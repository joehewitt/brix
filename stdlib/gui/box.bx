  (fn-do _ update-layout-pass _
    (if (not is-displayed)
      (if (or $is-layout-invalid $is-layout-invalid-below hidden-dirty-below)
        (call set-hidden-dirty-below true)
        (= $is-layout-invalid false)
      )
      (return)
    )
    (blank)
    (let was-parked hidden-dirty-below)
    (let needs-layout (or $is-layout-invalid was-parked))
    (if was-parked
      (call set-hidden-dirty-below false)
    )
    (blank)
    (let visit-below (or $is-layout-invalid-below was-parked))
    (let did-work (or needs-layout visit-below))
    (let pinned (and needs-layout (call is-scroll-pinned-to-end)))
    (if needs-layout
      (let outer-cause gui-arrange-cause)
      (= gui-arrange-cause layout-cause)
      (= layout-cause markup-cause-none)
      (call classify-pending-layout-invalidation)
      (let reuse-positioned-children false)
      (if (not is-markup-shadow)
        (let box-layout $layout)
        (if box-layout
          (let hint (. LayoutArrangeHint full))
          (if (and (== layout-invalidation-kind (. GuiLayout children-only)) (not $is-active-list-invalid))
            (= hint (. LayoutArrangeHint children-only))
          )
          (let outer-again gui-arrange-again)
          (= gui-arrange-again false)
          (call (. box-layout arrange-box) this hint)
          (while gui-arrange-again
            (= gui-arrange-again false)
            (= hint (. LayoutArrangeHint full))
            (call (. box-layout arrange-box) this hint)
          )
          (= gui-arrange-again outer-again)
          (if (== hint (. LayoutArrangeHint children-only))
            (let preserves-positioned (. box-layout preserves-positioned-children-on-children-only))
            (= reuse-positioned-children preserves-positioned)
          )
        )
        (if (not reuse-positioned-children)
          (call arrange-positioned-children)
        )
      )
      (= gui-arrange-cause outer-cause)
      (= $is-layout-invalid false)
      (call mark-layout-arranged)
      (= visit-below (or $is-layout-invalid-below was-parked))
    )
    (blank)
    (if visit-below
      (= $is-layout-invalid-below false)
      (call clear-shadow-layout-state)
      (let indexed-dirty (call take-indexed-dirty-layout-children))
      (if (and indexed-dirty (not was-parked))
        (for (in child indexed-dirty)
          (call (. child update-layout-pass))
        )
        (call (. indexed-dirty clear))
        (else
          (call (?. indexed-dirty clear))
          (for (in child (call RenderedChildCursor this))
            (call (. child update-layout-pass))
          )
        )
      )
    )
    (blank)
    (if did-work
      (probe-count gui.frame.layout-nodes-visited)
      (if pinned
        (call keep-scroll-end)
      )
      (call did-layout)
    )
  )
  (fn-do _ arrange-positioned-child _
    (param child Box)
    (if (. child is-markup-shadow)
      (for (in grandchild (call RenderedChildCursor child))
        (call arrange-positioned-child grandchild)
      )
      (return)
    )
    (if (and (. child is-displayed) (not (call (. child participates-in-parent-layout) this)))
      (call (. child effective-position arrange) this child)
      (else-if (. child is-displayed)
        (call (. child effective-position settle) this child)
      )
    )
  )
  (fn-do _ refresh-layout-index _
    (return-if (if current-layout-index))
    (blank)
    (let child-count (call rendered-box-count-up-to gui-layout-index-child-threshold))
    (if (== child-count 0)
      (if scroll-state
        (let state scroll-state)
        (if (. state layout-index)
          (let index (. state layout-index))
          (call (. index clear))
        )
      )
      (return)
    )
    (blank)
    (let had-index (and (!= scroll-state null) (!= (. scroll-state layout-index) null)))
    (let should-index (or clips-content (>= child-count gui-layout-index-child-threshold) had-index))
    (return-if (if (not should-index)))
    (blank)
    (let index (call layout-index-for-write))
    (let previous-subtree (. index subtree-bounds))
    (call (. index clear))
    (+= (. index refresh-generation) 1)
    (= (. index child-list-generation) child-list-generation)
    (= (. index subtree-bounds) hit-extent)
    (blank)
    (let axis (?. $layout sequence-axis))
    (if axis
      (= (. index is-sequenced) true)
      (= (. index orient) axis)
    )
    (blank)
    (let order Index)
    (let reach (? Length))
    (for (in child (call RenderedChildCursor this))
      (let subtree (call (. child retained-hit-subtree-bounds)))
      (= (. index subtree-bounds) (+ (. index subtree-bounds) subtree))
      (let entry (call LayoutIndexEntry child order))
      (+= order 1)
      (if (not (. index is-sequenced))
        (+= (. index children) entry)
        (continue)
      )
      (let span (. child bounds))
      (let horizontal (== (. index orient) (. Orientation horizontal)))
      (let start (if-expr horizontal (. span left) (. span top)))
      (let follows (and (>= start (?? reach start)) (call (. child participates-in-parent-layout) this)))
      (if (and follows (call (. span contains) subtree))
        (+= (. index children) entry)
        (= reach (if-expr horizontal (. span right) (. span bottom)))
        (else
          (+= (. index overflow) entry)
        )
      )
    )
    (blank)
    (= (. index valid) true)
    (if (!= previous-subtree (. index subtree-bounds))
      (call (?. material-parent invalidate-layout-index-chain))
    )
  )
  (fn-expr _ retained-hit-subtree-bounds Rect
    (if-expr (not transform) subtree (call (. transform transform) subtree))
    (where
      (lazy subtree (call own-hit-subtree-bounds))
      (lazy transform presentation-transform)
    )
  )
  (fn-do _ own-hit-subtree-bounds Rect
    (return-if hit-extent (if (or clips-content (not %first-child))))
    (blank)
    (let retained current-layout-index)
    (return-if (. retained subtree-bounds) (if retained))
    (blank)
    (let subtree hit-extent)
    (for (in child (call RenderedChildCursor this))
      (= subtree (+ subtree (call (. child retained-hit-subtree-bounds))))
    )
    (return subtree)
  )
  (fn-do _ sync-native-geometry-from _
    (param native-origin Point)
    (param native-parent (? Pointer))
    (call (?. window-host sync-native-artifact-registry) native-origin native-parent)
  )
  (fn-do _ sync-native-material _
    (param native-window Pointer)
    (param visible Bool)
    (param native-parent (? Pointer))
    (let material $window-material)
    (return-if (if (== material null)))
    (blank)
    (if (not native-material)
      (let host (call C:brixGuiMaterialCreate))
      (return-if (if (not host)))
      (blank)
      (let created (call NativeMaterial))
      (= (. created host) host)
      (= native-material created)
    )
    (let state (!! native-material))
    (let extent (call (. effective-shape extent) this bounds))
    (let zoom native-zoom)
    (call sync-native-material-mask state extent zoom)
    (let frame (call presentation-rect extent))
    (let origin (?? (?. presentation-layer presentation-origin) (call Point 0 0)))
    (call C:brixGuiMaterialSetContainer
      (block
        (arg (. state host))
        (arg native-window)
        (arg (?? native-parent (call Pointer)))
        (arg (call native-material-depth))
      )
    )
    (call C:brixGuiMaterialSetFrame
      (block
        (arg (. state host))
        (arg (* (- (. frame x) (. origin x)) zoom))
        (arg (* (- (. frame y) (. origin y)) zoom))
        (arg (* (. frame width) zoom))
        (arg (* (. frame height) zoom))
        (arg material)
        (arg effective-opacity)
        (arg (and visible (call is-presentation-visible extent)))
      )
    )
  )
  (fn-do _ native-material-depth _
    (return-if 0 (if is-presentation-layer))
    (blank)
    (let depth I32)
    (let cursor material-parent)
    (while cursor
      (let ancestor cursor)
      (if (. ancestor has-native-material)
        (+= depth 1)
      )
      (return-if depth (if (. ancestor is-presentation-layer)))
      (blank)
      (= cursor (. ancestor material-parent))
    )
    (return depth)
  )
  (fn-do _ sync-native-material-mask _
    (param state NativeMaterial)
    (param extent Rect)
    (param zoom F64)
    (if (or (<= (. extent width) 0) (<= (. extent height) 0))
      (return-if (if (and (not (. state mask-key)) (. state mask-dirty))))
      (blank)
      (= (. state mask-key) null)
      (= (. state mask-dirty) true)
      (call C:brixGuiMaterialSetCornerRadius (. state host) 0)
      (call C:brixGuiMaterialSetMask (. state host) (call Pointer) 0 0 0)
      (return)
    )
    (let outline (call (. effective-shape exact-outline) this bounds))
    (if (not outline)
      (return-if (if (and (not (. state mask-dirty)) (== (. state mask-zoom) zoom))))
      (blank)
      (= (. state mask-dirty) false)
      (= (. state mask-key) null)
      (= (. state mask-zoom) zoom)
      (call C:brixGuiMaterialSetCornerRadius (. state host) 0)
      (probe-count gui.native.material-masks)
      (let mask (call RasterCanvas (as (. extent width) I32) (as (. extent height) I32) (* 2 zoom) transparent))
      (do-use mask
        (call (. mask translate) (- (. extent x)) (- (. extent y)))
        (= (. mask fill-color) (call RGBA 0 0 0 1))
        (call (. effective-shape fill) this bounds mask)
        (call C:brixGuiMaterialSetMask
          (block
            (arg (. state host))
            (arg (. mask native))
            (arg (* (. extent width) zoom))
            (arg (* (. extent height) zoom))
            (arg 0)
          )
        )
      )
      (return)
    )
    (if (. outline is-rectangular)
      (let plain (call Outline (call Rect 0 0 0 0)))
      (return-if (if (== (. state mask-key) plain)))
      (blank)
      (= (. state mask-key) plain)
      (call C:brixGuiMaterialSetCornerRadius (. state host) 0)
      (call C:brixGuiMaterialSetMask (. state host) (call Pointer) 0 0 0)
      (return)
    )
    (call C:brixGuiMaterialSetCornerRadius (. state host) (* (. outline effective-radius) zoom))
    (let cap (call ceil (. outline effective-radius)))
    (let side (+ (* cap 2) 2))
    (let stretches (and (not (. outline arrow)) (>= (. extent width) side) (>= (. extent height) side)))
    (let local
      (call Rect
        (block
          (arg (- (. outline bounds x) (. extent x)))
          (arg (- (. outline bounds y) (. extent y)))
          (arg (. outline bounds width))
          (arg (. outline bounds height))
        )
      )
    )
    (let key
      (block
        (case? stretches
          (call Outline (call Rect 0 0 side side) (. outline effective-radius))
        )
        (default
          (call Outline local (. outline radius) (. outline arrow))
        )
      )
    )
    (return-if (if (and (== (. state mask-key) key) (== (. state mask-zoom) zoom))))
    (blank)
    (= (. state mask-key) key)
    (= (. state mask-zoom) zoom)
    (let width (if-expr stretches side (. extent width)))
    (let height (if-expr stretches side (. extent height)))
    (probe-count gui.native.material-masks)
    (let mask (call RasterCanvas (as width I32) (as height I32) (* 2 zoom) transparent))
    (do-use mask
      (= (. mask fill-color) (call RGBA 0 0 0 1))
      (call (. mask outline) key)
      (let inset (if-expr stretches (* cap zoom) 0))
      (call C:brixGuiMaterialSetMask (. state host) (. mask native) (* width zoom) (* height zoom) inset)
    )
  )
  (fn-do _ native-geometry-parent-context NativeGeometryContext
    (param native-origin Point)
    (param native-window Pointer)
    (param native-parent (? Pointer))
    (param pass U64)
    (= native-visit-pass pass)
    (let parent material-parent)
    (return-if (call NativeGeometryContext native-origin native-parent true null) (if (not parent)))
    (blank)
    (let synced (call (. parent synced-native-context) pass))
    (return-if synced (if synced))
    (blank)
    (let context
      (call (. parent native-geometry-parent-context)
        (block
          (arg native-origin)
          (arg native-window)
          (arg native-parent)
          (arg pass)
        )
      )
    )
    (let visible (and (. context visible) (. parent is-display-visible)))
    (let next-origin (. context origin))
    (let next-parent (. context parent))
    (let next-transform (call (. parent nested-presentation-transform) (. context transform)))
    (if (. parent is-presentation-layer)
      (= next-origin (. parent presentation-origin))
      (= next-parent (. parent presentation-native-host))
      (= next-transform null)
    )
    (let next-context
      (call (. parent sync-native-clip-host)
        (block
          (arg next-origin)
          (arg native-window)
          (arg visible)
          (arg next-parent)
          (arg next-transform)
          (arg pass)
        )
      )
    )
    (probe-count gui.native.ancestor-steps)
    (return next-context)
  )
  (fn-do _ invalidate-visited-native-geometry _
    (return-if (if (== native-visit-pass 0)))
    (blank)
    (call (?. window-host invalidate-visited-native-geometry) native-visit-pass)
  )
  (fn-expr _ synced-native-context (? NativeGeometryContext)
    (param pass U64)
    (if-expr (or (not state) (!= (. state native-sync-pass) pass)) null (. state native-sync-context))
    (where
      (lazy state scroll-state)
    )
  )
  (fn-expr _ nested-presentation-transform (? Matrix)
    (param outer (? Matrix))
    (case? (not own)
      outer
    )
    (case? (not outer)
      own
    )
    (default
      (call (. outer concatenate) own)
    )
    (where
      (lazy own presentation-transform)
    )
  )
  (fn-do _ sync-native-clip-host _
    (param native-origin Point)
    (param native-window Pointer)
    (param visible Bool)
    (param native-parent (? Pointer))
    (param transform (? Matrix))
    (param pass U64)
    (= native-visit-pass pass)
    (let synced (call synced-native-context pass))
    (return-if synced (if synced))
    (blank)
    (let next-origin native-origin)
    (let next-parent native-parent)
    (let next-transform transform)
    (let needs-host (!= (/and/ native-artifact-kinds gui-native-artifact-clip) 0))
    (= needs-host (and needs-host (!= native-window (call Pointer))))
    (if needs-host
      (let state (call scroll-state-for-write))
      (if (not (. state native-host))
        (= (. state native-host) (call C:brixGuiBoxHostCreate native-window))
        (probe-count gui.native.clip-hosts)
      )
      (if (. state native-host)
        (let viewport content-clip-rect)
        (let offset content-offset)
        (let content native-content-rect)
        (let zoom native-zoom)
        (let corner (call native-placed-point (- (. viewport top-left) next-origin) next-origin transform))
        (let linear (?? transform (call Matrix)))
        (call C:brixGuiBoxHostSetParent (!! (. state native-host)) (?? next-parent (call Pointer)))
        (call C:brixGuiBoxHostSetFrame
          (block
            (arg (!! (. state native-host)))
            (arg (* (. corner x) zoom))
            (arg (* (. corner y) zoom))
            (arg (* (. viewport width) zoom))
            (arg (* (. viewport height) zoom))
            (arg (. linear a))
            (arg (. linear c))
            (arg (. linear b))
            (arg (. linear d))
            (arg (* (. content x) zoom))
            (arg (* (. content y) zoom))
            (arg (* (. content width) zoom))
            (arg (* (. content height) zoom))
            (arg (* (. offset x) zoom))
            (arg (* (. offset y) zoom))
            (arg visible)
          )
        )
        (let rounded content-rounded-bounds)
        (call C:brixGuiBoxHostSetCornerRadii
          (block
            (arg (!! (. state native-host)))
            (arg (* (. rounded left) zoom))
            (arg (* (. rounded top) zoom))
            (arg (* (. rounded right) zoom))
            (arg (* (. rounded bottom) zoom))
          )
        )
        (let context (call NativeGeometryContext (. viewport top-left) (. state native-host) visible null))
        (= (. state native-sync-pass) pass)
        (= (. state native-sync-context) context)
        (return context)
      )
      (else-if (and scroll-state (. scroll-state native-host))
        (call C:brixGuiBoxHostRelease (. scroll-state native-host))
        (= (. (!! scroll-state) native-host) null)
      )
    )
    (return (call NativeGeometryContext next-origin next-parent visible next-transform))
  )
  (fn-expr _ reserves-scroll-indicator _
    (param axis Orientation)
    (case? (!= $scroll-indicator-gutter (. ScrollIndicatorGutter stable))
      false
    )
    (case? (not (call is-scroll-axis-enabled axis))
      false
    )
    (default
      (!= visibility (. ScrollIndicatorVisibility hidden))
    )
    (where
      (lazy visibility (if-expr (== axis (. Orientation horizontal)) $scroll-indicator-x $scroll-indicator-y))
    )
  )
  (fn-do _ swap-snapshot Image
    (call composite-refresh)
    (let scale (?? (?. window-host backing-scale) 1))
    (let b bounds)
    (let canvas
      (call RasterCanvas
        (block
          (arg (as (call max 1.0 (call ceil (. b width))) I32))
          (arg (as (call max 1.0 (call ceil (. b height))) I32))
          (arg scale)
          (arg transparent)
        )
      )
    )
    (let swap swap-filter)
    (do-use (. canvas saved-state)
      (call (. canvas translate) (- (. b x)) (- (. b y)))
      (if swap
        (call (. canvas begin-filter) b swap)
      )
      (call paint-layer canvas true true)
      (if swap
        (call (. canvas end-filter))
      )
    )
    (return (call Image canvas scale))
  )
  (fn-do _ swap-ended _
    (param run BoxSwap)
    (let state motion-state)
    (return-if (if (not state)))
    (blank)
    (let current (. state swap))
    (return-if (if (or (not current) (!= (as current Pointer) (as run Pointer)))))
    (blank)
    (= (. state swap) null)
    (call (. run from release))
    (call composite-invalidate)
    (call invalidate-paint)
  )
  (fn-do _ paint-with-context _
    (param canvas Canvas)
    (param parent-visible Bool)
    (param detached _ (= false))
    (param forced _ (= false))
    (probe-count gui.frame.paint-nodes-visited)
    (call paint-traversal-visit)
    (let visible (and parent-visible (or forced is-display-visible)))
    (if (not visible)
      (call settle-paint detached)
      (return)
    )
    (blank)
    (if is-markup-shadow
      (call paint-children-with-context canvas visible detached)
      (call settle-paint detached)
      (return)
    )
    (blank)
    (let opacity computed-opacity)
    (let filters layer-filters)
    (let transform painted-transform)
    (if transform
      (call (. canvas push))
      (call (. canvas transform-content) transform)
    )
    (if (< opacity 1%%)
      (call (. canvas push))
      (call (. canvas begin-opacity) opacity)
    )
    (for (in index (..< 0 (. filters length)))
      (call (. canvas begin-filter) bounds ([] filters (- (. filters length) 1 index)))
    )
    (call paint-layer canvas visible detached)
    (for (in filter filters)
      (call (. canvas end-filter))
    )
    (if (< opacity 1%%)
      (call (. canvas end-opacity))
      (call (. canvas pop))
    )
    (if transform
      (call (. canvas pop))
    )
    (call settle-paint detached)
  )
  (fn-do _ paint-layer _
    (param canvas Canvas)
    (param visible Bool)
    (param detached Bool)
    (call paint-box-background canvas)
    (if clips-content
      (do-use (. canvas saved-state)
        (call (. content-rounded-bounds clip) canvas)
        (call clip-content-shape canvas)
        (let translation content-scroll-translation)
        (call (. canvas translate) (. translation x) (. translation y))
        (call paint-content-self canvas)
        (call paint-children-with-context canvas visible detached)
      )
      (else
        (call paint-content-self canvas)
        (call paint-children-with-context canvas visible detached)
      )
    )
    (call paint-box-border canvas)
    (call paint-scroll-indicators canvas)
    (call paint-overlay canvas)
    (call paint-focus-ring canvas)
  )
  (fn-do _ settle-paint _
    (param detached Bool)
    (return-if (if detached))
    (blank)
    (= $is-paint-invalid false)
    (= $is-paint-invalid-below false)
  )
  (fn-do _ paint-children-with-context _
    (param canvas Canvas)
    (param visible Bool)
    (param detached _ (= false))
    (let record composite-record)
    (if record
      (call paint-routed canvas visible detached (. record below))
    )
    (let child (call gui-rendered-resolve this %first-child))
    (while child
      (if (== (/and/ (. child composite-bits) gui-composite-routed-bit) 0)
        (call (. child paint-with-context) canvas visible detached)
      )
      (= child (call gui-rendered-resolve this (call gui-rendered-climb child this)))
    )
    (if record
      (call paint-routed canvas visible detached (. record above))
    )
  )
  (fn-do _ paint-routed _
    (param canvas Canvas)
    (param visible Bool)
    (param detached Bool)
    (param members (? (list Box)))
    (return-if (if (not members)))
    (blank)
    (for (in member members)
      (call (. member paint-with-context) canvas visible detached)
    )
  )
  (fn-do _ paint-framed-background _
    (param canvas Canvas)
    (return-if (if (and (> computed-corner-radius 0) (or (<= width 0) (<= height 0)))))
    (blank)
    (let shadow painted-shadow)
    (let backdrop $backdrop-blur)
    (let backdrop-shader $backdrop)
    (let material $window-material)
    (if (!= material null)
      (if (and native-material (not (call (. effective-shape exact-outline) this bounds)))
        (= (. native-material mask-dirty) true)
        (call (?. window-host invalidate-native-artifacts))
      )
      (do-use (. canvas saved-state)
        (= (. canvas blend-mode) (. BlendMode clear))
        (= (. canvas fill-color) black)
        (= (. canvas stroke-color) null)
        (call (. effective-shape fill) this bounds canvas)
      )
    )
    (if backdrop-shader
      (call (. effective-shape backdrop-shader) this bounds (. backdrop-shader filter) (?? backdrop 0) canvas)
      (else-if (!= backdrop null)
        (call (. effective-shape backdrop) this bounds backdrop canvas)
      )
    )
    (if (and shadow (or (!= backdrop null) (!= backdrop-shader null) (!= material null)))
      (do-use (. canvas saved-state)
        (call (. effective-shape clip-out) this bounds (call (. ink-frame pad) -1) canvas)
        (call (. effective-shape shadow) this bounds shadow canvas)
      )
      (else-if shadow
        (call (. effective-shape shadow) this bounds shadow canvas)
      )
    )
    (if (and is-shaped (?? (?. $background clips-to-shape) true))
      (do-use (. canvas saved-state)
        (call (. effective-shape clip) this bounds canvas)
        (call paint-background canvas)
      )
      (else
        (call paint-background canvas)
      )
    )
  )
  (fn-do _ paint-framed-border _
    (param canvas Canvas)
    (return-if (if (and (> computed-corner-radius 0) (or (<= width 0) (<= height 0)))))
    (blank)
    (if is-shaped
      (do-use (. canvas saved-state)
        (call (. effective-shape clip) this bounds canvas)
        (call paint-border canvas)
      )
      (else
        (call paint-border canvas)
      )
    )
  )
  (fn-do _ paint-content-self _
    (param canvas Canvas)
    (let transform content-transform)
    (if (not transform)
      (call paint-self canvas)
      (return)
    )
    (do-use (. canvas saved-state)
      (call (. canvas transform-content) transform)
      (call paint-self canvas)
    )
  )
)

(type + EnsureVisibleQueue
  (prop + pending (? Box))
  (prop + generation U32)
  (prop + alignment _ (= (. ScrollAlignment nearest)))
  (prop + margin Insets)
  (prop + cause _ (= (. ScrollCause ensure-visible)))
)

(type + PointerHitPath (is Tuple)
  (prop + target Box)
  (prop + frames (list GUIEventRouteFrame))
  (fn-do + is-current _
    (return-if false (if (== (. frames length) 0)))
    (blank)
    (let root-owner (. ([] frames (- (. frames length) 1)) owner))
    (for (in frame frames)
      (let box (call (of gc-object-from-pointer Box) (. frame owner)))
      (return-if false (if (!= (. box input-generation) (. frame generation))))
      (return-if false (if (or (. box is-markup-shadow) (not (. box is-input-visible)))))
      (return-if false (if (!= (as (. box root) Pointer) root-owner)))
    )
    (return true)
  )
  (fn-do + at-point _
    (param point Point)
    (let next-frames (list GUIEventRouteFrame))
    (for (in frame frames)
      (let box (call (of gc-object-from-pointer Box) (. frame owner)))
      (+= next-frames
        (call GUIEventRouteFrame
          (block
            (arg (. frame owner))
            (arg (. frame generation))
            (arg (call (. box point-in-box) point))
          )
        )
      )
    )
    (return (call PointerHitPath target next-frames))
  )
  (fn-do + (of publish Event) Bool
    (param event Event)
    (constraint is Event GUIRoutedEvent)
    (return-if false (if (not (call is-current))))
    (blank)
    (let route (if-expr (call gui-event-requires-enabled event) (call enabled-frames) frames))
    (return-if false (if (== (. route length) 0)))
    (blank)
    (let receiver (call (of gc-object-from-pointer Box) (. ([] route 0) owner)))
    (let routed (as event GUIEvent))
    (let saved (call (. routed begin-route) gui-box-event-route-next route))
    (let cause (? MarkupCause)
      (scope (if-expr dragging gui-instant-cause (only-if markup-cause-none (if scrolling)))
        (lazy dragging (is event PointerDragEvent))
        (lazy scrolling (is event ScrollEvent))
      )
    )
    (let outer (only-if (call swap-markup-cause cause) (if cause)))
    (finally
      (call (. routed end-route) saved)
      (if outer
        (call swap-markup-cause outer)
      )
    )
    (return
      (match event
        (case ModifiersChangedEvent
          (<- (. receiver modifiers-changed) it)
          (. it is-canceled)
        )
        (case KeyReleaseEvent
          (<- (. receiver key-release) it)
          (. it is-canceled)
        )
        (case PointerDownEvent
          (<- (. receiver pointer-down) it)
          (. it is-canceled)
        )
        (case PointerUpEvent
          (<- (. receiver pointer-up) it)
          (. it is-canceled)
        )
        (case PointerMoveEvent
          (<- (. receiver pointer-move) it)
          (. it is-canceled)
        )
        (case PointerDragEvent
          (<- (. receiver pointer-drag) it)
          (. it is-canceled)
        )
        (case ScrollEvent
          (<- (. receiver scroll) it)
          (. it is-canceled)
        )
        (case MagnifyEvent
          (<- (. receiver magnify) it)
          (. it is-canceled)
        )
        (case TouchEvent
          (<- (. receiver touch) it)
          (. it is-canceled)
        )
        (case ClickEvent
          (<- (. receiver click) it)
          (. it is-canceled)
        )
        (case FocusEvent
          (<- (. receiver focus) it)
          (. it is-canceled)
        )
        (case BlurEvent
          (<- (. receiver blur) it)
          (. it is-canceled)
        )
        (case KeyPressEvent
          (<- (. receiver key-press) it)
          (. it is-canceled)
        )
        (case KeyInputEvent
          (<- (. receiver key-input) it)
          (. it is-canceled)
        )
        (case TextCommandEvent
          (<- (. receiver text-command) it)
          (. it is-canceled)
        )
        (case TextCompositionEvent
          (<- (. receiver text-composition) it)
          (. it is-canceled)
        )
        (case CopyEvent
          (<- (. receiver copy) it)
          (. it is-canceled)
        )
        (case CutEvent
          (<- (. receiver cut) it)
          (. it is-canceled)
        )
        (case PasteEvent
          (<- (. receiver paste) it)
          (. it is-canceled)
        )
      )
    )
  )
  (fn-do + publish-drag-start _
    (param event DragStartEvent)
    (return-if (if (not (call is-current))))
    (blank)
    (let saved (call (. event begin-route) gui-box-event-route-next frames))
    (finally
      (inline (call (. event end-route) saved))
    )
    (<- (. target drag-start) event)
  )
  (fn-do + publish-drag-over _
    (param event DragOverEvent)
    (return-if (if (not (call is-current))))
    (blank)
    (let saved (call (. event begin-route) gui-box-event-route-next frames))
    (finally
      (inline (call (. event end-route) saved))
    )
    (<- (. target drag-over) event)
  )
  (fn-expr _ enabled-frames (list GUIEventRouteFrame)
    (spread frames)
    (pipe ?*> (only-if each (if (. (call (of gc-object-from-pointer Box) (. each owner)) is-effectively-enabled))))
    (pipe |> List)
  )
)

(type + RenderedChildCursor (is Tuple)
  (implements (of CursorIterable Box Pointer))
  (prop + owner GuiNode)
  (fn-expr + initial-iterator-state _ :get
    (case? (not first)
      (call Pointer)
    )
    (default
      (as first Pointer)
    )
    (where
      (lazy first (call gui-rendered-resolve owner (. owner %first-child)))
    )
  )
  (fn-do + next-iterator _
    (param state Pointer)
    (let none (? Box))
    (return-if (tuple (call Pointer) none) (if (== state (call Pointer))))
    (blank)
    (let box (call (of gc-object-from-pointer Box) state))
    (let successor (call gui-rendered-resolve owner (call gui-rendered-climb box owner)))
    (let next-state (call Pointer))
    (if successor
      (= next-state (as successor Pointer))
    )
    (return (tuple next-state box))
  )
)

(type + ActiveChildCursor (is Tuple)
  (implements (of CursorIterable Box Pointer))
  (prop + owner Box)
  (fn-expr + initial-iterator-state _ :get
    (case? (not first)
      (call Pointer)
    )
    (default
      (as first Pointer)
    )
    (where
      (lazy first (. owner first-active-child))
    )
  )
  (fn-do + next-iterator _
    (param state Pointer)
    (let none (? Box))
    (return-if (tuple (call Pointer) none) (if (== state (call Pointer))))
    (blank)
    (let box (call (of gc-object-from-pointer Box) state))
    (let next-state (call Pointer))
    (if (. box next-active-sibling)
      (= next-state (as (!! (. box next-active-sibling)) Pointer))
    )
    (return (tuple next-state box))
  )
)

(type + GuiNode
  (implements (of MarkupParent GuiNode))
  (prop + markup-attachment-cache (? MarkupAttachment))
  (prop + is-gui-transparent _ (=> markup-is-transparent-region))
  (fn-expr + markup-make-region (? GuiNode)
    (call GuiRegion)
  )
  (fn-do + structural-children _ :get @inline
    (probe-count gui.tree.children-walks)
    (let next %first-child)
    (while next
      (let child next)
      (= next (. child %next-sibling))
      (yield child)
    )
  )
  (fn-do + rendered-nodes (list GuiNode) :get
    (for (in child structural-children)
      (if (. child is-gui-transparent)
        (yield-all (. child rendered-nodes))
        (else-if (not (and (is child Box) (. (as child Box) is-presentation-layer)))
          (yield child)
        )
      )
    )
  )
  (fn-expr + markup-batch-root _ :get
    (call markup-root-of this)
  )
  (fn-expr + markup-first-child (? MarkupElement) :get
    (call markup-structural-first-child-host this)
  )
  (fn-expr + markup-next-sibling (? MarkupElement) :get
    (call markup-structural-next-sibling-host this)
  )
  (fn-do + gui-child-list-changed _)
  (fn-do + clear-cursor-invalidations _
    (if (is this Box)
      (= (. (as this Box) $is-cursor-invalid) false)
    )
    (let child %first-child)
    (while child
      (let current child)
      (call (. current clear-cursor-invalidations))
      (= child (. current %next-sibling))
    )
  )
  (fn-do + close _ (?! Error)
    (let child %first-child)
    (while child
      (let current child)
      (call (. current close))
      (= child (. current %next-sibling))
    )
  )
  (fn-do + set-control-size _
    (param size ControlSize)
    (call set-theme-tag "small" (== size (. ControlSize small)))
    (call set-theme-tag "large" (== size (. ControlSize large)))
  )
  (fn-do + restyle-themes _
    (call style-restyle-themes this)
  )
  (fn-do + markup-attach-shadow-child _
    (param child MarkupElement)
    (param anchor (? MarkupElement))
    (+= gui-tree-structure-generation 1)
    (call gui-child-list-changed)
  )
  (fn-do + markup-detach-shadow-child _
    (param child MarkupElement)
    (+= gui-tree-structure-generation 1)
    (call gui-child-list-changed)
  )
  (fn-expr + markup-content _
    (param child GuiNode)
    child
  )
  (fn-do + markup-attach-child _
    (param child GuiNode)
    (param anchor (? GuiNode))
    (match? child
      (case (: box Box)
        (+= (. box input-generation) 1)
        (if (!= (/and/ (. box composite-bits) gui-composite-relevant-bit) 0)
          (call composite-invalidate)
        )
      )
    )
    (+= gui-tree-structure-generation 1)
    (call gui-child-list-changed)
  )
  (fn-do + markup-detach-child _
    (param child GuiNode)
    (match? child
      (case (: box Box)
        (+= (. box input-generation) 1)
        (= (. box active-next) null)
        (if (!= (/and/ (. box composite-bits) gui-composite-relevant-bit) 0)
          (call composite-invalidate)
        )
      )
    )
    (+= gui-tree-structure-generation 1)
    (call gui-child-list-changed)
  )
  (fn-do _ rendered-box-count-up-to Size
    (param limit Size)
    (let count Size 0)
    (let child (? GuiNode) %first-child)
    (while child
      (let node child)
      (if (. node is-gui-transparent)
        (+= count (call (. node rendered-box-count-up-to) (- limit count)))
        (else-if (and (is node Box) (not (. (as node Box) is-presentation-layer)))
          (+= count 1)
        )
      )
      (return-if count (if (>= count limit)))
      (blank)
      (= child (. node %next-sibling))
    )
    (return count)
  )
)

(type + GuiRegion (is GuiNode)
  (prop _ child-list-generation U32)
  (prop _ active-list-child-list-generation U32)
  (fn-do + gui-child-list-changed _
    (+= child-list-generation 1)
    (let parent (? Box))
    (let cursor (? GuiNode) %parent)
    (while cursor
      (let node cursor)
      (if (is node Box)
        (= parent (as node Box))
        (break)
      )
      (= cursor (. node %parent))
    )
    (call (?. parent gui-region-child-list-changed))
  )
  (fn-do + close _
    (call markup-close-region this)
    (call (. super close))
  )
  (fn-expr + markup-is-transparent-region _ :get
    true
  )
  (fn-do + markup-branch-changing _
    (let cursor (? GuiNode) %parent)
    (while cursor
      (let node cursor)
      (if (is node Box)
        (call (. (as node Box) swap-content))
        (return)
      )
      (= cursor (. node %parent))
    )
  )
  (fn-do + has-active-list-invalid Bool
    (return-if true (if (!= active-list-child-list-generation child-list-generation)))
    (blank)
    (let child %first-child)
    (while child
      (let current child)
      (if (is current GuiRegion)
        (return-if true (if (call (. (as current GuiRegion) has-active-list-invalid))))
      )
      (= child (. current %next-sibling))
    )
    (return false)
  )
  (fn-do + mark-active-list-clean _
    (= active-list-child-list-generation child-list-generation)
    (let child %first-child)
    (while child
      (let current child)
      (if (is current GuiRegion)
        (call (. (as current GuiRegion) mark-active-list-clean))
      )
      (= child (. current %next-sibling))
    )
  )
)

(type + WindowHost (is Interface)
  (fn-expr + window-clock FrameClock :get)
  (fn-expr + admits-entering Bool :get)
  (fn-expr + admits-leaving Bool :get)
  (fn-expr + backing-scale F64 :get)
  (fn-expr + effective-zoom F64 :get)
  (fn-do + hush-entering _
    (param hushed Bool)
  )
  (fn-do + hush-until-layout _)
  (fn-do + accept-focus-request Bool
    (param box (? Box))
  )
  (fn-do + accept-text-input-change _
    (param box Box)
  )
  (fn-do + invalidate-popup-placement _)
  (fn-do + watch-clip _
    (param watcher ClipWatcher)
  )
  (fn-do + unwatch-clip _
    (param watcher ClipWatcher)
  )
  (fn-do + notify-clip-watchers _
    (param scrolled (? Box))
  )
  (fn-do + holds-scroll-indicator Bool
    (param owner Box)
  )
  (fn-do + release-input-inside _
    (param subtree Box)
  )
  (fn-do + register-native-artifact _
    (param box Box)
  )
  (fn-do + unregister-native-artifact _
    (param box Box)
  )
  (fn-do + register-focus-home _
    (param box Box)
  )
  (fn-do + unregister-focus-home _
    (param box Box)
  )
  (fn-do + invalidate-native-artifacts _)
  (fn-do + invalidate-visited-native-geometry _
    (param pass U64)
  )
  (fn-do + sync-native-artifact-registry _
    (param native-origin Point)
    (param native-parent (? Pointer))
  )
)

(type + ClipWatcher (is Interface)
  (fn-do + clip-changed _
    (param scrolled (? Box))
  )
)

(type + ScrollGoal (is (fn-type (? Point))))

(type + ScrollGlide
  (implements FrameAnimation)
  (prop + box Box)
  (prop + goal ScrollGoal)
  (prop + motion Motion)
  (prop + position MotionChannel)
  (fn-do + This _
    (param box _)
    (param goal _)
    (param motion _)
    (param position _)
  )
  (fn-do + advance Bool
    (param tick FrameTick)
    (let wanted (call goal))
    (if wanted
      (call aim wanted (. tick now))
    )
    (call (. position update) (. tick now))
    (let ignored (call (. box scroll-to) (call Point (. position value))))
    (return (. position is-moving))
  )
  (fn-do + finish _
    (let ignored (call (. box scroll-to) (?? (call goal) (call Point (. position target)))))
  )
  (fn-do + retarget _
    (param next ScrollGoal)
    (param next-motion Motion)
    (param now Duration)
    (= goal next)
    (= motion next-motion)
    (let wanted (call goal))
    (if wanted
      (call aim wanted now)
    )
  )
  (fn-do + aim _
    (param point Point)
    (param now Duration)
    (let wanted (. point motion-vector))
    (let aimed (. position target))
    (return-if (if (and (< (call abs (- ([] wanted 0) ([] aimed 0))) (. position precision)) y-settled)))
    (blank)
    (lazy y-settled (< (call abs (- ([] wanted 1) ([] aimed 1))) (. position precision)))
    (call (. position retarget) wanted motion now)
  )
)

(type + BoxLanding (is Tuple)
  (prop + box Box)
  (prop + frame Rect)
  (prop + speed Point)
)

(fn-expr + gui-retained-tree-structure-generation _
  gui-tree-structure-generation
)

(fn-do + gui-rendered-resolve (? Box)
  (param owner GuiNode)
  (param candidate (? GuiNode))
  (let node candidate)
  (while node
    (let current node)
    (if (. current is-gui-transparent)
      (if (. current %first-child)
        (= node (. current %first-child))
        (else
          (= node (call gui-rendered-climb current owner))
        )
      )
      (else-if (and (is current Box) (not (. (as current Box) is-presentation-layer)))
        (return (as current Box))
      )
      (else
        (= node (call gui-rendered-climb current owner))
      )
    )
  )
  (return null)
)

(fn-do + gui-rendered-climb _
  (param node GuiNode)
  (param owner GuiNode)
  (let cursor node)
  (while true
    (return-if (if (== (as cursor Pointer) (as owner Pointer))))
    (blank)
    (if (. cursor %next-sibling)
      (return (. cursor %next-sibling))
    )
    (return-if (if (not (. cursor %parent))))
    (blank)
    (= cursor (!! (. cursor %parent)))
  )
)

(fn-do + gui-rendered-reverse-resolve (? Box)
  (param owner GuiNode)
  (param candidate (? GuiNode))
  (let node candidate)
  (while node
    (let current node)
    (if (. current is-gui-transparent)
      (if (. current %last-child)
        (= node (. current %last-child))
        (else
          (= node (call gui-rendered-reverse-climb current owner))
        )
      )
      (else-if (and (is current Box) (not (. (as current Box) is-presentation-layer)))
        (return (as current Box))
      )
      (else
        (= node (call gui-rendered-reverse-climb current owner))
      )
    )
  )
  (return null)
)

(fn-do + gui-rendered-reverse-climb _
  (param node GuiNode)
  (param owner GuiNode)
  (let cursor node)
  (while true
    (return-if (if (== (as cursor Pointer) (as owner Pointer))))
    (blank)
    (if (. cursor %previous-sibling)
      (return (. cursor %previous-sibling))
    )
    (return-if (if (not (. cursor %parent))))
    (blank)
    (= cursor (!! (. cursor %parent)))
  )
)

(fn-do + gui-node-precedes _
  (param left GuiNode)
  (param right GuiNode)
  (return-if false (if (== (as left Pointer) (as right Pointer))))
  (blank)
  (let cursor (? GuiNode) right)
  (while cursor
    (return-if true (if (== (as cursor Pointer) (as left Pointer))))
    (blank)
    (= cursor (. cursor %parent))
  )
  (= cursor left)
  (while cursor
    (return-if false (if (== (as cursor Pointer) (as right Pointer))))
    (blank)
    (= cursor (. cursor %parent))
  )
  (blank)
  (let common (? GuiNode))
  (let left-ancestor (? GuiNode) left)
  (while (and left-ancestor (not common))
    (let right-ancestor (? GuiNode) right)
    (while right-ancestor
      (if (== (as left-ancestor Pointer) (as right-ancestor Pointer))
        (= common left-ancestor)
        (break)
      )
      (= right-ancestor (. right-ancestor %parent))
    )
    (= left-ancestor (. left-ancestor %parent))
  )
  (return-if false (if (not common)))
  (blank)
  (let left-branch left)
  (while (and (. left-branch %parent) (!= (as (!! (. left-branch %parent)) Pointer) (as common Pointer)))
    (= left-branch (!! (. left-branch %parent)))
  )
  (let right-branch right)
  (while (and (. right-branch %parent) (!= (as (!! (. right-branch %parent)) Pointer) (as common Pointer)))
    (= right-branch (!! (. right-branch %parent)))
  )
  (blank)
  (let child (. common %first-child))
  (while child
    (return-if true (if (== (as child Pointer) (as left-branch Pointer))))
    (return-if false (if (== (as child Pointer) (as right-branch Pointer))))
    (blank)
    (= child (. child %next-sibling))
  )
  (return false)
)

(fn-expr + focus-mode-can-focus _
  (param mode FocusMode)
  (or (== mode (. FocusMode press)) (== mode (. FocusMode keys)) (== mode (. FocusMode input)))
)

(fn-expr + focus-mode-takes-keys _
  (param mode FocusMode)
  (or (== mode (. FocusMode keys)) (== mode (. FocusMode input)))
)

(fn-expr + focus-mode-contributes-shortcuts _
  (param mode FocusMode)
  (or (== mode (. FocusMode keys)) (== mode (. FocusMode inside)) (== mode (. FocusMode press)))
)

(fn-do + gui-box-event-route-next _
  (param raw-event Pointer)
  (param raw-current Pointer)
  (let event (call (of gc-object-from-pointer GUIEvent) raw-event))
  (let frames (. event route-frames))
  (let index (. event route-index))
  (return-if (if (or (>= index (. frames length)) (!= (. ([] frames index) owner) raw-current))))
  (blank)
  (let root-owner (. ([] frames (- (. frames length) 1)) owner))
  (+= index 1)
  (while (< index (. frames length))
    (let frame ([] frames index))
    (let box (call (of gc-object-from-pointer Box) (. frame owner)))
    (let is-live (== (. box input-generation) (. frame generation)))
    (let has-route (and (not (. box is-markup-shadow)) (. box is-input-visible)))
    (if (and is-live has-route (== (as (. box root) Pointer) root-owner))
      (call (. event advance-route) index (call (. box point-in-box) (. event root-point)))
      (return (. frame owner))
    )
    (+= index 1)
  )
)

(fn-do + gui-packed-span-up Length
  (param value Length)
  (let span (call gui-safe-span value))
  (let packed (as span F32))
  (let widened (as packed Length))
  (if (< widened span)
    (let machine-epsilon 0.00000011920928955078125f32)
    (let step (call max machine-epsilon (* (call abs packed) machine-epsilon)))
    (+= packed step)
  )
  (return packed)
)

(fn-expr + gui-pixel-snapped Rect
  (param rect Rect)
  (call Rect left top (call max 0 (- right left)) (call max 0 (- bottom top)))
  (where
    (lazy scale gui-pixel-scale)
    (lazy x (if-expr (call is-finite (. rect x)) (. rect x) 0))
    (lazy y (if-expr (call is-finite (. rect y)) (. rect y) 0))
    (lazy left (call gui-device-aligned x scale))
    (lazy top (call gui-device-aligned y scale))
    (lazy right (call gui-device-aligned (+ x (call gui-safe-span (. rect width))) scale))
    (lazy bottom (call gui-device-aligned (+ y (call gui-safe-span (. rect height))) scale))
  )
)

(fn-expr + gui-device-ceiled Length
  (param value Length)
  (if-expr (and (> scale 0) (call is-finite value)) (/ (call ceil (- (* value scale) 0.001)) scale) value)
  (where
    (lazy scale gui-pixel-scale)
  )
)

(fn-expr + gui-device-aligned Length
  (param value Length)
  (param scale F64)
  (if-expr (> scale 0) (/ (call round (* value scale)) scale) value)
)

(fn-expr + gui-text-search-precision _
  (param box Box)
  (case? (not (?. (. box window) native-window-handle))
    0.5
  )
  (default
    (if-expr (> scale 0) (/ 1 scale) 0.5)
  )
  (where
    (lazy scale (. box device-scale))
  )
)

(fn-expr + scroll-direction-delta Point
  (param direction ScrollDirection)
  (param amount Length)
  (match direction
    (case (. ScrollDirection up)
      (call Point 0 (- amount))
    )
    (case (. ScrollDirection down)
      (call Point 0 amount)
    )
    (case (. ScrollDirection left)
      (call Point (- amount) 0)
    )
    (default
      (call Point amount 0)
    )
  )
)

(type _ GuiLayout (is U8)
  (variant clean)
  (variant children-only)
  (variant self)
  (variant bounds-change)
)

(type _ GUIBoxStyleKeys
  (prop + layout-bit U32)
  (prop + presentation-bit U32)
  (prop + paint-bit U32)
  (blank)
  (prop _ domain-count Size (= 0))
  (prop _ transform-info (? StyleInfo))
  (fn-do + transform (? StyleInfo) :get
    (let found (?? transform-info (call style-info-named "GUIBoxTransform")))
    (= transform-info found)
    (return found)
  )
  (fn-do + refresh _
    (return-if (if (== domain-count (call style-domain-count))))
    (blank)
    (= domain-count (call style-domain-count))
    (= layout-bit (call domain-bit "layout"))
    (= presentation-bit (call domain-bit "presentation"))
    (= paint-bit (call domain-bit "paint"))
  )
  (fn-expr _ domain-bit U32
    (param name String)
    (if-expr (< index 0) 0 (/lshift/ 1u32 (as index Size)))
    (where
      (lazy index (call style-domain-named name))
    )
  )
)

(type _ LayoutIndex
  (prop + children (list LayoutIndexEntry))
  (prop + overflow (list LayoutIndexEntry))
  (prop + dirty-layout-children (list Box))
  (prop + visiting-layout-children (list Box))
  (prop + subtree-bounds Rect)
  (prop + ink-bounds Rect)
  (prop + has-ink-bounds _ (= false))
  (prop + child-list-generation U32)
  (prop + refresh-generation U32)
  (prop + orient _ (= (. Orientation vertical)))
  (prop + is-sequenced _ (= false))
  (prop + valid _ (= false))
  (prop + has-unlisted-dirty _ (= false))
  (fn-do + clear _
    (call (. children clear))
    (call (. overflow clear))
    (call (. dirty-layout-children clear))
    (= ink-bounds (call Rect 0 0 0 0))
    (= has-ink-bounds false)
    (= is-sequenced false)
    (= valid false)
  )
)

(type _ ScrollState
  (prop + position Point)
  (prop + direct-phase U8)
  (prop + momentum-phase U8)
  (prop + indicator-deadline (? Deadline))
  (prop + is-indicator-lingering _ (= false))
  (prop + indicator-fade (? MotionChannel))
  (prop + glide (? ScrollGlide))
  (prop + native-host (? Pointer))
  (prop + native-sync-pass U64)
  (prop + native-sync-context (? NativeGeometryContext))
  (prop + layout-index (? LayoutIndex))
)

(type _ NativeMaterial
  (prop + host Pointer)
  (prop + mask-key (? Outline))
  (prop + mask-zoom F64)
  (prop + mask-dirty _ (= true))
)

(type _ GUIBoxMotionHost
  (implements StyleMotionHost)
  (fn-expr + watch-mask U64
    (param info StyleInfo)
    (call (. gui-style-motion watch-mask) info)
  )
  (fn-do + style-values-changed _
    (param owner MarkupElement)
    (param changes (list StyleValueChange))
    (let box
      (match? owner
        (case (: found Box)
          found
        )
      )
    )
    (return-if (if (not box)))
    (blank)
    (for (in change changes)
      (if (call (. gui-style-motion is-motion-property) change "enter-space")
        (if (not (?? (?. (call markup-attachment box) style-settled) true))
          (call (. box expand-on-entry))
        )
        (else-if (== (. ([] (. change info properties) (. change offset)) name) "display")
          (if (?? (?. (call markup-attachment box) style-settled) true)
            (call (. box display-changed) change)
            (else
              (call (. box sync-display))
            )
          )
        )
        (else-if (call (. gui-style-motion is-motion-property) change "match")
          (call (. box sync-match))
        )
        (else-if (call (. gui-style-motion is-motion-property) change "timeline")
          (call (. box timeline-changed))
        )
        (else
          (call (. gui-style-motion change-value) box change)
        )
      )
    )
  )
  (fn-do + style-node-settled _
    (param owner MarkupElement)
    (if (is owner Box)
      (call (. (as owner Box) entered))
    )
  )
)

(type _ BoxMotionState
  (prop + departure (? BoxDeparture))
  (prop + space F64 (= 1))
  (prop + space-run (? BoxSpaceRun))
  (prop + layout-motion (? BoxLayoutMotion))
  (prop + entering-start (? Duration))
  (prop + stagger-time (? Duration))
  (prop + stagger-count Size (= 0))
  (prop + hiding-info (? StyleInfo))
  (prop + hiding-offset Size (= 0))
  (prop + registered-match (? String))
  (prop + is-match-hidden _ (= false))
  (prop + carry (? BoxCarry))
  (prop + timeline-drive (? BoxTimeline))
  (prop + carry-slot (? Index))
  (prop + carried-child (? Box))
  (prop + lift-order U64)
  (prop + frame-ticks (? FrameTicks))
  (prop + swap (? BoxSwap))
  (prop + scroll-blur (? BoxScrollBlur))
)

(type _ BoxSwap
  (implements FrameAnimation)
  (prop + box Box)
  (prop + from Image)
  (prop + channel _ (= (call MotionChannel (list 0.0) 0.001)))
  (prop + is-over _ (= false))
  (fn-do + This _
    (param box _)
    (param from _)
  )
  (fn-do + advance Bool
    (param tick FrameTick)
    (return-if false (if is-over))
    (blank)
    (call (. channel update) (. tick now))
    (if (. channel is-moving)
      (call (. box invalidate-presentation))
      (return true)
    )
    (= is-over true)
    (call (. box swap-ended) this)
    (return false)
  )
  (fn-do + finish _
    (return-if (if is-over))
    (blank)
    (= is-over true)
    (call (. box swap-ended) this)
  )
  (fn-expr + progress F64 :get
    (call min 1.0 (call max 0.0 ([] (. channel value) 0)))
  )
)

(type _ BoxScrollBlur
  (implements FrameAnimation)
  (prop + box Box)
  (prop + scroller (? Box))
  (prop + travel Point)
  (prop + shown Point)
  (prop + is-over _ (= false))
  (fn-do + This _
    (param box _)
  )
  (fn-do + advance Bool
    (param tick FrameTick)
    (return-if false (if is-over))
    (blank)
    (let moved travel)
    (= travel (call Point 0 0))
    (let kept (call exp (/ (- (as (. tick delta) F64)) (as gui-scroll-blur-fade F64))))
    (let faded (call Point (* (. shown x) kept) (* (. shown y) kept)))
    (let next
      (block
        (case? (>= (+ (* (. moved x) (. moved x)) (* (. moved y) (. moved y))) (+ (* (. faded x) (. faded x)) (* (. faded y) (. faded y))))
          moved
        )
        (default
          faded
        )
      )
    )
    (if (and (== (. moved x) 0) (== (. moved y) 0) (< (call (. box scroll-blur-span) next) gui-scroll-blur-least))
      (= is-over true)
      (call (. box scroll-blur-ended) this)
      (return false)
    )
    (if (or (!= next shown) (!= (. moved x) 0) (!= (. moved y) 0))
      (= shown next)
      (call (. box invalidate-presentation))
    )
    (return true)
  )
  (fn-do + finish _
    (return-if (if is-over))
    (blank)
    (= is-over true)
    (call (. box scroll-blur-ended) this)
  )
)

(type _ BoxDeparture
  (implements FrameAnimation)
  (prop + box Box)
  (prop + ending Doer)
  (prop + is-over _ (= false))
  (fn-do + This _
    (param box _)
    (param ending _)
  )
  (fn-do + advance Bool
    (param tick FrameTick)
    (return-if false (if is-over))
    (return-if true (if (or (. box is-spacing) (call (. gui-style-motion holds) box) (call markup-holds-departures box))))
    (blank)
    (call finish)
    (return false)
  )
  (fn-do + finish _
    (return-if (if is-over))
    (blank)
    (= is-over true)
    (call ending
      (block
        (on-error (: error Error)
          (call unhandled-error error)
        )
      )
    )
  )
)

(type _ BoxLayoutMotion
  (implements FrameAnimation)
  (prop + box Box)
  (prop + place (? MotionChannel))
  (prop + place-target _ (= (call Point 0 0)))
  (prop + size (? MotionChannel))
  (prop + size-target (? Dimensions))
  (prop + reflows _ (= false))
  (prop + reflow-target (? Dimensions))
  (prop + was-sized _ (= false))
  (prop + is-over _ (= false))
  (prop + is-flight _ (= false))
  (prop + cover (? BoxMatchCover))
  (prop + fade (? MotionChannel))
  (fn-do + This _
    (param box _)
  )
  (fn-do + advance Bool
    (param tick FrameTick)
    (return-if false (if is-over))
    (blank)
    (let sized (!= size null))
    (let moving-place place)
    (if moving-place
      (call (. moving-place update) (. tick now))
      (if (not (. moving-place is-moving))
        (= place null)
      )
    )
    (let moving-size size)
    (if moving-size
      (call (. moving-size update) (. tick now))
      (if (not (. moving-size is-moving))
        (= size null)
        (= size-target null)
      )
    )
    (let fading fade)
    (if fading
      (call (. fading update) (. tick now))
      (let alpha ([] (. fading value) 0))
      (if (or (not (. fading is-moving)) (<= alpha 0))
        (call release-cover)
        (else
          (= (?. cover alpha) (call min 1.0 alpha))
        )
      )
      (call (. box invalidate-paint))
    )
    (if is-moving
      (call (. box layout-moved) sized)
      (return true)
    )
    (= is-over true)
    (= was-sized sized)
    (call (. box layout-motion-ended) this)
    (return false)
  )
  (fn-do + finish _
    (return-if (if is-over))
    (blank)
    (= is-over true)
    (= was-sized (!= size null))
    (= place null)
    (= size null)
    (= size-target null)
    (call release-cover)
    (call (. box layout-motion-ended) this)
  )
  (fn-expr + is-moving Bool :get
    (or (!= place null) (!= size null) (!= fade null))
  )
  (fn-expr + offset Point :get
    (if-expr (not moving) zero (call Point (- ([] (. moving value) 0) (. place-target x)) (- ([] (. moving value) 1) (. place-target y))))
    (where
      (lazy moving place)
      (lazy zero (call Point 0 0))
    )
  )
  (fn-expr + shown (? Dimensions) :get
    (if-expr (not moving) null (call Dimensions (call max 0.0 ([] (. moving value) 0)) (call max 0.0 ([] (. moving value) 1))))
    (where
      (lazy moving size)
    )
  )
  (fn-do + cover-with _
    (param shown BoxMatchCover)
    (param motion (? Motion))
    (param now Duration)
    (if (or (not motion) (is motion InstantMotion))
      (call (. shown close))
      (return)
    )
    (let started (call MotionChannel (list 1.0) 0.01))
    (call (. started retarget) (list 0.0) motion now)
    (if (not (. started is-moving))
      (call (. shown close))
      (return)
    )
    (call release-cover)
    (= cover shown)
    (= fade started)
  )
  (fn-do + release-cover _
    (= fade null)
    (call (?. cover close))
    (= cover null)
  )
  (fn-expr + framed Rect
    (param next Rect)
    (if-expr (or (not reflows) (not shown)) next (call Rect (. next x) (. next y) (. shown width) (. shown height)))
    (where
      (lazy shown (. this shown))
    )
  )
  (fn-do + aim-place _
    (param from Point)
    (param to Point)
    (param motion (? Motion))
    (param now Duration)
    (param pace (? Point) (= null))
    (= place-target to)
    (if (or (not motion) (is motion InstantMotion))
      (= place null)
      (return)
    )
    (let current place)
    (if current
      (call (. current retarget) (list (. to x) (. to y)) motion now)
      (return)
    )
    (let started (call MotionChannel (list (. from x) (. from y)) 0.05))
    (if pace
      (call (. started jump) (list (. from x) (. from y)) (list (. pace x) (. pace y)))
    )
    (call (. started retarget) (list (. to x) (. to y)) motion now)
    (= place (only-if started (if (. started is-moving))))
  )
  (fn-do + snap-place _
    (param to Point)
    (= place-target to)
    (= place null)
  )
  (fn-do + aim-size _
    (param from Dimensions)
    (param to Dimensions)
    (param motion (? Motion))
    (param now Duration)
    (param reflow Bool)
    (= reflows reflow)
    (= reflow-target (only-if to (if reflow)))
    (if (or (not motion) (is motion InstantMotion))
      (= size null)
      (= size-target null)
      (return)
    )
    (= size-target to)
    (= was-sized true)
    (let current size)
    (if current
      (call (. current retarget) (list (. to width) (. to height)) motion now)
      (return)
    )
    (let started (call MotionChannel (list (. from width) (. from height)) 0.05))
    (call (. started retarget) (list (. to width) (. to height)) motion now)
    (= size (only-if started (if (. started is-moving))))
    (if (not size)
      (= size-target null)
    )
  )
)

(type _ BoxSpaceRun
  (implements FrameAnimation)
  (prop + box Box)
  (prop + channel MotionChannel)
  (prop + is-over _ (= false))
  (fn-do + This _
    (param box _)
    (param from F64)
    (lazy channel (call MotionChannel (list from) 0.001))
  )
  (fn-do + advance Bool
    (param tick FrameTick)
    (return-if false (if is-over))
    (blank)
    (call (. channel update) (. tick now))
    (call (. box set-space) ([] (. channel value) 0))
    (return-if true (if (. channel is-moving)))
    (blank)
    (= is-over true)
    (call (. box space-moved) this)
    (return false)
  )
  (fn-do + finish _
    (return-if (if is-over))
    (blank)
    (= is-over true)
    (call (. channel jump) (. channel target))
    (call (. box set-space) ([] (. channel value) 0))
    (call (. box space-moved) this)
  )
  (fn-do + aim _
    (param to F64)
    (param motion Motion)
    (param now Duration)
    (call (. channel retarget) (list to) motion now)
  )
)

(type _ BoxCarry
  (implements FrameAnimation)
  (prop + box Box)
  (prop + place MotionChannel)
  (prop + lead (? Box))
  (prop + spot Point)
  (prop + is-over _ (= false))
  (fn-do + This _
    (param box _)
    (param at Point)
    (param lead _)
    (param spot _)
    (lazy place (call MotionChannel (list (. at x) (. at y)) 0.05))
  )
  (fn-do + advance Bool
    (param tick FrameTick)
    (return-if false (if is-over))
    (blank)
    (call (. place update) (. tick now))
    (call (. box carry-moved))
    (return (. place is-moving))
  )
  (fn-do + finish _
    (return-if (if is-over))
    (blank)
    (call (. place jump) (. place target))
    (call (. box carry-moved))
  )
  (fn-expr + top-left Point :get
    (call Point ([] (. place value) 0) ([] (. place value) 1))
  )
  (fn-expr + speed Point :get
    (call Point ([] (. place speed) 0) ([] (. place speed) 1))
  )
  (fn-expr + offset Point :get
    (call Point (- (. local x) (. box bounds x)) (- (. local y) (. box bounds y)))
    (where
      (lazy corner top-left)
      (lazy local (?? (call (?. (. box route-transform) inverse-transform) corner) corner))
    )
  )
  (fn-do + jump _
    (param at Point)
    (param pace Point)
    (call (. place jump) (list (. at x) (. at y)) (list (. pace x) (. pace y)))
    (call (. box carry-moved))
  )
  (fn-do + chase _
    (let leading (?. lead carry-place))
    (return-if (if (or (not leading) is-over)))
    (blank)
    (let clock (. box frame-clock))
    (return-if (if (not clock)))
    (blank)
    (let wanted (call Point (+ (. leading x) (. spot x)) (+ (. leading y) (. spot y))))
    (if (or (!= ([] (. place target) 0) (. wanted x)) (!= ([] (. place target) 1) (. wanted y)))
      (call (. place retarget) (list (. wanted x) (. wanted y)) gui-carry-trail (. clock now))
    )
    (if (. place is-moving)
      (call (. clock start) box this)
    )
  )
)

(type _ BoxTimeline
  (implements ClipWatcher)
  (prop + box Box)
  (prop + run KeyframeRun)
  (prop + timeline AnimationTimeline)
  (blank)
  (prop _ host (? WindowHost))
  (fn-do + This _
    (param box _)
    (param run _)
    (param timeline _)
  )
  (fn-do + clip-changed _
    (param scrolled (? Box))
    (return-if (if (and scrolled (!= (as scrolled Pointer) (as (call (. timeline scroller) box) (? Pointer))))))
    (blank)
    (call scrub)
  )
  (fn-do + follow _
    (param next AnimationTimeline)
    (= timeline next)
    (let wanted (only-if (. box window-host) (if (. timeline follows-scrolling))))
    (if (!= (as wanted (? Pointer)) (as host (? Pointer)))
      (call (?. host unwatch-clip) this)
      (call (?. wanted watch-clip) this)
      (= host wanted)
    )
    (call scrub)
  )
  (fn-do + stop _
    (call (?. host unwatch-clip) this)
    (= host null)
  )
  (fn-do + scrub _
    (if (. run is-done)
      (call stop)
      (return)
    )
    (call (. run scrub) (call (. timeline progress) box))
  )
)

(fn-do + gui-record-paint-invalidations _
  (+= gui-paint-recording-depth 1)
)

(fn-do + gui-replay-paint-invalidations _
  (-= gui-paint-recording-depth 1)
  (return-if (if (or (> gui-paint-recording-depth 0) (== (. gui-paint-recorded length) 0))))
  (blank)
  (let recorded gui-paint-recorded)
  (= gui-paint-recorded (call (of List Box)))
  (for (in box recorded)
    (call (. box replay-paint-invalidation))
  )
)

(fn-expr _ gui-retained-paint-link-generation _
  (+ gui-tree-structure-generation gui-retained-paint-clear-generation)
)

(fn-expr _ gui-shifted-rect _
  (param rect Rect)
  (param delta Point)
  (call Rect (+ (. rect x) (. delta x)) (+ (. rect y) (. delta y)) (. rect width) (. rect height))
)

(fn-do _ clear-transparent-paint-state-within _
  (param node GuiNode)
  (let child (. node %first-child))
  (while child
    (let current child)
    (if (is current Box)
      (let box (as current Box))
      (if (. box is-markup-shadow)
        (call (. box clear-retained-paint-invalidation))
        (= (. box $is-paint-invalid) false)
        (= (. box $is-paint-invalid-below) false)
        (call clear-transparent-paint-state-within box)
      )
      (else-if (. current is-gui-transparent)
        (call clear-transparent-paint-state-within current)
      )
    )
    (= child (. current %next-sibling))
  )
)

(fn-do _ clear-transparent-layout-state _
  (param node GuiNode)
  (let child (. node %first-child))
  (while child
    (let current child)
    (if (is current Box)
      (let box (as current Box))
      (if (. box is-markup-shadow)
        (= (. box $is-layout-invalid) false)
        (= (. box $is-layout-invalid-below) false)
        (call clear-transparent-layout-state box)
      )
      (else-if (. current is-gui-transparent)
        (call clear-transparent-layout-state current)
      )
    )
    (= child (. current %next-sibling))
  )
)

(fn-expr _ gui-event-requires-enabled Bool
  (param event GUIRoutedEvent)
  (match event
    (case PointerDownEvent
      true
    )
    (case PointerUpEvent
      true
    )
    (case PointerMoveEvent
      true
    )
    (case PointerDragEvent
      true
    )
    (case ClickEvent
      true
    )
    (case TouchEvent
      true
    )
    (case MagnifyEvent
      true
    )
    (default
      false
    )
  )
)

(fn-do _ gui-next-lift U64
  (+= gui-lift-count 1)
  (return gui-lift-count)
)
