(blank)
(prop + gui-pixel-scale F64)
(blank)
(prop _ scroll-glide-precision _ (= 0.1))
(prop _ gui-layout-position _ (= (call LayoutPosition)))
(prop _ gui-arrange-cause (? MarkupCause))
(prop _ gui-arrange-again _ (= false))
(prop _ gui-box-hidden-dirty-bit U8 (= 16))
(prop _ gui-box-inline-limit-bit U8 (= 1))
(prop _ gui-box-block-limit-bit U8 (= 2))
(prop _ gui-box-inline-exact-bit U8 (= 4))
(prop _ gui-box-block-exact-bit U8 (= 8))
(prop _ gui-box-layout-kind-mask U8 (= 96))
(prop _ gui-box-shaped-hit-bit U8 (= 128))
(prop _ gui-composite-mounted-bit U8 (= 1))
(prop _ gui-composite-registered-bit U8 (= 2))
(prop _ gui-composite-routed-bit U8 (= 4))
(prop _ gui-composite-relevant-bit U8 (= 8))
(prop _ gui-composite-scope-bit U8 (= 16))
(prop _ gui-composite-visible-bit U8 (= 32))
(prop _ gui-composite-shape-bits U8 (= 48))
(prop _ gui-composite-pinned-bit U8 (= 64))
(prop _ gui-scroll-pinned-boxes _ (= (call (of List Box))))
(prop _ gui-scroll-blur-least Length (= 1.5))
(prop _ gui-scroll-blur-most Length (= 40))
(prop _ gui-scroll-blur-fade Nanoseconds (= 30000000ns))
(prop _ gui-tree-structure-generation U64)
(prop _ gui-lift-count U64)
(prop _ gui-carry-trail _ (= (call spring 150ms)))
(prop _ gui-stagger-steps Size (= 8))
(prop _ gui-retained-paint-clear-generation U64 (= 1))
(prop _ gui-retained-dirty-child-limit Size (= 32))
(prop _ gui-paint-recording-depth Size (= 0))
(prop _ gui-paint-recorded (list Box))
(prop _ gui-native-artifact-peer U8 (= 1))
(prop _ gui-native-artifact-clip U8 (= 2))
(prop _ gui-native-artifact-material U8 (= 4))
(prop _ gui-box-style-keys _ (= (call GUIBoxStyleKeys)))
(prop _ gui-measure-axis-available-bit U8 (= 16))
(prop _ gui-measure-axis-max-bit U8 (= 32))
(prop _ gui-layout-index-child-threshold Size (= 2))
(blank)
(type-line _ PackedAxisQuery (is (tuple (: min F32) (: available F32) (: max F32))))
(type-line _ PackedQuery (is (tuple (: i-flags U8) (: b-flags U8) (: inline PackedAxisQuery) (: block PackedAxisQuery))))
(type-line _ PackedDimensions (is (tuple (: width F32) (: height F32))))
(type-line _ PackedMeasureValue (is (tuple (: content PackedDimensions) (: border PackedDimensions) (: outer PackedDimensions))))
(type-line _ PackedMeasureCacheEntry (is (tuple (: query PackedQuery) (: result PackedMeasureValue) (: generation U32))))
(type-line _ LayoutIndexEntry (is (tuple (: child Box) (: order Index))))
(type-line _ NativeGeometryContext (is (tuple (: origin Point) (: parent (? Pointer)) (: visible Bool) (: transform (? Matrix)))))
(blank)

(main
  (call style-set-motion-host (call GUIBoxMotionHost))
  (call (. gui-style-motion watch-mounts))
)

(type + Box (is GuiNode)
  (implements KeyScopeNode)
  (implements StyleMotionOwner)
  (implements EventNode)
  (using GUIDefaultTheme)
  (using GUIMotionTheme)
  (using GUIShorthandsTheme)
  (using GUIBoxPaint)
  (using GUITextPaint)
  (using GUIFontStyle)
  (using GUIParagraphStyle)
  (using GUITextComposition)
  (using GUIBoxDisplay)
  (using GUIBoxCursor)
  (using GUIBoxComposite)
  (using GUIBoxWindowDrag)
  (using GUIBoxPlacement)
  (using GUIBoxSpacing)
  (using GUIBoxSize)
  (using GUIBoxLayout)
  (using VectorPaintStyle)
  (using GUIBoxTransform)
  (using GUIBoxMotion)
  (prop + inner-width Length)
  (prop + inner-height Length)
  (prop + input-generation U32)
  (prop + is-hovered _ (= false))
  (prop + is-hover-within _ (= false))
  (prop + is-pressed _ (= false))
  (prop + is-press-within _ (= false))
  (prop + is-enabled _ (= true))
  (prop + is-effectively-enabled _ (= true))
  (prop + is-entering _ (= true))
  (prop + is-leaving _ (= false))
  (prop + is-released _ (= false))
  (prop + is-flying _ (= false))
  (prop + is-carried _ (= false))
  (prop + has-spaced-children _ (= false))
  (prop + has-rigid-flex-children _ (= false))
  (prop + x _ (=> (. bounds x)))
  (prop + y _ (=> (. bounds y)))
  (prop + width _ (=> (. bounds width)))
  (prop + height _ (=> (. bounds height)))
  (prop + inner-size _ (=> (call Dimensions inner-width inner-height)))
  (prop + is-window-root _ (=> false))
  (prop + is-presentation-layer _ (=> false))
  (prop + presentation-native-host (? Pointer) (=> null))
  (prop + painted-shadow (? Shadow) (=> $shadow))
  (prop + presentation-origin _ (=> (. bounds top-left)))
  (prop + is-markup-shadow _ (=> false))
  (prop + is-gui-transparent _ (=> is-markup-shadow))
  (prop + is-layout-placed-by-parent _ (=> is-markup-shadow))
  (prop + is-layout-boundary _ (=> false))
  (prop + stagger-host (? Box) (=> this))
  (prop + match-key (? String) (=> registered-match))
  (prop + inline-ascent (? Length) (=> null))
  (prop + inline-outset _ (=> (call Dimensions 0 0)))
  (prop + is-style-shadow _ (=> (call markup-is-style-shadow this)))
  (prop + intrinsic-size _ (=> (. (call measure) border-size)))
  (prop + outer-intrinsic-size _ (=> (. (call measure) outer-size)))
  (prop + measured-outer-size _ (=> (. (call measure) outer-size)))
  (prop + has-inline-limits _ (=> (call has-state-bit gui-box-inline-limit-bit)))
  (prop + has-block-limits _ (=> (call has-state-bit gui-box-block-limit-bit)))
  (prop + has-exact-inline-size _ (=> (call has-state-bit gui-box-inline-exact-bit)))
  (prop + has-exact-block-size _ (=> (call has-state-bit gui-box-block-exact-bit)))
  (prop + carry-slot _ (=> (?. motion-state carry-slot)))
  (prop + carried-child _ (=> (?. motion-state carried-child)))
  (prop + lift-order _ (=> (?? (?. motion-state lift-order) 0)))
  (prop + native-window-handle (? Pointer) (=> null))
  (prop + text-input-context (? TextInputContext) (=> null))
  (prop + undo-target (? UndoTarget) (=> null))
  (prop + has-horizontal-overflow _ (=> (> inner-width (. content-bounds width))))
  (prop + has-vertical-overflow _ (=> (> inner-height (. content-bounds height))))
  (prop + has-overflow _ (=> (or has-horizontal-overflow has-vertical-overflow)))
  (blank)
  (depends own-enabled-changed is-enabled)
  (blank)
  (event + pointer-down PointerDownEvent)
  (event + pointer-up PointerUpEvent)
  (event + pointer-move PointerMoveEvent)
  (event + modifiers-changed ModifiersChangedEvent)
  (event + pointer-drag PointerDragEvent)
  (event + scroll ScrollEvent)
  (event + magnify MagnifyEvent)
  (event + touch TouchEvent)
  (event + scroll-changed ScrollChangedEvent)
  (event + click ClickEvent)
  (event + key-press KeyPressEvent)
  (event + key-release KeyReleaseEvent)
  (event + key-input KeyInputEvent)
  (event + text-command TextCommandEvent)
  (event + text-composition TextCompositionEvent)
  (event + copy CopyEvent)
  (event + cut CutEvent)
  (event + paste PasteEvent)
  (event + drag-start DragStartEvent)
  (event + drag-over DragOverEvent)
  (event + drag-leave DragSession)
  (event + drop DragSession)
  (event + drag-end DragEnd)
  (blank)
  (prop _ child-list-generation U32)
  (prop _ retained-child-list-revision U32)
  (prop _ cached-root (? Box))
  (prop _ root-generation U64)
  (prop _ state-bits U8)
  (prop _ measure-generation U32)
  (prop _ measure-cache (? PackedMeasureCacheEntry))
  (prop _ prior-measure-cache (? PackedMeasureCacheEntry))
  (prop _ arranged-bounds _ (= (call Rect 0 0 0 0)))
  (prop _ active-first-child (? Box))
  (prop _ active-next (? Box))
  (prop _ active-list-child-list-generation U32)
  (prop _ scroll-state (? ScrollState))
  (prop _ retained-paint-self-invalid _ (= true))
  (prop _ retained-paint-invalid-below _ (= true))
  (prop _ retained-dirty-children (? (list Box)))
  (prop _ tracks-retained-dirty-children _ (= false))
  (prop _ retained-paint-link-generation U64)
  (prop _ retained-scroll-only-invalidation _ (= false))
  (prop _ retained-move-only-invalidation _ (= false))
  (prop _ retained-transform-only-invalidation _ (= false))
  (prop _ retained-presentation-invalid _ (= false))
  (prop _ retained-scene-node Pointer)
  (prop _ retained-scene-generation U32)
  (prop _ native-artifact-kinds U8)
  (prop _ native-artifact-window (? Pointer))
  (prop _ native-visit-pass U64)
  (prop _ native-material (? NativeMaterial))
  (prop _ held-background-image (? Image))
  (prop _ composite-bits U8)
  (prop _ composite-record (? CompositeBoxState))
  (prop _ layout-cause _ (= markup-cause-none))
  (prop _ arranged-rel _ (= (call Point 0 0)))
  (prop _ is-arranged _ (= false))
  (prop _ slot-axis U8)
  (prop _ last-display _ (= (. Display visible)))
  (prop _ motion-state (? BoxMotionState))
  (prop _ hidden-dirty-below _ (=> (call has-state-bit gui-box-hidden-dirty-bit)))
  (prop _ layout-invalidation-kind _ (=> (/and/ (/rshift/ state-bits 5) 3)))
  (prop _ departure _ (=> (?. motion-state departure)))
  (prop _ space _ (=> (?? (?. motion-state space) 1.0)))
  (prop _ space-run _ (=> (?. motion-state space-run)))
  (prop _ layout-motion _ (=> (?. motion-state layout-motion)))
  (prop _ entering-start _ (=> (?. motion-state entering-start)))
  (prop _ hiding-info _ (=> (?. motion-state hiding-info)))
  (prop _ hiding-offset _ (=> (?? (?. motion-state hiding-offset) 0)))
  (prop _ registered-match _ (=> (?. motion-state registered-match)))
  (prop _ is-match-hidden _ (=> (?? (?. motion-state is-match-hidden) false)))
  (prop _ carry _ (=> (?. motion-state carry)))
  (prop _ timeline-drive _ (=> (?. motion-state timeline-drive)))
  (fn-do + gui-child-list-changed _
    (+= child-list-generation 1)
    (+= retained-child-list-revision 1)
    (= retained-move-only-invalidation false)
    (= retained-transform-only-invalidation false)
    (= $is-active-list-invalid true)
    (call invalidate-layout-index-chain)
    (call invalidate-child-list)
  )
  (fn-do + close _ (?! Error)
    (call hold-background-image null)
    (call (. super close))
  )
  (fn-expr + key-scope-parent (? KeyScopeNode) :get
    material-parent
  )
  (fn-expr + is-key-scope Bool :get
    (call focus-mode-contributes-shortcuts $focus-mode)
  )
  (fn-expr + is-motion-visible Bool :get
    is-paint-visible
  )
  (fn-expr + motion-start (? Duration) :get
    entering-start
  )
  (fn-do + snaps-motion Bool :get
    (let cursor (? Box) this)
    (while cursor
      (let box cursor)
      (return-if true (if (. box is-entering)))
      (return-if false (if (. box is-presentation-layer)))
      (blank)
      (= cursor (. box material-parent))
    )
    (return false)
  )
  (fn-do + drive-timeline Bool
    (param run KeyframeRun)
    (let timeline $timeline)
    (return-if false (if (not timeline)))
    (blank)
    (call (?. timeline-drive stop))
    (let drive (call BoxTimeline this run timeline))
    (= (. motion-state-for-write timeline-drive) drive)
    (call (. drive follow) timeline)
    (return true)
  )
  (fn-do + event-parent (? EventNode) :get
    (let cursor material-parent)
    (while cursor
      (let box cursor)
      (return-if box (if (not (. box is-markup-shadow))))
      (blank)
      (= cursor (. box material-parent))
    )
  )
  (fn-expr + indexed-dirty-layout-children _ :get
    (match current-layout-index
      (case= null
        null
      )
      (case? (== (. it dirty-layout-children length) 0)
        null
      )
      (default
        (. it dirty-layout-children)
      )
    )
  )
  (fn-do + material-parent _ :get
    (let cursor (?. markup-attachment-cache structural-parent))
    (while cursor
      (let link cursor)
      (let host (. link host))
      (return-if (as host Box) (if (is host Box)))
      (blank)
      (= cursor (. link structural-parent))
    )
  )
  (fn-do + rendered-children (list Box) :get
    (for (in node rendered-nodes (when (is node Box)))
      (yield (as node Box))
    )
  )
  (fn-expr + retained-rendered-first-child _ :get
    (call gui-rendered-resolve this %first-child)
  )
  (fn-expr + retained-rendered-last-child _ :get
    (call gui-rendered-reverse-resolve this %last-child)
  )
  (fn-expr + retained-child-list-generation _ :get
    retained-child-list-revision
  )
  (fn-expr + is-retained-paint-invalid _ :get
    retained-paint-self-invalid
  )
  (fn-expr + is-retained-paint-invalid-below _ :get
    retained-paint-invalid-below
  )
  (fn-expr + is-retained-scroll-only-invalidation _ :get
    retained-scroll-only-invalidation
  )
  (fn-expr + is-retained-move-only-invalidation _ :get
    retained-move-only-invalidation
  )
  (fn-expr + is-retained-transform-only-invalidation _ :get
    retained-transform-only-invalidation
  )
  (fn-expr + is-retained-presentation-invalid _ :get
    retained-presentation-invalid
  )
  (fn-expr + retained-paint-dirty-child-count _ :get
    (case? (and tracks-retained-dirty-children retained-dirty-children)
      (. retained-dirty-children length)
    )
    (default
      0
    )
  )
  (fn-expr + retained-display-layout-bounds _ :get
    (match current-layout-index
      (case= null
        bounds
      )
      (case? (. it has-ink-bounds)
        (+ (. it subtree-bounds) (. it ink-bounds))
      )
      (default
        (. it subtree-bounds)
      )
    )
  )
  (fn-expr + retained-layout-index-generation _ :get
    (?. current-layout-index refresh-generation)
  )
  (fn-expr + layout-space F64 :get
    space
  )
  (fn-expr + is-spacing Bool :get
    (!= space-run null)
  )
  (fn-do + shown-frame (? Rect) :get
    (let motion layout-motion)
    (let shown (?. motion shown))
    (let cut (and (< space 1) (not is-released) (!= slot-axis 0)))
    (return-if null (if (and (not shown) (not cut))))
    (return-if null (if (!= $resize-content (. ResizeContent reveal))))
    (blank)
    (let width (?? (?. shown width) (. bounds width)))
    (let height (?? (?. shown height) (. bounds height)))
    (if (and cut (== slot-axis 1))
      (= width (call min width (* (. bounds width) space)))
    )
    (if (and cut (== slot-axis 2))
      (= height (call min height (* (. bounds height) space)))
    )
    (return (call Rect (. bounds x) (. bounds y) (call max 0.0 width) (call max 0.0 height)))
  )
  (fn-expr + is-layout-moving Bool :get
    (?? (?. layout-motion is-moving) false)
  )
  (fn-expr + lifted-frame Rect :get
    (?? (call (?. route-transform transform) local) local)
    (where
      (lazy shift (?? (?. carry offset) (?. layout-motion offset) (call Point 0 0)))
      (lazy base (?? shown-frame bounds))
      (lazy local (call Rect (+ (. base x) (. shift x)) (+ (. base y) (. shift y)) (. base width) (. base height)))
    )
  )
  (fn-expr + carry-place (? Point) :get
    (?. carry top-left)
  )
  (fn-expr + carried-center (? Point) :get
    (if-expr (not running) null (call Point center-x (+ (. bounds y) (. shift y) (/ (. bounds height) 2))))
    (where
      (lazy running carry)
      (lazy shift (. running offset))
      (lazy center-x (+ (. bounds x) (. shift x) (/ (. bounds width) 2)))
    )
  )
  (fn-expr + is-flight-routable Bool :get
    (and (or is-flying (!= carry null)) (== presentation-layer null))
  )
  (fn-expr + is-flight-routed Bool :get
    (and is-flight-routable is-composite-routed)
  )
  (fn-expr + presented-frame Rect :get
    (?? (call (?. matrix transform) frame) frame)
    (where
      (lazy frame (?? shown-frame bounds))
      (lazy own painted-transform)
      (lazy route (if-expr is-flight-routed null route-transform))
      (lazy matrix (if-expr (and route own) (call (. route concatenate) own) (?? route own)))
    )
  )
  (fn-expr + painted-transform (? Matrix) :get
    (case? (not is-flight-routed)
      own
    )
    (case? (not route)
      own
    )
    (case? (not own)
      route
    )
    (default
      (call (. route concatenate) own)
    )
    (where
      (lazy own presentation-transform)
      (lazy route route-transform)
    )
  )
  (fn-do + route-transform (? Matrix) :get
    (let matrix (? Matrix) null)
    (let cursor material-parent)
    (while cursor
      (let ancestor cursor)
      (return-if matrix (if (or (. ancestor is-window-root) (. ancestor is-presentation-layer))))
      (blank)
      (if (not (. ancestor is-markup-shadow))
        (let step (. ancestor child-space-transform))
        (if step
          (= matrix (if-expr matrix (call (. step concatenate) matrix) step))
        )
        (return-if matrix (if (. ancestor is-flight-routed)))
      )
      (= cursor (. ancestor material-parent))
    )
    (return matrix)
  )
  (fn-expr + composite-state _ :get
    composite-record
  )
  (fn-expr + is-composite-routed _ :get
    (!= (/and/ composite-bits gui-composite-routed-bit) 0)
  )
  (fn-expr + is-composite-relevant _ :get
    (!= (/and/ composite-bits gui-composite-relevant-bit) 0)
  )
  (fn-expr + is-composite-host _ :get
    (or (!= (?. composite-record below) null) (!= (?. composite-record above) null))
  )
  (fn-expr + composite-host _ :get
    (?. composite-record host)
  )
  (fn-expr + composite-layers _ :get
    (?. composite-record layers)
  )
  (fn-do + declared-layer-list _ :get
    (let record composite-record-for-write)
    (if (not (. record layers))
      (= (. record layers) (call (of List Layer)))
    )
    (return (!! (. record layers)))
  )
  (fn-expr + is-composite-scope _ :get
    (or is-window-root is-presentation-layer clips-content is-translucent has-layer-filters)
    (where
      (lazy is-translucent (< computed-opacity 1%%))
    )
  )
  (fn-expr + has-native-material _ :get
    (!= (/and/ native-artifact-kinds gui-native-artifact-material) 0)
  )
  (fn-expr + native-clip-host _ :get
    (case? (not scroll-state)
      null
    )
    (default
      (. scroll-state native-host)
    )
  )
  (fn-expr + frame-clock (? FrameClock) :get
    (?. window-host window-clock)
  )
  (fn-expr + bounds _ :get
    arranged-bounds
  )
  (fn-expr + margin-edges _ :get
    (. (call Insets $margin-top $margin-right $margin-bottom $margin-left) clamped)
  )
  (fn-expr + padding-edges _ :get
    (. (call Insets $padding-top $padding-right $padding-bottom $padding-left) clamped)
  )
  (fn-expr + border-edges _ :get
    (. (call (. $border border-insets) this) clamped)
  )
  (fn-expr + padding-bounds _ :get
    (call (. bounds inset) (. border-edges clamped))
  )
  (fn-do + content-bounds _ :get
    (let content unreserved-content-bounds)
    (return-if content (if (!= $scroll-indicator-gutter (. ScrollIndicatorGutter stable))))
    (blank)
    (let thickness (call min $scroll-indicator-thickness (call min (. content width) (. content height))))
    (let reserve-right Length)
    (if (call reserves-scroll-indicator (. Orientation vertical))
      (= reserve-right thickness)
    )
    (let reserve-bottom Length)
    (if (call reserves-scroll-indicator (. Orientation horizontal))
      (= reserve-bottom thickness)
    )
    (return
      (call Rect
        (block
          (arg (. content x))
          (arg (. content y))
          (arg (call max 0 (- (. content width) reserve-right)))
          (arg (call max 0 (- (. content height) reserve-bottom)))
        )
      )
    )
  )
  (fn-expr + clips-content _ :get
    (or clips-x clips-y (!= shown-frame null))
    (where
      (lazy clips-x (or (== $overflow-x (. ScrollOverflow clip)) (call is-scroll-axis-enabled (. Orientation horizontal))))
      (lazy clips-y (or (== $overflow-y (. ScrollOverflow clip)) (call is-scroll-axis-enabled (. Orientation vertical))))
    )
  )
  (fn-expr + content-offset _ :get
    (call device-aligned scroll-position)
  )
  (fn-expr + device-scale F64 :get
    (?? (?. window-host backing-scale) 1)
  )
  (fn-expr + native-zoom F64 :get
    (?? (?. window-host effective-zoom) 1)
  )
  (fn-expr + native-content-rect _ :get
    (call Rect
      (block
        (arg 0)
        (arg 0)
        (arg (call max (. viewport width) (- inner-width (. origin x))))
        (arg (call max (. viewport height) (- inner-height (. origin y))))
      )
    )
    (where
      (lazy viewport content-bounds)
      (lazy origin content-origin)
    )
  )
  (fn-do + presentation-layer _ :get
    (let cursor (? Box) this)
    (while cursor
      (return-if cursor (if (. cursor is-presentation-layer)))
      (blank)
      (= cursor (. cursor material-parent))
    )
    (return null)
  )
  (fn-expr + outer-bounds _ :get
    (call (. bounds outset) (. margin-edges clamped))
  )
  (fn-expr + is-displayed _ :get
    (!= $display (. Display hidden))
  )
  (fn-expr + has-arrangement _ :get
    is-arranged
  )
  (fn-expr + is-display-visible _ :get
    (and (== $display (. Display visible)) (not is-match-hidden))
  )
  (fn-expr + is-paint-visible Bool :get
    (and is-display-visible (?? (?. (. this material-parent) is-paint-visible) true))
  )
  (fn-expr + is-input-visible Bool :get
    (and is-steady (?? (?. (. this material-parent) is-input-visible) true))
    (where
      (lazy is-steady (and is-display-visible (not is-leaving) (not is-flying) (not carry)))
    )
  )
  (fn-do + effective-position _ :get
    (return? $position)
    (return gui-layout-position)
  )
  (fn-do + layout-parent _ :get
    (let maybe-parent (. this material-parent))
    (while (and maybe-parent (. maybe-parent is-markup-shadow))
      (= maybe-parent (. maybe-parent material-parent))
    )
    (return maybe-parent)
  )
  (fn-do + root _ :get
    (return-if cached-root (if (and cached-root (== root-generation gui-tree-structure-generation))))
    (blank)
