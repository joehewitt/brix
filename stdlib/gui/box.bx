      (let middle (/ (+ low high) 2))
      (let bounds (. ([] (. index children) middle) child bounds))
      (let end (if-expr (== (. index orient) (. Orientation horizontal)) (. bounds right) (. bounds bottom)))
      (if (<= end coordinate)
        (= low (+ middle 1))
