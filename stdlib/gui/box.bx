      (let end (if-expr (== (. index orient) (. Orientation horizontal)) (. found right) (. found bottom)))
      (return-if low (if (and (>= coordinate start) (<= coordinate end))))
    )
    (blank)
    (if (> low 0)
      (let previous (. ([] (. index children) (- low 1)) child bounds))
      (let start (if-expr (== (. index orient) (. Orientation horizontal)) (. previous left) (. previous top)))
      (let end (if-expr (== (. index orient) (. Orientation horizontal)) (. previous right) (. previous bottom)))
