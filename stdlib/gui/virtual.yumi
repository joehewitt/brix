. slot-index Index
. cursor = %first-child?.%first-child
while cursor
    . root = cursor as VirtualSlotRoot'VItem
    . placement = recycler.placement-for-slot(slot-index)
    if placement && !placement.is-sticky && !root.is-sticky && !(followers has slot-index)
        . rect = placement-rect(placement, content)
        . shift = root.arranged-shift(rect)
        if shift
            leads += (rect.y, shift)
    cursor = cursor.%next-sibling
    slot-index += 1
= leads

────────────────────
_ do glide-followers
    - leads [VirtualGlideLead]
    - content Rect

. rise = if glide-delta < 0vcoord then virtual-length(glide-delta) else 0
. slot-index Index
. cursor = %first-child?.%first-child
while cursor
    . root = cursor as VirtualSlotRoot'VItem
    . placement = recycler.placement-for-slot(slot-index)
    if placement && !placement.is-sticky && followers has slot-index
        . shift = virtual-glide-shift(leads, placement-rect(placement, content).y, rise)
        if shift
            root.glide-from(Point(-shift.x, -shift.y))
    cursor = cursor.%next-sibling
    slot-index += 1

────────────────────
_ do settle-glide
    - content Rect

. last = glided-size
glided-size = bounds.size
if recycler.has-pending-revision
    glide-delta = 0vcoord
    glide-reach = 0vcoord
    . motion = row-glide-motion()
    follows-glides = motion != null
    =? if !motion
    if last.width == bounds.width && last.height > 0
        glide-size-from(last, motion)
    . limit = virtual-ceil(content.height) * virtual-glide-screens
    . natural = natural-extent().height - top-inset
    if natural <= 0
        glide-reach = limit
    else
        glide-delta = virtual-ceil(natural) - virtual-extent-y.known
        glide-reach = min(virtual-distance(glide-delta, 0vcoord), limit)
else if glide-reach > 0vcoord && !rows-moving()
    glide-reach = 0vcoord

────────────────────
_ do row-glide-motion Motion?

. cursor = %first-child?.%first-child
while cursor
    . root = cursor as VirtualSlotRoot'VItem
    =? root.position-motion() if root.slot.is-bound && !root.is-sticky
    cursor = cursor.%next-sibling
= null

────────────────────
_ do rows-moving Bool

. cursor = %first-child?.%first-child
while cursor
    . root = cursor as VirtualSlotRoot'VItem
    =? true if root.is-layout-moving
    cursor = cursor.%next-sibling
= false

────────────────────
_ glide-retention VirtualInsets
    - window VirtualWindow

|? glide-reach <= 0vcoord
    retention
??
    VirtualInsets
        - max(retention.top, window.overscan-top + glide-reach)
        - retention.right
        - max(retention.bottom, window.overscan-bottom + glide-reach)
        - retention.left

────────────────────
_ placement-rect
    - placement VirtualPlacement
    - content Rect

Rect(x, y, width, height)

.. x = content.x + virtual-length(placement.x - anchor-x)
.. y = content.y + top-inset + virtual-length(placement.y - anchor-y)
.. width = virtual-length(placement.width)
.. height = virtual-length(placement.height)

────────────────────
_ window-holds Bool

!source || !virtual-layout || holds-window(view-window(visible-view(content-bounds)))

────────────────────
_ holds-window Bool
    - view VirtualRect

|? virtual-distance(view.x, anchor-x) > virtual-anchor-span
    false
|? virtual-distance(view.y, anchor-y) > virtual-anchor-span
    false
??
    recycler.holds(view.x, view.y, view.width, view.height)

────────────────────
_ view-window VirtualRect
    - view Rect

VirtualRect(start-x, start-y, width, height)

.. start-x = virtual-floor(scroll-x + view.x)
.. start-y = virtual-floor(top + view.y)
.. width = virtual-ceil(scroll-x + view.right) - start-x
.. height = virtual-ceil(top + view.bottom) - start-y
.. top = scroll-y - top-inset

────────────────────
_ do watch-clip-host

=? if clip-host
. host = window-host
=? if !host
clip-host = host
host.watch-clip(this)

────────────────────
_ do visible-view Rect
    - content Rect

. visible = content
. shift-x Length = 0
. shift-y Length = 0
. cursor = this.material-parent
while cursor
    . ancestor = cursor
    cursor = ancestor.material-parent
    if !ancestor.is-markup-shadow
        . offset = ancestor.content-offset
        visible = Rect(visible.x - offset.x, visible.y - offset.y, visible.width, visible.height)
        shift-x += offset.x
        shift-y += offset.y
        if ancestor.clips-content
            visible = virtual-clipped-rect(visible, ancestor.content-bounds)
    if ancestor.is-presentation-layer || !cursor
        visible = virtual-clipped-rect(visible, ancestor.bounds)
        cursor = null
= Rect
    - visible.x + shift-x - content.x
    - visible.y + shift-y - content.y
    - visible.width
    - visible.height

────────────────────
_ do sticky-line-offset Length

=? sticky-inset if scroll-axis-maximum(Orientation.vertical) > 0
. content = content-bounds
. shift Length = 0
. cursor = this.material-parent
while cursor
    . ancestor = cursor
    if !ancestor.is-markup-shadow
        shift += ancestor.content-offset.y
        if ancestor.is-scroll-axis-enabled(Orientation.vertical)
            = ancestor.content-bounds.y + sticky-inset - content.y - top-inset + shift
    =? sticky-inset if ancestor.is-presentation-layer
    cursor = ancestor.material-parent
= sticky-inset

────────────────────
+ do virtual-slot-departing
    - slot-index Index

for index in 0 .. < followers.length
    if followers[index] == slot-index
        followers.remove(index)
        break
. root = root-at(slot-index)
=? if !root
root.input-generation += 1
root.window-host?.release-input-inside(root)

────────────────────
+ do virtual-slot-arriving
    - slot-index Index

if recycler.is-revision-change
    followers += slot-index
. root = root-at(slot-index)
if root
    gui-style-motion.restart-within(root)
    root.forget-arrangement()
    if recycler.is-revision-change
        root.enter-subtree()

────────────────────
+ do clip-changed
    - scrolled Box?

=? if is-arranging || awaits-arrange || !source || !virtual-layout
=? if scrolled && scrolled as Pointer == this as Pointer
. view = view-window(visible-view(content-bounds))
if has-sticky-rows && sticky-line-offset() != arranged-sticky-offset
    invalidate-bindings()
    =
=? if view == arranged-window
if !holds-window(view)
    invalidate-bindings()

────────────────────
+ get markup-query-boundary

true

────────────────────
+ do mounted

super.mounted()
watch-clip-host()

────────────────────
+ do unmounted

clip-host?.unwatch-clip(this)
clip-host = null
super.unmounted()

────────────────────
+ get native-content-rect

native-rows

────────────────────
+ get content-offset

Point(shown.x - virtual-length(anchor-x), shown.y - virtual-length(anchor-y))

.. shown = device-aligned(scroll-position)

────────────────────
+ do scroll-bounds-visible
    - rect Rect
    - alignment ScrollAlignment = ScrollAlignment.nearest
    - margin Insets = Insets(0, 0, 0, 0)
    - cause ScrollCause = ScrollCause.ensure-visible

. clear = Insets(margin.top + top-inset, margin.right, margin.bottom, margin.left)
= super.scroll-bounds-visible(rect, alignment, clear, cause)

────────────────────
+ scroll-indicator-track-bounds
    - axis Orientation

if axis == Orientation.horizontal then track else Rect(track.x, track.y + covered, track.width, track.height - covered)

.. track = super.scroll-indicator-track-bounds(axis)
.. covered = min(top-inset, track.height)

────────────────────
+ do measured-content-size
    - query MeasureQuery

natural-size = natural-extent()
= natural-size

────────────────────
+ do arrange-positioned-children

super.arrange-positioned-children()
arrange-virtual-content()

────────────────────
+ do did-layout

super.did-layout()
if rebinds-after-layout
    rebinds-after-layout = false
    invalidate-bindings()

━━━━━━━━━━━━━━━━━━━━
_ virtual-sticky-layer
    - depth Index

"virtual-sticky-${min(depth, virtual-sticky-depths - 1)}"

━━━━━━━━━━━━━━━━━━━━
_ virtual-sticky-layer-names

** 0 .. < virtual-sticky-depths
*> virtual-sticky-layer(virtual-sticky-depths - 1 - each)
|> List

━━━━━━━━━━━━━━━━━━━━
+ do virtual-row-is-sticky'Item
    - box Box

. cursor Box? = box
while cursor
    . current = cursor
    if current is VirtualSlotRoot'Item
        = (current as VirtualSlotRoot'Item).is-sticky
    cursor = current.material-parent
= false

━━━━━━━━━━━━━━━━━━━━
+ do virtual-reveal-stuck-row'Item
    - box Box

. cursor Box? = box
while cursor
    . current = cursor
    if current is VirtualSlotRoot'Item
        . root = current as VirtualSlotRoot'Item
        . region = root.layout-parent
        =? false if !root.is-sticky || !region || !(region is VirtualRegion'Item)
        = (region as VirtualRegion'Item).scroll-to-address(root.slot.address, ScrollAlignment.start)
    cursor = current.material-parent
= false

━━━━━━━━━━━━━━━━━━━━
_ do virtual-glide-shift Point?
    - leads [VirtualGlideLead]
    - top Length
    - rise Length

. above VirtualGlideLead?
. below VirtualGlideLead?
for lead in leads
    if lead.top <= top
        if !above || lead.top > above.top
            above = lead
    else if !below || lead.top < below.top
        below = lead
. shift = (above ?? below)?.shift
|? below || (shift && (shift.x != 0 || shift.y != 0))
    = shift
|? rise != 0
    = Point(0, rise)
??
    = shift

━━━━━━━━━━━━━━━━━━━━
_ do virtual-invalidate-paint
    - box Box

box.invalidate-paint()
for child in box.active-children
    virtual-invalidate-paint(child)

━━━━━━━━━━━━━━━━━━━━
_ virtual-floor VirtualCoord
    - value Length

floor(value) as I64

━━━━━━━━━━━━━━━━━━━━
_ virtual-ceil VirtualCoord
    - value Length

ceil(value) as I64

━━━━━━━━━━━━━━━━━━━━
_ virtual-length Length
    - value VirtualCoord

value as Length

━━━━━━━━━━━━━━━━━━━━
_ virtual-distance VirtualCoord
    - left VirtualCoord
    - right VirtualCoord

if left > right then left - right else right - left

━━━━━━━━━━━━━━━━━━━━
_ virtual-clipped-rect
    - rect Rect
    - clip Rect

Rect(left, top, max(0, right - left), max(0, bottom - top))

.. left = max(rect.left, clip.left)
.. top = max(rect.top, clip.top)
.. right = min(rect.right, clip.right)
.. bottom = min(rect.bottom, clip.bottom)

━━━━━━━━━━━━━━━━━━━━
_ virtual-natural-length-matters
    - before Length
    - after Length
    - arranged Length

before != after && (fit-before == 0 || fit-before != fit-after)

.. fit-before = virtual-natural-fit(before, arranged)
.. fit-after = virtual-natural-fit(after, arranged)

━━━━━━━━━━━━━━━━━━━━
_ virtual-natural-fit Int
    - natural Length
    - arranged Length

|? natural > arranged + 0.5
    1
|? natural < arranged - 0.5
    -1
??
    0

━━━━━━━━━━━━━━━━━━━━
_ virtual-inner-length
    - extent VirtualCoord
    - viewport Length
    - inset Length

?! Panic("Virtual extent exceeds GUI coordinate precision")
    if extent > virtual-precision-limit

if reach <= ceil(viewport) then viewport else reach

.. reach = virtual-length(extent) + inset

━━━━━━━━━━━━━━━━━━━━
_ virtual-reveal
    - position Length
    - maximum Length
    - viewport Length
    - start VirtualCoord
    - length VirtualCoord
    - alignment ScrollAlignment

gui-scroll-reveal-axis
    - position
    - 0
    - maximum
    - 0
    - viewport
    - virtual-length(start)
    - interval
    - 0
    - 0
    - axis-alignment

.. interval = virtual-length(length)
.. axis-alignment = if interval > viewport then ScrollAlignment.nearest else alignment
