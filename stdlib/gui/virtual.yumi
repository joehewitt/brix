+ do scroll-to-address Bool
    - address I64
    - alignment = ScrollAlignment.start
    - cause = ScrollCause.programmatic

=? false if !source || !virtual-layout
pinned-address = null
reveal-goal = null
. content = content-bounds
. rect = address-reveal-rect(address)
=? false if !rect
. reach-x = virtual-length(rect.x + rect.width)
. reach-y = virtual-length(rect.y + rect.height)
if reach-x > inner-width
    inner-width = reach-x
if reach-y > inner-height
    inner-height = reach-y
. maximum = scroll-max
. next-x = virtual-reveal(scroll-x, maximum.x, content.width, rect.x, rect.width, alignment)
. next-y = virtual-reveal(scroll-y, maximum.y, content.height, rect.y, rect.height, alignment)
. scrolled = scroll-to(Point(next-x, next-y), cause)
. shown = Rect
    - content.x + virtual-length(rect.x) - scroll-x
    - content.y + virtual-length(rect.y) - scroll-y
    - virtual-length(rect.width)
    - virtual-length(rect.height)
. revealed = reveal-in-ancestors(shown, alignment, Insets(0, 0, 0, 0), cause)
= scrolled || revealed

