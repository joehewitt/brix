_ do arrange-virtual-content

awaits-arrange = false
is-binding = true
do finally is-binding = false
watch-clip-host()
. content = content-bounds
. view = visible-view(content)
. live-layout = virtual-layout
. restored = restored-scroll
. target-x = restored?.x ?? scroll-x
. target-y = restored?.y ?? scroll-y
restored-scroll = null
. revealing = reveal-goal
reveal-goal = null
. revealed I64? = null
. sticky-offset = sticky-line-offset() if has-sticky-rows
arranged-sticky-offset = sticky-offset
. pinned = pinned-address if restored == null
if pinned != null
    . top = address-top(pinned)
    if top == null
        pinned-address = null
        pinned = null
    else
        target-y = max(0, top - pinned-offset)
else if revealing
    . address = revealing()
    . rect = address-reveal-rect(address) if address != null
    if rect
        revealed = address
        target-y = virtual-reveal
            - target-y
            - virtual-length(virtual-precision-limit)
            - content.height
            - rect.y
            - rect.height
            - reveal-alignment
. held = pinned ?? revealed
. ends = follows-to-end && reserved-height <= 0 && pinned == null
    .. follows-to-end = anchors-end && follows-end && restored == null && revealed == null
. glides = ends && glides-to-end
glides-to-end = false
if source && live-layout
    settle-glide(content)
    . pins-end = ends && !glides && !is-gliding
    . start-x = virtual-floor(target-x + view.x)
    . width = virtual-ceil(target-x + view.right) - start-x
    . start-y = virtual-floor(target-y)
    . pass Size
    . is-settled = false
    defers-overscan = binds-viewport-first && has-overscan && !shows-placed-rows(top-y, bottom-y)
