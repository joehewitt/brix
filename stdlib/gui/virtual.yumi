────────────────────
_ get has-overscan Bool

y-overscan || overscan.left > 0vcoord || overscan.right > 0vcoord

.. y-overscan = overscan-rows > 0vcoord || overscan.top > 0vcoord || overscan.bottom > 0vcoord

────────────────────
_ do shows-placed-rows Bool
    - start VirtualCoord
    - end VirtualCoord

. window = recycler.window
. index Index
while index < window.placement-count
    . placement = window.placements[index]
    =? true if !placement.is-sticky && placement.y < end && placement.y + placement.height > start
    index += 1
= false

────────────────────
_ do leading-placement VirtualPlacement?
    - start VirtualCoord

. window = recycler.window
. index Index
while index < window.placement-count
    . placement = window.placements[index]
    =? placement if !placement.is-sticky && placement.y + placement.height > start
    index += 1
= null

────────────────────
_ do measure-virtual-roots Bool
    - live-layout VirtualLayout
    - view-start VirtualCoord
    - view-end VirtualCoord

has-stable-anchor = false
. pool = %first-child
=? false if !pool
. changed = false
. slot-index Index
. cursor = pool.%first-child
while cursor
    . root = cursor as VirtualSlotRoot'VItem
    . placement = recycler.placement-for-slot(slot-index)
    . natural = root.natural-height(virtual-length(placement.width)) if placement
    if placement && natural != null
        . height = virtual-ceil(natural)
        . is-visible = placement.y < view-end && placement.y + placement.height > view-start
        . is-nearest = !has-stable-anchor || placement.y < stable-anchor-y
        if height == placement.height && is-visible && is-nearest && !placement.is-sticky
            has-stable-anchor = true
            stable-anchor-address = placement.address
            stable-anchor-y = placement.y
        if live-layout.record-row-height(placement, height)
            changed = true
    cursor = cursor.%next-sibling
    slot-index += 1
= changed

────────────────────
_ do arrange-virtual-roots
    - content Rect

native-rows = Rect(0, 0, 0, 0)
. pool = %first-child
if !pool
    followers.clear()
    =
. anchor = virtual-anchor
. re-anchored = placed-anchor != anchor
placed-anchor = anchor
. follows = follows-glides && followers.length > 0 && !re-anchored
follows-glides = false
. leads = if follows then glide-leads(content) else List'VirtualGlideLead()
. has-rows = false
. slot-index Index
. cursor = pool.%first-child
while cursor
    . root = cursor as VirtualSlotRoot'VItem
    . placement = recycler.placement-for-slot(slot-index)
    if placement
        . natural = placement-rect(placement, content)
        . shift = if placement.is-sticky && placement.is-pinned then sticky-fraction else 0
        . rect = Rect(natural.x, natural.y + shift, natural.width, natural.height)
        if re-anchored || placement.is-sticky || root.is-sticky
            root.forget-arrangement()
        if root.is-sticky != placement.is-sticky
            root.is-sticky = placement.is-sticky
        if root.sticky-depth != placement.sticky-depth
            root.sticky-depth = placement.sticky-depth
        root.arrange-outer-bounds(rect)
        . local = Rect(rect.x - content.x, rect.y - content.y, rect.width, rect.height)
        native-rows = if has-rows then native-rows + local else local
        has-rows = true
    else
        if root.is-sticky
            root.is-sticky = false
        root.arrange-outer-bounds(Rect(content.x, content.y, 0, 0))
    cursor = cursor.%next-sibling
    slot-index += 1
if follows
    glide-followers(leads, content)
followers.clear()

