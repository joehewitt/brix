/core/animatable
/core/style
/math
/math/easing
/math/motion
/time/duration
/units

_ endless-frame-rate F64 = 30

━━━━━━━━━━━━━━━━━━━━
+ Repeat is Union

| once
| forever
| times Int

━━━━━━━━━━━━━━━━━━━━
+ AnimationDirection is Union

| normal
| reverse
| alternate
| alternate-reverse

━━━━━━━━━━━━━━━━━━━━
+ KeyframeStop is Tuple

+ at F64
+ value [F64]?
+ easing Easing

━━━━━━━━━━━━━━━━━━━━
+ KeyframeTrack

+ style-index Index
+ offset Size
+ component Index?
+ stops [KeyframeStop]
+ motion Motion?
+ after Duration
+ over Duration?
+ sample StyleObjectHolder? = null

────────────────────
+ This
    - style-index
    - offset
    - component
    - motion
    - after
    - over

────────────────────
+ get info StyleInfo?

style-info-at(style-index)

────────────────────
+ do fill Bool
    - into [F64]
    - elapsed Duration
    - span Duration
    - precision F64
    - open [F64]

into.clear()
=? false if stops.length == 0
. local = if elapsed > after then elapsed - after else 0ns
. first = stops[0].value ?? open
. found = motion
if found && stops.length == 2
    . last = stops[1].value ?? open
    . moving = false
    for index in 0 .. < last.length
        . sample = found.sample(first[index] - last[index], 0, local, precision)
        into += last[index] + sample.offset
        if !sample.is-done
            moving = true
    = moving
. length = over ?? (if span > after then span - after else 0ns)
. seconds = (length as Seconds) as F64
. progress = if seconds > 0 then min(((local as Seconds) as F64) / seconds, 1.0) else 1.0
. place = keyframe-place(stops, progress)
if place.segment == 0
    into ++= first
    = false
. from = stops[place.segment - 1].value ?? open
. to = stops[place.segment].value ?? open
for index in 0 .. < to.length
    into += from[index] + (to[index] - from[index]) * place.fraction
= false

━━━━━━━━━━━━━━━━━━━━
+ KeyframeAnimation

+ duration Duration
+ repeat Repeat
+ direction AnimationDirection
+ frame-rate F64?
+ tracks [KeyframeTrack]

────────────────────
+ This
    - duration
    - repeat
    - direction
    - frame-rate

────────────────────
+ do get clock-rate F64?

=? frame-rate if frame-rate
match repeat
    |= .forever
        = endless-frame-rate
    ??
        = null

────────────────────
+ do range'Value This
    - property StyleProperty'Value
    - from Value?
    - to Value?
    - motion Motion? = null
    - after Duration = 0ns
    - over Duration? = null

. track = KeyframeTrack
    - property.style-index
    - property.offset
    - property.component
    - motion
    - after
    - over
track.stops += KeyframeStop(0, keyframe-vector(from), Easing.linear)
track.stops += KeyframeStop(1, keyframe-vector(to), Easing.linear)
track.sample = keyframe-sample(from) ?? keyframe-sample(to)
tracks += track
= this

────────────────────
+ do track'Value This
    - property StyleProperty'Value
    - after Duration = 0ns
    - over Duration? = null

tracks += KeyframeTrack
    - property.style-index
    - property.offset
    - property.component
    - null
    - after
    - over
= this

────────────────────
+ do at'Value This
    - property StyleProperty'Value
    - at Ratio
    - value Value
    - easing Easing = Easing.linear

?! Panic("A keyframe stop belongs to a track")
    if tracks.length == 0
. track = tracks[tracks.length - 1]
track.stops += KeyframeStop(at, keyframe-vector(value), easing)
track.sample = track.sample ?? keyframe-sample(value)
= this

━━━━━━━━━━━━━━━━━━━━
+ animation KeyframeAnimation
    - duration Duration
    - repeat Repeat = Repeat.once
    - direction AnimationDirection = AnimationDirection.normal
    - frame-rate F64? = null

KeyframeAnimation(duration, repeat, direction, frame-rate)

━━━━━━━━━━━━━━━━━━━━
_ keyframe-vector'Value [F64]?
    - value Value?
    - Value is Animatable

value?.motion-vector

━━━━━━━━━━━━━━━━━━━━
_ keyframe-vector [F64]?
    - value F64?

if value == null then null else [value]

━━━━━━━━━━━━━━━━━━━━
_ keyframe-sample'Value StyleObjectHolder?
    - value Value?
    - Value is Animatable

StyleWideHolder'Value(value) if value

━━━━━━━━━━━━━━━━━━━━
_ keyframe-sample StyleObjectHolder?
    - value F64?

null
