(import ./box)
(import ./primitives)
(import ./shape)
(import /graphics/canvas)
(import /graphics/primitives)
(import /graphics/roundedrect)
(import /math)

(type + BorderPainter
  (fn-expr + border-insets _
    (param node Box)
    (call Insets 0 0 0 0)
  )
  (fn-do + paint _
    (param node Box)
    (param rect Rect)
    (param canvas Canvas)
  )
)

(type + DefaultBorderPainter (is BorderPainter)
  (fn-expr + border-insets _
    (param node Box)
    (. node computed-border-widths)
  )
  (fn-do + paint _
    (param node Box)
    (param rect Rect)
    (param canvas Canvas)
    (let color (. node $border-color))
    (let fill (. node $border-fill))
    (return-if (if (and (not color) (not fill))))
    (return-if (if (or (<= (. rect width) 0) (<= (. rect height) 0))))
    (let edges (. node effective-border-widths))
    (return-if (if (and (<= (. edges top) 0) (<= (. edges right) 0) (<= (. edges bottom) 0) (<= (. edges left) 0))))
    (let radius (call max 0 (call min (. node computed-corner-radius) (/ (call min (. rect width) (. rect height)) 2))))
    (do-use (. canvas saved-state)
      (= (. canvas stroke-color) null)
      (= (. canvas fill-color) color)
      (= (. canvas shape-fill) fill)
      (if (and (== (. edges top) (. edges right)) (== (. edges top) (. edges bottom)) (== (. edges top) (. edges left)))
        (let width (. edges top))
        (if fill
          (call (. node effective-shape ring) node rect width canvas)
          (else
            (= (. canvas fill-color) null)
            (= (. canvas stroke-color) color)
            (= (. canvas stroke-width) width)
            (call (. node effective-shape stroke) node rect (/ width 2) canvas)
          )
        )
        (else-if (and (not fill) (== radius 0) (<= (. edges left) 0) (<= (. edges right) 0) top-bottom-fit)
          (if (> (. edges top) 0)
            (call (. canvas rect) (call Rect (. rect x) (. rect y) (. rect width) (. edges top)))
          )
          (if (> (. edges bottom) 0)
            (call (. canvas rect) (call Rect (. rect x) (- (. rect bottom) (. edges bottom)) (. rect width) (. edges bottom)))
          )
        )
        (else-if (and (not fill) (== radius 0) (<= (. edges top) 0) (<= (. edges bottom) 0) left-right-fit)
          (if (> (. edges left) 0)
            (call (. canvas rect) (call Rect (. rect x) (. rect y) (. edges left) (. rect height)))
          )
          (if (> (. edges right) 0)
            (call (. canvas rect) (call Rect (- (. rect right) (. edges right)) (. rect y) (. edges right) (. rect height)))
          )
        )
        (else
          (call (. canvas begin))
          (call (. (call RoundedRect rect radius radius radius radius) outline) canvas)
          (let inner
            (call Rect
              (block
                (arg (+ (. rect x) (. edges left)))
                (arg (+ (. rect y) (. edges top)))
                (arg (call max 0 (- (. rect width) (. edges left) (. edges right))))
                (arg (call max 0 (- (. rect height) (. edges top) (. edges bottom))))
              )
            )
          )
          (if (and (> (. inner width) 0) (> (. inner height) 0))
            (let left-radius (call max 0 (- radius (. edges left))))
            (let right-radius (call max 0 (- radius (. edges right))))
            (let top-radius (call max 0 (- radius (. edges top))))
            (let bottom-radius (call max 0 (- radius (. edges bottom))))
            (let horizontal (+ left-radius right-radius))
            (let vertical (+ top-radius bottom-radius))
            (let horizontal-scale (if-expr (> horizontal 0) (call min 1.0 (/ (. inner width) horizontal)) 1.0))
            (let vertical-scale (if-expr (> vertical 0) (call min 1.0 (/ (. inner height) vertical)) 1.0))
            (let inner-outline
              (call RoundedRect
                (block
                  (arg inner)
                  (arg (* left-radius horizontal-scale))
                  (arg (* top-radius vertical-scale))
                  (arg (* right-radius horizontal-scale))
                  (arg (* bottom-radius vertical-scale))
                )
              )
            )
            (call (. inner-outline outline) canvas)
          )
          (call (. canvas end) false (. FillRule even-odd))
        )
      )
    )
    (blank)
    (lazy top-bottom-fit (< (+ (. edges top) (. edges bottom)) (. rect height)))
    (lazy left-right-fit (< (+ (. edges left) (. edges right)) (. rect width)))
  )
)

(fn-do + paint-gui-box-border _
  (param node Box)
  (param rect Rect)
  (param canvas Canvas)
  (call (. node $border paint) node rect canvas)
)
