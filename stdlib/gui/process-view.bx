(import ./box)
(import ./surface-view)
(import /os/env)
(import /os/message-channel)
(import /os/process)
(import /unistd.h)

(type + ProcessView (is SurfaceView)
  (prop + path _ (= ""))
  (prop + arguments (list String))
  (event + exited Int)
  (event + failed Error)
  (prop _ process (? Process))
  (fn-do + sync _)
  (fn-do _ launch _ (?! Error)
    (let output (call C:dup 1))
    (let variables (call environment))
    (= ([] variables surface-rendezvous-variable) (call listen))
    (let connected
      (call connected-process path (:args arguments) (:variables variables) (:descriptors (list output))
        (block
          (on-error (: failure Error)
            (call C:close output)
            (throw failure)
          )
        )
      )
    )
    (call C:close output)
    (let spawned (. connected process))
    (= process spawned)
    (let opened (call MessageChannel (. connected socket)))
    (call connect opened (as (. spawned pid) I32))
    (call sync)
    (do-new @detached
      (finally
        (inline (call (. spawned reap)))
      )
      (while true
        (let message (call (. opened receive)))
        (if (not message)
          (break)
        )
        (call handle message)
      )
      (call ended spawned)
    )
  )
  (fn-do _ ended _
    (param program Process)
    (call disconnect)
    (let code (?? (call (. program wait) null) -1))
    (= process null)
    (<- exited code)
  )
  (fn-do + mounted _
    (call (. super mounted))
    (return-if (if (or process (== (. path length) 0))))
    (blank)
    (call launch
      (block
        (on-error (: failure Error)
          (<- failed failure)
        )
      )
    )
  )
  (fn-do + close _
    (call (?. process kill))
    (= process null)
    (call (. super close))
  )
)
