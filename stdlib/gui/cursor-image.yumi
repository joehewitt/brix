/YuAppleGUI/YuAppleGUI.h
/gc/gc
/graphics/canvas
/graphics/point

━━━━━━━━━━━━━━━━━━━━
+ CursorImage
    is Closable

_ handle Pointer?
_ cleanup CleanupHandle?

────────────────────
+ This
    - canvas RasterCanvas
    - hotspot Point

. image = C:yumiGuiCursorCreate(canvas.native, hotspot.x, hotspot.y)
?! Error("Cursor image requires a valid canvas and an in-bounds hotspot")
    if image == Pointer()
handle = image
cleanup = on-reclaim(this, image, reclaim-cursor-image)

────────────────────
+ get native

handle ?? Pointer()

────────────────────
+ do close

if handle
    cleanup?.cancel()
    reclaim-cursor-image(handle!)
    handle = null

━━━━━━━━━━━━━━━━━━━━
_ do reclaim-cursor-image
    - handle Pointer

C:yumiGuiCursorRelease(handle)
