./box
./events
./pinch
./primitives
/graphics/point
/graphics/primitives
/math
/ui/input

_ zoom-wheel-line Length = 40
_ zoom-precise-rate F64 = 0.01
_ zoom-line-rate F64 = 0.15

━━━━━━━━━━━━━━━━━━━━
+ ZoomBounds is Tuple

+ natural Dimensions
+ fitted Rect
+ low F64
+ high F64
+ ink = Insets(0, 0, 0, 0)

━━━━━━━━━━━━━━━━━━━━
+ ZoomOwner is Interface

────────────────────
+ do zoom-bounds ZoomBounds

━━━━━━━━━━━━━━━━━━━━
+ ZoomChrome is Interface

────────────────────
+ do zoom-chrome [Rect]

━━━━━━━━━━━━━━━━━━━━
+ ZoomFrame

+ box Box
+ owner ZoomOwner
+ zoom F64? = null
+ center Point? = null
+ is-immersed = false
+ event moved Bool

_ immersed-zoom F64? = null
_ pinch := PinchTracker(box)
_ drag-origin Point?
_ drag-center = Point(0, 0)

────────────────────
+ This
    - box
    - owner

────────────────────
for change on pinch.moved

show(owner.zoom-bounds(), change.scale, change.anchor)

────────────────────
for change on pinch.ended

zoom-to(change.scale, change.anchor)

────────────────────
+ get is-fit Bool

zoom == null

────────────────────
+ get is-pinching Bool

pinch.is-active

────────────────────
+ do immerse Bool
    - chrome [Rect]

. level = zoom
. is-held = is-immersed && level != null && level == immersed-zoom
. covering = is-held || level != null && zoom-covers(inked(), chrome)
immersed-zoom = level
=? false if covering == is-immersed
is-immersed = covering
= true

────────────────────
+ fit-zoom F64

zoom-fit-level(owner.zoom-bounds())

────────────────────
+ effective-zoom F64

zoom ?? fit-zoom()

────────────────────
+ placed Rect

placed-in(owner.zoom-bounds())

────────────────────
+ do zoom-to
    - level F64
    - anchor Point? = null

. bounds = owner.zoom-bounds()
. next = max(bounds.low, min(max(bounds.high, bounds.low), level))
if next <= zoom-fit-level(bounds) && bounds.low >= zoom-fit-level(bounds)
    fit()
    =
show(bounds, next, anchor)

────────────────────
+ do zoom-by
    - factor F64
    - anchor Point? = null

=? if factor <= 0
zoom-to(effective-zoom() * factor, anchor)

────────────────────
+ do fit

pinch.reset()
zoom = null
center = null
moved <- is-fit

────────────────────
+ do pan-by
    - delta Point

. level = zoom
=? if level == null
. bounds = owner.zoom-bounds()
. origin = visible-center(bounds)
center = clamped(bounds, Point(origin.x + delta.x / level, origin.y + delta.y / level), level)
moved <- is-fit

────────────────────
+ do handle-scroll Bool
    - event ScrollEvent

if event.modifiers.command || event.modifiers.control || event.modifiers.option
    . rate = if event.is-precise then zoom-precise-rate else zoom-line-rate
    zoom-by(exp(-event.delta-y * rate), event.point)
    = true
=? false if zoom == null
. line = if event.is-precise then 1 else zoom-wheel-line
pan-by(Point(event.delta-x * line, event.delta-y * line))
= true

────────────────────
+ do handle-magnify Bool
    - event MagnifyEvent

. bounds = owner.zoom-bounds()
=? false if bounds.natural.width <= 0 || bounds.natural.height <= 0
pinch.low = bounds.low
pinch.high = max(bounds.high, bounds.low)
= pinch.handle(event, zoom ?? zoom-fit-level(bounds))

────────────────────
+ do handle-pointer-down Bool
    - event PointerDownEvent

=? false if event.button != PointerButton.primary
if event.click-count == 2
    drag-origin = null
    if zoom == null
        zoom-to(max(1, fit-zoom() * 2), event.point)
    else
        fit()
    = true
drag-origin = event.point
drag-center = visible-center(owner.zoom-bounds())
= false

────────────────────
+ do handle-pointer-drag Bool
    - event PointerDragEvent

. origin = drag-origin
. level = zoom
=? false if !origin || level == null
. target = Point
    - drag-center.x - (event.point.x - origin.x) / level
    - drag-center.y - (event.point.y - origin.y) / level
center = clamped(owner.zoom-bounds(), target, level)
moved <- is-fit
= true

────────────────────
+ do handle-pointer-up

drag-origin = null

────────────────────
_ inked Rect

|? bounds.natural.width <= 0
    rect
??
    rect.inset(Insets(ink.top * scale, ink.right * scale, ink.bottom * scale, ink.left * scale))

.. bounds = owner.zoom-bounds()
.. rect = placed-in(bounds)
.. scale = rect.width / bounds.natural.width
.. ink = bounds.ink

────────────────────
_ do show
    - bounds ZoomBounds
    - level F64
    - anchor Point?

=? if bounds.natural.width <= 0 || bounds.natural.height <= 0
. prior = zoom ?? zoom-fit-level(bounds)
=? if prior <= 0 || level <= 0
. content = box.content-bounds
. frame = box.bounds
. focus = if anchor then Point(anchor.x + frame.x, anchor.y + frame.y) else content.center
. offset-x = focus.x - content.center.x
. offset-y = focus.y - content.center.y
. origin = visible-center(bounds)
. target = Point(origin.x + offset-x / prior, origin.y + offset-y / prior)
zoom = level
center = clamped(bounds, Point(target.x - offset-x / level, target.y - offset-y / level), level)
moved <- is-fit

────────────────────
_ placed-in Rect
    - bounds ZoomBounds

match zoom
    |= null
        bounds.fitted
    | level F64
        Rect
            - content.center.x - focus.x * level
            - content.center.y - focus.y * level
            - natural.width * level
            - natural.height * level

        .. focus = clamped(bounds, center ?? Point(natural.width / 2, natural.height / 2), level)

.. natural = bounds.natural
.. content = box.content-bounds

────────────────────
_ visible-center Point
    - bounds ZoomBounds

|? scale <= 0
    Point(0, 0)
??
    Point((content.center.x - rect.x) / scale, (content.center.y - rect.y) / scale)

.. rect = placed-in(bounds)
.. scale = if bounds.natural.width > 0 then rect.width / bounds.natural.width else 0.0
.. content = box.content-bounds

────────────────────
_ clamped Point
    - bounds ZoomBounds
    - target Point
    - level F64

Point
    - zoom-clamp-axis(target.x, level, middle.x, natural.width, fitted.x, fitted.right)
    - zoom-clamp-axis(target.y, level, middle.y, natural.height, fitted.y, fitted.bottom)

.. natural = bounds.natural
.. fitted = bounds.fitted
.. middle = box.content-bounds.center

━━━━━━━━━━━━━━━━━━━━
_ zoom-fit-level F64
    - bounds ZoomBounds

|? bounds.natural.width <= 0 || bounds.natural.height <= 0
    1
??
    bounds.fitted.width / bounds.natural.width

━━━━━━━━━━━━━━━━━━━━
_ zoom-clamp-axis F64
    - value F64
    - level F64
    - middle F64
    - extent F64
    - start F64
    - end F64

(middle - clamp(middle - value * level, min(start, end - span), max(start, end - span))) / level

.. span = extent * level

━━━━━━━━━━━━━━━━━━━━
+ do zoom-covers Bool
    - rect Rect
    - chrome [Rect]

for area in chrome
    . overlap = rect.intersection(area)
    =? true if overlap.width > 0 && overlap.height > 0
= false
