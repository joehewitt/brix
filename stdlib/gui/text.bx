(import ./border)
(import ./box)
(import ./layout)
(import ./painter)
(import ./primitives)
(import ./styles)
(import /core/style)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/roundedrect)
(import /graphics/text)
(import /math)
(import /stream/aggregate)
(blank)
(prop _ inline-layout _ (= (call InlineLayout)))

(type + TextDecorationLine (is Union)
  (variant none)
  (variant underline)
  (variant line-through)
)

(type + TextDecorationStyle (is Union)
  (variant solid)
  (variant dotted)
)

(type + GUITextDecoration (is Style)
  (prop + text-decoration TextDecorationLine (= (. TextDecorationLine none)))
  (prop + text-decoration-style TextDecorationStyle (= (. TextDecorationStyle solid)))
  (prop + text-decoration-color (? RGBA) (= null))
  (prop + text-decoration-thickness Length (= 1))
  (blank)
  (style-domains text-decoration (domain paint))
  (style-domains text-decoration-style (domain paint))
  (style-domains text-decoration-color (domain paint))
  (style-domains text-decoration-thickness (domain paint))
)

(type + SpanFragment (is Tuple)
  (prop + line-bounds Rect)
  (prop + glyph-bounds Rect)
  (prop + baseline Length)
)

(type + InlineLayout (is Layout)
  (fn-do + arrange-box _
    (param box Box)
    (param hint LayoutArrangeHint (= (. LayoutArrangeHint full)))
    (if (is box Text)
      (call (. (as box Text) arrange-paragraph))
    )
  )
  (fn-expr + measure-content _
    (param box Box)
    (param query MeasureQuery)
    (if-expr (is box Text) (call (. (as box Text) measure-paragraph) query) (call Dimensions 0 0))
  )
)

(type + Text (is Box)
  (rule This
    (= layout inline-layout)
    (= text-wrap (. TextWrap word))
    (= text-overflow (. TextOverflow clip))
  )
  (blank)
  (prop + effective-font _ (=> (call Font $font-family $font-size $font-weight $font-slant)))
  (prop + text-layout _ (=> paragraph))
  (prop + text-layout-snapshot _ (=> (?. paragraph snapshot)))
  (blank)
  (prop _ paragraph (? TextLayout))
  (prop _ paragraph-segments (list TextSegment))
  (prop _ paragraph-tight (? TightTextLayout))
  (prop _ measured (? TextLayout))
  (prop _ measured-segments (list TextSegment))
  (prop _ segment-scratch (list TextSegment))
  (prop _ measured-tight (? TightTextLayout))
  (prop _ items (list Box))
  (fn-expr + markup-content Box
    (param content String)
    (call Span content)
  )
  (fn-do + close _
    (call release-measured)
    (if paragraph
      (call (. paragraph close))
      (= paragraph null)
    )
    (call (. super close))
  )
  (fn-do + paint-overlay _
    (param canvas Canvas)
    (let content content-bounds)
    (call paint-layout
      (block
        (arg canvas)
        (arg
          (call ensure-paragraph
            (block
              (arg (call collect-segments (call child-layout-query)))
              (arg (. content width))
              (arg (call arranged-maximum-height content))
              (arg false)
            )
          )
        )
      )
    )
  )
  (fn-do + paint-text _
    (param canvas Canvas)
    (let layout paragraph)
    (if layout
      (call paint-layout canvas layout)
    )
  )
  (fn-do _ paint-layout _
    (param canvas Canvas)
    (param layout TextLayout)
    (let content content-bounds)
    (do-use (. canvas saved-state)
      (= (. canvas text-color) $color)
      (= (. canvas text-fill) $text-fill)
      (call (. canvas draw-text)
        (block
          (arg layout)
          (arg (call Rect (. content x) (. content y) (. content width) (. layout height)))
          (arg $text-alignment)
        )
      )
    )
  )
  (fn-do + caret-rect (? Rect)
    (param offset Size)
    (let layout paragraph)
    (return-if null (if (not layout)))
    (blank)
    (let content content-bounds)
    (let local (call (. layout caret-rect) offset))
    (let shift (call (. layout line-offset) (call (. layout line-at) offset) (. content width) $text-alignment))
    (return (call Rect (+ (. content x) shift (. local x)) (+ (. content y) (. local y)) 0 (. local height)))
  )
  (fn-do + row-rect (? Rect)
    (param row Index)
    (let layout paragraph)
    (return-if null (if (or (not layout) (>= row (. layout line-count)))))
    (blank)
    (let content content-bounds)
    (let line (. ([] (. layout snapshot lines) row) typographic-bounds))
    (let shift (call (. layout line-offset) row (. content width) $text-alignment))
    (return (call Rect (+ (. content x) shift) (+ (. content y) (. line y)) (. line width) (. line height)))
  )
  (fn-expr + offset-at Size
    (param point Point)
    (if-expr (not layout) 0 (call (. layout offset-at) (call Point (- (. point x) (. content x) shift) y)))
    (where
      (lazy layout paragraph)
      (lazy content content-bounds)
      (lazy y (- (. point y) (. content y)))
      (lazy row (call (. layout line-at) (call (. layout offset-at) (call Point 0 y))))
      (lazy shift (call (. layout line-offset) row (. content width) $text-alignment))
    )
  )
  (fn-do + measure-paragraph Dimensions
    (param query MeasureQuery)
    (let child-query (call derived-child-measure-query query))
    (let maximum-width (call measured-maximum-width query child-query))
    (let maximum-height (only-if (call resolved-size-spec (. query block) $max-height) (if truncates-lines)))
    (let segments (call collect-segments child-query))
    (let layout (call measured-layout segments maximum-width maximum-height))
    (let tight (call tight-for layout))
    (let height (call gui-device-ceiled (. layout height)))
    (return
      (match tight
        (case= null
          (call Dimensions (if-expr (== maximum-width null) natural (call min natural maximum-width)) height)
          (blank)
          (lazy natural (call gui-device-ceiled (. layout natural-width)))
        )
        (default
          (call Dimensions (call gui-device-ceiled (. tight width)) height)
        )
      )
    )
  )
  (fn-do + arrange-paragraph _
    (let content content-bounds)
    (let layout
      (call ensure-paragraph
        (block
          (arg (call collect-segments (call child-layout-query)))
          (arg (. content width))
          (arg (call arranged-maximum-height content))
          (arg true)
        )
      )
    )
    (call place-items layout content)
    (= inner-width (. content width))
    (= inner-height (. layout height))
  )
  (fn-expr _ tight-for _
    (param layout TextLayout)
    (case? (and painted (== (as painted Pointer) (as layout Pointer)))
      paragraph-tight
    )
    (default
      measured-tight
    )
    (where
      (lazy painted paragraph)
    )
  )
  (fn-expr _ is-tight _ :get
    (and (== $text-wrap (. TextWrap word)) (== $text-wrap-sizing (. TextWrapSizing tight)))
  )
  (fn-expr _ truncates-lines _ :get
    (and (== $text-wrap (. TextWrap word)) (== $text-overflow (. TextOverflow truncate-tail)))
  )
  (fn-expr _ arranged-maximum-height (? Length)
    (param content Rect)
    (only-if (. content height) (if truncates-lines))
  )
  (fn-expr _ measured-maximum-width _
    (param query MeasureQuery)
    (param child-query MeasureQuery)
    (case? (!= $text-wrap (. TextWrap word))
      null
    )
    (case? (not proposed)
      null
    )
    (default
      (call constrained-axis-size
        (block
          (arg (call gui-safe-span proposed))
          (arg (. query inline))
          (arg $min-width)
          (arg $max-width)
        )
      )
    )
    (where
      (lazy proposed (?? (. child-query inline available) (call resolved-size-spec (. query inline) $max-width)))
    )
  )
  (fn-do _ measured-layout TextLayout
    (param segments (list TextSegment))
    (param maximum-width (? Length))
    (param maximum-height (? Length))
    (let painted paragraph)
    (return-if painted (if (and painted (call painted-serves segments maximum-width maximum-height))))
    (blank)
    (let current measured)
    (return-if current (if (and current (call measured-serves segments maximum-width maximum-height))))
    (blank)
    (call release-measured)
    (let owned (call List segments))
    (let tight (only-if (call tight-paragraph owned maximum-width maximum-height) (if is-tight)))
    (let created (?? (?. tight layout) (call create-layout owned maximum-width maximum-height)))
    (= measured created)
    (= measured-segments owned)
    (= measured-tight tight)
    (return created)
  )
  (fn-do _ ensure-paragraph TextLayout
    (param segments (list TextSegment))
    (param maximum-width Length)
    (param maximum-height (? Length))
    (param repaint Bool)
    (let current paragraph)
    (return-if current (if (and current (call painted-serves segments maximum-width maximum-height))))
    (blank)
    (let replacement measured)
    (if (and replacement (call measured-serves segments maximum-width maximum-height))
      (= measured null)
      (call adopt-paragraph replacement measured-segments repaint measured-tight)
      (= measured-segments (call (of List TextSegment)))
      (= measured-tight null)
      (return replacement)
    )
    (let owned (call List segments))
    (let tight (only-if (call tight-paragraph owned maximum-width maximum-height) (if is-tight)))
    (let created (?? (?. tight layout) (call create-layout owned maximum-width maximum-height)))
    (call adopt-paragraph created owned repaint tight)
    (return created)
  )
  (fn-do _ adopt-paragraph _
    (param layout TextLayout)
    (param segments (list TextSegment))
    (param repaint Bool)
    (param tight (? TightTextLayout))
    (let previous paragraph)
    (= paragraph layout)
    (= paragraph-segments segments)
    (= paragraph-tight tight)
    (if previous
      (call (. previous close))
    )
    (if repaint
      (call invalidate-paint)
    )
  )
  (fn-expr _ create-layout _
    (param segments (list TextSegment))
    (param maximum-width (? Length))
    (param maximum-height (? Length))
    (call TextLayout
      (block
        (arg segments)
        (arg effective-font)
        (arg maximum-width)
        (arg $text-overflow)
        (arg $text-wrap)
        (arg (call gui-safe-span $line-spacing))
        (arg maximum-height)
      )
    )
  )
  (fn-expr _ tight-paragraph _
    (param segments (list TextSegment))
    (param maximum-width (? Length))
    (param maximum-height (? Length))
    (call tight-text-layout
      (block
        (arg (=> (width) (call create-layout segments width maximum-height)))
        (arg (call gui-text-search-precision this))
        (arg gui-packed-span-up)
        (arg maximum-width)
      )
    )
  )
  (fn-expr _ painted-serves _
    (param segments (list TextSegment))
    (param maximum-width (? Length))
    (param maximum-height (? Length))
    (case? (not painted)
      false
    )
    (default
      (call layout-serves
        (block
          (arg painted)
          (arg paragraph-segments)
          (arg segments)
          (arg paragraph-tight)
          (arg maximum-width)
          (arg maximum-height)
        )
      )
    )
    (where
      (lazy painted paragraph)
    )
  )
  (fn-expr _ measured-serves _
    (param segments (list TextSegment))
    (param maximum-width (? Length))
    (param maximum-height (? Length))
    (case? (not current)
      false
    )
    (default
      (call layout-serves
        (block
          (arg current)
          (arg measured-segments)
          (arg segments)
          (arg measured-tight)
          (arg maximum-width)
          (arg maximum-height)
        )
      )
    )
    (where
      (lazy current measured)
    )
  )
  (fn-expr _ layout-serves _
    (param layout TextLayout)
    (param layout-segments (list TextSegment))
    (param segments (list TextSegment))
    (param tight (? TightTextLayout))
    (param maximum-width (? Length))
    (param maximum-height (? Length))
    (and same-setup width-serves height-serves same-segments)
    (where
      (lazy request (. layout request))
      (lazy same-setup (and same-request same-spacing (== is-tight (!= tight null))))
      (lazy same-request (and (== (. request font) effective-font) (== (. request wrap) $text-wrap) same-overflow))
      (lazy same-overflow (== (. request overflow) $text-overflow))
      (lazy same-spacing (== (. layout line-spacing) (call gui-safe-span $line-spacing)))
      (lazy width-serves (call paragraph-width-serves layout tight maximum-width))
      (lazy height-serves (call text-height-serves layout maximum-height))
      (lazy same-segments (and (== (. segments length) (. layout-segments length)) (not segment-changed)))
      (lazy segment-changed (call some (..< 0 (. segments length)) (:where (!= ([] segments each) ([] layout-segments each)))))
    )
  )
  (fn-do _ release-measured _
    (if measured
      (call (. measured close))
      (= measured null)
    )
    (= measured-segments (call (of List TextSegment)))
    (= measured-tight null)
  )
  (fn-do _ collect-segments _
    (param query MeasureQuery)
    (call (. items clear))
    (let result segment-scratch)
    (call (. result clear))
    (for (in child (call RenderedChildCursor this))
      (call collect-node child query effective-font -1 result)
    )
    (return result)
  )
  (fn-do _ collect-node _
    (param node Box)
    (param query MeasureQuery)
    (param font Font)
    (param owner Int)
    (param result (list TextSegment))
    (if (. node is-markup-shadow)
      (for (in child (call RenderedChildCursor node))
        (call collect-node child query font owner result)
      )
      (return)
    )
    (return-if (if (not (call (. node participates-in-parent-layout) this))))
    (blank)
    (if (is node Span)
      (call collect-span (as node Span) query owner result)
      (return)
    )
    (blank)
    (let tag (. items length))
    (+= items node)
    (let outer (. (call (. node measure) query) outer-size))
    (let outset (. node inline-outset))
    (let size
      (call Dimensions
        (block
          (arg (call max 0 (- (. outer width) (* (. outset width) 2))))
          (arg (call max 0 (- (. outer height) (* (. outset height) 2))))
        )
      )
    )
    (let natural-ascent (. node inline-ascent))
    (let ascent (if-expr natural-ascent (- natural-ascent (. outset height)) estimated-ascent))
    (lazy estimated-ascent (call min (. size height) (+ (/ (. size height) 2) (* (. font size) 0.32))))
    (+= result
      (call TextSegment
        (block
          (arg tag)
          (arg "")
          (arg font)
          (arg null)
          (arg (call TextObjectMetrics (. size width) ascent (- (. size height) ascent)))
        )
      )
    )
  )
  (fn-do _ collect-span _
    (param span Span)
    (param query MeasureQuery)
    (param owner Int)
    (param result (list TextSegment))
    (let tag (. items length))
    (+= items span)
    (let font (. span effective-font))
    (call append-spacer result owner font (. span $margin-left) false)
    (call append-spacer result tag font (. span $padding-left) false)
    (if (. span text length)
      (+= result (call TextSegment tag (. span text) font (. span $color)))
    )
    (for (in child (call RenderedChildCursor span))
      (call collect-node child query font tag result)
    )
    (call append-spacer result tag font (. span $padding-right) true)
    (call append-spacer result owner font (. span $margin-right) true)
    (= (. span first-tag) tag)
    (= (. span end-tag) (. items length))
  )
  (fn-do _ append-spacer _
    (param result (list TextSegment))
    (param tag Int)
    (param font Font)
    (param width Length)
    (param trailing Bool)
    (return-if (if (or (not (call is-finite width)) (<= width 0))))
    (blank)
    (+= result
      (call TextSegment
        (block
          (arg tag)
          (arg "")
          (arg font)
          (arg null)
          (arg (call TextObjectMetrics width 0 0))
          (arg trailing)
          (arg (not trailing))
        )
      )
    )
  )
  (fn-do _ place-items _
    (param layout TextLayout)
    (param content Rect)
    (let alignment $text-alignment)
    (let placed
      (block
        (spread (. layout fragments))
        (pipe *> (call placed-fragment layout each content alignment))
        (pipe |> List)
      )
    )
    (let tags
      (block
        (spread (. layout fragments))
        (pipe *> (. each tag))
        (pipe |> List)
      )
    )
    (for (in tag (..< 0 (. items length)))
      (let item ([] items tag))
      (if (is item Span)
        (let span (as item Span))
        (call (. span place) (call merged-fragments placed tags (. span first-tag) (. span end-tag)) content)
        (else
          (let bounds (?? (call attachment-bounds placed tags tag) (call Rect (. content x) (. content y) 0 0)))
          (let outset (. item inline-outset))
          (call (. item arrange-outer-bounds)
            (block
              (arg
                (call Rect
                  (block
                    (arg (- (. bounds x) (. outset width)))
                    (arg (- (. bounds y) (. outset height)))
                    (arg (+ (. bounds width) (* (. outset width) 2)))
                    (arg (+ (. bounds height) (* (. outset height) 2)))
                  )
                )
              )
            )
          )
        )
      )
    )
  )
  (fn-expr _ placed-fragment _
    (param layout TextLayout)
    (param fragment TextFragment)
    (param content Rect)
    (param alignment TextAlignment)
    (call SpanFragment
      (block
        (arg (call Rect x top (. fragment width) (. line typographic-bounds height)))
        (arg (call Rect x (- baseline (. fragment ascent)) (. fragment width) (+ (. fragment ascent) (. fragment descent))))
        (arg baseline)
      )
    )
    (where
      (lazy line ([] (. layout snapshot lines) (. fragment line)))
      (lazy x (+ (. content x) (call (. layout line-offset) (. fragment line) (. content width) alignment) (. fragment x)))
      (lazy baseline (+ (. content y) (. line baseline)))
      (lazy top (+ (. content y) (. line typographic-bounds y)))
    )
  )
  (fn-expr _ attachment-bounds (? Rect)
    (param placed (list SpanFragment))
    (param tags (list Int))
    (param tag Int)
    (call first (in (. ([] placed each) glyph-bounds) (..< 0 (. placed length)) (when (== ([] tags each) tag))))
  )
  (fn-do _ merged-fragments _
    (param placed (list SpanFragment))
    (param tags (list Int))
    (param first Int)
    (param end Int)
    (let result (list SpanFragment))
    (let previous-line Length -1)
    (for (in index (..< 0 (. placed length)))
      (let tag ([] tags index))
      (if (or (< tag first) (>= tag end))
        (continue)
      )
      (let fragment ([] placed index))
      (if (and (. result length) (== (. fragment baseline) previous-line))
        (let last ([] result (- (. result length) 1)))
        (= ([] result (- (. result length) 1))
          (call SpanFragment
            (block
              (arg (+ (. last line-bounds) (. fragment line-bounds)))
              (arg (+ (. last glyph-bounds) (. fragment glyph-bounds)))
              (arg (. last baseline))
            )
          )
        )
        (else
          (+= result fragment)
        )
      )
      (= previous-line (. fragment baseline))
    )
    (return result)
  )
)

(type + Span (is Box)
  (using GUITextDecoration)
  (prop + text String)
  (prop + first-tag Int (= -1))
  (prop + end-tag Int (= -1))
  (prop + effective-font _ (=> (call Font $font-family $font-size $font-weight $font-slant)))
  (prop + is-layout-placed-by-parent _ (=> true))
  (blank)
  (prop _ local-fragments (list SpanFragment))
  (blank)
  (depends invalidate-content-size text)
  (depends share-hover is-hovered)
  (depends share-press is-pressed)
  (fn-do + This _
    (param text String (= ""))
  )
  (fn-expr + markup-content Box
    (param content String)
    (call Span content)
  )
  (fn-do + enclosing-span (? Span) :get
    (let cursor material-parent)
    (while (and cursor (. cursor is-markup-shadow))
      (= cursor (. cursor material-parent))
    )
    (return (only-if (as cursor Span) (if (and cursor (is cursor Span)))))
  )
  (fn-do + place _
    (param placed (list SpanFragment))
    (param content Rect)
    (let next-bounds (call Rect (. content x) (. content y) 0 0))
    (for (in index (..< 0 (. placed length)))
      (let fragment ([] placed index))
      (let outer (+ (. fragment line-bounds) (call decoration-bounds fragment)))
      (= next-bounds (if-expr (== index 0) outer (+ next-bounds outer)))
    )
    (call arrange-bounds next-bounds)
    (let origin (call Point (- (. next-bounds x)) (- (. next-bounds y))))
    (let local (call span-shifted-fragments placed origin))
    (let changed (!= (. local length) (. local-fragments length)))
    (if (not changed)
      (for (in index (..< 0 (. local length)))
        (= changed (or changed (!= ([] local index) ([] local-fragments index))))
      )
    )
    (= local-fragments local)
    (if changed
      (call invalidate-paint)
    )
  )
  (fn-expr + fragments _ :get
    (call span-shifted-fragments local-fragments (. bounds top-left))
  )
  (fn-expr + decoration-bounds _
    (param fragment SpanFragment)
    (call Rect
      (block
        (arg (. glyph x))
        (arg (- (. glyph y) $padding-top))
        (arg (. glyph width))
        (arg (+ (. glyph height) $padding-top $padding-bottom))
      )
    )
    (where
      (lazy glyph (. fragment glyph-bounds))
    )
  )
  (fn-expr + hit-contains _
    (param point Point)
    (call some fragments (:where (call (. each line-bounds contains) point)))
  )
  (fn-do + markup-style-domains-changed _
    (param mask U32)
    (call (. super markup-style-domains-changed) mask)
    (let paint-domain (call style-domain-named "paint"))
    (return-if (if (< paint-domain 0)))
    (blank)
    (if (!= (/and/ mask (/lshift/ 1u32 (as paint-domain Size))) 0)
      (call (?. (call (of ancestor Text)) invalidate-paint))
    )
  )
  (fn-do + paint-box-background _
    (param canvas Canvas)
    (return-if (if (and (not $background-color) (not $background) (not $background-image))))
    (blank)
    (for (in fragment fragments)
      (let rect (call decoration-bounds fragment))
      (let radius (call min computed-corner-radius (/ (call min (. rect width) (. rect height)) 2)))
      (do-use (. canvas saved-state)
        (if (> radius 0)
          (call (. (call RoundedRect rect radius radius radius radius) clip) canvas)
        )
        (call paint-gui-box-background this rect canvas)
      )
    )
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let decoration $text-decoration)
    (return-if (if (or (== decoration (. TextDecorationLine none)) (not (. fragments length)))))
    (blank)
    (let thickness (call max 0.5 (call gui-safe-span $text-decoration-thickness)))
    (let offset
      (scope (if-expr underlined (* $font-size 0.14) (* $font-size -0.3))
        (lazy underlined (== decoration (. TextDecorationLine underline)))
      )
    )
    (let last (- (. fragments length) 1))
    (do-use (. canvas saved-state)
      (= (. canvas fill-color) (?? $text-decoration-color $color))
      (= (. canvas stroke-color) null)
      (for (in index (..< 0 (. fragments length)))
        (let glyph (. ([] fragments index) glyph-bounds))
        (let start (if-expr (== index 0) (+ (. glyph x) $padding-left) (. glyph x)))
        (let finish (if-expr (== index last) (- (. glyph right) $padding-right) (. glyph right)))
        (let y (- (+ (. ([] fragments index) baseline) offset) (/ thickness 2)))
        (call paint-decoration-line canvas start finish y thickness)
      )
    )
  )
  (fn-do + paint-box-border _
    (param canvas Canvas)
    (return-if (if (<= computed-border-width 0)))
    (blank)
    (for (in fragment fragments)
      (call paint-gui-box-border this (call decoration-bounds fragment) canvas)
    )
  )
  (fn-do _ share-hover _
    (= (?. enclosing-span is-hovered) is-hovered)
  )
  (fn-do _ share-press _
    (= (?. enclosing-span is-pressed) is-pressed)
  )
  (fn-do _ paint-decoration-line _
    (param canvas Canvas)
    (param start Length)
    (param finish Length)
    (param y Length)
    (param thickness Length)
    (return-if (if (<= finish start)))
    (blank)
    (if (== $text-decoration-style (. TextDecorationStyle solid))
      (call (. canvas rect) (call Rect start y (- finish start) thickness))
      (return)
    )
    (let step (* thickness 3))
    (let x start)
    (while (<= (+ x thickness) finish)
      (call (. canvas rect) (call Rect x y thickness thickness))
      (+= x step)
    )
  )
)

(fn-expr _ span-shifted-fragments _
  (param fragments (list SpanFragment))
  (param offset Point)
  (spread fragments)
  (pipe *>
    (call SpanFragment
      (block
        (arg (+ (. each line-bounds) offset))
        (arg (+ (. each glyph-bounds) offset))
        (arg (+ (. each baseline) (. offset y)))
      )
    )
  )
  (pipe |> List)
)

(fn-expr _ paragraph-width-serves _
  (param layout TextLayout)
  (param tight (? TightTextLayout))
  (param maximum-width (? Length))
  (?? (call (?. tight serves) maximum-width) (call text-width-serves layout maximum-width))
)

(fn-expr _ text-width-serves _
  (param layout TextLayout)
  (param maximum-width (? Length))
  (case? (== (. request maximum-width) maximum-width)
    true
  )
  (case? (. layout is-truncated)
    false
  )
  (case? (and (== (. request wrap) (. TextWrap no-wrap)) (== (. request overflow) (. TextOverflow clip)))
    true
  )
  (default
    (and (call text-width-fits layout (. request maximum-width)) (call text-width-fits layout maximum-width))
  )
  (where
    (lazy request (. layout request))
  )
)

(fn-expr _ text-height-serves _
  (param layout TextLayout)
  (param maximum-height (? Length))
  (case? (== (. request maximum-height) maximum-height)
    true
  )
  (case? (and (!= maximum-height null) (> (. layout height) (+ maximum-height 0.01)))
    false
  )
  (case? (. layout is-truncated)
    (and (!= limit null) (!= maximum-height null) (<= maximum-height (+ limit 0.01)))
  )
  (default
    true
  )
  (where
    (lazy request (. layout request))
    (lazy limit (. request maximum-height))
  )
)

(fn-expr _ text-width-fits _
  (param layout TextLayout)
  (param width (? Length))
  (or (== width null) (<= (. layout natural-width) (+ width 0.01)))
)
