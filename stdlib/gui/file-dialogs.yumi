./window
/BxAppleGUI/BxFileDialog.h
/core/intrinsics
/os/path

━━━━━━━━━━━━━━━━━━━━
+ do choose-save-path Path?
    - window Window?
    - name = ""
    - types [String] = List'String()
    - directory Path? = null
    - message = ""
    - prompt = ""

. completion = Completion'(List'Path)()
. dialog = C:brixFileDialogSave
    - file-dialog-anchor(window)
    - name
    - file-dialog-types(types)
    - types.length
    - file-dialog-directory(directory)
    - message
    - prompt
    - file-dialog-finished as FileDialogCallback
    - completion as Pointer
do finally C:brixFileDialogRelease(dialog)
. chosen = completion.await() ?? List'Path()
= chosen[0] if chosen.length

━━━━━━━━━━━━━━━━━━━━
+ do choose-open-paths [Path]
    - window Window?
    - types [String] = List'String()
    - directory Path? = null
    - allows-multiple = false
    - chooses-files = true
    - chooses-directories = false
    - message = ""
    - prompt = ""

. completion = Completion'(List'Path)()
. dialog = C:brixFileDialogOpen
    - file-dialog-anchor(window)
    - file-dialog-types(types)
    - types.length
    - file-dialog-directory(directory)
    - allows-multiple
    - chooses-files
    - chooses-directories
    - message
    - prompt
    - file-dialog-finished as FileDialogCallback
    - completion as Pointer
do finally C:brixFileDialogRelease(dialog)
= completion.await() ?? List'Path()

━━━━━━━━━━━━━━━━━━━━
+ do choose-open-path Path?
    - window Window?
    - types [String] = List'String()
    - directory Path? = null
    - chooses-files = true
    - chooses-directories = false
    - message = ""
    - prompt = ""

. chosen = choose-open-paths
    - window
    - types
    - directory
    - false
    - chooses-files
    - chooses-directories
    - message
    - prompt
= chosen[0] if chosen.length

━━━━━━━━━━━━━━━━━━━━
+ FileDialogCallback is (*C) Void
    - request-pointer Pointer
    - paths CPointer'(CPointer'Char8)
    - count I32

━━━━━━━━━━━━━━━━━━━━
_ do file-dialog-anchor Pointer
    - window Window?

=? Pointer() if !window
window.ensure-native()
= window.native ?? Pointer()

━━━━━━━━━━━━━━━━━━━━
_ do file-dialog-types String[]
    - types [String]

. kinds = String[types.length]
for index in 0 .. < types.length
    kinds[index] = types[index]
= kinds

━━━━━━━━━━━━━━━━━━━━
_ file-dialog-directory String
    - directory Path?

if directory then directory as String else ""

━━━━━━━━━━━━━━━━━━━━
_ do file-dialog-finished
    - request-pointer Pointer
    - paths CPointer'(CPointer'Char8)
    - count I32

. completion = gc-object-from-pointer'(Completion'(List'Path))(request-pointer)
. chosen = List'Path()
for index in 0 .. < count
    chosen += Path(paths[index], 0)
completion.finish(chosen)
