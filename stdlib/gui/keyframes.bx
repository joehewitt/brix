(import /core/animatable)
(import /core/style)
(import /math)
(import /math/easing)
(import /math/motion)
(import /time/duration)
(import /units)
(blank)
(prop _ endless-frame-rate F64 (= 30))

(type + Repeat (is Union)
  (variant once)
  (variant forever)
  (variant times Int)
)

(type + AnimationDirection (is Union)
  (variant normal)
  (variant reverse)
  (variant alternate)
  (variant alternate-reverse)
)

(type + KeyframeStop (is Tuple)
  (prop + at F64)
  (prop + value (? (list F64)))
  (prop + easing Easing)
)

(type + KeyframeTrack
  (prop + style-index Index)
  (prop + offset Size)
  (prop + component (? Index))
  (prop + stops (list KeyframeStop))
  (prop + motion (? Motion))
  (prop + after Duration)
  (prop + over (? Duration))
  (prop + sample (? StyleObjectHolder) (= null))
  (fn-do + This _
    (param style-index _)
    (param offset _)
    (param component _)
    (param motion _)
    (param after _)
    (param over _)
  )
  (fn-expr + info (? StyleInfo) :get
    (call style-info-at style-index)
  )
  (fn-do + fill Bool
    (param into (list F64))
    (param elapsed Duration)
    (param span Duration)
    (param precision F64)
    (param open (list F64))
    (call (. into clear))
    (return-if false (if (== (. stops length) 0)))
    (blank)
    (let local (if-expr (> elapsed after) (- elapsed after) 0ns))
    (let first (?? (. ([] stops 0) value) open))
    (let found motion)
    (if (and found (== (. stops length) 2))
      (let last (?? (. ([] stops 1) value) open))
      (let moving false)
      (for (in index (..< 0 (. last length)))
        (let sample (call (. found sample) (- ([] first index) ([] last index)) 0 local precision))
        (+= into (+ ([] last index) (. sample offset)))
        (if (not (. sample is-done))
          (= moving true)
        )
      )
      (return moving)
    )
    (let length (?? over (if-expr (> span after) (- span after) 0ns)))
    (let seconds (as (as length Seconds) F64))
    (let progress (if-expr (> seconds 0) (call min (/ (as (as local Seconds) F64) seconds) 1.0) 1.0))
    (let place (call keyframe-place stops progress))
    (if (== (. place segment) 0)
      (++= into first)
      (return false)
    )
    (let from (?? (. ([] stops (- (. place segment) 1)) value) open))
    (let to (?? (. ([] stops (. place segment)) value) open))
    (for (in index (..< 0 (. to length)))
      (+= into (+ ([] from index) (* (- ([] to index) ([] from index)) (. place fraction))))
    )
    (return false)
  )
)

(type + KeyframeAnimation
  (prop + duration Duration)
  (prop + repeat Repeat)
  (prop + direction AnimationDirection)
  (prop + frame-rate (? F64))
  (prop + tracks (list KeyframeTrack))
  (fn-do + This _
    (param duration _)
    (param repeat _)
    (param direction _)
    (param frame-rate _)
  )
  (fn-do + clock-rate (? F64) :get
    (return-if frame-rate (if frame-rate))
    (blank)
    (match repeat
      (case= .forever
        (return endless-frame-rate)
      )
      (default
        (return null)
      )
    )
  )
  (fn-do + (of range Value) This
    (param property (of StyleProperty Value))
    (param from (? Value))
    (param to (? Value))
    (param motion (? Motion) (= null))
    (param after Duration (= 0ns))
    (param over (? Duration) (= null))
    (let track
      (call KeyframeTrack
        (block
          (arg (. property style-index))
          (arg (. property offset))
          (arg (. property component))
          (arg motion)
          (arg after)
          (arg over)
        )
      )
    )
    (+= (. track stops) (call KeyframeStop 0 (call keyframe-vector from) (. Easing linear)))
    (+= (. track stops) (call KeyframeStop 1 (call keyframe-vector to) (. Easing linear)))
    (= (. track sample) (?? (call keyframe-sample from) (call keyframe-sample to)))
    (+= tracks track)
    (return this)
  )
  (fn-do + (of track Value) This
    (param property (of StyleProperty Value))
    (param after Duration (= 0ns))
    (param over (? Duration) (= null))
    (+= tracks
      (call KeyframeTrack
        (block
          (arg (. property style-index))
          (arg (. property offset))
          (arg (. property component))
          (arg null)
          (arg after)
          (arg over)
        )
      )
    )
    (return this)
  )
  (fn-do + (of at Value) This
    (param property (of StyleProperty Value))
    (param at Ratio)
    (param value Value)
    (param easing Easing (= (. Easing linear)))
    (throw (call Panic "A keyframe stop belongs to a track") (if (== (. tracks length) 0)))
    (blank)
    (let track ([] tracks (- (. tracks length) 1)))
    (+= (. track stops) (call KeyframeStop at (call keyframe-vector value) easing))
    (= (. track sample) (?? (. track sample) (call keyframe-sample value)))
    (return this)
  )
)

(fn-expr + animation KeyframeAnimation
  (param duration Duration)
  (param repeat Repeat (= (. Repeat once)))
  (param direction AnimationDirection (= (. AnimationDirection normal)))
  (param frame-rate (? F64) (= null))
  (call KeyframeAnimation duration repeat direction frame-rate)
)

(fn-expr _ (of keyframe-vector Value) (? (list F64))
  (param value (? Value))
  (constraint is Value Animatable)
  (?. value motion-vector)
)

(fn-expr _ keyframe-vector (? (list F64))
  (param value (? F64))
  (if-expr (== value null) null (list value))
)

(fn-expr _ (of keyframe-sample Value) (? StyleObjectHolder)
  (param value (? Value))
  (constraint is Value Animatable)
  (only-if (call (of StyleWideHolder Value) value) (if value))
)

(fn-expr _ keyframe-sample (? StyleObjectHolder)
  (param value (? F64))
  null
)
