(import ./box)
(import ./color-picker)
(import ./color-well)
(import ./events)
(import ./number-field)
(import ./position)
(import ./primitives)
(import ./shorthands)
(import ./styles)
(import ./text-input)
(import ./theme)
(import /graphics/color)
(import /graphics/primitives)
(import /graphics/text)
(import /math)
(import /ui/value-change-phase)

(style-extend GUIDefaultTheme
  (using GUIBoxCursor)
  (using GUIBoxMotion)
  (using GUIBoxPaint)
  (using GUIBoxSize)
  (using GUIBoxSpacing)
  (using GUIFocusRingStyle)
  (using GUIFontStyle)
  (using GUITextPaint)
  (rule ColorField (• bg gui-field-color) (• text gui-text-color) (• h gui-control-height) (• pl 3) (• pr 6)
    (= font-size gui-control-font-size)
    (= corner-radius gui-control-radius)
    (= shadow gui-control-shadow)
    (blank)
    (when-style #is-focus-within
      (= focus-ring gui-focus-ring)
      (= (. motion focus-ring) gui-motion-quick)
    )
    (blank)
    (rule ColorWell
      (when-style #is-focus-visible
        (= focus-ring null)
      )
    )
    (blank)
    (rule color-field-hex (• ml 6)
      (= min-height (- gui-control-height 2))
      (= max-height (- gui-control-height 2))
    )
    (blank)
    (rule color-field-alpha (• bg null) (• w 46) (• ml 4) (• pl 0) (• pr 0)
      (= min-height (- gui-control-height 2))
      (= max-height (- gui-control-height 2))
      (= shadow null)
      (when-style #is-focus-within
        (= focus-ring null)
      )
      (blank)
      (rule number-field-entry
        (= text-alignment (. TextAlignment right))
      )
    )
  )
)

(type + ColorField (is Box)
  (prop + color _ (= (call RGBA 0 0 0)))
  (prop + is-mixed _ (= false))
  (prop + live-edit-delay _ (= gui-live-edit-delay))
  (event + value-changing (of ValueChange RGBA))
  (event + value-changed (of ValueChange RGBA))
  (blank)
  (prop _ is-live-applying _ (= false))
  (content
    (<> This (• flex-row)
      (<> ColorWell (id: well)
        (= align-y (. Alignment center))
        (= color #color)
        (= is-mixed #is-mixed)
        (for (on event value-changed)
          (call accept-color (. event value) (. event phase))
        )
      )
      (<> TextInput (id: hex-entry) (• color-field-hex) (• flex 1)
        (= is-bare true)
        (= align-y (. Alignment center))
        (= text (call color-field-hex-text #color #is-mixed))
        (= placeholder (if-expr #is-mixed "Mixed" ""))
        (= live-edit-delay #live-edit-delay)
        (for (on event text-edited)
          (call accept-hex-edit (. event text) (. event phase))
          (call (. event cancel))
        )
        (for (on event change)
          (call accept-hex (. event text))
          (call (. event cancel))
        )
      )
      (<> NumberField (id: alpha-entry) (• color-field-alpha)
        (= align-y (. Alignment center))
        (= value (call round (* (call clamp-unit (. #color alpha)) 100)))
        (= minimum 0)
        (= maximum 100)
        (= precision 0)
        (= unit "%")
        (= scrub-handle (. NumberFieldScrubHandle unit))
        (= is-mixed #is-mixed)
        (= live-edit-delay #live-edit-delay)
        (for (on event value-changed)
          (call accept-color (call (. color with-alpha) (/ (. event value) 100)) (. event phase))
        )
      )
    )
  )
  (fn-do + accept-color _
    (param next RGBA)
    (param phase ValueChangePhase (= (. ValueChangePhase discrete)))
    (return-if (if (not is-effectively-enabled)))
    (let old color)
    (let unchanged (and (== (call pack-rgba8 old) (call pack-rgba8 next)) (not is-mixed)))
    (return-if (if (and unchanged (or (== phase (. ValueChangePhase discrete)) (== phase (. ValueChangePhase changed))))))
    (if (not unchanged)
      (let change (call (of ValueChange RGBA) old next phase))
      (<- value-changing change)
      (return-if (if (. change is-canceled)))
    )
    (= color next)
    (= is-mixed false)
    (<- value-changed (call (of ValueChange RGBA) old next phase))
  )
  (fn-do + accept-hex _
    (param text String)
    (let parsed (call color-input-value text (. color alpha)))
    (if parsed
      (call accept-color parsed)
    )
    (= (. hex-entry text) (call color-field-hex-text color is-mixed))
  )
  (fn-do + accept-hex-edit _
    (param text String)
    (param phase ValueChangePhase)
    (let parsed (call color-input-value text (. color alpha)))
    (if (== phase (. ValueChangePhase ended))
      (call finish-live-edit parsed)
      (= (. hex-entry text) (call color-field-hex-text color is-mixed))
      (return)
    )
    (return-if (if (or (not parsed) (not (call color-field-hex-is-complete text)))))
    (call apply-live-edit parsed)
  )
  (fn-do _ apply-live-edit _
    (param next RGBA)
    (let phase (if-expr is-live-applying (. ValueChangePhase changed) (. ValueChangePhase began)))
    (= is-live-applying true)
    (call accept-color next phase)
  )
  (fn-do _ finish-live-edit _
    (param next (? RGBA))
    (if is-live-applying
      (= is-live-applying false)
      (call accept-color (?? next color) (. ValueChangePhase ended))
      (else-if next
        (call accept-color next)
      )
    )
  )
)

(fn-expr + color-field-hex-text String
  (param color RGBA)
  (param is-mixed Bool)
  (if-expr is-mixed "" (call hex-text color))
)

(fn-expr + color-field-hex-is-complete Bool
  (param text String)
  (or (== (. digits length) 6) (== (. digits length) 8))
  (where
    (lazy trimmed (call (. text trim)))
    (lazy digits (if-expr (call (. trimmed starts-with) "#") ([] trimmed (..< 1 (. trimmed length))) trimmed))
  )
)
