canvas.begin()
canvas.move(outer.x, outer.y)
canvas.line(outer.right, outer.y)
canvas.line(outer.right, outer.bottom)
canvas.line(outer.x, outer.bottom)
canvas.enclose()
path(node, rect, canvas)
canvas.clip-path(FillRule.even-odd)

