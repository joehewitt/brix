+ BoxShape

────────────────────
+ do path
    - node Box
    - rect Rect
    - canvas Canvas

canvas.move(rect.x, rect.y)
canvas.line(rect.right, rect.y)
canvas.line(rect.right, rect.bottom)
canvas.line(rect.x, rect.bottom)
canvas.enclose()

────────────────────
+ outsets Insets
    - node Box

Insets(0, 0, 0, 0)

────────────────────
+ extent Rect
    - node Box
    - rect Rect

Rect
    - rect.x - reach.left
    - rect.y - reach.top
    - rect.width + reach.left + reach.right
    - rect.height + reach.top + reach.bottom

.. reach = outsets(node)

────────────────────
+ exact-outline Outline?
    - node Box
    - rect Rect

null

────────────────────
+ do contains Bool
    - node Box
    - rect Rect
    - point Point

if !shape-hit-probe
    shape-hit-probe = RasterCanvas(1, 1, 1, transparent)
. probe = shape-hit-probe!
probe.begin()
path(node, rect, probe)
= probe.path-contains(point)

────────────────────
