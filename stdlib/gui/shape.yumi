━━━━━━━━━━━━━━━━━━━━
+ CalloutShape is OutlineShape

+ size Length = 8
+ side Side = Side.top
+ offset Length? = null

────────────────────
+ This
    - callout-size Length = 8
    - callout-side Side = Side.top
    - callout-offset Length? = null

size = callout-size
side = callout-side
offset = callout-offset

────────────────────
+ outline Outline
    - node Box
    - rect Rect

Outline(rect, node.computed-corner-radius, OutlineArrow(arrow-side, arrow-offset, size))

.. arrow-side = node.callout-side ?? side
.. span = if arrow-side == Side.left || arrow-side == Side.right then rect.height else rect.width
.. arrow-offset = node.callout-offset ?? offset ?? span / 2

────────────────────
+ outsets Insets
    - node Box

match node.callout-side ?? side
    |= Side.top
        Insets(size, 0, 0, 0)
    |= Side.bottom
        Insets(0, 0, size, 0)
    |= Side.left
        Insets(0, 0, 0, size)
    ??
        Insets(0, size, 0, 0)

────────────────────
+ get anchor-gap

size
