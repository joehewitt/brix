────────────────────

<This • flex-col
    <KeyShortcut "Previous"
        key = .arrow-up
        discoverable = false
        action = => do move-selection(-1)

    <KeyShortcut "Next"
        key = .arrow-down
        discoverable = false
        action = => do move-selection(1)

    <KeyShortcut "Extend up"
        key = KeyModifier.shift + Key.arrow-up
        discoverable = false
        when = => selection-mode == SelectionMode.multiple
        action = => do move-selection(-1, true)

    <KeyShortcut "Extend down"
        key = KeyModifier.shift + Key.arrow-down
        discoverable = false
        when = => selection-mode == SelectionMode.multiple
        action = => do move-selection(1, true)

    <KeyShortcut "Page Up"
        key = .page-up
        discoverable = false
        action = => do move-selection(-page-row-step, false, true)

    <KeyShortcut "Page Down"
        key = .page-down
        discoverable = false
        action = => do move-selection(page-row-step, false, true)

    <KeyShortcut "First"
        key = .home
        discoverable = false
        action = => do select-edge(false)

    <KeyShortcut "Last"
        key = .end
        discoverable = false
        action = => do select-edge(true)

    <KeyShortcut "Select All"
        key = KeyModifier.command + "a"
        discoverable = false
        when = => selection-mode == SelectionMode.multiple
        action = => do select-all()

    <KeyShortcut "Activate"
        key = .enter
        repeat = false
        discoverable = false
        action = => do commit-selection()

    if #is-empty && #empty-text
        <Label • list-empty
            text = #empty-text

