────────────────────
+ get first-row

selectable-rows() |> first

────────────────────
+ get page-row-step Int

|? row-height <= 0 || step < 1
    1
??
    step as Int

.. viewport = content-bounds.height
.. step = viewport / row-height
.. row-height = (first-row?.bounds.height ?? 0)

────────────────────
+ do is-key-selected Bool
    - key String?

=? false if key == null
if is-selected-set-stale
    selected-set.clear()
    for selected in selected-keys
        selected-set[selected] = true
    is-selected-set-stale = false
= selected-set has key

────────────────────
+ do select-key
    - key String?
    - extends = false
    - toggles = false

pending-key = null
if !key
    selected-key = null
    selection-anchor = null
    change-selection(List'String())
    =
. anchor = if is-key-selected(selection-anchor) then kept-anchor else selected-key
    .. kept-anchor = selection-anchor ?? selected-key
. keys = selection-after-press
    - selection-mode
    - selected-keys
    - key
    - selection-order()
    - anchor
    - extends
    - toggles
selection-anchor = if extends && anchor then anchor else key
selected-key = key
change-selection(keys)
reveal-key(key)

────────────────────
+ do select-all

=? if selection-mode != SelectionMode.multiple
change-selection(selection-order())

────────────────────
+ do change-selection
    - keys [String]

. old = selected-keys
=? if old == keys
. change = SelectionEvent'[String](old, keys)
selection-changing <- change
=? if change.is-canceled
selected-keys = keys
selection-changed <- SelectionEvent'[String](old, keys)

────────────────────
+ do move-selection
    - offset Int
    - extends = false
    - clamps = false

. order = selection-order()
. index = order.find(selected-key) if selected-key
if index != null && !selected-keys.length
    select-key(selected-key, extends)
    =
. cursor = ListCursor(order.length, index)
. target = if clamps then clamped-target else cursor.stepped(offset)
    .. clamped-target = cursor.clamped(offset) ?? cursor.stepped(offset)
if target != null
    select-key(order[target], extends)
else if selected-key
    reveal-key(selected-key)

────────────────────
+ do select-edge
    - last Bool

. order = selection-order()
=? if !order.length
select-key(if last then order[order.length - 1] else order[0])

────────────────────
+ do activate-selection

ensure-selection()
=? if !selected-key
item-activated <- ActivateEvent()

────────────────────
+ do commit-selection

activate-selection()
. key = selected-key
if key
    choose-key(key)

────────────────────
+ do choose-key
    - key String

=? if !can-choose(key)
chosen <- ChooseEvent(key)

────────────────────
+ can-choose Bool
    - key String

true

────────────────────
+ press-activates Bool
    - row ListItem

true

────────────────────
+ do ensure-selection

=? if selected-key && selection-order().find(selected-key!) != null
select-edge(false)

────────────────────
+ selection-order [String]

List'String
    ** selectable-rows()
    *> key-of-row(each)!

────────────────────
+ title-for-key String
    - key String

listed-row(key)?.text ?? ""

────────────────────
+ key-of-row String?
    - row ListItem?

match row
    |= null
        null
    ??
        if row.key then row.key else row.text

────────────────────
+ do reveal-key
    - key String

. row = listed-row(key)
if row
    root.ensure-visible
        - row
        - ScrollAlignment.nearest
        - Insets(0, 0, 0, 0)
        - ScrollCause.focus

────────────────────
+ do rows-changed

is-empty = !first-row
show-selection()

────────────────────
+ do show-selection

for row in selectable-rows()
    . selected = is-key-selected(key-of-row(row))
    if row.is-selected != selected
        row.is-selected = selected

────────────────────
+ row-at
    - event GUIEvent

match event.hit-box
    |= null
        null
    ??
        valid-row(it.ancestor-or-self'ListItem ?? it.style-target?.ancestor-or-self'ListItem)

────────────────────
+ selectable-rows @inline

** active-children
?*> selectable-row(each)

────────────────────
+ do selectable-row @inline
    - node Box

if node is ListItem
    . row = node as ListItem
    if row.is-enabled && row.is-display-visible
        = row

────────────────────
+ valid-row
    - row ListItem?

selectable-row(row) if row

────────────────────
_ do listed-row ListItem?
    - key String

for row in selectable-rows()
    =? row if key-of-row(row) == key

────────────────────
_ do press-row
    - event PointerDownEvent

pending-key = null
. row = row-at(event)
=? if !row || event.button != PointerButton.primary || event.modifiers.control || press-lands-in-control(event, row)
. key = key-of-row(row)
=? if !key
if event.click-count == 2 && press-activates(row)
    if chooses-on-press
        activate-selection()
    else
        commit-selection()
=? if event.click-count > 1
if press-waits-for-release(key, event.modifiers)
    pending-key = key
else
    press-key(key, event.modifiers)

────────────────────
_ do press-key
    - key String
    - modifiers PointerModifiers

select-key(key, modifiers.shift, modifiers.command)
if chooses-on-press && !modifiers.shift && !modifiers.command
    choose-key(key)

────────────────────
_ press-waits-for-release Bool
    - key String
    - modifiers PointerModifiers

!modifiers.shift && is-key-selected(key) && (modifiers.command || selected-keys.length > 1)

────────────────────
_ do press-lands-in-control Bool
    - event GUIEvent
    - row ListItem

. cursor Box? = event.hit-box
while cursor
    . box = cursor
    =? false if box as Pointer == row as Pointer || box as Pointer == this as Pointer
    =? true if box is Button || focus-mode-can-focus(box.$focus-mode)
    cursor = box.material-parent
= false

────────────────────
_ do type-select-key
    - event KeyPressEvent

. text = event.typed-text
=? if !text || (text == " " && !type-select.is-active)
. order = selection-order()
. titles = List'String
    ** order
    *> title-for-key(each)
. found = type-select.find(text, titles, order.find(selected-key) if selected-key)
=? if found == null
select-key(order[found])
event.cancel()

────────────────────
_ do selected-keys-changed

is-selected-set-stale = true
show-selection()

