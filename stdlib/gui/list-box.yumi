────────────────────
+ can-scroll
    - direction ScrollDirection

!is-horizontal && (super.can-scroll(direction))

.. is-horizontal = direction == ScrollDirection.left || direction == ScrollDirection.right

────────────────────
+ do reveal-focus

if !selected-key
    . order = selection-order()
    if order.length
        selected-key = order[0]
if selected-key
    reveal-key(selected-key)
else
    super.reveal-focus()

