(import ./box)
(import ./events)
(import ./primitives)
(import ./shorthands)
(import ./styles)
(import ./theme)
(import ./window)
(import /BxAppleGUI/BxAppleGUI.h)
(import /core/intrinsics)
(import /graphics/color)
(import /graphics/matrix)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/text)
(import /math)
(import /time/duration)
(import /ui/input)
(import /ui/undo-target)
(import /ui/value-change-phase)
(blank)
(prop + gui-live-edit-delay Duration (= 350ms))

(style-extend GUIDefaultTheme
  (using GUIBoxMotion)
  (using GUIBoxPaint)
  (using GUIBoxSize)
  (using GUIFocusRingStyle)
  (using GUIBoxSpacing)
  (rule TextInput (• bg gui-field-color) (• h gui-control-height) (• px 6)
    (= corner-radius gui-control-radius)
    (= shadow gui-control-shadow)
    (blank)
    (when-style #is-focused
      (= focus-ring gui-focus-ring)
      (= (. motion focus-ring) gui-motion-quick)
    )
    (blank)
    (when-style #wraps
      (• py 3)
      (= min-height (. SizeSpec auto))
      (= max-height (. SizeSpec auto))
    )
    (blank)
    (when-style #is-bare
      (• bg transparent)
      (• p 0)
      (= min-height (. SizeSpec auto))
      (= max-height (. SizeSpec auto))
      (= border-width 0)
      (= shadow null)
      (= focus-ring null)
    )
  )
)

(type + TextInput (is Box)
  (implements UndoTarget)
  (implements TextEditing)
  (using GUIInlineOutset)
  (rule This
    (= focus-mode (. FocusMode input))
    (= window-draggable false)
  )
  (blank)
  (prop + text _ (= ""))
  (prop + placeholder _ (= ""))
  (prop + is-bare _ (= false))
  (prop + is-read-only _ (= false))
  (prop + is-secure _ (= false))
  (prop + max-length (? Size))
  (prop + fits-text _ (= false))
  (prop + wraps _ (= false))
  (prop + accepts-newlines _ (= false))
  (prop + centers-wrapped-text _ (= false))
  (prop + max-lines (? Size))
  (prop + selection-start Size (= 0))
  (prop + selection-end Size (= 0))
  (prop + native (? Pointer))
  (prop + undo-target _ (=> this))
  (prop + is-focus-ready _ (=> (or is-native-shown (not is-natively-hosted))))
  (prop + inline-ascent _ (=> (only-if (call fitted-inline-ascent) (if fits-text))))
  (prop + inline-outset _ (=> (call Dimensions $inline-outset-x $inline-outset-y)))
  (prop + native-focus-handle _ (=> native))
  (prop + native-text-color (? RGBA))
  (prop + native-font (? Font))
  (prop _ native-font-zoom F64)
  (prop + native-text-alignment (? TextAlignment))
  (prop + live-edit-delay (? Duration))
  (prop + passes-keys (list Key))
  (blank)
  (prop _ committed-text _ (= ""))
  (prop _ is-dirty _ (= false))
  (prop _ is-native-editing _ (= false))
  (prop _ accepting-native-text _ (= false))
  (prop _ pending-live-edit (? Task))
  (prop _ is-live-editing _ (= false))
  (prop _ is-native-shown _ (= false))
  (prop _ is-natively-hosted _ (=> (!= (?. window native-window-handle) null)))
  (prop _ fitted-ascent Length (= 0))
  (prop _ wrapped-ascent Length (= 0))
  (prop _ wrapped-line-height Length (= 0))
  (prop _ wrapped-text-height Length (= 0))
  (prop _ native-frame-width (? Length))
  (prop _ native-fitting-height (? Length))
  (prop _ native-text-inset Length (= 0))
  (prop _ native-text-bottom-inset Length (= 0))
  (prop _ has-selection-request _ (= false))
  (blank)
  (depends intrinsic-content-changed text placeholder fits-text wraps max-lines)
  (depends programmatic-text-changed text)
  (depends native-wraps-changed wraps)
  (depends native-accepts-newlines-changed accepts-newlines)
  (depends native-enabled-changed is-effectively-enabled)
  (depends native-editable-changed is-read-only)
  (depends native-secure-changed is-secure)
  (depends native-max-length-changed max-length)
  (depends native-passed-keys-changed passes-keys)
  (fn-do + mounted _
    (call (. super mounted))
    (let host-box window)
    (return-if (if (not host-box)))
    (blank)
    (let host-window (as host-box Window))
    (blank)
    (call (. host-window ensure-native))
    (return-if (if (not (. host-window native))))
    (blank)
    (= native (call C:brixGuiTextInputCreate (. host-window native) 0 0 0 0 text placeholder))
    (call set-native-peer-artifact-required true)
    (call C:brixGuiTextInputSetEventCallback
      (block
        (arg (!! native))
        (arg (as gui-text-input-event GuiTextInputEventCallback))
        (arg (as this Pointer))
      )
    )
    (call C:brixGuiTextInputSetEnabled (!! native) is-effectively-enabled)
    (call C:brixGuiTextInputSetEditable (!! native) (not is-read-only))
    (call C:brixGuiTextInputSetSecure (!! native) is-secure)
    (call native-max-length-changed)
    (call C:brixGuiTextInputSetWraps (!! native) wraps)
    (call C:brixGuiTextInputSetAcceptsNewlines (!! native) accepts-newlines)
    (call native-passed-keys-changed)
    (call sync-native-cursor)
    (call sync-native-text-color)
    (call sync-native-font)
    (call sync-native-text-alignment)
    (call sync-native-selection)
    (= committed-text text)
    (call invalidate-content-size)
  )
  (fn-do + unmounted _
    (call (. super unmounted))
    (if native
      (call C:brixGuiTextInputRelease native)
      (= native null)
    )
    (= native-text-color null)
    (= native-font null)
    (= native-font-zoom 0)
    (= native-text-alignment null)
    (= native-frame-width null)
    (= native-fitting-height null)
    (= native-text-inset 0)
    (= native-text-bottom-inset 0)
    (= is-native-shown false)
  )
  (fn-do + did-layout _
    (return-if (if (not native)))
    (blank)
    (if (not is-native-editing)
      (call C:brixGuiTextInputSetText native text)
    )
    (call C:brixGuiTextInputSetPlaceholder (!! native) placeholder)
    (call C:brixGuiTextInputSetEnabled (!! native) is-effectively-enabled)
  )
  (fn-do + sync-native-geometry-self _
    (param native-origin Point)
    (param visible Bool)
    (param native-parent (? Pointer))
    (param transform (? Matrix))
    (return-if (if (not native)))
    (blank)
    (call sync-native-font)
    (call sync-native-text-alignment)
    (let zoom native-zoom)
    (let content content-bounds)
    (let left (- (. content x) (. native-origin x)))
    (let top (- (. content y) (. native-origin y)))
    (call C:brixGuiTextInputSetContainer (!! native) (?? native-parent (call Pointer)))
    (if (not wraps)
      (call sync-native-text-insets 0 0)
    )
    (if fits-text
      (let fitting-height (call native-line-fitting-height))
      (let width (if-expr is-focused (+ (. content width) (call fitted-editing-slack)) (. content width)))
      (call set-native-frame left top width fitting-height native-origin transform)
      (let text-x Length (/ (call C:brixGuiTextInputGetTextOriginX (!! native)) zoom))
      (let baseline Length (/ (call C:brixGuiTextInputGetTextBaseline (!! native)) zoom))
      (call set-native-frame
        (block
          (arg (- left text-x))
          (arg (- (+ top fitted-ascent) baseline))
          (arg (+ width (* text-x 2)))
          (arg fitting-height)
          (arg native-origin)
          (arg transform)
        )
      )
      (else-if wraps
        (if (not wrapped-line-height)
          (call measure-wrapped (. content width))
        )
        (call C:brixGuiTextInputSetLineMetrics (!! native) (* wrapped-line-height zoom) (* $line-spacing zoom))
        (let native-width (* (. content width) zoom))
        (if (!= native-frame-width native-width)
          (call set-native-frame left top (. content width) (. content height) native-origin transform)
          (= native-frame-width native-width)
        )
        (let text-x Length (/ (call C:brixGuiTextInputGetTextOriginX (!! native)) zoom))
        (let baseline Length (/ (- (call C:brixGuiTextInputGetTextBaseline (!! native)) native-text-inset) zoom))
        (let padding padding-edges)
        (let slack (if-expr centers-wrapped-text (/ (call max 0 (- (. content height) wrapped-text-height)) 2) 0))
        (let inset
          (scope (/ (call gui-device-aligned scaled-inset device-scale) zoom)
            (lazy scaled-inset (* (call max 0 (- (+ (. padding top) slack wrapped-ascent) baseline)) zoom))
          )
        )
        (let overflows (> wrapped-text-height (+ (. content height) 0.5)))
        (let bottom-inset (if-expr overflows (. padding bottom) 0))
        (call sync-native-text-insets (* inset zoom) (* bottom-inset zoom))
        (let shift (- (+ wrapped-ascent slack) baseline inset))
        (let growth (if-expr overflows 0 (+ wrapped-line-height $line-spacing)))
        (call set-native-frame
          (block
            (arg (- left text-x))
            (arg (+ top shift))
            (arg (+ (. content width) (* text-x 2)))
            (arg (+ (- (+ (. content height) (. padding bottom)) shift) growth))
            (arg native-origin)
            (arg transform)
          )
        )
      )
      (else
        (let fitting-height (call native-line-fitting-height))
        (let line-height (call min (. content height) fitting-height))
        (call set-native-frame
          (block
            (arg left)
            (arg (+ top (/ (- (. content height) line-height) 2)))
            (arg (. content width))
            (arg line-height)
            (arg native-origin)
            (arg transform)
          )
        )
      )
    )
    (call C:brixGuiTextInputSetVisible (!! native) visible)
    (call C:brixGuiTextInputSetOpacity (!! native) effective-opacity)
    (call sync-native-cursor)
    (call sync-native-text-color)
    (if (!= is-native-shown visible)
      (= is-native-shown visible)
      (let host window)
      (if (and visible host)
        (call (. (as host Window) schedule-render))
      )
    )
  )
  (fn-do _ set-native-frame _
    (param x Length)
    (param y Length)
    (param width Length)
    (param height Length)
    (param native-origin Point)
    (param transform (? Matrix))
    (let zoom native-zoom)
    (let corner (call native-placed-point (call Point x y) native-origin transform))
    (let linear (?? transform (call Matrix)))
    (call C:brixGuiTextInputSetFrame
      (block
        (arg (!! native))
        (arg (* (. corner x) zoom))
        (arg (* (. corner y) zoom))
        (arg (* width zoom))
        (arg (* height zoom))
        (arg (. linear a))
        (arg (. linear c))
        (arg (. linear b))
        (arg (. linear d))
      )
    )
    (let box bounds)
    (call C:brixGuiTextInputSetHitRect
      (block
        (arg (!! native))
        (arg (* (- (. box x) (. native-origin x) x) zoom))
        (arg (* (- (. box y) (. native-origin y) y) zoom))
        (arg (* (. box width) zoom))
        (arg (* (. box height) zoom))
      )
    )
  )
  (fn-do _ sync-native-text-insets _
    (param top Length)
    (param bottom Length)
    (return-if (if (and (< (call abs (- native-text-inset top)) 0.001) (< (call abs (- native-text-bottom-inset bottom)) 0.001))))
    (blank)
    (= native-text-inset top)
    (= native-text-bottom-inset bottom)
    (call C:brixGuiTextInputSetTextInsets (!! native) top bottom)
  )
  (fn-do + sync-native-cursor _
    (return-if (if (not native)))
    (blank)
    (call C:brixGuiTextInputSetCursorStyle
      (block
        (arg native)
        (arg (call cursor-style-native-value $cursor))
        (arg (call cursor-style-native-image $cursor))
      )
    )
  )
  (fn-expr + measured-content-size _
    (param query MeasureQuery)
    (case? fits-text
      (call fitted-content-size)
    )
    (case? wraps
      (call wrapped-content-size query)
    )
    (case? (not native)
      (call Dimensions 120 22)
    )
    (default
      (call native-fitting-size)
    )
  )
  (fn-do _ native-line-fitting-height Length
    (let cached native-fitting-height)
    (return-if cached (if cached))
    (blank)
    (let height Length (/ (call C:brixGuiTextInputGetFittingHeight (!! native)) native-zoom))
    (= native-fitting-height height)
    (return height)
  )
  (fn-do _ native-fitting-size Dimensions
    (call apply-native-font)
    (let zoom native-zoom)
    (return
      (call Dimensions
        (block
          (arg (/ (call C:brixGuiTextInputGetFittingWidth (!! native)) zoom))
          (arg (/ (call C:brixGuiTextInputGetFittingHeight (!! native)) zoom))
        )
      )
    )
  )
  (fn-do _ wrapped-content-size Dimensions
    (param query MeasureQuery)
    (let inner (. (call derived-child-measure-query query) inline))
    (let proposed (?? (. inner available) (. inner max) 120))
    (let width (call constrained-axis-size (call gui-safe-span proposed) (. query inline) $min-width $max-width))
    (let height (call measure-wrapped width))
    (let lines (if-expr (== (. query block mode) (. AxisMeasureMode min-content)) 1 max-lines))
    (return-if (call Dimensions width height) (if (== lines null)))
    (blank)
    (let count (as (call max lines 1) Length))
    (return (call Dimensions width (call min height (+ (* count wrapped-line-height) (* (- count 1) $line-spacing)))))
  )
  (fn-do _ measure-wrapped Length
    (param width Length)
    (let font (call Font $font-family $font-size $font-weight))
    (let sample (if-expr (. text length) text placeholder))
    (let measured (if-expr (call (. sample ends-with) "\n") (str sample " ") sample))
    (let segments (call (of List TextSegment) (call TextSegment 0 (if-expr (. measured length) measured " ") font)))
    (let layout (use (call TextLayout segments font width (. TextOverflow clip) (. TextWrap word) $line-spacing)))
    (= wrapped-ascent (. layout ascent))
    (= wrapped-line-height (+ (. layout ascent) (. layout descent) (. layout leading)))
    (= wrapped-text-height (. layout height))
    (return (. layout height))
  )
  (fn-do _ fitted-content-size Dimensions
    (let sample (if-expr (. text length) text placeholder))
    (let layout
      (use
        (call TextLayout
          (block
            (arg
              (call TextLayoutRequest
                (block
                  (arg (if-expr (. sample length) sample " "))
                  (arg (call Font $font-family $font-size $font-weight))
                )
              )
            )
          )
        )
      )
    )
    (= fitted-ascent (. layout ascent))
    (return (call Dimensions (+ (call ceil (. layout width)) 1) (+ (. layout ascent) (. layout descent))))
  )
  (fn-expr _ fitted-editing-slack Length
    (call ceil (* $font-size 2))
  )
  (fn-do _ fitted-inline-ascent Length
    (call measure)
    (return (+ (. margin-edges top) (. border-edges top) (. padding-edges top) fitted-ascent))
  )
  (subscribe-for (on event copy)
    (if (> selection-end selection-start)
      (call (. event cancel))
    )
  )
  (subscribe-for (on event cut)
    (call (. event cancel))
  )
  (fn-do + replace-text _
    (param value String)
    (= text value)
    (if native
      (call C:brixGuiTextInputReplaceText native value)
    )
  )
  (fn-do + place-caret-at-end _
    (if native
      (call C:brixGuiTextInputMoveCaretToEnd native)
    )
  )
  (fn-do + select-range _
    (param start Size)
    (param end Size)
    (= selection-start (call min start (. text length)))
    (= selection-end (call min (call max end selection-start) (. text length)))
    (= has-selection-request true)
    (call sync-native-selection)
  )
  (fn-do _ sync-native-selection _
    (return-if (if (or (not native) (not has-selection-request))))
    (blank)
    (call C:brixGuiTextInputSetSelection
      (block
        (arg native)
        (arg ([] text (..< 0 selection-start)))
        (arg ([] text (..< selection-start selection-end)))
      )
    )
  )
  (fn-do _ native-enabled-changed _
    (if native
      (call C:brixGuiTextInputSetEnabled native is-effectively-enabled)
    )
  )
  (fn-do _ native-editable-changed _
    (if native
      (call C:brixGuiTextInputSetEditable native (not is-read-only))
    )
  )
  (fn-do _ native-secure-changed _
    (= native-fitting-height null)
    (if native
      (call C:brixGuiTextInputSetSecure native is-secure)
    )
  )
  (fn-do _ native-max-length-changed _
    (if native
      (call C:brixGuiTextInputSetMaxLength native (?? max-length 0))
    )
  )
  (fn-do _ native-wraps-changed _
    (if native
      (call C:brixGuiTextInputSetWraps native wraps)
    )
  )
  (fn-do _ native-accepts-newlines-changed _
    (if native
      (call C:brixGuiTextInputSetAcceptsNewlines native accepts-newlines)
    )
  )
  (fn-do _ native-passed-keys-changed _
    (return-if (if (not native)))
    (blank)
    (let mask U32)
    (for (in key passes-keys)
      (= mask (/or/ mask (call text-input-passed-key-bit key)))
    )
    (call C:brixGuiTextInputSetPassedKeys (!! native) mask)
  )
  (fn-do _ sync-native-text-color _
    (return-if (if (not native)))
    (blank)
    (let color $color)
    (return-if (if (== native-text-color color)))
    (blank)
    (call C:brixGuiTextInputSetTextColor
      (block
        (arg (!! native))
        (arg (. color red))
        (arg (. color green))
        (arg (. color blue))
        (arg (. color alpha))
      )
    )
    (= native-text-color color)
  )
  (fn-do _ sync-native-text-alignment _
    (return-if (if (not native)))
    (blank)
    (let alignment $text-alignment)
    (return-if (if (== native-text-alignment alignment)))
    (blank)
    (let code I32
      (block
        (case? (== alignment (. TextAlignment center))
          1
        )
        (case? (== alignment (. TextAlignment right))
          2
        )
        (default
          0
        )
      )
    )
    (call C:brixGuiTextInputSetAlignment (!! native) code)
    (= native-text-alignment alignment)
  )
  (fn-do _ sync-native-font _
    (if (call apply-native-font)
      (call invalidate-content-size)
    )
  )
  (fn-do _ apply-native-font Bool
    (return-if false (if (not native)))
    (blank)
    (let font (call Font $font-family $font-size $font-weight))
    (let zoom native-zoom)
    (return-if false (if (and (== native-font font) (== native-font-zoom zoom))))
    (blank)
    (call C:brixGuiTextInputSetFont (!! native) (. font family) (* (. font size) zoom) (. font weight trait))
    (= native-font font)
    (= native-font-zoom zoom)
    (= native-fitting-height null)
    (return true)
  )
  (fn-do _ intrinsic-content-changed _
    (= native-fitting-height null)
    (call invalidate-content-size)
  )
  (fn-do _ programmatic-text-changed _
    (return-if (if (or accepting-native-text (and is-native-editing is-dirty))))
    (blank)
    (= committed-text text)
    (if native
      (call C:brixGuiTextInputSyncText native text)
    )
  )
  (fn-do + accept-native-input _
    (param next-text String)
    (param start (? Size) (= null))
    (param end (? Size) (= null))
    (= is-native-editing true)
    (= is-dirty (!= next-text committed-text))
    (let caret (call min (?? start selection-start) (. next-text length)))
    (= selection-start caret)
    (= selection-end (call min (call max (?? end selection-end) caret) (. next-text length)))
    (return-if (if (== next-text text)))
    (blank)
    (= accepting-native-text true)
    (= text next-text)
    (= accepting-native-text false)
    (<- input (call InputEvent text))
    (call schedule-live-edit)
  )
  (fn-do + accept-native-paste _
    (let pasting (call PasteEvent))
    (<- paste pasting)
    (return-if (if (. pasting is-canceled)))
    (blank)
    (if native
      (call C:brixGuiTextInputPasteText native)
    )
  )
  (fn-do + accept-native-copy _
    (<- copy (call CopyEvent))
  )
  (fn-do + accept-native-selection _
    (param next-text String)
    (param start Size)
    (param end Size)
    (return-if (call accept-native-input next-text start end) (if (!= next-text text)))
    (blank)
    (let caret (call min start (. text length)))
    (let last (call min (call max end caret) (. text length)))
    (return-if (if (and (== caret selection-start) (== last selection-end))))
    (blank)
    (= selection-start caret)
    (= selection-end last)
    (<- text-selected (call TextSelectionEvent caret last))
  )
  (fn-do + accept-native-commit _
    (param next-text String)
    (call accept-native-input next-text)
    (= is-native-editing false)
    (call (?. pending-live-edit cancel-later))
    (= pending-live-edit null)
    (if is-live-editing
      (= is-live-editing false)
      (<- text-edited (call TextEditEvent text (. ValueChangePhase ended)))
    )
    (if (== committed-text text)
      (call sync-native-text)
      (return)
    )
    (let old-text committed-text)
    (= committed-text text)
    (= is-dirty false)
    (<- change (call ChangeEvent old-text text))
    (call sync-native-text)
  )
  (fn-do _ schedule-live-edit _
    (let delay live-edit-delay)
    (return-if (if (not delay)))
    (blank)
    (call (?. pending-live-edit cancel-later))
    (= pending-live-edit
      (do-new
        (call (. delay wait))
        (= pending-live-edit null)
        (if is-native-editing
          (call publish-live-edit)
        )
      )
    )
  )
  (fn-do _ publish-live-edit _
    (let phase (if-expr is-live-editing (. ValueChangePhase changed) (. ValueChangePhase began)))
    (= is-live-editing true)
    (<- text-edited (call TextEditEvent text phase))
  )
  (fn-do _ sync-native-text _
    (if (and native (not is-native-editing))
      (call C:brixGuiTextInputSetText native text)
    )
  )
  (fn-do + accept-native-submit _
    (param next-text String)
    (param modifiers _ (= (call PointerModifiers)))
    (call accept-native-commit next-text)
    (let data
      (call PointerEventData
        (block
          (:modifiers modifiers)
        )
      )
    )
    (<- submit (call SubmitEvent text data))
  )
  (fn-do + accept-native-focus _
    (param is-editing _ (= true))
    (if is-editing
      (= is-native-editing true)
    )
    (let host window)
    (if host
      (call (. (as host Window) accept-native-focus) this)
    )
  )
  (fn-expr + can-undo _ :get
    (and (!= native null) (call C:brixGuiTextInputCanUndo native false))
  )
  (fn-expr + can-redo _ :get
    (and (!= native null) (call C:brixGuiTextInputCanUndo native true))
  )
  (fn-expr + undo-title _ :get
    "Undo Typing"
  )
  (fn-expr + redo-title _ :get
    "Redo Typing"
  )
  (fn-do + undo _
    (if native
      (call C:brixGuiTextInputUndo native false)
    )
  )
  (fn-do + redo _
    (if native
      (call C:brixGuiTextInputUndo native true)
    )
  )
)

(fn-expr _ text-input-passed-key-bit U32
  (param key Key)
  (match key
    (case= (. Key arrow-up)
      1
    )
    (case= (. Key arrow-down)
      2
    )
    (case= (. Key enter)
      4
    )
    (case= (. Key arrow-left)
      8
    )
    (case= (. Key arrow-right)
      16
    )
    (case= (. Key page-up)
      32
    )
    (case= (. Key page-down)
      64
    )
    (case= (. Key home)
      128
    )
    (case= (. Key end)
      256
    )
    (case= (. Key space)
      512
    )
    (case= (. Key tab)
      1024
    )
    (default
      0
    )
  )
)

(type + NativeTextInputEventKind (is U32)
  (variant input (= 0))
  (variant commit (= 1))
  (variant submit (= 2))
  (variant focus (= 3))
  (variant blur (= 4))
  (variant selection (= 5))
  (variant command-submit (= 6))
  (variant paste (= 7))
  (variant copy (= 8))
)

(type + GuiTextInputEventCallback (is (c-fn-type Void (param input-pointer Pointer) (param event-kind U32) (param text-pointer (of CPointer Char8)) (param selection-start U32) (param selection-end U32) (param modifier-bits U64))))

(fn-do + gui-text-input-event _
  (param input-pointer Pointer)
  (param event-kind U32)
  (param text-pointer (of CPointer Char8))
  (param selection-start U32)
  (param selection-end U32)
  (param modifier-bits U64)
  (let next-text (as text-pointer String))
  (let input (call (of gc-object-from-pointer TextInput) input-pointer))
  (match? (as event-kind NativeTextInputEventKind)
    (case= (. NativeTextInputEventKind selection)
      (call (. input accept-native-selection) next-text selection-start selection-end)
    )
    (case= (. NativeTextInputEventKind blur)
      (call (. input accept-native-focus) false)
    )
    (case= (. NativeTextInputEventKind focus)
      (call (. input accept-native-focus))
    )
    (case= (. NativeTextInputEventKind input)
      (call (. input accept-native-input) next-text (as selection-start Size) (as selection-end Size))
    )
    (case= (. NativeTextInputEventKind commit)
      (call (. input accept-native-commit) next-text)
    )
    (case= (. NativeTextInputEventKind submit)
      (call (. input accept-native-submit) next-text (call pointer-modifiers-from-native modifier-bits))
    )
    (case= (. NativeTextInputEventKind command-submit)
      (call (. input accept-native-submit) next-text (call pointer-modifiers-from-native modifier-bits))
    )
    (case= (. NativeTextInputEventKind paste)
      (call (. input accept-native-paste))
    )
    (case= (. NativeTextInputEventKind copy)
      (call (. input accept-native-copy))
    )
  )
)
