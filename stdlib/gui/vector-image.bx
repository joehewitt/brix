(import ./box)
(import ./primitives)
(import /core/markup)
(import /graphics/canvas)
(import /graphics/graphic)
(import /graphics/matrix)
(import /graphics/primitives)
(import /graphics/vector-group)
(import /graphics/vectorgeometry)

(type + VectorImage (is Box)
  (implements VectorGroupHost)
  (implements MarkupRootElement)
  (prop + view-box _ (= (call Rect)))
  (prop + fit _ (= (. ImageFit contain)))
  (prop + content-align-x _ (= (. AnchorPoint center)))
  (prop + content-align-y _ (= (. AnchorPoint center)))
  (prop + group _ (:= (call VectorGroup this)))
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (prop _ layout-content Rect)
  (prop _ has-layout-content Bool)
  (blank)
  (depends vector-intrinsic-changed view-box)
  (depends vector-fit-changed fit content-align-x content-align-y)
  (fn-do + This _)
  (fn-do + This _
    (param view-box _)
  )
  (fn-do + markup-absorb _
    (param content VectorNode)
    (call (. group markup-absorb) content)
  )
  (fn-do _ vector-intrinsic-changed _
    (call (. group graphic-invalidate) (/or/ graphic-change-intrinsic graphic-change-geometry))
  )
  (fn-do _ vector-fit-changed _
    (call (. group graphic-invalidate) graphic-change-geometry)
  )
  (fn-do + markup-style-domains-changed _
    (param mask U32)
    (call (. super markup-style-domains-changed) mask)
    (let kinds (/and/ (call vector-style-change-kinds mask) graphic-change-appearance))
    (if kinds
      (call (. group graphic-invalidate) kinds)
    )
  )
  (fn-do + did-layout _
    (call (. super did-layout))
    (let next content-bounds)
    (let did-change (or (not has-layout-content) (!= layout-content next)))
    (= layout-content next)
    (= has-layout-content true)
    (if (and did-change (. group parent) (call effective-view-box))
      (call (. group graphic-invalidate) graphic-change-geometry)
    )
  )
  (fn-do + mounted _
    (call (. super mounted))
    (call markup-adopt group this markup-batch-root)
  )
  (fn-do + unmounted _
    (call markup-release group)
    (call (. super unmounted))
  )
  (fn-do + close _
    (call (. group close))
    (call (. super close))
  )
  (fn-expr + measured-content-size _
    (param query MeasureQuery)
    (if-expr viewport (call Dimensions (. viewport width) (. viewport height)) (call Dimensions 0 0))
    (where
      (lazy viewport (call effective-view-box))
    )
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (return-if (if (. group parent)))
    (let viewport (call effective-view-box))
    (if (not viewport)
      (call (. group paint-vector) canvas null true null content-bounds)
      (return)
    )
    (let view viewport)
    (let content content-bounds)
    (return-if (if (or (<= (. content width) 0) (<= (. content height) 0))))
    (use (. canvas saved-state))
    (let transform (call fitted-transform view content))
    (return-if (if (call (. group paint-vector-geometry) canvas view transform content $color)))
    (call (. canvas clip) content)
    (call (. canvas transform) transform)
    (call (. group paint-vector) canvas null false null view)
  )
  (fn-do + markup-attach-child _
    (param child GuiNode)
    (param anchor (? GuiNode))
    (call (. super markup-attach-child) child anchor)
    (return-if (if (not (is child VectorImage))))
    (let next (only-if (. (as anchor VectorImage) group) (if (and anchor (is anchor VectorImage)))))
    (call (. group insert-group) (. (as child VectorImage) group) next)
  )
  (fn-do + markup-detach-child _
    (param child GuiNode)
    (call (. super markup-detach-child) child)
    (return-if (if (not (is child VectorImage))))
    (call (. group remove-group) (. (as child VectorImage) group))
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
  (fn-expr + vector-host-viewport (? Rect) :get
    (call effective-view-box)
  )
  (fn-expr + vector-host-transform (? Matrix) :get
    (case? (or (not viewport) (<= (. content width) 0) (<= (. content height) 0))
      null
    )
    (default
      (call fitted-transform viewport content)
    )
    (where
      (lazy viewport (call effective-view-box))
      (lazy content content-bounds)
    )
  )
  (fn-do + vector-host-changed _
    (param kinds U8)
    (if (/and/ kinds graphic-change-intrinsic)
      (call invalidate-content-size)
      (else
        (call invalidate-paint)
      )
    )
  )
  (fn-expr _ effective-view-box (? Rect)
    (only-if view-box (if (and (> (. view-box width) 0) (> (. view-box height) 0))))
  )
  (fn-expr _ fitted-transform Matrix
    (param view Rect)
    (param content Rect)
    (call vector-view-transform
      (block
        (arg view)
        (arg (call image-fit-rect (. view size) content fit content-align-x content-align-y))
      )
    )
  )
)
