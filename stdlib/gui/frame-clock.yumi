+ FrameTick is Tuple

+ now Nanoseconds
+ delta Nanoseconds
+ elapsed Nanoseconds

━━━━━━━━━━━━━━━━━━━━
+ FrameAnimation is Interface

────────────────────
+ do advance Bool
    - tick FrameTick

────────────────────
+ do finish

