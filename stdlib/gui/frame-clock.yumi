────────────────────
+ get frame-clock FrameClock?

━━━━━━━━━━━━━━━━━━━━
+ FrameClock

+ host FrameClockHost
+ now Nanoseconds = 0ns
+ interval Nanoseconds = 16666667ns
+ time-scale = 1.0

_ animators = List'FrameAnimator()
_ display-time Nanoseconds?
_ was-running = false

────────────────────
+ This
    - host

────────────────────
+ get is-running Bool

animators.length > 0

────────────────────
+ do start
    - owner FrameOwner?
    - animation FrameAnimation
    - frame-rate F64? = null

. running = animator-of(animation)
if running
    running.frame-rate = frame-rate
    running.restart()
    host.request-clock-frame()
    =
. started = FrameAnimator(owner, animation)
started.frame-rate = frame-rate
animators += started
host.request-clock-frame()

────────────────────
+ next-due Nanoseconds

if !was-running || !previous || wanted <= 0ns then 0ns else previous + wanted - interval / 2

.. wanted = wanted-interval()
.. previous = display-time

────────────────────
+ do cancel
    - animation FrameAnimation

animator-of(animation)?.is-done = true

────────────────────
+ is-animating Bool
    - animation FrameAnimation

animator-of(animation) != null

────────────────────
+ do wait
    - span Duration

. done = Completion'Bool()
. waiting = FrameWait(span, done)
start(null, waiting)
do finally
    cancel(waiting)
done.await()

────────────────────
+ do tick
    - display Nanoseconds
    - refresh Nanoseconds

if refresh > 0ns
    interval = refresh
. previous = display-time ?? display
=? if was-running && display > previous && display - previous + interval / 2 < wanted-interval()
display-time = display
. real = if was-running && display > previous then display - previous else interval
step(real * time-scale)

────────────────────
+ do advance
    - span Duration

step(span as Nanoseconds)

────────────────────
+ do finish-all

. running = animators
animators = List'FrameAnimator()
was-running = false
for animator in running
    if !animator.is-done
        animator.is-done = true
        animator.animation.finish()

────────────────────
_ do animator-of FrameAnimator?
    - animation FrameAnimation

for animator in animators
    =? animator if !animator.is-done && animator.animation as Pointer == animation as Pointer
= null

────────────────────
_ do wanted-interval Nanoseconds

. fastest = 0.0
for animator in animators
    if !animator.is-done
        . rate = animator.frame-rate
        =? 0ns if !rate || rate <= 0
        if rate > fastest
            fastest = rate
=? 0ns if fastest <= 0
= (1 / fastest) as Seconds

────────────────────
_ do step
    - delta Nanoseconds

now += delta
. outer = swap-markup-cause(markup-cause-none)
. running = animators
. count = running.length
for index in 0 .. < count
    . animator = running[index]
    if !animator.is-done
        advance-animator(animator, delta)
swap-markup-cause(outer)
. kept Size = 0
for index in 0 .. < animators.length
    . animator = animators[index]
    if !animator.is-done
        animators[kept] = animator
        kept += 1
animators.remove(kept, animators.length - kept)
was-running = animators.length > 0

────────────────────
_ do advance-animator
    - animator FrameAnimator
    - delta Nanoseconds

if !animator.is-attached(this)
    animator.is-done = true
    animator.animation.finish()
    =
. started = animator.started ?? now - delta
. last = animator.last ?? started
animator.started = started
animator.last = now
. restarts = animator.restarts
. keeps = animator.animation.advance(FrameTick(now, now - last, now - started))
if !keeps && animator.restarts == restarts
    animator.is-done = true

━━━━━━━━━━━━━━━━━━━━
_ FrameAnimator

+ owner FrameOwner?
+ animation FrameAnimation
+ started Nanoseconds?
+ last Nanoseconds?
+ restarts Size = 0
+ is-done = false
+ frame-rate F64? = null

────────────────────
+ This
    - owner
    - animation

────────────────────
+ is-attached Bool
    - clock FrameClock

|? !owner
    true
|? !attached
    false
??
    attached as Pointer == clock as Pointer

.. attached = owner.frame-clock

────────────────────
+ do restart

started = null
last = null
restarts += 1

━━━━━━━━━━━━━━━━━━━━
_ FrameWait
    is FrameAnimation

+ span Nanoseconds
+ done Completion'Bool

────────────────────
+ This
    - span
    - done

────────────────────
+ do advance Bool
    - tick FrameTick

=? true if tick.elapsed < span
finish()
= false

────────────────────
+ do finish

=? if done.is-finished
done.finish(true)

━━━━━━━━━━━━━━━━━━━━
+ FrameTicks
    is Usable'Void
    is FrameAnimation

+ owner FrameOwner

_ is-wanted = false

as Broadcastable'FrameTick for
_ ticks := AsyncOnDemandChannel'FrameTick(this)

────────────────────
+ This
    - owner

────────────────────
+ do resume

=? if !is-wanted
. clock = owner.frame-clock
=? if !clock || clock.is-animating(this)
clock.start(owner, this)

────────────────────
+ do begin-using

is-wanted = true
resume()

────────────────────
+ do end-using

is-wanted = false
owner.frame-clock?.cancel(this)

────────────────────
+ do advance Bool
    - tick FrameTick

=? false if !is-wanted
. outer = swap-markup-cause(gui-instant-cause)
do finally
    swap-markup-cause(outer)
ticks <- tick
= is-wanted

────────────────────
+ do finish
