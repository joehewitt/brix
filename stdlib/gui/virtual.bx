(import ./box)
(import ./composite)
(import ./events)
(import ./primitives)
(import ./style-motion)
(import ./styles)
(import ./theme)
(import /core/markup)
(import /core/style)
(import /graphics/point)
(import /graphics/primitives)
(import /math)
(import /math/motion)
(import /time/duration)
(import /time/timer)
(import /ui/virtual)
(import /ui/virtual-layout)
(import /ui/virtual-recycler)
(import /units)
(blank)
(prop _ virtual-anchor-span VirtualCoord (= 65536vcoord))
(prop _ virtual-precision-limit VirtualCoord (= 9007199254740992vcoord))
(prop _ virtual-measure-pass-limit Size (= 8))
(prop _ virtual-sticky-depths Index (= 8))
(prop _ virtual-sticky-layers _ (= (call virtual-sticky-layer-names)))
(prop _ virtual-glide-screens VirtualCoord (= 4vcoord))
(type-line _ VirtualGlideLead (is (tuple (: top Length) (: shift Point))))

(style-extend GUIDefaultTheme
  (using GUIBoxPaint)
  (rule VirtualSlotRoot
    (when-style #is-sticky
      (= backdrop-blur 24)
    )
  )
)

(type + GUIVirtualRowStyle (is Style)
  (prop + row-height Length @inherited (= 24))
  (blank)
  (style-domains row-height (domain layout))
)

(type + VirtualRevealGoal (is (fn-type (? I64))))

(type + (of VirtualSlotRoot VItem) (is Box)
  (prop + slot (of VirtualSlot VItem))
  (prop + fits-content Bool)
  (prop + is-sticky Bool)
  (prop + sticky-depth Index)
  (prop + is-layout-boundary _ (=> (not fits-content)))
  (prop + admits-focus-traversal _ (=> is-in-viewport))
  (prop + stagger-host _ (=> material-parent))
  (blank)
  (prop _ vhidden Display (= (. Display hidden)))
  (prop _ vvisible Display (= (. Display visible)))
  (blank)
  (rule This
    (= display (if-expr (. slot #is-bound) vvisible vhidden))
    (= layer (only-if (call virtual-sticky-layer #sticky-depth) (if #is-sticky)))
  )
  (fn-expr + is-in-viewport Bool :get
    (case? (or (not region) (not (. slot is-bound)))
      false
    )
    (default
      (and horizontal vertical)
    )
    (where
      (lazy region material-parent)
      (lazy offset (. region content-offset))
      (lazy dx (. offset x))
      (lazy dy (. offset y))
      (lazy viewport (. region content-bounds))
      (lazy rect bounds)
      (lazy horizontal (and (> (. rect width) 0) (> (- (. rect right) dx) (. viewport left)) (< (- (. rect left) dx) (. viewport right))))
      (lazy vertical (and (> (. rect height) 0) (> (- (. rect bottom) dy) (. viewport top)) (< (- (. rect top) dy) (. viewport bottom))))
    )
  )
  (fn-do + natural-height (? Length)
    (param width Length)
    (let query (call MeasureQuery (call fit-axis-query width) (call fit-axis-query)))
    (let height (? Length))
    (for (in child active-children)
      (let outer (. (call (. child measure) query) outer-size height))
      (= height (call max (?? height outer) outer))
    )
    (return height)
  )
  (whenever-rule #is-sticky
    (call set-scroll-pinned is-sticky)
    (for (in child active-children)
      (call virtual-invalidate-paint child)
    )
  )
  (fn-do + mounted _
    (call (. super mounted))
    (call set-scroll-pinned is-sticky)
  )
  (fn-do + arrange-positioned-children _
    (let content content-bounds)
    (for (in child active-children)
      (call (. child arrange-outer-bounds) content)
    )
    (= inner-width (. content width))
    (= inner-height (. content height))
    (call (. super arrange-positioned-children))
  )
)

(type + (of VirtualRegion VItem) (is Box)
  (implements VirtualRecyclerOwner)
  (implements ClipWatcher)
  (using GUIVirtualRowStyle)
  (prop + source (? (of VirtualSource VItem)))
  (prop + virtual-layout (? VirtualLayout))
  (prop + overscan _ (= (call VirtualInsets 0vcoord 0vcoord 0vcoord 0vcoord)))
  (prop + overscan-rows VirtualCoord (= 0vcoord))
  (prop + row-extent Length (= 24))
  (prop + retention _ (= (call VirtualInsets 0vcoord 0vcoord 0vcoord 0vcoord)))
  (prop + binds-viewport-first _ (= false))
  (prop + anchors-end _ (= false))
  (prop + follows-end _ (= true))
  (prop + reserved-height Length (= 0))
  (prop + glide-motion Motion (= (call spring 320ms)))
  (prop + sticky-inset Length (= 0))
  (prop + top-inset Length (= 0))
  (prop + virtual-extent-x VirtualExtent)
  (prop + virtual-extent-y VirtualExtent)
  (prop + virtual-scroll _ (=> (call VirtualPoint (call virtual-floor scroll-x) (call virtual-floor (- scroll-y top-inset)))))
  (prop + virtual-anchor _ (=> (call VirtualPoint anchor-x anchor-y)))
  (prop + is-layout-boundary _ (=> true))
  (blank)
  (prop _ recycler _ (:= (call (of VirtualRecycler VItem))))
  (prop _ anchor-x VirtualCoord)
  (prop _ anchor-y VirtualCoord)
  (prop _ observed-root-count Size)
  (prop _ stat-roots-created Size)
  (prop _ native-rows Rect)
  (prop _ is-arranging Bool)
  (prop _ is-binding Bool)
  (prop _ rebinds-after-layout Bool)
  (prop _ defers-overscan Bool)
  (prop _ has-stable-anchor Bool)
  (prop _ stable-anchor-address I64)
  (prop _ stable-anchor-y VirtualCoord)
  (prop _ restored-scroll (? Point))
  (prop _ reveal-goal (? VirtualRevealGoal))
  (prop _ reveal-alignment _ (= (. ScrollAlignment start)))
  (prop _ natural-window _ (:= (call VirtualWindow)))
  (prop _ natural-size Dimensions)
  (prop _ awaits-arrange Bool)
  (prop _ arranged-window VirtualRect)
  (prop _ clip-host (? WindowHost))
  (prop _ arranged-sticky-offset (? Length))
  (prop _ sticky-fraction Length)
  (prop _ pinned-address (? I64))
  (prop _ placed-anchor (? VirtualPoint))
  (prop _ pinned-offset Length)
  (prop _ glides-to-end Bool)
  (prop _ followers (list Index))
  (prop _ follows-glides Bool)
  (prop _ glide-reach VirtualCoord)
  (prop _ glide-delta VirtualCoord)
  (prop _ glided-size Dimensions)
  (blank)
  (depends bindings-changed source virtual-layout overscan overscan-rows retention anchors-end)
  (depends bindings-changed sticky-inset top-inset)
  (blank)
  (rule This
    (= overflow-x (. ScrollOverflow auto))
    (= overflow-y (. ScrollOverflow auto))
  )
  (fn-do + This _
    (= (. recycler owner) this)
  )
  (content
    (<> This
      (for (in slot (. recycler #slots))
        (<> (of VirtualSlotRoot VItem)
          (= slot slot)
          (= fits-content (?? (?. #virtual-layout measures-rows) false))
          (blank)
          (+<> Box (id: row) (param: slot (of VirtualSlot VItem)))
        )
      )
      (blank)
      (if (?? (?. #virtual-layout has-sticky-rows) false)
        (for (in layer-name virtual-sticky-layers)
          (<> Layer
            (= name layer-name)
          )
        )
      )
    )
  )
  (subscribe-for (on event scroll-changed (when arrival))
    (if (not is-arranging)
      (if (. event cause is-direct)
        (= pinned-address null)
        (= reveal-goal null)
        (call yield-reserved-height)
      )
      (if (and (!= (. event cause) (. ScrollCause layout-clamp)) (not is-gliding))
        (= follows-end (and (<= reserved-height 0) (>= scroll-y (- (. scroll-max y) 1))))
      )
      (if (and (not awaits-arrange) (or has-sticky-rows (not (call window-holds))))
        (call invalidate-bindings)
      )
    )
  )
  (whenever-rule (. (?. #source revision) #changes)
    (call invalidate-bindings)
  )
  (whenever-rule (?. (?. #virtual-layout revision) #changes)
    (call invalidate-bindings)
  )
  (fn-expr + stats VirtualRecyclerStats :get
    (. recycler stats)
  )
  (fn-expr + roots-created Size :get
    stat-roots-created
  )
  (fn-expr + pool-size _ :get
    (. recycler pool-size)
  )
  (fn-expr + slot-at (? (of VirtualSlot VItem))
    (param index Index)
    (call (. recycler slot-at) index)
  )
  (fn-do + root-at (? (of VirtualSlotRoot VItem))
    (param index Index)
    (let pool %first-child)
    (return-if (if (not pool)))
    (blank)
    (let cursor (. pool %first-child))
    (let position Index)
    (while cursor
      (return-if (as cursor (of VirtualSlotRoot VItem)) (if (== position index)))
      (blank)
      (+= position 1)
      (= cursor (. cursor %next-sibling))
    )
    (return null)
  )
  (fn-do + invalidate-bindings _
    (if is-binding
      (= rebinds-after-layout true)
      (return)
    )
    (let natural (call natural-extent))
    (if (!= natural natural-size)
      (let content content-bounds)
      (let climbs (call virtual-natural-length-matters (. natural-size width) (. natural width) (. content width)))
      (if (not climbs)
        (= climbs (call virtual-natural-length-matters (. natural-size height) (. natural height) (. content height)))
      )
      (= natural-size natural)
      (call invalidate-layout)
      (if climbs
        (call (?. (. this material-parent) invalidate-content-size))
      )
    )
    (= awaits-arrange true)
    (call mark-child-only-layout-invalid)
    (call schedule-layout)
  )
  (fn-do + refresh-bindings-at _
    (param scroll-x VirtualCoord)
    (param scroll-y VirtualCoord)
    (param viewport-width VirtualCoord)
    (param viewport-height VirtualCoord)
    (return-if (if (or (not source) (not virtual-layout))))
    (blank)
    (= (. recycler source) source)
    (= (. recycler layout) virtual-layout)
    (let window (. recycler window))
    (= (. window scroll-x) scroll-x)
    (= (. window scroll-y) scroll-y)
    (= (. window viewport-width) viewport-width)
    (= (. window viewport-height) viewport-height)
    (call frame-window window)
    (if defers-overscan
      (call (. window set-overscan) (call VirtualInsets 0vcoord 0vcoord 0vcoord 0vcoord))
      (else
        (call (. window set-overscan) overscan)
        (let margin (* (. window row-height) overscan-rows))
        (+= (. window overscan-top) margin)
        (+= (. window overscan-bottom) margin)
      )
    )
    (= (. recycler retention) (call glide-retention window))
    (let grown-from (. recycler pool-size))
    (call (. recycler refresh))
    (if (. recycler is-revision-change)
      (for (in index (..< grown-from (. recycler pool-size)))
        (+= followers index)
      )
    )
  )
  (fn-do + publish-bindings _
    (return-if (if (not (. recycler has-pending-changes))))
    (blank)
    (= (. recycler has-pending-changes) false)
    (let host window-host)
    (let hushes (not (. recycler is-revision-change)))
    (if hushes
      (call (?. host hush-entering) true)
    )
    (call checkpoint-window)
    (if hushes
      (call (?. host hush-entering) false)
    )
    (call count-created-roots)
  )
  (fn-do + release-bindings _
    (call (. recycler release))
    (= source null)
    (= virtual-extent-x (call VirtualExtent 0vcoord null false))
    (= virtual-extent-y (call VirtualExtent 0vcoord null false))
    (= anchor-x 0vcoord)
    (= anchor-y 0vcoord)
    (= observed-root-count 0)
    (call stop-gliding)
    (= glides-to-end false)
    (= pinned-address null)
    (= reveal-goal null)
    (= reserved-height 0)
    (call (. followers clear))
    (= glide-reach 0vcoord)
    (= glide-delta 0vcoord)
    (call checkpoint-window)
    (call invalidate-bindings)
  )
  (fn-do + follow-end _
    (call stop-gliding)
    (= glides-to-end false)
    (= pinned-address null)
    (= reveal-goal null)
    (= follows-end true)
    (call invalidate-bindings)
  )
  (fn-do + glide-to-end _
    (= pinned-address null)
    (= reveal-goal null)
    (= follows-end true)
    (= glides-to-end true)
    (call invalidate-bindings)
  )
  (fn-expr + address-offset (? Length)
    (param address I64)
    (only-if (- top scroll-y) (if (!= top null)))
    (where
      (lazy top (call address-top address))
    )
  )
  (fn-do + pin-address _
    (param address I64)
    (param offset Length)
    (call stop-gliding)
    (= pinned-address address)
    (= pinned-offset offset)
    (= reveal-goal null)
    (= follows-end false)
    (call invalidate-bindings)
  )
  (fn-do + glide-to-address Bool
    (param address I64)
    (param inset Length (= 0))
    (param room (? Length) (= null))
    (return-if false (if (. content-bounds is-empty)))
    (blank)
    (let first (call glide-target address inset room))
    (return-if false (if (== first null)))
    (blank)
    (= pinned-address null)
    (= reveal-goal null)
    (= follows-end false)
    (call reserve-through first)
    (call scroll-to
      (block
        (arg (=> () (call address-glide-point address inset room)))
        (arg glide-motion)
      )
    )
    (return true)
  )
  (fn-do + restore-scroll _
    (param point Point)
    (= pinned-address null)
    (= reveal-goal null)
    (= restored-scroll point)
    (call invalidate-bindings)
  )
  (fn-do + reveal-address _
    (param address I64)
    (param alignment _ (= (. ScrollAlignment start)))
    (call reveal-address (=> () address) alignment)
  )
  (fn-do + reveal-address _
    (param goal VirtualRevealGoal)
    (param alignment _ (= (. ScrollAlignment start)))
    (= pinned-address null)
    (= restored-scroll null)
    (= reveal-goal goal)
    (= reveal-alignment alignment)
    (call invalidate-bindings)
  )
  (fn-do + scroll-to-address Bool
    (param address I64)
    (param alignment _ (= (. ScrollAlignment start)))
    (param cause _ (= (. ScrollCause programmatic)))
    (return-if false (if (or (not source) (not virtual-layout))))
    (blank)
    (= pinned-address null)
    (= reveal-goal null)
    (let content content-bounds)
    (let rect (call address-reveal-rect address))
    (return-if false (if (not rect)))
    (blank)
    (let reach-x (call virtual-length (+ (. rect x) (. rect width))))
    (let reach-y (call virtual-length (+ (. rect y) (. rect height))))
    (if (> reach-x inner-width)
      (= inner-width reach-x)
    )
    (if (> reach-y inner-height)
      (= inner-height reach-y)
    )
    (let maximum scroll-max)
    (let next-x (call virtual-reveal scroll-x (. maximum x) (. content width) (. rect x) (. rect width) alignment))
    (let next-y (call virtual-reveal scroll-y (. maximum y) (. content height) (. rect y) (. rect height) alignment))
    (let scrolled (call scroll-to (call Point next-x next-y) cause))
    (let shown
      (call Rect
        (block
          (arg (- (+ (. content x) (call virtual-length (. rect x))) scroll-x))
          (arg (- (+ (. content y) (call virtual-length (. rect y))) scroll-y))
          (arg (call virtual-length (. rect width)))
          (arg (call virtual-length (. rect height)))
        )
      )
    )
    (let revealed (call reveal-in-ancestors shown alignment (call Insets 0 0 0 0) cause))
    (return (or scrolled revealed))
  )
  (fn-expr + has-sticky-rows _ :get
    (?? (?. virtual-layout has-sticky-rows) false)
  )
  (fn-do _ glide-target (? Length)
    (param address I64)
    (param inset Length)
    (param room (? Length))
    (let placed (call address-rect address))
    (return-if (if (== placed null)))
    (blank)
    (let top (call virtual-length (. placed y)))
    (return-if (call max 0 (- top inset)) (if (== room null)))
    (blank)
    (let bottom (+ (call virtual-length (+ (. placed y) (. placed height))) top-inset))
    (return (call max 0 (call min (- top inset) (- (+ bottom room) (. content-bounds height)))))
  )
  (fn-do _ address-glide-point (? Point)
    (param address I64)
    (param inset Length)
    (param room (? Length))
    (let target (call glide-target address inset room))
    (return-if (if (== target null)))
    (blank)
    (call reserve-through target)
    (return (call Point scroll-x target))
  )
  (fn-expr _ address-top (? Length)
    (param address I64)
    (only-if (+ (call virtual-length (. placed y)) top-inset) (if placed))
    (where
      (lazy placed (call address-rect address))
    )
  )
  (fn-do _ address-rect (? VirtualRect)
    (param address I64)
    (return-if (if (or (not source) (not virtual-layout))))
    (blank)
    (= (. recycler source) source)
    (= (. recycler layout) virtual-layout)
    (call frame-window (. recycler window))
    (return (call (. recycler rect-for-address) address))
  )
  (fn-do _ address-reveal-rect (? VirtualRect)
    (param address I64)
    (let natural (call address-rect address))
    (return-if (if (not natural)))
    (blank)
    (let header-margin (call (. (!! virtual-layout) sticky-margin) address (. (!! source) domain) (. recycler window)))
    (let margin (+ header-margin (call virtual-ceil sticky-inset)))
    (let covered (call virtual-ceil top-inset))
    (return (call VirtualRect (. natural x) (- (. natural y) margin) (. natural width) (+ (. natural height) margin covered)))
  )
  (fn-do _ reserve-through _
    (param target Length)
    (= reserved-height (+ target (. content-bounds height)))
    (call settle-reserved-height)
  )
  (fn-do _ yield-reserved-height _
    (return-if (if (<= reserved-height 0)))
    (blank)
    (let reach (+ scroll-y (. content-bounds height)))
    (if (< reach reserved-height)
      (= reserved-height reach)
      (call settle-reserved-height)
    )
  )
  (fn-do _ settle-reserved-height _
    (let natural (call virtual-inner-length (. virtual-extent-y known) (. content-bounds height) top-inset))
    (if (<= reserved-height natural)
      (= reserved-height 0)
    )
    (= inner-height (call max natural reserved-height))
  )
  (fn-do _ frame-window _
    (param window VirtualWindow)
    (let content content-bounds)
    (= (. window frame-width) (call virtual-ceil (. content width)))
    (= (. window frame-height) (call virtual-ceil (. content height)))
    (let extent (call max 1 (call round $row-height)))
    (= (. window row-height) (as extent I64))
    (if (!= extent row-extent)
      (= row-extent extent)
    )
  )
  (fn-do _ bindings-changed _
    (call invalidate-bindings)
  )
  (fn-do _ natural-extent Dimensions
    (let live-source source)
    (let live-layout virtual-layout)
    (return-if (call Dimensions 0 0) (if (or (not live-source) (not live-layout))))
    (return-if (call Dimensions 0 0) (if (or (. live-layout measures-rows) (not (. live-source domain is-final)))))
    (blank)
    (= (. natural-window row-height) (as (call max 1 (call round $row-height)) I64))
    (call (. live-layout fill-window) natural-window (. live-source domain))
    (return
      (call Dimensions
        (block
          (arg (call virtual-length (. natural-window known-width)))
          (arg (+ (call virtual-length (. natural-window known-height)) top-inset))
        )
      )
    )
  )
  (fn-do _ checkpoint-window _
    (let root markup-batch-root)
    (if root
      (catch (call (. root markup-batch-queue checkpoint)))
    )
  )
  (fn-do _ count-created-roots _
    (while (and (< observed-root-count (. recycler pool-size)) (call root-at observed-root-count))
      (+= observed-root-count 1)
      (+= stat-roots-created 1)
    )
  )
  (fn-do _ arrange-virtual-content _
    (= awaits-arrange false)
    (= is-binding true)
    (finally
      (inline (= is-binding false))
    )
    (call watch-clip-host)
    (let content content-bounds)
    (let view (call visible-view content))
    (let live-layout virtual-layout)
    (let restored restored-scroll)
    (let target-x (?? (?. restored x) scroll-x))
    (let target-y (?? (?. restored y) scroll-y))
    (= restored-scroll null)
    (let revealing reveal-goal)
    (= reveal-goal null)
    (let revealed (? I64) null)
    (let sticky-offset (only-if (call sticky-line-offset) (if has-sticky-rows)))
    (= arranged-sticky-offset sticky-offset)
    (let pinned (only-if pinned-address (if (== restored null))))
    (if (!= pinned null)
      (let top (call address-top pinned))
      (if (== top null)
        (= pinned-address null)
        (= pinned null)
        (else
          (= target-y (call max 0 (- top pinned-offset)))
        )
      )
      (else-if revealing
        (let address (call revealing))
        (let rect (only-if (call address-reveal-rect address) (if (!= address null))))
        (if rect
          (= revealed address)
          (= target-y
            (call virtual-reveal
              (block
                (arg target-y)
                (arg (call virtual-length virtual-precision-limit))
                (arg (. content height))
                (arg (. rect y))
                (arg (. rect height))
                (arg reveal-alignment)
              )
            )
          )
        )
      )
    )
    (let held (?? pinned revealed))
    (let ends
      (scope (and follows-to-end (<= reserved-height 0) (== pinned null))
        (lazy follows-to-end (and anchors-end follows-end (== restored null) (== revealed null)))
      )
    )
    (let glides (and ends glides-to-end))
    (= glides-to-end false)
    (if (and source live-layout)
      (call settle-glide content)
      (let pins-end (and ends (not glides) (not is-gliding)))
      (let start-x (call virtual-floor (+ target-x (. view x))))
      (let width (- (call virtual-ceil (+ target-x (. view right))) start-x))
      (let start-y (call virtual-floor target-y))
      (let pass Size)
      (let is-settled false)
      (= defers-overscan
        (scope (and binds-viewport-first has-overscan (not (call shows-placed-rows top-y bottom-y)))
          (lazy top-y (call virtual-floor (+ (- target-y top-inset) (. view y))))
          (lazy bottom-y (call virtual-ceil (+ (- target-y top-inset) (. view bottom))))
        )
      )
      (while (not is-settled)
        (let height (call virtual-ceil (. content height)))
        (if pins-end
          (= start-y virtual-precision-limit)
          (else
            (= start-y (call virtual-floor (+ (- target-y top-inset) (. view y))))
            (= height (- (call virtual-ceil (+ (- target-y top-inset) (. view bottom))) start-y))
          )
        )
        (let shown-y (call gui-device-aligned target-y device-scale))
        (let sticky-line (only-if (call virtual-floor (+ shown-y sticky-offset)) (if (!= sticky-offset null))))
        (= (. recycler window sticky-line) sticky-line)
        (= sticky-fraction
          (scope (if-expr (!= sticky-line null) sticky-shift 0)
            (lazy sticky-shift (- (+ shown-y (!! sticky-offset)) (call virtual-length sticky-line)))
          )
        )
        (probe-group + gui.virtual.bind)
        (call refresh-bindings-at start-x start-y width height)
        (call publish-bindings)
        (probe-group - gui.virtual.bind)
        (if pins-end
          (= start-y (. recycler window resolved-scroll-y))
          (= target-y (+ (call virtual-length start-y) top-inset))
        )
        (= is-settled true)
        (if (and (. live-layout measures-rows) (== pass virtual-measure-pass-limit))
          (= rebinds-after-layout true)
          (else-if (. live-layout measures-rows)
            (let leading (call leading-placement start-y))
            (let held-address (?? (?. leading address) 0))
            (let held-y (?? (?. leading y) 0vcoord))
            (let pin-rect (only-if (call (. recycler rect-for-address) held) (if (!= held null))))
            (probe-group + gui.virtual.measure)
            (let remeasures (call measure-virtual-roots live-layout start-y (+ start-y height)))
            (probe-group - gui.virtual.measure)
            (if remeasures
              (+= pass 1)
              (= is-settled false)
              (if pin-rect
                (= held-address (!! held))
                (= held-y (. pin-rect y))
                (else-if has-stable-anchor
                  (= held-address stable-anchor-address)
                  (= held-y stable-anchor-y)
                )
              )
              (let moved (only-if (call (. recycler rect-for-address) held-address) (if (or leading pin-rect))))
              (if moved
                (+= anchor-y (- (. moved y) held-y))
                (if (not pins-end)
                  (+= target-y (call virtual-length (- (. moved y) held-y)))
                )
              )
            )
          )
        )
      )
      (if defers-overscan
        (= defers-overscan false)
        (= rebinds-after-layout true)
      )
      (let window (. recycler window))
      (let extent-x (. window extent-x))
      (if (!= extent-x virtual-extent-x)
        (= virtual-extent-x extent-x)
      )
      (let extent-y (. window extent-y))
      (if (!= extent-y virtual-extent-y)
        (= virtual-extent-y extent-y)
      )
      (if (> (call virtual-distance start-x anchor-x) virtual-anchor-span)
        (= anchor-x start-x)
      )
      (if (> (call virtual-distance start-y anchor-y) virtual-anchor-span)
        (= anchor-y start-y)
      )
      (if pins-end
        (= target-y (call gui-safe-span (- (+ (call virtual-length (. extent-y known)) top-inset) (. content height))))
      )
    )
    (call arrange-virtual-roots content)
    (= inner-width (call virtual-inner-length (. virtual-extent-x known) (. content width) 0))
    (if (!= pinned null)
      (= reserved-height (+ target-y (. content height)))
    )
    (call settle-reserved-height)
    (if (or (!= target-x scroll-x) (!= target-y scroll-y))
      (= is-arranging true)
      (call scroll-to (call Point target-x target-y) (. ScrollCause layout-clamp))
      (= is-arranging false)
      (if (or (!= restored null) (!= revealed null))
        (= follows-end (>= scroll-y (- (. scroll-max y) 1)))
        (if (not (call window-holds))
          (= rebinds-after-layout true)
        )
      )
    )
    (= arranged-window (call view-window view))
    (if (!= revealed null)
      (call reveal-arranged revealed content)
    )
    (if glides
      (call scroll-to
        (block
          (arg (=> () (call Point scroll-x (. scroll-max y))))
          (arg glide-motion)
        )
      )
    )
  )
  (fn-do _ reveal-arranged _
    (param address I64)
    (param content Rect)
    (let rect (call address-reveal-rect address))
    (return-if (if (not rect)))
    (blank)
    (let shown
      (call Rect
        (block
          (arg (- (+ (. content x) (call virtual-length (. rect x))) scroll-x))
          (arg (- (+ (. content y) (call virtual-length (. rect y))) scroll-y))
          (arg (call virtual-length (. rect width)))
          (arg (call virtual-length (. rect height)))
        )
      )
    )
    (= is-arranging true)
    (let ignored
      (call reveal-in-ancestors
        (block
          (arg shown)
          (arg reveal-alignment)
          (arg (call Insets 0 0 0 0))
          (arg (. ScrollCause programmatic))
        )
      )
    )
    (= is-arranging false)
  )
  (fn-expr _ has-overscan Bool :get
    (or y-overscan (> (. overscan left) 0vcoord) (> (. overscan right) 0vcoord))
    (where
      (lazy y-overscan (or (> overscan-rows 0vcoord) (> (. overscan top) 0vcoord) (> (. overscan bottom) 0vcoord)))
    )
  )
  (fn-do _ shows-placed-rows Bool
    (param start VirtualCoord)
    (param end VirtualCoord)
    (let window (. recycler window))
    (let index Index)
    (while (< index (. window placement-count))
      (let placement ([] (. window placements) index))
      (return-if true (if (and (not (. placement is-sticky)) (< (. placement y) end) (> (+ (. placement y) (. placement height)) start))))
      (blank)
      (+= index 1)
    )
    (return false)
  )
  (fn-do _ leading-placement (? VirtualPlacement)
    (param start VirtualCoord)
    (let window (. recycler window))
    (let index Index)
    (while (< index (. window placement-count))
      (let placement ([] (. window placements) index))
      (return-if placement (if (and (not (. placement is-sticky)) (> (+ (. placement y) (. placement height)) start))))
      (blank)
      (+= index 1)
    )
    (return null)
  )
  (fn-do _ measure-virtual-roots Bool
    (param live-layout VirtualLayout)
    (param view-start VirtualCoord)
    (param view-end VirtualCoord)
    (= has-stable-anchor false)
    (let pool %first-child)
    (return-if false (if (not pool)))
    (blank)
    (let changed false)
    (let slot-index Index)
    (let cursor (. pool %first-child))
    (while cursor
      (let root (as cursor (of VirtualSlotRoot VItem)))
      (let placement (call (. recycler placement-for-slot) slot-index))
      (let natural (only-if (call (. root natural-height) (call virtual-length (. placement width))) (if placement)))
      (if (and placement (!= natural null))
        (let height (call virtual-ceil natural))
        (let is-visible (and (< (. placement y) view-end) (> (+ (. placement y) (. placement height)) view-start)))
        (let is-nearest (or (not has-stable-anchor) (< (. placement y) stable-anchor-y)))
        (if (and (== height (. placement height)) is-visible is-nearest (not (. placement is-sticky)))
          (= has-stable-anchor true)
          (= stable-anchor-address (. placement address))
          (= stable-anchor-y (. placement y))
        )
        (if (call (. live-layout record-row-height) placement height)
          (= changed true)
        )
      )
      (= cursor (. cursor %next-sibling))
      (+= slot-index 1)
    )
    (return changed)
  )
  (fn-do _ arrange-virtual-roots _
    (param content Rect)
    (= native-rows (call Rect 0 0 0 0))
    (let pool %first-child)
    (if (not pool)
      (call (. followers clear))
      (return)
    )
    (let anchor virtual-anchor)
    (let re-anchored (!= placed-anchor anchor))
    (= placed-anchor anchor)
    (let follows (and follows-glides (> (. followers length) 0) (not re-anchored)))
    (= follows-glides false)
    (let leads (if-expr follows (call glide-leads content) (call (of List VirtualGlideLead))))
    (let has-rows false)
    (let slot-index Index)
    (let cursor (. pool %first-child))
    (while cursor
      (let root (as cursor (of VirtualSlotRoot VItem)))
      (let placement (call (. recycler placement-for-slot) slot-index))
      (if placement
        (let natural (call placement-rect placement content))
        (let shift (if-expr (and (. placement is-sticky) (. placement is-pinned)) sticky-fraction 0))
        (let rect (call Rect (. natural x) (+ (. natural y) shift) (. natural width) (. natural height)))
        (if (or re-anchored (. placement is-sticky) (. root is-sticky))
          (call (. root forget-arrangement))
        )
        (if (!= (. root is-sticky) (. placement is-sticky))
          (= (. root is-sticky) (. placement is-sticky))
        )
        (if (!= (. root sticky-depth) (. placement sticky-depth))
          (= (. root sticky-depth) (. placement sticky-depth))
        )
        (call (. root arrange-outer-bounds) rect)
        (let local (call Rect (- (. rect x) (. content x)) (- (. rect y) (. content y)) (. rect width) (. rect height)))
        (= native-rows (if-expr has-rows (+ native-rows local) local))
        (= has-rows true)
        (else
          (if (. root is-sticky)
            (= (. root is-sticky) false)
          )
          (call (. root arrange-outer-bounds) (call Rect (. content x) (. content y) 0 0))
        )
      )
      (= cursor (. cursor %next-sibling))
      (+= slot-index 1)
    )
    (if follows
      (call glide-followers leads content)
    )
    (call (. followers clear))
  )
  (fn-do _ glide-leads (list VirtualGlideLead)
    (param content Rect)
    (let leads (list VirtualGlideLead))
    (let slot-index Index)
    (let cursor (?. %first-child %first-child))
    (while cursor
      (let root (as cursor (of VirtualSlotRoot VItem)))
      (let placement (call (. recycler placement-for-slot) slot-index))
      (if (and placement (not (. placement is-sticky)) (not (. root is-sticky)) (not (has followers slot-index)))
        (let rect (call placement-rect placement content))
        (let shift (call (. root arranged-shift) rect))
        (if shift
          (+= leads (tuple (. rect y) shift))
        )
      )
      (= cursor (. cursor %next-sibling))
      (+= slot-index 1)
    )
    (return leads)
  )
  (fn-do _ glide-followers _
    (param leads (list VirtualGlideLead))
    (param content Rect)
    (let rise (if-expr (< glide-delta 0vcoord) (call virtual-length glide-delta) 0))
    (let slot-index Index)
    (let cursor (?. %first-child %first-child))
    (while cursor
      (let root (as cursor (of VirtualSlotRoot VItem)))
      (let placement (call (. recycler placement-for-slot) slot-index))
      (if (and placement (not (. placement is-sticky)) (has followers slot-index))
        (let shift (call virtual-glide-shift leads (. (call placement-rect placement content) y) rise))
        (if shift
          (call (. root glide-from) (call Point (- (. shift x)) (- (. shift y))))
        )
      )
      (= cursor (. cursor %next-sibling))
      (+= slot-index 1)
    )
  )
  (fn-do _ settle-glide _
    (param content Rect)
    (let last glided-size)
    (= glided-size (. bounds size))
    (if (. recycler has-pending-revision)
      (= glide-delta 0vcoord)
      (= glide-reach 0vcoord)
      (let motion (call row-glide-motion))
      (= follows-glides (!= motion null))
      (return-if (if (not motion)))
      (blank)
      (if (and (== (. last width) (. bounds width)) (> (. last height) 0))
        (call glide-size-from last motion)
      )
      (let limit (* (call virtual-ceil (. content height)) virtual-glide-screens))
      (let natural (- (. (call natural-extent) height) top-inset))
      (if (<= natural 0)
        (= glide-reach limit)
        (else
          (= glide-delta (- (call virtual-ceil natural) (. virtual-extent-y known)))
          (= glide-reach (call min (call virtual-distance glide-delta 0vcoord) limit))
        )
      )
      (else-if (and (> glide-reach 0vcoord) (not (call rows-moving)))
        (= glide-reach 0vcoord)
      )
    )
  )
  (fn-do _ row-glide-motion (? Motion)
    (let cursor (?. %first-child %first-child))
    (while cursor
      (let root (as cursor (of VirtualSlotRoot VItem)))
      (return-if (call (. root position-motion)) (if (and (. root slot is-bound) (not (. root is-sticky)))))
      (blank)
      (= cursor (. cursor %next-sibling))
    )
    (return null)
  )
  (fn-do _ rows-moving Bool
    (let cursor (?. %first-child %first-child))
    (while cursor
      (let root (as cursor (of VirtualSlotRoot VItem)))
      (return-if true (if (. root is-layout-moving)))
      (blank)
      (= cursor (. cursor %next-sibling))
    )
    (return false)
  )
  (fn-expr _ glide-retention VirtualInsets
    (param window VirtualWindow)
    (case? (<= glide-reach 0vcoord)
      retention
    )
    (default
      (call VirtualInsets
        (block
          (arg (call max (. retention top) (+ (. window overscan-top) glide-reach)))
          (arg (. retention right))
          (arg (call max (. retention bottom) (+ (. window overscan-bottom) glide-reach)))
          (arg (. retention left))
        )
      )
    )
  )
  (fn-expr _ placement-rect _
    (param placement VirtualPlacement)
    (param content Rect)
    (call Rect x y width height)
    (where
      (lazy x (+ (. content x) (call virtual-length (- (. placement x) anchor-x))))
      (lazy y (+ (. content y) top-inset (call virtual-length (- (. placement y) anchor-y))))
      (lazy width (call virtual-length (. placement width)))
      (lazy height (call virtual-length (. placement height)))
    )
  )
  (fn-expr _ window-holds Bool
    (or (not source) (not virtual-layout) (call holds-window (call view-window (call visible-view content-bounds))))
  )
  (fn-expr _ holds-window Bool
    (param view VirtualRect)
    (case? (> (call virtual-distance (. view x) anchor-x) virtual-anchor-span)
      false
    )
    (case? (> (call virtual-distance (. view y) anchor-y) virtual-anchor-span)
      false
    )
    (default
      (call (. recycler holds) (. view x) (. view y) (. view width) (. view height))
    )
  )
  (fn-expr _ view-window VirtualRect
    (param view Rect)
    (call VirtualRect start-x start-y width height)
    (where
      (lazy start-x (call virtual-floor (+ scroll-x (. view x))))
      (lazy start-y (call virtual-floor (+ top (. view y))))
      (lazy width (- (call virtual-ceil (+ scroll-x (. view right))) start-x))
      (lazy height (- (call virtual-ceil (+ top (. view bottom))) start-y))
      (lazy top (- scroll-y top-inset))
    )
  )
  (fn-do _ watch-clip-host _
    (return-if (if clip-host))
    (blank)
    (let host window-host)
    (return-if (if (not host)))
    (blank)
    (= clip-host host)
    (call (. host watch-clip) this)
  )
  (fn-do _ visible-view Rect
    (param content Rect)
    (let visible content)
    (let shift-x Length 0)
    (let shift-y Length 0)
    (let cursor (. this material-parent))
    (while cursor
      (let ancestor cursor)
      (= cursor (. ancestor material-parent))
      (if (not (. ancestor is-markup-shadow))
        (let offset (. ancestor content-offset))
        (= visible (call Rect (- (. visible x) (. offset x)) (- (. visible y) (. offset y)) (. visible width) (. visible height)))
        (+= shift-x (. offset x))
        (+= shift-y (. offset y))
        (if (. ancestor clips-content)
          (= visible (call virtual-clipped-rect visible (. ancestor content-bounds)))
        )
      )
      (if (or (. ancestor is-presentation-layer) (not cursor))
        (= visible (call virtual-clipped-rect visible (. ancestor bounds)))
        (= cursor null)
      )
    )
    (return
      (call Rect
        (block
          (arg (- (+ (. visible x) shift-x) (. content x)))
          (arg (- (+ (. visible y) shift-y) (. content y)))
          (arg (. visible width))
          (arg (. visible height))
        )
      )
    )
  )
  (fn-do _ sticky-line-offset Length
    (return-if sticky-inset (if (> (call scroll-axis-maximum (. Orientation vertical)) 0)))
    (blank)
    (let content content-bounds)
    (let shift Length 0)
    (let cursor (. this material-parent))
    (while cursor
      (let ancestor cursor)
      (if (not (. ancestor is-markup-shadow))
        (+= shift (. ancestor content-offset y))
        (if (call (. ancestor is-scroll-axis-enabled) (. Orientation vertical))
          (return (+ (- (+ (. ancestor content-bounds y) sticky-inset) (. content y) top-inset) shift))
        )
      )
      (return-if sticky-inset (if (. ancestor is-presentation-layer)))
      (blank)
      (= cursor (. ancestor material-parent))
    )
    (return sticky-inset)
  )
  (fn-do + virtual-slot-departing _
    (param slot-index Index)
    (for (in index (..< 0 (. followers length)))
      (if (== ([] followers index) slot-index)
        (call (. followers remove) index)
        (break)
      )
    )
    (let root (call root-at slot-index))
    (return-if (if (not root)))
    (blank)
    (+= (. root input-generation) 1)
    (call (?. (. root window-host) release-input-inside) root)
  )
  (fn-do + virtual-slot-arriving _
    (param slot-index Index)
    (if (. recycler is-revision-change)
      (+= followers slot-index)
    )
    (let root (call root-at slot-index))
    (if root
      (call (. gui-style-motion restart-within) root)
      (call (. root forget-arrangement))
      (if (. recycler is-revision-change)
        (call (. root enter-subtree))
      )
    )
  )
  (fn-do + clip-changed _
    (param scrolled (? Box))
    (return-if (if (or is-arranging awaits-arrange (not source) (not virtual-layout))))
    (return-if (if (and scrolled (== (as scrolled Pointer) (as this Pointer)))))
    (blank)
    (let view (call view-window (call visible-view content-bounds)))
    (if (and has-sticky-rows (!= (call sticky-line-offset) arranged-sticky-offset))
      (call invalidate-bindings)
      (return)
    )
    (return-if (if (== view arranged-window)))
    (blank)
    (if (not (call holds-window view))
      (call invalidate-bindings)
    )
  )
  (fn-expr + markup-query-boundary _ :get
    true
  )
  (fn-do + mounted _
    (call (. super mounted))
    (call watch-clip-host)
  )
  (fn-do + unmounted _
    (call (?. clip-host unwatch-clip) this)
    (= clip-host null)
    (call (. super unmounted))
  )
  (fn-expr + native-content-rect _ :get
    native-rows
  )
  (fn-expr + content-offset _ :get
    (call Point (- (. shown x) (call virtual-length anchor-x)) (- (. shown y) (call virtual-length anchor-y)))
    (where
      (lazy shown (call device-aligned scroll-position))
    )
  )
  (fn-do + scroll-bounds-visible _
    (param rect Rect)
    (param alignment ScrollAlignment (= (. ScrollAlignment nearest)))
    (param margin Insets (= (call Insets 0 0 0 0)))
    (param cause ScrollCause (= (. ScrollCause ensure-visible)))
    (let clear (call Insets (+ (. margin top) top-inset) (. margin right) (. margin bottom) (. margin left)))
    (return (call (. super scroll-bounds-visible) rect alignment clear cause))
  )
  (fn-expr + scroll-indicator-track-bounds _
    (param axis Orientation)
    (if-expr (== axis (. Orientation horizontal)) track (call Rect (. track x) (+ (. track y) covered) (. track width) (- (. track height) covered)))
    (where
      (lazy track (call (. super scroll-indicator-track-bounds) axis))
      (lazy covered (call min top-inset (. track height)))
    )
  )
  (fn-do + measured-content-size _
    (param query MeasureQuery)
    (= natural-size (call natural-extent))
    (return natural-size)
  )
  (fn-do + arrange-positioned-children _
    (call (. super arrange-positioned-children))
    (call arrange-virtual-content)
  )
  (fn-do + did-layout _
    (call (. super did-layout))
    (if rebinds-after-layout
      (= rebinds-after-layout false)
      (call invalidate-bindings)
    )
  )
)

(fn-expr _ virtual-sticky-layer _
  (param depth Index)
  (str "virtual-sticky-" (call min depth (- virtual-sticky-depths 1)))
)

(fn-expr _ virtual-sticky-layer-names _
  (spread (..< 0 virtual-sticky-depths))
  (pipe *> (call virtual-sticky-layer (- virtual-sticky-depths 1 each)))
  (pipe |> List)
)

(fn-do + (of virtual-row-is-sticky Item) _
  (param box Box)
  (let cursor (? Box) box)
  (while cursor
    (let current cursor)
    (if (is current (of VirtualSlotRoot Item))
      (return (. (as current (of VirtualSlotRoot Item)) is-sticky))
    )
    (= cursor (. current material-parent))
  )
  (return false)
)

(fn-do + (of virtual-reveal-stuck-row Item) _
  (param box Box)
  (let cursor (? Box) box)
  (while cursor
    (let current cursor)
    (if (is current (of VirtualSlotRoot Item))
      (let root (as current (of VirtualSlotRoot Item)))
      (let region (. root layout-parent))
      (return-if false (if (or (not (. root is-sticky)) (not region) (not (is region (of VirtualRegion Item))))))
      (return (call (. (as region (of VirtualRegion Item)) scroll-to-address) (. root slot address) (. ScrollAlignment start)))
    )
    (= cursor (. current material-parent))
  )
  (return false)
)

(fn-do _ virtual-glide-shift (? Point)
  (param leads (list VirtualGlideLead))
  (param top Length)
  (param rise Length)
  (let above (? VirtualGlideLead))
  (let below (? VirtualGlideLead))
  (for (in lead leads)
    (if (<= (. lead top) top)
      (if (or (not above) (> (. lead top) (. above top)))
        (= above lead)
      )
      (else-if (or (not below) (< (. lead top) (. below top)))
        (= below lead)
      )
    )
  )
  (let shift (?. (?? above below) shift))
  (case? (or below (and shift (or (!= (. shift x) 0) (!= (. shift y) 0))))
    (return shift)
  )
  (case? (!= rise 0)
    (return (call Point 0 rise))
  )
  (default
    (return shift)
  )
)

(fn-do _ virtual-invalidate-paint _
  (param box Box)
  (call (. box invalidate-paint))
  (for (in child (. box active-children))
    (call virtual-invalidate-paint child)
  )
)

(fn-expr _ virtual-floor VirtualCoord
  (param value Length)
  (as (call floor value) I64)
)

(fn-expr _ virtual-ceil VirtualCoord
  (param value Length)
  (as (call ceil value) I64)
)

(fn-expr _ virtual-length Length
  (param value VirtualCoord)
  (as value Length)
)

(fn-expr _ virtual-distance VirtualCoord
  (param left VirtualCoord)
  (param right VirtualCoord)
  (if-expr (> left right) (- left right) (- right left))
)

(fn-expr _ virtual-clipped-rect _
  (param rect Rect)
  (param clip Rect)
  (call Rect left top (call max 0 (- right left)) (call max 0 (- bottom top)))
  (where
    (lazy left (call max (. rect left) (. clip left)))
    (lazy top (call max (. rect top) (. clip top)))
    (lazy right (call min (. rect right) (. clip right)))
    (lazy bottom (call min (. rect bottom) (. clip bottom)))
  )
)

(fn-expr _ virtual-natural-length-matters _
  (param before Length)
  (param after Length)
  (param arranged Length)
  (and (!= before after) (or (== fit-before 0) (!= fit-before fit-after)))
  (where
    (lazy fit-before (call virtual-natural-fit before arranged))
    (lazy fit-after (call virtual-natural-fit after arranged))
  )
)

(fn-expr _ virtual-natural-fit Int
  (param natural Length)
  (param arranged Length)
  (case? (> natural (+ arranged 0.5))
    1
  )
  (case? (< natural (- arranged 0.5))
    -1
  )
  (default
    0
  )
)

(fn-expr _ virtual-inner-length _
  (param extent VirtualCoord)
  (param viewport Length)
  (param inset Length)
  (before
    (throw (call Panic "Virtual extent exceeds GUI coordinate precision") (if (> extent virtual-precision-limit)))
  )
  (if-expr (<= reach (call ceil viewport)) viewport reach)
  (where
    (lazy reach (+ (call virtual-length extent) inset))
  )
)

(fn-expr _ virtual-reveal _
  (param position Length)
  (param maximum Length)
  (param viewport Length)
  (param start VirtualCoord)
  (param length VirtualCoord)
  (param alignment ScrollAlignment)
  (call gui-scroll-reveal-axis
    (block
      (arg position)
      (arg 0)
      (arg maximum)
      (arg 0)
      (arg viewport)
      (arg (call virtual-length start))
      (arg interval)
      (arg 0)
      (arg 0)
      (arg axis-alignment)
    )
  )
  (where
    (lazy interval (call virtual-length length))
    (lazy axis-alignment (if-expr (> interval viewport) (. ScrollAlignment nearest) alignment))
  )
)
