+ PaneDockView is Box

_ bench Workbench
_ side PaneSide
_ state = bench.#docks[#side]
_ dock-size = workbench-revised(bench.model.layout().dock(#side).size, bench.#revision)
_ is-carrying = workbench-carrying(bench, bench.#dragging, bench.#carried-payload)

────────────────────

<This • flex-col
    display = if #state.is-open then Display.visible else Display.hidden
    <Box • workbench-title-spacer
    <Box • flex-col flex:1
        if #state.current != null
            <Box • workbench-dock-body flex-col flex:1
                if #state.is-topped && (!#state.is-single || #is-carrying)
                    <PaneStrip • pane-strip-row
                        bench = bench
                        side = #side
                        is-row = true
                        is-inside = true
                        is-live = #state.is-open
                <PaneNodeView • flex:1 mx:(workbench-gap / 2) mb:(workbench-gap / 2)
                    bench = bench
                    node = #state.current!.root
                    scope = PaneScope.layout
                    place = PaneRegionKind.dock
                    side = #side
                    is-region = true
                <Resizer
                    edge = workbench-dock-edge(#side)
                    min-size = 150
                    max-size = 900
                    size = #dock-size
                    default-size = pane-side-dock-size
                    collapse-size = 70
                    for length on resized
                        bench.model.set-dock-size(side, length)
                    for event on collapse-requested
                        do use motion($gui-motion-quick)
                            bench.toggle-dock(side)

