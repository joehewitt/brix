+ PaneDockTarget is Box

_ bench Workbench
+ is-drop-target = false

────────────────────
for event on drag-over

. payload = workbench-payload(event.payload)
. carried = payload ?? bench.arriving(event.payload)
if carried && !event.modifiers.option
    is-drop-target = hover(carried.drag, event.root-point)
    event.accept(null, if !is-drop-target then DropOperation.none else drop-kind)
        .. drop-kind = if payload then DropOperation.move else DropOperation.copy
else
    leave-drop()

────────────────────
for session on drag-leave when arrival

leave-drop()

────────────────────
for session on drop when arrival

. payload = workbench-payload(session.payload)
. carried = payload ?? bench.arriving(session.payload)
. target = target-at(carried.drag, session.point) if carried
leave-drop()
if payload && target
    bench.settle-drop(payload.drag, target)
else if target
    do use gui-still-cause
        bench.open-drop(session.payload, target)

────────────────────
+ target-at PaneTarget?
    - drag PaneDrag
    - point Point

null

────────────────────
+ hover Bool
    - drag PaneDrag
    - point Point

target-at(drag, point) != null

────────────────────
+ do leave-drop

is-drop-target = false

