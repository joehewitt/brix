super.leave-drop()
bench.strip-hint = null
bench.spring(null, side)

╌╌╌╌╌╌╌╌╌╌ is Box ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do did-layout

super.did-layout()
fit-items()

╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌

────────────────────
_ do fit-items

=? if !is-row
. icons = List'PaneStripButton()
. keys = List'String()
. groups = group-boxes()
for group in groups
    for item in group.item-boxes()
        . key = "icon:${item.view}"
        keys += key
        if !(hidden has key) && item.bounds.width > 0
            widths[key] = item.bounds.width + 4
        icons += item
. extra = workbench-action-button + 2
. fixed = tools.bounds.width - (if hidden.length > 0 then extra else 0)
. room = content-bounds.width - fixed - workbench-strip-group-gap * groups.length
. total = sum((widths[each] ?? workbench-strip-button) in keys)
. dropped = List'String()
if total > room
    . order = List'String()
    for lit in [false, true]
        for index in 0 .. < icons.length
            . icon = icons[icons.length - 1 - index]
            if icon.is-lit == lit
                order += "icon:${icon.view}"
    . used = total
    for key in order
        if used > room - extra
            dropped += key
            used -= widths[key] ?? workbench-strip-button
=? if ",".join(dropped) == ",".join(hidden)
hidden = dropped

────────────────────
_ group-boxes [PaneStripGroup]

List'PaneStripGroup
    ** tray.active-children
    ?*> each as PaneStripGroup if each is PaneStripGroup

────────────────────
_ along Length
    - point Point

if is-row then point.x else point.y

────────────────────
_ do button-at String?
    - drag PaneDrag
    - point Point

for group in group-boxes()
    . page = group.page
    =? page.views[0] if page.views[0] != drag.view && page.root != drag.stack && holds-point
    .. holds-point = group.bounds.contains(point)
= null

────────────────────
_ do slot-at PaneStripSlot?
    - drag PaneDrag
    - point Point

. groups = group-boxes()
=? null if groups.length == 0
. half = workbench-strip-group-gap / 2
. marks = List'PaneStripMark()
for index in 0 .. < groups.length
    . group = groups[index]
    . frame = group.bounds
    marks += PaneStripMark
        - (if is-row then frame.x else frame.y) - half
        - mark-target(group.page, false)
    if index + 1 == groups.length
        marks += PaneStripMark
            - (if is-row then frame.right else frame.bottom) + half
            - mark-target(group.page, true)
. at = along(point)
. best PaneStripMark? = null
for mark in marks
    if !best || abs(mark.at - at) < abs(best.at - at)
        best = mark
=? null if !best || !bench.model.validate(drag, best.target)
= PaneStripSlot(best.target, hint-at(best.at))

────────────────────
_ mark-target PaneTarget
    - page PaneStripPage
    - after Bool

pane-slot-target(side, if after then bench.model.page-after(side, page.page) else page.page)

────────────────────
_ hint-at Rect
    - at Length

|? is-row
    Rect
        - at - workbench-strip-bar / 2 - origin.x
        - area.y + inset - origin.y
        - workbench-strip-bar
        - area.height - inset * 2
??
    Rect
        - area.x + inset - origin.x
        - at - workbench-strip-bar / 2 - origin.y
        - area.width - inset * 2
        - workbench-strip-bar

.. area = bounds
.. origin = bench.bounds
.. inset Length = 4

