+ PaneTab is PaneDragSource

_ stack PaneStackView
+ view String
+ is-active = false
+ is-compact = false
+ is-framed = #is-active
+ shows-hover = #is-hover-within && !#is-framed
+ is-slot = #view == ""
_ is-carried = false
_ is-held = false
_ is-gap = false
+ is-divided = false
_ slot-width Length = 0
_ title = workbench-revised(bench.title-for(#view), bench.#label-revision)
_ tooltip = workbench-revised(bench.tooltip-for(#view), bench.#label-revision)
_ marks = workbench-revised(bench.tab-marks(#view), bench.#label-revision)
_ symbol = bench.make-mark(#view, #marks)
_ is-renaming = bench.#renaming == #view
_ can-rename = workbench-revised(bench.rename-text(#view), bench.#label-revision) != null
_ is-pointed = false
