. shown = active
=? if !shown
. host = workbench-host(bench.model, shown, context)
visited = List'PaneHost(each in visited when each.key != host.key)
visited += host
if visited.length > bench.mounted-limit
    . ignored = visited.pop-first()
visits += 1

