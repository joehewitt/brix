+ Workbench is Box

+ model PaneModel
+ state-key String?
+ revision = #model.#revision
_ focus-revision = #model.#revision + #model.#focus-revision
+ view-revision U64
_ label-revision = #view-revision + #revision
+ mounted-limit Size = 8
+ retained-contexts [String]
+ renaming String?
_ top-stacks = workbench-revised(#model.top-stacks(), #revision)
_ reflow PaneReflow?
_ hoisted = workbench-top(#top-stacks, #reflow)
_ center-root = workbench-revised(#model.layout().center.root ?? pane-workspace-node(), #revision)
_ floats = workbench-revised(workbench-floats(#model), #revision)
_ docks = workbench-revised(workbench-docks(#model), #revision)
_ dragging PaneDragPayload?
_ carried-payload = owner-window?.#drag-session?.payload
+ float-hint Rect?
+ drop-hint Rect?
+ drop-tab Rect?
+ strip-hint Rect?
_ peek String?
_ peek-side = PaneSide.left
_ spring-view String?
_ popover-key String?
_ popover-content Box?
_ spring-side = PaneSide.left
_ springs := debounced(workbench-spring-delay, this.spring-now)
_ stoplight-inset = workbench-inset(owner-window?.#is-full-screen, owner-window?.#stoplight-inset)

_ owner-window Ancestor'Window
_ headers Descendants'PaneHeader
_ strips Descendants'PaneStrip
_ regions Descendants'PaneNodeView
_ drop-stack PaneStackView?
_ held-zone PaneZone?
_ landing PaneLanding?
_ is-restored = false
_ focusing PaneVisit?

