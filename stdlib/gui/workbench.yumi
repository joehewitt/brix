+ PaneStripView is Box

_ bench Workbench
_ side PaneSide
_ state = bench.#docks[#side]
_ is-carrying = workbench-carrying(bench, bench.#dragging, bench.#carried-payload)
_ is-strip = #state.pages.length > 0 && (!#state.is-single || #is-carrying) && (!#state.is-open || !#state.is-topped) && #state.mode != PaneStripMode.top-only
_ is-edge = !#is-strip && !#state.is-open && #is-carrying

────────────────────

<This • flex-col
    display = if #is-strip || #is-edge then Display.visible else Display.hidden
    min-width = SizeSpec.coord(workbench-strip-width + workbench-gap)
    max-width = SizeSpec.coord(workbench-strip-width + workbench-gap)
    <Box • workbench-title-spacer
    <Box • flex-col flex:1 mx:(workbench-gap / 2) mb:(workbench-gap / 2)
        if #is-edge
            <PaneEdgeTarget • flex:1
                bench = bench
                side = #side
        else
            <PaneStrip • flex:1
                bench = bench
                side = #side
                is-live = #is-strip
                is-boxed = #state.is-open

