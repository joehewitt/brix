+ PaneHeaderFit is Tuple

_ is-hoisted = false
_ is-cramped = false
_ is-nudged = false
_ is-float = false
_ leading Length = 0
_ trailing Length = 0

────────────────────
_ get is-lifted

is-hoisted && !is-cramped

────────────────────
_ get nudge Length

if is-nudged then workbench-gap else 0

────────────────────
_ get bar-top Length

if is-cramped then workbench-title-height else 0

────────────────────
_ get bar-height Length

(if is-lifted then workbench-title-height else workbench-header-height) - nudge

────────────────────
_ get bar-left Length

if is-lifted then leading else 0

────────────────────
_ get bar-right Length

(if is-lifted then trailing else 0) - 4

────────────────────
_ get height Length

bar-top + header-band + (if is-float then 1 else 0)

.. header-band = if is-lifted then workbench-title-height else workbench-header-height

