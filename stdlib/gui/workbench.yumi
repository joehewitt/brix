            rect = Rect(0, 0, #slot-width, gui-tab-height)
            is-tab = true
            is-slot = true
            is-gap = #is-gap
            is-fluid = #is-compact
    else
        <Box • tab-divider
        <Box • tab-side flex-row
            if #shows-close
                <IconButton • tab-close icon-x
                    action = => do bench.close-view(view)
        <Box • tab-center flex-row
            <PaneIcon
                bench = bench
                view = view
            <Box • pane-tab-label flex-row
                max-width = if #is-compact then SizeSpec.coord(0) else SizeSpec.auto
                <Label caption • tab-title
                    text = #title
                    display = if #is-renaming then Display.hidden else Display.visible
                if #is-renaming
                    <PaneRenameInput
                        bench = bench
                        view = view
                        text = bench.rename-text(view) ?? ""
        <Box • tab-side flex-row
            <PaneTabMark
                marks = #marks
                symbol = #symbol
        if #tooltip != null || #is-compact
            <Tooltip
                text = #tooltip ?? #title
        <ContextMenu
            <PaneTabActions
                bench = bench
                view = view
                scope = stack.#scope
                stack = stack.#node.id
                place = stack.#place
                views = stack.#views
                anchor = stack

