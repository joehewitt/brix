+ PaneStripActions is Box

_ bench Workbench
_ view String
_ anchor Box
+ views [String]
_ can-menu = true
_ closes = if #views.length > 0 then #views else List'String(#view)
_ is-group = #closes.length > 1
_ is-menu = workbench-revised(bench.model.in-menu(#view), bench.#revision)
_ is-role = workbench-revised(workbench-all-roles(bench.model, #closes), bench.#revision)
_ is-folded = workbench-revised(bench.model.shows-buttons(#view), bench.#revision)
_ can-fold = !#is-group && (#is-folded || workbench-revised(bench.model.can-inline(#view), bench.#revision))
_ shows-menu = #can-menu

────────────────────

<This • flex-col
    if !#is-group
        <PaneViewItems
            bench = bench
            view = view
            can-rename = false
    <MenuItem "Float" • icon-picture-in-picture-2
        action = => do bench.float-strip-view(view, anchor)
    if #shows-menu
        <MenuItem "Open as Menu" • icon-square-menu
            is-on = #is-menu
            action = => do bench.model.set-menu(view, !is-menu)
    if #can-fold
        if #is-folded
            <MenuItem "Expand Panel" • icon-unfold-vertical
                action = => do fold(false)
        else
            <MenuItem "Collapse Panel" • icon-fold-vertical
                action = => do fold(true)
    <MenuSeparator
    <PaneMoveItems
        bench = bench
        view = #view
    <MenuSeparator
    <MenuItem
        title = if #is-role then "Hide" else "Close"
        action = => do close-all()

────────────────────
_ do fold
    - collapsed Bool

bench.model.set-inline(view, collapsed)

────────────────────
_ do close-all

for each in closes
    bench.close-view(each)

