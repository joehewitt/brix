min(workbench-tab-max-width, max(workbench-tab-width, workbench-tab-chrome + caption-width()))

────────────────────
_ least-width Length

workbench-tab-chrome + min(workbench-tab-least-label, caption-width())

────────────────────
_ caption-width Length

caption.flow-measure(measure-fit-query()).outer-size.width

