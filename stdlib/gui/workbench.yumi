_ float-frame Rect
    - anchor Box

|? !(anchor is PaneStackView)
    fit-float
        - Rect(area.x - bounds.x + 40, area.y - bounds.y - 40, 380, 280)
        - workbench-float-margin
??
    fit-float
        - Rect(area.x - bounds.x + 40, area.y - bounds.y + 40, width, height)
        - workbench-float-margin

.. area = anchor.bounds
.. width = max(260.0, min(area.width, 520.0))
.. height = max(180.0, min(area.height, 420.0))

────────────────────
_ float-area Rect

Rect(0, workbench-title-height, bounds.width, max(0.0, bounds.height - workbench-title-height))

────────────────────
_ fit-float Rect
    - rect Rect
    - margin Length = 0

Rect(x, y, width, height)

.. full = float-area()
.. area = full.inset(Insets(margin, margin, margin, margin))
.. width = min(rect.width, area.width)
.. height = min(rect.height, area.height)
.. x = max(area.x, min(rect.x, area.right - width))
.. y = max(area.y, min(rect.y, area.bottom - height))

────────────────────
_ do clear-drop

. stack = drop-stack
if stack
    stack.header.slot-index = null
strip-hint = null
drop-stack = null
held-zone = null
landing = null
reflow = null
drop-hint = null
drop-tab = null

────────────────────
_ do stack-at PaneStackView?
    - point Point

. found PaneStackView? = null
. near PaneStackView? = null
. reach = workbench-gap / 2 + 0.5
for header in headers
    . stack = header.stack
    if stack.is-home-visible
        . home = stack.home-rect
        if home.contains(point)
            found = stack
        else if home.outset(Insets(reach, reach, reach, reach)).contains(point)
            near = if near == null || stack == drop-stack then stack else near
= found ?? near

────────────────────
_ stack-target PaneTarget
    - stack PaneStackView
    - drag PaneDrag
    - point Point

|? Rect(home.x, home.y, home.width, head).contains(point)
    pane-stack-target
        - stack.scope
        - stack.node.id
        - PaneZone.center
        - stack.header.tab-index(Point(point.x + shown.x - home.x, point.y + shown.y - home.y))
|? !model.can-split(stack.scope, stack.node.id)
    pane-stack-target(stack.scope, stack.node.id, PaneZone.center)
??
    pane-stack-target
        - stack.scope
        - stack.node.id
        - workbench-zone(fx, fy, facing-zones(drag, stack), held-zone, hx, hy)

.. home = stack.home-rect
.. head = stack.home-head()
.. shown = stack.header.bounds
.. area = Rect(home.x, home.y + head, home.width, max(0.0, home.height - head))
.. fx = (point.x - area.x) / max(1.0, area.width)
.. fy = (point.y - area.y) / max(1.0, area.height)
.. hx = workbench-zone-hold / max(1.0, area.width)
.. hy = workbench-zone-hold / max(1.0, area.height)

────────────────────
_ do hover-pane
    - event DragOverEvent
    - stack PaneStackView
    - payload PaneDragPayload

. drag = payload.drag
. target = stack-target(stack, drag, event.root-point)
if target is .stack && model.validate(drag, target)
    . into = target.zone == PaneZone.center
    if target.zone != held-zone
        . is-reorder = into && drag.view != null && target.stack == drag.stack
        landing = if is-reorder then null else landing-of(drag, target, into)
    held-zone = target.zone
    . found = landing
    reflow = found?.reflow
    drop-hint = found?.body
    drop-tab = if into then null else found?.tab
    stack.header.slot-index = (target.index ?? stack.views.length) if into
    stack.header.slot-width = payload.width
    stack.header.is-slot-shown = target.index == null
    event.accept
        - null
        - if event.payload is PaneDragPayload then DropOperation.move else DropOperation.copy
else
    clear-drop()

────────────────────
_ arriving PaneDragPayload?
    - payload DragPayload

PaneDragPayload(pane-arrival-drag(workbench-arrival-view), workbench-tab-width) if droppable

.. droppable = accepts-drop(payload)

────────────────────
_ do landing-of PaneLanding?
    - drag PaneDrag
    - target PaneTarget
    - into Bool

. preview = model.preview(drag, target)
. views = model.payload-views(drag)
=? null if views.length == 0
. found = preview.locate(views[0])
=? null if !found
. before = frames-of(model)
. after = frames-of(preview)
. landed = List'String()
for view in views
    . place = preview.locate(view)
    if place
        landed += place.stack
. shown = Map'String'Rect()
. frames = Map'String'Rect()
. hidden = List'String()
for header in headers
    . stack = header.stack
    . id = stack.node.id
    . was = before[id]
    . now = after[id]
    if was && now && (into || !(landed has id))
        . moved = workbench-shifted(stack.home-rect, was, now)
        shown[id] = moved
        if !workbench-same-rect(was, now)
            frames[id] = moved
    else if was
        hidden += id
. area = shown[found.stack] ?? after[found.stack]
=? null if !area
. region = found.region
. kind = if found.scope == PaneScope.workspace then PaneRegionKind.center else region.kind
. top = preview.top-stacks()
. frame = Rect(area.x - bounds.x, area.y - bounds.y, area.width, area.height)
. fit = workbench-header-fit(this, kind, workbench-hoists(kind, top, found.stack), frame)
. body = Rect(frame.x, frame.y + fit.height, frame.width, frame.height - fit.height)
. tab-top = frame.y + fit.bar-top + (fit.bar-height - gui-tab-height) / 2
. edge = workbench-header-inset(kind, region.side) + gui-tab-tray-pad
. left = frame.x + fit.bar-left + edge
. right = frame.right - fit.bar-right - edge - workbench-header-action-pad
= PaneLanding
    - body
    - Rect(left, tab-top, gui-safe-span(right - left), gui-tab-height)
    - PaneReflow(frames, hidden, top)

────────────────────
_ do frames-of [String = Rect]
    - source PaneModel

. frames = Map'String'Rect()
. top = source.top-stacks()
for view in regions
    if view.is-region
        . root = workbench-region-root(source, view.place, view.side, view.float-id)
        if root
            collect-frames(source, root, view.bounds, view.place, top, frames)
= frames

────────────────────
_ do collect-frames
    - source PaneModel
    - node PaneNode
    - area Rect
    - place PaneRegionKind
    - top [String]
    - frames [String = Rect]

if node.kind == PaneNodeKind.stack
    frames[node.id] = area
else if node.kind == PaneNodeKind.workspace
    . inner = source.layout().workspace.root
    if inner
        collect-frames(source, inner, area, PaneRegionKind.workspace, top, frames)
else if node.kind == PaneNodeKind.split
    . cells = workbench-cells(source, node)
    . gapped = place != PaneRegionKind.float
    . gap Length = if gapped then workbench-gap else 0
    . is-row = node.axis == PaneAxis.row
    . folded = sum
        - workbench-folded-length(source, each.node, place, top) in cells when each.is-collapsed
    . total = max(sum(each.size in cells when !each.is-collapsed), 0.0001)
    . extent = main-size - gap * (max(cells.length, 1) - 1) - folded
        .. main-size = if is-row then area.width else area.height
    . offset Length = 0
    for cell in cells
        . length = if cell.is-collapsed then folded-length else extent * cell.size / total
            .. folded-length = workbench-folded-length(source, cell.node, place, top)
        . rule Length = if cell.index > 0 && !gapped then 1 else 0
        . box = if is-row then row-box else column-box
            .. row-box = Rect(area.x + offset + rule, area.y, length - rule, area.height)
            .. column-box = Rect(area.x, area.y + offset + rule, area.width, length - rule)
        collect-frames(source, cell.node, box, place, top, frames)
        offset += length + gap

────────────────────
_ do facing-zones [PaneZone]
    - drag PaneDrag
    - stack PaneStackView

. zones = List'PaneZone()
=? zones if stack.place == PaneRegionKind.float || !model.vacates(drag)
. source = source-rect(drag, stack)
=? zones if !source
. area = stack.home-rect
. across = min(source.right, area.right) - max(source.left, area.left)
. along = min(source.bottom, area.bottom) - max(source.top, area.top)
if workbench-touches(source.top, area.bottom, across, area.width)
    zones += PaneZone.bottom
if workbench-touches(source.bottom, area.top, across, area.width)
    zones += PaneZone.top
if workbench-touches(source.left, area.right, along, area.height)
    zones += PaneZone.right
if workbench-touches(source.right, area.left, along, area.height)
    zones += PaneZone.left
= zones

────────────────────
_ do source-rect Rect?
    - drag PaneDrag
    - target PaneStackView

. ids = model.drag-stacks(drag)
. found Rect? = null
for header in headers
    . stack = header.stack
    if stack.scope == drag.scope && ids has stack.node.id
        =? null if !workbench-same-region(stack, target)
        found = if found then found + stack.home-rect else stack.home-rect
= found

────────────────────
_ do restore

=? if is-restored
is-restored = true
. key = state-key
. store = gui-app-state(this)
=? if !key || !store
. saved = store.read("workbench:$key", 1)
if saved
    . ignored = model.load(saved)

────────────────────
_ do remember

. key = state-key
=? if !key || !is-restored
. store = gui-app-state(this)
if store
    store.write("workbench:$key", 1, model.json)

━━━━━━━━━━━━━━━━━━━━
+ PaneNodeView is Box

_ bench Workbench
_ node PaneNode
_ scope PaneScope
_ place PaneRegionKind
_ side = PaneSide.left
_ float-id = ""
_ workspace-root = workbench-revised(workbench-workspace-root(bench.model), bench.#revision)
_ is-region = false

────────────────────

<This • flex-col
    if #node.kind == PaneNodeKind.split
        <PaneSplitView • flex:1
            bench = bench
            node = #node
            scope = #scope
            place = #place
            side = #side
            float-id = #float-id
    else if #node.kind == PaneNodeKind.workspace
        <PaneNodeView • flex:1
            bench = bench
            node = #workspace-root
            scope = PaneScope.workspace
            place = PaneRegionKind.workspace
    else
        <PaneStackView • flex:1
            bench = bench
            node = #node
            scope = #scope
            place = #place
            side = #side
            float-id = #float-id

━━━━━━━━━━━━━━━━━━━━
+ PaneSplitView is Box

_ bench Workbench
_ node PaneNode
_ scope PaneScope
_ place PaneRegionKind
_ side = PaneSide.left
_ float-id = ""
_ cells = workbench-revised(workbench-cells(bench.model, #node), bench.#revision)
_ is-gapped = #place != PaneRegionKind.float

────────────────────

<This
    layout = FlexLayout
        - if #node.axis == PaneAxis.row then Orientation.horizontal else Orientation.vertical
    gap = if #is-gapped then workbench-gap else 0
    for cell in #cells keyed by cell.node.id
        <PaneSplitCell
            bench = bench
            split = this
            cell = cell

────────────────────
_ cell-boxes [PaneSplitCell]

List'PaneSplitCell
    ** active-children
    ?*> each as PaneSplitCell if each is PaneSplitCell

────────────────────
_ do even-out

. sizes = List'Float()
for kid in node.kids
    sizes += 1
bench.model.set-split-sizes(node.id, sizes)

────────────────────
_ do commit-sizes

. boxes = cell-boxes()
. sizes = List'Float(node.size-at(each) in 0 .. < node.kids.length)
for box in boxes
    if box.cell.index < sizes.length
        sizes[box.cell.index] = box.drag-flex ?? box.cell.size
bench.model.set-split-sizes(node.id, sizes)
for box in boxes
    box.drag-flex = null

━━━━━━━━━━━━━━━━━━━━
+ PaneSplitCell is Box

_ bench Workbench
_ split PaneSplitView
_ cell PaneCell
_ is-row = #split.#node.axis == PaneAxis.row
_ is-ruled = #cell.index > 0 && !#split.#is-gapped
_ drag-flex Float? = null

────────────────────

<This • flex-col
    flex = if #cell.is-collapsed then 0 else #drag-flex ?? #cell.size
    border-left-width = if #is-ruled && #is-row then 1 else 0
    border-top-width = if #is-ruled && !#is-row then 1 else 0
    <PaneNodeView • flex:1
        bench = bench
        node = #cell.node
        scope = split.#scope
        place = split.#place
        side = split.#side
        float-id = split.#float-id
    if #cell.index > 0 && workbench-gutter-live(split.#cells, #cell.index)
        <PaneGutter
            split = split
            position = #cell.index
            is-row = #is-row
            inset = if split.#is-gapped then workbench-gap / 2 else 0

━━━━━━━━━━━━━━━━━━━━
+ PaneGutter is Box

_ split PaneSplitView
_ position Index
_ is-row = true
_ inset Length = 0
_ offset = -(workbench-gutter-reach / 2 + #inset)

_ lead Index = 0
_ trail Index = 0
_ start-lead Length = 0
_ start-trail Length = 0
_ flex-lead Float = 1
_ flex-trail Float = 1

────────────────────

<This
    left = if #is-row then PositionOffset.coord(#offset) else PositionOffset.coord(0)
    right = if #is-row then null else PositionOffset.coord(0)
    top = if #is-row then PositionOffset.coord(0) else PositionOffset.coord(#offset)
    bottom = PositionOffset.coord(0) if #is-row
    min-width = if #is-row then SizeSpec.coord(workbench-gutter-reach) else SizeSpec.auto
    max-width = if #is-row then SizeSpec.coord(workbench-gutter-reach) else SizeSpec.auto
    min-height = if #is-row then SizeSpec.auto else SizeSpec.coord(workbench-gutter-reach)
    max-height = if #is-row then SizeSpec.auto else SizeSpec.coord(workbench-gutter-reach)
    cursor = if #is-row then CursorStyle.resize-horizontal else CursorStyle.resize-vertical
    drag-cursor = if #is-row then CursorStyle.resize-horizontal else CursorStyle.resize-vertical

────────────────────
_ gesture ~>

~> idle

~> dragging for press on pointer-down when press.button == PointerButton.primary && press.click-count < 2
    do
        begin-resize()

    for drag on pointer-drag when drag.pointer-id == press.pointer-id
        drag.cancel()
        resize-by(axis-of(drag.root-point) - axis-of(press.root-point))

    then idle for up on pointer-up when up.pointer-id == press.pointer-id
        do
            up.cancel()
            split.commit-sizes()

────────────────────
for press on pointer-down when press.button == PointerButton.primary && press.click-count >= 2

split.even-out()
press.cancel()

────────────────────
for event on drag-start

event.cancel()

────────────────────
_ do begin-resize

. boxes = split.cell-boxes()
=? if position >= boxes.length
lead = last(each in 0 .. < position when !boxes[each].cell.is-collapsed) ?? position - 1
trail = first(each in position .. < boxes.length when !boxes[each].cell.is-collapsed) ?? position
start-lead = extent-of(boxes[lead])
start-trail = extent-of(boxes[trail])
flex-lead = boxes[lead].$flex
flex-trail = boxes[trail].$flex

────────────────────
_ do resize-by
    - delta Length

. boxes = split.cell-boxes()
=? if trail >= boxes.length
. total = start-lead + start-trail
=? if total <= workbench-min-pane-size * 2
. sum = flex-lead + flex-trail
. leading = max(workbench-min-pane-size, min(total - workbench-min-pane-size, start-lead + delta))
. share = sum * leading / total
boxes[lead].drag-flex = share
boxes[trail].drag-flex = sum - share

────────────────────
_ extent-of Length
    - box Box

if is-row then box.bounds.width else box.bounds.height

────────────────────
_ axis-of Length
    - point Point

if is-row then point.x else point.y

━━━━━━━━━━━━━━━━━━━━
+ PaneStackView is Box

_ bench Workbench
+ node PaneNode
_ scope PaneScope
_ place PaneRegionKind
_ side = PaneSide.left
_ float-id = ""
_ views = workbench-revised(bench.model.tab-views(#node), bench.#revision)
+ inlined = workbench-revised(workbench-inlined(bench.model, #node), bench.#revision)
_ active = workbench-revised(bench.model.active-view(#node), bench.#revision)
_ context = workbench-revised(bench.model.current, bench.#revision)
_ active-key = workbench-revised
    - workbench-host-key(bench.model, #active, #context)
    - bench.#revision
_ retained = bench.#retained-contexts
_ is-hoisted = workbench-hoists(#place, bench.#hoisted, #node.id)
+ is-boxed = workbench-is-boxed(bench, #place, #side, #active)
+ is-collapsed = workbench-revised(#node.is-collapsed, bench.#revision)
_ is-folded = #is-collapsed || (#views.length == 0 && #inlined.length > 0)
_ is-docked = #place == PaneRegionKind.dock
+ is-lit = #is-boxed && workbench-revised(bench.model.focused-stack(), bench.#focus-revision) == #node.id
_ is-passive = !bench.model.is-focusable(#active ?? "")
_ placed = workbench-placed(bench.#reflow, #node.id)
+ is-placed = #placed != null
_ is-vacated = workbench-vacated(bench.#reflow, #node.id)

_ cell Ancestor'PaneNodeView
_ visited [PaneHost]
_ visits U64

────────────────────

<This • flex-col
    match = "workbench-stack-${#node.id}"
    keeps-focus = #is-docked || #is-passive
    focus-group = !#is-passive
    display = if #is-vacated then Display.hidden else Display.visible
    left = PositionOffset.coord(#placed.x) if #placed != null
    top = PositionOffset.coord(#placed.y) if #placed != null
    min-width = if #placed != null then SizeSpec.coord(#placed.width) else SizeSpec.auto
    max-width = if #placed != null then SizeSpec.coord(#placed.width) else SizeSpec.auto
