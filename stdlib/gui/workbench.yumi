+ PaneTabActions is Box

_ bench Workbench
_ view String
_ scope PaneScope
_ stack String
_ place PaneRegionKind
_ views [String]
_ anchor Box
_ is-page = false
_ is-alone = #views.length <= 1
_ can-float = !(#is-alone && #place == PaneRegionKind.float)
_ can-float-group = !#is-alone && #place != PaneRegionKind.float
_ is-collapsed = workbench-revised
    - bench.model.stack-in(#scope, #stack)?.is-collapsed ?? false
    - bench.#revision
_ can-collapse = workbench-revised(bench.model.can-collapse(#scope, #stack), bench.#revision)
_ can-inline = workbench-revised(bench.model.can-inline(#view), bench.#revision)
_ is-menu = workbench-revised(bench.model.in-menu(#view), bench.#revision)

────────────────────

<This • flex-col
    <PaneViewItems
        bench = bench
        view = #view
    <MenuItem "Float Tab" • icon-picture-in-picture-2
        is-enabled = #can-float
        action = => do bench.float-view(view, scope, stack, anchor)
    <MenuItem "Float Group" • icon-app-window
        is-enabled = #can-float-group
        action = => do bench.float-stack(scope, stack, anchor)
    if #is-page
        <MenuItem "Open as Menu" • icon-square-menu
            is-on = #is-menu
            action = => do bench.model.set-menu(view, !is-menu)
    if #is-collapsed
        <MenuItem "Expand Panel" • icon-unfold-vertical
            action = => do bench.model.set-collapsed(scope, stack, false)
    else
        <MenuItem "Collapse Panel" • icon-fold-vertical
            is-enabled = #can-inline || #can-collapse
            action = => do collapse()
    <MenuSeparator
    <MenuItem "Split Right" • icon-panel-right-dashed
        is-enabled = !#is-alone
        action = => do bench.split-view(view, scope, stack, PaneZone.right)
    <MenuItem "Split Left" • icon-panel-left-dashed
        is-enabled = !#is-alone
        action = => do bench.split-view(view, scope, stack, PaneZone.left)
    <MenuItem "Split Down" • icon-panel-bottom-dashed
        is-enabled = !#is-alone
        action = => do bench.split-view(view, scope, stack, PaneZone.bottom)
    <MenuItem "Split Up" • icon-panel-top-dashed
        is-enabled = !#is-alone
        action = => do bench.split-view(view, scope, stack, PaneZone.top)
    <MenuSeparator
    if #is-page
        <PaneMoveItems
            bench = bench
            view = #view
        <MenuSeparator
    <MenuItem "Close Tab" • icon-x
        action = => do bench.close-view(view)

────────────────────
_ do collapse

if can-inline
    bench.model.set-inline(view, true)
else
    bench.model.set-collapsed(scope, stack, true)

