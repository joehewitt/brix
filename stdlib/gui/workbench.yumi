────────────────────

<This • flex-col
    left = PositionOffset.coord(#frame-x)
    top = PositionOffset.coord(max(workbench-title-height, #frame-y))
    min-width = SizeSpec.coord(#frame-width - workbench-float-border * 2)
    max-width = SizeSpec.coord(#frame-width - workbench-float-border * 2)
    min-height = SizeSpec.coord(#frame-height - workbench-float-border * 2)
    max-height = SizeSpec.coord(#frame-height - workbench-float-border * 2)
    if #tree != null
        <PaneNodeView • flex:1
            bench = bench
            node = #tree!
            scope = PaneScope.layout
            place = PaneRegionKind.float
            float-id = #region.id
            is-region = true
    for sides in workbench-float-sides
        <PaneFloatEdge
            float = this
            sides = sides

────────────────────
_ moving ~>

~> rest

~> moving for press on pointer-down when press.button == PointerButton.primary && bench.is-float-grab(region.id, press.root-point)
    do
        start-x = frame-x
        start-y = frame-y

    for drag on pointer-drag when drag.pointer-id == press.pointer-id
        drag.cancel()
        move-by
            - Point(drag.root-point.x - press.root-point.x, drag.root-point.y - press.root-point.y)

    then rest for up on pointer-up when up.pointer-id == press.pointer-id
        do
            up.cancel()
            commit-frame()

╌╌╌╌╌╌╌╌╌╌ is Box ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do mounted

super.mounted()
set-theme-tag("glass", false)

╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌

────────────────────
_ do move-by
    - delta Point

. moved = bench.fit-float(Rect(start-x + delta.x, start-y + delta.y, frame-width, frame-height))
frame-x = moved.x
frame-y = moved.y

────────────────────
_ do begin-resize

start-x = frame-x
start-y = frame-y
start-width = frame-width
start-height = frame-height

────────────────────
_ do resize-by
    - sides PaneFloatSides
    - delta Point

. area = bench.float-area()
. left = start-x
. top = start-y
. right = start-x + start-width
. bottom = start-y + start-height
if sides.left
    left = max(area.x, min(right - workbench-float-min-width, left + delta.x))
if sides.right
    right = min(area.right, max(left + workbench-float-min-width, right + delta.x))
if sides.top
    top = max(area.y, min(bottom - workbench-float-min-height, top + delta.y))
if sides.bottom
    bottom = min(area.bottom, max(top + workbench-float-min-height, bottom + delta.y))
frame-x = left
frame-y = top
frame-width = right - left
frame-height = bottom - top

────────────────────
_ do commit-frame

bench.model.move-float(region.id, frame-x, frame-y, frame-width, frame-height)

━━━━━━━━━━━━━━━━━━━━
+ PaneFloatEdge is Box

_ float PaneFloatView
_ sides PaneFloatSides
_ is-corner = (#sides.left || #sides.right) && (#sides.top || #sides.bottom)

────────────────────

<This
    left = if #sides.right then null else PositionOffset.coord(if #sides.left then 0 else workbench-float-corner)
    right = if #sides.left then null else PositionOffset.coord(if #sides.right then 0 else workbench-float-corner)
    top = if #sides.bottom then null else PositionOffset.coord(if #sides.top then 0 else workbench-float-corner)
    bottom = if #sides.top then null else PositionOffset.coord(if #sides.bottom then 0 else workbench-float-corner)
    min-width = if #sides.left || #sides.right then SizeSpec.coord(if #is-corner then workbench-float-corner else workbench-float-edge) else SizeSpec.auto
    max-width = if #sides.left || #sides.right then SizeSpec.coord(if #is-corner then workbench-float-corner else workbench-float-edge) else SizeSpec.auto
    min-height = if #sides.top || #sides.bottom then SizeSpec.coord(if #is-corner then workbench-float-corner else workbench-float-edge) else SizeSpec.auto
    max-height = if #sides.top || #sides.bottom then SizeSpec.coord(if #is-corner then workbench-float-corner else workbench-float-edge) else SizeSpec.auto
    cursor = workbench-float-cursor(#sides)

────────────────────
_ gesture ~>

~> idle

~> resizing for press on pointer-down when press.button == PointerButton.primary
    do
        float.begin-resize()

    for drag on pointer-drag when drag.pointer-id == press.pointer-id
        drag.cancel()
        float.resize-by
            - sides
            - Point(drag.root-point.x - press.root-point.x, drag.root-point.y - press.root-point.y)

    then idle for up on pointer-up when up.pointer-id == press.pointer-id
        do
            up.cancel()
            float.commit-frame()

━━━━━━━━━━━━━━━━━━━━
+ PanePeek is Popup

_ bench Workbench
_ view String
_ side PaneSide
_ strip PaneStrip
_ size = workbench-revised(bench.model.layout().dock(#side).size, bench.#revision)
_ group = workbench-revised(workbench-peek-group(bench.model, #view), bench.#revision)

────────────────────

<This • flex-col
    placement = PanePeekPlacement(#side, strip, #size)
    if #group != null
        <PaneNodeView • flex:1 mt:(workbench-gap / 2)
            bench = bench
            node = #group!
            scope = PaneScope.layout
            place = PaneRegionKind.dock
            side = #side
    else
        if bench.#renaming == #view
            <Box • pane-peek-header flex-row
                <PaneIcon
                    bench = bench
                    view = #view
                <PaneRenameInput • pane-peek-rename
                    bench = bench
                    view = #view
                    text = bench.rename-text(#view) ?? ""
        <PaneContentHost • flex:1
            bench = bench
            view = #view
            context = workbench-host(bench.model, #view, bench.model.current).context

────────────────────
for reason on dismissed when arrival

bench.close-peek(view)

────────────────────
for event on Choosing.chosen

bench.close-peek(view)

╌╌╌╌╌╌╌╌╌╌ is Box ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do mounted

super.mounted()
show()

╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌

━━━━━━━━━━━━━━━━━━━━
_ workbench-peek-group PaneNode?
    - model PaneModel
    - view String

page.root if page && model.page-views(page).length > 1

.. page = model.locate(view)?.page

━━━━━━━━━━━━━━━━━━━━
+ PanePeekPlacement is Placement

_ side PaneSide
_ strip PaneStrip
_ size Length

────────────────────
+ This
    - side
    - strip
    - size

╌╌╌╌╌╌╌╌╌╌ is Placement ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do place
    - request PlacementRequest

. area = request.anchor
if strip.is-inside
    . floor = strip.dock?.bounds.bottom ?? request.boundary.bottom
    = PlacementResult(Rect(area.x, area.bottom, area.width, max(0.0, floor - area.bottom)))
= match side
    |= PaneSide.left
        PlacementResult(Rect(area.right, area.y, size, area.height))
    |= PaneSide.right
        PlacementResult(Rect(area.x - size, area.y, size, area.height))

━━━━━━━━━━━━━━━━━━━━
_ do workbench-corner String
    - root PaneNode?
    - revision U64

. cursor = root
while cursor && cursor.is-split && cursor.kids.length > 0
    cursor = cursor.kids[if cursor.axis == PaneAxis.row then cursor.kids.length - 1 else 0]
. ignored = revision
= cursor?.id ?? ""

━━━━━━━━━━━━━━━━━━━━
_ do workbench-inlined [String]
    - model PaneModel
    - stack PaneNode

. tabs = model.tab-views(stack)
= List'String(each in model.visible-views(stack) when !(tabs has each))

━━━━━━━━━━━━━━━━━━━━
_ workbench-dock-side PaneSide?
    - model PaneModel
    - view String

place.region.side if place && place.region.kind == PaneRegionKind.dock

.. place = model.locate(view)

━━━━━━━━━━━━━━━━━━━━
_ workbench-lone-tab PaneLocation?
    - model PaneModel
    - view String

|? !place || place.region.kind != PaneRegionKind.dock
    null
|? !page || model.page-views(page).length != 1
    null
|? workbench-stack-tabs(model, place.scope, place.stack).length != 1
    null
??
    place

.. place = model.locate(view)
.. page = place.page

━━━━━━━━━━━━━━━━━━━━
_ workbench-is-iconic Bool
    - model PaneModel
    - view String

|? !place || place.region.kind != PaneRegionKind.dock
    false
|? !page || workbench-stack-tabs(model, place.scope, place.stack).length != 1
    false
??
    views.length == 1 || (model.pages-in(place.region.side).length == 1 && views[0] == view)

.. place = model.locate(view)
.. page = place.page
.. views = model.page-views(page)

━━━━━━━━━━━━━━━━━━━━
_ workbench-stack-tabs [String]
    - model PaneModel
    - scope PaneScope
    - stack String

if node then model.tab-views(node) else List'String()

.. node = model.stack-in(scope, stack)

━━━━━━━━━━━━━━━━━━━━
_ do workbench-docks [PaneDockState]
    - model PaneModel

. docks = List'PaneDockState()
for side in [PaneSide.left, PaneSide.right]
    . region = model.layout().dock(side)
    . pages = List'PaneStripPage(workbench-strip-page(model, each) in model.pages-in(side))
    docks += PaneDockState(side, pages, model.current-page(side), region.strip, region.is-collapsed)
= docks

━━━━━━━━━━━━━━━━━━━━
_ workbench-strip-page PaneStripPage
    - model PaneModel
    - page PanePage

PaneStripPage(page.id, page.root.id, views, List'String(each in views when model.is-shown(each)))

.. views = model.page-views(page)

━━━━━━━━━━━━━━━━━━━━
_ workbench-button-tooltip String
    - button PaneButton

|? !button.is-available && button.unavailable-reason.length > 0
    button.unavailable-reason
??
    button.description

━━━━━━━━━━━━━━━━━━━━
_ do workbench-overflow [PaneOverflowItem]
    - bench Workbench
    - pages [PaneStripPage]
    - hidden [String]

. items = List'PaneOverflowItem()
=? items if hidden.length == 0
for page in pages
    for view in page.views
        . key = "icon:$view"
        if hidden has key
            items += PaneOverflowItem(key, view, bench.title-for(view))
= items

━━━━━━━━━━━━━━━━━━━━
_ workbench-strip-folded Bool
    - views [String]
    - hidden [String]

views.length > 0 && (all(views) • where hidden has "icon:$each")

━━━━━━━━━━━━━━━━━━━━
_ workbench-strip-carried Bool
    - dragging PaneDragPayload?
    - view String
    - root String

|? !dragging
    false
|? dragging.drag.view
    dragging.drag.view == view
??
    dragging.drag.stack == root

━━━━━━━━━━━━━━━━━━━━
_ do workbench-all-roles Bool
    - model PaneModel
    - views [String]

. roles = model.role-views()
= all(views) • where roles has each

━━━━━━━━━━━━━━━━━━━━
_ workbench-placed [String]
    - model PaneModel
    - views [String]

List'String(each in views when model.locate(each) != null)

━━━━━━━━━━━━━━━━━━━━
_ workbench-float-cursor CursorStyle
    - sides PaneFloatSides

|? (sides.left && sides.top) || (sides.right && sides.bottom)
    CursorStyle.resize-nwse
|? (sides.right && sides.top) || (sides.left && sides.bottom)
    CursorStyle.resize-nesw
|? sides.left || sides.right
    CursorStyle.resize-horizontal
??
    CursorStyle.resize-vertical

━━━━━━━━━━━━━━━━━━━━
_ workbench-inset Length
    - is-full-screen Bool?
    - inset Length?

if is-full-screen ?? false then window-full-screen-inset else inset ?? window-stoplight-inset

━━━━━━━━━━━━━━━━━━━━
_ workbench-workspace-root PaneNode
    - model PaneModel

model.layout().workspace.root ?? pane-stack-node("workspace-empty", List'String())

━━━━━━━━━━━━━━━━━━━━
_ workbench-floats [PaneRegion]
    - model PaneModel

List'PaneRegion(model.layout().floats)

━━━━━━━━━━━━━━━━━━━━
_ workbench-dock-edge Side
    - side PaneSide

match side
    |= PaneSide.left
        Side.right
    |= PaneSide.right
        Side.left

━━━━━━━━━━━━━━━━━━━━
_ do workbench-cells [PaneCell]
    - model PaneModel
    - node PaneNode

. cells = List'PaneCell()
for index in 0 .. < node.kids.length
    . kid = node.kids[index]
    cells += PaneCell
        - kid
        - index
        - node.size-at(index)
        - node.axis == PaneAxis.column && model.is-folded-node(kid)
= cells

━━━━━━━━━━━━━━━━━━━━
_ workbench-gutter-live Bool
    - cells [PaneCell]
    - position Index

(some(cells[0 .. < position]) • where !each.is-collapsed) && (some(cells[position .. < cells.length]) • where !each.is-collapsed)

━━━━━━━━━━━━━━━━━━━━
_ workbench-top [String]
    - top [String]
    - reflow PaneReflow?

reflow?.top ?? top

━━━━━━━━━━━━━━━━━━━━
_ workbench-placed Rect?
    - reflow PaneReflow?
    - id String

reflow?.frames[id]

━━━━━━━━━━━━━━━━━━━━
_ workbench-vacated Bool
    - reflow PaneReflow?
    - id String

reflow?.hidden.has(id) ?? false

━━━━━━━━━━━━━━━━━━━━
_ workbench-shifted Rect
    - home Rect
    - was Rect
    - now Rect

Rect(left, top, max(0.0, right - left), max(0.0, bottom - top))

.. left = home.x + now.x - was.x
.. top = home.y + now.y - was.y
.. right = home.right + now.right - was.right
.. bottom = home.bottom + now.bottom - was.bottom

━━━━━━━━━━━━━━━━━━━━
_ workbench-same-rect Bool
    - a Rect
    - b Rect

same-origin && abs(a.right - b.right) < 0.5 && abs(a.bottom - b.bottom) < 0.5

.. same-origin = abs(a.x - b.x) < 0.5 && abs(a.y - b.y) < 0.5

━━━━━━━━━━━━━━━━━━━━
_ do workbench-folded-length Length
    - source PaneModel
    - node PaneNode
    - place PaneRegionKind
    - top [String]

=? workbench-folded-extent(place, top, node.id) if !node.is-split
. gap Length = if place != PaneRegionKind.float then workbench-gap else 0
. cells = workbench-cells(source, node)
. total Length = 0
. tallest Length = 0
for cell in cells
    . length = workbench-folded-length(source, cell.node, place, top)
    total += length
    tallest = max(tallest, length)
= if node.axis == PaneAxis.row then tallest else total + gap * (max(cells.length, 1) - 1)

━━━━━━━━━━━━━━━━━━━━
_ workbench-folded-extent Length
    - place PaneRegionKind
    - top [String]
    - id String

|? workbench-hoists(place, top, id)
    workbench-title-height
??
    workbench-header-height + (if place == PaneRegionKind.float then 1 else 0)

━━━━━━━━━━━━━━━━━━━━
_ workbench-region-root PaneNode?
    - source PaneModel
    - place PaneRegionKind
    - side PaneSide
    - float-id String

match? place
    |= PaneRegionKind.center
        source.layout().center.root
    |= PaneRegionKind.dock
        source.current-page(side)?.root
    |= PaneRegionKind.float
        source.layout().find-float(float-id)?.root

━━━━━━━━━━━━━━━━━━━━
_ workbench-hoists Bool
    - place PaneRegionKind
    - top [String]
    - id String

workbench-is-central(place) && top has id

━━━━━━━━━━━━━━━━━━━━
_ workbench-carried String?
    - dragging PaneDragPayload?
    - stack String
    - scope PaneScope

|? !dragging
    null
|? drag.stack != stack || drag.scope != scope
    null
??
    drag.view

.. drag = dragging.drag

━━━━━━━━━━━━━━━━━━━━
_ workbench-tab-divided Bool
    - items [String]
    - item String
    - framed String?
    - hovered String?
    - carried String?
    - held Bool

item-plain && leader != null && workbench-tab-plain(leader, framed, hovered, carried)

.. shown = if held then items else List'String(each in items when each != carried)
.. item-plain = workbench-tab-plain(item, framed, hovered, carried)
.. index = shown.find(item) ?? 0
.. leader = shown[index - 1] if index > 0

━━━━━━━━━━━━━━━━━━━━
_ workbench-tab-plain Bool
    - item String
    - framed String?
    - hovered String?
    - carried String?

item != "" && item != framed && item != hovered && item != carried

━━━━━━━━━━━━━━━━━━━━
_ workbench-tab-slots [String]
    - views [String]
    - slot Index?
    - carried String?

|? slot == null
    views
|? home != null
    List'String
        ** rest[0 .. < held]
        *? carried
        ** rest[held .. < rest.length]
??
    List'String
        ** views[0 .. < at]
        * ""
        ** views[at .. < views.length]

.. at = min(slot ?? views.length, views.length)
.. home = views.find(carried) if carried
.. rest = List'String(each in views when each != carried)
.. held = min(if at > (home ?? at) then at - 1 else at, rest.length)

━━━━━━━━━━━━━━━━━━━━
_ workbench-header-inset Length
    - place PaneRegionKind
    - side PaneSide

if place == PaneRegionKind.dock then gui-sidebar-row-inset - gui-tab-tray-pad else 4

━━━━━━━━━━━━━━━━━━━━
_ workbench-header-fit PaneHeaderFit
    - bench Workbench
    - place PaneRegionKind
    - is-hoisted Bool
    - frame Rect

PaneHeaderFit(is-hoisted, cramped, nudged, place == PaneRegionKind.float, leading, trailing)

.. leading = if is-hoisted then max(0.0, bench.leading-edge - frame.x) else 0
.. trailing = if is-hoisted then max(0.0, frame.right - bench.trailing-edge) else 0
.. cramped = is-hoisted && frame.width - leading - trailing < workbench-min-hoisted-width
.. nudged = place != PaneRegionKind.float && !(is-hoisted && !cramped) && below-title
.. below-title = frame.y > workbench-title-height + 0.5

━━━━━━━━━━━━━━━━━━━━
_ workbench-same-region Bool
    - source PaneStackView
    - target PaneStackView

|? workbench-is-central(source.place) && workbench-is-central(target.place)
    true
??
    source.place == target.place && source.side == target.side && source.float-id == target.float-id

━━━━━━━━━━━━━━━━━━━━
_ workbench-is-central Bool
    - place PaneRegionKind

place == PaneRegionKind.center || place == PaneRegionKind.workspace

━━━━━━━━━━━━━━━━━━━━
_ workbench-holds Bool
    - tree PaneNode?
    - stack String?

|? !tree || !stack
    false
??
    some(tree.stacks()) • where each.id == stack

━━━━━━━━━━━━━━━━━━━━
_ workbench-is-boxed Bool
    - bench Workbench
    - place PaneRegionKind
    - side PaneSide
    - view String?

|? !view || place == PaneRegionKind.float
    false
|? workbench-is-central(place)
    true
??
    bench.boxes-in-sidebar(view)

━━━━━━━━━━━━━━━━━━━━
_ PaneHost is (key String, view String, context String)

━━━━━━━━━━━━━━━━━━━━
_ workbench-host PaneHost
    - model PaneModel
    - view String
    - context String

if is-instance then PaneHost("$context|$view", view, context) else PaneHost(view, view, "")

.. is-instance = model.instance-kind(view) != null

━━━━━━━━━━━━━━━━━━━━
_ workbench-host-key String?
    - model PaneModel
    - view String?
    - context String

workbench-host(model, view, context).key if view

━━━━━━━━━━━━━━━━━━━━
_ do workbench-hosts [PaneHost]
    - model PaneModel
    - node PaneNode
    - views [String]
    - active String?
    - context String
    - visited [PaneHost]
    - retained [String]
    - visits U64
    - revision U64

. ignored = visits + revision
. hosts [PaneHost]
for view in views
    . host = workbench-host(model, view, context)
    if view == active || (some(visited) • where each.key == host.key)
        hosts += host
for host in visited
    if other-context && retained has host.context && holds-view
        hosts += host
    .. other-context = host.context != "" && host.context != context
    .. holds-view = node.views has host.view && model.holds-instance(host.context, host.view)
= hosts

━━━━━━━━━━━━━━━━━━━━
_ workbench-kept-visits [PaneHost]
    - visited [PaneHost]
    - context String
    - retained [String]

List'PaneHost(each in visited when each.context == "" || each.context == context || retained has each.context)

━━━━━━━━━━━━━━━━━━━━
_ workbench-revised'Value Value
    - value Value
    - revision U64

value

.. ignored = revision

━━━━━━━━━━━━━━━━━━━━
_ workbench-payload PaneDragPayload?
    - payload DragPayload

payload as PaneDragPayload if payload is PaneDragPayload

━━━━━━━━━━━━━━━━━━━━
_ workbench-carrying Bool
    - bench Workbench
    - dragging PaneDragPayload?
    - payload DragPayload?

|? dragging
    true
|? payload
    !(payload is PaneDragPayload) && bench.accepts-drop(payload)
??
    false

━━━━━━━━━━━━━━━━━━━━
_ do workbench-zone PaneZone
    - fx Float
    - fy Float
    - blocked [PaneZone]
    - held PaneZone? = null
    - hx Float = 0
    - hy Float = 0

if held != null && held != PaneZone.center && !(blocked has held)
    . across = held == PaneZone.left || held == PaneZone.right
    . depth = match held
        |= PaneZone.left
            fx
        |= PaneZone.right
            1 - fx
        |= PaneZone.top
            fy
        ??
            1 - fy
    =? held if depth < workbench-zone-edge + (if across then hx else hy)
. inner = held == PaneZone.center
. ex = workbench-zone-edge - (if inner then hx else 0)
. ey = workbench-zone-edge - (if inner then hy else 0)
. zone = PaneZone.center
. nearest Float = 1
if fx < ex && fx < nearest && !(blocked has PaneZone.left)
    zone = PaneZone.left
    nearest = fx
if 1 - fx < ex && 1 - fx < nearest && !(blocked has PaneZone.right)
    zone = PaneZone.right
    nearest = 1 - fx
if fy < ey && fy < nearest && !(blocked has PaneZone.top)
    zone = PaneZone.top
    nearest = fy
if 1 - fy < ey && 1 - fy < nearest && !(blocked has PaneZone.bottom)
    zone = PaneZone.bottom
= zone

━━━━━━━━━━━━━━━━━━━━
_ workbench-touches Bool
    - edge Length
    - other Length
    - overlap Length
    - length Length

within-reach && overlap * 2 > length

.. within-reach = edge - other <= workbench-touch-reach && other - edge <= workbench-touch-reach
