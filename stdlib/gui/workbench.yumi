_ is-folded = workbench-strip-folded(#page.views, #hidden)

────────────────────

<This
    layout = FlexLayout(if #is-row then Orientation.horizontal else Orientation.vertical)
    display = if #is-folded then Display.hidden else Display.visible
    if #page.views.length > 0
        for view in #page.views keyed by view
            <PaneStripButton
                bench = bench
                view = view
                views = #page.views
                page-root = #page.root
                side = strip.side
                is-lit = #is-up && #page.shown has view
                is-hidden = #hidden has "icon:$view"
    else
        <PaneStripBlank
            bench = bench
            view = ""
            page = #page
            page-root = #page.root
            side = strip.side
            is-lit = #lit-page == #page.page

