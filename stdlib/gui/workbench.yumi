+ PaneStrip is PaneDockTarget

_ side PaneSide
+ is-row = false
+ is-boxed = false
_ is-inside = false
_ is-live = false
_ state = bench.#docks[#side]
_ roles = workbench-revised(bench.model.role-views(), bench.#revision)
_ placed = workbench-revised(workbench-placed(bench.model, #roles), bench.#revision)
_ peek = bench.#peek if #is-live && bench.#peek-side == #side
_ hidden [String]
_ overflow-items = workbench-revised
    - workbench-overflow(bench, #state.pages, #hidden)
    - bench.#label-revision
_ widths [String = Length]

_ dock Ancestor'PaneDockView

────────────────────

<This
    layout = FlexLayout(if #is-row then Orientation.horizontal else Orientation.vertical)
    <Box tray • pane-strip-tray
        layout = FlexLayout(if #is-row then Orientation.horizontal else Orientation.vertical)
        for page in #state.pages keyed by page.page
            <PaneStripGroup
                bench = bench
                strip = this
                page = page
                is-row = #is-row
                lit-page = #state.lit-page
                hidden = #hidden
    <Box • pane-strip-fill
    <Box tools • pane-header-actions flex-row
        if #hidden.length > 0
            <IconButton overflow • icon-chevrons-right
                action = => do overflow-menu.show(PopupAnchor.box(overflow))
                <Tooltip "More"
    <Menu overflow-menu
        for item in #overflow-items keyed by item.key
            <MenuItem
                title = item.title
                action = => do bench.press-strip(item.view, side)
    <ContextMenu
        for view in #roles keyed by view
            <MenuItem
                title = bench.title-for(view)
                is-on = #placed has view
                action = => do bench.toggle-pane(view, side)
        <MenuSeparator
        <MenuItem "Strip Beside the Sidebar"
            is-on = #state.mode == PaneStripMode.beside
            action = => do bench.model.set-strip-mode(side, PaneStripMode.beside)
        <MenuItem "Strip at the Top of the Sidebar"
            is-on = #state.mode == PaneStripMode.top
            action = => do bench.model.set-strip-mode(side, PaneStripMode.top)
        <MenuItem "Strip Only at the Top of the Sidebar"
            is-on = #state.mode == PaneStripMode.top-only
            action = => do bench.model.set-strip-mode(side, PaneStripMode.top-only)
    if #peek != null
        <PanePeek
            bench = bench
            view = #peek!
            side = side
            strip = this

