────────────────────
for event on drag-over

. payload = workbench-payload(event.payload)
if payload && event.modifiers.option
    clear-drop()
    . point = point-in-box(event.root-point)
    float-hint = fit-float(Rect(point.x - 30, point.y - 12, 380, 260), workbench-float-margin)
    event.accept(null, DropOperation.move)
else
    float-hint = null
    . stack = stack-at(event.root-point)
    if stack != drop-stack
        clear-drop()
        drop-stack = stack
    . carried = payload ?? arriving(event.payload)
    if stack && carried
        hover-pane(event, stack, carried)
    else
        clear-drop()

────────────────────
for session on drag-leave when arrival

float-hint = null
clear-drop()

────────────────────
for visit on switcher.chosen

visit-view(visit)

────────────────────
for view on model.menu-requested

. place = model.locate(view)
if place
    show-peek(view, place.region.side)

────────────────────
for session on drop when arrival

. hint = float-hint
. payload = workbench-payload(session.payload)
. carried = payload ?? arriving(session.payload)
. stack = drop-stack
. target = stack-target(stack, carried.drag, session.point) if stack && carried
if payload && hint
    settle-drop(payload.drag, pane-float-target(hint.x, hint.y, hint.width, hint.height))
else if target && payload
    settle-drop(payload.drag, target)
else if target
    do use gui-still-cause
        float-hint = null
        clear-drop()
        open-drop(session.payload, target)
else
    float-hint = null
    clear-drop()

