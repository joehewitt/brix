────────────────────
_ do fit-tabs

. found = tab-boxes()
. margins Length = if carried != null then 0 else workbench-slot-gap * 2
. slot Length = if slot-index != null then slot-width + margins else 0
. count = found.length + (if slot > 0 then 1 else 0)
. room = bar.content-bounds.width - tools.bounds.width - gui-tab-tray-pad * 2 - slot - tab-gaps
    .. tab-gaps = gui-tab-gap * max(0, count - 1)
is-compact = room < max(each.least-width() in found) * found.length

