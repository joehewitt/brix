────────────────────
+ target-at PaneTarget?
    - drag PaneDrag
    - point Point

slot-at(drag, point)?.target

────────────────────
+ do hover Bool
    - drag PaneDrag
    - point Point

. found = slot-at(drag, point)
bench.strip-hint = found?.hint
bench.spring(button-at(drag, point), side)
= found != null

