
./box
./primitives
./status-item
./theme
./window
/BxAppleGUI/BxAppleGUI.h
/core/intrinsics
/gc
/graphics/color
/graphics/vectorgeometry
/os/bundle
/os/path
/ui/app-state

+ gui-minimum-heap-goal Size = 128 * 1024 * 1024

━━━━━━━━━━━━━━━━━━━━
+ App is GuiNode

+ title = main-bundle-name ?? ""
+ keeps-display-awake = false
+ is-quitting = false
+ state AppState?
+ native Pointer?
+ first-window Window?
+ last-window Window?
+ status-items [StatusItem]
+ vector-geometry-table := VectorGeometryTable()
+ accents GUIAccents?
+ event open-requested [Path]
_ has-run = false

. title-changed < title
. keeps-display-awake-changed < keeps-display-awake

────────────────────
+ This

set-minimum-heap-goal(gui-minimum-heap-goal)
native = C:brixGuiAppCreate()
C:brixGuiAppSetQuitCallback(native!, gui-app-native-quit as GuiAppCallback, this as Pointer)
C:brixGuiAppSetBackgroundCallback
    - native!
    - gui-app-native-background as GuiAppCallback
    - this as Pointer
C:brixGuiAppSetOpenCallback(native!, gui-app-native-open as GuiAppOpenCallback, this as Pointer)
C:brixGuiAppSetSystemCallback(native!, gui-app-native-system as GuiAppCallback, this as Pointer)
title-changed()
when-main-ends(autorun)

────────────────────
+ do title-changed

if native
    C:brixGuiAppSetTitle(native, title)

────────────────────
+ do keeps-display-awake-changed

if native
    C:brixGuiAppSetKeepsDisplayAwake(native, keeps-display-awake)

────────────────────
+ do ensure-accents

=? if accents
sync-accents()

────────────────────
+ do system-changed

. restyles = sync-accents()
for window in windows
    window.system-changed(restyles)

────────────────────
_ do sync-accents Bool

. read = GUIAccents
    - gui-system-color(GUISystemColor.accent, WindowAppearance.dark)
    - gui-system-color(GUISystemColor.selection, WindowAppearance.dark)
    - gui-system-color(GUISystemColor.unemphasized-selection, WindowAppearance.dark)
    - gui-system-color(GUISystemColor.accent, WindowAppearance.light)
    - gui-system-color(GUISystemColor.selection, WindowAppearance.light)
    - gui-system-color(GUISystemColor.unemphasized-selection, WindowAppearance.light)
=? false if accents == read
accents = read
gui-use-accents(read)
= true

────────────────────
+ do get windows

. window = first-window
while window
    <= window
    window = window.next-window

────────────────────
+ do this += window Window

window.app = this
if !first-window
    first-window = last-window = window
else
    last-window?.next-window = window
    window.previous-window = last-window
    last-window = window

= window

────────────────────
+ do remove-window
    - window Window

. before = window.previous-window
. after = window.next-window
if before
    before.next-window = after
if after
    after.previous-window = before
if first-window as Pointer == window as Pointer
    first-window = after
if last-window as Pointer == window as Pointer
    last-window = before

────────────────────
+ do this += status-item StatusItem

status-item.app = this
status-items += status-item
= status-item

────────────────────
+ markup-make-region GuiNode?

AppRegion(this)

────────────────────
+ do markup-attach-child
    - child GuiNode
    - anchor GuiNode?

match? child
    | window Window
        this += window
    | status-item StatusItem
        this += status-item
=? if !has-run
do new
    open-joined(child)

────────────────────
+ do markup-detach-child
    - child GuiNode

match? child
    | window Window
        remove-window(window)
        window.app = null
    | status-item StatusItem
        status-items -= status-item
        status-item.app = null

────────────────────
_ do open-joined
    - child GuiNode

match? child
    | window Window
        if window.app == this && !window.has-opened
            window.open()
    | status-item StatusItem
        if status-item.app == this
            status-item.open()

────────────────────
+ do run

has-run = true
for window in windows
    window.open()
for status-item in status-items
    status-item.open()
ensure-accents()

C:brixGuiAppRun(native!)
close()
Task().when-finished(end-process)

────────────────────
_ do autorun

=? if has-run || !native
run()

────────────────────
_ do end-process

request-process-termination(0)

────────────────────
+ do quit

is-quitting = true
for window in windows
    if !window.request-close()
        is-quitting = false
        =
stop()

────────────────────
+ do stop

C:brixGuiAppStop(native!)

────────────────────
+ do close

for window in windows
    window.close()
for status-item in status-items
    status-item.close()
super.close()
    catch error Error
        unhandled-error(error)
. store = state
if store
    store.flush()

if native
    C:brixGuiAppRelease(native)
    native = null

━━━━━━━━━━━━━━━━━━━━
_ AppRegion is GuiRegion

+ app App

────────────────────
+ This
    - app

────────────────────
+ markup-make-region GuiNode?

AppRegion(app)

────────────────────
+ do markup-attach-child
    - child GuiNode
    - anchor GuiNode?

app.markup-attach-child(child, anchor)

────────────────────
+ do markup-detach-child
    - child GuiNode

app.markup-detach-child(child)

━━━━━━━━━━━━━━━━━━━━
+ gui-system-appearance WindowAppearance

C:brixGuiSystemAppearance() as WindowAppearance

━━━━━━━━━━━━━━━━━━━━
+ gui-system-color RGBA
    - color GUISystemColor
    - appearance WindowAppearance

rgba8(C:brixGuiSystemColor(color, appearance))

━━━━━━━━━━━━━━━━━━━━
+ GUISystemOptions is Tuple

+ reduces-motion Bool
+ increases-contrast Bool
+ reduces-transparency Bool

━━━━━━━━━━━━━━━━━━━━
+ gui-system-options GUISystemOptions

GUISystemOptions((bits /and/ 1) != 0, (bits /and/ 2) != 0, (bits /and/ 4) != 0)

.. bits = C:brixGuiSystemOptions()

━━━━━━━━━━━━━━━━━━━━
+ GuiAppCallback is (*C) Void
    - app-pointer Pointer

━━━━━━━━━━━━━━━━━━━━
+ GuiAppOpenCallback is (*C) Void
    - app-pointer Pointer
    - paths CPointer'(CPointer'Char8)
    - count I32

━━━━━━━━━━━━━━━━━━━━
_ do gui-app-native-quit
    - app-pointer Pointer

gc-object-from-pointer'App(app-pointer).quit()
    catch error Error
        unhandled-error(error)

━━━━━━━━━━━━━━━━━━━━
_ do gui-app-native-background
    - app-pointer Pointer

. store = gc-object-from-pointer'App(app-pointer).state
if store
    store.flush()

━━━━━━━━━━━━━━━━━━━━
_ do gui-app-native-system
    - app-pointer Pointer

gc-object-from-pointer'App(app-pointer).system-changed()

━━━━━━━━━━━━━━━━━━━━
_ do gui-app-native-open
    - app-pointer Pointer
    - paths CPointer'(CPointer'Char8)
    - count I32

. opened = List'Path()
for index in 0 .. < count
    opened += Path(paths[index], 0)
gc-object-from-pointer'App(app-pointer).open-requested <- opened
