(import ./frame-clock)
(import /core/tracker)
(import /math/motion)
(import /time/duration)
(blank)
(prop _ animated-precision _ (= 0.001))

(type + AnimatedValue
  (implements Tracker)
  (implements FrameAnimation)
  (prop + owner FrameOwner)
  (prop + channel MotionChannel)
  (prop + goal (list F64))
  (blank)
  (prop _ action (? LiveAction))
  (fn-do + This _
    (param owner _)
    (param start (list F64))
    (lazy channel (call MotionChannel start animated-precision))
    (lazy goal (call (of List F64) start))
  )
  (fn-do + follow (list F64)
    (param to (list F64))
    (param motion Motion)
    (return-if (. channel value) (if (call is-same to)))
    (= goal (call (of List F64) to))
    (let clock (. owner frame-clock))
    (if (or (not clock) (is motion InstantMotion))
      (call (?. (. owner frame-clock) cancel) this)
      (call (. channel jump) to)
      (return (. channel value))
    )
    (call (. channel retarget) to motion (. clock now))
    (if (and (. channel is-moving) (not (call (. clock is-animating) this)))
      (call (. clock start) owner this)
    )
    (return (. channel value))
  )
  (fn-expr _ is-same Bool
    (param to (list F64))
    (== to goal)
  )
  (fn-do + advance Bool
    (param tick FrameTick)
    (call (. channel update) (. tick now))
    (if action
      (call action)
    )
    (return (. channel is-moving))
  )
  (fn-do + finish _
    (call (. channel jump) goal)
    (if action
      (call action)
    )
  )
  (fn-do + attach _
    (param action LiveAction)
    (= (. this action) action)
    (return-if (if (not (. channel is-moving))))
    (let clock (. owner frame-clock))
    (if (not clock)
      (call (. channel jump) goal)
      (return)
    )
    (if (not (call (. clock is-animating) this))
      (call (. clock start) owner this)
    )
  )
  (fn-do + detach _
    (param action LiveAction)
    (= (. this action) null)
    (call (?. (. owner frame-clock) cancel) this)
  )
)
