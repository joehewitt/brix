• extend GUIDefaultTheme
    using GUIBoxCursor
    using GUIBoxDisplay
    using GUIBoxMotion
    using GUIBoxPaint
    using GUIBoxSize
    using GUIBoxSpacing
    using GUIFocusRingStyle
    using GUITextPaint
    using GUIBoxTransform

• Switch • text:gui-text-color

    • switch-track • bg:gui-track-color w:30 h:16 p:2
        corner-radius = 10
        motion = gui-motion-quick

    • switch-knob • bg:gui-knob-color w:16 h:16
        corner-radius = 8
        shadow = gui-control-shadow
        motion = gui-motion-quick
        motion.position = gui-motion-quick

    • switch-title • ml:8

    • switch-lead • flex:1
        display = Display.hidden

    when #is-hover-within
        • switch-track
            background-color = gui-hover-color.over(gui-track-color)

    when #is-press-within
        • switch-knob
            scale = 0.9

    when #is-on
        • switch-track • bg:gui-accent-color

        • switch-lead
            display = Display.visible

    when #is-focus-visible
        • switch-track
            focus-ring = gui-focus-ring

