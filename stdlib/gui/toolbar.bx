(import ./box)
(import ./button)
(import ./glass)
(import ./label)
(import ./menu)
(import ./primitives)
(import ./segmented-control)
(import ./shorthands)
(import ./slider)
(import ./styles)
(import ./tab-bar)
(import ./theme)
(import ./window)
(import /core/markup)
(import /graphics/color)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/text)
(import /units)
(blank)
(prop + gui-toolbar-height Length (= 52))
(prop + gui-toolbar-pad Length (= 10))
(prop + gui-toolbar-gap Length (= 8))
(prop + gui-toolbar-item-height Length (= 28))
(prop + gui-toolbar-group-pad Length (= 3))
(prop + gui-toolbar-group-height Length (= (+ gui-toolbar-item-height (* (+ gui-toolbar-group-pad gui-liquid-glass-border) 2))))
(prop + gui-toolbar-icon Length (= 16))
(prop + gui-toolbar-stoplight-offset _
  (=
    (call Point
      (block
        (arg (. window-stoplight-offset x))
        (arg (- (/ gui-toolbar-height 2) window-stoplight-center))
      )
    )
  )
)
(prop + gui-toolbar-tab-pad Length (= 8))
(prop + gui-toolbar-tab-bar-height Length (= (+ (- gui-tab-bar-height (- (/ (- gui-tab-bar-height gui-tab-tray-height) 2) 1)) gui-toolbar-tab-pad)))

(style-extend GUIDefaultTheme
  (using GUIBoxCursor)
  (using GUIBoxLayout)
  (using GUIBoxMotion)
  (using GUIBoxPaint)
  (using GUIBoxPlacement)
  (using GUIBoxSize)
  (using GUIBoxSpacing)
  (using GUIBoxWindowDrag)
  (using GUIFontStyle)
  (using GUITextComposition)
  (using GUITextPaint)
  (rule Toolbar (• flex-col) (• bg gui-glass-panel-color)
    (= backdrop-blur gui-glass-panel-blur)
    (= border-color gui-toolbar-edge-color)
    (= border-bottom-width gui-hairline)
    (= window-draggable true)
    (blank)
    (rule toolbar-items (• flex-row) (• h gui-toolbar-height) (• pr gui-toolbar-pad) (• gap gui-toolbar-gap) (• items-center))
    (blank)
    (rule TabBar (• bg transparent) (• pb gui-toolbar-tab-pad)
      (= border-bottom-width 0)
    )
    (blank)
    (rule TabTray (• liquid-glass)
      (= border-width 0)
    )
  )
  (blank)
  (rule ToolbarSpace (• flex 1))
  (blank)
  (rule ToolbarTitle (• text gui-strong-text-color) (• px 4) (• shrink 1)
    (= font-size gui-title3-font-size)
    (= font-weight (. FontWeight semibold))
    (= align-y (. Alignment center))
  )
  (blank)
  (rule ToolbarGroup (• liquid-glass) (• flex-row) (• h gui-toolbar-item-height) (• p gui-toolbar-group-pad) (• items-center)
    (= corner-radius (/ gui-toolbar-group-height 2))
    (= window-draggable false)
    (blank)
    (rule Slider (• mx 10)
      (= align-y (. Alignment center))
    )
    (blank)
    (rule SegmentedControl (• bg transparent) (• p 0)
      (= corner-radius (/ gui-toolbar-item-height 2))
      (blank)
      (rule Segment (• h gui-toolbar-item-height) (• px 12)
        (= min-height gui-toolbar-item-height)
        (= max-height gui-toolbar-item-height)
        (= corner-radius (/ gui-toolbar-item-height 2))
      )
    )
    (blank)
    (rule MenuButton (• bg transparent) (• text gui-glass-icon-color) (• h gui-toolbar-item-height) (• pl 12) (• pr 10)
      (= corner-radius (/ gui-toolbar-item-height 2))
      (= shadow null)
      (blank)
      (when-style #is-hover-within
        (• bg gui-hover-color)
      )
      (blank)
      (when-style #is-press-within
        (• bg gui-pressed-color)
      )
      (blank)
      (when-style #is-open
        (• bg gui-pressed-color)
      )
      (blank)
      (when-style #is-untitled
        (• px 0)
        (• w gui-toolbar-item-height)
        (blank)
        (rule button-content
          (= align-x (. Alignment center))
        )
        (blank)
        (rule button-title (• flex 0))
      )
    )
  )
  (blank)
  (rule ToolbarButton (• bg transparent) (• text gui-glass-icon-color) (• h gui-toolbar-item-height) (• px 12)
    (= corner-radius (/ gui-toolbar-item-height 2))
    (= shadow null)
    (= motion gui-motion-quick)
    (blank)
    (rule icon (• w gui-toolbar-icon) (• h gui-toolbar-icon) (• mr 6))
    (blank)
    (when-style #is-untitled
      (• px 0)
      (• w gui-toolbar-item-height)
      (blank)
      (rule icon (• mr 0))
    )
    (blank)
    (when-style #is-hover-within
      (• bg gui-hover-color)
    )
    (blank)
    (when-style #is-press-within
      (• bg gui-pressed-color)
    )
    (blank)
    (when-style #is-on
      (• bg gui-pressed-color)
      (• text gui-accent-bright-color)
    )
    (blank)
    (when-style #is-default
      (• bg gui-accent-color)
      (• text gui-accent-text-color)
    )
    (blank)
    (when-style (not #is-effectively-enabled)
      (• bg transparent)
      (= cursor (. CursorStyle arrow))
    )
    (blank)
    (when-style (not #is-enabled)
      (= opacity 0.3%%)
    )
  )
)

(type + Toolbar (is Box)
  (prop + is-title-bar _ (= false))
  (prop + is-beside-stoplights _ (= (and #is-title-bar (not (?? (?. owner-window #is-full-screen) false)))))
  (prop + stoplight-inset _ (= (?? (?. owner-window #stoplight-inset) window-stoplight-inset)))
  (blank)
  (prop _ owner-window (of Ancestor Window))
  (content
    (<> This
      (+<> Box (• toolbar-items)
        (= padding-left (if-expr #is-beside-stoplights #stoplight-inset gui-toolbar-pad))
      )
      (+<> Box (id: accessory))
    )
  )
)

(type + ToolbarSpace (is Box))

(type + ToolbarTitle (is Label)
  (fn-do + This _
    (param text _ (= ""))
  )
)

(type + ToolbarGroup (is Box))

(type + ToolbarButton (is Button)
  (fn-do + This _
    (param title _ (= ""))
  )
)
