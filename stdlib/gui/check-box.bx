(import ./box)
(import ./events)
(import ./icons/lucide/check)
(import ./icons/lucide/minus)
(import ./label)
(import ./primitives)
(import ./shorthands)
(import ./styles)
(import ./theme)
(import ./toggle)
(import /graphics/color)
(import /graphics/primitives)
(import /graphics/style)
(import /graphics/text)
(import /units)

(style-extend GUIDefaultTheme
  (using GUIBoxCursor)
  (using GUIBoxDisplay)
  (using GUIBoxMotion)
  (using GUIBoxPaint)
  (using GUIBoxSize)
  (using GUIBoxSpacing)
  (using GUIFocusRingStyle)
  (using GUITextPaint)
  (using GUIBoxTransform)
  (rule CheckBox (• text gui-text-color)
    (blank)
    (rule check-box-mark (• bg gui-field-color) (• text gui-accent-text-color) (• w 12) (• h 12) (• min-w 12) (• min-h 12) (• p 1)
      (= corner-radius gui-inner-radius)
      (= border-color gui-border-color)
      (= border-width 1)
      (blank)
      (rule icon (• w 12) (• h 12)
        (= stroke-width 3)
      )
      (blank)
      (rule check-box-check
        (= display (. Display hidden))
      )
      (blank)
      (rule check-box-dash
        (= display (. Display hidden))
      )
    )
    (blank)
    (rule check-box-title (• ml 6)
      (= text-wrap (. TextWrap no-wrap))
      (= text-overflow (. TextOverflow truncate-tail))
    )
    (blank)
    (when-style #is-hover-within
      (rule check-box-mark
        (= border-color gui-disabled-text-color)
      )
    )
    (blank)
    (when-style #is-marked
      (rule check-box-mark (• bg gui-accent-color)
        (= border-color gui-accent-color)
      )
    )
    (blank)
    (when-style #is-on
      (rule check-box-check
        (= display (. Display visible))
      )
    )
    (blank)
    (when-style #is-mixed
      (rule check-box-check
        (= display (. Display hidden))
      )
      (blank)
      (rule check-box-dash
        (= display (. Display visible))
      )
    )
    (blank)
    (when-style #is-focus-visible
      (rule check-box-mark
        (= focus-ring gui-focus-ring)
        (= (. motion focus-ring) gui-motion-quick)
      )
    )
  )
)

(type + CheckBox (is Toggle)
  (prop + is-mixed _ (= false))
  (prop + is-marked _ (= (or #is-on #is-mixed)))
  (prop + toggled-value _ (=> (or (not is-on) is-mixed)))
  (fn-do + This _
    (param title _ (= ""))
  )
  (content
    (<> This
      (<> Box (• check-box-mark) (• icon-host) (• flex-row)
        (= align-y (. Alignment center))
        (<> LucideCheck (• icon) (• check-box-check))
        (<> LucideMinus (• icon) (• check-box-dash))
      )
      (if (!= #title "")
        (<> Label (• check-box-title) (• flex 1)
          (= align-y (. Alignment center))
          (= text #title)
        )
      )
    )
  )
  (fn-do + did-toggle _
    (= is-mixed false)
  )
)
