+ measured-content-size
    - query MeasureQuery

|? fits-text
    fitted-content-size()
|? wraps
    wrapped-content-size(query)
|? !native
    Dimensions(120, 22)
??
    native-fitting-size()

────────────────────
_ do native-line-fitting-height Length

. cached = native-fitting-height
=? cached if cached
. height Length = C:yumiGuiTextInputGetFittingHeight(native!) / native-zoom
native-fitting-height = height
= height

────────────────────
_ do native-fitting-size Dimensions

apply-native-font()
. zoom = native-zoom
= Dimensions
    - C:yumiGuiTextInputGetFittingWidth(native!) / zoom
    - C:yumiGuiTextInputGetFittingHeight(native!) / zoom

────────────────────
_ do wrapped-content-size Dimensions
    - query MeasureQuery

. inner = derived-child-measure-query(query).inline
. proposed = inner.available ?? inner.max ?? 120
. width = constrained-axis-size(gui-safe-span(proposed), query.inline, $min-width, $max-width)
. height = measure-wrapped(width)
. lines = if query.block.mode == AxisMeasureMode.min-content then 1 else max-lines
=? Dimensions(width, height) if lines == null
. count = max(lines, 1) as Length
= Dimensions(width, min(height, count * wrapped-line-height + (count - 1) * $line-spacing))

────────────────────
_ do measure-wrapped Length
    - width Length

. font = Font($font-family, $font-size, $font-weight)
. sample = if text.length then text else placeholder
. measured = if sample.ends-with("\n") then "$sample " else sample
. segments = List'TextSegment(TextSegment(0, if measured.length then measured else " ", font))
. layout = use TextLayout(segments, font, width, TextOverflow.clip, TextWrap.word, $line-spacing)
wrapped-ascent = layout.ascent
wrapped-line-height = layout.ascent + layout.descent + layout.leading
wrapped-text-height = layout.height
= layout.height

────────────────────
_ do fitted-content-size Dimensions

. sample = if text.length then text else placeholder
. layout = use TextLayout
    - TextLayoutRequest
        - if sample.length then sample else " "
        - Font($font-family, $font-size, $font-weight)
fitted-ascent = layout.ascent
= Dimensions(ceil(layout.width) + 1, layout.ascent + layout.descent)

────────────────────
_ fitted-editing-slack Length

ceil($font-size * 2)

────────────────────
_ do fitted-inline-ascent Length

measure()
= margin-edges.top + border-edges.top + padding-edges.top + fitted-ascent

