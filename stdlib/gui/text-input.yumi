+ do accept-native-input
    - next-text String
    - start Size? = null
    - end Size? = null

is-native-editing = true
is-dirty = next-text != committed-text
. caret = min(start ?? selection-start, next-text.length)
selection-start = caret
selection-end = min(max(end ?? selection-end, caret), next-text.length)
=? if next-text == text
accepting-native-text = true
text = next-text
accepting-native-text = false
input <- InputEvent(text)
schedule-live-edit()

