=? if abs(native-text-inset - top) < 0.001 && abs(native-text-bottom-inset - bottom) < 0.001
native-text-inset = top
native-text-bottom-inset = bottom
C:yumiGuiTextInputSetTextInsets(native!, top, bottom)

