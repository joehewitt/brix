+ do sync-native-geometry-self
    - native-origin Point
    - visible Bool
    - native-parent Pointer?
    - transform Matrix?

=? if !native
sync-native-font()
sync-native-text-alignment()
. zoom = native-zoom
. content = content-bounds
. left = content.x - native-origin.x
. top = content.y - native-origin.y
C:yumiGuiTextInputSetContainer(native!, native-parent ?? Pointer())
if !wraps
    sync-native-text-insets(0, 0)
if fits-text
    . fitting-height = native-line-fitting-height()
    . width = if is-focused then content.width + fitted-editing-slack() else content.width
    set-native-frame(left, top, width, fitting-height, native-origin, transform)
    . text-x Length = C:yumiGuiTextInputGetTextOriginX(native!) / zoom
    . baseline Length = C:yumiGuiTextInputGetTextBaseline(native!) / zoom
    set-native-frame
        - left - text-x
        - top + fitted-ascent - baseline
        - width + text-x * 2
        - fitting-height
        - native-origin
        - transform
else if wraps
    if !wrapped-line-height
        measure-wrapped(content.width)
    C:yumiGuiTextInputSetLineMetrics(native!, wrapped-line-height * zoom, $line-spacing * zoom)
    . native-width = content.width * zoom
    if native-frame-width != native-width
        set-native-frame(left, top, content.width, content.height, native-origin, transform)
        native-frame-width = native-width
    . text-x Length = C:yumiGuiTextInputGetTextOriginX(native!) / zoom
    . baseline Length = (C:yumiGuiTextInputGetTextBaseline(native!) - native-text-inset) / zoom
    . padding = padding-edges
    . slack = if centers-wrapped-text then max(0, content.height - wrapped-text-height) / 2 else 0
    . inset = gui-device-aligned(scaled-inset, device-scale) / zoom
        .. scaled-inset = max(0, padding.top + slack + wrapped-ascent - baseline) * zoom
    . overflows = wrapped-text-height > content.height + 0.5
    . bottom-inset = if overflows then padding.bottom else 0
    sync-native-text-insets(inset * zoom, bottom-inset * zoom)
    . shift = wrapped-ascent + slack - baseline - inset
    . growth = if overflows then 0 else wrapped-line-height + $line-spacing
    set-native-frame
        - left - text-x
        - top + shift
        - content.width + text-x * 2
        - content.height + padding.bottom - shift + growth
        - native-origin
        - transform
else
    . fitting-height = native-line-fitting-height()
    . line-height = min(content.height, fitting-height)
    set-native-frame
        - left
        - top + (content.height - line-height) / 2
        - content.width
        - line-height
        - native-origin
        - transform
C:yumiGuiTextInputSetVisible(native!, visible)
C:yumiGuiTextInputSetOpacity(native!, effective-opacity)
sync-native-cursor()
sync-native-text-color()
if is-native-shown != visible
    is-native-shown = visible
    . host = window
    if visible && host
        (host as Window).schedule-render()

────────────────────
_ do set-native-frame
    - x Length
    - y Length
    - width Length
    - height Length
    - native-origin Point
    - transform Matrix?

. zoom = native-zoom
. corner = native-placed-point(Point(x, y), native-origin, transform)
. linear = transform ?? Matrix()
C:yumiGuiTextInputSetFrame
    - native!
    - corner.x * zoom
    - corner.y * zoom
    - width * zoom
    - height * zoom
    - linear.a
    - linear.c
    - linear.b
    - linear.d
. box = bounds
C:yumiGuiTextInputSetHitRect
    - native!
    - (box.x - native-origin.x - x) * zoom
    - (box.y - native-origin.y - y) * zoom
    - box.width * zoom
    - box.height * zoom

