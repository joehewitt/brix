+ do accept-native-selection
    - next-text String
    - start Size
    - end Size

=? accept-native-input(next-text, start, end) if next-text != text
. caret = min(start, text.length)
. last = min(max(end, caret), text.length)
=? if caret == selection-start && last == selection-end
selection-start = caret
selection-end = last
text-selected <- TextSelectionEvent(caret, last)

────────────────────
+ do accept-native-commit
    - next-text String

accept-native-input(next-text)
is-native-editing = false
edit-generation += 1
if is-live-editing
    is-live-editing = false
    text-edited <- TextEditEvent(text, ValueChangePhase.ended)
if committed-text == text
    sync-native-text()
    =
. old-text = committed-text
committed-text = text
is-dirty = false
change <- ChangeEvent(old-text, text)
sync-native-text()

────────────────────
_ do schedule-live-edit

. delay = live-edit-delay
=? if !delay
edit-generation += 1
. generation = edit-generation
do new
    delay.wait()
    if generation == edit-generation && is-native-editing
        publish-live-edit()

────────────────────
_ do publish-live-edit

. phase = if is-live-editing then ValueChangePhase.changed else ValueChangePhase.began
is-live-editing = true
text-edited <- TextEditEvent(text, phase)

────────────────────
_ do sync-native-text

if native && !is-native-editing
    C:yumiGuiTextInputSetText(native, text)

