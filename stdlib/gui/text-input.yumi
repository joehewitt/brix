━━━━━━━━━━━━━━━━━━━━
_ text-input-passed-key-bit U32
    - key Key

match key
    |= Key.arrow-up
        1
    |= Key.arrow-down
        2
    |= Key.enter
        4
    |= Key.arrow-left
        8
    |= Key.arrow-right
        16
    |= Key.page-up
        32
    |= Key.page-down
        64
    |= Key.home
        128
    |= Key.end
        256
    ??
        0

━━━━━━━━━━━━━━━━━━━━
+ NativeTextInputEventKind is U32

| input = 0
| commit = 1
| submit = 2
| focus = 3
| blur = 4
| selection = 5
| command-submit = 6
| paste = 7
| copy = 8

━━━━━━━━━━━━━━━━━━━━
+ GuiTextInputEventCallback is (*C) Void
    - input-pointer Pointer
    - event-kind U32
    - text-pointer CPointer'Char8
    - selection-start U32
    - selection-end U32
    - modifier-bits U64

━━━━━━━━━━━━━━━━━━━━
+ do gui-text-input-event
    - input-pointer Pointer
    - event-kind U32
    - text-pointer CPointer'Char8
    - selection-start U32
    - selection-end U32
    - modifier-bits U64

. next-text = text-pointer as String
. input = gc-object-from-pointer'TextInput(input-pointer)
do match? event-kind as NativeTextInputEventKind
    |= NativeTextInputEventKind.selection
        input.accept-native-selection(next-text, selection-start, selection-end)
    |= NativeTextInputEventKind.blur
        input.accept-native-focus(false)
    |= NativeTextInputEventKind.focus
        input.accept-native-focus()
    |= NativeTextInputEventKind.input
        input.accept-native-input(next-text, selection-start as Size, selection-end as Size)
    |= NativeTextInputEventKind.commit
        input.accept-native-commit(next-text)
    |= NativeTextInputEventKind.submit
        input.accept-native-submit(next-text, pointer-modifiers-from-native(modifier-bits))
    |= NativeTextInputEventKind.command-submit
        input.accept-native-submit(next-text, pointer-modifiers-from-native(modifier-bits))
    |= NativeTextInputEventKind.paste
        input.accept-native-paste()
    |= NativeTextInputEventKind.copy
        input.accept-native-copy()
