    - key String

if is-expanded(key)
    collapse-key(key)
else
    expand-key(key)

────────────────────
+ do expand-all
    - max-depth Index = 64

. current-root = root-node
=? if !current-root
. root-children = children-for("", current-root)
=? if root-children == null
expand-descendants(root-children, "", 0, max-depth)
expansion-revision += 1
rebuild-entries()

────────────────────
+ do collapse-all

expanded-keys.clear()
expansion-revision += 1
