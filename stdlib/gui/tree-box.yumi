_ placement-in
    - session DragSession
    - entry TreeBoxEntry'Item
    - gap Index = 0
    - depth Index = 0

TreeBoxPlacement'Item
    - gap
    - depth
    - entry.key
    - TreeBoxDrop'Item(session.payload, entry.item, index, session.modifiers)

.. closed = entry.has-children && !entry.is-expanded
.. index Index? = if closed then null else 0

