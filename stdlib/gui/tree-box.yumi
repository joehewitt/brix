** expanded-keys.keys
?*> items-by-key[each]
|> List

────────────────────
+ do collapse-key
    - key String

=? if !is-expanded(key)
-= expanded-keys[key]
expansion-revision += 1
if selected-key && is-descendant-key(selected-key, key)
    move-cursor(key)
rebuild-entries()

