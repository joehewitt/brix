━━━━━━━━━━━━━━━━━━━━
_ do tree-box-entries-match'Item Bool
    - current [TreeBoxEntry'Item]
    - next [TreeBoxEntry'Item]

=? false if current.length != next.length
. index Index = 0
while index < current.length
    . a = current[index]
    . b = next[index]
    =? false if a.key != b.key || a.depth != b.depth || a.parent-key != b.parent-key
    =? false if a.has-children != b.has-children || a.is-expanded != b.is-expanded
    =? false if !(a.item == b.item)
    index += 1
= true

