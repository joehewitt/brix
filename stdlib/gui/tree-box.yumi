_ TreeBoxStickyRows'Item
    is VirtualStickyRows

+ entries [TreeBoxEntry'Item]

_ parents = List'I64()
_ lasts = List'I64()
_ heads = List'Bool()

────────────────────
+ This
    - entries

. open = List'Index()
for index in 0 .. < entries.length
    . entry = entries[index]
    while open.length > 0 && entries[open[open.length - 1]].depth >= entry.depth
        open.remove(open.length - 1)
    parents += if open.length > 0 then open[open.length - 1] as I64 else -1
    lasts += index
    heads += entry.has-children && entry.is-expanded
    for ancestor in open
        lasts[ancestor] = index
    open += index

────────────────────
+ do sticky-headers
    - address I64
    - headers List'I64

=? if address < 0 || address >= (parents.length as I64)
. start = headers.length
if heads[address]
    headers += address
. parent = parents[address]
while parent >= 0
    headers.insert(parent, start)
    parent = parents[parent]

────────────────────
+ sticky-section-last
    - header I64

|? header < 0 || header >= (lasts.length as I64)
    header
??
    lasts[header]

