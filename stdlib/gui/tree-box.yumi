    - held

────────────────────
+ get revision VirtualRevision?

inner.revision

────────────────────
+ do fill-window
    - window VirtualWindow
    - domain VirtualSequenceDomain

inner.fill-window(window, domain)
for address in held
    . index = domain.index-of(address)
    . rect = inner.rect-for-address(address, domain, window)
    if index != null && rect
        . position Index = 0
        while position < window.placement-count && window.placements[position].placement-id < index
            position += 1
        if position == window.placement-count || window.placements[position].placement-id != index
            window.insert-placement
                - position
                - index
                - address
                - rect.x
                - rect.y
                - rect.width
                - rect.height

