────────────────────
+ do reveal-key-path Bool
    - keys [String]
    - alignment = ScrollAlignment.nearest

=? false if !keys
reveal-alignment = alignment

. last-ancestor = keys.length - 1
. index Index = 0
while index < last-ancestor
    if !is-expanded(keys[index])
        expanded-keys[keys[index]] = true
        expansion-revision += 1
    index += 1

rebuild-entries()
. target-key = keys[last-ancestor]
=? false if entry-index-for-key(target-key) == null

move-cursor(target-key)
= true

────────────────────
+ do rebuild-entries

rebuild-entries-from(selected-key)

────────────────────
_ do rebuild-entries-from
    - selection String?

. next [TreeBoxEntry'Item] = List'(TreeBoxEntry'Item)()
. current-root = root-node
if current-root
    . root-children = children-for("", current-root)
    if root-children != null
        append-visible-entries(next, root-children, "", 0, null)

walked = next
arrange-display()
. restored = restored-selection(selection)
if restored != selected-key
    move-cursor(restored)
refresh-row-selection()

────────────────────
+ do refresh-row-selection

=? if !is-live
for index in 0 .. < rows.pool-size
    . row = pool-row(index)
    if row
        sync-row-selection(row)

────────────────────
+ do sync-row-selection
    - row TreeBoxItem'Item

. entry = row.entry
. selected = false
. targeted = false
. stowed = false
if entry
    selected = is-key-selected(entry.key)
    targeted = entry.key == drop-key
    stowed = dragged-keys has entry.key && !(carried-keys has entry.key)
if row.is-selected != selected
    row.is-selected = selected
if row.is-drop-target != targeted
    row.is-drop-target = targeted
if row.is-dragged != stowed
    row.is-dragged = stowed

────────────────────
+ do row-for-key TreeBoxItem'Item?
    - key String?

=? if !key || !is-live
. live-key = key
for index in 0 .. < rows.pool-size
    . row = pool-row(index)
    =? row if row && row.entry?.key == live-key
= null

────────────────────
+ entry-for-key TreeBoxEntry'Item?
    - key String?

entries[index] if index != null

.. index = entry-index-for-key(key)

────────────────────
+ entry-index-for-key Index?
    - key String?

|? index == null || index >= entries.length || entries[index].key != key
    null
??
    index

.. index = entry-indexes[key] if key

────────────────────
_ pool-row
    - index Index

match? child
    | row TreeBoxItem'Item
        row

.. root = rows.root-at(index)
.. child = root.%first-child if root && root.slot.is-bound

────────────────────
_ do arrange-display

. still [TreeBoxEntry'Item] = List'(TreeBoxEntry'Item)()
. moving [TreeBoxEntry'Item] = List'(TreeBoxEntry'Item)()
for entry in walked
    if dragged-keys has entry.key
        moving += entry
    else
        still += entry
resting = still
. shown = walked
. gap = drop-gap
if is-carrying && is-ordered && gap != null
    shown = List'(TreeBoxEntry'Item)()
    for index in 0 .. < still.length
        if index == gap
            for entry in moving
                shown += entry
        shown += still[index]
    if gap >= still.length
        for entry in moving
            shown += entry
if !tree-box-entries-match'Item(entries, shown)
    publish-entries(shown)
sync-held-rows()

────────────────────
_ do sync-held-rows

. held = List'I64()
if is-carrying
    for index in 0 .. < entries.length
        if carried-keys has entries[index].key
            held += index
if held != held-rows
    held-rows = held

────────────────────
_ do resting-index Index
    - row Index

. index Index = 0
. count = min(row, entries.length)
for cursor in 0 .. < count
    if !(dragged-keys has entries[cursor].key)
        index += 1
= index

────────────────────
_ do publish-entries
    - next [TreeBoxEntry'Item]

entry-indexes.clear()
for index in 0 .. < next.length
    entry-indexes[next[index].key] = index
entries = next
is-empty = next.length == 0
sticky-rows = TreeBoxStickyRows'Item(next) if has-sticky-parents
entry-source.replace(next)

────────────────────
_ do move-cursor
    - key String?

request-reveal()
=? if key == selected-key
selected-key = key
refresh-row-selection()

────────────────────
_ do request-reveal

reveal-pending = true
if is-live
    rows.reveal-address(=> take-reveal(), reveal-alignment)

────────────────────
_ do take-reveal I64?

=? null if !reveal-pending
reveal-pending = false
reveal-alignment = ScrollAlignment.nearest
. index = selected-index
= index as I64 if index != null

────────────────────
_ restored-selection String?
    - key String?

|? !entries || !key
    null
|? entry-index-for-key(key) != null
    key
??
    visible-ancestor-key(key)

────────────────────
_ do visible-ancestor-key
    - key String

. candidate = parent-key-of(key)
while candidate
    =? candidate if entry-index-for-key(candidate) != null
    candidate = parent-key-of(candidate)

────────────────────
_ parent-key-of
    - key String

parent-keys[key]

────────────────────
_ do is-descendant-key Bool
    - key String
    - ancestor String

. current = parent-key-of(key)
while current
    =? true if current == ancestor
    current = parent-key-of(current)
= false

────────────────────
_ first-child-key-of String?
    - key String

|? index == null || index + 1 >= entries.length
    null
??
    match? entries[index + 1]
        |? it.parent-key == key
            it.key

.. index = entry-index-for-key(key)

────────────────────
_ do append-visible-entries
    - target [TreeBoxEntry'Item]
    - items [Item]
    - key-prefix String
    - depth Index
    - parent-key String?

. index Index = 0
for item in items
    . key = key-for-item(item, key-prefix, index)
    items-by-key[key] = item
    if parent-key
        parent-keys[key] = parent-key
    . has-children = item-has-children-at(key, item)
    if has-children && !(seen-keys has key)
        seen-keys[key] = true
        . auto = auto-expand
        if auto && auto(item)
            expanded-keys[key] = true
    . expanded = has-children && is-expanded(key) && !(dragged-keys has key)
    target += TreeBoxEntry'Item(item, key, depth, parent-key, has-children, expanded)
    if expanded
        . child-items = children-for(key, item)
        if child-items != null
            append-visible-entries(target, child-items, key, depth + 1, key)
    index += 1

────────────────────
_ do expand-descendants
    - items [Item]
    - key-prefix String
    - depth Index
    - max-depth Index

=? if depth >= max-depth
. index Index = 0
for item in items
    . key = key-for-item(item, key-prefix, index)
    if item-has-children-at(key, item)
        expanded-keys[key] = true
        items-by-key[key] = item
        . child-items = children-for(key, item)
        if child-items != null
            expand-descendants(child-items, key, depth + 1, max-depth)
    index += 1

────────────────────
_ item-has-children-at Bool
    - key String
    - item Item

|? predicate
    predicate(item)
??
    children != null && children.length > 0

.. predicate = item-has-children
.. children = children-for(key, item)

────────────────────
_ key-for-item
    - item Item
    - key-prefix String
    - index Index

|? builder
    builder(item)
|? key-prefix
    "$key-prefix/$index"
??
    "$index"

.. builder = key-builder

────────────────────
_ do begin-row-drag
    - event DragStartEvent

. row = row-at(event)
. entry = entry-for-key(key-of-row(row))
. allows = can-drag
=? if !entry || !allows || !allows(entry.item)
. provider = drag-items
. offered = if provider then provider(entry.item) else dragged-selection(entry)
. items [Item]
for item in offered
    if allows(item)
        items += item
=? if !items.length
. locate = item-path
. paths [Path]
if locate
    for item in items
        . path = locate(item)
        if path
            paths += path
. stack = List'Box()
for listed in entries
    if items has listed.item
        dragged-keys[listed.key] = true
        if listed.key != entry.key
            . other = row-for-key(listed.key)?.material-parent
            if other
                stack += other
                carried-keys[listed.key] = true
carried-keys[entry.key] = true
is-carrying = true
event.carry(TreeBoxDrag'Item(this, items, paths), row?.material-parent ?? row, stack)
held-key = selected-key
rebuild-entries()
reveal-pending = false
reveal-alignment = ScrollAlignment.nearest

────────────────────
_ dragged-selection [Item]
    - entry TreeBoxEntry'Item

if !is-key-selected(entry.key) then [entry.item] else selected-items

────────────────────
_ do show-placement
    - next TreeBoxPlacement'Item?

placement = next?.drop
. gap Index? = next?.gap
if gap != drop-gap
    drop-gap = gap
    if is-carrying
        arrange-display()
. depth = next?.depth ?? 0
if depth != drop-depth
    drop-depth = depth
if rows.scroll-y != drop-scroll
    drop-scroll = rows.scroll-y
. on-root = tree-box-lands-on-root'Item(next)
if on-root != is-drop-root
    is-drop-root = on-root
. key = next?.key
if key != drop-key
    drop-key = key
    refresh-row-selection()

────────────────────
_ do placement-at
    - session DragSession
    - point Point

=? null if !root-node || !takes(session.payload)
. local = rows.point-in-box(point)
. height = rows.row-extent
. reach = max(0, local.y + rows.scroll-y)
=? folder-placement(session, floor(reach / height) as Index) if !is-ordered
. held = drop-gap
if is-carrying
    . slot = floor(reach / height) as Index
    if slot < entries.length && dragged-keys has entries[slot].key
        =? gap-placement(session, held, local.x) if held != null
        = gap-placement(session, resting-index(slot), local.x)
    . above = resting-index(slot)
    . landing = if slot < entries.length && past-middle then above + 1 else above
        .. past-middle = reach / height - (slot as Length) >= 0.5
    = gap-placement(session, landing, local.x)
if held != null
    . edge = (held as Length) * height
    =? gap-placement(session, held, local.x) if reach >= edge && reach < edge + height
    if reach >= edge + height
        reach -= height
. row = floor(reach / height) as Index
. gap =
    |? row >= resting.length
        resting.length
    |? reach / height - (row as Length) < 0.5
        row
    ??
        row + 1
= gap-placement(session, gap, local.x)

────────────────────
_ folder-placement
    - session DragSession
    - row Index

|? entry && is-carried-key(entry.key)
    null
|? entry && !entry.has-children && allows-drop(inside.drop)
    inside
|? allows-drop(landing.drop)
    landing
??
    null

.. entry = entries[row] if row < entries.length
.. inside = placement-into(session, entry)
.. folder = if entry && !entry.has-children then entry-for-key(entry.parent-key) else entry
.. landing = placement-into(session, folder)

────────────────────
_ do is-carried-key Bool
    - key String

. cursor String? = key
while cursor
    =? true if dragged-keys has cursor
    cursor = parent-keys[cursor]
= false

────────────────────
_ placement-into
    - session DragSession
    - folder TreeBoxEntry'Item?

TreeBoxPlacement'Item
    - null
    - 0
    - key
    - TreeBoxDrop'Item(session.payload, parent, null, session.modifiers)

.. parent = if folder then folder.item else root-node!
.. key = folder.key if folder

────────────────────
_ takes
    - payload DragPayload

if payload is TreeBoxDrag'Item then can-drop != null else payload-operation != null

────────────────────
_ allows-drop
    - drop TreeBoxDrop'Item

operation-for(drop) != DropOperation.none

────────────────────
_ operation-for DropOperation
    - drop TreeBoxDrop'Item

|? is-own && checks
    if checks(drop) then DropOperation.move else DropOperation.none
|? !is-own && weighs
    weighs(drop)
??
    DropOperation.none

.. is-own = drop.payload is TreeBoxDrag'Item
.. checks = can-drop
.. weighs = payload-operation

────────────────────
_ do gap-placement
    - session DragSession
    - gap Index
    - x Length

. lowest = if gap < resting.length then resting[gap].depth else 0
. highest Index = 0
if gap > 0
    . above = resting[gap - 1]
    highest = above.depth
    if (above.has-children && above.is-expanded) || allows-drop(placement-in(session, above).drop)
        highest = above.depth + 1
highest = max(highest, lowest)
. pulled = round((x - tree-box-row-inset - chevron-width) / tree-box-indent-width)
. wanted = min(highest, max(lowest, max(0, pulled) as Index))
. direct = placement-under(session, gap, wanted)
=? direct if allows-drop(direct.drop)
. depth = highest
while true
    if depth != wanted
        . other = placement-under(session, gap, depth)
        =? other if allows-drop(other.drop)
    =? null if depth == lowest
    depth -= 1

────────────────────
_ do placement-under
    - session DragSession
    - gap Index
    - depth Index

. index Index = 0
. cursor = gap
while cursor > 0
    cursor -= 1
    . entry = resting[cursor]
    if entry.depth < depth
        =? placement-in(session, entry, gap, depth) if entry.has-children && !entry.is-expanded
        = TreeBoxPlacement'Item
            - gap
            - depth
            - entry.key
            - TreeBoxDrop'Item(session.payload, entry.item, index, session.modifiers)
    if entry.depth == depth
        index += 1
= TreeBoxPlacement'Item
    - gap
    - depth
    - null
    - TreeBoxDrop'Item(session.payload, root-node!, index, session.modifiers)

