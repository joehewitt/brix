(import ./box)
(import ./choice-control)
(import ./events)
(import ./keys)
(import ./label)
(import ./menu)
(import ./placement)
(import ./popup)
(import ./primitives)
(import ./shorthands)
(import ./styles)
(import ./text-input)
(import ./theme)
(import /graphics/color)
(import /graphics/outline)
(import /graphics/primitives)
(import /graphics/style)
(import /graphics/text)
(import /ui/input)
(import /ui/type-select)

(style-extend GUIDefaultTheme
  (using GUIBoxPaint)
  (using GUITextPaint)
  (using GUIFontStyle)
  (using GUIBoxSpacing)
  (using GUIBoxSize)
  (using GUIPopupStyle)
  (rule Select
    (when-style #shows-placeholder
      (• text gui-muted-text-color)
    )
  )
)

(type + (of SelectTitle T) (is (fn-type String (param option T))))

(type + (of Select T) (is MenuButton)
  (prop + options (list T) (= (call (of List T))))
  (prop + selected (? T))
  (prop + option-title (? (of SelectTitle T)))
  (prop + placeholder _ (= ""))
  (prop + shows-placeholder _ (= (== #selected null)))
  (event + selection-changing (of SelectionEvent T))
  (event + selection-changed (of SelectionEvent T))
  (blank)
  (prop _ type-select _ (= (call TypeSelect)))
  (content
    (<> This
      (= title (if-expr #shows-placeholder #placeholder (call (of select-title T) #selected #option-title)))
      (<> SelectMenu
        (= focus-index (call option-index #options #selected))
        (for (in option #options)
          (<> MenuItem
            (= title (call (of select-title T) option #option-title))
            (= is-on (== #selected option))
            (= action (=> () :do (call choose option)))
          )
        )
      )
      (<> KeyShortcut (text: "Open options")
        (= key .arrow-up)
        (= discoverable false)
        (= action (=> () :do (call open-menu)))
      )
    )
  )
  (subscribe-for (on event key-press)
    (call type-select-key event)
  )
  (fn-do + choose _
    (param value T)
    (let old selected)
    (return-if (if (== old value)))
    (blank)
    (let change (call (of SelectionEvent T) old value))
    (<- selection-changing change)
    (return-if (if (. change is-canceled)))
    (blank)
    (= selected value)
    (<- selection-changed (call (of SelectionEvent T) old value))
  )
  (fn-do _ type-select-key _
    (param event KeyPressEvent)
    (return-if (if (not is-effectively-enabled)))
    (blank)
    (let text (. event typed-text))
    (return-if (if (or (not text) (and (== text " ") (not (. type-select is-active))))))
    (blank)
    (let titles (call (of List String)))
    (for (in option options)
      (+= titles (call (of select-title T) option option-title))
    )
    (let current (only-if (call option-index options selected) (if (!= selected null))))
    (let found (call (. type-select find) text titles current))
    (if (!= found null)
      (call choose ([] options found))
    )
    (call (. event cancel))
  )
  (fn-do + option-index Size
    (param choices (list T))
    (param option (? T))
    (for (in index (..< 0 (. choices length)))
      (return-if index (if (== option ([] choices index))))
    )
    (return 0)
  )
)

(fn-expr + (of select-title T) String
  (param option (? T))
  (param formatter (? (of SelectTitle T)))
  (case? (== option null)
    ""
  )
  (case? (!= formatter null)
    (call formatter option)
  )
  (default
    (str option)
  )
)

(type + SelectMenu (is Menu)
  (prop + focus-index Size (= 0))
  (blank)
  (rule This (• cover-anchor))
  (fn-expr + placement-focus _ :get
    (call select-focus-rect this focus-index)
  )
)

(fn-do + select-focus-rect _
  (param menu Menu)
  (param index Size)
  (let padding (. menu padding-edges))
  (let border (. menu border-edges))
  (let y (+ (. border top) (. padding top)))
  (let candidates (. menu items))
  (for (in position (..< 0 (. candidates length)))
    (let height (. (call (. ([] candidates position) measure)) outer-size height))
    (if (== position index)
      (return (call Rect (+ (. border left) (. padding left) 12) y 0 height))
    )
    (+= y height)
  )
  (return (call Rect (+ (. border left) (. padding left) 12) (+ (. border top) (. padding top)) 0 24))
)
