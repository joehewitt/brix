(import ./box)
(import ./events)
(import ./frame-clock)
(import /graphics/point)
(import /math)
(import /math/motion)
(import /time/duration)
(blank)
(prop _ pinch-reach _ (= 0.7))
(prop _ pinch-rubber _ (= 0.55))
(prop _ pinch-stiffness _ (= 22.0))
(prop _ pinch-rest _ (= 0.001))
(prop _ pinch-motion _ (= (call spring (as (/ (* 2 (as π F64)) pinch-stiffness) Seconds))))

(type + PinchChange (is Tuple)
  (prop + scale F64)
  (prop + anchor Point)
)

(type + PinchTracker
  (implements FrameAnimation)
  (prop + box Box)
  (prop + low _ (= 1.0))
  (prop + high _ (= 1.0))
  (prop + scale _ (= 1.0))
  (prop + anchor _ (= (call Point 0 0)))
  (prop + is-tracking _ (= false))
  (prop + is-settling _ (= false))
  (event + moved PinchChange)
  (event + ended PinchChange)
  (blank)
  (prop _ raw _ (= 1.0))
  (prop _ target _ (= 1.0))
  (prop _ settling _ (= (call MotionChannel (list 0.0) pinch-rest)))
  (fn-do + This _
    (param box _)
  )
  (fn-expr + is-active Bool :get
    (or is-tracking is-settling)
  )
  (fn-do + handle Bool
    (param event MagnifyEvent)
    (param current F64)
    (let phase (. event phase))
    (if (== phase (. ScrollPhase none))
      (= is-settling false)
      (= is-tracking false)
      (= scale (call clamp (* current (. event scale)) low high))
      (= anchor (. event point))
      (<- moved (call PinchChange scale anchor))
      (<- ended (call PinchChange scale anchor))
      (return true)
    )
    (if (== phase (. ScrollPhase began))
      (= is-settling false)
      (= is-tracking true)
      (= raw (call unshape current))
      (= anchor (. event point))
    )
    (return-if false (if (not is-tracking)))
    (blank)
    (if (or (== phase (. ScrollPhase ended)) (== phase (. ScrollPhase cancelled)))
      (call release)
      (return true)
    )
    (= raw (* raw (. event scale)))
    (= scale (call shape raw))
    (= anchor (. event point))
    (<- moved (call PinchChange scale anchor))
    (return true)
  )
  (fn-do + reset _
    (= is-tracking false)
    (= is-settling false)
  )
  (fn-do _ release _
    (= is-tracking false)
    (= target (call clamp scale low high))
    (if (or (== target scale) (<= target 0))
      (<- ended (call PinchChange scale anchor))
      (return)
    )
    (call (. settling jump) (list (call log (/ scale target))))
    (call (. settling retarget) (list 0.0) pinch-motion (?? (?. (. box frame-clock) now) 0ns))
    (= is-settling true)
    (call (. box animate) this)
  )
  (fn-expr _ shape F64
    (param value F64)
    (case? (and (< value low) (> low 0))
      (* low (call exp (- (call pinch-band (call log (/ low value))))))
    )
    (case? (and (> value high) (> high 0))
      (* high (call exp (call pinch-band (call log (/ value high)))))
    )
    (default
      value
    )
  )
  (fn-expr _ unshape F64
    (param value F64)
    (case? (and (< value low) (> low 0))
      (* low (call exp (- (call pinch-unband (call log (/ low value))))))
    )
    (case? (and (> value high) (> high 0))
      (* high (call exp (call pinch-unband (call log (/ value high)))))
    )
    (default
      value
    )
  )
  (fn-do + advance Bool
    (param tick FrameTick)
    (return-if false (if (not is-settling)))
    (blank)
    (call (. settling update) (. tick now))
    (if (not (. settling is-moving))
      (call finish)
      (return false)
    )
    (= scale (* target (call exp ([] (. settling value) 0))))
    (<- moved (call PinchChange scale anchor))
    (return true)
  )
  (fn-do + finish _
    (return-if (if (not is-settling)))
    (blank)
    (= is-settling false)
    (= scale target)
    (<- ended (call PinchChange scale anchor))
  )
)

(fn-expr _ pinch-band F64
  (param distance F64)
  (* (- 1 (/ 1 (+ (/ (* distance pinch-rubber) pinch-reach) 1))) pinch-reach)
)

(fn-expr _ pinch-unband F64
  (param stretch F64)
  (/ (* pinch-reach (- (/ 1 (- 1 (/ (call min stretch (* pinch-reach 0.99)) pinch-reach))) 1)) pinch-rubber)
)
