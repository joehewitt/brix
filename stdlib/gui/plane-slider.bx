(import ./box)
(import ./events)
(import ./keys)
(import ./painter)
(import ./position)
(import ./primitives)
(import ./shorthands)
(import ./styles)
(import ./theme)
(import /core/function)
(import /core/intrinsics)
(import /core/markup)
(import /graphics/point)
(import /graphics/primitives)
(import /math)
(import /ui/input)
(import /ui/key-combo)
(import /ui/value-change-phase)
(import /units)
(blank)
(prop + plane-slider-thumb-size Length (= 16))
(prop + plane-slider-ring-width Length (= 3))
(prop _ plane-slider-thumb-radius Length (= (+ (/ plane-slider-thumb-size 2) plane-slider-ring-width)))

(style-extend GUIDefaultTheme
  (using GUIBoxMotion)
  (using GUIBoxPaint)
  (using GUIFocusRingStyle)
  (using GUIBoxSize)
  (rule PlaneSlider (• bg gui-well-color)
    (= corner-radius gui-control-radius)
    (blank)
    (when-style #is-focus-visible
      (= focus-ring gui-focus-ring)
      (= (. motion focus-ring) gui-motion-quick)
    )
  )
  (blank)
  (rule PlaneSliderThumb (• w plane-slider-thumb-size) (• h plane-slider-thumb-size)
    (= border-color gui-accent-text-color)
    (= border-width plane-slider-ring-width)
    (= corner-radius 1000)
  )
  (blank)
  (rule PlaneSliderThumbEdge
    (= border-color gui-scrim-color)
    (= border-width 1)
    (= corner-radius 1000)
  )
)

(type + PlaneSlider (is Box)
  (rule This
    (= focus-mode (. FocusMode keys))
    (= window-draggable false)
  )
  (blank)
  (prop + value _ (= (call Point 0 0)))
  (prop + minimum _ (= (call Point 0 0)))
  (prop + maximum _ (= (call Point 1 1)))
  (prop + step _ (= (call Point 0 0)))
  (prop + plane-painter (? Painter))
  (blank)
  (event + value-changing (of ValueChange Point))
  (event + value-changed (of ValueChange Point))
  (blank)
  (prop _ thumb-area PlaneSliderThumbArea)
  (prop _ thumb PlaneSliderThumb)
  (prop _ drag-offset _ (= (call Point 0 0)))
  (prop _ render-x Ratio)
  (prop _ render-y Ratio)
  (event _ inoperable Bool)
  (event _ unmounting Bool)
  (blank)
  (depends plane-state-changed value minimum maximum is-effectively-enabled)
  (content
    (<> This
      (= background #plane-painter)
      (<> PlaneSliderThumbArea (id: thumb-area) (• absolute)
        (= anchor (. Anchor parent))
        (= left (call (. PositionOffset coord) (- plane-slider-thumb-radius)))
        (= top (call (. PositionOffset coord) (- plane-slider-thumb-radius)))
        (= right (call (. PositionOffset coord) (- plane-slider-thumb-radius)))
        (= bottom (call (. PositionOffset coord) (- plane-slider-thumb-radius)))
        (<> PlaneSliderThumb (id: thumb) (• absolute) (• flex-row)
          (= anchor (. Anchor parent))
          (= left (call (. PositionOffset percent) #render-x))
          (= top (call (. PositionOffset percent) #render-y))
          (<> PlaneSliderThumbEdge (• flex 1))
        )
      )
      (blank)
      (<> KeyShortcut (text: "Right")
        (= key .arrow-right)
        (= discoverable false)
        (= action (=> () :do (call step-values 1 0)))
      )
      (blank)
      (<> KeyShortcut (text: "Left")
        (= key .arrow-left)
        (= discoverable false)
        (= action (=> () :do (call step-values -1 0)))
      )
      (blank)
      (<> KeyShortcut (text: "Down")
        (= key .arrow-down)
        (= discoverable false)
        (= action (=> () :do (call step-values 0 1)))
      )
      (blank)
      (<> KeyShortcut (text: "Up")
        (= key .arrow-up)
        (= discoverable false)
        (= action (=> () :do (call step-values 0 -1)))
      )
      (blank)
      (<> KeyShortcut (text: "Page Right")
        (= key (+ (. KeyModifier shift) (. Key arrow-right)))
        (= discoverable false)
        (= action (=> () :do (call step-values 10 0)))
      )
      (blank)
      (<> KeyShortcut (text: "Page Left")
        (= key (+ (. KeyModifier shift) (. Key arrow-left)))
        (= discoverable false)
        (= action (=> () :do (call step-values -10 0)))
      )
      (blank)
      (<> KeyShortcut (text: "Page Down")
        (= key (+ (. KeyModifier shift) (. Key arrow-down)))
        (= discoverable false)
        (= action (=> () :do (call step-values 0 10)))
      )
      (blank)
      (<> KeyShortcut (text: "Page Up")
        (= key (+ (. KeyModifier shift) (. Key arrow-up)))
        (= discoverable false)
        (= action (=> () :do (call step-values 0 -10)))
      )
      (blank)
      (<> KeyShortcut (text: "Minimum")
        (= key .home)
        (= discoverable false)
        (= action (=> () :do (call accept-user-value minimum)))
      )
      (blank)
      (<> KeyShortcut (text: "Maximum")
        (= key .end)
        (= discoverable false)
        (= action (=> () :do (call accept-user-value maximum)))
      )
    )
  )
  (prop _ gesture _
    (machine
      (state idle)
      (blank)
      (state dragging (trigger for press pointer-down (and (== (. press button) (. PointerButton primary)) is-effectively-enabled (not (is gesture .dragging))))
        (if (call event-target-is-thumb press)
          (= drag-offset (- thumb-center (. press point)))
          (call accept-user-value effective-value (. ValueChangePhase began))
          (else
            (= drag-offset (call Point 0 0))
            (call accept-pointer-point (. press point) (. ValueChangePhase began))
          )
        )
        (blank)
        (for (on drag pointer-drag (when (and (== (. drag pointer-id) (. press pointer-id)) (== (. drag button) (. PointerButton primary)))))
          (call accept-pointer-point (. drag point) (. ValueChangePhase changed))
          (call (. drag cancel))
        )
        (blank)
        (then idle (trigger for up pointer-up (and (== (. up pointer-id) (. press pointer-id)) (== (. up button) (. PointerButton primary))))
          (call accept-pointer-point (. up point) (. ValueChangePhase ended))
          (call (. up cancel))
        )
        (blank)
        (then (call awaiting-release (. press pointer-id)) (trigger on blur))
        (then (call awaiting-release (. press pointer-id)) (trigger on inoperable))
        (then idle (trigger on unmounting)
          (call publish-drag-ended)
        )
      )
      (blank)
      (state (call awaiting-release pointer-id)
        (call publish-drag-ended)
        (blank)
        (for (on drag pointer-drag (when (and (== (. drag pointer-id) pointer-id) (== (. drag button) (. PointerButton primary)))))
          (call (. drag cancel))
        )
        (blank)
        (then idle (trigger for up pointer-up (and (== (. up pointer-id) pointer-id) (== (. up button) (. PointerButton primary))))
          (call (. up cancel))
        )
        (blank)
        (then idle (trigger on unmounting))
      )
    )
  )
  (subscribe-for (on press pointer-down (when (or (!= (. press button) (. PointerButton primary)) (not is-effectively-enabled) (is gesture .dragging))))
    (call (. press cancel))
  )
  (fn-do + mounted _
    (call (. super mounted))
    (call plane-state-changed)
  )
  (fn-do + unmounted _
    (<- unmounting true)
    (call (. super unmounted))
  )
  (fn-expr + measured-content-size _
    (param query MeasureQuery)
    (call Dimensions 200 150)
  )
  (fn-do _ plane-state-changed _
    (let ratio (call value-ratio effective-value))
    (= render-x (as (. ratio x) Ratio))
    (= render-y (as (. ratio y) Ratio))
    (if (not is-effectively-enabled)
      (<- inoperable true)
    )
  )
  (fn-do + accept-user-value _
    (param candidate Point)
    (param phase ValueChangePhase (= (. ValueChangePhase discrete)))
    (return-if (if (not is-effectively-enabled)))
    (let old effective-value)
    (let next (call normalized-value candidate))
    (return-if (if (and (== next old) (or (== phase (. ValueChangePhase discrete)) (== phase (. ValueChangePhase changed))))))
    (if (!= next old)
      (let change (call (of ValueChange Point) old next phase))
      (<- value-changing change)
      (return-if (if (. change is-canceled)))
    )
    (= value next)
    (<- value-changed (call (of ValueChange Point) old next phase))
  )
  (fn-do _ step-values _
    (param x-steps F64)
    (param y-steps F64)
    (let current effective-value)
    (let increment small-increment)
    (call accept-user-value (call Point (+ (. current x) (* x-steps (. increment x))) (+ (. current y) (* y-steps (. increment y)))))
  )
  (fn-do _ accept-pointer-point _
    (param point Point)
    (param phase ValueChangePhase)
    (let plane plane-rect)
    (let target (+ point drag-offset))
    (let current (call value-ratio effective-value))
    (let x-ratio (if-expr (> (. plane width) 0) (/ (- (. target x) (. plane x)) (. plane width)) (. current x)))
    (let y-ratio (if-expr (> (. plane height) 0) (/ (- (. target y) (. plane y)) (. plane height)) (. current y)))
    (call accept-user-value (call value-at-ratio (call Point x-ratio y-ratio)) phase)
  )
  (fn-expr _ effective-value Point :get
    (call Point (call clamped-axis (. value x) (. minimum x) (. maximum x)) (call clamped-axis (. value y) (. minimum y) (. maximum y)))
  )
  (fn-expr _ normalized-value Point
    (param candidate Point)
    (call Point
      (block
        (arg (call snapped-axis (. candidate x) (. minimum x) (. maximum x) (. step x)))
        (arg (call snapped-axis (. candidate y) (. minimum y) (. maximum y) (. step y)))
      )
    )
  )
  (fn-expr _ value-ratio Point
    (param point Point)
    (call Point (call axis-ratio (. point x) (. minimum x) (. maximum x)) (call axis-ratio (. point y) (. minimum y) (. maximum y)))
  )
  (fn-expr _ value-at-ratio Point
    (param ratio Point)
    (call Point (+ (. minimum x) (* (. ratio x) (- (. maximum x) (. minimum x)))) (+ (. minimum y) (* (. ratio y) (- (. maximum y) (. minimum y)))))
  )
  (fn-expr _ small-increment Point :get
    (call Point (call axis-increment (. minimum x) (. maximum x) (. step x)) (call axis-increment (. minimum y) (. maximum y) (. step y)))
  )
  (fn-expr _ plane-rect _ :get
    (call Rect
      (block
        (arg (- (. content-bounds x) (. bounds x)))
        (arg (- (. content-bounds y) (. bounds y)))
        (arg (. content-bounds width))
        (arg (. content-bounds height))
      )
    )
  )
  (fn-expr _ thumb-center _ :get
    (- (. thumb bounds center) (call Point (. bounds x) (. bounds y)))
  )
  (fn-expr _ event-target-is-thumb _
    (param event GUIEvent)
    (case? (not hit-thumb)
      false
    )
    (default
      (== (as owner (? Pointer)) (as this (? Pointer)))
    )
    (where
      (lazy hit-thumb (of (?. (. event hit-box) ancestor-or-self) PlaneSliderThumb))
      (lazy owner (of (. hit-thumb ancestor) PlaneSlider))
    )
  )
  (fn-do _ publish-drag-ended _
    (let current effective-value)
    (<- value-changed (call (of ValueChange Point) current current (. ValueChangePhase ended)))
  )
)

(type _ PlaneSliderThumbArea (is Box))

(type + PlaneSliderThumb (is Box))

(type + PlaneSliderThumbEdge (is Box))

(fn-expr _ clamped-axis F64
  (param value F64)
  (param minimum F64)
  (param maximum F64)
  (case? (or (not (call is-finite value)) (<= value minimum))
    minimum
  )
  (case? (>= value maximum)
    maximum
  )
  (default
    value
  )
)

(fn-expr _ snapped-axis F64
  (param value F64)
  (param minimum F64)
  (param maximum F64)
  (param step F64)
  (case? (or (not (call is-finite step)) (<= step 0))
    (call clamped-axis value minimum maximum)
  )
  (default
    (call clamped-axis (+ minimum (* (call round (/ (- clamped minimum) step)) step)) minimum maximum)
  )
  (where
    (lazy clamped (call clamped-axis value minimum maximum))
  )
)

(fn-expr _ axis-ratio F64
  (param value F64)
  (param minimum F64)
  (param maximum F64)
  (case? (or (not (call is-finite minimum)) (not (call is-finite maximum)) (<= maximum minimum))
    0
  )
  (default
    (/ (- (call clamped-axis value minimum maximum) minimum) (- maximum minimum))
  )
)

(fn-expr _ axis-increment F64
  (param minimum F64)
  (param maximum F64)
  (param step F64)
  (case? (and (call is-finite step) (> step 0))
    step
  )
  (default
    (* (- maximum minimum) 0.01)
  )
)
