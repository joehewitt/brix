(import ./code-link-card)
(import ./code-syntax-style)
(import /code)
(import /code/code-find)
(import /code/syntax)
(import /data/diff)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/text)
(import /gui)
(import /gui/clipboard)
(import /math)
(import /stream/aggregate)
(import /time/duration)
(import /time/timer)
(import /ui/input)
(import /ui/key-combo)
(import /ui/undo-target)
(import /ui/virtual)
(import /ui/virtual-layout)
(blank)
(prop _ code-row-ratio _ (= 1.5))
(prop _ code-text-inset Length (= 8))
(prop _ code-row-padding Length (= 32))
(prop _ code-caret-width Length (= 2))
(prop _ code-gutter-inset Length (= 16))
(prop _ code-gutter-gap Length (= 12))
(prop _ code-gutter-digits Size (= 3))
(prop + code-fold-width Length (= 14))
(prop + code-chip-gap Length (= 8))
(prop + code-chip-width Length (= 22))
(prop _ code-fold-arrow-size Length (= 4))
(prop _ code-chip-inset Length (= 4))
(prop _ code-chip-dot Length (= 2))
(prop _ code-sticky-limit Size (= 5))
(prop _ code-change-offset Length (= 4))
(prop _ code-change-width Length (= 3))
(prop _ code-change-wedge Length (= 4))
(prop + code-overview-width Length (= 16))
(prop _ code-overview-inset Length (= 2))
(prop _ code-overview-gap Length (= 1))
(prop _ code-overview-mark Length (= 3))
(prop _ code-overview-mark-width Length (= 4))
(prop _ code-overview-slop Length (= 2))
(prop _ code-blink-interval _ (= 530ms))
(prop _ code-blink-timeout _ (= 10s))
(prop _ code-edit-roles _
  (:=
    (block
      (list (. MenuRole select-all))
    )
  )
)
(prop _ code-redo-key _ (:= (call KeyCombo "Cmd+Y")))
(prop _ code-save-key _ (:= (call KeyCombo "Cmd+S")))
(prop _ code-comment-key _ (:= (call KeyCombo "Cmd+/")))
(prop _ code-indent-key _ (:= (call KeyCombo "Cmd+]")))
(prop _ code-outdent-key _ (:= (call KeyCombo "Cmd+[")))

(style CodeEditorTheme
  (using GUIBoxCursor)
  (using GUIFontStyle)
  (using GUIMetrics)
  (rule code-editor-text
    (= font-family "Menlo")
    (= font-size gui-callout-font-size)
    (= cursor (. CursorStyle text))
  )
)

(type + CodeLink (is Tuple)
  (prop + start Size)
  (prop + end Size)
  (prop + title _ (= ""))
  (prop + detail _ (= ""))
  (prop + is-definition _ (= false))
)

(type + CodeRow (is Tuple)
  (prop + line Size)
  (prop + runs (list SyntaxStyledRun))
)

(type + CodeStuckRow (is (tuple (: row Size) (: y Length))))

(type + CodeEditor (is Box)
  (implements CodeFindTarget)
  (implements UndoTarget)
  (using CodeEditorTheme)
  (using CodeSyntaxStyle)
  (prop + session (? CodeSession))
  (prop + caret-line Size)
  (prop + caret-column Size)
  (prop + line-count Size)
  (prop + row-count Size)
  (prop + caret-row Size)
  (prop + row-changes (list DiffLineChange))
  (prop + fold-version U64)
  (prop + language-title String (= "Plain Text"))
  (prop + has-parse-error Bool)
  (prop + is-parsing Bool)
  (prop + has-selection Bool)
  (prop + source (? CodeRowSource))
  (prop + row-height VirtualCoord (= 18vcoord))
  (prop + row-width (? VirtualCoord))
  (prop + cell-width Length)
  (prop + gutter-width Length (= (call code-gutter-width #line-count #cell-width)))
  (prop + text-input-context _ (=> (call caret-context)))
  (prop + undo-target _ (=> this))
  (prop + link (? CodeLink))
  (prop + has-link _ (= false))
  (prop + find (? CodeFind))
  (prop + text-revision U64)
  (prop + definition-key (? KeyCombo))
  (prop + top-inset Length (= 0))
  (event + save-requested CodeSession)
  (event + definition-requested Size)
  (event + link-probed Size)
  (blank)
  (prop _ bound-rows (? CodeRowSource))
  (prop _ shown-generation U64)
  (prop _ scroll-top Length)
  (prop _ widest-columns Size)
  (prop _ measured-font (? Font))
  (prop _ centers-caret Bool)
  (prop _ top-goal (? Size))
  (prop _ hover-point (? Point))
  (prop _ probed (? Size))
  (prop _ context-offset (? Size))
  (prop _ context-link (? CodeLink))
  (prop _ sticky-rows (? CodeStickyRows))
  (event _ refreshed Bool)
  (event _ closing Bool)
  (blank)
  (depends inset-changed top-inset)
  (blank)
  (rule This (• code-editor-text) (• flex-row)
    (= focus-mode (. FocusMode input))
    (when-style #has-link
      (= cursor (. CursorStyle pointing-hand))
    )
  )
  (content
    (<> This
      (<> CodeGutter (id: gutter)
        (= min-width (call (. SizeSpec coord) #gutter-width))
        (= max-width (call (. SizeSpec coord) #gutter-width))
        (= numbered #row-count)
        (= caret-row #caret-row)
        (= scrolled (- #scroll-top #top-inset))
        (= row-length (as #row-height Length))
        (= changes #row-changes)
        (= session #session)
        (= version #fold-version)
      )
      (<> (of VirtualRegion CodeRow) (id: region) (• flex 1)
        (= source #source)
        (= virtual-layout (call code-row-layout #row-height #row-width #sticky-rows))
        (= overscan (call VirtualInsets 60vcoord 0vcoord 60vcoord 0vcoord))
        (= top-inset #top-inset)
        (blank)
        (<> CodeRowBox (slot: row) (param: slot)
          (= row (. slot #item))
          (= inset code-text-inset)
        )
      )
      (<> CodeOverview (id: overview) (• absolute) (• w code-overview-width)
        (= anchor (. Anchor parent))
        (= top (call (. PositionOffset coord) #top-inset))
        (= right (call (. PositionOffset coord) 0))
        (= bottom (call (. PositionOffset coord) 0))
        (= rows #row-count)
        (= row-length (as #row-height Length))
        (= changes #row-changes)
      )
      (<> CodeLinkCard (id: link-card))
      (<> ContextMenu
        (if (!= #context-link null)
          (<> MenuItem (text: "Go to Definition")
            (= key #definition-key)
            (= action (=> () :do (call go-to-context-definition)))
          )
          (<> MenuSeparator)
        )
        (<> MenuItem (text: "Cut")
          (= key cut-key)
          (= is-enabled #has-selection)
          (= action (=> () :do (call cut-from-menu)))
        )
        (<> MenuItem (text: "Copy")
          (= key copy-key)
          (= is-enabled #has-selection)
          (= action (=> () :do (call copy-from-menu)))
        )
        (<> MenuItem (text: "Paste")
          (= key paste-key)
          (= action (=> () :do (call paste-from-menu)))
        )
      )
    )
  )
  (fn-do + show _
    (param next CodeSession)
    (param scroll _ (= (call Point 0 0)))
    (call clear-link)
    (= bound-rows null)
    (= source null)
    (call (. region release-bindings))
    (+= shown-generation 1)
    (let generation shown-generation)
    (let bound (call CodeRowSource next))
    (= session next)
    (= bound-rows bound)
    (= sticky-rows (call CodeStickyRows next))
    (= language-title (if-expr (. next language) (. next language title) "Plain Text"))
    (= widest-columns 0)
    (= row-width null)
    (= centers-caret false)
    (= top-goal null)
    (= source bound)
    (call (. region restore-scroll) scroll)
    (= scroll-top (. scroll y))
    (call refresh)
    (for (on revision (. next updated) (until (!= generation shown-generation)))
      (call session-updated)
    )
  )
  (fn-do + jump-to _
    (param line Size)
    (param column Float (= 0))
    (let active session)
    (return-if (if (not active)))
    (call (. active place) line column)
    (= centers-caret true)
    (call refresh)
    (call invalidate-layout)
  )
  (fn-do + fold _
    (let active session)
    (return-if (if (not active)))
    (call (. active fold))
    (call refresh)
  )
  (fn-do + unfold _
    (let active session)
    (return-if (if (not active)))
    (call (. active unfold))
    (call refresh)
  )
  (fn-do + fold-all _
    (let active session)
    (return-if (if (not active)))
    (call (. active fold-all))
    (call refresh)
  )
  (fn-do + unfold-all _
    (let active session)
    (return-if (if (not active)))
    (call (. active unfold-all))
    (call refresh)
  )
  (fn-do + show-link _
    (param probe Size)
    (param found (? CodeLink))
    (if (and (== probe context-offset) (?? (?. found is-definition) false))
      (= context-link found)
    )
    (return-if (if (!= probed probe)))
    (call set-link found)
  )
  (fn-expr + text-scroll Point :get
    (call Point (. region scroll-x) (. region scroll-y))
  )
  (fn-expr + top-line Size :get
    (call line-at-point (call Point 0 top-inset))
  )
  (fn-do + scroll-to-line _
    (param line Size)
    (= top-goal line)
    (call invalidate-layout)
  )
  (fn-expr + text String :get
    (?? (. (?. session text) text) "")
  )
  (fn-do + perform _
    (param command TextCommand)
    (param extends _ (= false))
    (let active session)
    (return-if (if (not active)))
    (match command
      (case .move-backward
        (call (. active move-left) extends)
      )
      (case .move-forward
        (call (. active move-right) extends)
      )
      (case .move-word-backward
        (call (. active move-word-left) extends)
      )
      (case .move-word-forward
        (call (. active move-word-right) extends)
      )
      (case .move-up
        (call (. active move-up) extends)
      )
      (case .move-down
        (call (. active move-down) extends)
      )
      (case .move-to-line-start
        (call (. active move-to-line-start) extends)
      )
      (case .move-to-line-end
        (call (. active move-to-line-end) extends)
      )
      (case .move-to-paragraph-start
        (call (. active move-to-line-start) extends)
      )
      (case .move-to-paragraph-end
        (call (. active move-to-line-end) extends)
      )
      (case .move-to-start
        (call (. active move-to-start) extends)
      )
      (case .move-to-end
        (call (. active move-to-end) extends)
      )
      (case .page-up
        (call (. active move-up) extends (call page-rows))
      )
      (case .page-down
        (call (. active move-down) extends (call page-rows))
      )
      (case .scroll-page-up
        (call (. region scroll-by) (call Point 0 (* (- (call page-rows)) row-length)))
        (return)
      )
      (case .scroll-page-down
        (call (. region scroll-by) (call Point 0 (* (call page-rows) row-length)))
        (return)
      )
      (case .scroll-to-start
        (call (. region scroll-to-start) (. Orientation vertical))
        (return)
      )
      (case .scroll-to-end
        (call (. region scroll-to-end) (. Orientation vertical))
        (return)
      )
      (case .delete-backward
        (call (. active delete-backward))
      )
      (case .delete-forward
        (call (. active delete-forward))
      )
      (case .delete-word-backward
        (call (. active delete-word-backward))
      )
      (case .delete-word-forward
        (call (. active delete-word-forward))
      )
      (case .delete-to-line-start
        (call (. active delete-to-line-start))
      )
      (case .delete-to-line-end
        (call (. active delete-to-line-end))
      )
      (case .delete-to-paragraph-end
        (call (. active delete-to-line-end))
      )
      (case .insert-newline
        (call (. active newline))
      )
      (case .insert-line-break
        (call (. active newline))
      )
      (case .insert-tab
        (call (. active insert-tab))
      )
      (case .insert-backtab
        (call (. active outdent-lines))
      )
      (case .select-all
        (call (. active select-all))
      )
      (case .cancel
        (call (. active collapse))
      )
      (default
        (return)
      )
    )
    (call refresh)
  )
  (fn-expr + can-undo _ :get
    (?? (. (?. session history) can-undo) false)
  )
  (fn-expr + can-redo _ :get
    (?? (. (?. session history) can-redo) false)
  )
  (fn-expr + undo-title _ :get
    (?? (. (?. session history) undo-title) "Undo")
  )
  (fn-expr + redo-title _ :get
    (?? (. (?. session history) redo-title) "Redo")
  )
  (fn-do + undo _
    (let ignored (call perform-edit (. MenuRole undo)))
  )
  (fn-do + redo _
    (let ignored (call perform-edit (. MenuRole redo)))
  )
  (fn-do + perform-edit Bool
    (param role MenuRole)
    (let active session)
    (return-if false (if (not active)))
    (match role
      (case .undo
        (call (. active undo))
      )
      (case .redo
        (call (. active redo))
      )
      (case .select-all
        (call (. active select-all))
      )
      (default
        (return false)
      )
    )
    (call refresh)
    (return true)
  )
  (fn-do _ press Bool
    (param event KeyPressEvent)
    (let active session)
    (return-if false (if (not active)))
    (let role (call code-edit-role event))
    (return-if (call perform-edit role) (if role))
    (if (call (. code-save-key matches) event)
      (<- save-requested active)
      (return true)
    )
    (if (call (. code-comment-key matches) event)
      (call (. active toggle-comment))
      (call refresh)
      (return true)
    )
    (if (call (. code-indent-key matches) event)
      (call (. active indent-lines))
      (else-if (call (. code-outdent-key matches) event)
        (call (. active outdent-lines))
      )
      (else
        (return false)
      )
    )
    (call refresh)
    (return true)
  )
  (fn-do _ copy-selection Bool
    (param clipboard Clipboard)
    (let active session)
    (return-if false (if (or (not active) (not (. active has-selection)))))
    (return (call (. clipboard write-text) (. active selected-text)))
  )
  (subscribe-for (on event pointer-down)
    (if (or (== (. event button) (. PointerButton secondary)) control-click)
      (call press-context (. event point))
      (else-if (== (. event button) (. PointerButton primary))
        (call request-focus)
        (let active session)
        (let stuck (call stuck-row-at (. event point)))
        (let folded (call fold-target (. event point)))
        (if (and active (!= stuck null))
          (call (. active place) (call (. active folds actual) stuck) (call column-at-point (. event point)))
          (call refresh)
          (else-if (and active (!= folded null))
            (call (. active toggle-fold) folded)
            (call refresh)
          )
          (else-if active
            (let line (call line-at-point (. event point)))
            (if (>= (. event click-count) 3)
              (call (. active select-line) (call min line (- (. active line-count) 1)))
              (else-if (== (. event click-count) 2)
                (call (. active place) line (call column-at-point (. event point)))
                (call (. active select-word-at) (. active caret))
              )
              (else-if (. event modifiers command)
                (call (. active place) line (call column-at-point (. event point)))
              )
              (else
                (call (. active place) line (call column-at-point (. event point)) (. event modifiers shift))
              )
            )
            (call refresh)
            (if (and (== (. event click-count) 1) (. event modifiers command))
              (<- definition-requested (. active caret))
            )
          )
        )
      )
    )
    (lazy control-click (and (== (. event button) (. PointerButton primary)) (. event modifiers control)))
  )
  (fn-do _ cut-selection Bool
    (param clipboard Clipboard)
    (let active session)
    (return-if false (if (or (not active) (not (call copy-selection clipboard)))))
    (call (. active delete-selection))
    (call refresh)
    (return true)
  )
  (fn-do _ paste-text Bool
    (param clipboard Clipboard)
    (let active session)
    (let pasted (call (. clipboard read-text)))
    (return-if false (if (or (not active) (not pasted))))
    (call (. active paste) pasted)
    (call refresh)
    (return true)
  )
  (fn-do _ cut-from-menu _
    (let ignored (call cut-selection (call Clipboard)))
  )
  (fn-do _ copy-from-menu _
    (let ignored (call copy-selection (call Clipboard)))
  )
  (fn-do _ paste-from-menu _
    (let ignored (call paste-text (call Clipboard)))
  )
  (fn-do _ press-context _
    (param point Point)
    (call request-focus)
    (= context-offset null)
    (= context-link null)
    (let active session)
    (return-if (if (not active)))
    (let offset (call character-at-point active point))
    (let is-selected (and (!= offset null) (>= offset (. active selection-start)) (< offset (. active selection-end))))
    (if (not is-selected)
      (call (. active place) (call line-at-point point) (call column-at-point point))
      (call refresh)
    )
    (return-if (if (== offset null)))
    (= context-offset offset)
    (<- link-probed offset)
  )
  (fn-do _ go-to-context-definition _
    (let active session)
    (let offset context-offset)
    (return-if (if (or (not active) (== offset null))))
    (call (. active move-to) offset)
    (call refresh)
    (<- definition-requested offset)
  )
  (subscribe-for (on event pointer-move)
    (= hover-point (. event point))
    (call probe (. event modifiers command))
  )
  (subscribe-for (on event modifiers-changed)
    (= hover-point (. event point))
    (call probe (. event modifiers command))
  )
  (whenever-rule #is-hover-within
    (if (not is-hover-within)
      (= hover-point null)
      (call clear-link)
    )
  )
  (subscribe-for (on event pointer-drag)
    (let active session)
    (if active
      (call (. active place) (call line-at-point (. event point)) (call column-at-point (. event point)) true)
      (call refresh)
    )
  )
  (subscribe-for (on event key-press)
    (let modifiers (. event modifiers))
    (if (and (== (. event key) (. Key tab)) (not (. modifiers command)) (not (. modifiers control)) (not (. modifiers option)))
      (call perform (if-expr (. modifiers shift) (. TextCommand insert-backtab) (. TextCommand insert-tab)))
      (call (. event cancel))
      (else-if (call press event)
        (call (. event cancel))
      )
    )
  )
  (subscribe-for (on event key-input)
    (call (?. session type) (. event text) (. event replaces-before) (. event replaces-length))
    (call refresh)
  )
  (subscribe-for (on event text-command)
    (call perform (. event command) (. event extends-selection))
  )
  (subscribe-for (on event copy)
    (if (call copy-selection (. event clipboard))
      (call (. event cancel))
    )
  )
  (subscribe-for (on event cut)
    (if (call cut-selection (. event clipboard))
      (call (. event cancel))
    )
  )
  (subscribe-for (on event paste)
    (if (call paste-text (. event clipboard))
      (call (. event cancel))
    )
  )
  (subscribe-for (on event focus)
    (call invalidate-paint)
  )
  (subscribe-for (on event blur)
    (call invalidate-paint)
  )
  (prop _ caret-blink _
    (machine
      (state steady
        (then blinking (trigger on focus))
      )
      (blank)
      (state blinking (trigger on refreshed is-focused)
        (then steady (trigger on blur))
        (then steady (trigger on closing))
        (then rested (trigger on (call Timer code-blink-timeout)))
        (blank)
        (state lit
          (do
            (inline (call invalidate-paint))
          )
          (then dim (trigger on (call Timer code-blink-interval)))
        )
        (blank)
        (state dim
          (do
            (inline (call invalidate-paint))
          )
          (then lit (trigger on (call Timer code-blink-interval)))
        )
      )
      (blank)
      (state rested
        (do
          (inline (call invalidate-paint))
        )
        (then steady (trigger on blur))
        (then steady (trigger on closing))
      )
    )
  )
  (subscribe-for (on change (. overview chose))
    (call request-focus)
    (call jump-to (?? (call (. (?. session folds) actual) (. change line)) (. change line)))
  )
  (subscribe-for (on event (. region scroll-changed) (when arrival))
    (call clear-link)
    (= scroll-top (. event position y))
    (call invalidate-paint)
  )
  (fn-expr _ row-length Length :get
    (as row-height Length)
  )
  (fn-expr _ shown-top Length :get
    (- (. region scroll-y) top-inset)
  )
  (fn-do _ inset-changed _
    (call invalidate-paint)
  )
  (fn-do _ refresh _
    (let active session)
    (let bound bound-rows)
    (return-if (if (or (not active) (not bound))))
    (call (. active reveal-anchor))
    (call sync active bound)
    (call widen)
    (call reveal-caret active)
    (<- refreshed true)
    (if is-focused
      (call text-input-changed)
    )
    (call invalidate-paint)
  )
  (fn-do _ session-updated _
    (let active session)
    (let bound bound-rows)
    (return-if (if (or (not active) (not bound))))
    (call sync active bound)
    (call widen)
    (call invalidate-paint)
  )
  (fn-do _ sync _
    (param active CodeSession)
    (param bound CodeRowSource)
    (let folds (. active folds))
    (if (or (!= (. bound text-revision) (. active revision)) (!= (. bound fold-version) (. folds version)))
      (= (. bound text-revision) (. active revision))
      (= (. bound fold-version) (. folds version))
      (call (. bound revision bump))
      (call (. bound resize))
      (call clear-link)
    )
    (= text-revision (. active revision))
    (= caret-line (. active caret-line))
    (= caret-column (. active caret-column))
    (= line-count (. active line-count))
    (= row-count (call (. folds row-count) line-count))
    (= caret-row (call (. folds shown) caret-line))
    (= fold-version (+ (. folds version) (. active revision)))
    (= row-changes (call shown-changes active))
    (= has-parse-error (. active has-parse-error))
    (= is-parsing (. active is-parsing))
    (= has-selection (. active has-selection))
  )
  (fn-do _ reveal-caret _
    (param active CodeSession)
    (let view (. region content-bounds))
    (return-if (if (or (<= (. view width) 0) (<= (. view height) 0))))
    (call (. region scroll-to-address) (call (. active folds shown) (. active caret-line)) (. ScrollAlignment nearest))
    (let left (+ code-text-inset (* (. active caret-column) cell-width)))
    (let x (. region scroll-x))
    (if (< (- left code-text-inset) x)
      (= x (- left code-text-inset))
      (else-if (> (+ left code-row-padding) (+ x (. view width)))
        (= x (- (+ left code-row-padding) (. view width)))
      )
    )
    (if (!= x (. region scroll-x))
      (call (. region scroll-to) (call Point x (. region scroll-y)))
    )
  )
  (fn-expr _ page-rows Size
    (if-expr (> count 1) (- count 1) 1)
    (where
      (lazy count (as (call floor (/ (- (. region content-bounds height) top-inset) row-length)) Size))
    )
  )
  (fn-do _ probe _
    (param is-command Bool)
    (let active session)
    (let point hover-point)
    (if (or (not is-command) (not active) (not point))
      (call clear-link)
      (return)
    )
    (let offset (call character-at-point active point))
    (if (not offset)
      (call clear-link)
      (return)
    )
    (let current link)
    (return-if (if (and current (>= offset (. current start)) (< offset (. current end)))))
    (return-if (if (== offset probed)))
    (= probed offset)
    (if current
      (call set-link null)
    )
    (<- link-probed offset)
  )
  (fn-do _ clear-link _
    (= probed null)
    (if link
      (call set-link null)
    )
  )
  (fn-do _ set-link _
    (param found (? CodeLink))
    (= link found)
    (= has-link (!= found null))
    (call invalidate-paint)
    (let active session)
    (if (or (not found) (not active) (and (== (. found title length) 0) (== (. found detail length) 0)))
      (call (. link-card dismiss))
      (return)
    )
    (= (. link-card title) (. found title))
    (= (. link-card detail) (. found detail))
    (call (. link-card show) (call (. PopupAnchor rect) (call presentation-rect (call link-rect active found))))
  )
  (fn-expr _ link-rect Rect
    (param active CodeSession)
    (param found CodeLink)
    (call Rect x y (if-expr (> high low) (* (- high low) cell-width) 0) row-length)
    (where
      (lazy content text-bounds)
      (lazy line (call (. active text line-at) (. found start)))
      (lazy low (call (. active display-column) (. found start)))
      (lazy high (call (. active display-column) (. found end)))
      (lazy x (- (+ (. content x) code-text-inset (* low cell-width)) (. region scroll-x)))
      (lazy y (- (+ (. content y) (* (call (. active folds shown) line) row-length)) shown-top))
    )
  )
  (fn-expr _ character-at-point (? Size)
    (param active CodeSession)
    (param point Point)
    (case? (or (< x 0) (<= cell-width 0))
      null
    )
    (case? (>= row (call (. active folds row-count) (. active line-count)))
      null
    )
    (case? (>= offset (call (. active text line-end) line))
      null
    )
    (default
      offset
    )
    (where
      (lazy x (- (+ (. point x) (. region scroll-x)) code-text-inset gutter-width))
      (lazy row (call row-at-point point))
      (lazy line (call (. active folds actual) row))
      (lazy offset (call (. active offset-at-column) line (+ (call floor (/ x cell-width)) 0.25)))
    )
  )
  (fn-expr _ line-at-point Size
    (param point Point)
    (case? (not active)
      row
    )
    (case? (> rows 0)
      (call (. active folds actual) (call min row (- rows 1)))
    )
    (default
      0
    )
    (where
      (lazy row (call row-at-point point))
      (lazy active session)
      (lazy rows (call (. active folds row-count) (. active line-count)))
    )
  )
  (fn-expr _ row-at-point Size
    (param point Point)
    (if-expr (> y 0) (as (call floor (/ y row-length)) Size) 0)
    (where
      (lazy y (+ (. point y) shown-top))
    )
  )
  (fn-expr _ fold-target (? Size)
    (param point Point)
    (case? (not active)
      null
    )
    (case? (!= chip null)
      chip
    )
    (case? (or (< (. point x) (- gutter-width code-gutter-gap code-fold-width)) (>= (. point x) gutter-width))
      null
    )
    (case? (>= (call row-at-point point) (call (. active folds row-count) (. active line-count)))
      null
    )
    (case? (or (call (. active folds is-folded) line) (call (. active can-fold) line))
      line
    )
    (default
      null
    )
    (where
      (lazy active session)
      (lazy chip (call chip-at point))
      (lazy line (call line-at-point point))
    )
  )
  (fn-expr _ chip-at (? Size)
    (param point Point)
    (case? (or (not active) (<= cell-width 0))
      null
    )
    (case? (or (< x 0) (>= row (call (. active folds row-count) (. active line-count))))
      null
    )
    (case? (not (call (. active folds is-folded) line))
      null
    )
    (case? (or (< x start) (> x (+ start code-chip-width)))
      null
    )
    (default
      line
    )
    (where
      (lazy active session)
      (lazy x (- (+ (. point x) (. region scroll-x)) code-text-inset gutter-width))
      (lazy row (call row-at-point point))
      (lazy line (call (. active folds actual) row))
      (lazy start (+ (* (call (. active line-columns) line) cell-width) code-chip-gap))
    )
  )
  (fn-expr _ stuck-rows (list CodeStuckRow)
    (case? (or (not sticky) (not active))
      (call (of List CodeStuckRow))
    )
    (default
      (call code-stuck-rows sticky (call (. active folds row-count) (. active line-count)) row-length (. region scroll-y) top-inset)
    )
    (where
      (lazy sticky sticky-rows)
      (lazy active session)
    )
  )
  (fn-do + scroll-held-rects _ :get
    (let stuck (call stuck-rows))
    (return-if (call (of List Rect)) (if (== (. stuck length) 0)))
    (let content content-bounds)
    (let top (. ([] stuck 0) y))
    (return (list (call Rect (. content x) (+ (. content y) top) (. content width) (+ (- (call code-stuck-height stuck row-length) top) 1))))
  )
  (fn-expr _ stuck-row-at (? Size)
    (param point Point)
    (call code-stuck-at (call stuck-rows) (. point y) row-length)
  )
  (fn-do _ shown-changes (list DiffLineChange)
    (param active CodeSession)
    (let folds (. active folds))
    (return-if (. active line-changes) (if (. folds is-plain)))
    (let made (list DiffLineChange))
    (for (in change (. active line-changes))
      (let top (call (. folds shown) (. change line)))
      (if (or (== (. change kind) (. DiffLineChangeKind deleted)) (== (. change count) 0))
        (+= made (call DiffLineChange (. change kind) top (. change count)))
        (else
          (let bottom (call (. folds shown) (- (+ (. change line) (. change count)) 1)))
          (+= made (call DiffLineChange (. change kind) top (+ (- bottom top) 1)))
        )
      )
    )
    (return made)
  )
  (fn-expr _ column-at-point Float
    (param point Point)
    (if-expr (and (> x 0) (> cell-width 0)) (/ x cell-width) 0)
    (where
      (lazy x (- (+ (. point x) (. region scroll-x)) code-text-inset gutter-width))
    )
  )
  (fn-expr _ caret-rect Rect
    (param active CodeSession)
    (call Rect (- x (/ code-caret-width 2)) (+ y 1) code-caret-width (- row-length 2))
    (where
      (lazy content text-bounds)
      (lazy x (- (+ (. content x) code-text-inset (* (. active caret-column) cell-width)) (. region scroll-x)))
      (lazy y (- (+ (. content y) (* (call (. active folds shown) (. active caret-line)) row-length)) shown-top))
    )
  )
  (fn-expr _ caret-context (? TextInputContext)
    (only-if (call TextInputContext (. active caret-prefix) (. active selected-text) (call caret-rect active)) (if active))
    (where
      (lazy active session)
    )
  )
  (fn-expr _ text-bounds Rect :get
    (call Rect (+ (. content x) gutter-width) (. content y) (- (. content width) gutter-width) (. content height))
    (where
      (lazy content content-bounds)
    )
  )
  (fn-do _ center-caret _
    (return-if (if (not centers-caret)))
    (let active session)
    (let view (. region content-bounds))
    (return-if (if (or (not active) (<= (. view height) 0))))
    (= centers-caret false)
    (let centered-y (+ (* (call (. active folds shown) (. active caret-line)) row-length) (/ (+ (- row-length (. view height)) top-inset) 2)))
    (call (. region scroll-to) (call Point (. region scroll-x) centered-y))
  )
  (fn-do _ reveal-top _
    (let line top-goal)
    (let active session)
    (let view (. region content-bounds))
    (return-if (if (or (== line null) (not active) (<= (. view height) 0))))
    (= top-goal null)
    (call (. region scroll-to) (call Point (. region scroll-x) (* (call (. active folds shown) line) row-length)))
  )
  (fn-do _ widen _
    (let active session)
    (return-if (if (not active)))
    (let font (call Font $font-family $font-size $font-weight $font-slant))
    (if (!= font measured-font)
      (= measured-font font)
      (= cell-width (call code-cell-width font))
      (= row-height (as (call ceil (* $font-size code-row-ratio)) I64))
      (= row-width null)
    )
    (let widest (call max (. active widest-columns) widest-columns))
    (let width
      (scope (as (call ceil (call max text-width (. region content-bounds width))) I64)
        (lazy text-width (+ (* widest cell-width) code-text-inset code-row-padding))
      )
    )
    (return-if (if (and (== widest widest-columns) (== row-width width))))
    (= widest-columns widest)
    (= row-width width)
  )
  (fn-expr _ hit-rect Rect
    (param active CodeSession)
    (param hit CodeHit)
    (param left Length)
    (param top Length)
    (call Rect
      (block
        (arg (+ left (* low cell-width)))
        (arg (+ top (* (call (. active folds shown) (. hit row)) row-length)))
        (arg (* (- high low) cell-width))
        (arg row-length)
      )
    )
    (where
      (lazy low (call (. active display-column) (call (. active text char-offset) (. hit row) (. hit start))))
      (lazy high (call (. active display-column) (call (. active text char-offset) (. hit row) (. hit end))))
    )
  )
  (fn-expr _ find-place CodeFindPlace
    (param active CodeSession)
    (param offset Size)
    (call CodeFindPlace (call (. active text line-at) offset) (call (. active text char-index) offset))
  )
  (fn-expr + find-stamp U64
    (?? (?. session revision) 0)
  )
  (fn-do + find-rows (list CodeFindRow)
    (param editing Bool)
    (let rows (list CodeFindRow))
    (let active session)
    (return-if rows (if (not active)))
    (for (in line (..< 0 (. active line-count)))
      (+= rows (call CodeFindRow (call (. active text line-text) line) 0 true))
    )
    (return rows)
  )
  (fn-expr + find-caret CodeFindPlace
    (if-expr (not active) (call CodeFindPlace 0 0) (call find-place active (. active caret)))
    (where
      (lazy active session)
    )
  )
  (fn-expr + find-origin CodeFindPlace
    (if-expr (not active) (call CodeFindPlace 0 0) (call find-place active (. active selection-start)))
    (where
      (lazy active session)
    )
  )
  (fn-expr + find-selection (? CodeHit)
    (case? (or (not active) (not (. active has-selection)))
      null
    )
    (case? (!= (. start row) (. end row))
      null
    )
    (default
      (call CodeHit (. start row) (. start column) (. end column))
    )
    (where
      (lazy active session)
      (lazy start (call find-place active (. active selection-start)))
      (lazy end (call find-place active (. active selection-end)))
    )
  )
  (fn-expr + find-seed (? String)
    (if-expr (== (call find-selection) null) null (. (!! session) selected-text))
  )
  (fn-do + find-reveal _
    (param hit CodeHit)
    (let active session)
    (return-if (if (not active)))
    (call (. active select-range)
      (block
        (arg (call (. active text char-offset) (. hit row) (. hit start)))
        (arg (call (. active text char-offset) (. hit row) (. hit end)))
      )
    )
    (call (. active reveal-anchor))
    (let view (. region content-bounds))
    (let row (call (. active folds shown) (. hit row)))
    (let y (* row row-length))
    (if (or (< y (. region scroll-y)) (> (+ y row-length) (- (+ (. region scroll-y) (. view height)) top-inset)))
      (call (. region scroll-to-address) row (. ScrollAlignment center))
    )
    (call refresh)
  )
  (fn-do + find-replace Bool
    (param hit CodeHit)
    (param text String)
    (let active session)
    (return-if false (if (not active)))
    (let start (call (. active text char-offset) (. hit row) (. hit start)))
    (let end (call (. active text char-offset) (. hit row) (. hit end)))
    (call (. active replace-ranges) (list start) (list end) (list text))
    (call refresh)
    (return true)
  )
  (fn-expr + find-can-edit Bool
    (param row Size)
    (!= session null)
  )
  (fn-do + find-rewrite CodeRewrite
    (param rows (list Size))
    (param texts (list String))
    (let active session)
    (return-if (call CodeRewrite 0 0) (if (not active)))
    (let starts (list Size))
    (let ends (list Size))
    (for (in row rows)
      (+= starts (call (. active text line-start) row))
      (+= ends (call (. active text line-end) row))
    )
    (call (. active replace-ranges) starts ends texts)
    (call refresh)
    (return (call CodeRewrite (. rows length) 0))
  )
  (fn-do + find-show _
    (param model (? CodeFind))
    (= find model)
    (call invalidate-paint)
  )
  (fn-do + find-focus _
    (call request-focus)
  )
  (fn-do + close _
    (<- closing true)
    (+= shown-generation 1)
    (= session null)
    (call (. super close))
  )
  (fn-do + did-layout _
    (call (. super did-layout))
    (= (. overview clearance) (+ (. region $scroll-indicator-thickness) (. region $scroll-indicator-inset)))
    (call widen)
    (call center-caret)
    (call reveal-top)
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let whole content-bounds)
    (= (. canvas fill-color) $gui-editor-background-color)
    (call (. canvas rect) whole)
    (let active session)
    (return-if (if (or (not active) (== (. active line-count) 0))))
    (let content text-bounds)
    (let folds (. active folds))
    (let top shown-top)
    (let first (if-expr (> top 0) (as (call floor (/ top row-length)) Size) 0))
    (let last
      (call min
        (block
          (arg (call (. folds row-count) (. active line-count)))
          (arg (+ (as (call ceil (/ (+ top (. content height)) row-length)) Size) 1))
        )
      )
    )
    (return-if (if (>= first last)))
    (let last-line (call (. folds actual) (- last 1)))
    (let left (- (+ (. content x) code-text-inset) (. region scroll-x)))
    (let selects (. active has-selection))
    (let selection-start (. active selection-start))
    (let selection-end (. active selection-end))
    (let first-selected (call (. active text line-at) selection-start))
    (let last-selected (call (. active text line-at) selection-end))
    (let finder find)
    (let hits (if-expr finder (. finder found) (call (of List CodeHit))))
    (let next-hit (if-expr finder (call (. finder first-at) (call (. folds actual) first)) 0))
    (let focus-hit (only-if (. finder current) (if finder)))
    (do-use (. canvas saved-state)
      (call (. canvas clip) content)
      (if (not selects)
        (let y (- (+ (. content y) (* (call (. folds shown) (. active caret-line)) row-length)) top))
        (= (. canvas fill-color) $gui-editor-current-line-color)
        (call (. canvas rect) (call Rect (. content x) y (. content width) row-length))
      )
      (= (. canvas fill-color) $gui-editor-find-color)
      (while (and (< next-hit (. hits length)) (<= (. ([] hits next-hit) row) last-line))
        (if (and (!= next-hit focus-hit) (not (call (. folds is-hidden) (. ([] hits next-hit) row))))
          (call (. canvas rect) (call hit-rect active ([] hits next-hit) left (- (. content y) top)))
        )
        (+= next-hit 1)
      )
      (if selects
        (= (. canvas fill-color)
          (scope (if-expr is-focused $gui-editor-selection-color idle-color)
            (lazy idle-color $gui-editor-idle-selection-color)
          )
        )
        (for (in index (..< first last))
          (let line (call (. folds actual) index))
          (if (and (>= line first-selected) (<= line last-selected))
            (let y (- (+ (. content y) (* index row-length)) top))
            (let low (if-expr (== line first-selected) (call (. active display-column) selection-start) 0))
            (lazy line-end (+ (call (. active line-columns) line) 1))
            (lazy end-column (call (. active display-column) selection-end))
            (let high (if-expr (== line last-selected) end-column line-end))
            (if (> high low)
              (call (. canvas rect)
                (block
                  (arg (call Rect (+ left (* low cell-width)) y (* (- high low) cell-width) row-length))
                )
              )
            )
          )
        )
      )
      (let focused (only-if (. finder current-found) (if finder)))
      (if (and focused (not (call (. folds is-hidden) (. focused row))))
        (let display (call (. folds shown) (. focused row)))
        (if (and (>= display first) (< display last))
          (= (. canvas fill-color) $gui-editor-find-current-color)
          (call (. canvas rect) (call hit-rect active focused left (- (. content y) top)))
        )
      )
      (for (in index (..< first last))
        (let line (call (. folds actual) index))
        (if (call (. folds is-folded) line)
          (let x (+ left (* (call (. active line-columns) line) cell-width) code-chip-gap))
          (let y (- (+ (. content y) (* index row-length)) top))
          (call code-fold-chip
            (block
              (arg canvas)
              (arg x)
              (arg y)
              (arg row-length)
              (arg $gui-editor-fold-chip-color)
              (arg $gui-editor-line-number-color)
            )
          )
        )
      )
    )
  )
  (fn-do + paint-overlay _
    (param canvas Canvas)
    (let active session)
    (return-if (if (or (not active) (== cell-width 0))))
    (let stuck (call stuck-rows))
    (let text text-bounds)
    (let below (call code-stuck-height stuck row-length))
    (let open (call Rect (. text x) (+ (. text y) below) (. text width) (call max (- (. text height) below) 0)))
    (call paint-stuck canvas active stuck)
    (call paint-link canvas active open)
    (return-if (if (or (not is-focused) (is caret-blink .dim))))
    (do-use (. canvas saved-state)
      (call (. canvas clip) open)
      (= (. canvas fill-color) $gui-editor-caret-color)
      (call (. canvas rect) (call caret-rect active))
    )
  )
  (fn-do _ paint-stuck _
    (param canvas Canvas)
    (param active CodeSession)
    (param stuck (list CodeStuckRow))
    (return-if (if (== (. stuck length) 0)))
    (let content content-bounds)
    (let font (call Font $font-family $font-size $font-weight $font-slant))
    (let right (- (+ (. content x) gutter-width) code-gutter-gap code-fold-width))
    (let arrow-x (- (+ (. content x) gutter-width) (/ (+ code-gutter-gap code-fold-width) 2)))
    (do-use (. canvas saved-state)
      (call (. canvas clip) content)
      (= (. canvas stroke-color) null)
      (for (in row stuck)
        (let y (+ (. content y) (. row y)))
        (= (. canvas fill-color) $gui-editor-gutter-color)
        (call (. canvas rect) (call Rect (. content x) y gutter-width row-length))
        (let layout (use (call TextLayout (call TextLayoutRequest (str (+ (call (. active folds actual) (. row row)) 1)) font))))
        (let text-y (+ y (/ (- row-length (. layout height)) 2)))
        (= (. canvas text-color) $gui-editor-line-number-color)
        (call (. canvas draw-text)
          (block
            (arg layout)
            (arg (call Rect (- right (. layout width)) text-y (. layout width) (. layout height)))
            (arg (. TextAlignment left))
          )
        )
        (= (. canvas fill-color) $gui-editor-line-number-color)
        (call code-fold-arrow canvas arrow-x (+ y (/ row-length 2)) true)
      )
      (let last ([] stuck (- (. stuck length) 1)))
      (if (> (. last y) (- (* (as (. last row) Length) row-length) shown-top))
        (= (. canvas fill-color) $gui-editor-sticky-border-color)
        (call (. canvas rect) (call Rect (. content x) (+ (. content y) (. last y) row-length) (. content width) 1))
      )
    )
  )
  (fn-do _ paint-link _
    (param canvas Canvas)
    (param active CodeSession)
    (param open Rect)
    (let found link)
    (return-if (if (not found)))
    (let rect (call link-rect active found))
    (return-if (if (<= (. rect width) 0)))
    (do-use (. canvas saved-state)
      (call (. canvas clip) open)
      (= (. canvas fill-color) $gui-editor-link-color)
      (call (. canvas rect) (call Rect (. rect x) (- (+ (. rect y) (. rect height)) 3) (. rect width) 1))
    )
  )
)

(type + CodeChangeBox (is Box)
  (using CodeSyntaxStyle)
  (fn-expr + change-color RGBA
    (param kind DiffLineChangeKind)
    (match kind
      (case .inserted
        $gui-editor-inserted-line-color
      )
      (case .modified
        $gui-editor-modified-line-color
      )
      (case .deleted
        $gui-editor-deleted-line-color
      )
    )
  )
  (fn-do + paint-changes _
    (param canvas Canvas)
    (param content Rect)
    (param edge Length)
    (param changes (list DiffLineChange))
    (param scrolled Length)
    (param row-length Length)
    (let strip (+ edge code-change-offset))
    (= (. canvas stroke-color) null)
    (for (in change changes)
      (let top (- (+ (. content y) (* (. change line) row-length)) scrolled))
      (if (== (. change kind) (. DiffLineChangeKind deleted))
        (if (and (> top (- (. content y) code-change-wedge)) (< top (+ (. content bottom) code-change-wedge)))
          (= (. canvas fill-color) (call change-color (. change kind)))
          (call (. canvas begin))
          (call (. canvas move) strip (- top code-change-wedge))
          (call (. canvas line) (+ strip code-change-wedge) top)
          (call (. canvas line) strip (+ top code-change-wedge))
          (call (. canvas end))
        )
        (else
          (let bottom (+ top (* (. change count) row-length)))
          (if (and (> bottom (. content y)) (< top (. content bottom)))
            (= (. canvas fill-color) (call change-color (. change kind)))
            (call (. canvas rect) (call Rect strip top code-change-width (- bottom top)))
          )
        )
      )
    )
  )
)

(type + CodeGutter (is CodeChangeBox)
  (prop + numbered Size)
  (prop + caret-row Size)
  (prop + scrolled Length)
  (prop + row-length Length (= 18))
  (prop + changes (list DiffLineChange))
  (prop + session (? CodeSession))
  (prop + version U64)
  (blank)
  (prop _ numbers (list TextLayout))
  (prop _ labels (list Size))
  (blank)
  (depends changed numbered caret-row scrolled row-length changes version)
  (fn-do _ changed _
    (call invalidate-paint)
  )
  (whenever-rule #is-hover-within
    (call invalidate-paint)
  )
  (fn-do _ release-numbers _
    (for (in layout numbers)
      (call (. layout close))
    )
    (= numbers (call (of List TextLayout)))
    (= labels (call (of List Size)))
  )
  (fn-do _ ensure-numbers _
    (param wanted (list Size))
    (return-if (if (call is-labeled wanted)))
    (call release-numbers)
    (let font (call Font $font-family $font-size $font-weight $font-slant))
    (for (in label wanted)
      (+= numbers (call TextLayout (call TextLayoutRequest (str label) font)))
    )
    (= labels wanted)
  )
  (fn-expr _ is-labeled Bool
    (param wanted (list Size))
    (== labels wanted)
  )
  (fn-do + close _
    (call release-numbers)
    (call (. super close))
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let content content-bounds)
    (return-if (if (or (<= (. content width) 0) (<= (. content height) 0))))
    (= (. canvas fill-color) $gui-editor-gutter-color)
    (call (. canvas rect) content)
    (let low (if-expr (> scrolled 0) (as (call floor (/ scrolled row-length)) Size) 0))
    (let high (call min numbered (+ (as (call ceil (/ (+ scrolled (. content height)) row-length)) Size) 1)))
    (return-if (if (<= high low)))
    (let active session)
    (let lines (list Size))
    (let wanted (list Size))
    (for (in index (..< low high))
      (let line (if-expr active (call (. active folds actual) index) index))
      (+= lines line)
      (+= wanted (+ line 1))
    )
    (call ensure-numbers wanted)
    (let right (- (+ (. content x) (. content width)) code-gutter-gap code-fold-width))
    (let arrow-x (- (+ (. content x) (. content width)) (/ (+ code-gutter-gap code-fold-width) 2)))
    (do-use (. canvas saved-state)
      (call (. canvas clip) content)
      (= (. canvas stroke-color) null)
      (for (in index (..< low high))
        (let layout ([] numbers (- index low)))
        (let y (- (+ (. content y) (* index row-length)) scrolled))
        (let text-y (+ y (/ (- row-length (. layout height)) 2)))
        (let text-rect (call Rect (- right (. layout width)) text-y (. layout width) (. layout height)))
        (= (. canvas text-color)
          (block
            (if-expr on-caret $gui-editor-caret-line-number-color $gui-editor-line-number-color)
          )
        )
        (lazy on-caret (== index caret-row))
        (call (. canvas draw-text) layout text-rect (. TextAlignment left))
        (if active
          (let line ([] lines (- index low)))
          (let middle (+ y (/ row-length 2)))
          (if (call (. active folds is-folded) line)
            (= (. canvas fill-color) $gui-editor-caret-line-number-color)
            (call code-fold-arrow canvas arrow-x middle false)
            (else-if (and is-hover-within (call (. active can-fold) line))
              (= (. canvas fill-color) $gui-editor-line-number-color)
              (call code-fold-arrow canvas arrow-x middle true)
            )
          )
        )
      )
      (call paint-changes canvas content right changes scrolled row-length)
    )
  )
)

(type + CodeOverview (is Box)
  (prop + rows Size)
  (prop + row-length Length (= 18))
  (prop + changes (list DiffLineChange))
  (prop + clearance Length)
  (event + chose DiffLineChange)
  (blank)
  (depends rows-changed rows row-length clearance)
  (content
    (<> This
      (for (in marked #changes)
        (<> CodeOverviewMark
          (= line-change marked)
          (for (on event pointer-down)
            (if (== (. event button) (. PointerButton primary))
              (<- chose marked)
            )
            (call (. event cancel))
          )
        )
      )
    )
  )
  (fn-do _ rows-changed _
    (call invalidate-layout)
  )
  (fn-do + mounted _
    (call (. super mounted))
    (call set-scroll-pinned true)
  )
  (fn-expr + hit-contains _
    (param point Point)
    false
  )
  (fn-do + arrange-positioned-children _
    (let content content-bounds)
    (let right (- (+ (. content x) (. content width)) clearance code-overview-gap))
    (let top-edge (+ (. content y) code-overview-inset))
    (let track (- (. content height) (* code-overview-inset 2)))
    (let scale (if-expr (> track 0) (/ track (call max (* rows row-length) (. content height))) 0))
    (for (in child active-children)
      (if (is child CodeOverviewMark)
        (let mark (as child CodeOverviewMark))
        (let top (+ top-edge (* (. mark line-change line) row-length scale)))
        (let height (call max code-overview-mark (* (. mark line-change count) row-length scale)))
        (if (== (. mark line-change kind) (. DiffLineChangeKind deleted))
          (-= top (/ code-overview-mark 2))
          (= height code-overview-mark)
        )
        (call (. mark arrange-outer-bounds)
          (block
            (arg
              (call Rect
                (block
                  (arg (- right code-overview-mark-width code-overview-slop))
                  (arg (- top code-overview-slop))
                  (arg (+ code-overview-mark-width code-overview-slop))
                  (arg (+ height (* code-overview-slop 2)))
                )
              )
            )
          )
        )
      )
    )
    (call (. super arrange-positioned-children))
  )
)

(type + CodeOverviewMark (is CodeChangeBox)
  (prop + line-change DiffLineChange)
  (blank)
  (rule This
    (= cursor (. CursorStyle pointing-hand))
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let content content-bounds)
    (return-if (if (or (<= (. content width) 0) (<= (. content height) (* code-overview-slop 2)))))
    (= (. canvas stroke-color) null)
    (= (. canvas fill-color) (call change-color (. line-change kind)))
    (call (. canvas rect)
      (block
        (arg
          (call Rect
            (block
              (arg (- (+ (. content x) (. content width)) code-overview-mark-width))
              (arg (+ (. content y) code-overview-slop))
              (arg code-overview-mark-width)
              (arg (- (. content height) (* code-overview-slop 2)))
            )
          )
        )
      )
    )
  )
)

(type + CodeRowBox (is Box)
  (using CodeSyntaxStyle)
  (prop + row CodeRow)
  (prop + inset Length (= code-text-inset))
  (blank)
  (prop _ text-layout (? TextLayout))
  (prop _ shown-runs (list SyntaxStyledRun))
  (prop _ shown-colors (list RGBA))
  (blank)
  (depends row-changed row)
  (fn-do _ row-changed _
    (if (!= shown-runs (. row runs))
      (call release-text-layout)
    )
    (call invalidate-paint)
  )
  (fn-do _ ensure-text-layout TextLayout
    (let colors (call (of List RGBA) (in (call role-color (. each role)) (. row runs))))
    (let cached text-layout)
    (if cached
      (return-if cached (if (== colors shown-colors)))
      (call release-text-layout)
    )
    (let font (call Font $font-family $font-size $font-weight $font-slant))
    (let segments
      (call (of List TextSegment)
        (block
          (arg (in (call TextSegment (if-expr (. each is-marked) 1 0) (. each text) font (call role-color (. each role))) (. row runs)))
        )
      )
    )
    (let layout (call TextLayout segments font null (. TextOverflow clip) (. TextWrap no-wrap)))
    (= text-layout layout)
    (= shown-runs (. row runs))
    (= shown-colors colors)
    (return layout)
  )
  (fn-expr _ role-color RGBA
    (param role SyntaxRole)
    (if-expr (== role (. SyntaxRole plain)) (?? $syntax-plain-color $gui-syntax-plain-color) (call gui-syntax-role-color this role))
  )
  (fn-do _ paint-marks _
    (param canvas Canvas)
    (param layout TextLayout)
    (param content Rect)
    (let left (+ (. content x) inset))
    (let low Length 0)
    (let high Length 0)
    (let is-open false)
    (= (. canvas fill-color) (?? $editor-mark-color $gui-editor-mark-color))
    (for (in fragment (. layout fragments))
      (if (!= (. fragment tag) 1)
        (continue)
      )
      (if (and is-open (< (call abs (- (. fragment x) high)) 0.5))
        (= high (+ (. fragment x) (. fragment width)))
        (else
          (if is-open
            (call (. canvas rect) (call Rect (+ left low) (. content y) (- high low) (. content height)))
          )
          (= low (. fragment x))
          (= high (+ (. fragment x) (. fragment width)))
          (= is-open true)
        )
      )
    )
    (if is-open
      (call (. canvas rect) (call Rect (+ left low) (. content y) (- high low) (. content height)))
    )
  )
  (fn-do _ release-text-layout _
    (if text-layout
      (call (. text-layout close))
      (= text-layout null)
    )
  )
  (fn-do + close _
    (call release-text-layout)
    (call (. super close))
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let content content-bounds)
    (return-if (if (or (<= (. content width) 0) (<= (. content height) 0))))
    (if (call (of virtual-row-is-sticky CodeRow) this)
      (= (. canvas fill-color) $gui-editor-background-color)
      (call (. canvas rect) content)
    )
    (return-if (if (== (. row runs length) 0)))
    (do-use (. canvas saved-state)
      (call (. canvas clip) content)
      (let layout (call ensure-text-layout))
      (let text-y (+ (. content y) (/ (- (. content height) (. layout height)) 2)))
      (let text-rect (call Rect (+ (. content x) inset) text-y (. layout width) (. layout height)))
      (call paint-marks canvas layout content)
      (= (. canvas text-color) (?? $syntax-plain-color $gui-syntax-plain-color))
      (call (. canvas draw-text) layout text-rect (. TextAlignment left))
    )
  )
)

(type + CodeRowSource
  (implements (of VirtualSource CodeRow))
  (prop + session CodeSession)
  (prop + revision _ (:= (call VirtualRevision)))
  (prop + text-revision U64)
  (prop + fold-version U64)
  (blank)
  (prop _ range VirtualRangeSource)
  (fn-do + resize _
    (= (. range count) (call (. session folds row-count) (. session line-count)))
  )
  (fn-do + This _
    (param session _)
    (lazy range (call VirtualRangeSource (call (. session folds row-count) (. session line-count))))
  )
  (fn-expr + domain VirtualSequenceDomain :get
    range
  )
  (fn-do + bind _
    (param address I64)
    (param generation U64)
    (param target (of VirtualBindingTarget CodeRow))
    (if (or (< address 0) (>= address (call (. session folds row-count) (. session line-count))))
      (call (. target fail) generation)
      (else
        (let line (call (. session folds actual) address))
        (call (. target commit)
          (block
            (arg (call VirtualKey (. revision value) address))
            (arg (call CodeRow line (call (. session styled-runs) line)))
            (arg generation)
          )
        )
      )
    )
  )
)

(type + CodeStickyRows
  (implements VirtualStickyRows)
  (prop + session CodeSession)
  (fn-do + This _
    (param session _)
  )
  (fn-do + sticky-headers _
    (param address I64)
    (param headers (of List I64))
    (let folds (. session folds))
    (return-if (if (or (< address 0) (>= address (as (call (. folds row-count) (. session line-count)) I64)))))
    (let line (call (. folds actual) address))
    (let count Size 0)
    (for (in fold (call (. session fold-ranges) line line))
      (if (or (>= count code-sticky-limit) (> (. fold start) line))
        (break)
      )
      (if (and (>= (. fold end) line) (not (call (. folds has-fold) (. fold start))))
        (+= headers (call (. folds shown) (. fold start)))
        (+= count 1)
      )
    )
  )
  (fn-expr + sticky-section-last I64
    (param header I64)
    (if-expr (not found) header (as (call (. folds shown) (. found end)) I64))
    (where
      (lazy folds (. session folds))
      (lazy found (call (. session fold-at) (call (. folds actual) header)))
    )
  )
)

(fn-expr _ code-row-layout VirtualLayout
  (param row-height VirtualCoord)
  (param row-width (? VirtualCoord))
  (param sticky (? CodeStickyRows))
  (case? (!= sticky null)
    (call VerticalStickyLayout (call VerticalFixedLayout row-height row-width) sticky)
  )
  (default
    (call VerticalFixedLayout row-height row-width)
  )
)

(fn-do _ code-edit-role (? MenuRole)
  (param event KeyPressEvent)
  (return-if (. MenuRole redo) (if (call (. code-redo-key matches) event)))
  (for (in role code-edit-roles)
    (let key (call menu-role-key role))
    (return-if role (if (and key (call (. key matches) event))))
  )
  (return null)
)

(fn-do _ code-gutter-width Length
  (param line-count Size)
  (param cell-width Length)
  (let digits code-gutter-digits)
  (let limit Size 1000)
  (while (>= line-count limit)
    (+= digits 1)
    (*= limit 10)
  )
  (let digit (if-expr (> cell-width 0) (call ceil cell-width) 8))
  (return (+ code-gutter-inset (* digits digit) code-gutter-gap code-fold-width))
)

(fn-do + code-stuck-rows (list CodeStuckRow)
  (param sticky VirtualStickyRows)
  (param row-count Size)
  (param row-length Length)
  (param top Length)
  (param inset Length)
  (let found (list CodeStuckRow))
  (return-if found (if (<= row-length 0)))
  (let bottom top)
  (let reach top)
  (let headers (call (of List I64)))
  (while (>= reach 0)
    (let probe (as (call floor (/ reach row-length)) Size))
    (return-if found (if (>= probe row-count)))
    (call (. headers clear))
    (call (. sticky sticky-headers) probe headers)
    (return-if found (if (or (<= (. headers length) (. found length)) (not (call code-extends-stuck headers found)))))
    (let header ([] headers (. found length)))
    (let natural (* (as header Size) row-length))
    (let limit (* (+ (as (call (. sticky sticky-section-last) header) Size) 1) row-length))
    (let y (call max natural (call min bottom (- limit row-length))))
    (+= found (call CodeStuckRow header (+ (- y top) inset)))
    (= bottom (+ y row-length))
    (+= reach row-length)
  )
  (return found)
)

(fn-expr _ code-extends-stuck Bool
  (param headers (of List I64))
  (param found (list CodeStuckRow))
  (call all (..< 0 (. found length)) (:where (== (as ([] headers each) Size) (. ([] found each) row))))
)

(fn-do + code-stuck-at (? Size)
  (param stuck (list CodeStuckRow))
  (param y Length)
  (param row-length Length)
  (for (in row stuck)
    (return-if (. row row) (if (and (>= y (. row y)) (< y (+ (. row y) row-length)))))
  )
  (return null)
)

(fn-expr + code-stuck-height Length
  (param stuck (list CodeStuckRow))
  (param row-length Length)
  (if-expr (> (. stuck length) 0) (call max (+ (. ([] stuck (- (. stuck length) 1)) y) row-length) 0) 0)
)

(fn-do + code-fold-arrow _
  (param canvas Canvas)
  (param x Length)
  (param y Length)
  (param is-open Bool)
  (call (. canvas begin))
  (if is-open
    (call (. canvas move) (- x code-fold-arrow-size) (- y (/ code-fold-arrow-size 2)))
    (call (. canvas line) (+ x code-fold-arrow-size) (- y (/ code-fold-arrow-size 2)))
    (call (. canvas line) x (+ y (/ code-fold-arrow-size 2) 1))
    (else
      (call (. canvas move) (- x (/ code-fold-arrow-size 2)) (- y code-fold-arrow-size))
      (call (. canvas line) (+ x (/ code-fold-arrow-size 2) 1) y)
      (call (. canvas line) (- x (/ code-fold-arrow-size 2)) (+ y code-fold-arrow-size))
    )
  )
  (call (. canvas end))
)

(fn-do + code-fold-chip _
  (param canvas Canvas)
  (param x Length)
  (param y Length)
  (param height Length)
  (param fill RGBA)
  (param dot RGBA)
  (= (. canvas fill-color) fill)
  (call (. canvas rect) (call Rect x (+ y code-chip-inset) code-chip-width (- height (* code-chip-inset 2))))
  (= (. canvas fill-color) dot)
  (let middle (- (+ y (/ height 2)) (/ code-chip-dot 2)))
  (let spacing (/ code-chip-width 4))
  (for (in index (.. 1 3))
    (call (. canvas rect) (call Rect (- (+ x (* spacing index)) (/ code-chip-dot 2)) middle code-chip-dot code-chip-dot))
  )
)

(fn-expr + code-cell-width Length
  (param font Font)
  (/ (. layout natural-width) 10)
  (where
    (lazy layout (use (call TextLayout "MMMMMMMMMM" font)))
  )
)
