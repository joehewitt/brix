/data/json
/ui/app-state

_ find-options-key = "find"
_ find-options-version = 1

━━━━━━━━━━━━━━━━━━━━
+ FindOptions

+ matches-case = false
+ matches-word = false
+ is-regex = false
+ revision U64

_ state AppState?

────────────────────
+ do restore
    - store AppState

state = store
. saved = store.read(find-options-key, find-options-version)
=? if !saved
. fields = catch? JSONReader(find-options-key, saved).object()
=? if !fields
matches-case = catch? fields["case"].bool() ?? false
matches-word = catch? fields["word"].bool() ?? false
is-regex = catch? fields["regex"].bool() ?? false
revision += 1

────────────────────
+ do toggle-case

matches-case = !matches-case
changed()

────────────────────
+ do toggle-word

matches-word = !matches-word
changed()

────────────────────
+ do toggle-regex

is-regex = !is-regex
changed()

────────────────────
_ do changed

revision += 1
. fields = Map'String'JSON
    • "case" matches-case
    • "word" matches-word
    • "regex" is-regex
state?.write(find-options-key, find-options-version, fields)
