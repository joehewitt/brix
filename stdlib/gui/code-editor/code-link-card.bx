(import /gui)

(style-extend GUIDefaultTheme
  (using GUIBoxPaint)
  (using GUITextPaint)
  (using GUIBoxSpacing)
  (using GUIFontStyle)
  (using GUIPopupStyle)
  (rule CodeLinkCard (• bg gui-popup-color) (• text gui-text-color) (• px 12) (• py 10)
    (= border-color gui-border-color)
    (= border-width 1)
    (= corner-radius gui-popup-radius)
    (= shadow gui-popup-shadow)
  )
  (blank)
  (rule code-link-title (• text gui-muted-text-color)
    (= font-size gui-callout-font-size)
  )
  (blank)
  (rule code-link-detail
    (= font-family "Menlo")
    (= font-size gui-body-font-size)
  )
)

(type + CodeLinkCard (is Popup)
  (prop + title _ (= ""))
  (prop + detail _ (= ""))
  (blank)
  (rule This (• passive) (• flex-col) (• below 4))
  (content
    (<> This
      (if (> (. #title length) 0)
        (<> Label (• code-link-title)
          (= text #title)
        )
      )
      (if (and (> (. #title length) 0) (> (. #detail length) 0))
        (<> Box (• h 8))
      )
      (if (> (. #detail length) 0)
        (<> Label (• code-link-detail)
          (= text #detail)
        )
      )
    )
  )
)
