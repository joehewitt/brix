            is-enabled = #has-selection
            action = => do cut-from-menu()
        <MenuItem "Copy"
            key = copy-key
            is-enabled = #has-selection
            action = => do copy-from-menu()
        <MenuItem "Paste"
            key = paste-key
            action = => do paste-from-menu()

────────────────────
+ do show
    - next CodeSession
    - scroll = Point(0, 0)

clear-link()
bound-rows = null
source = null
region.release-bindings()
shown-generation += 1
. generation = shown-generation
. bound = CodeRowSource(next)
session = next
bound-rows = bound
sticky-rows = CodeStickyRows(next)
language-title = if next.language then next.language.title else "Plain Text"
widest-columns = 0
row-width = null
centers-caret = false
top-goal = null
source = bound
region.restore-scroll(scroll)
scroll-top = scroll.y
refresh()
for revision on next.updated until generation != shown-generation
    session-updated()

