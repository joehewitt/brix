────────────────────
+ do perform
    - command TextCommand
    - extends = false

. active = session
=? if !active
do match command
    | .move-backward
        active.move-left(extends)
    | .move-forward
        active.move-right(extends)
    | .move-word-backward
        active.move-word-left(extends)
    | .move-word-forward
        active.move-word-right(extends)
    | .move-up
        active.move-up(extends)
    | .move-down
        active.move-down(extends)
    | .move-to-line-start
        active.move-to-line-start(extends)
    | .move-to-line-end
        active.move-to-line-end(extends)
    | .move-to-paragraph-start
        active.move-to-line-start(extends)
    | .move-to-paragraph-end
        active.move-to-line-end(extends)
    | .move-to-start
        active.move-to-start(extends)
    | .move-to-end
        active.move-to-end(extends)
    | .page-up
        active.move-up(extends, page-rows())
    | .page-down
        active.move-down(extends, page-rows())
    | .scroll-page-up
        region.scroll-by(Point(0, -page-rows() * row-length))
        =
    | .scroll-page-down
        region.scroll-by(Point(0, page-rows() * row-length))
        =
    | .scroll-to-start
        region.scroll-to-start(Orientation.vertical)
        =
    | .scroll-to-end
        region.scroll-to-end(Orientation.vertical)
        =
    | .delete-backward
        active.delete-backward()
    | .delete-forward
        active.delete-forward()
    | .delete-word-backward
        active.delete-word-backward()
    | .delete-word-forward
        active.delete-word-forward()
    | .delete-to-line-start
        active.delete-to-line-start()
    | .delete-to-line-end
        active.delete-to-line-end()
    | .delete-to-paragraph-end
        active.delete-to-line-end()
    | .insert-newline
        active.newline()
    | .insert-line-break
        active.newline()
    | .insert-tab
        active.insert-tab()
    | .insert-backtab
        active.outdent-lines()
    | .select-all
        active.select-all()
    | .cancel
        active.collapse()
    ??
        =
refresh()

