            if active.folds.is-folded(line)
                canvas.fill-color = $gui-editor-caret-line-number-color
                code-fold-arrow(canvas, arrow-x, middle, false)
            else if is-hover-within && active.can-fold(line)
                canvas.fill-color = $gui-editor-line-number-color
                code-fold-arrow(canvas, arrow-x, middle, true)
    paint-changes(canvas, content, right, changes, scrolled, row-length)

