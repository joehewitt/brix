for fragment in layout.fragments
    if fragment.tag != 1
        continue
    if is-open && abs(fragment.x - high) < 0.5
        high = fragment.x + fragment.width
    else
        if is-open
            canvas.rect(Rect(left + low, content.y, high - low, content.height))
        low = fragment.x
        high = fragment.x + fragment.width
        is-open = true
if is-open
    canvas.rect(Rect(left + low, content.y, high - low, content.height))

