. strip = edge + code-change-offset
canvas.stroke-color = null
for change in changes
    . top = content.y + change.line * row-length - scrolled
    if change.kind == DiffLineChangeKind.deleted
        if top > content.y - code-change-wedge && top < content.bottom + code-change-wedge
            canvas.fill-color = change-color(change.kind)
            canvas.begin()
            canvas.move(strip, top - code-change-wedge)
            canvas.line(strip + code-change-wedge, top)
            canvas.line(strip, top + code-change-wedge)
            canvas.end()
    else
        . bottom = top + change.count * row-length
        if bottom > content.y && top < content.bottom
            canvas.fill-color = change-color(change.kind)
            canvas.rect(Rect(strip, top, code-change-width, bottom - top))

