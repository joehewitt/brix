────────────────────
+ do perform-edit Bool
    - role MenuRole

. active = session
=? false if !active
do match role
    | .undo
        active.undo()
    | .redo
        active.redo()
    | .select-all
        active.select-all()
    ??
        = false
refresh()
= true

────────────────────
_ do press Bool
    - event KeyPressEvent

. active = session
=? false if !active
. role = code-edit-role(event)
=? perform-edit(role) if role
if code-save-key.matches(event)
    save-requested <- active
    = true
if code-comment-key.matches(event)
    active.toggle-comment()
    refresh()
    = true
if code-indent-key.matches(event)
    active.indent-lines()
else if code-outdent-key.matches(event)
    active.outdent-lines()
else
    = false
refresh()
= true

────────────────────
_ do copy-selection Bool
    - clipboard Clipboard

. active = session
=? false if !active || !active.has-selection
= clipboard.write-text(active.selected-text)

────────────────────
for event on pointer-down

if event.button == PointerButton.secondary || control-click
    press-context(event.point)
else if event.button == PointerButton.primary
    request-focus()
    . active = session
    . stuck = stuck-row-at(event.point)
    . folded = fold-target(event.point)
    if active && stuck != null
        active.place(active.folds.actual(stuck), column-at-point(event.point))
        refresh()
    else if active && folded != null
        active.toggle-fold(folded)
        refresh()
    else if active
        . line = line-at-point(event.point)
        if event.click-count >= 3
            active.select-line(min(line, active.line-count - 1))
        else if event.click-count == 2
            active.place(line, column-at-point(event.point))
            active.select-word-at(active.caret)
        else if event.modifiers.command
            active.place(line, column-at-point(event.point))
        else
            active.place(line, column-at-point(event.point), event.modifiers.shift)
        refresh()
        if event.click-count == 1 && event.modifiers.command
            definition-requested <- active.caret
.. control-click = event.button == PointerButton.primary && event.modifiers.control

────────────────────
_ do cut-selection Bool
    - clipboard Clipboard

. active = session
=? false if !active || !copy-selection(clipboard)
active.delete-selection()
refresh()
= true

────────────────────
_ do paste-text Bool
    - clipboard Clipboard

. active = session
. pasted = clipboard.read-text()
=? false if !active || !pasted
active.paste(pasted)
refresh()
= true

────────────────────
_ do cut-from-menu

. ignored = cut-selection(Clipboard())

────────────────────
_ do copy-from-menu

. ignored = copy-selection(Clipboard())

────────────────────
_ do paste-from-menu

. ignored = paste-text(Clipboard())

────────────────────
_ do press-context
    - point Point

request-focus()
context-offset = null
context-link = null
. active = session
=? if !active
. offset = character-at-point(active, point)
. is-selected = offset != null && offset >= active.selection-start && offset < active.selection-end
if !is-selected
    active.place(line-at-point(point), column-at-point(point))
    refresh()
=? if offset == null
context-offset = offset
link-probed <- offset

────────────────────
_ do go-to-context-definition

. active = session
. offset = context-offset
=? if !active || offset == null
active.move-to(offset)
refresh()
definition-requested <- offset

────────────────────
for event on pointer-move

hover-point = event.point
probe(event.modifiers.command)

────────────────────
for event on modifiers-changed

hover-point = event.point
probe(event.modifiers.command)

────────────────────
whenever #is-hover-within

if !is-hover-within
    hover-point = null
    clear-link()

────────────────────
for event on pointer-drag

. active = session
if active
    active.place(line-at-point(event.point), column-at-point(event.point), true)
    refresh()

────────────────────
for event on key-press

. modifiers = event.modifiers
if event.key == Key.tab && !modifiers.command && !modifiers.control && !modifiers.option
    perform(if modifiers.shift then TextCommand.insert-backtab else TextCommand.insert-tab)
    event.cancel()
else if press(event)
    event.cancel()

────────────────────
for event on key-input

session?.type(event.text, event.replaces-before)
refresh()

────────────────────
for event on text-command

perform(event.command, event.extends-selection)

────────────────────
for event on copy

if copy-selection(event.clipboard)
    event.cancel()

────────────────────
for event on cut

if cut-selection(event.clipboard)
    event.cancel()

────────────────────
for event on paste

if paste-text(event.clipboard)
    event.cancel()

────────────────────
for event on focus

invalidate-paint()

────────────────────
for event on blur

invalidate-paint()

────────────────────
_ caret-blink ~>

~> steady
    then blinking on focus

~> blinking on refreshed when is-focused
    then steady on blur
    then steady on closing

    ~> lit
        do invalidate-paint()
        then dim on Timer(code-blink-interval)

    ~> dim
        do invalidate-paint()
        then lit on Timer(code-blink-interval)

────────────────────
for change on overview.chose

request-focus()
jump-to(session?.folds.actual(change.line) ?? change.line)

────────────────────
for event on region.scroll-changed when arrival

clear-link()
scroll-top = event.position.y
invalidate-paint()

────────────────────
_ get row-length Length

row-height as Length

────────────────────
_ do refresh

. active = session
. bound = bound-rows
=? if !active || !bound
active.reveal-anchor()
sync(active, bound)
widen()
reveal-caret(active)
refreshed <- true
if is-focused
    text-input-changed()
invalidate-paint()

────────────────────
_ do session-updated

. active = session
. bound = bound-rows
=? if !active || !bound
sync(active, bound)
widen()
invalidate-paint()

────────────────────
_ do sync
    - active CodeSession
    - bound CodeRowSource

. folds = active.folds
if bound.text-revision != active.revision || bound.fold-version != folds.version
    bound.text-revision = active.revision
    bound.fold-version = folds.version
    bound.revision.bump()
    bound.resize()
    clear-link()
text-revision = active.revision
caret-line = active.caret-line
caret-column = active.caret-column
line-count = active.line-count
row-count = folds.row-count(line-count)
caret-row = folds.shown(caret-line)
fold-version = folds.version + active.revision
row-changes = shown-changes(active)
has-parse-error = active.has-parse-error
is-parsing = active.is-parsing
has-selection = active.has-selection

────────────────────
_ do reveal-caret
    - active CodeSession

. view = region.content-bounds
=? if view.width <= 0 || view.height <= 0
region.scroll-to-address(active.folds.shown(active.caret-line), ScrollAlignment.nearest)
. left = code-text-inset + active.caret-column * cell-width
. x = region.scroll-x
if left - code-text-inset < x
    x = left - code-text-inset
else if left + code-row-padding > x + view.width
    x = left + code-row-padding - view.width
if x != region.scroll-x
    region.scroll-to(Point(x, region.scroll-y))

────────────────────
_ page-rows Size

if count > 1 then count - 1 else 1

.. count = floor(region.content-bounds.height / row-length) as Size

────────────────────
_ do probe
    - is-command Bool

. active = session
. point = hover-point
if !is-command || !active || !point
    clear-link()
    =
. offset = character-at-point(active, point)
if !offset
    clear-link()
    =
. current = link
=? if current && offset >= current.start && offset < current.end
=? if offset == probed
probed = offset
if current
    set-link(null)
link-probed <- offset

────────────────────
_ do clear-link

probed = null
if link
    set-link(null)

────────────────────
_ do set-link
    - found CodeLink?

link = found
has-link = found != null
invalidate-paint()
. active = session
if !found || !active || (found.title.length == 0 && found.detail.length == 0)
    link-card.dismiss()
    =
link-card.title = found.title
link-card.detail = found.detail
link-card.show(PopupAnchor.rect(presentation-rect(link-rect(active, found))))

────────────────────
_ link-rect Rect
    - active CodeSession
    - found CodeLink

Rect(x, y, if high > low then (high - low) * cell-width else 0, row-length)

.. content = text-bounds
.. line = active.text.line-at(found.start)
.. low = active.display-column(found.start)
.. high = active.display-column(found.end)
.. x = content.x + code-text-inset + low * cell-width - region.scroll-x
.. y = content.y + active.folds.shown(line) * row-length - region.scroll-y

────────────────────
_ character-at-point Size?
    - active CodeSession
    - point Point

|? x < 0 || cell-width <= 0
    null
|? row >= active.folds.row-count(active.line-count)
    null
|? offset >= active.text.line-end(line)
    null
??
    offset

.. x = point.x + region.scroll-x - code-text-inset - gutter-width
.. row = row-at-point(point)
.. line = active.folds.actual(row)
.. offset = active.offset-at-column(line, floor(x / cell-width) + 0.25)

────────────────────
_ line-at-point Size
    - point Point

|? !active
    row
|? rows > 0
    active.folds.actual(min(row, rows - 1))
??
    0

.. row = row-at-point(point)
.. active = session
.. rows = active.folds.row-count(active.line-count)

────────────────────
_ row-at-point Size
    - point Point

if y > 0 then floor(y / row-length) as Size else 0

.. y = point.y + region.scroll-y

────────────────────
_ fold-target Size?
    - point Point

|? !active
    null
|? chip != null
    chip
|? point.x < gutter-width - code-fold-width || point.x >= gutter-width
    null
|? row-at-point(point) >= active.folds.row-count(active.line-count)
    null
|? active.folds.is-folded(line) || active.can-fold(line)
    line
??
    null

.. active = session
.. chip = chip-at(point)
.. line = line-at-point(point)

────────────────────
_ chip-at Size?
    - point Point

|? !active || cell-width <= 0
    null
|? x < 0 || row >= active.folds.row-count(active.line-count)
    null
|? !active.folds.is-folded(line)
    null
|? x < start || x > start + code-chip-width
    null
??
    line

.. active = session
.. x = point.x + region.scroll-x - code-text-inset - gutter-width
.. row = row-at-point(point)
.. line = active.folds.actual(row)
.. start = active.line-columns(line) * cell-width + code-chip-gap

────────────────────
_ stuck-rows [CodeStuckRow]

|? !sticky || !active
    List'CodeStuckRow()
??
    code-stuck-rows(sticky, active.folds.row-count(active.line-count), row-length, region.scroll-y)

.. sticky = sticky-rows
.. active = session

────────────────────
_ stuck-row-at Size?
    - point Point

code-stuck-at(stuck-rows(), point.y, row-length)

────────────────────
_ do shown-changes [DiffLineChange]
    - active CodeSession

. folds = active.folds
=? active.line-changes if folds.is-plain
. made [DiffLineChange]
for change in active.line-changes
    . top = folds.shown(change.line)
    if change.kind == DiffLineChangeKind.deleted || change.count == 0
        made += DiffLineChange(change.kind, top, change.count)
    else
        . bottom = folds.shown(change.line + change.count - 1)
        made += DiffLineChange(change.kind, top, bottom - top + 1)
= made

────────────────────
_ column-at-point Float
    - point Point

if x > 0 && cell-width > 0 then x / cell-width else 0

.. x = point.x + region.scroll-x - code-text-inset - gutter-width

────────────────────
_ caret-rect Rect
    - active CodeSession

Rect(x - code-caret-width / 2, y + 1, code-caret-width, row-length - 2)

.. content = text-bounds
.. x = content.x + code-text-inset + active.caret-column * cell-width - region.scroll-x
.. y = content.y + active.folds.shown(active.caret-line) * row-length - region.scroll-y

────────────────────
_ caret-context TextInputContext?

TextInputContext(active.caret-prefix, active.selected-text, caret-rect(active)) if active

.. active = session

────────────────────
_ get text-bounds Rect

Rect(content.x + gutter-width, content.y, content.width - gutter-width, content.height)

.. content = content-bounds

────────────────────
_ do center-caret

=? if !centers-caret
. active = session
. view = region.content-bounds
=? if !active || view.height <= 0
centers-caret = false
. centered-y = active.folds.shown(active.caret-line) * row-length + (row-length - view.height) / 2
region.scroll-to(Point(region.scroll-x, centered-y))

────────────────────
_ do reveal-top

. line = top-goal
. active = session
. view = region.content-bounds
=? if line == null || !active || view.height <= 0
top-goal = null
region.scroll-to(Point(region.scroll-x, active.folds.shown(line) * row-length))

────────────────────
_ do widen

. active = session
=? if !active
. font = Font($font-family, $font-size, $font-weight, $font-slant)
if font != measured-font
    measured-font = font
    cell-width = code-cell-width(font)
    row-height = ceil($font-size * code-row-ratio) as I64
    row-width = null
. widest = max(active.widest-columns, widest-columns)
. width = ceil(max(text-width, region.content-bounds.width)) as I64
    .. text-width = widest * cell-width + code-text-inset + code-row-padding
=? if widest == widest-columns && row-width == width
widest-columns = widest
row-width = width

────────────────────
_ hit-rect Rect
    - active CodeSession
    - hit CodeHit
    - left Length
    - top Length

Rect
    - left + low * cell-width
    - top + active.folds.shown(hit.row) * row-length
    - (high - low) * cell-width
