        . layout = use TextLayout(TextLayoutRequest("${active.folds.actual(row.row) + 1}", font))
        . text-y = y + (row-length - layout.height) / 2
        canvas.text-color = $gui-editor-line-number-color
        canvas.draw-text
            - layout
            - Rect(right - layout.width, text-y, layout.width, layout.height)
            - TextAlignment.left
        canvas.fill-color = $gui-editor-line-number-color
        code-fold-arrow(canvas, arrow-x, y + row-length / 2, true)
    . last = stuck[stuck.length - 1]
    if last.y > (last.row as Length) * row-length - region.scroll-y
