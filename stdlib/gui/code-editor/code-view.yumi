_ do paint-stuck
    - canvas Canvas
    - active CodeSession
    - stuck [CodeStuckRow]

=? if stuck.length == 0
. content = content-bounds
. font = Font($font-family, $font-size, $font-weight, $font-slant)
. right = content.x + gutter-width - code-gutter-gap - code-fold-width
. arrow-x = content.x + gutter-width - code-fold-width / 2
do use canvas.saved-state
    canvas.clip(content)
    canvas.stroke-color = null
    for row in stuck
        . y = content.y + row.y
        canvas.fill-color = $gui-editor-gutter-color
