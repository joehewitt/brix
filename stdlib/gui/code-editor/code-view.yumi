    - y Length
    - row-length Length

for row in stuck
    =? row.row if y >= row.y && y < row.y + row-length
= null

━━━━━━━━━━━━━━━━━━━━
+ code-stuck-height Length
    - stuck [CodeStuckRow]
    - row-length Length

if stuck.length > 0 then max(stuck[stuck.length - 1].y + row-length, 0) else 0

━━━━━━━━━━━━━━━━━━━━
+ do code-fold-arrow
    - canvas Canvas
    - x Length
    - y Length
    - is-open Bool

canvas.begin()
if is-open
    canvas.move(x - code-fold-arrow-size, y - code-fold-arrow-size / 2)
    canvas.line(x + code-fold-arrow-size, y - code-fold-arrow-size / 2)
    canvas.line(x, y + code-fold-arrow-size / 2 + 1)
else
    canvas.move(x - code-fold-arrow-size / 2, y - code-fold-arrow-size)
    canvas.line(x + code-fold-arrow-size / 2 + 1, y)
    canvas.line(x - code-fold-arrow-size / 2, y + code-fold-arrow-size)
canvas.end()

━━━━━━━━━━━━━━━━━━━━
+ do code-fold-chip
    - canvas Canvas
    - x Length
    - y Length
    - height Length
    - fill RGBA
    - dot RGBA

canvas.fill-color = fill
canvas.rect(Rect(x, y + code-chip-inset, code-chip-width, height - code-chip-inset * 2))
canvas.fill-color = dot
. middle = y + height / 2 - code-chip-dot / 2
. spacing = code-chip-width / 4
for index in 1 .. 3
    canvas.rect(Rect(x + spacing * index - code-chip-dot / 2, middle, code-chip-dot, code-chip-dot))

━━━━━━━━━━━━━━━━━━━━
+ code-cell-width Length
    - font Font

layout.natural-width / 10

.. layout = use TextLayout("MMMMMMMMMM", font)
