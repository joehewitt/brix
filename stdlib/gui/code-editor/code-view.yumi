+ do arrange-positioned-children

. content = content-bounds
. right = content.x + content.width - clearance - code-overview-gap
. top-edge = content.y + code-overview-inset
. track = content.height - code-overview-inset * 2
. scale = if track > 0 then track / max(rows * row-length, content.height) else 0
for child in active-children
    if child is CodeOverviewMark
        . mark = child as CodeOverviewMark
        . top = top-edge + mark.line-change.line * row-length * scale
        . height = max(code-overview-mark, mark.line-change.count * row-length * scale)
        if mark.line-change.kind == DiffLineChangeKind.deleted
            top -= code-overview-mark / 2
            height = code-overview-mark
        mark.arrange-outer-bounds
            - Rect
                - right - code-overview-mark-width - code-overview-slop
                - top - code-overview-slop
                - code-overview-mark-width + code-overview-slop
                - height + code-overview-slop * 2
super.arrange-positioned-children()

