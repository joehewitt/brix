. found [CodeStuckRow]
=? found if row-length <= 0
. bottom = top
. reach = top
. headers = List'I64()
while reach >= 0
    . probe = floor(reach / row-length) as Size
    =? found if probe >= row-count
    headers.clear()
    sticky.sticky-headers(probe, headers)
    =? found if headers.length <= found.length || !code-extends-stuck(headers, found)
