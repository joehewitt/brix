+ do paint-self
    - canvas Canvas

. whole = content-bounds
canvas.fill-color = $gui-editor-background-color
canvas.rect(whole)
. active = session
=? if !active || active.line-count == 0
. content = text-bounds
. folds = active.folds
. top = region.scroll-y
. first = if top > 0 then floor(top / row-length) as Size else 0
. last = min
    - folds.row-count(active.line-count)
    - (ceil((top + content.height) / row-length) as Size) + 1
=? if first >= last
. last-line = folds.actual(last - 1)
. left = content.x + code-text-inset - region.scroll-x
. selects = active.has-selection
. selection-start = active.selection-start
. selection-end = active.selection-end
. first-selected = active.text.line-at(selection-start)
. last-selected = active.text.line-at(selection-end)
. finder = find
. hits = if finder then finder.found else List'CodeHit()
. next-hit = if finder then finder.first-at(folds.actual(first)) else 0
. focus-hit = finder.current if finder
do use canvas.saved-state
    canvas.clip(content)
    if !selects
        . y = content.y + folds.shown(active.caret-line) * row-length - top
        canvas.fill-color = $gui-editor-current-line-color
        canvas.rect(Rect(content.x, y, content.width, row-length))
    canvas.fill-color = $gui-editor-find-color
    while next-hit < hits.length && hits[next-hit].row <= last-line
        if next-hit != focus-hit && !folds.is-hidden(hits[next-hit].row)
            canvas.rect(hit-rect(active, hits[next-hit], left, content.y - top))
        next-hit += 1
    if selects
        canvas.fill-color = if is-focused then $gui-editor-selection-color else idle-color
            .. idle-color = $gui-editor-idle-selection-color
        for index in first .. < last
            . line = folds.actual(index)
            if line >= first-selected && line <= last-selected
                . y = content.y + index * row-length - top
                . low = if line == first-selected then active.display-column(selection-start) else 0
                .. line-end = active.line-columns(line) + 1
                .. end-column = active.display-column(selection-end)
                . high = if line == last-selected then end-column else line-end
                if high > low
                    canvas.rect
                        - Rect(left + low * cell-width, y, (high - low) * cell-width, row-length)
    . focused = finder.current-found if finder
    if focused && !folds.is-hidden(focused.row)
        . display = folds.shown(focused.row)
        if display >= first && display < last
            canvas.fill-color = $gui-editor-find-current-color
            canvas.rect(hit-rect(active, focused, left, content.y - top))
    for index in first .. < last
        . line = folds.actual(index)
        if folds.is-folded(line)
            . x = left + active.line-columns(line) * cell-width + code-chip-gap
            . y = content.y + index * row-length - top
            code-fold-chip
                - canvas
                - x
                - y
                - row-length
                - $gui-editor-fold-chip-color
                - $gui-editor-line-number-color

