(import /code)
(import /code/syntax)
(import /math)

(type + CodeVisualRow (is Tuple)
  (prop + line Size)
  (prop + start-offset Size)
  (prop + end-offset Size)
  (prop + start-column Size)
  (prop + end-column Size)
  (prop + is-first Bool)
  (prop + is-last Bool)
)

(type + CodeWrapMap
  (prop + rows (list CodeVisualRow))
  (prop + line-first (list Size))
  (prop + line-counts (list Size))
  (prop + max-columns Size (= 0))
  (prop + revision U64 (= 0))
  (prop + is-built _ (= false))
  (fn-expr + row-count Size :get
    (. rows length)
  )
  (fn-do + rebuild _
    (param session CodeSession)
    (param columns Size)
    (let limit (call max 1 columns))
    (let text (. session text))
    (let tab (. session tab-width))
    (let next-rows (list CodeVisualRow))
    (let next-first (list Size))
    (let next-counts (list Size))
    (for (in line (..< 0 (. text line-count)))
      (let first (. next-rows length))
      (+= next-first first)
      (let start (call (. text line-start) line))
      (let end (call (. text line-end) line))
      (if (== start end)
        (+= next-rows (call CodeVisualRow line start start 0 0 true true))
        (else
          (let seg-start start)
          (let seg-col Size 0)
          (let is-first true)
          (while (< seg-start end)
            (let index seg-start)
            (let column seg-col)
            (let break-index (? Size) null)
            (let break-column Size 0)
            (let wrapped false)
            (while (< index end)
              (let byte (call (. text byte-at) index))
              (let next-index (call (. text next-char) index))
              (let next-column (call code-wrap-advance text index column tab))
              (if (and (> (- next-column seg-col) limit) (> index seg-start))
                (if (!= break-index null)
                  (+= next-rows (call CodeVisualRow line seg-start break-index seg-col break-column is-first false))
                  (= seg-start break-index)
                  (= seg-col break-column)
                  (else
                    (+= next-rows (call CodeVisualRow line seg-start index seg-col column is-first false))
                    (= seg-start index)
                    (= seg-col column)
                  )
                )
                (= is-first false)
                (= wrapped true)
                (break)
              )
              (= index next-index)
              (= column next-column)
              (if (or (== byte code-space) (== byte code-tab))
                (= break-index index)
                (= break-column column)
              )
            )
            (if (not wrapped)
              (+= next-rows (call CodeVisualRow line seg-start end seg-col column is-first true))
              (= seg-start end)
            )
          )
        )
      )
      (+= next-counts (- (. next-rows length) first))
    )
    (= rows next-rows)
    (= line-first next-first)
    (= line-counts next-counts)
    (= max-columns limit)
    (= revision (. session revision))
    (= is-built true)
  )
  (fn-do + visual-row Size
    (param session CodeSession)
    (param offset Size)
    (return-if 0 (if (== (. rows length) 0)))
    (blank)
    (let line (call min (call (. session text line-at) offset) (- (. line-first length) 1)))
    (let first ([] line-first line))
    (let count ([] line-counts line))
    (for (in index (..< first (+ first count)))
      (let row ([] rows index))
      (if (or (. row is-last) (< offset (. row end-offset)))
        (return index)
      )
    )
    (return (if-expr (> (+ first count) 0) (- (+ first count) 1) 0))
  )
  (fn-do + visual-column Size
    (param session CodeSession)
    (param row-index Size)
    (param offset Size)
    (return-if 0 (if (== (. rows length) 0)))
    (blank)
    (let clamped (call min row-index (- (. rows length) 1)))
    (let row ([] rows clamped))
    (let col (call (. session display-column) offset))
    (return (if-expr (>= col (. row start-column)) (- col (. row start-column)) 0))
  )
  (fn-do + offset-at Size
    (param session CodeSession)
    (param row-index Size)
    (param target Float)
    (return-if 0 (if (== (. rows length) 0)))
    (blank)
    (let clamped (call min row-index (- (. rows length) 1)))
    (let row ([] rows clamped))
    (let text (. session text))
    (let tab (. session tab-width))
    (let index (. row start-offset))
    (let end (. row end-offset))
    (let column (. row start-column))
    (while (< index end)
      (let next-column (call code-wrap-advance text index column tab))
      (let left (as (- column (. row start-column)) Float))
      (let right (as (- next-column (. row start-column)) Float))
      (if (> right target)
        (let picked (if-expr (> (- target left) (- right target)) (call (. text next-char) index) index))
        (if (and (not (. row is-last)) (>= picked end) (> end (. row start-offset)))
          (return (call (. text previous-char) end))
        )
        (return picked)
      )
      (= column next-column)
      (= index (call (. text next-char) index))
    )
    (if (and (not (. row is-last)) (> end (. row start-offset)))
      (return (call (. text previous-char) end))
    )
    (return end)
  )
  (fn-expr + row-end-caret Size
    (param session CodeSession)
    (param row-index Size)
    (if-expr (and (not (. row is-last)) (> (. row end-offset) (. row start-offset))) (call (. session text previous-char) (. row end-offset)) (. row end-offset))
    (where
      (lazy clamped (call min row-index (- (. rows length) 1)))
      (lazy row ([] rows clamped))
    )
  )
)

(fn-expr + code-wrap-advance Size
  (param text CodeText)
  (param index Size)
  (param column Size)
  (param tab Size)
  (case? (== byte code-tab)
    (* (+ (/ column tab) 1) tab)
  )
  (case? (< byte 0x80)
    (+ column 1)
  )
  (default
    (+ column (. (as (call (. text codepoint-at) index) Char) display-width))
  )
  (where
    (lazy byte (call (. text byte-at) index))
  )
)

(fn-do + code-slice-runs (list SyntaxStyledRun)
  (param runs (list SyntaxStyledRun))
  (param start-column Size)
  (param end-column Size)
  (let sliced (list SyntaxStyledRun))
  (return-if sliced (if (<= end-column start-column)))
  (blank)
  (let column Size 0)
  (for (in run runs)
    (let raw (. run text))
    (let bytes (call byte-view raw))
    (let length (. bytes size))
    (let index Size 0)
    (let slice-start (? Size) null)
    (let slice-end Size 0)
    (while (< index length)
      (let next-index (call utf8-next bytes length index))
      (let width (call utf8-display-width bytes length index))
      (let next-column (+ column width))
      (if (and (> next-column start-column) (< column end-column))
        (if (== slice-start null)
          (= slice-start index)
        )
        (= slice-end next-index)
      )
      (= column next-column)
      (= index next-index)
      (if (>= column end-column)
        (break)
      )
    )
    (if (and (!= slice-start null) (> slice-end slice-start))
      (+= sliced (call SyntaxStyledRun (call (. bytes slice-string) (..< slice-start slice-end)) (. run role) (. run is-marked)))
    )
    (if (>= column end-column)
      (break)
    )
  )
  (return sliced)
)

(fn-do _ utf8-next Size
  (param bytes (of ImmutableArray Byte))
  (param length Size)
  (param offset Size)
  (let next (+ offset 1))
  (while (and (< next length) (call utf8-is-continuation ([] bytes next)))
    (+= next 1)
  )
  (return next)
)

(fn-do _ utf8-display-width Size
  (param bytes (of ImmutableArray Byte))
  (param length Size)
  (param offset Size)
  (let lead (as ([] bytes offset) U32))
  (return-if 1 (if (< lead 0x80)))
  (blank)
  (let extra Size (if-expr (< lead 0xe0) 1 (if-expr (< lead 0xf0) 2 3)))
  (let value (/and/ lead (if-expr (== extra 1) 0x1f (if-expr (== extra 2) 0x0f 0x07))))
  (for (in index (.. 1 extra))
    (if (< (+ offset index) length)
      (= value (/or/ (/lshift/ value 6) (/and/ (as ([] bytes (+ offset index)) U32) 0x3f)))
    )
  )
  (return (. (as value Char) display-width))
)
