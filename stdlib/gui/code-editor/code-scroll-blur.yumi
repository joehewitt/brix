/graphics/shader-declarations

━━━━━━━━━━━━━━━━━━━━
+ CodeScrollBlur is LayerShader

+ span F64
+ still-top F64
+ still-bottom F64
+ edge F64

────────────────────
+ This
    - span
    - still-top
    - still-bottom
    - edge

────────────────────
+ ¶ metal

float4 filter(float2 position, ShaderLayer layer, CodeScrollBlurArgs args) {
    bool above = position.y < args.still_top;
    bool held = position.x >= layer.size.x - args.edge
        || (position.y >= args.still_top && position.y < args.still_bottom);
    if (held || args.span <= 0.0) {
        return layer.sample(position);
    }
    float pixel = 0.5 / layer.scale;
    float low = (above ? 0.0 : args.still_bottom) + pixel;
    float high = (above ? args.still_top : layer.size.y) - pixel;
    int taps = clamp(int(ceil(args.span * layer.scale * 0.5)), 2, 24);
    float4 sum = float4(0.0);
    for (int i = 0; i < taps; ++i) {
        float t = (float(i) + 0.5) / float(taps) - 0.5;
        float y = clamp(position.y + t * args.span, low, high);
        float4 color = layer.sample(float2(position.x, y));
        sum += float4(color.rgb * color.a, color.a);
    }
    sum /= float(taps);
    float3 color = sum.a > 0.0 ? sum.rgb / sum.a : float3(0.0);
    return float4(color, sum.a);
}
