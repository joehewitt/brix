(import ./code-find-options)
(import /code/code-find)
(import /graphics/primitives)
(import /gui)
(import /gui/icons/lucide/arrow-down)
(import /gui/icons/lucide/arrow-up)
(import /gui/icons/lucide/case-sensitive)
(import /gui/icons/lucide/chevron-right)
(import /gui/icons/lucide/regex)
(import /gui/icons/lucide/replace)
(import /gui/icons/lucide/replace-all)
(import /gui/icons/lucide/whole-word)
(import /gui/icons/lucide/x)
(import /regex)

(type + FindBar (is Box)
  (prop + target (? CodeFindTarget))
  (prop + options FindOptions)
  (prop + is-open _ (= false))
  (prop + is-replacing _ (= false))
  (prop + query _ (= ""))
  (prop + template _ (= ""))
  (prop + summary _ (= ""))
  (prop + is-failing _ (= false))
  (blank)
  (prop _ finder _ (= (call CodeFind)))
  (prop _ origin _ (= (call CodeFindPlace 0 0)))
  (blank)
  (rule This (• flex-col) (• px 8) (• py 4) (• bg gui-panel-color)
    (= focus-mode (. FocusMode inside))
    (= border-color gui-divider-color)
    (= border-bottom-width 1)
    (= (. motion size) gui-motion-quick)
    (= enter-space (. EnterSpace expand))
    (= leave-space (. LeaveSpace collapse))
    (blank)
    (rule find-line (• flex-row) (• h 28))
    (blank)
    (rule find-field (• flex-row) (• flex 1) (• h 24) (• px 6) (• bg gui-field-color)
      (= corner-radius gui-control-radius)
    )
    (blank)
    (rule find-summary (• text gui-muted-text-color) (• w 170) (• ml 8))
    (blank)
    (when-style #is-failing
      (rule find-summary (• text gui-danger-color))
      (rule find-field
        (= animation (shape shake 3))
      )
    )
  )
  (content
    (<> This
      (= display (if-expr #is-open (. Display visible) (. Display hidden)))
      (blank)
      (<> Box (• find-line)
        (<> DisclosureButton (• icon-chevron-right) (• w 22) (• h 22) (• mr 4)
          (= align-y (. Alignment center))
          (= is-open #is-replacing)
          (= action (=> () :do (call toggle-replacing)))
          (<> Tooltip
            (= text (if-expr #is-replacing "Hide Replace" "Show Replace"))
          )
        )
        (<> Box (• find-field)
          (<> TextInput (id: find-input) (• flex 1)
            (= is-bare true)
            (= placeholder "Find")
            (= passes-keys (list (. Key enter) (. Key escape)))
          )
          (<> IconButton (• icon-case-sensitive) (• w 22) (• h 20) (• ml 2)
            (= align-y (. Alignment center))
            (= is-on (. options #matches-case))
            (= action (=> () :do (call toggle-case)))
            (<> Tooltip (text: "Match Case (⌥⌘C)"))
          )
          (<> IconButton (• icon-whole-word) (• w 22) (• h 20) (• ml 2)
            (= align-y (. Alignment center))
            (= is-on (. options #matches-word))
            (= action (=> () :do (call toggle-word)))
            (<> Tooltip (text: "Match Whole Word (⌥⌘W)"))
          )
          (<> IconButton (• icon-regex) (• w 22) (• h 20) (• ml 2)
            (= align-y (. Alignment center))
            (= is-on (. options #is-regex))
            (= action (=> () :do (call toggle-regex)))
            (<> Tooltip (text: "Use Regular Expression (⌥⌘R)"))
          )
        )
        (<> Label (• find-summary)
          (= text #summary)
        )
        (<> IconButton (• icon-arrow-up) (• w 24) (• h 22) (• ml 4)
          (= align-y (. Alignment center))
          (= action (=> () :do (call step false)))
          (<> Tooltip (text: "Previous Match (⇧⌘G)"))
        )
        (<> IconButton (• icon-arrow-down) (• w 24) (• h 22) (• ml 2)
          (= align-y (. Alignment center))
          (= action (=> () :do (call step true)))
          (<> Tooltip (text: "Next Match (⌘G)"))
        )
        (<> IconButton (• icon-x) (• w 24) (• h 22) (• ml 2)
          (= align-y (. Alignment center))
          (= action (=> () :do (call close)))
          (<> Tooltip (text: "Close (Esc)"))
        )
      )
      (<> Box (• find-line) (• mt 2)
        (= display (if-expr #is-replacing (. Display visible) (. Display hidden)))
        (<> Box (• w 26))
        (<> Box (• find-field)
          (<> TextInput (id: replace-input) (• flex 1)
            (= is-bare true)
            (= placeholder "Replace")
            (= passes-keys (list (. Key enter) (. Key escape)))
          )
        )
        (<> IconButton (• icon-replace) (• w 24) (• h 22) (• ml 8)
          (= align-y (. Alignment center))
          (= action (=> () :do (call replace-one)))
          (<> Tooltip (text: "Replace (↩)"))
        )
        (<> IconButton (• icon-replace-all) (• w 24) (• h 22) (• ml 2)
          (= align-y (. Alignment center))
          (= action (=> () :do (call replace-all)))
          (<> Tooltip (text: "Replace All (⌥⌘↩)"))
        )
        (<> Box (• w 200))
      )
      (blank)
      (<> KeyShortcut (text: "Next Match")
        (= key .enter)
        (= discoverable false)
        (= allow-while-input true)
        (= action (=> () :do (call confirm true)))
      )
      (<> KeyShortcut (text: "Previous Match")
        (= key (call KeyCombo "Shift+Enter"))
        (= discoverable false)
        (= allow-while-input true)
        (= action (=> () :do (call confirm false)))
      )
      (<> KeyShortcut (text: "Replace All")
        (= key (call KeyCombo "Option+Cmd+Enter"))
        (= discoverable false)
        (= allow-while-input true)
        (= action (=> () :do (call replace-all)))
      )
      (<> KeyShortcut (text: "Close Find")
        (= key .escape)
        (= discoverable false)
        (= allow-while-input true)
        (= action (=> () :do (call close)))
      )
      (<> KeyShortcut (text: "Match Case")
        (= key (call KeyCombo "Option+Cmd+C"))
        (= discoverable false)
        (= allow-while-input true)
        (= action (=> () :do (call toggle-case)))
      )
      (<> KeyShortcut (text: "Match Whole Word")
        (= key (call KeyCombo "Option+Cmd+W"))
        (= discoverable false)
        (= allow-while-input true)
        (= action (=> () :do (call toggle-word)))
      )
      (<> KeyShortcut (text: "Use Regular Expression")
        (= key (call KeyCombo "Option+Cmd+R"))
        (= discoverable false)
        (= allow-while-input true)
        (= action (=> () :do (call toggle-regex)))
      )
    )
  )
  (subscribe-for (on event (. find-input input))
    (= query (. event text))
    (call rerun)
  )
  (subscribe-for (on event (. replace-input input))
    (= template (. event text))
  )
  (whenever-rule (. options #revision)
    (if is-open
      (call rerun)
      (else
        (call (. finder set-query) (call asked))
      )
    )
  )
  (fn-do + open _
    (param replacing Bool)
    (let host target)
    (if host
      (= origin (call (. host find-origin)))
      (let seed (call (. host find-seed)))
      (if seed
        (= query seed)
        (call (. find-input replace-text) seed)
      )
    )
    (if replacing
      (= is-replacing true)
    )
    (= is-open true)
    (call rerun)
    (call (. find-input request-focus))
    (call (. find-input select-range) 0 (. query length))
  )
  (fn-do + close _
    (return-if (if (not is-open)))
    (blank)
    (= is-open false)
    (let host target)
    (return-if (if (not host)))
    (blank)
    (call (. host find-show) null)
    (call (. host find-focus))
  )
  (fn-do + use-selection _
    (let host target)
    (return-if (if (not host)))
    (blank)
    (let seed (call (. host find-seed)))
    (return-if (if (not seed)))
    (blank)
    (= query seed)
    (call (. find-input replace-text) seed)
    (= origin (call (. host find-origin)))
    (call rerun)
  )
  (fn-do + step _
    (param forward Bool)
    (let host target)
    (return-if (if (not host)))
    (blank)
    (if (not (. finder is-active))
      (call open false)
      (return)
    )
    (if (call (. finder is-stale) host)
      (call (. finder search) host)
    )
    (let hit (. finder current-found))
    (if (and hit (call is-selected hit (call (. host find-selection))))
      (call (. finder step) forward)
      (else-if forward
        (let caret (call (. host find-caret)))
        (call (. finder pick) (. caret row) (. caret column))
      )
      (else
        (let start (call (. host find-origin)))
        (call (. finder pick) (. start row) (. start column))
        (call (. finder step) false)
      )
    )
    (call reveal)
  )
  (fn-do + follow _
    (return-if (if (not is-open)))
    (blank)
    (let host target)
    (return-if (if (or (not host) (not (. finder is-active)) (not (call (. finder is-stale) host)))))
    (blank)
    (call (. finder search) host)
    (call show-summary)
    (call paint)
  )
  (fn-do + reset _
    (call (. finder reset))
    (call follow)
  )
  (fn-do _ confirm _
    (param forward Bool)
    (if (and forward (. replace-input is-focused))
      (call replace-one)
      (else
        (call step forward)
      )
    )
  )
  (fn-do _ toggle-replacing _
    (= is-replacing (not is-replacing))
    (if is-replacing
      (call (. replace-input request-focus))
      (else
        (call (. find-input request-focus))
      )
    )
  )
  (fn-do _ toggle-case _
    (call (. options toggle-case))
  )
  (fn-do _ toggle-word _
    (call (. options toggle-word))
  )
  (fn-do _ toggle-regex _
    (call (. options toggle-regex))
  )
  (fn-expr _ asked (? CodeFindQuery)
    (if-expr (== (. query length) 0) null find-query)
    (where
      (lazy find-query (call CodeFindQuery query (. options matches-case) (. options matches-word) (. options is-regex)))
    )
  )
  (fn-do _ rerun _
    (call (. finder set-query) (call asked))
    (let host target)
    (return-if (if (not host)))
    (blank)
    (call paint)
    (if (. finder is-active)
      (call (. finder search) host)
      (call (. finder pick) (. origin row) (. origin column))
      (call reveal)
      (return)
    )
    (call show-summary)
  )
  (fn-do _ reveal _
    (let hit (. finder current-found))
    (if hit
      (call (?. target find-reveal) hit)
    )
    (call show-summary)
    (call paint)
  )
  (fn-do _ paint _
    (call (?. target find-show) (only-if finder (if is-open)))
  )
  (fn-do _ replace-one _
    (let host target)
    (return-if (if (or (not host) (not (. finder is-active)))))
    (blank)
    (if (call (. finder is-stale) host)
      (call (. finder search) host)
    )
    (let hit (. finder current-found))
    (if (or (not hit) (not (call is-selected hit (call (. host find-selection)))))
      (call step true)
      (return)
    )
    (let made (catch (call (. finder replacement) hit template)))
    (if (is made RegexError)
      (call fail (. (as made RegexError) message))
      (return)
    )
    (let text (as made String))
    (if (not (call (. host find-replace) hit text))
      (call fail "That row can’t be edited")
      (return)
    )
    (call (. finder search) host)
    (call (. finder pick) (. hit row) (+ (. hit start) (. text length)))
    (call reveal)
  )
  (fn-do _ replace-all _
    (let host target)
    (return-if (if (or (not host) (not (. finder is-active)))))
    (blank)
    (let outcome (catch (call (. finder replace-all) host template)))
    (if (is outcome RegexError)
      (call fail (. (as outcome RegexError) message))
      (return)
    )
    (let report (as outcome CodeReplaced))
    (call (. finder search) host)
    (call paint)
    (= summary (call replaced-summary report))
    (= is-failing (or (> (. report held) 0) (> (. report skipped) 0)))
  )
  (fn-do _ fail _
    (param message String)
    (= summary message)
    (= is-failing true)
  )
  (fn-do _ show-summary _
    (let problem (. finder problem))
    (if problem
      (call fail problem)
      (return)
    )
    (let count (. finder found length))
    (let more (if-expr (. finder is-truncated) "+" ""))
    (let index (. finder current))
    (= is-failing (and (. finder is-active) (== count 0)))
    (= summary
      (block
        (case? (not (. finder is-active))
          ""
        )
        (case? (== count 0)
          "No results"
        )
        (case? (== index null)
          (str count more " results")
        )
        (default
          (str (+ index 1) " of " count more)
        )
      )
    )
  )
)

(fn-expr _ is-selected Bool
  (param hit CodeHit)
  (param selected (? CodeHit))
  (case? (not selected)
    false
  )
  (default
    (and (== (. selected row) (. hit row)) (== (. selected start) (. hit start)) (== (. selected end) (. hit end)))
  )
)

(fn-expr _ replaced-summary String
  (param report CodeReplaced)
  (case? (and (== (. report count) 0) (== (. report skipped) 0))
    "Nothing replaced"
  )
  (case? (> (. report skipped) 0)
    (str "Replaced " (. report count) "; " (. report skipped) " rows can’t be edited")
  )
  (case? (> (. report held) 0)
    (str "Replaced " (. report count) "; " (. report held) " rows don’t parse")
  )
  (default
    (str "Replaced " (. report count) " in " (. report rows) " rows")
  )
)
