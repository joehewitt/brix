(import /code/syntax)
(import /core/style)
(import /graphics/color)
(import /gui)

(type + CodeSyntaxStyle (is Style)
  (prop + syntax-plain-color (? RGBA) @inherited)
  (prop + editor-mark-color (? RGBA) @inherited)
  (blank)
  (style-domains syntax-plain-color (domain paint))
  (style-domains editor-mark-color (domain paint))
)

(fn-expr + gui-syntax-role-color RGBA
  (param box Box)
  (param role SyntaxRole)
  (match role
    (case .plain
      (. box $gui-syntax-plain-color)
    )
    (case .comment
      (. box $gui-syntax-comment-color)
    )
    (case .keyword
      (. box $gui-syntax-keyword-color)
    )
    (case .operator
      (. box $gui-syntax-operator-color)
    )
    (case .punctuation
      (. box $gui-syntax-punctuation-color)
    )
    (case .string
      (. box $gui-syntax-string-color)
    )
    (case .escape
      (. box $gui-syntax-escape-color)
    )
    (case .number
      (. box $gui-syntax-number-color)
    )
    (case .constant
      (. box $gui-syntax-constant-color)
    )
    (case .function
      (. box $gui-syntax-function-color)
    )
    (case .type-name
      (. box $gui-syntax-type-color)
    )
    (case .variable
      (. box $gui-syntax-variable-color)
    )
    (case .parameter
      (. box $gui-syntax-parameter-color)
    )
    (case .builtin
      (. box $gui-syntax-builtin-color)
    )
    (case .property
      (. box $gui-syntax-property-color)
    )
    (case .attribute
      (. box $gui-syntax-attribute-color)
    )
    (case .tag
      (. box $gui-syntax-tag-color)
    )
    (case .label
      (. box $gui-syntax-label-color)
    )
    (case .namespace
      (. box $gui-syntax-namespace-color)
    )
    (case .invalid
      (. box $gui-syntax-invalid-color)
    )
  )
)
