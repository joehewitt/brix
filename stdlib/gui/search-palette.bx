(import ./box)
(import ./events)
(import ./keys)
(import ./label)
(import ./match-label)
(import ./placement)
(import ./popup)
(import ./primitives)
(import ./shorthands)
(import ./styles)
(import ./text-input)
(import ./theme)
(import ./virtual)
(import ./window)
(import /core/intrinsics)
(import /core/markup)
(import /data/fuzzy)
(import /graphics/point)
(import /graphics/primitives)
(import /math)
(import /stream/aggregate)
(import /ui/input)
(import /ui/virtual)
(import /ui/virtual-layout)
(import /units)
(blank)
(prop _ palette-overscan-rows VirtualCoord (= 3vcoord))

(style-extend GUIDefaultTheme
  (using GUIBoxPaint)
  (using GUIFocusRingStyle)
  (using GUITextPaint)
  (using GUIBoxSpacing)
  (using GUIBoxSize)
  (using GUIPopupStyle)
  (using GUIVirtualRowStyle)
  (rule Palette (• bg gui-glass-color) (• text gui-text-color) (• p 10) (• w 498) (• h 338)
    (= window-material gui-glass-material)
    (= border-color gui-border-color)
    (= border-width 1)
    (= corner-radius gui-popup-radius)
    (= shadow gui-popup-shadow)
    (= placement (call CenteredPlacement 56))
    (= row-height 25)
    (blank)
    (rule palette-field (• bg gui-glass-well-color) (• text gui-text-color) (• h 28) (• px 8) (• mb 6)
      (= corner-radius gui-control-radius)
    )
    (blank)
    (rule palette-empty (• text gui-muted-text-color) (• h 24) (• px 8))
    (blank)
    (rule palette-notice (• text gui-muted-text-color) (• h 24) (• px 8) (• mt 6))
  )
  (blank)
  (rule PaletteRow (• px 8) (• mb 1)
    (= corner-radius gui-control-radius)
    (blank)
    (when-style #is-highlighted
      (• bg gui-accent-color)
      (• text gui-accent-text-color)
      (blank)
      (rule MatchLabelSpan
        (when-style #is-hit
          (• text gui-accent-text-color)
        )
      )
    )
  )
)

(type + (of PaletteSource Item) (is (fn-type (list Item) (param query String))))

(type + (of Palette Item) (is Popup)
  (using GUIVirtualRowStyle)
  (rule This
    (= focus-mode (. FocusMode inside))
  )
  (blank)
  (prop + prompt _ (= ""))
  (prop + empty-text _ (= ""))
  (prop + notice _ (= ""))
  (prop + query _ (= ""))
  (prop + results (list Item) (= (call (of List Item))))
  (prop + source (? (of PaletteSource Item)))
  (prop + key-builder (? (of MarkupKeyBuilder Item)))
  (prop + takes-keys (list Key) (= (list (. Key arrow-up) (. Key arrow-down))))
  (prop + selected-index Size (= 0))
  (prop + selected-item (? Item) (= (call (of palette-item-at Item) #results #selected-index)))
  (prop + result-source _ (:= (call (of VirtualListSource Item))))
  (blank)
  (event + chosen Item)
  (blank)
  (prop _ applied-query (? String))
  (prop _ selected-key (? String))
  (prop _ follows-selection _ (= false))
  (prop _ is-live _ (= false))
  (content
    (<> This (• flex-col) (• modal)
      (= outside-press-dismiss true)
      (= outside-press-passes false)
      (blank)
      (<> Box (• palette-field) (• flex-row)
        (+<> Box (id: leading) (• flex-row))
        (<> TextInput (id: search-input) (• flex 1)
          (= is-bare true)
          (= placeholder #prompt)
          (= passes-keys #takes-keys)
        )
        (+<> Box (id: trailing) (• flex-row))
      )
      (blank)
      (if (and (== (. #results length) 0) #empty-text)
        (<> Label (• palette-empty)
          (= text #empty-text)
          (= align-y (. Alignment center))
        )
      )
      (blank)
      (<> (of VirtualRegion Item) (id: rows) (• flex 1)
        (= source result-source)
        (= virtual-layout (call VerticalRowLayout))
        (= overscan-rows palette-overscan-rows)
        (blank)
        (<> (of PaletteRow Item) (id: palette-row) (slot: row) (param: slot)
          (= palette this)
          (= item (. slot #item))
          (= index (as (. slot #address) Size))
          (blank)
          (+<> Box (id: row) (param: palette-row (of PaletteRow Item)) (• flex-row) (• flex 1))
        )
      )
      (blank)
      (if #notice
        (<> Label (• palette-notice)
          (= text #notice)
          (= align-y (. Alignment center))
        )
      )
      (blank)
      (<> KeyShortcut (text: "Previous")
        (= key .arrow-up)
        (= discoverable false)
        (= allow-while-input true)
        (= action (=> () :do (call move-selection -1)))
      )
      (<> KeyShortcut (text: "Next")
        (= key .arrow-down)
        (= discoverable false)
        (= allow-while-input true)
        (= action (=> () :do (call move-selection 1)))
      )
      (<> KeyShortcut (text: "First")
        (= key .home)
        (= discoverable false)
        (= allow-while-input true)
        (= action (=> () :do (call select-first)))
      )
      (<> KeyShortcut (text: "Last")
        (= key .end)
        (= discoverable false)
        (= allow-while-input true)
        (= action (=> () :do (call select-last)))
      )
      (<> KeyShortcut (text: "Page Up")
        (= key .page-up)
        (= discoverable false)
        (= allow-while-input true)
        (= action (=> () :do (call move-selection-page -1)))
      )
      (<> KeyShortcut (text: "Page Down")
        (= key .page-down)
        (= discoverable false)
        (= allow-while-input true)
        (= action (=> () :do (call move-selection-page 1)))
      )
      (<> KeyShortcut (text: "Choose")
        (= key .enter)
        (= repeat false)
        (= discoverable false)
        (= allow-while-input true)
        (= action (=> () :do (call choose-selected)))
      )
    )
  )
  (subscribe-for (on event (. search-input input))
    (= query (. event text))
  )
  (whenever-rule #query
    (call apply-query)
  )
  (whenever-rule #results
    (call show-results)
  )
  (fn-do + show _
    (param at (? PopupAnchor) (= null))
    (call reset)
    (call (. super show) at)
  )
  (fn-do + mounted _
    (call (. super mounted))
    (= is-live true)
    (call show-results)
  )
  (fn-do + unmounted _
    (= is-live false)
    (call (. super unmounted))
  )
  (fn-do + reset _
    (call rewrite "")
    (= applied-query null)
    (call apply-query)
  )
  (fn-do + rewrite _
    (param text String)
    (if (!= (. search-input text) text)
      (call (. search-input replace-text) text)
      (call (. search-input select-range) (. text length) (. text length))
    )
    (if (!= query text)
      (= query text)
    )
  )
  (fn-do + refresh _
    (let provider source)
    (if provider
      (= results (call provider query))
    )
  )
  (fn-do + move-selection _
    (param offset Int)
    (let count (. results length))
    (return-if (if (== count 0)))
    (blank)
    (let next (+ (as selected-index Int) offset))
    (= next (call max 0 (call min next (- (as count Int) 1))))
    (call select next)
  )
  (fn-do + move-selection-page _
    (param direction Int)
    (call move-selection (* direction page-row-count))
  )
  (fn-do + select-first _
    (call select 0)
  )
  (fn-do + select-last _
    (let count (. results length))
    (if (> count 0)
      (call select (- count 1))
    )
  )
  (fn-do + select _
    (param index Size)
    (return-if (if (>= index (. results length))))
    (blank)
    (= selected-index index)
    (= selected-key (call key-of ([] results index)))
    (= follows-selection true)
    (call reveal-selection)
  )
  (fn-do + select-key _
    (param key String)
    (= selected-key key)
    (= follows-selection true)
    (let index (call index-of-key key))
    (if (!= index null)
      (= selected-index index)
      (call reveal-selection)
    )
  )
  (fn-do + choose-selected _
    (let index selected-index)
    (return-if (if (>= index (. results length))))
    (blank)
    (call choose ([] results index))
  )
  (fn-do + choose _
    (param item Item)
    (call dismiss (. DismissReason chosen))
    (<- chosen item)
  )
  (fn-do + row-at-index (? (of PaletteRow Item))
    (param index Size)
    (return-if (if (not is-live)))
    (blank)
    (for (in position (..< 0 (. rows pool-size)))
      (let root (call (. rows root-at) position))
      (if (and root (. root slot is-bound) (== (. root slot address) (as index I64)))
        (return
          (match? (. root %first-child)
            (case (: row (of PaletteRow Item))
              row
            )
          )
        )
      )
    )
    (return null)
  )
  (fn-expr _ page-row-count Int :get
    (case? (< count 1)
      1
    )
    (default
      count
    )
    (where
      (lazy count (as (call floor (/ (. rows content-bounds height) (. rows row-extent))) Int))
    )
  )
  (fn-do _ apply-query _
    (return-if (if (== applied-query query)))
    (blank)
    (= applied-query query)
    (= notice "")
    (= selected-index 0)
    (= selected-key null)
    (= follows-selection false)
    (if is-live
      (let ignored (call (. rows scroll-to) (call Point 0 0)))
    )
    (call refresh)
  )
  (fn-do _ show-results _
    (call (. result-source replace) results)
    (let count (. results length))
    (let index selected-index)
    (if (and follows-selection selected-key)
      (= index (?? (call index-of-key selected-key) index))
    )
    (if (== count 0)
      (= index 0)
      (else-if (>= index count)
        (= index (- count 1))
      )
    )
    (if (!= selected-index index)
      (= selected-index index)
    )
    (= selected-key (only-if (call key-of ([] results index)) (if (< index count))))
    (if follows-selection
      (call reveal-selection)
    )
  )
  (fn-expr _ index-of-key (? Size)
    (param key String)
    (call first (in each (..< 0 (. results length)) (when (== (call key-of ([] results each)) key))))
  )
  (fn-expr _ key-of (? String)
    (param item Item)
    (only-if (call builder item) (if builder))
    (where
      (lazy builder key-builder)
    )
  )
  (fn-do _ reveal-selection _
    (return-if (if (not is-live)))
    (blank)
    (let ignored (call (. rows scroll-to-address) selected-index (. ScrollAlignment nearest)))
  )
)

(type + (of PaletteRow Item) (is Box)
  (prop + palette (? (of Palette Item)))
  (prop + item (? Item))
  (prop + index Size (= 0))
  (prop + is-highlighted _ (= (== (?. #palette #selected-index) #index)))
  (blank)
  (rule This (• flex-row)
    (= focus-mode (. FocusMode press))
  )
  (subscribe-for (on event click)
    (let owner palette)
    (let picked item)
    (if (and owner picked)
      (call (. owner choose) picked)
    )
    (call (. event cancel))
  )
)

(fn-expr _ (of palette-item-at Item) (? Item)
  (param items (list Item))
  (param index Size)
  (only-if ([] items index) (if (< index (. items length))))
)
