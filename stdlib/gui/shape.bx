(import ./box)
(import ./primitives)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/outline)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/shader)
(import /math)
(blank)
(prop + default-box-shape _ (= (call OutlineShape)))
(prop _ shape-hit-probe (? RasterCanvas))

(type + BoxShape
  (fn-do + path _
    (param node Box)
    (param rect Rect)
    (param canvas Canvas)
    (call (. canvas move) (. rect x) (. rect y))
    (call (. canvas line) (. rect right) (. rect y))
    (call (. canvas line) (. rect right) (. rect bottom))
    (call (. canvas line) (. rect x) (. rect bottom))
    (call (. canvas enclose))
  )
  (fn-expr + outsets Insets
    (param node Box)
    (call Insets 0 0 0 0)
  )
  (fn-expr + extent Rect
    (param node Box)
    (param rect Rect)
    (call Rect
      (block
        (arg (- (. rect x) (. reach left)))
        (arg (- (. rect y) (. reach top)))
        (arg (+ (. rect width) (. reach left) (. reach right)))
        (arg (+ (. rect height) (. reach top) (. reach bottom)))
      )
    )
    (where
      (lazy reach (call outsets node))
    )
  )
  (fn-expr + exact-outline (? Outline)
    (param node Box)
    (param rect Rect)
    null
  )
  (fn-do + contains Bool
    (param node Box)
    (param rect Rect)
    (param point Point)
    (if (not shape-hit-probe)
      (= shape-hit-probe (call RasterCanvas 1 1 1 transparent))
    )
    (let probe (!! shape-hit-probe))
    (call (. probe begin))
    (call path node rect probe)
    (return (call (. probe path-contains) point))
  )
  (fn-expr + anchor-gap Length :get
    0
  )
  (fn-do + fill _
    (param node Box)
    (param rect Rect)
    (param canvas Canvas)
    (call (. canvas begin))
    (call path node rect canvas)
    (call (. canvas end))
  )
  (fn-do + stroke _
    (param node Box)
    (param rect Rect)
    (param inset Length)
    (param canvas Canvas)
    (call (. canvas begin))
    (call path node (call (. rect pad) inset) canvas)
    (call (. canvas end))
  )
  (fn-do + ring _
    (param node Box)
    (param rect Rect)
    (param width Length)
    (param canvas Canvas)
    (call (. canvas begin))
    (call path node rect canvas)
    (call path node (call (. rect pad) width) canvas)
    (call (. canvas end) false (. FillRule even-odd))
  )
  (fn-do + shadow _
    (param node Box)
    (param rect Rect)
    (param shadow Shadow)
    (param canvas Canvas)
    (call (. canvas begin))
    (call path node rect canvas)
    (call (. canvas shadow-path) shadow)
  )
  (fn-do + clip _
    (param node Box)
    (param rect Rect)
    (param canvas Canvas)
    (call (. canvas begin))
    (call path node rect canvas)
    (call (. canvas clip-path))
  )
  (fn-expr + clips-content Bool :get
    true
  )
  (fn-do + clip-out _
    (param node Box)
    (param rect Rect)
    (param outer Rect)
    (param canvas Canvas)
    (call (. canvas begin))
    (call (. canvas move) (. outer x) (. outer y))
    (call (. canvas line) (. outer right) (. outer y))
    (call (. canvas line) (. outer right) (. outer bottom))
    (call (. canvas line) (. outer x) (. outer bottom))
    (call (. canvas enclose))
    (call path node rect canvas)
    (call (. canvas clip-path) (. FillRule even-odd))
  )
  (fn-do + backdrop _
    (param node Box)
    (param rect Rect)
    (param radius Length)
    (param canvas Canvas)
    (do-use (. canvas saved-state)
      (call clip node rect canvas)
      (call (. canvas backdrop-blur) (call Outline (call extent node rect)) radius)
    )
  )
  (fn-do + backdrop-shader _
    (param node Box)
    (param rect Rect)
    (param backdrop ShaderFilter)
    (param blur Length)
    (param canvas Canvas)
    (do-use (. canvas saved-state)
      (call clip node rect canvas)
      (call (. canvas backdrop-shader) (call Outline (call extent node rect)) backdrop blur)
    )
  )
)

(type + OutlineShape (is BoxShape)
  (fn-expr + outline Outline
    (param node Box)
    (param rect Rect)
    (call Outline rect (. node computed-corner-radius))
  )
  (fn-do + path _
    (param node Box)
    (param rect Rect)
    (param canvas Canvas)
    (call (. canvas outline-path) (call outline node rect))
  )
  (fn-expr + extent Rect
    (param node Box)
    (param rect Rect)
    (. (call outline node rect) extent)
  )
  (fn-expr + exact-outline (? Outline)
    (param node Box)
    (param rect Rect)
    (call outline node rect)
  )
  (fn-expr + contains Bool
    (param node Box)
    (param rect Rect)
    (param point Point)
    (call (. (call outline node rect) contains) point)
  )
  (fn-do + fill _
    (param node Box)
    (param rect Rect)
    (param canvas Canvas)
    (call (. canvas outline) (call outline node rect))
  )
  (fn-do + stroke _
    (param node Box)
    (param rect Rect)
    (param inset Length)
    (param canvas Canvas)
    (call (. canvas outline) (call (. (call outline node rect) grow) (- inset)))
  )
  (fn-do + ring _
    (param node Box)
    (param rect Rect)
    (param width Length)
    (param canvas Canvas)
    (let outer (call outline node rect))
    (call (. canvas begin))
    (call (. canvas outline-path) outer)
    (call (. canvas outline-path) (call (. outer grow) (- width)))
    (call (. canvas end) false (. FillRule even-odd))
  )
  (fn-do + shadow _
    (param node Box)
    (param rect Rect)
    (param shadow Shadow)
    (param canvas Canvas)
    (call (. canvas shadow) (call outline node rect) shadow)
  )
  (fn-do + clip _
    (param node Box)
    (param rect Rect)
    (param canvas Canvas)
    (call (. canvas clip-outline) (call outline node rect))
  )
  (fn-expr + clips-content _ :get
    false
  )
  (fn-do + backdrop _
    (param node Box)
    (param rect Rect)
    (param radius Length)
    (param canvas Canvas)
    (call (. canvas backdrop-blur) (call outline node rect) radius)
  )
  (fn-do + backdrop-shader _
    (param node Box)
    (param rect Rect)
    (param backdrop ShaderFilter)
    (param blur Length)
    (param canvas Canvas)
    (call (. canvas backdrop-shader) (call outline node rect) backdrop blur)
  )
)

(type + CalloutShape (is OutlineShape)
  (prop + size Length (= 8))
  (prop + side Side (= (. Side top)))
  (prop + offset (? Length) (= null))
  (fn-do + This _
    (param callout-size Length (= 8))
    (param callout-side Side (= (. Side top)))
    (param callout-offset (? Length) (= null))
    (= size callout-size)
    (= side callout-side)
    (= offset callout-offset)
  )
  (fn-expr + outline Outline
    (param node Box)
    (param rect Rect)
    (call Outline rect (. node computed-corner-radius) (call OutlineArrow arrow-side arrow-offset size))
    (where
      (lazy arrow-side (?? (. node callout-side) side))
      (lazy span (if-expr (or (== arrow-side (. Side left)) (== arrow-side (. Side right))) (. rect height) (. rect width)))
      (lazy arrow-offset (?? (. node callout-offset) offset (/ span 2)))
    )
  )
  (fn-expr + outsets Insets
    (param node Box)
    (match (?? (. node callout-side) side)
      (case= (. Side top)
        (call Insets size 0 0 0)
      )
      (case= (. Side bottom)
        (call Insets 0 0 size 0)
      )
      (case= (. Side left)
        (call Insets 0 0 0 size)
      )
      (default
        (call Insets 0 size 0 0)
      )
    )
  )
  (fn-expr + anchor-gap _ :get
    size
  )
)
