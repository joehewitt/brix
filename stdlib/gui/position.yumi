━━━━━━━━━━━━━━━━━━━━
+ StickyAnchor
    is ClipWatcher

+ box Box
+ flow Rect
+ stuck Rect

_ host WindowHost?

────────────────────
+ This
    - box

flow = box.bounds
stuck = box.bounds

────────────────────
+ do note-flow

if box.bounds != stuck
    flow = box.bounds

────────────────────
+ do stick

. current = box.window-host
if current as Pointer? != host as Pointer?
    host?.unwatch-clip(this)
    host = current
    current?.watch-clip(this)
=? if !current
box.arrange-bounds(gui-sticky-rect(box, flow))
stuck = box.bounds

────────────────────
+ do release

host?.unwatch-clip(this)
host = null
gui-sticky-forget(this)
if box.bounds == stuck && stuck != flow
    box.arrange-bounds(flow)

╌╌╌╌╌╌╌╌╌╌ is ClipWatcher ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do clip-changed
    - scrolled Box?

if box.window as Pointer? != host as Pointer? || !(box.$position is StickyPosition)
    release()
    =
=? if scrolled && !gui-box-contains(scrolled, box)
note-flow()
stick()

━━━━━━━━━━━━━━━━━━━━
_ do gui-sticky-anchor
    - box Box

for anchor in gui-sticky-anchors
    =? anchor if anchor.box as Pointer == box as Pointer
. made = StickyAnchor(box)
gui-sticky-anchors += made
= made

━━━━━━━━━━━━━━━━━━━━
_ do gui-sticky-forget
    - anchor StickyAnchor

for index in 0 .. < gui-sticky-anchors.length
    if gui-sticky-anchors[index] as Pointer == anchor as Pointer
        gui-sticky-anchors.remove(index)
        =

━━━━━━━━━━━━━━━━━━━━
_ do gui-box-contains
    - ancestor Box
    - box Box

. cursor = box.material-parent
while cursor
    . current = cursor
    =? true if current as Pointer == ancestor as Pointer
    cursor = current.material-parent
= false

━━━━━━━━━━━━━━━━━━━━
_ do gui-sticky-container
    - box Box

. cursor = box.material-parent
while cursor
    . ancestor = cursor
    =? if ancestor.is-presentation-layer
    if !ancestor.is-markup-shadow
        =? ancestor if ancestor.is-scroll-axis-enabled(Orientation.vertical)
        =? ancestor if ancestor.is-scroll-axis-enabled(Orientation.horizontal)
    cursor = ancestor.material-parent

━━━━━━━━━━━━━━━━━━━━
_ do gui-sticky-rect
    - box Box
    - flow Rect

. container = gui-sticky-container(box)
. parent = box.layout-parent
=? flow if !container || !parent
. viewport = container.content-bounds
. scroll = container.scroll-position
. scrolls-parent = parent as Pointer == container as Pointer
. limit = if scrolls-parent then container.scroll-content-bounds else parent.content-bounds
. x = flow.x
. y = flow.y
. left = box.$left
if left
    . pinned = viewport.x + scroll.x + (gui-position-offset-edge(left) ?? 0)
    x = max(flow.x, min(pinned, limit.x + limit.width - flow.width))
. top = box.$top
if top
    . pinned = viewport.y + scroll.y + (gui-position-offset-edge(top) ?? 0)
    y = max(flow.y, min(pinned, limit.y + limit.height - flow.height))
= Rect(x, y, flow.width, flow.height)

━━━━━━━━━━━━━━━━━━━━
+ do gui-sticky-clamp-scroll
    - box Box

=? if !(box.$position is StickyPosition)
. container = gui-sticky-container(box)
=? if !container
. flow = gui-sticky-flow(box)
. viewport = container.content-bounds
. x = container.scroll-x
. y = container.scroll-y
. left = box.$left
if left
    x = min(x, max(0, flow.x - viewport.x - (gui-position-offset-edge(left) ?? 0)))
. top = box.$top
if top
    y = min(y, max(0, flow.y - viewport.y - (gui-position-offset-edge(top) ?? 0)))
container.scroll-to(Point(x, y))

━━━━━━━━━━━━━━━━━━━━
_ do gui-sticky-flow
    - box Box

for anchor in gui-sticky-anchors
    =? anchor.flow if anchor.box as Pointer == box as Pointer
= box.bounds

━━━━━━━━━━━━━━━━━━━━
+ AbsolutePosition is Position

╌╌╌╌╌╌╌╌╌╌ is Position ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ participation
    - parent Box
    - child Box

LayoutParticipation(false, false, true)

────────────────────
+ do arrange
    - parent Box
    - child Box

. anchor = child.anchor-bounds(parent)
. inline-available = absolute-available(anchor.width, child.$left, child.$right)
. block-available = absolute-available(anchor.height, child.$top, child.$bottom)
. intrinsic = child.measure(measure-fit-query(inline-available, block-available)).outer-size
. inline = absolute-axis(anchor.x, anchor.width, intrinsic.width, child.$left, child.$right)
. block = absolute-axis(anchor.y, anchor.height, intrinsic.height, child.$top, child.$bottom)
if child.$align-x && child.$align-x != Alignment.stretch
    inline = absolute-axis-align
        - anchor.x
        - anchor.width
        - intrinsic.width
        - child.$align-x!
        - child.$left
        - child.$right
if child.$align-y && child.$align-y != Alignment.stretch
    block = absolute-axis-align
        - anchor.y
        - anchor.height
        - intrinsic.height
        - child.$align-y!
        - child.$top
        - child.$bottom
child.arrange-outer-bounds(Rect(inline.start, block.start, inline.span, block.span))

━━━━━━━━━━━━━━━━━━━━
_ absolute-available Length
    - span Length
    - near PositionOffset?
    - far PositionOffset?

|? near-edge && far-edge
    gui-safe-span(span - near-edge - far-edge)
??
    gui-safe-span(span)

.. near-edge = gui-position-offset-edge(near)
.. far-edge = gui-position-offset-edge(far)

━━━━━━━━━━━━━━━━━━━━
_ absolute-axis
    - start Length
    - span Length
    - intrinsic Length
    - near PositionOffset?
    - far PositionOffset?

|? near-pin
    absolute-axis-pin(start, span, intrinsic, near-pin)
|? far-pin
    absolute-axis-pin(start, span, intrinsic, far-pin)
|? near && far && near-edge && far-edge
    PositionAxis(start + near-edge, gui-safe-span(span - near-edge - far-edge))
|? near && near-edge
    PositionAxis(start + near-edge, intrinsic)
|? far && far-edge
    PositionAxis(start + span - far-edge - intrinsic, intrinsic)
??
    PositionAxis(start, intrinsic)

.. near-pin = gui-position-offset-pin(near)
.. far-pin = gui-position-offset-pin(far)
.. near-edge = gui-position-offset-edge(near)
.. far-edge = gui-position-offset-edge(far)

━━━━━━━━━━━━━━━━━━━━
_ absolute-axis-pin
    - start Length
    - span Length
    - intrinsic Length
    - pin PositionAxisPin

PositionAxis(start + pin.target * span - pin.source * intrinsic, intrinsic)

━━━━━━━━━━━━━━━━━━━━
_ absolute-axis-align
    - start Length
    - span Length
    - intrinsic Length
    - align Alignment
    - near PositionOffset?
    - far PositionOffset?

PositionAxis(target + offset - source, intrinsic)

.. target = start + align.fraction * span
.. source = align.fraction * intrinsic
.. offset = gui-position-offset-edge(near) ?? -(gui-position-offset-edge(far) ?? 0)

━━━━━━━━━━━━━━━━━━━━
_ gui-position-offset-edge
    - offset PositionOffset?

match? offset
    | PositionOffset.coord(n)
        if is-finite(n) then n else 0

━━━━━━━━━━━━━━━━━━━━
_ gui-position-offset-pin
    - offset PositionOffset?

match? offset
    | PositionOffset.anchor-start
        PositionAxisPin(0%%, 0%%)
    | PositionOffset.anchor-center
        PositionAxisPin(0.5%%, 0.5%%)
    | PositionOffset.anchor-end
        PositionAxisPin(1%%, 1%%)
    | PositionOffset.percent(percent)
        PositionAxisPin(percent, percent)
    | PositionOffset.pin(pin)
        PositionAxisPin
            - pin.source.fraction
            - pin.target.fraction
