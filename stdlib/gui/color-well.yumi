for event on pointer-down

if is-effectively-enabled
    popover.toggle-on-press(event)

────────────────────
for event on click

if is-effectively-enabled
    popover.toggle-on-click(event)
event.cancel()

────────────────────
+ do accept-color
    - next RGBA
    - phase ValueChangePhase = ValueChangePhase.discrete

=? if !is-effectively-enabled
. change = ValueChange'RGBA(color, next, phase)
value-changing <- change
=? if change.is-canceled
color = next
is-mixed = false
value-changed <- ValueChange'RGBA(change.old-value, next, phase)

