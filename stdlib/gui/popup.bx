(import ./box)
(import ./events)
(import ./metal)
(import ./placement)
(import ./primitives)
(import ./scene)
(import ./style-motion)
(import ./styles)
(import ./theme)
(import ./window)
(import /BxAppleGUI/BxAppleGUI.h)
(import /core/markup)
(import /core/style)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/point)
(import /graphics/primitives)
(import /math)
(import /time/duration)
(import /ui/input)

(type + PopupStacking (is Union)
  (variant auto)
  (variant hint)
  (variant manual)
)

(type + PopupFocus (is Union)
  (variant none)
  (variant first)
)

(type + DismissReason (is Union)
  (variant programmatic)
  (variant outside-press)
  (variant escape)
  (variant focus-loss)
  (variant deactivate)
  (variant anchor-hidden)
  (variant ancestor-closed)
  (variant superseded)
  (variant chosen)
  (variant hover-end)
)

(type + PopupAnchor (is Union)
  (variant owner)
  (variant box Box)
  (variant rect Rect)
  (variant point Point)
  (variant pointer)
  (variant window)
)

(type + GUIPopupStyle (is Style)
  (prop + placement (? Placement) (= null))
  (prop + modal _ (= false))
  (prop + pointer-transparent _ (= false))
  (prop + popup-stacking PopupStacking (= (. PopupStacking auto)))
  (prop + popup-focus PopupFocus (= (. PopupFocus none)))
  (prop + outside-press-dismiss _ (= true))
  (prop + outside-press-passes _ (= true))
  (prop + escape-dismiss _ (= true))
  (prop + focus-loss-dismiss _ (= false))
  (prop + deactivate-dismiss _ (= true))
  (prop + anchor-hidden-dismiss _ (= true))
  (prop + hover-trigger _ (= false))
  (prop + hover-delay Seconds (= 0.6s))
  (prop + hover-linger Seconds (= 0.12s))
  (prop + hover-warmth Seconds (= 0.5s))
  (prop + context-trigger _ (= false))
  (blank)
  (style-domains placement (domain layout))
  (style-domains modal (domain layout))
  (style-domains pointer-transparent (domain paint))
)

(style GUIPopupShorthands
  (using GUIPopupStyle)
  (rule below
    (param gap Length (= 4))
    (= placement (call AnchoredPlacement (. Side bottom) (. AnchorPoint start) gap))
  )
  (blank)
  (rule below-matched
    (param gap Length (= 4))
    (= placement (call AnchoredPlacement (. Side bottom) (. AnchorPoint start) gap 0 true))
  )
  (blank)
  (rule below-center
    (param gap Length (= 4))
    (= placement (call AnchoredPlacement (. Side bottom) (. AnchorPoint center) gap))
  )
  (blank)
  (rule below-end
    (param gap Length (= 4))
    (= placement (call AnchoredPlacement (. Side bottom) (. AnchorPoint end) gap))
  )
  (blank)
  (rule above
    (param gap Length (= 4))
    (= placement (call AnchoredPlacement (. Side top) (. AnchorPoint start) gap))
  )
  (blank)
  (rule above-center
    (param gap Length (= 4))
    (= placement (call AnchoredPlacement (. Side top) (. AnchorPoint center) gap))
  )
  (blank)
  (rule beside
    (param gap Length (= 0))
    (= placement (call AnchoredPlacement (. Side right) (. AnchorPoint start) gap))
  )
  (blank)
  (rule beside-center
    (param gap Length (= 8))
    (= placement (call AnchoredPlacement (. Side right) (. AnchorPoint center) gap))
  )
  (blank)
  (rule at-pointer
    (= placement (call PointPlacement))
  )
  (blank)
  (rule follow-pointer
    (= placement (call PointPlacement (call Point 14 18) true))
  )
  (blank)
  (rule cover-anchor
    (= placement (call CoverPlacement))
  )
  (blank)
  (rule centered
    (param top (? Length) (= null))
    (= placement (call CenteredPlacement top))
  )
  (blank)
  (rule fill-window
    (= placement (call FillPlacement))
  )
  (blank)
  (rule corner
    (param corner Corner (= (. Corner bottom-right)))
    (= placement (call CornerPlacement corner))
  )
  (blank)
  (rule modal
    (= modal true)
    (= popup-focus (. PopupFocus first))
    (= outside-press-dismiss false)
  )
  (blank)
  (rule passive
    (= pointer-transparent true)
    (= popup-stacking (. PopupStacking hint))
  )
  (blank)
  (rule transient
    (= popup-focus (. PopupFocus first))
  )
  (blank)
  (rule persistent
    (= popup-stacking (. PopupStacking manual))
    (= outside-press-dismiss false)
    (= escape-dismiss false)
    (= deactivate-dismiss false)
    (= anchor-hidden-dismiss false)
  )
)

(type + Popup (is Box)
  (using GUIPopupStyle)
  (using GUIPopupShorthands)
  (prop + anchor _ (= (. PopupAnchor owner)))
  (prop + placed-side (? Side))
  (prop + arrow-offset Length)
  (prop + open-point Point)
  (prop + opened-by-press _ (= false))
  (prop + holds-popup _ (= false))
  (prop + anchor-origin _ (= (call Point 0.5 0.5)))
  (prop + is-presentation-layer _ (=> true))
  (prop + painted-shadow _ (=> null))
  (prop + presentation-native-host _ (=> (?. presentation host)))
  (prop + presentation-origin _ (=> (. (call popup-presentation-frame this) top-left)))
  (blank)
  (event + opened Popup)
  (event + dismissed DismissReason)
  (blank)
  (prop _ presentation (? PopupPresentation))
  (prop _ presenter (? Window))
  (prop _ return-focus (? Box))
  (prop _ toggled-by-press _ (= false))
  (event _ showing Bool)
  (event _ dismissing DismissReason)
  (content
    (state is-closed
      (then is-open (trigger on showing))
    )
    (state is-open
      (call invalidate-layout)
      (call invalidate-paint)
      (= opened-by-press false)
      (= presenter host-window)
      (call (?. presenter present-popup) this)
      (call begin-entering)
      (<- opened this)
      (blank)
      (then is-closed (trigger for reason dismissing)
        (call invalidate-layout)
        (call invalidate-paint)
        (call (?. (?? host-window presenter) withdraw-popup) this reason)
        (= presenter null)
        (call release-presentation)
        (<- dismissed reason)
      )
    )
  )
  (fn-expr + parent-popup _ :get
    (call (of ancestor Popup))
  )
  (fn-expr + anchor-box (? Box) :get
    (match? anchor
      (case (. PopupAnchor owner)
        layout-parent
      )
      (case (call (. PopupAnchor box) box)
        box
      )
    )
  )
  (fn-expr + placement-focus (? Rect) :get
    null
  )
  (fn-expr + default-placement Placement :get
    (call AnchoredPlacement)
  )
  (fn-do + show _
    (param at (? PopupAnchor) (= null))
    (if at
      (= anchor at)
    )
    (let host host-window)
    (if host
      (= open-point (. host pointer-location))
    )
    (if is-leaving
      (call end-departure)
      (= is-leaving false)
      (call (. gui-style-motion release-held) this)
    )
    (<- showing true)
  )
  (fn-do + show-at _
    (param point Point)
    (call show (call (. PopupAnchor point) point))
  )
  (fn-do + dismiss _
    (param reason _ (= (. DismissReason programmatic)))
    (return-if (if is-leaving))
    (blank)
    (if (and is-open frame-clock (or (call leaves-with-motion) (call markup-holds-departures this)))
      (= is-leaving true)
      (call watch-leaving (=> () :do (call finish-dismissing reason)))
      (return)
    )
    (<- dismissing reason)
  )
  (fn-do _ finish-dismissing _
    (param reason DismissReason)
    (call end-departure)
    (<- dismissing reason)
    (= is-leaving false)
    (call (. gui-style-motion forget) this)
  )
  (fn-do + toggle _
    (if is-open
      (call dismiss)
      (else
        (call show)
      )
    )
  )
  (fn-do + toggle-on-press _
    (param event PointerDownEvent)
    (return-if (if (!= (. event button) (. PointerButton primary))))
    (blank)
    (= toggled-by-press true)
    (call toggle)
  )
  (fn-do + toggle-on-click _
    (param event ClickEvent)
    (if toggled-by-press
      (= toggled-by-press false)
      (else
        (call toggle)
      )
    )
    (call (. event cancel))
  )
  (fn-expr + anchor-rect Rect
    (param host Window)
    (match anchor
      (case (. PopupAnchor owner)
        (?? (call presented-bounds-of layout-parent) (. host bounds))
      )
      (case (call (. PopupAnchor box) box)
        (?? (call presented-bounds-of box) (. host bounds))
      )
      (case (call (. PopupAnchor rect) rect)
        rect
      )
      (case (call (. PopupAnchor point) point)
        (call Rect (. point x) (. point y) 0 0)
      )
      (case (. PopupAnchor pointer)
        (call Rect (. open-point x) (. open-point y) 0 0)
      )
      (default
        (. host bounds)
      )
    )
  )
  (fn-expr + host-window (? Window) :get
    (only-if (as host Window) (if host))
    (where
      (lazy host window)
    )
  )
  (fn-expr + is-anchor-visible _ :get
    (case? (not box)
      true
    )
    (default
      (and (. box is-input-visible) (call (. box is-presentation-visible) (. box bounds)))
    )
    (where
      (lazy box anchor-box)
    )
  )
  (fn-do + accept-placement _
    (param result PlacementResult)
    (param anchor-rect Rect)
    (if (!= placed-side (. result side))
      (= placed-side (. result side))
    )
    (if (!= arrow-offset (. result arrow-offset))
      (= arrow-offset (. result arrow-offset))
    )
    (let placed (. result bounds))
    (let x
      (scope (if-expr (> (. placed width) 0) (call min (call max x-fraction 0.0) 1.0) 0.5)
        (lazy x-fraction (/ (- (+ (. anchor-rect x) (/ (. anchor-rect width) 2)) (. placed x)) (. placed width)))
      )
    )
    (let y
      (scope (if-expr (> (. placed height) 0) (call min (call max y-fraction 0.0) 1.0) 0.5)
        (lazy y-fraction (/ (- (+ (. anchor-rect y) (/ (. anchor-rect height) 2)) (. placed y)) (. placed height)))
      )
    )
    (let side (. result side))
    (let origin (call Point x y))
    (if (== side (. Side bottom))
      (= origin (call Point x 0))
      (else-if (== side (. Side top))
        (= origin (call Point x 1))
      )
      (else-if (== side (. Side right))
        (= origin (call Point 0 y))
      )
      (else-if (== side (. Side left))
        (= origin (call Point 1 y))
      )
    )
    (if (!= anchor-origin origin)
      (= anchor-origin origin)
    )
  )
  (fn-do + remember-return-focus _
    (param box (? Box))
    (= return-focus box)
  )
  (fn-do + remember-return-focus-if-empty _
    (param box (? Box))
    (if (not return-focus)
      (= return-focus box)
    )
  )
  (fn-do + take-return-focus (? Box)
    (let box return-focus)
    (= return-focus null)
    (return box)
  )
  (fn-do + render-presentation LiveFillState
    (param window-native Pointer)
    (param display-scale F64)
    (param zoom F64)
    (param color-space Pointer)
    (param use-metal Bool)
    (param live-time F64)
    (param adds-live-damage Bool)
    (if (not presentation)
      (= presentation (call PopupPresentation window-native))
    )
    (return
      (call (. (!! presentation) render)
        (block
          (arg this)
          (arg display-scale)
          (arg zoom)
          (arg color-space)
          (arg use-metal)
          (arg live-time)
          (arg adds-live-damage)
        )
      )
    )
  )
  (fn-do + ensure-presentation _
    (param window-native Pointer)
    (if (not presentation)
      (= presentation (call PopupPresentation window-native))
    )
  )
  (fn-do + release-presentation _
    (call (?. presentation close))
    (= presentation null)
  )
  (fn-expr + is-displayed _ :get
    (and is-open (!= $display (. Display hidden)))
  )
  (fn-expr + callout-side _ :get
    (?. placed-side opposite)
  )
  (fn-expr + callout-offset _ :get
    (only-if arrow-offset (if placed-side))
  )
  (fn-expr + is-display-visible _ :get
    (and is-open (== $display (. Display visible)))
  )
  (fn-do + mounted _
    (call (. super mounted))
    (call set-theme-tag "glass" false)
    (if is-open
      (= presenter host-window)
      (call (?. presenter present-popup) this)
    )
  )
  (fn-do + unmounted _
    (call (?. (?? host-window presenter) withdraw-popup) this)
    (= presenter null)
    (call release-presentation)
    (call (. super unmounted))
  )
)

(fn-expr + presented-bounds-of (? Rect)
  (param box (? Box))
  (only-if (call (. box presentation-rect) (. box bounds)) (if box))
)

(fn-expr + popup-presentation-frame Rect
  (param popup Box)
  (. popup ink-frame)
)

(type + PopupPresentation
  (prop + native Pointer)
  (prop + host (? Pointer))
  (prop + scene (? DisplayScene))
  (prop + surface (? RasterCanvas))
  (prop + renderer (? MetalOffscreenRenderer))
  (prop + surface-extent Dimensions)
  (prop + surface-scale F64)
  (prop + surface-color-space Pointer)
  (prop + origin Point)
  (prop + is-shown _ (= false))
  (prop _ live-fills _ (= (call LiveFillState false null null)))
  (fn-do + This _
    (param window-native Pointer)
    (= native (call C:brixGuiPopupCreate window-native))
    (= host (call C:brixGuiPopupGetHost native))
  )
  (fn-expr + is-metal _ :get
    (!= renderer null)
  )
  (fn-do + render LiveFillState
    (param popup Popup)
    (param display-scale F64)
    (param zoom F64)
    (param color-space Pointer)
    (param use-metal Bool)
    (param live-time F64)
    (param adds-live-damage Bool)
    (return-if (call LiveFillState false null null) (if (== native (call Pointer))))
    (blank)
    (let frame (call popup-presentation-frame popup))
    (let size (call Dimensions (call max 1 (call ceil (* (. frame width) zoom))) (call max 1 (call ceil (* (. frame height) zoom)))))
    (let extent (call Dimensions (/ (. size width) zoom) (/ (. size height) zoom)))
    (let scale (* display-scale zoom))
    (if (and (not use-metal) renderer)
      (call release-metal)
    )
    (let rendered-metal
      (block
        (and use-metal (call render-metal popup frame extent scale live-time adds-live-damage))
      )
    )
    (let committed (or rendered-metal (call render-canvas popup frame extent scale color-space live-time adds-live-damage)))
    (call C:brixGuiPopupSetFrame native (* (. frame x) zoom) (* (. frame y) zoom) (. size width) (. size height))
    (call C:brixGuiPopupSetShadow native (!= (. popup $shadow) null))
    (call C:brixGuiPopupSetPassesPointer native (. popup $pointer-transparent))
    (if (and committed (not rendered-metal))
      (call C:brixGuiPopupCommitFrame native (. (!! surface) native))
    )
    (if (not is-shown)
      (= is-shown true)
      (call C:brixGuiPopupSetShown native true)
    )
    (return live-fills)
  )
  (fn-do _ render-metal Bool
    (param popup Popup)
    (param frame Rect)
    (param extent Dimensions)
    (param scale F64)
    (param live-time F64)
    (param adds-live-damage Bool)
    (let reset false)
    (if renderer
      (let current renderer)
      (let same-size (and (== (. current width) (. extent width)) (== (. current height) (. extent height))))
      (if (or (not same-size) (!= (. current scale) scale))
        (if (call (. current resize) (. extent width) (. extent height) scale transparent)
          (= reset true)
          (else
            (call release-metal)
          )
        )
      )
    )
    (if (not renderer)
      (call (?. surface close))
      (= surface null)
      (call (?. scene close))
      (= scene null)
      (let candidate (call MetalOffscreenRenderer (. extent width) (. extent height) scale transparent true))
      (if (or (not (. candidate is-available)) (not (call (. candidate attach-popup) native)))
        (call (. candidate close))
        (return false)
      )
      (= renderer candidate)
      (= reset true)
    )
    (let active (!! renderer))
    (if (not scene)
      (= scene (call DisplayScene scale transparent active))
      (= reset true)
    )
    (let live-scene (!! scene))
    (let fill-redraw (call (. active take-fill-redraw)))
    (call maintain-scene live-scene popup frame scale (or reset fill-redraw) live-time adds-live-damage)
    (call (. active set-fill-time) live-time)
    (let encoded (call (. live-scene frame-metal) active))
    (if (and (not encoded) (. live-scene has-damage))
      (call release-metal)
      (return false)
    )
    (return true)
  )
  (fn-do _ render-canvas Bool
    (param popup Popup)
    (param frame Rect)
    (param extent Dimensions)
    (param scale F64)
    (param color-space Pointer)
    (param live-time F64)
    (param adds-live-damage Bool)
    (let recreated false)
    (if (or (not surface) (!= surface-extent extent) (!= surface-scale scale) space-changed)
      (call (?. surface close))
      (= surface (call RasterCanvas extent scale transparent color-space))
      (= surface-extent extent)
      (= surface-scale scale)
      (= surface-color-space color-space)
      (= recreated true)
    )
    (lazy space-changed (!= surface-color-space color-space))
    (if (not scene)
      (= scene (call DisplayScene scale transparent))
    )
    (let live-scene (!! scene))
    (call maintain-scene live-scene popup frame scale recreated live-time adds-live-damage)
    (let replayed (. live-scene frames-replayed))
    (call (. live-scene frame) (!! surface))
    (return (!= (. live-scene frames-replayed) replayed))
  )
  (fn-do _ maintain-scene _
    (param live-scene DisplayScene)
    (param popup Popup)
    (param frame Rect)
    (param scale F64)
    (param is-reset Bool)
    (param live-time F64)
    (param adds-live-damage Bool)
    (call (. live-scene set-live-time) live-time)
    (= (. live-scene origin) (. frame top-left))
    (call (. live-scene maintain) popup scale transparent)
    (if (or is-reset (!= origin (. frame top-left)))
      (call (. live-scene add-damage) frame)
    )
    (= origin (. frame top-left))
    (= live-fills (call (. live-scene damage-live-chunks) frame adds-live-damage))
  )
  (fn-do _ release-metal _
    (call (?. scene close))
    (= scene null)
    (if renderer
      (call (. renderer detach-window) native)
      (call (. (!! renderer) close))
      (= renderer null)
    )
  )
  (fn-do + close _
    (call release-metal)
    (call (?. scene close))
    (= scene null)
    (call (?. surface close))
    (= surface null)
    (if (!= native (call Pointer))
      (call C:brixGuiPopupRelease native)
      (= native (call Pointer))
      (= host null)
    )
  )
)
