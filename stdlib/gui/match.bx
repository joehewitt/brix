(import ./box)
(import /core/markup)
(import /graphics/canvas)
(import /graphics/primitives)
(import /units)
(blank)
(prop + gui-box-matches _ (= (call BoxMatches)))

(type + BoxMatchCover
  (prop + image RasterCanvas)
  (prop + ink Rect)
  (prop + frame Rect)
  (prop + alpha _ (= 1.0))
  (fn-do + This _
    (param image _)
    (param ink _)
    (param frame _)
  )
  (fn-do + paint _
    (param canvas Canvas)
    (param shown Rect)
    (return-if (if (or (<= alpha 0) (<= (. frame width) 0) (<= (. frame height) 0))))
    (blank)
    (let sx (/ (. shown width) (. frame width)))
    (let sy (/ (. shown height) (. frame height)))
    (let rect
      (call Rect
        (block
          (arg (+ (. shown x) (* (- (. ink x) (. frame x)) sx)))
          (arg (+ (. shown y) (* (- (. ink y) (. frame y)) sy)))
          (arg (* (. ink width) sx))
          (arg (* (. ink height) sy))
        )
      )
    )
    (call (. canvas push))
    (call (. canvas begin-opacity) alpha)
    (call (. canvas draw-image) image rect)
    (call (. canvas end-opacity))
    (call (. canvas pop))
  )
  (fn-do + close _
    (call (. image close))
  )
)

(type + BoxMatchDeparture
  (prop + box Box)
  (prop + key String)
  (prop + host WindowHost)
  (prop + frame Rect)
  (prop + is-leaving Bool)
  (prop + cover (? BoxMatchCover))
  (fn-do + This _
    (param box _)
    (param key _)
    (param host _)
    (param frame _)
    (param is-leaving _)
    (param cover _)
  )
)

(type + BoxMatchArrival
  (prop + box Box)
  (prop + key String)
  (prop + host (? WindowHost))
  (prop + cause MarkupCause)
  (fn-do + This _
    (param box _)
    (param key _)
    (param host _)
    (param cause _)
  )
)

(type + BoxMatches
  (prop _ boxes _ (= (call (of List Box))))
  (prop _ departures _ (= (call (of List BoxMatchDeparture))))
  (prop _ arrivals _ (= (call (of List BoxMatchArrival))))
  (fn-do + enlist _
    (param box Box)
    (+= boxes box)
  )
  (fn-do + delist _
    (param box Box)
    (let index Size 0)
    (while (< index (. boxes length))
      (if (== (as ([] boxes index) Pointer) (as box Pointer))
        (call (. boxes remove) index)
        (return)
      )
      (+= index 1)
    )
  )
  (fn-do + add-departure _
    (param departure BoxMatchDeparture)
    (+= departures departure)
  )
  (fn-do + arrive _
    (param box Box)
    (param key String)
    (param cause MarkupCause)
    (+= arrivals (call BoxMatchArrival box key (. box window-host) cause))
  )
  (fn-do + depart-within _
    (param root Box)
    (for (in box boxes)
      (let key (. box match-key))
      (if (and key (call (. box is-within) root))
        (call (. box depart-match) key true)
      )
    )
  )
  (fn-do + arrive-within _
    (param root Box)
    (param cause MarkupCause)
    (for (in box boxes)
      (let key (. box match-key))
      (if (and key (call (. box is-within) root))
        (call arrive box key cause)
      )
    )
  )
  (fn-do + revive-within _
    (param root Box)
    (let index Size 0)
    (while (< index (. departures length))
      (let departure ([] departures index))
      (if (and (. departure is-leaving) (call (. departure box is-within) root))
        (call (?. (. departure cover) close))
        (call (. departures remove) index)
        (else
          (+= index 1)
        )
      )
    )
    (for (in box boxes)
      (if (call (. box is-within) root)
        (call (. box match-reveal))
      )
    )
  )
  (fn-do + resolve _
    (param host WindowHost)
    (return-if (if (and (== (. arrivals length) 0) (== (. departures length) 0))))
    (blank)
    (let leaving (call (of List BoxMatchDeparture)))
    (let index Size 0)
    (while (< index (. departures length))
      (if (== (as (. ([] departures index) host) Pointer) (as host Pointer))
        (+= leaving ([] departures index))
        (call (. departures remove) index)
        (else
          (+= index 1)
        )
      )
    )
    (let coming (call (of List BoxMatchArrival)))
    (= index 0)
    (while (< index (. arrivals length))
      (if (== (as (. ([] arrivals index) host) (? Pointer)) (as host Pointer))
        (+= coming ([] arrivals index))
        (call (. arrivals remove) index)
        (else
          (+= index 1)
        )
      )
    )
    (for (in arrival coming)
      (let found (call latest-departure leaving arrival))
      (if found
        (let cover (. found cover))
        (= (. found cover) null)
        (call (. arrival box fly-from) (. found frame) cover (. arrival cause))
        (if (. found is-leaving)
          (call (. found box match-hide))
        )
      )
    )
    (for (in departure leaving)
      (call (?. (. departure cover) close))
    )
  )
  (fn-do _ latest-departure (? BoxMatchDeparture)
    (param leaving (list BoxMatchDeparture))
    (param arrival BoxMatchArrival)
    (let box (. arrival box))
    (return-if null (if (!= (. box match-key) (. arrival key))))
    (blank)
    (let index (. leaving length))
    (while (> index 0)
      (-= index 1)
      (let departure ([] leaving index))
      (return-if departure (if (and (== (. departure key) (. arrival key)) (!= (as (. departure box) Pointer) (as box Pointer)))))
    )
    (return null)
  )
)
