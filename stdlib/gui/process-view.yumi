./box
./surface-view
/os/env
/os/message-channel
/os/process
/unistd.h

━━━━━━━━━━━━━━━━━━━━
+ ProcessView is SurfaceView

+ path = ""
+ arguments [String]
+ event exited Int
+ event failed Error
_ process Process?

────────────────────
+ do sync

────────────────────
_ do launch ?! Error

. output = C:dup(1)
. variables = environment()
variables[surface-rendezvous-variable] = listen()
. connected = connected-process(path) • args arguments • variables variables • descriptors [output]
    catch failure Error
        C:close(output)
        ?! failure
C:close(output)
. spawned = connected.process
process = spawned
. opened = MessageChannel(connected.socket)
connect(opened, spawned.pid as I32)
sync()
do new
    while true
        . message = opened.receive()
        if !message
            break
        handle(message)
    ended(spawned)

────────────────────
_ do ended
    - program Process

disconnect()
. code = program.wait(null) ?? -1
process = null
exited <- code

╌╌╌╌╌╌╌╌╌╌ is Box ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do mounted

super.mounted()
=? if process || path.length == 0
launch()
    catch failure Error
        failed <- failure

────────────────────
+ do close

process?.kill()
process = null
super.close()
