(import ./box)
(import ./button)
(import ./choice-control)
(import ./events)
(import ./keys)
(import ./primitives)
(import ./shorthands)
(import ./styles)
(import ./theme)
(import /core/list-cursor)
(import /graphics/color)
(import /graphics/primitives)
(import /ui/input)

(style-extend GUIDefaultTheme
  (using GUIBoxCursor)
  (using GUIBoxMotion)
  (using GUIBoxPaint)
  (using GUIBoxSize)
  (using GUIBoxSpacing)
  (using GUIBoxTransform)
  (using GUIFocusRingStyle)
  (using GUITextPaint)
  (rule SegmentedControl (• bg gui-tray-color) (• p 2)
    (= font-size gui-control-font-size)
    (= corner-radius (+ gui-control-radius 2))
    (blank)
    (when-style #is-focus-visible
      (= focus-ring gui-focus-ring)
      (= (. motion focus-ring) gui-motion-quick)
    )
  )
  (blank)
  (rule Segment (• bg transparent) (• text gui-muted-text-color) (• px 10)
    (= min-height (- gui-control-height 4))
    (= max-height (- gui-control-height 4))
    (= shadow null)
    (= cursor (. CursorStyle pointing-hand))
    (blank)
    (when-style #is-untitled
      (• px 6)
      (blank)
      (rule icon (• mr 0))
    )
    (blank)
    (when-style #is-hover-within
      (• bg transparent)
      (• text gui-text-color)
    )
    (blank)
    (when-style #is-press-within
      (• bg transparent)
      (= scale 1)
    )
    (blank)
    (when-style (not #is-effectively-enabled)
      (• bg transparent)
      (= cursor (. CursorStyle arrow))
    )
    (blank)
    (when-style #is-selected
      (• bg gui-raised-color)
      (• text gui-strong-text-color)
      (= shadow gui-control-shadow)
    )
  )
)

(type + (of SegmentedControl T) (is (of ChoiceControl T))
  (rule This
    (= focus-mode (. FocusMode keys))
    (= window-draggable false)
  )
  (blank)
  (prop _ segments (of Descendants (of Segment T)))
  (content
    (<> This (• flex-row)
      (<> KeyShortcut (text: "Next")
        (= key .arrow-right)
        (= discoverable false)
        (= action (=> () :do (call choose-relative 1)))
      )
      (blank)
      (<> KeyShortcut (text: "Previous")
        (= key .arrow-left)
        (= discoverable false)
        (= action (=> () :do (call choose-relative -1)))
      )
      (blank)
      (<> KeyShortcut (text: "First")
        (= key .home)
        (= discoverable false)
        (= action (=> () :do (call choose-edge false)))
      )
      (blank)
      (<> KeyShortcut (text: "Last")
        (= key .end)
        (= discoverable false)
        (= action (=> () :do (call choose-edge true)))
      )
    )
  )
  (fn-do + choose-relative _
    (param offset Int)
    (let choices enabled-segments)
    (let next (call (. (call ListCursor (. choices length) (call selected-index choices)) stepped) offset))
    (if (!= next null)
      (call choose (. ([] choices next) value))
    )
  )
  (fn-do + choose-edge _
    (param last Bool)
    (let choices enabled-segments)
    (return-if (if (== (. choices length) 0)))
    (blank)
    (call choose (if-expr last (. ([] choices (- (. choices length) 1)) value) (. ([] choices 0) value)))
  )
  (fn-expr _ enabled-segments _ :get
    (spread segments)
    (pipe ?> (. each is-effectively-enabled))
    (pipe |> List)
  )
  (fn-do _ selected-index (? Index)
    (param choices (list (of Segment T)))
    (for (in index (..< 0 (. choices length)))
      (return-if index (if (== selected (. ([] choices index) value))))
    )
  )
)

(type + (of Segment T) (is Button)
  (rule This
    (= focus-mode (. FocusMode none))
  )
  (blank)
  (prop + value T)
  (prop + is-selected _ (= (== (?. #control #selected) #value)))
  (blank)
  (prop _ control (of Ancestor (of ChoiceControl T)))
  (fn-do + This _
    (param title _ (= ""))
  )
  (subscribe-for (on event click)
    (if is-effectively-enabled
      (call (?. control choose) value)
      (call (. event cancel))
    )
  )
)
