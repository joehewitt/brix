(import ./box)
(import ./events)
(import ./frame-clock)
(import ./primitives)
(import /graphics/point)
(import /graphics/primitives)
(import /math)
(import /math/motion)
(import /time/duration)
(blank)
(prop _ swipe-lock-distance _ (= 8.0))
(prop _ swipe-commit-fraction _ (= 0.5))
(prop _ swipe-flick-speed _ (= 300.0))
(prop _ swipe-stiffness _ (= 22.0))
(prop _ swipe-motion _ (= (call spring (as (/ (* 2 (as π F64)) swipe-stiffness) Seconds))))
(prop _ swipe-rubber _ (= 0.3))
(prop _ swipe-rubber-reach _ (= 0.15))
(prop _ swipe-velocity-window _ (= 0.1))
(prop _ swipe-rest-distance _ (= 0.5))

(type + SwipeEvent (is GUIEvent)
  (prop + axis Orientation)
  (prop + step Int)
  (fn-do + This _
    (param axis Orientation)
    (param step Int)
    (param data PointerEventData (= (call PointerEventData)))
  )
)

(type + SwipeTracker
  (implements FrameAnimation)
  (prop + box Box)
  (prop + page _ (= (call Dimensions 0 0)))
  (prop + has-previous-x _ (= false))
  (prop + has-next-x _ (= false))
  (prop + has-previous-y _ (= false))
  (prop + has-next-y _ (= false))
  (prop + offset _ (= (call Point 0 0)))
  (prop + axis (? Orientation))
  (prop + is-tracking _ (= false))
  (prop + is-settling _ (= false))
  (event + moved Point)
  (event + landing SwipeEvent)
  (event + turned SwipeEvent)
  (blank)
  (prop _ travel _ (= (call Point 0 0)))
  (prop _ base _ (= 0.0))
  (prop _ is-ignoring _ (= false))
  (prop _ is-coasting _ (= false))
  (prop _ is-caught _ (= false))
  (prop _ times _ (= (call (of List F64))))
  (prop _ places _ (= (call (of List F64))))
  (prop _ target _ (= 0.0))
  (prop _ settling _ (= (call MotionChannel (list 0.0) swipe-rest-distance)))
  (fn-do + This _
    (param box _)
  )
  (fn-expr + is-active Bool :get
    (or is-tracking is-settling)
  )
  (fn-do + handle Bool
    (param event ScrollEvent)
    (let momentum (. event momentum-phase))
    (if (!= momentum (. ScrollPhase none))
      (let swallowed is-coasting)
      (if (or (== momentum (. ScrollPhase ended)) (== momentum (. ScrollPhase cancelled)))
        (= is-coasting false)
      )
      (return swallowed)
    )
    (let phase (. event phase))
    (return-if false (if (== phase (. ScrollPhase none))))
    (return-if is-settling (if (== phase (. ScrollPhase may-begin))))
    (if (== phase (. ScrollPhase began))
      (return-if false (if (not (call start))))
    )
    (return-if false (if (not is-tracking)))
    (if is-ignoring
      (if (or (== phase (. ScrollPhase ended)) (== phase (. ScrollPhase cancelled)))
        (= is-tracking false)
        (= is-ignoring false)
      )
      (return false)
    )
    (if (or (== phase (. ScrollPhase ended)) (== phase (. ScrollPhase cancelled)))
      (call release (. event ordering-time))
      (else
        (call move (. event delta) (. event ordering-time))
      )
    )
    (return true)
  )
  (fn-do + reset _
    (let kept axis)
    (if (and is-settling (!= target 0) (!= kept null))
      (<- landing (call SwipeEvent kept 0))
    )
    (= is-settling false)
    (= is-tracking false)
    (= is-ignoring false)
    (= axis null)
    (= target 0)
    (= offset (call Point 0 0))
  )
  (fn-do _ start Bool
    (if is-settling
      (call catch)
      (return true)
    )
    (return-if false (if (and (not has-previous-x) (not has-next-x) (not has-previous-y) (not has-next-y))))
    (= is-tracking true)
    (= is-caught false)
    (= is-ignoring false)
    (= is-coasting false)
    (= axis null)
    (= offset (call Point 0 0))
    (= base 0)
    (= travel (call Point 0 0))
    (= times (call (of List F64)))
    (= places (call (of List F64)))
    (return true)
  )
  (fn-do _ catch _
    (let kept axis)
    (let is-turning (!= target 0))
    (let remaining (- (call along offset) target))
    (if is-turning
      (call finish)
      (= axis kept)
      (= offset (call placed remaining))
    )
    (= is-settling false)
    (= is-tracking true)
    (= is-caught true)
    (= is-ignoring false)
    (= is-coasting false)
    (= base (if-expr is-turning remaining (call unshape remaining)))
    (= travel (call Point 0 0))
    (= times (call (of List F64)))
    (= places (call (of List F64)))
    (<- moved offset)
  )
  (fn-do _ move _
    (param delta Point)
    (param time F64)
    (= travel (call Point (- (. travel x) (. delta x)) (- (. travel y) (. delta y))))
    (if (== axis null)
      (return-if (if (and (< (call abs (. travel x)) swipe-lock-distance) (< (call abs (. travel y)) swipe-lock-distance))))
      (let wanted
        (scope (if-expr mostly-horizontal (. Orientation horizontal) (. Orientation vertical))
          (lazy mostly-horizontal (>= (call abs (. travel x)) (call abs (. travel y))))
        )
      )
      (if (not (call reaches wanted))
        (= is-ignoring true)
        (return)
      )
      (= axis wanted)
    )
    (let pulled (+ base (call along travel)))
    (= offset (call placed (call shape pulled)))
    (while (and times (> (- time ([] times 0)) (* swipe-velocity-window 2)))
      (call (. times remove) 0)
      (call (. places remove) 0)
    )
    (+= times time)
    (+= places pulled)
    (<- moved offset)
  )
  (fn-do _ release _
    (param time F64)
    (= is-tracking false)
    (= is-coasting true)
    (let kept axis)
    (if (== kept null)
      (= offset (call Point 0 0))
      (<- moved offset)
      (return)
    )
    (let last (- (. times length) 1))
    (let is-stale (or (< last 0) (> (- time ([] times last)) swipe-velocity-window)))
    (let velocity (if-expr is-stale 0.0 (call pace)))
    (let step (call choose (call along offset) velocity span))
    (= target (* (- (as step F64)) span))
    (<- landing (call SwipeEvent kept step))
    (call settle (* velocity (call slope (+ base (call along travel)))))
  )
  (fn-do _ choose Int
    (param current F64)
    (param velocity F64)
    (param extent F64)
    (if (>= (call abs velocity) swipe-flick-speed)
      (return-if 1 (if (and (< velocity 0) (or (<= current 0) is-caught) has-next)))
      (return-if -1 (if (and (> velocity 0) (or (>= current 0) is-caught) has-previous)))
      (return 0)
    )
    (return-if 1 (if (and (<= current (* (- extent) swipe-commit-fraction)) has-next)))
    (return-if -1 (if (and (>= current (* extent swipe-commit-fraction)) has-previous)))
    (return 0)
  )
  (fn-do _ pace F64
    (return-if 0 (if (< (. places length) 2)))
    (let last (- (. times length) 1))
    (let now ([] times last))
    (let index last)
    (while (and (> index 0) (<= (- now ([] times (- index 1))) swipe-velocity-window))
      (-= index 1)
    )
    (let elapsed (- now ([] times index)))
    (return-if 0 (if (<= elapsed 0)))
    (return (/ (- ([] places last) ([] places index)) elapsed))
  )
  (fn-do _ settle _
    (param velocity F64)
    (let drift (- (call along offset) target))
    (let limit (* (call abs drift) swipe-stiffness))
    (let is-toward (== (< velocity 0) (> drift 0)))
    (let speed (if-expr is-toward (call clamp velocity (- limit) limit) velocity))
    (call (. settling jump) (list (call along offset)) (list speed))
    (call (. settling retarget) (list target) swipe-motion (?? (?. (. box frame-clock) now) 0ns))
    (= is-settling true)
    (call (. box animate) this)
  )
  (fn-expr _ span F64 :get
    (if-expr (== axis (. Orientation vertical)) (. page height) (. page width))
  )
  (fn-expr _ has-previous Bool :get
    (if-expr (== axis (. Orientation vertical)) has-previous-y has-previous-x)
  )
  (fn-expr _ has-next Bool :get
    (if-expr (== axis (. Orientation vertical)) has-next-y has-next-x)
  )
  (fn-expr _ reaches Bool
    (param wanted Orientation)
    (if-expr is-vertical (or has-previous-y has-next-y) (or has-previous-x has-next-x))
    (where
      (lazy is-vertical (== wanted (. Orientation vertical)))
    )
  )
  (fn-expr _ along F64
    (param point Point)
    (if-expr (== axis (. Orientation vertical)) (. point y) (. point x))
  )
  (fn-expr _ placed Point
    (param value F64)
    (if-expr (== axis (. Orientation vertical)) (call Point 0 value) (call Point value 0))
  )
  (fn-expr _ shape F64
    (param raw F64)
    (+ (- raw over) (if-expr (< over 0) (- stretch) stretch))
    (where
      (lazy over (call overshoot raw))
      (lazy stretch (call swipe-rubber-band (call abs over) span))
    )
  )
  (fn-expr _ unshape F64
    (param shaped F64)
    (+ (- shaped over) (if-expr (< over 0) (- pull) pull))
    (where
      (lazy over (call overshoot shaped))
      (lazy pull (call swipe-rubber-unband (call abs over) span))
    )
  )
  (fn-expr _ slope F64
    (param raw F64)
    (if-expr (== over 0) 1.0 (call swipe-rubber-slope (call abs over) span))
    (where
      (lazy over (call overshoot raw))
    )
  )
  (fn-expr _ overshoot F64
    (param value F64)
    (case? (and (> value span) has-previous)
      (- value span)
    )
    (case? (and (> value 0) (not has-previous))
      value
    )
    (case? (and (< value (- span)) has-next)
      (+ value span)
    )
    (case? (and (< value 0) (not has-next))
      value
    )
    (default
      0
    )
  )
  (fn-do + advance Bool
    (param tick FrameTick)
    (return-if false (if (not is-settling)))
    (call (. settling update) (. tick now))
    (if (not (. settling is-moving))
      (call finish)
      (return false)
    )
    (= offset (call placed ([] (. settling value) 0)))
    (<- moved offset)
    (return true)
  )
  (fn-do + finish _
    (return-if (if (not is-settling)))
    (= is-settling false)
    (let kept axis)
    (let step (if-expr (< target 0) 1 (if-expr (> target 0) -1 0)))
    (= target 0)
    (= axis null)
    (= offset (call Point 0 0))
    (if (and (!= kept null) (!= step 0))
      (<- turned (call SwipeEvent kept step))
      (else
        (<- moved offset)
      )
    )
  )
)

(fn-expr _ swipe-rubber-band F64
  (param distance F64)
  (param extent F64)
  (case? (<= reach 0)
    0
  )
  (default
    (* (- 1 (/ 1 (+ (/ (* distance swipe-rubber) reach) 1))) reach)
  )
  (where
    (lazy reach (* extent swipe-rubber-reach))
  )
)

(fn-expr _ swipe-rubber-unband F64
  (param stretch F64)
  (param extent F64)
  (case? (<= reach 0)
    0
  )
  (default
    (/ (* reach (- (/ 1 (- 1 (/ (call min stretch (* reach 0.99)) reach))) 1)) swipe-rubber)
  )
  (where
    (lazy reach (* extent swipe-rubber-reach))
  )
)

(fn-expr _ swipe-rubber-slope F64
  (param distance F64)
  (param extent F64)
  (case? (<= reach 0)
    0
  )
  (default
    (/ swipe-rubber (* growth growth))
  )
  (where
    (lazy reach (* extent swipe-rubber-reach))
    (lazy growth (+ (/ (* distance swipe-rubber) reach) 1))
  )
)
