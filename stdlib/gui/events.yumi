+ PointerRecordKind is U32

| move = 0
| down = 1
| up = 2
| drag = 3
| scroll = 4
| exit = 5
| deactivate = 6
| magnify = 7
| cancel = 8
| drop-enter = 9
| drop-over = 10
| drop-exit = 11
| drop = 12
| peer-press = 13

