+ pointer-device-kind-from-native
    - raw U32

match raw
    |= 0
        PointerDeviceKind.mouse
    |= 1
        PointerDeviceKind.pen
    |= 2
        PointerDeviceKind.cursor
    |= 3
        PointerDeviceKind.eraser
    |= 4
        PointerDeviceKind.touch
    ??
        PointerDeviceKind.unknown(raw)

━━━━━━━━━━━━━━━━━━━━
+ pointer-button-from-native
    - raw U32

match raw
    |= 0
        PointerButton.primary
    |= 1
        PointerButton.secondary
    |= 2
        PointerButton.middle
    ??
        PointerButton.other(raw)

━━━━━━━━━━━━━━━━━━━━
+ pointer-device-kind-to-native
    - kind PointerDeviceKind

match kind
    | PointerDeviceKind.mouse
        0u32
    | PointerDeviceKind.pen
        1u32
    | PointerDeviceKind.cursor
        2u32
    | PointerDeviceKind.eraser
        3u32
    | PointerDeviceKind.touch
        4u32
    | PointerDeviceKind.unknown(raw)
        raw

━━━━━━━━━━━━━━━━━━━━
+ pointer-button-to-native
    - button PointerButton

match button
    | PointerButton.primary
        0u32
    | PointerButton.secondary
        1u32
    | PointerButton.middle
        2u32
    | PointerButton.other(raw)
        raw

