━━━━━━━━━━━━━━━━━━━━
+ GUIEvent
    is RoutedEvent

+ data PointerEventData
+ point Point
+ route-frames [GUIEventRouteFrame]
+ route-index Size
+ is-canceled = false
+ root-point => data.root-point
+ pointer-id => data.pointer-id
+ device-kind => data.device-kind
+ modifiers => data.modifiers
+ buttons => data.buttons
+ ordering-time => data.ordering-time

_ route-next GUIEventRouteNext?

────────────────────
+ get hit-box Box?

gc-object-from-pointer'Box(route-frames[0].owner) if route-frames.length > 0

────────────────────
+ get has-own-route Bool

if route-next then true else false

────────────────────
+ do cancel

is-canceled = true

────────────────────
+ do begin-route
    - next GUIEventRouteNext
    - frames [GUIEventRouteFrame]

. saved = GUIEventRouteState(route-next, route-frames, route-index, point)
route-next = next
route-frames = frames
route-index = 0
point = frames[0].point
= saved

────────────────────
+ do end-route
    - saved GUIEventRouteState

route-next = saved.next
route-frames = saved.frames
route-index = saved.index
point = saved.point

────────────────────
+ do advance-route
    - index Size
    - next-point Point

route-index = index
point = next-point

────────────────────
+ do next-event-owner
    - current Pointer

=? if !route-next
= route-next(this as Pointer, current)

