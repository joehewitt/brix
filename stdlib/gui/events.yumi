━━━━━━━━━━━━━━━━━━━━
+ text-command-event TextCommandEvent
    - selector String

TextCommandEvent(text-command-from-selector(base), extends, selector)

.. suffix = "AndModifySelection:"
.. extends = selector.length > suffix.length && selector.ends-with(suffix)
.. base = if extends then "${selector[0 .. < selector.length - suffix.length]}:" else selector

━━━━━━━━━━━━━━━━━━━━
+ text-command-from-selector TextCommand
    - selector String

match selector
    |= "moveLeft:"
        TextCommand.move-backward
    |= "moveBackward:"
        TextCommand.move-backward
    |= "moveRight:"
        TextCommand.move-forward
    |= "moveForward:"
        TextCommand.move-forward
    |= "moveUp:"
        TextCommand.move-up
    |= "moveDown:"
        TextCommand.move-down
    |= "moveWordLeft:"
        TextCommand.move-word-backward
    |= "moveWordBackward:"
        TextCommand.move-word-backward
    |= "moveWordRight:"
        TextCommand.move-word-forward
    |= "moveWordForward:"
        TextCommand.move-word-forward
    |= "moveToLeftEndOfLine:"
        TextCommand.move-to-line-start
    |= "moveToBeginningOfLine:"
        TextCommand.move-to-line-start
    |= "moveToRightEndOfLine:"
        TextCommand.move-to-line-end
    |= "moveToEndOfLine:"
        TextCommand.move-to-line-end
    |= "moveToBeginningOfParagraph:"
        TextCommand.move-to-paragraph-start
    |= "moveParagraphBackward:"
        TextCommand.move-to-paragraph-start
    |= "moveToEndOfParagraph:"
        TextCommand.move-to-paragraph-end
    |= "moveParagraphForward:"
        TextCommand.move-to-paragraph-end
    |= "moveToBeginningOfDocument:"
        TextCommand.move-to-start
    |= "moveToEndOfDocument:"
        TextCommand.move-to-end
    |= "pageUp:"
        TextCommand.page-up
    |= "pageDown:"
        TextCommand.page-down
    |= "scrollToBeginningOfDocument:"
        TextCommand.scroll-to-start
    |= "scrollToEndOfDocument:"
        TextCommand.scroll-to-end
    |= "scrollPageUp:"
        TextCommand.scroll-page-up
    |= "scrollPageDown:"
        TextCommand.scroll-page-down
    |= "deleteBackward:"
        TextCommand.delete-backward
    |= "deleteBackwardByDecomposingPreviousCharacter:"
        TextCommand.delete-backward
    |= "deleteForward:"
        TextCommand.delete-forward
    |= "deleteWordBackward:"
        TextCommand.delete-word-backward
    |= "deleteWordForward:"
        TextCommand.delete-word-forward
    |= "deleteToBeginningOfLine:"
        TextCommand.delete-to-line-start
    |= "deleteToEndOfLine:"
        TextCommand.delete-to-line-end
    |= "deleteToEndOfParagraph:"
        TextCommand.delete-to-paragraph-end
    |= "insertNewline:"
        TextCommand.insert-newline
    |= "insertLineBreak:"
        TextCommand.insert-line-break
    |= "insertNewlineIgnoringFieldEditor:"
        TextCommand.insert-line-break
    |= "insertTab:"
        TextCommand.insert-tab
    |= "insertTabIgnoringFieldEditor:"
        TextCommand.insert-tab
    |= "insertBacktab:"
        TextCommand.insert-backtab
    |= "cancelOperation:"
        TextCommand.cancel
    |= "complete:"
        TextCommand.complete
    |= "transpose:"
        TextCommand.transpose
    |= "selectAll:"
        TextCommand.select-all
    ??
        TextCommand.other(selector)

