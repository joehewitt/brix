+ window-drag-token U64

────────────────────
+ get data PointerEventData

PointerEventData
    - point
    - pointer-id
    - pointer-device-kind-from-native(device-kind)
    - pointer-modifiers-from-native(modifier-bits)
    - buttons
    - ordering-time

────────────────────
+ get pointer-button PointerButton

pointer-button-from-native(button)

━━━━━━━━━━━━━━━━━━━━
+ pointer-modifiers-from-native
    - raw U64

PointerModifiers
    - (raw /and/ 1) != 0
    - (raw /and/ 2) != 0
    - (raw /and/ 4) != 0
    - (raw /and/ 8) != 0
    - (raw /and/ 16) != 0
    - (raw /and/ 32) != 0

━━━━━━━━━━━━━━━━━━━━
+ key-from-native
    - raw U32
    - native-key-code U32

match raw
    |= 1
        Key.tab
    |= 2
        Key.enter
    |= 3
        Key.escape
    |= 4
        Key.space
    |= 5
        Key.arrow-up
    |= 6
        Key.arrow-down
    |= 7
        Key.arrow-left
    |= 8
        Key.arrow-right
    |= 9
        Key.home
    |= 10
        Key.end
    |= 11
        Key.page-up
    |= 12
        Key.page-down
    |= 13
        Key.backspace
    |= 14
        Key.delete
    |? raw >= 100 && raw <= 115
        Key.function-key(raw - 99)
    ??
        Key.unknown(native-key-code)

━━━━━━━━━━━━━━━━━━━━
+ key-to-native
    - key Key

match key
    | Key.tab
        1u32
    | Key.enter
        2u32
    | Key.escape
        3u32
    | Key.space
        4u32
    | Key.arrow-up
        5u32
    | Key.arrow-down
        6u32
    | Key.arrow-left
        7u32
    | Key.arrow-right
        8u32
    | Key.home
        9u32
    | Key.end
        10u32
    | Key.page-up
        11u32
    | Key.page-down
        12u32
    | Key.backspace
        13u32
    | Key.delete
        14u32
    | Key.function-key(index)
        index + 99
    ??
        0u32

━━━━━━━━━━━━━━━━━━━━
+ pointer-modifiers-to-native
    - modifiers PointerModifiers

shift-bit /or/ control-bit /or/ option-bit /or/ command-bit /or/ caps-lock-bit /or/ function-bit

.. shift-bit = if modifiers.shift then 1u64 else 0u64
.. control-bit = if modifiers.control then 2u64 else 0u64
.. option-bit = if modifiers.option then 4u64 else 0u64
.. command-bit = if modifiers.command then 8u64 else 0u64
.. caps-lock-bit = if modifiers.caps-lock then 16u64 else 0u64
.. function-bit = if modifiers.function then 32u64 else 0u64
