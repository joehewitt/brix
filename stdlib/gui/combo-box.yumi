+ ComboBox is Box

• This
    focus-mode = FocusMode.inside

+ suggestions [String] = List'String()
+ placeholder = ""
+ text = ""
+ value = ""
+ highlighted-index Index?
+ matches [String] = combo-matches(#suggestions, #text)
+ highlighted-match String? = combo-highlighted-match(#matches, #highlighted-index)
+ event value-changing ValueChange'String
+ event value-changed ValueChange'String

────────────────────

<This • flex-col
    <TextInput field • flex:1
        placeholder = #placeholder
        text = #text
    <ComboSuggestions suggestions-popup • flex-col
        for match in #matches
            <ComboRow
                value = match
    <KeyShortcut "Next suggestion"
        key = .arrow-down
        discoverable = false
        allow-while-input = true
        action = => do move-highlight(1)
    <KeyShortcut "Previous suggestion"
        key = .arrow-up
        discoverable = false
        allow-while-input = true
        action = => do move-highlight(-1)
    <KeyShortcut "Accept suggestion"
        key = .enter
        repeat = false
        discoverable = false
        allow-while-input = true
        action = => do accept-highlighted()

────────────────────
for event on field.input

text = event.text
highlighted-index = null
if combo-matches(suggestions, text).length > 0
    suggestions-popup.show()
else
    suggestions-popup.dismiss()

────────────────────
+ do move-highlight
    - offset Int

. count = combo-matches(suggestions, text).length
=? if count == 0
if !suggestions-popup.is-open
    suggestions-popup.show()
highlighted-index = ListCursor(count, highlighted-index).wrapped(offset)

────────────────────
+ do highlight
    - match String

. current = combo-matches(suggestions, text)
for index in 0 .. < current.length
    if current[index] == match
        highlighted-index = index
        =

────────────────────
+ do accept-highlighted

accept(combo-highlighted-match(combo-matches(suggestions, text), highlighted-index) ?? text)

────────────────────
+ do accept
    - candidate String

. old = value
if candidate != old
    . change = ValueChange'String(old, candidate)
    value-changing <- change
    =? if change.is-canceled
text = candidate
value = candidate
highlighted-index = null
suggestions-popup.dismiss(DismissReason.chosen)
=? if candidate == old
value-changed <- ValueChange'String(old, candidate)

