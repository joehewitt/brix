(import ./box)
(import ./events)
(import ./keys)
(import ./label)
(import ./position)
(import ./primitives)
(import ./shorthands)
(import ./styles)
(import ./text-input)
(import ./theme)
(import /core/patterns)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/text)
(import /math)
(import /ui/input)
(import /ui/key-combo)
(import /ui/value-change-phase)

(style-extend GUIDefaultTheme
  (using GUIBoxCursor)
  (using GUIBoxMotion)
  (using GUIBoxPaint)
  (using GUIBoxSize)
  (using GUIBoxSpacing)
  (using GUIFocusRingStyle)
  (using GUIFontStyle)
  (using GUITextPaint)
  (rule NumberField (• bg gui-field-color) (• text gui-text-color) (• h gui-control-height) (• pl 2) (• pr 6)
    (= font-size gui-control-font-size)
    (= corner-radius gui-control-radius)
    (= shadow gui-control-shadow)
    (blank)
    (when-style #is-focus-within
      (= focus-ring gui-focus-ring)
      (= (. motion focus-ring) gui-motion-quick)
    )
    (when-style #is-read-only
      (rule NumberFieldScrubber
        (= cursor (. CursorStyle arrow))
        (= drag-cursor null)
        (blank)
        (rule Box
          (= drag-cursor null)
        )
      )
    )
    (blank)
    (rule number-field-entry
      (= min-height (- gui-control-height 2))
      (= max-height (- gui-control-height 2))
    )
  )
  (blank)
  (rule NumberFieldUnit (• text gui-muted-text-color) (• ml 2)
    (= font-size gui-footnote-font-size)
    (blank)
    (when-style #is-scrubbable
      (= cursor (. CursorStyle resize-horizontal))
      (= drag-cursor (. CursorStyle resize-horizontal))
    )
  )
  (blank)
  (rule NumberFieldScrubber (• text gui-muted-text-color) (• w 18) (• h 18) (• mr 2)
    (= cursor (. CursorStyle resize-horizontal))
    (= drag-cursor (. CursorStyle resize-horizontal))
    (blank)
    (rule Box
      (= drag-cursor (. CursorStyle resize-horizontal))
    )
  )
)

(type + NumberField (is Box)
  (prop + value F64)
  (prop + minimum (? F64))
  (prop + maximum (? F64))
  (prop + step F64 (= 1))
  (prop + scrub-step (? F64))
  (prop + snaps _ (= false))
  (prop + precision Size (= 2))
  (prop + label _ (= ""))
  (prop + unit _ (= ""))
  (prop + placeholder _ (= ""))
  (prop + is-mixed _ (= false))
  (prop + is-read-only _ (= false))
  (prop + is-scrubbable _ (= true))
  (prop + scrub-handle _ (= (. NumberFieldScrubHandle label)))
  (prop + live-edit-delay _ (= gui-live-edit-delay))
  (blank)
  (rule This
    (= focus-mode (. FocusMode inside))
  )
  (event + value-changing (of ValueChange F64))
  (event + value-changed (of ValueChange F64))
  (blank)
  (prop _ is-live-applying _ (= false))
  (prop _ edit-origin F64)
  (blank)
  (depends displayed-value-changed value is-mixed precision)
  (content
    (<> This (• flex-row)
      (<> NumberFieldScrubber (id: scrubber) (• flex-row)
        (= align-y (. Alignment center))
        (= display
          (block
            (case? (and #is-scrubbable (== #scrub-handle (. NumberFieldScrubHandle label)))
              (. Display visible)
            )
            (default
              (. Display hidden)
            )
          )
        )
        (+<> Box (id: icon) (• flex-row) (• flex 1)
          (<> Label (• flex 1)
            (= text-alignment (. TextAlignment center))
            (= text #label)
          )
        )
      )
      (<> TextInput (id: entry) (• number-field-entry) (• flex 1)
        (= is-bare true)
        (= align-y (. Alignment center))
        (= text (call number-field-display-text #value #precision #is-mixed))
        (= placeholder (if-expr #is-mixed "Mixed" #placeholder))
        (= is-read-only #is-read-only)
        (= live-edit-delay #live-edit-delay)
        (for (on event input)
          (call (. event cancel))
        )
        (for (on event text-selected)
          (call (. event cancel))
        )
        (for (on event text-edited)
          (call accept-edit (. event text) (. event phase))
          (call (. event cancel))
        )
        (for (on event change)
          (call accept-text (. event text))
          (call (. event cancel))
        )
      )
      (if (. #unit length)
        (<> NumberFieldUnit (id: unit-label)
          (= text #unit)
          (= align-y (. Alignment center))
          (= is-scrubbable
            (block
              (and #is-scrubbable (not #is-read-only) (== #scrub-handle (. NumberFieldScrubHandle unit)))
            )
          )
        )
      )
      (<> KeyShortcut (text: "Increment")
        (= key .arrow-up)
        (= discoverable false)
        (= allow-while-input true)
        (= enabled (not #is-read-only))
        (= action (=> () :do (call step-from-entry 1)))
      )
      (<> KeyShortcut (text: "Decrement")
        (= key .arrow-down)
        (= discoverable false)
        (= allow-while-input true)
        (= enabled (not #is-read-only))
        (= action (=> () :do (call step-from-entry -1)))
      )
      (<> KeyShortcut (text: "Increment by ten")
        (= key (+ (. KeyModifier shift) (. Key arrow-up)))
        (= discoverable false)
        (= allow-while-input true)
        (= enabled (not #is-read-only))
        (= action (=> () :do (call step-from-entry 10)))
      )
      (<> KeyShortcut (text: "Decrement by ten")
        (= key (+ (. KeyModifier shift) (. Key arrow-down)))
        (= discoverable false)
        (= allow-while-input true)
        (= enabled (not #is-read-only))
        (= action (=> () :do (call step-from-entry -10)))
      )
      (<> KeyShortcut (text: "Page Up")
        (= key .page-up)
        (= discoverable false)
        (= allow-while-input true)
        (= enabled (not #is-read-only))
        (= action (=> () :do (call step-from-entry 10)))
      )
      (<> KeyShortcut (text: "Page Down")
        (= key .page-down)
        (= discoverable false)
        (= allow-while-input true)
        (= enabled (not #is-read-only))
        (= action (=> () :do (call step-from-entry -10)))
      )
      (<> KeyShortcut (text: "Revert")
        (= key .escape)
        (= discoverable false)
        (= allow-while-input true)
        (= when (=> () is-entry-dirty))
        (= action (=> () :do (call revert-entry)))
      )
    )
  )
  (fn-expr + is-entry-dirty Bool :get
    (or is-live-applying (!= (. entry text) (call number-field-display-text value precision is-mixed)))
  )
  (fn-do + accept-text _
    (param text String)
    (let parsed (call parse-decimal text))
    (if parsed
      (call accept-value parsed)
    )
    (= (. entry text) (call number-field-display-text value precision (and is-mixed (not parsed))))
  )
  (fn-do + accept-edit _
    (param text String)
    (param phase ValueChangePhase)
    (let parsed (call parse-decimal text))
    (if (== phase (. ValueChangePhase ended))
      (if is-live-applying
        (= is-live-applying false)
        (call accept-value (?? parsed value) (. ValueChangePhase ended))
        (else-if parsed
          (call accept-value parsed)
        )
      )
      (= (. entry text) (call number-field-display-text value precision (and is-mixed (not parsed))))
      (return)
    )
    (return-if (if (not parsed)))
    (let live-phase (if-expr is-live-applying (. ValueChangePhase changed) (. ValueChangePhase began)))
    (if (not is-live-applying)
      (= edit-origin value)
    )
    (= is-live-applying true)
    (call accept-value parsed live-phase)
  )
  (fn-do + accept-value _
    (param candidate F64)
    (param phase ValueChangePhase (= (. ValueChangePhase discrete)))
    (return-if (if (or (not is-effectively-enabled) is-read-only)))
    (let next (call normalized candidate))
    (let old value)
    (let unchanged (and (== next old) (not is-mixed)))
    (return-if (if (and unchanged (or (== phase (. ValueChangePhase discrete)) (== phase (. ValueChangePhase changed))))))
    (if (not unchanged)
      (let change (call (of ValueChange F64) old next phase))
      (<- value-changing change)
      (if (. change is-canceled)
        (= (. entry text) (call number-field-display-text value precision is-mixed))
        (return)
      )
    )
    (= value next)
    (= (. entry text) (call number-field-display-text next precision false))
    (<- value-changed (call (of ValueChange F64) old next phase))
  )
  (fn-do + step-by _
    (param steps F64)
    (param phase ValueChangePhase (= (. ValueChangePhase discrete)))
    (call accept-value (+ value (* steps step)) phase)
  )
  (fn-do + step-from-entry _
    (param steps F64)
    (let base (?? (call parse-decimal (. entry text)) value))
    (call accept-value (+ base (* steps step)))
    (call (. entry replace-text) (call number-field-display-text value precision false))
  )
  (fn-do + revert-entry _
    (if is-live-applying
      (= is-live-applying false)
      (call accept-value edit-origin (. ValueChangePhase ended))
    )
    (call (. entry replace-text) (call number-field-display-text value precision is-mixed))
  )
  (fn-expr + normalized F64
    (param candidate F64)
    (call number-field-round stepped precision)
    (where
      (lazy lower (if-expr minimum (call max candidate minimum) candidate))
      (lazy bounded (if-expr maximum (?? (call min lower maximum) lower) lower))
      (lazy snapped (call number-field-stepped bounded step (?? minimum 0.0) maximum))
      (lazy stepped (if-expr (and snaps (> step 0)) snapped bounded))
    )
  )
  (fn-do _ displayed-value-changed _
    (= (. entry text) (call number-field-display-text value precision is-mixed))
  )
)

(type + NumberFieldScrubHandle (is Union)
  (variant label)
  (variant unit)
)

(type + NumberFieldScrubber (is Box)
  (prop _ scrub _ (= (call NumberFieldScrub)))
  (subscribe-for (on event pointer-down)
    (call (. scrub begin) this event)
  )
  (subscribe-for (on event pointer-drag)
    (call (. scrub drag) this event)
  )
  (subscribe-for (on event pointer-up)
    (call (. scrub end) this event)
  )
)

(type + NumberFieldUnit (is Label)
  (prop + is-scrubbable _ (= false))
  (blank)
  (prop _ scrub _ (= (call NumberFieldScrub)))
  (subscribe-for (on event pointer-down)
    (if is-scrubbable
      (call (. scrub begin) this event)
    )
  )
  (subscribe-for (on event pointer-drag)
    (call (. scrub drag) this event)
  )
  (subscribe-for (on event pointer-up)
    (call (. scrub end) this event)
  )
)

(fn-do + number-field-stepped F64
  (param value F64)
  (param step F64)
  (param base F64)
  (param maximum (? F64))
  (let snapped (+ base (* (call round (/ (- value base) step)) step)))
  (if (and (!= maximum null) (> snapped maximum))
    (= snapped (+ base (* (call floor (+ (/ (- maximum base) step) 0.000000001)) step)))
  )
  (return snapped)
)

(fn-expr + number-field-round F64
  (param value F64)
  (param precision Size)
  (/ (call round (* value scale)) scale)
  (where
    (lazy scale (%% 10.0 precision))
  )
)

(fn-expr + number-field-display-text String
  (param value F64)
  (param precision Size)
  (param is-mixed Bool)
  (if-expr is-mixed "" (call (. value places) precision))
)

(type _ NumberFieldScrub
  (prop _ active-pointer-id (? U64))
  (prop _ start-x Coord (= 0))
  (prop _ start-value F64)
  (fn-do + begin _
    (param handle Box)
    (param event PointerDownEvent)
    (let owner (of (. handle ancestor) NumberField))
    (return-if (if (or (!= (. event button) (. PointerButton primary)) (not owner))))
    (return-if (if (or (not (. owner is-effectively-enabled)) (. owner is-read-only))))
    (= active-pointer-id (. event pointer-id))
    (= start-x (. event point x))
    (= start-value (. owner value))
    (call (. owner accept-value) start-value (. ValueChangePhase began))
  )
  (fn-do + drag _
    (param handle Box)
    (param event PointerDragEvent)
    (return-if (if (not (call is-active (. event pointer-id)))))
    (let owner (of (. handle ancestor) NumberField))
    (return-if (if (not owner)))
    (call (. owner accept-value)
      (block
        (arg (+ start-value (* (- (. event point x) start-x) (?? (. owner scrub-step) (. owner step)))))
        (arg (. ValueChangePhase changed))
      )
    )
    (call (. event cancel))
  )
  (fn-do + end _
    (param handle Box)
    (param event PointerUpEvent)
    (return-if (if (not (call is-active (. event pointer-id)))))
    (= active-pointer-id null)
    (let owner (of (. handle ancestor) NumberField))
    (if owner
      (call (. owner accept-value) (. owner value) (. ValueChangePhase ended))
    )
    (call (. event cancel))
  )
  (fn-expr _ is-active _
    (param pointer-id U64)
    (and (!= active-pointer-id null) (== active-pointer-id pointer-id))
  )
)
