        + <Box trailing • button-trailing
    if #role == ButtonRole.default
        <KeyShortcut "Default"
            key = .enter
            discoverable = false
            is-container-wide = true
            action = => do activate()
    if #role == ButtonRole.cancel
        <KeyShortcut "Cancel"
            key = .escape
            discoverable = false
            is-container-wide = true
            action = => do activate()

