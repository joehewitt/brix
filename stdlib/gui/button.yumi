+ ButtonRole is Union

| normal
| default
| cancel
| destructive

━━━━━━━━━━━━━━━━━━━━
+ Button is Box

+ title = ""
+ shorthand String?
+ action Doer?
+ command CommandNode?
+ is-on = #command?.#is-on ?? false
+ is-enabled = #command?.#enabled ?? true
+ is-untitled = #title == ""
+ role = ButtonRole.normal
+ is-default = #role == ButtonRole.default
+ is-destructive = #role == ButtonRole.destructive
+ is-accent-pressed = (#is-on || #is-default) && #is-press-within

