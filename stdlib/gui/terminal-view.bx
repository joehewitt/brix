(import /core/style)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/text)
(import /gui)
(import /gui/clipboard)
(import /gui/terminal-glyphs)
(import /math)
(import /os/terminal)
(import /stream/aggregate)
(import /time/duration)
(import /time/timer)
(import /ui/input)
(blank)
(prop _ terminal-blink-interval _ (= 530ms))
(prop _ terminal-blink-timeout _ (= 10s))
(prop _ terminal-line-gap Length (= 2))
(prop _ terminal-bar-width Length (= 2))
(prop _ terminal-underline-height Length (= 1))
(prop _ terminal-delete-byte Byte (= 127))
(prop _ terminal-down-arrow-code U32 (= 125))
(prop _ terminal-up-arrow-code U32 (= 126))
(prop _ terminal-word-left-bytes _ (= (call (of Array Byte) "\x1bb")))
(prop _ terminal-word-right-bytes _ (= (call (of Array Byte) "\x1bf")))
(prop _ terminal-line-start-bytes _ (= (call (of Array Byte) "\x01")))
(prop _ terminal-line-end-bytes _ (= (call (of Array Byte) "\x05")))

(style TerminalTheme
  (using GUIBoxCursor)
  (using GUIFontStyle)
  (using GUIMetrics)
  (rule terminal-text
    (= font-family "Menlo")
    (= font-size gui-callout-font-size)
    (= cursor (. CursorStyle text))
  )
)

(type _ TerminalLayout (is Tuple)
  (prop + column Size)
  (prop + layout TextLayout)
)

(type _ TerminalHover (is Tuple)
  (prop + start Size)
  (prop + end Size)
  (prop + columns Size)
  (prop + target (? TerminalPathLink))
)

(type _ TerminalLine
  (prop + runs (list TerminalRun))
  (prop + selection-start Int (= -1))
  (prop + selection-end Int (= -1))
  (prop + wraps _ (= false))
  (prop + layouts (list TerminalLayout))
  (prop + is-laid-out _ (= false))
  (fn-do + update _
    (param row TerminalRow)
    (call release)
    (= runs (. row runs))
    (= selection-start (. row selection-start))
    (= selection-end (. row selection-end))
    (= wraps (. row wraps))
  )
  (fn-do + release _
    (for (in item layouts)
      (call (. item layout close))
    )
    (call (. layouts clear))
    (= is-laid-out false)
  )
)

(type + TerminalView (is Box)
  (using GUIBoxCursor)
  (using TerminalTheme)
  (prop + session TerminalSession)
  (prop + text-input-context _ (=> (call cursor-context)))
  (prop + cell-width Length)
  (prop + cell-height Length)
  (prop + has-link _ (= false))
  (event + path-opened TerminalPathLink)
  (blank)
  (prop _ text-baseline Length)
  (prop _ measured-font (? Font))
  (prop _ lines (list TerminalLine))
  (prop _ shown-colors (list RGBA))
  (prop _ text-cursor (? TerminalCursor))
  (prop _ colors (? TerminalColors))
  (prop _ last-key-code U32)
  (prop _ is-selecting _ (= false))
  (prop _ is-tracking-press _ (= false))
  (prop _ scroll-remainder Length)
  (prop _ backscroll _ (= (call TerminalScrollbar 0 0 0)))
  (prop _ has-selection _ (= false))
  (prop _ drag-point _ (= (call Point 0 0)))
  (prop _ is-rectangle-drag _ (= false))
  (prop _ is-autoscrolling _ (= false))
  (prop _ autoscroll-remainder Length)
  (prop _ hover-point (? Point))
  (prop _ hovered (? TerminalHover))
  (prop _ is-command-held _ (= false))
  (event _ input-sent Bool)
  (event _ closing Bool)
  (blank)
  (rule This (• terminal-text)
    (= focus-mode (. FocusMode input))
    (when-style #has-link
      (= cursor (. CursorStyle pointing-hand))
    )
  )
  (content
    (<> This
      (<> ContextMenu
        (<> MenuItem (text: "Copy")
          (= key copy-key)
          (= is-enabled #has-selection)
          (= action (=> () :do (call copy-from-menu)))
        )
        (<> MenuItem (text: "Copy All")
          (= action (=> () :do (call copy-all)))
        )
        (<> MenuItem (text: "Paste")
          (= key paste-key)
          (= action (=> () :do (call paste-from-menu)))
        )
        (<> MenuSeparator)
        (<> MenuItem (text: "Clear Scrollback")
          (= key (call KeyCombo "Cmd+K"))
          (= action (=> () :do (call (. session clear-scrollback))))
        )
      )
    )
  )
  (whenever-rule (. session #revision)
    (call refresh)
  )
  (subscribe-for (on event key-press)
    (call press-key event)
  )
  (fn-do _ press-key _
    (param event KeyPressEvent)
    (let modifiers (. event modifiers))
    (= last-key-code (. event native-key-code))
    (let editing (call editing-bytes (. event key) modifiers))
    (if editing
      (call send-input editing)
      (call (. event cancel))
      (return)
    )
    (if (. modifiers command)
      (if (and (not (. modifiers control)) (not (. modifiers option)) (call command-key (. event characters)))
        (call (. event cancel))
      )
      (return)
    )
    (return-if (if (and (not (call is-special-key (. event key))) (not (. modifiers control)))))
    (return-if (if (and (. modifiers control) (call is-shortcut event))))
    (let action (if-expr (. event is-repeat) (. TerminalKeyAction repeat) (. TerminalKeyAction press)))
    (call send-input
      (block
        (arg
          (call (. session emulator encode-key)
            (block
              (arg (. event native-key-code))
              (arg (call key-mods modifiers))
              (arg action)
              (arg null)
              (arg (call unshifted (. event characters)))
            )
          )
        )
      )
    )
    (call (. event cancel))
  )
  (subscribe-for (on event key-release)
    (let bytes
      (call (. session emulator encode-key)
        (block
          (arg (. event native-key-code))
          (arg (call key-mods (. event modifiers)))
          (arg (. TerminalKeyAction release))
          (arg null)
          (arg (call unshifted (. event characters)))
        )
      )
    )
    (if bytes
      (call (. session send) bytes)
    )
  )
  (subscribe-for (on event key-input)
    (call input-text event)
  )
  (fn-do _ input-text _
    (param event KeyInputEvent)
    (return-if (if (== (. event text size) 0)))
    (if (and (> (. event replaces-before) 0) (== (. event replaces-length) (. event replaces-before)))
      (let erase ([] Byte (. event replaces-before)))
      (for (in index (..< 0 (. event replaces-before)))
        (= ([] erase index) terminal-delete-byte)
      )
      (call (. session send) erase)
    )
    (let encoded
      (call (. session emulator encode-key)
        (block
          (arg last-key-code)
          (arg (call key-mods (. event modifiers)))
          (arg (. TerminalKeyAction press))
          (arg (. event text))
        )
      )
    )
    (if encoded
      (call send-input encoded)
      (else
        (call send-input (call (of Array Byte) (. event text)))
      )
    )
  )
  (subscribe-for (on event copy)
    (if (call copy-selection (. event clipboard))
      (call (. event cancel))
    )
  )
  (subscribe-for (on event paste)
    (if (call paste-text (. event clipboard))
      (call (. event cancel))
    )
  )
  (fn-do _ copy-selection Bool
    (param clipboard Clipboard)
    (let text (call (. session emulator selection-text)))
    (return-if false (if (not text)))
    (return (call (. clipboard write-text) text))
  )
  (fn-do _ paste-text Bool
    (param clipboard Clipboard)
    (let text (call (. clipboard read-text)))
    (return-if false (if (not text)))
    (call send-input (call (. session emulator encode-paste) text))
    (return true)
  )
  (fn-do _ copy-from-menu _
    (let ignored (call copy-selection (call Clipboard)))
  )
  (fn-do _ paste-from-menu _
    (let ignored (call paste-text (call Clipboard)))
  )
  (fn-do _ copy-all _
    (let text (call (. session emulator all-text)))
    (if text
      (let ignored (call (. (call Clipboard) write-text) text))
    )
  )
  (subscribe-for (on event focus)
    (let bytes (call (. session emulator encode-focus) true))
    (if bytes
      (call (. session send) bytes)
    )
    (call invalidate-paint)
  )
  (subscribe-for (on event blur)
    (let bytes (call (. session emulator encode-focus) false))
    (if bytes
      (call (. session send) bytes)
    )
    (call invalidate-paint)
  )
  (prop _ cursor-blink _
    (machine
      (state steady
        (then blinking (trigger on focus))
      )
      (blank)
      (state blinking (trigger on input-sent is-focused)
        (then steady (trigger on blur))
        (then steady (trigger on closing))
        (then rested (trigger on (call Timer terminal-blink-timeout)))
        (blank)
        (state lit
          (do
            (inline (call repaint-blinking-cursor))
          )
          (then dim (trigger on (call Timer terminal-blink-interval)))
        )
        (blank)
        (state dim
          (do
            (inline (call repaint-blinking-cursor))
          )
          (then lit (trigger on (call Timer terminal-blink-interval)))
        )
      )
      (blank)
      (state rested
        (do
          (inline (call repaint-blinking-cursor))
        )
        (then steady (trigger on blur))
        (then steady (trigger on closing))
      )
    )
  )
  (subscribe-for (on event pointer-down)
    (call press-pointer event)
  )
  (fn-do _ press-pointer _
    (param event PointerDownEvent)
    (let target (?. hovered target))
    (if (and target (== (. event button) (. PointerButton primary)) (. event modifiers command))
      (<- path-opened target)
      (call (. event cancel))
      (return)
    )
    (call request-focus)
    (let local (call local-point (. event point)))
    (let is-primary (== (. event button) (. PointerButton primary)))
    (let is-context (or (== (. event button) (. PointerButton secondary)) (and is-primary (. event modifiers control))))
    (if (call reports-mouse (. event modifiers))
      (= is-tracking-press true)
      (call send-mouse (. TerminalMouseAction press) (call mouse-button (. event button)) (. event modifiers) local)
      (if is-context
        (call (. event cancel))
      )
      (return)
    )
    (return-if (if (or (not is-primary) is-context)))
    (= is-selecting true)
    (= drag-point local)
    (call (. session emulator select-press) (call column-at local) (call row-at local) (. local x) (. local y))
    (call refresh)
  )
  (subscribe-for (on event pointer-drag)
    (call drag-pointer event)
  )
  (fn-do _ drag-pointer _
    (param event PointerDragEvent)
    (let local (call local-point (. event point)))
    (if is-tracking-press
      (call send-mouse (. TerminalMouseAction motion) (call mouse-button (. event button)) (. event modifiers) local)
      (return)
    )
    (return-if (if (not is-selecting)))
    (= drag-point local)
    (= is-rectangle-drag (. event modifiers option))
    (call extend-selection)
    (call start-autoscroll)
  )
  (fn-do _ extend-selection _
    (call (. session emulator select-drag)
      (block
        (arg (call column-at drag-point))
        (arg (call row-at drag-point))
        (arg (. drag-point x))
        (arg (. drag-point y))
        (arg is-rectangle-drag)
      )
    )
    (call refresh)
  )
  (fn-do _ start-autoscroll _
    (return-if (if (or is-autoscrolling (== (call autoscroll-delta) 0))))
    (= is-autoscrolling true)
    (= autoscroll-remainder 0)
    (do-new
      (while (call step-autoscroll)
        (call (. drag-scroll-interval wait))
      )
      (= is-autoscrolling false)
    )
  )
  (fn-do _ step-autoscroll Bool
    (return-if false (if (or (not is-selecting) (<= cell-height 0))))
    (let delta (call autoscroll-delta))
    (return-if false (if (== delta 0)))
    (+= autoscroll-remainder delta)
    (let rows (as (/ autoscroll-remainder cell-height) Int))
    (return-if true (if (== rows 0)))
    (-= autoscroll-remainder (* (as rows Length) cell-height))
    (return-if false (if (not (call scroll-backscroll rows))))
    (call extend-selection)
    (return true)
  )
  (fn-expr _ autoscroll-delta Length
    (case? (< (. drag-point y) 0)
      (- (call drag-scroll-amount (- (. drag-point y))))
    )
    (case? (> (. drag-point y) bottom)
      (call drag-scroll-amount (- (. drag-point y) bottom))
    )
    (default
      0
    )
    (where
      (lazy bottom (* (. lines length) cell-height))
    )
  )
  (fn-do _ scroll-backscroll Bool
    (param rows Int)
    (let emulator (. session emulator))
    (let resting (. emulator scrollbar offset))
    (call (. emulator scroll-by) rows)
    (return-if false (if (== (. emulator scrollbar offset) resting)))
    (call linger-scroll-indicator)
    (return true)
  )
  (subscribe-for (on event pointer-up)
    (call release-pointer event)
  )
  (fn-do _ release-pointer _
    (param event PointerUpEvent)
    (let local (call local-point (. event point)))
    (if is-tracking-press
      (= is-tracking-press false)
      (call send-mouse (. TerminalMouseAction release) (call mouse-button (. event button)) (. event modifiers) local)
      (return)
    )
    (return-if (if (not is-selecting)))
    (= is-selecting false)
    (call (. session emulator select-release) (call column-at local) (call row-at local))
    (call refresh)
  )
  (subscribe-for (on event pointer-move)
    (call move-pointer event)
  )
  (fn-do _ move-pointer _
    (param event PointerMoveEvent)
    (= hover-point (call local-point (. event point)))
    (= is-command-held (. event modifiers command))
    (call probe-link)
    (return-if (if (not (. session emulator is-mouse-tracking))))
    (call send-mouse
      (block
        (arg (. TerminalMouseAction motion))
        (arg (. TerminalMouseButton none))
        (arg (. event modifiers))
        (arg (call local-point (. event point)))
      )
    )
  )
  (subscribe-for (on event modifiers-changed)
    (= hover-point (call local-point (. event point)))
    (= is-command-held (. event modifiers command))
    (call probe-link)
  )
  (whenever-rule #is-hover-within
    (if (not is-hover-within)
      (= hover-point null)
      (call probe-link)
    )
  )
  (fn-do _ probe-link _
    (let point hover-point)
    (if (or (not is-command-held) (not point) (< (. point x) 0) (< (. point y) 0) (<= cell-height 0))
      (call show-hover null)
      (return)
    )
    (let row (call row-at point))
    (let column (call column-at point))
    (let columns (. session emulator columns))
    (if (or (>= row (. lines length)) (>= column columns))
      (call show-hover null)
      (return)
    )
    (let index (+ (* row columns) column))
    (let current hovered)
    (return-if (if (and current (== (. current columns) columns) (>= index (. current start)) (< index (. current end)))))
    (let first row)
    (while (and (> first 0) (. ([] lines (- first 1)) wraps))
      (-= first 1)
    )
    (let last row)
    (while (and (< (+ last 1) (. lines length)) (. ([] lines last) wraps))
      (+= last 1)
    )
    (let cells (list String))
    (for (in joined (..< first (+ last 1)))
      (++= cells (call terminal-row-cells (. ([] lines joined) runs)))
      (if (< joined last)
        (while (< (. cells length) (* (+ (- joined first) 1) columns))
          (+= cells "")
        )
      )
    )
    (let span (call terminal-path-span cells (- index (* first columns))))
    (if (not span)
      (call show-hover null)
      (return)
    )
    (let base (* first columns))
    (call show-hover
      (block
        (arg (call TerminalHover (+ base (. span start)) (+ base (. span end)) columns (call (. session resolve-link) (. span text))))
      )
    )
  )
  (fn-do _ show-hover _
    (param next (? TerminalHover))
    (let was-linked (!= (?. hovered target) null))
    (= hovered next)
    (= has-link (!= (?. next target) null))
    (if (or was-linked has-link)
      (call invalidate-paint)
    )
  )
  (subscribe-for (on event scroll)
    (call scroll-wheel event)
  )
  (fn-do _ scroll-wheel _
    (param event ScrollEvent)
    (return-if (if (<= cell-height 0)))
    (let step (if-expr (. event is-precise) 1 cell-height))
    (+= scroll-remainder (* (. event delta-y) step))
    (let rows (as (/ scroll-remainder cell-height) Int))
    (return-if (if (== rows 0)))
    (-= scroll-remainder (* (as rows Length) cell-height))
    (call (. event cancel))
    (let emulator (. session emulator))
    (if (. emulator is-mouse-tracking)
      (let button (if-expr (> rows 0) (. TerminalMouseButton wheel-down) (. TerminalMouseButton wheel-up)))
      (let local (call local-point (. event point)))
      (for (in index (..< 0 (call abs rows)))
        (call send-mouse (. TerminalMouseAction press) button (. event modifiers) local)
      )
      (else-if (and (. emulator is-alternate-screen) (. emulator is-alternate-scrolling))
        (let key-code (if-expr (> rows 0) terminal-down-arrow-code terminal-up-arrow-code))
        (for (in index (..< 0 (call abs rows)))
          (call send-input (call (. emulator encode-key) key-code 0 (. TerminalKeyAction press) null))
        )
      )
      (else-if (call scroll-backscroll rows)
        (call refresh)
      )
    )
  )
  (fn-expr _ is-shortcut Bool
    (param event KeyPressEvent)
    (match window
      (case (: host Window)
        (call some (. host key-bindings) (:where (call (. each key matches) event)))
      )
      (default
        false
      )
    )
  )
  (fn-do _ command-key Bool
    (param characters String)
    (let emulator (. session emulator))
    (match characters
      (case= "a"
        (call (. emulator select-all))
        (call refresh)
      )
      (case= "k"
        (call (. session clear-scrollback))
      )
      (default
        (return false)
      )
    )
    (return true)
  )
  (fn-do _ send-input _
    (param bytes (? ([] Byte)))
    (return-if (if (not bytes)))
    (let emulator (. session emulator))
    (if (not (. emulator is-viewport-at-bottom))
      (call (. emulator scroll-to-bottom))
    )
    (if (. emulator has-selection)
      (call (. emulator clear-selection))
    )
    (call (. session send) bytes)
    (<- input-sent true)
    (call refresh)
  )
  (fn-do _ send-mouse _
    (param action U32)
    (param button U32)
    (param modifiers PointerModifiers)
    (param point Point)
    (let scale (if-expr (> cell-width 0) (/ (call ceil cell-width) cell-width) 1))
    (let bytes
      (call (. session emulator encode-mouse)
        (block
          (arg action)
          (arg button)
          (arg (call key-mods modifiers))
          (arg (as (* (. point x) scale) F32))
          (arg (as (. point y) F32))
        )
      )
    )
    (if bytes
      (call (. session send) bytes)
    )
  )
  (fn-expr _ reports-mouse Bool
    (param modifiers PointerModifiers)
    (and (. session emulator is-mouse-tracking) (not (. modifiers shift)))
  )
  (fn-expr _ local-point Point
    (param point Point)
    (call Point (+ (- (. point x) (. origin x)) (. frame x)) (+ (- (. point y) (. origin y)) (. frame y)))
    (where
      (lazy origin (call grid-origin))
      (lazy frame bounds)
    )
  )
  (fn-expr _ column-at Size
    (param point Point)
    (if-expr (and (> (. point x) 0) (> cell-width 0)) (as (call floor (/ (. point x) cell-width)) Size) 0)
  )
  (fn-expr _ row-at Size
    (param point Point)
    (if-expr (and (> (. point y) 0) (> cell-height 0)) (as (call floor (/ (. point y) cell-height)) Size) 0)
  )
  (fn-expr _ grid-origin Point
    (call Point (call round (. content x)) (call round (. content y)))
    (where
      (lazy content content-bounds)
    )
  )
  (fn-expr _ column-offset Length
    (param column Size)
    (call round (* column cell-width))
  )
  (fn-expr _ cell-span Rect
    (param origin Point)
    (param top Length)
    (param column Size)
    (param columns Size)
    (call Rect (+ (. origin x) left) top (- (call column-offset (+ column columns)) left) cell-height)
    (where
      (lazy left (call column-offset column))
    )
  )
  (fn-expr _ cursor-context (? TextInputContext)
    (match shown
      (case= null
        null
      )
      (default
        (call TextInputContext "" "" rect)
        (blank)
        (lazy rect
          (call Rect
            (block
              (arg (+ (. origin x) (call column-offset (. shown column))))
              (arg (+ (. origin y) (* (. shown row) cell-height)))
              (arg cell-width)
              (arg cell-height)
            )
          )
        )
      )
    )
    (where
      (lazy shown text-cursor)
      (lazy origin (call grid-origin))
    )
  )
  (fn-do _ refresh _
    (let emulator (. session emulator))
    (return-if (if (or (not (. emulator is-open)) (. session is-holding-frame))))
    (let palette (call theme-colors))
    (let recolored (!= shown-colors palette))
    (if recolored
      (= shown-colors palette)
      (call push-colors emulator palette)
    )
    (let dirty (call (. emulator render-update)))
    (if (or (!= dirty terminal-dirty-none) recolored (!= (. lines length) (. emulator rows)))
      (call fit-lines (. emulator rows))
      (let partial (and (== dirty terminal-dirty-partial) (not recolored)))
      (for (in row (call (. emulator render-rows) partial))
        (if (and (>= (. row y) 0) (< (as (. row y) Size) (. lines length)))
          (call (. ([] lines (as (. row y) Size)) update) row)
        )
      )
      (call (. emulator render-clean))
    )
    (= text-cursor (. emulator cursor))
    (= colors (. emulator colors))
    (= backscroll (. emulator scrollbar))
    (= has-selection (. emulator has-selection))
    (call invalidate-paint)
    (if is-command-held
      (= hovered null)
      (call probe-link)
    )
  )
  (fn-do _ fit-lines _
    (param count Size)
    (while (> (. lines length) count)
      (call (. ([] lines (- (. lines length) 1)) release))
      (call (. lines remove) (- (. lines length) 1))
    )
    (while (< (. lines length) count)
      (+= lines (call TerminalLine))
    )
  )
  (fn-do _ push-colors _
    (param emulator TerminalEmulator)
    (param palette (list RGBA))
    (let entries ([] U32 16))
    (for (in index (..< 0 16))
      (= ([] entries index) (call rgb-value ([] palette (+ index 3))))
    )
    (call (. emulator set-colors) (call rgb-value ([] palette 0)) (call rgb-value ([] palette 1)) (call rgb-value ([] palette 2)) entries)
    (call (. emulator set-dark) (< (call luminance ([] palette 1)) 0.5))
  )
  (fn-expr _ theme-colors (list RGBA)
    (call (of List RGBA)
      (block
        (item $gui-terminal-foreground-color)
        (item $gui-terminal-background-color)
        (item $gui-terminal-cursor-color)
        (item $gui-terminal-black-color)
        (item $gui-terminal-red-color)
        (item $gui-terminal-green-color)
        (item $gui-terminal-yellow-color)
        (item $gui-terminal-blue-color)
        (item $gui-terminal-magenta-color)
        (item $gui-terminal-cyan-color)
        (item $gui-terminal-white-color)
        (item $gui-terminal-bright-black-color)
        (item $gui-terminal-bright-red-color)
        (item $gui-terminal-bright-green-color)
        (item $gui-terminal-bright-yellow-color)
        (item $gui-terminal-bright-blue-color)
        (item $gui-terminal-bright-magenta-color)
        (item $gui-terminal-bright-cyan-color)
        (item $gui-terminal-bright-white-color)
      )
    )
  )
  (fn-do _ measure _
    (let font (call Font $font-family $font-size $font-weight $font-slant))
    (return-if (if (== font measured-font)))
    (= measured-font font)
    (let wide (use (call TextLayout "MMMMMMMMMM" font)))
    (= cell-width (/ (. wide natural-width) 10))
    (let probe (use (call TextLayout "M" font)))
    (= cell-height (+ (call ceil (. probe height)) terminal-line-gap))
    (= text-baseline (+ (call floor (/ (- cell-height (. probe height)) 2)) (. probe baseline)))
    (for (in line lines)
      (call (. line release))
    )
  )
  (fn-do _ layout-line _
    (param line TerminalLine)
    (call (. line release))
    (let segments (list TextSegment))
    (let start Size 0)
    (for (in run (. line runs))
      (if (call (. run has-flag) terminal-run-isolated)
        (call flush-segments line segments start)
        (= segments (call (of List TextSegment)))
        (let single (list TextSegment))
        (+= single (call run-segment run))
        (+= (. line layouts) (call TerminalLayout (. run column) (call text-layout single)))
        (else-if (call (. run has-flag) terminal-run-sprite)
          (call flush-segments line segments start)
          (= segments (call (of List TextSegment)))
        )
        (else
          (if (== (. segments length) 0)
            (= start (. run column))
          )
          (+= segments (call run-segment run))
        )
      )
    )
    (call flush-segments line segments start)
    (= (. line is-laid-out) true)
  )
  (fn-do _ flush-segments _
    (param line TerminalLine)
    (param segments (list TextSegment))
    (param start Size)
    (return-if (if (== (. segments length) 0)))
    (+= (. line layouts) (call TerminalLayout start (call text-layout segments)))
  )
  (fn-expr _ text-layout TextLayout
    (param segments (list TextSegment))
    (call TextLayout segments (call run-font false false) null (. TextOverflow clip) (. TextWrap no-wrap))
  )
  (fn-expr _ run-segment TextSegment
    (param run TerminalRun)
    (call TextSegment 0 (. run text) font (call run-color run))
    (where
      (lazy font (call run-font (call (. run has-flag) terminal-run-bold) (call (. run has-flag) terminal-run-italic)))
    )
  )
  (fn-expr _ run-color RGBA
    (param run TerminalRun)
    (case? (call (. run has-flag) terminal-run-invisible)
      (call (. base with-alpha) 0)
    )
    (case? (call (. run has-flag) terminal-run-faint)
      (call (. base with-alpha) 0.5)
    )
    (default
      base
    )
    (where
      (lazy base (call rgb-color (. run foreground)))
    )
  )
  (fn-do _ paint-sprites _
    (param canvas Canvas)
    (param origin Point)
    (param top Length)
    (param run TerminalRun)
    (param color RGBA)
    (return-if (if (<= (. color alpha) 0)))
    (let stroke glyph-stroke)
    (let scale device-scale)
    (= (. canvas fill-color) color)
    (let column (. run column))
    (for (in code (. run text codepoints))
      (call paint-terminal-glyph canvas (as code U32) (call cell-span origin top column 1) stroke scale)
      (+= column 1)
    )
  )
  (fn-expr _ glyph-stroke Length :get
    (/ cell-width 8)
  )
  (fn-expr _ run-font Font
    (param is-bold Bool)
    (param is-italic Bool)
    (call Font $font-family $font-size weight slant)
    (where
      (lazy weight (if-expr is-bold (. FontWeight bold) (. FontWeight regular)))
      (lazy slant (if-expr is-italic (. FontSlant italic) (. FontSlant upright)))
    )
  )
  (fn-do _ repaint-blinking-cursor _
    (if (?? (?. text-cursor is-blinking) false)
      (call invalidate-paint)
    )
  )
  (fn-do _ paint-cursor _
    (param canvas Canvas)
    (param origin Point)
    (let shown text-cursor)
    (return-if (if (or (not shown) (not (. shown is-visible)) (>= (. shown row) (. lines length)))))
    (return-if (if (and is-focused (. shown is-blinking) (is cursor-blink .dim))))
    (let x (+ (. origin x) (call column-offset (. shown column))))
    (let y (+ (. origin y) (* (. shown row) cell-height)))
    (= (. canvas fill-color) (call rgb-color (?? (?. colors cursor) 0xe6edf3)))
    (if (or (not is-focused) (== (. shown style) terminal-cursor-block-hollow))
      (call (. canvas rect) (call Rect x y cell-width 1))
      (call (. canvas rect) (call Rect x (- (+ y cell-height) 1) cell-width 1))
      (call (. canvas rect) (call Rect x y 1 cell-height))
      (call (. canvas rect) (call Rect (- (+ x cell-width) 1) y 1 cell-height))
      (else-if (== (. shown style) terminal-cursor-bar)
        (call (. canvas rect) (call Rect x y terminal-bar-width cell-height))
      )
      (else-if (== (. shown style) terminal-cursor-underline)
        (call (. canvas rect) (call Rect x (- (+ y cell-height) terminal-bar-width) cell-width terminal-bar-width))
      )
      (else
        (call (. canvas rect) (call Rect x y cell-width cell-height))
        (call paint-cursor-text canvas ([] lines (. shown row)) (. shown column) x y)
      )
    )
  )
  (fn-do _ paint-cursor-text _
    (param canvas Canvas)
    (param line TerminalLine)
    (param column Size)
    (param x Length)
    (param y Length)
    (for (in run (. line runs))
      (if (and (>= column (. run column)) (< column (+ (. run column) (. run columns))))
        (let text (call cell-text run column))
        (return-if (if (== (. (call (. text trim)) size) 0)))
        (let background (call rgb-color (?? (?. colors background) 0)))
        (if (call (. run has-flag) terminal-run-sprite)
          (= (. canvas fill-color) background)
          (let cell (call Rect x y cell-width cell-height))
          (call paint-terminal-glyph
            (block
              (arg canvas)
              (arg (as ([] (. text codepoints) 0) U32))
              (arg cell)
              (arg glyph-stroke)
              (arg device-scale)
            )
          )
          (return)
        )
        (let segments (list TextSegment))
        (let font (call run-font (call (. run has-flag) terminal-run-bold) (call (. run has-flag) terminal-run-italic)))
        (+= segments (call TextSegment 0 text font background))
        (let layout (use (call text-layout segments)))
        (call (. canvas draw-text)
          (block
            (arg layout)
            (arg (call Rect x (- (+ y text-baseline) (. layout baseline)) (. layout width) (. layout height)))
            (arg (. TextAlignment left))
          )
        )
        (return)
      )
    )
  )
  (fn-expr _ cell-text String
    (param run TerminalRun)
    (param column Size)
    (if-expr isolated (. run text) (str ([] (. run text codepoints) (- column (. run column)))))
    (where
      (lazy isolated (call (. run has-flag) terminal-run-isolated))
    )
  )
  (fn-do _ paint-link _
    (param canvas Canvas)
    (param origin Point)
    (param shown TerminalHover)
    (let columns (. shown columns))
    (let first (/ (. shown start) columns))
    (let last (/ (- (. shown end) 1) columns))
    (= (. canvas fill-color) $gui-terminal-link-color)
    (for (in row (..< first (call min (+ last 1) (. lines length))))
      (let from (if-expr (== row first) (% (. shown start) columns) 0))
      (let to (if-expr (== row last) (+ (% (- (. shown end) 1) columns) 1) columns))
      (let left (+ (. origin x) (call column-offset from)))
      (let baseline (+ (. origin y) (* row cell-height) text-baseline))
      (call (. canvas rect)
        (block
          (arg (call Rect left (+ baseline 1) (- (+ (. origin x) (call column-offset to)) left) terminal-underline-height))
        )
      )
    )
  )
  (fn-do + mounted _
    (call (. super mounted))
    (call refresh)
  )
  (fn-do + close _
    (<- closing true)
    (for (in line lines)
      (call (. line release))
    )
    (call (. lines clear))
    (call (. super close))
  )
  (fn-do + did-layout _
    (call (. super did-layout))
    (call measure)
    (let content content-bounds)
    (return-if (if (or (<= cell-width 0) (<= cell-height 0) (<= (. content width) 0) (<= (. content height) 0))))
    (let columns (call max 1 (as (call floor (/ (. content width) cell-width)) Size)))
    (let rows (call max 1 (as (call floor (/ (. content height) cell-height)) Size)))
    (call (. session resize) columns rows (as (call ceil cell-width) Size) (as cell-height Size))
    (call refresh)
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let content content-bounds)
    (let origin (call grid-origin))
    (let background (call rgb-color (?? (?. colors background) (call rgb-value $gui-terminal-background-color))))
    (= (. canvas fill-color) background)
    (call (. canvas rect) padding-bounds)
    (return-if (if (or (<= cell-width 0) (<= cell-height 0))))
    (do-use (. canvas saved-state)
      (call (. canvas clip) content)
      (for (in index (..< 0 (. lines length)))
        (let line ([] lines index))
        (let top (+ (. origin y) (* index cell-height)))
        (for (in run (. line runs))
          (if (. run has-background)
            (= (. canvas fill-color) (call rgb-color (. run background)))
            (call (. canvas rect) (call cell-span origin top (. run column) (. run columns)))
          )
        )
        (if (>= (. line selection-start) 0)
          (= (. canvas fill-color) $gui-terminal-selection-color)
          (let span (as (+ (- (. line selection-end) (. line selection-start)) 1) Size))
          (call (. canvas rect) (call cell-span origin top (. line selection-start) span))
        )
        (if (not (. line is-laid-out))
          (call layout-line line)
        )
        (let baseline (+ top text-baseline))
        (for (in item (. line layouts))
          (let layout (. item layout))
          (call (. canvas draw-text)
            (block
              (arg layout)
              (arg
                (call Rect
                  (block
                    (arg (+ (. origin x) (call column-offset (. item column))))
                    (arg (- baseline (. layout baseline)))
                    (arg (. layout width))
                    (arg (. layout height))
                  )
                )
              )
              (arg (. TextAlignment left))
            )
          )
        )
        (for (in run (. line runs))
          (if (call (. run has-flag) terminal-run-sprite)
            (call paint-sprites canvas origin top run (call run-color run))
          )
          (lazy struck (call (. run has-flag) terminal-run-strike))
          (lazy overlined (call (. run has-flag) terminal-run-overline))
          (let decorated (or (call (. run has-flag) terminal-run-underline) struck overlined))
          (if decorated
            (let left (+ (. origin x) (call column-offset (. run column))))
            (let width (- (call column-offset (+ (. run column) (. run columns))) (call column-offset (. run column))))
            (= (. canvas fill-color) (call rgb-color (. run foreground)))
            (if (call (. run has-flag) terminal-run-underline)
              (call (. canvas rect) (call Rect left (+ baseline 1) width terminal-underline-height))
            )
            (if (call (. run has-flag) terminal-run-strike)
              (call (. canvas rect)
                (block
                  (arg (call Rect left (+ top (call floor (/ cell-height 2))) width terminal-underline-height))
                )
              )
            )
            (if (call (. run has-flag) terminal-run-overline)
              (call (. canvas rect) (call Rect left top width terminal-underline-height))
            )
          )
        )
      )
      (let shown hovered)
      (if (and shown (!= (. shown target) null) (> (. shown columns) 0))
        (call paint-link canvas origin shown)
      )
    )
  )
  (fn-do + paint-overlay _
    (param canvas Canvas)
    (let content content-bounds)
    (return-if (if (or (<= cell-width 0) (<= cell-height 0))))
    (do-use (. canvas saved-state)
      (call (. canvas clip) content)
      (call paint-cursor canvas (call grid-origin))
    )
  )
  (fn-expr + shows-scroll-indicator _
    (param axis Orientation)
    (case? (or (== axis (. Orientation horizontal)) (== $scroll-indicator-y (. ScrollIndicatorVisibility hidden)))
      false
    )
    (case? (== $scroll-indicator-y (. ScrollIndicatorVisibility always))
      true
    )
    (case? (<= (. backscroll total) (. backscroll length))
      false
    )
    (default
      (call has-lingering-scroll-indicator)
    )
  )
  (fn-expr + scroll-axis-snapshot _
    (param axis Orientation)
    (case? (== axis (. Orientation horizontal))
      (call (. super scroll-axis-snapshot) axis)
    )
    (default
      (call ScrollAxisSnapshot
        (block
          (arg (* (. backscroll offset) cell-height))
          (arg 0)
          (arg (call max 0 (- content viewport)))
          (arg viewport)
          (arg content)
          (arg true)
        )
      )
    )
    (where
      (lazy viewport (* (. backscroll length) cell-height))
      (lazy content (* (. backscroll total) cell-height))
    )
  )
  (fn-do + scroll-indicator-seek Bool
    (param axis Orientation)
    (param position Length)
    (return-if false (if (or (== axis (. Orientation horizontal)) (<= cell-height 0))))
    (let row (as (call round (/ (call max 0 position) cell-height)) Size))
    (return-if false (if (== row (. backscroll offset))))
    (call (. session emulator scroll-to-row) row)
    (call linger-scroll-indicator)
    (call refresh)
    (return true)
  )
)

(fn-expr _ is-special-key Bool
  (param key Key)
  (match key
    (case .space
      false
    )
    (case .unknown
      false
    )
    (default
      true
    )
  )
)

(fn-do _ editing-bytes (? ([] Byte))
  (param key Key)
  (param modifiers PointerModifiers)
  (return-if null (if (or (. modifiers shift) (. modifiers control) (== (. modifiers option) (. modifiers command)))))
  (return
    (match key
      (case .arrow-left
        (if-expr (. modifiers option) terminal-word-left-bytes terminal-line-start-bytes)
      )
      (case .arrow-right
        (if-expr (. modifiers option) terminal-word-right-bytes terminal-line-end-bytes)
      )
      (default
        null
      )
    )
  )
)

(fn-expr _ key-mods U32
  (param modifiers PointerModifiers)
  (/or/ shift control alt command caps)
  (where
    (lazy shift (if-expr (. modifiers shift) terminal-mods-shift 0u32))
    (lazy control (if-expr (. modifiers control) terminal-mods-control 0u32))
    (lazy alt (if-expr (. modifiers option) terminal-mods-alt 0u32))
    (lazy command (if-expr (. modifiers command) terminal-mods-super 0u32))
    (lazy caps (if-expr (. modifiers caps-lock) terminal-mods-caps-lock 0u32))
  )
)

(fn-expr _ unshifted U32
  (param characters String)
  (if-expr (and (>= code 32) (< code 127)) code 0)
  (where
    (lazy lowered (. characters lowercased))
    (lazy code (if-expr (> (. lowered size) 0) (as ([] (. lowered codepoints) 0) U32) 0u32))
  )
)

(fn-expr _ mouse-button U32
  (param button PointerButton)
  (match button
    (case .primary
      (. TerminalMouseButton left)
    )
    (case .secondary
      (. TerminalMouseButton right)
    )
    (case .middle
      (. TerminalMouseButton middle)
    )
    (default
      (. TerminalMouseButton none)
    )
  )
)

(fn-expr _ rgb-value U32
  (param color RGBA)
  (/or/ (/lshift/ red 16) (/lshift/ green 8) blue)
  (where
    (lazy red (as (call color-channel-byte (. color red)) U32))
    (lazy green (as (call color-channel-byte (. color green)) U32))
    (lazy blue (as (call color-channel-byte (. color blue)) U32))
  )
)

(fn-expr _ rgb-color RGBA
  (param value U32)
  (call RGBA red green blue 1)
  (where
    (lazy red (/ (as (/and/ (/rshift/ value 16) 255) F64) 255))
    (lazy green (/ (as (/and/ (/rshift/ value 8) 255) F64) 255))
    (lazy blue (/ (as (/and/ value 255) F64) 255))
  )
)

(fn-expr _ luminance F64
  (param color RGBA)
  (+ (* (. color red) 0.299) (* (. color green) 0.587) (* (. color blue) 0.114))
)
