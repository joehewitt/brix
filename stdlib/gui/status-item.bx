(import ./app)
(import ./box)
(import ./menu)
(import ./primitives)
(import ./window)
(import /BxAppleGUI/BxAppleGUI.h)
(import /core/intrinsics)
(import /core/markup)
(import /graphics/canvas)
(import /graphics/point)
(import /graphics/primitives)
(blank)
(prop _ panel-gap Length (= 4))
(prop _ panel-margin Length (= 8))

(type + StatusItem (is Box)
  (implements MarkupRootElement)
  (prop + app (? App))
  (prop + title _ (= ""))
  (prop + autosave-name _ (= ""))
  (prop + make-panel (? (of Getter Window)))
  (prop + make-popover (? (of Getter Window)))
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue (as this MarkupRootElement))))
  (blank)
  (prop _ native (? Pointer))
  (prop _ panel (? Window))
  (blank)
  (depends title-changed title)
  (depends autosave-name-changed autosave-name)
  (fn-do + open _
    (return-if (if native))
    (blank)
    (= native (call C:brixGuiStatusItemCreate))
    (if (!= autosave-name "")
      (call autosave-name-changed)
    )
    (call C:brixGuiStatusItemSetCallback
      (block
        (arg (!! native))
        (arg (as gui-status-item-native-event GuiStatusItemCallback))
        (arg (as this Pointer))
      )
    )
    (call markup-mount-root this this)
    (catch (call (. markup-batch-queue checkpoint)))
    (call title-changed)
    (call sync-menu)
  )
  (fn-do + close _
    (call (?. panel close))
    (= panel null)
    (let item native)
    (return-if (if (not item)))
    (blank)
    (= native null)
    (call C:brixGuiStatusItemClosePopover item)
    (call C:brixGuiStatusItemRelease item)
    (call markup-release this)
  )
  (fn-do + set-image _
    (param canvas (? RasterCanvas))
    (param width Length (= 0))
    (param height Length (= 0))
    (param is-template Bool (= true))
    (let item native)
    (return-if (if (not item)))
    (blank)
    (if canvas
      (call C:brixGuiStatusItemSetImage item (. canvas native) width height is-template)
      (else
        (call C:brixGuiStatusItemSetImage item (call Pointer) 0 0 is-template)
      )
    )
  )
  (fn-do + toggle-panel _
    (let shown panel)
    (if (and shown (. shown is-open))
      (call (. shown close))
      (= panel null)
      (else
        (call open-panel)
      )
    )
  )
  (fn-do + dismiss-panel _
    (let shown panel)
    (if (and shown (. shown is-open))
      (call (. shown close))
      (= panel null)
    )
  )
  (fn-do + place-panel _
    (let item native)
    (let shown panel)
    (return-if (if (or (not item) (not shown) (not (. shown is-open)) (. shown is-embedded))))
    (blank)
    (= (. shown position) (call panel-position item shown))
  )
  (fn-do + title-changed _
    (if native
      (call C:brixGuiStatusItemSetTitle native title)
    )
  )
  (fn-do + autosave-name-changed _
    (if native
      (call C:brixGuiStatusItemSetAutosaveName native autosave-name)
    )
  )
  (fn-do _ sync-menu _
    (let item native)
    (return-if (if (not item)))
    (blank)
    (let menu (call first-child-menu this))
    (let handle (if-expr menu (call (. menu native-menu)) (call Pointer)))
    (if (or make-panel make-popover)
      (call C:brixGuiStatusItemSetMenu item (call Pointer))
      (call C:brixGuiStatusItemSetContextMenu item handle)
      (else
        (call C:brixGuiStatusItemSetContextMenu item (call Pointer))
        (call C:brixGuiStatusItemSetMenu item handle)
      )
    )
  )
  (fn-do _ open-panel _
    (let item native)
    (return-if (if (not item)))
    (blank)
    (let make-pop make-popover)
    (if make-pop
      (let shown (call make-pop))
      (= panel shown)
      (let owner app)
      (if owner
        (+= owner shown)
      )
      (let handle (call C:brixGuiStatusItemCreatePopover item (. shown size width) (. shown size height)))
      (if handle
        (call (. shown open-embedded) handle)
        (call C:brixGuiStatusItemShowPopover item)
      )
      (return)
    )
    (let make make-panel)
    (return-if (if (not make)))
    (blank)
    (let shown (call make))
    (= panel shown)
    (= (. shown app) app)
    (= (. shown kind) (. WindowKind panel))
    (= (. shown position) (call panel-position item shown))
    (call (. shown open))
    (let window-native (. shown native))
    (if window-native
      (call C:brixGuiStatusItemSetPanel item window-native)
    )
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
    (call sync-menu)
  )
)

(fn-expr _ panel-position Point
  (param item Pointer)
  (param shown Window)
  (call Point (if-expr (> x right) right (if-expr (< x left) left x)) y)
  (where
    (lazy left (+ (call C:brixGuiStatusItemGetScreenBound item 0) panel-margin))
    (lazy right (- (+ left (call C:brixGuiStatusItemGetScreenBound item 2)) (. shown size width) (* panel-margin 2)))
    (lazy x (call C:brixGuiStatusItemGetBound item 0))
    (lazy y (+ (call C:brixGuiStatusItemGetBound item 1) (call C:brixGuiStatusItemGetBound item 3) panel-gap))
  )
)

(type _ NativeStatusItemEventKind (is U32)
  (variant pressed (= 0))
  (variant dismissed (= 1))
  (variant moved (= 2))
)

(type _ GuiStatusItemCallback (is (c-fn-type Void (param item-pointer Pointer) (param event-kind U32))))

(fn-do _ gui-status-item-native-event _
  (param item-pointer Pointer)
  (param event-kind U32)
  (let item (call (of gc-object-from-pointer StatusItem) item-pointer))
  (match? (as event-kind NativeStatusItemEventKind)
    (case= (. NativeStatusItemEventKind pressed)
      (call (. item toggle-panel)
        (block
          (on-error (: error Error)
            (call unhandled-error error)
          )
        )
      )
    )
    (case= (. NativeStatusItemEventKind dismissed)
      (call (. item dismiss-panel)
        (block
          (on-error (: error Error)
            (call unhandled-error error)
          )
        )
      )
    )
    (case= (. NativeStatusItemEventKind moved)
      (call (. item place-panel))
    )
  )
)
