• extend GUIDefaultTheme
    using GUIBoxCursor
    using GUIBoxMotion
    using GUIBoxPaint
    using GUIBoxSize
    using GUIBoxSpacing
    using GUIBoxTransform
    using GUIFocusRingStyle
    using GUITextPaint

• SegmentedControl • bg:gui-tray-color p:2
    font-size = gui-control-font-size
    corner-radius = gui-control-radius + 2

    when #is-focus-visible
        focus-ring = gui-focus-ring
        motion.focus-ring = gui-motion-quick

• Segment • bg:transparent text:gui-muted-text-color px:10
    min-height = gui-control-height - 4
    max-height = gui-control-height - 4
    shadow = null
    cursor = CursorStyle.pointing-hand

    when #is-untitled
        • px:6

        • icon • mr:0

    when #is-hover-within
        • bg:transparent
        • text:gui-text-color

    when #is-press-within
        • bg:transparent
        scale = 1

    when !#is-effectively-enabled
        • bg:transparent
        cursor = CursorStyle.arrow

    when #is-selected
        • bg:gui-raised-color
        • text:gui-strong-text-color
        shadow = gui-control-shadow

━━━━━━━━━━━━━━━━━━━━
+ SegmentedControl'T is ChoiceControl'T

• This
    focus-mode = FocusMode.keys
    window-draggable = false

_ segments Descendants'(Segment'T)

────────────────────

<This • flex-row
    <KeyShortcut "Next"
        key = .arrow-right
        discoverable = false
        action = => do choose-relative(1)

    <KeyShortcut "Previous"
        key = .arrow-left
        discoverable = false
        action = => do choose-relative(-1)

    <KeyShortcut "First"
        key = .home
        discoverable = false
        action = => do choose-edge(false)

    <KeyShortcut "Last"
        key = .end
        discoverable = false
        action = => do choose-edge(true)

────────────────────
+ do choose-relative
    - offset Int

. choices = enabled-segments
. next = ListCursor(choices.length, selected-index(choices)).stepped(offset)
if next != null
    choose(choices[next].value)

────────────────────
+ do choose-edge
    - last Bool

. choices = enabled-segments
=? if choices.length == 0
choose(if last then choices[choices.length - 1].value else choices[0].value)

────────────────────
_ get enabled-segments

** segments
?> each.is-effectively-enabled
|> List

────────────────────
_ do selected-index Index?
    - choices [Segment'T]

for index in 0 .. < choices.length
    =? index if selected == choices[index].value

━━━━━━━━━━━━━━━━━━━━
+ Segment'T is Button

• This
    focus-mode = FocusMode.none

+ value T
+ is-selected = #control?.#selected == #value

_ control Ancestor'(ChoiceControl'T)

────────────────────
+ This
    - title = ""

────────────────────
for event on click

if is-effectively-enabled
    control?.choose(value)
    event.cancel()
