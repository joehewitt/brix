(import ./box)
(import ./clipboard)
(import ./primitives)
(import /core/event)
(import /core/intrinsics)
(import /graphics/point)
(import /graphics/primitives)
(import /ui/input)
(import /ui/value-change-phase)

(type + PointerDeviceKind (is Union)
  (variant mouse)
  (variant pen)
  (variant cursor)
  (variant eraser)
  (variant touch)
  (variant unknown U32)
)

(type + ScrollPhase (is U64)
  (variant none (= 0))
  (variant began (= 1))
  (variant stationary (= 2))
  (variant changed (= 4))
  (variant ended (= 8))
  (variant cancelled (= 16))
  (variant may-begin (= 32))
)

(type + PointerEventData (is Tuple)
  (prop + root-point Point)
  (prop + pointer-id U64)
  (prop + device-kind PointerDeviceKind (= (. PointerDeviceKind mouse)))
  (prop + modifiers PointerModifiers (= (call PointerModifiers)))
  (prop + buttons U64)
  (prop + ordering-time F64)
)

(type + PointerEvent (is Union)
  (variant PointerDownEvent)
  (variant PointerUpEvent)
  (variant PointerMoveEvent)
  (variant PointerDragEvent)
  (variant ScrollEvent)
  (variant MagnifyEvent)
  (variant ClickEvent)
)

(type + FocusedInputEvent (is Union)
  (variant KeyPressEvent)
  (variant KeyReleaseEvent)
  (variant KeyInputEvent)
  (variant TextCommandEvent)
  (variant TextCompositionEvent)
  (variant CopyEvent)
  (variant CutEvent)
  (variant PasteEvent)
)

(type + GUIRoutedEvent (is Union)
  (variant PointerDownEvent)
  (variant PointerUpEvent)
  (variant PointerMoveEvent)
  (variant PointerDragEvent)
  (variant ScrollEvent)
  (variant MagnifyEvent)
  (variant TouchEvent)
  (variant ClickEvent)
  (variant FocusEvent)
  (variant BlurEvent)
  (variant KeyPressEvent)
  (variant KeyReleaseEvent)
  (variant KeyInputEvent)
  (variant TextCommandEvent)
  (variant TextCompositionEvent)
  (variant CopyEvent)
  (variant CutEvent)
  (variant PasteEvent)
  (variant ModifiersChangedEvent)
)

(type + ModifiersChangedEvent (is GUIEvent)
  (fn-do + This _
    (param data PointerEventData)
  )
)

(type + GUIEventRouteNext (is (fn-type (? Pointer) (param event Pointer) (param current Pointer))))

(type + GUIEventRouteFrame (is Tuple)
  (prop + owner Pointer)
  (prop + generation U64)
  (prop + point Point)
)

(type + GUIEventRouteState (is Tuple)
  (prop + next (? GUIEventRouteNext))
  (prop + frames (list GUIEventRouteFrame))
  (prop + index Size)
  (prop + point Point)
)

(type + GUIEvent
  (implements RoutedEvent)
  (prop + data PointerEventData)
  (prop + point Point)
  (prop + route-frames (list GUIEventRouteFrame))
  (prop + route-index Size)
  (prop + is-canceled _ (= false))
  (prop + root-point _ (=> (. data root-point)))
  (prop + pointer-id _ (=> (. data pointer-id)))
  (prop + device-kind _ (=> (. data device-kind)))
  (prop + modifiers _ (=> (. data modifiers)))
  (prop + buttons _ (=> (. data buttons)))
  (prop + ordering-time _ (=> (. data ordering-time)))
  (blank)
  (prop _ route-next (? GUIEventRouteNext))
  (fn-expr + hit-box (? Box) :get
    (only-if (call (of gc-object-from-pointer Box) (. ([] route-frames 0) owner)) (if (> (. route-frames length) 0)))
  )
  (fn-expr + has-own-route Bool :get
    (if-expr route-next true false)
  )
  (fn-do + cancel _
    (= is-canceled true)
  )
  (fn-do + begin-route _
    (param next GUIEventRouteNext)
    (param frames (list GUIEventRouteFrame))
    (let saved (call GUIEventRouteState route-next route-frames route-index point))
    (= route-next next)
    (= route-frames frames)
    (= route-index 0)
    (= point (. ([] frames 0) point))
    (return saved)
  )
  (fn-do + end-route _
    (param saved GUIEventRouteState)
    (= route-next (. saved next))
    (= route-frames (. saved frames))
    (= route-index (. saved index))
    (= point (. saved point))
  )
  (fn-do + advance-route _
    (param index Size)
    (param next-point Point)
    (= route-index index)
    (= point next-point)
  )
  (fn-do + next-event-owner _
    (param current Pointer)
    (return-if (if (not route-next)))
    (return (call route-next (as this Pointer) current))
  )
)

(type + PointerDownEvent (is GUIEvent)
  (prop + button PointerButton)
  (prop + click-count U32)
  (prop + window-drag-token U64)
  (fn-do + This _
    (param data PointerEventData)
    (param button PointerButton (= (. PointerButton primary)))
    (param click-count U32 (= 1))
    (param window-drag-token U64 (= 0))
  )
)

(type + PointerUpEvent (is GUIEvent)
  (prop + button PointerButton)
  (prop + is-interrupted Bool)
  (fn-do + This _
    (param data PointerEventData)
    (param button PointerButton (= (. PointerButton primary)))
    (param is-interrupted Bool (= false))
  )
)

(type + PointerMoveEvent (is GUIEvent)
  (prop + delta Point)
  (fn-do + This _
    (param data PointerEventData)
    (param delta Point (= (call Point 0 0)))
  )
)

(type + PointerDragEvent (is GUIEvent)
  (prop + button PointerButton)
  (prop + delta Point)
  (fn-do + This _
    (param data PointerEventData)
    (param button PointerButton (= (. PointerButton primary)))
    (param delta Point (= (call Point 0 0)))
  )
)

(type + ScrollEvent (is GUIEvent)
  (prop + delta-x Length)
  (prop + delta-y Length)
  (prop + is-precise Bool)
  (prop + phase ScrollPhase)
  (prop + momentum-phase ScrollPhase)
  (prop + delta _ (=> (call Point delta-x delta-y)))
  (fn-do + This _
    (param data PointerEventData)
    (param delta-x Length (= 0))
    (param delta-y Length (= 0))
    (param is-precise Bool (= false))
    (param phase ScrollPhase (= (. ScrollPhase none)))
    (param momentum-phase ScrollPhase (= (. ScrollPhase none)))
  )
)

(type + MagnifyEvent (is GUIEvent)
  (prop + magnification F64)
  (prop + phase ScrollPhase)
  (prop + scale _ (=> (+ 1 magnification)))
  (fn-do + This _
    (param data PointerEventData)
    (param magnification F64 (= 0))
    (param phase ScrollPhase (= (. ScrollPhase none)))
  )
)

(type + TouchPhase (is U32)
  (variant began (= 0))
  (variant moved (= 1))
  (variant ended (= 2))
  (variant cancelled (= 3))
)

(type + TouchEvent (is GUIEvent)
  (prop + phase TouchPhase)
  (prop + delta Point)
  (prop + tap-count U32)
  (prop + radius F64)
  (prop + touch-id _ (=> pointer-id))
  (fn-do + This _
    (param data PointerEventData)
    (param phase TouchPhase (= (. TouchPhase began)))
    (param delta Point (= (call Point 0 0)))
    (param tap-count U32 (= 0))
    (param radius F64 (= 0))
  )
)

(type + ScrollChangedEvent (is Tuple)
  (prop + old-position Point)
  (prop + position Point)
  (prop + cause ScrollCause)
  (prop + phase ScrollPhase (= (. ScrollPhase none)))
  (prop + momentum-phase ScrollPhase (= (. ScrollPhase none)))
)

(type + ClickEvent (is GUIEvent)
  (prop + button PointerButton)
  (prop + click-count U32)
  (fn-do + This _
    (param data PointerEventData)
    (param button PointerButton (= (. PointerButton primary)))
    (param click-count U32 (= 1))
  )
)

(type + FocusMode (is Union)
  (variant none)
  (variant press)
  (variant keys)
  (variant inside)
  (variant input)
)

(type + FocusEvent (is GUIEvent)
  (fn-do + This _
    (param data PointerEventData (= (call PointerEventData)))
  )
)

(type + BlurEvent (is GUIEvent)
  (fn-do + This _
    (param data PointerEventData (= (call PointerEventData)))
  )
)

(type + KeyPressEvent (is GUIEvent)
  (prop + key Key)
  (prop + is-repeat Bool)
  (prop + native-key-code U32)
  (prop + characters String)
  (fn-do + This _
    (param key _)
    (param key-modifiers PointerModifiers (= (call PointerModifiers)))
    (param is-repeat Bool (= false))
    (param native-key-code U32 (= 0))
    (param characters String (= ""))
    (param data PointerEventData (= (call PointerEventData)))
    (= (. this data)
      (call PointerEventData
        (block
          (arg (. data root-point))
          (arg (. data pointer-id))
          (arg (. data device-kind))
          (arg key-modifiers)
          (arg (. data buttons))
          (arg (. data ordering-time))
        )
      )
    )
  )
  (fn-expr + typed-text String :get
    (if-expr is-shortcut "" (call key-typed-text key characters))
    (where
      (lazy is-shortcut (or (. modifiers control) (. modifiers option) (. modifiers command)))
    )
  )
)

(fn-expr _ key-typed-text String
  (param key Key)
  (param characters String)
  (match key
    (case (call (. Key unknown) code)
      characters
    )
    (case (. Key space)
      characters
    )
    (default
      ""
    )
  )
)

(type + KeyReleaseEvent (is GUIEvent)
  (prop + key Key)
  (prop + native-key-code U32)
  (prop + characters String)
  (fn-do + This _
    (param key _)
    (param key-modifiers PointerModifiers (= (call PointerModifiers)))
    (param native-key-code U32 (= 0))
    (param characters String (= ""))
    (param data PointerEventData (= (call PointerEventData)))
    (= (. this data)
      (call PointerEventData
        (block
          (arg (. data root-point))
          (arg (. data pointer-id))
          (arg (. data device-kind))
          (arg key-modifiers)
          (arg (. data buttons))
          (arg (. data ordering-time))
        )
      )
    )
  )
)

(type + KeyInputEvent (is GUIEvent)
  (prop + text String)
  (prop + replaces-before Size)
  (prop + replaces-length Size)
  (fn-do + This _
    (param text _)
    (param replaces-before Size (= 0))
    (param replaces-length Size (= 0))
    (param data PointerEventData (= (call PointerEventData)))
  )
)

(type + TextCommand (is Union)
  (variant move-backward)
  (variant move-forward)
  (variant move-up)
  (variant move-down)
  (variant move-word-backward)
  (variant move-word-forward)
  (variant move-to-line-start)
  (variant move-to-line-end)
  (variant move-to-paragraph-start)
  (variant move-to-paragraph-end)
  (variant move-to-start)
  (variant move-to-end)
  (variant page-up)
  (variant page-down)
  (variant scroll-to-start)
  (variant scroll-to-end)
  (variant scroll-page-up)
  (variant scroll-page-down)
  (variant delete-backward)
  (variant delete-forward)
  (variant delete-word-backward)
  (variant delete-word-forward)
  (variant delete-to-line-start)
  (variant delete-to-line-end)
  (variant delete-to-paragraph-end)
  (variant insert-newline)
  (variant insert-line-break)
  (variant insert-tab)
  (variant insert-backtab)
  (variant cancel)
  (variant complete)
  (variant transpose)
  (variant select-all)
  (variant other String)
)

(type + TextCommandEvent (is GUIEvent)
  (prop + command TextCommand)
  (prop + extends-selection Bool)
  (prop + selector String)
  (fn-do + This _
    (param command _)
    (param extends-selection Bool (= false))
    (param selector String (= ""))
    (param data PointerEventData (= (call PointerEventData)))
  )
)

(fn-expr + text-command-event TextCommandEvent
  (param selector String)
  (call TextCommandEvent (call text-command-from-selector base) extends selector)
  (where
    (lazy suffix "AndModifySelection:")
    (lazy extends (and (> (. selector length) (. suffix length)) (call (. selector ends-with) suffix)))
    (lazy base (if-expr extends (str ([] selector (..< 0 (- (. selector length) (. suffix length)))) ":") selector))
  )
)

(fn-expr + text-command-from-selector TextCommand
  (param selector String)
  (match selector
    (case= "moveLeft:"
      (. TextCommand move-backward)
    )
    (case= "moveBackward:"
      (. TextCommand move-backward)
    )
    (case= "moveRight:"
      (. TextCommand move-forward)
    )
    (case= "moveForward:"
      (. TextCommand move-forward)
    )
    (case= "moveUp:"
      (. TextCommand move-up)
    )
    (case= "moveDown:"
      (. TextCommand move-down)
    )
    (case= "moveWordLeft:"
      (. TextCommand move-word-backward)
    )
    (case= "moveWordBackward:"
      (. TextCommand move-word-backward)
    )
    (case= "moveWordRight:"
      (. TextCommand move-word-forward)
    )
    (case= "moveWordForward:"
      (. TextCommand move-word-forward)
    )
    (case= "moveToLeftEndOfLine:"
      (. TextCommand move-to-line-start)
    )
    (case= "moveToBeginningOfLine:"
      (. TextCommand move-to-line-start)
    )
    (case= "moveToRightEndOfLine:"
      (. TextCommand move-to-line-end)
    )
    (case= "moveToEndOfLine:"
      (. TextCommand move-to-line-end)
    )
    (case= "moveToBeginningOfParagraph:"
      (. TextCommand move-to-paragraph-start)
    )
    (case= "moveParagraphBackward:"
      (. TextCommand move-to-paragraph-start)
    )
    (case= "moveToEndOfParagraph:"
      (. TextCommand move-to-paragraph-end)
    )
    (case= "moveParagraphForward:"
      (. TextCommand move-to-paragraph-end)
    )
    (case= "moveToBeginningOfDocument:"
      (. TextCommand move-to-start)
    )
    (case= "moveToEndOfDocument:"
      (. TextCommand move-to-end)
    )
    (case= "pageUp:"
      (. TextCommand page-up)
    )
    (case= "pageDown:"
      (. TextCommand page-down)
    )
    (case= "scrollToBeginningOfDocument:"
      (. TextCommand scroll-to-start)
    )
    (case= "scrollToEndOfDocument:"
      (. TextCommand scroll-to-end)
    )
    (case= "scrollPageUp:"
      (. TextCommand scroll-page-up)
    )
    (case= "scrollPageDown:"
      (. TextCommand scroll-page-down)
    )
    (case= "deleteBackward:"
      (. TextCommand delete-backward)
    )
    (case= "deleteBackwardByDecomposingPreviousCharacter:"
      (. TextCommand delete-backward)
    )
    (case= "deleteForward:"
      (. TextCommand delete-forward)
    )
    (case= "deleteWordBackward:"
      (. TextCommand delete-word-backward)
    )
    (case= "deleteWordForward:"
      (. TextCommand delete-word-forward)
    )
    (case= "deleteToBeginningOfLine:"
      (. TextCommand delete-to-line-start)
    )
    (case= "deleteToEndOfLine:"
      (. TextCommand delete-to-line-end)
    )
    (case= "deleteToEndOfParagraph:"
      (. TextCommand delete-to-paragraph-end)
    )
    (case= "insertNewline:"
      (. TextCommand insert-newline)
    )
    (case= "insertLineBreak:"
      (. TextCommand insert-line-break)
    )
    (case= "insertNewlineIgnoringFieldEditor:"
      (. TextCommand insert-line-break)
    )
    (case= "insertTab:"
      (. TextCommand insert-tab)
    )
    (case= "insertTabIgnoringFieldEditor:"
      (. TextCommand insert-tab)
    )
    (case= "insertBacktab:"
      (. TextCommand insert-backtab)
    )
    (case= "cancelOperation:"
      (. TextCommand cancel)
    )
    (case= "complete:"
      (. TextCommand complete)
    )
    (case= "transpose:"
      (. TextCommand transpose)
    )
    (case= "selectAll:"
      (. TextCommand select-all)
    )
    (default
      (call (. TextCommand other) selector)
    )
  )
)

