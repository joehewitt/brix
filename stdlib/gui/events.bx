(fn-expr + pointer-device-kind-from-native _
  (param raw U32)
  (match raw
    (case= 0
      (. PointerDeviceKind mouse)
    )
    (case= 1
      (. PointerDeviceKind pen)
    )
    (case= 2
      (. PointerDeviceKind cursor)
    )
    (case= 3
      (. PointerDeviceKind eraser)
    )
    (case= 4
      (. PointerDeviceKind touch)
    )
    (default
      (call (. PointerDeviceKind unknown) raw)
    )
  )
)

(fn-expr + pointer-button-from-native _
  (param raw U32)
  (match raw
    (case= 0
      (. PointerButton primary)
    )
    (case= 1
      (. PointerButton secondary)
    )
    (case= 2
      (. PointerButton middle)
    )
    (default
      (call (. PointerButton other) raw)
    )
  )
)

(fn-expr + pointer-device-kind-to-native _
  (param kind PointerDeviceKind)
  (match kind
    (case (. PointerDeviceKind mouse)
      0u32
    )
    (case (. PointerDeviceKind pen)
      1u32
    )
    (case (. PointerDeviceKind cursor)
      2u32
    )
    (case (. PointerDeviceKind eraser)
      3u32
    )
    (case (. PointerDeviceKind touch)
      4u32
    )
    (case (call (. PointerDeviceKind unknown) raw)
      raw
    )
  )
)

(fn-expr + pointer-button-to-native _
  (param button PointerButton)
  (match button
    (case (. PointerButton primary)
      0u32
    )
    (case (. PointerButton secondary)
      1u32
    )
    (case (. PointerButton middle)
      2u32
    )
    (case (call (. PointerButton other) raw)
      raw
    )
  )
)

(type + PointerRecordKind (is U32)
  (variant move (= 0))
  (variant down (= 1))
  (variant up (= 2))
  (variant drag (= 3))
  (variant scroll (= 4))
  (variant exit (= 5))
  (variant deactivate (= 6))
  (variant magnify (= 7))
  (variant cancel (= 8))
  (variant drop-enter (= 9))
  (variant drop-over (= 10))
  (variant drop-exit (= 11))
  (variant drop (= 12))
  (variant peer-press (= 13))
)

(type + PointerRecord (is Tuple)
  (prop + kind PointerRecordKind)
  (prop + point Point)
  (prop + delta Point (= (call Point 0 0)))
  (prop + pointer-id U64)
  (prop + device-kind U32)
  (prop + button U32)
  (prop + buttons U64)
  (prop + modifier-bits U64)
  (prop + ordering-time F64)
  (prop + click-count U32)
  (prop + is-precise _ (= false))
  (prop + phase U64)
  (prop + momentum-phase U64)
  (prop + window-drag-token U64)
  (fn-expr + data PointerEventData :get
    (call PointerEventData
      (block
        (arg point)
        (arg pointer-id)
        (arg (call pointer-device-kind-from-native device-kind))
        (arg (call pointer-modifiers-from-native modifier-bits))
        (arg buttons)
        (arg ordering-time)
      )
    )
  )
  (fn-expr + pointer-button PointerButton :get
    (call pointer-button-from-native button)
  )
)

(fn-expr + pointer-modifiers-from-native _
  (param raw U64)
  (call PointerModifiers
    (block
      (arg (!= (/and/ raw 1) 0))
      (arg (!= (/and/ raw 2) 0))
      (arg (!= (/and/ raw 4) 0))
      (arg (!= (/and/ raw 8) 0))
      (arg (!= (/and/ raw 16) 0))
      (arg (!= (/and/ raw 32) 0))
    )
  )
)

(fn-expr + key-from-native _
  (param raw U32)
  (param native-key-code U32)
  (match raw
    (case= 1
      (. Key tab)
    )
    (case= 2
      (. Key enter)
    )
    (case= 3
      (. Key escape)
    )
    (case= 4
      (. Key space)
    )
    (case= 5
      (. Key arrow-up)
    )
    (case= 6
      (. Key arrow-down)
    )
    (case= 7
      (. Key arrow-left)
    )
    (case= 8
      (. Key arrow-right)
    )
    (case= 9
      (. Key home)
    )
    (case= 10
      (. Key end)
    )
    (case= 11
      (. Key page-up)
    )
    (case= 12
      (. Key page-down)
    )
    (case= 13
      (. Key backspace)
    )
    (case= 14
      (. Key delete)
    )
    (case? (and (>= raw 100) (<= raw 115))
      (call (. Key function-key) (- raw 99))
    )
    (default
      (call (. Key unknown) native-key-code)
    )
  )
)

(fn-expr + key-to-native _
  (param key Key)
  (match key
    (case (. Key tab)
      1u32
    )
    (case (. Key enter)
      2u32
    )
    (case (. Key escape)
      3u32
    )
    (case (. Key space)
      4u32
    )
    (case (. Key arrow-up)
      5u32
    )
    (case (. Key arrow-down)
      6u32
    )
    (case (. Key arrow-left)
      7u32
    )
    (case (. Key arrow-right)
      8u32
    )
    (case (. Key home)
      9u32
    )
    (case (. Key end)
      10u32
    )
    (case (. Key page-up)
      11u32
    )
    (case (. Key page-down)
      12u32
    )
    (case (. Key backspace)
      13u32
    )
    (case (. Key delete)
      14u32
    )
    (case (call (. Key function-key) index)
      (+ index 99)
    )
    (default
      0u32
    )
  )
)

(fn-expr + pointer-modifiers-to-native _
  (param modifiers PointerModifiers)
  (/or/ shift-bit control-bit option-bit command-bit caps-lock-bit function-bit)
  (where
    (lazy shift-bit (if-expr (. modifiers shift) 1u64 0u64))
    (lazy control-bit (if-expr (. modifiers control) 2u64 0u64))
    (lazy option-bit (if-expr (. modifiers option) 4u64 0u64))
    (lazy command-bit (if-expr (. modifiers command) 8u64 0u64))
    (lazy caps-lock-bit (if-expr (. modifiers caps-lock) 16u64 0u64))
    (lazy function-bit (if-expr (. modifiers function) 32u64 0u64))
  )
)
