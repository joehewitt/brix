(import ./markdown-blocks)
(import ./markdown-theme)
(import /data/json)
(import /gui)

(type + MarkdownStat (is Tuple)
  (prop + index Index)
  (prop + label String)
  (prop + value String)
  (prop + change (? String))
  (prop + tone String)
)

(type + MarkdownExhibit (is Box)
  (prop + block MarkdownBlock)
  (prop + stats _ (= (call markdown-exhibit-stats #block)))
  (content
    (<> This (• flex-col) (• flex 1)
      (if (!= #stats null)
        (<> MarkdownStatsView
          (= stats (!! #stats))
        )
        (else-if (call markdown-exhibit-is-settled (. #block code))
          (<> Box (• markdown-code-block) (• flex-col) (• flex 1) (• px 14) (• py 12)
            (<> Text (• markdown-code)
              (<> Span
                (= text (. #block code))
              )
            )
          )
        )
        (else
          (<> Label (• markdown-waiting) (• h 22)
            (= text "Drawing…")
          )
        )
      )
    )
  )
)

(type + MarkdownStatsView (is Box)
  (prop + stats (list MarkdownStat))
  (content
    (<> This (• markdown-stats) (• flex-row) (• flex 1)
      (for (in stat #stats (keyed-by (. stat index)))
        (<> MarkdownStatView (• markdown-stat) (• flex-col) (• px 12) (• py 8) (• mr 8)
          (= stat stat)
        )
      )
    )
  )
)

(type + MarkdownStatView (is Box)
  (prop + stat MarkdownStat)
  (prop + is-good _ (= (== (. #stat tone) "good")))
  (prop + is-bad _ (= (== (. #stat tone) "bad")))
  (prop + is-warn _ (= (== (. #stat tone) "warn")))
  (content
    (<> This
      (<> Label (• markdown-stat-label) (• h 18)
        (= text (. #stat label))
      )
      (<> Label (• markdown-stat-value) (• h 26)
        (= text (. #stat value))
      )
      (if (!= (. #stat change) null)
        (<> Label (• markdown-stat-change) (• h 18)
          (= text (!! (. #stat change)))
        )
      )
    )
  )
)

(fn-expr + markdown-exhibit-stats (? (list MarkdownStat))
  (param block MarkdownBlock)
  (case? (!= (. block language) "stat")
    null
  )
  (default
    (catch? (call read-markdown-stats (. block code)))
  )
)

(fn-do _ read-markdown-stats (list MarkdownStat) (?! Error)
  (param code String)
  (let stats (call (of List MarkdownStat)))
  (for (in item (call markdown-exhibit-items (call parse-json code)))
    (let fields (call (. item object)))
    (let tone (if-expr (. ([] fields "tone") is-present) (call (. ([] fields "tone") string)) "neutral"))
    (let change (only-if (call markdown-exhibit-text ([] fields "change")) (if (. ([] fields "change") is-present))))
    (+= stats
      (call MarkdownStat
        (block
          (arg (. stats length))
          (arg (call (. ([] fields "label") string)))
          (arg (call markdown-exhibit-text ([] fields "value")))
          (arg change)
          (arg tone)
        )
      )
    )
  )
  (return stats)
)

(fn-do _ markdown-exhibit-items (list JSONReader) (?! Error)
  (param root JSON)
  (if (= (| (: fields (map String JSON))) root)
    (return (call (. (call JSONReader "exhibit items" ([] fields "items")) items)))
  )
  (return (call (. (call JSONReader "exhibit" root) items)))
)

(fn-expr _ markdown-exhibit-text _ (?! Error)
  (param reader JSONReader)
  (match (. reader value)
    (case (: text String)
      text
    )
    (case (: number Int)
      (str number)
    )
    (case (: number Float)
      (str number)
    )
    (throw (call Error (str (. reader label) " must be text or a number")))
  )
)

(fn-expr _ markdown-exhibit-is-settled _
  (param code String)
  (or (call (. trimmed ends-with) "]") (call (. trimmed ends-with) "}"))
  (where
    (lazy trimmed (call (. code trim)))
  )
)
