(import ./markdown-blocks)
(import ./markdown-source)
(import ./markdown-view)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/text)
(import /gui)
(import /math)
(blank)
(prop _ markdown-newline-width Length (= 6))

(type + MarkdownPoint (is Tuple)
  (prop + block Size)
  (prop + cell Size)
  (prop + offset Size)
)

(type + MarkdownRange (is Tuple)
  (prop + anchor MarkdownPoint)
  (prop + caret MarkdownPoint)
)

(type + MarkdownGranularity (is Union)
  (variant character)
  (variant word)
  (variant block)
)

(fn-expr + markdown-point-before Bool
  (param a MarkdownPoint)
  (param b MarkdownPoint)
  (or (< (. a block) (. b block)) (and (== (. a block) (. b block)) cell-before))
  (where
    (lazy cell-before (or (< (. a cell) (. b cell)) (and (== (. a cell) (. b cell)) (< (. a offset) (. b offset)))))
  )
)

(fn-expr + markdown-granularity MarkdownGranularity
  (param click-count U32)
  (case? (>= click-count 3)
    (. MarkdownGranularity block)
  )
  (case? (== click-count 2)
    (. MarkdownGranularity word)
  )
  (default
    (. MarkdownGranularity character)
  )
)

(fn-expr + markdown-unit-at MarkdownRange
  (param blocks (list MarkdownBlock))
  (param point MarkdownPoint)
  (param granularity MarkdownGranularity)
  (match granularity
    (case (. MarkdownGranularity character)
      (call MarkdownRange point point)
    )
    (case (. MarkdownGranularity block)
      (call MarkdownRange
        (block
          (arg start)
          (arg (call MarkdownPoint (. point block) (. point cell) (call markdown-slot-size blocks point)))
        )
      )
    )
    (case (. MarkdownGranularity word)
      (call MarkdownRange
        (block
          (arg (call MarkdownPoint (. point block) (. point cell) low))
          (arg (call MarkdownPoint (. point block) (. point cell) high))
        )
      )
    )
  )
  (where
    (lazy start (call MarkdownPoint (. point block) (. point cell) 0))
    (lazy text (call markdown-slot-text blocks point))
    (lazy runs (call markdown-slot-runs blocks point))
    (lazy low (call markdown-runs-snap runs (call markdown-word-start text (. point offset)) false))
    (lazy high (call markdown-runs-snap runs (call markdown-word-end text (. point offset)) true))
  )
)

(fn-expr + markdown-extend-range MarkdownRange
  (param blocks (list MarkdownBlock))
  (param origin MarkdownRange)
  (param point MarkdownPoint)
  (param granularity MarkdownGranularity)
  (case? (call markdown-point-before (. unit anchor) (. origin anchor))
    (call MarkdownRange (. origin caret) (. unit anchor))
  )
  (default
    (call MarkdownRange
      (block
        (arg (. origin anchor))
        (arg (if-expr (call markdown-point-before (. origin caret) (. unit caret)) (. unit caret) (. origin caret)))
      )
    )
  )
  (where
    (lazy unit (call markdown-unit-at blocks point granularity))
  )
)

(fn-expr + markdown-is-atomic Bool
  (param block MarkdownBlock)
  (or (== kind (. MarkdownBlockKind divider)) (== kind (. MarkdownBlockKind exhibit)) (call markdown-is-rendered block))
  (where
    (lazy kind (. block kind))
  )
)

(fn-expr + markdown-slot-count Size
  (param blocks (list MarkdownBlock))
  (param index Size)
  (case? (call markdown-is-atomic block)
    0
  )
  (case? (== (. block kind) (. MarkdownBlockKind grid))
    (. block cells length)
  )
  (default
    1
  )
  (where
    (lazy block ([] blocks index))
  )
)

(fn-expr + markdown-slot-runs (list MarkdownRun)
  (param blocks (list MarkdownBlock))
  (param point MarkdownPoint)
  (if-expr in-grid-cell (. ([] (. block cells) (. point cell)) runs) (. block runs))
  (where
    (lazy block ([] blocks (. point block)))
    (lazy in-grid-cell (and (== (. block kind) (. MarkdownBlockKind grid)) (< (. point cell) (. block cells length))))
  )
)

(fn-expr + markdown-slot-text String
  (param blocks (list MarkdownBlock))
  (param point MarkdownPoint)
  (case? (or (== (. block kind) (. MarkdownBlockKind code)) (== (. block kind) (. MarkdownBlockKind exhibit)))
    (. block code)
  )
  (default
    (call markdown-runs-text (call markdown-slot-runs blocks point))
  )
  (where
    (lazy block ([] blocks (. point block)))
  )
)

(fn-expr + markdown-slot-size Size
  (param blocks (list MarkdownBlock))
  (param point MarkdownPoint)
  (. (call markdown-slot-text blocks point) size)
)

(fn-expr + markdown-slot-end MarkdownPoint
  (param blocks (list MarkdownBlock))
  (param index Size)
  (call MarkdownPoint index cell (call markdown-slot-size blocks (call MarkdownPoint index cell 0)))
  (where
    (lazy count (call markdown-slot-count blocks index))
    (lazy cell (if-expr (> count 0) (- count 1) 0))
  )
)

(fn-do + markdown-editable-from (? Size)
  (param blocks (list MarkdownBlock))
  (param index Size)
  (param forward Bool)
  (let at index)
  (while (< at (. blocks length))
    (return-if at (if (and (not (call markdown-is-atomic ([] blocks at))) (> (call markdown-slot-count blocks at) 0))))
    (return-if null (if (and (not forward) (== at 0))))
    (= at (if-expr forward (+ at 1) (- at 1)))
  )
  (return null)
)

(fn-do + markdown-clamp-point MarkdownPoint
  (param blocks (list MarkdownBlock))
  (param point MarkdownPoint)
  (return-if (call MarkdownPoint 0 0 0) (if (not (. blocks length))))
  (let index (call min (. point block) (- (. blocks length) 1)))
  (let block ([] blocks index))
  (if (call markdown-is-atomic block)
    (let after (call markdown-editable-from blocks index true))
    (return-if (call MarkdownPoint after 0 0) (if (!= after null)))
    (let before (call markdown-editable-from blocks index false))
    (return-if (call markdown-slot-end blocks before) (if (!= before null)))
    (return (call MarkdownPoint index 0 0))
  )
  (let cells (if-expr (== (. block kind) (. MarkdownBlockKind grid)) (. block cells length) 1))
  (let cell (call min (. point cell) (if-expr (> cells 0) (- cells 1) 0)))
  (let at (call MarkdownPoint index cell 0))
  (return (call markdown-snap-point blocks (call MarkdownPoint index cell (call min (. point offset) (call markdown-slot-size blocks at))) null))
)

(fn-do + markdown-snap-point MarkdownPoint
  (param blocks (list MarkdownBlock))
  (param point MarkdownPoint)
  (param forward (? Bool))
  (return-if point (if (>= (. point block) (. blocks length))))
  (let kind (. ([] blocks (. point block)) kind))
  (return-if point (if (or (== kind (. MarkdownBlockKind code)) (== kind (. MarkdownBlockKind exhibit)))))
  (return (call MarkdownPoint (. point block) (. point cell) (call markdown-runs-snap (call markdown-slot-runs blocks point) (. point offset) forward)))
)

(fn-expr + markdown-first-point MarkdownPoint
  (param blocks (list MarkdownBlock))
  (call markdown-clamp-point blocks (call MarkdownPoint 0 0 0))
)

(fn-expr + markdown-last-point MarkdownPoint
  (param blocks (list MarkdownBlock))
  (case? (not (. blocks length))
    (call MarkdownPoint 0 0 0)
  )
  (case? (== index null)
    (call MarkdownPoint 0 0 0)
  )
  (default
    (call markdown-slot-end blocks index)
  )
  (where
    (lazy index (call markdown-editable-from blocks (- (. blocks length) 1) false))
  )
)

(fn-do + markdown-point-at (? MarkdownPoint)
  (param blocks (list MarkdownBlock))
  (param views (list MarkdownBlockView))
  (param point Point)
  (let found (? MarkdownBlockView) null)
  (let distance Length 0)
  (for (in view views)
    (let box (. view bounds))
    (let gap
      (scope (if-expr (< (. point y) (. box y)) (- (. box y) (. point y)) (if-expr past-bottom bottom-gap 0))
        (lazy past-bottom (>= (. point y) (+ (. box y) (. box height))))
        (lazy bottom-gap (- (. point y) (. box y) (. box height)))
      )
    )
    (if (or (not found) (< gap distance))
      (= found view)
      (= distance gap)
    )
  )
  (return-if null (if (not found)))
  (let index Size (. found block index))
  (return-if null (if (>= index (. blocks length))))
  (if (call markdown-is-atomic ([] blocks index))
    (let after (call markdown-editable-from blocks index true))
    (return-if (call MarkdownPoint after 0 0) (if (!= after null)))
    (let before (call markdown-editable-from blocks index false))
    (return-if (call markdown-slot-end blocks before) (if (!= before null)))
    (return null)
  )
  (let cell (if-expr (== (. ([] blocks index) kind) (. MarkdownBlockKind grid)) (call markdown-cell-at found point) 0))
  (let slot (call MarkdownPoint index cell 0))
  (let view (call markdown-slot-view-in found slot))
  (return-if slot (if (not view)))
  (let offset (call min (call (. view offset-at) point) (call markdown-slot-size blocks slot)))
  (return (call markdown-snap-point blocks (call MarkdownPoint index cell offset) null))
)

(fn-do + markdown-cell-at Size
  (param view MarkdownBlockView)
  (param point Point)
  (let best Size 0)
  (let distance Length 0)
  (let first true)
  (for (in cell (call markdown-grid-cells view))
    (let box (. cell bounds))
    (let dx
      (scope (if-expr (< (. point x) (. box x)) (- (. box x) (. point x)) (if-expr past-right right-gap 0))
        (lazy past-right (> (. point x) (+ (. box x) (. box width))))
        (lazy right-gap (- (. point x) (. box x) (. box width)))
      )
    )
    (let dy
      (scope (if-expr (< (. point y) (. box y)) (- (. box y) (. point y)) (if-expr past-bottom bottom-gap 0))
        (lazy past-bottom (> (. point y) (+ (. box y) (. box height))))
        (lazy bottom-gap (- (. point y) (. box y) (. box height)))
      )
    )
    (let gap (+ dx (* dy 4)))
    (if (or first (< gap distance))
      (= best (. cell cell index))
      (= distance gap)
      (= first false)
    )
  )
  (return best)
)

(fn-do + markdown-slot-view-in (? Text)
  (param view MarkdownBlockView)
  (param point MarkdownPoint)
  (if (== (. view block kind) (. MarkdownBlockKind grid))
    (for (in cell (call markdown-grid-cells view))
      (return-if cell (if (== (. cell cell index) (. point cell))))
    )
    (return null)
  )
  (return (call markdown-first-text view))
)

(fn-expr + markdown-cell-in-range Bool
  (param index Size)
  (param cell Size)
  (param start MarkdownPoint)
  (param end MarkdownPoint)
  (and (not (and (== index (. start block)) (< cell (. start cell)))) (not (and (== index (. end block)) (> cell (. end cell)))))
)

(fn-do + markdown-paint-selection _
  (param canvas Canvas)
  (param blocks (list MarkdownBlock))
  (param shown MarkdownBlockView)
  (param start MarkdownPoint)
  (param end MarkdownPoint)
  (param color RGBA)
  (param object-color RGBA)
  (let index Size (. shown block index))
  (return-if (if (or (< index (. start block)) (> index (. end block)) (>= index (. blocks length)))))
  (if (call markdown-is-atomic (. shown block))
    (= (. canvas fill-color) object-color)
    (call (. canvas rect) (. shown bounds))
    (return)
  )
  (= (. canvas fill-color) color)
  (for (in cell (..< 0 (call markdown-slot-count blocks index)))
    (if (call markdown-cell-in-range index cell start end)
      (let slot (call MarkdownPoint index cell 0))
      (let view (call markdown-slot-view-in shown slot))
      (if view
        (let low (if-expr (and (== index (. start block)) (== cell (. start cell))) (. start offset) 0))
        (let is-last (and (== index (. end block)) (== cell (. end cell))))
        (let high (if-expr is-last (. end offset) (call markdown-slot-size blocks slot)))
        (call markdown-paint-range canvas view low high (not is-last))
      )
    )
  )
)

(fn-do + markdown-paint-range _
  (param canvas Canvas)
  (param view Text)
  (param low Size)
  (param high Size)
  (param continues Bool)
  (let layout (. view text-layout))
  (return-if (if (not layout)))
  (let first (call (. layout line-at) low))
  (let last (call (. layout line-at) high))
  (let bands (list Rect))
  (for (in row (..< first (+ last 1)))
    (let line (call (. view row-rect) row))
    (if line
      (let left (if-expr (== row first) (. (?? (call (. view caret-rect) low) line) x) (. line x)))
      (let right (if-expr (== row last) (. (?? (call (. view caret-rect) high) line) x) (+ (. line x) (. line width))))
      (if (and (== row last) continues)
        (+= right markdown-newline-width)
      )
      (if (> right left)
        (+= bands (call Rect left (. line y) (- right left) (. line height)))
      )
    )
  )
  (return-if (if (not (. bands length))))
  (for (in band bands)
    (call (. canvas rect) band)
  )
  (do-use (. canvas saved-state)
    (call (. canvas begin))
    (for (in band bands)
      (call (. canvas rect-path) band)
    )
    (call (. canvas clip-path))
    (call (. view paint-text) canvas)
  )
)

(fn-do + markdown-selection-source String
  (param blocks (list MarkdownBlock))
  (param start MarkdownPoint)
  (param end MarkdownPoint)
  (param prefixes (? (list String)) (= null))
  (param sources (? (list String)) (= null))
  (if (and (== (. start block) (. end block)) (== (. start cell) (. end cell)))
    (let block ([] blocks (. start block)))
    (return-if (call markdown-slice (. block code) (. start offset) (. end offset)) (if (== (. block kind) (. MarkdownBlockKind code))))
    (return
      (call markdown-inline-source
        (block
          (arg (call markdown-runs-slice (call markdown-slot-runs blocks start) (. start offset) (. end offset)))
          (arg "")
          (arg false)
          (arg false)
        )
      )
    )
  )
  (let parts (list String))
  (let previous (? MarkdownBlockKind) null)
  (for (in index (..< (. start block) (+ (. end block) 1)))
    (let draft (call markdown-block-draft-at blocks index prefixes sources))
    (if (== index (. end block))
      (call markdown-truncate-draft draft end true)
    )
    (if (== index (. start block))
      (call markdown-truncate-draft draft start false)
    )
    (if (. parts length)
      (+= parts
        (scope (if-expr (and (== previous (. MarkdownBlockKind item)) draft-is-item) "\n" "\n\n")
          (lazy draft-is-item (== (. draft kind) (. MarkdownBlockKind item)))
        )
      )
    )
    (+= parts (call markdown-draft-source draft))
    (= previous (. draft kind))
  )
  (return (call (. "" join) parts))
)

(fn-do + markdown-block-draft-at MarkdownDraft
  (param blocks (list MarkdownBlock))
  (param index Size)
  (param prefixes (? (list String)) (= null))
  (param sources (? (list String)) (= null))
  (let block ([] blocks index))
  (let draft (call markdown-block-draft block (if-expr prefixes ([] prefixes index) "")))
  (let kind (. block kind))
  (if sources
    (if (call markdown-is-atomic block)
      (= (. draft source) ([] sources index))
    )
    (if (== kind (. MarkdownBlockKind grid))
      (let row Size 0)
      (for (in line (call (. ([] sources index) split) "\n"))
        (if (== row 1)
          (= (. draft delimiter) line)
          (else
            (+= (. draft rows) line)
          )
        )
        (+= row 1)
      )
    )
  )
  (return draft)
)

(fn-do + markdown-truncate-draft _
  (param draft MarkdownDraft)
  (param point MarkdownPoint)
  (param keeps-head Bool)
  (let kind (. draft kind))
  (if (or (== kind (. MarkdownBlockKind code)) (== kind (. MarkdownBlockKind exhibit)))
    (let size (. draft code size))
    (= (. draft code)
      (scope (if-expr keeps-head (call markdown-slice (. draft code) 0 (. point offset)) tail-code)
        (lazy tail-code (call markdown-slice (. draft code) (. point offset) size))
      )
    )
    (else-if (== kind (. MarkdownBlockKind grid))
      (for (in cell (..< 0 (. draft cells length)))
        (let size (. (call markdown-runs-text ([] (. draft cells) cell)) size))
        (if (and keeps-head (>= cell (. point cell)))
          (= ([] (. draft cells) cell)
            (call markdown-runs-slice
              (block
                (arg ([] (. draft cells) cell))
                (arg 0)
                (arg (if-expr (== cell (. point cell)) (. point offset) 0))
              )
            )
          )
          (call markdown-touch-row draft cell)
          (else-if (and (not keeps-head) (<= cell (. point cell)))
            (= ([] (. draft cells) cell)
              (call markdown-runs-slice
                (block
                  (arg ([] (. draft cells) cell))
                  (arg (if-expr (== cell (. point cell)) (. point offset) size))
                  (arg size)
                )
              )
            )
            (call markdown-touch-row draft cell)
          )
        )
      )
    )
    (else
      (let size (. (call markdown-runs-text (. draft runs)) size))
      (= (. draft runs)
        (scope (if-expr keeps-head (call markdown-runs-slice (. draft runs) 0 (. point offset)) tail-runs)
          (lazy tail-runs (call markdown-runs-slice (. draft runs) (. point offset) size))
        )
      )
    )
  )
)

(fn-do + markdown-touch-row _
  (param draft MarkdownDraft)
  (param cell Size)
  (let row (if-expr (> (. draft columns) 0) (/ cell (. draft columns)) 0))
  (if (< row (. draft rows length))
    (= ([] (. draft rows) row) null)
  )
)

(fn-do + markdown-grid-cells (list MarkdownGridCellView)
  (param box Box)
  (let found (list MarkdownGridCellView))
  (call markdown-collect-grid-cells box found)
  (return found)
)

(fn-do _ markdown-collect-grid-cells _
  (param box Box)
  (param found (list MarkdownGridCellView))
  (for (in child (call RenderedChildCursor box))
    (if (is child MarkdownGridCellView)
      (+= found (as child MarkdownGridCellView))
      (else
        (call markdown-collect-grid-cells child found)
      )
    )
  )
)

(fn-do + markdown-first-text (? Text)
  (param box Box)
  (for (in child (call RenderedChildCursor box))
    (return-if (as child Text) (if (is child Text)))
    (let found (call markdown-first-text child))
    (return-if found (if found))
  )
  (return null)
)

(fn-expr + markdown-byte-class Size
  (param byte Byte)
  (case? (or (== byte 32) (== byte 9) (== byte 10))
    0
  )
  (case? (or (>= byte 0x80) (== byte 95) (and (>= byte 48) (<= byte 57)) is-letter)
    1
  )
  (default
    2
  )
  (where
    (lazy is-letter (or (and (>= byte 65) (<= byte 90)) (and (>= byte 97) (<= byte 122))))
  )
)

(fn-do + markdown-word-start Size
  (param text String)
  (param offset Size)
  (let bytes (call byte-view text))
  (let at (call min offset (. bytes size)))
  (return-if at (if (and (== at (. bytes size)) (== at 0))))
  (let kind (call markdown-byte-class ([] bytes (if-expr (< at (. bytes size)) at (- at 1)))))
  (while (and (> at 0) (== (call markdown-byte-class ([] bytes (- at 1))) kind))
    (-= at 1)
  )
  (return at)
)

(fn-do + markdown-word-end Size
  (param text String)
  (param offset Size)
  (let bytes (call byte-view text))
  (let at (call min offset (. bytes size)))
  (return-if at (if (== at (. bytes size))))
  (let kind (call markdown-byte-class ([] bytes at)))
  (while (and (< at (. bytes size)) (== (call markdown-byte-class ([] bytes at)) kind))
    (+= at 1)
  )
  (return at)
)
