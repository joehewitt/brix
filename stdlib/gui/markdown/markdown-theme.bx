(import /graphics/color)
(import /graphics/text)
(import /gui)
(import /units)

(style-extend GUIDefaultTheme
  (using GUITextDecoration)
  (using GUIBoxCursor)
  (using GUIPopupStyle)
  (rule markdown-block (• mb 10)
    (when-style #is-heading
      (• mt 6)
      (= font-size 16)
      (= font-weight (. FontWeight bold))
    )
    (blank)
    (when-style #is-title
      (= font-size gui-title1-font-size)
    )
    (blank)
    (when-style #is-section
      (= font-size 19)
    )
    (blank)
    (when-style #is-quote
      (• text gui-muted-text-color)
      (• pl 12)
      (= border-color gui-border-color)
      (= border-left-width 3)
    )
  )
  (blank)
  (rule markdown-prose
    (= line-spacing 4)
  )
  (blank)
  (rule markdown-editor
    (= cursor (. CursorStyle text))
  )
  (blank)
  (rule markdown-marker (• text gui-muted-text-color) (• min-w 19) (• pr 7)
    (= line-spacing 4)
    (= text-alignment (. TextAlignment right))
    (= align-y (. Alignment start))
  )
  (blank)
  (rule markdown-run
    (when-style #is-strong
      (= font-weight (. FontWeight bold))
    )
    (blank)
    (when-style #is-em
      (= font-slant (. FontSlant italic))
    )
    (blank)
    (when-style #is-code
      (• bg gui-field-color)
      (• text markdown-code-color)
      (• px 4)
      (= font-family "Menlo")
      (= font-size gui-callout-font-size)
      (= corner-radius 4)
    )
  )
  (blank)
  (rule markdown-link
    (when-style #is-link
      (• text markdown-link-color)
      (= cursor (. CursorStyle pointing-hand))
    )
    (blank)
    (when-style #is-hovered-link
      (= text-decoration (. TextDecorationLine underline))
    )
  )
  (blank)
  (rule markdown-code-block (• bg gui-editor-background-color)
    (= border-color gui-border-color)
    (= border-width 1)
    (= corner-radius 8)
  )
  (blank)
  (rule markdown-code-copy (• bg gui-well-color) (• min-w 26) (• min-h 26)
    (= corner-radius 6)
    (rule icon (• w 14) (• h 14))
  )
  (blank)
  (rule markdown-code
    (= font-family "Menlo")
    (= font-size gui-callout-font-size)
    (= line-spacing 3)
  )
  (blank)
  (rule markdown-code-toggle (• bg gui-well-color) (• p 1)
    (= corner-radius 6)
    (rule Segment (• h 18) (• px 8)
      (= font-size 11)
    )
  )
  (blank)
  (rule markdown-code-error (• text markdown-bad-color)
    (= font-size gui-callout-font-size)
  )
  (blank)
  (rule markdown-divider (• bg gui-border-color))
  (blank)
  (rule markdown-grid
    (= overflow-x (. ScrollOverflow auto))
  )
  (blank)
  (rule markdown-grid-cell
    (= line-spacing 4)
    (= border-color gui-border-color)
    (= border-bottom-width 1)
    (blank)
    (when-style #is-header
      (= font-weight (. FontWeight bold))
    )
    (blank)
    (when-style #is-final-row
      (= border-bottom-width 0)
    )
  )
  (blank)
  (rule markdown-link-tooltip (• bg gui-popup-color) (• text gui-text-color) (• px 8) (• py 4)
    (= border-color gui-border-color)
    (= border-width 1)
    (= corner-radius gui-popup-radius)
    (= shadow gui-popup-shadow)
  )
  (blank)
  (rule markdown-link-tooltip-text
    (= font-size gui-callout-font-size)
  )
  (blank)
  (rule markdown-added (• text markdown-good-color))
  (blank)
  (rule markdown-removed (• text markdown-bad-color)
    (= line-spacing 3)
  )
  (blank)
  (rule markdown-stats
    (= overflow-x (. ScrollOverflow auto))
  )
  (blank)
  (rule markdown-stat (• bg gui-field-color)
    (= border-color gui-border-color)
    (= border-width 1)
    (= corner-radius gui-card-radius)
    (blank)
    (when-style #is-good
      (rule markdown-stat-change (• text markdown-good-color))
    )
    (blank)
    (when-style #is-bad
      (rule markdown-stat-change (• text markdown-bad-color))
    )
    (blank)
    (when-style #is-warn
      (rule markdown-stat-change (• text markdown-warn-color))
    )
  )
  (blank)
  (rule markdown-stat-label (• text gui-muted-text-color)
    (= font-size gui-callout-font-size)
  )
  (blank)
  (rule markdown-stat-value (• text gui-strong-text-color)
    (= font-size 19)
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule markdown-stat-change
    (= font-size gui-callout-font-size)
  )
  (blank)
  (rule markdown-waiting (• text gui-muted-text-color))
)
