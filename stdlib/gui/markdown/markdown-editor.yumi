else
    index = editable-from(point.block - 1, false) if point.block > 0
=? null if index == null
. target = blocks[index]
if target.kind == MarkdownBlockKind.grid && target.columns > 0
    . columns = target.columns
    . first = if down then 0 else target.cells.length - columns
    = MarkdownPoint(index, first + column-at(index, first, columns, x), 0)
= MarkdownPoint(index, 0, 0)

────────────────────
_ do column-at Size
    - index Size
    - first Size
    - columns Size
    - x Length

. best Size = 0
. distance Length = 0
for column in 0 .. < columns
    . view = slot-view(MarkdownPoint(index, first + column, 0))
    if view
        . box = view.bounds
        . gap = if x < box.x then box.x - x else if past-right then x - box.x - box.width else 0
            .. past-right = x > box.x + box.width
        if column == 0 || gap < distance
            best = column
            distance = gap
