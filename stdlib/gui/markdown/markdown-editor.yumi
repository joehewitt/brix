╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do perform-edit Bool
    - role MenuRole

. active = session
=? false if !active
do match role
    | .undo
        sync-session-caret(active)
        active.undo()
        session-updated()
    | .redo
        sync-session-caret(active)
        active.redo()
        session-updated()
    | .select-all
        anchor = first-point()
        caret = last-point()
        refresh-view()
    ??
        = false
= true

────────────────────
+ do insert-text
    - typed String

=? if !typed.size
. start = selection-start()
. end = selection-end()
. block = blocks[start.block]
. is-code = block.kind == MarkdownBlockKind.code
. text = if is-code then typed else " ".join(typed.split("\n"))
if start == end && text == " " && apply-input-rule(start)
    =
edit-range(start, end, text, start == end)

────────────────────
+ do toggle-mark
    - mark MarkdownMark

. start = selection-start()
. end = selection-end()
if start == end
    . marks = typing-marks ?? markdown-runs-marks-at(slot-runs(caret), caret.offset)
    typing-marks = markdown-marks-with(marks, mark, !markdown-marks-has(marks, mark))
    =
. drafts [MarkdownDraft]
for index in start.block .. < end.block + 1
    . draft = draft-at(index)
    . kind = draft.kind
    if kind == MarkdownBlockKind.grid
        for cell in 0 .. < draft.cells.length
            if markdown-cell-in-range(index, cell, start, end)
                . size = markdown-runs-text(draft.cells[cell]).size
                . from = if index == start.block && cell == start.cell then start.offset else 0
                . to = if index == end.block && cell == end.cell then end.offset else size
                draft.cells[cell] = markdown-runs-toggle(draft.cells[cell], from, to, mark)
                markdown-touch-row(draft, cell)
    else if markdown-is-prose(kind)
        . size = markdown-runs-text(draft.runs).size
        . from = if index == start.block then start.offset else 0
        . to = if index == end.block then end.offset else size
        draft.runs = markdown-runs-toggle(draft.runs, from, to, mark)
    drafts += draft
commit(start.block, end.block, drafts, MarkdownPoint(0, 0, 0))
anchor = start
caret = end
refresh-view()

────────────────────
+ do set-heading
    - level Size

. start = selection-start()
. end = selection-end()
. drafts [MarkdownDraft]
for index in start.block .. < end.block + 1
    . draft = draft-at(index)
    if markdown-is-prose(draft.kind)
        draft.kind = if level > 0 then MarkdownBlockKind.heading else MarkdownBlockKind.paragraph
        draft.level = level
        draft.prefix = ""
    drafts += draft
commit(start.block, end.block, drafts, MarkdownPoint(0, 0, 0))
anchor = clamp-point(start)
caret = clamp-point(end)
refresh-view()

────────────────────
_ do press Bool
    - event KeyPressEvent

. active = session
=? false if !active
. role = markdown-edit-role(event)
=? perform-edit(role) if role
if markdown-save-key.matches(event)
    sync-session-caret(active)
    save-requested <- active
    = true
if markdown-bold-key.matches(event)
    toggle-mark(MarkdownMark.strong)
    = true
if markdown-italic-key.matches(event)
    toggle-mark(MarkdownMark.em)
    = true
if markdown-paragraph-key.matches(event)
    set-heading(0)
    = true
for index in 0 .. < markdown-heading-keys.length
    if markdown-heading-keys[index].matches(event)
        set-heading(index + 1)
        = true
= false

────────────────────
for event on pointer-down

if event.button == PointerButton.primary && !event.modifiers.command
    click-at(event.root-point, event.click-count, event.modifiers.shift)

────────────────────
for event on pointer-drag

. found = point-at(content-point(event.root-point))
if found != null
    . range = markdown-extend-range(blocks, drag-origin, found, drag-granularity)
    anchor = range.anchor
    caret = range.caret
    goal-x = null
    refresh-view()

────────────────────
for event on key-press

. modifiers = event.modifiers
if event.key == Key.tab && !modifiers.command && !modifiers.control && !modifiers.option
    perform(if modifiers.shift then TextCommand.insert-backtab else TextCommand.insert-tab)
    event.cancel()
else if press(event)
    event.cancel()

────────────────────
for event on key-input

if session
    if event.replaces-before > 0 && caret == anchor
        . text = slot-text(caret)
        . start Size = caret.offset
        for index in 0 .. < event.replaces-before
            start = markdown-previous-char(text, start)
        anchor = MarkdownPoint(caret.block, caret.cell, start)
    insert-text(event.text)
    goal-x = null

────────────────────
for event on text-command

perform(event.command, event.extends-selection)

────────────────────
for event on copy

if copy-selection(event.clipboard)
    event.cancel()

────────────────────
for event on cut

if session && copy-selection(event.clipboard)
    edit-range(selection-start(), selection-end(), "", false)
    event.cancel()

────────────────────
for event on paste

. pasted = event.clipboard.read-text()
if session && pasted
    paste-text(pasted)
    event.cancel()

────────────────────
for event on focus

start-blink()
repaint()

────────────────────
for event on blur

store-caret()
stop-blink()
repaint()

╌╌╌╌╌╌╌╌╌╌ is Box ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do close

stop-blink()
shown-generation += 1
session = null
model.detach()
super.close()

────────────────────
+ do did-layout

super.did-layout()
=? if !reveals
reveals = false
reveal-caret()

╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌

────────────────────
_ do refresh-view

reveals = true
invalidate-layout()
if is-focused
    start-blink()
    text-input-changed()
repaint()

────────────────────
_ do repaint

. low = if caret.block < anchor.block then caret.block else anchor.block
. high = if caret.block > anchor.block then caret.block else anchor.block
. first = if low < painted-first then low else painted-first
. last = if high > painted-last then high else painted-last
painted-first = low
painted-last = high
for row in editor-rows()
    . view = markdown-row-view(row)
    if view && view.block.index >= first && view.block.index <= last
        row.invalidate-paint()

────────────────────
_ do repaint-rows

for row in editor-rows()
    row.invalidate-paint()

────────────────────
_ do reveal-caret

. view = slot-view(caret)
if !view
    =? if reveal-tries >= 3 || caret.block >= blocks.length
    reveal-tries += 1
    . ignored = rows.scroll-to-address(caret.block, ScrollAlignment.nearest)
    reveals = true
    invalidate-layout()
    =
reveal-tries = 0
. rect = view.caret-rect(caret.offset)
=? if rect == null
. ignored = view.reveal-in-ancestors(rect, ScrollAlignment.nearest, Insets(24, 0, 24, 0))

────────────────────
_ do session-updated

. active = session
=? if !active || is-applying || active.revision == shown-revision
rebuild(active)
adopt-session-caret(active)
goal-x = null
typing-marks = null
refresh-view()

────────────────────
_ do adopt-session-caret
    - active CodeSession

caret = point-at-source(active.text, active.caret)
anchor = point-at-source(active.text, active.anchor)

────────────────────
_ do sync-session-caret
    - active CodeSession

. text = active.text
. at = source-at-point(text, caret)
. from = source-at-point(text, anchor)
if active.caret != at || active.anchor != from
    active.select-range(from, at)

────────────────────
_ do rebuild
    - active CodeSession

shown-revision = active.revision
. change = model.sync(active.text, base)
=? if change == null
if change.is-rebuilt
    blocks = model.blocks
    block-layout.reset()
    rows.restore-scroll(Point(0, 0))
else if change.removed > 0 || change.added > 0
    block-layout.splice(block-source, change.at, change.removed, change.added)
    repaint-rows()
block-source.revision.bump()
reveal-pending-line()

────────────────────
_ do commit
    - first Size
    - last Size
    - drafts [MarkdownDraft]
    - next MarkdownPoint
    - coalescing = false

. active = session
=? if !active || !drafts.length
sync-session-caret(active)
. text = active.text
. range-start = if first > 0 then model.ends[first - 1] else 0
. range-end = if last + 1 < blocks.length then model.starts[last + 1] else text.length
. parts [String]
. leading = text.text-in(range-start, model.starts[first])
if first > 0
    parts += markdown-gap
        - leading
        - blocks[first - 1].kind
        - model.is-empty-block(first - 1)
        - drafts[0].kind
        - drafts[0].is-empty
else
    parts += leading
for index in 0 .. < drafts.length
    if index > 0
        parts += markdown-separator(drafts[index - 1], drafts[index])
    parts += markdown-draft-source(drafts[index])
. tail = drafts[drafts.length - 1]
. trailing = text.text-in(model.ends[last], range-end)
if last + 1 < blocks.length
    parts += markdown-gap
        - trailing
        - tail.kind
        - tail.is-empty
        - blocks[last + 1].kind
        - model.is-empty-block(last + 1)
else if !trailing.size && tail.is-empty
    parts += "\n"
else
    parts += trailing
apply-diff(active, range-start, text.text-in(range-start, range-end), "".join(parts), coalescing)
rebuild(active)
caret = clamp-point(MarkdownPoint(first + next.block, next.cell, next.offset))
anchor = caret
goal-x = null
typing-marks = null
sync-session-caret(active)
refresh-view()

────────────────────
_ do apply-diff
    - active CodeSession
    - start Size
    - old String
    - replacement String
    - coalescing Bool

. a = old as Byte[]
. b = replacement as Byte[]
. prefix Size = 0
while prefix < a.size && prefix < b.size && a[prefix] == b[prefix]
    prefix += 1
while prefix > 0 && prefix < a.size && a[prefix] >= 0x80 && a[prefix] < 0xC0
    prefix -= 1
. suffix Size = 0
while suffix < a.size - prefix && suffix < b.size - prefix && a[a.size - 1 - suffix] == b[b.size - 1 - suffix]
    suffix += 1
while suffix > 0 && a[a.size - suffix] >= 0x80 && a[a.size - suffix] < 0xC0
    suffix -= 1
=? if prefix == a.size && prefix == b.size
is-applying = true
active.replace
    - start + prefix
    - start + a.size - suffix
    - markdown-slice(replacement, prefix, b.size - suffix)
    - coalescing
is-applying = false

────────────────────
_ do edit-range
    - start MarkdownPoint
    - end MarkdownPoint
    - typed String
    - coalescing Bool

if start.block == end.block
    . draft = draft-at(start.block)
    delete-in-draft(draft, start, end)
    if typed.size
        insert-in-draft(draft, start.cell, start.offset, typed)
    commit
        - start.block
        - start.block
        - [draft]
        - MarkdownPoint(0, start.cell, start.offset + typed.size)
        - coalescing
    =
. head = draft-at(start.block)
. tail = draft-at(end.block)
. drops-head = !head.is-prose && start.cell == 0 && start.offset == 0
. drops-tail = !tail.is-prose && end == slot-end-of(end.block)
markdown-truncate-draft(head, start, true)
markdown-truncate-draft(tail, end, false)
if head.is-prose && tail.is-prose
    . merged = if model.is-empty-block(start.block) then tail else head
    merged.runs = markdown-runs-join(head.runs, tail.runs)
    if typed.size
        insert-in-draft(merged, 0, start.offset, typed)
    if !merged.runs.length
        merged = MarkdownDraft(MarkdownBlockKind.paragraph)
    commit(start.block, end.block, [merged], MarkdownPoint(0, 0, start.offset + typed.size))
    =
. drafts [MarkdownDraft]
. next = MarkdownPoint(0, start.cell, start.offset + typed.size)
if head.is-prose && !head.runs.length
    head = MarkdownDraft(MarkdownBlockKind.paragraph)
if !drops-head
    if typed.size
        insert-in-draft(head, start.cell, start.offset, typed)
    drafts += head
if !drops-tail
    drafts += tail
if drops-head
    next = MarkdownPoint(0, 0, typed.size)
    if typed.size || !drafts.length
        . front = MarkdownDraft(MarkdownBlockKind.paragraph)
        if typed.size
            insert-in-draft(front, 0, 0, typed)
        drafts.insert(front, 0)
commit(start.block, end.block, drafts, next)

────────────────────
_ do insert-in-draft
    - draft MarkdownDraft
    - cell Size
    - offset Size
    - typed String

. kind = draft.kind
if kind == MarkdownBlockKind.code || kind == MarkdownBlockKind.exhibit
    draft.code = "${markdown-slice(draft.code, 0, offset)}$typed$code-tail"
        .. code-tail = markdown-slice(draft.code, offset, draft.code.size)
else if kind == MarkdownBlockKind.grid
    . runs = draft.cells[cell]
    draft.cells[cell] = markdown-runs-insert
        - runs
        - offset
        - typed
        - typing-marks ?? markdown-runs-marks-at(runs, offset)
    markdown-touch-row(draft, cell)
else
    draft.runs = markdown-runs-insert
        - draft.runs
        - offset
        - typed
        - typing-marks ?? markdown-runs-marks-at(draft.runs, offset)

────────────────────
_ do delete-in-draft
    - draft MarkdownDraft
    - start MarkdownPoint
    - end MarkdownPoint

=? if start == end
. kind = draft.kind
if kind == MarkdownBlockKind.code || kind == MarkdownBlockKind.exhibit
    draft.code = "${markdown-slice(draft.code, 0, start.offset)}$code-tail"
        .. code-tail = markdown-slice(draft.code, end.offset, draft.code.size)
else if kind == MarkdownBlockKind.grid
    for cell in start.cell .. < end.cell + 1
        . size = markdown-runs-text(draft.cells[cell]).size
        . from = if cell == start.cell then start.offset else 0
        . to = if cell == end.cell then end.offset else size
        draft.cells[cell] = markdown-runs-delete(draft.cells[cell], from, to)
        markdown-touch-row(draft, cell)
else
    draft.runs = markdown-runs-delete(draft.runs, start.offset, end.offset)

────────────────────
_ do apply-input-rule Bool
    - point MarkdownPoint

. draft = draft-at(point.block)
=? false if draft.kind != MarkdownBlockKind.paragraph
. text = markdown-runs-text(draft.runs)
. marker = markdown-slice(text, 0, point.offset)
. size = text.size
. rest = markdown-runs-slice(draft.runs, point.offset, size)
. heading = markdown-heading-marker(marker)
if heading > 0
    draft.kind = MarkdownBlockKind.heading
    draft.level = heading
    draft.prefix = "$marker "
else if marker == "-" || marker == "*" || marker == "+" || markdown-is-ordered-marker(marker)
    draft.kind = MarkdownBlockKind.item
    draft.prefix = "$marker "
else if marker == ">"
    draft.kind = MarkdownBlockKind.quote
    draft.prefix = "> "
else
    = false
draft.runs = rest
commit(point.block, point.block, [draft], MarkdownPoint(0, 0, 0))
= true

────────────────────
_ do split

. active = session
=? if !active
if anchor != caret
    edit-range(selection-start(), selection-end(), "", false)
. point = caret
. draft = draft-at(point.block)
. kind = draft.kind
. size = slot-size(point)
if kind == MarkdownBlockKind.grid
    . columns = draft.columns
    if point.cell + columns < draft.cells.length
        set-caret(MarkdownPoint(point.block, point.cell + columns, 0), false)
        refresh-view()
        =
    append-row(draft)
    commit(point.block, point.block, [draft], MarkdownPoint(0, point.cell + columns, 0))
    =
if kind == MarkdownBlockKind.code
    . code = draft.code
    if point.offset == size && code.ends-with("\n")
        draft.code = markdown-slice(code, 0, size - 1)
        commit
            - point.block
            - point.block
            - [draft, MarkdownDraft(MarkdownBlockKind.paragraph)]
            - MarkdownPoint(1, 0, 0)
        =
    . indent = markdown-line-indent(code, point.offset)
    insert-in-draft(draft, 0, point.offset, "\n$indent")
    commit(point.block, point.block, [draft], MarkdownPoint(0, 0, point.offset + 1 + indent.size))
    =
if kind == MarkdownBlockKind.paragraph && block-rule(point, draft)
    =
if kind == MarkdownBlockKind.item && !size
    commit
        - point.block
        - point.block
        - [MarkdownDraft(MarkdownBlockKind.paragraph)]
        - MarkdownPoint(0, 0, 0)
    =
if draft.is-empty
    commit
        - point.block
        - point.block
        - [draft, MarkdownDraft(MarkdownBlockKind.paragraph)]
        - MarkdownPoint(1, 0, 0)
    =
. tail = draft.copy()
draft.runs = markdown-runs-slice(draft.runs, 0, point.offset)
tail.runs = markdown-runs-slice(tail.runs, point.offset, size)
if kind == MarkdownBlockKind.item
    tail.prefix = markdown-next-item-prefix(draft.prefix)
else if point.offset == size || kind == MarkdownBlockKind.heading
    tail.kind = MarkdownBlockKind.paragraph
    tail.prefix = ""
if point.offset == 0 && size > 0 && kind != MarkdownBlockKind.item
    commit
        - point.block
        - point.block
        - [MarkdownDraft(MarkdownBlockKind.paragraph), tail]
        - MarkdownPoint(1, 0, 0)
    =
commit(point.block, point.block, [draft, tail], MarkdownPoint(1, 0, 0))

────────────────────
_ do block-rule Bool
    - point MarkdownPoint
    - draft MarkdownDraft

. text = markdown-runs-text(draft.runs)
=? false if point.offset != text.size
if text == "---"
    commit
        - point.block
        - point.block
        - [MarkdownDraft(MarkdownBlockKind.divider), MarkdownDraft(MarkdownBlockKind.paragraph)]
        - MarkdownPoint(1, 0, 0)
    = true
if text.starts-with("```")
    . code = MarkdownDraft(MarkdownBlockKind.code)
    code.language = markdown-slice(text, 3, text.size).trim()
    commit(point.block, point.block, [code], MarkdownPoint(0, 0, 0))
    = true
. cells = markdown-header-cells(text)
=? false if cells.length < 1
. grid = MarkdownDraft(MarkdownBlockKind.grid)
grid.columns = cells.length
for cell in cells
    . runs [MarkdownRun]
    runs += markdown-marked-run(cell, MarkdownMarks())
    grid.cells += runs
for cell in cells
    grid.cells += List'MarkdownRun()
commit(point.block, point.block, [grid], MarkdownPoint(0, grid.columns, 0))
= true

────────────────────
_ do append-row
    - draft MarkdownDraft

for column in 0 .. < draft.columns
    draft.cells += List'MarkdownRun()

────────────────────
_ do delete-backward

if anchor != caret
    edit-range(selection-start(), selection-end(), "", false)
    =
. point = caret
if point.offset > 0
    . start = markdown-previous-char(slot-text(point), point.offset)
    edit-range(MarkdownPoint(point.block, point.cell, start), point, "", false)
    =
. block = blocks[point.block]
. kind = block.kind
if kind == MarkdownBlockKind.grid
    move-horizontally(false, false, false)
    =
if kind == MarkdownBlockKind.code
    if !block.code.size
        commit
            - point.block
            - point.block
            - [MarkdownDraft(MarkdownBlockKind.paragraph)]
            - MarkdownPoint(0, 0, 0)
    else
        move-horizontally(false, false, false)
    =
if kind != MarkdownBlockKind.paragraph
    . draft = draft-at(point.block)
    draft.kind = MarkdownBlockKind.paragraph
    draft.prefix = ""
    draft.level = 0
    commit(point.block, point.block, [draft], MarkdownPoint(0, 0, 0))
    =
=? if point.block == 0
. previous = point.block - 1
. before = blocks[previous]
if markdown-is-atomic(before.kind) || model.is-empty-block(previous)
    commit(previous, point.block, [draft-at(point.block)], MarkdownPoint(0, 0, 0))
else if markdown-is-prose(before.kind)
    . merged = draft-at(previous)
    . size = markdown-runs-text(merged.runs).size
    merged.runs = markdown-runs-join(merged.runs, draft-at(point.block).runs)
    commit(previous, point.block, [merged], MarkdownPoint(0, 0, size))
else if model.is-empty-block(point.block)
    . end = slot-end-of(previous)
    commit(previous, point.block, [draft-at(previous)], MarkdownPoint(0, end.cell, end.offset))
else
    set-caret(slot-end-of(previous), false)

────────────────────
_ do delete-forward

if anchor != caret
    edit-range(selection-start(), selection-end(), "", false)
    =
. point = caret
. size = slot-size(point)
if point.offset < size
    . end = markdown-next-char(slot-text(point), point.offset)
    edit-range(point, MarkdownPoint(point.block, point.cell, end), "", false)
    =
. block = blocks[point.block]
=? if block.kind == MarkdownBlockKind.grid
. next = point.block + 1
=? if next >= blocks.length
. after = blocks[next]
. here = draft-at(point.block)
if markdown-is-atomic(after.kind) || model.is-empty-block(next)
    commit(point.block, next, [here], MarkdownPoint(0, point.cell, point.offset))
else if here.is-empty
    commit(point.block, next, [draft-at(next)], MarkdownPoint(0, 0, 0))
else if markdown-is-prose(block.kind) && markdown-is-prose(after.kind)
    here.runs = markdown-runs-join(here.runs, draft-at(next).runs)
    commit(point.block, next, [here], MarkdownPoint(0, 0, point.offset))

────────────────────
_ do delete-word
    - forward Bool

if anchor != caret
    edit-range(selection-start(), selection-end(), "", false)
    =
. point = caret
. text = slot-text(point)
if forward
    =? delete-forward() if point.offset >= text.size
    edit-range
        - point
        - MarkdownPoint(point.block, point.cell, markdown-word-right(text, point.offset))
        - ""
        - false
else
    =? delete-backward() if point.offset == 0
    edit-range
        - MarkdownPoint(point.block, point.cell, markdown-word-left(text, point.offset))
        - point
        - ""
        - false

────────────────────
_ do delete-to-row-edge
    - forward Bool

if anchor != caret
    edit-range(selection-start(), selection-end(), "", false)
    =
. edge = row-edge(caret, forward)
if forward && edge.offset > caret.offset
    edit-range(caret, edge, "", false)
else if !forward && edge.offset < caret.offset
    edit-range(edge, caret, "", false)
else if forward
    delete-forward()
else
    delete-backward()

────────────────────
_ do tab
    - backward Bool

. point = caret
. block = blocks[point.block]
. kind = block.kind
if kind == MarkdownBlockKind.grid
    if backward
        =? if point.cell == 0
        set-caret(MarkdownPoint(point.block, point.cell - 1, 0), false)
        =
    if point.cell + 1 < block.cells.length
        set-caret(MarkdownPoint(point.block, point.cell + 1, 0), false)
        =
    . draft = draft-at(point.block)
    append-row(draft)
    commit(point.block, point.block, [draft], MarkdownPoint(0, point.cell + 1, 0))
    =
if kind == MarkdownBlockKind.code && !backward
    edit-range(selection-start(), selection-end(), "    ", false)
    =
=? if kind != MarkdownBlockKind.item
. draft = draft-at(point.block)
. indent = markdown-leading-spaces(draft.prefix)
if backward
    =? if indent == 0
    draft.prefix = markdown-slice(draft.prefix, min(indent, 2), draft.prefix.size)
else
    =? if point.block == 0 || blocks[point.block - 1].kind != MarkdownBlockKind.item
    draft.prefix = "  ${draft.prefix}"
commit(point.block, point.block, [draft], MarkdownPoint(0, 0, point.offset))

────────────────────
+ do paste-text
    - pasted String

. text = "\n".join(pasted.split("\r\n"))
if anchor != caret
    edit-range(selection-start(), selection-end(), "", false)
. point = caret
. kind = blocks[point.block].kind
if kind == MarkdownBlockKind.code || kind == MarkdownBlockKind.grid || text.find("\n") == null
    if kind == MarkdownBlockKind.code || kind == MarkdownBlockKind.grid
        insert-text(text)
        =
    . parsed = markdown-blocks(text, base)
    if parsed.length == 1 && parsed[0].kind == MarkdownBlockKind.paragraph
        . draft = draft-at(point.block)
        . runs = markdown-runs-normalized(parsed[0].runs)
        . size = markdown-runs-text(draft.runs).size
        draft.runs = markdown-runs-join
            - markdown-runs-join(markdown-runs-slice(draft.runs, 0, point.offset), runs)
            - markdown-runs-slice(draft.runs, point.offset, size)
        commit
            - point.block
            - point.block
            - [draft]
            - MarkdownPoint(0, 0, point.offset + markdown-runs-text(runs).size)
        =
    insert-text(text)
    =
. draft = draft-at(point.block)
. size = markdown-runs-text(draft.runs).size
. tail = draft.copy()
draft.runs = markdown-runs-slice(draft.runs, 0, point.offset)
tail.runs = markdown-runs-slice(tail.runs, point.offset, size)
. drafts [MarkdownDraft]
drafts += draft
for block in markdown-blocks(text, base)
    drafts += markdown-block-draft(block, "")
. last = drafts[drafts.length - 1]
. caret-block = drafts.length - 1
. caret-offset = if last.is-prose then markdown-runs-text(last.runs).size else 0
if tail.runs.length
    if last.is-prose
        last.runs = markdown-runs-join(last.runs, tail.runs)
    else
        drafts += tail
if drafts.length > 1 && drafts[1].kind == MarkdownBlockKind.paragraph && drafts[0].is-prose
    . first-size = markdown-runs-text(drafts[0].runs).size
    drafts[0].runs = markdown-runs-join(drafts[0].runs, drafts[1].runs)
    if caret-block == 1
        caret-offset += first-size
    drafts.remove(1)
    caret-block -= 1
if drafts.length > 1 && drafts[0].is-empty
    drafts.remove(0)
    caret-block -= 1
commit(point.block, point.block, drafts, MarkdownPoint(caret-block, 0, caret-offset))

────────────────────
_ do copy-selection Bool
    - clipboard Clipboard

=? false if anchor == caret
= clipboard.write-text(selection-source())

────────────────────
_ selection-source String

markdown-selection-source(blocks, selection-start(), selection-end(), model.prefixes, model.sources)

────────────────────
_ draft-at MarkdownDraft
    - index Size

markdown-block-draft-at(blocks, index, model.prefixes, model.sources)

────────────────────
_ selection-start MarkdownPoint

if markdown-point-before(caret, anchor) then caret else anchor

────────────────────
_ selection-end MarkdownPoint

if markdown-point-before(caret, anchor) then anchor else caret

────────────────────
_ do set-caret
    - point MarkdownPoint
    - extends Bool

caret = point
if !extends
    anchor = point
typing-marks = null

────────────────────
_ clamp-point MarkdownPoint
    - point MarkdownPoint

markdown-clamp-point(blocks, point)

────────────────────
_ editable-from Size?
    - index Size
    - forward Bool

markdown-editable-from(blocks, index, forward)

────────────────────
_ slot-count Size
    - index Size

markdown-slot-count(blocks, index)

────────────────────
_ slot-runs [MarkdownRun]
    - point MarkdownPoint

markdown-slot-runs(blocks, point)

────────────────────
_ slot-text String
    - point MarkdownPoint

markdown-slot-text(blocks, point)

────────────────────
_ slot-size Size
    - point MarkdownPoint

markdown-slot-size(blocks, point)

────────────────────
_ slot-end-of MarkdownPoint
