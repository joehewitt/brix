??
    slot-end-of(index)

.. index = editable-from(point.block - 1, false)

────────────────────
_ do move-horizontally
    - forward Bool
    - by-word Bool
    - extends Bool

if anchor != caret && !extends
    set-caret(if forward then selection-end() else selection-start(), false)
    =
. text = slot-text(caret)
if forward && caret.offset < text.size
    . next = if by-word then markdown-word-right(text, caret.offset) else next-char
        .. next-char = markdown-next-char(text, caret.offset)
    set-caret(MarkdownPoint(caret.block, caret.cell, next), extends)
else if !forward && caret.offset > 0
    . next = if by-word then markdown-word-left(text, caret.offset) else previous-char
        .. previous-char = markdown-previous-char(text, caret.offset)
    set-caret(MarkdownPoint(caret.block, caret.cell, next), extends)
else
    . neighbor = if forward then next-slot(caret) else previous-slot(caret)
    if neighbor != null
        set-caret(neighbor, extends)

────────────────────
_ do move-vertically
    - down Bool
    - extends Bool

. view = slot-view(caret)
. rect = point-rect(caret)
. layout = view?.text-layout
if !view || rect == null || !layout
    . fallback = vertical-neighbor(caret, down, goal-x ?? 0)
    if fallback != null
        set-caret(fallback, extends)
    =
. x = goal-x ?? rect.x
. row = layout.line-at(caret.offset)
. target MarkdownPoint? = null
if down && row + 1 < layout.line-count
    target = MarkdownPoint(caret.block, caret.cell, row-offset(view, row + 1, x))
else if !down && row > 0
    target = MarkdownPoint(caret.block, caret.cell, row-offset(view, row - 1, x))
else
