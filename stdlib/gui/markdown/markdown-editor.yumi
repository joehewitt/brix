            target = MarkdownPoint(neighbor.block, neighbor.cell, row-offset(other, edge, x))
        else
            target = neighbor
    else
        target = MarkdownPoint(caret.block, caret.cell, if down then slot-size(caret) else 0)
if target != null
    set-caret(target, extends)
goal-x = x

