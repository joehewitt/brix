+ MarkdownEditor is Box
    is UndoTarget

+ session CodeSession?
+ base String
+ column-width Length? = null
+ column-padding = Insets(0, 0, 0, 0)
+ text-input-context => caret-context()
+ undo-target => this
+ event save-requested CodeSession

_ blocks [MarkdownBlock]
_ model = MarkdownModel()
_ block-source := MarkdownBlockSource(model)
_ block-layout := markdown-block-layout(block-source)
_ painted-first Size
_ painted-last Size
_ reveal-tries Size
_ caret = MarkdownPoint(0, 0, 0)
_ anchor = MarkdownPoint(0, 0, 0)
_ drag-origin = MarkdownRange(MarkdownPoint(0, 0, 0), MarkdownPoint(0, 0, 0))
_ drag-granularity = MarkdownGranularity.character
_ shown-revision U64
_ shown-generation U64
_ goal-x Length?
_ typing-marks MarkdownMarks?
_ is-applying = false
_ reveals = false
_ pending-line Size?
_ is-caret-lit = true
_ blink-generation U64

• This • markdown-editor flex-col
    focus-mode = FocusMode.input

────────────────────

<This
    <VirtualRegion'MarkdownBlock rows • flex:1
        source = block-source
        virtual-layout = block-layout
        overscan = VirtualInsets(markdown-overscan, 0vcoord, markdown-overscan, 0vcoord)
        binds-viewport-first = true

        <MarkdownEditorRow (row) - slot • flex-col
            editor = this
            padding-left = #column-padding.left
            padding-right = #column-padding.right
            <MarkdownBlockView
                block = slot.#item
                is-editable = true
                min-width = SizeSpec.percent(100%)
                max-width = if #column-width != null then SizeSpec.coord(#column-width) else SizeSpec.auto
                align-x = Alignment.center

────────────────────
whenever #column-padding

block-layout.leading = column-padding.top as VirtualCoord
block-layout.trailing = column-padding.bottom as VirtualCoord
block-source.inset = (column-padding.left + column-padding.right) as VirtualCoord

────────────────────
whenever #column-width

block-source.limit = (column-width ?? 0) as VirtualCoord

────────────────────
+ do show
    - next CodeSession

shown-generation += 1
. generation = shown-generation
session = next
rebuild(next)
adopt-session-caret(next)
invalidate-layout()
repaint()
for revision on next.updated until generation != shown-generation
    session-updated()

────────────────────
+ do top-line Size?

. top = rows.content-bounds.y + rows.content-offset.y
. found MarkdownBlockView? = null
for view in block-views()
    if view.block.index < blocks.length && view.bounds.y + view.bounds.height > top + 1
        if !found || view.block.index < found.block.index
            found = view
= found?.block.line

────────────────────
+ do reveal-line
    - line Size

pending-line = line
reveal-pending-line()

────────────────────
+ do store-caret

. active = session
if active
    sync-session-caret(active)

────────────────────
+ do click-at
    - root-point Point
    - click-count U32
    - extends Bool

request-focus()
. found = point-at(content-point(root-point))
=? if found == null
drag-granularity = markdown-granularity(click-count)
. keeps = drag-granularity == MarkdownGranularity.character && extends
drag-origin = if keeps then MarkdownRange(anchor, anchor) else found-unit
    .. found-unit = markdown-unit-at(blocks, found, drag-granularity)
. range = markdown-extend-range(blocks, drag-origin, found, drag-granularity)
anchor = range.anchor
caret = range.caret
goal-x = null
typing-marks = null
refresh-view()

────────────────────
+ do perform
    - command TextCommand
    - extends = false

. active = session
=? if !active
if command != TextCommand.move-up && command != TextCommand.move-down
    goal-x = null
do match command
    | .move-backward
        move-horizontally(false, false, extends)
    | .move-forward
        move-horizontally(true, false, extends)
    | .move-word-backward
        move-horizontally(false, true, extends)
    | .move-word-forward
        move-horizontally(true, true, extends)
    | .move-up
        move-vertically(false, extends)
    | .move-down
        move-vertically(true, extends)
    | .move-to-line-start
        move-to-row-edge(false, extends)
    | .move-to-line-end
        move-to-row-edge(true, extends)
    | .move-to-paragraph-start
        set-caret(MarkdownPoint(caret.block, caret.cell, 0), extends)
    | .move-to-paragraph-end
        set-caret(MarkdownPoint(caret.block, caret.cell, slot-size(caret)), extends)
    | .move-to-start
        set-caret(first-point(), extends)
    | .move-to-end
        set-caret(last-point(), extends)
    | .page-up
        move-page(false, extends)
    | .page-down
        move-page(true, extends)
    | .delete-backward
        delete-backward()
    | .delete-forward
        delete-forward()
    | .delete-word-backward
        delete-word(false)
    | .delete-word-forward
        delete-word(true)
    | .delete-to-line-start
        delete-to-row-edge(false)
    | .delete-to-line-end
        delete-to-row-edge(true)
    | .delete-to-paragraph-end
        delete-to-row-edge(true)
    | .insert-newline
        split()
    | .insert-line-break
        split()
    | .insert-tab
        tab(false)
    | .insert-backtab
        tab(true)
    | .select-all
        anchor = first-point()
        caret = last-point()
    | .cancel
        anchor = caret
    ??
        =
refresh-view()

