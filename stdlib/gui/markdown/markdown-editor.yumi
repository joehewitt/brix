_ markdown-caret-width Length = 2
_ markdown-blink-interval = 530ms
_ markdown-overscan VirtualCoord = 1000vcoord
_ markdown-estimated-line VirtualCoord = 32vcoord
_ markdown-edit-roles :=
    [MenuRole.select-all]
_ markdown-redo-key := KeyCombo("Cmd+Y")
_ markdown-save-key := KeyCombo("Cmd+S")
_ markdown-bold-key := KeyCombo("Cmd+B")
_ markdown-italic-key := KeyCombo("Cmd+I")
_ markdown-paragraph-key := KeyCombo("Cmd+0")
_ markdown-heading-keys :=
    [KeyCombo("Cmd+1"), KeyCombo("Cmd+2"), KeyCombo("Cmd+3"), KeyCombo("Cmd+4"), KeyCombo("Cmd+5"), KeyCombo("Cmd+6")]

