markdown-slot-end(blocks, index)

────────────────────
_ first-point MarkdownPoint

markdown-first-point(blocks)

────────────────────
_ last-point MarkdownPoint

markdown-last-point(blocks)

────────────────────
_ next-slot MarkdownPoint?
    - point MarkdownPoint

|? point.cell + 1 < slot-count(point.block)
    MarkdownPoint(point.block, point.cell + 1, 0)
|? point.block + 1 >= blocks.length
    null
|? index == null
    null
??
    MarkdownPoint(index, 0, 0)

.. index = editable-from(point.block + 1, true)

────────────────────
_ previous-slot MarkdownPoint?
    - point MarkdownPoint

|? point.cell > 0
    MarkdownPoint(point.block, point.cell - 1, slot-size(cell))

    .. cell = MarkdownPoint(point.block, point.cell - 1, 0)
|? point.block == 0
    null
|? index == null
