    - forward Bool
    - extends Bool

set-caret(row-edge(caret, forward), extends)

────────────────────
_ row-edge MarkdownPoint
    - point MarkdownPoint
    - forward Bool

|? !layout
    MarkdownPoint(point.block, point.cell, if forward then size else 0)
|? !forward
    MarkdownPoint(point.block, point.cell, layout.line-start-offset(row))
??
    MarkdownPoint(point.block, point.cell, min(trimmed, size))

.. view = slot-view(point)
.. layout = view?.text-layout
.. size = slot-size(point)
.. row = layout.line-at(point.offset)
.. end = layout.line-end-offset(row)
.. text = slot-text(point)
.. bytes = text as Byte[]
.. trimmed = if row + 1 < layout.line-count && end > 0 && ends-in-space then end - 1 else end
.. ends-in-space = end <= bytes.size && bytes[end - 1] == 32

────────────────────
_ do move-page
    - down Bool
    - extends Bool

. rect = point-rect(caret)
=? if rect == null
. distance = rows.content-bounds.height
. y = if down then rect.y + distance else rect.y - distance
. found = point-at(Point(goal-x ?? rect.x, y))
if found != null
    set-caret(found, extends)

────────────────────
_ point-at MarkdownPoint?
    - point Point

markdown-point-at(blocks, block-views(), point)

────────────────────
_ point-rect Rect?
    - point MarkdownPoint

slot-view(point)?.caret-rect(point.offset)

────────────────────
_ slot-view Text?
    - point MarkdownPoint

if !view then null else slot-view-in(view, point)

.. view = block-view(point.block)

────────────────────
_ slot-view-in Text?
    - view MarkdownBlockView
    - point MarkdownPoint

markdown-slot-view-in(view, point)

────────────────────
_ do block-view MarkdownBlockView?
    - index Size

=? null if index >= blocks.length
. wanted = blocks[index]
for view in block-views()
    =? view if view.block as Pointer == wanted as Pointer
= null

────────────────────
_ do block-views [MarkdownBlockView]

. found [MarkdownBlockView]
for row in editor-rows()
    . view = markdown-row-view(row)
    if view && view.block.index < blocks.length && same-block
        found += view
    .. same-block = blocks[view.block.index] as Pointer == view.block as Pointer
= found

────────────────────
_ do editor-rows [MarkdownEditorRow]

. found [MarkdownEditorRow]
markdown-collect-rows(rows, found)
= found

────────────────────
_ content-point Point
    - root-point Point

Point(local.x + rows.bounds.x + offset.x, local.y + rows.bounds.y + offset.y)

.. local = rows.point-in-box(root-point)
.. offset = rows.content-offset

────────────────────
_ do paint-row
    - canvas Canvas
    - row MarkdownEditorRow

=? if !session
. shown = markdown-row-view(row)
=? if !shown
. index = shown.block.index
=? if index >= blocks.length || blocks[index] as Pointer != shown.block as Pointer
if anchor != caret
    . color = if is-focused then $gui-markdown-selection-color else idle-color
        .. idle-color = $gui-markdown-idle-selection-color
    . object-color = if is-focused then $gui-markdown-object-selection-color else idle-object-color
        .. idle-object-color = $gui-markdown-idle-object-selection-color
    markdown-paint-selection
        - canvas
        - blocks
        - shown
        - selection-start()
        - selection-end()
        - color
        - object-color
    =
=? if caret.block != index || !is-focused || !is-caret-lit
. view = slot-view-in(shown, caret)
=? if !view
. rect = view.caret-rect(caret.offset)
=? if rect == null
canvas.fill-color = $gui-markdown-caret-color
canvas.rect(Rect(rect.x - markdown-caret-width / 2, rect.y, markdown-caret-width, rect.height))

────────────────────
_ do point-at-source MarkdownPoint
    - text CodeText
    - offset Size

=? MarkdownPoint(0, 0, 0) if !blocks.length
. index = model.block-at-offset(offset)
if offset > model.ends[index] && index + 1 < blocks.length
    index += 1
. block = blocks[index]
=? clamp-point(MarkdownPoint(index, 0, 0)) if markdown-is-atomic(block.kind)
. start = model.starts[index]
if block.kind == MarkdownBlockKind.code || block.kind == MarkdownBlockKind.exhibit
    . body = text.line-start(min(text.line-at(start) + 1, text.line-count - 1))
    = clamp-point(MarkdownPoint(index, 0, if offset > body then offset - body else 0))
if block.kind == MarkdownBlockKind.grid
    = grid-point-at-source(text, index, min(offset, model.ends[index]))
. from = start + min(model.prefixes[index].size, model.ends[index] - start)
. visible = slot-text(MarkdownPoint(index, 0, 0))
. inner = if offset > from then offset - from else 0
= clamp-point
    - MarkdownPoint
        - index
        - 0
        - markdown-visible-offset(text.text-in(from, model.ends[index]), visible, inner)

────────────────────
_ do grid-point-at-source MarkdownPoint
    - text CodeText
    - index Size
    - offset Size

. block = blocks[index]
. columns = max(block.columns, 1)
. first = text.line-at(model.starts[index])
. line = text.line-at(offset)
. row-line = line - first
. row = if row-line >= 2 then row-line - 1 else 0
. line-start = text.line-start(line)
. cells = markdown-table-cell-starts(text.line-text(line))
. local = offset - line-start
. column Size = 0
for at in 0 .. < cells.length
    if cells[at] <= local
        column = at
column = min(column, columns - 1)
. cell = min(row * columns + column, max(block.cells.length, 1) - 1)
. point = MarkdownPoint(index, cell, 0)
. cell-start = if column < cells.length then cells[column] else local
. cell-end = if column + 1 < cells.length then cells[column + 1] else text.line-length(line)
. source = markdown-slice(text.line-text(line), cell-start, cell-end)
. inner = if local > cell-start then local - cell-start else 0
= clamp-point(MarkdownPoint(index, cell, markdown-visible-offset(source, slot-text(point), inner)))

────────────────────
_ do source-at-point Size
    - text CodeText
    - point MarkdownPoint

=? 0 if point.block >= blocks.length
. index = point.block
. block = blocks[index]
. start = model.starts[index]
=? start if model.is-empty-block(index) || markdown-is-atomic(block.kind)
if block.kind == MarkdownBlockKind.code || block.kind == MarkdownBlockKind.exhibit
    . body = text.line-start(min(text.line-at(start) + 1, text.line-count - 1))
    = min(body + point.offset, model.ends[index])
if block.kind == MarkdownBlockKind.grid
    . columns = max(block.columns, 1)
    . row = point.cell / columns
    . line = text.line-at(start) + (if row == 0 then 0 else row + 1)
    =? start if line >= text.line-count
    . line-text = text.line-text(line)
    . cells = markdown-table-cell-starts(line-text)
    . column = point.cell % columns
    =? text.line-start(line) if column >= cells.length
    . cell-end = if column + 1 < cells.length then cells[column + 1] else line-text.size
    . source = markdown-slice(line-text, cells[column], cell-end)
    = text.line-start(line) + cells[column] + cell-offset
        .. cell-offset = markdown-source-offset(source, slot-text(point), point.offset)
. from = start + min(model.prefixes[index].size, model.ends[index] - start)
. source = text.text-in(from, model.ends[index])
= from + markdown-source-offset(source, slot-text(point), point.offset)

────────────────────
_ caret-context TextInputContext?

|? !session || !blocks.length
    null
??
    TextInputContext(preceding, selected, rect)

.. shown = point-rect(caret)
.. rect = if shown then window-rect(shown, rows) else window-rect(corner, material-parent)
.. corner = Rect(bounds.x, bounds.y, 0, 0)
.. preceding = markdown-slice(slot-text(caret), 0, caret.offset)
.. start = selection-start()
.. end = selection-end()
.. selected = if same-slot then markdown-slice(slot-text(start), start.offset, end.offset) else ""
.. same-slot = start.block == end.block && start.cell == end.cell

────────────────────
_ do window-rect Rect
    - rect Rect
    - start Box?

. x = rect.x
. y = rect.y
. cursor = start
while cursor
    . ancestor = cursor
    if !ancestor.is-markup-shadow
        . offset = ancestor.content-offset
        x -= offset.x
        y -= offset.y
    if ancestor.is-presentation-layer
        break
    cursor = ancestor.material-parent
= Rect(x, y, rect.width, rect.height)

────────────────────
_ do start-blink

is-caret-lit = true
blink-generation += 1
. generation = blink-generation
do new
    while generation == blink-generation
        markdown-blink-interval.wait()
        if generation == blink-generation
            is-caret-lit = !is-caret-lit
            repaint()

────────────────────
_ do stop-blink

blink-generation += 1

────────────────────
_ do reveal-pending-line

. line = pending-line
=? if line == null || !blocks.length
pending-line = null
. low Size = 0
. high = blocks.length
while low < high
    . middle = low + (high - low) / 2
    if blocks[middle].line <= line
        low = middle + 1
    else
        high = middle
. index = if low > 0 then low - 1 else 0
rows.reveal-address(index)

━━━━━━━━━━━━━━━━━━━━
_ markdown-gap String
    - original String
    - before MarkdownBlockKind
    - before-empty Bool
    - after MarkdownBlockKind
    - after-empty Bool

|? newlines >= 2
    original
|? newlines == 1 && !before-empty && !after-empty && !merges
    original
|? both-items && !before-empty && !after-empty
    "\n"
??
    "\n\n"

.. newlines = markdown-newline-count(original)
.. merges = both-paragraphs || both-quotes
.. both-paragraphs = before == MarkdownBlockKind.paragraph && after == MarkdownBlockKind.paragraph
.. both-quotes = before == MarkdownBlockKind.quote && after == MarkdownBlockKind.quote
.. both-items = before == MarkdownBlockKind.item && after == MarkdownBlockKind.item

━━━━━━━━━━━━━━━━━━━━
_ do markdown-newline-count Size
    - text String

. count Size = 0
for byte in text as Byte[]
    if byte == 10
        count += 1
= count

━━━━━━━━━━━━━━━━━━━━
_ markdown-separator String
    - first MarkdownDraft
    - second MarkdownDraft

if both-items then "\n" else "\n\n"

.. both-items = first.kind == MarkdownBlockKind.item && second.kind == MarkdownBlockKind.item

━━━━━━━━━━━━━━━━━━━━
_ markdown-is-prose Bool
    - kind MarkdownBlockKind

prose || kind == MarkdownBlockKind.item || kind == MarkdownBlockKind.quote

.. prose = kind == MarkdownBlockKind.paragraph || kind == MarkdownBlockKind.heading

━━━━━━━━━━━━━━━━━━━━
_ MarkdownEditorRow is Box

+ editor MarkdownEditor?

╌╌╌╌╌╌╌╌╌╌ is Box ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do paint-overlay
    - canvas Canvas

editor?.paint-row(canvas, this)

━━━━━━━━━━━━━━━━━━━━
_ MarkdownBlockSource
    is VirtualSequenceDomain
    is VirtualSource'MarkdownBlock

+ model MarkdownModel
+ revision := VirtualRevision()
+ inset VirtualCoord
+ limit VirtualCoord

. parameters-changed < inset, limit

────────────────────
+ This
    - model

────────────────────
+ estimate VirtualCoord
    - address I64
    - width VirtualCoord

|? address < 0 || address >= (model.blocks.length as I64)
    markdown-estimated-line
|? block.kind == MarkdownBlockKind.heading
    if block.level <= 1 then 48vcoord else 40vcoord
|? block.kind == MarkdownBlockKind.divider
    21vcoord
|? block.kind == MarkdownBlockKind.code || block.kind == MarkdownBlockKind.exhibit
    ((markdown-newline-count(block.code) as VirtualCoord) + 1vcoord) * 19vcoord + 36vcoord
|? block.kind == MarkdownBlockKind.grid
    ((block.cells.length / columns) as VirtualCoord) * 32vcoord + 12vcoord

    .. columns = if block.columns > 0 then block.columns else 1
|? size == 0vcoord
    markdown-estimated-line
??
    (size / chars + 1vcoord) * 22vcoord + 10vcoord

.. index = address as Index
.. block = model.blocks[index]
.. available = width - inset
.. column = if limit > 0vcoord && limit < available then limit else available
.. chars = if column > 160vcoord then column / 8vcoord else 20vcoord
.. size = (model.ends[index] - model.starts[index]) as VirtualCoord

────────────────────
_ do parameters-changed

revision.touch()

╌╌╌╌╌╌╌╌╌╌ is VirtualSequenceDomain ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ get known-count VirtualCoord

model.blocks.length

────────────────────
+ get estimated-count VirtualCoord?

model.blocks.length as VirtualCoord

────────────────────
+ get is-final Bool

true

────────────────────
+ address-at I64
    - index VirtualCoord

index

────────────────────
+ index-of VirtualCoord?
    - address I64

|? address < 0 || address >= (model.blocks.length as I64)
    null
??
    address as VirtualCoord

╌╌╌╌╌╌╌╌╌╌ is VirtualSource'MarkdownBlock ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ get domain VirtualSequenceDomain

this

────────────────────
+ do bind
    - address I64
    - generation U64
    - target VirtualBindingTarget'MarkdownBlock

if address < 0 || address >= (model.blocks.length as I64)
    target.fail(generation)
else
    target.commit(VirtualKey(revision.value, address), model.blocks[address], generation)

────────────────────
+ do identity-at U64?
    - address I64

=? if address < 0 || address >= (model.blocks.length as I64)
= (model.blocks[address] as Pointer).address as U64

━━━━━━━━━━━━━━━━━━━━
_ markdown-block-layout VerticalMeasuredLayout
    - source MarkdownBlockSource

VerticalMeasuredLayout(markdown-estimated-line, estimate)

.. estimate = :: address, width => source.estimate(address, width)

━━━━━━━━━━━━━━━━━━━━
_ do markdown-collect-rows
    - box Box
    - found [MarkdownEditorRow]

for child in RenderedChildCursor(box)
    if child is MarkdownEditorRow
        found += child as MarkdownEditorRow
    else if child is VirtualSlotRoot'MarkdownBlock
        if (child as VirtualSlotRoot'MarkdownBlock).slot.is-bound
            markdown-collect-rows(child, found)
    else
        markdown-collect-rows(child, found)

━━━━━━━━━━━━━━━━━━━━
_ do markdown-row-view MarkdownBlockView?
    - row MarkdownEditorRow

for child in RenderedChildCursor(row)
    =? child as MarkdownBlockView if child is MarkdownBlockView
= null

━━━━━━━━━━━━━━━━━━━━
_ do markdown-heading-marker Size
    - marker String

=? 0 if marker.size < 1 || marker.size > 6
for byte in marker as Byte[]
    =? 0 if byte != 35
= marker.size

━━━━━━━━━━━━━━━━━━━━
_ do markdown-is-ordered-marker Bool
    - marker String

. bytes = marker as Byte[]
=? false if bytes.size < 2 || bytes[bytes.size - 1] != 46
= all(0 .. < bytes.size - 1) • where bytes[each] >= 48 && bytes[each] <= 57

━━━━━━━━━━━━━━━━━━━━
_ do markdown-header-cells [String]
    - text String

. trimmed = text.trim()
. result [String]
=? result if !trimmed.starts-with("|") || trimmed.size < 3 || unclosed
.. unclosed = (trimmed as Byte[])[trimmed.size - 1] != 124
for part in markdown-slice(trimmed, 1, trimmed.size - 1).split("|")
    result += part.trim()
= result

━━━━━━━━━━━━━━━━━━━━
_ do markdown-line-indent String
    - code String
    - offset Size

. bytes = code as Byte[]
. start = min(offset, bytes.size)
while start > 0 && bytes[start - 1] != 10
    start -= 1
. end = start
while end < bytes.size && end < offset && (bytes[end] == 32 || bytes[end] == 9)
    end += 1
= markdown-slice(code, start, end)

━━━━━━━━━━━━━━━━━━━━
_ do markdown-leading-spaces Size
    - text String

. bytes = text as Byte[]
. count Size = 0
while count < bytes.size && bytes[count] == 32
    count += 1
= count

━━━━━━━━━━━━━━━━━━━━
_ markdown-next-char Size
    - text String
    - offset Size

if offset >= bytes.size then bytes.size else min(offset + width, bytes.size)

.. bytes = text as Byte[]
.. lead = bytes[offset]
.. width = if lead >= 0xF0 then 4 else if lead >= 0xE0 then 3 else if lead >= 0xC0 then 2 else 1

━━━━━━━━━━━━━━━━━━━━
_ do markdown-previous-char Size
    - text String
    - offset Size

. bytes = text as Byte[]
. at = min(offset, bytes.size)
=? 0 if at == 0
at -= 1
while at > 0 && bytes[at] >= 0x80 && bytes[at] < 0xC0
    at -= 1
= at

━━━━━━━━━━━━━━━━━━━━
_ do markdown-word-left Size
    - text String
    - offset Size

. bytes = text as Byte[]
. at = min(offset, bytes.size)
while at > 0 && markdown-byte-class(bytes[at - 1]) == 0
    at -= 1
=? 0 if at == 0
. kind = markdown-byte-class(bytes[at - 1])
while at > 0 && markdown-byte-class(bytes[at - 1]) == kind
    at -= 1
= at

━━━━━━━━━━━━━━━━━━━━
_ do markdown-word-right Size
    - text String
    - offset Size

. bytes = text as Byte[]
. at = offset
while at < bytes.size && markdown-byte-class(bytes[at]) == 0
    at += 1
=? bytes.size if at >= bytes.size
. kind = markdown-byte-class(bytes[at])
while at < bytes.size && markdown-byte-class(bytes[at]) == kind
    at += 1
= at

━━━━━━━━━━━━━━━━━━━━
_ do markdown-edit-role MenuRole?
    - event KeyPressEvent

=? MenuRole.redo if markdown-redo-key.matches(event)
for role in markdown-edit-roles
    . key = menu-role-key(role)
    =? role if key && key.matches(event)
= null
