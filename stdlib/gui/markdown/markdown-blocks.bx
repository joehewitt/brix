(import ./markdown-references)
(import /code/structure/rows)
(import /code/syntax)
(import /data/markdown)
(import /graphics/text)
(import /gui/box)
(import /stream/aggregate)

(type + MarkdownBlock
  (prop + index Index)
  (prop + kind MarkdownBlockKind)
  (prop + level Size)
  (prop + depth Size)
  (prop + marker String)
  (prop + runs (list MarkdownRun))
  (prop + code String)
  (prop + language String)
  (prop + columns Size)
  (prop + cells (list MarkdownGridCell))
  (prop + line Size)
  (prop + anchor _ (= ""))
  (prop + shows-source _ (= false))
  (prop + rendering (? MarkdownCodeRendering) (= null))
  (prop + render-error (? String) (= null))
  (prop + renders-runs _ (= false))
  (fn-do + This _
    (param index _)
    (param kind _)
    (param level _ (= 0))
    (param depth _ (= 0))
    (param marker _ (= ""))
    (param runs (list MarkdownRun) (= (call (of List MarkdownRun))))
    (param code _ (= ""))
    (param language _ (= ""))
  )
)

(type + MarkdownCodeRun (is Tuple)
  (prop + text String)
  (prop + role SyntaxRole (= (. SyntaxRole plain)))
  (prop + kind (? SourceSpanKind) (= null))
  (prop + is-optional _ (= false))
)

(type + MarkdownCodeRendering (is Interface)
  (fn-do + view Box)
)

(type + MarkdownSourceRequest (is Tuple)
  (prop + block MarkdownBlock)
  (prop + shows Bool)
)

(type + MarkdownCodeRenderer
  (fn-expr + renders Bool
    (param language String)
    false
  )
  (fn-expr + rendered-title String
    (param language String)
    "Rendered"
  )
  (fn-expr + source-title String
    (param language String)
    "Source"
  )
  (fn-do + render MarkdownCodeRendering (?! Error)
    (param code String)
    (param language String)
    (throw (call Error (str "No rendering for " language)))
  )
  (fn-expr + renders-inline Bool
    (param language String)
    false
  )
  (fn-do + render-inline (list MarkdownCodeRun) (?! Error)
    (param code String)
    (param language String)
    (throw (call Error (str "No inline rendering for " language)))
  )
)

(fn-expr + markdown-is-rendered Bool
  (param block MarkdownBlock)
  (and (== (. block kind) (. MarkdownBlockKind code)) (!= (. block rendering) null) (not (. block shows-source)))
)

(fn-do + markdown-render-block _
  (param renderer (? MarkdownCodeRenderer))
  (param block MarkdownBlock)
  (return-if (if (not renderer)))
  (if (!= (. block kind) (. MarkdownBlockKind code))
    (call markdown-render-runs renderer block)
    (return)
  )
  (return-if (if (or (. block shows-source) (!= (. block rendering) null) (not (call (. renderer renders) (. block language))))))
  (let rendering (catch (call (. renderer render) (. block code) (. block language))))
  (if (is rendering Error)
    (= (. block render-error) (str rendering))
    (= (. block shows-source) true)
    (return)
  )
  (= (. block rendering) (as rendering MarkdownCodeRendering))
)

(fn-do _ markdown-render-runs _
  (param renderer MarkdownCodeRenderer)
  (param block MarkdownBlock)
  (return-if (if (. block renders-runs)))
  (= (. block renders-runs) true)
  (if (and (not (call markdown-runs-tagged (. block runs))) (not (call some (. block cells) (:where (call markdown-runs-tagged (. each runs))))))
    (return)
  )
  (= (. block runs) (call markdown-rendered-runs renderer (. block runs)))
  (let cells (list MarkdownGridCell))
  (for (in cell (. block cells))
    (+= cells
      (call MarkdownGridCell
        (block
          (arg (. cell index))
          (arg (call markdown-rendered-runs renderer (. cell runs)))
          (arg (. cell alignment))
          (arg (. cell is-header))
          (arg (. cell is-final-row))
        )
      )
    )
  )
  (= (. block cells) cells)
)

(fn-expr _ markdown-runs-tagged Bool
  (param runs (list MarkdownRun))
  (call some runs (:where (and (> (. each language size) 0) (== (. each rendering) null))))
)

(fn-do _ markdown-rendered-runs (list MarkdownRun)
  (param renderer MarkdownCodeRenderer)
  (param runs (list MarkdownRun))
  (let result (list MarkdownRun))
  (for (in run runs)
    (let rendered (call markdown-rendered-run renderer run))
    (+= result (?? rendered run))
  )
  (return result)
)

(fn-do _ markdown-rendered-run (? MarkdownRun)
  (param renderer MarkdownCodeRenderer)
  (param run MarkdownRun)
  (return-if null (if (or (not (. run is-code)) (not (. run language size)) (!= (. run rendering) null) (not (call (. renderer renders-inline) (. run language))))))
  (let pieces (catch (call (. renderer render-inline) (. run text) (. run language))))
  (return-if null (if (is pieces Error)))
  (let rendering (as pieces (list MarkdownCodeRun)))
  (let text (call (. "" join) (in (. each text) rendering)))
  (return-if null (if (not (. text size))))
  (return
    (call MarkdownRun
      (block
        (arg (. run index))
        (arg text)
        (arg (. run is-strong))
        (arg (. run is-em))
        (arg true)
        (arg (. run url))
        (arg null)
        (arg false)
        (arg (. run is-image))
        (arg (. run language))
        (arg (. run text))
        (arg rendering)
      )
    )
  )
)

(fn-do + markdown-toggle-source _
  (param renderer (? MarkdownCodeRenderer))
  (param block MarkdownBlock)
  (param shows Bool)
  (= (. block render-error) null)
  (= (. block shows-source) shows)
  (if (not shows)
    (call markdown-render-block renderer block)
  )
)

(fn-do + markdown-carry-source _
  (param old MarkdownBlock)
  (param next MarkdownBlock)
  (if (and (. old shows-source) (== (. old kind) (. next kind)) (== (. old language) (. next language)))
    (= (. next shows-source) true)
  )
)

(type + MarkdownBlockKind (is Union)
  (variant paragraph)
  (variant heading)
  (variant item)
  (variant quote)
  (variant code)
  (variant exhibit)
  (variant divider)
  (variant grid)
)

(type + MarkdownRun (is Tuple)
  (prop + index Index)
  (prop + text String)
  (prop + is-strong Bool)
  (prop + is-em Bool)
  (prop + is-code Bool)
  (prop + url (? String))
  (prop + reference (? MarkdownReference) (= null))
  (prop + is-break _ (= false))
  (prop + is-image _ (= false))
  (prop + language _ (= ""))
  (prop + source (? String) (= null))
  (prop + rendering (? (list MarkdownCodeRun)) (= null))
  (fn-expr + is-rendered _ :get
    (!= rendering null)
  )
)

(type + MarkdownGridCell (is Tuple)
  (prop + index Index)
  (prop + runs (list MarkdownRun))
  (prop + alignment TextAlignment)
  (prop + is-header Bool)
  (prop + is-final-row Bool)
)

(type + MarkdownBlockCache
  (prop _ source (? String))
  (prop _ based (? String))
  (prop _ blocks (list MarkdownBlock))
  (fn-expr + is-filled _ :get
    (!= source null)
  )
  (fn-do + blocks-for (list MarkdownBlock)
    (param text String)
    (param base _ (= ""))
    (if (or (== source null) (!= source text) (!= based base))
      (= blocks (call markdown-blocks text base))
      (= source text)
      (= based base)
    )
    (return blocks)
  )
)

(fn-do + markdown-blocks (list MarkdownBlock)
  (param source String)
  (param base _ (= ""))
  (let builder (call MarkdownBlockBuilder base))
  (call (. builder add) (call Markdown source) 0)
  (return (. builder blocks))
)

(fn-expr + markdown-is-exhibit _
  (param language String)
  (== language "stat")
)

(type _ MarkdownBlockBuilder
  (prop + base String)
  (prop + blocks (list MarkdownBlock))
  (blank)
  (prop _ line Size)
  (prop _ anchors _ (= (call (of Map String Size))))
  (fn-do + This _
    (param base _)
  )
  (fn-do + add _
    (param node Markdown)
    (param depth Size)
    (match node
      (case (: document MDDocument)
        (for (in child (. document content))
          (call add child depth)
        )
      )
      (case (: header MDHeader)
        (= line (as (. header line) Size))
        (let block
          (call MarkdownBlock
            (block
              (arg (. blocks length))
              (arg (. MarkdownBlockKind heading))
              (arg (. header level))
              (arg depth)
              (arg "")
              (arg (call runs (. header content)))
            )
          )
        )
        (= (. block anchor) (call anchor-for header))
        (call push block)
      )
      (case (: paragraph MDParagraph)
        (= line (as (. paragraph line) Size))
        (call push
          (block
            (arg
              (call MarkdownBlock
                (block
                  (arg (. blocks length))
                  (arg (. MarkdownBlockKind paragraph))
                  (arg 0)
                  (arg depth)
                  (arg "")
                  (arg (call runs (. paragraph content)))
                )
              )
            )
          )
        )
      )
      (case (: divider MDDivider)
        (= line (as (. divider line) Size))
        (call push (call MarkdownBlock (. blocks length) (. MarkdownBlockKind divider) 0 depth))
      )
      (case (: list MDList)
        (call add-list list depth)
      )
      (case (: quote MDBlockQuote)
        (= line (as (. quote line) Size))
        (for (in child (. quote content))
          (call add-quote child depth)
        )
      )
      (case (: code MDFencedCode)
        (= line (as (. code source-location begin line) Size))
        (let language (call (. code language trim)))
        (let kind
          (scope (if-expr is-exhibit (. MarkdownBlockKind exhibit) (. MarkdownBlockKind code))
            (lazy is-exhibit (call markdown-is-exhibit language))
          )
        )
        (let block
          (call MarkdownBlock
            (block
              (arg (. blocks length))
              (arg kind)
              (arg 0)
              (arg depth)
              (arg "")
              (arg (call (of List MarkdownRun)))
              (arg (call markdown-code-body (. code body)))
              (arg language)
            )
          )
        )
        (call push block)
      )
      (case (: table MDTable)
        (= line (as (. table line) Size))
        (call add-grid table depth)
      )
      (default
        (call push (call MarkdownBlock (. blocks length) (. MarkdownBlockKind paragraph) 0 depth "" (call runs (list node))))
      )
    )
  )
  (fn-do _ push _
    (param block MarkdownBlock)
    (= (. block line) line)
    (+= blocks block)
  )
  (fn-do _ anchor-for String
    (param header MDHeader)
    (let slug (call markdown-heading-slug (call markdown-visible-text (. header content))))
    (let count (+ (?? ([] anchors slug) 0) 1))
    (= ([] anchors slug) count)
    (return (if-expr (== count 1) slug (str slug "-" count)))
  )
  (fn-do _ add-list _
    (param list MDList)
    (param depth Size)
    (let number (. list start))
    (for (in child (. list children))
      (if (= (| (: item MDListItem)) child)
        (= line (as (. item line) Size))
        (let marker (if-expr (. list ordered) (str number ".") "•"))
        (call push
          (block
            (arg
              (call MarkdownBlock
                (block
                  (arg (. blocks length))
                  (arg (. MarkdownBlockKind item))
                  (arg 0)
                  (arg depth)
                  (arg marker)
                  (arg (call runs (. item content)))
                )
              )
            )
          )
        )
        (for (in block (. item blocks))
          (call add block (+ depth 1))
        )
        (+= number 1)
      )
    )
  )
  (fn-do _ add-quote _
    (param node Markdown)
    (param depth Size)
    (if (= (| (: paragraph MDParagraph)) node)
      (= line (as (. paragraph line) Size))
      (call push
        (block
          (arg
            (call MarkdownBlock
              (block
                (arg (. blocks length))
                (arg (. MarkdownBlockKind quote))
                (arg 0)
                (arg depth)
                (arg "")
                (arg (call runs (. paragraph content)))
              )
            )
          )
        )
      )
      (else
        (call add node depth)
      )
    )
  )
  (fn-do _ add-grid _
    (param table MDTable)
    (param depth Size)
    (let block (call MarkdownBlock (. blocks length) (. MarkdownBlockKind grid) 0 depth))
    (= (. block columns) (. table header cells length))
    (call add-grid-row block table (. table header) true (not (. table rows length)))
    (for (in index (..< 0 (. table rows length)))
      (call add-grid-row block table ([] (. table rows) index) false (== index (- (. table rows length) 1)))
    )
    (call push block)
  )
  (fn-do _ add-grid-row _
    (param block MarkdownBlock)
    (param table MDTable)
    (param row MDTableRow)
    (param is-header Bool)
    (param is-final-row Bool)
    (for (in column (..< 0 (. block columns)))
      (let content (list MarkdownRun))
      (if (< column (. row cells length))
        (call add-runs content (. ([] (. row cells) column) content) (call MarkdownRunStyle))
      )
      (+= (. block cells)
        (call MarkdownGridCell
          (block
            (arg (. block cells length))
            (arg content)
            (arg (call markdown-grid-alignment (call (. table alignment) column)))
            (arg is-header)
            (arg is-final-row)
          )
        )
      )
    )
  )
  (fn-do _ runs _
    (param nodes (list Markdown))
    (let result (list MarkdownRun))
    (call add-runs result nodes (call MarkdownRunStyle))
    (return (call markdown-referenced-runs result base))
  )
  (fn-do _ add-runs _
    (param result (list MarkdownRun))
    (param nodes (list Markdown))
    (param style MarkdownRunStyle)
    (for (in node nodes)
      (match node
        (case (: text MDText)
          (if (. text is-break)
            (+= result
              (call MarkdownRun
                (block
                  (arg (. result length))
                  (arg (. text text))
                  (arg false)
                  (arg false)
                  (arg false)
                  (arg null)
                  (arg null)
                  (arg true)
                )
              )
            )
            (else
              (call add-run result (. text text) style)
            )
          )
        )
        (case (: strong MDStrong)
          (call add-runs
            (block
              (arg result)
              (arg (. strong content))
              (arg (call MarkdownRunStyle true (. style is-em) false (. style url) (. style is-image)))
            )
          )
        )
        (case (: em MDEm)
          (call add-runs
            (block
              (arg result)
              (arg (. em content))
              (arg (call MarkdownRunStyle (. style is-strong) true false (. style url) (. style is-image)))
            )
          )
        )
        (case (: link MDLink)
          (call add-runs
            (block
              (arg result)
              (arg (. link content))
              (arg (call MarkdownRunStyle (. style is-strong) (. style is-em) false (. link url)))
            )
          )
        )
        (case (: image MDImage)
          (call add-runs
            (block
              (arg result)
              (arg (. image content))
              (arg (call MarkdownRunStyle (. style is-strong) (. style is-em) false (. image url) true))
            )
          )
        )
        (case (: code MDInlineCode)
          (call add-run
            (block
              (arg result)
              (arg (. code code))
              (arg
                (call MarkdownRunStyle
                  (block
                    (arg (. style is-strong))
                    (arg (. style is-em))
                    (arg true)
                    (arg (. style url))
                    (arg (. style is-image))
                    (arg (. code language))
                  )
                )
              )
            )
          )
        )
        (default
          (call add-run result (str node) style)
        )
      )
    )
  )
  (fn-do _ add-run _
    (param result (list MarkdownRun))
    (param text String)
    (param style MarkdownRunStyle)
    (return-if (if (not (. text length))))
    (if (= (| (list ... last)) result)
      (if (and (not (. last is-break)) (not (. style language size)) (== (call markdown-run-style last) style))
        (= ([] result (- (. result length) 1))
          (call MarkdownRun
            (block
              (arg (. last index))
              (arg (str (. last text) text))
              (arg (. last is-strong))
              (arg (. last is-em))
              (arg (. last is-code))
              (arg (. last url))
              (arg null)
              (arg false)
              (arg (. last is-image))
            )
          )
        )
        (return)
      )
    )
    (+= result
      (call MarkdownRun
        (block
          (arg (. result length))
          (arg text)
          (arg (. style is-strong))
          (arg (. style is-em))
          (arg (. style is-code))
          (arg (. style url))
          (arg null)
          (arg false)
          (arg (. style is-image))
          (arg (. style language))
        )
      )
    )
  )
)

(type _ MarkdownRunStyle (is Tuple)
  (prop + is-strong Bool)
  (prop + is-em Bool)
  (prop + is-code Bool)
  (prop + url (? String) (= null))
  (prop + is-image _ (= false))
  (prop + language _ (= ""))
)

(fn-do _ markdown-referenced-runs (list MarkdownRun)
  (param runs (list MarkdownRun))
  (param base String)
  (let result (list MarkdownRun))
  (for (in run runs)
    (if (!= (. run url) null)
      (+= result (call markdown-run-piece result run (. run text) (call markdown-url-reference (. run url) base)))
      (else-if (. run is-code)
        (+= result (call markdown-run-piece result run (. run text) (call markdown-code-reference (. run text))))
      )
      (else
        (let last Index 0)
        (for (in span (call markdown-text-references (. run text)))
          (if (> (. span start) last)
            (+= result (call markdown-run-piece result run ([] (. run text) (..< last (. span start))) null))
          )
          (+= result
            (call markdown-run-piece
              (block
                (arg result)
                (arg run)
                (arg ([] (. run text) (..< (. span start) (. span end))))
                (arg (. span reference))
              )
            )
          )
          (= last (. span end))
        )
        (if (== last 0)
          (+= result (call markdown-run-piece result run (. run text) null))
          (else-if (< last (. run text length))
            (+= result (call markdown-run-piece result run ([] (. run text) (... last)) null))
          )
        )
      )
    )
  )
  (return result)
)

(fn-expr _ markdown-run-piece MarkdownRun
  (param result (list MarkdownRun))
  (param run MarkdownRun)
  (param text String)
  (param reference (? MarkdownReference))
  (call MarkdownRun
    (block
      (arg (. result length))
      (arg text)
      (arg (. run is-strong))
      (arg (. run is-em))
      (arg (. run is-code))
      (arg (. run url))
      (arg reference)
      (arg (. run is-break))
      (arg (. run is-image))
      (arg (. run language))
    )
  )
)

(fn-expr _ markdown-run-style _
  (param run MarkdownRun)
  (call MarkdownRunStyle (. run is-strong) (. run is-em) (. run is-code) (. run url) (. run is-image) (. run language))
)

(fn-expr _ markdown-grid-alignment _
  (param alignment MDTableAlignment)
  (match alignment
    (case (. MDTableAlignment center)
      (. TextAlignment center)
    )
    (case (. MDTableAlignment right)
      (. TextAlignment right)
    )
    (default
      (. TextAlignment left)
    )
  )
)

(fn-expr _ markdown-code-body _
  (param body String)
  (case? (call (. body ends-with) "\n")
    ([] body (..< 0 (- (. body length) 1)))
  )
  (default
    body
  )
)
