hover-scope?.hover-link(this, null)
super.unmounted()

━━━━━━━━━━━━━━━━━━━━
_ markdown-runs-link
    - runs [MarkdownRun]

some(runs) • where each.url != null || each.reference != null

━━━━━━━━━━━━━━━━━━━━
_ markdown-web-url String?
    - url String?

url if url && (url.starts-with("https://") || url.starts-with("http://"))

━━━━━━━━━━━━━━━━━━━━
_ markdown-anchor String?
    - url String?

url[1 ...] if url && url.starts-with("#") && url.length > 1

