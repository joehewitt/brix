+ detail MarkdownLinkDetail
+ has-counts = #detail.additions != null

• This • markdown-link-tooltip passive flex-col above-center:6
    hover-trigger = true
    hover-delay = 1.6s

────────────────────

<This
    <Text • markdown-link-tooltip-text
        <Span
            text = #detail.path
        if #has-counts
