_ markdown-list-indent Length = 26
_ markdown-grid-min-track Length = 112
_ markdown-select-all-key := KeyCombo("Cmd+A")
_ markdown-selection-owner := MarkdownSelectionOwner()

━━━━━━━━━━━━━━━━━━━━
_ MarkdownSelectionOwner

+ view MarkdownView?

━━━━━━━━━━━━━━━━━━━━
+ markdown-selected-view MarkdownView?

owner if owner && owner.has-selection

.. owner = markdown-selection-owner.view

━━━━━━━━━━━━━━━━━━━━
+ MarkdownView is Box

+ text String = ""
+ base String
+ cache MarkdownBlockCache?
+ is-selectable = true
+ blocks = markdown-view-blocks(#text, #base, #cache)

_ pending-line Size?
_ anchor = MarkdownPoint(0, 0, 0)
_ caret = MarkdownPoint(0, 0, 0)
_ is-selecting = false
_ origin = MarkdownRange(MarkdownPoint(0, 0, 0), MarkdownPoint(0, 0, 0))
_ granularity = MarkdownGranularity.character

• This
    focus-mode = if #is-selectable then FocusMode.keys else FocusMode.none

    when #is-selectable
        cursor = CursorStyle.text

────────────────────

<This • flex-col
    for block in #blocks keyed by block.index
        <MarkdownBlockView
            block = block

────────────────────
for event on pointer-down

. modifiers = event.modifiers
if is-selectable && event.button == PointerButton.primary && unmodified
    select-at(event.root-point, event.click-count, modifiers.shift)
.. unmodified = !modifiers.command && !modifiers.control

────────────────────
for event on pointer-drag

if is-selecting
    . found = markdown-point-at(blocks, block-views(), layout-point(event.root-point))
    if found != null
        select-range(markdown-extend-range(blocks, origin, found, granularity))

────────────────────
for _ on pointer-up

is-selecting = false

────────────────────
for event on key-press

if is-selectable && markdown-select-all-key.matches(event)
    select-all()
    event.cancel()

────────────────────
for event on copy

if has-selection && event.clipboard.write-text(selected-source())
    event.cancel()

────────────────────
for _ on focus

invalidate-paint()

────────────────────
for _ on blur

invalidate-paint()

────────────────────
+ get has-selection

anchor != caret

────────────────────
+ do select-all

=? if !blocks.length
claim-selection()
anchor = markdown-first-point(blocks)
caret = markdown-last-point(blocks)
show-selection()

────────────────────
+ do clear-selection

=? if anchor == caret
anchor = caret
invalidate-paint()

────────────────────
+ selected-source String

|? !has-selection || !blocks.length
    ""
??
    markdown-selection-source(blocks, start, end)

.. start = markdown-clamp-point
    - blocks
    - if markdown-point-before(caret, anchor) then caret else anchor
.. end = markdown-clamp-point
    - blocks
    - if markdown-point-before(caret, anchor) then anchor else caret

────────────────────
+ do reveal-anchor Bool
    - anchor String

for view in block-views()
    =? reveal(view) if view.block.anchor == anchor
= false

────────────────────
+ do reveal-line
    - line Size

pending-line = line
invalidate-layout()

────────────────────
+ do top-line Size?

. scroller = scroll-ancestor()
=? null if !scroller
. top = scroller.content-bounds.y + scroller.scroll-y
for view in block-views()
    =? view.block.line if view.bounds.y + view.bounds.height > top + 1
= null

────────────────────
+ do block-views [MarkdownBlockView]

. found [MarkdownBlockView]
collect-block-views(this, found)
= found

╌╌╌╌╌╌╌╌╌╌ is Box ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do unmounted

if markdown-selection-owner.view as Pointer? == this as Pointer
    markdown-selection-owner.view = null
super.unmounted()

────────────────────
+ do did-layout

super.did-layout()
. line = pending-line
=? if line == null
pending-line = null
. found MarkdownBlockView? = null
for view in block-views()
    if view.block.line > line
        break
    found = view
if found
    . ignored = reveal(found)

────────────────────
+ do paint-overlay
    - canvas Canvas

super.paint-overlay(canvas)
=? if !has-selection || !blocks.length
. start = markdown-clamp-point
    - blocks
    - if markdown-point-before(caret, anchor) then caret else anchor
. end = markdown-clamp-point(blocks, if markdown-point-before(caret, anchor) then anchor else caret)
. color = if is-focused then $gui-markdown-selection-color else $gui-markdown-idle-selection-color
. object-color = if is-focused then $gui-markdown-object-selection-color else idle-object-color
    .. idle-object-color = $gui-markdown-idle-object-selection-color
for view in block-views()
    markdown-paint-selection(canvas, blocks, view, start, end, color, object-color)

╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌

────────────────────
_ do select-at
    - root-point Point
    - click-count U32
    - extends Bool

. found = markdown-point-at(blocks, block-views(), layout-point(root-point))
=? if found == null
claim-selection()
is-selecting = true
granularity = markdown-granularity(click-count)
. keeps = granularity == MarkdownGranularity.character && extends && is-focused
origin = if keeps then MarkdownRange(anchor, anchor) else found-unit
    .. found-unit = markdown-unit-at(blocks, found, granularity)
select-range(markdown-extend-range(blocks, origin, found, granularity))

────────────────────
_ do select-range
    - range MarkdownRange

=? if range.anchor == anchor && range.caret == caret
anchor = range.anchor
caret = range.caret
show-selection()

────────────────────
_ do claim-selection

. owner = markdown-selection-owner.view
if owner && owner as Pointer != this as Pointer
    owner.clear-selection()
markdown-selection-owner.view = this

────────────────────
_ do show-selection

if has-selection && !is-focused
    . ignored = request-focus()
invalidate-paint()

────────────────────
_ layout-point Point
    - root-point Point

Point(local.x + bounds.x + offset.x, local.y + bounds.y + offset.y)

.. local = point-in-box(root-point)
.. offset = content-offset

────────────────────
_ do reveal Bool
    - view MarkdownBlockView

. scroller = scroll-ancestor()
=? false if !scroller
= scroller.ensure-visible(view, ScrollAlignment.start)

────────────────────
_ do scroll-ancestor Box?

. cursor = material-parent
while cursor
    . ancestor = cursor
    =? ancestor if ancestor.is-scroll-axis-enabled(Orientation.vertical)
    cursor = ancestor.material-parent
= null

────────────────────
_ do collect-block-views
    - box Box
    - found [MarkdownBlockView]

for child in RenderedChildCursor(box)
    if child is MarkdownBlockView
        found += child as MarkdownBlockView
    else if child.is-markup-shadow
        collect-block-views(child, found)

━━━━━━━━━━━━━━━━━━━━
_ markdown-view-blocks
    - text String
    - base String
    - cache MarkdownBlockCache?

if cache then cache.blocks-for(text, base) else markdown-blocks(text, base)

━━━━━━━━━━━━━━━━━━━━
+ MarkdownBlockView is Box

+ block MarkdownBlock
+ is-editable = false
+ is-heading = #block.kind == MarkdownBlockKind.heading
+ is-title = #block.kind == MarkdownBlockKind.heading && #block.level == 1
+ is-section = #block.kind == MarkdownBlockKind.heading && #block.level == 2
+ is-quote = #block.kind == MarkdownBlockKind.quote

────────────────────

<This • markdown-block flex-row
    padding-left = #block.depth * markdown-list-indent
    if #block.kind == MarkdownBlockKind.code
        <Box • markdown-code-block flex-col flex:1 px:14 py:12
            <Text • markdown-code
                <Span
                    text = #block.code
            if !#is-editable && #is-hover-within
                <CopyButton • markdown-code-copy absolute w:26 h:26
                    anchor = Anchor.parent
                    top = PositionOffset.coord(-8)
                    right = PositionOffset.coord(-10)
                    text = #block.code
    else if #block.kind == MarkdownBlockKind.exhibit
        <MarkdownExhibit • flex:1
            block = #block
    else if #block.kind == MarkdownBlockKind.divider
        <Box • markdown-divider flex:1 h:1
    else if #block.kind == MarkdownBlockKind.grid
        <Box • markdown-grid flex:1
            layout = GridLayout(#block.columns, markdown-grid-min-track)
            for cell in #block.cells keyed by cell.index
                <MarkdownGridCellView • markdown-grid-cell px:12 py:7
                    cell = cell
    else
        if #block.marker.length > 0
            <Label • markdown-marker
                text = #block.marker
        <Text • markdown-prose flex:1
            if markdown-runs-link(#block.runs)
                for run in #block.runs keyed by run.index
                    <MarkdownLinkSpan • markdown-run markdown-link
                        run = run
            else
                for run in #block.runs keyed by run.index
                    <MarkdownRunSpan • markdown-run
                        run = run

