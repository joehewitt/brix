━━━━━━━━━━━━━━━━━━━━
+ MarkdownLinkSpan is Span

+ run MarkdownRun
+ target = markdown-reference-target
    - #scope?.#references?.#revision ?? 0
    - #scope?.#references
    - #run.reference
+ is-strong = #run.is-strong
+ is-em = #run.is-em
+ is-code = #run.is-code
+ web-url = markdown-web-url(#run.url)
+ anchor = markdown-anchor(#run.url)
+ is-link = #web-url != null || #target != null || #anchor != null
+ detail = markdown-reference-detail
    - #scope?.#references?.#revision ?? 0
    - #scope?.#references
    - #target
+ is-hovered-link = #is-link && #is-hovered

_ scope Ancestor'MarkdownReferenceScope
_ view Ancestor'MarkdownView
_ block-view Ancestor'MarkdownBlockView
_ hover-scope MarkdownReferenceScope?

────────────────────

<This
    text = #run.text
    if #detail != null
        <MarkdownLinkTooltip
            detail = #detail!

────────────────────
whenever #is-hovered-link

hover-scope = scope ?? hover-scope
hover-scope?.hover-link(this, (run.url ?? detail?.path) if is-hovered-link)

────────────────────
for event on click

. reference = run.reference
. references = scope?.references
. follows = !(block-view?.is-editable ?? false) || event.modifiers.command
if follows && reference && references && target
    references.follow(reference, scope?.origin)
    event.cancel()
else if follows && web-url
    open-url(web-url)
    event.cancel()
else if follows && anchor && view
    . ignored = view.reveal-anchor(anchor)
    event.cancel()

