+ do markdown-runs-insert [MarkdownRun]
    - runs [MarkdownRun]
    - offset Size
    - text String
    - marks MarkdownMarks

. size = markdown-runs-text(runs).size
. head = markdown-runs-slice(runs, 0, offset)
head += markdown-marked-run(text, marks)
= markdown-runs-join(head, markdown-runs-slice(runs, offset, size))

━━━━━━━━━━━━━━━━━━━━
+ markdown-runs-delete [MarkdownRun]
    - runs [MarkdownRun]
    - start Size
    - end Size

markdown-runs-join(markdown-runs-slice(runs, 0, start), markdown-runs-slice(runs, end, size))

.. size = markdown-runs-text(runs).size

━━━━━━━━━━━━━━━━━━━━
+ do markdown-runs-marks-at MarkdownMarks
    - runs [MarkdownRun]
    - offset Size

. at Size = 0
. before MarkdownMarks? = null
. after MarkdownMarks? = null
. inside = false
for run in runs
    . end = at + run.text.size
    if at < offset && offset <= end
        before = if run.is-break then null else markdown-run-marks(run)
        inside = offset < end
    if after == null && at >= offset && !run.is-break
        after = markdown-run-marks(run)
    at = end
. found = before ?? after ?? MarkdownMarks()
=? found if inside
= MarkdownMarks(found.is-strong, found.is-em, found.is-code)

━━━━━━━━━━━━━━━━━━━━
+ do markdown-runs-toggle [MarkdownRun]
    - runs [MarkdownRun]
    - start Size
    - end Size
    - mark MarkdownMark

. size = markdown-runs-text(runs).size
. sliced = markdown-runs-slice(runs, start, end)
. has = true
for run in sliced
    if !run.is-break && !markdown-marks-has(markdown-run-marks(run), mark)
        has = false
. middle [MarkdownRun]
for run in sliced
    if run.is-break
        middle += run
    else
        middle += markdown-marked-run
            - run.text
            - markdown-marks-with(markdown-run-marks(run), mark, !has)
= markdown-runs-join
    - markdown-runs-join(markdown-runs-slice(runs, 0, start), middle)
    - markdown-runs-slice(runs, end, size)

━━━━━━━━━━━━━━━━━━━━
+ markdown-marks-has Bool
    - marks MarkdownMarks
    - mark MarkdownMark

match mark
    | .strong
        marks.is-strong
    | .em
        marks.is-em
    | .code
        marks.is-code

━━━━━━━━━━━━━━━━━━━━
+ markdown-marks-with MarkdownMarks
    - marks MarkdownMarks
    - mark MarkdownMark
    - on Bool

match mark
    | .strong
        MarkdownMarks(on, marks.is-em, marks.is-code, marks.url, marks.is-image)
    | .em
        MarkdownMarks(marks.is-strong, on, marks.is-code, marks.url, marks.is-image)
    | .code
        MarkdownMarks(marks.is-strong, marks.is-em, on, marks.url, marks.is-image)

━━━━━━━━━━━━━━━━━━━━
+ markdown-draft-source String
    - draft MarkdownDraft

|? original != null
    original
|? kind == MarkdownBlockKind.paragraph
    markdown-inline-source(draft.runs, "", false, true)
|? kind == MarkdownBlockKind.heading
    "$heading-prefix${markdown-inline-source(draft.runs, "", false, false)}"
    .. heading-prefix = markdown-heading-prefix(draft.prefix, draft.level)
|? kind == MarkdownBlockKind.item
    "${draft.prefix}${markdown-inline-source(draft.runs, "", false, false)}"
|? kind == MarkdownBlockKind.quote
    "$prefix${markdown-inline-source(draft.runs, "> ", false, false)}"

    .. prefix = if draft.prefix.size > 0 then draft.prefix else "> "
|? kind == MarkdownBlockKind.code || kind == MarkdownBlockKind.exhibit
    markdown-code-source(draft.code, draft.language)
|? kind == MarkdownBlockKind.divider
    "---"
|? kind == MarkdownBlockKind.grid
    markdown-grid-source(draft)
??
    ""

.. kind = draft.kind
.. original = draft.source

━━━━━━━━━━━━━━━━━━━━
_ markdown-heading-prefix String
    - prefix String
    - level Size

|? prefix.size > level && prefix.trim() == "#" * level
    prefix
??
    "${"#" * level} "

━━━━━━━━━━━━━━━━━━━━
+ do markdown-code-source String
    - code String
    - language String

. fence = "```"
while code.find(fence) != null
    fence = "$fence`"
=? "$fence$language\n$fence" if !code.size
= "$fence$language\n$code\n$fence"

━━━━━━━━━━━━━━━━━━━━
+ do markdown-grid-source String
    - draft MarkdownDraft

. lines [String]
for row in 0 .. < draft.row-count
    . original = draft.rows[row] if row < draft.rows.length
    lines += original ?? markdown-grid-row-source(draft, row)
    if row == 0
        lines += draft.delimiter ?? markdown-grid-delimiter(draft.alignments, draft.columns)
= "\n".join(lines)

━━━━━━━━━━━━━━━━━━━━
+ do markdown-grid-row-source String
    - draft MarkdownDraft
    - row Size

. cells [String]
for column in 0 .. < draft.columns
    cells += markdown-inline-source(draft.cells[row * draft.columns + column], "", true, false)
= "| ${" | ".join(cells)} |"

━━━━━━━━━━━━━━━━━━━━
+ do markdown-grid-delimiter String
    - alignments [TextAlignment]
    - columns Size

. cells [String]
for column in 0 .. < columns
    . alignment = if column < alignments.length then alignments[column] else TextAlignment.left
    if alignment == TextAlignment.center
        cells += ":---:"
    else if alignment == TextAlignment.right
        cells += "---:"
    else
        cells += "---"
= "| ${" | ".join(cells)} |"

━━━━━━━━━━━━━━━━━━━━
+ do markdown-inline-source String
    - runs [MarkdownRun]
    - break-prefix String
    - in-table Bool
    - line-start Bool

. writer = MarkdownInlineWriter(in-table, line-start)
. normalized = markdown-runs-normalized(runs)
for index in 0 .. < normalized.length
    . run = normalized[index]
    if run.is-break
        writer.close-to(0)
        writer.parts += "\n$break-prefix"
        writer.at-line-start = line-start
    else
        . next = normalized[index + 1].url if index + 1 < normalized.length
        writer.open(markdown-run-marks(run))
        writer.text(run.text, next != null && next != run.url)
writer.close-to(0)
= "".join(writer.parts)

━━━━━━━━━━━━━━━━━━━━
_ MarkdownInlineWriter

+ parts [String]
+ at-line-start Bool
+ in-table Bool

_ url String?
_ image = false
_ linked = false
_ strong = false
_ em = false
_ code = false

────────────────────
+ This
    - in-table
    - at-line-start

────────────────────
+ do open
    - marks MarkdownMarks

. wants-link = marks.url != null
. same-link = linked == wants-link && (!linked || (url == marks.url && image == marks.is-image))
if !same-link
    close-to(0)
else if strong != marks.is-strong
    close-to(1)
else if em != marks.is-em
    close-to(2)
else if code != marks.is-code
    close-to(3)
if !linked && wants-link
    parts += if marks.is-image then "![" else "["
    linked = true
    url = marks.url
    image = marks.is-image
if !strong && marks.is-strong
    parts += "**"
    strong = true
if !em && marks.is-em
    parts += "*"
    em = true
if !code && marks.is-code
    parts += "`"
    code = true

────────────────────
+ do close-to
    - level Size

if code && level <= 3
    parts += "`"
    code = false
if em && level <= 2
    parts += "*"
    em = false
if strong && level <= 1
    parts += "**"
    strong = false
if linked && level == 0
    parts += "](${markdown-url-escaped(url ?? "")})"
    linked = false
    url = null
    image = false

────────────────────
+ do text
    - text String
    - links-next Bool

if code
    parts += text
    at-line-start = false
    =
. plain = !linked && !strong && !em
parts += markdown-escaped(text, in-table, at-line-start && plain, links-next)
at-line-start = false

━━━━━━━━━━━━━━━━━━━━
+ do markdown-escaped String
    - text String
    - in-table Bool
    - line-start Bool
    - links-next = false

. bytes = text as Byte[]
. parts [String]
. last Size = 0
. guarded = markdown-line-start-guard(bytes) if line-start
for index in 0 .. < bytes.size
    . byte = bytes[index]
    . special = byte == 92 || byte == 42 || byte == 91 || byte == 93 || byte == 96
    . bang = byte == 33 && (if index + 1 < bytes.size then bytes[index + 1] == 91 else links-next)
    . pipe = in-table && byte == 124
    if special || bang || pipe || guarded == index
        parts += markdown-slice(text, last, index)
        parts += "\\"
        last = index
parts += markdown-slice(text, last, bytes.size)
= "".join(parts)

━━━━━━━━━━━━━━━━━━━━
_ do markdown-line-start-guard Size?
    - bytes Byte[]

=? null if !bytes.size
. lead = bytes[0]
if lead == 35
    . count Size = 0
    while count < bytes.size && bytes[count] == 35
        count += 1
    =? 0 if count <= 6 && (count == bytes.size || bytes[count] == 32)
    = null
=? 0 if lead == 62
if lead == 45
    . dashes Size = 0
    . other = false
    for byte in bytes
        if byte == 45
            dashes += 1
        else if byte != 32
            other = true
    =? 0 if !other && dashes >= 3
. index Size = 0
while index < bytes.size && bytes[index] == 32
    index += 1
=? null if index >= bytes.size
. marker = bytes[index]
=? index if (marker == 45 || marker == 43) && (index + 1 == bytes.size || bytes[index + 1] == 32)
. digits = index
while digits < bytes.size && bytes[digits] >= 48 && bytes[digits] <= 57
    digits += 1
=? digits if digits > index && digits + 1 < bytes.size && dot-space
.. dot-space = bytes[digits] == 46 && bytes[digits + 1] == 32
= null

━━━━━━━━━━━━━━━━━━━━
_ markdown-url-escaped String
    - url String

"\\)".join(url.split(")"))

━━━━━━━━━━━━━━━━━━━━
+ do markdown-line-prefix String
    - line String
    - kind MarkdownBlockKind

. bytes = line as Byte[]
. index Size = 0
if kind == MarkdownBlockKind.heading
    while index < bytes.size && bytes[index] == 35
        index += 1
else if kind == MarkdownBlockKind.quote
    =? "" if !bytes.size || bytes[0] != 62
    index = 1
else if kind == MarkdownBlockKind.item
    while index < bytes.size && bytes[index] == 32
        index += 1
    while index < bytes.size && bytes[index] >= 48 && bytes[index] <= 57
        index += 1
    if index < bytes.size && (bytes[index] == 45 || bytes[index] == 42 || plus-or-dot)
        index += 1
    .. plus-or-dot = bytes[index] == 43 || bytes[index] == 46
else
    = ""
while index < bytes.size && bytes[index] == 32
    index += 1
= markdown-slice(line, 0, index)

━━━━━━━━━━━━━━━━━━━━
+ do markdown-next-item-prefix String
    - prefix String

. bytes = prefix as Byte[]
. index Size = 0
while index < bytes.size && bytes[index] == 32
    index += 1
. digits = index
. number Size = 0
while digits < bytes.size && bytes[digits] >= 48 && bytes[digits] <= 57
    number = number * 10 + (bytes[digits] - 48)
    digits += 1
=? prefix if digits == index
= "${markdown-slice(prefix, 0, index)}${number + 1}${markdown-slice(prefix, digits, bytes.size)}"

━━━━━━━━━━━━━━━━━━━━
+ do markdown-table-cell-starts [Size]
    - line String

. bytes = line as Byte[]
. starts [Size]
. index Size = 0
while index < bytes.size && bytes[index] == 32
    index += 1
if index < bytes.size && bytes[index] == 124
    index += 1
. at = index
while at <= bytes.size
    . start = at
    while start < bytes.size && bytes[start] == 32
        start += 1
    starts += start
    . cursor = start
    . ticked = false
    while cursor < bytes.size && (bytes[cursor] != 124 || ticked)
        if bytes[cursor] == 92 && cursor + 1 < bytes.size
            cursor += 1
        else if bytes[cursor] == 96
            ticked = !ticked
        cursor += 1
    =? starts if cursor >= bytes.size
    at = cursor + 1
= starts

━━━━━━━━━━━━━━━━━━━━
+ do markdown-source-offset Size
    - source String
    - visible String
    - offset Size

. from = source as Byte[]
. shown = visible as Byte[]
. cursor Size = 0
. count = min(offset, shown.size)
for index in 0 .. < count
    . at = markdown-byte-match(from, cursor, shown[index])
    if at != null
        cursor = at + 1
if count < shown.size
    . next = markdown-byte-match(from, cursor, shown[count])
    =? next if next != null
= cursor

━━━━━━━━━━━━━━━━━━━━
+ do markdown-visible-offset Size
    - source String
    - visible String
    - offset Size

. from = source as Byte[]
. shown = visible as Byte[]
. cursor Size = 0
. count Size = 0
for index in 0 .. < shown.size
    . at = markdown-byte-match(from, cursor, shown[index])
    if at == null || at >= offset
        break
    cursor = at + 1
    count = index + 1
= count

━━━━━━━━━━━━━━━━━━━━
_ do markdown-byte-match Size?
    - bytes Byte[]
    - start Size
    - wanted Byte

. at = start
while at < bytes.size
    . found = bytes[at]
    =? at if found == wanted || (markdown-is-space(found) && markdown-is-space(wanted))
    at += 1
= null

━━━━━━━━━━━━━━━━━━━━
_ markdown-is-space Bool
    - byte Byte

byte == 32 || byte == 10 || byte == 9 || byte == 13
