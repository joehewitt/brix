━━━━━━━━━━━━━━━━━━━━
+ do markdown-runs-normalized [MarkdownRun]
    - runs [MarkdownRun]

. result [MarkdownRun]
for run in runs
    . count = result.length
    if run.is-break
        result += MarkdownRun(count, " ", false, false, false, null, null, true)
    else if run.text.size > 0
        . marks = markdown-run-marks(run)
        if count > 0 && !result[count - 1].is-break && same-marks
            result[count - 1] = markdown-marked-run("${result[count - 1].text}${run.text}", marks)
        else
            result += markdown-marked-run(run.text, marks)
        .. same-marks = markdown-run-marks(result[count - 1]) == marks
= result

━━━━━━━━━━━━━━━━━━━━
+ do markdown-runs-slice [MarkdownRun]
    - runs [MarkdownRun]
    - start Size
    - end Size

. result [MarkdownRun]
. at Size = 0
for run in runs
    . size = run.text.size
    . low = max(start, at)
    . high = min(end, at + size)
    if high > low
        if run.is-break
            result += run
        else
            result += markdown-marked-run
                - markdown-slice(run.text, low - at, high - at)
                - markdown-run-marks(run)
    at += size
= markdown-runs-normalized(result)

━━━━━━━━━━━━━━━━━━━━
+ do markdown-runs-join [MarkdownRun]
    - first [MarkdownRun]
    - second [MarkdownRun]

. result [MarkdownRun]
for run in first
    result += run
for run in second
    result += run
= markdown-runs-normalized(result)

