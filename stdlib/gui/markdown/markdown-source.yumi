━━━━━━━━━━━━━━━━━━━━
+ MarkdownMarks is Tuple

+ is-strong = false
+ is-em = false
+ is-code = false
+ url String? = null
+ is-image = false

━━━━━━━━━━━━━━━━━━━━
+ MarkdownMark is Union

| strong
| em
| code

━━━━━━━━━━━━━━━━━━━━
+ MarkdownDraft

+ kind MarkdownBlockKind
+ level Size = 0
+ prefix String
+ runs [MarkdownRun]
+ code String
+ language String
+ columns Size = 0
+ cells [[MarkdownRun]]
+ alignments [TextAlignment]
+ rows [String?]
+ delimiter String?
+ source String?

────────────────────
+ This
    - kind
    - runs [MarkdownRun] = List'MarkdownRun()

────────────────────
+ get is-empty

kind == MarkdownBlockKind.paragraph && !runs.length

────────────────────
+ get is-prose

kind == MarkdownBlockKind.paragraph || kind == MarkdownBlockKind.heading || is-flow

────────────────────
+ get is-flow

kind == MarkdownBlockKind.item || kind == MarkdownBlockKind.quote

────────────────────
+ get row-count Size

if columns > 0 then cells.length / columns else 0

────────────────────
+ do copy MarkdownDraft

. result = MarkdownDraft(kind, runs)
result.level = level
result.prefix = prefix
result.code = code
result.language = language
result.columns = columns
for cell in cells
    result.cells += cell
for alignment in alignments
    result.alignments += alignment
for row in rows
    result.rows += row
result.delimiter = delimiter
result.source = source
= result

━━━━━━━━━━━━━━━━━━━━
+ do markdown-block-draft MarkdownDraft
    - block MarkdownBlock
    - prefix String

. draft = MarkdownDraft(block.kind, markdown-runs-normalized(block.runs))
draft.level = block.level
draft.prefix = prefix
draft.code = block.code
draft.language = block.language
draft.columns = block.columns
if block.kind == MarkdownBlockKind.item && !prefix.size
    draft.prefix = "${"  " * block.depth}${if block.marker == "•" then "-" else block.marker} "
for cell in block.cells
    draft.cells += markdown-runs-normalized(cell.runs)
    if cell.is-header
        draft.alignments += cell.alignment
= draft

