(import /gui)
(import /stream/aggregate)
(blank)
(prop _ markdown-reference-extension-limit Size (= 8))
(prop _ markdown-reference-code-limit Size (= 240))

(type + MarkdownReference (is Tuple)
  (prop + path String)
  (prop + line (? Size) (= null))
  (prop + column (? Size) (= null))
)

(type + MarkdownLinkTarget (is Tuple)
  (prop + path String)
  (prop + line (? Size) (= null))
  (prop + column (? Size) (= null))
  (prop + is-directory _ (= false))
)

(type + MarkdownLinkDetail (is Tuple)
  (prop + path String)
  (prop + additions (? I64) (= null))
  (prop + deletions (? I64) (= null))
)

(type + MarkdownReferenceSpan (is Tuple)
  (prop + start Index)
  (prop + end Index)
  (prop + reference MarkdownReference)
)

(type + MarkdownOpening (is Tuple)
  (prop + target MarkdownLinkTarget)
  (prop + origin (? String))
)

(type + MarkdownReferences
  (prop + revision U64)
  (event + opened MarkdownOpening)
  (blank)
  (prop _ found _ (= (call (of Map String MarkdownLinkTarget))))
  (prop _ asked _ (= (call (of Map String Bool))))
  (prop _ wanted _ (= (call (of List MarkdownReference))))
  (prop _ is-resolving _ (= false))
  (fn-do + target-for (? MarkdownLinkTarget)
    (param reference MarkdownReference)
    (let key (call markdown-reference-key reference))
    (let known ([] found key))
    (return-if known (if known))
    (return-if null (if ([] asked key)))
    (= ([] asked key) true)
    (+= wanted reference)
    (if (not is-resolving)
      (= is-resolving true)
      (do-new
        (call resolve-wanted)
      )
    )
    (return null)
  )
  (fn-do + follow _
    (param reference MarkdownReference)
    (param origin (? String) (= null))
    (let known ([] found (call markdown-reference-key reference)))
    (return-if (if (not known)))
    (let target
      (call MarkdownLinkTarget
        (block
          (arg (. known path))
          (arg (?? (. reference line) (. known line)))
          (arg (?? (. reference column) (. known column)))
          (arg (. known is-directory))
        )
      )
    )
    (<- opened (call MarkdownOpening target origin))
  )
  (fn-do + resolve-all (map String MarkdownLinkTarget) (?! Error)
    (param references (list MarkdownReference))
    (return (call (of Map String MarkdownLinkTarget)))
  )
  (fn-expr + describe (? MarkdownLinkDetail)
    (param target MarkdownLinkTarget)
    (call MarkdownLinkDetail (. target path))
  )
  (fn-do _ resolve-wanted _
    (while (> (. wanted length) 0)
      (let batch wanted)
      (= wanted (call (of List MarkdownReference)))
      (let targets (catch? (call resolve-all batch)))
      (if (and targets (> (. targets length) 0))
        (for (in (tuple key target) targets)
          (= ([] found key) target)
        )
        (+= revision 1)
      )
    )
    (= is-resolving false)
  )
)

(type + MarkdownReferenceScope (is Box)
  (prop + references (? MarkdownReferences))
  (prop + origin (? String))
  (prop + hovered-url (? String))
  (blank)
  (prop _ hovered-owner (? Box))
  (fn-do + hover-link _
    (param owner Box)
    (param url (? String))
    (if (!= url null)
      (= hovered-owner owner)
      (= hovered-url url)
      (else-if (and hovered-owner (== (as hovered-owner Pointer) (as owner Pointer)))
        (= hovered-owner null)
        (= hovered-url null)
      )
    )
  )
)

(fn-expr + markdown-reference-target (? MarkdownLinkTarget)
  (param revision U64)
  (param references (? MarkdownReferences))
  (param reference (? MarkdownReference))
  (only-if (call (. references target-for) reference) (if (and references reference)))
)

(fn-expr + markdown-reference-detail (? MarkdownLinkDetail)
  (param revision U64)
  (param references (? MarkdownReferences))
  (param target (? MarkdownLinkTarget))
  (only-if (call (. references describe) target) (if (and references target)))
)

(fn-expr + markdown-reference-key String
  (param reference MarkdownReference)
  (. reference path)
)

(fn-do + markdown-text-references (list MarkdownReferenceSpan)
  (param text String)
  (let chars (. text codepoints))
  (let found (list MarkdownReferenceSpan))
  (let index Index 0)
  (while (< index (. chars length))
    (if (and (call markdown-is-path-char ([] chars index)) starts-path)
      (let span (call markdown-path-span text chars index))
      (if span
        (+= found span)
        (= index (. span end))
        (else
          (+= index 1)
        )
      )
      (else
        (+= index 1)
      )
    )
    (lazy starts-path (or (== index 0) (not (call markdown-is-path-char ([] chars (- index 1))))))
  )
  (return found)
)

(fn-expr + markdown-code-reference (? MarkdownReference)
  (param text String)
  (case? (or (not (. trimmed length)) (> (. trimmed length) markdown-reference-code-limit))
    null
  )
  (case? (and span (== (. span end) (. chars length)))
    (. span reference)
  )
  (default
    null
  )
  (where
    (lazy trimmed (call (. text trim)))
    (lazy chars (. trimmed codepoints))
    (lazy span (call markdown-path-span trimmed chars 0))
  )
)

(fn-expr + markdown-url-reference (? MarkdownReference)
  (param url String)
  (param base _ (= ""))
  (case? (or (not (. local length)) (!= (call (. local find) "://") null))
    null
  )
  (case? (or (call (. local starts-with) "#") (call (. local starts-with) "mailto:"))
    null
  )
  (default
    (call markdown-based-reference (call markdown-local-reference local) base)
  )
  (where
    (lazy local (if-expr (call (. url starts-with) "file://") ([] url (... 7)) url))
  )
)

(fn-expr _ markdown-local-reference (? MarkdownReference)
  (param local String)
  (match (call (. local find) "#L")
    (case (: hash I32)
      (case? (not (. path length))
        null
      )
      (default
        (call MarkdownReference path (only-if (- line 1) (if (and line (> line 0)))))
      )
      (blank)
      (lazy line (call markdown-parse-number ([] local (... (+ hash 2)))))
      (lazy path ([] local (..< 0 hash)))
    )
    (default
      (case? (and span (== (. span end) (. chars length)))
        (. span reference)
      )
      (default
        (call MarkdownReference bare)
      )
      (blank)
      (lazy fragment (call (. local find) "#"))
      (lazy bare (if-expr (!= fragment null) ([] local (..< 0 fragment)) local))
      (lazy chars (. bare codepoints))
      (lazy span (call markdown-path-span bare chars 0))
    )
  )
)

(fn-expr _ markdown-based-reference (? MarkdownReference)
  (param reference (? MarkdownReference))
  (param base String)
  (case? (or (not reference) (not (. base length)) (call (. reference path starts-with) "/"))
    reference
  )
  (default
    (call MarkdownReference (call markdown-joined-path base (. reference path)) (. reference line) (. reference column))
  )
)

(fn-do _ markdown-joined-path String
  (param base String)
  (param path String)
  (let parts (list String))
  (for (in part (call (. (str base "/" path) split) "/"))
    (if (== part "..")
      (if (> (. parts length) 0)
        (call (. parts pop))
      )
      (else-if (and (> (. part length) 0) (!= part "."))
        (+= parts part)
      )
    )
  )
  (return (call (. "/" join) parts))
)

(fn-do _ markdown-path-span (? MarkdownReferenceSpan)
  (param text String)
  (param chars ([] Char))
  (param start Index)
  (return-if null (if (and (> start 0) (== ([] chars (- start 1)) ':'))))
  (let end start)
  (while (and (< end (. chars length)) (call markdown-is-path-char ([] chars end)))
    (+= end 1)
  )
  (while (and (> end start) (or (== ([] chars (- end 1)) '.') (== ([] chars (- end 1)) '-') (== ([] chars (- end 1)) '/')))
    (-= end 1)
  )
  (return-if null (if (== end start)))
  (let path ([] text (..< start end)))
  (return-if null (if (not (call markdown-looks-like-path path))))
  (let line (? Size) null)
  (let column (? Size) null)
  (let stop end)
  (let first (only-if (call markdown-digits-at chars (+ end 1)) (if (and (< end (. chars length)) (== ([] chars end) ':')))))
  (if first
    (= line (. first value))
    (= stop (. first end))
    (let second (only-if (call markdown-digits-at chars (+ stop 1)) (if (and (< stop (. chars length)) (== ([] chars stop) ':')))))
    (if second
      (= column (. second value))
      (= stop (. second end))
      (else
        (lazy has-range (and (< stop (. chars length)) (== ([] chars stop) '-')))
        (let last (only-if (call markdown-digits-at chars (+ stop 1)) (if has-range)))
        (if last
          (= stop (. last end))
        )
      )
    )
  )
  (let shown-line (only-if (- line 1) (if (and line (> line 0)))))
  (let shown-column (only-if (- column 1) (if (and column (> column 0)))))
  (return (call MarkdownReferenceSpan start stop (call MarkdownReference path shown-line shown-column)))
)

(type _ MarkdownDigits (is Tuple)
  (prop + value Size)
  (prop + end Index)
)

(fn-do _ markdown-digits-at (? MarkdownDigits)
  (param chars ([] Char))
  (param start Index)
  (let value Size 0)
  (let end start)
  (while (and (< end (. chars length)) (>= ([] chars end) '0') (<= ([] chars end) '9'))
    (= value (+ (* value 10) (- (as ([] chars end) U32) (as '0' U32))))
    (+= end 1)
  )
  (return (only-if (call MarkdownDigits value end) (if (> end start))))
)

(fn-expr _ markdown-parse-number (? Size)
  (param text String)
  (?. (call markdown-digits-at (. text codepoints) 0) value)
)

(fn-expr _ markdown-looks-like-path Bool
  (param path String)
  (and (not (call (. path starts-with) "//")) (> (. name length) 0) (or has-extension (and (!= slash null) has-letter)))
  (where
    (lazy slash (call (. path find-reverse) "/"))
    (lazy name (if-expr (!= slash null) ([] path (... (+ slash 1))) path))
    (lazy has-letter (call markdown-has-letter name))
    (lazy dot (call (. name find-reverse) "."))
    (lazy extension (if-expr (and (!= dot null) (> dot 0)) ([] name (... (+ dot 1))) ""))
    (lazy fits-limit (and (> (. extension length) 0) (<= (. extension length) markdown-reference-extension-limit)))
    (lazy has-extension (and fits-limit (call markdown-has-letter extension) (call markdown-is-word extension)))
  )
)

(fn-expr _ markdown-has-letter Bool
  (param text String)
  (call some text (:where (or (and (>= each 'a') (<= each 'z')) (and (>= each 'A') (<= each 'Z')))))
)

(fn-expr _ markdown-is-word Bool
  (param text String)
  (call all text (:where (call markdown-is-word-char each)))
)

(fn-expr _ markdown-is-word-char Bool
  (param char Char)
  (or is-letter is-digit (== char '_'))
  (where
    (lazy is-letter (or (and (>= char 'a') (<= char 'z')) (and (>= char 'A') (<= char 'Z'))))
    (lazy is-digit (and (>= char '0') (<= char '9')))
  )
)

(fn-expr _ markdown-is-path-char Bool
  (param char Char)
  (or is-word-char (== char '-') (== char '.') (== char '/') (== char '~') (== char '@'))
  (where
    (lazy is-word-char (call markdown-is-word-char char))
  )
)
