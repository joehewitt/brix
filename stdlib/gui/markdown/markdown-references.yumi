━━━━━━━━━━━━━━━━━━━━
+ MarkdownReferences

+ revision U64
+ event opened MarkdownOpening

_ found = Map'String'MarkdownLinkTarget()
_ asked = Map'String'Bool()
_ wanted = List'MarkdownReference()
_ is-resolving = false

────────────────────
+ do target-for MarkdownLinkTarget?
    - reference MarkdownReference

. key = markdown-reference-key(reference)
. known = found[key]
=? known if known
=? null if asked[key]
asked[key] = true
wanted += reference
if !is-resolving
    is-resolving = true
    do new
        resolve-wanted()
= null

────────────────────
+ do follow
    - reference MarkdownReference
    - origin String? = null

. known = found[markdown-reference-key(reference)]
=? if !known
. target = MarkdownLinkTarget
    - known.path
    - reference.line ?? known.line
    - reference.column ?? known.column
    - known.is-directory
opened <- MarkdownOpening(target, origin)

────────────────────
+ do resolve-all [String = MarkdownLinkTarget] ?! Error
    - references [MarkdownReference]

= Map'String'MarkdownLinkTarget()

────────────────────
+ describe MarkdownLinkDetail?
    - target MarkdownLinkTarget

MarkdownLinkDetail(target.path)

────────────────────
_ do resolve-wanted

while wanted.length > 0
    . batch = wanted
    wanted = List'MarkdownReference()
    . targets = catch? resolve-all(batch)
    if targets && targets.length > 0
        for key, target in targets
            found[key] = target
        revision += 1
is-resolving = false

━━━━━━━━━━━━━━━━━━━━
+ MarkdownReferenceScope is Box

+ references MarkdownReferences?
+ origin String?
+ hovered-url String?

_ hovered-owner Box?

────────────────────
+ do hover-link
    - owner Box
    - url String?

if url != null
    hovered-owner = owner
    hovered-url = url
else if hovered-owner && hovered-owner as Pointer == owner as Pointer
    hovered-owner = null
    hovered-url = null

