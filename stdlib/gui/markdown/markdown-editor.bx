  (fn-do _ edit-range _
    (param from MarkdownPoint)
    (param to MarkdownPoint)
    (param typed String)
    (param coalescing Bool)
    (let start (call markdown-snap-point blocks from (== from to)))
    (let end (call markdown-snap-point blocks to true))
    (if (== (. start block) (. end block))
      (let draft (call draft-at (. start block)))
      (call delete-in-draft draft start end)
      (if (. typed size)
        (call insert-in-draft draft (. start cell) (. start offset) typed)
      )
      (call commit
        (block
          (arg (. start block))
          (arg (. start block))
          (arg (list draft))
          (arg (call MarkdownPoint 0 (. start cell) (+ (. start offset) (. typed size))))
          (arg coalescing)
        )
      )
      (return)
    )
    (let head (call draft-at (. start block)))
    (let tail (call draft-at (. end block)))
    (let drops-head (and (not (. head is-prose)) (== (. start cell) 0) (== (. start offset) 0)))
    (let drops-tail (and (not (. tail is-prose)) (== end (call slot-end-of (. end block)))))
    (call markdown-truncate-draft head start true)
    (call markdown-truncate-draft tail end false)
    (if (and (. head is-prose) (. tail is-prose))
