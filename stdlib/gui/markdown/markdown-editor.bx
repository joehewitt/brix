  (fn-do _ delete-in-draft _
    (param draft MarkdownDraft)
    (param start MarkdownPoint)
    (param end MarkdownPoint)
    (return-if (if (== start end)))
    (let kind (. draft kind))
    (if (or (== kind (. MarkdownBlockKind code)) (== kind (. MarkdownBlockKind exhibit)))
      (= (. draft code)
        (scope (str (call markdown-slice (. draft code) 0 (. start offset)) code-tail)
          (lazy code-tail (call markdown-slice (. draft code) (. end offset) (. draft code size)))
        )
      )
      (else-if (== kind (. MarkdownBlockKind grid))
        (for (in cell (..< (. start cell) (+ (. end cell) 1)))
          (let size (. (call markdown-runs-text ([] (. draft cells) cell)) size))
          (let from (if-expr (== cell (. start cell)) (. start offset) 0))
          (let to (if-expr (== cell (. end cell)) (. end offset) size))
          (= ([] (. draft cells) cell) (call markdown-runs-delete ([] (. draft cells) cell) from to))
          (call markdown-touch-row draft cell)
