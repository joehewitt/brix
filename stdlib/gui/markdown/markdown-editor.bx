  (fn-do _ block-rule Bool
    (param point MarkdownPoint)
    (param draft MarkdownDraft)
    (let text (call markdown-runs-text (. draft runs)))
    (return-if false (if (!= (. point offset) (. text size))))
    (if (== text "---")
      (call commit
        (block
          (arg (. point block))
          (arg (. point block))
          (arg (list (call MarkdownDraft (. MarkdownBlockKind divider)) (call MarkdownDraft (. MarkdownBlockKind paragraph))))
          (arg (call MarkdownPoint 1 0 0))
        )
      )
      (return true)
    )
    (if (call (. text starts-with) "```")
      (let code (call MarkdownDraft (. MarkdownBlockKind code)))
      (= (. code language) (call (. (call markdown-slice text 3 (. text size)) trim)))
      (call commit (. point block) (. point block) (list code) (call MarkdownPoint 0 0 0))
