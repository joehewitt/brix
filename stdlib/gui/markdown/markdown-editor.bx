    (let marker (call markdown-slice text 0 (. point offset)))
    (let size (. text size))
    (let rest (call markdown-runs-slice (. draft runs) (. point offset) size))
    (let heading (call markdown-heading-marker marker))
    (if (> heading 0)
      (= (. draft kind) (. MarkdownBlockKind heading))
