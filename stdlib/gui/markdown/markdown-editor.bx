        (= (. draft prefix) (str marker " "))
      )
      (else-if (== marker ">")
        (= (. draft kind) (. MarkdownBlockKind quote))
        (= (. draft prefix) "> ")
      )
      (else
        (return false)
      )
    )
    (= (. draft runs) rest)
    (call commit (. point block) (. point block) (list draft) (call MarkdownPoint 0 0 0))
    (return true)
