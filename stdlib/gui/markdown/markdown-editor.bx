    )
    (let cells (call markdown-header-cells text))
    (return-if false (if (< (. cells length) 1)))
    (let grid (call MarkdownDraft (. MarkdownBlockKind grid)))
    (= (. grid columns) (. cells length))
    (for (in cell cells)
      (let runs (list MarkdownRun))
      (+= runs (call markdown-marked-run cell (call MarkdownMarks)))
      (+= (. grid cells) runs)
    )
    (for (in cell cells)
      (+= (. grid cells) (call (of List MarkdownRun)))
    )
    (call commit (. point block) (. point block) (list grid) (call MarkdownPoint 0 (. grid columns) 0))
    (return true)
  )
  (fn-do _ append-row _
    (param draft MarkdownDraft)
    (for (in column (..< 0 (. draft columns)))
      (+= (. draft cells) (call (of List MarkdownRun)))
    )
  )
  (fn-do _ delete-backward _
    (if (!= anchor caret)
      (call edit-range (call selection-start) (call selection-end) "" false)
      (return)
    )
    (let point caret)
    (if (> (. point offset) 0)
      (let start (call markdown-previous-char (call slot-text point) (. point offset)))
      (call edit-range (call MarkdownPoint (. point block) (. point cell) start) point "" false)
      (return)
    )
    (let block ([] blocks (. point block)))
    (let kind (. block kind))
    (if (== kind (. MarkdownBlockKind grid))
      (call move-horizontally false false false)
      (return)
    )
    (if (== kind (. MarkdownBlockKind code))
      (if (not (. block code size))
        (call commit
          (block
            (arg (. point block))
            (arg (. point block))
            (arg (list (call MarkdownDraft (. MarkdownBlockKind paragraph))))
            (arg (call MarkdownPoint 0 0 0))
          )
        )
        (else
          (call move-horizontally false false false)
        )
      )
      (return)
    )
    (if (!= kind (. MarkdownBlockKind paragraph))
      (let draft (call draft-at (. point block)))
      (= (. draft kind) (. MarkdownBlockKind paragraph))
      (= (. draft prefix) "")
      (= (. draft level) 0)
      (call commit (. point block) (. point block) (list draft) (call MarkdownPoint 0 0 0))
      (return)
    )
    (return-if (if (== (. point block) 0)))
    (let previous (- (. point block) 1))
    (let before ([] blocks previous))
    (if (or (call markdown-is-atomic before) (call (. model is-empty-block) previous))
      (call commit previous (. point block) (list (call draft-at (. point block))) (call MarkdownPoint 0 0 0))
      (else-if (call markdown-is-prose (. before kind))
        (let merged (call draft-at previous))
        (let size (. (call markdown-runs-text (. merged runs)) size))
        (= (. merged runs) (call markdown-runs-join (. merged runs) (. (call draft-at (. point block)) runs)))
        (call commit previous (. point block) (list merged) (call MarkdownPoint 0 0 size))
      )
      (else-if (call (. model is-empty-block) (. point block))
        (let end (call slot-end-of previous))
        (call commit previous (. point block) (list (call draft-at previous)) (call MarkdownPoint 0 (. end cell) (. end offset)))
      )
      (else
        (call set-caret (call slot-end-of previous) false)
      )
    )
  )
  (fn-do _ delete-forward _
    (if (!= anchor caret)
      (call edit-range (call selection-start) (call selection-end) "" false)
      (return)
    )
    (let point caret)
    (let size (call slot-size point))
    (if (< (. point offset) size)
      (let end (call markdown-next-char (call slot-text point) (. point offset)))
      (call edit-range point (call MarkdownPoint (. point block) (. point cell) end) "" false)
      (return)
    )
    (let block ([] blocks (. point block)))
    (return-if (if (== (. block kind) (. MarkdownBlockKind grid))))
    (let next (+ (. point block) 1))
    (return-if (if (>= next (. blocks length))))
    (let after ([] blocks next))
    (let here (call draft-at (. point block)))
    (if (or (call markdown-is-atomic after) (call (. model is-empty-block) next))
      (call commit (. point block) next (list here) (call MarkdownPoint 0 (. point cell) (. point offset)))
      (else-if (. here is-empty)
        (call commit (. point block) next (list (call draft-at next)) (call MarkdownPoint 0 0 0))
      )
      (else-if (and (call markdown-is-prose (. block kind)) (call markdown-is-prose (. after kind)))
        (= (. here runs) (call markdown-runs-join (. here runs) (. (call draft-at next) runs)))
        (call commit (. point block) next (list here) (call MarkdownPoint 0 0 (. point offset)))
      )
    )
  )
  (fn-do _ delete-word _
    (param forward Bool)
    (if (!= anchor caret)
      (call edit-range (call selection-start) (call selection-end) "" false)
      (return)
    )
    (let point caret)
    (let text (call slot-text point))
    (if forward
      (return-if (call delete-forward) (if (>= (. point offset) (. text size))))
      (call edit-range
        (block
          (arg point)
          (arg (call MarkdownPoint (. point block) (. point cell) (call markdown-word-right text (. point offset))))
          (arg "")
          (arg false)
        )
      )
      (else
        (return-if (call delete-backward) (if (== (. point offset) 0)))
        (call edit-range
          (block
            (arg (call MarkdownPoint (. point block) (. point cell) (call markdown-word-left text (. point offset))))
            (arg point)
            (arg "")
            (arg false)
          )
        )
      )
    )
  )
  (fn-do _ delete-to-row-edge _
    (param forward Bool)
    (if (!= anchor caret)
      (call edit-range (call selection-start) (call selection-end) "" false)
      (return)
    )
    (let edge (call row-edge caret forward))
    (if (and forward (> (. edge offset) (. caret offset)))
      (call edit-range caret edge "" false)
      (else-if (and (not forward) (< (. edge offset) (. caret offset)))
        (call edit-range edge caret "" false)
      )
      (else-if forward
        (call delete-forward)
      )
      (else
        (call delete-backward)
      )
    )
  )
  (fn-do _ tab _
    (param backward Bool)
    (let point caret)
    (let block ([] blocks (. point block)))
    (let kind (. block kind))
    (if (== kind (. MarkdownBlockKind grid))
      (if backward
        (return-if (if (== (. point cell) 0)))
        (call set-caret (call MarkdownPoint (. point block) (- (. point cell) 1) 0) false)
        (return)
      )
      (if (< (+ (. point cell) 1) (. block cells length))
        (call set-caret (call MarkdownPoint (. point block) (+ (. point cell) 1) 0) false)
        (return)
      )
      (let draft (call draft-at (. point block)))
      (call append-row draft)
      (call commit (. point block) (. point block) (list draft) (call MarkdownPoint 0 (+ (. point cell) 1) 0))
      (return)
    )
    (if (and (== kind (. MarkdownBlockKind code)) (not backward))
      (call edit-range (call selection-start) (call selection-end) "    " false)
      (return)
    )
    (return-if (if (!= kind (. MarkdownBlockKind item))))
    (let draft (call draft-at (. point block)))
    (let indent (call markdown-leading-spaces (. draft prefix)))
    (if backward
      (return-if (if (== indent 0)))
      (= (. draft prefix) (call markdown-slice (. draft prefix) (call min indent 2) (. draft prefix size)))
      (else
        (return-if (if (or (== (. point block) 0) (!= (. ([] blocks (- (. point block) 1)) kind) (. MarkdownBlockKind item)))))
        (= (. draft prefix) (str "  " (. draft prefix)))
      )
    )
    (call commit (. point block) (. point block) (list draft) (call MarkdownPoint 0 0 (. point offset)))
  )
  (fn-do + paste-text _
    (param pasted String)
    (let text (call (. "\n" join) (call (. pasted split) "\r\n")))
    (if (!= anchor caret)
      (call edit-range (call selection-start) (call selection-end) "" false)
    )
    (let point caret)
    (let kind (. ([] blocks (. point block)) kind))
    (if (or (== kind (. MarkdownBlockKind code)) (== kind (. MarkdownBlockKind grid)) (== (call (. text find) "\n") null))
      (if (or (== kind (. MarkdownBlockKind code)) (== kind (. MarkdownBlockKind grid)))
        (call insert-text text)
        (return)
      )
      (let parsed (call rendered-blocks text))
      (if (and (== (. parsed length) 1) (== (. ([] parsed 0) kind) (. MarkdownBlockKind paragraph)))
        (let draft (call draft-at (. point block)))
        (let runs (call markdown-runs-normalized (. ([] parsed 0) runs)))
        (let size (. (call markdown-runs-text (. draft runs)) size))
        (= (. draft runs)
          (call markdown-runs-join
            (block
              (arg (call markdown-runs-join (call markdown-runs-slice (. draft runs) 0 (. point offset)) runs))
              (arg (call markdown-runs-slice (. draft runs) (. point offset) size))
            )
          )
        )
        (call commit
          (block
            (arg (. point block))
            (arg (. point block))
            (arg (list draft))
            (arg (call MarkdownPoint 0 0 (+ (. point offset) (. (call markdown-runs-text runs) size))))
          )
        )
        (return)
      )
      (call insert-text text)
      (return)
    )
    (let draft (call draft-at (. point block)))
    (let size (. (call markdown-runs-text (. draft runs)) size))
    (let tail (call (. draft copy)))
    (= (. draft runs) (call markdown-runs-slice (. draft runs) 0 (. point offset)))
    (= (. tail runs) (call markdown-runs-slice (. tail runs) (. point offset) size))
    (let drafts (list MarkdownDraft))
    (+= drafts draft)
    (for (in block (call rendered-blocks text))
      (+= drafts (call markdown-block-draft block ""))
    )
    (let last ([] drafts (- (. drafts length) 1)))
    (let caret-block (- (. drafts length) 1))
    (let caret-offset (if-expr (. last is-prose) (. (call markdown-runs-text (. last runs)) size) 0))
    (if (. tail runs length)
      (if (. last is-prose)
        (= (. last runs) (call markdown-runs-join (. last runs) (. tail runs)))
        (else
          (+= drafts tail)
        )
      )
    )
    (if (and (> (. drafts length) 1) (== (. ([] drafts 1) kind) (. MarkdownBlockKind paragraph)) (. ([] drafts 0) is-prose))
      (let first-size (. (call markdown-runs-text (. ([] drafts 0) runs)) size))
      (= (. ([] drafts 0) runs) (call markdown-runs-join (. ([] drafts 0) runs) (. ([] drafts 1) runs)))
      (if (== caret-block 1)
        (+= caret-offset first-size)
      )
      (call (. drafts remove) 1)
      (-= caret-block 1)
    )
    (if (and (> (. drafts length) 1) (. ([] drafts 0) is-empty))
      (call (. drafts remove) 0)
      (-= caret-block 1)
    )
    (call commit (. point block) (. point block) drafts (call MarkdownPoint caret-block 0 caret-offset))
  )
  (fn-do _ rendered-blocks (list MarkdownBlock)
    (param text String)
    (let parsed (call markdown-blocks text base))
    (for (in block parsed)
      (call markdown-render-block code-renderer block)
    )
    (return parsed)
  )
  (fn-do _ copy-selection Bool
    (param clipboard Clipboard)
    (return-if false (if (== anchor caret)))
    (return (call (. clipboard write-text) (call selection-source)))
  )
  (fn-expr _ selection-source String
    (call markdown-selection-source blocks (call selection-start) (call selection-end) (. model prefixes) (. model sources))
  )
  (fn-expr _ draft-at MarkdownDraft
    (param index Size)
    (call markdown-block-draft-at blocks index (. model prefixes) (. model sources))
  )
  (fn-expr _ selection-start MarkdownPoint
    (if-expr (call markdown-point-before caret anchor) caret anchor)
  )
  (fn-expr _ selection-end MarkdownPoint
    (if-expr (call markdown-point-before caret anchor) anchor caret)
  )
  (fn-do _ set-caret _
    (param point MarkdownPoint)
    (param extends Bool)
    (= caret (call markdown-snap-point blocks point (call markdown-point-before caret point)))
    (if (not extends)
      (= anchor caret)
    )
    (= typing-marks null)
  )
  (fn-expr _ clamp-point MarkdownPoint
    (param point MarkdownPoint)
    (call markdown-clamp-point blocks point)
  )
  (fn-expr _ editable-from (? Size)
    (param index Size)
    (param forward Bool)
    (call markdown-editable-from blocks index forward)
  )
  (fn-expr _ slot-count Size
    (param index Size)
    (call markdown-slot-count blocks index)
  )
  (fn-expr _ slot-runs (list MarkdownRun)
    (param point MarkdownPoint)
    (call markdown-slot-runs blocks point)
  )
  (fn-expr _ slot-text String
    (param point MarkdownPoint)
    (call markdown-slot-text blocks point)
  )
  (fn-expr _ slot-size Size
    (param point MarkdownPoint)
    (call markdown-slot-size blocks point)
  )
  (fn-expr _ slot-end-of MarkdownPoint
    (param index Size)
    (call markdown-slot-end blocks index)
  )
  (fn-expr _ first-point MarkdownPoint
    (call markdown-first-point blocks)
  )
  (fn-expr _ last-point MarkdownPoint
    (call markdown-last-point blocks)
  )
  (fn-expr _ next-slot (? MarkdownPoint)
    (param point MarkdownPoint)
    (case? (< (+ (. point cell) 1) (call slot-count (. point block)))
      (call MarkdownPoint (. point block) (+ (. point cell) 1) 0)
    )
    (case? (>= (+ (. point block) 1) (. blocks length))
      null
    )
    (case? (== index null)
      null
    )
    (default
      (call MarkdownPoint index 0 0)
    )
    (where
      (lazy index (call editable-from (+ (. point block) 1) true))
    )
  )
  (fn-expr _ previous-slot (? MarkdownPoint)
    (param point MarkdownPoint)
    (case? (> (. point cell) 0)
      (call MarkdownPoint (. point block) (- (. point cell) 1) (call slot-size cell))
      (blank)
      (lazy cell (call MarkdownPoint (. point block) (- (. point cell) 1) 0))
    )
    (case? (== (. point block) 0)
      null
    )
    (case? (== index null)
      null
    )
    (default
      (call slot-end-of index)
    )
    (where
      (lazy index (call editable-from (- (. point block) 1) false))
    )
  )
  (fn-do _ move-horizontally _
    (param forward Bool)
    (param by-word Bool)
    (param extends Bool)
    (if (and (!= anchor caret) (not extends))
      (call set-caret (if-expr forward (call selection-end) (call selection-start)) false)
      (return)
    )
    (let text (call slot-text caret))
    (if (and forward (< (. caret offset) (. text size)))
      (let next
        (scope (if-expr by-word (call markdown-word-right text (. caret offset)) next-char)
          (lazy next-char (call markdown-next-char text (. caret offset)))
        )
      )
      (call set-caret (call MarkdownPoint (. caret block) (. caret cell) next) extends)
      (else-if (and (not forward) (> (. caret offset) 0))
        (let next
          (scope (if-expr by-word (call markdown-word-left text (. caret offset)) previous-char)
            (lazy previous-char (call markdown-previous-char text (. caret offset)))
          )
        )
        (call set-caret (call MarkdownPoint (. caret block) (. caret cell) next) extends)
      )
      (else
        (let neighbor (if-expr forward (call next-slot caret) (call previous-slot caret)))
        (if (!= neighbor null)
          (call set-caret neighbor extends)
        )
      )
    )
  )
  (fn-do _ move-vertically _
    (param down Bool)
    (param extends Bool)
    (let view (call slot-view caret))
    (let rect (call point-rect caret))
    (let layout (?. view text-layout))
    (if (or (not view) (== rect null) (not layout))
      (let fallback (call vertical-neighbor caret down (?? goal-x 0)))
      (if (!= fallback null)
        (call set-caret fallback extends)
      )
      (return)
    )
    (let x (?? goal-x (. rect x)))
    (let row (call (. layout line-at) (. caret offset)))
    (let target (? MarkdownPoint) null)
    (if (and down (< (+ row 1) (. layout line-count)))
      (= target (call MarkdownPoint (. caret block) (. caret cell) (call row-offset view (+ row 1) x)))
      (else-if (and (not down) (> row 0))
        (= target (call MarkdownPoint (. caret block) (. caret cell) (call row-offset view (- row 1) x)))
      )
      (else
        (let neighbor (call vertical-neighbor caret down x))
        (if (!= neighbor null)
          (let other (call slot-view neighbor))
          (let shaped (?. other text-layout))
          (if (and other shaped)
            (let edge (if-expr down 0 (- (. shaped line-count) 1)))
            (= target (call MarkdownPoint (. neighbor block) (. neighbor cell) (call row-offset other edge x)))
            (else
              (= target neighbor)
            )
          )
          (else
            (= target (call MarkdownPoint (. caret block) (. caret cell) (if-expr down (call slot-size caret) 0)))
          )
        )
      )
    )
    (if (!= target null)
      (call set-caret target extends)
    )
    (= goal-x x)
  )
  (fn-expr _ row-offset Size
    (param view Text)
    (param row Index)
    (param x Length)
    (if-expr (== rect null) 0 (call (. view offset-at) (call Point x (+ (. rect y) (/ (. rect height) 2)))))
    (where
      (lazy rect (call (. view row-rect) row))
    )
  )
  (fn-do _ vertical-neighbor (? MarkdownPoint)
    (param point MarkdownPoint)
    (param down Bool)
    (param x Length)
    (let block ([] blocks (. point block)))
    (if (and (== (. block kind) (. MarkdownBlockKind grid)) (> (. block columns) 0))
      (let columns (. block columns))
      (if (and down (< (+ (. point cell) columns) (. block cells length)))
        (return (call MarkdownPoint (. point block) (+ (. point cell) columns) 0))
      )
      (if (and (not down) (>= (. point cell) columns))
        (return (call MarkdownPoint (. point block) (- (. point cell) columns) 0))
      )
    )
    (let index (? Size) null)
    (if down
      (= index (only-if (call editable-from (+ (. point block) 1) true) (if (< (+ (. point block) 1) (. blocks length)))))
      (else
        (= index (only-if (call editable-from (- (. point block) 1) false) (if (> (. point block) 0))))
      )
    )
    (return-if null (if (== index null)))
    (let target ([] blocks index))
    (if (and (== (. target kind) (. MarkdownBlockKind grid)) (> (. target columns) 0))
      (let columns (. target columns))
      (let first (if-expr down 0 (- (. target cells length) columns)))
      (return (call MarkdownPoint index (+ first (call column-at index first columns x)) 0))
    )
    (return (call MarkdownPoint index 0 0))
  )
  (fn-do _ column-at Size
    (param index Size)
    (param first Size)
    (param columns Size)
    (param x Length)
    (let best Size 0)
    (let distance Length 0)
    (for (in column (..< 0 columns))
      (let view (call slot-view (call MarkdownPoint index (+ first column) 0)))
      (if view
        (let box (. view bounds))
        (let gap
          (scope (if-expr (< x (. box x)) (- (. box x) x) (if-expr past-right (- x (. box x) (. box width)) 0))
            (lazy past-right (> x (+ (. box x) (. box width))))
          )
        )
        (if (or (== column 0) (< gap distance))
          (= best column)
          (= distance gap)
        )
      )
    )
    (return best)
  )
  (fn-do _ move-to-row-edge _
    (param forward Bool)
    (param extends Bool)
    (call set-caret (call row-edge caret forward) extends)
  )
  (fn-expr _ row-edge MarkdownPoint
    (param point MarkdownPoint)
    (param forward Bool)
    (case? (not layout)
      (call MarkdownPoint (. point block) (. point cell) (if-expr forward size 0))
    )
    (case? (not forward)
      (call MarkdownPoint (. point block) (. point cell) (call (. layout line-start-offset) row))
    )
    (default
      (call MarkdownPoint (. point block) (. point cell) (call min trimmed size))
    )
    (where
      (lazy view (call slot-view point))
      (lazy layout (?. view text-layout))
      (lazy size (call slot-size point))
      (lazy row (call (. layout line-at) (. point offset)))
      (lazy end (call (. layout line-end-offset) row))
      (lazy text (call slot-text point))
      (lazy bytes (call byte-view text))
      (lazy trimmed (if-expr (and (< (+ row 1) (. layout line-count)) (> end 0) ends-in-space) (- end 1) end))
      (lazy ends-in-space (and (<= end (. bytes size)) (== ([] bytes (- end 1)) 32)))
    )
  )
  (fn-do _ move-page _
    (param down Bool)
    (param extends Bool)
    (let rect (call point-rect caret))
    (return-if (if (== rect null)))
    (let distance (. rows content-bounds height))
    (let y (if-expr down (+ (. rect y) distance) (- (. rect y) distance)))
    (let found (call point-at (call Point (?? goal-x (. rect x)) y)))
    (if (!= found null)
      (call set-caret found extends)
    )
  )
  (fn-expr _ point-at (? MarkdownPoint)
    (param point Point)
    (call markdown-point-at blocks (call block-views) point)
  )
  (fn-expr _ point-rect (? Rect)
    (param point MarkdownPoint)
    (call (?. (call slot-view point) caret-rect) (. point offset))
  )
  (fn-expr _ slot-view (? Text)
    (param point MarkdownPoint)
    (if-expr (not view) null (call slot-view-in view point))
    (where
      (lazy view (call block-view (. point block)))
    )
  )
  (fn-expr _ slot-view-in (? Text)
    (param view MarkdownBlockView)
    (param point MarkdownPoint)
    (call markdown-slot-view-in view point)
  )
  (fn-do _ block-view (? MarkdownBlockView)
    (param index Size)
    (return-if null (if (>= index (. blocks length))))
    (let wanted ([] blocks index))
    (for (in view (call block-views))
      (return-if view (if (== (as (. view block) Pointer) (as wanted Pointer))))
    )
    (return null)
  )
  (fn-do _ block-views (list MarkdownBlockView)
    (let found (list MarkdownBlockView))
    (for (in row (call editor-rows))
      (let view (call markdown-row-view row))
      (if (and view (< (. view block index) (. blocks length)) same-block)
        (+= found view)
      )
      (lazy same-block (== (as ([] blocks (. view block index)) Pointer) (as (. view block) Pointer)))
    )
    (return found)
  )
  (fn-do _ editor-rows (list MarkdownEditorRow)
    (let found (list MarkdownEditorRow))
    (call markdown-collect-rows rows found)
    (return found)
  )
  (fn-expr _ content-point Point
    (param root-point Point)
    (call Point (+ (. local x) (. rows bounds x) (. offset x)) (+ (. local y) (. rows bounds y) (. offset y)))
    (where
      (lazy local (call (. rows point-in-box) root-point))
      (lazy offset (. rows content-offset))
    )
  )
  (fn-do _ paint-row _
    (param canvas Canvas)
    (param row MarkdownEditorRow)
    (return-if (if (not session)))
    (let shown (call markdown-row-view row))
    (return-if (if (not shown)))
    (let index (. shown block index))
    (return-if (if (or (>= index (. blocks length)) (!= (as ([] blocks index) Pointer) (as (. shown block) Pointer)))))
    (if (!= anchor caret)
      (let color
        (scope (if-expr is-focused $gui-markdown-selection-color idle-color)
          (lazy idle-color $gui-markdown-idle-selection-color)
        )
      )
      (let object-color
        (scope (if-expr is-focused $gui-markdown-object-selection-color idle-object-color)
          (lazy idle-object-color $gui-markdown-idle-object-selection-color)
        )
      )
      (call markdown-paint-selection
        (block
          (arg canvas)
          (arg blocks)
          (arg shown)
          (arg (call selection-start))
          (arg (call selection-end))
          (arg color)
          (arg object-color)
        )
      )
      (return)
    )
    (return-if (if (or (!= (. caret block) index) (not is-focused) (not is-caret-lit))))
    (let view (call slot-view-in shown caret))
    (return-if (if (not view)))
    (let rect (call (. view caret-rect) (. caret offset)))
    (return-if (if (== rect null)))
    (= (. canvas fill-color) $gui-markdown-caret-color)
    (call (. canvas rect) (call Rect (- (. rect x) (/ markdown-caret-width 2)) (. rect y) markdown-caret-width (. rect height)))
  )
  (fn-do _ point-at-source MarkdownPoint
    (param text CodeText)
    (param offset Size)
    (return-if (call MarkdownPoint 0 0 0) (if (not (. blocks length))))
    (let index (call (. model block-at-offset) offset))
    (if (and (> offset ([] (. model ends) index)) (< (+ index 1) (. blocks length)))
      (+= index 1)
    )
    (let block ([] blocks index))
    (return-if (call clamp-point (call MarkdownPoint index 0 0)) (if (call markdown-is-atomic block)))
    (let start ([] (. model starts) index))
    (if (or (== (. block kind) (. MarkdownBlockKind code)) (== (. block kind) (. MarkdownBlockKind exhibit)))
      (let body (call (. text line-start) (call min (+ (call (. text line-at) start) 1) (- (. text line-count) 1))))
      (return (call clamp-point (call MarkdownPoint index 0 (if-expr (> offset body) (- offset body) 0))))
    )
    (if (== (. block kind) (. MarkdownBlockKind grid))
      (return (call grid-point-at-source text index (call min offset ([] (. model ends) index))))
    )
    (let from (+ start (call min (. ([] (. model prefixes) index) size) (- ([] (. model ends) index) start))))
    (let point (call MarkdownPoint index 0 0))
    (let inner (if-expr (> offset from) (- offset from) 0))
    (let found (call markdown-visible-offset (call (. text text-in) from ([] (. model ends) index)) (call source-text point) inner))
    (return (call clamp-point (call MarkdownPoint index 0 (call markdown-runs-shown-offset (call slot-runs point) found))))
  )
  (fn-do _ grid-point-at-source MarkdownPoint
    (param text CodeText)
    (param index Size)
    (param offset Size)
    (let block ([] blocks index))
    (let columns (call max (. block columns) 1))
    (let first (call (. text line-at) ([] (. model starts) index)))
    (let line (call (. text line-at) offset))
    (let row-line (- line first))
    (let row (if-expr (>= row-line 2) (- row-line 1) 0))
    (let line-start (call (. text line-start) line))
    (let cells (call markdown-table-cell-starts (call (. text line-text) line)))
    (let local (- offset line-start))
    (let column Size 0)
    (for (in at (..< 0 (. cells length)))
      (if (<= ([] cells at) local)
        (= column at)
      )
    )
    (= column (call min column (- columns 1)))
    (let cell (call min (+ (* row columns) column) (- (call max (. block cells length) 1) 1)))
    (let point (call MarkdownPoint index cell 0))
    (let cell-start (if-expr (< column (. cells length)) ([] cells column) local))
    (let cell-end (if-expr (< (+ column 1) (. cells length)) ([] cells (+ column 1)) (call (. text line-length) line)))
    (let source (call markdown-slice (call (. text line-text) line) cell-start cell-end))
    (let inner (if-expr (> local cell-start) (- local cell-start) 0))
    (let found (call markdown-visible-offset source (call source-text point) inner))
    (return (call clamp-point (call MarkdownPoint index cell (call markdown-runs-shown-offset (call slot-runs point) found))))
  )
  (fn-do _ source-at-point Size
    (param text CodeText)
    (param point MarkdownPoint)
    (return-if 0 (if (>= (. point block) (. blocks length))))
    (let index (. point block))
    (let block ([] blocks index))
    (let start ([] (. model starts) index))
    (return-if start (if (or (call (. model is-empty-block) index) (call markdown-is-atomic block))))
    (if (or (== (. block kind) (. MarkdownBlockKind code)) (== (. block kind) (. MarkdownBlockKind exhibit)))
      (let body (call (. text line-start) (call min (+ (call (. text line-at) start) 1) (- (. text line-count) 1))))
      (return (call min (+ body (. point offset)) ([] (. model ends) index)))
    )
    (if (== (. block kind) (. MarkdownBlockKind grid))
      (let columns (call max (. block columns) 1))
      (let row (/ (. point cell) columns))
      (let line (+ (call (. text line-at) start) (if-expr (== row 0) 0 (+ row 1))))
      (return-if start (if (>= line (. text line-count))))
      (let line-text (call (. text line-text) line))
      (let cells (call markdown-table-cell-starts line-text))
      (let column (% (. point cell) columns))
      (return-if (call (. text line-start) line) (if (>= column (. cells length))))
      (let cell-end (if-expr (< (+ column 1) (. cells length)) ([] cells (+ column 1)) (. line-text size)))
      (let source (call markdown-slice line-text ([] cells column) cell-end))
      (return (+ (call (. text line-start) line) ([] cells column) (call source-offset source point)))
    )
    (let from (+ start (call min (. ([] (. model prefixes) index) size) (- ([] (. model ends) index) start))))
    (return (+ from (call source-offset (call (. text text-in) from ([] (. model ends) index)) point)))
  )
  (fn-expr _ source-offset Size
    (param source String)
    (param point MarkdownPoint)
    (call markdown-source-offset source (call source-text point) (call markdown-runs-source-offset (call slot-runs point) (. point offset)))
  )
  (fn-expr _ source-text String
    (param point MarkdownPoint)
    (call markdown-runs-source-text (call slot-runs point))
  )
  (fn-expr _ caret-context (? TextInputContext)
    (case? (or (not session) (not (. blocks length)))
      null
    )
    (default
      (call TextInputContext preceding selected rect)
    )
    (where
      (lazy shown (call point-rect caret))
      (lazy rect (if-expr shown (call window-rect shown rows) (call window-rect corner material-parent)))
      (lazy corner (call Rect (. bounds x) (. bounds y) 0 0))
      (lazy preceding (call markdown-slice (call slot-text caret) 0 (. caret offset)))
      (lazy start (call selection-start))
      (lazy end (call selection-end))
      (lazy selected (if-expr same-slot (call markdown-slice (call slot-text start) (. start offset) (. end offset)) ""))
      (lazy same-slot (and (== (. start block) (. end block)) (== (. start cell) (. end cell))))
    )
  )
  (fn-do _ window-rect Rect
    (param rect Rect)
    (param start (? Box))
    (let x (. rect x))
    (let y (. rect y))
    (let cursor start)
    (while cursor
      (let ancestor cursor)
      (if (not (. ancestor is-markup-shadow))
        (let offset (. ancestor content-offset))
        (-= x (. offset x))
        (-= y (. offset y))
      )
      (if (. ancestor is-presentation-layer)
        (break)
      )
      (= cursor (. ancestor material-parent))
    )
    (return (call Rect x y (. rect width) (. rect height)))
  )
  (fn-do _ start-blink _
    (= is-caret-lit true)
    (call (?. blinker cancel-later))
    (= blinker
      (do-new
        (let blinked 0ms)
        (while (or (< blinked markdown-blink-timeout) (not is-caret-lit))
          (call (. markdown-blink-interval wait))
          (= is-caret-lit (not is-caret-lit))
          (+= blinked markdown-blink-interval)
          (call repaint)
        )
      )
    )
  )
  (fn-do _ stop-blink _
    (call (?. blinker cancel-later))
    (= blinker null)
  )
  (fn-do _ reveal-pending-line _
    (let line pending-line)
    (return-if (if (or (== line null) (not (. blocks length)))))
    (= pending-line null)
    (let low Size 0)
    (let high (. blocks length))
    (while (< low high)
      (let middle (+ low (/ (- high low) 2)))
      (if (<= (. ([] blocks middle) line) line)
        (= low (+ middle 1))
        (else
          (= high middle)
        )
      )
    )
    (let index (if-expr (> low 0) (- low 1) 0))
    (call (. rows reveal-address) index)
  )
)

(fn-expr _ markdown-gap String
  (param original String)
  (param before MarkdownBlockKind)
  (param before-empty Bool)
  (param after MarkdownBlockKind)
  (param after-empty Bool)
  (case? (>= newlines 2)
    original
  )
  (case? (and (== newlines 1) (not before-empty) (not after-empty) (not merges))
    original
  )
  (case? (and both-items (not before-empty) (not after-empty))
    "\n"
  )
  (default
    "\n\n"
  )
  (where
    (lazy newlines (call markdown-newline-count original))
    (lazy merges (or both-paragraphs both-quotes))
    (lazy both-paragraphs (and (== before (. MarkdownBlockKind paragraph)) (== after (. MarkdownBlockKind paragraph))))
    (lazy both-quotes (and (== before (. MarkdownBlockKind quote)) (== after (. MarkdownBlockKind quote))))
    (lazy both-items (and (== before (. MarkdownBlockKind item)) (== after (. MarkdownBlockKind item))))
  )
)

(fn-do _ markdown-newline-count Size
  (param text String)
  (let count Size 0)
  (for (in byte (call byte-view text))
    (if (== byte 10)
      (+= count 1)
    )
  )
  (return count)
)

(fn-expr _ markdown-separator String
  (param first MarkdownDraft)
  (param second MarkdownDraft)
  (if-expr both-items "\n" "\n\n")
  (where
    (lazy both-items (and (== (. first kind) (. MarkdownBlockKind item)) (== (. second kind) (. MarkdownBlockKind item))))
  )
)

(fn-expr _ markdown-is-prose Bool
  (param kind MarkdownBlockKind)
  (or prose (== kind (. MarkdownBlockKind item)) (== kind (. MarkdownBlockKind quote)))
  (where
    (lazy prose (or (== kind (. MarkdownBlockKind paragraph)) (== kind (. MarkdownBlockKind heading))))
  )
)

(type _ MarkdownEditorRow (is Box)
  (prop + editor (? MarkdownEditor))
  (fn-do + paint-overlay _
    (param canvas Canvas)
    (call (?. editor paint-row) canvas this)
  )
)

(type _ MarkdownBlockSource
  (implements VirtualSequenceDomain)
  (implements (of VirtualSource MarkdownBlock))
  (prop + model MarkdownModel)
  (prop + revision _ (:= (call VirtualRevision)))
  (prop + inset VirtualCoord)
  (prop + limit VirtualCoord)
  (blank)
  (depends parameters-changed inset limit)
  (fn-do + This _
    (param model _)
  )
  (fn-expr + estimate VirtualCoord
    (param address I64)
    (param width VirtualCoord)
    (case? (or (< address 0) (>= address (as (. model blocks length) I64)))
      markdown-estimated-line
    )
    (case? (== (. block kind) (. MarkdownBlockKind heading))
      (if-expr (<= (. block level) 1) 48vcoord 40vcoord)
    )
    (case? (== (. block kind) (. MarkdownBlockKind divider))
      21vcoord
    )
    (case? (or (== (. block kind) (. MarkdownBlockKind code)) (== (. block kind) (. MarkdownBlockKind exhibit)))
      (+ (* (+ (as (call markdown-newline-count (. block code)) VirtualCoord) 1vcoord) 19vcoord) 36vcoord)
    )
    (case? (== (. block kind) (. MarkdownBlockKind grid))
      (+ (* (as (/ (. block cells length) columns) VirtualCoord) 32vcoord) 12vcoord)
      (blank)
      (lazy columns (if-expr (> (. block columns) 0) (. block columns) 1))
    )
    (case? (== size 0vcoord)
      markdown-estimated-line
    )
    (default
      (+ (* (+ (/ size chars) 1vcoord) 22vcoord) 10vcoord)
    )
    (where
      (lazy index (as address Index))
      (lazy block ([] (. model blocks) index))
      (lazy available (- width inset))
      (lazy column (if-expr (and (> limit 0vcoord) (< limit available)) limit available))
      (lazy chars (if-expr (> column 160vcoord) (/ column 8vcoord) 20vcoord))
      (lazy size (as (- ([] (. model ends) index) ([] (. model starts) index)) VirtualCoord))
    )
  )
  (fn-do _ parameters-changed _
    (call (. revision touch))
  )
  (fn-expr + known-count VirtualCoord :get
    (. model blocks length)
  )
  (fn-expr + estimated-count (? VirtualCoord) :get
    (as (. model blocks length) VirtualCoord)
  )
  (fn-expr + is-final Bool :get
    true
  )
  (fn-expr + address-at I64
    (param index VirtualCoord)
    index
  )
  (fn-expr + index-of (? VirtualCoord)
    (param address I64)
    (case? (or (< address 0) (>= address (as (. model blocks length) I64)))
      null
    )
    (default
      (as address VirtualCoord)
    )
  )
  (fn-expr + domain VirtualSequenceDomain :get
    this
  )
  (fn-do + bind _
    (param address I64)
    (param generation U64)
    (param target (of VirtualBindingTarget MarkdownBlock))
    (if (or (< address 0) (>= address (as (. model blocks length) I64)))
      (call (. target fail) generation)
      (else
        (call (. target commit) (call VirtualKey (. revision value) address) ([] (. model blocks) address) generation)
      )
    )
  )
  (fn-do + identity-at (? U64)
    (param address I64)
    (return-if (if (or (< address 0) (>= address (as (. model blocks length) I64)))))
    (return (as (. (as ([] (. model blocks) address) Pointer) address) U64))
  )
)

(fn-expr _ markdown-block-layout VerticalMeasuredLayout
  (param source MarkdownBlockSource)
  (call VerticalMeasuredLayout markdown-estimated-line estimate)
  (where
    (lazy estimate (=> (address width) (call (. source estimate) address width)))
  )
)

(fn-do _ markdown-collect-rows _
  (param box Box)
  (param found (list MarkdownEditorRow))
  (for (in child (call RenderedChildCursor box))
    (if (is child MarkdownEditorRow)
      (+= found (as child MarkdownEditorRow))
      (else-if (is child (of VirtualSlotRoot MarkdownBlock))
        (if (. (as child (of VirtualSlotRoot MarkdownBlock)) slot is-bound)
          (call markdown-collect-rows child found)
        )
      )
      (else
        (call markdown-collect-rows child found)
      )
    )
  )
)

(fn-do _ markdown-row-view (? MarkdownBlockView)
  (param row MarkdownEditorRow)
  (for (in child (call RenderedChildCursor row))
    (return-if (as child MarkdownBlockView) (if (is child MarkdownBlockView)))
  )
  (return null)
)

(fn-do _ markdown-heading-marker Size
  (param marker String)
  (return-if 0 (if (or (< (. marker size) 1) (> (. marker size) 6))))
  (for (in byte (call byte-view marker))
    (return-if 0 (if (!= byte 35)))
  )
  (return (. marker size))
)

(fn-do _ markdown-is-ordered-marker Bool
  (param marker String)
  (let bytes (call byte-view marker))
  (return-if false (if (or (< (. bytes size) 2) (!= ([] bytes (- (. bytes size) 1)) 46))))
  (return (call all (..< 0 (- (. bytes size) 1)) (:where (and (>= ([] bytes each) 48) (<= ([] bytes each) 57)))))
)

(fn-do _ markdown-header-cells (list String)
  (param text String)
  (let trimmed (call (. text trim)))
  (let result (list String))
  (return-if result (if (or (not (call (. trimmed starts-with) "|")) (< (. trimmed size) 3) unclosed)))
  (lazy unclosed (!= ([] (call byte-view trimmed) (- (. trimmed size) 1)) 124))
  (for (in part (call (. (call markdown-slice trimmed 1 (- (. trimmed size) 1)) split) "|"))
    (+= result (call (. part trim)))
  )
  (return result)
)

(fn-do _ markdown-line-indent String
  (param code String)
  (param offset Size)
  (let bytes (call byte-view code))
  (let start (call min offset (. bytes size)))
  (while (and (> start 0) (!= ([] bytes (- start 1)) 10))
    (-= start 1)
  )
  (let end start)
  (while (and (< end (. bytes size)) (< end offset) (or (== ([] bytes end) 32) (== ([] bytes end) 9)))
    (+= end 1)
  )
  (return (call markdown-slice code start end))
)

(fn-do _ markdown-leading-spaces Size
  (param text String)
  (let bytes (call byte-view text))
  (let count Size 0)
  (while (and (< count (. bytes size)) (== ([] bytes count) 32))
    (+= count 1)
  )
  (return count)
)

(fn-expr _ markdown-next-char Size
  (param text String)
  (param offset Size)
  (if-expr (>= offset (. bytes size)) (. bytes size) (call min (+ offset width) (. bytes size)))
  (where
    (lazy bytes (call byte-view text))
    (lazy lead ([] bytes offset))
    (lazy width (if-expr (>= lead 0xF0) 4 (if-expr (>= lead 0xE0) 3 (if-expr (>= lead 0xC0) 2 1))))
  )
)

(fn-do _ markdown-previous-char Size
  (param text String)
  (param offset Size)
  (let bytes (call byte-view text))
  (let at (call min offset (. bytes size)))
  (return-if 0 (if (== at 0)))
  (-= at 1)
  (while (and (> at 0) (>= ([] bytes at) 0x80) (< ([] bytes at) 0xC0))
    (-= at 1)
  )
  (return at)
)

(fn-do _ markdown-word-left Size
  (param text String)
  (param offset Size)
  (let bytes (call byte-view text))
  (let at (call min offset (. bytes size)))
  (while (and (> at 0) (== (call markdown-byte-class ([] bytes (- at 1))) 0))
    (-= at 1)
  )
  (return-if 0 (if (== at 0)))
  (let kind (call markdown-byte-class ([] bytes (- at 1))))
  (while (and (> at 0) (== (call markdown-byte-class ([] bytes (- at 1))) kind))
    (-= at 1)
  )
  (return at)
)

(fn-do _ markdown-word-right Size
  (param text String)
  (param offset Size)
  (let bytes (call byte-view text))
  (let at offset)
  (while (and (< at (. bytes size)) (== (call markdown-byte-class ([] bytes at)) 0))
    (+= at 1)
  )
  (return-if (. bytes size) (if (>= at (. bytes size))))
  (let kind (call markdown-byte-class ([] bytes at)))
  (while (and (< at (. bytes size)) (== (call markdown-byte-class ([] bytes at)) kind))
    (+= at 1)
  )
  (return at)
)

(fn-do _ markdown-edit-role (? MenuRole)
  (param event KeyPressEvent)
  (return-if (. MenuRole redo) (if (call (. markdown-redo-key matches) event)))
  (for (in role markdown-edit-roles)
    (let key (call menu-role-key role))
    (return-if role (if (and key (call (. key matches) event))))
  )
  (return null)
)
