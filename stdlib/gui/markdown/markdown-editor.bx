      (= (. merged runs) (call markdown-runs-join (. head runs) (. tail runs)))
      (if (. typed size)
        (call insert-in-draft merged 0 (. start offset) typed)
      )
      (if (not (. merged runs length))
        (= merged (call MarkdownDraft (. MarkdownBlockKind paragraph)))
      )
      (call commit (. start block) (. end block) (list merged) (call MarkdownPoint 0 0 (+ (. start offset) (. typed size))))
      (return)
    )
    (let drafts (list MarkdownDraft))
    (let next (call MarkdownPoint 0 (. start cell) (+ (. start offset) (. typed size))))
    (if (and (. head is-prose) (not (. head runs length)))
      (= head (call MarkdownDraft (. MarkdownBlockKind paragraph)))
    )
    (if (not drops-head)
      (if (. typed size)
        (call insert-in-draft head (. start cell) (. start offset) typed)
      )
      (+= drafts head)
    )
    (if (not drops-tail)
      (+= drafts tail)
    )
    (if drops-head
      (= next (call MarkdownPoint 0 0 (. typed size)))
      (if (or (. typed size) (not (. drafts length)))
        (let front (call MarkdownDraft (. MarkdownBlockKind paragraph)))
        (if (. typed size)
          (call insert-in-draft front 0 0 typed)
        )
        (call (. drafts insert) front 0)
      )
    )
    (call commit (. start block) (. end block) drafts next)
  )
  (fn-do _ insert-in-draft _
    (param draft MarkdownDraft)
    (param cell Size)
    (param offset Size)
    (param typed String)
    (let kind (. draft kind))
    (if (or (== kind (. MarkdownBlockKind code)) (== kind (. MarkdownBlockKind exhibit)))
      (= (. draft code)
        (scope (str (call markdown-slice (. draft code) 0 offset) typed code-tail)
          (lazy code-tail (call markdown-slice (. draft code) offset (. draft code size)))
        )
      )
      (else-if (== kind (. MarkdownBlockKind grid))
        (let runs ([] (. draft cells) cell))
        (= ([] (. draft cells) cell)
          (call markdown-runs-insert
            (block
              (arg runs)
              (arg offset)
              (arg typed)
              (arg (?? typing-marks (call markdown-runs-marks-at runs offset)))
            )
          )
        )
        (call markdown-touch-row draft cell)
      )
      (else
        (= (. draft runs)
          (call markdown-runs-insert
            (block
              (arg (. draft runs))
              (arg offset)
              (arg typed)
              (arg (?? typing-marks (call markdown-runs-marks-at (. draft runs) offset)))
            )
          )
        )
      )
    )
