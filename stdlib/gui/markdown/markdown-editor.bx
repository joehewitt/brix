          (block
            (arg (. point block))
            (arg (. point block))
            (arg (list draft (call MarkdownDraft (. MarkdownBlockKind paragraph))))
            (arg (call MarkdownPoint 1 0 0))
          )
        )
        (return)
      )
      (let indent (call markdown-line-indent code (. point offset)))
      (call insert-in-draft draft 0 (. point offset) (str "\n" indent))
      (call commit (. point block) (. point block) (list draft) (call MarkdownPoint 0 0 (+ (. point offset) 1 (. indent size))))
      (return)
    )
    (if (and (== kind (. MarkdownBlockKind paragraph)) (call block-rule point draft))
      (return)
    )
    (if (and (== kind (. MarkdownBlockKind item)) (not size))
      (call commit
        (block
          (arg (. point block))
          (arg (. point block))
          (arg (list (call MarkdownDraft (. MarkdownBlockKind paragraph))))
          (arg (call MarkdownPoint 0 0 0))
        )
      )
      (return)
    )
    (if (. draft is-empty)
      (call commit
        (block
          (arg (. point block))
          (arg (. point block))
          (arg (list draft (call MarkdownDraft (. MarkdownBlockKind paragraph))))
          (arg (call MarkdownPoint 1 0 0))
        )
      )
      (return)
    )
