  (fn-do _ split _
    (let active session)
    (return-if (if (not active)))
    (if (!= anchor caret)
      (call edit-range (call selection-start) (call selection-end) "" false)
    )
    (let point caret)
    (let draft (call draft-at (. point block)))
    (let kind (. draft kind))
    (let size (call slot-size point))
    (if (== kind (. MarkdownBlockKind grid))
      (let columns (. draft columns))
      (if (< (+ (. point cell) columns) (. draft cells length))
        (call set-caret (call MarkdownPoint (. point block) (+ (. point cell) columns) 0) false)
        (call refresh-view)
        (return)
      )
      (call append-row draft)
      (call commit (. point block) (. point block) (list draft) (call MarkdownPoint 0 (+ (. point cell) columns) 0))
      (return)
    )
    (if (== kind (. MarkdownBlockKind code))
      (let code (. draft code))
      (if (and (== (. point offset) size) (call (. code ends-with) "\n"))
        (= (. draft code) (call markdown-slice code 0 (- size 1)))
