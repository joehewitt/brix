(import ./markdown-blocks)
(import ./markdown-model)
(import ./markdown-selection)
(import ./markdown-source)
(import ./markdown-view)
(import /code)
(import /core/style)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/text)
(import /gui)
(import /gui/clipboard)
(import /gui/virtual)
(import /math)
(import /stream/aggregate)
(import /time/duration)
(import /ui/input)
(import /ui/key-combo)
(import /ui/undo-target)
(import /ui/virtual)
(import /ui/virtual-layout)
(import /units)
(blank)
(prop _ markdown-caret-width Length (= 2))
(prop _ markdown-blink-interval _ (= 530ms))
(prop _ markdown-blink-timeout _ (= 10s))
(prop _ markdown-overscan VirtualCoord (= 1000vcoord))
(prop _ markdown-estimated-line VirtualCoord (= 32vcoord))
(prop _ markdown-edit-roles _
  (:=
    (block
      (list (. MenuRole select-all))
    )
  )
)
(prop _ markdown-redo-key _ (:= (call KeyCombo "Cmd+Y")))
(prop _ markdown-save-key _ (:= (call KeyCombo "Cmd+S")))
(prop _ markdown-bold-key _ (:= (call KeyCombo "Cmd+B")))
(prop _ markdown-italic-key _ (:= (call KeyCombo "Cmd+I")))
(prop _ markdown-paragraph-key _ (:= (call KeyCombo "Cmd+0")))
(prop _ markdown-heading-keys _
  (:=
    (block
      (list (call KeyCombo "Cmd+1") (call KeyCombo "Cmd+2") (call KeyCombo "Cmd+3") (call KeyCombo "Cmd+4") (call KeyCombo "Cmd+5") (call KeyCombo "Cmd+6"))
    )
  )
)

(type + MarkdownEditor (is Box)
  (implements UndoTarget)
  (prop + session (? CodeSession))
  (prop + base String)
  (prop + column-width (? Length) (= null))
  (prop + column-padding _ (= (call Insets 0 0 0 0)))
  (prop + code-renderer (? MarkdownCodeRenderer) (= null))
  (prop + text-input-context _ (=> (call caret-context)))
  (prop + undo-target _ (=> this))
  (event + save-requested CodeSession)
  (blank)
  (prop _ blocks (list MarkdownBlock))
  (prop _ model _ (= (call MarkdownModel)))
  (prop _ block-source _ (:= (call MarkdownBlockSource model)))
  (prop _ block-layout _ (:= (call markdown-block-layout block-source)))
  (prop _ painted-first Size)
  (prop _ painted-last Size)
  (prop _ reveal-tries Size)
  (prop _ caret _ (= (call MarkdownPoint 0 0 0)))
  (prop _ anchor _ (= (call MarkdownPoint 0 0 0)))
  (prop _ drag-origin _ (= (call MarkdownRange (call MarkdownPoint 0 0 0) (call MarkdownPoint 0 0 0))))
  (prop _ drag-granularity _ (= (. MarkdownGranularity character)))
  (prop _ shown-revision U64)
  (prop _ shown-generation U64)
  (prop _ goal-x (? Length))
  (prop _ typing-marks (? MarkdownMarks))
  (prop _ is-applying _ (= false))
  (prop _ reveals _ (= false))
  (prop _ pending-line (? Size))
  (prop _ is-caret-lit _ (= true))
  (prop _ blinker (? Task))
  (blank)
  (rule This (• markdown-editor) (• flex-col)
    (= focus-mode (. FocusMode input))
  )
  (content
    (<> This
      (<> (of VirtualRegion MarkdownBlock) (id: rows) (• flex 1)
        (= source block-source)
        (= virtual-layout block-layout)
        (= overscan (call VirtualInsets markdown-overscan 0vcoord markdown-overscan 0vcoord))
        (= binds-viewport-first true)
        (blank)
        (<> MarkdownEditorRow (slot: row) (param: slot) (• flex-col)
          (= editor this)
          (= padding-left (. #column-padding left))
          (= padding-right (. #column-padding right))
          (<> MarkdownBlockView
            (= block (. slot #item))
            (= is-editable true)
            (= code-renderer #code-renderer)
            (= min-width (call (. SizeSpec percent) 100%))
            (= max-width (if-expr (!= #column-width null) (call (. SizeSpec coord) #column-width) (. SizeSpec auto)))
            (= align-x (. Alignment center))
            (for (on request source-requested)
              (call toggle-source request)
            )
          )
        )
      )
    )
  )
  (whenever-rule #code-renderer
    (call render-blocks)
    (call (. block-source revision bump))
    (call refresh-view)
  )
  (whenever-rule #column-padding
    (= (. block-layout leading) (as (. column-padding top) VirtualCoord))
    (= (. block-layout trailing) (as (. column-padding bottom) VirtualCoord))
    (= (. block-source inset) (as (+ (. column-padding left) (. column-padding right)) VirtualCoord))
  )
  (whenever-rule #column-width
    (= (. block-source limit) (as (?? column-width 0) VirtualCoord))
  )
  (fn-do + show _
    (param next CodeSession)
    (+= shown-generation 1)
    (let generation shown-generation)
    (= session next)
    (call rebuild next)
    (call adopt-session-caret next)
    (call invalidate-layout)
    (call repaint)
    (for (on revision (. next updated) (until (!= generation shown-generation)))
      (call session-updated)
    )
  )
  (fn-do + top-line (? Size)
    (let top (+ (. rows content-bounds y) (. rows content-offset y)))
    (let found (? MarkdownBlockView) null)
    (for (in view (call block-views))
      (if (and (< (. view block index) (. blocks length)) (> (+ (. view bounds y) (. view bounds height)) (+ top 1)))
        (if (or (not found) (< (. view block index) (. found block index)))
          (= found view)
        )
      )
    )
    (return (. (?. found block) line))
  )
  (fn-do + reveal-line _
    (param line Size)
    (= pending-line line)
    (call reveal-pending-line)
  )
  (fn-do + store-caret _
    (let active session)
    (if active
      (call sync-session-caret active)
    )
  )
  (fn-do + click-at _
    (param root-point Point)
    (param click-count U32)
    (param extends Bool)
    (call request-focus)
    (let found (call point-at (call content-point root-point)))
    (return-if (if (== found null)))
    (= drag-granularity (call markdown-granularity click-count))
    (let keeps (and (== drag-granularity (. MarkdownGranularity character)) extends))
    (= drag-origin
      (scope (if-expr keeps (call MarkdownRange anchor anchor) found-unit)
        (lazy found-unit (call markdown-unit-at blocks found drag-granularity))
      )
    )
    (let range (call markdown-extend-range blocks drag-origin found drag-granularity))
    (= anchor (. range anchor))
    (= caret (. range caret))
    (= goal-x null)
    (= typing-marks null)
    (call refresh-view)
  )
  (fn-do + perform _
    (param command TextCommand)
    (param extends _ (= false))
    (let active session)
    (return-if (if (not active)))
    (if (and (!= command (. TextCommand move-up)) (!= command (. TextCommand move-down)))
      (= goal-x null)
    )
    (match command
      (case .move-backward
        (call move-horizontally false false extends)
      )
      (case .move-forward
        (call move-horizontally true false extends)
      )
      (case .move-word-backward
        (call move-horizontally false true extends)
      )
      (case .move-word-forward
        (call move-horizontally true true extends)
      )
      (case .move-up
        (call move-vertically false extends)
      )
      (case .move-down
        (call move-vertically true extends)
      )
      (case .move-to-line-start
        (call move-to-row-edge false extends)
      )
      (case .move-to-line-end
        (call move-to-row-edge true extends)
      )
      (case .move-to-paragraph-start
        (call set-caret (call MarkdownPoint (. caret block) (. caret cell) 0) extends)
      )
      (case .move-to-paragraph-end
        (call set-caret (call MarkdownPoint (. caret block) (. caret cell) (call slot-size caret)) extends)
      )
      (case .move-to-start
        (call set-caret (call first-point) extends)
      )
      (case .move-to-end
        (call set-caret (call last-point) extends)
      )
      (case .page-up
        (call move-page false extends)
      )
      (case .page-down
        (call move-page true extends)
      )
      (case .delete-backward
        (call delete-backward)
      )
      (case .delete-forward
        (call delete-forward)
      )
      (case .delete-word-backward
        (call delete-word false)
      )
      (case .delete-word-forward
        (call delete-word true)
      )
      (case .delete-to-line-start
        (call delete-to-row-edge false)
      )
      (case .delete-to-line-end
        (call delete-to-row-edge true)
      )
      (case .delete-to-paragraph-end
        (call delete-to-row-edge true)
      )
      (case .insert-newline
        (call split)
      )
      (case .insert-line-break
        (call split)
      )
      (case .insert-tab
        (call tab false)
      )
      (case .insert-backtab
        (call tab true)
      )
      (case .select-all
        (= anchor (call first-point))
        (= caret (call last-point))
      )
      (case .cancel
        (= anchor caret)
      )
      (default
        (return)
      )
    )
    (call refresh-view)
  )
  (fn-expr + can-undo _ :get
    (?? (. (?. session history) can-undo) false)
  )
  (fn-expr + can-redo _ :get
    (?? (. (?. session history) can-redo) false)
  )
  (fn-expr + undo-title _ :get
    (?? (. (?. session history) undo-title) "Undo")
  )
  (fn-expr + redo-title _ :get
    (?? (. (?. session history) redo-title) "Redo")
  )
  (fn-do + undo _
    (let ignored (call perform-edit (. MenuRole undo)))
  )
  (fn-do + redo _
    (let ignored (call perform-edit (. MenuRole redo)))
  )
  (fn-do + perform-edit Bool
    (param role MenuRole)
    (let active session)
    (return-if false (if (not active)))
    (match role
      (case .undo
        (call sync-session-caret active)
        (call (. active undo))
        (call session-updated)
      )
      (case .redo
        (call sync-session-caret active)
        (call (. active redo))
        (call session-updated)
      )
      (case .select-all
        (= anchor (call first-point))
        (= caret (call last-point))
        (call refresh-view)
      )
      (default
        (return false)
      )
    )
    (return true)
  )
  (fn-do + insert-text _
    (param typed String)
    (return-if (if (not (. typed size))))
    (let start (call selection-start))
    (let end (call selection-end))
    (let block ([] blocks (. start block)))
    (let is-code (== (. block kind) (. MarkdownBlockKind code)))
    (let text (if-expr is-code typed (call (. " " join) (call (. typed split) "\n"))))
    (if (and (== start end) (== text " ") (call apply-input-rule start))
      (return)
    )
    (call edit-range start end text (== start end))
  )
  (fn-do + toggle-mark _
    (param mark MarkdownMark)
    (let start (call selection-start))
    (let end (call selection-end))
    (if (== start end)
      (let marks (?? typing-marks (call markdown-runs-marks-at (call slot-runs caret) (. caret offset))))
      (= typing-marks (call markdown-marks-with marks mark (not (call markdown-marks-has marks mark))))
      (return)
    )
    (let drafts (list MarkdownDraft))
    (for (in index (..< (. start block) (+ (. end block) 1)))
      (let draft (call draft-at index))
      (let kind (. draft kind))
      (if (== kind (. MarkdownBlockKind grid))
        (for (in cell (..< 0 (. draft cells length)))
          (if (call markdown-cell-in-range index cell start end)
            (let size (. (call markdown-runs-text ([] (. draft cells) cell)) size))
            (let from (if-expr (and (== index (. start block)) (== cell (. start cell))) (. start offset) 0))
            (let to (if-expr (and (== index (. end block)) (== cell (. end cell))) (. end offset) size))
            (= ([] (. draft cells) cell) (call markdown-runs-toggle ([] (. draft cells) cell) from to mark))
            (call markdown-touch-row draft cell)
          )
        )
        (else-if (call markdown-is-prose kind)
          (let size (. (call markdown-runs-text (. draft runs)) size))
          (let from (if-expr (== index (. start block)) (. start offset) 0))
          (let to (if-expr (== index (. end block)) (. end offset) size))
          (= (. draft runs) (call markdown-runs-toggle (. draft runs) from to mark))
        )
      )
      (+= drafts draft)
    )
    (call commit (. start block) (. end block) drafts (call MarkdownPoint 0 0 0))
    (= anchor start)
    (= caret end)
    (call refresh-view)
  )
  (fn-do + set-heading _
    (param level Size)
    (let start (call selection-start))
    (let end (call selection-end))
    (let drafts (list MarkdownDraft))
    (for (in index (..< (. start block) (+ (. end block) 1)))
      (let draft (call draft-at index))
      (if (call markdown-is-prose (. draft kind))
        (= (. draft kind) (if-expr (> level 0) (. MarkdownBlockKind heading) (. MarkdownBlockKind paragraph)))
        (= (. draft level) level)
        (= (. draft prefix) "")
      )
      (+= drafts draft)
    )
    (call commit (. start block) (. end block) drafts (call MarkdownPoint 0 0 0))
    (= anchor (call clamp-point start))
    (= caret (call clamp-point end))
    (call refresh-view)
  )
  (fn-do _ press Bool
    (param event KeyPressEvent)
    (let active session)
    (return-if false (if (not active)))
    (let role (call markdown-edit-role event))
    (return-if (call perform-edit role) (if role))
    (if (call (. markdown-save-key matches) event)
      (call sync-session-caret active)
      (<- save-requested active)
      (return true)
    )
    (if (call (. markdown-bold-key matches) event)
      (call toggle-mark (. MarkdownMark strong))
      (return true)
    )
    (if (call (. markdown-italic-key matches) event)
      (call toggle-mark (. MarkdownMark em))
      (return true)
    )
    (if (call (. markdown-paragraph-key matches) event)
      (call set-heading 0)
      (return true)
    )
    (for (in index (..< 0 (. markdown-heading-keys length)))
      (if (call (. ([] markdown-heading-keys index) matches) event)
        (call set-heading (+ index 1))
        (return true)
      )
    )
    (return false)
  )
  (subscribe-for (on event pointer-down)
    (if (and (== (. event button) (. PointerButton primary)) (not (. event modifiers command)))
      (call click-at (. event root-point) (. event click-count) (. event modifiers shift))
    )
  )
  (subscribe-for (on event pointer-drag)
    (let found (call point-at (call content-point (. event root-point))))
    (if (!= found null)
      (let range (call markdown-extend-range blocks drag-origin found drag-granularity))
      (= anchor (. range anchor))
      (= caret (. range caret))
      (= goal-x null)
      (call refresh-view)
    )
  )
  (subscribe-for (on event key-press)
    (let modifiers (. event modifiers))
    (if (and (== (. event key) (. Key tab)) (not (. modifiers command)) (not (. modifiers control)) (not (. modifiers option)))
      (call perform (if-expr (. modifiers shift) (. TextCommand insert-backtab) (. TextCommand insert-tab)))
      (call (. event cancel))
      (else-if (call press event)
        (call (. event cancel))
      )
    )
  )
  (subscribe-for (on event key-input)
    (if session
      (if (and (> (. event replaces-before) 0) (== caret anchor))
        (let text (call slot-text caret))
        (let start Size (. caret offset))
        (for (in index (..< 0 (. event replaces-before)))
          (= start (call markdown-previous-char text start))
        )
        (let end Size start)
        (for (in index (..< 0 (. event replaces-length)))
          (= end (call markdown-next-char text end))
        )
        (= anchor (call MarkdownPoint (. caret block) (. caret cell) start))
        (= caret (call MarkdownPoint (. caret block) (. caret cell) end))
      )
      (call insert-text (. event text))
      (= goal-x null)
    )
  )
  (subscribe-for (on event text-command)
    (call perform (. event command) (. event extends-selection))
  )
  (subscribe-for (on event copy)
    (if (call copy-selection (. event clipboard))
      (call (. event cancel))
    )
  )
  (subscribe-for (on event cut)
    (if (and session (call copy-selection (. event clipboard)))
      (call edit-range (call selection-start) (call selection-end) "" false)
      (call (. event cancel))
    )
  )
  (subscribe-for (on event paste)
    (let pasted (call (. event clipboard read-text)))
    (if (and session pasted)
      (call paste-text pasted)
      (call (. event cancel))
    )
  )
  (subscribe-for (on event focus)
    (call start-blink)
    (call repaint)
  )
  (subscribe-for (on event blur)
    (call store-caret)
    (call stop-blink)
    (call repaint)
  )
  (fn-do + close _
    (call stop-blink)
    (+= shown-generation 1)
    (= session null)
    (call (. model detach))
    (call (. super close))
  )
  (fn-do + did-layout _
    (call (. super did-layout))
    (return-if (if (not reveals)))
    (= reveals false)
    (call reveal-caret)
  )
  (fn-do _ refresh-view _
    (= reveals true)
    (call invalidate-layout)
    (if is-focused
      (call start-blink)
      (call text-input-changed)
    )
    (call repaint)
  )
  (fn-do _ repaint _
    (let low (if-expr (< (. caret block) (. anchor block)) (. caret block) (. anchor block)))
    (let high (if-expr (> (. caret block) (. anchor block)) (. caret block) (. anchor block)))
    (let first (if-expr (< low painted-first) low painted-first))
    (let last (if-expr (> high painted-last) high painted-last))
    (= painted-first low)
    (= painted-last high)
    (for (in row (call editor-rows))
      (let view (call markdown-row-view row))
      (if (and view (>= (. view block index) first) (<= (. view block index) last))
        (call (. row invalidate-paint))
      )
    )
  )
  (fn-do _ repaint-rows _
    (for (in row (call editor-rows))
      (call (. row invalidate-paint))
    )
  )
  (fn-do _ reveal-caret _
    (let view (call slot-view caret))
    (if (not view)
      (return-if (if (or (>= reveal-tries 3) (>= (. caret block) (. blocks length)))))
      (+= reveal-tries 1)
      (let ignored (call (. rows scroll-to-address) (. caret block) (. ScrollAlignment nearest)))
      (= reveals true)
      (call invalidate-layout)
      (return)
    )
    (= reveal-tries 0)
    (let rect (call (. view caret-rect) (. caret offset)))
    (return-if (if (== rect null)))
    (let ignored (call (. view reveal-in-ancestors) rect (. ScrollAlignment nearest) (call Insets 24 0 24 0)))
  )
  (fn-do _ session-updated _
    (let active session)
    (return-if (if (or (not active) is-applying (== (. active revision) shown-revision))))
    (call rebuild active)
    (call adopt-session-caret active)
    (= goal-x null)
    (= typing-marks null)
    (call refresh-view)
  )
  (fn-do _ adopt-session-caret _
    (param active CodeSession)
    (= caret (call point-at-source (. active text) (. active caret)))
    (= anchor (call point-at-source (. active text) (. active anchor)))
  )
  (fn-do _ sync-session-caret _
    (param active CodeSession)
    (let text (. active text))
    (let at (call source-at-point text caret))
    (let from (call source-at-point text anchor))
    (if (or (!= (. active caret) at) (!= (. active anchor) from))
      (call (. active select-range) from at)
    )
  )
  (fn-do _ rebuild _
    (param active CodeSession)
    (= shown-revision (. active revision))
    (let change (call (. model sync) (. active text) base))
    (return-if (if (== change null)))
    (if (. change is-rebuilt)
      (= blocks (. model blocks))
      (call (. block-layout reset))
      (call (. rows restore-scroll) (call Point 0 0))
      (else-if (or (> (. change removed) 0) (> (. change added) 0))
        (call (. block-layout splice) block-source (. change at) (. change removed) (. change added))
        (call repaint-rows)
      )
    )
    (call render-blocks)
    (call (. block-source revision bump))
    (call reveal-pending-line)
  )
  (fn-do _ render-blocks _
    (for (in block blocks)
      (call markdown-render-block code-renderer block)
    )
  )
  (fn-do _ toggle-source _
    (param request MarkdownSourceRequest)
    (let block (. request block))
    (call markdown-toggle-source code-renderer block (. request shows))
    (let index (. block index))
    (let active session)
    (return-if (if (or (not active) (>= index (. blocks length)) (!= (as ([] blocks index) Pointer) (as block Pointer)))))
    (if (. block shows-source)
      (call set-caret (call MarkdownPoint index 0 0) false)
      (else
        (= caret (call clamp-point caret))
        (= anchor (call clamp-point anchor))
      )
    )
    (call sync-session-caret active)
    (= goal-x null)
    (call (. block-source revision bump))
    (call request-focus)
    (call refresh-view)
  )
  (fn-do _ commit _
    (param first Size)
    (param last Size)
    (param drafts (list MarkdownDraft))
    (param next MarkdownPoint)
    (param coalescing _ (= false))
    (let active session)
    (return-if (if (or (not active) (not (. drafts length)))))
    (call sync-session-caret active)
    (let text (. active text))
    (let range-start (if-expr (> first 0) ([] (. model ends) (- first 1)) 0))
    (let range-end (if-expr (< (+ last 1) (. blocks length)) ([] (. model starts) (+ last 1)) (. text length)))
    (let parts (list String))
    (let leading (call (. text text-in) range-start ([] (. model starts) first)))
    (if (> first 0)
      (+= parts
        (call markdown-gap
          (block
            (arg leading)
            (arg (. ([] blocks (- first 1)) kind))
            (arg (call (. model is-empty-block) (- first 1)))
            (arg (. ([] drafts 0) kind))
            (arg (. ([] drafts 0) is-empty))
          )
        )
      )
      (else
        (+= parts leading)
      )
    )
    (for (in index (..< 0 (. drafts length)))
      (if (> index 0)
        (+= parts (call markdown-separator ([] drafts (- index 1)) ([] drafts index)))
      )
      (+= parts (call markdown-draft-source ([] drafts index)))
    )
    (let tail ([] drafts (- (. drafts length) 1)))
    (let trailing (call (. text text-in) ([] (. model ends) last) range-end))
    (if (< (+ last 1) (. blocks length))
      (+= parts
        (call markdown-gap
          (block
            (arg trailing)
            (arg (. tail kind))
            (arg (. tail is-empty))
            (arg (. ([] blocks (+ last 1)) kind))
            (arg (call (. model is-empty-block) (+ last 1)))
          )
        )
      )
      (else-if (and (not (. trailing size)) (. tail is-empty))
        (+= parts "\n")
      )
      (else
        (+= parts trailing)
      )
    )
    (call apply-diff active range-start (call (. text text-in) range-start range-end) (call (. "" join) parts) coalescing)
    (call rebuild active)
    (= caret (call clamp-point (call MarkdownPoint (+ first (. next block)) (. next cell) (. next offset))))
    (= anchor caret)
    (= goal-x null)
    (= typing-marks null)
    (call sync-session-caret active)
    (call refresh-view)
  )
  (fn-do _ apply-diff _
    (param active CodeSession)
    (param start Size)
    (param old String)
    (param replacement String)
    (param coalescing Bool)
    (let a (call byte-view old))
    (let b (call byte-view replacement))
    (let prefix Size 0)
    (while (and (< prefix (. a size)) (< prefix (. b size)) (== ([] a prefix) ([] b prefix)))
      (+= prefix 1)
    )
    (while (and (> prefix 0) (< prefix (. a size)) (>= ([] a prefix) 0x80) (< ([] a prefix) 0xC0))
      (-= prefix 1)
    )
    (let suffix Size 0)
    (while (and (< suffix (- (. a size) prefix)) (< suffix (- (. b size) prefix)) (== ([] a (- (. a size) 1 suffix)) ([] b (- (. b size) 1 suffix))))
      (+= suffix 1)
    )
    (while (and (> suffix 0) (>= ([] a (- (. a size) suffix)) 0x80) (< ([] a (- (. a size) suffix)) 0xC0))
      (-= suffix 1)
    )
    (return-if (if (and (== prefix (. a size)) (== prefix (. b size)))))
    (= is-applying true)
