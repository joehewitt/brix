(import /code)
(blank)
(prop _ markdown-backtick Byte (= 96))
(prop _ markdown-pipe Byte (= 124))
(prop _ markdown-backslash Byte (= 92))
(prop _ markdown-hash Byte (= 35))
(prop _ markdown-star Byte (= 42))
(prop _ markdown-plus Byte (= 43))
(prop _ markdown-dash Byte (= 45))
(prop _ markdown-dot Byte (= 46))
(prop _ markdown-colon Byte (= 58))
(prop _ markdown-quote-mark Byte (= 62))
(prop _ markdown-zero Byte (= 48))
(prop _ markdown-nine Byte (= 57))

(type + MarkdownOutlineEdit (is Tuple)
  (prop + first Size)
  (prop + removed Size)
  (prop + added Size)
  (prop + start-line Size)
  (prop + old-end-line (? Size))
)

(type + MarkdownOutline
  (prop + starts (list Size))
  (prop + ends (list Size))
  (fn-do + scan _
    (param text CodeText)
    (= starts (call (of List Size)))
    (= ends (call (of List Size)))
    (let line (call markdown-skip-empty text 0))
    (while (< line (. text line-count))
      (let end (call markdown-value-end text line))
      (+= starts line)
      (+= ends end)
      (= line (call markdown-skip-empty text end))
    )
  )
  (fn-do + update MarkdownOutlineEdit
    (param text CodeText)
    (param damage CodeTextDamage)
    (let low Size 0)
    (let high (. starts length))
    (while (< low high)
      (let middle (+ low (/ (- high low) 2)))
      (if (<= (+ ([] starts middle) 2) (. damage first-line))
        (= low (+ middle 1))
        (else
          (= high middle)
        )
      )
    )
    (let first (if-expr (> low 0) (- low 1) 0))
    (let start-line (if-expr (> low 0) ([] starts first) 0))
    (let added-starts (list Size))
    (let added-ends (list Size))
    (let old first)
    (let old-end-line (? Size) null)
    (let line (call markdown-skip-empty text start-line))
    (while (< line (. text line-count))
      (if (> line (. damage last-line))
        (let target (as (- (as line I64) (. damage line-delta)) Size))
        (while (and (< old (. starts length)) (< ([] starts old) target))
          (+= old 1)
        )
        (if (and (< old (. starts length)) (== ([] starts old) target))
          (= old-end-line target)
          (break)
        )
      )
      (let end (call markdown-value-end text line))
      (+= added-starts line)
      (+= added-ends end)
      (= line (call markdown-skip-empty text end))
    )
    (if (== old-end-line null)
      (= old (. starts length))
    )
    (let index old)
    (while (< index (. starts length))
      (= ([] starts index) (+ (as ([] starts index) I64) (. damage line-delta)))
      (= ([] ends index) (+ (as ([] ends index) I64) (. damage line-delta)))
      (+= index 1)
    )
    (let removed (- old first))
    (if (> removed 0)
      (call (. starts remove) first removed)
      (call (. ends remove) first removed)
    )
    (if (> (. added-starts length) 0)
      (call (. starts insert) added-starts first)
      (call (. ends insert) added-ends first)
    )
    (return (call MarkdownOutlineEdit first removed (. added-starts length) start-line old-end-line))
  )
)

(fn-do _ markdown-skip-empty Size
  (param text CodeText)
  (param line Size)
  (let at line)
  (while (and (< at (. text line-count)) (== (call (. text line-start) at) (call (. text line-end) at)))
    (+= at 1)
  )
  (return at)
)

(fn-do _ markdown-value-end Size
  (param text CodeText)
  (param line Size)
  (let count (. text line-count))
  (let width (call markdown-fence-width text line))
  (if (>= width 3)
    (return-if (+ line 1) (if (>= (+ line 1) count)))
    (let at (+ line 1))
    (while (< at count)
      (return-if (+ at 1) (if (call markdown-is-fence-close text at width)))
      (+= at 1)
    )
    (return count)
  )
  (if (call markdown-is-table-start text line)
    (let at (+ line 2))
    (while (and (< at count) (call markdown-is-table-row text at))
      (+= at 1)
    )
    (return at)
  )
  (return-if (+ line 1) (if (call markdown-is-heading text line)))
  (return-if (call markdown-run-end text line true) (if (call markdown-is-list-line text line false)))
  (return-if (+ line 1) (if (call markdown-is-divider text line)))
  (return-if (call markdown-run-end text line false) (if (call markdown-is-quote text line)))
  (let at (+ line 1))
  (while (and (< at count) (< (call (. text line-start) at) (call (. text line-end) at)) (not (call markdown-is-block-start text at)))
    (+= at 1)
  )
  (return at)
)

(fn-do _ markdown-run-end Size
  (param text CodeText)
  (param line Size)
  (param is-list Bool)
  (let end (+ line 1))
  (let next (call markdown-skip-empty text end))
  (while (and (< next (. text line-count)) (if-expr is-list (call markdown-is-list-line text next false) (call markdown-is-quote text next)))
    (= end (+ next 1))
    (= next (call markdown-skip-empty text end))
  )
  (return end)
)

(fn-expr _ markdown-is-block-start Bool
  (param text CodeText)
  (param line Size)
  (or fence-or-table is-heading is-list-line is-divider (call markdown-is-quote text line))
  (where
    (lazy fence-or-table (or (>= (call markdown-fence-width text line) 3) (call markdown-is-table-start text line)))
    (lazy is-heading (call markdown-is-heading text line))
    (lazy is-list-line (call markdown-is-list-line text line true))
    (lazy is-divider (call markdown-is-divider text line))
  )
)

(fn-do _ markdown-fence-width Size
  (param text CodeText)
  (param line Size)
  (let start (call (. text line-start) line))
  (let end (call (. text line-end) line))
  (let at start)
  (while (and (< at end) (== (call (. text byte-at) at) markdown-backtick))
    (+= at 1)
  )
  (return (- at start))
)

(fn-expr _ markdown-is-fence-close Bool
  (param text CodeText)
  (param line Size)
  (param width Size)
  (and (>= ticks width) (== (call markdown-skip-spaces text (+ (call (. text line-start) line) ticks) end) end))
  (where
    (lazy ticks (call markdown-fence-width text line))
    (lazy end (call (. text line-end) line))
  )
)

(fn-do _ markdown-is-heading Bool
  (param text CodeText)
  (param line Size)
  (let start (call (. text line-start) line))
  (let end (call (. text line-end) line))
  (let at start)
  (while (and (< at end) (< (- at start) 7) (== (call (. text byte-at) at) markdown-hash))
    (+= at 1)
  )
  (let level (- at start))
  (return (and (>= level 1) (<= level 6) (< at end) (call markdown-is-space (call (. text byte-at) at))))
)

(fn-expr _ markdown-is-list-line Bool
  (param text CodeText)
  (param line Size)
  (param allows-zeros Bool)
  (case? (>= at end)
    false
  )
  (case? (or (== byte markdown-star) (== byte markdown-plus) (== byte markdown-dash))
    (and (< (+ at 1) end) (call markdown-is-space (call (. text byte-at) (+ at 1))))
  )
  (case? (== digits at)
    false
  )
  (default
    (and (< (+ marker 1) end) (== (call (. text byte-at) marker) markdown-dot) space-follows)
  )
  (where
    (lazy end (call (. text line-end) line))
    (lazy space-follows (call markdown-is-space (call (. text byte-at) (+ marker 1))))
    (lazy at (call markdown-skip-spaces text (call (. text line-start) line) end))
    (lazy byte (call (. text byte-at) at))
    (lazy digits (call markdown-skip-digits text at end))
    (lazy marker (if-expr (and (not allows-zeros) (== byte markdown-zero)) (+ at 1) digits))
  )
)

(fn-do _ markdown-is-divider Bool
  (param text CodeText)
  (param line Size)
  (let start (call (. text line-start) line))
  (let end (call (. text line-end) line))
  (return-if false (if (or (>= start end) (!= (call (. text byte-at) start) markdown-dash))))
  (let dashes Size 0)
  (let at start)
  (while (< at end)
    (let byte (call (. text byte-at) at))
    (if (== byte markdown-dash)
      (+= dashes 1)
      (else-if (not (call markdown-is-space byte))
        (return false)
      )
    )
    (+= at 1)
  )
  (return (>= dashes 3))
)

(fn-expr _ markdown-is-quote Bool
  (param text CodeText)
  (param line Size)
  (and (< start (call (. text line-end) line)) (== (call (. text byte-at) start) markdown-quote-mark))
  (where
    (lazy start (call (. text line-start) line))
  )
)

(fn-expr _ markdown-is-table-start Bool
  (param text CodeText)
  (param line Size)
  (and (call markdown-is-table-row text line) (< (+ line 1) (. text line-count)) delimited)
  (where
    (lazy delimited (call markdown-is-table-delimiter text (+ line 1)))
  )
)

(fn-do _ markdown-is-table-row Bool
  (param text CodeText)
  (param line Size)
  (let end (call (. text line-end) line))
  (let at (call (. text line-start) line))
  (if (and (< at end) (== (call (. text byte-at) at) markdown-pipe))
    (+= at 1)
  )
  (while (< at end)
    (let byte (call (. text byte-at) at))
    (if (== byte markdown-pipe)
      (return true)
    )
    (if (and (== byte markdown-backslash) (< (+ at 1) end) (== (call (. text byte-at) (+ at 1)) markdown-pipe))
      (+= at 2)
      (else-if (== byte markdown-backtick)
        (let close (call markdown-find-byte text (+ at 1) end markdown-backtick))
        (= at (if-expr (< close end) (+ close 1) (+ at 1)))
      )
      (else
        (+= at 1)
      )
    )
  )
  (return false)
)

(fn-do _ markdown-is-table-delimiter Bool
  (param text CodeText)
  (param line Size)
  (let end (call (. text line-end) line))
  (let at (call (. text line-start) line))
  (if (and (< at end) (== (call (. text byte-at) at) markdown-pipe))
    (+= at 1)
  )
  (let cell (call markdown-delimiter-cell-end text at end))
  (return-if false (if (== cell null)))
  (= at cell)
  (let cells Size 0)
  (while (and (< at end) (== (call (. text byte-at) at) markdown-pipe))
    (let next (call markdown-delimiter-cell-end text (+ at 1) end))
    (if (== next null)
      (break)
    )
    (= at next)
    (+= cells 1)
  )
  (return-if false (if (== cells 0)))
  (if (and (< at end) (== (call (. text byte-at) at) markdown-pipe))
    (+= at 1)
  )
  (return (== at end))
)

(fn-do _ markdown-delimiter-cell-end (? Size)
  (param text CodeText)
  (param start Size)
  (param end Size)
  (let at (call markdown-skip-spaces text start end))
  (if (and (< at end) (== (call (. text byte-at) at) markdown-colon))
    (let dashes (call markdown-skip-byte text (+ at 1) end markdown-dash))
    (case? (== dashes (+ at 1))
      (return null)
    )
    (case? (and (< dashes end) (== (call (. text byte-at) dashes) markdown-colon))
      (return (call markdown-skip-spaces text (+ dashes 1) end))
    )
    (default
      (return (call markdown-skip-spaces text dashes end))
    )
  )
  (let dashes (call markdown-skip-byte text at end markdown-dash))
  (case? (== dashes at)
    (return null)
  )
  (case? (and (< dashes end) (== (call (. text byte-at) dashes) markdown-colon))
    (return (call markdown-skip-spaces text (+ dashes 1) end))
  )
  (case? (< (- dashes at) 3)
    (return null)
  )
  (default
    (return (call markdown-skip-spaces text dashes end))
  )
)

(fn-expr _ markdown-is-space Bool
  (param byte Byte)
  (or (== byte code-space) (== byte code-tab))
)

(fn-do _ markdown-skip-spaces Size
  (param text CodeText)
  (param start Size)
  (param end Size)
  (let at start)
  (while (and (< at end) (call markdown-is-space (call (. text byte-at) at)))
    (+= at 1)
  )
  (return at)
)

(fn-do _ markdown-skip-digits Size
  (param text CodeText)
  (param start Size)
  (param end Size)
  (let at start)
  (while (and (< at end) (>= (call (. text byte-at) at) markdown-zero) (<= (call (. text byte-at) at) markdown-nine))
    (+= at 1)
  )
  (return at)
)

(fn-do _ markdown-skip-byte Size
  (param text CodeText)
  (param start Size)
  (param end Size)
  (param byte Byte)
  (let at start)
  (while (and (< at end) (== (call (. text byte-at) at) byte))
    (+= at 1)
  )
  (return at)
)

(fn-do _ markdown-find-byte Size
  (param text CodeText)
  (param start Size)
  (param end Size)
  (param byte Byte)
  (let at start)
  (while (and (< at end) (!= (call (. text byte-at) at) byte))
    (+= at 1)
  )
  (return at)
)
