    - language String

language == "stat"

━━━━━━━━━━━━━━━━━━━━
_ MarkdownBlockBuilder

+ base String
+ blocks [MarkdownBlock]

_ line Size
_ anchors = Map'String'Size()

────────────────────
+ This
    - base

────────────────────
+ do add
    - node Markdown
    - depth Size

do match node
    | document MDDocument
        for child in document.content
            add(child, depth)
    | header MDHeader
        line = header.line as Size
        . block = MarkdownBlock
            - blocks.length
            - MarkdownBlockKind.heading
            - header.level
            - depth
            - ""
            - runs(header.content)
        block.anchor = anchor-for(header)
        push(block)
    | paragraph MDParagraph
        line = paragraph.line as Size
        push
            - MarkdownBlock
                - blocks.length
                - MarkdownBlockKind.paragraph
                - 0
                - depth
                - ""
                - runs(paragraph.content)
    | divider MDDivider
        line = divider.line as Size
        push(MarkdownBlock(blocks.length, MarkdownBlockKind.divider, 0, depth))
    | list MDList
        add-list(list, depth)
    | quote MDBlockQuote
        line = quote.line as Size
        for child in quote.content
            add-quote(child, depth)
    | code MDFencedCode
        line = code.source-location.begin.line as Size
        . language = code.language.trim()
        . kind = if is-exhibit then MarkdownBlockKind.exhibit else MarkdownBlockKind.code
            .. is-exhibit = markdown-is-exhibit(language)
        . block = MarkdownBlock
            - blocks.length
            - kind
            - 0
            - depth
            - ""
            - List'MarkdownRun()
            - markdown-code-body(code.body)
            - language
        push(block)
    | table MDTable
        line = table.line as Size
        add-grid(table, depth)
    ??
        push(MarkdownBlock(blocks.length, MarkdownBlockKind.paragraph, 0, depth, "", runs([node])))

────────────────────
_ do push
    - block MarkdownBlock

block.line = line
blocks += block

────────────────────
_ do anchor-for String
    - header MDHeader

. slug = markdown-heading-slug(markdown-visible-text(header.content))
. count = (anchors[slug] ?? 0) + 1
anchors[slug] = count
= if count == 1 then slug else "${slug}-$count"

────────────────────
_ do add-list
    - list MDList
    - depth Size

. number = list.start
for child in list.children
    if | item MDListItem = child
        line = item.line as Size
        . marker = if list.ordered then "$number." else "•"
        push
            - MarkdownBlock
                - blocks.length
                - MarkdownBlockKind.item
                - 0
                - depth
                - marker
                - runs(item.content)
        for nested in item.child
            add-list(nested, depth + 1)
        number += 1

────────────────────
_ do add-quote
    - node Markdown
    - depth Size

if | paragraph MDParagraph = node
    line = paragraph.line as Size
    push
        - MarkdownBlock
            - blocks.length
            - MarkdownBlockKind.quote
            - 0
            - depth
            - ""
            - runs(paragraph.content)
else
    add(node, depth)

────────────────────
_ do add-grid
    - table MDTable
    - depth Size

. block = MarkdownBlock(blocks.length, MarkdownBlockKind.grid, 0, depth)
block.columns = table.header.cells.length
add-grid-row(block, table, table.header, true, !table.rows.length)
for index in 0 .. < table.rows.length
    add-grid-row(block, table, table.rows[index], false, index == table.rows.length - 1)
push(block)

────────────────────
_ do add-grid-row
    - block MarkdownBlock
    - table MDTable
    - row MDTableRow
    - is-header Bool
    - is-final-row Bool

for column in 0 .. < block.columns
    . content [MarkdownRun]
    if column < row.cells.length
        add-runs(content, row.cells[column].content, MarkdownRunStyle())
    block.cells += MarkdownGridCell
        - block.cells.length
        - content
        - markdown-grid-alignment(table.alignment(column))
        - is-header
        - is-final-row

────────────────────
_ do runs
    - nodes [Markdown]

. result [MarkdownRun]
add-runs(result, nodes, MarkdownRunStyle())
= markdown-referenced-runs(result, base)

────────────────────
_ do add-runs
    - result [MarkdownRun]
    - nodes [Markdown]
    - style MarkdownRunStyle

for node in nodes
    do match node
        | text MDText
            if text.is-break
                result += MarkdownRun
                    - result.length
                    - text.text
                    - false
                    - false
                    - false
                    - null
                    - null
                    - true
            else
                add-run(result, text.text, style)
        | strong MDStrong
            add-runs
                - result
                - strong.content
                - MarkdownRunStyle(true, style.is-em, false, style.url, style.is-image)
        | em MDEm
            add-runs
                - result
                - em.content
                - MarkdownRunStyle(style.is-strong, true, false, style.url, style.is-image)
        | link MDLink
            add-runs
                - result
                - link.content
                - MarkdownRunStyle(style.is-strong, style.is-em, false, link.url)
        | image MDImage
            add-runs
                - result
                - image.content
                - MarkdownRunStyle(style.is-strong, style.is-em, false, image.url, true)
        | code MDInlineCode
            add-run
                - result
                - code.code
                - MarkdownRunStyle(style.is-strong, style.is-em, true, style.url, style.is-image, code.language)
        ??
            add-run(result, "$node", style)

────────────────────
_ do add-run
    - result [MarkdownRun]
    - text String
    - style MarkdownRunStyle

=? if !text.length
if | [..., last] = result
    if !last.is-break && !style.language.size && markdown-run-style(last) == style
        result[result.length - 1] = MarkdownRun
            - last.index
            - "${last.text}$text"
            - last.is-strong
            - last.is-em
            - last.is-code
            - last.url
            - null
            - false
            - last.is-image
        =
result += MarkdownRun
    - result.length
    - text
    - style.is-strong
    - style.is-em
    - style.is-code
    - style.url
    - null
    - false
    - style.is-image
    - style.language

━━━━━━━━━━━━━━━━━━━━
_ MarkdownRunStyle is Tuple

+ is-strong Bool
+ is-em Bool
+ is-code Bool
+ url String? = null
+ is-image = false
+ language = ""

━━━━━━━━━━━━━━━━━━━━
_ do markdown-referenced-runs [MarkdownRun]
    - runs [MarkdownRun]
    - base String

. result [MarkdownRun]
for run in runs
    if run.url != null
        result += markdown-run-piece(result, run, run.text, markdown-url-reference(run.url, base))
    else if run.is-code
        result += markdown-run-piece(result, run, run.text, markdown-code-reference(run.text))
    else
        . last Index = 0
        for span in markdown-text-references(run.text)
            if span.start > last
                result += markdown-run-piece(result, run, run.text[last .. < span.start], null)
            result += markdown-run-piece
                - result
                - run
                - run.text[span.start .. < span.end]
                - span.reference
            last = span.end
        if last == 0
            result += markdown-run-piece(result, run, run.text, null)
        else if last < run.text.length
            result += markdown-run-piece(result, run, run.text[last ...], null)
= result

━━━━━━━━━━━━━━━━━━━━
_ markdown-run-piece MarkdownRun
    - result [MarkdownRun]
    - run MarkdownRun
    - text String
    - reference MarkdownReference?

MarkdownRun
    - result.length
    - text
    - run.is-strong
    - run.is-em
    - run.is-code
    - run.url
    - reference
    - run.is-break
    - run.is-image
    - run.language

━━━━━━━━━━━━━━━━━━━━
_ markdown-run-style
    - run MarkdownRun

MarkdownRunStyle(run.is-strong, run.is-em, run.is-code, run.url, run.is-image, run.language)

━━━━━━━━━━━━━━━━━━━━
_ markdown-grid-alignment
    - alignment MDTableAlignment

match alignment
    | MDTableAlignment.center
        TextAlignment.center
    | MDTableAlignment.right
        TextAlignment.right
    ??
        TextAlignment.left

━━━━━━━━━━━━━━━━━━━━
_ markdown-code-body
    - body String

|? body.ends-with("\n")
    body[0 .. < body.length - 1]
??
    body
