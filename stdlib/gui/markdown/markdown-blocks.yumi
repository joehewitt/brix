━━━━━━━━━━━━━━━━━━━━
+ markdown-is-rendered Bool
    - block MarkdownBlock

block.kind == MarkdownBlockKind.code && block.rendering != null && !block.shows-source

━━━━━━━━━━━━━━━━━━━━
+ do markdown-render-block
    - renderer MarkdownCodeRenderer?
    - block MarkdownBlock

=? if !renderer
if block.kind != MarkdownBlockKind.code
    markdown-render-runs(renderer, block)
    =
=? if block.shows-source || block.rendering != null || !renderer.renders(block.language)
. lines = catch renderer.render(block.code, block.language)
if lines is Error
    block.render-error = "$lines"
    block.shows-source = true
    =
block.rendering = lines as [MarkdownCodeLine]

━━━━━━━━━━━━━━━━━━━━
_ do markdown-render-runs
    - renderer MarkdownCodeRenderer
    - block MarkdownBlock

=? if block.renders-runs
block.renders-runs = true
=? if !markdown-runs-tagged(block.runs) && !(some(block.cells) • where markdown-runs-tagged(each.runs))
block.runs = markdown-rendered-runs(renderer, block.runs)
. cells [MarkdownGridCell]
for cell in block.cells
    cells += MarkdownGridCell
        - cell.index
        - markdown-rendered-runs(renderer, cell.runs)
        - cell.alignment
        - cell.is-header
        - cell.is-final-row
block.cells = cells

━━━━━━━━━━━━━━━━━━━━
_ markdown-runs-tagged Bool
    - runs [MarkdownRun]

some(runs) • where each.language.size > 0 && each.rendering == null

━━━━━━━━━━━━━━━━━━━━
_ do markdown-rendered-runs [MarkdownRun]
    - renderer MarkdownCodeRenderer
    - runs [MarkdownRun]

. result [MarkdownRun]
for run in runs
    . rendered = markdown-rendered-run(renderer, run)
    result += rendered ?? run
= result

━━━━━━━━━━━━━━━━━━━━
_ do markdown-rendered-run MarkdownRun?
    - renderer MarkdownCodeRenderer
    - run MarkdownRun

=? null if !run.is-code || !run.language.size || run.rendering != null || !renderer.renders-inline(run.language)
. pieces = catch renderer.render-inline(run.text, run.language)
=? null if pieces is Error
. rendering = pieces as [SyntaxStyledRun]
. text = "".join(each.text in rendering)
=? null if !text.size
= MarkdownRun
    - run.index
    - text
    - run.is-strong
    - run.is-em
    - true
    - run.url
    - null
    - false
    - run.is-image
    - run.language
    - run.text
    - rendering

━━━━━━━━━━━━━━━━━━━━
+ do markdown-toggle-source
    - renderer MarkdownCodeRenderer?
    - block MarkdownBlock
    - shows Bool

block.render-error = null
block.shows-source = shows
if !shows
    markdown-render-block(renderer, block)

━━━━━━━━━━━━━━━━━━━━
+ do markdown-carry-source
    - old MarkdownBlock
    - next MarkdownBlock

if old.shows-source && old.kind == next.kind && old.language == next.language
    next.shows-source = true

