+ MarkdownBlockCache

_ source String?
_ based String?
_ blocks [MarkdownBlock]

────────────────────
+ get is-filled

source != null

────────────────────
+ do blocks-for [MarkdownBlock]
    - text String
    - base = ""

if source == null || source != text || based != base
    blocks = markdown-blocks(text, base)
    source = text
    based = base
= blocks

━━━━━━━━━━━━━━━━━━━━
+ do markdown-blocks [MarkdownBlock]
    - source String
    - base = ""

. builder = MarkdownBlockBuilder(base)
builder.add(Markdown(source), 0)
= builder.blocks

━━━━━━━━━━━━━━━━━━━━
