(import ./markdown-blocks)
(import /graphics/text)
(import /math)

(type + MarkdownMarks (is Tuple)
  (prop + is-strong _ (= false))
  (prop + is-em _ (= false))
  (prop + is-code _ (= false))
  (prop + url (? String) (= null))
  (prop + is-image _ (= false))
  (prop + language _ (= ""))
)

(type + MarkdownMark (is Union)
  (variant strong)
  (variant em)
  (variant code)
)

(type + MarkdownDraft
  (prop + kind MarkdownBlockKind)
  (prop + level Size (= 0))
  (prop + prefix String)
  (prop + runs (list MarkdownRun))
  (prop + code String)
  (prop + language String)
  (prop + columns Size (= 0))
  (prop + cells (list (list MarkdownRun)))
  (prop + alignments (list TextAlignment))
  (prop + rows (list (? String)))
  (prop + delimiter (? String))
  (prop + source (? String))
  (fn-do + This _
    (param kind _)
    (param runs (list MarkdownRun) (= (call (of List MarkdownRun))))
  )
  (fn-expr + is-empty _ :get
    (and (== kind (. MarkdownBlockKind paragraph)) (not (. runs length)))
  )
  (fn-expr + is-prose _ :get
    (or (== kind (. MarkdownBlockKind paragraph)) (== kind (. MarkdownBlockKind heading)) is-flow)
  )
  (fn-expr + is-flow _ :get
    (or (== kind (. MarkdownBlockKind item)) (== kind (. MarkdownBlockKind quote)))
  )
  (fn-expr + row-count Size :get
    (if-expr (> columns 0) (/ (. cells length) columns) 0)
  )
  (fn-do + copy MarkdownDraft
    (let result (call MarkdownDraft kind runs))
    (= (. result level) level)
    (= (. result prefix) prefix)
    (= (. result code) code)
    (= (. result language) language)
    (= (. result columns) columns)
    (for (in cell cells)
      (+= (. result cells) cell)
    )
    (for (in alignment alignments)
      (+= (. result alignments) alignment)
    )
    (for (in row rows)
      (+= (. result rows) row)
    )
    (= (. result delimiter) delimiter)
    (= (. result source) source)
    (return result)
  )
)

(fn-do + markdown-block-draft MarkdownDraft
  (param block MarkdownBlock)
  (param prefix String)
  (let draft (call MarkdownDraft (. block kind) (call markdown-runs-normalized (. block runs))))
  (= (. draft level) (. block level))
  (= (. draft prefix) prefix)
  (= (. draft code) (. block code))
  (= (. draft language) (. block language))
  (= (. draft columns) (. block columns))
  (if (and (== (. block kind) (. MarkdownBlockKind item)) (not (. prefix size)))
    (= (. draft prefix) (str (* "  " (. block depth)) (if-expr (== (. block marker) "•") "-" (. block marker)) " "))
  )
  (for (in cell (. block cells))
    (+= (. draft cells) (call markdown-runs-normalized (. cell runs)))
    (if (. cell is-header)
      (+= (. draft alignments) (. cell alignment))
    )
  )
  (return draft)
)

(fn-expr + markdown-run-marks MarkdownMarks
  (param run MarkdownRun)
  (call MarkdownMarks (. run is-strong) (. run is-em) (. run is-code) (. run url) (. run is-image) (. run language))
)

(fn-expr + markdown-marked-run MarkdownRun
  (param text String)
  (param marks MarkdownMarks)
  (call MarkdownRun
    (block
      (arg 0)
      (arg text)
      (arg (. marks is-strong))
      (arg (. marks is-em))
      (arg (. marks is-code))
      (arg (. marks url))
      (arg null)
      (arg false)
      (arg (. marks is-image))
      (arg (if-expr (. marks is-code) (. marks language) ""))
    )
  )
)

(fn-expr + markdown-remarked-run MarkdownRun
  (param run MarkdownRun)
  (param marks MarkdownMarks)
  (case? (. run is-rendered)
    (call MarkdownRun
      (block
        (arg 0)
        (arg (. run text))
        (arg (. marks is-strong))
        (arg (. marks is-em))
        (arg true)
        (arg (. marks url))
        (arg null)
        (arg false)
        (arg (. marks is-image))
        (arg (. run language))
        (arg (. run source))
        (arg (. run rendering))
      )
    )
  )
  (default
    (call markdown-marked-run (. run text) marks)
  )
)

(fn-expr + markdown-runs-text String
  (param runs (list MarkdownRun))
  (call (. "" join) (in (. each text) runs))
)

(fn-expr + markdown-slice String
  (param text String)
  (param start Size)
  (param end Size)
  (if-expr (> end start) (call (. (call byte-view text) slice-string) (..< start end)) "")
)

(fn-do + markdown-runs-normalized (list MarkdownRun)
  (param runs (list MarkdownRun))
  (let result (list MarkdownRun))
  (for (in run runs)
    (let count (. result length))
    (if (. run is-break)
      (+= result (call MarkdownRun count " " false false false null null true))
      (else-if (. run is-rendered)
        (+= result (call markdown-remarked-run run (call markdown-run-marks run)))
      )
      (else-if (> (. run text size) 0)
        (let marks (call markdown-run-marks run))
        (if (and (> count 0) joins)
          (= ([] result (- count 1)) (call markdown-marked-run (str (. ([] result (- count 1)) text) (. run text)) marks))
          (else
            (+= result (call markdown-marked-run (. run text) marks))
          )
        )
        (lazy joins
          (block
            (and (not (. previous is-break)) (not (. previous is-rendered)) (== (call markdown-run-marks previous) marks))
          )
        )
        (lazy previous ([] result (- count 1)))
      )
    )
  )
  (return result)
)

(fn-do + markdown-runs-slice (list MarkdownRun)
  (param runs (list MarkdownRun))
  (param start Size)
  (param end Size)
  (let result (list MarkdownRun))
  (let at Size 0)
  (for (in run runs)
    (let size (. run text size))
    (let low (call max start at))
    (let high (call min end (+ at size)))
    (if (. run is-rendered)
      (+=? result (only-if run (if (and (>= at start) (< at end)))))
      (else-if (> high low)
        (if (. run is-break)
          (+= result run)
          (else
            (+= result
              (call markdown-marked-run
                (block
                  (arg (call markdown-slice (. run text) (- low at) (- high at)))
                  (arg (call markdown-run-marks run))
                )
              )
            )
          )
        )
      )
    )
    (+= at size)
  )
  (return (call markdown-runs-normalized result))
)

(fn-do + markdown-runs-snap Size
  (param runs (list MarkdownRun))
  (param offset Size)
  (param forward (? Bool))
  (let at Size 0)
  (for (in run runs)
    (return-if offset (if (<= offset at)))
    (let end (+ at (. run text size)))
    (if (and (. run is-rendered) (< offset end))
      (return (if-expr (?? forward (>= (- offset at) (- end offset))) end at))
    )
    (= at end)
  )
  (return offset)
)

(fn-expr + markdown-runs-source-text String
  (param runs (list MarkdownRun))
  (call (. "" join) (in (?? (. each source) (. each text)) runs))
)

(fn-do + markdown-runs-source-offset Size
  (param runs (list MarkdownRun))
  (param offset Size)
  (let shown Size 0)
  (let source Size 0)
  (for (in run runs)
    (let size (. run text size))
    (let from (if-expr (. run is-rendered) (. (?? (. run source) (. run text)) size) size))
    (if (<= offset (+ shown size))
      (return-if (+ source from) (if (and (. run is-rendered) (> offset shown))))
      (return (- (+ source offset) shown))
    )
    (+= shown size)
    (+= source from)
  )
  (return (- (+ source offset) shown))
)

(fn-do + markdown-runs-shown-offset Size
  (param runs (list MarkdownRun))
  (param offset Size)
  (let shown Size 0)
  (let source Size 0)
  (for (in run runs)
    (let size (. run text size))
    (let from (if-expr (. run is-rendered) (. (?? (. run source) (. run text)) size) size))
    (if (<= offset (+ source from))
      (return-if (+ shown size) (if (and (. run is-rendered) (> offset source))))
      (return (- (+ shown offset) source))
    )
    (+= shown size)
    (+= source from)
  )
  (return (- (+ shown offset) source))
)

(fn-do + markdown-runs-join (list MarkdownRun)
  (param first (list MarkdownRun))
  (param second (list MarkdownRun))
  (let result (list MarkdownRun))
  (for (in run first)
    (+= result run)
  )
  (for (in run second)
    (+= result run)
  )
  (return (call markdown-runs-normalized result))
)

(fn-do + markdown-runs-insert (list MarkdownRun)
  (param runs (list MarkdownRun))
  (param offset Size)
  (param text String)
  (param marks MarkdownMarks)
  (let size (. (call markdown-runs-text runs) size))
  (let head (call markdown-runs-slice runs 0 offset))
  (+= head (call markdown-marked-run text marks))
  (return (call markdown-runs-join head (call markdown-runs-slice runs offset size)))
)

(fn-expr + markdown-runs-delete (list MarkdownRun)
  (param runs (list MarkdownRun))
  (param start Size)
  (param end Size)
  (call markdown-runs-join (call markdown-runs-slice runs 0 start) (call markdown-runs-slice runs end size))
  (where
    (lazy size (. (call markdown-runs-text runs) size))
  )
)

(fn-do + markdown-runs-marks-at MarkdownMarks
  (param runs (list MarkdownRun))
  (param offset Size)
  (let at Size 0)
  (let before (? MarkdownMarks) null)
  (let after (? MarkdownMarks) null)
  (let inside false)
  (for (in run runs)
    (let end (+ at (. run text size)))
    (if (and (< at offset) (<= offset end))
      (= before (if-expr (. run is-break) null (call markdown-typing-marks run)))
      (= inside (< offset end))
    )
    (if (and (== after null) (>= at offset) (not (. run is-break)))
      (= after (call markdown-typing-marks run))
    )
    (= at end)
  )
  (let found (?? before after (call MarkdownMarks)))
  (return-if found (if inside))
  (return (call MarkdownMarks (. found is-strong) (. found is-em) (. found is-code) null false (. found language)))
)

(fn-expr _ markdown-typing-marks MarkdownMarks
  (param run MarkdownRun)
  (if-expr (. run is-rendered) (call MarkdownMarks (. run is-strong) (. run is-em)) (call markdown-run-marks run))
)

(fn-do + markdown-runs-toggle (list MarkdownRun)
  (param runs (list MarkdownRun))
  (param start Size)
  (param end Size)
  (param mark MarkdownMark)
  (let size (. (call markdown-runs-text runs) size))
  (let sliced (call markdown-runs-slice runs start end))
  (let has true)
  (for (in run sliced)
    (if (and (not (. run is-break)) (not (call markdown-marks-has (call markdown-run-marks run) mark)))
      (= has false)
    )
  )
  (let middle (list MarkdownRun))
  (for (in run sliced)
    (if (. run is-break)
      (+= middle run)
      (else
        (+= middle
          (call markdown-remarked-run
            (block
              (arg run)
              (arg (call markdown-marks-with (call markdown-run-marks run) mark (not has)))
            )
          )
        )
      )
    )
  )
  (return
    (call markdown-runs-join
      (block
        (arg (call markdown-runs-join (call markdown-runs-slice runs 0 start) middle))
        (arg (call markdown-runs-slice runs end size))
      )
    )
  )
)

(fn-expr + markdown-marks-has Bool
  (param marks MarkdownMarks)
  (param mark MarkdownMark)
  (match mark
    (case .strong
      (. marks is-strong)
    )
    (case .em
      (. marks is-em)
    )
    (case .code
      (. marks is-code)
    )
  )
)

(fn-expr + markdown-marks-with MarkdownMarks
  (param marks MarkdownMarks)
  (param mark MarkdownMark)
  (param on Bool)
  (match mark
    (case .strong
      (call MarkdownMarks on (. marks is-em) (. marks is-code) (. marks url) (. marks is-image) (. marks language))
    )
    (case .em
      (call MarkdownMarks (. marks is-strong) on (. marks is-code) (. marks url) (. marks is-image) (. marks language))
    )
    (case .code
      (call MarkdownMarks
        (block
          (arg (. marks is-strong))
          (arg (. marks is-em))
          (arg on)
          (arg (. marks url))
          (arg (. marks is-image))
          (arg (if-expr on (. marks language) ""))
        )
      )
    )
  )
)

(fn-expr + markdown-draft-source String
  (param draft MarkdownDraft)
  (case? (!= original null)
    original
  )
  (case? (== kind (. MarkdownBlockKind paragraph))
    (call markdown-inline-source (. draft runs) "" false true)
  )
  (case? (== kind (. MarkdownBlockKind heading))
    (str heading-prefix (call markdown-inline-source (. draft runs) "" false false))
    (lazy heading-prefix (call markdown-heading-prefix (. draft prefix) (. draft level)))
  )
  (case? (== kind (. MarkdownBlockKind item))
    (str (. draft prefix) (call markdown-inline-source (. draft runs) "" false false))
  )
  (case? (== kind (. MarkdownBlockKind quote))
    (str prefix (call markdown-inline-source (. draft runs) "> " false false))
    (blank)
    (lazy prefix (if-expr (> (. draft prefix size) 0) (. draft prefix) "> "))
  )
  (case? (or (== kind (. MarkdownBlockKind code)) (== kind (. MarkdownBlockKind exhibit)))
    (call markdown-code-source (. draft code) (. draft language))
  )
  (case? (== kind (. MarkdownBlockKind divider))
    "---"
  )
  (case? (== kind (. MarkdownBlockKind grid))
    (call markdown-grid-source draft)
  )
  (default
    ""
  )
  (where
    (lazy kind (. draft kind))
    (lazy original (. draft source))
  )
)

(fn-do + markdown-code-source String
  (param code String)
  (param language String)
  (let fence "```")
  (while (!= (call (. code find) fence) null)
    (= fence (str fence "`"))
  )
  (return-if (str fence language "\n" fence) (if (not (. code size))))
  (return (str fence language "\n" code "\n" fence))
)

(fn-do + markdown-grid-source String
  (param draft MarkdownDraft)
  (let lines (list String))
  (for (in row (..< 0 (. draft row-count)))
    (let original (only-if ([] (. draft rows) row) (if (< row (. draft rows length)))))
    (+= lines (?? original (call markdown-grid-row-source draft row)))
    (if (== row 0)
      (+= lines (?? (. draft delimiter) (call markdown-grid-delimiter (. draft alignments) (. draft columns))))
    )
  )
  (return (call (. "\n" join) lines))
)

(fn-do + markdown-grid-row-source String
  (param draft MarkdownDraft)
  (param row Size)
  (let cells (list String))
  (for (in column (..< 0 (. draft columns)))
    (+= cells (call markdown-inline-source ([] (. draft cells) (+ (* row (. draft columns)) column)) "" true false))
  )
  (return (str "| " (call (. " | " join) cells) " |"))
)

(fn-do + markdown-grid-delimiter String
  (param alignments (list TextAlignment))
  (param columns Size)
  (let cells (list String))
  (for (in column (..< 0 columns))
    (let alignment (if-expr (< column (. alignments length)) ([] alignments column) (. TextAlignment left)))
    (if (== alignment (. TextAlignment center))
      (+= cells ":---:")
      (else-if (== alignment (. TextAlignment right))
        (+= cells "---:")
      )
      (else
        (+= cells "---")
      )
    )
  )
  (return (str "| " (call (. " | " join) cells) " |"))
)

(fn-do + markdown-inline-source String
  (param runs (list MarkdownRun))
  (param break-prefix String)
  (param in-table Bool)
  (param line-start Bool)
  (let writer (call MarkdownInlineWriter in-table line-start))
  (let normalized (call markdown-runs-normalized runs))
  (for (in index (..< 0 (. normalized length)))
    (let run ([] normalized index))
    (if (. run is-break)
      (call (. writer close-to) 0)
      (+= (. writer parts) (str "\n" break-prefix))
      (= (. writer at-line-start) line-start)
      (else-if (. run is-rendered)
        (call (. writer close-to) 3)
        (call (. writer open) (call markdown-run-marks run))
        (call (. writer text) (?? (. run source) (. run text)) false)
        (call (. writer close-to) 3)
      )
      (else
        (let next (only-if (. ([] normalized (+ index 1)) url) (if (< (+ index 1) (. normalized length)))))
        (call (. writer open) (call markdown-run-marks run))
        (call (. writer text) (. run text) (and (!= next null) (!= next (. run url))))
      )
    )
  )
  (call (. writer close-to) 0)
  (return (call (. "" join) (. writer parts)))
)

(fn-do + markdown-escaped String
  (param text String)
  (param in-table Bool)
  (param line-start Bool)
  (param links-next _ (= false))
  (let bytes (call byte-view text))
  (let parts (list String))
  (let last Size 0)
  (let guarded (only-if (call markdown-line-start-guard bytes) (if line-start)))
  (for (in index (..< 0 (. bytes size)))
    (let byte ([] bytes index))
    (let special (or (== byte 92) (== byte 42) (== byte 91) (== byte 93) (== byte 96)))
    (let bang (and (== byte 33) (if-expr (< (+ index 1) (. bytes size)) (== ([] bytes (+ index 1)) 91) links-next)))
    (let pipe (and in-table (== byte 124)))
    (if (or special bang pipe (== guarded index))
      (+= parts (call markdown-slice text last index))
      (+= parts "\\")
      (= last index)
    )
  )
  (+= parts (call markdown-slice text last (. bytes size)))
  (return (call (. "" join) parts))
)

(fn-do + markdown-line-prefix String
  (param line String)
  (param kind MarkdownBlockKind)
  (let bytes (call byte-view line))
  (let index Size 0)
  (if (== kind (. MarkdownBlockKind heading))
    (while (and (< index (. bytes size)) (== ([] bytes index) 35))
      (+= index 1)
    )
    (else-if (== kind (. MarkdownBlockKind quote))
      (return-if "" (if (or (not (. bytes size)) (!= ([] bytes 0) 62))))
      (= index 1)
    )
    (else-if (== kind (. MarkdownBlockKind item))
      (while (and (< index (. bytes size)) (== ([] bytes index) 32))
        (+= index 1)
      )
      (while (and (< index (. bytes size)) (>= ([] bytes index) 48) (<= ([] bytes index) 57))
        (+= index 1)
      )
      (if (and (< index (. bytes size)) (or (== ([] bytes index) 45) (== ([] bytes index) 42) plus-or-dot))
        (+= index 1)
      )
      (lazy plus-or-dot (or (== ([] bytes index) 43) (== ([] bytes index) 46)))
    )
    (else
      (return "")
    )
  )
  (while (and (< index (. bytes size)) (== ([] bytes index) 32))
    (+= index 1)
  )
  (return (call markdown-slice line 0 index))
)

(fn-do + markdown-next-item-prefix String
  (param prefix String)
  (let bytes (call byte-view prefix))
  (let index Size 0)
  (while (and (< index (. bytes size)) (== ([] bytes index) 32))
    (+= index 1)
  )
  (let digits index)
  (let number Size 0)
  (while (and (< digits (. bytes size)) (>= ([] bytes digits) 48) (<= ([] bytes digits) 57))
    (= number (+ (* number 10) (- ([] bytes digits) 48)))
    (+= digits 1)
  )
  (return-if prefix (if (== digits index)))
  (return (str (call markdown-slice prefix 0 index) (+ number 1) (call markdown-slice prefix digits (. bytes size))))
)

(fn-do + markdown-table-cell-starts (list Size)
  (param line String)
  (let bytes (call byte-view line))
  (let starts (list Size))
  (let index Size 0)
  (while (and (< index (. bytes size)) (== ([] bytes index) 32))
    (+= index 1)
  )
  (if (and (< index (. bytes size)) (== ([] bytes index) 124))
    (+= index 1)
  )
  (let at index)
  (while (<= at (. bytes size))
    (let start at)
    (while (and (< start (. bytes size)) (== ([] bytes start) 32))
      (+= start 1)
    )
    (+= starts start)
    (let cursor start)
    (let ticked false)
    (while (and (< cursor (. bytes size)) (or (!= ([] bytes cursor) 124) ticked))
      (if (and (== ([] bytes cursor) 92) (< (+ cursor 1) (. bytes size)))
        (+= cursor 1)
        (else-if (== ([] bytes cursor) 96)
          (= ticked (not ticked))
        )
      )
      (+= cursor 1)
    )
    (return-if starts (if (>= cursor (. bytes size))))
    (= at (+ cursor 1))
  )
  (return starts)
)

(fn-do + markdown-source-offset Size
  (param source String)
  (param visible String)
  (param offset Size)
  (let from (call byte-view source))
  (let shown (call byte-view visible))
  (let cursor Size 0)
  (let count (call min offset (. shown size)))
  (for (in index (..< 0 count))
    (let at (call markdown-byte-match from cursor ([] shown index)))
    (if (!= at null)
      (= cursor (+ at 1))
    )
  )
  (if (< count (. shown size))
    (let next (call markdown-byte-match from cursor ([] shown count)))
    (return-if next (if (!= next null)))
  )
  (return cursor)
)

(fn-do + markdown-visible-offset Size
  (param source String)
  (param visible String)
  (param offset Size)
  (let from (call byte-view source))
  (let shown (call byte-view visible))
  (let cursor Size 0)
  (let count Size 0)
  (for (in index (..< 0 (. shown size)))
    (let at (call markdown-byte-match from cursor ([] shown index)))
    (if (or (== at null) (>= at offset))
      (break)
    )
    (= cursor (+ at 1))
    (= count (+ index 1))
  )
  (return count)
)

(type _ MarkdownInlineWriter
  (prop + parts (list String))
  (prop + at-line-start Bool)
  (prop + in-table Bool)
  (blank)
  (prop _ url (? String))
  (prop _ image _ (= false))
  (prop _ linked _ (= false))
  (prop _ strong _ (= false))
  (prop _ em _ (= false))
  (prop _ code _ (= false))
  (prop _ language _ (= ""))
  (fn-do + This _
    (param in-table _)
    (param at-line-start _)
  )
  (fn-do + open _
    (param marks MarkdownMarks)
    (let wants-link (!= (. marks url) null))
    (let same-link (and (== linked wants-link) (or (not linked) (and (== url (. marks url)) (== image (. marks is-image))))))
    (if (not same-link)
      (call close-to 0)
      (else-if (!= strong (. marks is-strong))
        (call close-to 1)
      )
      (else-if (!= em (. marks is-em))
        (call close-to 2)
      )
      (else-if (or (!= code (. marks is-code)) (!= language (. marks language)))
        (call close-to 3)
      )
    )
    (if (and (not linked) wants-link)
      (+= parts (if-expr (. marks is-image) "![" "["))
      (= linked true)
      (= url (. marks url))
      (= image (. marks is-image))
    )
    (if (and (not strong) (. marks is-strong))
      (+= parts "**")
      (= strong true)
    )
    (if (and (not em) (. marks is-em))
      (+= parts "*")
      (= em true)
    )
    (if (and (not code) (. marks is-code))
      (+= parts "`")
      (= code true)
      (= language (. marks language))
    )
  )
  (fn-do + close-to _
    (param level Size)
    (if (and code (<= level 3))
      (+= parts "`")
      (+=? parts (only-if (str "{." language "}") (if (> (. language size) 0))))
      (= code false)
      (= language "")
    )
    (if (and em (<= level 2))
      (+= parts "*")
      (= em false)
    )
    (if (and strong (<= level 1))
      (+= parts "**")
      (= strong false)
    )
    (if (and linked (== level 0))
      (+= parts (str "](" (call markdown-url-escaped (?? url "")) ")"))
      (= linked false)
      (= url null)
      (= image false)
    )
  )
  (fn-do + text _
    (param text String)
    (param links-next Bool)
    (if code
      (+= parts (if-expr in-table (call (. "\\|" join) (call (. text split) "|")) text))
      (= at-line-start false)
      (return)
    )
    (let plain (and (not linked) (not strong) (not em)))
    (+= parts (call markdown-escaped text in-table (and at-line-start plain) links-next))
    (= at-line-start false)
  )
)

(fn-expr _ markdown-heading-prefix String
  (param prefix String)
  (param level Size)
  (case? (and (> (. prefix size) level) (== (call (. prefix trim)) (* "#" level)))
    prefix
  )
  (default
    (str (* "#" level) " ")
  )
)

(fn-do _ markdown-line-start-guard (? Size)
  (param bytes (of ImmutableArray Byte))
  (return-if null (if (not (. bytes size))))
  (let lead ([] bytes 0))
  (if (== lead 35)
    (let count Size 0)
    (while (and (< count (. bytes size)) (== ([] bytes count) 35))
      (+= count 1)
    )
    (return-if 0 (if (and (<= count 6) (or (== count (. bytes size)) (== ([] bytes count) 32)))))
    (return null)
  )
  (return-if 0 (if (== lead 62)))
  (if (== lead 45)
    (let dashes Size 0)
    (let other false)
    (for (in byte bytes)
      (if (== byte 45)
        (+= dashes 1)
        (else-if (!= byte 32)
          (= other true)
        )
      )
    )
    (return-if 0 (if (and (not other) (>= dashes 3))))
  )
  (let index Size 0)
  (while (and (< index (. bytes size)) (== ([] bytes index) 32))
    (+= index 1)
  )
  (return-if null (if (>= index (. bytes size))))
  (let marker ([] bytes index))
  (return-if index (if (and (or (== marker 45) (== marker 43)) (or (== (+ index 1) (. bytes size)) (== ([] bytes (+ index 1)) 32)))))
  (let digits index)
  (while (and (< digits (. bytes size)) (>= ([] bytes digits) 48) (<= ([] bytes digits) 57))
    (+= digits 1)
  )
  (return-if digits (if (and (> digits index) (< (+ digits 1) (. bytes size)) dot-space)))
  (lazy dot-space (and (== ([] bytes digits) 46) (== ([] bytes (+ digits 1)) 32)))
  (return null)
)

(fn-expr _ markdown-url-escaped String
  (param url String)
  (call (. "\\)" join) (call (. url split) ")"))
)

(fn-do _ markdown-byte-match (? Size)
  (param bytes (of ImmutableArray Byte))
  (param start Size)
  (param wanted Byte)
  (let at start)
  (while (< at (. bytes size))
    (let found ([] bytes at))
    (return-if at (if (or (== found wanted) (and (call markdown-is-space found) (call markdown-is-space wanted)))))
    (+= at 1)
  )
  (return null)
)

(fn-expr _ markdown-is-space Bool
  (param byte Byte)
  (or (== byte 32) (== byte 10) (== byte 9) (== byte 13))
)
