(import ./markdown-blocks)
(import ./markdown-outline)
(import ./markdown-source)
(import /code)
(import /math)

(type + MarkdownModelChange (is Tuple)
  (prop + is-rebuilt Bool)
  (prop + at Size)
  (prop + removed Size)
  (prop + added Size)
)

(type + MarkdownModel
  (prop + blocks (list MarkdownBlock))
  (prop + starts (list Size))
  (prop + ends (list Size))
  (prop + prefixes (list String))
  (prop + sources (list String))
  (blank)
  (prop _ outline _ (= (call MarkdownOutline)))
  (prop _ damage _ (= (call CodeTextDamage)))
  (prop _ text (? CodeText))
  (prop _ base _ (= ""))
  (fn-do + sync (? MarkdownModelChange)
    (param next CodeText)
    (param next-base String)
    (let current text)
    (if (or (not current) (!= (as current Pointer) (as next Pointer)) (!= base next-base))
      (if current
        (call (. current untrack) damage)
      )
      (call (. next track) damage)
      (= text next)
      (= base next-base)
      (call build next)
      (return (call MarkdownModelChange true 0 0 0))
    )
    (return-if null (if (not (. damage is-damaged))))
    (return (call update next))
  )
  (fn-do + detach _
    (let current text)
    (if current
      (call (. current untrack) damage)
    )
    (= text null)
  )
  (fn-do + block-at-offset Size
    (param offset Size)
    (let low Size 0)
    (let high (. starts length))
    (while (< low high)
      (let middle (+ low (/ (- high low) 2)))
      (if (<= ([] starts middle) offset)
        (= low (+ middle 1))
        (else
          (= high middle)
        )
      )
    )
    (return (if-expr (> low 0) (- low 1) 0))
  )
  (fn-expr + is-empty-block Bool
    (param index Size)
    (and (== ([] starts index) ([] ends index)) (== (. ([] blocks index) kind) (. MarkdownBlockKind paragraph)))
  )
  (fn-do _ build _
    (param next CodeText)
    (call (. damage clear))
    (call (. outline scan) next)
    (let builder (call MarkdownModelBuilder (call (of Map String MarkdownBlock))))
    (call finish builder next (call generate builder next 0 (. outline starts length) null false) null)
    (if (not (. builder blocks length))
      (call (. builder push-empty) 0 0)
    )
    (= blocks (. builder blocks))
    (= starts (. builder starts))
    (= ends (. builder ends))
    (= prefixes (. builder prefixes))
    (= sources (. builder sources))
  )
  (fn-do _ update MarkdownModelChange
    (param next CodeText)
    (let edit (call (. outline update) next damage))
    (let line-delta (. damage line-delta))
    (let byte-delta (. damage byte-delta))
    (call (. damage clear))
    (let first (call block-at-line (. edit start-line)))
    (let old-end-line (. edit old-end-line))
    (let last (if-expr (!= old-end-line null) (call block-at-line old-end-line) (. blocks length)))
    (let previous (? Size) null)
    (let back first)
    (while (and (> back 0) (== previous null))
      (-= back 1)
      (if (not (call is-empty-block back))
        (= previous (+ (call (. next line-at) ([] ends back)) 1))
      )
    )
    (let reuse (call (of Map String MarkdownBlock)))
    (let index first)
    (while (< index last)
      (= ([] reuse ([] sources index)) ([] blocks index))
      (+= index 1)
    )
    (let builder (call MarkdownModelBuilder reuse))
    (let kept-line (only-if (as (+ (as (. ([] blocks last) line) I64) line-delta) Size) (if (< last (. blocks length)))))
    (call finish
      (block
        (arg builder)
        (arg next)
        (arg (call generate builder next (. edit first) (+ (. edit first) (. edit added)) previous (> (. edit start-line) 0)))
        (arg kept-line)
      )
    )
    (if (and (not (. builder blocks length)) (== first 0) (== last (. blocks length)))
      (call (. builder push-empty) 0 0)
    )
    (= index last)
    (while (< index (. blocks length))
      (= (. ([] blocks index) line) (as (+ (as (. ([] blocks index) line) I64) line-delta) Size))
      (= ([] starts index) (+ (as ([] starts index) I64) byte-delta))
      (= ([] ends index) (+ (as ([] ends index) I64) byte-delta))
      (+= index 1)
    )
    (return (call splice first last builder))
  )
  (fn-do _ block-at-line Size
    (param line Size)
    (let low Size 0)
    (let high (. blocks length))
    (while (< low high)
      (let middle (+ low (/ (- high low) 2)))
      (if (< (. ([] blocks middle) line) line)
        (= low (+ middle 1))
        (else
          (= high middle)
        )
      )
    )
    (return low)
  )
  (fn-do _ splice MarkdownModelChange
    (param first Size)
    (param last Size)
    (param builder MarkdownModelBuilder)
    (let added (. builder blocks))
    (let removed (- last first))
    (let kept (call min removed (. added length)))
    (let index Size 0)
    (while (< index (. added length))
      (= (. ([] added index) index) (+ first index))
      (+= index 1)
    )
    (= index 0)
    (while (< index kept)
      (let old ([] blocks (+ first index)))
      (if (!= (as old Pointer) (as ([] added index) Pointer))
        (call markdown-carry-source old ([] added index))
        (= ([] blocks (+ first index)) ([] added index))
      )
      (+= index 1)
    )
    (if (> removed kept)
      (call (. blocks remove) (+ first kept) (- removed kept))
      (else-if (> (. added length) kept)
        (call (. blocks insert) ([] added (... kept)) (+ first kept))
      )
    )
    (if (!= removed (. added length))
      (= index (+ first (. added length)))
      (while (< index (. blocks length))
        (= (. ([] blocks index) index) index)
        (+= index 1)
      )
    )
    (if (> removed 0)
      (call (. starts remove) first removed)
      (call (. ends remove) first removed)
      (call (. prefixes remove) first removed)
      (call (. sources remove) first removed)
    )
    (if (> (. added length) 0)
      (call (. starts insert) (. builder starts) first)
      (call (. ends insert) (. builder ends) first)
      (call (. prefixes insert) (. builder prefixes) first)
      (call (. sources insert) (. builder sources) first)
    )
    (return (call MarkdownModelChange false (+ first kept) (- removed kept) (- (. added length) kept)))
  )
  (fn-do _ generate (? Size)
    (param builder MarkdownModelBuilder)
    (param next CodeText)
    (param first Size)
    (param last Size)
    (param previous (? Size))
    (param keeps-gap Bool)
    (let after previous)
    (let skips-gap keeps-gap)
    (let value first)
    (while (< value last)
      (let start ([] (. outline starts) value))
      (let end ([] (. outline ends) value))
      (let parsed (call markdown-blocks (call (. next text-in) (call (. next line-start) start) (call (. next line-end) (- end 1))) base))
      (for (in block parsed)
        (+= (. block line) start)
      )
      (for (in index (..< 0 (. parsed length)))
        (let block ([] parsed index))
        (let span-start (. block line))
        (let following (+ index 1))
        (while (and (< following (. parsed length)) (<= (. ([] parsed following) line) span-start))
          (+= following 1)
        )
        (let span-end (if-expr (< following (. parsed length)) (. ([] parsed following) line) end))
        (while (and (> span-end (+ span-start 1)) (call markdown-is-blank-line (call (. next line-text) (- span-end 1)) (. block kind)))
          (-= span-end 1)
        )
        (if (not skips-gap)
          (call add-gap builder next (?? after 0) span-start (== after null) false)
        )
        (= skips-gap false)
        (let from (call (. next line-start) span-start))
        (let to (call (. next line-end) (- span-end 1)))
        (call (. builder push)
          (block
            (arg block)
            (arg from)
            (arg to)
            (arg (call markdown-line-prefix (call (. next line-text) span-start) (. block kind)))
            (arg (call (. next text-in) from to))
          )
        )
        (= after span-end)
      )
      (+= value 1)
    )
    (return after)
  )
  (fn-do _ finish _
    (param builder MarkdownModelBuilder)
    (param next CodeText)
    (param previous (? Size))
    (param kept-line (? Size))
    (if (!= kept-line null)
      (call add-gap builder next (?? previous 0) kept-line (== previous null) false)
      (return)
    )
    (let limit
      (scope (if-expr ends-with-newline (- (. next line-count) 1) (. next line-count))
        (lazy ends-with-newline (and (> (. next length) 0) (== (call (. next byte-at) (- (. next length) 1)) code-newline)))
      )
    )
    (call add-gap builder next (?? previous 0) (call max limit (?? previous 0)) (== previous null) true)
  )
  (fn-do _ add-gap _
    (param builder MarkdownModelBuilder)
    (param next CodeText)
    (param first Size)
    (param end Size)
    (param at-start Bool)
    (param at-end Bool)
    (return-if (if (<= end first)))
    (for (in line (..< first end))
      (return-if (if (> (. (call (. (call (. next line-text) line) trim)) size) 0)))
    )
    (let size (- end first))
    (let count (if-expr (or at-start at-end) (/ size 2) (if-expr (>= size 3) (/ (- size 1) 2) 0)))
    (for (in index (..< 0 count))
      (let line (if-expr at-start (+ first (* index 2)) (+ first 1 (* index 2))))
      (call (. builder push-empty) (call (. next line-start) line) line)
    )
  )
)

(type _ MarkdownModelBuilder
  (prop + blocks (list MarkdownBlock))
  (prop + starts (list Size))
  (prop + ends (list Size))
  (prop + prefixes (list String))
  (prop + sources (list String))
  (blank)
  (prop _ reuse (of Map String MarkdownBlock))
  (fn-do + This _
    (param reuse _)
  )
  (fn-do + push _
    (param block MarkdownBlock)
    (param start Size)
    (param end Size)
    (param prefix String)
    (param source String)
    (let chosen block)
    (let old ([] reuse source))
    (if (and old (call markdown-block-matches old block))
      (-= ([] reuse source))
      (= chosen old)
    )
    (= (. chosen index) (. blocks length))
    (= (. chosen line) (. block line))
    (+= blocks chosen)
    (+= starts start)
    (+= ends end)
    (+= prefixes prefix)
    (+= sources source)
  )
  (fn-do + push-empty _
    (param position Size)
    (param line Size)
    (let empty (call MarkdownBlock 0 (. MarkdownBlockKind paragraph)))
    (= (. empty line) line)
    (call push empty position position "" "")
  )
)

(fn-expr _ markdown-is-blank-line Bool
  (param line String)
  (param kind MarkdownBlockKind)
  (or (== (. trimmed size) 0) (and (== kind (. MarkdownBlockKind quote)) (== trimmed ">")))
  (where
    (lazy trimmed (call (. line trim)))
  )
)

(fn-do _ markdown-block-matches Bool
  (param old MarkdownBlock)
  (param block MarkdownBlock)
  (return-if false (if (or (!= (. old kind) (. block kind)) (!= (. old level) (. block level)) nesting-differs)))
  (lazy nesting-differs (or (!= (. old depth) (. block depth)) (!= (. old marker) (. block marker))))
  (return-if false (if (or (!= (. old anchor) (. block anchor)) (!= (. old code) (. block code)) (!= (. old language) (. block language)))))
  (return-if false (if (or (!= (. old columns) (. block columns)) lengths-differ)))
  (lazy lengths-differ (or (!= (. old cells length) (. block cells length)) (!= (. old runs length) (. block runs length))))
  (for (in index (..< 0 (. old runs length)))
    (let a ([] (. old runs) index))
    (let b ([] (. block runs) index))
    (return-if false (if (or (!= (?? (. a source) (. a text)) (?? (. b source) (. b text))) style-differs)))
    (lazy style-differs (or (!= (. a is-strong) (. b is-strong)) (!= (. a is-em) (. b is-em)) (!= (. a is-code) (. b is-code))))
    (return-if false (if (or (!= (. a url) (. b url)) (!= (. a is-break) (. b is-break)) (!= (. a is-image) (. b is-image)))))
    (return-if false (if (!= (. a language) (. b language))))
  )
  (return true)
)
