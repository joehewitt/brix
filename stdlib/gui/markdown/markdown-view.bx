(import ./markdown-blocks)
(import ./markdown-exhibits)
(import ./markdown-references)
(import ./markdown-selection)
(import ./markdown-theme)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/text)
(import /gui)
(import /gui/code-editor/code-syntax-style)
(import /gui/desktop)
(import /gui/source-editor/source-style)
(import /stream/aggregate)
(import /time/duration)
(import /ui/key-combo)
(blank)
(prop _ markdown-list-indent Length (= 26))
(prop _ markdown-grid-min-track Length (= 112))
(prop _ markdown-select-all-key _ (:= (call KeyCombo "Cmd+A")))
(prop _ markdown-selection-owner _ (:= (call MarkdownSelectionOwner)))

(type + MarkdownView (is Box)
  (prop + text String (= ""))
  (prop + base String)
  (prop + cache (? MarkdownBlockCache))
  (prop + is-selectable _ (= true))
  (prop + code-renderer (? MarkdownCodeRenderer) (= null))
  (prop + blocks _ (= (call markdown-view-blocks #text #base #cache #code-renderer)))
  (blank)
  (prop _ pending-line (? Size))
  (prop _ anchor _ (= (call MarkdownPoint 0 0 0)))
  (prop _ caret _ (= (call MarkdownPoint 0 0 0)))
  (prop _ is-selecting _ (= false))
  (prop _ origin _ (= (call MarkdownRange (call MarkdownPoint 0 0 0) (call MarkdownPoint 0 0 0))))
  (prop _ granularity _ (= (. MarkdownGranularity character)))
  (blank)
  (rule This
    (= focus-mode (if-expr #is-selectable (. FocusMode keys) (. FocusMode none)))
    (blank)
    (when-style #is-selectable
      (= cursor (. CursorStyle text))
    )
  )
  (content
    (<> This (• flex-col)
      (for (in block #blocks (keyed-by (. block index)))
        (<> MarkdownBlockView
          (= block block)
          (= code-renderer #code-renderer)
          (for (on request source-requested)
            (call markdown-toggle-source code-renderer (. request block) (. request shows))
          )
        )
      )
    )
  )
  (subscribe-for (on event pointer-down)
    (let modifiers (. event modifiers))
    (if (and is-selectable (== (. event button) (. PointerButton primary)) unmodified)
      (call select-at (. event root-point) (. event click-count) (. modifiers shift))
    )
    (lazy unmodified (and (not (. modifiers command)) (not (. modifiers control))))
  )
  (subscribe-for (on event pointer-drag)
    (if is-selecting
      (let found (call markdown-point-at blocks (call block-views) (call layout-point (. event root-point))))
      (if (!= found null)
        (call select-range (call markdown-extend-range blocks origin found granularity))
      )
    )
  )
  (subscribe-for (on _ pointer-up)
    (= is-selecting false)
  )
  (subscribe-for (on event key-press)
    (if (and is-selectable (call (. markdown-select-all-key matches) event))
      (call select-all)
      (call (. event cancel))
    )
  )
  (subscribe-for (on event copy)
    (if (and has-selection (call (. event clipboard write-text) (call selected-source)))
      (call (. event cancel))
    )
  )
  (subscribe-for (on _ focus)
    (call invalidate-paint)
  )
  (subscribe-for (on _ blur)
    (call invalidate-paint)
  )
  (fn-do + unmounted _
    (if (== (as (. markdown-selection-owner view) (? Pointer)) (as this Pointer))
      (= (. markdown-selection-owner view) null)
    )
    (call (. super unmounted))
  )
  (fn-do + did-layout _
    (call (. super did-layout))
    (let line pending-line)
    (return-if (if (== line null)))
    (blank)
    (= pending-line null)
    (let found (? MarkdownBlockView) null)
    (for (in view (call block-views))
      (if (> (. view block line) line)
        (break)
      )
      (= found view)
    )
    (if found
      (let ignored (call reveal found))
    )
  )
  (fn-do + paint-overlay _
    (param canvas Canvas)
    (call (. super paint-overlay) canvas)
    (return-if (if (or (not has-selection) (not (. blocks length)))))
    (blank)
    (let start
      (call markdown-clamp-point
        (block
          (arg blocks)
          (arg (if-expr (call markdown-point-before caret anchor) caret anchor))
        )
      )
    )
    (let end (call markdown-clamp-point blocks (if-expr (call markdown-point-before caret anchor) anchor caret)))
    (let color (if-expr is-focused $gui-markdown-selection-color $gui-markdown-idle-selection-color))
    (let object-color
      (scope (if-expr is-focused $gui-markdown-object-selection-color idle-object-color)
        (lazy idle-object-color $gui-markdown-idle-object-selection-color)
      )
    )
    (for (in view (call block-views))
      (call markdown-paint-selection canvas blocks view start end color object-color)
    )
  )
  (fn-expr + has-selection _ :get
    (!= anchor caret)
  )
  (fn-do + select-all _
    (return-if (if (not (. blocks length))))
    (blank)
    (call claim-selection)
    (= anchor (call markdown-first-point blocks))
    (= caret (call markdown-last-point blocks))
    (call show-selection)
  )
  (fn-do + clear-selection _
    (return-if (if (== anchor caret)))
    (blank)
    (= anchor caret)
    (call invalidate-paint)
  )
  (fn-expr + selected-source String
    (case? (or (not has-selection) (not (. blocks length)))
      ""
    )
    (default
      (call markdown-selection-source blocks start end)
    )
    (where
      (lazy start
        (call markdown-clamp-point
          (block
            (arg blocks)
            (arg (if-expr (call markdown-point-before caret anchor) caret anchor))
          )
        )
      )
      (lazy end
        (call markdown-clamp-point
          (block
            (arg blocks)
            (arg (if-expr (call markdown-point-before caret anchor) anchor caret))
          )
        )
      )
    )
  )
  (fn-do + reveal-anchor Bool
    (param anchor String)
    (for (in view (call block-views))
      (return-if (call reveal view) (if (== (. view block anchor) anchor)))
    )
    (return false)
  )
  (fn-do + reveal-line _
    (param line Size)
    (= pending-line line)
    (call invalidate-layout)
  )
  (fn-do + top-line (? Size)
    (let scroller (call scroll-ancestor))
    (return-if null (if (not scroller)))
    (blank)
    (let top (+ (. scroller content-bounds y) (. scroller scroll-y)))
    (for (in view (call block-views))
      (return-if (. view block line) (if (> (+ (. view bounds y) (. view bounds height)) (+ top 1))))
    )
    (return null)
  )
  (fn-do + block-views (list MarkdownBlockView)
    (let found (list MarkdownBlockView))
    (call collect-block-views this found)
    (return found)
  )
  (fn-do _ select-at _
    (param root-point Point)
    (param click-count U32)
    (param extends Bool)
    (let found (call markdown-point-at blocks (call block-views) (call layout-point root-point)))
    (return-if (if (== found null)))
    (blank)
    (call claim-selection)
    (= is-selecting true)
    (= granularity (call markdown-granularity click-count))
    (let keeps (and (== granularity (. MarkdownGranularity character)) extends is-focused))
    (= origin
      (scope (if-expr keeps (call MarkdownRange anchor anchor) found-unit)
        (lazy found-unit (call markdown-unit-at blocks found granularity))
      )
    )
    (call select-range (call markdown-extend-range blocks origin found granularity))
  )
  (fn-do _ select-range _
    (param range MarkdownRange)
    (return-if (if (and (== (. range anchor) anchor) (== (. range caret) caret))))
    (blank)
    (= anchor (. range anchor))
    (= caret (. range caret))
    (call show-selection)
  )
  (fn-do _ claim-selection _
    (let owner (. markdown-selection-owner view))
    (if (and owner (!= (as owner Pointer) (as this Pointer)))
      (call (. owner clear-selection))
    )
    (= (. markdown-selection-owner view) this)
  )
  (fn-do _ show-selection _
    (if (and has-selection (not is-focused))
      (let ignored (call request-focus))
    )
    (call invalidate-paint)
  )
  (fn-expr _ layout-point Point
    (param root-point Point)
    (call Point (+ (. local x) (. bounds x) (. offset x)) (+ (. local y) (. bounds y) (. offset y)))
    (where
      (lazy local (call point-in-box root-point))
      (lazy offset content-offset)
    )
  )
  (fn-do _ reveal Bool
    (param view MarkdownBlockView)
    (let scroller (call scroll-ancestor))
    (return-if false (if (not scroller)))
    (return (call (. scroller ensure-visible) view (. ScrollAlignment start)))
  )
  (fn-do _ scroll-ancestor (? Box)
    (let cursor material-parent)
    (while cursor
      (let ancestor cursor)
      (return-if ancestor (if (call (. ancestor is-scroll-axis-enabled) (. Orientation vertical))))
      (blank)
      (= cursor (. ancestor material-parent))
    )
    (return null)
  )
  (fn-do _ collect-block-views _
    (param box Box)
    (param found (list MarkdownBlockView))
    (for (in child (call RenderedChildCursor box))
      (if (is child MarkdownBlockView)
        (+= found (as child MarkdownBlockView))
        (else-if (. child is-markup-shadow)
          (call collect-block-views child found)
        )
      )
    )
  )
)

(fn-do _ markdown-view-blocks (list MarkdownBlock)
  (param text String)
  (param base String)
  (param cache (? MarkdownBlockCache))
  (param renderer (? MarkdownCodeRenderer))
  (let found (if-expr cache (call (. cache blocks-for) text base) (call markdown-blocks text base)))
  (for (in block found)
    (call markdown-render-block renderer block)
  )
  (return found)
)

(type + MarkdownBlockView (is Box)
  (prop + block MarkdownBlock)
  (prop + is-editable _ (= false))
  (prop + code-renderer (? MarkdownCodeRenderer) (= null))
  (prop + is-heading _ (= (== (. #block kind) (. MarkdownBlockKind heading))))
  (prop + is-title _ (= (and (== (. #block kind) (. MarkdownBlockKind heading)) (== (. #block level) 1))))
  (prop + is-section _ (= (and (== (. #block kind) (. MarkdownBlockKind heading)) (== (. #block level) 2))))
  (prop + is-quote _ (= (== (. #block kind) (. MarkdownBlockKind quote))))
  (prop + is-rendered _
    (=
      (block
        (and (== (. #block kind) (. MarkdownBlockKind code)) (!= (. #block #rendering) null) (not (. #block #shows-source)))
      )
    )
  )
  (prop + has-toggle _
    (=
      (block
        (and (== (. #block kind) (. MarkdownBlockKind code)) (?? (call (?. #code-renderer renders) (. #block language)) false))
      )
    )
  )
  (prop + shows-toggle _ (= (and #has-toggle (or #is-hover-within (and #is-editable (. #block #shows-source))))))
  (prop + shows-copy _ (= (and (not #is-editable) #is-hover-within)))
  (event + source-requested MarkdownSourceRequest)
  (content
    (<> This (• markdown-block) (• flex-row)
      (= padding-left (* (. #block depth) markdown-list-indent))
      (if (== (. #block kind) (. MarkdownBlockKind code))
        (<> Box (• flex-col) (• flex 1)
          (if #is-rendered
            (<> Box (• markdown-code-block) (• flex-col)
              (call (. (!! (. #block #rendering)) view))
            )
            (else
              (<> Box (• markdown-code-block) (• flex-col) (• px 14) (• py 12)
                (<> Text (• markdown-code)
                  (<> Span
                    (= text (. #block code))
                  )
                )
                (if (!= (. #block #render-error) null)
                  (<> Label (• markdown-code-error) (• mt 8)
                    (= text (!! (. #block #render-error)))
                  )
                )
              )
            )
          )
          (if #shows-copy
            (<> CopyButton (• markdown-code-copy) (• absolute) (• w 26) (• h 26)
              (= anchor (. Anchor parent))
              (= top (call (. PositionOffset coord) -8))
              (= right (call (. PositionOffset coord) -10))
              (= text (. #block code))
            )
          )
          (if #shows-toggle
            (<> (of SegmentedControl Bool) (• markdown-code-toggle) (• absolute)
              (= anchor (. Anchor parent))
              (= top (call (. PositionOffset coord) -9))
              (= right (call (. PositionOffset coord) (if-expr #shows-copy 22 -10)))
              (= selected (. #block #shows-source))
              (for (on event selection-changing)
                (call (. event cancel))
                (<- source-requested (call MarkdownSourceRequest block (. event value)))
              )
              (<> (of Segment Bool)
                (= title (call (. (!! #code-renderer) rendered-title) (. #block language)))
                (= value false)
              )
              (<> (of Segment Bool)
                (= title (call (. (!! #code-renderer) source-title) (. #block language)))
                (= value true)
              )
            )
          )
        )
        (else-if (== (. #block kind) (. MarkdownBlockKind exhibit))
          (<> MarkdownExhibit (• flex 1)
            (= block #block)
          )
        )
        (else-if (== (. #block kind) (. MarkdownBlockKind divider))
          (<> Box (• markdown-divider) (• flex 1) (• h 1))
        )
        (else-if (== (. #block kind) (. MarkdownBlockKind grid))
          (<> Box (• markdown-grid) (• flex 1)
            (= layout (call GridLayout (. #block columns) markdown-grid-min-track))
            (for (in cell (. #block #cells) (keyed-by (. cell index)))
              (<> MarkdownGridCellView (• markdown-grid-cell) (• px 12) (• py 7)
                (= cell cell)
              )
            )
          )
        )
        (else
          (if (> (. #block marker length) 0)
            (<> Label (• markdown-marker)
              (= text (. #block marker))
            )
          )
          (<> Text (• markdown-prose) (• flex 1)
            (if (call markdown-runs-link (. #block #runs))
              (for (in run (. #block #runs) (keyed-by (. run index)))
                (<> MarkdownLinkSpan (• markdown-run) (• markdown-link)
                  (= run run)
                )
              )
              (else
                (for (in run (. #block #runs) (keyed-by (. run index)))
                  (<> MarkdownRunSpan (• markdown-run)
                    (= run run)
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

(type + MarkdownCodeSpan (is Span)
  (using CodeSyntaxStyle)
  (using SourceStructureTheme)
  (prop + run MarkdownCodeRun)
  (prop + is-bold _ (= (and (!= (. #run kind) null) (call source-is-bold (. #run kind)))))
  (prop + is-slanted _ (= (. #run is-optional)))
  (rule This
    (when-style #is-bold
      (= font-weight (. FontWeight bold))
    )
    (when-style #is-slanted
      (= font-slant (. FontSlant italic))
    )
  )
  (content
    (<> This
      (= text (. #run text))
      (= color (call markdown-code-run-color this #run))
    )
  )
)

(fn-expr _ markdown-code-run-color RGBA
  (param span MarkdownCodeSpan)
  (param run MarkdownCodeRun)
  (case? (== (. run kind) null)
    (call gui-syntax-role-color span (. run role))
  )
  (default
    (call source-span-color span (. run kind))
  )
)

(type + MarkdownGridCellView (is Text)
  (prop + cell MarkdownGridCell)
  (prop + is-header _ (= (. #cell is-header)))
  (prop + is-final-row _ (= (. #cell is-final-row)))
  (content
    (<> This
      (= text-alignment (. #cell alignment))
      (if (call markdown-runs-link (. #cell runs))
        (for (in run (. #cell runs) (keyed-by (. run index)))
          (<> MarkdownLinkSpan (• markdown-run) (• markdown-link)
            (= run run)
          )
        )
        (else
          (for (in run (. #cell runs) (keyed-by (. run index)))
            (<> MarkdownRunSpan (• markdown-run)
              (= run run)
            )
          )
        )
      )
    )
  )
)

(type + MarkdownRunSpan (is Span)
  (prop + run MarkdownRun)
  (prop + is-strong _ (= (. #run is-strong)))
  (prop + is-em _ (= (. #run is-em)))
  (prop + is-code _ (= (. #run is-code)))
  (content
    (<> This
      (= text (if-expr (!= (. #run rendering) null) "" (. #run text)))
      (if (!= (. #run rendering) null)
        (for (in piece (!! (. #run rendering)))
          (<> MarkdownCodeSpan
            (= run piece)
          )
        )
      )
    )
  )
)

(type + MarkdownLinkSpan (is Span)
  (prop + run MarkdownRun)
  (prop + target _
    (=
      (call markdown-reference-target
        (block
          (arg (?? (?. (?. #scope #references) #revision) 0))
          (arg (?. #scope #references))
          (arg (. #run reference))
        )
      )
    )
  )
  (prop + is-strong _ (= (. #run is-strong)))
  (prop + is-em _ (= (. #run is-em)))
  (prop + is-code _ (= (. #run is-code)))
  (prop + web-url _ (= (call markdown-web-url (. #run url))))
  (prop + anchor _ (= (call markdown-anchor (. #run url))))
  (prop + is-link _ (= (or (!= #web-url null) (!= #target null) (!= #anchor null))))
  (prop + detail _
    (=
      (call markdown-reference-detail
        (block
          (arg (?? (?. (?. #scope #references) #revision) 0))
          (arg (?. #scope #references))
          (arg #target)
        )
      )
    )
  )
  (prop + is-hovered-link _ (= (and #is-link #is-hovered)))
  (blank)
  (prop _ scope (of Ancestor MarkdownReferenceScope))
  (prop _ view (of Ancestor MarkdownView))
  (prop _ block-view (of Ancestor MarkdownBlockView))
  (prop _ hover-scope (? MarkdownReferenceScope))
  (content
    (<> This
      (= text (if-expr (!= (. #run rendering) null) "" (. #run text)))
      (if (!= (. #run rendering) null)
        (for (in piece (!! (. #run rendering)))
          (<> MarkdownCodeSpan
            (= run piece)
          )
        )
      )
      (if (!= #detail null)
        (<> MarkdownLinkTooltip
          (= detail (!! #detail))
        )
      )
    )
  )
  (subscribe-for (on event click)
    (let reference (. run reference))
    (let references (?. scope references))
    (let follows (or (not (?? (?. block-view is-editable) false)) (. event modifiers command)))
    (if (and follows reference references target)
      (call (. references follow) reference (?. scope origin))
      (call (. event cancel))
      (else-if (and follows web-url)
        (call open-url web-url)
        (call (. event cancel))
      )
      (else-if (and follows anchor view)
        (let ignored (call (. view reveal-anchor) anchor))
        (call (. event cancel))
      )
    )
  )
  (whenever-rule #is-hovered-link
    (= hover-scope (?? scope hover-scope))
    (call (?. hover-scope hover-link) this (only-if (?? (. run url) (?. detail path)) (if is-hovered-link)))
  )
  (fn-do + unmounted _
    (call (?. hover-scope hover-link) this null)
    (call (. super unmounted))
  )
)

(type + MarkdownLinkTooltip (is Popup)
  (prop + detail MarkdownLinkDetail)
  (prop + has-counts _ (= (!= (. #detail additions) null)))
  (blank)
  (rule This (• markdown-link-tooltip) (• passive) (• flex-col) (• above-center 6)
    (= hover-trigger true)
    (= hover-delay 1.6s)
  )
  (content
    (<> This
      (<> Text (• markdown-link-tooltip-text)
        (<> Span
          (= text (. #detail path))
        )
        (if #has-counts
          (<> Span (• markdown-added)
            (= text (str "  +" (?? (. #detail additions) 0)))
          )
          (<> Span (• markdown-removed)
            (= text (str " −" (?? (. #detail deletions) 0)))
          )
        )
      )
    )
  )
)

(fn-expr + markdown-selected-view (? MarkdownView)
  (only-if owner (if (and owner (. owner has-selection))))
  (where
    (lazy owner (. markdown-selection-owner view))
  )
)

(type _ MarkdownSelectionOwner
  (prop + view (? MarkdownView))
)

(fn-expr _ markdown-runs-link _
  (param runs (list MarkdownRun))
  (call some runs (:where (or (!= (. each url) null) (!= (. each reference) null))))
)

(fn-expr _ markdown-web-url (? String)
  (param url (? String))
  (only-if url (if (and url (or (call (. url starts-with) "https://") (call (. url starts-with) "http://")))))
)

(fn-expr _ markdown-anchor (? String)
  (param url (? String))
  (only-if ([] url (... 1)) (if (and url (call (. url starts-with) "#") (> (. url length) 1))))
)
