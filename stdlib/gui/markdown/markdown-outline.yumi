/code

_ markdown-backtick Byte = 96
_ markdown-pipe Byte = 124
_ markdown-backslash Byte = 92
_ markdown-hash Byte = 35
_ markdown-star Byte = 42
_ markdown-plus Byte = 43
_ markdown-dash Byte = 45
_ markdown-dot Byte = 46
_ markdown-colon Byte = 58
_ markdown-quote-mark Byte = 62
_ markdown-zero Byte = 48
_ markdown-nine Byte = 57

━━━━━━━━━━━━━━━━━━━━
+ MarkdownOutlineEdit is Tuple

+ first Size
+ removed Size
+ added Size
+ start-line Size
+ old-end-line Size?

━━━━━━━━━━━━━━━━━━━━
+ MarkdownOutline

+ starts [Size]
+ ends [Size]

────────────────────
+ do scan
    - text CodeText

starts = List'Size()
ends = List'Size()
. line = markdown-skip-empty(text, 0)
while line < text.line-count
    . end = markdown-value-end(text, line)
    starts += line
    ends += end
    line = markdown-skip-empty(text, end)

────────────────────
+ do update MarkdownOutlineEdit
    - text CodeText
    - damage CodeTextDamage

. low Size = 0
. high = starts.length
while low < high
    . middle = low + (high - low) / 2
    if starts[middle] + 2 <= damage.first-line
        low = middle + 1
    else
        high = middle
. first = if low > 0 then low - 1 else 0
. start-line = if low > 0 then starts[first] else 0
. added-starts [Size]
. added-ends [Size]
. old = first
. old-end-line Size? = null
. line = markdown-skip-empty(text, start-line)
while line < text.line-count
    if line > damage.last-line
        . target = ((line as I64) - damage.line-delta) as Size
        while old < starts.length && starts[old] < target
            old += 1
        if old < starts.length && starts[old] == target
            old-end-line = target
            break
    . end = markdown-value-end(text, line)
    added-starts += line
    added-ends += end
    line = markdown-skip-empty(text, end)
if old-end-line == null
    old = starts.length
. index = old
while index < starts.length
    starts[index] = (starts[index] as I64) + damage.line-delta
    ends[index] = (ends[index] as I64) + damage.line-delta
    index += 1
. removed = old - first
if removed > 0
    starts.remove(first, removed)
    ends.remove(first, removed)
if added-starts.length > 0
    starts.insert(added-starts, first)
    ends.insert(added-ends, first)
= MarkdownOutlineEdit(first, removed, added-starts.length, start-line, old-end-line)

━━━━━━━━━━━━━━━━━━━━
_ do markdown-skip-empty Size
    - text CodeText
    - line Size

. at = line
while at < text.line-count && text.line-start(at) == text.line-end(at)
    at += 1
= at

━━━━━━━━━━━━━━━━━━━━
_ do markdown-value-end Size
    - text CodeText
    - line Size

. count = text.line-count
. width = markdown-fence-width(text, line)
if width >= 3
    =? line + 1 if line + 1 >= count
    . at = line + 1
    while at < count
        =? at + 1 if markdown-is-fence-close(text, at, width)
        at += 1
    = count
if markdown-is-table-start(text, line)
    . at = line + 2
    while at < count && markdown-is-table-row(text, at)
        at += 1
    = at
=? line + 1 if markdown-is-heading(text, line)
=? markdown-run-end(text, line, true) if markdown-is-list-line(text, line, false)
=? line + 1 if markdown-is-divider(text, line)
=? markdown-run-end(text, line, false) if markdown-is-quote(text, line)
. at = line + 1
while at < count && text.line-start(at) < text.line-end(at) && !markdown-is-block-start(text, at)
    at += 1
= at

━━━━━━━━━━━━━━━━━━━━
_ do markdown-run-end Size
    - text CodeText
    - line Size
    - is-list Bool

. end = line + 1
. next = markdown-skip-empty(text, end)
while next < text.line-count && (if is-list then markdown-is-list-line(text, next, false) else markdown-is-quote(text, next))
    end = next + 1
    next = markdown-skip-empty(text, end)
= end

━━━━━━━━━━━━━━━━━━━━
_ markdown-is-block-start Bool
    - text CodeText
    - line Size

fence-or-table || is-heading || is-list-line || is-divider || markdown-is-quote(text, line)

.. fence-or-table = markdown-fence-width(text, line) >= 3 || markdown-is-table-start(text, line)
.. is-heading = markdown-is-heading(text, line)
.. is-list-line = markdown-is-list-line(text, line, true)
.. is-divider = markdown-is-divider(text, line)

━━━━━━━━━━━━━━━━━━━━
_ do markdown-fence-width Size
    - text CodeText
    - line Size

. start = text.line-start(line)
. end = text.line-end(line)
. at = start
while at < end && text.byte-at(at) == markdown-backtick
    at += 1
= at - start

━━━━━━━━━━━━━━━━━━━━
_ markdown-is-fence-close Bool
    - text CodeText
    - line Size
    - width Size

ticks >= width && markdown-skip-spaces(text, text.line-start(line) + ticks, end) == end

.. ticks = markdown-fence-width(text, line)
.. end = text.line-end(line)

━━━━━━━━━━━━━━━━━━━━
_ do markdown-is-heading Bool
    - text CodeText
    - line Size

. start = text.line-start(line)
. end = text.line-end(line)
. at = start
while at < end && at - start < 7 && text.byte-at(at) == markdown-hash
    at += 1
. level = at - start
= level >= 1 && level <= 6 && at < end && markdown-is-space(text.byte-at(at))

━━━━━━━━━━━━━━━━━━━━
_ markdown-is-list-line Bool
    - text CodeText
    - line Size
    - allows-zeros Bool

|? at >= end
    false
|? byte == markdown-star || byte == markdown-plus || byte == markdown-dash
    at + 1 < end && markdown-is-space(text.byte-at(at + 1))
|? digits == at
    false
??
    marker + 1 < end && text.byte-at(marker) == markdown-dot && space-follows

.. end = text.line-end(line)
.. space-follows = markdown-is-space(text.byte-at(marker + 1))
.. at = markdown-skip-spaces(text, text.line-start(line), end)
.. byte = text.byte-at(at)
.. digits = markdown-skip-digits(text, at, end)
.. marker = if !allows-zeros && byte == markdown-zero then at + 1 else digits

━━━━━━━━━━━━━━━━━━━━
_ do markdown-is-divider Bool
    - text CodeText
    - line Size

. start = text.line-start(line)
. end = text.line-end(line)
=? false if start >= end || text.byte-at(start) != markdown-dash
. dashes Size = 0
. at = start
while at < end
    . byte = text.byte-at(at)
    if byte == markdown-dash
        dashes += 1
    else if !markdown-is-space(byte)
        = false
    at += 1
= dashes >= 3

━━━━━━━━━━━━━━━━━━━━
_ markdown-is-quote Bool
    - text CodeText
    - line Size

start < text.line-end(line) && text.byte-at(start) == markdown-quote-mark

.. start = text.line-start(line)

━━━━━━━━━━━━━━━━━━━━
_ markdown-is-table-start Bool
    - text CodeText
    - line Size

markdown-is-table-row(text, line) && line + 1 < text.line-count && delimited

.. delimited = markdown-is-table-delimiter(text, line + 1)

━━━━━━━━━━━━━━━━━━━━
_ do markdown-is-table-row Bool
    - text CodeText
    - line Size

. end = text.line-end(line)
. at = text.line-start(line)
if at < end && text.byte-at(at) == markdown-pipe
    at += 1
while at < end
    . byte = text.byte-at(at)
    if byte == markdown-pipe
        = true
    if byte == markdown-backslash && at + 1 < end && text.byte-at(at + 1) == markdown-pipe
        at += 2
    else if byte == markdown-backtick
        . close = markdown-find-byte(text, at + 1, end, markdown-backtick)
        at = if close < end then close + 1 else at + 1
    else
        at += 1
= false

━━━━━━━━━━━━━━━━━━━━
_ do markdown-is-table-delimiter Bool
    - text CodeText
    - line Size

. end = text.line-end(line)
. at = text.line-start(line)
if at < end && text.byte-at(at) == markdown-pipe
    at += 1
. cell = markdown-delimiter-cell-end(text, at, end)
=? false if cell == null
at = cell
. cells Size = 0
while at < end && text.byte-at(at) == markdown-pipe
    . next = markdown-delimiter-cell-end(text, at + 1, end)
    if next == null
        break
    at = next
    cells += 1
=? false if cells == 0
if at < end && text.byte-at(at) == markdown-pipe
    at += 1
= at == end

━━━━━━━━━━━━━━━━━━━━
_ do markdown-delimiter-cell-end Size?
    - text CodeText
    - start Size
    - end Size

. at = markdown-skip-spaces(text, start, end)
if at < end && text.byte-at(at) == markdown-colon
    . dashes = markdown-skip-byte(text, at + 1, end, markdown-dash)
    |? dashes == at + 1
        = null
    |? dashes < end && text.byte-at(dashes) == markdown-colon
        = markdown-skip-spaces(text, dashes + 1, end)
    ??
        = markdown-skip-spaces(text, dashes, end)
. dashes = markdown-skip-byte(text, at, end, markdown-dash)
|? dashes == at
    = null
|? dashes < end && text.byte-at(dashes) == markdown-colon
    = markdown-skip-spaces(text, dashes + 1, end)
|? dashes - at < 3
    = null
??
    = markdown-skip-spaces(text, dashes, end)

━━━━━━━━━━━━━━━━━━━━
_ markdown-is-space Bool
    - byte Byte

byte == code-space || byte == code-tab

━━━━━━━━━━━━━━━━━━━━
_ do markdown-skip-spaces Size
    - text CodeText
    - start Size
    - end Size

. at = start
while at < end && markdown-is-space(text.byte-at(at))
    at += 1
= at

━━━━━━━━━━━━━━━━━━━━
_ do markdown-skip-digits Size
    - text CodeText
    - start Size
    - end Size

. at = start
while at < end && text.byte-at(at) >= markdown-zero && text.byte-at(at) <= markdown-nine
    at += 1
= at

━━━━━━━━━━━━━━━━━━━━
_ do markdown-skip-byte Size
    - text CodeText
    - start Size
    - end Size
    - byte Byte

. at = start
while at < end && text.byte-at(at) == byte
    at += 1
= at

━━━━━━━━━━━━━━━━━━━━
_ do markdown-find-byte Size
    - text CodeText
    - start Size
    - end Size
    - byte Byte

. at = start
while at < end && text.byte-at(at) != byte
    at += 1
= at
