────────────────────
+ do style-values-changed
    - owner MarkupHost
    - changes [StyleValueChange]

. box = match? owner
    | found Box
        found
=? if !box
for change in changes
    if gui-style-motion.is-motion-property(change, "enter-space")
        if !(markup-attachment(box)?.style-settled ?? true)
            box.expand-on-entry()
    else if change.info.properties[change.offset].name == "display"
        if markup-attachment(box)?.style-settled ?? true
            box.display-changed(change)
        else
            box.sync-display()
    else if gui-style-motion.is-motion-property(change, "match")
        box.sync-match()
    else if gui-style-motion.is-motion-property(change, "timeline")
        box.timeline-changed()
    else
        gui-style-motion.change-value(box, change)

