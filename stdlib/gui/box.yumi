_ do clear-transparent-paint-state-within
    - node GuiNode

. child = node.%first-child
while child
    . current = child
    if current is Box
        . box = current as Box
        if box.is-markup-shadow
            box.clear-retained-paint-invalidation()
            box.$is-paint-invalid = false
            box.$is-paint-invalid-below = false
            clear-transparent-paint-state-within(box)
    else if current.is-gui-transparent
        clear-transparent-paint-state-within(current)
    child = current.%next-sibling

