+ ScrollGlide
    is FrameAnimation

+ box Box
+ goal ScrollGoal
+ motion Motion
+ position MotionChannel

────────────────────
+ This
    - box
    - goal
    - motion
    - position

────────────────────
+ do retarget
    - next ScrollGoal
    - next-motion Motion
    - now Duration

goal = next
motion = next-motion
. wanted = goal()
if wanted
    aim(wanted, now)

────────────────────
+ do aim
    - point Point
    - now Duration

. wanted = point.motion-vector
. aimed = position.target
=? if abs(wanted[0] - aimed[0]) < position.precision && y-settled
.. y-settled = abs(wanted[1] - aimed[1]) < position.precision
position.retarget(wanted, motion, now)

