+ x => bounds.x
+ y => bounds.y
+ width => bounds.width
+ height => bounds.height

+ inner-width Length
+ inner-height Length
+ inner-size => Dimensions(inner-width, inner-height)

+ is-window-root => false
+ is-presentation-layer => false
+ presentation-native-host Pointer? => null
+ painted-shadow Shadow? => $shadow
+ presentation-origin => bounds.top-left
+ is-markup-shadow => false
+ is-gui-transparent => is-markup-shadow
+ is-layout-placed-by-parent => is-markup-shadow
+ is-layout-boundary => false
+ admits-focus-traversal => true
+ stagger-host Box? => this
+ match-key String? => registered-match
+ inline-ascent Length? => null
+ inline-outset => Dimensions(0, 0)
+ is-style-shadow => markup-is-style-shadow(this)
+ intrinsic-size => measure().border-size
+ outer-intrinsic-size => measure().outer-size
+ measured-outer-size => measure().outer-size

+ input-generation U32
+ has-inline-limits => has-state-bit(gui-box-inline-limit-bit)
+ has-block-limits => has-state-bit(gui-box-block-limit-bit)
+ has-exact-inline-size => has-state-bit(gui-box-inline-exact-bit)
+ has-exact-block-size => has-state-bit(gui-box-block-exact-bit)
+ is-hovered = false
+ is-hover-within = false
+ is-pressed = false
+ is-press-within = false
+ is-focused = false
+ is-focus-visible = false
+ is-focus-within = false
+ remembered-focus Box?
+ is-enabled = true
+ is-effectively-enabled = true
+ is-entering = true
+ is-leaving = false
+ is-released = false
+ is-flying = false
+ is-carried = false
+ has-spaced-children = false
+ has-rigid-flex-children = false
+ carry-slot => motion-state?.carry-slot
+ carried-child => motion-state?.carried-child
+ lift-order => motion-state?.lift-order ?? 0

. own-enabled-changed < is-enabled

+ is-focus-enabled => true
+ is-focus-ready => true
+ accepts-focus =>
    is-focusable && is-effectively-enabled && is-available && is-focus-admitted
    .. is-focusable = focus-mode-can-focus($focus-mode) && is-focus-enabled
    .. is-available = is-input-visible && markup-batch-root != null
+ is-focus-admitted =>
    !host || host.admits-focus(this)
    .. host = window
+ can-focus => accepts-focus && is-focus-ready
+ delegates-focus => $focus-group && !focus-mode-can-focus($focus-mode)
+ holds-group-focus =>
    delegates-focus && is-effectively-enabled && is-available && is-focus-admitted
    .. is-available = is-input-visible && markup-batch-root != null
+ can-hold-focus => can-focus || holds-group-focus
+ native-focus-handle Pointer? => null
+ native-window-handle Pointer? => null
+ text-input-context TextInputContext? => null
+ undo-target UndoTarget? => null

+ has-horizontal-overflow => inner-width > content-bounds.width
+ has-vertical-overflow => inner-height > content-bounds.height
+ has-overflow => has-horizontal-overflow || has-vertical-overflow
+ scroll-position => if scroll-state then scroll-state.position else Point(0, 0)
+ scroll-x => scroll-position.x
+ scroll-y => scroll-position.y
+ scroll-min => Point(0, 0)
+ scroll-max => calculate-scroll-max()
+ scroll-viewport => content-bounds.size
+ scroll-content-bounds => calculate-scroll-content-bounds()
+ scroll-phase => calculate-scroll-phase()
+ is-scrolling => is-active-scroll-phase(scroll-phase)

