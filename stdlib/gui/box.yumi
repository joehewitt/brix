+ scroll-direction-delta Point
    - direction ScrollDirection
    - amount Length

match direction
    | ScrollDirection.up
        Point(0, -amount)
    | ScrollDirection.down
        Point(0, amount)
    | ScrollDirection.left
        Point(-amount, 0)
    ??
        Point(amount, 0)

