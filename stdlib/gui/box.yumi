_ BoxLayoutMotion
    is FrameAnimation

+ box Box
+ place MotionChannel?
+ place-target = Point(0, 0)
+ size MotionChannel?
+ size-target Dimensions?
+ reflows = false
+ reflow-target Dimensions?
+ was-sized = false
+ is-over = false
+ is-flight = false
+ cover BoxMatchCover?
+ fade MotionChannel?

────────────────────
+ This
    - box

────────────────────
+ get is-moving Bool

place != null || size != null || fade != null

────────────────────
+ do cover-with
    - shown BoxMatchCover
    - motion Motion?
    - now Duration

if !motion || motion is InstantMotion
    shown.close()
    =
. started = MotionChannel([1.0], 0.01)
started.retarget([0.0], motion, now)
if !started.is-moving
    shown.close()
    =
release-cover()
cover = shown
fade = started

────────────────────
+ do release-cover

fade = null
cover?.close()
cover = null

────────────────────
+ get offset Point

if !moving then zero else Point(moving.value[0] - place-target.x, moving.value[1] - place-target.y)

.. moving = place
.. zero = Point(0, 0)

────────────────────
+ get shown Dimensions?

if !moving then null else Dimensions(max(0.0, moving.value[0]), max(0.0, moving.value[1]))

.. moving = size

────────────────────
+ framed Rect
    - next Rect

if !reflows || !shown then next else Rect(next.x, next.y, shown.width, shown.height)

.. shown = this.shown

────────────────────
+ do aim-place
    - from Point
    - to Point
    - motion Motion?
    - now Duration
    - pace Point? = null

place-target = to
if !motion || motion is InstantMotion
    place = null
    =
. current = place
if current
    current.retarget([to.x, to.y], motion, now)
    =
. started = MotionChannel([from.x, from.y], 0.05)
if pace
    started.jump([from.x, from.y], [pace.x, pace.y])
started.retarget([to.x, to.y], motion, now)
place = started if started.is-moving

────────────────────
+ do snap-place
    - to Point

place-target = to
place = null

────────────────────
+ do aim-size
    - from Dimensions
    - to Dimensions
    - motion Motion?
    - now Duration
    - reflow Bool

reflows = reflow
reflow-target = to if reflow
if !motion || motion is InstantMotion
    size = null
    size-target = null
    =
size-target = to
was-sized = true
. current = size
if current
    current.retarget([to.width, to.height], motion, now)
    =
. started = MotionChannel([from.width, from.height], 0.05)
started.retarget([to.width, to.height], motion, now)
size = started if started.is-moving
if !size
    size-target = null

╌╌╌╌╌╌╌╌╌╌ is FrameAnimation ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do advance Bool
    - tick FrameTick

=? false if is-over
. sized = size != null
. moving-place = place
if moving-place
    moving-place.update(tick.now)
    if !moving-place.is-moving
        place = null
. moving-size = size
if moving-size
    moving-size.update(tick.now)
    if !moving-size.is-moving
        size = null
        size-target = null
. fading = fade
if fading
    fading.update(tick.now)
    . alpha = fading.value[0]
    if !fading.is-moving || alpha <= 0
        release-cover()
    else
        cover?.alpha = min(1.0, alpha)
    box.invalidate-paint()
if is-moving
    box.layout-moved(sized)
    = true
is-over = true
was-sized = sized
box.layout-motion-ended(this)
= false

────────────────────
+ do finish

=? if is-over
is-over = true
was-sized = size != null
place = null
size = null
size-target = null
release-cover()
box.layout-motion-ended(this)

