━━━━━━━━━━━━━━━━━━━━
+ PointerHitPath is Tuple

+ target Box
+ frames [GUIEventRouteFrame]

────────────────────
+ do is-current

=? false if frames.length == 0
. root-owner = frames[frames.length - 1].owner
for frame in frames
    . box = gc-object-from-pointer'Box(frame.owner)
    =? false if box.input-generation != frame.generation
    =? false if box.is-markup-shadow || !box.is-input-visible
    =? false if box.root as Pointer != root-owner
= true

────────────────────
+ do at-point
    - point Point

. next-frames [GUIEventRouteFrame]
for frame in frames
    . box = gc-object-from-pointer'Box(frame.owner)
    next-frames += GUIEventRouteFrame
        - frame.owner
        - frame.generation
        - box.point-in-box(point)
= PointerHitPath(target, next-frames)

────────────────────
+ do publish'Event Bool
    - event Event
    - Event is GUIRoutedEvent

=? false if !is-current()

. route = if gui-event-requires-enabled(event) then enabled-frames() else frames
=? false if route.length == 0
. receiver = gc-object-from-pointer'Box(route[0].owner)
. routed = event as GUIEvent
. saved = routed.begin-route(gui-box-event-route-next, route)
. cause MarkupCause? = if dragging then gui-instant-cause else markup-cause-none if scrolling
    .. dragging = event is PointerDragEvent
    .. scrolling = event is ScrollEvent
. outer = swap-markup-cause(cause) if cause
do finally
    routed.end-route(saved)
    if outer
        swap-markup-cause(outer)
= match event
    | ModifiersChangedEvent
        receiver.modifiers-changed <- it
        it.is-canceled
    | KeyReleaseEvent
        receiver.key-release <- it
        it.is-canceled
    | PointerDownEvent
        receiver.pointer-down <- it
        it.is-canceled
    | PointerUpEvent
        receiver.pointer-up <- it
        it.is-canceled
    | PointerMoveEvent
        receiver.pointer-move <- it
        it.is-canceled
    | PointerDragEvent
        receiver.pointer-drag <- it
        it.is-canceled
    | ScrollEvent
        receiver.scroll <- it
        it.is-canceled
    | MagnifyEvent
        receiver.magnify <- it
        it.is-canceled
    | TouchEvent
        receiver.touch <- it
        it.is-canceled
    | ClickEvent
        receiver.click <- it
        it.is-canceled
    | FocusEvent
        receiver.focus <- it
        it.is-canceled
    | BlurEvent
        receiver.blur <- it
        it.is-canceled
    | KeyPressEvent
        receiver.key-press <- it
        it.is-canceled
    | KeyInputEvent
        receiver.key-input <- it
        it.is-canceled
    | TextCommandEvent
        receiver.text-command <- it
        it.is-canceled
    | TextCompositionEvent
        receiver.text-composition <- it
        it.is-canceled
    | CopyEvent
        receiver.copy <- it
        it.is-canceled
    | CutEvent
        receiver.cut <- it
        it.is-canceled
    | PasteEvent
        receiver.paste <- it
        it.is-canceled

────────────────────
_ enabled-frames [GUIEventRouteFrame]

** frames
?*> each if gc-object-from-pointer'Box(each.owner).is-effectively-enabled
|> List

────────────────────
+ do publish-drag-start
    - event DragStartEvent

=? if !is-current()
. saved = event.begin-route(gui-box-event-route-next, frames)
do finally event.end-route(saved)
target.drag-start <- event

────────────────────
+ do publish-drag-over
    - event DragOverEvent

=? if !is-current()
. saved = event.begin-route(gui-box-event-route-next, frames)
do finally event.end-route(saved)
target.drag-over <- event

━━━━━━━━━━━━━━━━━━━━
+ do gui-rendered-resolve Box?
    - owner GuiNode
    - candidate GuiNode?

. node = candidate
while node
    . current = node
    if current.is-gui-transparent
        if current.%first-child
            node = current.%first-child
        else
            node = gui-rendered-climb(current, owner)
    else if current is Box && !(current as Box).is-presentation-layer
        = current as Box
    else
        node = gui-rendered-climb(current, owner)
= null

━━━━━━━━━━━━━━━━━━━━
+ do gui-rendered-climb
    - node GuiNode
    - owner GuiNode

. cursor = node
while true
    =? if cursor as Pointer == owner as Pointer
    if cursor.%next-sibling
        = cursor.%next-sibling
    =? if !cursor.%parent
    cursor = cursor.%parent!

━━━━━━━━━━━━━━━━━━━━
+ do gui-rendered-reverse-resolve Box?
    - owner GuiNode
    - candidate GuiNode?

. node = candidate
while node
    . current = node
    if current.is-gui-transparent
        if current.%last-child
            node = current.%last-child
        else
            node = gui-rendered-reverse-climb(current, owner)
    else if current is Box && !(current as Box).is-presentation-layer
        = current as Box
    else
        node = gui-rendered-reverse-climb(current, owner)
= null

━━━━━━━━━━━━━━━━━━━━
+ do gui-rendered-reverse-climb
    - node GuiNode
    - owner GuiNode

. cursor = node
while true
    =? if cursor as Pointer == owner as Pointer
    if cursor.%previous-sibling
        = cursor.%previous-sibling
    =? if !cursor.%parent
    cursor = cursor.%parent!

━━━━━━━━━━━━━━━━━━━━
+ do gui-node-precedes
    - left GuiNode
    - right GuiNode

=? false if left as Pointer == right as Pointer
. cursor GuiNode? = right
while cursor
    =? true if cursor as Pointer == left as Pointer
    cursor = cursor.%parent
cursor = left
while cursor
    =? false if cursor as Pointer == right as Pointer
    cursor = cursor.%parent

. common GuiNode?
. left-ancestor GuiNode? = left
while left-ancestor && !common
    . right-ancestor GuiNode? = right
    while right-ancestor
        if left-ancestor as Pointer == right-ancestor as Pointer
            common = left-ancestor
            break
        right-ancestor = right-ancestor.%parent
    left-ancestor = left-ancestor.%parent
=? false if !common

. left-branch = left
while left-branch.%parent && left-branch.%parent! as Pointer != common as Pointer
    left-branch = left-branch.%parent!
. right-branch = right
while right-branch.%parent && right-branch.%parent! as Pointer != common as Pointer
    right-branch = right-branch.%parent!

. child = common.%first-child
while child
    =? true if child as Pointer == left-branch as Pointer
    =? false if child as Pointer == right-branch as Pointer
    child = child.%next-sibling
= false

