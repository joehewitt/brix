+ do has-active-list-invalid Bool

=? true
    if active-list-child-list-generation != child-list-generation
. child = %first-child
while child
    . current = child
    if current is GuiRegion
        =? true
            if (current as GuiRegion).has-active-list-invalid()
    child = current.%next-sibling
= false

