_ do clear-transparent-layout-state
    - node GuiNode

. child = node.%first-child
while child
    . current = child
    if current is Box
        . box = current as Box
        if box.is-markup-shadow
            box.$is-layout-invalid = false
            box.$is-layout-invalid-below = false
            clear-transparent-layout-state(box)
    else if current.is-gui-transparent
        clear-transparent-layout-state(current)
    child = current.%next-sibling

