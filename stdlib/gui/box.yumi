. offset = index.children.length
while offset > 0
    offset -= 1
    . child = index.children[offset].child
    if (child.composite-bits /and/ gui-composite-routed-bit) == 0
        . found = child.hit-descend(point, parent-visible, frames)
        =? found if found

────────────────────
_ do sequenced-index-hit-descend
    - index LayoutIndex
    - point Point
    - parent-visible Bool
    - frames [GUIEventRouteFrame]

. candidate = sequenced-index-candidate(index, point)
. overflow-offset = index.overflow.length
if candidate
    . entry = index.children[candidate]
    while overflow-offset > 0
        . overflow-entry = index.overflow[overflow-offset - 1]
        if overflow-entry.order <= entry.order
            break
        overflow-offset -= 1
        . found = overflow-entry.child.hit-descend-unrouted(point, parent-visible, frames)
        =? found if found
    . found = entry.child.hit-descend-unrouted(point, parent-visible, frames)
    =? found if found

while overflow-offset > 0
    overflow-offset -= 1
    . overflow-entry = index.overflow[overflow-offset]
    . found = overflow-entry.child.hit-descend-unrouted(point, parent-visible, frames)
