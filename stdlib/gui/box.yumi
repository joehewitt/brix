+ do clear-cursor-invalidations

if this is Box
    (this as Box).$is-cursor-invalid = false
. child = %first-child
while child
    . current = child
    current.clear-cursor-invalidations()
    child = current.%next-sibling

────────────────────
+ do get rendered-nodes [GuiNode]

for child in children
    if child.is-gui-transparent
        <<= child.rendered-nodes
    else if !(child is Box && (child as Box).is-presentation-layer)
        <= child

────────────────────
_ do rendered-box-count-up-to Size
    - limit Size

. count Size = 0
. child GuiNode? = %first-child
while child
    . node = child
    if node.is-gui-transparent
        count += node.rendered-box-count-up-to(limit - count)
    else if node is Box && !(node as Box).is-presentation-layer
        count += 1
    =? count if count >= limit
    child = node.%next-sibling
= count

