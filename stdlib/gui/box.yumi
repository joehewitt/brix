. frames = event.route-frames
. index = event.route-index
=? if index >= frames.length || frames[index].owner != raw-current

. root-owner = frames[frames.length - 1].owner
index += 1
while index < frames.length
    . frame = frames[index]
    . box = gc-object-from-pointer'Box(frame.owner)
    . is-live = box.input-generation == frame.generation
    . has-route = !box.is-markup-shadow && box.is-input-visible
    if is-live && has-route && box.root as Pointer == root-owner
        event.advance-route(index, box.point-in-box(event.root-point))
        = frame.owner
    index += 1

