━━━━━━━━━━━━━━━━━━━━
_ BoxTimeline
    is ClipWatcher

+ box Box
+ run KeyframeRun
+ timeline AnimationTimeline

_ host WindowHost?

────────────────────
+ This
    - box
    - run
    - timeline

────────────────────
+ do follow
    - next AnimationTimeline

timeline = next
. wanted = box.window-host if timeline.follows-scrolling
if wanted as Pointer? != host as Pointer?
    host?.unwatch-clip(this)
    wanted?.watch-clip(this)
    host = wanted
scrub()

────────────────────
+ do stop

host?.unwatch-clip(this)
host = null

────────────────────
+ do scrub

if run.is-done
    stop()
    =
run.scrub(timeline.progress(box))

