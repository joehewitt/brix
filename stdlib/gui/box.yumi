=? if !index.children
. coordinate = if index.orient == Orientation.horizontal then point.x else point.y
. low Size = 0
. high = index.children.length
while low < high
    . middle = (low + high) / 2
    . bounds = index.children[middle].child.bounds
    . end = if index.orient == Orientation.horizontal then bounds.right else bounds.bottom
    if end <= coordinate
        low = middle + 1
    else
        high = middle
if low < index.children.length
    . found = index.children[low].child.bounds
    . start = if index.orient == Orientation.horizontal then found.left else found.top
    . end = if index.orient == Orientation.horizontal then found.right else found.bottom
    =? low if coordinate >= start && coordinate <= end

if low > 0
    . previous = index.children[low - 1].child.bounds
    . start = if index.orient == Orientation.horizontal then previous.left else previous.top
    . end = if index.orient == Orientation.horizontal then previous.right else previous.bottom
    =? low - 1 if coordinate >= start && coordinate <= end

