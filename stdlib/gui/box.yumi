. visible = parent-visible && is-display-visible && !is-leaving && !is-flying && !carry
=? if !visible
. transform = presentation-transform
. presented = if transform then transform.inverse-transform(outer-point) else outer-point
=? if !presented
. point Point = presented

. found Box?
. can-hit-content = !clips-content || content-bounds.contains(point)
if can-hit-content
    . offset = content-offset
    . content-point = Point(point.x + offset.x, point.y + offset.y)
    . record = composite-record
    if record
        found = hit-descend-routed(content-point, visible, frames, record.above)
    if !found
        found = hit-descend-children(content-point, visible, frames)
    if !found && record
        found = hit-descend-routed(content-point, visible, frames, record.below)

if !found
    . accepts-point = !is-markup-shadow && hit-contains(point)
    =? if !accepts-point
    found = this

if !is-markup-shadow
    frames += GUIEventRouteFrame
        - this as Pointer
        - input-generation
        - Point(point.x - bounds.x, point.y - bounds.y)
= found

