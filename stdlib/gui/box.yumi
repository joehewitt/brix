_ BoxCarry
    is FrameAnimation

+ box Box
+ place MotionChannel
+ lead Box?
+ spot Point
+ is-over = false

────────────────────
+ This
    - box
    - at Point
    - lead
    - spot

.. place = MotionChannel([at.x, at.y], 0.05)

────────────────────
+ get top-left Point

Point(place.value[0], place.value[1])

────────────────────
+ get speed Point

Point(place.speed[0], place.speed[1])

────────────────────
+ get offset Point

Point(local.x - box.bounds.x, local.y - box.bounds.y)

.. corner = top-left
.. local = box.route-transform?.inverse-transform(corner) ?? corner

────────────────────
+ do jump
    - at Point
    - pace Point

place.jump([at.x, at.y], [pace.x, pace.y])
box.carry-moved()

────────────────────
+ do chase

. leading = lead?.carry-place
=? if !leading || is-over
. clock = box.frame-clock
=? if !clock
. wanted = Point(leading.x + spot.x, leading.y + spot.y)
if place.target[0] != wanted.x || place.target[1] != wanted.y
    place.retarget([wanted.x, wanted.y], gui-carry-trail, clock.now)
if place.is-moving
    clock.start(box, this)

