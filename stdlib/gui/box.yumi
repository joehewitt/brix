space-run != null

────────────────────
+ do begin-entering

=? if !property-observed(this as Pointer, "is-entering")
is-entering = true
stagger-entry()
style-report-next-settle(this)

────────────────────
+ do enter-subtree

begin-entering()
enter-nodes(this)

────────────────────
_ do enter-nodes
    - node GuiNode

. cursor = node.%first-child
while cursor
    if cursor is Box
        (cursor as Box).enter-subtree()
    else
        enter-nodes(cursor)
    cursor = cursor.%next-sibling

────────────────────
+ do entered

is-entering = false
. start = entering-start
if start
    gui-style-motion.defer-entrance(this, start)

────────────────────
+ do next-entry-start Duration
    - now Duration
    - stagger Duration

. state = motion-state-for-write
if state.stagger-time != now
    state.stagger-time = now
    state.stagger-count = 0
. start = now + stagger * min(state.stagger-count, gui-stagger-steps)
state.stagger-count += 1
= start

────────────────────
+ do expand-on-entry

=? if $enter-space != EnterSpace.expand || !(window-host?.admits-entering ?? false)
set-space(0)
move-space(1)

────────────────────
+ do sync-display

last-display = $display

────────────────────
+ do display-changed
    - change StyleValueChange

. interrupted = hiding-info != null
if interrupted
    stop-hiding()
. previous = last-display
. next = $display
last-display = next
if next == Display.hidden && previous == Display.visible
    gui-box-matches.depart-within(this)
    if (material-parent?.is-paint-visible ?? true) && frame-clock && leaves-with-motion()
        begin-hiding(change)
    else
        forget-arrangement()
    =
if next == Display.visible && previous == Display.hidden
    gui-box-matches.revive-within(this)
    gui-box-matches.arrive-within(this, current-markup-cause())
if next == Display.visible && previous == Display.hidden && !interrupted && host-admits
    begin-entering()
    if $enter-space == EnterSpace.expand
        set-space(0)
        move-space(1)
.. host-admits = window-host?.admits-entering ?? false

────────────────────
+ do finish-hiding

. info = hiding-info
=? if !info
motion-state?.hiding-info = null
motion-state?.departure = null
gui-style-motion.forget(this)
style-unpresent(this, info, hiding-offset)
is-leaving = false
is-released = false
end-space()
set-space(1)
forget-arrangement()

────────────────────
