────────────────────
+ get initial-iterator-state

|? !first
    Pointer()
??
    first as Pointer

.. first = gui-rendered-resolve(owner, owner.%first-child)

────────────────────
+ do next-iterator
    - state Pointer

. none Box?
=? (Pointer(), none) if state == Pointer()
. box = gc-object-from-pointer'Box(state)
. successor = gui-rendered-resolve(owner, gui-rendered-climb(box, owner))
. next-state = Pointer()
if successor
    next-state = successor as Pointer
= (next-state, box)

