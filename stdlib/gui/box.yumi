────────────────────
_ has-state-bit
    - bit U8

(state-bits /and/ bit) != 0

────────────────────
_ do set-state-bit
    - bit U8
    - value Bool

if value
    state-bits = state-bits /or/ bit
else
    state-bits = state-bits /and/ not(bit)

────────────────────
_ do set-hidden-dirty-below
    - value Bool

set-state-bit(gui-box-hidden-dirty-bit, value)

────────────────────
_ do set-layout-invalidation-kind
    - kind U8

state-bits = state-bits /and/ not(gui-box-layout-kind-mask)
state-bits = state-bits /or/ ((kind /and/ 3) /lshift/ 5)

────────────────────
_ do packed-measure-axis-flags
    - query AxisQuery

. flags = packed-measure-mode-flags(query.mode)
if query.available
    flags = flags /or/ gui-measure-axis-available-bit
if query.max
    flags = flags /or/ gui-measure-axis-max-bit
= flags

────────────────────
_ packed-measure-mode-flags U8
    - mode AxisMeasureMode

match mode
    | AxisMeasureMode.max-content
        1
    | AxisMeasureMode.fit
        2
    | AxisMeasureMode.exact
        3
    ??
        0

────────────────────
_ packed-measure-optional-length
    - value Length?

|? value
    value as F32
??
    0.0f32

────────────────────
_ packed-measure-entry
    - query MeasureQuery
    - result MeasureResult
    - generation U32

PackedMeasureCacheEntry(packed-query, packed-result, generation)

.. inline = PackedAxisQuery
    - query.inline.min as F32
    - packed-measure-optional-length(query.inline.available)
    - packed-measure-optional-length(query.inline.max)
.. block = PackedAxisQuery
    - query.block.min as F32
    - packed-measure-optional-length(query.block.available)
    - packed-measure-optional-length(query.block.max)
.. packed-query = PackedQuery
    - packed-measure-axis-flags(query.inline)
    - packed-measure-axis-flags(query.block)
    - inline
    - block
.. packed-result = PackedMeasureValue
    - PackedDimensions(result.content-size.width as F32, result.content-size.height as F32)
    - PackedDimensions(result.border-size.width as F32, result.border-size.height as F32)
    - PackedDimensions(result.outer-size.width as F32, result.outer-size.height as F32)

────────────────────
_ packed-measure-entry-matches
    - entry PackedMeasureCacheEntry
    - query MeasureQuery

|? packed.i-flags != packed-measure-axis-flags(query.inline)
    false
|? packed.b-flags != packed-measure-axis-flags(query.block)
    false
|? packed.inline.min != query.inline.min as F32
    false
|? packed.inline.available != packed-measure-optional-length(query.inline.available)
    false
|? packed.inline.max != packed-measure-optional-length(query.inline.max)
    false
|? packed.block.min != query.block.min as F32
    false
|? packed.block.available != packed-measure-optional-length(query.block.available)
    false
|? packed.block.max != packed-measure-optional-length(query.block.max)
    false
??
    true

.. packed = entry.query

────────────────────
_ packed-measure-result
    - entry PackedMeasureCacheEntry

MeasureResult
    - Dimensions(content-width, content-height)
    - Dimensions(border-width, border-height)
    - Dimensions(outer-width, outer-height)

.. content-width = entry.result.content.width
.. content-height = entry.result.content.height
.. border-width = entry.result.border.width
.. border-height = entry.result.border.height
.. outer-width = entry.result.outer.width
.. outer-height = entry.result.outer.height

────────────────────
_ unpacked-measure-fit-query
    - entry PackedMeasureCacheEntry

MeasureQuery
    - unpacked-axis-fit-query(packed.i-flags, packed.inline)
    - unpacked-axis-fit-query(packed.b-flags, packed.block)

.. packed = entry.query

────────────────────
_ unpacked-axis-fit-query
    - flags U8
    - axis PackedAxisQuery

|? (flags /and/ gui-measure-axis-available-bit) != 0
    fit-axis-query(axis.available as Length)
??
    fit-axis-query()

────────────────────
_ scroll-phase-code
    - phase ScrollPhase

match phase
    |= ScrollPhase.began
        1
    |= ScrollPhase.stationary
        2
    |= ScrollPhase.changed
        3
    |= ScrollPhase.ended
        4
    |= ScrollPhase.cancelled
        5
    |= ScrollPhase.may-begin
        6
    ??
        0

────────────────────
_ scroll-phase-from-code
    - code U8

match code
    |= 1
        ScrollPhase.began
    |= 2
        ScrollPhase.stationary
    |= 3
        ScrollPhase.changed
    |= 4
        ScrollPhase.ended
    |= 5
        ScrollPhase.cancelled
    |= 6
        ScrollPhase.may-begin
    ??
        ScrollPhase.none

────────────────────
_ do get motion-state-for-write BoxMotionState

if !motion-state
    motion-state = BoxMotionState()
= motion-state!

────────────────────
_ do scroll-state-for-write

if !scroll-state
    scroll-state = ScrollState()
= scroll-state!

────────────────────
_ do layout-index-for-write

. state = scroll-state-for-write()
if !state.layout-index
    state.layout-index = LayoutIndex()
= state.layout-index!

────────────────────
_ get current-layout-index

match scroll-state?.layout-index
    |= null
        null
    |? !it.valid || it.child-list-generation != child-list-generation
        null
    ??
        it

────────────────────
+ do retain-indexed-dirty-layout-child
    - child Box

. index = current-layout-index
if index
    //gui.layout.arrange.indexed-dirty-records ++
    index.dirty-layout-children += child
else
    //gui.layout.arrange.indexed-dirty-misses ++

────────────────────
+ get indexed-dirty-layout-children

match current-layout-index
    |= null
        null
    |? it.dirty-layout-children.length == 0
        null
    ??
        it.dirty-layout-children

────────────────────
_ do take-indexed-dirty-layout-children [Box]?

=? if !scroll-state || !scroll-state.layout-index
. state = scroll-state
. index = state.layout-index!
. is-current = index.valid && index.child-list-generation == child-list-generation
. unlisted = index.has-unlisted-dirty
index.has-unlisted-dirty = false
if !is-current || unlisted || index.dirty-layout-children.length == 0
    index.dirty-layout-children.clear()
    = null
. visiting = index.dirty-layout-children
index.dirty-layout-children = index.visiting-layout-children
index.visiting-layout-children = visiting
= visiting

────────────────────
_ do note-unlisted-layout

. cursor = this.material-parent if !is-presentation-layer
while cursor
    . parent = cursor
    . index = parent.scroll-state?.layout-index
    if index
        index.has-unlisted-dirty = true
    =? if parent.is-presentation-layer
    cursor = parent.material-parent

────────────────────
_ do invalidate-layout-index-chain

. cursor Box? = this
while cursor
    . box = cursor
    if box.scroll-state
        . state = box.scroll-state
        if state.layout-index
            . index = state.layout-index
            index.valid = false
    cursor = box.material-parent

────────────────────
+ has-lingering-scroll-indicator

|? !scroll-state
    false
??
    scroll-state.is-indicator-lingering || scroll-state.indicator-fade != null

