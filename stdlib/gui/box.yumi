    - point Point
    - visible Bool
    - frames [GUIEventRouteFrame]
    - members [Box]?

=? if !members
. index = members.length
while index > 0
    index -= 1
    . member = members[index]
    . found = member.hit-descend(point, visible, frames)
    if found
        . cursor = member.material-parent
        while cursor
            . box = cursor
            if box as Pointer == this as Pointer
                break
            if !box.is-markup-shadow
