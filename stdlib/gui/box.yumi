    - point Point
    - visible Bool
    - frames [GUIEventRouteFrame]

. retained = current-layout-index
if retained
    = indexed-hit-descend(retained, point, visible, frames)
. child = gui-rendered-reverse-resolve(this, %last-child)
while child
    if (child.composite-bits /and/ gui-composite-routed-bit) == 0
        . found = child.hit-descend(point, visible, frames)
        =? found if found
    child = gui-rendered-reverse-resolve(this, gui-rendered-reverse-climb(child, this))

