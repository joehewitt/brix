────────────────────
+ do markup-style-domains-changed
    - mask U32

invalidate-visited-native-geometry()
. keys = gui-box-style-keys
keys.refresh()
if (mask /and/ keys.layout-bit) != 0
    layout-cause = current-markup-cause()
    note-unlisted-layout()
if (mask /and/ (composite-style-mask() as U32)) != 0
    composite-style-changed(mask)
if (mask /and/ keys.presentation-bit) != 0
    presentation-changed()
=? if (mask /and/ keys.paint-bit) == 0
invalidate-paint()
sync-shaped-hit()
sync-window-material-artifact()
sync-background-image()
sync-focus-home()

────────────────────
+ do mounted

inherit-enabled(material-parent?.is-effectively-enabled ?? true)
input-generation += 1
set-native-artifact-kind(gui-native-artifact-peer, native-focus-handle != null)
sync-shaped-hit()
sync-window-material-artifact()
sync-background-image()
sync-focus-home()
composite-bits = composite-bits /or/ gui-composite-mounted-bit
sync-composite-registration()
motion-state?.frame-ticks?.resume()
sync-match()
if is-entering
    if (window-host?.admits-entering ?? false) && property-observed(this as Pointer, "is-entering")
        stagger-entry()
        style-report-next-settle(this)
    else
        do use gui-instant-cause
            is-entering = false

────────────────────
+ do markup-depart Bool

if hiding-info
    finish-hiding()
    = false
gui-box-matches.depart-within(this)
is-leaving = true
=? if !frame-clock || !leaves-with-motion()
leave-space()
watch-leaving(=> do markup-departed(this))
= true

────────────────────
+ do markup-revive

gui-box-matches.revive-within(this)
end-departure()
is-leaving = false
restore-space()
gui-style-motion.release-held(this)
gui-box-matches.arrive-within(this, current-markup-cause())

