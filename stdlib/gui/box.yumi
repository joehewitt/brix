────────────────────
+ do advance Bool
    - tick FrameTick

. wanted = goal()
if wanted
    aim(wanted, tick.now)
position.update(tick.now)
. ignored = box.scroll-to(Point(position.value))
= position.is-moving

────────────────────
+ do finish

. ignored = box.scroll-to(goal() ?? Point(position.target))

