/BxAppleGUI/BxAppleGUI.h
/os/path

━━━━━━━━━━━━━━━━━━━━
+ do move-to-trash ?! Error
    - path Path

?! Error("Could not move ${path.name} to the Trash")
    if !C:brixGuiTrashPath(path as String)

━━━━━━━━━━━━━━━━━━━━
+ do reveal-in-file-viewer Bool
    - path Path

= C:brixGuiRevealPath(path as String)

━━━━━━━━━━━━━━━━━━━━
+ do open-url Bool
    - url String

= C:brixGuiOpenURL(url)
