/YuAppleGUI/YuAppleGUI.h
/os/path

━━━━━━━━━━━━━━━━━━━━
+ do move-to-trash ?! Error
    - path Path

?! Error("Could not move ${path.name} to the Trash")
    if !C:yumiGuiTrashPath(path as String)

━━━━━━━━━━━━━━━━━━━━
+ do reveal-in-file-viewer Bool
    - path Path

= C:yumiGuiRevealPath(path as String)

━━━━━━━━━━━━━━━━━━━━
+ do open-url Bool
    - url String

= C:yumiGuiOpenURL(url)
