━━━━━━━━━━━━━━━━━━━━
+ ProgressBar is Box

+ value F64
+ minimum F64
+ maximum F64 = 1
+ is-indeterminate = false
+ label = ""
+ shows-percent = false

_ fill-start F64
_ fill-length F64
_ event sweep-requests Bool

. fill-changed < value, minimum, maximum
. sweep-changed < is-indeterminate

────────────────────

<This
    if #label.length || #shows-percent
        <Box • progress-caption
            <Label • flex:1
                text = #label
            if #shows-percent && !#is-indeterminate
                <Label • progress-percent
                    text = "${round(#fill-length * 100) as Int}%"
    <Box • progress-track
        <Box
            flex = #fill-start
        <Box • progress-fill
            flex = #fill-length
        <Box
            flex = 1 - #fill-start - #fill-length

╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌

~> is-filling
    do fill-changed()

    then is-sweeping on sweep-requests when each

~> is-sweeping
    do advance-sweep(0)

    for tick on frames
        advance-sweep(tick.elapsed)

    then is-filling on sweep-requests when !each

╌╌╌╌╌╌╌╌╌╌ is Box ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do mounted

super.mounted()
sweep-changed()

────────────────────
+ do unmounted

sweep-requests <- false
super.unmounted()

╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌

────────────────────
+ get fraction F64

progress-fraction(value, minimum, maximum)

────────────────────
_ do fill-changed

=? if is-sweeping
fill-start = 0
fill-length = fraction

────────────────────
_ do sweep-changed

sweep-requests <- (is-indeterminate && window != null)

────────────────────
_ do advance-sweep
    - elapsed Nanoseconds

. period = (progress-sweep-period as Nanoseconds) as F64
. phase = ((elapsed as F64) % period) / period
. lead = phase * (1 + progress-sweep-width) - progress-sweep-width
fill-start = max(0, lead)
fill-length = min(1, lead + progress-sweep-width) - fill-start

━━━━━━━━━━━━━━━━━━━━
+ progress-fraction F64
    - value F64
    - minimum F64
    - maximum F64

|? !is-finite(value) || !is-finite(minimum) || !is-finite(maximum) || maximum <= minimum
    0
??
    min(1, max(0, (value - minimum) / (maximum - minimum)))
