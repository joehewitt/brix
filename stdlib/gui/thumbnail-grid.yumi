────────────────────

<This • flex-col
    <KeyShortcut "Previous"
        key = .arrow-left
        discoverable = false
        action = => do move-selection(-1)
    <KeyShortcut "Next"
        key = .arrow-right
        discoverable = false
        action = => do move-selection(1)
    <KeyShortcut "Above"
        key = .arrow-up
        discoverable = false
        action = => do move-selection(-column-count)
    <KeyShortcut "Below"
        key = .arrow-down
        discoverable = false
        action = => do move-selection(column-count)
    <KeyShortcut "First"
        key = .home
        discoverable = false
        action = => do select-index(0)
    <KeyShortcut "Last"
        key = .end
        discoverable = false
        action = => do select-index((paths.length as Int) - 1)
    <KeyShortcut "Open"
        key = .enter
        repeat = false
        discoverable = false
        action = => do open-selected()

    <VirtualRegion'Path rows • flex:1 p:4
        source = path-source
        virtual-layout = #grid-layout
        overscan = thumbnail-grid-overscan(#cell-length, #spacing)

        <ThumbnailCell cell(row) - slot
            grid = this
            path = slot.#item
            address = slot.#address
            is-bound = slot.#is-bound

        for event on scroll-changed when arrival
            note-scroll(event)

        for event on magnify
            zoom-with-magnify(event)

────────────────────
+ do get thumbnail-cache ThumbnailCache

=? cache if cache
. owned = owned-cache
=? owned if owned
. created = ThumbnailCache()
owned-cache = created
= created

────────────────────
+ get column-count Int

grid-layout.column-count(floor(rows.content-bounds.width) as I64)

────────────────────
+ thumbnail-priority F64
    - address I64

|? address >= first && address <= last
    (address - first) as F64
|? is-below != is-scrolling-up
    visible + distance
??
    visible + (columns as F64) + distance

.. content = rows.content-bounds
.. width = floor(content.width) as I64
.. columns = grid-layout.column-count(width) as I64
.. pitch = (grid-layout.cell-extent(width) + grid-layout.spacing) as Length
.. top = rows.scroll-y
.. top-row = floor(top / pitch) as I64
.. bottom-row = floor((top + max(0, content.height - 1)) / pitch) as I64
.. first = top-row * columns
.. last = (bottom-row + 1) * columns - 1
.. visible = (last - first + 1) as F64
.. is-below = address > last
.. distance = if is-below then (address - last) as F64 else (first - address) as F64

────────────────────
+ do begin-zoom
    - focus Point? = null

zoom-anchor = -1
=? if paths.length == 0
. content = rows.content-bounds
. point = focus ?? Point(content.x + content.width / 2, content.y + content.height / 2)
. local = Point(point.x - content.x, point.y - content.y)
. width = floor(content.width) as I64
. columns = grid-layout.column-count(width) as I64
. cell = grid-layout.cell-extent(width) as Length
. pitch = cell + grid-layout.spacing as Length
. inset = grid-layout.leading-inset(width) as Length
. column = min(max(0, round((local.x - inset - cell / 2) / pitch)) as I64, columns - 1)
. row = max(0, round((rows.scroll-y + local.y - cell / 2) / pitch)) as I64
. address = min(row * columns + column, (paths.length as I64) - 1)
. y = ((address / columns) as Length) * pitch - rows.scroll-y
zoom-anchor = address
zoom-top = local.y
zoom-fraction = (local.y - y) / cell

────────────────────
+ do zoom-to
    - length Length

. next = max(min-cell-length, min(max-cell-length, length))
=? if next == cell-length
. is-zooming = zoom-anchor >= 0
if !is-zooming
    begin-zoom()
apply-zoom(next)
if !is-zooming
    end-zoom()

────────────────────
+ do end-zoom

zoom-anchor = -1

────────────────────
_ do apply-zoom
    - next Length

cell-length = next
if zoom-anchor >= 0
    . layout = thumbnail-grid-layout(next, spacing)
    . width = floor(rows.content-bounds.width) as I64
    . columns = layout.column-count(width) as I64
    . cell = layout.cell-extent(width) as Length
    . pitch = cell + layout.spacing as Length
    . row = (zoom-anchor / columns) as Length
    rows.restore-scroll(Point(0, max(0, row * pitch - zoom-top + zoom-fraction * cell)))
zoomed <- next

────────────────────
_ do zoom-with-magnify
    - event MagnifyEvent

if event.phase == ScrollPhase.began
    begin-zoom(event.point)
zoom-to(cell-length * event.scale)
if event.phase == ScrollPhase.ended || event.phase == ScrollPhase.cancelled
    end-zoom()
event.cancel()

────────────────────
+ do scroll-to-top

rows.restore-scroll(Point(0, 0))

────────────────────
+ do select
    - path Path

if selected != path
    selected = path
reveal-path(path)
chosen <- path

────────────────────
+ do open
    - path Path

select(path)
opened <- path

────────────────────
+ do select-index
    - index Int

=? if paths.length == 0
select(paths[max(0, min(index, (paths.length as Int) - 1)) as Size])

────────────────────
+ do move-selection
    - offset Int

. current = selected-index
if current == null
    select-index(0)
    =
. next = current + offset
=? if next < 0 || next >= (paths.length as Int)
select-index(next)

────────────────────
+ do open-selected

. current = selected
if current
    open(current)

────────────────────
+ get selected-index Int?

match current
    |= null
        null
    ??
        first((each as Int) in 0 .. < paths.length when paths[each] == current)

.. current = selected

────────────────────
_ do note-scroll
    - event ScrollChangedEvent

. delta = event.position.y - event.old-position.y
if delta != 0
    is-scrolling-up = delta < 0

────────────────────
_ do reveal-path
    - path Path

=? if !is-live
for index in 0 .. < paths.length
    if paths[index] == path
        . ignored = rows.scroll-to-address(index, ScrollAlignment.nearest)
        =

────────────────────
_ do paths-changed

path-source.replace(paths)

────────────────────
+ do mounted

super.mounted()
is-live = true
path-source.replace(paths)

────────────────────
+ do unmounted

is-live = false
super.unmounted()

────────────────────
+ do reveal-focus

. current = selected
if current
    reveal-path(current)
else
    super.reveal-focus()

────────────────────
+ do close

super.close()
owned-cache?.close()
owned-cache = null

━━━━━━━━━━━━━━━━━━━━
+ ThumbnailCell is Box
    is ThumbnailClient
    using GUIThumbnailStyle

+ grid ThumbnailGrid?
+ path Path?
+ address I64
+ is-bound = false
+ is-selected = #is-bound && #path != null && #grid?.#selected == #path
+ stack-size = thumbnail-stack-size(#grid?.#stack-sizes, #path, #is-bound)

_ shown ThumbnailTicket?
_ wanted ThumbnailTicket?
_ ticket-path Path?
_ ticket-cache ThumbnailCache?
_ pixel-size I32

. thumbnail-changed < grid, path, is-bound
. invalidate-paint < stack-size

────────────────────
for event on pointer-down

handle-pointer-down(event)

────────────────────
+ get image Image?

shown?.image

────────────────────
_ do handle-pointer-down
    - event PointerDownEvent

. owner = grid
. target = path
=? if event.button != PointerButton.primary || !owner || !target || !is-bound
if event.click-count >= 2
    owner.open(target)
else
    owner.select(target)

────────────────────
_ do thumbnail-changed

. owner = grid
. target = path
if !owner || !target || !is-bound
    release-tickets()
    =
. cache = owner.thumbnail-cache
if ticket-path != target || ticket-cache as Pointer? != cache as Pointer
    release-tickets()
    ticket-path = target
    ticket-cache = cache
    shown = cache.ready-ticket(target, this)
    invalidate-paint()
=? if pixel-size <= 0
. bucket = cache.bucket-for(pixel-size)
if shown?.entry.bucket == bucket
    drop-wanted()
    =
=? if wanted?.entry.bucket == bucket
drop-wanted()
. ticket = cache.request(target, pixel-size, this)
if ticket.is-settled
    adopt(ticket)
else
    wanted = ticket

────────────────────
_ do adopt
    - ticket ThumbnailTicket

. previous = shown
shown = ticket
if previous
    ticket-cache?.cancel(previous)
invalidate-paint()

────────────────────
_ do drop-wanted

. pending = wanted
=? if !pending
wanted = null
ticket-cache?.cancel(pending)

────────────────────
_ do release-tickets

drop-wanted()
. previous = shown
if previous
    shown = null
    ticket-cache?.cancel(previous)
    invalidate-paint()
ticket-path = null
ticket-cache = null

────────────────────
+ thumbnail-priority F64
    - ticket ThumbnailTicket

if owner then owner.thumbnail-priority(address) else 0

.. owner = grid

────────────────────
+ do thumbnail-loaded
    - ticket ThumbnailTicket

if wanted && wanted as Pointer == ticket as Pointer
    wanted = null
    adopt(ticket)
else if shown && shown as Pointer == ticket as Pointer
    invalidate-paint()

────────────────────
+ do unmounted

release-tickets()
super.unmounted()

────────────────────
+ do did-layout

super.did-layout()
. content = content-bounds
. scale = ancestor'Window()?.backing-scale ?? 1
. size = ceil(max(content.width, content.height) * scale) as I32
if size != pixel-size
    pixel-size = size
    thumbnail-changed()

────────────────────
+ do close

release-tickets()
super.close()

────────────────────
+ do paint-self
    - canvas Canvas

. content = content-bounds
=? if content.width <= 0 || content.height <= 0
. current = shown?.image
if !current || current.is-released
    do use canvas.saved-state
        canvas.stroke-color = null
        canvas.fill-color = $thumbnail-placeholder-color
        canvas.rect(content)
    =
. depth = if stack-size > 1 then min(content.width, content.height) * thumbnail-stack-depth else 0
. fitted = image-fit-rect
    - current.size
    - Rect(content.x, content.y, content.width - depth * 2, content.height - depth * 2)
    - ImageFit.contain
    - AnchorPoint.center
    - AnchorPoint.center
. rect = Rect
    - content.x + (content.width - fitted.width - depth * 2) / 2
    - content.y + (content.height - fitted.height - depth * 2) / 2 + depth * 2
    - fitted.width
    - fitted.height
. backdrop = if depth > 0 then $thumbnail-stack-color else $thumbnail-backdrop-color
do use canvas.saved-state
    canvas.fill-color = $thumbnail-stack-color
    canvas.stroke-color = $thumbnail-stack-edge-color
    canvas.stroke-width = 1
    if depth > 0
        for layer in [2.0, 1.0]
            canvas.rect
                - Rect(rect.x + depth * layer, rect.y - depth * layer, rect.width, rect.height)
    if backdrop.alpha > 0
        canvas.fill-color = backdrop
        canvas.rect(rect)
current.draw • destination canvas
    - rect
    - ImageSampling.smooth

━━━━━━━━━━━━━━━━━━━━
_ thumbnail-grid-layout VerticalGridLayout
    - cell-length Length
    - spacing Length

VerticalGridLayout(max(1, floor(cell-length)) as I64, max(0, floor(spacing)) as I64)

━━━━━━━━━━━━━━━━━━━━
_ thumbnail-grid-overscan VirtualInsets
    - cell-length Length
    - spacing Length

VirtualInsets(pitch, 0vcoord, pitch, 0vcoord)

.. pitch = (max(1, floor(cell-length)) + max(0, floor(spacing))) as I64

━━━━━━━━━━━━━━━━━━━━
_ thumbnail-stack-size Size
    - sizes [Path = Size]?
    - path Path?
    - is-bound Bool

if is-bound && sizes && path then sizes[path] ?? 1 else 1
