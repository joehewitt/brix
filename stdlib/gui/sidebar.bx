(import ./box)
(import ./button)
(import ./events)
(import ./icon-button)
(import ./icons/lucide/chevron-right)
(import ./list-box)
(import ./primitives)
(import ./resizer)
(import ./shorthands)
(import ./styles)
(import ./theme)
(import ./timeline)
(import ./tree-box)
(import ./virtual)
(import /data/json)
(import /graphics/color)
(import /graphics/primitives)
(import /graphics/style)
(import /graphics/text)
(import /math)
(blank)
(prop + gui-sidebar-row-inset Length (= 10))
(prop + gui-sidebar-row-radius Length (= 7))
(prop + gui-sidebar-icon-gap Length (= 6))

(style-extend GUIDefaultTheme
  (using GUIBoxCursor)
  (using GUIBoxDisplay)
  (using GUIBoxLayout)
  (using GUIBoxMotion)
  (using GUIBoxPaint)
  (using GUIBoxPlacement)
  (using GUIBoxSize)
  (using GUIBoxSpacing)
  (using GUIFontStyle)
  (using GUITextPaint)
  (using GUIVirtualRowStyle)
  (using VectorPaintStyle)
  (rule Sidebar (• bg gui-panel-color) (• text gui-text-color)
    (= border-color gui-divider-color)
    (= border-right-width 1)
    (= (. motion size) gui-motion-quick)
    (= enter-space (. EnterSpace expand))
    (= leave-space (. LeaveSpace collapse))
    (blank)
    (when-style #is-collapsed
      (= display (. Display hidden))
    )
    (blank)
    (when-style #is-focus-within
      (rule SidebarItem
        (when-style #is-on
          (• bg gui-accent-color)
          (• text gui-accent-text-color)
        )
      )
    )
    (blank)
    (rule sidebar-header-divider (• absolute) (• h 1) (• bg gui-divider-color)
      (= animation fade-in)
    )
    (blank)
    (rule SidebarSection (• pb 12)
      (rule sidebar-section-list
        (= gap 2)
      )
    )
    (blank)
    (rule TreeBox (• sidebar-tree))
    (blank)
    (rule ListItem (• sidebar-row))
    (blank)
    (rule SidebarFooter
      (= border-color gui-divider-color)
      (= border-top-width 1)
      (blank)
      (when-style (not #has-content)
        (= display (. Display hidden))
      )
    )
  )
  (blank)
  (rule sidebar-tree
    (= row-height 28)
    (blank)
    (rule TreeBoxDisclosure (• mr gui-sidebar-icon-gap))
    (blank)
    (rule ListItem (• sidebar-row))
    (blank)
    (when-style #is-focused
      (rule ListItem
        (when-style #is-selected
          (• bg gui-accent-color)
          (• text gui-accent-text-color)
        )
      )
    )
  )
  (blank)
  (rule sidebar-row (• text gui-text-color) (• mx gui-sidebar-row-inset) (• h 28)
    (= corner-radius gui-sidebar-row-radius)
    (blank)
    (when-style #is-hover-within
      (• bg gui-hover-color)
    )
    (blank)
    (when-style #is-selected
      (• bg gui-pressed-color)
      (• text gui-strong-text-color)
    )
  )
  (blank)
  (rule SidebarItem (• bg transparent) (• text gui-text-color) (• h 28) (• mx gui-sidebar-row-inset) (• pl tree-box-row-inset) (• pr 8)
    (= shadow null)
    (= font-size inherit)
    (= corner-radius gui-sidebar-row-radius)
    (= cursor (. CursorStyle pointing-hand))
    (blank)
    (when-style #is-hover-within
      (• bg gui-hover-color)
    )
    (blank)
    (when-style #is-press-within
      (• bg gui-pressed-color)
    )
    (blank)
    (when-style #is-on
      (• bg gui-pressed-color)
      (• text gui-strong-text-color)
    )
    (blank)
    (rule button-content
      (= align-x null)
    )
    (blank)
    (rule button-title (• flex 1))
    (blank)
    (rule icon (• w tree-box-chevron-width) (• h tree-box-chevron-width) (• mr gui-sidebar-icon-gap))
  )
  (blank)
  (rule SidebarSectionHeader (• group-heading) (• mb 2)
    (blank)
    (when-style #is-hover-within
      (• bg transparent)
      (• text gui-text-color)
      (blank)
      (rule icon
        (= display (. Display visible))
      )
    )
    (blank)
    (when-style #is-press-within
      (• bg transparent)
    )
    (blank)
    (when-style #is-focus-visible
      (rule icon
        (= display (. Display visible))
      )
    )
    (blank)
    (rule button-title (• flex 0))
    (blank)
    (rule icon (• w 12) (• h 12) (• ml 4) (• mr 0)
      (= stroke-width 2)
      (= display (. Display hidden))
    )
  )
)

(type + Sidebar (is Box)
  (prop + resize-edge (? Side))
  (prop + state-key (? String))
  (prop + collapse-size (? Length))
  (prop + is-collapsed _ (= false))
  (blank)
  (depends collapse-changed is-collapsed)
  (blank)
  (rule sidebar-body)
  (content
    (<> This (• flex-col)
      (<> Box (id: heading) (• flex-col)
        (+<> Box (id: header) (• flex-col))
        (<> Box (id: header-divider) (• sidebar-header-divider)
          (= left (call (. PositionOffset coord) 0))
          (= right (call (. PositionOffset coord) 0))
          (= bottom (call (. PositionOffset coord) 0))
        )
      )
      (+<> Box (• sidebar-body) (• flex-col) (• flex 1)
        (= overflow-y (. ScrollOverflow auto))
      )
      (<> SidebarFooter (• flex-row)
        (+<> Box (id: footer) (• flex-row) (• flex 1))
      )
      (if (!= #resize-edge null)
        (<> Resizer
          (= edge (!! #resize-edge))
          (= state-key #state-key)
          (= collapse-size #collapse-size)
          (for (on event collapse-requested)
            (= is-collapsed true)
          )
        )
      )
    )
  )
  (fn-do + mounted _
    (call (. super mounted))
    (call restore-collapse)
    (= (. header-divider timeline) (call scroll-timeline (.. 0 12) (call scrolling-body)))
  )
  (fn-do + toggle _
    (= is-collapsed (not is-collapsed))
  )
  (fn-do _ scrolling-body (? Box)
    (let after false)
    (for (in child children)
      (return-if (as child Box) (if (and after (is child Box))))
      (blank)
      (= after (== (as child Pointer) (as heading Pointer)))
    )
    (return null)
  )
  (fn-expr _ storage-key (? String) :get
    (only-if (str "sidebar:" state-key) (if state-key))
  )
  (fn-do _ restore-collapse _
    (let key storage-key)
    (let store (call gui-app-state this))
    (return-if (if (or (not key) (not store))))
    (blank)
    (let saved (call (. store read) key 1))
    (return-if (if (not saved)))
    (blank)
    (let collapsed (catch? (call (. (call JSONReader "sidebar" saved) bool))))
    (if (!= collapsed null)
      (= is-collapsed collapsed)
    )
  )
  (fn-do _ collapse-changed _
    (let key storage-key)
    (let store (call gui-app-state this))
    (return-if (if (or (not key) (not store))))
    (blank)
    (call (. store write) key 1 is-collapsed)
  )
)

(type + SidebarFooter (is Box)
  (prop + has-content _ (= false))
  (whenever-rule (trigger descendants Box)
    (= has-content (!= (?. %first-child %first-child) null))
  )
)

(type + SidebarSection (is Box)
  (prop + title _ (= ""))
  (prop + is-expanded _ (= true))
  (blank)
  (rule This (• flex-col)
    (rule sidebar-section-list (• flex-col))
  )
  (fn-do + This _
    (param title _ (= ""))
  )
  (content
    (<> This
      (if (!= #title "")
        (<> SidebarSectionHeader (id: header)
          (= title #title)
          (= is-expanded #is-expanded)
          (= action (=> () :do (call toggle)))
        )
      )
      (blank)
      (+<> Box (• sidebar-section-list)
        (= display (if-expr #is-expanded (. Display visible) (. Display hidden)))
      )
    )
  )
  (fn-do + toggle _
    (= is-expanded (not is-expanded))
  )
)

(type + SidebarItem (is Button)
  (implements Choosing)
  (fn-expr + can-choose Bool :get
    true
  )
  (fn-do + activate Bool
    (return-if false (if (not (call (. super activate)))))
    (blank)
    (if can-choose
      (<- chosen (call ChooseEvent))
    )
    (return true)
  )
)

(type + SidebarSectionHeader (is SidebarItem)
  (prop + is-expanded _ (= true))
  (blank)
  (rule This
    (rule button-title
      (<> LucideChevronRight (slot: after) (• icon) (• sidebar-section-chevron))
    )
    (blank)
    (rule sidebar-section-chevron
      (= (. motion rotate) gui-motion-quick)
    )
    (blank)
    (when-style #is-expanded
      (rule sidebar-section-chevron
        (= rotate (/ π 2))
      )
    )
  )
  (fn-expr + can-choose _ :get
    false
  )
)
