    - event KeyReleaseEvent

matches-key(event.key, event.characters, event.modifiers)

────────────────────
+ matches Bool
    - event KeyInputEvent

matches-text(event.text)

────────────────────
+ matches-shift Bool
    - event KeyPressEvent

modifiers.shift == event.modifiers.shift

━━━━━━━━━━━━━━━━━━━━
_ shortcut-status-label String
    - key KeyCombo
    - title String

if label then "$label $title" else title

.. label = key.display-label

