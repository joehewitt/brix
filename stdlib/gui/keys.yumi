this as Pointer

────────────────────
+ do run

=? if !is-active
. callback = action
if callback
    callback()
        catch error Error
            unhandled-error(error)

────────────────────
+ get command-target

this as Command

────────────────────
+ do press
    - event KeyPressEvent

=? if event.is-repeat && !repeat
run()

━━━━━━━━━━━━━━━━━━━━
+ KeyCommandActivation is Union

| press
| tap

━━━━━━━━━━━━━━━━━━━━
+ KeyCommand is KeyBinding

+ repeat = true
+ command Command?
+ activation = KeyCommandActivation.press
+ tap-threshold = 200ms

_ armed-native-key-code U32
_ tap-deadline Deadline?

────────────────────
+ This
    - title = ""

────────────────────
+ get display-title

command?.title ?? title

────────────────────
+ get is-active

is-effectively-enabled && key-command-predicate-enabled(enabled, when, command)

────────────────────
+ get command-target

command

────────────────────
+ get part

|? activation == KeyCommandActivation.tap
    KeyPart.tap
??
    KeyPart.press

────────────────────
+ do press
    - event KeyPressEvent

if activation == KeyCommandActivation.tap
    if !event.is-repeat
        armed-native-key-code = event.native-key-code
        tap-deadline = Deadline(tap-threshold)
    =
=? if event.is-repeat && !repeat
command?.run()

────────────────────
+ do release
    - event KeyReleaseEvent

=? if !tap-deadline || event.native-key-code != armed-native-key-code
. is-tap = !tap-deadline.has-passed
tap-deadline = null
if is-tap && is-active
    command?.run()

────────────────────
+ do pointer-pressed

tap-deadline = null

────────────────────
+ do release-active

tap-deadline = null

