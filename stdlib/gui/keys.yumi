+ cut-key := KeyCombo("Cmd+X")
+ copy-key := KeyCombo("Cmd+C")
+ paste-key := KeyCombo("Cmd+V")
+ undo-key := KeyCombo("Cmd+Z")
+ redo-key := KeyCombo("Cmd+Shift+Z")

