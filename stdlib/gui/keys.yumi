+ is-routable Bool
    - focused Box?
    - modal Box?

is-input-visible && key-assignment-routable(this, input-owned, outside-modal)

.. input-owned = focused?.$focus-mode == FocusMode.input && key.is-text-input()
.. outside-modal = modal != null && !is-within(modal)

