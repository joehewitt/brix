(import ./box)
(import ./events)
(import ./window)
(import /graphics/canvas)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/surface)
(import /os/mach-port)
(import /os/message-channel)
(import /stream/aggregate)
(import /time/timer)
(import /ui/input)
(import /unistd.h)
(blank)
(prop + surface-ring-size Size (= 3))
(prop + surface-rendezvous-variable _ (= "BRIX_SURFACE_RENDEZVOUS"))
(prop _ surface-view-rendezvous-count U64)

(type + SurfaceMessageKind (is U32)
  (variant surfaces (= 1))
  (variant frame (= 2))
  (variant release (= 3))
  (variant size (= 4))
  (variant pointer (= 5))
  (variant starved (= 6))
  (variant key (= 7))
  (variant text (= 8))
  (variant focus (= 9))
  (variant app (= 64))
)

(type + SurfaceKeyPhase (is U32)
  (variant press (= 0))
  (variant release (= 1))
)

(type + SurfaceKeyRecord (is Tuple)
  (prop + phase SurfaceKeyPhase)
  (prop + key U32)
  (prop + native-key-code U32)
  (prop + is-repeat U32)
  (prop + modifier-bits U64)
  (fn-expr + modifiers PointerModifiers :get
    (call pointer-modifiers-from-native modifier-bits)
  )
)

(type + SurfaceTextAction (is U32)
  (variant input (= 0))
  (variant command (= 1))
  (variant composition (= 2))
)

(type + SurfaceTextRecord (is Tuple)
  (prop + action SurfaceTextAction)
  (prop + start U32)
  (prop + length U32)
  (prop + spare U32)
)

(type + SurfaceFocusRecord (is Tuple)
  (prop + is-focused U32)
  (prop + spare U32)
)

(type + SurfaceSetReport (is Tuple)
  (prop + generation U32)
  (prop + count U32)
  (prop + pixel-width I32)
  (prop + pixel-height I32)
  (prop + scale F64)
)

(type + SurfaceFrameReport (is Tuple)
  (prop + frame U64)
  (prop + generation U32)
  (prop + slot U32)
  (prop + finished U64)
  (prop + rendered U64)
)

(type + SurfaceSlot (is Tuple)
  (prop + generation U32)
  (prop + slot U32)
)

(type + SurfaceSizeRequest (is Tuple)
  (prop + width F64)
  (prop + height F64)
  (prop + scale F64)
)

(type + SurfaceSender
  (implements Closable)
  (prop + channel MessageChannel)
  (prop + host MachPort)
  (prop + generation U32)
  (prop + wanted (? SurfaceSizeRequest))
  (prop + frames-sent Size)
  (prop + frames-skipped Size)
  (prop _ surfaces (list SharedSurface))
  (prop _ held (list Bool))
  (prop _ drawing (? Index))
  (prop _ next-frame U64 (= 1))
  (fn-do + This _ (?! IOError)
    (param channel MessageChannel)
    (param rendezvous String)
    (return (call This channel (call MachPort rendezvous)))
  )
  (fn-do _ This _
    (param channel _)
    (param host _)
  )
  (fn-do + resize _ (?! IOError)
    (param pixel-width I32)
    (param pixel-height I32)
    (param scale F64)
    (call release-surfaces)
    (+= generation 1)
    (let ports (list U32))
    (for (in index (..< 0 surface-ring-size))
      (let surface (call SharedSurface pixel-width pixel-height))
      (+= surfaces surface)
      (+= held false)
      (+= ports (call (. surface make-port)))
    )
    (let report (call SurfaceSetReport generation (as surface-ring-size U32) pixel-width pixel-height scale))
    (throw (call IOError "Unable to send surfaces to the host") (if (not (call (. host send) ports &report (. SurfaceSetReport size)))))
    (call (. channel send-record) (. SurfaceMessageKind surfaces) report)
  )
  (fn-do + acquire (? SharedSurface)
    (for (in index (..< 0 (. surfaces length)))
      (if (not ([] held index))
        (= ([] held index) true)
        (= drawing index)
        (return ([] surfaces index))
      )
    )
    (+= frames-skipped 1)
    (call (. channel send) (. SurfaceMessageKind starved))
    (return null)
  )
  (fn-do + deliver _
    (param rendered U64)
    (let slot drawing)
    (return-if (if (== slot null)))
    (= drawing null)
    (let report
      (call SurfaceFrameReport
        (block
          (arg next-frame)
          (arg generation)
          (arg (as slot U32))
          (arg (call monotonic-time-nanoseconds))
          (arg rendered)
        )
      )
    )
    (+= next-frame 1)
    (+= frames-sent 1)
    (call (. channel send-record) (. SurfaceMessageKind frame) report)
  )
  (fn-do + abandon _
    (let slot drawing)
    (return-if (if (== slot null)))
    (= ([] held slot) false)
    (= drawing null)
  )
  (fn-do + handle Bool
    (param message Message)
    (match (as (. message kind) SurfaceMessageKind)
      (case= .release
        (let released (call (of (. message record) SurfaceSlot)))
        (if (and released (== (. released generation) generation) (< (. released slot) (. held length)))
          (= ([] held (. released slot)) false)
        )
        (return true)
      )
      (case= .size
        (= wanted (?? (call (of (. message record) SurfaceSizeRequest)) wanted))
        (return true)
      )
      (default
        (return false)
      )
    )
  )
  (fn-do _ release-surfaces _
    (for (in surface surfaces)
      (call (. surface close))
    )
    (call (. surfaces clear))
    (call (. held clear))
    (= drawing null)
  )
  (fn-do + close _
    (call release-surfaces)
    (call (. host close))
  )
)

(type _ SurfaceSet
  (prop + generation U32)
  (prop + canvases (list (? RasterCanvas)))
  (fn-do + This _
    (param generation _)
    (param canvases _)
  )
  (fn-do + close _
    (for (in canvas canvases)
      (call (?. canvas close))
    )
    (call (. canvases clear))
  )
)

(type _ SurfaceRetiree (is Tuple)
  (prop + generation U32)
  (prop + slot U32)
  (prop + after I64)
)

(type + SurfaceView (is Box)
  (rule This
    (= focus-mode (. FocusMode input))
  )
  (blank)
  (prop + rendezvous (? MachRendezvous))
  (prop + channel (? MessageChannel))
  (prop + sender I32)
  (prop + shown (? SurfaceFrameReport))
  (prop + shown-at U64)
  (prop + frames-received Size)
  (prop + frames-shown Size)
  (prop + frames-unseen Size)
  (event + first-frame SurfaceFrameReport)
  (prop _ sets (list SurfaceSet))
  (prop _ pending (? SurfaceFrameReport))
  (prop _ retired (list SurfaceRetiree))
  (prop _ requested (? SurfaceSizeRequest))
  (prop _ awaits-first _ (= false))
  (blank)
  (depends hover-changed is-hovered)
  (depends focus-changed is-focused)
  (fn-do + listen String (?! IOError)
    (call (?. rendezvous close))
    (+= surface-view-rendezvous-count 1)
    (let opened (call MachRendezvous (str "com.yumi.surface." (call C:getpid) "." surface-view-rendezvous-count)))
    (= rendezvous opened)
    (return (. opened name))
  )
  (fn-do + connect _
    (param channel MessageChannel)
    (param sender I32)
    (call retire-session)
    (= (. this channel) channel)
    (= (. this sender) sender)
    (= requested null)
    (= awaits-first true)
    (call request-size)
    (call focus-changed)
  )
  (fn-do + disconnect _
    (= channel null)
    (= pending null)
    (call (. retired clear))
  )
  (fn-expr + shown-image (? RasterCanvas) :get
    (only-if (call canvas-for (. current generation) (. current slot)) (if current))
    (where
      (lazy current shown)
    )
  )
  (fn-do + handle Bool
    (param message Message)
    (match (as (. message kind) SurfaceMessageKind)
      (case= .surfaces
        (call collect-surfaces)
        (return true)
      )
      (case= .frame
        (let report (call (of (. message record) SurfaceFrameReport)))
        (if report
          (call receive-frame report)
        )
        (return true)
      )
      (case= .starved
        (call release-retired)
        (return true)
      )
      (default
        (return false)
      )
    )
  )
  (fn-do + request-size _
    (let open channel)
    (return-if (if (not open)))
    (let content content-bounds)
    (return-if (if (or (<= (. content width) 0) (<= (. content height) 0))))
    (let wanted (call SurfaceSizeRequest (. content width) (. content height) backing-scale))
    (let last requested)
    (if last
      (return-if (if (and (== (. last width) (. wanted width)) (== (. last height) (. wanted height)) (== (. last scale) (. wanted scale)))))
    )
    (= requested wanted)
    (call (. open send-record) (. SurfaceMessageKind size) wanted)
  )
  (fn-expr _ backing-scale F64 :get
    (if-expr host (. (as host Window) backing-scale) 1)
    (where
      (lazy host window)
    )
  )
  (fn-expr _ last-frame-id I64 :get
    (if-expr host (. (as host Window) last-metal-frame-id) -1)
    (where
      (lazy host window)
    )
  )
  (fn-expr _ completed-frame-id I64 :get
    (if-expr host (. (as host Window) completed-metal-frame-id) -1)
    (where
      (lazy host window)
    )
  )
  (fn-do _ retire-session _
    (let current shown)
    (let index Size 0)
    (while (< index (. sets length))
      (let set ([] sets index))
      (if (and current (== (. set generation) (. current generation)))
        (= (. set generation) 0)
        (+= index 1)
        (else
          (call (. set close))
          (call (. sets remove) index)
        )
      )
    )
    (= pending null)
    (call (. retired clear))
    (if current
      (= shown (call SurfaceFrameReport (. current frame) 0 (. current slot) (. current finished) (. current rendered)))
    )
  )
  (fn-do _ collect-surfaces _
    (let listening rendezvous)
    (return-if (if (not listening)))
    (while true
      (let parcel (call (. listening receive)))
      (return-if (if (not parcel)))
      (if (or (!= (. parcel sender) sender) (< (. parcel bytes size) (. SurfaceSetReport size)))
        (for (in right (. parcel ports))
          (call release-mach-right right)
        )
        (else
          (call install parcel)
        )
      )
    )
  )
  (fn-do _ install _
    (param parcel MachParcel)
    (let report ([] (as (. parcel bytes data) (of CPointer SurfaceSetReport)) 0))
    (let canvases (list (? RasterCanvas)))
    (for (in right (. parcel ports))
      (let surface (call shared-surface-from-port right))
      (if surface
        (+= canvases (call (. surface canvas) (. report scale)))
        (call (. surface close))
        (else
          (+= canvases null)
        )
      )
    )
    (+= sets (call SurfaceSet (. report generation) canvases))
  )
  (fn-expr _ canvas-for (? RasterCanvas)
    (param generation U32)
    (param slot U32)
    (match found
      (case= null
        null
      )
      (case? (>= slot (. it canvases length))
        null
      )
      (default
        ([] (. it canvases) slot)
      )
    )
    (where
      (lazy found (call first (in each sets (when (== (. each generation) generation)))))
    )
  )
  (fn-do _ receive-frame _
    (param report SurfaceFrameReport)
    (+= frames-received 1)
    (call release-retired)
    (if (not (call canvas-for (. report generation) (. report slot)))
      (call release (. report generation) (. report slot))
      (return)
    )
    (let previous pending)
    (if previous
      (call release (. previous generation) (. previous slot))
      (+= frames-unseen 1)
    )
    (= pending report)
    (call invalidate-paint)
  )
  (fn-do _ release _
    (param generation U32)
    (param slot U32)
    (let open channel)
    (return-if (if (not open)))
    (call (. open send-record) (. SurfaceMessageKind release) (call SurfaceSlot generation slot))
  )
  (fn-do _ release-retired _
    (let completed completed-frame-id)
    (let index Size 0)
    (while (< index (. retired length))
      (let entry ([] retired index))
      (if (<= (. entry after) completed)
        (call release (. entry generation) (. entry slot))
        (call (. retired remove) index)
        (else
          (+= index 1)
        )
      )
    )
    (call prune-sets)
  )
  (fn-do _ prune-sets _
    (return-if (if (< (. sets length) 2)))
    (let newest (. ([] sets (- (. sets length) 1)) generation))
    (let index Size 0)
    (while (< index (. sets length))
      (let set ([] sets index))
      (if (and (!= (. set generation) newest) (not (call is-referenced (. set generation))))
        (call (. set close))
        (call (. sets remove) index)
        (else
          (+= index 1)
        )
      )
    )
  )
  (fn-expr _ is-referenced Bool
    (param generation U32)
    (or (== (?. shown generation) generation) (== (?. pending generation) generation) is-retired)
    (where
      (lazy is-retired (call some retired (:where (== (. each generation) generation))))
    )
  )
  (fn-do _ advance _
    (let next pending)
    (return-if (if (not next)))
    (= pending null)
    (let previous shown)
    (if previous
      (+= retired (call SurfaceRetiree (. previous generation) (. previous slot) last-frame-id))
    )
    (= shown next)
    (= shown-at (call monotonic-time-nanoseconds))
    (+= frames-shown 1)
    (call (?. (call canvas-for (. next generation) (. next slot)) surface-changed))
    (if awaits-first
      (= awaits-first false)
      (<- first-frame next)
    )
  )
  (subscribe-for (on event pointer-down)
    (call send-record (. PointerRecordKind down) event (call Point 0 0) (. event button) (. event click-count))
  )
  (subscribe-for (on event pointer-up)
    (call send-record (. PointerRecordKind up) event (call Point 0 0) (. event button))
    (call (. event cancel))
  )
  (subscribe-for (on event pointer-drag)
    (call send-record (. PointerRecordKind drag) event (. event delta) (. event button))
    (call (. event cancel))
  )
  (subscribe-for (on event pointer-move)
    (call send-record (. PointerRecordKind move) event (. event delta))
  )
  (subscribe-for (on event scroll)
    (call send-record
      (block
        (arg (. PointerRecordKind scroll))
        (arg event)
        (arg (. event delta))
        (arg (. PointerButton primary))
        (arg 0)
        (arg (. event is-precise))
        (arg (. event phase))
        (arg (. event momentum-phase))
      )
    )
    (call (. event cancel))
  )
  (subscribe-for (on event magnify)
    (call send-record
      (block
        (arg (. PointerRecordKind magnify))
        (arg event)
        (arg (call Point (. event magnification) 0))
        (arg (. PointerButton primary))
        (arg 0)
        (arg false)
        (arg (. event phase))
      )
    )
    (call (. event cancel))
  )
  (subscribe-for (on event key-press)
    (call send-key
      (block
        (arg (. SurfaceKeyPhase press))
        (arg (. event key))
        (arg (. event native-key-code))
        (arg (. event modifiers))
        (arg (. event is-repeat))
        (arg (. event characters))
      )
    )
    (call (. event cancel))
  )
  (subscribe-for (on event key-release)
    (call send-key
      (block
        (arg (. SurfaceKeyPhase release))
        (arg (. event key))
        (arg (. event native-key-code))
        (arg (. event modifiers))
        (arg false)
        (arg (. event characters))
      )
    )
    (call (. event cancel))
  )
  (subscribe-for (on event key-input)
    (call send-text (. SurfaceTextAction input) (. event text) (. event replaces-before) (. event replaces-length))
    (call (. event cancel))
  )
  (subscribe-for (on event text-composition)
    (call send-text (. SurfaceTextAction composition) (. event text) (. event selection-start) (. event selection-length))
    (call (. event cancel))
  )
  (subscribe-for (on event text-command)
    (call send-text (. SurfaceTextAction command) (. event selector))
    (call (. event cancel))
  )
  (fn-do _ hover-changed _
    (return-if (if is-hovered))
    (call (?. channel send-record) (. SurfaceMessageKind pointer) (call PointerRecord (. PointerRecordKind exit) (call Point 0 0)))
  )
  (fn-do _ focus-changed _
    (call (?. channel send-record)
      (block
        (arg (. SurfaceMessageKind focus))
        (arg (call SurfaceFocusRecord (if-expr is-focused 1u32 0u32) 0))
      )
    )
  )
  (fn-do _ send-key _
    (param phase SurfaceKeyPhase)
    (param key Key)
    (param native-key-code U32)
    (param modifiers PointerModifiers)
    (param is-repeat Bool)
    (param characters String)
    (let record
      (call SurfaceKeyRecord
        (block
          (arg phase)
          (arg (call key-to-native key))
          (arg native-key-code)
          (arg (if-expr is-repeat 1u32 0u32))
          (arg (call pointer-modifiers-to-native modifiers))
        )
      )
    )
    (call (?. channel send-record) (. SurfaceMessageKind key) record (as characters Pointer) (. characters size))
  )
  (fn-do _ send-text _
    (param action SurfaceTextAction)
    (param text String)
    (param start Size (= 0))
    (param length Size (= 0))
    (lazy record (call SurfaceTextRecord action (as start U32) (as length U32) 0))
    (call (?. channel send-record) (. SurfaceMessageKind text) record (as text Pointer) (. text size))
  )
  (fn-do _ send-record _
    (param kind PointerRecordKind)
    (param event GUIEvent)
    (param delta Point)
    (param button PointerButton (= (. PointerButton primary)))
    (param click-count U32 (= 0))
    (param is-precise _ (= false))
    (param phase _ (= (. ScrollPhase none)))
    (param momentum-phase _ (= (. ScrollPhase none)))
    (let open channel)
    (return-if (if (not open)))
    (let record
      (call PointerRecord
        (block
          (arg kind)
          (arg (call content-point (. event point)))
          (arg delta)
          (arg (. event pointer-id))
          (arg (call pointer-device-kind-to-native (. event device-kind)))
          (arg (call pointer-button-to-native button))
          (arg (. event buttons))
          (arg (call pointer-modifiers-to-native (. event modifiers)))
          (arg (. event ordering-time))
          (arg click-count)
          (arg is-precise)
          (arg phase)
          (arg momentum-phase)
        )
      )
    )
    (call (. open send-record) (. SurfaceMessageKind pointer) record)
  )
  (fn-expr _ content-point Point
    (param point Point)
    (- point (- (. content-bounds top-left) (. bounds top-left)))
  )
  (fn-do + did-layout _
    (call (. super did-layout))
    (call request-size)
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (call advance)
    (call release-retired)
    (let current shown)
    (return-if (if (not current)))
    (let image (call canvas-for (. current generation) (. current slot)))
    (return-if (if (not image)))
    (call (. canvas draw-image) image content-bounds)
  )
  (fn-do + close _
    (for (in set sets)
      (call (. set close))
    )
    (call (. sets clear))
    (call (?. rendezvous close))
    (= rendezvous null)
    (call (. super close))
  )
)
