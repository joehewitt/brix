(import ./events)
(import /graphics/point)
(import /math)
(blank)
(prop _ glide-step F64 (= 0.008333))
(prop _ glide-substep F64 (= 0.004))
(prop _ glide-stop-speed F64 (= 0.12))
(prop _ glide-interrupt-speed F64 (= 2))

(type + ScrollResampler
  (prop + lag F64 (= 0.010))
  (prop + span F64 (= 0.0167))
  (blank)
  (prop _ events (list ScrollEvent))
  (prop _ starts (list F64))
  (prop _ spent F64)
  (prop _ last-time F64)
  (prop _ motion-time F64)
  (prop _ horizon F64)
  (prop _ glide (? ScrollEvent))
  (prop _ glide-time F64)
  (prop _ glide-velocity Point)
  (prop _ glide-end (? ScrollEvent))
  (prop _ is-gliding _ (= false))
  (prop _ is-glide-pending _ (= false))
  (prop _ is-overriding _ (= false))
  (prop _ momentum-step F64)
  (fn-expr + is-idle _ :get
    (and (== (. events length) 0) (not is-gliding) (not is-glide-pending))
  )
  (fn-do + accept Bool
    (param event ScrollEvent)
    (return-if false (if (<= lag 0)))
    (blank)
    (let time (. event ordering-time))
    (let momentum (. event momentum-phase))
    (if (and is-overriding (. event is-precise))
      (if (== momentum (. ScrollPhase changed))
        (= momentum-step (. event delta length))
        (return true)
      )
      (if (or (== momentum (. ScrollPhase ended)) (== momentum (. ScrollPhase cancelled)))
        (= is-overriding false)
        (let ended (call scroll-resampler-moved event (call Point 0 0)))
        (let is-natural (and (== momentum (. ScrollPhase ended)) (< momentum-step glide-interrupt-speed)))
        (if (and is-natural (or is-gliding is-glide-pending))
          (= glide-end ended)
          (else
            (call enqueue ended time)
          )
        )
        (return true)
      )
    )
    (if (or is-gliding is-glide-pending)
      (call enqueue event time)
      (return true)
    )
    (if (and (. event is-precise) (== momentum (. ScrollPhase began)))
      (= is-overriding true)
      (= is-glide-pending true)
      (= momentum-step (. event delta length))
      (call enqueue event time (call max horizon motion-time))
      (return true)
    )
    (if (and (== (. events length) 0) (not (and (. event is-precise) (call scroll-resampler-moves event))))
      (= last-time time)
      (return false)
    )
    (call enqueue event time)
    (return true)
  )
  (fn-do + take (list ScrollEvent)
    (param frame-time F64)
    (return-if (call drain) (if (<= frame-time 0)))
    (blank)
    (let taken (call (of List ScrollEvent)))
    (= horizon (call max horizon (- frame-time lag)))
    (while (> (. events length) 0)
      (let event ([] events 0))
      (let time (. event ordering-time))
      (let start ([] starts 0))
      (let begins-glide (and (. event is-precise) (== (. event momentum-phase) (. ScrollPhase began))))
      (if (and begins-glide (<= start horizon))
        (if is-gliding
          (call advance-glide start taken)
          (call finish-glide taken)
        )
        (call start-glide event start)
        (+= taken (call scroll-resampler-moved event (call Point 0 0)))
        (call pop)
        (else-if (<= time horizon)
          (if is-gliding
            (call advance-glide time taken)
            (call finish-glide taken)
          )
          (if (< spent 1)
            (+= taken (call scroll-resampler-part event (- 1 spent) true))
          )
          (call pop)
        )
        (else
          (if (and (not begins-glide) (call scroll-resampler-moves event))
            (let fraction (call min 1 (call max 0 (/ (- horizon start) (call max (- time start) 0.0001)))))
            (if (> fraction spent)
              (+= taken (call scroll-resampler-part event (- fraction spent) false))
              (= spent fraction)
            )
          )
          (break)
        )
      )
    )
    (if is-gliding
      (call advance-glide horizon taken)
    )
    (return taken)
  )
  (fn-do + drain (list ScrollEvent)
    (let taken (call (of List ScrollEvent)))
    (while (> (. events length) 0)
      (if (< spent 1)
        (+= taken (call scroll-resampler-part ([] events 0) (- 1 spent) true))
      )
      (call pop)
    )
    (call finish-glide taken)
    (return taken)
  )
  (fn-do _ enqueue _
    (param event ScrollEvent)
    (param time F64)
    (param since (? F64) (= null))
    (let previous (?? since last-time))
    (let start (if-expr (> previous 0) (call max previous (- time span)) (- time span)))
    (+= events event)
    (+= starts (call min start time))
    (= last-time time)
    (if (call scroll-resampler-moves event)
      (= motion-time time)
    )
  )
  (fn-do _ pop _
    (call (. events remove) 0)
    (call (. starts remove) 0)
    (= spent 0)
  )
  (fn-do _ start-glide _
    (param event ScrollEvent)
    (param time F64)
    (= is-glide-pending false)
    (= is-gliding true)
    (= glide event)
    (= glide-time time)
    (= glide-velocity (call Point (/ (. event delta-x) glide-step) (/ (. event delta-y) glide-step)))
  )
  (fn-do _ advance-glide _
    (param time F64)
    (param taken (list ScrollEvent))
    (let template glide)
    (return-if (if (or (not template) (<= time glide-time))))
    (blank)
    (let delta-x F64)
    (let delta-y F64)
    (let velocity glide-velocity)
    (let remaining (- time glide-time))
    (while (> remaining 0)
      (let speed (* (. velocity length) glide-step))
      (if (< speed glide-stop-speed)
        (= is-gliding false)
        (break)
      )
      (let step (call min remaining glide-substep))
      (let rate (/ (- (call log (call scroll-resampler-decay speed))) glide-step))
      (let kept (call exp (* (- rate) step)))
      (+= delta-x (/ (* (. velocity x) (- 1 kept)) rate))
      (+= delta-y (/ (* (. velocity y) (- 1 kept)) rate))
      (= velocity (call Point (* (. velocity x) kept) (* (. velocity y) kept)))
      (-= remaining step)
    )
    (= glide-velocity velocity)
    (= glide-time time)
    (if (or (!= delta-x 0) (!= delta-y 0))
      (+= taken
        (call ScrollEvent
          (block
            (arg (. template data))
            (arg delta-x)
            (arg delta-y)
            (arg true)
            (arg (. ScrollPhase none))
            (arg (. ScrollPhase changed))
          )
        )
      )
    )
    (if (not is-gliding)
      (call finish-glide taken)
    )
  )
  (fn-do _ finish-glide _
    (param taken (list ScrollEvent))
    (= is-gliding false)
    (= is-glide-pending false)
    (= glide null)
    (let end glide-end)
    (if end
      (= glide-end null)
      (+= taken end)
    )
  )
)

(fn-expr _ scroll-resampler-moves Bool
  (param event ScrollEvent)
  (and (!= (. event phase) (. ScrollPhase began)) (!= (. event phase) (. ScrollPhase may-begin)) has-delta)
  (where
    (lazy has-delta (or (!= (. event delta-x) 0) (!= (. event delta-y) 0)))
  )
)

(fn-expr _ scroll-resampler-decay F64
  (param speed F64)
  (case? (>= speed 90)
    0.974
  )
  (case? (>= speed 8)
    (+ 0.964 (/ (* 0.010 (call log (/ speed 8))) (call log (/ 90.0 8))))
  )
  (case? (>= speed 0.5)
    (+ 0.93 (/ (* 0.034 (call log (/ speed 0.5))) (call log 16.0)))
  )
  (default
    0.93
  )
)

(fn-expr _ scroll-resampler-moved ScrollEvent
  (param event ScrollEvent)
  (param delta Point)
  (call ScrollEvent (. event data) (. delta x) (. delta y) (. event is-precise) (. event phase) (. event momentum-phase))
)

(fn-expr _ scroll-resampler-part ScrollEvent
  (param event ScrollEvent)
  (param fraction F64)
  (param is-final Bool)
  (if-expr (and (>= fraction 1) is-final) event part)
  (where
    (lazy phase (if-expr (or is-final (== (. event phase) (. ScrollPhase none))) (. event phase) (. ScrollPhase changed)))
    (lazy keeps-momentum (or is-final (== (. event momentum-phase) (. ScrollPhase none))))
    (lazy momentum (if-expr keeps-momentum (. event momentum-phase) (. ScrollPhase changed)))
    (lazy part
      (call ScrollEvent
        (block
          (arg (. event data))
          (arg (* (. event delta-x) fraction))
          (arg (* (. event delta-y) fraction))
          (arg (. event is-precise))
          (arg phase)
          (arg momentum)
        )
      )
    )
  )
)
