  (fn-do + press-button _
    (param view String)
    (param button PaneButton)
    (param anchor Box)
    (= peek null)
    (let key (str view ":" (. button key)))
    (if (and (. button-popover is-open) (== popover-key key))
      (call (. button-popover dismiss))
      (return)
    )
    (let content (call (. button make-popover)))
    (if content
      (= popover-key key)
      (= popover-content content)
      (call (. button-popover show) (call (. PopupAnchor box) anchor))
      (return)
    )
    (call (. button-popover dismiss))
    (if (. button is-available)
      (call (. button run))
    )
  )
