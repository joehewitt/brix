  (subscribe-for (on event drag-over)
    (let payload (call workbench-payload (. event payload)))
    (if (and payload (. event modifiers option))
      (call clear-drop)
      (let point (call point-in-box (. event root-point)))
      (= float-hint (call fit-float (call Rect (- (. point x) 30) (- (. point y) 12) 380 260) workbench-float-margin))
      (call (. event accept) null (. DropOperation move))
      (else
        (= float-hint null)
        (let stack (call stack-at (. event root-point)))
        (if (!= stack drop-stack)
