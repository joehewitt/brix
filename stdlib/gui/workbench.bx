  )
  (fn-expr _ float-frame Rect
    (param anchor Box)
    (case? (not (is anchor PaneStackView))
      (call fit-float
        (block
          (arg (call Rect (+ (- (. area x) (. bounds x)) 40) (- (. area y) (. bounds y) 40) 380 280))
          (arg workbench-float-margin)
        )
      )
    )
    (default
      (call fit-float
        (block
          (arg (call Rect (+ (- (. area x) (. bounds x)) 40) (+ (- (. area y) (. bounds y)) 40) width height))
          (arg workbench-float-margin)
        )
      )
    )
    (where
      (lazy area (. anchor bounds))
      (lazy width (call max 260.0 (call min (. area width) 520.0)))
      (lazy height (call max 180.0 (call min (. area height) 420.0)))
    )
  )
  (fn-expr _ float-area Rect
    (call Rect 0 workbench-title-height (. bounds width) (call max 0.0 (- (. bounds height) workbench-title-height)))
  )
  (fn-expr _ fit-float Rect
    (param rect Rect)
    (param margin Length (= 0))
    (call Rect x y width height)
    (where
      (lazy full (call float-area))
      (lazy area (call (. full inset) (call Insets margin margin margin margin)))
      (lazy width (call min (. rect width) (. area width)))
      (lazy height (call min (. rect height) (. area height)))
      (lazy x (call max (. area x) (call min (. rect x) (- (. area right) width))))
      (lazy y (call max (. area y) (call min (. rect y) (- (. area bottom) height))))
    )
  )
  (fn-do _ clear-drop _
    (let stack drop-stack)
    (if stack
      (= (. stack header slot-index) null)
    )
    (= strip-hint null)
    (= drop-stack null)
    (= held-zone null)
    (= landing null)
    (= reflow null)
    (= drop-hint null)
    (= drop-tab null)
  )
  (fn-do _ stack-at (? PaneStackView)
    (param point Point)
    (let found (? PaneStackView) null)
    (let near (? PaneStackView) null)
    (let reach (+ (/ workbench-gap 2) 0.5))
    (for (in header headers)
      (let stack (. header stack))
      (if (. stack is-home-visible)
        (let home (. stack home-rect))
        (if (call (. home contains) point)
          (= found stack)
          (else-if (call (. (call (. home outset) (call Insets reach reach reach reach)) contains) point)
            (= near (if-expr (or (== near null) (== stack drop-stack)) stack near))
          )
        )
      )
    )
    (return (?? found near))
  )
  (fn-expr _ stack-target PaneTarget
    (param stack PaneStackView)
    (param drag PaneDrag)
    (param point Point)
    (case? (call (. (call Rect (. home x) (. home y) (. home width) head) contains) point)
      (call pane-stack-target
        (block
          (arg (. stack scope))
          (arg (. stack node id))
          (arg (. PaneZone center))
          (arg (call (. stack header tab-index) (call Point (- (+ (. point x) (. shown x)) (. home x)) (- (+ (. point y) (. shown y)) (. home y)))))
        )
      )
    )
    (case? (not (call (. model can-split) (. stack scope) (. stack node id)))
      (call pane-stack-target (. stack scope) (. stack node id) (. PaneZone center))
    )
    (default
      (call pane-stack-target
        (block
          (arg (. stack scope))
          (arg (. stack node id))
          (arg (call workbench-zone fx fy (call facing-zones drag stack) held-zone hx hy))
        )
      )
    )
    (where
      (lazy home (. stack home-rect))
      (lazy head (call (. stack home-head)))
      (lazy shown (. stack header bounds))
      (lazy area (call Rect (. home x) (+ (. home y) head) (. home width) (call max 0.0 (- (. home height) head))))
      (lazy fx (/ (- (. point x) (. area x)) (call max 1.0 (. area width))))
      (lazy fy (/ (- (. point y) (. area y)) (call max 1.0 (. area height))))
      (lazy hx (/ workbench-zone-hold (call max 1.0 (. area width))))
      (lazy hy (/ workbench-zone-hold (call max 1.0 (. area height))))
    )
  )
  (fn-do _ hover-pane _
    (param event DragOverEvent)
    (param stack PaneStackView)
    (param payload PaneDragPayload)
    (let drag (. payload drag))
    (let target (call stack-target stack drag (. event root-point)))
    (if (and (is target .stack) (call (. model validate) drag target))
      (let into (== (. target zone) (. PaneZone center)))
      (if (!= (. target zone) held-zone)
        (let is-reorder (and into (!= (. drag view) null) (== (. target stack) (. drag stack))))
        (= landing (if-expr is-reorder null (call landing-of drag target into)))
      )
      (= held-zone (. target zone))
      (let found landing)
      (= reflow (?. found reflow))
      (= drop-hint (?. found body))
      (= drop-tab (if-expr into null (?. found tab)))
      (= (. stack header slot-index) (only-if (?? (. target index) (. stack views length)) (if into)))
      (= (. stack header slot-width) (. payload width))
      (= (. stack header is-slot-shown) (== (. target index) null))
      (call (. event accept)
        (block
          (arg null)
          (arg (if-expr (is (. event payload) PaneDragPayload) (. DropOperation move) (. DropOperation copy)))
        )
      )
      (else
        (call clear-drop)
      )
    )
  )
  (fn-expr _ arriving (? PaneDragPayload)
    (param payload DragPayload)
    (only-if (call PaneDragPayload (call pane-arrival-drag workbench-arrival-view) workbench-tab-width) (if droppable))
    (where
      (lazy droppable (call accepts-drop payload))
    )
  )
  (fn-do _ landing-of (? PaneLanding)
    (param drag PaneDrag)
    (param target PaneTarget)
    (param into Bool)
    (let preview (call (. model preview) drag target))
    (let views (call (. model payload-views) drag))
    (return-if null (if (== (. views length) 0)))
    (let found (call (. preview locate) ([] views 0)))
    (return-if null (if (not found)))
    (let before (call frames-of model))
    (let after (call frames-of preview))
    (let landed (call (of List String)))
    (for (in view views)
      (let place (call (. preview locate) view))
      (if place
        (+= landed (. place stack))
      )
    )
    (let shown (call (of Map String Rect)))
    (let frames (call (of Map String Rect)))
    (let hidden (call (of List String)))
    (for (in header headers)
      (let stack (. header stack))
      (let id (. stack node id))
      (let was ([] before id))
      (let now ([] after id))
      (if (and was now (or into (not (has landed id))))
        (let moved (call workbench-shifted (. stack home-rect) was now))
        (= ([] shown id) moved)
        (if (not (call workbench-same-rect was now))
          (= ([] frames id) moved)
        )
        (else-if was
          (+= hidden id)
        )
      )
    )
    (let area (?? ([] shown (. found stack)) ([] after (. found stack))))
    (return-if null (if (not area)))
    (let region (. found region))
    (let kind (if-expr (== (. found scope) (. PaneScope workspace)) (. PaneRegionKind center) (. region kind)))
    (let top (call (. preview top-stacks)))
    (let frame (call Rect (- (. area x) (. bounds x)) (- (. area y) (. bounds y)) (. area width) (. area height)))
    (let fit (call workbench-header-fit this kind (call workbench-hoists kind top (. found stack)) frame))
    (let body (call Rect (. frame x) (+ (. frame y) (. fit height)) (. frame width) (- (. frame height) (. fit height))))
    (let tab-top (+ (. frame y) (. fit bar-top) (/ (- (. fit bar-height) gui-tab-height) 2)))
    (let edge (+ (call workbench-header-inset kind (. region side)) gui-tab-tray-pad))
    (let left (+ (. frame x) (. fit bar-left) edge))
    (let right (- (. frame right) (. fit bar-right) edge workbench-header-action-pad))
    (return
      (call PaneLanding
        (block
          (arg body)
          (arg (call Rect left tab-top (call gui-safe-span (- right left)) gui-tab-height))
          (arg (call PaneReflow frames hidden top))
        )
      )
    )
  )
  (fn-do _ frames-of (map String Rect)
    (param source PaneModel)
    (let frames (call (of Map String Rect)))
    (let top (call (. source top-stacks)))
    (for (in view regions)
      (if (. view is-region)
        (let root (call workbench-region-root source (. view place) (. view side) (. view float-id)))
        (if root
          (call collect-frames source root (. view bounds) (. view place) top frames)
        )
      )
    )
    (return frames)
  )
  (fn-do _ collect-frames _
    (param source PaneModel)
    (param node PaneNode)
    (param area Rect)
    (param place PaneRegionKind)
    (param top (list String))
    (param frames (map String Rect))
    (if (== (. node kind) (. PaneNodeKind stack))
      (= ([] frames (. node id)) area)
      (else-if (== (. node kind) (. PaneNodeKind workspace))
        (let inner (. (call (. source layout)) workspace root))
        (if inner
          (call collect-frames source inner area (. PaneRegionKind workspace) top frames)
        )
      )
      (else-if (== (. node kind) (. PaneNodeKind split))
        (let cells (call workbench-cells source node))
        (let gapped (!= place (. PaneRegionKind float)))
        (let gap Length (if-expr gapped workbench-gap 0))
        (let is-row (== (. node axis) (. PaneAxis row)))
        (let folded
          (call sum
            (block
              (arg (in (call workbench-folded-length source (. each node) place top) cells (when (. each is-collapsed))))
            )
          )
        )
        (let total (call max (call sum (in (. each size) cells (when (not (. each is-collapsed))))) 0.0001))
        (let extent
          (scope (- main-size (* gap (- (call max (. cells length) 1) 1)) folded)
            (lazy main-size (if-expr is-row (. area width) (. area height)))
          )
        )
        (let offset Length 0)
        (for (in cell cells)
          (let length
            (scope (if-expr (. cell is-collapsed) folded-length (/ (* extent (. cell size)) total))
              (lazy folded-length (call workbench-folded-length source (. cell node) place top))
            )
          )
          (let rule Length (if-expr (and (> (. cell index) 0) (not gapped)) 1 0))
          (let box
            (scope (if-expr is-row row-box column-box)
              (lazy row-box (call Rect (+ (. area x) offset rule) (. area y) (- length rule) (. area height)))
              (lazy column-box (call Rect (. area x) (+ (. area y) offset rule) (. area width) (- length rule)))
            )
          )
          (call collect-frames source (. cell node) box place top frames)
          (+= offset (+ length gap))
        )
      )
    )
  )
  (fn-do _ facing-zones (list PaneZone)
    (param drag PaneDrag)
    (param stack PaneStackView)
    (let zones (call (of List PaneZone)))
    (return-if zones (if (or (== (. stack place) (. PaneRegionKind float)) (not (call (. model vacates) drag)))))
    (let source (call source-rect drag stack))
    (return-if zones (if (not source)))
    (let area (. stack home-rect))
    (let across (- (call min (. source right) (. area right)) (call max (. source left) (. area left))))
    (let along (- (call min (. source bottom) (. area bottom)) (call max (. source top) (. area top))))
    (if (call workbench-touches (. source top) (. area bottom) across (. area width))
      (+= zones (. PaneZone bottom))
    )
    (if (call workbench-touches (. source bottom) (. area top) across (. area width))
      (+= zones (. PaneZone top))
    )
    (if (call workbench-touches (. source left) (. area right) along (. area height))
      (+= zones (. PaneZone right))
    )
    (if (call workbench-touches (. source right) (. area left) along (. area height))
      (+= zones (. PaneZone left))
    )
    (return zones)
  )
  (fn-do _ source-rect (? Rect)
    (param drag PaneDrag)
    (param target PaneStackView)
    (let ids (call (. model drag-stacks) drag))
    (let found (? Rect) null)
    (for (in header headers)
      (let stack (. header stack))
      (if (and (== (. stack scope) (. drag scope)) (has ids (. stack node id)))
        (return-if null (if (not (call workbench-same-region stack target))))
        (= found (if-expr found (+ found (. stack home-rect)) (. stack home-rect)))
      )
    )
    (return found)
  )
  (fn-do _ restore _
    (return-if (if is-restored))
    (= is-restored true)
    (let key state-key)
    (let store (call gui-app-state this))
    (return-if (if (or (not key) (not store))))
    (let saved (call (. store read) (str "workbench:" key) 1))
    (if saved
      (let ignored (call (. model load) saved))
    )
  )
  (fn-do _ remember _
    (let key state-key)
    (return-if (if (or (not key) (not is-restored))))
    (let store (call gui-app-state this))
    (if store
      (call (. store write) (str "workbench:" key) 1 (. model json))
    )
  )
)

(type + PaneNodeView (is Box)
  (prop _ bench Workbench)
  (prop _ node PaneNode)
  (prop _ scope PaneScope)
  (prop _ place PaneRegionKind)
  (prop _ side _ (= (. PaneSide left)))
  (prop _ float-id _ (= ""))
  (prop _ workspace-root _ (= (call workbench-revised (call workbench-workspace-root (. bench model)) (. bench #revision))))
  (prop _ is-region _ (= false))
  (content
    (<> This (• flex-col)
      (if (== (. #node kind) (. PaneNodeKind split))
        (<> PaneSplitView (• flex 1)
          (= bench bench)
          (= node #node)
          (= scope #scope)
          (= place #place)
          (= side #side)
          (= float-id #float-id)
        )
        (else-if (== (. #node kind) (. PaneNodeKind workspace))
          (<> PaneNodeView (• flex 1)
            (= bench bench)
            (= node #workspace-root)
            (= scope (. PaneScope workspace))
            (= place (. PaneRegionKind workspace))
          )
        )
        (else
          (<> PaneStackView (• flex 1)
            (= bench bench)
            (= node #node)
            (= scope #scope)
            (= place #place)
            (= side #side)
            (= float-id #float-id)
          )
        )
      )
    )
  )
)

(type + PaneSplitView (is Box)
  (prop _ bench Workbench)
  (prop _ node PaneNode)
  (prop _ scope PaneScope)
  (prop _ place PaneRegionKind)
  (prop _ side _ (= (. PaneSide left)))
  (prop _ float-id _ (= ""))
  (prop _ cells _ (= (call workbench-revised (call workbench-cells (. bench model) #node) (. bench #revision))))
  (prop _ is-gapped _ (= (!= #place (. PaneRegionKind float))))
  (content
    (<> This
      (= layout
        (call FlexLayout
          (block
            (arg (if-expr (== (. #node axis) (. PaneAxis row)) (. Orientation horizontal) (. Orientation vertical)))
          )
        )
      )
      (= gap (if-expr #is-gapped workbench-gap 0))
      (for (in cell #cells (keyed-by (. cell node id)))
        (<> PaneSplitCell
          (= bench bench)
          (= split this)
          (= cell cell)
        )
      )
    )
  )
  (fn-expr _ cell-boxes (list PaneSplitCell)
    (call (of List PaneSplitCell)
      (block
        (spread active-children)
        (pipe ?*> (only-if (as each PaneSplitCell) (if (is each PaneSplitCell))))
      )
    )
  )
  (fn-do _ even-out _
    (let sizes (call (of List Float)))
    (for (in kid (. node kids))
      (+= sizes 1)
    )
    (call (. bench model set-split-sizes) (. node id) sizes)
  )
  (fn-do _ commit-sizes _
    (let boxes (call cell-boxes))
    (let sizes (call (of List Float) (in (call (. node size-at) each) (..< 0 (. node kids length)))))
    (for (in box boxes)
      (if (< (. box cell index) (. sizes length))
        (= ([] sizes (. box cell index)) (?? (. box drag-flex) (. box cell size)))
      )
    )
    (call (. bench model set-split-sizes) (. node id) sizes)
    (for (in box boxes)
      (= (. box drag-flex) null)
    )
  )
)

(type + PaneSplitCell (is Box)
  (prop _ bench Workbench)
  (prop _ split PaneSplitView)
  (prop _ cell PaneCell)
  (prop _ is-row _ (= (== (. #split #node axis) (. PaneAxis row))))
  (prop _ is-ruled _ (= (and (> (. #cell index) 0) (not (. #split #is-gapped)))))
  (prop _ drag-flex (? Float) (= null))
  (content
    (<> This (• flex-col)
      (= flex (if-expr (. #cell is-collapsed) 0 (?? #drag-flex (. #cell size))))
      (= border-left-width (if-expr (and #is-ruled #is-row) 1 0))
      (= border-top-width (if-expr (and #is-ruled (not #is-row)) 1 0))
      (<> PaneNodeView (• flex 1)
        (= bench bench)
        (= node (. #cell node))
        (= scope (. split #scope))
        (= place (. split #place))
        (= side (. split #side))
        (= float-id (. split #float-id))
      )
      (if (and (> (. #cell index) 0) (call workbench-gutter-live (. split #cells) (. #cell index)))
        (<> PaneGutter
          (= split split)
          (= position (. #cell index))
          (= is-row #is-row)
          (= inset (if-expr (. split #is-gapped) (/ workbench-gap 2) 0))
        )
      )
    )
  )
)

(type + PaneGutter (is Box)
  (prop _ split PaneSplitView)
  (prop _ position Index)
  (prop _ is-row _ (= true))
  (prop _ inset Length (= 0))
  (prop _ offset _ (= (- (+ (/ workbench-gutter-reach 2) #inset))))
  (blank)
  (prop _ lead Index (= 0))
  (prop _ trail Index (= 0))
  (prop _ start-lead Length (= 0))
  (prop _ start-trail Length (= 0))
  (prop _ flex-lead Float (= 1))
  (prop _ flex-trail Float (= 1))
  (content
    (<> This
      (= left (if-expr #is-row (call (. PositionOffset coord) #offset) (call (. PositionOffset coord) 0)))
      (= right (if-expr #is-row null (call (. PositionOffset coord) 0)))
      (= top (if-expr #is-row (call (. PositionOffset coord) 0) (call (. PositionOffset coord) #offset)))
      (= bottom (only-if (call (. PositionOffset coord) 0) (if #is-row)))
      (= min-width (if-expr #is-row (call (. SizeSpec coord) workbench-gutter-reach) (. SizeSpec auto)))
      (= max-width (if-expr #is-row (call (. SizeSpec coord) workbench-gutter-reach) (. SizeSpec auto)))
      (= min-height (if-expr #is-row (. SizeSpec auto) (call (. SizeSpec coord) workbench-gutter-reach)))
      (= max-height (if-expr #is-row (. SizeSpec auto) (call (. SizeSpec coord) workbench-gutter-reach)))
      (= cursor (if-expr #is-row (. CursorStyle resize-horizontal) (. CursorStyle resize-vertical)))
      (= drag-cursor (if-expr #is-row (. CursorStyle resize-horizontal) (. CursorStyle resize-vertical)))
    )
  )
  (prop _ gesture _
    (machine
      (state idle)
      (blank)
      (state dragging (trigger for press pointer-down (and (== (. press button) (. PointerButton primary)) (< (. press click-count) 2)))
        (do
          (call begin-resize)
        )
        (blank)
        (for (on drag pointer-drag (when (== (. drag pointer-id) (. press pointer-id))))
          (call (. drag cancel))
          (call resize-by (- (call axis-of (. drag root-point)) (call axis-of (. press root-point))))
        )
        (blank)
        (then idle (trigger for up pointer-up (== (. up pointer-id) (. press pointer-id)))
          (do
            (call (. up cancel))
            (call (. split commit-sizes))
          )
        )
      )
    )
  )
  (subscribe-for (on press pointer-down (when (and (== (. press button) (. PointerButton primary)) (>= (. press click-count) 2))))
    (call (. split even-out))
    (call (. press cancel))
  )
  (subscribe-for (on event drag-start)
    (call (. event cancel))
  )
  (fn-do _ begin-resize _
    (let boxes (call (. split cell-boxes)))
    (return-if (if (>= position (. boxes length))))
    (= lead (?? (call last (in each (..< 0 position) (when (not (. ([] boxes each) cell is-collapsed))))) (- position 1)))
    (= trail (?? (call first (in each (..< position (. boxes length)) (when (not (. ([] boxes each) cell is-collapsed))))) position))
    (= start-lead (call extent-of ([] boxes lead)))
    (= start-trail (call extent-of ([] boxes trail)))
    (= flex-lead (. ([] boxes lead) $flex))
    (= flex-trail (. ([] boxes trail) $flex))
  )
  (fn-do _ resize-by _
    (param delta Length)
    (let boxes (call (. split cell-boxes)))
    (return-if (if (>= trail (. boxes length))))
    (let total (+ start-lead start-trail))
    (return-if (if (<= total (* workbench-min-pane-size 2))))
    (let sum (+ flex-lead flex-trail))
    (let leading (call max workbench-min-pane-size (call min (- total workbench-min-pane-size) (+ start-lead delta))))
    (let share (/ (* sum leading) total))
    (= (. ([] boxes lead) drag-flex) share)
    (= (. ([] boxes trail) drag-flex) (- sum share))
  )
  (fn-expr _ extent-of Length
    (param box Box)
    (if-expr is-row (. box bounds width) (. box bounds height))
  )
  (fn-expr _ axis-of Length
    (param point Point)
    (if-expr is-row (. point x) (. point y))
  )
)

(type + PaneStackView (is Box)
  (prop _ bench Workbench)
  (prop + node PaneNode)
  (prop _ scope PaneScope)
  (prop _ place PaneRegionKind)
  (prop _ side _ (= (. PaneSide left)))
  (prop _ float-id _ (= ""))
  (prop _ views _ (= (call workbench-revised (call (. bench model tab-views) #node) (. bench #revision))))
  (prop + inlined _ (= (call workbench-revised (call workbench-inlined (. bench model) #node) (. bench #revision))))
  (prop _ active _ (= (call workbench-revised (call (. bench model active-view) #node) (. bench #revision))))
  (prop _ context _ (= (call workbench-revised (. bench model current) (. bench #revision))))
  (prop _ active-key _
    (=
      (call workbench-revised
        (block
          (arg (call workbench-host-key (. bench model) #active #context))
          (arg (. bench #revision))
        )
      )
    )
  )
  (prop _ retained _ (= (. bench #retained-contexts)))
  (prop _ is-hoisted _ (= (call workbench-hoists #place (. bench #hoisted) (. #node id))))
  (prop + is-boxed _ (= (call workbench-is-boxed bench #place #side #active)))
  (prop + is-collapsed _ (= (call workbench-revised (. #node is-collapsed) (. bench #revision))))
  (prop _ is-folded _ (= (or #is-collapsed (and (== (. #views length) 0) (> (. #inlined length) 0)))))
  (prop _ is-docked _ (= (== #place (. PaneRegionKind dock))))
  (prop + is-lit _ (= (and #is-boxed (== (call workbench-revised (call (. bench model focused-stack)) (. bench #focus-revision)) (. #node id)))))
  (prop _ is-passive _ (= (not (call (. bench model is-focusable) (?? #active "")))))
  (prop _ placed _ (= (call workbench-placed (. bench #reflow) (. #node id))))
  (prop + is-placed _ (= (!= #placed null)))
  (prop _ is-vacated _ (= (call workbench-vacated (. bench #reflow) (. #node id))))
  (blank)
  (prop _ cell (of Ancestor PaneNodeView))
  (prop _ visited (list PaneHost))
  (prop _ visits U64)
  (content
    (<> This (• flex-col)
      (= match (str "workbench-stack-" (. #node id)))
      (= keeps-focus (or #is-docked #is-passive))
      (= focus-group (not #is-passive))
      (= display (if-expr #is-vacated (. Display hidden) (. Display visible)))
      (= left (only-if (call (. PositionOffset coord) (. #placed x)) (if (!= #placed null))))
      (= top (only-if (call (. PositionOffset coord) (. #placed y)) (if (!= #placed null))))
      (= min-width (if-expr (!= #placed null) (call (. SizeSpec coord) (. #placed width)) (. SizeSpec auto)))
      (= max-width (if-expr (!= #placed null) (call (. SizeSpec coord) (. #placed width)) (. SizeSpec auto)))
      (= min-height (if-expr (!= #placed null) (call (. SizeSpec coord) (. #placed height)) (. SizeSpec auto)))
      (= max-height (if-expr (!= #placed null) (call (. SizeSpec coord) (. #placed height)) (. SizeSpec auto)))
      (<> PaneHeader (id: header)
        (= bench bench)
        (= stack this)
        (= is-hoisted #is-hoisted)
      )
      (<> PaneBody (id: body) (• pane-body) (• flex-col) (• flex 1)
        (= is-boxed #is-boxed)
        (= display (if-expr #is-folded (. Display hidden) (. Display visible)))
        (for (in host (call workbench-hosts (. bench model) #node #views #active #context visited #retained #visits (. bench #revision)) (keyed-by (. host key)))
          (<> PaneContentHost (• flex 1)
            (= bench bench)
            (= view (. host view))
            (= context (. host context))
            (= display (if-expr (== (. host key) #active-key) (. Display visible) (. Display hidden)))
            (= pinned (only-if (call pinned-content #placed) (if (!= #placed null))))
          )
        )
        (if (== (. #views length) 0)
          (<> Box (• pane-empty) (• flex-col)
            (if (== #scope (. PaneScope workspace))
              (call (. bench make-empty))
              (else
                (<> PaneEmpty)
              )
            )
          )
        )
      )
    )
  )
  (whenever-rule #active
    (call note-visit)
  )
  (whenever-rule #context
    (= visited (call workbench-kept-visits visited context retained))
    (call note-visit)
  )
  (whenever-rule #retained
    (= visited (call workbench-kept-visits visited context retained))
    (+= visits 1)
  )
  (fn-do + mounted _
    (call (. super mounted))
    (call note-visit)
  )
  (fn-expr _ home-rect Rect :get
    (?? (?. cell bounds) bounds)
  )
  (fn-expr _ is-home-visible Bool :get
    (?? (?. cell is-input-visible) false)
  )
  (fn-expr _ home-head Length
    (call head-at home-rect (. bench top-stacks))
  )
  (fn-expr _ head-at Length
    (param rect Rect)
    (param top (list String))
    (if-expr (. header is-bare) 0 (. (call workbench-header-fit bench place hoists frame) height))
    (where
      (lazy origin (. bench bounds))
      (lazy hoists (call workbench-hoists place top (. node id)))
      (lazy frame (call Rect (- (. rect x) (. origin x)) (- (. rect y) (. origin y)) (. rect width) (. rect height)))
    )
  )
  (fn-expr _ content-at Dimensions
    (param rect Rect)
    (param head Length)
    (call Dimensions (call max 0.0 (- (. rect width) edge)) (call max 0.0 (- (. rect height) head edge)))
    (where
      (lazy edge Length (if-expr is-boxed 2 0))
    )
  )
  (fn-expr _ pinned-content Dimensions
    (param placed Rect)
    (call Dimensions (call max (. home width) (. shown width)) (call max (. home height) (. shown height)))
    (where
      (lazy home (call content-at home-rect (call home-head)))
      (lazy shown (call content-at placed (call head-at placed (. bench hoisted))))
    )
  )
  (fn-do _ note-visit _
    (let shown active)
    (return-if (if (not shown)))
    (let host (call workbench-host (. bench model) shown context))
    (= visited (call (of List PaneHost) (in each visited (when (!= (. each key) (. host key))))))
    (+= visited host)
    (if (> (. visited length) (. bench mounted-limit))
      (let ignored (call (. visited pop-first)))
    )
    (+= visits 1)
  )
)

(type + PaneBody (is Box)
  (prop + is-boxed _ (= false))
  (whenever-rule #is-boxed
    (call sync-glass)
  )
  (fn-do + mounted _
    (call (. super mounted))
    (call sync-glass)
  )
  (fn-do _ sync-glass _
    (return-if (if (not (call style-live-attachment this))))
    (call set-theme-tag "glass" (only-if false (if is-boxed)))
  )
)

(type + PaneDragSource (is Box)
  (prop _ bench Workbench)
  (prop + is-lifted _ (= false))
  (subscribe-for (on event drag-end (when arrival))
    (= is-lifted false)
    (= (. bench dragging) null)
  )
  (fn-do _ begin-drag _
    (param event DragStartEvent)
    (param drag PaneDrag)
    (param width Length)
    (let payload (call PaneDragPayload drag width))
    (= is-lifted true)
    (let root markup-batch-root)
    (if root
      (catch (call (. root markup-batch-queue checkpoint)))
    )
    (= (. bench peek) null)
    (= (. bench dragging) payload)
    (let ignored (call (. event begin) payload this))
  )
)

(type + PaneHeaderBar (is Box)
  (prop _ leading Length (= 0))
  (prop _ trailing Length (= 0))
  (fn-expr + padding-edges _ :get
    (. (call Insets $padding-top (+ $padding-right trailing) $padding-bottom (+ $padding-left leading)) clamped)
  )
  (fn-do + inset _
    (param left Length)
    (param right Length)
    (return-if (if (and (== left leading) (== right trailing))))
    (= leading left)
    (= trailing right)
    (call invalidate-layout)
  )
)

(type + PaneHeader (is PaneDragSource)
  (prop + stack PaneStackView)
  (prop _ is-hoisted _ (= false))
  (prop _ fit _ (= (call PaneHeaderFit)))
  (prop _ inset _ (= (call workbench-header-inset (. stack #place) (. stack #side))))
  (prop + slot-index (? Index))
  (prop _ slot-width Length (= 0))
  (prop _ is-slot-shown _ (= false))
  (prop _ carried _ (= (call workbench-carried (. bench #dragging) (. stack #node id) (. stack #scope))))
  (prop _ slots _ (= (call workbench-tab-slots (. stack #views) #slot-index #carried)))
  (prop _ framed _ (= (if-expr (. stack #is-collapsed) null (. stack #active))))
  (prop _ hovered (? String) (= null))
  (prop _ is-float-corner _ (= (and (== (. stack #place) (. PaneRegionKind float)) (== (. stack #node id) (call workbench-corner (?. (call (. (call (. bench model layout)) find-float) (. stack #float-id)) root) (. bench #revision))))))
  (prop _ is-bottom-corner _ (= (and (== (. stack #place) (. PaneRegionKind center)) (== (. stack #node id) (call workbench-corner (call (. bench model bottom-node)) (. bench #revision))))))
  (prop _ is-docked _ (= (== (. stack #place) (. PaneRegionKind dock))))
  (prop _ is-compact _ (= false))
  (prop _ is-trayed _ (= (and (not (. stack #is-collapsed)) (> (+ (. stack #views length) (if-expr (!= #slot-index null) 1 0)) 0))))
  (prop _ is-bare _ (= (and #is-docked (== (. stack #views length) 1) (!= (. bench #renaming) ([] (. stack #views) 0)) (call workbench-revised (call workbench-is-iconic (. bench model) ([] (. stack #views) 0)) (. bench #revision)))))
  (prop _ is-vacant _ (= (and (== (+ (. stack #views length) (. stack #inlined length)) 0) (== #slot-index null) (or (== (. stack #scope) (. PaneScope layout)) (!= (. stack #node id) (call workbench-revised (. (call workbench-workspace-root (. bench model)) id) (. bench #revision)))))))
  (content
    (<> This (• flex-col)
      (= display (if-expr #is-bare (. Display hidden) (. Display visible)))
      (= border-bottom-width (if-expr (== (. stack #place) (. PaneRegionKind float)) 1 0))
      (= window-draggable (. #fit is-lifted))
      (if (. #fit is-cramped)
        (<> Box (• workbench-title-spacer))
      )
      (<> PaneHeaderBar (id: bar) (• flex-row) (• items-center)
        (= min-height (call (. SizeSpec coord) (. #fit bar-height)))
        (= max-height (call (. SizeSpec coord) (. #fit bar-height)))
        (= padding-bottom (. #fit nudge))
        (<> Box (id: tabs) (• tab-tray) (• flex-row) (• flex 1)
          (for (in item #slots (keyed-by item))
            (<> PaneTab
              (= bench bench)
              (= stack stack)
              (= view item)
              (= slot-width #slot-width)
              (= is-gap (not #is-slot-shown))
              (= is-active (== item #framed))
              (= is-compact #is-compact)
              (= is-carried (== item #carried))
              (= is-held (and (== item #carried) (!= #slot-index null)))
              (= is-divided
                (call workbench-tab-divided
                  (block
                    (arg #slots)
                    (arg item)
                    (arg #framed)
                    (arg #hovered)
                    (arg #carried)
                    (arg (!= #slot-index null))
                  )
                )
              )
            )
          )
          (if #is-vacant
            (<> Button (text: "Close") (• pane-close)
              (= action (=> () :do (call (. bench close-pane) (. stack node id))))
            )
          )
        )
        (<> Box (id: tools) (• pane-header-actions) (• flex-row)
          (for (in view (. stack #inlined) (keyed-by view))
            (<> PaneInlineButtons
              (= bench bench)
              (= view view)
            )
          )
          (if #is-float-corner
            (<> IconButton (• icon-x)
              (= action (=> () :do (call (. bench model unfloat) (. stack float-id))))
              (<> Tooltip (text: "Put this group back"))
            )
          )
          (if #is-bottom-corner
            (<> IconButton (• icon-panel-bottom)
              (= action (=> () :do (call (. bench toggle-bottom))))
              (<> Tooltip (text: "Toggle the bottom panes"))
            )
          )
        )
      )
    )
  )
  (whenever-rule #is-hoisted
    (call refit)
  )
  (subscribe-for (on event drag-start)
    (if (and (not (. fit is-lifted)) (!= (. stack place) (. PaneRegionKind float)) has-panes)
      (call begin-drag event (call pane-node-drag (. stack node id) (. stack scope)) (call tabs-width (call tab-boxes)))
    )
    (lazy has-panes (> (+ (. stack views length) (. stack inlined length)) 0))
  )
  (fn-do + arrange-bounds _
    (param rect Rect)
    (call (. super arrange-bounds) rect)
    (call refit)
  )
  (fn-do + did-layout _
    (call (. super did-layout))
    (call fit-tabs)
  )
  (fn-do _ refit _
    (let origin (. bench bounds))
    (let frame (call Rect (- (. bounds x) (. origin x)) (- (. bounds y) (. origin y)) (. bounds width) (. bounds height)))
    (= fit (call workbench-header-fit bench (. stack place) is-hoisted frame))
    (call (. bar inset) (+ (. fit bar-left) inset) (+ (. fit bar-right) inset))
  )
  (fn-do _ fit-tabs _
    (let found (call tab-boxes))
    (let margins Length (if-expr (!= carried null) 0 (* workbench-slot-gap 2)))
    (let slot Length (if-expr (!= slot-index null) (+ slot-width margins) 0))
    (let count (+ (. found length) (if-expr (> slot 0) 1 0)))
    (let room
      (scope (- (. bar content-bounds width) (. tools bounds width) (* gui-tab-tray-pad 2) slot tab-gaps)
        (lazy tab-gaps (* gui-tab-gap (call max 0 (- count 1))))
      )
    )
    (= is-compact (< room (* (call max (in (call (. each least-width)) found)) (. found length))))
  )
  (fn-expr _ tabs-width Length
    (param found (list PaneTab))
    (+ (call sum (in (call (. each natural-width)) found)) (* gui-tab-gap (call max 0 (- (. found length) 1))))
  )
  (fn-expr _ is-grab-area Bool
    (param point Point)
    (and (call (. bar bounds contains) point) (not (call (. tools bounds contains) point)) (not on-tab))
    (where
      (lazy on-tab (call some (call tab-boxes) (:where (call (. each bounds contains) point))))
    )
  )
  (fn-expr + tab-boxes (list PaneTab)
    (call (of List PaneTab)
      (block
        (spread (. tabs active-children))
        (pipe ?*> (only-if (as each PaneTab) (if (and (is each PaneTab) (not (. (as each PaneTab) is-slot)) (not (. (as each PaneTab) is-carried))))))
      )
    )
  )
  (fn-expr _ tab-index Index
    (param point Point)
    (if-expr (and (!= hidden null) (>= index hidden)) (+ index 1) index)
    (where
      (lazy found (call tab-boxes))
      (lazy before (call (of List Index) (in each (..< 0 (. found length)) (when (< (. point x) (. ([] found each) bounds center x))))))
      (lazy index (?? (call first before) (. found length)))
      (lazy hidden (only-if (call (. stack views find) carried) (if carried)))
    )
  )
)

(type + PaneTab (is PaneDragSource)
  (prop _ stack PaneStackView)
  (prop + view String)
  (prop + is-active _ (= false))
  (prop + is-compact _ (= false))
  (prop + is-framed _ (= #is-active))
  (prop + shows-hover _ (= (and #is-hover-within (not #is-framed))))
  (prop + is-slot _ (= (== #view "")))
  (prop _ is-carried _ (= false))
  (prop _ is-held _ (= false))
  (prop _ is-gap _ (= false))
  (prop + is-divided _ (= false))
  (prop _ slot-width Length (= 0))
  (prop _ title _ (= (call workbench-revised (call (. bench title-for) #view) (. bench #label-revision))))
  (prop _ tooltip _ (= (call workbench-revised (call (. bench tooltip-for) #view) (. bench #label-revision))))
  (prop _ marks _ (= (call workbench-revised (call (. bench tab-marks) #view) (. bench #label-revision))))
  (prop _ symbol _ (= (call (. bench make-mark) #view #marks)))
  (prop _ is-renaming _ (= (== (. bench #renaming) #view)))
  (prop _ can-rename _ (= (!= (call workbench-revised (call (. bench rename-text) #view) (. bench #label-revision)) null)))
  (prop _ is-pointed _ (= false))
  (prop _ shows-close _ (= (and #is-pointed #is-active (not #is-compact))))
  (prop + is-modified _ (= (. #marks is-modified)))
  (prop + is-changed _ (= (. #marks is-changed)))
  (content
    (<> This (• tab-pill) (• flex-row)
      (= display (if-expr (and #is-carried (not #is-held)) (. Display hidden) (. Display visible)))
      (= flex (if-expr (and #is-slot (not #is-compact)) 0 1))
      (if #is-slot
        (<> PaneDropHint
          (= rect (call Rect 0 0 #slot-width gui-tab-height))
          (= is-tab true)
          (= is-slot true)
          (= is-gap #is-gap)
          (= is-fluid #is-compact)
        )
        (else
          (<> Box (• tab-divider))
          (<> Box (• tab-side) (• flex-row)
            (if #shows-close
              (<> IconButton (• tab-close) (• icon-x)
                (= action (=> () :do (call (. bench close-view) view)))
              )
            )
          )
          (<> Box (• tab-center) (• flex-row)
            (<> PaneIcon
              (= bench bench)
              (= view view)
            )
            (<> Box (• pane-tab-label) (• flex-row)
              (= max-width (if-expr #is-compact (call (. SizeSpec coord) 0) (. SizeSpec auto)))
              (<> Label (id: caption) (• tab-title)
                (= text #title)
                (= display (if-expr #is-renaming (. Display hidden) (. Display visible)))
              )
              (if #is-renaming
                (<> PaneRenameInput
                  (= bench bench)
                  (= view view)
                  (= text (?? (call (. bench rename-text) view) ""))
                )
              )
            )
          )
          (<> Box (• tab-side) (• flex-row)
            (<> PaneTabMark
              (= marks #marks)
              (= symbol #symbol)
            )
          )
          (if (or (!= #tooltip null) #is-compact)
            (<> Tooltip
              (= text (?? #tooltip #title))
            )
          )
          (<> ContextMenu
            (<> PaneTabActions
              (= bench bench)
              (= view view)
              (= scope (. stack #scope))
              (= stack (. stack #node id))
              (= place (. stack #place))
              (= views (. stack #views))
              (= anchor stack)
            )
          )
        )
      )
    )
  )
  (whenever-rule #is-hover-within
    (call settle-close)
    (call note-hover)
  )
  (whenever-rule #is-press-within
    (call settle-close)
  )
  (subscribe-for (on event pointer-down (when (and (== (. event button) (. PointerButton primary)) (not (. event modifiers control)) (== (. event click-count) 1))))
    (call (. bench model select) (. stack scope) (. stack node id) view)
  )
  (subscribe-for (on event click)
    (if (and (>= (. event click-count) 2) can-rename)
      (call (. bench begin-rename) view)
    )
    (call (. event cancel))
  )
  (subscribe-for (on event drag-start)
    (call begin-drag event (call pane-view-drag view (. stack scope) (. stack node id)) (call natural-width))
  )
  (fn-do _ settle-close _
    (return-if (if is-press-within))
    (= is-pointed is-hover-within)
  )
  (fn-do _ note-hover _
    (let header (. stack header))
    (if is-hover-within
      (= (. header hovered) view)
      (else-if (== (. header hovered) view)
        (= (. header hovered) null)
      )
    )
  )
  (fn-expr _ natural-width Length
    (call min workbench-tab-max-width (call max workbench-tab-width (+ workbench-tab-chrome (call caption-width))))
  )
  (fn-expr _ least-width Length
    (+ workbench-tab-chrome (call min workbench-tab-least-label (call caption-width)))
  )
  (fn-expr _ caption-width Length
    (. (call (. caption flow-measure) (call measure-fit-query)) outer-size width)
  )
  (fn-expr + hit-contains _
    (param point Point)
    (and (not is-slot) (call (. super hit-contains) point))
  )
)

(type + PaneRenameInput (is TextInput)
  (prop _ bench Workbench)
  (prop _ view String)
  (subscribe-for (on event focus)
    (let length (call (. bench rename-selection) view))
    (if (!= length null)
      (call select-range 0 length)
      (else
        (call place-caret-at-end)
      )
    )
  )
  (subscribe-for (on event key-press)
    (if (== (. event key) (. Key escape))
      (call (. bench finish-rename) view null)
      (call (. event cancel))
    )
  )
  (subscribe-for (on event submit)
    (call (. bench finish-rename) view text)
  )
  (subscribe-for (on event blur)
    (call (. bench finish-rename) view text)
  )
  (fn-do + mounted _
    (call (. super mounted))
    (call request-focus)
  )
)

(type + PaneTabMark (is Box)
  (prop + marks PaneTabMarks)
  (prop + symbol (? Box))
  (prop + is-busy _ (= (. #marks is-busy)))
  (prop + is-accent _ (= (== (. #marks tone) (. PaneTabTone accent))))
  (prop + is-success _ (= (== (. #marks tone) (. PaneTabTone success))))
  (prop + is-warning _ (= (== (. #marks tone) (. PaneTabTone warning))))
  (prop + is-danger _ (= (== (. #marks tone) (. PaneTabTone danger))))
  (content
    (<> This (• flex-row)
      (if #symbol
        (!! #symbol)
        (else-if (. #marks has-activity)
          (<> Box (• pane-tab-activity))
        )
        (else-if (. #marks is-modified)
          (<> Box (• tab-modified))
        )
      )
    )
  )
)

(type _ PaneDotPainter (is Painter)
  (fn-do + paint _
    (param node Box)
    (param rect Rect)
    (param canvas Canvas)
    (return-if (if (or (<= (. rect width) 0) (<= (. rect height) 0))))
    (do-use (. canvas saved-state)
      (= (. canvas fill-color) (?? (. node $background-color) (. node $color)))
      (= (. canvas shape-fill) null)
      (= (. canvas stroke-color) null)
      (call (. canvas rect) rect)
    )
  )
)

(type + PaneDockToggle (is PaneDragSource)
  (prop _ side PaneSide)
  (prop _ state _ (= ([] (. bench #docks) #side)))
  (prop _ lone _ (= (only-if ([] (. ([] (. #state pages) 0) views) 0) (if (and (. #state is-single) (> (. ([] (. #state pages) 0) views length) 0))))))
  (prop _ is-carried _ (= (and (!= #lone null) (call workbench-strip-carried (. bench #dragging) #lone (. ([] (. #state pages) 0) root)))))
  (content
    (<> This (• flex-row)
      (if (!= #lone null)
        (<> IconButton
          (= action (=> () :do (call (. bench toggle-dock) side)))
          (<> PaneIcon (slot: leading)
            (= bench bench)
            (= view (!! #lone))
          )
          (<> Tooltip
            (= text (call workbench-revised (call (. bench title-for) (!! #lone)) (. bench #label-revision)))
          )
          (<> ContextMenu
            (<> PaneIconActions
              (= bench bench)
              (= view (!! #lone))
              (= views (. ([] (. #state pages) 0) views))
              (= anchor this)
            )
          )
        )
        (else-if (== #side (. PaneSide left))
          (<> IconButton (• icon-panel-left)
            (= is-enabled (!= (. #state current) null))
            (= action (=> () :do (call (. bench toggle-dock) side)))
          )
        )
        (else
          (<> IconButton (• icon-panel-right)
            (= is-enabled (!= (. #state current) null))
            (= action (=> () :do (call (. bench toggle-dock) side)))
          )
        )
      )
    )
  )
  (subscribe-for (on event drag-start)
    (let view lone)
    (let drag (only-if (call (. bench model page-drag) view) (if view)))
    (if drag
      (call begin-drag event drag workbench-tab-width)
    )
  )
)

(type + PaneIcon (is Box)
  (prop _ bench Workbench)
  (prop _ view String)
  (content
    (<> This (• flex-col)
      (call (. bench make-icon) #view)
    )
  )
)

(type + PaneContentHost (is Box)
  (prop _ bench Workbench)
  (prop _ view String)
  (prop _ context _ (= ""))
  (prop _ pinned (? Dimensions))
  (prop + is-pinned _ (= (!= #pinned null)))
  (prop + is-passive _ (= (not (call (. bench model is-focusable) #view))))
  (content
    (<> This (• flex-col)
      (= left (only-if (call (. PositionOffset coord) 0) (if (!= #pinned null))))
      (= top (only-if (call (. PositionOffset coord) 0) (if (!= #pinned null))))
      (= min-width (if-expr (!= #pinned null) (call (. SizeSpec coord) (. #pinned width)) (. SizeSpec auto)))
      (= max-width (if-expr (!= #pinned null) (call (. SizeSpec coord) (. #pinned width)) (. SizeSpec auto)))
      (= min-height (if-expr (!= #pinned null) (call (. SizeSpec coord) (. #pinned height)) (. SizeSpec auto)))
      (= max-height (if-expr (!= #pinned null) (call (. SizeSpec coord) (. #pinned height)) (. SizeSpec auto)))
      (= focus-group (not #is-passive))
      (= focus-mode (. FocusMode inside))
      (call (. bench make-content) view context)
    )
  )
  (whenever-rule #is-focus-within
    (if is-focus-within
      (call (. bench model note-focus) view)
    )
  )
  (whenever-rule (. bench #focusing)
    (call claim-focus)
  )
  (fn-do _ claim-focus _
    (return-if (if (not (call (. bench take-focusing) view context))))
    (call request-focus)
  )
  (fn-do + mounted _
    (call (. super mounted))
    (call claim-focus)
  )
  (fn-do + markup-attach-child _
    (param child GuiNode)
    (param anchor (? GuiNode))
    (call (. super markup-attach-child) child anchor)
    (if (is child Box)
      (= (. (as child Box) flex) 1)
    )
  )
)

(type + PaneSwitcher (is (of Switcher PaneVisit))
  (prop _ bench Workbench)
  (content
    (<> This
      (<> Box (slot: row) (param: entry) (• flex-row) (• flex 1)
        (<> Label (• flex 1)
          (= text (call (. bench visit-title) (. entry item)))
        )
        (<> Label (• switcher-detail)
          (= text (call (. bench visit-detail) (. entry item)))
        )
      )
    )
  )
)

(type + PaneEmpty (is Label))

(type + PaneDropHint (is Box)
  (prop _ rect Rect)
  (prop + is-tab _ (= false))
  (prop + is-float _ (= false))
  (prop + is-slot _ (= false))
  (prop + is-gap _ (= false))
  (prop + is-fluid _ (= false))
  (prop + is-bar _ (= false))
  (prop _ stroke _ (= (if-expr #is-tab gui-tab-stroke (if-expr #is-bar 0 workbench-hint-border))))
  (prop _ hint-width _ (= (if-expr #is-fluid (. SizeSpec auto) (call (. SizeSpec coord) (- (. #rect width) (* #stroke 2))))))
  (content
    (<> This
      (= left (call (. PositionOffset coord) (. #rect x)))
      (= top (call (. PositionOffset coord) (. #rect y)))
      (= flex (if-expr #is-fluid 1 0))
      (= min-width #hint-width)
      (= max-width #hint-width)
      (= min-height (call (. SizeSpec coord) (- (. #rect height) (* #stroke 2))))
      (= max-height (call (. SizeSpec coord) (- (. #rect height) (* #stroke 2))))
    )
  )
  (fn-expr + hit-contains _
    (param point Point)
    false
  )
)

(type + PaneStripPage (is Tuple)
  (prop + page String)
  (prop + root String)
  (prop + views (list String))
  (prop + shown (list String))
)

(type + PaneDockState (is Tuple)
  (prop + side PaneSide)
  (prop + pages (list PaneStripPage))
  (prop + current (? PanePage))
  (prop + mode PaneStripMode)
  (prop + is-collapsed Bool)
  (fn-expr + is-open Bool :get
    (and (!= current null) (not is-collapsed))
  )
  (fn-expr + is-topped Bool :get
    (!= mode (. PaneStripMode beside))
  )
  (fn-expr + is-single Bool :get
    (and (== (. pages length) 1) (!= current null))
  )
  (fn-expr + lit-page (? String) :get
    (only-if (?. current id) (if is-open))
  )
)

(type _ PaneStripSlot (is (tuple (: target PaneTarget) (: hint Rect))))

(type _ PaneStripMark (is (tuple (: at Length) (: target PaneTarget))))

(type + PaneDockView (is Box)
  (prop _ bench Workbench)
  (prop _ side PaneSide)
  (prop _ state _ (= ([] (. bench #docks) #side)))
  (prop _ dock-size _ (= (call workbench-revised (. (call (. (call (. bench model layout)) dock) #side) size) (. bench #revision))))
  (prop _ is-carrying _ (= (call workbench-carrying bench (. bench #dragging) (. bench #carried-payload))))
  (content
    (<> This (• flex-col)
      (= display (if-expr (. #state is-open) (. Display visible) (. Display hidden)))
      (<> Box (• workbench-title-spacer))
      (<> Box (• flex-col) (• flex 1)
        (if (!= (. #state current) null)
          (<> Box (• workbench-dock-body) (• flex-col) (• flex 1)
            (if (and (. #state is-topped) (or (not (. #state is-single)) #is-carrying))
              (<> PaneStrip (• pane-strip-row)
                (= bench bench)
                (= side #side)
                (= is-row true)
                (= is-inside true)
                (= is-live (. #state is-open))
              )
            )
            (<> PaneNodeView (• flex 1) (• mx (/ workbench-gap 2)) (• mb (/ workbench-gap 2))
              (= bench bench)
              (= node (. (!! (. #state current)) root))
              (= scope (. PaneScope layout))
              (= place (. PaneRegionKind dock))
              (= side #side)
              (= is-region true)
            )
            (<> Resizer
              (= edge (call workbench-dock-edge #side))
              (= min-size 150)
              (= max-size 900)
              (= size #dock-size)
              (= default-size pane-side-dock-size)
              (= collapse-size 70)
              (for (on length resized)
                (call (. bench model set-dock-size) side length)
              )
              (for (on event collapse-requested)
                (do-use (call motion $gui-motion-quick)
                  (call (. bench toggle-dock) side)
                )
              )
            )
          )
        )
      )
    )
  )
)

(type + PaneStripView (is Box)
  (prop _ bench Workbench)
  (prop _ side PaneSide)
  (prop _ state _ (= ([] (. bench #docks) #side)))
  (prop _ is-carrying _ (= (call workbench-carrying bench (. bench #dragging) (. bench #carried-payload))))
  (prop _ is-strip _ (= (and (> (. #state pages length) 0) (or (not (. #state is-single)) #is-carrying) (or (not (. #state is-open)) (not (. #state is-topped))) (!= (. #state mode) (. PaneStripMode top-only)))))
  (prop _ is-edge _ (= (and (not #is-strip) (not (. #state is-open)) #is-carrying)))
  (content
    (<> This (• flex-col)
      (= display (if-expr (or #is-strip #is-edge) (. Display visible) (. Display hidden)))
      (= min-width (call (. SizeSpec coord) (+ workbench-strip-width workbench-gap)))
      (= max-width (call (. SizeSpec coord) (+ workbench-strip-width workbench-gap)))
      (<> Box (• workbench-title-spacer))
      (<> Box (• flex-col) (• flex 1) (• mx (/ workbench-gap 2)) (• mb (/ workbench-gap 2))
        (if #is-edge
          (<> PaneEdgeTarget (• flex 1)
            (= bench bench)
            (= side #side)
          )
          (else
            (<> PaneStrip (• flex 1)
              (= bench bench)
              (= side #side)
              (= is-live #is-strip)
              (= is-boxed (. #state is-open))
            )
          )
        )
      )
    )
  )
)

(type + PaneDockTarget (is Box)
  (prop _ bench Workbench)
  (prop + is-drop-target _ (= false))
  (subscribe-for (on event drag-over)
    (let payload (call workbench-payload (. event payload)))
    (let carried (?? payload (call (. bench arriving) (. event payload))))
    (if (and carried (not (. event modifiers option)))
      (= is-drop-target (call hover (. carried drag) (. event root-point)))
      (call (. event accept) null (if-expr (not is-drop-target) (. DropOperation none) drop-kind)
        (block
          (lazy drop-kind (if-expr payload (. DropOperation move) (. DropOperation copy)))
        )
      )
      (else
        (call leave-drop)
      )
    )
  )
  (subscribe-for (on session drag-leave (when arrival))
    (call leave-drop)
  )
  (subscribe-for (on session drop (when arrival))
    (let payload (call workbench-payload (. session payload)))
    (let carried (?? payload (call (. bench arriving) (. session payload))))
    (let target (only-if (call target-at (. carried drag) (. session point)) (if carried)))
    (call leave-drop)
    (if (and payload target)
      (call (. bench settle-drop) (. payload drag) target)
      (else-if target
        (do-use gui-still-cause
          (call (. bench open-drop) (. session payload) target)
        )
      )
    )
  )
  (fn-expr + target-at (? PaneTarget)
    (param drag PaneDrag)
    (param point Point)
    null
  )
  (fn-expr + hover Bool
    (param drag PaneDrag)
    (param point Point)
    (!= (call target-at drag point) null)
  )
  (fn-do + leave-drop _
    (= is-drop-target false)
  )
)

(type + PaneStrip (is PaneDockTarget)
  (prop _ side PaneSide)
  (prop + is-row _ (= false))
  (prop + is-boxed _ (= false))
  (prop _ is-inside _ (= false))
  (prop _ is-live _ (= false))
  (prop _ state _ (= ([] (. bench #docks) #side)))
  (prop _ roles _ (= (call workbench-revised (call (. bench model role-views)) (. bench #revision))))
  (prop _ placed _ (= (call workbench-revised (call workbench-placed (. bench model) #roles) (. bench #revision))))
  (prop _ peek _ (= (only-if (. bench #peek) (if (and #is-live (== (. bench #peek-side) #side))))))
  (prop _ hidden (list String))
  (prop _ overflow-items _
    (=
      (call workbench-revised
        (block
          (arg (call workbench-overflow bench (. #state pages) #hidden))
          (arg (. bench #label-revision))
        )
      )
    )
  )
  (prop _ widths (map String Length))
  (blank)
  (prop _ dock (of Ancestor PaneDockView))
  (content
    (<> This
      (= layout (call FlexLayout (if-expr #is-row (. Orientation horizontal) (. Orientation vertical))))
      (<> Box (id: tray) (• pane-strip-tray)
        (= layout (call FlexLayout (if-expr #is-row (. Orientation horizontal) (. Orientation vertical))))
        (for (in page (. #state pages) (keyed-by (. page page)))
          (<> PaneStripGroup
            (= bench bench)
            (= strip this)
            (= page page)
            (= is-row #is-row)
            (= lit-page (. #state lit-page))
            (= hidden #hidden)
          )
        )
      )
      (<> Box (• pane-strip-fill))
      (<> Box (id: tools) (• pane-header-actions) (• flex-row)
        (if (> (. #hidden length) 0)
          (<> IconButton (id: overflow) (• icon-chevrons-right)
            (= action (=> () :do (call (. overflow-menu show) (call (. PopupAnchor box) overflow))))
            (<> Tooltip (text: "More"))
          )
        )
      )
      (<> Menu (id: overflow-menu)
        (for (in item #overflow-items (keyed-by (. item key)))
          (<> MenuItem
            (= title (. item title))
            (= action (=> () :do (call (. bench press-strip) (. item view) side)))
          )
        )
      )
      (<> ContextMenu
        (for (in view #roles (keyed-by view))
          (<> MenuItem
            (= title (call (. bench title-for) view))
            (= is-on (has #placed view))
            (= action (=> () :do (call (. bench toggle-pane) view side)))
          )
        )
        (<> MenuSeparator)
        (<> MenuItem (text: "Strip Beside the Sidebar")
          (= is-on (== (. #state mode) (. PaneStripMode beside)))
          (= action (=> () :do (call (. bench model set-strip-mode) side (. PaneStripMode beside))))
        )
        (<> MenuItem (text: "Strip at the Top of the Sidebar")
          (= is-on (== (. #state mode) (. PaneStripMode top)))
          (= action (=> () :do (call (. bench model set-strip-mode) side (. PaneStripMode top))))
        )
        (<> MenuItem (text: "Strip Only at the Top of the Sidebar")
          (= is-on (== (. #state mode) (. PaneStripMode top-only)))
          (= action (=> () :do (call (. bench model set-strip-mode) side (. PaneStripMode top-only))))
        )
      )
      (if (!= #peek null)
        (<> PanePeek
          (= bench bench)
          (= view (!! #peek))
          (= side side)
          (= strip this)
        )
      )
    )
  )
  (fn-expr + target-at (? PaneTarget)
    (param drag PaneDrag)
    (param point Point)
    (?. (call slot-at drag point) target)
  )
  (fn-do + hover Bool
    (param drag PaneDrag)
    (param point Point)
    (let found (call slot-at drag point))
    (= (. bench strip-hint) (?. found hint))
    (call (. bench spring) (call button-at drag point) side)
    (return (!= found null))
  )
  (fn-do + leave-drop _
    (call (. super leave-drop))
    (= (. bench strip-hint) null)
    (call (. bench spring) null side)
  )
  (fn-do + did-layout _
    (call (. super did-layout))
    (call fit-items)
  )
  (fn-do _ fit-items _
    (return-if (if (not is-row)))
    (let icons (call (of List PaneStripButton)))
    (let keys (call (of List String)))
    (let groups (call group-boxes))
    (for (in group groups)
      (for (in item (call (. group item-boxes)))
        (let key (str "icon:" (. item view)))
        (+= keys key)
        (if (and (not (has hidden key)) (> (. item bounds width) 0))
          (= ([] widths key) (+ (. item bounds width) 4))
        )
        (+= icons item)
      )
    )
    (let extra (+ workbench-action-button 2))
    (let fixed (- (. tools bounds width) (if-expr (> (. hidden length) 0) extra 0)))
    (let room (- (. content-bounds width) fixed (* workbench-strip-group-gap (. groups length))))
    (let total (call sum (in (?? ([] widths each) workbench-strip-button) keys)))
    (let dropped (call (of List String)))
    (if (> total room)
      (let order (call (of List String)))
      (for (in lit (list false true))
        (for (in index (..< 0 (. icons length)))
          (let icon ([] icons (- (. icons length) 1 index)))
          (if (== (. icon is-lit) lit)
            (+= order (str "icon:" (. icon view)))
          )
        )
      )
      (let used total)
      (for (in key order)
        (if (> used (- room extra))
          (+= dropped key)
          (-= used (?? ([] widths key) workbench-strip-button))
        )
      )
    )
    (return-if (if (== (call (. "," join) dropped) (call (. "," join) hidden))))
    (= hidden dropped)
  )
  (fn-expr _ group-boxes (list PaneStripGroup)
    (call (of List PaneStripGroup)
      (block
        (spread (. tray active-children))
        (pipe ?*> (only-if (as each PaneStripGroup) (if (is each PaneStripGroup))))
      )
    )
  )
  (fn-expr _ along Length
    (param point Point)
    (if-expr is-row (. point x) (. point y))
  )
  (fn-do _ button-at (? String)
    (param drag PaneDrag)
    (param point Point)
    (for (in group (call group-boxes))
      (let page (. group page))
      (return-if ([] (. page views) 0) (if (and (!= ([] (. page views) 0) (. drag view)) (!= (. page root) (. drag stack)) holds-point)))
      (lazy holds-point (call (. group bounds contains) point))
    )
    (return null)
  )
  (fn-do _ slot-at (? PaneStripSlot)
    (param drag PaneDrag)
    (param point Point)
    (let groups (call group-boxes))
    (return-if null (if (== (. groups length) 0)))
    (let half (/ workbench-strip-group-gap 2))
    (let marks (call (of List PaneStripMark)))
    (for (in index (..< 0 (. groups length)))
      (let group ([] groups index))
      (let frame (. group bounds))
      (+= marks
        (call PaneStripMark
          (block
            (arg (- (if-expr is-row (. frame x) (. frame y)) half))
            (arg (call mark-target (. group page) false))
          )
        )
      )
      (if (== (+ index 1) (. groups length))
        (+= marks
          (call PaneStripMark
            (block
              (arg (+ (if-expr is-row (. frame right) (. frame bottom)) half))
              (arg (call mark-target (. group page) true))
            )
          )
        )
      )
    )
    (let at (call along point))
    (let best (? PaneStripMark) null)
    (for (in mark marks)
      (if (or (not best) (< (call abs (- (. mark at) at)) (call abs (- (. best at) at))))
        (= best mark)
      )
    )
    (return-if null (if (or (not best) (not (call (. bench model validate) drag (. best target))))))
    (return (call PaneStripSlot (. best target) (call hint-at (. best at))))
  )
  (fn-expr _ mark-target PaneTarget
    (param page PaneStripPage)
    (param after Bool)
    (call pane-slot-target side (if-expr after (call (. bench model page-after) side (. page page)) (. page page)))
  )
  (fn-expr _ hint-at Rect
    (param at Length)
    (case? is-row
      (call Rect
        (block
          (arg (- at (/ workbench-strip-bar 2) (. origin x)))
          (arg (- (+ (. area y) inset) (. origin y)))
          (arg workbench-strip-bar)
          (arg (- (. area height) (* inset 2)))
        )
      )
    )
    (default
      (call Rect
        (block
          (arg (- (+ (. area x) inset) (. origin x)))
          (arg (- at (/ workbench-strip-bar 2) (. origin y)))
          (arg (- (. area width) (* inset 2)))
          (arg workbench-strip-bar)
        )
      )
    )
    (where
      (lazy area bounds)
      (lazy origin (. bench bounds))
      (lazy inset Length 4)
    )
  )
)

(type + PaneStripGroup (is Box)
  (prop _ bench Workbench)
  (prop _ strip PaneStrip)
  (prop + page PaneStripPage)
  (prop + is-row _ (= false))
  (prop _ lit-page (? String))
  (prop _ hidden (list String))
  (prop _ is-up _ (= (or (== #lit-page (. #page page)) (and (> (. #page views length) 0) (== (. bench #peek) ([] (. #page views) 0))))))
  (prop _ is-folded _ (= (call workbench-strip-folded (. #page views) #hidden)))
  (content
    (<> This
      (= layout (call FlexLayout (if-expr #is-row (. Orientation horizontal) (. Orientation vertical))))
      (= display (if-expr #is-folded (. Display hidden) (. Display visible)))
      (if (> (. #page views length) 0)
        (for (in view (. #page views) (keyed-by view))
          (<> PaneStripButton
            (= bench bench)
            (= view view)
            (= views (. #page views))
            (= page-root (. #page root))
            (= side (. strip side))
            (= is-lit (and #is-up (has (. #page shown) view)))
            (= is-hidden (has #hidden (str "icon:" view)))
          )
        )
        (else
          (<> PaneStripBlank
            (= bench bench)
            (= view "")
            (= page #page)
            (= page-root (. #page root))
            (= side (. strip side))
            (= is-lit (== #lit-page (. #page page)))
          )
        )
      )
    )
  )
  (fn-expr _ item-boxes (list PaneStripButton)
    (call (of List PaneStripButton)
      (block
        (spread active-children)
        (pipe ?*> (only-if (as each PaneStripButton) (if (is each PaneStripButton))))
      )
    )
  )
)

(type + PaneStripItem (is PaneDragSource)
  (prop _ view String)
  (prop + page-root _ (= ""))
  (prop + is-lit _ (= false))
  (prop + is-hidden _ (= false))
  (prop + is-carried _ (= (call workbench-strip-carried (. bench #dragging) #view #page-root)))
  (blank)
  (prop _ was-lit _ (= false))
  (subscribe-for (on event pointer-down (when (and (== (. event button) (. PointerButton primary)) (not (. event modifiers control)) (== (. event click-count) 1))))
    (= was-lit is-lit)
    (if (not was-lit)
      (call press-item)
    )
  )
  (subscribe-for (on event click)
    (if was-lit
      (call press-item)
    )
    (= was-lit false)
    (call (. event cancel))
  )
  (subscribe-for (on event drag-start)
    (= was-lit false)
    (let drag (call item-drag))
    (if drag
      (call begin-drag event drag workbench-tab-width)
    )
  )
  (fn-expr + item-drag (? PaneDrag)
    (call (. bench model page-drag) view)
  )
  (fn-do + press-item _)
)

(type + PaneStripButton (is PaneStripItem)
  (prop + views (list String))
  (prop _ side PaneSide)
  (prop _ tooltip _
    (=
      (call workbench-revised
        (block
          (arg (?? (call (. bench tooltip-for) #view) (call (. bench title-for) #view)))
          (arg (. bench #label-revision))
        )
      )
    )
  )
  (prop _ marks _ (= (call workbench-revised (call (. bench tab-marks) #view) (. bench #label-revision))))
  (content
    (<> This (• flex-row)
      (<> PaneIcon
        (= bench bench)
        (= view #view)
      )
      (if (. #marks is-marked)
        (<> PaneTabMark
          (= marks #marks)
        )
      )
      (<> Tooltip
        (= text #tooltip)
      )
      (<> ContextMenu
        (<> PaneIconActions
          (= bench bench)
          (= view #view)
          (= views #views)
          (= anchor this)
        )
      )
    )
  )
  (fn-do + press-item _
    (call (. bench press-strip) view side)
  )
)

(type + PaneStripBlank (is PaneStripItem)
  (prop _ page PaneStripPage)
  (prop _ side PaneSide)
  (content
    (<> This (• flex-row)
      (<> LucideSquareDashed (• icon))
      (<> Tooltip (text: "Empty Pane"))
      (<> ContextMenu
        (<> MenuItem (text: "Close Pane") (• icon-x)
          (= action (=> () :do (call (. bench close-pane) (. page root))))
        )
      )
    )
  )
  (fn-expr + item-drag (? PaneDrag)
    null
  )
  (fn-do + press-item _
    (call (. bench press-page) side (. page page))
  )
)

(type + PaneStripActions (is Box)
  (prop _ bench Workbench)
  (prop _ view String)
  (prop _ anchor Box)
  (prop + views (list String))
  (prop _ can-menu _ (= true))
  (prop _ closes _ (= (if-expr (> (. #views length) 0) #views (call (of List String) #view))))
  (prop _ is-group _ (= (> (. #closes length) 1)))
  (prop _ is-menu _ (= (call workbench-revised (call (. bench model in-menu) #view) (. bench #revision))))
  (prop _ is-role _ (= (call workbench-revised (call workbench-all-roles (. bench model) #closes) (. bench #revision))))
  (prop _ is-folded _ (= (call workbench-revised (call (. bench model shows-buttons) #view) (. bench #revision))))
  (prop _ can-fold _ (= (and (not #is-group) (or #is-folded (call workbench-revised (call (. bench model can-inline) #view) (. bench #revision))))))
  (prop _ shows-menu _ (= #can-menu))
  (content
    (<> This (• flex-col)
      (if (not #is-group)
        (<> PaneViewItems
          (= bench bench)
          (= view view)
          (= can-rename false)
        )
      )
      (<> MenuItem (text: "Float") (• icon-picture-in-picture-2)
        (= action (=> () :do (call (. bench float-strip-view) view anchor)))
      )
      (if #shows-menu
        (<> MenuItem (text: "Open as Menu") (• icon-square-menu)
          (= is-on #is-menu)
          (= action (=> () :do (call (. bench model set-menu) view (not is-menu))))
        )
      )
      (if #can-fold
        (if #is-folded
          (<> MenuItem (text: "Expand Panel") (• icon-unfold-vertical)
            (= action (=> () :do (call fold false)))
          )
          (else
            (<> MenuItem (text: "Collapse Panel") (• icon-fold-vertical)
              (= action (=> () :do (call fold true)))
            )
          )
        )
      )
      (<> MenuSeparator)
      (<> PaneMoveItems
        (= bench bench)
        (= view #view)
      )
      (<> MenuSeparator)
      (<> MenuItem
        (= title (if-expr #is-role "Hide" "Close"))
        (= action (=> () :do (call close-all)))
      )
    )
  )
  (fn-do _ fold _
    (param collapsed Bool)
    (call (. bench model set-inline) view collapsed)
  )
  (fn-do _ close-all _
    (for (in each closes)
      (call (. bench close-view) each)
    )
  )
)

(type + PaneTabActions (is Box)
  (prop _ bench Workbench)
  (prop _ view String)
  (prop _ scope PaneScope)
  (prop _ stack String)
  (prop _ place PaneRegionKind)
  (prop _ views (list String))
  (prop _ anchor Box)
  (prop _ is-page _ (= false))
  (prop _ is-alone _ (= (<= (. #views length) 1)))
  (prop _ can-float _ (= (not (and #is-alone (== #place (. PaneRegionKind float))))))
  (prop _ can-float-group _ (= (and (not #is-alone) (!= #place (. PaneRegionKind float)))))
  (prop _ is-collapsed _
    (=
      (call workbench-revised
        (block
          (arg (?? (?. (call (. bench model stack-in) #scope #stack) is-collapsed) false))
          (arg (. bench #revision))
        )
      )
    )
  )
  (prop _ can-collapse _ (= (call workbench-revised (call (. bench model can-collapse) #scope #stack) (. bench #revision))))
  (prop _ can-inline _ (= (call workbench-revised (call (. bench model can-inline) #view) (. bench #revision))))
  (prop _ is-menu _ (= (call workbench-revised (call (. bench model in-menu) #view) (. bench #revision))))
  (content
    (<> This (• flex-col)
      (<> PaneViewItems
        (= bench bench)
        (= view #view)
      )
      (<> MenuItem (text: "Float Tab") (• icon-picture-in-picture-2)
        (= is-enabled #can-float)
        (= action (=> () :do (call (. bench float-view) view scope stack anchor)))
      )
      (<> MenuItem (text: "Float Group") (• icon-app-window)
        (= is-enabled #can-float-group)
        (= action (=> () :do (call (. bench float-stack) scope stack anchor)))
      )
      (if #is-page
        (<> MenuItem (text: "Open as Menu") (• icon-square-menu)
          (= is-on #is-menu)
          (= action (=> () :do (call (. bench model set-menu) view (not is-menu))))
        )
      )
      (if #is-collapsed
        (<> MenuItem (text: "Expand Panel") (• icon-unfold-vertical)
          (= action (=> () :do (call (. bench model set-collapsed) scope stack false)))
        )
        (else
          (<> MenuItem (text: "Collapse Panel") (• icon-fold-vertical)
            (= is-enabled (or #can-inline #can-collapse))
            (= action (=> () :do (call collapse)))
          )
        )
      )
      (<> MenuSeparator)
      (<> MenuItem (text: "Split Right") (• icon-panel-right-dashed)
        (= is-enabled (not #is-alone))
        (= action (=> () :do (call (. bench split-view) view scope stack (. PaneZone right))))
      )
      (<> MenuItem (text: "Split Left") (• icon-panel-left-dashed)
        (= is-enabled (not #is-alone))
        (= action (=> () :do (call (. bench split-view) view scope stack (. PaneZone left))))
      )
      (<> MenuItem (text: "Split Down") (• icon-panel-bottom-dashed)
        (= is-enabled (not #is-alone))
        (= action (=> () :do (call (. bench split-view) view scope stack (. PaneZone bottom))))
      )
      (<> MenuItem (text: "Split Up") (• icon-panel-top-dashed)
        (= is-enabled (not #is-alone))
        (= action (=> () :do (call (. bench split-view) view scope stack (. PaneZone top))))
      )
      (<> MenuSeparator)
      (if #is-page
        (<> PaneMoveItems
          (= bench bench)
          (= view #view)
        )
        (<> MenuSeparator)
      )
      (<> MenuItem (text: "Close Tab") (• icon-x)
        (= action (=> () :do (call (. bench close-view) view)))
      )
    )
  )
  (fn-do _ collapse _
    (if can-inline
      (call (. bench model set-inline) view true)
      (else
        (call (. bench model set-collapsed) scope stack true)
      )
    )
  )
)

(type + PaneMoveItems (is Box)
  (prop _ bench Workbench)
  (prop _ view String)
  (prop _ side _ (= (call workbench-revised (call workbench-dock-side (. bench model) #view) (. bench #revision))))
  (prop _ is-bottom _ (= (call workbench-revised (call (. bench model in-bottom) #view) (. bench #revision))))
  (content
    (<> This (• flex-col)
      (if (!= #side (. PaneSide left))
        (<> MenuItem (text: "Move to Left") (• icon-panel-left)
          (= action (=> () :do (call (. bench model move-to-dock) view (. PaneSide left))))
        )
      )
      (if (!= #side (. PaneSide right))
        (<> MenuItem (text: "Move to Right") (• icon-panel-right)
          (= action (=> () :do (call (. bench model move-to-dock) view (. PaneSide right))))
        )
      )
      (if (not #is-bottom)
        (<> MenuItem (text: "Move to Bottom") (• icon-panel-bottom)
          (= action (=> () :do (call (. bench model move-to-bottom) view)))
        )
      )
    )
  )
)

(type + PaneIconActions (is Box)
  (prop _ bench Workbench)
  (prop _ view String)
  (prop _ views (list String))
  (prop _ anchor Box)
  (prop _ lone _ (= (call workbench-revised (call workbench-lone-tab (. bench model) #view) (. bench #revision))))
  (content
    (<> This (• flex-col)
      (if (!= #lone null)
        (<> PaneTabActions
          (= bench bench)
          (= view #view)
          (= scope (. (!! #lone) scope))
          (= stack (. (!! #lone) stack))
          (= place (. (!! #lone) region kind))
          (= views #views)
          (= anchor anchor)
          (= is-page true)
        )
        (else
          (<> PaneStripActions
            (= bench bench)
            (= view #view)
            (= views #views)
            (= anchor anchor)
          )
        )
      )
    )
  )
)

(type + PaneInlineButtons (is Box)
  (prop _ bench Workbench)
  (prop _ view String)
  (prop _ buttons _ (= (call workbench-revised (call (. bench buttons-for) #view) (. bench #label-revision))))
  (content
    (<> This (• flex-row) (• items-center)
      (for (in button #buttons (keyed-by (. button key)))
        (<> PaneButtonView
          (= bench bench)
          (= view view)
          (= button button)
        )
      )
    )
  )
)

(type + PaneViewItems (is Box)
  (prop _ bench Workbench)
  (prop _ view String)
  (prop _ can-rename _ (= true))
  (prop _ menu _ (= (call workbench-revised (call (. bench make-tab-menu) #view) (. bench #label-revision))))
  (prop _ is-renamable _ (= (and #can-rename (!= (call workbench-revised (call (. bench rename-text) #view) (. bench #label-revision)) null))))
  (content
    (<> This (• flex-col)
      (if #menu
        (!! #menu)
        (<> MenuSeparator)
      )
      (if #is-renamable
        (<> MenuItem (text: "Rename…")
          (= action (=> () :do (call (. bench begin-rename) view)))
        )
        (<> MenuSeparator)
      )
    )
  )
)

(type + PaneButtonView (is PaneStripItem)
  (prop + button PaneButton)
  (prop + is-lit _ (= (or (. #button is-on) (== (. bench #popover-key) (str #view ":" (. #button key))))))
  (prop + is-muted _ (= (. #button is-muted)))
  (prop + is-available _ (= (. #button is-available)))
  (prop _ icon _ (= (call (. #button make-icon))))
  (prop _ menu _ (= (call (. #button make-menu))))
  (prop _ tooltip _ (= (call workbench-button-tooltip #button)))
  (content
    (<> This (• flex-row)
      (if #icon
        (<> Box (• pane-button-icon) (• flex-col)
          (!! #icon)
        )
      )
      (<> Label (• pane-button-title)
        (= text (. #button title))
      )
      (if (. #button marks is-marked)
        (<> PaneTabMark
          (= marks (. #button marks))
        )
      )
      (if (> (. #tooltip length) 0)
        (<> Tooltip
          (= text #tooltip)
        )
      )
      (<> ContextMenu
        (if #menu
          (!! #menu)
          (<> MenuSeparator)
        )
        (<> PaneStripActions
          (= bench bench)
          (= view view)
          (= anchor this)
          (= can-menu false)
        )
      )
    )
  )
  (subscribe-for (on event click)
    (call (. bench press-button) view button this)
    (call (. event cancel))
  )
  (fn-expr + item-drag (? PaneDrag)
    (only-if (call pane-view-drag view (. place scope) (. place stack)) (if place))
    (where
      (lazy place (call (. bench model locate) view))
    )
  )
)

(type + PaneButtonPopover (is Popover)
  (prop + content (? Box))
  (content
    (<> This (• flex-col)
      (if #content
        (!! #content)
      )
    )
  )
  (subscribe-for (on event (. Choosing chosen))
    (call dismiss)
  )
)

(type + PaneEdgeTarget (is PaneDockTarget)
  (prop _ side PaneSide)
  (content
    (<> This (• flex-col))
  )
  (fn-expr + target-at (? PaneTarget)
    (param drag PaneDrag)
    (param point Point)
    (only-if target (if (call (. bench model validate) drag target)))
    (where
      (lazy target (call pane-slot-target side))
    )
  )
)

(type + PaneBottomTarget (is PaneDockTarget)
  (prop _ is-carrying _ (= (call workbench-carrying bench (. bench #dragging) (. bench #carried-payload))))
  (prop _ is-missing _ (= (call workbench-revised (not (call (. bench model has-bottom))) (. bench #revision))))
  (content
    (<> This (• flex-col) (• items-center) (• justify-center)
      (= display (if-expr (and #is-carrying #is-missing) (. Display visible) (. Display hidden)))
      (<> Label (text: "Bottom dock") (• pane-edge-label))
    )
  )
  (fn-expr + target-at (? PaneTarget)
    (param drag PaneDrag)
    (param point Point)
    (only-if (. PaneTarget bottom) (if (call (. bench model validate) drag (. PaneTarget bottom))))
  )
)

(type + PaneFloatView (is Box)
  (prop _ bench Workbench)
  (prop _ region PaneRegion)
  (prop _ frame-x Length (= (call workbench-revised (. #region x) (. bench #revision))))
  (prop _ frame-y Length (= (call workbench-revised (. #region y) (. bench #revision))))
  (prop _ frame-width Length (= (call workbench-revised (. #region width) (. bench #revision))))
  (prop _ frame-height Length (= (call workbench-revised (. #region height) (. bench #revision))))
  (prop _ tree _ (= (call workbench-revised (. #region root) (. bench #revision))))
  (prop + is-lit _
    (=
      (call workbench-holds
        (block
          (arg #tree)
          (arg (call workbench-revised (call (. bench model focused-stack)) (. bench #focus-revision)))
        )
      )
    )
  )
  (blank)
  (prop _ start-x Length (= 0))
  (prop _ start-y Length (= 0))
  (prop _ start-width Length (= 0))
  (prop _ start-height Length (= 0))
  (content
    (<> This (• flex-col)
      (= left (call (. PositionOffset coord) #frame-x))
      (= top (call (. PositionOffset coord) (call max workbench-title-height #frame-y)))
      (= min-width (call (. SizeSpec coord) (- #frame-width (* workbench-float-border 2))))
      (= max-width (call (. SizeSpec coord) (- #frame-width (* workbench-float-border 2))))
      (= min-height (call (. SizeSpec coord) (- #frame-height (* workbench-float-border 2))))
      (= max-height (call (. SizeSpec coord) (- #frame-height (* workbench-float-border 2))))
      (if (!= #tree null)
        (<> PaneNodeView (• flex 1)
          (= bench bench)
          (= node (!! #tree))
          (= scope (. PaneScope layout))
          (= place (. PaneRegionKind float))
          (= float-id (. #region id))
          (= is-region true)
        )
      )
      (for (in sides workbench-float-sides)
        (<> PaneFloatEdge
          (= float this)
          (= sides sides)
        )
      )
    )
  )
  (prop _ moving _
    (machine
      (state rest)
      (blank)
      (state moving (trigger for press pointer-down (and (== (. press button) (. PointerButton primary)) (call (. bench is-float-grab) (. region id) (. press root-point))))
        (do
          (= start-x frame-x)
          (= start-y frame-y)
        )
        (blank)
        (for (on drag pointer-drag (when (== (. drag pointer-id) (. press pointer-id))))
          (call (. drag cancel))
          (call move-by
            (block
              (arg (call Point (- (. drag root-point x) (. press root-point x)) (- (. drag root-point y) (. press root-point y))))
            )
          )
        )
        (blank)
        (then rest (trigger for up pointer-up (== (. up pointer-id) (. press pointer-id)))
          (do
            (call (. up cancel))
            (call commit-frame)
          )
        )
      )
    )
  )
  (fn-do + mounted _
    (call (. super mounted))
    (call set-theme-tag "glass" false)
  )
  (fn-do _ move-by _
    (param delta Point)
    (let moved (call (. bench fit-float) (call Rect (+ start-x (. delta x)) (+ start-y (. delta y)) frame-width frame-height)))
    (= frame-x (. moved x))
    (= frame-y (. moved y))
  )
  (fn-do _ begin-resize _
    (= start-x frame-x)
    (= start-y frame-y)
    (= start-width frame-width)
    (= start-height frame-height)
  )
  (fn-do _ resize-by _
    (param sides PaneFloatSides)
    (param delta Point)
    (let area (call (. bench float-area)))
    (let left start-x)
    (let top start-y)
    (let right (+ start-x start-width))
    (let bottom (+ start-y start-height))
    (if (. sides left)
      (= left (call max (. area x) (call min (- right workbench-float-min-width) (+ left (. delta x)))))
    )
    (if (. sides right)
      (= right (call min (. area right) (call max (+ left workbench-float-min-width) (+ right (. delta x)))))
    )
    (if (. sides top)
      (= top (call max (. area y) (call min (- bottom workbench-float-min-height) (+ top (. delta y)))))
    )
    (if (. sides bottom)
      (= bottom (call min (. area bottom) (call max (+ top workbench-float-min-height) (+ bottom (. delta y)))))
    )
    (= frame-x left)
    (= frame-y top)
    (= frame-width (- right left))
    (= frame-height (- bottom top))
  )
  (fn-do _ commit-frame _
    (call (. bench model move-float) (. region id) frame-x frame-y frame-width frame-height)
  )
)

(type + PaneFloatEdge (is Box)
  (prop _ float PaneFloatView)
  (prop _ sides PaneFloatSides)
  (prop _ is-corner _ (= (and (or (. #sides left) (. #sides right)) (or (. #sides top) (. #sides bottom)))))
  (content
    (<> This
      (= left (if-expr (. #sides right) null (call (. PositionOffset coord) (if-expr (. #sides left) 0 workbench-float-corner))))
      (= right (if-expr (. #sides left) null (call (. PositionOffset coord) (if-expr (. #sides right) 0 workbench-float-corner))))
      (= top (if-expr (. #sides bottom) null (call (. PositionOffset coord) (if-expr (. #sides top) 0 workbench-float-corner))))
      (= bottom (if-expr (. #sides top) null (call (. PositionOffset coord) (if-expr (. #sides bottom) 0 workbench-float-corner))))
      (= min-width (if-expr (or (. #sides left) (. #sides right)) (call (. SizeSpec coord) (if-expr #is-corner workbench-float-corner workbench-float-edge)) (. SizeSpec auto)))
      (= max-width (if-expr (or (. #sides left) (. #sides right)) (call (. SizeSpec coord) (if-expr #is-corner workbench-float-corner workbench-float-edge)) (. SizeSpec auto)))
      (= min-height (if-expr (or (. #sides top) (. #sides bottom)) (call (. SizeSpec coord) (if-expr #is-corner workbench-float-corner workbench-float-edge)) (. SizeSpec auto)))
      (= max-height (if-expr (or (. #sides top) (. #sides bottom)) (call (. SizeSpec coord) (if-expr #is-corner workbench-float-corner workbench-float-edge)) (. SizeSpec auto)))
      (= cursor (call workbench-float-cursor #sides))
    )
  )
  (prop _ gesture _
    (machine
      (state idle)
      (blank)
      (state resizing (trigger for press pointer-down (== (. press button) (. PointerButton primary)))
        (do
          (call (. float begin-resize))
        )
        (blank)
        (for (on drag pointer-drag (when (== (. drag pointer-id) (. press pointer-id))))
          (call (. drag cancel))
          (call (. float resize-by)
            (block
              (arg sides)
              (arg (call Point (- (. drag root-point x) (. press root-point x)) (- (. drag root-point y) (. press root-point y))))
            )
          )
        )
        (blank)
        (then idle (trigger for up pointer-up (== (. up pointer-id) (. press pointer-id)))
          (do
            (call (. up cancel))
            (call (. float commit-frame))
          )
        )
      )
    )
  )
)

(type + PanePeek (is Popup)
  (prop _ bench Workbench)
  (prop _ view String)
  (prop _ side PaneSide)
  (prop _ strip PaneStrip)
  (prop _ size _ (= (call workbench-revised (. (call (. (call (. bench model layout)) dock) #side) size) (. bench #revision))))
  (prop _ group _ (= (call workbench-revised (call workbench-peek-group (. bench model) #view) (. bench #revision))))
  (content
    (<> This (• flex-col)
      (= placement (call PanePeekPlacement #side strip #size))
      (if (!= #group null)
        (<> PaneNodeView (• flex 1) (• mt (/ workbench-gap 2))
          (= bench bench)
          (= node (!! #group))
          (= scope (. PaneScope layout))
          (= place (. PaneRegionKind dock))
          (= side #side)
        )
        (else
          (if (== (. bench #renaming) #view)
            (<> Box (• pane-peek-header) (• flex-row)
              (<> PaneIcon
                (= bench bench)
                (= view #view)
              )
              (<> PaneRenameInput (• pane-peek-rename)
                (= bench bench)
                (= view #view)
                (= text (?? (call (. bench rename-text) #view) ""))
              )
            )
          )
          (<> PaneContentHost (• flex 1)
            (= bench bench)
            (= view #view)
            (= context (. (call workbench-host (. bench model) #view (. bench model current)) context))
          )
        )
      )
    )
  )
  (subscribe-for (on reason dismissed (when arrival))
    (call (. bench close-peek) view)
  )
  (subscribe-for (on event (. Choosing chosen))
    (call (. bench close-peek) view)
  )
  (fn-do + mounted _
    (call (. super mounted))
    (call show)
  )
)

(fn-expr _ workbench-peek-group (? PaneNode)
  (param model PaneModel)
  (param view String)
  (only-if (. page root) (if (and page (> (. (call (. model page-views) page) length) 1))))
  (where
    (lazy page (?. (call (. model locate) view) page))
  )
)

(type + PanePeekPlacement (is Placement)
  (prop _ side PaneSide)
  (prop _ strip PaneStrip)
  (prop _ size Length)
  (fn-do + This _
    (param side _)
    (param strip _)
    (param size _)
  )
  (fn-do + place _
    (param request PlacementRequest)
    (let area (. request anchor))
    (if (. strip is-inside)
      (let floor (?? (. (?. (. strip dock) bounds) bottom) (. request boundary bottom)))
      (return (call PlacementResult (call Rect (. area x) (. area bottom) (. area width) (call max 0.0 (- floor (. area bottom))))))
    )
    (return
      (match side
        (case= (. PaneSide left)
          (call PlacementResult (call Rect (. area right) (. area y) size (. area height)))
        )
        (case= (. PaneSide right)
          (call PlacementResult (call Rect (- (. area x) size) (. area y) size (. area height)))
        )
      )
    )
  )
)

(fn-do _ workbench-corner String
  (param root (? PaneNode))
  (param revision U64)
  (let cursor root)
  (while (and cursor (. cursor is-split) (> (. cursor kids length) 0))
    (= cursor ([] (. cursor kids) (if-expr (== (. cursor axis) (. PaneAxis row)) (- (. cursor kids length) 1) 0)))
  )
  (let ignored revision)
  (return (?? (?. cursor id) ""))
)

(fn-do _ workbench-inlined (list String)
  (param model PaneModel)
  (param stack PaneNode)
  (let tabs (call (. model tab-views) stack))
  (return (call (of List String) (in each (call (. model visible-views) stack) (when (not (has tabs each))))))
)

(fn-expr _ workbench-dock-side (? PaneSide)
  (param model PaneModel)
  (param view String)
  (only-if (. place region side) (if (and place (== (. place region kind) (. PaneRegionKind dock)))))
  (where
    (lazy place (call (. model locate) view))
  )
)

(fn-expr _ workbench-lone-tab (? PaneLocation)
  (param model PaneModel)
  (param view String)
  (case? (or (not place) (!= (. place region kind) (. PaneRegionKind dock)))
    null
  )
  (case? (or (not page) (!= (. (call (. model page-views) page) length) 1))
    null
  )
  (case? (!= (. (call workbench-stack-tabs model (. place scope) (. place stack)) length) 1)
    null
  )
  (default
    place
  )
  (where
    (lazy place (call (. model locate) view))
    (lazy page (. place page))
  )
)

(fn-expr _ workbench-is-iconic Bool
  (param model PaneModel)
  (param view String)
  (case? (or (not place) (!= (. place region kind) (. PaneRegionKind dock)))
    false
  )
  (case? (or (not page) (!= (. (call workbench-stack-tabs model (. place scope) (. place stack)) length) 1))
    false
  )
  (default
    (or (== (. views length) 1) (and (== (. (call (. model pages-in) (. place region side)) length) 1) (== ([] views 0) view)))
  )
  (where
    (lazy place (call (. model locate) view))
    (lazy page (. place page))
    (lazy views (call (. model page-views) page))
  )
)

(fn-expr _ workbench-stack-tabs (list String)
  (param model PaneModel)
  (param scope PaneScope)
  (param stack String)
  (if-expr node (call (. model tab-views) node) (call (of List String)))
  (where
    (lazy node (call (. model stack-in) scope stack))
  )
)

(fn-do _ workbench-docks (list PaneDockState)
  (param model PaneModel)
  (let docks (call (of List PaneDockState)))
  (for (in side (list (. PaneSide left) (. PaneSide right)))
    (let region (call (. (call (. model layout)) dock) side))
    (let pages (call (of List PaneStripPage) (in (call workbench-strip-page model each) (call (. model pages-in) side))))
    (+= docks (call PaneDockState side pages (call (. model current-page) side) (. region strip) (. region is-collapsed)))
  )
  (return docks)
)

(fn-expr _ workbench-strip-page PaneStripPage
  (param model PaneModel)
  (param page PanePage)
  (call PaneStripPage (. page id) (. page root id) views (call (of List String) (in each views (when (call (. model is-shown) each)))))
  (where
    (lazy views (call (. model page-views) page))
  )
)

(fn-expr _ workbench-button-tooltip String
  (param button PaneButton)
  (case? (and (not (. button is-available)) (> (. button unavailable-reason length) 0))
    (. button unavailable-reason)
  )
  (default
    (. button description)
  )
)

(fn-do _ workbench-overflow (list PaneOverflowItem)
  (param bench Workbench)
  (param pages (list PaneStripPage))
  (param hidden (list String))
  (let items (call (of List PaneOverflowItem)))
  (return-if items (if (== (. hidden length) 0)))
  (for (in page pages)
    (for (in view (. page views))
      (let key (str "icon:" view))
      (if (has hidden key)
        (+= items (call PaneOverflowItem key view (call (. bench title-for) view)))
      )
    )
  )
  (return items)
)

(fn-expr _ workbench-strip-folded Bool
  (param views (list String))
  (param hidden (list String))
  (and (> (. views length) 0) (call all views (:where (has hidden (str "icon:" each)))))
)

(fn-expr _ workbench-strip-carried Bool
  (param dragging (? PaneDragPayload))
  (param view String)
  (param root String)
  (case? (not dragging)
    false
  )
  (case? (. dragging drag view)
    (== (. dragging drag view) view)
  )
  (default
    (== (. dragging drag stack) root)
  )
)

(fn-do _ workbench-all-roles Bool
  (param model PaneModel)
  (param views (list String))
  (let roles (call (. model role-views)))
  (return (call all views (:where (has roles each))))
)

(fn-expr _ workbench-placed (list String)
  (param model PaneModel)
  (param views (list String))
  (call (of List String) (in each views (when (!= (call (. model locate) each) null))))
)

(fn-expr _ workbench-float-cursor CursorStyle
  (param sides PaneFloatSides)
  (case? (or (and (. sides left) (. sides top)) (and (. sides right) (. sides bottom)))
    (. CursorStyle resize-nwse)
  )
  (case? (or (and (. sides right) (. sides top)) (and (. sides left) (. sides bottom)))
    (. CursorStyle resize-nesw)
  )
  (case? (or (. sides left) (. sides right))
    (. CursorStyle resize-horizontal)
  )
  (default
    (. CursorStyle resize-vertical)
  )
)

(fn-expr _ workbench-inset Length
  (param is-full-screen (? Bool))
  (param inset (? Length))
  (if-expr (?? is-full-screen false) window-full-screen-inset (?? inset window-stoplight-inset))
)

(fn-expr _ workbench-workspace-root PaneNode
  (param model PaneModel)
  (?? (. (call (. model layout)) workspace root) (call pane-stack-node "workspace-empty" (call (of List String))))
)

(fn-expr _ workbench-floats (list PaneRegion)
  (param model PaneModel)
  (call (of List PaneRegion) (. (call (. model layout)) floats))
)

(fn-expr _ workbench-dock-edge Side
  (param side PaneSide)
  (match side
    (case= (. PaneSide left)
      (. Side right)
    )
    (case= (. PaneSide right)
      (. Side left)
    )
  )
)

(fn-do _ workbench-cells (list PaneCell)
  (param model PaneModel)
  (param node PaneNode)
  (let cells (call (of List PaneCell)))
  (for (in index (..< 0 (. node kids length)))
    (let kid ([] (. node kids) index))
    (+= cells
      (call PaneCell
        (block
          (arg kid)
          (arg index)
          (arg (call (. node size-at) index))
          (arg (and (== (. node axis) (. PaneAxis column)) (call (. model is-folded-node) kid)))
        )
      )
    )
  )
  (return cells)
)

(fn-expr _ workbench-gutter-live Bool
  (param cells (list PaneCell))
  (param position Index)
  (and (call some ([] cells (..< 0 position)) (:where (not (. each is-collapsed)))) (call some ([] cells (..< position (. cells length))) (:where (not (. each is-collapsed)))))
)

(fn-expr _ workbench-top (list String)
  (param top (list String))
  (param reflow (? PaneReflow))
  (?? (?. reflow top) top)
)

(fn-expr _ workbench-placed (? Rect)
  (param reflow (? PaneReflow))
  (param id String)
  ([] (?. reflow frames) id)
)

(fn-expr _ workbench-vacated Bool
  (param reflow (? PaneReflow))
  (param id String)
  (?? (call (. (?. reflow hidden) has) id) false)
)

(fn-expr _ workbench-shifted Rect
  (param home Rect)
  (param was Rect)
  (param now Rect)
  (call Rect left top (call max 0.0 (- right left)) (call max 0.0 (- bottom top)))
  (where
    (lazy left (- (+ (. home x) (. now x)) (. was x)))
    (lazy top (- (+ (. home y) (. now y)) (. was y)))
    (lazy right (- (+ (. home right) (. now right)) (. was right)))
    (lazy bottom (- (+ (. home bottom) (. now bottom)) (. was bottom)))
  )
)

(fn-expr _ workbench-same-rect Bool
  (param a Rect)
  (param b Rect)
  (and same-origin (< (call abs (- (. a right) (. b right))) 0.5) (< (call abs (- (. a bottom) (. b bottom))) 0.5))
  (where
    (lazy same-origin (and (< (call abs (- (. a x) (. b x))) 0.5) (< (call abs (- (. a y) (. b y))) 0.5)))
  )
)

(fn-do _ workbench-folded-length Length
  (param source PaneModel)
  (param node PaneNode)
  (param place PaneRegionKind)
  (param top (list String))
  (return-if (call workbench-folded-extent place top (. node id)) (if (not (. node is-split))))
  (let gap Length (if-expr (!= place (. PaneRegionKind float)) workbench-gap 0))
  (let cells (call workbench-cells source node))
  (let total Length 0)
  (let tallest Length 0)
  (for (in cell cells)
    (let length (call workbench-folded-length source (. cell node) place top))
    (+= total length)
    (= tallest (call max tallest length))
  )
  (return (if-expr (== (. node axis) (. PaneAxis row)) tallest (+ total (* gap (- (call max (. cells length) 1) 1)))))
)

(fn-expr _ workbench-folded-extent Length
  (param place PaneRegionKind)
  (param top (list String))
  (param id String)
  (case? (call workbench-hoists place top id)
    workbench-title-height
  )
  (default
    (+ workbench-header-height (if-expr (== place (. PaneRegionKind float)) 1 0))
  )
)

(fn-expr _ workbench-region-root (? PaneNode)
  (param source PaneModel)
  (param place PaneRegionKind)
  (param side PaneSide)
  (param float-id String)
  (match? place
    (case= (. PaneRegionKind center)
      (. (call (. source layout)) center root)
    )
    (case= (. PaneRegionKind dock)
      (?. (call (. source current-page) side) root)
    )
    (case= (. PaneRegionKind float)
      (?. (call (. (call (. source layout)) find-float) float-id) root)
    )
  )
)

(fn-expr _ workbench-hoists Bool
  (param place PaneRegionKind)
  (param top (list String))
  (param id String)
  (and (call workbench-is-central place) (has top id))
)

(fn-expr _ workbench-carried (? String)
  (param dragging (? PaneDragPayload))
  (param stack String)
  (param scope PaneScope)
  (case? (not dragging)
    null
  )
  (case? (or (!= (. drag stack) stack) (!= (. drag scope) scope))
    null
  )
  (default
    (. drag view)
  )
  (where
    (lazy drag (. dragging drag))
  )
)

(fn-expr _ workbench-tab-divided Bool
  (param items (list String))
  (param item String)
  (param framed (? String))
  (param hovered (? String))
  (param carried (? String))
  (param held Bool)
  (and item-plain (!= leader null) (call workbench-tab-plain leader framed hovered carried))
  (where
    (lazy shown (if-expr held items (call (of List String) (in each items (when (!= each carried))))))
    (lazy item-plain (call workbench-tab-plain item framed hovered carried))
    (lazy index (?? (call (. shown find) item) 0))
    (lazy leader (only-if ([] shown (- index 1)) (if (> index 0))))
  )
)

(fn-expr _ workbench-tab-plain Bool
  (param item String)
  (param framed (? String))
  (param hovered (? String))
  (param carried (? String))
  (and (!= item "") (!= item framed) (!= item hovered) (!= item carried))
)

(fn-expr _ workbench-tab-slots (list String)
  (param views (list String))
  (param slot (? Index))
  (param carried (? String))
  (case? (== slot null)
    views
  )
  (case? (!= home null)
    (call (of List String)
      (block
        (spread ([] rest (..< 0 held)))
        (item? carried)
        (spread ([] rest (..< held (. rest length))))
      )
    )
  )
  (default
    (call (of List String)
      (block
        (spread ([] views (..< 0 at)))
        (item "")
        (spread ([] views (..< at (. views length))))
      )
    )
  )
  (where
    (lazy at (call min (?? slot (. views length)) (. views length)))
    (lazy home (only-if (call (. views find) carried) (if carried)))
    (lazy rest (call (of List String) (in each views (when (!= each carried)))))
    (lazy held (call min (if-expr (> at (?? home at)) (- at 1) at) (. rest length)))
  )
)

(fn-expr _ workbench-header-inset Length
  (param place PaneRegionKind)
  (param side PaneSide)
  (if-expr (== place (. PaneRegionKind dock)) (- gui-sidebar-row-inset gui-tab-tray-pad) 4)
)

(fn-expr _ workbench-header-fit PaneHeaderFit
  (param bench Workbench)
  (param place PaneRegionKind)
  (param is-hoisted Bool)
  (param frame Rect)
  (call PaneHeaderFit is-hoisted cramped nudged (== place (. PaneRegionKind float)) leading trailing)
  (where
    (lazy leading (if-expr is-hoisted (call max 0.0 (- (. bench leading-edge) (. frame x))) 0))
    (lazy trailing (if-expr is-hoisted (call max 0.0 (- (. frame right) (. bench trailing-edge))) 0))
    (lazy cramped (and is-hoisted (< (- (. frame width) leading trailing) workbench-min-hoisted-width)))
    (lazy nudged (and (!= place (. PaneRegionKind float)) (not (and is-hoisted (not cramped))) below-title))
    (lazy below-title (> (. frame y) (+ workbench-title-height 0.5)))
  )
)

(fn-expr _ workbench-same-region Bool
  (param source PaneStackView)
  (param target PaneStackView)
  (case? (and (call workbench-is-central (. source place)) (call workbench-is-central (. target place)))
    true
  )
  (default
    (and (== (. source place) (. target place)) (== (. source side) (. target side)) (== (. source float-id) (. target float-id)))
  )
)

(fn-expr _ workbench-is-central Bool
  (param place PaneRegionKind)
  (or (== place (. PaneRegionKind center)) (== place (. PaneRegionKind workspace)))
)

(fn-expr _ workbench-holds Bool
  (param tree (? PaneNode))
  (param stack (? String))
  (case? (or (not tree) (not stack))
    false
  )
  (default
    (call some (call (. tree stacks)) (:where (== (. each id) stack)))
  )
)

(fn-expr _ workbench-is-boxed Bool
  (param bench Workbench)
  (param place PaneRegionKind)
  (param side PaneSide)
  (param view (? String))
  (case? (or (not view) (== place (. PaneRegionKind float)))
    false
  )
  (case? (call workbench-is-central place)
    true
  )
  (default
    (call (. bench boxes-in-sidebar) view)
  )
)

(type _ PaneHost (is (tuple (: key String) (: view String) (: context String))))

(fn-expr _ workbench-host PaneHost
  (param model PaneModel)
  (param view String)
  (param context String)
  (if-expr is-instance (call PaneHost (str context "|" view) view context) (call PaneHost view view ""))
  (where
    (lazy is-instance (!= (call (. model instance-kind) view) null))
  )
)

(fn-expr _ workbench-host-key (? String)
  (param model PaneModel)
  (param view (? String))
  (param context String)
  (only-if (. (call workbench-host model view context) key) (if view))
)

(fn-do _ workbench-hosts (list PaneHost)
  (param model PaneModel)
  (param node PaneNode)
  (param views (list String))
  (param active (? String))
  (param context String)
  (param visited (list PaneHost))
  (param retained (list String))
  (param visits U64)
  (param revision U64)
  (let ignored (+ visits revision))
  (let hosts (list PaneHost))
  (for (in view views)
    (let host (call workbench-host model view context))
    (if (or (== view active) (call some visited (:where (== (. each key) (. host key)))))
      (+= hosts host)
    )
  )
  (for (in host visited)
    (if (and other-context (has retained (. host context)) holds-view)
      (+= hosts host)
    )
    (lazy other-context (and (!= (. host context) "") (!= (. host context) context)))
    (lazy holds-view (and (has (. node views) (. host view)) (call (. model holds-instance) (. host context) (. host view))))
  )
  (return hosts)
)

(fn-expr _ workbench-kept-visits (list PaneHost)
  (param visited (list PaneHost))
  (param context String)
  (param retained (list String))
  (call (of List PaneHost) (in each visited (when (or (== (. each context) "") (== (. each context) context) (has retained (. each context))))))
)

(fn-expr _ (of workbench-revised Value) Value
  (param value Value)
  (param revision U64)
  value
  (where
    (lazy ignored revision)
  )
)

(fn-expr _ workbench-payload (? PaneDragPayload)
  (param payload DragPayload)
  (only-if (as payload PaneDragPayload) (if (is payload PaneDragPayload)))
)

(fn-expr _ workbench-carrying Bool
  (param bench Workbench)
  (param dragging (? PaneDragPayload))
  (param payload (? DragPayload))
  (case? dragging
    true
  )
  (case? payload
    (and (not (is payload PaneDragPayload)) (call (. bench accepts-drop) payload))
  )
  (default
    false
  )
)

(fn-do _ workbench-zone PaneZone
  (param fx Float)
  (param fy Float)
  (param blocked (list PaneZone))
  (param held (? PaneZone) (= null))
  (param hx Float (= 0))
  (param hy Float (= 0))
  (if (and (!= held null) (!= held (. PaneZone center)) (not (has blocked held)))
    (let across (or (== held (. PaneZone left)) (== held (. PaneZone right))))
    (let depth
      (match held
        (case= (. PaneZone left)
          fx
        )
        (case= (. PaneZone right)
          (- 1 fx)
        )
        (case= (. PaneZone top)
          fy
        )
        (default
          (- 1 fy)
        )
      )
    )
    (return-if held (if (< depth (+ workbench-zone-edge (if-expr across hx hy)))))
  )
  (let inner (== held (. PaneZone center)))
  (let ex (- workbench-zone-edge (if-expr inner hx 0)))
  (let ey (- workbench-zone-edge (if-expr inner hy 0)))
  (let zone (. PaneZone center))
  (let nearest Float 1)
  (if (and (< fx ex) (< fx nearest) (not (has blocked (. PaneZone left))))
    (= zone (. PaneZone left))
    (= nearest fx)
  )
  (if (and (< (- 1 fx) ex) (< (- 1 fx) nearest) (not (has blocked (. PaneZone right))))
    (= zone (. PaneZone right))
    (= nearest (- 1 fx))
  )
  (if (and (< fy ey) (< fy nearest) (not (has blocked (. PaneZone top))))
    (= zone (. PaneZone top))
    (= nearest fy)
  )
  (if (and (< (- 1 fy) ey) (< (- 1 fy) nearest) (not (has blocked (. PaneZone bottom))))
    (= zone (. PaneZone bottom))
  )
  (return zone)
)

(fn-expr _ workbench-touches Bool
  (param edge Length)
  (param other Length)
  (param overlap Length)
  (param length Length)
  (and within-reach (> (* overlap 2) length))
  (where
    (lazy within-reach (and (<= (- edge other) workbench-touch-reach) (<= (- other edge) workbench-touch-reach)))
  )
)
