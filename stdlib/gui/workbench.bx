  (fn-do _ spring-now _
    (let view spring-view)
    (= spring-view null)
    (let page (?. (call (. model locate) (?? view "")) page))
    (return-if (if (or (not page) (not (call (. model opens) page)))))
    (let region (call (. (call (. model layout)) dock) spring-side))
    (if (or (. region is-collapsed) (!= (?. (call (. model current-page) spring-side) id) (. page id)))
      (do-use (call motion $gui-motion-quick)
        (call (. model show-page) spring-side (. page id))
      )
    )
  )
