(type-line + PaneReflow (is (tuple (: frames (map String Rect)) (: hidden (list String)) (: top (list String)))))
(type-line + PaneLanding (is (tuple (: body Rect) (: tab Rect) (: reflow PaneReflow))))
(type-line + PaneCell (is (tuple (: node PaneNode) (: index Index) (: size Float) (: is-collapsed Bool))))
(type-line + PaneFloatSides (is (tuple (: left Bool) (: top Bool) (: right Bool) (: bottom Bool))))

