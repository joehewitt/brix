(prop + workbench-title-height Length (= (+ workbench-header-height (* workbench-title-margin 2))))
(prop + workbench-stoplight-offset _
  (=
    (call Point
      (block
        (arg (. window-stoplight-offset x))
        (arg (- (+ (/ workbench-title-height 2) workbench-chrome-drop) window-stoplight-center))
      )
    )
  )
)
