  (fn-do + press-strip _
    (param view String)
    (param side PaneSide)
    (call close-popover)
    (if (call (. model in-menu) view)
      (if (and (== peek (call peek-of view)) (call (. model is-shown) view))
        (= peek null)
        (else
          (call (. model reveal) view false)
          (call show-peek view side)
