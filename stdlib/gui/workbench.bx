(type + PaneTabTone (is Union)
  (variant accent)
  (variant success)
  (variant warning)
  (variant danger)
)

(type + PaneTabMarks (is Tuple)
  (prop + is-modified _ (= false))
  (prop + is-changed _ (= false))
  (prop + is-busy _ (= false))
  (prop + tone (? PaneTabTone) (= null))
  (fn-expr + has-activity Bool :get
    (or is-busy (!= tone null))
  )
  (fn-expr + is-marked Bool :get
    (or has-activity is-modified)
  )
)

(type + PaneButton
  (implements Command)
  (prop + key _ (= ""))
  (prop + title _ (= ""))
  (prop + description _ (= ""))
  (prop + is-on _ (= false))
  (prop + is-muted _ (= false))
  (prop + enabled _ (= true))
  (prop + unavailable-reason _ (= ""))
  (prop + running _ (= false))
  (prop + marks _ (= (call PaneTabMarks)))
  (fn-expr + make-icon (? Box)
    null
  )
  (fn-expr + make-popover (? Box)
    null
  )
  (fn-expr + make-menu (? Box)
    null
  )
  (fn-expr + is-available _ :get
    enabled
  )
  (fn-expr + stable-key _ :get
    key
  )
  (fn-expr + identity _ :get
    this
  )
  (fn-do + run _)
)

(type _ PaneOverflowItem (is (tuple (: key String) (: view String) (: title String))))

(type + PaneDragPayload (is Tuple)
  (implements DragPayload)
  (prop _ drag PaneDrag)
  (prop _ width Length)
  (fn-expr + drag-kind _ :get
    "workbench.pane"
  )
)

(type + PaneHeaderFit (is Tuple)
  (prop _ is-hoisted _ (= false))
  (prop _ is-cramped _ (= false))
  (prop _ is-nudged _ (= false))
  (prop _ is-float _ (= false))
  (prop _ leading Length (= 0))
  (prop _ trailing Length (= 0))
  (fn-expr _ is-lifted _ :get
    (and is-hoisted (not is-cramped))
  )
  (fn-expr _ nudge Length :get
    (if-expr is-nudged workbench-gap 0)
  )
  (fn-expr _ bar-top Length :get
    (if-expr is-cramped workbench-title-height 0)
  )
  (fn-expr _ bar-height Length :get
    (- (if-expr is-lifted workbench-title-height workbench-header-height) nudge)
  )
  (fn-expr _ bar-left Length :get
    (if-expr is-lifted leading 0)
  )
  (fn-expr _ bar-right Length :get
    (- (if-expr is-lifted trailing 0) 4)
  )
  (fn-expr _ height Length :get
    (+ bar-top header-band (if-expr is-float 1 0))
    (where
      (lazy header-band (if-expr is-lifted workbench-title-height workbench-header-height))
    )
  )
)

(type + Workbench (is Box)
  (prop + model PaneModel)
  (prop + state-key (? String))
  (prop + revision _ (= (. #model #revision)))
  (prop _ focus-revision _ (= (+ (. #model #revision) (. #model #focus-revision))))
  (prop + view-revision U64)
  (prop _ label-revision _ (= (+ #view-revision #revision)))
  (prop + mounted-limit Size (= 8))
  (prop + retained-contexts (list String))
  (prop + renaming (? String))
  (prop _ top-stacks _ (= (call workbench-revised (call (. #model top-stacks)) #revision)))
  (prop _ reflow (? PaneReflow))
  (prop _ hoisted _ (= (call workbench-top #top-stacks #reflow)))
