(import ./box)
(import ./events)
(import ./keys)
(import ./placement)
(import ./popup)
(import ./primitives)
(import ./shorthands)
(import ./styles)
(import ./theme)
(import /core/list-cursor)
(import /ui/input)
(import /ui/key-combo)

(style-extend GUIDefaultTheme
  (using GUIBoxPaint)
  (using GUITextPaint)
  (using GUIBoxSpacing)
  (using GUIBoxSize)
  (using GUIPopupStyle)
  (rule Switcher (• transient) (• centered 56) (• flex-col) (• bg gui-glass-color) (• text gui-text-color) (• p 5) (• w 420) (• max-h 480)
    (= window-material gui-glass-material)
    (= border-color gui-border-color)
    (= border-width 1)
    (= corner-radius gui-popup-radius)
    (= shadow gui-popup-shadow)
    (= overflow-y (. ScrollOverflow auto))
  )
  (blank)
  (rule SwitcherRow (• flex-row) (• h 25) (• px 8) (• mb 1)
    (= corner-radius gui-control-radius)
    (blank)
    (when-style #is-highlighted
      (• bg gui-accent-color)
      (• text gui-accent-text-color)
    )
  )
)

(type + (of SwitcherEntry Item) (is Tuple)
  (prop + index Size)
  (prop + item Item)
)

(type + (of Switcher Item) (is Popup)
  (rule This
    (= focus-mode (. FocusMode keys))
  )
  (blank)
  (prop + items (list Item) (= (call (of List Item))))
  (prop + entries (list (of SwitcherEntry Item)) (= (call (of switcher-entries Item) #items)))
  (prop + selected-index Size (= 0))
  (prop + trigger _ (= (call KeyCombo)))
  (blank)
  (event + chosen Item)
  (content
    (<> This
      (= outside-press-passes false)
      (blank)
      (for (in entry #entries)
        (<> (of SwitcherRow Item)
          (= switcher this)
          (= index (. entry index))
          (blank)
          (+<> Box (id: row) (param: entry (of SwitcherEntry Item)) (• flex-row) (• flex 1))
        )
      )
      (blank)
      (<> KeyShortcut (text: "Next")
        (= key #trigger)
        (= discoverable false)
        (= action (=> () :do (call advance 1)))
      )
      (if (not (. #trigger modifiers shift))
        (<> KeyShortcut (text: "Previous")
          (= key (+ #trigger (. KeyModifier shift)))
          (= discoverable false)
          (= action (=> () :do (call advance -1)))
        )
      )
      (<> KeyShortcut (text: "Next")
        (= key .arrow-down)
        (= discoverable false)
        (= action (=> () :do (call advance 1)))
      )
      (<> KeyShortcut (text: "Previous")
        (= key .arrow-up)
        (= discoverable false)
        (= action (=> () :do (call advance -1)))
      )
      (<> KeyShortcut (text: "Choose")
        (= key .enter)
        (= repeat false)
        (= discoverable false)
        (= action (=> () :do (call choose-selected)))
      )
      (<> SwitcherHold
        (= key (call switcher-held-key #trigger))
        (for (on modifiers changed)
          (call release modifiers)
        )
      )
    )
  )
  (fn-do + present _
    (param choices (list Item))
    (param key KeyCombo)
    (if is-open
      (call advance 1)
      (return)
    )
    (return-if (if (== (. choices length) 0)))
    (= items choices)
    (= trigger key)
    (= selected-index 0)
    (call show)
    (call advance 1)
  )
  (fn-do + advance _
    (param offset Int)
    (let next (call (. (call ListCursor (. items length) selected-index) wrapped) offset))
    (if (!= next null)
      (= selected-index next)
    )
  )
  (fn-do + choose-selected _
    (call choose-at selected-index)
  )
  (fn-do + choose-at _
    (param index Size)
    (return-if (if (>= index (. items length))))
    (call choose ([] items index))
  )
  (fn-do + choose _
    (param item Item)
    (call dismiss (. DismissReason chosen))
    (<- chosen item)
  )
  (fn-do _ release _
    (param modifiers PointerModifiers)
    (return-if (if (or (not is-open) (not (call switcher-released (. trigger modifiers) modifiers)))))
    (call choose-selected)
  )
)

(type + (of SwitcherRow Item) (is Box)
  (prop + switcher (? (of Switcher Item)))
  (prop + index Size (= 0))
  (prop + is-highlighted _ (= (== (?. #switcher #selected-index) #index)))
  (whenever-rule #is-highlighted
    (if is-highlighted
      (let ignored (call (?. switcher ensure-visible) this))
    )
  )
  (subscribe-for (on event click)
    (call (?. switcher choose-at) index)
    (call (. event cancel))
  )
)

(type _ SwitcherHold (is KeyBinding)
  (event + changed PointerModifiers)
  (fn-do + update-modifiers _
    (param modifiers PointerModifiers)
    (<- changed modifiers)
  )
)

(fn-expr _ (of switcher-entries Item) (list (of SwitcherEntry Item))
  (param items (list Item))
  (spread (..< 0 (. items length)))
  (pipe *> (call (of SwitcherEntry Item) each ([] items each)))
  (pipe |> List)
)

(fn-expr _ switcher-held-key _
  (param trigger KeyCombo)
  (call KeyCombo (call PointerModifiers false (. held control) (. held option) (. held command)) (. KeyTrigger none))
  (where
    (lazy held (. trigger modifiers))
  )
)

(fn-expr _ switcher-released _
  (param held PointerModifiers)
  (param pressed PointerModifiers)
  (or command-released control-released option-released)
  (where
    (lazy command-released (and (. held command) (not (. pressed command))))
    (lazy control-released (and (. held control) (not (. pressed control))))
    (lazy option-released (and (. held option) (not (. pressed option))))
  )
)
