(import ./box)
(import ./events)
(import ./label)
(import ./primitives)
(import ./shorthands)
(import ./styles)
(import ./theme)
(import ./toggle)
(import /graphics/color)
(import /graphics/primitives)
(import /graphics/style)
(import /units)

(style-extend GUIDefaultTheme
  (using GUIBoxCursor)
  (using GUIBoxDisplay)
  (using GUIBoxMotion)
  (using GUIBoxPaint)
  (using GUIBoxSize)
  (using GUIBoxSpacing)
  (using GUIFocusRingStyle)
  (using GUITextPaint)
  (using GUIBoxTransform)
  (rule Switch (• text gui-text-color)
    (blank)
    (rule switch-track (• bg gui-track-color) (• w 30) (• h 16) (• p 2)
      (= corner-radius 10)
      (= motion gui-motion-quick)
    )
    (blank)
    (rule switch-knob (• bg gui-knob-color) (• w 16) (• h 16)
      (= corner-radius 8)
      (= shadow gui-control-shadow)
      (= motion gui-motion-quick)
      (= (. motion position) gui-motion-quick)
    )
    (blank)
    (rule switch-title (• ml 8))
    (blank)
    (rule switch-lead (• flex 1)
      (= display (. Display hidden))
    )
    (blank)
    (when-style #is-hover-within
      (rule switch-track
        (= background-color (call (. gui-hover-color over) gui-track-color))
      )
    )
    (blank)
    (when-style #is-press-within
      (rule switch-knob
        (= scale 0.9)
      )
    )
    (blank)
    (when-style #is-on
      (rule switch-track (• bg gui-accent-color))
      (blank)
      (rule switch-lead
        (= display (. Display visible))
      )
    )
    (blank)
    (when-style #is-focus-visible
      (rule switch-track
        (= focus-ring gui-focus-ring)
      )
    )
  )
)

(type + Switch (is Toggle)
  (fn-do + This _
    (param title _ (= ""))
  )
  (content
    (<> This
      (<> Box (• switch-track) (• flex-row)
        (= align-y (. Alignment center))
        (blank)
        (<> Box (• switch-lead))
        (<> Box (• switch-knob))
      )
      (if (!= #title "")
        (<> Label (• switch-title)
          (= align-y (. Alignment center))
          (= text #title)
        )
      )
    )
  )
)
