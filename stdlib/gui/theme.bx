  (style-domains gui-inner-radius (domain paint))
  (style-domains gui-popup-radius (domain paint))
  (style-domains gui-card-radius (domain paint))
  (blank)
  (rule Window
    (= color gui-text-color)
  )
  (blank)
  (rule Box
    (= animates-fills gui-animates-fills)
    (when-style (not #is-enabled)
      (= opacity 0.45%%)
    )
  )
  (blank)
  (rule group-heading (• text gui-muted-text-color)
    (= font-size gui-footnote-font-size)
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule glass (• bg gui-glass-color)
    (= window-material gui-glass-material)
  )
)

