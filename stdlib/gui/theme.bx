(style GUIMetrics
  (prop + gui-control-height Length (= 24))
  (prop + gui-control-padding Length (= 12))
  (prop + gui-control-font-size Length (= 13))
  (prop + gui-control-icon-size Length (= 14))
  (prop + gui-icon-stroke-width Length (= 1.75))
  (prop + gui-hairline Length (= 1))
  (prop + gui-caption-font-size Length (= 10))
  (prop + gui-footnote-font-size Length (= 11))
  (prop + gui-callout-font-size Length (= 12))
  (prop + gui-body-font-size Length (= 13))
  (prop + gui-title3-font-size Length (= 15))
  (prop + gui-title2-font-size Length (= 17))
  (prop + gui-title1-font-size Length (= 22))
  (prop + gui-large-title-font-size Length (= 26))
  (blank)
  (style-domains gui-control-height (domain layout))
  (style-domains gui-control-padding (domain layout))
  (style-domains gui-control-font-size (domain layout))
  (style-domains gui-control-icon-size (domain layout))
  (style-domains gui-icon-stroke-width (domain paint))
  (style-domains gui-hairline (domain layout))
  (style-domains gui-caption-font-size (domain layout))
  (style-domains gui-footnote-font-size (domain layout))
  (style-domains gui-callout-font-size (domain layout))
  (style-domains gui-body-font-size (domain layout))
  (style-domains gui-title3-font-size (domain layout))
  (style-domains gui-title2-font-size (domain layout))
  (style-domains gui-title1-font-size (domain layout))
  (style-domains gui-large-title-font-size (domain layout))
)

(style GUISmallMetrics (is GUIMetrics) (for small)
  (prop + gui-control-height _ (= 20))
  (prop + gui-control-padding _ (= 8))
  (prop + gui-control-font-size _ (= 11))
  (prop + gui-control-icon-size _ (= 12))
  (prop + gui-icon-stroke-width _ (= 2))
)

(style GUILargeMetrics (is GUIMetrics) (for large)
  (prop + gui-control-height _ (= 28))
  (prop + gui-control-padding _ (= 14))
  (prop + gui-control-icon-size _ (= 16))
  (prop + gui-icon-stroke-width _ (= 1.5))
)

(style GUIRetinaMetrics (is GUIMetrics) (for retina)
  (prop + gui-hairline _ (= 0.5))
)

(style GUIMotionTheme
  (using GUIBoxTransform)
  (using GUIBoxScroll)
  (prop + gui-motion-quick Motion (= (call spring 180ms)))
  (prop + gui-motion-smooth Motion (= (call spring 320ms)))
  (prop + gui-motion-bouncy Motion (= (call spring 420ms 0.3)))
  (prop + gui-animates-fills _ (= true))
  (prop + gui-scroll-blur (? Ratio) (= 0.5%%))
  (blank)
  (rule scroll-blurred
    (= scroll-blur gui-scroll-blur)
  )
  (blank)
  (keyframes spin animation 1s
    (= repeat (. Repeat forever))
    (= frame-rate 30)
    (range rotate 0 (* 2 π))
  )
  (blank)
  (keyframes shake (param distance Length) animation 360ms
    (track translate.x
      (at 0% 0)
      (at 20% (- distance))
      (at 40% distance)
      (at 60% (/ (- distance) 2))
      (at 80% (/ distance 2))
      (at 100% 0)
    )
  )
  (blank)
  (keyframes pop-in animation 220ms
    (range opacity 0%% _ (:motion (call ease-out 160ms)))
    (range scale 0.94 _ (:motion gui-motion-bouncy))
    (range translate (call Point 0 6) (call Point 0 0))
  )
  (blank)
  (keyframes popup-out animation 120ms
    (range opacity _ 0%% (:motion (call ease-in 120ms)))
  )
  (blank)
  (keyframes fade-in animation 1s
    (range opacity 0%% _)
  )
  (blank)
  (keyframes breathe animation 1200ms
    (= repeat (. Repeat forever))
    (= direction (. AnimationDirection alternate))
    (range opacity 1%% 0.6%%)
  )
  (blank)
  (keyframes pulse animation 1400ms
    (= repeat (. Repeat forever))
    (track opacity
      (at 0% 1%%)
      (at 50% 0.35%% (:easing (. Easing ease-in-out)))
      (at 100% 1%% (:easing (. Easing ease-in-out)))
    )
    (track scale
      (at 0% 1.15)
      (at 50% 0.8 (:easing (. Easing ease-in-out)))
      (at 100% 1.15 (:easing (. Easing ease-in-out)))
    )
  )
  (blank)
  (keyframes overshoot (param peak F64) motion 280ms
    (at 0% 0)
    (at 65% peak)
    (at 100% 1 (:motion (call spring 140ms)))
  )
)

(style GUIReducedMotionTheme (is GUIMotionTheme) (for reduce-motion)
  (prop + gui-motion-quick _ (= instant))
  (prop + gui-motion-smooth _ (= (call ease-out 120ms)))
  (prop + gui-motion-bouncy _ (= (call ease-out 120ms)))
  (prop + gui-animates-fills _ (= false))
  (prop + gui-scroll-blur _ (= null))
  (blank)
  (keyframes pop-in animation 120ms
    (range opacity 0%% _)
  )
  (blank)
  (keyframes popup-out animation 100ms
    (range opacity _ 0%%)
  )
  (blank)
  (keyframes shake (param distance Length) animation 240ms
    (track opacity
      (at 0% 1%%)
      (at 50% 0.4%%)
      (at 100% 1%%)
    )
  )
  (blank)
  (keyframes pulse animation 1400ms
    (= repeat (. Repeat forever))
    (track opacity
      (at 0% 1%%)
      (at 50% 0.35%% (:easing (. Easing ease-in-out)))
      (at 100% 1%% (:easing (. Easing ease-in-out)))
    )
  )
  (blank)
  (keyframes overshoot (param peak F64) motion 120ms
    (at 0% 0)
    (at 100% 1)
  )
)

(style GUIInactiveTheme (is GUIDefaultTheme) (for inactive)
  (prop + gui-accent-color _ (= (call RGBA "#464646")))
  (prop + gui-accent-bright-color _ (= (call RGBA "#7c7c7c")))
  (prop + gui-focus-border-color _ (= (call RGBA "#565656")))
)

(style GUILightInactiveTheme (is GUILightTheme) (for inactive)
  (prop + gui-accent-color _ (= (call RGBA "#dcdcdc")))
  (prop + gui-accent-bright-color _ (= (call RGBA "#a5a5a5")))
  (prop + gui-focus-border-color _ (= (call RGBA "#0000002f")))
  (prop + gui-accent-text-color _ (= (call RGBA "#1d1d1f")))
)

(style GUIGlassTheme (is GUIDefaultTheme) (for glass)
  (prop + gui-field-color _ (= (call RGBA "#ffffff1a")))
)

(style GUIInactiveGlassTheme (is GUIInactiveTheme) (for glass)
  (prop + gui-field-color _ (= (call RGBA "#ffffff1a")))
)

(style GUILightGlassTheme (is GUILightTheme) (for glass)
  (prop + gui-field-color _ (= (call RGBA "#ffffff99")))
)

(style GUILightInactiveGlassTheme (is GUILightInactiveTheme) (for glass)
  (prop + gui-field-color _ (= (call RGBA "#ffffff99")))
)

(type + GUIAccents (is Tuple)
  (prop + dark-control RGBA)
  (prop + dark-selection RGBA)
  (prop + dark-unemphasized RGBA)
  (prop + light-control RGBA)
  (prop + light-selection RGBA)
  (prop + light-unemphasized RGBA)
)

(fn-do + gui-use-accents _
  (param accents GUIAccents)
  (call style-set-theme-slot
    (block
      (arg GUIDefaultTheme)
      (arg "gui-accent-bright-color")
      (arg (call gui-color-bits (. accents dark-control)))
      (arg false)
    )
  )
  (call style-set-theme-slot
    (block
      (arg GUIDefaultTheme)
      (arg "gui-accent-color")
      (arg (call gui-color-bits (. accents dark-selection)))
      (arg false)
    )
  )
  (call style-set-theme-slot
    (block
      (arg GUILightTheme)
      (arg "gui-accent-bright-color")
      (arg (call gui-color-bits (. accents light-control)))
      (arg false)
    )
  )
  (call style-set-theme-slot
    (block
      (arg GUILightTheme)
      (arg "gui-accent-color")
      (arg (call gui-color-bits (. accents light-selection)))
      (arg false)
    )
  )
  (call style-set-theme-slot
    (block
      (arg GUIInactiveTheme)
      (arg "gui-accent-color")
      (arg (call gui-color-bits (. accents dark-unemphasized)))
      (arg false)
    )
  )
  (call style-set-theme-slot
    (block
      (arg GUILightInactiveTheme)
      (arg "gui-accent-color")
      (arg (call gui-color-bits (. accents light-unemphasized)))
      (arg false)
    )
  )
  (call style-set-theme-slot
    (block
      (arg GUIGlassTheme)
      (arg "gui-accent-bright-color")
      (arg (call gui-color-bits (. accents dark-control)))
      (arg false)
    )
  )
  (call style-set-theme-slot
    (block
      (arg GUIGlassTheme)
      (arg "gui-accent-color")
      (arg (call gui-color-bits (. accents dark-selection)))
      (arg false)
    )
  )
  (call style-set-theme-slot
    (block
      (arg GUILightGlassTheme)
      (arg "gui-accent-bright-color")
      (arg (call gui-color-bits (. accents light-control)))
      (arg false)
    )
  )
  (call style-set-theme-slot
    (block
      (arg GUILightGlassTheme)
      (arg "gui-accent-color")
      (arg (call gui-color-bits (. accents light-selection)))
      (arg false)
    )
  )
  (call style-set-theme-slot
    (block
      (arg GUIInactiveGlassTheme)
      (arg "gui-accent-color")
      (arg (call gui-color-bits (. accents dark-unemphasized)))
      (arg false)
    )
  )
  (call style-set-theme-slot
    (block
      (arg GUILightInactiveGlassTheme)
      (arg "gui-accent-color")
      (arg (call gui-color-bits (. accents light-unemphasized)))
      (arg false)
    )
  )
)

(fn-expr _ gui-color-bits I64
  (param color RGBA)
  (call style-intern-holder (call (of StyleWideHolder RGBA) color))
)
