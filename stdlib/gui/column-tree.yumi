━━━━━━━━━━━━━━━━━━━━
_ do column-tree-entries-match'Item Bool
    - current [ColumnTreeEntry'Item]
    - next [ColumnTreeEntry'Item]

=? false if current.length != next.length
. index Index = 0
while index < current.length
    . a = current[index]
    . b = next[index]
    =? false if a.key != b.key || !(a.item == b.item)
    index += 1
= true
