────────────────────
_ placement-at ColumnTreePlacement'Item?
    - column ColumnTreeColumn'Item
    - drag ColumnTreeDrag'Item
    - point Point

match column.level
    |= null
        null
    | model ColumnTreeLevel'Item
        |? !can-drop || index == null || is-carried-level(index)
            null
        |? is-on-row && dragged-keys has entry.key
            null
        |? is-on-row && allows-drop(inside)
            ColumnTreePlacement'Item(entry.key, model.id, inside)
        |? allows-drop(landing)
            ColumnTreePlacement'Item(null, model.id, landing)
        ??
            null

        .. index = path.index-of(model)
        .. row = column.row-index-at(point)
        .. is-on-row = row < model.entries.length
        .. entry = model.entries[row]
        .. inside = ColumnTreeDrop'Item(drag.items, entry.item, drag.tree)
        .. landing = ColumnTreeDrop'Item(drag.items, model.owner, drag.tree)

────────────────────
_ do is-carried-level Bool
    - index Index

. cursor Index = 0
while cursor < index && cursor < path.levels.length
    . key = path.levels[cursor].selected-key
    =? true if key && dragged-keys has key
    cursor += 1
= false

────────────────────
_ allows-drop
    - drop ColumnTreeDrop'Item

|? checks
    checks(drop)
??
    false

.. checks = can-drop

────────────────────
_ do show-placement
    - next ColumnTreePlacement'Item?

placement = next?.drop
. key = next?.key
. level-id = next?.level-id
=? if key == drop-key && level-id == drop-level-id
drop-key = key
drop-level-id = level-id
refresh-rows()

────────────────────
_ do refresh-rows

for column in columns
    column.refresh-rows()

────────────────────
_ do reveal-detail

=? if !detail-reveal-pending
detail-reveal-pending = false
=? if detail-item == null || detail-pane.bounds.width <= 0
scroll-bounds-visible(detail-pane.bounds)
. column = active-column
if column
    scroll-bounds-visible(column.bounds)

────────────────────
_ do activate-deepest-level

if path.levels
    . focused = path.focus(path.levels.length - 1)

────────────────────
_ do append-missing-preview

. count = path.levels.length
=? if count == 0
=? if path.levels[count - 1].selected-index < 0 || path.levels[count - 1].is-multiple
. ignored = append-children-of-selection(count - 1, -1)

────────────────────
_ do preview-selection
    - index Index

=? if index < path.levels.length && path.levels[index].is-multiple
is-previewing = true
. next-index = index + 1
if next-index < path.levels.length
    request-level-scroll(next-index)
    =
. selected-index = if next-index == path.active-index then 0 else -1
if !append-children-of-selection(index, selected-index)
    . ignored = truncate-path-after(index)
    =
if selected-index >= 0
    publish-selection()
viewport-retention.consume()
request-level-scroll(next-index)

────────────────────
_ do append-children-of-selection Bool
    - index Index
    - selected-index Int

. entry = path.selected-entry-at(index)
=? false if !entry
. entries = entries-of(entry.item, entry.key)
=? false if !entries
. ignored = truncate-path-after(index)
path.append(entry.item, entry.key, entries, selected-index)
= true

────────────────────
_ do request-level-scroll
    - index Index

. id = path.level-id(index)
if id
    scroll-requests <- ColumnScrollRequest(index, id)

────────────────────
_ do truncate-path-after-retaining-space
    - index Index

. widths = List'Length()
for position in index + 1 .. < path.levels.length
    . column = column-tree-level-column'Item(columns, path.levels, position, null)
    if column
        widths += column.bounds.width
. removed-count = truncate-path-after(index)
if removed-count > 0 && scroll-x > 0
    viewport-retention.retain(widths)

────────────────────
_ do truncate-path-after
    - index Index

. removed-count = path.truncate-after(index)
if !path.levels
    viewport-retention.release()
path-shortened <- true
= removed-count

────────────────────
+ do select-row-at-index
    - row-index Int
    - column ColumnTreeColumn'Item

. maybe-index = column-index-of(column)
=? if maybe-index == null
. index = maybe-index
=? if index >= path.levels.length

. changed = path.select(row-index, index)

if index != path.active-index
    focus-level(index)

if changed
    truncate-path-after-retaining-space(index)
    publish-selection()

preview-selection(index)

────────────────────
+ do select-rows
    - keys [String]
    - key String
    - column ColumnTreeColumn'Item

. maybe-index = column-index-of(column)
=? if maybe-index == null
. index = maybe-index
=? if index >= path.levels.length
. entries = path.levels[index].entries
if keys.length < 2
    . only = column-tree-index-of-key'Item(entries, keys[0] if keys.length == 1)
    select-row-at-index(if only != null then only as Int else -1, column)
    =
. focus = column-tree-index-of-key'Item
    - entries
    - if keys has key then key else keys[keys.length - 1]
=? if focus == null
. changed = path.select-many(focus, keys, index)
if index != path.active-index
    focus-level(index)
if changed
    truncate-path-after-retaining-space(index)
    is-previewing = false
    publish-selection()

