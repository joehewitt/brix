_ do load-root Bool

. current-root = root-node
=? false if !current-root
. entries = entries-of(current-root, "")
=? false if !entries
path.append(current-root, "", entries, 0)
= true

────────────────────
_ do clear-path

is-previewing = false
path.clear()
has-children-cache.clear()
path-shortened <- true
project-active-column()
viewport-retention.release()
if scroll-x != 0
