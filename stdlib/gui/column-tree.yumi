+ do clear-selection

column-tree-level-column'Item(columns, path.levels, 0, null)?.select-index(null)

────────────────────
_ do project-key-path Bool
    - keys [String]

. current-root = root-node
if !current-root
    clear-path()
    = false

. owner Item = current-root
. owner-key = ""
. depth Index = 0
while depth < keys.length
    if depth >= path.levels.length || path.levels[depth].owner-key != owner-key
        if depth == 0
            clear-path()
        else
            . ignored = truncate-path-after(depth - 1)
        . entries = entries-of(owner, owner-key)
        if !entries
            activate-deepest-level()
            = false
        path.append(owner, owner-key, entries)

    . level = path.levels[depth]
    . match-index = column-tree-index-of-key'Item(level.entries, keys[depth])
    if match-index == null
        . ignored = truncate-path-after(depth)
        activate-deepest-level()
        = false

    if path.select(match-index, depth)
        . ignored = truncate-path-after(depth)
    . entry = level.entries[match-index]
    owner = entry.item
    owner-key = entry.key
    depth += 1

. last = keys.length - 1
. ignored = truncate-path-after(last)
. focused = path.focus(last)
publish-selection()
preview-selection(last)
= true

────────────────────
+ do refresh

refresh-count += 1
has-children-cache.clear()
. held-focus = is-focus-within
. held-active = path.active-index
. current-root = root-node
if !current-root || !path.levels
    clear-path()
    . ignored = load-root()
    project-active-column()
    =

. owner Item = current-root
. owner-key = ""
. index Index = 0
while index < path.levels.length
    . level = path.levels[index]
    . entries = entries-of(owner, owner-key)
    if !entries
        if index == 0
            clear-path()
        else
            . ignored = truncate-path-after(index - 1)
        break

    . found = column-tree-index-of-key'Item(entries, level.selected-key)
    . lost = level.selected-index >= 0 && found == null
    . selected = -1
    if found != null
        selected = found
    else if lost && index <= path.active-index
        selected = min(level.selected-index, (entries.length as Int) - 1)
    . kept = if lost then List'String() else kept-selection
        .. kept-selection = column-tree-kept-selection'Item(level.selection, entries)
    if selected != level.selected-index || kept != level.selection || entries-differ
        path.replace(index, owner, owner-key, entries, selected, kept)
    .. entries-differ = !column-tree-entries-match'Item(level.entries, entries)
    if lost
        . ignored = truncate-path-after(index)
        publish-selection()
        if selected >= 0
            preview-selection(index)
        break
    if selected < 0
        break

    . entry = entries[selected]
    owner = entry.item
    owner-key = entry.key
    index += 1

if is-previewing
    append-missing-preview()
project-active-column()
refresh-rows()
if held-focus && path.levels && path.active-index != held-active
    focus-level(path.active-index)

