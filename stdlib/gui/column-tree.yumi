_ do column-tree-entry-has-children'Item Bool
    - entry ColumnTreeEntry'Item
    - provider ColumnTreeChildProvider'Item
    - cache Map'String'Bool
    - predicate ColumnTreeItemPredicate'Item?

if predicate
    = predicate(entry.item)
. cached = cache[entry.key]
=? cached if cached != null
. children = provider(entry.item)
. found = children != null && children.length > 0
cache[entry.key] = found
= found

