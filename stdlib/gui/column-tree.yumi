+ do sync-row
    - row ColumnTreeItem'Item

. model = level
. owner = tree
. entry = row.entry
. selected = false
. targeted = false
. dragged = false
. parent = false
if entry && model && owner
    selected = model.is-key-selected(entry.key)
    targeted = entry.key == owner.drop-key && model.id == owner.drop-level-id
    dragged = owner.is-dragged-key(entry.key)
    parent = owner.has-children-of(entry)
if row.is-selected != selected
    row.is-selected = selected
if row.is-drop-target != targeted
    row.is-drop-target = targeted
if row.is-dragged != dragged
    row.is-dragged = dragged
if row.has-children != parent
    row.has-children = parent

