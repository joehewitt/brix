────────────────────
_ do entries-of [ColumnTreeEntry'Item]?
    - owner Item
    - owner-key String

. items = load-children(owner)
has-children-cache[owner-key] = items != null && items.length > 0
=? if items == null
=? if items.length == 0
. entries [ColumnTreeEntry'Item] = List'(ColumnTreeEntry'Item)()
. index Index = 0
for item in items
    entries += ColumnTreeEntry'Item(item, key-for-item(item, owner-key, index))
    index += 1
= entries

