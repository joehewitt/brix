./frame-clock
/core/tracker
/math/motion
/time/duration

_ animated-precision = 0.001

━━━━━━━━━━━━━━━━━━━━
+ AnimatedValue
    is Tracker
    is FrameAnimation

+ owner FrameOwner
+ channel MotionChannel
+ goal [F64]

_ action LiveAction?

────────────────────
+ This
    - owner
    - start [F64]

.. channel = MotionChannel(start, animated-precision)
.. goal = List'F64(start)

────────────────────
+ do follow [F64]
    - to [F64]
    - motion Motion

=? channel.value if is-same(to)
goal = List'F64(to)
. clock = owner.frame-clock
if !clock || motion is InstantMotion
    owner.frame-clock?.cancel(this)
    channel.jump(to)
    = channel.value
channel.retarget(to, motion, clock.now)
if channel.is-moving && !clock.is-animating(this)
    clock.start(owner, this)
= channel.value

────────────────────
_ is-same Bool
    - to [F64]

to == goal

────────────────────
+ do advance Bool
    - tick FrameTick

channel.update(tick.now)
if action
    action()
= channel.is-moving

────────────────────
+ do finish

channel.jump(goal)
if action
    action()

────────────────────
+ do attach
    - action LiveAction

this.action = action
=? if !channel.is-moving
. clock = owner.frame-clock
if !clock
    channel.jump(goal)
    =
if !clock.is-animating(this)
    clock.start(owner, this)

────────────────────
+ do detach
    - action LiveAction

this.action = null
owner.frame-clock?.cancel(this)
