━━━━━━━━━━━━━━━━━━━━
+ Dialog is Popup

+ title = ""
+ event accepted DismissReason
+ event canceled DismissReason

• This • flex-col fill-window modal
    focus-mode = FocusMode.inside
    deactivate-dismiss = false
    anchor-hidden-dismiss = false

────────────────────
+ This
    - title = ""

────────────────────

<This
    <Box • flex-row flex:1
        align-x = Alignment.center
        <Box panel • dialog-panel flex-col
            align-y = Alignment.center
            if #title != ""
                <Label title-label • dialog-title
                    text = #title
            + <Box body • flex-col
            + <Box actions • dialog-actions flex-row

────────────────────
for reason on dismissed when arrival

if reason == DismissReason.chosen
    accepted <- reason
else
    canceled <- reason

────────────────────
+ do accept

dismiss(DismissReason.chosen)

────────────────────
+ do cancel

dismiss(DismissReason.programmatic)

━━━━━━━━━━━━━━━━━━━━
+ AlertDialog is Dialog

+ message = ""
+ accept-title = "OK"

────────────────────

<This
    <Label (body) • dialog-message
        text = #message
    <Box (actions) • flex-row
        <Box • flex:1
        <Button • dialog-button
            title = #accept-title
            role = ButtonRole.default
            action = => do accept()

━━━━━━━━━━━━━━━━━━━━
+ ConfirmDialog is Dialog

+ message = ""
+ accept-title = "OK"
+ cancel-title = "Cancel"

────────────────────

<This
    <Label (body) • dialog-message
        text = #message
    <Box (actions) • flex-row
        <Box • flex:1
        <Button • dialog-button
            title = #cancel-title
            role = ButtonRole.cancel
            action = => do cancel()
        <Button • dialog-button
            title = #accept-title
            role = ButtonRole.default
            action = => do accept()
