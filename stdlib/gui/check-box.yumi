            motion.focus-ring = gui-motion-quick

━━━━━━━━━━━━━━━━━━━━
+ CheckBox is Toggle

+ is-mixed = false
+ is-marked = #is-on || #is-mixed
+ toggled-value => !is-on || is-mixed

