(import ./box)
(import ./events)
(import ./keys)
(import ./label)
(import ./placement)
(import ./popup)
(import ./primitives)
(import ./shorthands)
(import ./styles)
(import ./text-input)
(import ./theme)
(import /core/list-cursor)
(import /data/fuzzy)
(import /graphics/color)
(import /graphics/outline)
(import /graphics/primitives)
(import /graphics/text)
(import /ui/input)

(style-extend GUIDefaultTheme
  (using GUIBoxPaint)
  (using GUITextPaint)
  (using GUIBoxSpacing)
  (using GUIBoxSize)
  (using GUIPopupStyle)
  (rule ComboSuggestions (• bg gui-glass-color) (• text gui-text-color) (• p 4) (• max-h 220)
    (= window-material gui-glass-material)
    (= border-color gui-border-color)
    (= border-width 1)
    (= corner-radius gui-popup-radius)
    (= shadow gui-popup-shadow)
  )
  (blank)
  (rule ComboRow (• text gui-text-color) (• h 24) (• px 8)
    (= corner-radius gui-control-radius)
    (blank)
    (when-style #is-highlighted
      (• bg gui-accent-color)
      (• text gui-accent-text-color)
    )
  )
)

(type + ComboBox (is Box)
  (rule This
    (= focus-mode (. FocusMode inside))
  )
  (blank)
  (prop + suggestions (list String) (= (call (of List String))))
  (prop + placeholder _ (= ""))
  (prop + text _ (= ""))
  (prop + value _ (= ""))
  (prop + highlighted-index (? Index))
  (prop + matches (list String) (= (call combo-matches #suggestions #text)))
  (prop + highlighted-match (? String) (= (call combo-highlighted-match #matches #highlighted-index)))
  (event + value-changing (of ValueChange String))
  (event + value-changed (of ValueChange String))
  (content
    (<> This (• flex-col)
      (<> TextInput (id: field) (• flex 1)
        (= placeholder #placeholder)
        (= text #text)
      )
      (<> ComboSuggestions (id: suggestions-popup) (• flex-col)
        (for (in match #matches)
          (<> ComboRow
            (= value match)
          )
        )
      )
      (<> KeyShortcut (text: "Next suggestion")
        (= key .arrow-down)
        (= discoverable false)
        (= allow-while-input true)
        (= action (=> () :do (call move-highlight 1)))
      )
      (<> KeyShortcut (text: "Previous suggestion")
        (= key .arrow-up)
        (= discoverable false)
        (= allow-while-input true)
        (= action (=> () :do (call move-highlight -1)))
      )
      (<> KeyShortcut (text: "Accept suggestion")
        (= key .enter)
        (= repeat false)
        (= discoverable false)
        (= allow-while-input true)
        (= action (=> () :do (call accept-highlighted)))
      )
    )
  )
  (subscribe-for (on event (. field input))
    (= text (. event text))
    (= highlighted-index null)
    (if (> (. (call combo-matches suggestions text) length) 0)
      (call (. suggestions-popup show))
      (else
        (call (. suggestions-popup dismiss))
      )
    )
  )
  (fn-do + move-highlight _
    (param offset Int)
    (let count (. (call combo-matches suggestions text) length))
    (return-if (if (== count 0)))
    (blank)
    (if (not (. suggestions-popup is-open))
      (call (. suggestions-popup show))
    )
    (= highlighted-index (call (. (call ListCursor count highlighted-index) wrapped) offset))
  )
  (fn-do + highlight _
    (param match String)
    (let current (call combo-matches suggestions text))
    (for (in index (..< 0 (. current length)))
      (if (== ([] current index) match)
        (= highlighted-index index)
        (return)
      )
    )
  )
  (fn-do + accept-highlighted _
    (call accept (?? (call combo-highlighted-match (call combo-matches suggestions text) highlighted-index) text))
  )
  (fn-do + accept _
    (param candidate String)
    (let old value)
    (if (!= candidate old)
      (let change (call (of ValueChange String) old candidate))
      (<- value-changing change)
      (return-if (if (. change is-canceled)))
    )
    (= text candidate)
    (= value candidate)
    (= highlighted-index null)
    (call (. suggestions-popup dismiss) (. DismissReason chosen))
    (return-if (if (== candidate old)))
    (blank)
    (<- value-changed (call (of ValueChange String) old candidate))
  )
)

(type + ComboSuggestions (is Popup)
  (rule This (• below-matched 3)
    (= focus-loss-dismiss true)
    (= popup-focus (. PopupFocus none))
    (= overflow-y (. ScrollOverflow auto))
  )
)

(type + ComboRow (is Box)
  (prop + value String)
  (prop + is-highlighted _ (= (== (?. #combo #highlighted-match) #value)))
  (blank)
  (prop _ combo (of Ancestor ComboBox))
  (blank)
  (depends hover-changed is-hover-within)
  (content
    (<> This (• flex-row)
      (<> Label (• flex 1)
        (= align-y (. Alignment center))
        (= text value)
      )
    )
  )
  (subscribe-for (on event click)
    (call (?. combo accept) value)
    (call (. event cancel))
  )
  (fn-do _ hover-changed _
    (if is-hover-within
      (call (?. combo highlight) value)
    )
  )
)

(fn-expr + combo-highlighted-match (? String)
  (param matches (list String))
  (param index (? Index))
  (case? (and (!= index null) (< index (. matches length)))
    ([] matches index)
  )
  (default
    null
  )
)

(fn-expr + combo-matches (list String)
  (param suggestions (list String))
  (param text String)
  (spread (call fuzzy-ranked suggestions text (=> (suggestion) suggestion)))
  (pipe ?> (and text (!= (. each lowercased) (. text lowercased))))
  (pipe |> List)
)
