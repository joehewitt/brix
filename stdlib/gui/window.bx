  (fn-do _ accept-external-drag _
    (param data PointerEventData)
    (let name (only-if (call C:brixGuiWindowDropPasteboardName native) (if native)))
    (return-if (if (not name)))
    (call dispatch-external-drag (call ClipboardDrag (call Clipboard name) (. data pointer-id)) data)
  )
  (fn-do _ begin-drag _
    (param session DragSession)
    (= drag-session session)
    (call clear-pointer-capture)
    (call clear-scroll-gesture)
    (call clear-hover)
    (if (> (. session carried length) 0)
      (call begin-carry session)
      (else
        (let pictured (. session pending-snapshot))
        (if (and pictured (. pictured is-paint-visible))
          (call capture-drag-ghost session)
        )
      )
    )
    (call advance-drag (. session point) (. session modifiers))
  )
  (fn-do _ begin-carry _
    (param session DragSession)
    (= (. session pending-snapshot) null)
    (let lead ([] (. session carried) 0))
    (let at (. lead lifted-frame top-left))
    (= (. session grab) (call Point (- (. session origin x) (. at x)) (- (. session origin y) (. at y))))
    (call (. lead begin-carry) at null (call Point 0 0))
    (let count (. session carried length))
    (for (in index (..< 1 count))
      (let follower ([] (. session carried) index))
      (let step (* (as (call min index drag-stack-depth) Length) drag-stack-step))
      (call (. follower begin-carry) (. follower lifted-frame top-left) lead (call Point step step))
    )
    (let index count)
    (while (> index 0)
      (-= index 1)
      (call (. ([] (. session carried) index) lift))
    )
  )
  (fn-do _ capture-drag-ghost _
    (param session DragSession)
    (let box (. session pending-snapshot))
    (= (. session pending-snapshot) null)
    (return-if (if (not box)))
    (let frame (. box ink-frame))
    (let shown (call (. box presentation-rect) frame))
    (let size (call Dimensions (call max 1 (call ceil (. frame width))) (call max 1 (call ceil (. frame height)))))
    (let held (call Point (- (. session origin x) (. shown x)) (- (. session origin y) (. shown y))))
    (let resting (call Point (call min 12 (/ (. size width) 2)) (/ (. size height) 2)))
    (let placed (if-expr (. box is-paint-visible) held resting))
    (let grab (?? (. session grab) placed))
    (let backdrop (only-if (. box backdrop-color) (if (. box is-paint-visible))))
    (let ghost (call DragGhost (call (. box snapshot) backing-scale backdrop) size grab (call Point 0 0)))
    (call (. ghost follow) (. session point))
    (= (. session ghost) ghost)
    (if (not native)
      (call invalidate-paint)
    )
  )
  (fn-do _ advance-drag _
    (param point Point)
    (param modifiers PointerModifiers)
    (let session drag-session)
    (return-if (if (not session)))
    (= (. session point) point)
    (= (. session modifiers) modifiers)
    (call (?. (. session ghost) follow) point)
    (call follow-carried session)
    (let data (call PointerEventData point (. session pointer-id) (. PointerDeviceKind mouse) modifiers))
    (let asked (call DragOverEvent data session))
    (call (?. (call pointer-hit-path point) publish-drag-over) asked)
    (let previous (. session target))
    (let next (. asked acceptor))
    (= (. session target) next)
    (call project-carried session)
    (= (. session scroller) (. asked scroller))
    (= (. session operation) (. asked operation))
    (if (and (not (. session source)) native)
      (probe-log gui.drop (text: "verdict " (as (. asked operation) U32) " target " (!= next null) " at " point))
      (call C:brixGuiWindowSetDropOperation native (if-expr next (. asked operation) (. DropOperation none)))
    )
    (if (and previous (or (not next) (!= (as previous Pointer) (as next Pointer))))
      (<- (. previous drag-leave) session)
    )
    (= cursor-resolution-invalid true)
    (if (not native)
      (call invalidate-paint)
    )
    (call start-drag-scroll)
  )
  (fn-do _ follow-carried _
    (param session DragSession)
    (return-if (if (== (. session carried length) 0)))
    (let grab (?? (. session grab) (call Point 0 0)))
    (let at (call Point (- (. session point x) (. grab x)) (- (. session point y) (. grab y))))
    (let pace (. session pace))
    (for (in box (. session carried))
      (call (. box follow-carry) at pace)
    )
  )
  (fn-do _ project-carried _
    (param session DragSession)
    (let target (. session target))
    (for (in box (. session carried))
      (let parent (. box layout-parent))
      (call (. box sync-carry-slot) (and (!= target null) (!= parent null) (call (. parent is-within) target)))
    )
  )
  (fn-do _ land-carried _
    (param session DragSession)
    (let index (. session carried length))
    (while (> index 0)
      (-= index 1)
      (let landing (call (. ([] (. session carried) index) end-carry)))
      (if landing
        (+= landings landing)
        (call (. landing box schedule-layout))
      )
    )
    (= (. session carried) (call (of List Box)))
  )
  (fn-do _ finish-drag _
    (param dropped Bool)
    (let session drag-session)
    (return-if (if (not session)))
    (= drag-session null)
    (let target (. session target))
    (= (. session target) null)
    (= (. session scroller) null)
    (= (. session pending-snapshot) null)
    (call (?. (. session ghost) close))
    (= (. session ghost) null)
    (if target
      (if dropped
        (<- (. target drop) session)
        (else
          (<- (. target drag-leave) session)
        )
      )
    )
    (let source (. session source))
    (if source
      (<- (. source drag-end) (call DragEnd session (and dropped (!= target null))))
    )
    (call land-carried session)
    (= cursor-resolution-invalid true)
    (= is-hover-refresh-pending true)
