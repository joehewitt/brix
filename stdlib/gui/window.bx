  (fn-do _ validate-pointer-owners _
    (let changed false)
    (if (and is-hover-refresh-pending (not scroll-hover-owner))
      (= is-hover-refresh-pending false)
      (if has-pointer-location
        (call update-hover (call pointer-hit-path pointer-location))
      )
      (= changed true)
    )
    (let is-hover-root (and hovered-box (== (as (. hovered-box root) Pointer) (as this Pointer))))
    (if (and hovered-box (or (not (. hovered-box is-input-visible)) (not is-hover-root)))
