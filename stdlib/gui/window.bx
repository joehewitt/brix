  (fn-do _ clip-watcher-index (? Index)
    (param watcher ClipWatcher)
    (for (in index (..< 0 (. clip-watchers length)))
      (return-if index (if (== (as ([] clip-watchers index) Pointer) (as watcher Pointer))))
    )
  )
  (fn-expr _ popup-dismissal-restores-focus _
    (param reason DismissReason)
    (match reason
      (case (. DismissReason escape)
        true
      )
      (case (. DismissReason chosen)
        true
      )
      (case (. DismissReason programmatic)
        true
      )
      (default
        false
      )
    )
  )
  (fn-expr _ press-syncs-native-focus _
    (param target Box)
    (param holder (? Box))
    (match holder
      (case= null
        false
      )
      (case (: held Box)
        (and (. held native-focus-handle) (not in-popup))
        (blank)
        (lazy in-popup (call some popups (:where (or (call (. target is-within) each) (call (. held is-within) each)))))
      )
    )
  )
  (fn-expr _ press-focus-owner (? Box)
    (param target Box)
    (if-expr (and owner (== (. owner $focus-mode) (. FocusMode press)) (. owner $keeps-focus)) null owner)
    (where
      (lazy owner (call (. target nearest-focus-owner)))
    )
  )
  (fn-do _ press-keeps-focus _
    (param target Box)
    (param holder (? Box))
    (for (in popup popups)
      (if (call (. target is-within) popup)
        (return-if true (if (== (. popup $popup-focus) (. PopupFocus none))))
        (return-if true (if (and holder (call (. holder is-within) popup))))
      )
    )
    (return (. target $keeps-focus))
  )
  (fn-do _ open-context-popup _
    (param target Box)
    (param point Point)
    (let cursor (? Box) target)
    (while cursor
      (let box cursor)
      (let popup (call find-child-popup box false))
      (if popup
        (call (. popup show) (call (. PopupAnchor point) point))
        (= (. popup opened-by-press) true)
        (return)
      )
      (= cursor (. box material-parent))
    )
  )
  (fn-do _ release-into-press-popup _
    (param hit PointerHitPath)
    (param event PointerUpEvent)
    (let moved (> (call (. press-origin distance) (. event root-point)) 4))
    (return-if (if (not moved)))
    (for (in popup popups)
      (if (and (. popup opened-by-press) (call (. hit target is-within) popup))
        (let click (call ClickEvent (. event data) (. event button) 1))
        (call (. (call (. hit at-point) (. event root-point)) publish) click)
        (return)
      )
    )
  )
  (fn-do _ find-child-popup (? Popup)
    (param node GuiNode)
    (param hover Bool)
    (let child (. node %first-child))
    (while child
      (let current child)
      (if (is current Popup)
        (let popup (as current Popup))
        (let matches (if-expr hover (. popup $hover-trigger) (. popup $context-trigger)))
        (return-if popup (if matches))
        (else-if (. current is-gui-transparent)
          (let nested (call find-child-popup current hover))
          (return-if nested (if nested))
        )
      )
      (= child (. current %next-sibling))
    )
  )
  (fn-do _ hover-candidate-owner _
    (param target (? Box))
    (let cursor target)
    (while cursor
      (let box cursor)
      (if (call find-child-popup box true)
        (return-if null (if (call is-hint-blocked box)))
        (return box)
      )
      (= cursor (. box material-parent))
    )
  )
  (fn-do _ settle-hover-popup _
    (param target (? Box))
    (let owner (call hover-candidate-owner target))
    (return-if (if (== (as owner (? Pointer)) (as hover-owner (? Pointer)))))
    (= hover-owner owner)
    (if owner
      (let popup (!! (call find-child-popup owner true)))
      (<- hover-entered popup)
      (else
        (<- hover-exited true)
      )
    )
  )
  (fn-do _ show-hover-popup _
    (param popup Popup)
    (if (and (not (. popup is-open)) (not (call is-hint-blocked popup)))
      (call (. popup show))
    )
  )
  (fn-do _ is-hint-blocked Bool
    (param box Box)
    (let top (? Popup))
    (for (in popup popups)
      (if (== (. popup $popup-stacking) (. PopupStacking auto))
        (= top popup)
      )
    )
    (return (and (!= top null) (not (call (. box is-within) top))))
  )
  (fn-do _ switch-hover-popup _
    (param leaving Popup)
    (param entering Popup)
    (call (. leaving dismiss) (. DismissReason hover-end))
    (call show-hover-popup entering)
  )
  (fn-do _ refresh-popup-holds _
    (for (in popup popups)
      (let holds (call some popups (:where (and (!= (as each Pointer) (as popup Pointer)) (call (. each is-within) popup)))))
      (if (!= (. popup holds-popup) holds)
        (= (. popup holds-popup) holds)
      )
    )
  )
  (fn-do _ refresh-modal-popup _
    (let next (? Popup))
    (for (in popup popups)
      (if (. popup $modal)
        (= next popup)
      )
    )
    (return-if (if (== (as next (? Pointer)) (as modal-popup (? Pointer)))))
    (= modal-popup next)
    (return-if (if (not next)))
    (if (and focused-box (not (call (. focused-box is-within) next)))
      (call clear-focus-state false)
    )
    (call clear-hover)
    (call clear-scroll-gesture)
  )
  (fn-do _ popup-index (? Index)
    (param popup Popup)
    (for (in index (..< 0 (. popups length)))
      (return-if index (if (== (as ([] popups index) Pointer) (as popup Pointer))))
    )
  )
  (fn-expr _ supersedes-parent Bool
    (param popup Popup)
    (param other Popup)
    (and (!= parent null) (!= (call popup-index parent) null) (call popup-supersedes popup parent))
    (where
      (lazy parent (. other parent-popup))
    )
  )
  (fn-expr _ popup-supersedes _
    (param popup Popup)
    (param other Popup)
    (case? (== (as other Pointer) (as popup Pointer))
      false
    )
    (case? (== (. other $popup-stacking) (. PopupStacking manual))
      false
    )
    (case? (== (. popup $popup-stacking) (. PopupStacking hint))
      (== (. other $popup-stacking) (. PopupStacking hint))
    )
    (case? (call (. popup is-within) other)
      false
    )
    (case? (and anchor (call (. anchor is-within) other))
      false
    )
    (default
      true
    )
    (where
      (lazy anchor (. popup anchor-box))
    )
  )
  (fn-expr _ popup-contains _
    (param popup Popup)
    (param box Box)
    (param point (? Point) (= null))
    (case? (. popup $pointer-transparent)
      false
    )
    (case? (and (== (as box Pointer) (as popup Pointer)) (!= point null))
      (call (. popup hit-contains) point)
    )
    (case? (call (. box is-within) popup)
      true
    )
    (default
      (and (!= anchor null) (call (. box is-within) anchor))
    )
    (where
      (lazy anchor (. popup anchor-box))
    )
  )
  (fn-do _ dismiss-popups-for-press _
    (param point Point)
    (param hit (? PointerHitPath))
    (let target (?. hit target))
    (let consumed false)
    (let index (. popups length))
    (while (> index 0)
      (-= index 1)
      (if (< index (. popups length))
        (let popup ([] popups index))
        (if (and target (call popup-contains popup target point))
          (break)
        )
        (if (. popup $outside-press-dismiss)
          (call (. popup dismiss) (. DismissReason outside-press))
          (if (not (. popup $outside-press-passes))
            (= consumed true)
          )
          (else-if (. popup $modal)
            (break)
          )
        )
      )
    )
    (return consumed)
  )
  (fn-do _ dismiss-popups-for-focus _
    (param box (? Box))
    (for (in popup (call (of List Popup) popups))
      (if (. popup $focus-loss-dismiss)
        (if (or (not box) (not (call popup-contains popup box)))
          (call (. popup dismiss) (. DismissReason focus-loss))
        )
      )
    )
  )
  (fn-do _ dismiss-popups-for-deactivation _
    (for (in popup (call (of List Popup) popups))
      (if (. popup $deactivate-dismiss)
        (call (. popup dismiss) (. DismissReason deactivate))
      )
    )
  )
  (fn-do _ invalidate-pointer-placement _
    (for (in popup popups)
      (let placement (. popup $placement))
      (if (and placement (. placement tracks-pointer))
        (call invalidate-popup-placement)
        (return)
      )
    )
  )
  (fn-do _ place-popup _
    (param popup Popup)
    (param boundary Rect)
    (let anchor (call (. popup anchor-rect) this))
    (let request
      (call PlacementRequest
        (block
          (arg popup)
          (arg anchor)
          (arg boundary)
          (arg bounds)
          (arg pointer-location)
          (arg (. popup placement-focus))
        )
      )
    )
    (let placement (?? (. popup $placement) (. popup default-placement)))
    (let result (call (. placement place) request))
    (call (. popup accept-placement) result anchor)
    (let placed (. result bounds))
    (let width (call ceil (. placed width)))
    (let height (call ceil (. placed height)))
    (let x (if-expr (== (. result side) (. Side left)) (- (call floor (. placed right)) width) (call round (. placed x))))
    (let y (if-expr (== (. result side) (. Side top)) (- (call floor (. placed bottom)) height) (call round (. placed y))))
    (call (. popup arrange-bounds) (call Rect x y width height))
    (call (. popup update-layout))
  )
  (fn-do _ render-popups LiveFillState
    (param output-color-space Pointer)
    (let fills (call LiveFillState false null null))
    (return-if fills (if (or (== (. popups length) 0) (not native))))
    (let scale display-scale)
    (let zoom effective-zoom)
    (for (in popup popups)
      (if (. popup is-paint-visible)
        (= fills
          (call merged-live-fills
            (block
              (arg fills)
              (arg
                (call (. popup render-presentation)
                  (block
                    (arg (!! native))
                    (arg scale)
                    (arg zoom)
                    (arg output-color-space)
                    (arg is-metal-rendering)
                    (arg (. live-fills seconds))
                    (arg (. live-fills is-pending))
                  )
                )
              )
            )
          )
        )
      )
    )
    (return fills)
  )
  (fn-do _ window-size-changed _
    (call schedule-layout)
    (if (and native (!= requested-native-size size))
      (= requested-native-size size)
      (call C:brixGuiWindowSetContentSize native (. size width) (. size height))
    )
  )
  (fn-do _ window-position-changed _
    (let requested position)
    (if (and native requested (!= requested-native-position requested))
      (call apply-native-position requested)
    )
  )
  (fn-do _ apply-native-position _
    (param requested Point)
    (return-if (if (not native)))
    (call C:brixGuiWindowSetPosition native (. requested x) (. requested y))
    (call accept-native-position)
  )
  (fn-do _ accept-native-content-size _
    (param accepted Dimensions)
    (let outer (call swap-markup-cause markup-cause-none))
    (finally
      (call swap-markup-cause outer)
    )
    (let safe (call Dimensions (call gui-safe-span (. accepted width)) (call gui-safe-span (. accepted height))))
    (= requested-native-size safe)
    (if (!= size safe)
      (= size safe)
      (call schedule-layout)
      (call render-resize-frame)
    )
  )
  (fn-do _ render-resize-frame _
    (return-if (if is-closed))
    (return-if (if (not native)))
    (blank)
    (if is-frame-scheduled
      (call C:brixGuiWindowCancelFrame native)
      (= is-frame-scheduled false)
    )
    (call render-frame)
    (probe-count gui.adapter.resize.frames-committed)
    (let native-size
      (call Dimensions
        (block
          (arg (call C:brixGuiWindowGetContentWidth (!! native)))
          (arg (call C:brixGuiWindowGetContentHeight (!! native)))
        )
      )
    )
    (if (!= native-size size)
      (probe-count gui.adapter.resize.obsolete-sizes-rendered)
    )
  )
  (fn-do _ request-render-frame _
    (param not-before Nanoseconds (= 0ns))
    (return-if (if is-closed))
    (return-if (if (and is-frame-scheduled (>= not-before frame-not-before))))
    (return-if (if is-rendering))
    (blank)
    (call ensure-native)
    (return-if (if (not native)))
    (blank)
    (= is-frame-scheduled true)
    (= frame-not-before not-before)
    (let callback (as gui-window-render-frame GuiWindowFrameCallback))
    (call C:brixGuiWindowRequestFrame
      (block
        (arg native)
        (arg callback)
        (arg (as this Pointer))
        (arg not-before)
      )
    )
  )
  (fn-do _ render-frame _
    (= is-frame-scheduled false)
    (blank)
    (return-if (if is-closed))
    (return-if (if (not native)))
    (blank)
    (let frame (use frame-scope))
    (blank)
    (= last-frame-target-time (as (call C:brixGuiWindowGetLastFrameTargetTimeNanoseconds (!! native)) Nanoseconds))
    (let refresh-interval (call C:brixGuiWindowGetLastFrameRefreshIntervalNanoseconds (!! native)))
    (= last-frame-refresh-interval (as refresh-interval Nanoseconds))
    (call dispatch-scroll-samples)
    (call (. window-clock tick) last-frame-target-time last-frame-refresh-interval)
    (probe-group + gui.frame.update)
    (= (. frame committed) (call update-frame))
    (probe-group - gui.frame.update (text: "committed " (. frame committed)))
    (call sync-undo-state)
  )
)

(type + GUIFocusAdapter
  (prop + accepts _ (= true))
  (prop + requested-box (? Box))
  (prop + request-count Size (= 0))
  (fn-do + request _
    (param box (? Box))
    (= requested-box box)
    (+= request-count 1)
    (return accepts)
  )
)

(type + GuiWindowFrameCallback (is (c-fn-type Void (param window-pointer Pointer))))

(type + GuiWindowSizeCallback (is (c-fn-type Void (param window-pointer Pointer) (param width F64) (param height F64))))

(type + GuiWindowPointerCallback (is (c-fn-type Void (param window-pointer Pointer) (param event-kind U32) (param pointer-id U64) (param device-kind U32) (param button U32) (param buttons U64) (param modifier-bits U64) (param x F64) (param y F64) (param delta-x F64) (param delta-y F64) (param ordering-time F64) (param click-count U32) (param is-precise Bool) (param phase U64) (param momentum-phase U64) (param window-drag-token U64))))

(type + GuiWindowTouchCallback (is (c-fn-type Void (param window-pointer Pointer) (param phase U32) (param touch-id U64) (param x F64) (param y F64) (param ordering-time F64) (param tap-count U32) (param radius F64))))

(type + GuiWindowEventCallback (is (c-fn-type Void (param window-pointer Pointer) (param event-kind U32) (param key-kind U32) (param native-key-code U32) (param modifier-bits U64) (param is-repeat Bool) (param text-pointer (of CPointer Char8)))))

(type + NativeWindowEventKind (is U32)
  (variant key-press (= 0))
  (variant activated (= 3))
  (variant deactivated (= 4))
  (variant close-request (= 5))
  (variant closed (= 6))
  (variant modifiers-changed (= 7))
  (variant key-release (= 8))
  (variant unoccluded (= 9))
  (variant entered-full-screen (= 10))
  (variant exited-full-screen (= 11))
  (variant zoom-in (= 12))
  (variant zoom-out (= 13))
  (variant actual-size (= 14))
)

(type + NativeTextActionKind (is U32)
  (variant input (= 0))
  (variant command (= 1))
  (variant composition (= 2))
)

(type + GuiWindowTextActionCallback (is (c-fn-type Void (param window-pointer Pointer) (param action-kind U32) (param text-pointer (of CPointer Char8)) (param start U32) (param length U32) (param keyed Bool))))

(type + WindowFrame
  (implements (of Usable Void))
  (prop + committed _ (= false))
  (blank)
  (prop _ window Window)
  (fn-do + This _
    (param window _)
  )
  (fn-do + begin-using _
    (= committed false)
    (call (. window begin-frame))
    (return this)
  )
  (fn-do + end-using _
    (call (. window end-frame) committed)
  )
)

(fn-do + gui-window-render-frame _
  (param window-pointer Pointer)
  (let window (call (of gc-object-from-pointer Window) window-pointer))
  (call (. window render-frame))
)

(fn-do + gui-window-backing-scale-changed _
  (param window-pointer Pointer)
  (let window (call (of gc-object-from-pointer Window) window-pointer))
  (probe-count gui.adapter.backing-scale.callbacks-serviced)
  (call (. window sync-appearance-tags))
  (call (. window schedule-layout))
)

(fn-do + gui-window-moved _
  (param window-pointer Pointer)
  (let window (call (of gc-object-from-pointer Window) window-pointer))
  (call (. window accept-native-position))
)

(fn-do + gui-window-content-size-changed _
  (param window-pointer Pointer)
  (param width F64)
  (param height F64)
  (let window (call (of gc-object-from-pointer Window) window-pointer))
  (probe-count gui.adapter.resize.callbacks-serviced)
  (call (. window accept-native-content-size) (call Dimensions width height))
)

(fn-do + gui-window-pointer-event _
  (param window-pointer Pointer)
  (param event-kind U32)
  (param pointer-id U64)
  (param device-kind U32)
  (param button U32)
  (param buttons U64)
  (param modifier-bits U64)
  (param x F64)
  (param y F64)
  (param delta-x F64)
  (param delta-y F64)
  (param ordering-time F64)
  (param click-count U32)
  (param is-precise Bool)
  (param phase U64)
  (param momentum-phase U64)
  (param window-drag-token U64 (= 0))
  (let window (call (of gc-object-from-pointer Window) window-pointer))
  (call (. window accept-pointer-record)
    (block
      (arg
        (call PointerRecord
          (block
            (arg (as event-kind PointerRecordKind))
            (arg (call Point x y))
            (arg (call Point delta-x delta-y))
            (arg pointer-id)
            (arg device-kind)
            (arg button)
            (arg buttons)
            (arg modifier-bits)
            (arg ordering-time)
            (arg click-count)
            (arg is-precise)
            (arg phase)
            (arg momentum-phase)
            (arg window-drag-token)
          )
        )
      )
    )
  )
)

(fn-do + gui-window-touch-event _
  (param window-pointer Pointer)
  (param phase U32)
  (param touch-id U64)
  (param x F64)
  (param y F64)
  (param ordering-time F64)
  (param tap-count U32)
  (param radius F64)
  (let window (call (of gc-object-from-pointer Window) window-pointer))
  (let data
    (call PointerEventData
      (block
        (arg (call Point x y))
        (arg touch-id)
        (arg (. PointerDeviceKind touch))
        (arg (call PointerModifiers))
        (arg 0)
        (arg ordering-time)
      )
    )
  )
  (call (. window accept-touch) data (as phase TouchPhase) tap-count radius)
)

(fn-do + gui-window-native-event _
  (param window-pointer Pointer)
  (param event-kind U32)
  (param key-kind U32)
  (param native-key-code U32)
  (param modifier-bits U64)
  (param is-repeat Bool)
  (param text-pointer (of CPointer Char8))
  (let text (as text-pointer String))
  (let window (call (of gc-object-from-pointer Window) window-pointer))
  (match? (as event-kind NativeWindowEventKind)
    (case= (. NativeWindowEventKind key-press)
      (let event
        (call KeyPressEvent
          (block
            (arg (call key-from-native key-kind native-key-code))
            (arg (call pointer-modifiers-from-native modifier-bits))
            (arg is-repeat)
            (arg native-key-code)
            (arg text)
          )
        )
      )
      (call (. window dispatch-key-press) event)
    )
    (case= (. NativeWindowEventKind activated)
      (call (. window accept-window-activated))
    )
    (case= (. NativeWindowEventKind deactivated)
      (call (. window accept-window-deactivated))
    )
    (case= (. NativeWindowEventKind close-request)
      (call (. window accept-native-close-request)
        (block
          (on-error (: error Error)
            (call unhandled-error error)
          )
        )
      )
    )
    (case= (. NativeWindowEventKind closed)
      (call (. window close)
        (block
          (on-error (: error Error)
            (call unhandled-error error)
          )
        )
      )
    )
    (case= (. NativeWindowEventKind modifiers-changed)
      (call (. window dispatch-modifiers-changed) (call pointer-modifiers-from-native modifier-bits))
    )
    (case= (. NativeWindowEventKind key-release)
      (let event
        (call KeyReleaseEvent
          (block
            (arg (call key-from-native key-kind native-key-code))
            (arg (call pointer-modifiers-from-native modifier-bits))
            (arg native-key-code)
            (arg text)
          )
        )
      )
      (call (. window dispatch-key-release) event)
    )
    (case= (. NativeWindowEventKind unoccluded)
      (call (. window accept-window-unoccluded))
    )
    (case= (. NativeWindowEventKind entered-full-screen)
      (= (. window is-full-screen) true)
    )
    (case= (. NativeWindowEventKind exited-full-screen)
      (= (. window is-full-screen) false)
    )
    (case= (. NativeWindowEventKind zoom-in)
      (if (. window allows-zoom)
        (call (. window zoom-in))
      )
    )
    (case= (. NativeWindowEventKind zoom-out)
      (if (. window allows-zoom)
        (call (. window zoom-out))
      )
    )
    (case= (. NativeWindowEventKind actual-size)
      (if (. window allows-zoom)
        (call (. window zoom-to-actual-size))
      )
    )
  )
)

(fn-do + gui-window-text-action _
  (param window-pointer Pointer)
  (param action-kind U32)
  (param text-pointer (of CPointer Char8))
  (param start U32)
  (param length U32)
  (param keyed Bool)
  (let window (call (of gc-object-from-pointer Window) window-pointer))
  (call (. window accept-text-action) (as action-kind NativeTextActionKind) text-pointer start length keyed)
)

(type _ LiveFillDriver
  (implements FrameAnimation)
  (prop + owner Window)
  (prop + seconds F64)
  (prop + is-pending _ (= false))
  (fn-do + This _
    (param owner _)
  )
  (fn-do + advance Bool
    (param tick FrameTick)
    (+= seconds (as (as (. tick delta) Seconds) F64))
    (= is-pending true)
    (call (. owner schedule-render))
    (probe-count gui.live-fill.frames)
    (return true)
  )
  (fn-do + finish _)
)

(type _ WindowMarkupRoot (is Box)
  (implements MarkupRootElement)
  (prop + owner-window Window)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue (as this MarkupRootElement))))
  (fn-do + This _
    (param owner-window _)
    (call register-vector-geometry-renderer this (. owner-window vector-geometry-table))
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
    (if (. flush is-layout-invalid)
      (call (. owner-window schedule-layout))
      (else-if (. flush is-paint-invalid)
        (call (. owner-window schedule-render))
      )
    )
    (if (. flush is-cursor-invalid)
      (call (. owner-window accept-cursor-style-changes))
    )
    (call (. owner-window settle-pending-focus))
  )
  (fn-do + close _
    (call unregister-vector-geometry-renderer this)
    (call (. super close))
  )
)

(fn-expr _ window-commands _
  (param command-nodes (list CommandNode))
  (param shortcuts (list KeyShortcut))
  (spread command-nodes)
  (pipe *> (as each Command))
  (spread
    (block
      (spread shortcuts)
      (pipe ?> (and (. each title) (. each discoverable)))
      (pipe *> (as each Command))
    )
  )
  (pipe |> List)
)

(fn-expr _ window-stoplight-room Length
  (param edge Length)
  (param offset (? Point))
  (if-expr (> edge 0) (+ edge (?? (?. offset x) 0) window-stoplight-gap) window-stoplight-inset)
)
