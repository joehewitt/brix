(blank)
(prop + window-stoplight-offset _ (= (call Point 8 7)))
(prop + window-stoplight-center Length (= 14))
(prop + window-stoplight-inset Length (= 80))
(prop + window-full-screen-inset Length (= 8))
(prop + window-sidebar-toggle-width Length (= 34))
(prop + window-sidebar-toggle-inset Length (= (+ window-stoplight-inset window-sidebar-toggle-width)))
(prop + window-full-screen-sidebar-toggle-inset Length
  (=
    (block
      (+ window-full-screen-inset window-sidebar-toggle-width)
    )
  )
)
(prop + window-zoom-levels (list F64) (= (list 0.5 (/ 2.0 3.0) 0.75 0.8 0.9 1.0 1.1 1.25 1.5 1.75 2.0)))
(blank)
(prop _ window-stoplight-gap Length (= 11))
(prop _ window-opening-settle-limit _ (= 1s))
(prop _ window-opening-settle-step _ (= 2ms))
(prop _ window-zoom-tolerance F64 (= 0.001))
(prop _ window-zoom-in-keys _ (= (list (+ (. KeyModifier command) "=") (+ (. KeyModifier command) "+"))))
(prop _ window-zoom-out-keys _ (= (list (+ (. KeyModifier command) "-"))))
(prop _ window-actual-size-keys _ (= (list (+ (. KeyModifier command) "0"))))
(blank)
(type-line _ PointerCapture (is (tuple (: path PointerHitPath) (: pointer-id U64) (: button PointerButton) (: click-count U32))))
(type-line _ TouchCapture (is (tuple (: path PointerHitPath) (: point Point))))
(type-line _ ScrollIndicatorHit (is (tuple (: owner Box) (: axis Orientation))))
(type-line _ IndicatorCapture (is (tuple (: route PointerHitPath) (: owner Box) (: axis Orientation) (: id U64) (: offset Length))))

(type + Window (is Box)
  (implements Closable)
  (implements WindowHost)
  (implements FrameClockHost)
  (prop + app (? App))
  (event + activated WindowActivatedEvent)
  (event + deactivated WindowDeactivatedEvent)
  (event + closing ClosingEvent)
  (event + closed ClosedEvent)
  (prop + title _ (= (?? (?. #app #title) "")))
  (prop + kind _ (= (. WindowKind standard)))
  (prop + titlebar-visible _ (= true))
  (prop + stoplight-offset (? Point))
  (prop + is-full-screen _ (= false))
  (prop + appearance _ (= gui-window-appearance))
  (prop + size _ (= (call Dimensions 640 480)))
  (prop + zoom F64 (= 1))
  (prop + allows-zoom _ (= false))
  (prop + stoplight-inset _ (= (/ (call window-stoplight-room #native-stoplight-edge #stoplight-offset) (if-expr (> #zoom 0) #zoom 1))))
  (prop + position (? Point))
  (prop + state-key (? String))
  (prop + background (? RGBA))
  (prop + use-metal _ (= true))
  (prop + use-wide-gamut _ (= false))
  (prop + metal-fallback-reason _ (= ""))
  (prop + native (? Pointer))
  (prop + native-menu-bar (? Pointer))
  (prop + last-frame-target-time Nanoseconds (= 0ns))
  (prop + last-frame-refresh-interval Nanoseconds (= 0ns))
  (prop _ logged-gc-collections UInt)
  (prop + previous-window (? Window))
  (prop + next-window (? Window))
  (prop + is-active _ (= false))
  (prop + has-opened _ (= false))
  (prop + focused-box (? Box))
  (prop + remembered-focus-box (? Box))
  (prop + popups (list Popup))
  (prop + modal-popup (? Popup))
  (prop + focus-adapter (? GUIFocusAdapter))
  (prop + drag-session (? DragSession))
  (prop + key-bindings (list KeyBinding) (= (call active-bindings #key-binding-nodes #focused-box #modal-popup)))
  (prop + key-binding-conflicts (list KeyBindingConflict) (= (call find-key-binding-conflicts #key-bindings)))
  (prop + registered-key-bindings (list KeyBinding) (= #key-binding-nodes))
  (prop + commands (list Command) (= (call window-commands #command-nodes #key-shortcut-nodes)))
  (prop + window-clock _ (:= (call FrameClock this)))
  (prop + native-window-handle _ (=> native))
  (prop + is-window-root _ (=> true))
  (prop + admits-entering _ (=> (and has-opened (== entering-hush 0) (not (call scope-stills (call current-markup-cause))))))
  (prop + admits-leaving _ (=> (and has-opened (not (call scope-stills (call current-markup-cause))))))
  (prop + current-cursor-style _ (=> resolved-cursor-style))
  (prop + current-hovered-box (? Box) (=> hovered-box))
  (blank)
  (prop _ entering-hush Size (= 0))
  (prop _ is-layout-hushed _ (= false))
  (prop _ shows-inactive _ (= false))
  (prop _ focus-home (? Box))
  (prop _ key-binding-nodes (of Descendants KeyBinding))
  (prop _ command-nodes (of Descendants CommandNode))
  (prop _ key-shortcut-nodes (of Descendants KeyShortcut))
  (prop _ is-closed _ (= true))
  (prop _ is-closing _ (= false))
  (prop _ is-finished _ (= false))
  (prop _ is-render-invalid _ (= true))
  (prop _ is-fill-pending _ (= false))
  (prop _ is-frame-scheduled _ (= false))
  (prop _ frame-not-before Nanoseconds (= 0ns))
  (prop _ is-rendering _ (= false))
  (prop _ live-fill-rate (? F64))
  (prop _ live-fill-rest-at (? U64))
  (prop _ live-fill-wake-at (? F64))
  (prop _ live-fill-waker (? Task))
  (prop _ needs-layout _ (= true))
  (prop _ requested-native-size _ (= (call Dimensions -1 -1)))
  (prop _ requested-native-position (? Point))
  (prop _ hovered-box (? Box))
  (prop _ hovered-path (? PointerHitPath))
  (prop _ pointer-capture (? PointerCapture))
  (prop _ touch-captures (map U64 TouchCapture))
  (prop _ landings _ (= (call (of List BoxLanding))))
  (prop _ is-drag-offered _ (= false))
  (prop _ is-drag-scrolling _ (= false))
  (prop _ scroll-indicator-capture (? IndicatorCapture))
  (prop _ scroll-gesture-path (? PointerHitPath))
  (prop _ magnify-gesture-path (? PointerHitPath))
  (prop _ wheel-path (? PointerHitPath))
  (prop _ focused-path (? PointerHitPath))
  (prop _ pending-focus-box (? Box))
  (prop _ focused-groups (list Box))
  (prop _ is-key-focus _ (= false))
  (prop _ pending-popup-focus (? Popup))
  (prop _ is-focus-suspended _ (= false))
  (prop _ is-popup-placement-invalid _ (= false))
  (prop _ clip-watchers (list ClipWatcher))
  (prop _ press-origin Point)
  (prop _ hover-owner (? Box))
  (prop _ is-hover-refresh-pending _ (= false))
  (prop _ scroll-hover-owner (? Box))
  (prop _ scroll-hover-deadline (? Deadline))
  (prop _ is-scroll-hover-settling _ (= false))
  (prop _ markup-root _ (:= (call WindowMarkupRoot this)))
  (prop _ frame-scope _ (:= (call WindowFrame this)))
  (prop _ live-fills _ (:= (call LiveFillDriver this)))
  (event _ hover-entered Popup)
  (event _ hover-exited Bool)
  (event _ hover-popup-removed Popup)
  (prop + pointer-location Point)
  (blank)
  (prop _ is-requesting-native-focus _ (= false))
  (prop _ requested-native-focus-box (? Box))
  (prop _ key-press-handled _ (= false))
  (prop _ key-pressed-box (? Box))
  (prop _ native-text-input-active _ (= false))
  (prop _ native-undo-title (? String))
  (prop _ native-redo-title (? String))
  (prop _ ensure-visible-queue (? EnsureVisibleQueue))
  (prop _ retained-scene (? DisplayScene))
  (prop _ retained-surface (? RasterCanvas))
  (prop _ retained-surface-size Dimensions)
  (prop _ retained-surface-scale F64)
  (prop _ retained-surface-color-space Pointer)
  (prop _ selected-metal _ (= false))
  (prop _ metal-renderer (? MetalOffscreenRenderer))
  (prop _ metal-surface-reset _ (= false))
  (prop _ native-artifacts (list Pointer))
  (prop _ native-artifact-registry-changed _ (= false))
  (prop _ native-sync-pass U64)
  (prop _ native-geometry-dirty _ (= true))
  (prop _ window-material-count Size)
  (prop _ native-transparent _ (= false))
  (prop _ native-clear _ (= false))
  (prop _ native-transparency-known _ (= false))
  (prop _ has-pointer-location _ (= false))
  (prop _ cursor-resolution-invalid _ (= true))
  (prop _ resolved-cursor-style _ (= (. CursorStyle automatic)))
  (prop _ resolved-cursor-captured _ (= false))
  (prop _ has-root-layers _ (= false))
  (prop _ applied-zoom F64 (= 1))
  (prop _ native-stoplight-edge Length (= 0))
  (prop _ scroll-resampler _ (:= (call ScrollResampler)))
  (prop _ fallback-vector-geometry-table _ (:= (call VectorGeometryTable)))
  (blank)
  (depends window-size-changed size)
  (depends window-zoom-changed zoom)
  (depends window-position-changed position)
  (depends window-background-changed background)
  (depends window-chrome-changed kind titlebar-visible stoplight-offset appearance allows-zoom)
  (depends window-title-changed title)
  (prop _ hover-tip _
    (machine
      (state hidden
        (then (call waiting popup) (trigger for popup hover-entered))
      )
      (blank)
      (state (call waiting popup)
        (then (call shown popup) (trigger on (call Timer (. popup $hover-delay)) (not is-closed))
          (do
            (inline (call show-hover-popup popup))
          )
        )
        (then (call waiting next) (trigger for next hover-entered))
        (then hidden (trigger on hover-exited))
      )
      (blank)
      (state (call shown popup)
        (then (call lingering popup) (trigger on hover-exited))
        (then (call shown next) (trigger for next hover-entered)
          (do
            (inline (call switch-hover-popup popup next))
          )
        )
        (then (call cooling (. popup $hover-warmth)) (trigger on hover-popup-removed (== (as each Pointer) (as popup Pointer))))
      )
      (blank)
      (state (call lingering popup)
        (then (call cooling (. popup $hover-warmth)) (trigger on (call Timer (. popup $hover-linger)))
          (do
            (inline (call (. popup dismiss) (. DismissReason hover-end)))
          )
        )
        (then (call shown popup) (trigger on hover-entered (== (as each Pointer) (as popup Pointer))))
        (then (call shown next) (trigger for next hover-entered)
          (do
            (inline (call switch-hover-popup popup next))
          )
        )
        (then (call cooling (. popup $hover-warmth)) (trigger on hover-popup-removed (== (as each Pointer) (as popup Pointer))))
      )
      (blank)
      (state (call cooling warmth)
        (then hidden (trigger on (call Timer warmth)))
        (then (call shown next) (trigger for next hover-entered)
          (do
            (inline (call show-hover-popup next))
          )
        )
      )
    )
  )
  (whenever-rule #position
    (call save-frame)
  )
  (whenever-rule #size
    (call save-frame)
  )
  (fn-do + composite-layers _ :get
    (if (not has-root-layers)
      (= has-root-layers true)
      (call composite-install-window-layers this)
    )
    (return declared-layer-list)
  )
  (fn-do + hit-path _
    (param point Point)
    (let index (. popups length))
    (while (> index 0)
      (-= index 1)
      (let popup ([] popups index))
      (if (. popup is-input-visible)
        (let is-hit (and (not (. popup $pointer-transparent)) (call (. popup hit-contains) point)))
        (return-if (call hit-path-within popup point) (if (or is-hit (. popup $modal))))
      )
    )
    (return-if (if (not (call (. bounds contains) point))))
    (return (call (. super hit-path) point))
  )
  (fn-expr + admits-focus _
    (param box Box)
    (or (not home) (== (as box (? Pointer)) (as home (? Pointer))) (. box $claims-focus))
    (where
      (lazy home attached-focus-home)
    )
  )
  (fn-do + schedule-layout _
    (= needs-layout true)
    (= cursor-resolution-invalid true)
    (call schedule-render)
  )
  (fn-do + schedule-render _
    (return-if (if is-closed))
    (blank)
    (= is-render-invalid true)
    (call request-render-frame)
  )
  (fn-do + queue-ensure-visible-request _
    (param descendant Box)
    (param generation U32)
    (param alignment ScrollAlignment)
    (param margin Insets)
    (param cause ScrollCause)
    (if (not ensure-visible-queue)
      (= ensure-visible-queue (call EnsureVisibleQueue))
    )
    (let queue (!! ensure-visible-queue))
    (= (. queue pending) descendant)
    (= (. queue generation) generation)
    (= (. queue alignment) alignment)
    (= (. queue margin) margin)
    (= (. queue cause) cause)
    (call schedule-layout)
  )
  (fn-do + did-layout _
    (call (. super did-layout))
    (if ensure-visible-queue
      (call settle-ensure-visible-queue ensure-visible-queue)
    )
  )
  (fn-do + paint _
    (param canvas Canvas)
    (if (not retained-scene)
      (= retained-scene (call DisplayScene (. canvas scale) window-background))
    )
    (call (. (!! retained-scene) maintain) this (. canvas scale) window-background)
    (call (. super paint) canvas)
  )
  (fn-do + paint-overlay _
    (param canvas Canvas)
    (for (in popup popups)
      (if (. popup is-paint-visible)
        (call (. popup paint) canvas)
      )
    )
    (let ghost (?. drag-session ghost))
    (if ghost
      (call (. canvas draw-image) (. ghost image) (. ghost frame))
    )
  )
  (fn-do + close _
    (return-if (if is-finished))
    (= is-finished true)
    (return-if (if is-closed))
    (call settle-pointer-dispatch)
    (if native
      (call C:brixGuiWindowClose native)
    )
    (call finish-close)
    (call (. super close))
    (call (. markup-root close))
  )
  (fn-expr + backing-scale _ :get
    (* display-scale effective-zoom)
  )
  (fn-expr + effective-zoom F64 :get
    (if-expr (> zoom 0) zoom 1)
  )
  (fn-do + hush-entering _
    (param hushed Bool)
    (if hushed
      (+= entering-hush 1)
      (else-if entering-hush
        (-= entering-hush 1)
      )
    )
  )
  (fn-do + hush-until-layout _
    (return-if (if is-layout-hushed))
    (= is-layout-hushed true)
    (call hush-entering true)
    (call schedule-layout)
  )
  (fn-do + accept-focus-request _
    (param box (? Box))
    (return-if false (if is-closed))
    (if (not box)
      (= pending-focus-box null)
      (return (call apply-focus null true))
    )
    (blank)
    (let target box)
    (return-if false (if (not (call is-in-focus-scope target))))
    (if (not (. target can-focus))
      (= pending-focus-box target)
      (return true)
    )
    (blank)
    (= pending-focus-box null)
    (return (call apply-focus target true))
  )
  (fn-do + accept-text-input-change _
    (param box Box)
    (if (== (as box (? Pointer)) (as focused-box (? Pointer)))
      (call sync-text-input)
    )
  )
  (fn-do + invalidate-popup-placement _
    (return-if (if (or (== (. popups length) 0) is-closed)))
    (= is-popup-placement-invalid true)
    (call schedule-render)
  )
  (fn-do + watch-clip _
    (param watcher ClipWatcher)
    (return-if (if (!= (call clip-watcher-index watcher) null)))
    (+= clip-watchers watcher)
  )
  (fn-do + unwatch-clip _
    (param watcher ClipWatcher)
    (let index (call clip-watcher-index watcher))
    (if (!= index null)
      (call (. clip-watchers remove) index)
    )
  )
  (fn-do + notify-clip-watchers _
    (param scrolled (? Box))
    (return-if (if is-closed))
    (let index Index)
    (while (< index (. clip-watchers length))
      (let watcher ([] clip-watchers index))
      (call (. watcher clip-changed) scrolled)
      (if (and (< index (. clip-watchers length)) (== (as ([] clip-watchers index) Pointer) (as watcher Pointer)))
        (+= index 1)
      )
    )
  )
  (fn-expr + holds-scroll-indicator _
    (param owner Box)
    (or is-captured (and has-pointer-location holds-hover has-axis))
    (where
      (lazy capture scroll-indicator-capture)
      (lazy holds-hover (call hover-path-holds (as owner Pointer) hovered-path))
      (lazy is-captured (and capture (== (as (. capture owner) Pointer) (as owner Pointer))))
      (lazy has-axis (!= (call (. owner scroll-indicator-axis-at) pointer-location) null))
    )
  )
  (fn-do + release-input-inside _
    (param subtree Box)
    (return-if (if is-closed))
    (if (and focused-box (call (. focused-box is-within) subtree))
      (call request-native-focus null)
      (call clear-focus-state false)
    )
    (if (and pending-focus-box (call (. pending-focus-box is-within) subtree))
      (= pending-focus-box null)
    )
    (if (and remembered-focus-box (call (. remembered-focus-box is-within) subtree))
      (= remembered-focus-box null)
    )
    (if (and requested-native-focus-box (call (. requested-native-focus-box is-within) subtree))
      (= requested-native-focus-box null)
    )
    (let queue ensure-visible-queue)
    (if (and queue (. queue pending) (call (. queue pending is-within) subtree))
      (= (. queue pending) null)
    )
    (for (in popup popups)
      (let restore (call (. popup take-return-focus)))
      (if (and restore (not (call (. restore is-within) subtree)))
        (call (. popup remember-return-focus) restore)
      )
    )
    (for (in popup (call (of List Popup) popups))
      (let anchor (. popup anchor-box))
      (if (or (call (. popup is-within) subtree) (and (!= anchor null) (call (. anchor is-within) subtree)))
        (call (. popup dismiss) (. DismissReason anchor-hidden))
      )
    )
    (if (and hovered-box (call (. hovered-box is-within) subtree))
      (call clear-hover)
      (= is-hover-refresh-pending true)
    )
    (if (and pointer-capture (call (. pointer-capture path target is-within) subtree))
      (call clear-pointer-capture)
    )
    (if (and scroll-indicator-capture (call (. scroll-indicator-capture owner is-within) subtree))
      (call clear-pointer-capture)
    )
    (if (and scroll-gesture-path (call (. scroll-gesture-path target is-within) subtree))
      (call clear-scroll-gesture)
    )
    (if (and scroll-hover-owner (call (. scroll-hover-owner is-within) subtree))
      (call release-scroll-hover-hold)
    )
    (= cursor-resolution-invalid true)
  )
  (fn-do + register-native-artifact _
    (param box Box)
    (let identity (as box Pointer))
    (for (in existing native-artifacts)
      (return-if (if (== existing identity)))
    )
    (+= native-artifacts identity)
    (= native-artifact-registry-changed true)
    (probe-count gui.native.registry-additions)
  )
  (fn-do + unregister-native-artifact _
    (param box Box)
    (let identity (as box Pointer))
    (for (in index (..< 0 (. native-artifacts length)))
      (if (== ([] native-artifacts index) identity)
        (call (. native-artifacts remove) index)
        (= native-artifact-registry-changed true)
        (probe-count gui.native.registry-removals)
        (return)
      )
    )
  )
  (fn-do + register-focus-home _
    (param box Box)
    (= focus-home box)
  )
  (fn-do + unregister-focus-home _
    (param box Box)
    (if (== (as focus-home (? Pointer)) (as box (? Pointer)))
      (= focus-home null)
    )
  )
  (fn-do + invalidate-native-artifacts _
    (= native-artifact-registry-changed true)
  )
  (fn-do + invalidate-visited-native-geometry _
    (param pass U64)
    (if (== pass native-sync-pass)
      (= native-geometry-dirty true)
    )
  )
  (fn-do + sync-native-artifact-registry _
    (param native-origin Point)
    (param native-parent (? Pointer))
    (= native-artifact-registry-changed false)
    (= native-geometry-dirty false)
    (= window-material-count 0)
    (return-if (if (== (. native-artifacts length) 0)))
    (probe-count gui.native.registered-artifacts (as (. native-artifacts length) U64))
    (let native-window (?? native-window-handle (call Pointer)))
    (+= native-sync-pass 1)
    (for (in identity native-artifacts)
      (let artifact (call (of gc-object-from-pointer Box) identity))
      (call (. artifact sync-native-artifact) native-origin native-window native-parent native-sync-pass)
      (if (and (. artifact has-native-material) (not (. artifact presentation-layer)))
        (+= window-material-count 1)
      )
    )
  )
  (fn-do + request-clock-frame _
    (call request-render-frame)
  )
  (fn-expr + vector-geometry-table _ :get
    (?? (?. app vector-geometry-table) fallback-vector-geometry-table)
  )
  (fn-expr + is-open _ :get
    (not is-closed)
  )
  (fn-expr + native-artifact-count _ :get
    (. native-artifacts length)
  )
  (fn-expr + popup-boundary _ :get
    (case? native
      (call (. screen inset) (call Insets 4 4 4 4))
    )
    (default
      bounds
    )
    (where
      (lazy screen
        (call Rect
          (block
            (arg (/ (call C:brixGuiWindowGetScreenBound native 0) zoom))
            (arg (/ (call C:brixGuiWindowGetScreenBound (!! native) 1) zoom))
            (arg (/ (call C:brixGuiWindowGetScreenBound (!! native) 2) zoom))
            (arg (/ (call C:brixGuiWindowGetScreenBound (!! native) 3) zoom))
          )
        )
      )
      (lazy zoom effective-zoom)
    )
  )
  (fn-expr + display-scale F64 :get
    (if-expr native (call C:brixGuiWindowGetBackingScaleFactor native) 1)
  )
  (fn-expr + viewport Dimensions :get
    (call Dimensions (/ (. size width) zoom-factor) (/ (. size height) zoom-factor))
    (where
      (lazy zoom-factor effective-zoom)
    )
  )
  (fn-expr + is-metal-rendering _ :get
    (and selected-metal metal-renderer (. metal-renderer is-available))
  )
  (fn-expr + metal-present-count _ :get
    (?? (?. metal-renderer presents) 0)
  )
  (fn-expr + metal-maximum-frames-per-second I64 :get
    (?? (?. metal-renderer maximum-frames-per-second) 0)
  )
  (fn-expr + last-metal-frame-id _ :get
    (- (?? (?. metal-renderer commits) 0) 1)
  )
  (fn-expr + metal-renderer-allocations _ :get
    (?? (?. metal-renderer renderer-allocations) -1)
  )
  (fn-expr + metal-draw-calls _ :get
    (?? (?. metal-renderer draw-calls) -1)
  )
  (fn-expr + metal-skipped-ops _ :get
    (?? (?. metal-renderer skipped-ops) -1)
  )
  (fn-expr + scene-opaque-demotions _ :get
    (?? (?. retained-scene opaque-demotions) 0)
  )
  (fn-expr + scene-metal-tile-fallbacks _ :get
    (?? (?. retained-scene metal-tile-fallbacks) 0)
  )
  (fn-expr + scene-items-built _ :get
    (?? (?. retained-scene items-built) 0)
  )
  (fn-expr + completed-metal-frame-id I64 :get
    (?? (?. metal-renderer completed-frame) -1)
  )
  (fn-expr _ has-transparent-background Bool :get
    (or (> window-material-count 0) has-clear-background)
  )
  (fn-expr _ has-clear-background Bool :get
    (< (. window-background alpha) 1)
  )
  (fn-expr _ window-background RGBA :get
    (?? background $gui-window-color)
  )
