          (call clear-hover)
        )
      )
      (= changed true)
    )
    (if (and pointer-capture (not (call (. pointer-capture path is-current))))
      (call clear-pointer-capture)
      (= changed true)
    )
    (if (and scroll-indicator-capture (not (call (. scroll-indicator-capture route is-current))))
      (call clear-pointer-capture)
      (= changed true)
    )
    (if (and scroll-gesture-path (not (call (. scroll-gesture-path is-current))))
      (call clear-scroll-gesture)
      (= changed true)
    )
    (if (!= (. touch-captures length) 0)
      (let stale-touches (list U64))
      (for (in (tuple id capture) touch-captures)
        (if (not (call (. capture path is-current)))
          (+= stale-touches id)
        )
      )
      (for (in id stale-touches)
        (-= ([] touch-captures id))
      )
    )
    (let source (?. drag-session source))
    (if (and source (!= (as (. source root) Pointer) (as this Pointer)))
      (call finish-drag false)
      (= changed true)
    )
    (return changed)
  )
  (fn-do _ prepare-pointer-dispatch _
    (return-if false (if is-closed))
    (call settle-pointer-dispatch)
    (return (not is-closed))
  )
  (fn-do _ settle-pointer-dispatch _
    (return-if (if is-closed))
    (catch (call (. markup-root markup-batch-queue checkpoint)))
    (return-if (if is-closed))
    (call settle-popup-focus)
    (call settle-pending-focus)
    (if needs-layout
      (= needs-layout false)
      (call layout)
      (else-if is-popup-placement-invalid
        (call layout-popups)
      )
    )
    (blank)
    (let owners-changed (call validate-pointer-owners))
    (let focus-changed (call validate-focus-owner))
    (if (or owners-changed focus-changed)
      (catch (call (. markup-root markup-batch-queue checkpoint)))
      (call settle-pending-focus)
      (if needs-layout
        (= needs-layout false)
        (call layout)
      )
    )
    (call settle-focus-home)
    (call settle-drag-ghost)
    (call settle-cursor-resolution)
    (call sync-undo-state)
