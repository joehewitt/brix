      (block
        (arg
          (call merged-live-fills
            (block
              (arg (call (. scene damage-live-chunks) (call Rect viewport) (. live-fills is-pending)))
              (arg popup-fills)
            )
          )
        )
      )
    )
    (= (. live-fills is-pending) false)
