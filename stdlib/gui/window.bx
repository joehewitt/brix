      (return)
    )
    (call rest-live-fills null)
    (return-if (if (and (call (. window-clock is-animating) live-fills) (== live-fill-rate (. state frame-rate)))))
    (= live-fill-rate (. state frame-rate))
    (call (. window-clock start) this live-fills (. state frame-rate))
