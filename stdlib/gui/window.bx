      (lazy is-arrow (or is-vertical-arrow is-horizontal-arrow))
      (lazy is-vertical-arrow (or (== key (. Key arrow-up)) (== key (. Key arrow-down))))
      (lazy is-horizontal-arrow (or (== key (. Key arrow-left)) (== key (. Key arrow-right))))
      (lazy is-paging (or (== key (. Key home)) (== key (. Key end)) (== key (. Key page-up)) (== key (. Key page-down))))
