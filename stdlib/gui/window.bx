        (arg (!! native))
        (arg (. surface native))
        (arg (. presented x))
        (arg (. presented y))
        (arg (. presented width))
        (arg (. presented height))
      )
    )
    (probe-group - gui.frame.phase.commit)
    (probe-count gui.frame.gc-objects (- (call C:brixGCAllocatedObjectCount) frame-objects0))
    (probe-count gui.frame.gc-bytes (- (call C:brixGCRequestedByteCount) frame-bytes0))
    (return true)
