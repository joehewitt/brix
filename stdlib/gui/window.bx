    (= is-scroll-hover-settling true)
    (do-new
      (call settle-scroll-hover-hold)
    )
  )
  (fn-do _ settle-scroll-hover-hold _
    (while (and scroll-hover-owner (not is-closed))
      (let deadline (!! scroll-hover-deadline))
      (if (. deadline has-passed)
        (break)
      )
      (call (. deadline remaining wait))
    )
    (= is-scroll-hover-settling false)
    (return-if (if (or (not scroll-hover-owner) is-closed)))
    (call release-scroll-hover-hold)
    (= is-hover-refresh-pending true)
    (call settle-pointer-dispatch)
  )
  (fn-do _ release-scroll-hover-hold _
    (= scroll-hover-owner null)
    (= wheel-path null)
  )
  (fn-do _ finish-scroll-event _
    (param event ScrollEvent)
    (let direct-cancel (== (. event phase) (. ScrollPhase cancelled)))
    (let momentum-finished (== (. event momentum-phase) (. ScrollPhase ended)))
    (= momentum-finished (or momentum-finished (== (. event momentum-phase) (. ScrollPhase cancelled))))
    (if (or direct-cancel momentum-finished)
      (call clear-scroll-gesture)
    )
