      (= live-fill-wake-at null)
      (call (?. live-fill-waker cancel-later))
      (= live-fill-waker null)
      (return)
    )
    (= live-fill-rest-at (?? live-fill-rest-at (call monotonic-time-nanoseconds)))
    (return-if (if (== live-fill-wake-at wake-at)))
    (= live-fill-wake-at wake-at)
    (call (?. live-fill-waker cancel-later))
