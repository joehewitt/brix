  (fn-do _ settle-drag-ghost _
    (let session drag-session)
    (return-if (if (not session)))
    (if (. session pending-snapshot)
      (call capture-drag-ghost session)
    )
    (if native
      (call (?. (. session ghost) present) native effective-zoom)
    )
  )
  (fn-expr _ drag-scroll-delta Length
    (param session DragSession)
    (match (. session scroller)
      (case= null
        0
      )
      (case (: scroller Box)
        (case? (< above drag-scroll-edge)
          (- (call drag-scroll-amount (- drag-scroll-edge above)))
        )
        (case? (< below drag-scroll-edge)
          (call drag-scroll-amount (- drag-scroll-edge below))
        )
        (default
          0
        )
        (blank)
        (lazy local (call (. scroller point-in-box) (. session point)))
        (lazy above (. local y))
        (lazy below (- (. scroller bounds height) (. local y)))
      )
    )
  )
  (fn-do _ start-drag-scroll _
    (let session drag-session)
    (return-if (if (or (not session) is-drag-scrolling (not native))))
    (return-if (if (== (call drag-scroll-delta session) 0)))
    (= is-drag-scrolling true)
    (do-new
      (while (call step-drag-scroll)
        (call (. drag-scroll-interval wait))
      )
      (= is-drag-scrolling false)
    )
  )
  (fn-do _ dispatch-scroll-samples _
    (return-if (if (or (. scroll-resampler is-idle) (not native))))
    (for (in event (call (. scroll-resampler take) (call C:brixGuiWindowGetLastFrameEventTime (!! native))))
      (let ignored (call dispatch-pointer-event event))
    )
    (if (not (. scroll-resampler is-idle))
      (call request-render-frame)
    )
  )
  (fn-do _ show-activity _
    (param active Bool)
    (return-if (if (== shows-inactive (not active))))
    (= shows-inactive (not active))
    (if (and (not is-closed) (call style-live-attachment this))
      (call set-theme-tag "inactive" shows-inactive)
    )
    (call schedule-layout)
  )
  (fn-expr _ pointer-hit-path _
    (param point Point)
    (call hit-path point)
  )
  (fn-do _ accept-pointer-location _
    (param point Point)
    (= pointer-location point)
    (= has-pointer-location true)
    (= cursor-resolution-invalid true)
  )
  (fn-do _ settle-cursor-resolution _
    (return-if (if (or (not cursor-resolution-invalid) (and scroll-hover-owner (not drag-session)))))
    (= cursor-resolution-invalid false)
    (let next (. CursorStyle automatic))
    (let captured false)
    (if has-pointer-location
      (let hit (call pointer-hit-path pointer-location))
      (if hit
        (= next (. hit target $cursor))
      )
    )
    (if (and pointer-capture (call (. pointer-capture path is-current)))
      (let override (. pointer-capture path target $drag-cursor))
      (if override
        (= next override)
        (= captured true)
      )
    )
    (let session drag-session)
    (if (and session (. session source))
      (= next (if-expr (. session is-accepted) (. CursorStyle closed-hand) (. CursorStyle not-allowed)))
      (= captured true)
    )
    (return-if (if (and (== next resolved-cursor-style) (== captured resolved-cursor-captured))))
    (= resolved-cursor-style next)
    (= resolved-cursor-captured captured)
    (if native
      (call C:brixGuiWindowSetCursorStyle
        (block
          (arg native)
          (arg (call cursor-style-native-value next))
          (arg (call cursor-style-native-image next))
          (arg captured)
        )
      )
    )
  )
  (fn-do _ activate-pressed _
    (param event KeyPressEvent)
    (param target (? Box))
    (return-if (if (or (not target) (!= (. target $focus-mode) (. FocusMode press)))))
    (call (. event cancel))
    (return-if (if (. event is-repeat)))
    (call release-key-press)
    (= key-pressed-box target)
    (= (. target is-pressed) true)
    (= (. target is-press-within) true)
    (call (. (call (. target event-path)) publish) (call ClickEvent (call PointerEventData) (. PointerButton primary) 1))
  )
  (fn-do _ release-key-press _
    (let box key-pressed-box)
    (return-if (if (not box)))
    (= key-pressed-box null)
    (= (. box is-pressed) false)
    (= (. box is-press-within) false)
  )
  (fn-do _ update-hover _
    (param hit (? PointerHitPath))
    (return-if (if drag-session))
    (let target (?. hit target))
    (return-if (if (== target hovered-box)))
    (blank)
    (do-use gui-instant-cause
      (= (?. hovered-box is-hovered) false)
      (call set-scroll-hover-path false hovered-path hit)
      (= hovered-box target)
      (= hovered-path hit)
      (if target
        (= (. target is-hovered) (. target is-effectively-enabled))
      )
      (call set-scroll-hover-path true hovered-path)
    )
    (call settle-hover-popup target)
  )
  (fn-do _ clear-hover _
    (do-use gui-instant-cause
      (= (?. hovered-box is-hovered) false)
      (call set-scroll-hover-path false hovered-path)
    )
    (= hovered-box null)
    (= hovered-path null)
    (call settle-hover-popup null)
  )
  (fn-do _ clear-pointer-capture _
    (= (. (?. pointer-capture path) target is-pressed) false)
    (call set-press-path false (?. pointer-capture path))
    (= pointer-capture null)
    (= scroll-indicator-capture null)
    (= cursor-resolution-invalid true)
  )
  (fn-do _ set-press-path _
    (param value Bool)
    (param path (? PointerHitPath))
    (return-if (if (not path)))
    (for (in frame (. path frames))
      (let box (call (of gc-object-from-pointer Box) (. frame owner)))
      (let next (and value (. box is-effectively-enabled)))
      (if (!= (. box is-press-within) next)
        (= (. box is-press-within) next)
      )
    )
  )
  (fn-do _ set-scroll-hover-path _
    (param value Bool)
    (param path (? PointerHitPath))
    (param retained (? PointerHitPath) (= null))
    (return-if (if (not path)))
    (for (in frame (. path frames))
      (if (not (call hover-path-holds (. frame owner) retained))
        (let box (call (of gc-object-from-pointer Box) (. frame owner)))
        (let next (and value (. box is-effectively-enabled)))
        (if (!= (. box is-hover-within) next)
          (= (. box is-hover-within) next)
        )
      )
    )
  )
  (fn-expr _ hover-path-holds _
    (param owner Pointer)
    (param path (? PointerHitPath))
    (and path (call some (. path frames) (:where (== (. each owner) owner))))
  )
  (fn-do _ scroll-indicator-hit _
    (param point Point)
    (param hit (? PointerHitPath))
    (return-if (if (not hit)))
    (for (in frame (. hit frames))
      (let box (call (of gc-object-from-pointer Box) (. frame owner)))
      (let axis (call (. box scroll-indicator-axis-at) point))
      (return-if (call ScrollIndicatorHit box axis) (if axis))
    )
  )
  (fn-do _ begin-scroll-indicator-capture _
    (param event PointerDownEvent)
    (param hit (? PointerHitPath))
    (return-if false (if (!= (. event button) (. PointerButton primary))))
    (let indicator (call scroll-indicator-hit (. event root-point) hit))
    (return-if false (if (not indicator)))
    (let owner (. indicator owner))
    (let path (call (. (call (. owner event-path)) at-point) (. event root-point)))
    (call update-hover path)
    (let offset (call (. owner scroll-indicator-drag-offset) (. indicator axis) (. event root-point)))
    (call (. owner scroll-indicator-scroll-to-point) (. indicator axis) (. event root-point) offset)
    (call clear-pointer-capture)
    (= scroll-indicator-capture
      (call IndicatorCapture
        (block
          (arg path)
          (arg owner)
          (arg (. indicator axis))
          (arg (. event pointer-id))
          (arg offset)
        )
      )
    )
    (return true)
  )
  (fn-do _ clear-scroll-gesture _
    (= scroll-gesture-path null)
    (= magnify-gesture-path null)
    (call release-scroll-hover-hold)
  )
  (fn-do _ scroll-event-path (? PointerHitPath)
    (param event ScrollEvent)
    (let begins (or (== (. event phase) (. ScrollPhase began)) (== (. event phase) (. ScrollPhase may-begin))))
    (let is-phased (or (!= (. event phase) (. ScrollPhase none)) (!= (. event momentum-phase) (. ScrollPhase none))))
    (if (and is-phased (not begins) scroll-gesture-path (call (. scroll-gesture-path is-current)))
      (return scroll-gesture-path)
    )
    (if (and (not is-phased) scroll-hover-owner wheel-path (call (. wheel-path is-current)))
      (return wheel-path)
    )
    (if (and (not begins) scroll-hover-owner (. scroll-hover-owner is-input-visible))
      (let held (call (. scroll-hover-owner event-path)))
      (if (not is-phased)
        (= wheel-path held)
      )
      (return held)
    )
    (let hit (call pointer-hit-path (. event root-point)))
    (if (not scroll-hover-owner)
      (call update-hover hit)
    )
    (if begins
      (= scroll-gesture-path hit)
    )
    (if (not is-phased)
      (= wheel-path hit)
    )
    (return hit)
  )
  (fn-do _ consume-default-scroll _
    (param path PointerHitPath)
    (param event ScrollEvent)
    (let scale Length (if-expr (. event is-precise) 1 40))
    (let remaining (call Point (* (. event delta-x) scale) (* (. event delta-y) scale)))
    (let did-handle false)
    (let cause (. ScrollCause wheel))
    (if (!= (. event momentum-phase) (. ScrollPhase none))
      (= cause (. ScrollCause momentum))
      (else-if (. event is-precise)
        (= cause (. ScrollCause trackpad))
      )
    )
    (blank)
    (let is-spent false)
    (let scroller (? Box) null)
    (for (in frame (. path frames))
      (let box (call (of gc-object-from-pointer Box) (. frame owner)))
      (if is-spent
        (call (. box settle-scroll-phase) (. event phase) (. event momentum-phase))
        (else
          (let consumed (call (. box consume-scroll) remaining cause (. event phase) (. event momentum-phase)))
          (if (or (!= (. consumed actual x) 0) (!= (. consumed actual y) 0))
            (= did-handle true)
            (= scroller box)
          )
          (= remaining (. consumed remainder))
          (if (and (!= (. remaining x) 0) (call (. box stops-scroll-remainder) (. Orientation horizontal)))
            (= remaining (call Point 0 (. remaining y)))
            (= did-handle true)
          )
          (if (and (!= (. remaining y) 0) (call (. box stops-scroll-remainder) (. Orientation vertical)))
            (= remaining (call Point (. remaining x) 0))
            (= did-handle true)
          )
          (= is-spent (and (== (. remaining x) 0) (== (. remaining y) 0)))
        )
      )
    )
    (if scroller
      (call hold-scroll-hover scroller)
    )
    (return (or did-handle is-spent))
  )
  (fn-do _ hold-scroll-hover _
    (param scroller Box)
    (= scroll-hover-owner scroller)
    (if (!= (as hovered-box (? Pointer)) (as scroller Pointer))
      (call update-hover (call (. (call (. scroller event-path)) at-point) pointer-location))
    )
  )
  (fn-do _ extend-scroll-hover-hold _
    (= scroll-hover-deadline (call Deadline gui-scroll-hover-hold))
