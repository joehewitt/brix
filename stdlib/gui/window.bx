  (fn-do _ ensure-retained-surface _
    (param output-color-space Pointer)
    (let next-scale backing-scale)
    (let next-size viewport)
    (let recreate (not retained-surface))
    (= recreate (or recreate (!= retained-surface-size next-size)))
    (= recreate (or recreate (!= retained-surface-scale next-scale)))
    (= recreate (or recreate (!= retained-surface-color-space output-color-space)))
    (return-if false (if (not recreate)))
    (blank)
    (if retained-surface
      (call (. retained-surface close))
    )
    (= retained-surface (call RasterCanvas next-size next-scale window-background output-color-space))
    (= retained-surface-size next-size)
    (= retained-surface-scale next-scale)
    (= retained-surface-color-space output-color-space)
    (return true)
  )
  (fn-do _ window-background-changed _
    (call schedule-render)
  )
  (fn-do _ window-chrome-changed _
    (call sync-native-chrome)
    (call sync-appearance-tags)
    (call schedule-layout)
  )
  (fn-do _ sync-appearance-tags _
    (return-if (if (or is-closed (not (call style-live-attachment this)))))
    (let outer (call swap-markup-cause markup-cause-none))
    (finally
      (call swap-markup-cause outer)
    )
    (let resolved (if-expr (== appearance (. WindowAppearance system)) (call gui-system-appearance) appearance))
    (let is-dark (== resolved (. WindowAppearance dark)))
    (call set-theme-tag "dark" is-dark)
    (call set-theme-tag "light" (not is-dark))
    (let options (call gui-system-options))
    (call set-theme-tag "reduce-motion" (. options reduces-motion))
    (call set-theme-tag "high-contrast" (. options increases-contrast))
    (call set-theme-tag "reduce-transparency" (. options reduces-transparency))
    (call set-theme-tag "inactive" shows-inactive)
    (call set-theme-tag "retina" (>= backing-scale 2))
  )
  (fn-do _ window-title-changed _
    (return-if (if (not native)))
    (call C:brixGuiWindowSetTitle native title)
  )
  (fn-do _ sync-native-chrome _
    (return-if (if (not native)))
    (call C:brixGuiWindowSetKind native kind)
    (let offset (?? stoplight-offset (call Point 0 0)))
    (call C:brixGuiWindowSetChrome
      (block
        (arg (!! native))
        (arg titlebar-visible)
        (arg (!= stoplight-offset null))
        (arg (. offset x))
        (arg (. offset y))
        (arg effective-zoom)
      )
    )
    (= native-stoplight-edge (call C:brixGuiWindowGetStoplightEdge (!! native)))
    (call C:brixGuiWindowSetAllowsZoom (!! native) allows-zoom)
    (call C:brixGuiWindowSetAppearance (!! native) appearance)
