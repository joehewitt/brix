    (probe-count gui.gpu.maximum-frames-per-second (as (. renderer maximum-frames-per-second) U64))
    (probe-count gui.frame.gc-objects (- (call C:brixGCAllocatedObjectCount) frame-objects0))
    (probe-count gui.frame.gc-bytes (- (call C:brixGCRequestedByteCount) frame-bytes0))
    (return true)
  )
  (fn-do _ ensure-metal-window-renderer _
    (let scale backing-scale)
    (let clear window-background)
    (let view viewport)
    (if metal-renderer
      (let current metal-renderer)
      (let same-size (and (== (. current width) (. view width)) (== (. current height) (. view height))))
      (if (and same-size (== (. current scale) scale) (== (. current background) clear))
        (return true)
      )
      (let did-resize (call (. current resize) (. view width) (. view height) scale clear))
      (if did-resize
        (= metal-surface-reset true)
        (return true)
      )
    )
    (blank)
    (if retained-scene
      (call (. retained-scene close))
      (= retained-scene null)
    )
    (if metal-renderer
      (call (. metal-renderer detach-window) (!! native))
      (call (. (!! metal-renderer) close))
      (= metal-renderer null)
    )
    (blank)
    (probe-group + gui.gpu.renderer-create)
    (let candidate
      (call MetalOffscreenRenderer
        (block
          (arg (. view width))
          (arg (. view height))
          (arg scale)
          (arg clear)
          (arg true)
        )
      )
    )
    (probe-group - gui.gpu.renderer-create)
    (if (not (. candidate is-available))
      (= metal-fallback-reason "Metal renderer unavailable")
      (call (. candidate close))
      (= selected-metal false)
      (probe-count gui.gpu.metal-window-fallback)
      (return false)
    )
    (if (not (call (. candidate attach-window) (!! native)))
      (let attach-status (. candidate attach-status))
      (= metal-fallback-reason
        (match attach-status
          (case= -3
            "Metal presentation view has no CAMetalLayer"
          )
          (case= -4
            "AppKit rejected the presentation CAMetalLayer"
          )
          (default
            (str "CAMetalLayer attachment failed (" attach-status ")")
          )
        )
      )
      (call (. candidate close))
      (= selected-metal false)
      (probe-count gui.gpu.metal-window-fallback)
      (return false)
    )
    (= metal-renderer candidate)
    (= metal-surface-reset true)
    (= metal-fallback-reason "")
    (return true)
  )
  (fn-do _ disable-metal-window-renderer _
    (if retained-scene
      (call (. retained-scene close))
      (= retained-scene null)
    )
    (if metal-renderer
      (call (. metal-renderer detach-window) (!! native))
      (call (. (!! metal-renderer) close))
      (= metal-renderer null)
    )
    (= selected-metal false)
    (= metal-surface-reset false)
    (probe-count gui.gpu.metal-window-fallback)
  )
  (fn-do _ render-retained _
    (param output-color-space Pointer)
    (param popup-fills LiveFillState)
    (probe gui.frame.gc-objects (let frame-objects0 (call C:brixGCAllocatedObjectCount)))
    (probe gui.frame.gc-bytes (let frame-bytes0 (call C:brixGCRequestedByteCount)))
