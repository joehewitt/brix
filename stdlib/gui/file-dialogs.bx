(import ./window)
(import /BxAppleGUI/BxFileDialog.h)
(import /core/intrinsics)
(import /os/path)

(fn-do + choose-save-path (? Path)
  (param window (? Window))
  (param name _ (= ""))
  (param types (list String) (= (call (of List String))))
  (param directory (? Path) (= null))
  (param message _ (= ""))
  (param prompt _ (= ""))
  (let completion (call (of Completion (of List Path))))
  (let dialog
    (call C:brixFileDialogSave
      (block
        (arg (call file-dialog-anchor window))
        (arg name)
        (arg (call file-dialog-types types))
        (arg (. types length))
        (arg (call file-dialog-directory directory))
        (arg message)
        (arg prompt)
        (arg (as file-dialog-finished FileDialogCallback))
        (arg (as completion Pointer))
      )
    )
  )
  (finally
    (inline (call C:brixFileDialogRelease dialog))
  )
  (let chosen (?? (call (. completion await)) (call (of List Path))))
  (return (only-if ([] chosen 0) (if (. chosen length))))
)

(fn-do + choose-open-paths (list Path)
  (param window (? Window))
  (param types (list String) (= (call (of List String))))
  (param directory (? Path) (= null))
  (param allows-multiple _ (= false))
  (param chooses-files _ (= true))
  (param chooses-directories _ (= false))
  (param message _ (= ""))
  (param prompt _ (= ""))
  (let completion (call (of Completion (of List Path))))
  (let dialog
    (call C:brixFileDialogOpen
      (block
        (arg (call file-dialog-anchor window))
        (arg (call file-dialog-types types))
        (arg (. types length))
        (arg (call file-dialog-directory directory))
        (arg allows-multiple)
        (arg chooses-files)
        (arg chooses-directories)
        (arg message)
        (arg prompt)
        (arg (as file-dialog-finished FileDialogCallback))
        (arg (as completion Pointer))
      )
    )
  )
  (finally
    (inline (call C:brixFileDialogRelease dialog))
  )
  (return (?? (call (. completion await)) (call (of List Path))))
)

(fn-do + choose-open-path (? Path)
  (param window (? Window))
  (param types (list String) (= (call (of List String))))
  (param directory (? Path) (= null))
  (param chooses-files _ (= true))
  (param chooses-directories _ (= false))
  (param message _ (= ""))
  (param prompt _ (= ""))
  (let chosen
    (call choose-open-paths
      (block
        (arg window)
        (arg types)
        (arg directory)
        (arg false)
        (arg chooses-files)
        (arg chooses-directories)
        (arg message)
        (arg prompt)
      )
    )
  )
  (return (only-if ([] chosen 0) (if (. chosen length))))
)

(type + FileDialogCallback (is (c-fn-type Void (param request-pointer Pointer) (param paths (of CPointer (of CPointer Char8))) (param count I32))))

(fn-do _ file-dialog-anchor Pointer
  (param window (? Window))
  (return-if (call Pointer) (if (not window)))
  (call (. window ensure-native))
  (return (?? (. window native) (call Pointer)))
)

(fn-do _ file-dialog-types ([] String)
  (param types (list String))
  (let kinds ([] String (. types length)))
  (for (in index (..< 0 (. types length)))
    (= ([] kinds index) ([] types index))
  )
  (return kinds)
)

(fn-expr _ file-dialog-directory String
  (param directory (? Path))
  (if-expr directory (as directory String) "")
)

(fn-do _ file-dialog-finished _
  (param request-pointer Pointer)
  (param paths (of CPointer (of CPointer Char8)))
  (param count I32)
  (let completion (call (of gc-object-from-pointer (of Completion (of List Path))) request-pointer))
  (let chosen (call (of List Path)))
  (for (in index (..< 0 count))
    (+= chosen (call Path ([] paths index) 0))
  )
  (call (. completion finish) chosen)
)
