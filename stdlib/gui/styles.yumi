+ GUIBoxPaint is Style

+ background-color RGBA? = null
+ background-fill ShaderFill? = null
+ background Painter? = null
+ background-image Image? = null
+ background-fit = ImageFit.none
+ background-align-x = AnchorPoint.center
+ background-align-y = AnchorPoint.center
+ background-repeat = ImageRepeat.none
+ background-sampling = ImageSampling.smooth
+ border BorderPainter = DefaultBorderPainter()
+ border-color RGBA? = null
+ border-fill ShaderFill? = null
+ border-width Length = 0
+ border-top-width Length?
+ border-right-width Length?
+ border-bottom-width Length?
+ border-left-width Length?
+ corner-radius Length = 0
+ shape BoxShape? = null
+ shadow Shadow? = null
+ backdrop-blur Length? = null
+ backdrop ShaderBackdrop? = null
+ filters [ShaderFilter]
+ mask ShaderMask? = null
+ window-material WindowMaterial? = null
+ caches-raster = false

. background-color -> paint
. background-fill -> paint
. background -> paint
. background-image -> paint
. background-fit -> paint
. background-align-x -> paint
. background-align-y -> paint
. background-repeat -> paint
. background-sampling -> paint
. border -> layout, layout on parent, paint
. border-color -> paint
. border-fill -> paint
. border-width -> layout, layout on parent, paint
. border-top-width -> layout, layout on parent, paint
. border-right-width -> layout, layout on parent, paint
. border-bottom-width -> layout, layout on parent, paint
. border-left-width -> layout, layout on parent, paint
. corner-radius -> paint
. shape -> paint
. shadow -> paint
. backdrop-blur -> paint
. backdrop -> paint
. filters -> composite, paint
. mask -> composite, paint
. window-material -> paint
. caches-raster -> paint

