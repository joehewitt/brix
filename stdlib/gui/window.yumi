+ window-stoplight-offset = Point(8, 7)
+ window-stoplight-center Length = 14
+ window-stoplight-inset Length = 80
_ window-stoplight-gap Length = 11
+ window-full-screen-inset Length = 8
+ window-sidebar-toggle-width Length = 34
+ window-sidebar-toggle-inset Length = window-stoplight-inset + window-sidebar-toggle-width
+ window-full-screen-sidebar-toggle-inset Length = window-full-screen-inset + window-sidebar-toggle-width
+ window-zoom-levels [F64] = [0.5, 2.0 / 3.0, 0.75, 0.8, 0.9, 1.0, 1.1, 1.25, 1.5, 1.75, 2.0]
_ window-zoom-tolerance F64 = 0.001
_ window-zoom-in-keys = [KeyModifier.command + "=", KeyModifier.command + "+"]
_ window-zoom-out-keys = [KeyModifier.command + "-"]
_ window-actual-size-keys = [KeyModifier.command + "0"]

_ PointerCapture is (path PointerHitPath, pointer-id U64, button PointerButton, click-count U32)
_ TouchCapture is (path PointerHitPath, point Point)
_ ScrollIndicatorHit is (owner Box, axis Orientation)
_ IndicatorCapture is (route PointerHitPath, owner Box, axis Orientation, id U64, offset Length)

