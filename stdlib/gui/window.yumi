────────────────────
whenever #position

save-frame()

────────────────────
whenever #size

save-frame()

────────────────────
_ do restore-frame

. key = state-key
. store = app?.state
=? if !key || !store
. saved = store.read("window:${key}", 1)
=? if !saved
. frame = catch? JSONReader("window", saved).object()
=? if !frame
. x = catch? frame["x"].number()
. y = catch? frame["y"].number()
. width = catch? frame["width"].number()
. height = catch? frame["height"].number()
=? if x == null || y == null || width == null || height == null
=? if width < 1 || height < 1
size = Dimensions(width, height)
position = Point(x, y)
. saved-zoom = catch? frame["zoom"].number()
if allows-zoom && saved-zoom && saved-zoom > 0
    zoom = saved-zoom

────────────────────
_ do save-frame

. key = state-key
. store = app?.state
=? if !key || !store || is-closed
if !position
    accept-native-position()
. placed = position
=? if !placed
. frame = Map'String'JSON
    • "x" placed.x as F64
    • "y" placed.y as F64
    • "width" size.width as F64
    • "height" size.height as F64
    • "zoom" effective-zoom
store.write("window:${key}", 1, frame)

────────────────────
+ do open

?! Panic("A closed window cannot be opened again")
    if is-finished
is-closed = false
restore-frame()
ensure-native()
app?.ensure-accents()
render-opening-frame()
if native
    C:yumiGuiWindowShow(native)
has-opened = true

────────────────────
_ do render-opening-frame

. frame = use frame-scope

markup-mount-root(markup-root, markup-root)
markup-mount-root(this, markup-root)
sync-appearance-tags()
catch markup-root.markup-batch-queue.checkpoint()
settle-popup-focus()
settle-pending-focus()

. passes = 0
while needs-layout && passes < 8
    needs-layout = false
    layout()
    catch markup-root.markup-batch-queue.checkpoint()
    passes += 1
is-render-invalid = false
frame.committed = render()

────────────────────
+ do bring-to-front

if native && !is-closed
    C:yumiGuiWindowShow(native)

────────────────────
+ do close

=? if is-finished
is-finished = true
=? if is-closed
settle-pointer-dispatch()
if native
    C:yumiGuiWindowClose(native)
finish-close()
super.close()
markup-root.close()

────────────────────
+ do request-close

=? true if is-closed
=? false if is-closing || !confirm-close()
close()
= true

────────────────────
+ do accept-native-close-request

=? if request-close()
if native
    C:yumiGuiWindowRejectDeferredClose(native)

────────────────────
_ do confirm-close

settle-pointer-dispatch()
is-closing = true
. event = ClosingEvent()
closing <- event
settle-pointer-dispatch()
is-closing = false
= !event.is-canceled

────────────────────
_ do finish-close

is-closed = true
is-active = false
window-clock.finish-all()
finish-drag(false)
clear-hover()
clear-pointer-capture()
clear-scroll-gesture()
clear-focus-state(true)
pending-focus-box = null
pending-popup-focus = null
remembered-focus-box = null
for popup in popups
    popup.release-presentation()
popups.clear()
modal-popup = null
is-render-invalid = false
is-frame-scheduled = false
is-rendering = false
needs-layout = false

if native
    C:yumiGuiWindowCancelFrame(native)

markup-release(this)
markup-release(markup-root)
vector-geometry-table.evict-unused()
if retained-scene
    retained-scene.close()
    retained-scene = null
if metal-renderer
    if native
        metal-renderer.detach-window(native)
    metal-renderer!.close()
    metal-renderer = null
if retained-surface
    retained-surface.close()
    retained-surface = null

if native
    . closing-native = native
    native = null
    C:yumiGuiWindowRelease(closing-native)

closed <- ClosedEvent()

────────────────────
+ do render

=? false if is-closed
ensure-native()
=? false if !native

. output-color-space = C:yumiGuiWindowGetDisplayColorSpace(native)
for popup in popups
    popup.ensure-presentation(native!)
catch-up-live-fills()
. popup-fills = render-popups(output-color-space)
. rendered = render-main(output-color-space, popup-fills)
sync-native-transparency()
= rendered

────────────────────
+ do prepare-frame

=? if is-closed || !native
catch markup-root.markup-batch-queue.checkpoint()
if needs-layout
    needs-layout = false
    layout()
. renderer = metal-renderer
. scene = retained-scene
=? if !renderer || !scene
scene.maintain(this, renderer.scale, window-background)

────────────────────
_ get has-transparent-background Bool

window-material-count > 0 || has-clear-background

────────────────────
_ get has-clear-background Bool

window-background.alpha < 1

────────────────────
_ get window-background RGBA

background ?? $gui-window-color

────────────────────
_ do sync-native-transparency

. transparent = has-transparent-background
. clear = has-clear-background
=? if native-transparency-known && transparent == native-transparent && clear == native-clear
native-transparent = transparent
native-clear = clear
native-transparency-known = true
C:yumiGuiWindowSetTransparent(native!, clear, transparent)

────────────────────
_ do render-main Bool
    - output-color-space Pointer
    - popup-fills LiveFillState

if selected-metal
    . did-render-metal = render-metal(popup-fills)
    =? did-render-metal if selected-metal
= render-retained(output-color-space, popup-fills)

────────────────────
_ do render-metal
    - popup-fills LiveFillState

=? false if !ensure-metal-window-renderer()
. renderer = metal-renderer!

//!gui.frame.gc-objects . frame-objects0 = C:yumiGCAllocatedObjectCount()
//!gui.frame.gc-bytes . frame-bytes0 = C:yumiGCRequestedByteCount()

//+gui.frame.phase.sync
sync-native-geometry-if-changed()
//-gui.frame.phase.sync
sync-native-transparency()
. wide = use-wide-gamut && C:yumiGuiWindowDisplayIsWideGamut(native!)
if renderer.set-output-gamut(wide, !has-transparent-background)
    metal-surface-reset = true

//+gui.frame.phase.paint
if !retained-scene
    retained-scene = DisplayScene(renderer.scale, window-background, renderer)
. scene = retained-scene!
scene.set-live-time(live-fills.seconds)
scene.maintain(this, renderer.scale, window-background)
sync-native-geometry-if-registry-changed()
. fill-redraw = renderer.take-fill-redraw()
if metal-surface-reset || fill-redraw
    scene.add-damage(Rect(viewport))
scene.damage-pending-textures()
sync-live-fills
    - merged-live-fills
        - scene.damage-live-chunks(Rect(viewport), live-fills.is-pending)
        - popup-fills
live-fills.is-pending = false
renderer.set-fill-time(live-fills.seconds)
metal-surface-reset = false
. did-encode = scene.frame-metal(renderer)
//-gui.frame.phase.paint

if !did-encode && scene.has-damage
    metal-fallback-reason = "Metal frame packet failed"
    disable-metal-window-renderer()
    = false

metal-fallback-reason = ""
is-fill-pending = renderer.has-pending-fill-frames
if scene.has-pending-textures
    is-render-invalid = true

mark-painted()
=? false if !did-encode

//+gui.frame.phase.commit
C:yumiGuiWindowCommitMetalFrame(native!)
//-gui.frame.phase.commit
//gui.gpu.drawable-wait-nanos += renderer.drawable-wait-nanos
//gui.gpu.presents += 1
//gui.gpu.present-copied-pixels += renderer.take-present-copied-pixels()
//gui.gpu.maximum-frames-per-second += renderer.maximum-frames-per-second as U64
//gui.frame.gc-objects += C:yumiGCAllocatedObjectCount() - frame-objects0
//gui.frame.gc-bytes += C:yumiGCRequestedByteCount() - frame-bytes0
= true

────────────────────
_ do ensure-metal-window-renderer

. scale = backing-scale
. clear = window-background
. view = viewport
if metal-renderer
    . current = metal-renderer
    . same-size = current.width == view.width && current.height == view.height
    if same-size && current.scale == scale && current.background == clear
        = true
    . did-resize = current.resize(view.width, view.height, scale, clear)
    if did-resize
        metal-surface-reset = true
        = true

if retained-scene
    retained-scene.close()
    retained-scene = null
if metal-renderer
    metal-renderer.detach-window(native!)
    metal-renderer!.close()
    metal-renderer = null

//+gui.gpu.renderer-create
. candidate = MetalOffscreenRenderer
    - view.width
    - view.height
    - scale
    - clear
    - true
//-gui.gpu.renderer-create
if !candidate.is-available
    metal-fallback-reason = "Metal renderer unavailable"
    candidate.close()
    selected-metal = false
    //gui.gpu.metal-window-fallback ++
    = false
if !candidate.attach-window(native!)
    . attach-status = candidate.attach-status
    metal-fallback-reason = match attach-status
        |= -3
            "Metal presentation view has no CAMetalLayer"
        |= -4
            "AppKit rejected the presentation CAMetalLayer"
        ??
            "CAMetalLayer attachment failed ($attach-status)"
    candidate.close()
    selected-metal = false
    //gui.gpu.metal-window-fallback ++
    = false
metal-renderer = candidate
metal-surface-reset = true
metal-fallback-reason = ""
= true

────────────────────
_ do disable-metal-window-renderer

if retained-scene
    retained-scene.close()
    retained-scene = null
if metal-renderer
    metal-renderer.detach-window(native!)
    metal-renderer!.close()
    metal-renderer = null
selected-metal = false
metal-surface-reset = false
//gui.gpu.metal-window-fallback ++

────────────────────
_ do render-retained
    - output-color-space Pointer
    - popup-fills LiveFillState

//!gui.frame.gc-objects . frame-objects0 = C:yumiGCAllocatedObjectCount()
//!gui.frame.gc-bytes . frame-bytes0 = C:yumiGCRequestedByteCount()
//+gui.frame.phase.create
. surface-recreated = ensure-retained-surface(output-color-space)
//-gui.frame.phase.create
. surface = retained-surface!

//+gui.frame.phase.sync
sync-native-geometry-if-changed()
//-gui.frame.phase.sync
sync-native-transparency()

//+gui.frame.phase.paint
if !retained-scene
    retained-scene = DisplayScene(surface.scale, window-background)
. scene = retained-scene!
scene.set-live-time(live-fills.seconds)
scene.maintain(this, surface.scale, window-background)
sync-native-geometry-if-registry-changed()
if surface-recreated
    scene.add-damage(Rect(viewport))
sync-live-fills
    - merged-live-fills
        - scene.damage-live-chunks(Rect(viewport), live-fills.is-pending)
        - popup-fills
live-fills.is-pending = false
. replay-count = scene.frames-replayed
scene.frame(surface)
. did-replay = scene.frames-replayed != replay-count
//-gui.frame.phase.paint

mark-painted()
=? false if !did-replay

//+gui.frame.phase.commit
. presented = scene.last-frame-damage
C:yumiGuiWindowCommitFrame
    - native!
    - surface.native
    - presented.x
    - presented.y
    - presented.width
    - presented.height
//-gui.frame.phase.commit
//gui.frame.gc-objects += C:yumiGCAllocatedObjectCount() - frame-objects0
//gui.frame.gc-bytes += C:yumiGCRequestedByteCount() - frame-bytes0
= true

────────────────────
_ do ensure-retained-surface
    - output-color-space Pointer

. next-scale = backing-scale
. next-size = viewport
. recreate = !retained-surface
recreate = recreate || retained-surface-size != next-size
recreate = recreate || retained-surface-scale != next-scale
recreate = recreate || retained-surface-color-space != output-color-space
=? false if !recreate

if retained-surface
    retained-surface.close()
retained-surface = RasterCanvas(next-size, next-scale, window-background, output-color-space)
retained-surface-size = next-size
retained-surface-scale = next-scale
retained-surface-color-space = output-color-space
= true

────────────────────
+ do paint
    - canvas Canvas

if !retained-scene
    retained-scene = DisplayScene(canvas.scale, window-background)
retained-scene!.maintain(this, canvas.scale, window-background)
super.paint(canvas)

────────────────────
_ do window-background-changed

schedule-render()

