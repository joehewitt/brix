. owners-changed = validate-pointer-owners()
. focus-changed = validate-focus-owner()
if owners-changed || focus-changed
    catch markup-root.markup-batch-queue.checkpoint()
    settle-pending-focus()
    if needs-layout
        needs-layout = false
        layout()
settle-focus-home()
settle-drag-ghost()
settle-cursor-resolution()
sync-undo-state()

