+ native-menu-bar Pointer?
+ native-window-handle => native
+ last-frame-target-time Nanoseconds = 0ns
+ last-frame-refresh-interval Nanoseconds = 0ns
+ window-clock := FrameClock(this)
+ previous-window Window?
+ next-window Window?
+ is-window-root => true
+ is-active = false
+ has-opened = false
+ admits-entering => has-opened && entering-hush == 0 && !scope-stills(current-markup-cause())
+ admits-leaving => has-opened && !scope-stills(current-markup-cause())
