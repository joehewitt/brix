━━━━━━━━━━━━━━━━━━━━
+ do gui-window-pointer-event
    - window-pointer Pointer
    - event-kind U32
    - pointer-id U64
    - device-kind U32
    - button U32
    - buttons U64
    - modifier-bits U64
    - x F64
    - y F64
    - delta-x F64
    - delta-y F64
    - ordering-time F64
    - click-count U32
    - is-precise Bool
    - phase U64
    - momentum-phase U64
    - window-drag-token U64 = 0

. window = gc-object-from-pointer'Window(window-pointer)
window.accept-pointer-record
    - PointerRecord
        - event-kind as PointerRecordKind
        - Point(x, y)
        - Point(delta-x, delta-y)
        - pointer-id
        - device-kind
        - button
        - buttons
        - modifier-bits
        - ordering-time
        - click-count
        - is-precise
        - phase
        - momentum-phase
        - window-drag-token

━━━━━━━━━━━━━━━━━━━━
+ do gui-window-touch-event
    - window-pointer Pointer
    - phase U32
    - touch-id U64
    - x F64
    - y F64
    - ordering-time F64
    - tap-count U32
    - radius F64

. window = gc-object-from-pointer'Window(window-pointer)
. data = PointerEventData
    - Point(x, y)
    - touch-id
    - PointerDeviceKind.touch
    - PointerModifiers()
    - 0
    - ordering-time
window.accept-touch(data, phase as TouchPhase, tap-count, radius)

━━━━━━━━━━━━━━━━━━━━
+ do gui-window-native-event
    - window-pointer Pointer
    - event-kind U32
    - key-kind U32
    - native-key-code U32
    - modifier-bits U64
    - is-repeat Bool
    - text-pointer CPointer'Char8

. text = text-pointer as String
. window = gc-object-from-pointer'Window(window-pointer)
do match? event-kind as NativeWindowEventKind
    |= NativeWindowEventKind.key-press
        . event = KeyPressEvent
            - key-from-native(key-kind, native-key-code)
            - pointer-modifiers-from-native(modifier-bits)
            - is-repeat
            - native-key-code
            - text
        window.dispatch-key-press(event)
    |= NativeWindowEventKind.activated
        window.accept-window-activated()
    |= NativeWindowEventKind.deactivated
        window.accept-window-deactivated()
    |= NativeWindowEventKind.close-request
        window.accept-native-close-request()
            catch error Error
                unhandled-error(error)
    |= NativeWindowEventKind.closed
        window.close()
            catch error Error
                unhandled-error(error)
    |= NativeWindowEventKind.modifiers-changed
        window.dispatch-modifiers-changed(pointer-modifiers-from-native(modifier-bits))
    |= NativeWindowEventKind.key-release
        . event = KeyReleaseEvent
            - key-from-native(key-kind, native-key-code)
            - pointer-modifiers-from-native(modifier-bits)
            - native-key-code
            - text
        window.dispatch-key-release(event)
    |= NativeWindowEventKind.unoccluded
        window.accept-window-unoccluded()
    |= NativeWindowEventKind.entered-full-screen
        window.is-full-screen = true
    |= NativeWindowEventKind.exited-full-screen
        window.is-full-screen = false
    |= NativeWindowEventKind.zoom-in
        if window.allows-zoom
            window.zoom-in()
    |= NativeWindowEventKind.zoom-out
        if window.allows-zoom
            window.zoom-out()
    |= NativeWindowEventKind.actual-size
        if window.allows-zoom
            window.zoom-to-actual-size()

━━━━━━━━━━━━━━━━━━━━
+ do gui-window-text-action
    - window-pointer Pointer
    - action-kind U32
    - text-pointer CPointer'Char8
    - start U32
    - length U32
    - keyed Bool

. window = gc-object-from-pointer'Window(window-pointer)
window.accept-text-action(action-kind as NativeTextActionKind, text-pointer, start, length, keyed)

━━━━━━━━━━━━━━━━━━━━
+ WindowFrame
    is Usable'Void

_ window Window
+ committed = false

────────────────────
+ This
    - window

────────────────────
+ do begin-using

committed = false
window.begin-frame()
= this

────────────────────
+ do end-using

window.end-frame(committed)
