        if popup-supersedes(popup, other) && !supersedes-parent(popup, other)
            other.dismiss(DismissReason.superseded)
popup.remember-return-focus(focused-box)
if pointer-capture
    popup.opened-by-press = true
popups += popup
refresh-modal-popup()
refresh-popup-holds()
if popup.$popup-focus == PopupFocus.first
