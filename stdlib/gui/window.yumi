────────────────────
_ do place-popup
    - popup Popup
    - boundary Rect

. anchor = popup.anchor-rect(this)
. request = PlacementRequest
    - popup
    - anchor
    - boundary
    - bounds
    - pointer-location
    - popup.placement-focus
. placement = popup.$placement ?? popup.default-placement
. result = placement.place(request)
popup.accept-placement(result, anchor)
. placed = result.bounds
. width = ceil(placed.width)
. height = ceil(placed.height)
. x = if result.side == Side.left then floor(placed.right) - width else round(placed.x)
. y = if result.side == Side.top then floor(placed.bottom) - height else round(placed.y)
popup.arrange-bounds(Rect(x, y, width, height))
popup.update-layout()

