────────────────────
+ do system-changed
    - restyles Bool

=? if is-closed
sync-appearance-tags()
if restyles
    restyle-themes()
schedule-layout()

────────────────────
_ do sync-appearance-tags

=? if is-closed || !style-live-attachment(this)
. outer = swap-markup-cause(markup-cause-none)
do finally
    swap-markup-cause(outer)
. resolved = if appearance == WindowAppearance.system then gui-system-appearance() else appearance
. is-dark = resolved == WindowAppearance.dark
set-theme-tag("dark", is-dark)
set-theme-tag("light", !is-dark)
. options = gui-system-options()
set-theme-tag("reduce-motion", options.reduces-motion)
set-theme-tag("high-contrast", options.increases-contrast)
set-theme-tag("reduce-transparency", options.reduces-transparency)
set-theme-tag("inactive", shows-inactive)
set-theme-tag("retina", backing-scale >= 2)

────────────────────
_ do window-title-changed

=? if !native
C:yumiGuiWindowSetTitle(native, title)

────────────────────
_ do sync-native-chrome

=? if !native
C:yumiGuiWindowSetKind(native, kind)
. offset = stoplight-offset ?? Point(0, 0)
C:yumiGuiWindowSetChrome
    - native!
    - titlebar-visible
    - stoplight-offset != null
    - offset.x
    - offset.y
    - effective-zoom
native-stoplight-edge = C:yumiGuiWindowGetStoplightEdge(native!)
C:yumiGuiWindowSetAllowsZoom(native!, allows-zoom)
C:yumiGuiWindowSetAppearance(native!, appearance)

────────────────────
+ do schedule-render

=? if is-closed

is-render-invalid = true
request-render-frame()

────────────────────
_ do sync-live-fills
    - state LiveFillState

if !state.is-visible
    window-clock.cancel(live-fills)
    rest-live-fills(state.wake-at)
    =
