if pointer-capture && pointer-capture.path.target.is-within(subtree)
    clear-pointer-capture()
if scroll-indicator-capture && scroll-indicator-capture.owner.is-within(subtree)
    clear-pointer-capture()
if scroll-gesture-path && scroll-gesture-path.target.is-within(subtree)
    clear-scroll-gesture()
if scroll-hover-owner && scroll-hover-owner.is-within(subtree)
    release-scroll-hover-hold()
cursor-resolution-invalid = true

