────────────────────
_ do finish-scroll-event
    - event ScrollEvent

. direct-cancel = event.phase == ScrollPhase.cancelled
. momentum-finished = event.momentum-phase == ScrollPhase.ended
momentum-finished = momentum-finished || event.momentum-phase == ScrollPhase.cancelled
if direct-cancel || momentum-finished
