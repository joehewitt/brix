    owner-window.accept-cursor-style-changes()
owner-window.settle-pending-focus()

━━━━━━━━━━━━━━━━━━━━
_ window-commands
    - command-nodes [CommandNode]
    - shortcuts [KeyShortcut]

** command-nodes
*> each as Command
**
    ** shortcuts
    ?> each.title && each.discoverable
    *> each as Command
|> List

