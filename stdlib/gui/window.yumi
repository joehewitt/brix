. queue = ensure-visible-queue
if queue && queue.pending && queue.pending.is-within(subtree)
    queue.pending = null
for popup in popups
    . restore = popup.take-return-focus()
    if restore && !restore.is-within(subtree)
        popup.remember-return-focus(restore)
for popup in List'Popup(popups)
    . anchor = popup.anchor-box
    if popup.is-within(subtree) || (anchor != null && anchor.is-within(subtree))
        popup.dismiss(DismissReason.anchor-hidden)
if hovered-box && hovered-box.is-within(subtree)
    clear-hover()
