. live-capture = pointer-capture
. is-live-pointer = live-capture != null && live-capture.pointer-id == event.pointer-id
. is-primary = is-live-pointer && live-capture!.button == PointerButton.primary
. is-release-target = hit != null && is-live-pointer && hit.target == live-capture!.path.target
. is-current-target = is-release-target && live-capture!.path.is-current()
. is-completed = !event.is-canceled && !event.is-interrupted
. should-click = is-completed && is-primary && is-current-target
if should-click
    . click = ClickEvent(event.data, live-capture!.button, live-capture!.click-count)
    live-capture!.path.at-point(event.root-point).publish(click)
else if is-live-pointer && hit && is-completed
    release-into-press-popup(hit, event)
if is-live-pointer
    for popup in popups
        popup.opened-by-press = false

if is-matching-capture
    clear-pointer-capture()
settle-pointer-dispatch()

────────────────────
+ do dispatch-pointer-event
    - event PointerDragEvent

=? if !prepare-pointer-dispatch()

accept-pointer-location(event.root-point)
invalidate-pointer-placement()
. dragging = drag-session
if dragging
    dragging.sample(event.root-point, event.ordering-time)
    advance-drag(event.root-point, event.modifiers)
    settle-pointer-dispatch()
    =
. indicator-capture = scroll-indicator-capture
. matches-indicator = indicator-capture != null
matches-indicator = matches-indicator && indicator-capture!.id == event.pointer-id
if matches-indicator && indicator-capture!.route.is-current()
    update-hover(indicator-capture!.route.at-point(event.root-point))
    indicator-capture!.owner.scroll-indicator-scroll-to-point
        - indicator-capture!.axis
        - event.root-point
        - indicator-capture!.offset
    settle-pointer-dispatch()
    =
else if matches-indicator
    clear-pointer-capture()

. capture = pointer-capture
. is-matching-pointer = capture != null && capture.pointer-id == event.pointer-id
. is-matching-capture = is-matching-pointer && capture!.button == event.button
if is-matching-capture && offer-drag(capture!, event)
    settle-pointer-dispatch()
    =
. hit = pointer-hit-path(event.root-point)
update-hover(hit)
. drag-path = if is-matching-capture then capture!.path.at-point(event.root-point) else hit
drag-path?.publish(event)
settle-pointer-dispatch()

────────────────────
+ do cancel-drag

=? if !prepare-pointer-dispatch()
finish-drag(false)
settle-pointer-dispatch()

────────────────────
+ do step-drag-scroll

. session = drag-session
=? false if !session
. delta = drag-scroll-delta(session)
. scroller = session.scroller
=? false if delta == 0 || !scroller
. resting = scroller.scroll-y
scroller.scroll-by(Point(0, delta))
=? false if scroller.scroll-y == resting
advance-drag(session.point, session.modifiers)
settle-pointer-dispatch()
= true

────────────────────
_ do offer-drag
    - capture PointerCapture
    - event PointerDragEvent

=? false if is-drag-offered || capture.button != PointerButton.primary
=? false if press-origin.distance(event.root-point) < drag-start-distance
is-drag-offered = true
. data = PointerEventData
    - press-origin
    - event.pointer-id
    - event.device-kind
    - event.modifiers
    - event.buttons
    - event.ordering-time
. offer = DragStartEvent(data, event.root-point)
capture.path.at-point(press-origin).publish-drag-start(offer)
. exported = offer.exported
=? begin-export-drag(exported) if exported
. session = offer.session
=? false if !session
session.sample(event.root-point, event.ordering-time)
begin-drag(session)
= true

────────────────────
_ do begin-export-drag Bool
    - exported DragExport

=? false if !native
. frame = exported.frame
. wide = max(1.0, ceil(frame.width * backing-scale))
. tall = max(1.0, ceil(frame.height * backing-scale))
. picture = use RasterCanvas(wide as I32, tall as I32)
exported.image.draw(picture, Rect(0, 0, wide, tall))
. writer = clipboard-writer(exported.items)
=? false if writer == Pointer()
do finally C:yumiGuiClipboardWriterRelease(writer)
. zoom = effective-zoom
. dragged = Rect(frame.x * zoom, frame.y * zoom, frame.width * zoom, frame.height * zoom)
=? false if !C:yumiGuiWindowBeginExportDrag(native, writer, picture.native, dragged.x, dragged.y, dragged.width, dragged.height)
clear-pointer-capture()
clear-scroll-gesture()
clear-hover()
= true

────────────────────
+ do dispatch-external-drag
    - payload ClipboardDrag
    - data PointerEventData

=? if !prepare-pointer-dispatch()
. session = drag-session
if session && session.source
    settle-pointer-dispatch()
    =
. current = session.payload as ClipboardDrag if session && session.payload is ClipboardDrag
if current && current.sequence == payload.sequence
    advance-drag(data.root-point, data.modifiers)
else
    //gui.drop// begin external ${payload.sequence} at ${data.root-point}
    if session
        finish-drag(false)
    begin-drag
        - DragSession
            - payload
            - null
            - data.root-point
            - data.root-point
            - data.modifiers
            - payload.sequence
settle-pointer-dispatch()

────────────────────
_ do accept-external-drag
    - data PointerEventData

. name = C:yumiGuiWindowDropPasteboardName(native) if native
=? if !name
dispatch-external-drag(ClipboardDrag(Clipboard(name), data.pointer-id), data)

────────────────────
+ do finish-external-drag
    - data PointerEventData
    - dropped Bool

=? if !prepare-pointer-dispatch()
. session = drag-session
//gui.drop// finish external dropped $dropped session ${session != null} at ${data.root-point}
if session && !session.source
    if dropped
        advance-drag(data.root-point, data.modifiers)
    finish-drag(dropped)
settle-pointer-dispatch()

────────────────────
_ do begin-drag
    - session DragSession

drag-session = session
clear-pointer-capture()
clear-scroll-gesture()
clear-hover()
if session.carried.length > 0
    begin-carry(session)
else
    . pictured = session.pending-snapshot
    if pictured && pictured.is-paint-visible
        capture-drag-ghost(session)
advance-drag(session.point, session.modifiers)

────────────────────
_ do begin-carry
    - session DragSession

session.pending-snapshot = null
. lead = session.carried[0]
. at = lead.lifted-frame.top-left
session.grab = Point(session.origin.x - at.x, session.origin.y - at.y)
lead.begin-carry(at, null, Point(0, 0))
. count = session.carried.length
for index in 1 .. < count
    . follower = session.carried[index]
    . step = (min(index, drag-stack-depth) as Length) * drag-stack-step
    follower.begin-carry(follower.lifted-frame.top-left, lead, Point(step, step))
. index = count
while index > 0
    index -= 1
    session.carried[index].lift()

────────────────────
_ do capture-drag-ghost
    - session DragSession

. box = session.pending-snapshot
session.pending-snapshot = null
=? if !box
. frame = box.ink-frame
. shown = box.presentation-rect(frame)
. size = Dimensions(max(1, ceil(frame.width)), max(1, ceil(frame.height)))
. held = Point(session.origin.x - shown.x, session.origin.y - shown.y)
. resting = Point(min(12, size.width / 2), size.height / 2)
. placed = if box.is-paint-visible then held else resting
. grab = session.grab ?? placed
. backdrop = box.backdrop-color if box.is-paint-visible
. ghost = DragGhost(box.snapshot(backing-scale, backdrop), size, grab, Point(0, 0))
ghost.follow(session.point)
session.ghost = ghost
if !native
    invalidate-paint()

────────────────────
_ do advance-drag
    - point Point
    - modifiers PointerModifiers

. session = drag-session
=? if !session
session.point = point
session.modifiers = modifiers
session.ghost?.follow(point)
follow-carried(session)
. data = PointerEventData(point, session.pointer-id, PointerDeviceKind.mouse, modifiers)
. asked = DragOverEvent(data, session)
pointer-hit-path(point)?.publish-drag-over(asked)
. previous = session.target
. next = asked.acceptor
session.target = next
project-carried(session)
session.scroller = asked.scroller
session.operation = asked.operation
if !session.source && native
    //gui.drop// verdict ${asked.operation as U32} target ${next != null} at $point
    C:yumiGuiWindowSetDropOperation(native, if next then asked.operation else DropOperation.none)
if previous && (!next || previous as Pointer != next as Pointer)
    previous.drag-leave <- session
cursor-resolution-invalid = true
if !native
    invalidate-paint()
start-drag-scroll()

────────────────────
_ do follow-carried
    - session DragSession

=? if session.carried.length == 0
. grab = session.grab ?? Point(0, 0)
. at = Point(session.point.x - grab.x, session.point.y - grab.y)
. pace = session.pace
for box in session.carried
    box.follow-carry(at, pace)

────────────────────
_ do project-carried
    - session DragSession

. target = session.target
for box in session.carried
    . parent = box.layout-parent
    box.sync-carry-slot(target != null && parent != null && parent.is-within(target))

────────────────────
_ do land-carried
    - session DragSession

. index = session.carried.length
while index > 0
    index -= 1
    . landing = session.carried[index].end-carry()
    if landing
        landings += landing
        landing.box.schedule-layout()
session.carried = List'Box()

────────────────────
_ do finish-drag
    - dropped Bool

. session = drag-session
=? if !session
drag-session = null
. target = session.target
session.target = null
session.scroller = null
session.pending-snapshot = null
session.ghost?.close()
session.ghost = null
if target
    if dropped
        target.drop <- session
    else
        target.drag-leave <- session
. source = session.source
if source
    source.drag-end <- DragEnd(session, dropped && target != null)
land-carried(session)
cursor-resolution-invalid = true
is-hover-refresh-pending = true
if !native
    invalidate-paint()

────────────────────
_ do settle-drag-ghost

. session = drag-session
=? if !session
if session.pending-snapshot
    capture-drag-ghost(session)
if native
    session.ghost?.present(native, effective-zoom)

────────────────────
_ drag-scroll-delta Length
    - session DragSession

match session.scroller
    |= null
        0
    | scroller Box
        |? above < drag-scroll-edge
            -drag-scroll-amount(drag-scroll-edge - above)
        |? below < drag-scroll-edge
            drag-scroll-amount(drag-scroll-edge - below)
        ??
            0

        .. local = scroller.point-in-box(session.point)
        .. above = local.y
        .. below = scroller.bounds.height - local.y

────────────────────
_ do start-drag-scroll

. session = drag-session
=? if !session || is-drag-scrolling || !native
=? if drag-scroll-delta(session) == 0
is-drag-scrolling = true
do new
    while step-drag-scroll()
        drag-scroll-interval.wait()
    is-drag-scrolling = false

────────────────────
+ do dispatch-pointer-event
    - event ScrollEvent

=? false if !prepare-pointer-dispatch()

if !has-pointer-location || event.root-point != pointer-location
    release-scroll-hover-hold()
accept-pointer-location(event.root-point)
. path = scroll-event-path(event)
path?.at-point(event.root-point).publish(event)
. did-handle = event.is-canceled
if !event.is-canceled && path && path.is-current()
    did-handle = consume-default-scroll(path, event)
    is-hover-refresh-pending = true
if scroll-hover-owner
    extend-scroll-hover-hold()
finish-scroll-event(event)
if drag-session
    advance-drag(drag-session.point, drag-session.modifiers)
settle-pointer-dispatch()
= did-handle

────────────────────
+ do accept-native-scroll
    - event ScrollEvent

if scroll-resampler.accept(event)
    request-render-frame()
    =
. ignored = dispatch-pointer-event(event)

────────────────────
_ do dispatch-scroll-samples

=? if scroll-resampler.is-idle || !native
for event in scroll-resampler.take(C:yumiGuiWindowGetLastFrameEventTime(native!))
    . ignored = dispatch-pointer-event(event)
if !scroll-resampler.is-idle
    request-render-frame()

────────────────────
+ do dispatch-pointer-event
    - event MagnifyEvent

=? if !prepare-pointer-dispatch()
accept-pointer-location(event.root-point)
. held = magnify-gesture-path
. continues = event.phase != ScrollPhase.began && event.phase != ScrollPhase.none
. path = if continues && held && held.is-current() then held else pointer-hit-path(event.root-point)
magnify-gesture-path = path
path?.at-point(event.root-point).publish(event)
if event.phase == ScrollPhase.ended || event.phase == ScrollPhase.cancelled
    magnify-gesture-path = null
settle-pointer-dispatch()

────────────────────
+ do accept-pointer-record
    - native-record PointerRecord

. record = unzoomed(native-record)
. data = record.data
. button = record.pointer-button
do match? record.kind
    |= PointerRecordKind.move
        dispatch-pointer-event(PointerMoveEvent(data, record.delta))
    |= PointerRecordKind.down
        dispatch-pointer-event
            - PointerDownEvent(data, button, record.click-count, record.window-drag-token)
    |= PointerRecordKind.up
        dispatch-pointer-event(PointerUpEvent(data, button))
    |= PointerRecordKind.cancel
        dispatch-pointer-event(PointerUpEvent(data, button, true))
    |= PointerRecordKind.drag
        dispatch-pointer-event(PointerDragEvent(data, button, record.delta))
    |= PointerRecordKind.scroll
        . phase = record.phase as ScrollPhase
        . momentum = record.momentum-phase as ScrollPhase
        accept-native-scroll
            - ScrollEvent(data, record.delta.x, record.delta.y, record.is-precise, phase, momentum)
    |= PointerRecordKind.exit
        dispatch-pointer-exit()
    |= PointerRecordKind.deactivate
        dispatch-window-deactivated()
    |= PointerRecordKind.magnify
        dispatch-pointer-event(MagnifyEvent(data, record.delta.x, record.phase as ScrollPhase))
    |= PointerRecordKind.drop-enter
        accept-external-drag(data)
    |= PointerRecordKind.drop-over
        accept-external-drag(data)
    |= PointerRecordKind.drop-exit
        finish-external-drag(data, false)
    |= PointerRecordKind.drop
        finish-external-drag(data, true)
    |= PointerRecordKind.peer-press
        dispatch-peer-press(data.root-point)

────────────────────
+ do accept-touch
    - native-data PointerEventData
    - phase TouchPhase
    - tap-count U32
    - native-radius F64

=? if !prepare-pointer-dispatch()
. zoom = effective-zoom
. point = Point(native-data.root-point.x / zoom, native-data.root-point.y / zoom)
. data = native-data.root-point = point
. radius = native-radius / zoom
. id = data.pointer-id
if phase == TouchPhase.began
    . hit = pointer-hit-path(point)
    if hit
        touch-captures[id] = TouchCapture(hit, point)
        hit.publish(TouchEvent(data, phase, Point(0, 0), tap-count, radius))
    settle-pointer-dispatch()
    =
. capture = touch-captures[id]
if !capture
    settle-pointer-dispatch()
    =
if phase == TouchPhase.moved
    touch-captures[id] = TouchCapture(capture.path, point)
else
    -= touch-captures[id]
. delta = Point(point.x - capture.point.x, point.y - capture.point.y)
capture.path.at-point(point).publish(TouchEvent(data, phase, delta, tap-count, radius))
settle-pointer-dispatch()

────────────────────
+ do dispatch-pointer-exit

=? if !prepare-pointer-dispatch()
has-pointer-location = false
cursor-resolution-invalid = true
clear-hover()
settle-pointer-dispatch()

────────────────────
+ do dispatch-window-deactivated

accept-window-deactivated()

────────────────────
+ do accept-window-activated

=? if is-closed || is-active
settle-pointer-dispatch()
is-active = true
show-activity(true)
if native-menu-bar
    C:yumiGuiMenuBarInstall(native-menu-bar)
activated <- WindowActivatedEvent()
. remembered = remembered-focus-box
if remembered && is-valid-focus-box(remembered)
    apply-focus(remembered, true)
is-focus-suspended = false
settle-pointer-dispatch()

────────────────────
+ do accept-window-unoccluded

=? if is-closed || !is-metal-rendering
schedule-render()

────────────────────
+ do accept-window-deactivated

=? if is-closed
settle-pointer-dispatch()
release-key-bindings(key-binding-nodes)
dismiss-popups-for-deactivation()
. was-active = is-active
if drag-session?.source
    finish-drag(false)
clear-pointer-capture()
touch-captures.clear()
clear-scroll-gesture()
is-focus-suspended = true
clear-focus-state(true)
is-active = false
show-activity(false)
if was-active
    deactivated <- WindowDeactivatedEvent()
settle-pointer-dispatch()

────────────────────
_ do show-activity
    - active Bool

=? if shows-inactive == !active
shows-inactive = !active
if !is-closed && style-live-attachment(this)
    set-theme-tag("inactive", shows-inactive)
schedule-layout()

────────────────────
_ pointer-hit-path
    - point Point

hit-path(point)

────────────────────
_ do accept-pointer-location
    - point Point

pointer-location = point
has-pointer-location = true
cursor-resolution-invalid = true

────────────────────
_ do settle-cursor-resolution

=? if !cursor-resolution-invalid || (scroll-hover-owner && !drag-session)
cursor-resolution-invalid = false
. next = CursorStyle.automatic
. captured = false
if has-pointer-location
    . hit = pointer-hit-path(pointer-location)
    if hit
        next = hit.target.$cursor
if pointer-capture && pointer-capture.path.is-current()
    . override = pointer-capture.path.target.$drag-cursor
    if override
        next = override
        captured = true
. session = drag-session
if session && session.source
    next = if session.is-accepted then CursorStyle.closed-hand else CursorStyle.not-allowed
    captured = true
=? if next == resolved-cursor-style && captured == resolved-cursor-captured
resolved-cursor-style = next
resolved-cursor-captured = captured
if native
    C:yumiGuiWindowSetCursorStyle
        - native
        - cursor-style-native-value(next)
        - cursor-style-native-image(next)
        - captured

────────────────────
_ do activate-pressed
    - event KeyPressEvent
    - target Box?

=? if !target || target.$focus-mode != FocusMode.press
event.cancel()
=? if event.is-repeat
release-key-press()
key-pressed-box = target
target.is-pressed = true
target.is-press-within = true
target.event-path().publish(ClickEvent(PointerEventData(), PointerButton.primary, 1))

────────────────────
_ do release-key-press

. box = key-pressed-box
=? if !box
key-pressed-box = null
box.is-pressed = false
box.is-press-within = false

────────────────────
_ do update-hover
    - hit PointerHitPath?

=? if drag-session
. target = hit?.target
=? if target == hovered-box

do use gui-instant-cause
    hovered-box?.is-hovered = false
    set-scroll-hover-path(false, hovered-path, hit)
    hovered-box = target
    hovered-path = hit
    if target
        target.is-hovered = target.is-effectively-enabled
    set-scroll-hover-path(true, hovered-path)
settle-hover-popup(target)

────────────────────
_ do clear-hover

do use gui-instant-cause
    hovered-box?.is-hovered = false
    set-scroll-hover-path(false, hovered-path)
hovered-box = null
hovered-path = null
settle-hover-popup(null)

────────────────────
_ do clear-pointer-capture

pointer-capture?.path.target.is-pressed = false
set-press-path(false, pointer-capture?.path)
pointer-capture = null
scroll-indicator-capture = null
cursor-resolution-invalid = true

────────────────────
_ do set-press-path
    - value Bool
    - path PointerHitPath?

=? if !path
for frame in path.frames
    . box = gc-object-from-pointer'Box(frame.owner)
    . next = value && box.is-effectively-enabled
    if box.is-press-within != next
        box.is-press-within = next

────────────────────
_ do set-scroll-hover-path
    - value Bool
    - path PointerHitPath?
    - retained PointerHitPath? = null

=? if !path
for frame in path.frames
    if !hover-path-holds(frame.owner, retained)
        . box = gc-object-from-pointer'Box(frame.owner)
        . next = value && box.is-effectively-enabled
        if box.is-hover-within != next
            box.is-hover-within = next

────────────────────
_ hover-path-holds
    - owner Pointer
    - path PointerHitPath?

path && (some(path.frames) • where each.owner == owner)

────────────────────
+ holds-scroll-indicator
    - owner Box

is-captured || (has-pointer-location && holds-hover && has-axis)

.. capture = scroll-indicator-capture
.. holds-hover = hover-path-holds(owner as Pointer, hovered-path)
.. is-captured = capture && capture.owner as Pointer == owner as Pointer
.. has-axis = owner.scroll-indicator-axis-at(pointer-location) != null

────────────────────
_ do scroll-indicator-hit
    - point Point
    - hit PointerHitPath?

=? if !hit
for frame in hit.frames
    . box = gc-object-from-pointer'Box(frame.owner)
    . axis = box.scroll-indicator-axis-at(point)
    =? ScrollIndicatorHit(box, axis) if axis

────────────────────
_ do begin-scroll-indicator-capture
    - event PointerDownEvent
    - hit PointerHitPath?

=? false if event.button != PointerButton.primary
. indicator = scroll-indicator-hit(event.root-point, hit)
=? false if !indicator
. owner = indicator.owner
. path = owner.event-path().at-point(event.root-point)
update-hover(path)
. offset = owner.scroll-indicator-drag-offset(indicator.axis, event.root-point)
owner.scroll-indicator-scroll-to-point(indicator.axis, event.root-point, offset)
clear-pointer-capture()
scroll-indicator-capture = IndicatorCapture
    - path
    - owner
    - indicator.axis
    - event.pointer-id
    - offset
= true

────────────────────
_ do clear-scroll-gesture

scroll-gesture-path = null
magnify-gesture-path = null
release-scroll-hover-hold()

────────────────────
_ do scroll-event-path PointerHitPath?
    - event ScrollEvent

. begins = event.phase == ScrollPhase.began || event.phase == ScrollPhase.may-begin
. is-phased = event.phase != ScrollPhase.none || event.momentum-phase != ScrollPhase.none
if is-phased && !begins && scroll-gesture-path && scroll-gesture-path.is-current()
    = scroll-gesture-path
if !is-phased && scroll-hover-owner && wheel-path && wheel-path.is-current()
    = wheel-path
if !begins && scroll-hover-owner && scroll-hover-owner.is-input-visible
    . held = scroll-hover-owner.event-path()
    if !is-phased
        wheel-path = held
    = held
. hit = pointer-hit-path(event.root-point)
if !scroll-hover-owner
    update-hover(hit)
if begins
    scroll-gesture-path = hit
if !is-phased
    wheel-path = hit
= hit

────────────────────
_ do consume-default-scroll
    - path PointerHitPath
    - event ScrollEvent

. scale Length = if event.is-precise then 1 else 40
. remaining = Point(event.delta-x * scale, event.delta-y * scale)
. did-handle = false
. cause = ScrollCause.wheel
if event.momentum-phase != ScrollPhase.none
    cause = ScrollCause.momentum
else if event.is-precise
    cause = ScrollCause.trackpad

. is-spent = false
. scroller Box? = null
for frame in path.frames
    . box = gc-object-from-pointer'Box(frame.owner)
    if is-spent
        box.settle-scroll-phase(event.phase, event.momentum-phase)
    else
        . consumed = box.consume-scroll(remaining, cause, event.phase, event.momentum-phase)
        if consumed.actual.x != 0 || consumed.actual.y != 0
            did-handle = true
            scroller = box
        remaining = consumed.remainder
        if remaining.x != 0 && box.stops-scroll-remainder(Orientation.horizontal)
            remaining = Point(0, remaining.y)
            did-handle = true
        if remaining.y != 0 && box.stops-scroll-remainder(Orientation.vertical)
            remaining = Point(remaining.x, 0)
            did-handle = true
        is-spent = remaining.x == 0 && remaining.y == 0
if scroller
    hold-scroll-hover(scroller)
= did-handle || is-spent

────────────────────
_ do hold-scroll-hover
    - scroller Box

scroll-hover-owner = scroller
if hovered-box as Pointer? != scroller as Pointer
    update-hover(scroller.event-path().at-point(pointer-location))

────────────────────
_ do extend-scroll-hover-hold

scroll-hover-deadline = Deadline(gui-scroll-hover-hold)
=? if is-scroll-hover-settling
is-scroll-hover-settling = true
do new
    settle-scroll-hover-hold()

────────────────────
_ do settle-scroll-hover-hold

while scroll-hover-owner && !is-closed
    . deadline = scroll-hover-deadline!
    if deadline.has-passed
        break
    deadline.remaining.wait()
is-scroll-hover-settling = false
=? if !scroll-hover-owner || is-closed
release-scroll-hover-hold()
is-hover-refresh-pending = true
settle-pointer-dispatch()

────────────────────
_ do release-scroll-hover-hold

