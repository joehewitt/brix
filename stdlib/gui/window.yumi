────────────────────
_ hover-tip ~>

~> hidden
    then waiting(popup) for popup on hover-entered

~> waiting(popup)
    then shown(popup) on Timer(popup.$hover-delay) when !is-closed
        do show-hover-popup(popup)
    then waiting(next) for next on hover-entered
    then hidden on hover-exited

~> shown(popup)
    then lingering(popup) on hover-exited
    then shown(next) for next on hover-entered
        do switch-hover-popup(popup, next)
    then cooling(popup.$hover-warmth) on hover-popup-removed when each as Pointer == popup as Pointer

~> lingering(popup)
    then cooling(popup.$hover-warmth) on Timer(popup.$hover-linger)
        do popup.dismiss(DismissReason.hover-end)
    then shown(popup) on hover-entered when each as Pointer == popup as Pointer
    then shown(next) for next on hover-entered
        do switch-hover-popup(popup, next)
    then cooling(popup.$hover-warmth) on hover-popup-removed when each as Pointer == popup as Pointer

~> cooling(warmth)
    then hidden on Timer(warmth)
    then shown(next) for next on hover-entered
        do show-hover-popup(next)

