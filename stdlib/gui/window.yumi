. restore = popup.take-return-focus()
. focus-inside = focused-box != null && focused-box.is-within(popup)
. restores-empty-focus = !focused-box && popup-dismissal-restores-focus(reason)
refresh-modal-popup()
if hovered-box && hovered-box.is-within(popup)
