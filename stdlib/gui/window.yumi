────────────────────
_ do find-child-popup Popup?
    - node GuiNode
    - hover Bool

. child = node.%first-child
while child
    . current = child
    if current is Popup
        . popup = current as Popup
        . matches = if hover then popup.$hover-trigger else popup.$context-trigger
        =? popup if matches
    else if current.is-gui-transparent
        . nested = find-child-popup(current, hover)
        =? nested if nested
    child = current.%next-sibling

