+ title = #app?.#title ?? ""
+ kind = WindowKind.standard
+ titlebar-visible = true
+ stoplight-offset Point?
+ is-full-screen = false
+ appearance = gui-window-appearance
+ size = Dimensions(640, 480)
+ zoom F64 = 1
+ allows-zoom = false
+ stoplight-inset = window-stoplight-room(#native-stoplight-edge, #stoplight-offset) / (if #zoom > 0 then #zoom else 1)
