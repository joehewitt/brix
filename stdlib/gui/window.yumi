────────────────────
_ do validate-pointer-owners

. changed = false
if is-hover-refresh-pending && !scroll-hover-owner
    is-hover-refresh-pending = false
    if has-pointer-location
        update-hover(pointer-hit-path(pointer-location))
    changed = true
. is-hover-root = hovered-box && hovered-box.root as Pointer == this as Pointer
if hovered-box && (!hovered-box.is-input-visible || !is-hover-root)
    if has-pointer-location && !scroll-hover-owner
        update-hover(pointer-hit-path(pointer-location))
    else
        clear-hover()
    changed = true
if pointer-capture && !pointer-capture.path.is-current()
    clear-pointer-capture()
    changed = true
if scroll-indicator-capture && !scroll-indicator-capture.route.is-current()
    clear-pointer-capture()
    changed = true
if scroll-gesture-path && !scroll-gesture-path.is-current()
    clear-scroll-gesture()
    changed = true
if touch-captures.length != 0
    . stale-touches [U64]
    for id, capture in touch-captures
        if !capture.path.is-current()
            stale-touches += id
    for id in stale-touches
        -= touch-captures[id]
. source = drag-session?.source
if source && source.root as Pointer != this as Pointer
    finish-drag(false)
    changed = true
= changed

