+ NativeWindowEventKind is U32

| key-press = 0
| activated = 3
| deactivated = 4
| close-request = 5
| closed = 6
| modifiers-changed = 7
| key-release = 8
| unoccluded = 9
| entered-full-screen = 10
| exited-full-screen = 11
| zoom-in = 12
| zoom-out = 13
| actual-size = 14

