────────────────────
+ do sync-native-artifact-registry
    - native-origin Point
    - native-parent Pointer?

native-artifact-registry-changed = false
native-geometry-dirty = false
window-material-count = 0
=? if native-artifacts.length == 0
//gui.native.registered-artifacts += native-artifacts.length as U64
. native-window = native-window-handle ?? Pointer()
native-sync-pass += 1
for identity in native-artifacts
    . artifact = gc-object-from-pointer'Box(identity)
    artifact.sync-native-artifact(native-origin, native-window, native-parent, native-sync-pass)
    if artifact.has-native-material && !artifact.presentation-layer
        window-material-count += 1

