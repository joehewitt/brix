+ key-binding-conflicts [KeyBindingConflict] = find-key-binding-conflicts(#key-bindings)
+ registered-key-bindings [KeyBinding] = #key-binding-nodes
+ commands [Command] = window-commands(#command-nodes, #key-shortcut-nodes)

