(import ./box)
(import ./events)
(import ./primitives)
(import ./shorthands)
(import ./styles)
(import ./theme)
(import /graphics/primitives)

(style-extend GUIDefaultTheme
  (using GUIBoxCursor)
  (rule Toggle
    (= cursor (. CursorStyle pointing-hand))
    (blank)
    (when-style (not #is-effectively-enabled)
      (= cursor (. CursorStyle arrow))
    )
  )
)

(type + Toggle (is Box)
  (rule This (• flex-row)
    (= focus-mode (. FocusMode press))
    (= window-draggable false)
    (= align-x (. Alignment start))
  )
  (blank)
  (prop + title _ (= ""))
  (prop + is-on _ (= false))
  (prop + toggled-value _ (=> (not is-on)))
  (event + value-changing (of ValueChange Bool))
  (event + value-changed (of ValueChange Bool))
  (fn-do + This _
    (param title _ (= ""))
  )
  (subscribe-for (on event click)
    (if is-effectively-enabled
      (call toggle)
    )
    (call (. event cancel))
  )
  (fn-do + toggle _
    (let next toggled-value)
    (let change (call (of ValueChange Bool) is-on next))
    (<- value-changing change)
    (return-if (if (. change is-canceled)))
    (blank)
    (= is-on next)
    (call did-toggle)
    (<- value-changed (call (of ValueChange Bool) (. change old-value) next))
  )
  (fn-do + did-toggle _)
)
