(import ./box)
(import ./clipboard)
(import ./events)
(import ./primitives)
(import /BxAppleGUI/BxAppleGUI.h)
(import /core/intrinsics)
(import /graphics/canvas)
(import /graphics/image)
(import /graphics/point)
(import /graphics/primitives)
(import /math)
(import /os/path)
(import /time/duration)
(import /ui/input)
(blank)
(prop + drag-start-distance Length (= 3))
(prop + drag-scroll-edge Length (= 28))
(prop + drag-scroll-step Length (= 12))
(prop + drag-scroll-interval _ (= 16ms))
(prop + drag-promise-timeout-milliseconds U64 (= 30000))
(prop + drag-stack-depth Index (= 3))
(prop + drag-stack-step Length (= 3))
(prop _ drag-pace-window _ (= 0.1))

(type + DragPayload (is Interface)
  (fn-expr + drag-kind String :get)
)

(type + PathsDrag
  (implements DragPayload)
  (prop + paths (list Path))
  (fn-do + This _
    (param paths _)
  )
  (fn-expr + drag-kind _ :get
    "paths"
  )
)

(fn-expr + drag-paths (? (list Path))
  (param payload DragPayload)
  (only-if found (if (> (. found length) 0)))
  (where
    (lazy found (if-expr (is payload ClipboardDrag) clipboard-paths other-paths))
    (lazy clipboard-paths (. (as payload ClipboardDrag) clipboard paths))
    (lazy other-paths (if-expr (is payload PathsDrag) (. (as payload PathsDrag) paths) (call (of List Path))))
  )
)

(type + DropOperation (is U32)
  (variant none (= 0))
  (variant copy (= 1))
  (variant link (= 2))
  (variant move (= 3))
)

(type + ClipboardDrag (is Tuple)
  (implements DragPayload)
  (prop + clipboard Clipboard)
  (prop + sequence U64)
  (fn-expr + drag-kind _ :get
    "clipboard"
  )
  (fn-do + receive-promised-files (list Path)
    (let done (call (of Semaphore U64)))
    (do-new-thread
      (call (. done post) (call C:brixGuiDragWaitPromisedFiles sequence drag-promise-timeout-milliseconds))
    )
    (let count U64)
    (do (without cancel)
      (= count (?? (call (. done await)) 0))
    )
    (finally
      (inline (call C:brixGuiDragReleasePromisedFiles sequence))
    )
    (let files (list Path))
    (for (in index (..< 0 count))
      (let file (call C:brixGuiDragPromisedFile sequence index))
      (if file
        (+= files (as file String))
      )
    )
    (return files)
  )
)

(type + DragGhost
  (prop + image RasterCanvas)
  (prop + size Dimensions)
  (prop + grab Point)
  (prop + origin Point)
  (prop + native Pointer (= (call Pointer)))
  (prop + is-shown _ (= false))
  (fn-do + This _
    (param image _)
    (param size _)
    (param grab _)
    (param origin _)
  )
  (fn-expr + frame _ :get
    (call Rect (. origin x) (. origin y) (. size width) (. size height))
  )
  (fn-do + follow _
    (param point Point)
    (= origin (call Point (- (. point x) (. grab x)) (- (. point y) (. grab y))))
  )
  (fn-do + present _
    (param window-native Pointer)
    (param zoom F64)
    (if (== native (call Pointer))
      (= native (call C:brixGuiPopupCreate window-native))
      (call C:brixGuiPopupSetConstrained native false)
    )
    (return-if (if (== native (call Pointer))))
    (blank)
    (call C:brixGuiPopupSetFrame
      (block
        (arg native)
        (arg (* (. origin x) zoom))
        (arg (* (. origin y) zoom))
        (arg (* (. size width) zoom))
        (arg (* (. size height) zoom))
      )
    )
    (return-if (if is-shown))
    (blank)
    (= is-shown true)
    (call C:brixGuiPopupSetPassesPointer native true)
    (call C:brixGuiPopupCommitFrame native (. image native))
    (call C:brixGuiPopupSetShown native true)
  )
  (fn-do + close _
    (if (!= native (call Pointer))
      (call C:brixGuiPopupRelease native)
      (= native (call Pointer))
    )
    (= is-shown false)
    (call (. image close))
  )
)

(type + DragSession
  (prop + payload DragPayload)
  (prop + source (? Box))
  (prop + origin Point)
  (prop + point Point)
  (prop + modifiers PointerModifiers)
  (prop + pointer-id U64)
  (prop + target (? Box))
  (prop + scroller (? Box))
  (prop + ghost (? DragGhost))
  (prop + grab (? Point))
  (prop + pending-snapshot (? Box))
  (prop + carried (list Box))
  (prop + operation _ (= (. DropOperation none)))
  (prop + is-accepted _ (=> (!= target null)))
  (blank)
  (prop _ times _ (= (call (of List F64))))
  (prop _ places _ (= (call (of List Point))))
  (fn-do + This _
    (param payload _)
    (param source _)
    (param origin _)
    (param point _)
    (param modifiers _)
    (param pointer-id _)
  )
  (fn-do + sample _
    (param at Point)
    (param time F64)
    (while (and times (> (- time ([] times 0)) (* drag-pace-window 2)))
      (call (. times remove) 0)
      (call (. places remove) 0)
    )
    (+= times time)
    (+= places at)
  )
  (fn-do + pace Point :get
    (return-if (call Point 0 0) (if (< (. places length) 2)))
    (blank)
    (let last (- (. times length) 1))
    (let now ([] times last))
    (let index last)
    (while (and (> index 0) (<= (- now ([] times (- index 1))) drag-pace-window))
      (-= index 1)
    )
    (let elapsed (- now ([] times index)))
    (return-if (call Point 0 0) (if (<= elapsed 0)))
    (blank)
    (let from ([] places index))
    (let to ([] places last))
    (return (call Point (/ (- (. to x) (. from x)) elapsed) (/ (- (. to y) (. from y)) elapsed)))
  )
)

(type + DragExport (is Tuple)
  (prop + items (list ClipboardItem))
  (prop + image Image)
  (prop + frame Rect)
)

(type + DragStartEvent (is GUIEvent)
  (prop + pointer Point)
  (prop + session (? DragSession))
  (prop + exported (? DragExport))
  (fn-do + This _
    (param data PointerEventData)
    (param pointer _)
  )
  (fn-do + begin _
    (param payload DragPayload)
    (param snapshot (? Box) (= null))
    (param grab (? Point) (= null))
    (let owner (call (of gc-object-from-pointer Box) (. ([] route-frames route-index) owner)))
    (let started (call DragSession payload owner root-point pointer modifiers pointer-id))
    (= (. started pending-snapshot) (?? snapshot owner))
    (= (. started grab) grab)
    (= session started)
    (call cancel)
    (return started)
  )
  (fn-do + carry DragSession
    (param payload DragPayload)
    (param box (? Box) (= null))
    (param stack (list Box) (= (call (of List Box))))
    (let owner (call (of gc-object-from-pointer Box) (. ([] route-frames route-index) owner)))
    (let started (call DragSession payload owner root-point pointer modifiers pointer-id))
    (+= (. started carried) (?? box owner))
    (for (in follower stack)
      (+= (. started carried) follower)
    )
    (= session started)
    (call cancel)
    (return started)
  )
  (fn-do + export _
    (param items (list ClipboardItem))
    (param image Image)
    (param frame Rect)
    (= exported (call DragExport items image frame))
    (call cancel)
  )
)

(type + DragOverEvent (is GUIEvent)
  (prop + session DragSession)
  (prop + acceptor (? Box))
  (prop + scroller (? Box))
  (prop + operation _ (= (. DropOperation none)))
  (prop + payload _ (=> (. session payload)))
  (fn-do + This _
    (param data PointerEventData)
    (param session _)
  )
  (fn-do + accept _
    (param scrolling (? Box) (= null))
    (param dropping _ (= (. DropOperation copy)))
    (= acceptor (call (of gc-object-from-pointer Box) (. ([] route-frames route-index) owner)))
    (= scroller scrolling)
    (= operation dropping)
    (call cancel)
  )
)

(type + DragEnd (is Tuple)
  (prop + session DragSession)
  (prop + dropped Bool)
)

(fn-expr + drag-scroll-amount Length
  (param depth Length)
  (* drag-scroll-step (call min 1 (call max 0.2 (/ depth drag-scroll-edge))))
)
