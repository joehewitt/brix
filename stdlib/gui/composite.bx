(import ./box)
(import /core/markup)
(import /core/style)
(import /stream/aggregate)
(blank)
(prop _ gui-composite _ (= (call CompositeState)))
(blank)
(type-line _ CompositeStep (is (tuple (: box (? Box)) (: index Size))))
(type-line _ CompositeRoute (is (tuple (: box Box) (: host Box) (: layer Layer) (: is-proxy Bool))))
(type-line _ CompositeList (is (tuple (: layer (? Layer)) (: owner (? Box)))))

(type + CompositeBoxState
  (prop + layers (? (list Layer)))
  (prop + host (? Box))
  (prop + below (? (list Box)))
  (prop + above (? (list Box)))
)

(type + Layer (is GuiNode)
  (prop + name _ (= ""))
  (prop + is-default _ (= false))
  (blank)
  (prop _ sublayers (list Layer))
  (prop _ parent-layer (? Layer))
  (prop _ owner (? Box))
  (blank)
  (depends layer-changed name is-default)
  (fn-do + This _
    (param name _ (= ""))
  )
  (fn-do + declarer _ :get
    (let cursor Layer this)
    (while (. cursor parent-layer)
      (= cursor (. cursor parent-layer))
    )
    (return (. cursor owner))
  )
  (fn-do + adopt _
    (param sublayer Layer)
    (= (. sublayer parent-layer) this)
    (+= sublayers sublayer)
    (call composite-invalidate)
  )
  (fn-do + mounted _
    (call (. super mounted))
    (match? (call composite-layer-holder this)
      (case (: layer Layer)
        (= parent-layer layer)
        (call composite-insert-layer (. layer sublayers) this)
      )
      (case (: box Box)
        (= owner box)
        (call composite-insert-layer (. box declared-layer-list) this)
      )
    )
    (call composite-invalidate)
  )
  (fn-do + unmounted _
    (let parent parent-layer)
    (if parent
      (call composite-remove-layer (. parent sublayers) this)
      (= parent-layer null)
    )
    (let holder owner)
    (if holder
      (call composite-remove-layer (. holder declared-layer-list) this)
      (= owner null)
    )
    (call composite-invalidate)
    (call (. super unmounted))
  )
  (fn-do _ layer-changed _
    (call composite-invalidate)
  )
)

(fn-do + composite-install-window-layers _
  (param window Box)
  (let layers (. window declared-layer-list))
  (let adornments (call Layer "adornments"))
  (call (. adornments adopt) (call Layer "focus"))
  (call (. adornments adopt) (call Layer "handles"))
  (let content (call Layer "content"))
  (= (. content is-default) true)
  (call (. layers insert) (call Layer "underlay") 0)
  (call (. layers insert) content 1)
  (call (. layers insert) (call Layer "flights") 2)
  (call (. layers insert) adornments 3)
  (call (. layers insert) (call Layer "feedback") 4)
  (let index Size 0)
  (while (< index 5)
    (= (. ([] layers index) owner) window)
    (+= index 1)
  )
  (call composite-invalidate)
)

(fn-do + composite-register _
  (param box Box)
  (+= (. gui-composite boxes) box)
  (call composite-invalidate)
)

(fn-do + composite-unregister _
  (param box Box)
  (let boxes (. gui-composite boxes))
  (let index Size 0)
  (while (< index (. boxes length))
    (if (== (as ([] boxes index) Pointer) (as box Pointer))
      (call (. boxes remove) index)
      (break)
    )
    (+= index 1)
  )
  (call composite-invalidate)
)

(fn-do + composite-invalidate _
  (+= (. gui-composite generation) 1)
)

(fn-do + composite-style-mask _
  (let state gui-composite)
  (return-if (. state style-mask) (if (!= (. state style-mask) 0)))
  (let composite (call style-domain-named "composite"))
  (let layout (call style-domain-named "layout"))
  (let effects (call style-domain-named "vector-composite"))
  (return-if 0 (if (or (< composite 0) (< layout 0) (< effects 0))))
  (= (. state layer-mask) (/lshift/ 1u32 (as composite Size)))
  (let shape (/or/ (/lshift/ 1u32 (as layout Size)) (/lshift/ 1u32 (as effects Size))))
  (= (. state style-mask) (/or/ (. state layer-mask) shape))
  (return (. state style-mask))
)

(fn-expr + composite-layer-mask _
  (. gui-composite layer-mask)
)

(fn-do + composite-refresh _
  (let state gui-composite)
  (return-if (if (== (. state plan-generation) (. state generation))))
  (= (. state plan-generation) (. state generation))
  (for (in box (. state relevant))
    (call (. box set-composite-relevant) false)
  )
  (let relevant (list Box))
  (let routes (list CompositeRoute))
  (for (in box (. state boxes))
    (call composite-mark-relevant box relevant)
    (let route (call composite-route box))
    (if route
      (+= routes route)
    )
  )
  (= (. state relevant) relevant)
  (let hostings (list CompositeHosting))
  (for (in route routes)
    (if (not (call composite-has-hosting hostings (. route host)))
      (+= hostings (call composite-build-hosting (. route host) routes))
    )
  )
  (return-if (if (call composite-same-plan state routes hostings)))
  (for (in route (. state routes))
    (call (. route box set-composite-host) null)
  )
  (for (in hosting (. state hostings))
    (call (. hosting host set-composite-members) null null)
  )
  (let old-routes (. state routes))
  (let old-hostings (. state hostings))
  (= (. state routes) routes)
  (= (. state hostings) hostings)
  (for (in route routes)
    (call (. route box set-composite-host) (. route host))
  )
  (for (in hosting hostings)
    (call (. hosting host set-composite-members) (. hosting below) (. hosting above))
  )
  (call composite-mark-placements old-routes routes)
  (call composite-mark-placements routes old-routes)
  (call composite-mark-hostings old-hostings hostings)
  (call composite-mark-hostings hostings old-hostings)
)

(type _ CompositeState
  (prop + generation U64 (= 1))
  (prop + plan-generation U64)
  (prop + boxes (list Box))
  (prop + relevant (list Box))
  (prop + routes (list CompositeRoute))
  (prop + hostings (list CompositeHosting))
  (prop + style-mask U32)
  (prop + layer-mask U32)
)

(type _ CompositeHosting
  (prop + host Box)
  (prop + below (list Box))
  (prop + above (list Box))
  (fn-do + This _
    (param host _)
    (param below _)
    (param above _)
  )
)

(fn-do _ composite-mark-placements _
  (param routes (list CompositeRoute))
  (param others (list CompositeRoute))
  (for (in route routes (when (not (call composite-routes-box others (. route box)))))
    (call (?. (. route box material-parent) composite-placement-changed))
  )
)

(fn-expr _ composite-routes-box _
  (param routes (list CompositeRoute))
  (param box Box)
  (call some routes (:where (== (as (. each box) Pointer) (as box Pointer))))
)

(fn-do _ composite-mark-hostings _
  (param hostings (list CompositeHosting))
  (param others (list CompositeHosting))
  (for (in hosting hostings (when (not (call composite-keeps-hosting others hosting))))
    (call (. hosting host composite-placement-changed))
  )
)

(fn-do _ composite-keeps-hosting Bool
  (param hostings (list CompositeHosting))
  (param hosting CompositeHosting)
  (for (in other hostings (when (== (as (. other host) Pointer) (as (. hosting host) Pointer))))
    (return
      (scope (and (call composite-same-boxes (. other below) (. hosting below)) same-above)
        (lazy same-above (call composite-same-boxes (. other above) (. hosting above)))
      )
    )
  )
  (return false)
)

(fn-do _ composite-mark-relevant _
  (param box Box)
  (param relevant (list Box))
  (let cursor (? Box) box)
  (while cursor
    (let current cursor)
    (return-if (if (. current is-composite-relevant)))
    (call (. current set-composite-relevant) true)
    (+= relevant current)
    (= cursor (. current material-parent))
  )
)

(fn-do _ composite-resolve _
  (param box Box)
  (param name String)
  (let cursor (. box layout-parent))
  (while cursor
    (let ancestor cursor)
    (let layers (. ancestor composite-layers))
    (if layers
      (let found (call composite-find-layer layers name))
      (return-if found (if found))
    )
    (= cursor (. ancestor layout-parent))
  )
)

(fn-do _ composite-layer-holder _
  (param layer Layer)
  (let cursor (. layer %parent))
  (while cursor
    (let node cursor)
    (return-if node (if (not (. node is-gui-transparent))))
    (= cursor (. node %parent))
  )
)

(fn-do _ composite-insert-layer _
  (param layers (list Layer))
  (param layer Layer)
  (let index (. layers length))
  (while (and (> index 0) (call gui-node-precedes layer ([] layers (- index 1))))
    (-= index 1)
  )
  (call (. layers insert) layer index)
)

(fn-do _ composite-remove-layer _
  (param layers (list Layer))
  (param layer Layer)
  (let index Size 0)
  (while (< index (. layers length))
    (if (== (as ([] layers index) Pointer) (as layer Pointer))
      (call (. layers remove) index)
      (return)
    )
    (+= index 1)
  )
)

(fn-do _ composite-find-layer (? Layer)
  (param layers (list Layer))
  (param name String)
  (for (in layer layers)
    (return-if layer (if (== (. layer name) name)))
    (let nested (call composite-find-layer (. layer sublayers) name))
    (return-if nested (if nested))
  )
)

(fn-do _ composite-default-layer (? Layer)
  (param layers (list Layer))
  (for (in layer layers)
    (return-if layer (if (. layer is-default)))
    (let nested (call composite-default-layer (. layer sublayers)))
    (return-if nested (if nested))
  )
)

(fn-do _ composite-flatten-layers _
  (param layers (list Layer))
  (param ordered (list Layer))
  (for (in layer layers)
    (+= ordered layer)
    (call composite-flatten-layers (. layer sublayers) ordered)
  )
)

(fn-expr _ composite-list _
  (param box Box)
  (if-expr layer (call CompositeList layer null) (call composite-inherited-list box))
  (where
    (lazy name (. box $layer))
    (lazy layer (only-if (call composite-resolve box name) (if name)))
  )
)

(fn-expr _ composite-inherited-list CompositeList
  (param box Box)
  (case? (not parent)
    (call CompositeList null null)
  )
  (case? (or (not layers) (== (. layers length) 0))
    (call composite-list parent)
  )
  (case? fallback
    (call CompositeList fallback null)
  )
  (default
    (call CompositeList null parent)
  )
  (where
    (lazy parent (. box layout-parent))
    (lazy layers (. parent composite-layers))
    (lazy fallback (call composite-default-layer layers))
  )
)

(fn-expr _ composite-same-list _
  (param left CompositeList)
  (param right CompositeList)
  (and same-layer (== (as (. left owner) (? Pointer)) (as (. right owner) (? Pointer))))
  (where
    (lazy same-layer (== (as (. left layer) (? Pointer)) (as (. right layer) (? Pointer))))
  )
)

(fn-do _ composite-route _
  (param box Box)
  (let flies (. box is-flight-routable))
  (let name (if-expr flies "flights" (. box $layer)))
  (return-if (if (not name)))
  (let layer (call composite-resolve box name))
  (return-if (if (not layer)))
  (return-if (if (call composite-same-list (call composite-inherited-list box) (call CompositeList layer null))))
  (let declarer (. layer declarer))
  (let host (?? (if-expr flies declarer null) (call composite-host-for box declarer)))
  (return (call CompositeRoute box host layer (!= (as host Pointer) (as declarer (? Pointer)))))
)

(fn-do _ composite-host-for _
  (param box Box)
  (param declarer (? Box))
  (let host box)
  (let cursor (. box layout-parent))
  (while cursor
    (let ancestor cursor)
    (return-if ancestor (if (or (== (as ancestor (? Pointer)) (as declarer (? Pointer))) (. ancestor is-composite-scope))))
    (= host ancestor)
    (= cursor (. ancestor layout-parent))
  )
  (return host)
)

(fn-do _ composite-chain-visible _
  (param box Box)
  (param host Box)
  (let cursor (. box material-parent))
  (while cursor
    (let ancestor cursor)
    (return-if true (if (== (as ancestor Pointer) (as host Pointer))))
    (return-if false (if (not (. ancestor is-display-visible))))
    (= cursor (. ancestor material-parent))
  )
  (return true)
)

(fn-expr _ composite-has-hosting _
  (param hostings (list CompositeHosting))
  (param host Box)
  (call some hostings (:where (== (as (. each host) Pointer) (as host Pointer))))
)

(fn-do _ composite-build-hosting _
  (param host Box)
  (param routes (list CompositeRoute))
  (let local (list CompositeRoute))
  (let proxies (list CompositeRoute))
  (for (in route routes (when (== (as (. route host) Pointer) (as host Pointer))))
    (if (call composite-chain-visible (. route box) host)
      (if (. route is-proxy)
        (+= proxies route)
        (else
          (+= local route)
        )
      )
    )
  )
  (let lower (list Box))
  (let upper (list Box))
  (call composite-split-proxies host proxies lower upper)
  (let local-lower (list Box))
  (let local-upper (list Box))
  (call composite-split-local host local local-lower local-upper)
  (let below
    (call (of List Box)
      (block
        (spread lower)
        (spread local-lower)
      )
    )
  )
  (let above
    (call (of List Box)
      (block
        (spread local-upper)
        (spread upper)
      )
    )
  )
  (return (call CompositeHosting host below above))
)

(fn-do _ composite-split-local _
  (param host Box)
  (param local (list CompositeRoute))
  (param lower (list Box))
  (param upper (list Box))
  (return-if (if (== (. local length) 0)))
  (let layers (. host composite-layers))
  (return-if (if (not layers)))
  (let fallback (call composite-default-layer layers))
  (let is-lower (!= fallback null))
  (let ordered (list Layer))
  (call composite-flatten-layers layers ordered)
  (for (in layer ordered)
    (if (== (as layer Pointer) (as fallback (? Pointer)))
      (= is-lower false)
    )
    (let members (list Box))
    (for (in route local (when (== (as (. route layer) Pointer) (as layer Pointer))))
      (call composite-insert-in-tree-order members (. route box))
    )
    (for (in member members)
      (if is-lower
        (+= lower member)
        (else
          (+= upper member)
        )
      )
    )
  )
)

(fn-do _ composite-insert-in-tree-order _
  (param boxes (list Box))
  (param box Box)
  (let index (. boxes length))
  (while (and (> index 0) (call composite-paints-before box ([] boxes (- index 1))))
    (-= index 1)
  )
  (call (. boxes insert) box index)
)

(fn-do _ composite-split-proxies _
  (param scope Box)
  (param proxies (list CompositeRoute))
  (param lower (list Box))
  (param upper (list Box))
  (return-if (if (== (. proxies length) 0)))
  (let keys (list (list CompositeStep)))
  (let boxes (list Box))
  (for (in route proxies)
    (let key (call composite-position-key (. route box)))
    (let index (. keys length))
    (while (and (> index 0) (call composite-key-precedes key ([] keys (- index 1))))
      (-= index 1)
    )
    (call (. keys insert) key index)
    (call (. boxes insert) (. route box) index)
  )
  (let scope-key (call composite-position-key scope))
  (let index Size 0)
  (while (< index (. boxes length))
    (if (call composite-key-precedes ([] keys index) scope-key)
      (+= lower ([] boxes index))
      (else
        (+= upper ([] boxes index))
      )
    )
    (+= index 1)
  )
)

(fn-do _ composite-position-key (list CompositeStep)
  (param box Box)
  (let key (call composite-list-key (call composite-list box)))
  (+= key (call CompositeStep box 0))
  (return key)
)

(fn-do _ composite-list-key _
  (param list CompositeList)
  (let key (list CompositeStep))
  (let layer (. list layer))
  (if layer
    (let declarer (. layer declarer))
    (if declarer
      (= key (call composite-position-key declarer))
    )
    (for (in index (call composite-layer-path layer))
      (+= key (call CompositeStep null index))
    )
    (+= key (call CompositeStep null 0))
    (return key)
  )
  (let owner (. list owner))
  (if owner
    (= key (call composite-position-key owner))
    (+= key (call CompositeStep null 0))
  )
  (return key)
)

(fn-do _ composite-layer-path _
  (param layer Layer)
  (let path (list Size))
  (let cursor (? Layer) layer)
  (while cursor
    (let current cursor)
    (call (. path insert) (call composite-layer-index current) 0)
    (= cursor (. current parent-layer))
  )
  (return path)
)

(fn-do _ composite-layer-index Size
  (param layer Layer)
  (let parent (. layer parent-layer))
  (let holder (. layer owner))
  (let siblings (list Layer))
  (if parent
    (= siblings (. parent sublayers))
    (else-if holder
      (= siblings (. holder declared-layer-list))
    )
  )
  (let index Size 0)
  (while (< index (. siblings length))
    (return-if (+ index 1) (if (== (as ([] siblings index) Pointer) (as layer Pointer))))
    (+= index 1)
  )
  (return 0)
)

(fn-do _ composite-key-precedes _
  (param left (list CompositeStep))
  (param right (list CompositeStep))
  (let index Size 0)
  (while (and (< index (. left length)) (< index (. right length)))
    (let a ([] left index))
    (let b ([] right index))
    (let a-box (. a box))
    (let b-box (. b box))
    (if (and a-box b-box)
      (return-if (call gui-node-precedes a-box b-box) (if (!= (as a-box Pointer) (as b-box Pointer))))
      (else-if (!= (. a index) (. b index))
        (return (< (. a index) (. b index)))
      )
    )
    (+= index 1)
  )
  (return (< (. left length) (. right length)))
)

(fn-do _ composite-same-plan _
  (param state CompositeState)
  (param routes (list CompositeRoute))
  (param hostings (list CompositeHosting))
  (return-if false (if (or (!= (. state routes length) (. routes length)) (!= (. state hostings length) (. hostings length)))))
  (let index Size 0)
  (while (< index (. routes length))
    (let left ([] (. state routes) index))
    (let right ([] routes index))
    (return-if false (if (!= (as (. left box) Pointer) (as (. right box) Pointer))))
    (return-if false (if (!= (as (. left host) Pointer) (as (. right host) Pointer))))
    (+= index 1)
  )
  (= index 0)
  (while (< index (. hostings length))
    (let left ([] (. state hostings) index))
    (let right ([] hostings index))
    (return-if false (if (!= (as (. left host) Pointer) (as (. right host) Pointer))))
    (return-if false (if (not (call composite-same-boxes (. left below) (. right below)))))
    (return-if false (if (not (call composite-same-boxes (. left above) (. right above)))))
    (+= index 1)
  )
  (return true)
)

(fn-do _ composite-same-boxes _
  (param left (list Box))
  (param right (list Box))
  (return-if false (if (!= (. left length) (. right length))))
  (let index Size 0)
  (while (< index (. left length))
    (return-if false (if (!= (as ([] left index) Pointer) (as ([] right index) Pointer))))
    (+= index 1)
  )
  (return true)
)

(fn-expr _ composite-paints-before Bool
  (param box Box)
  (param other Box)
  (if-expr both-routable (< (. box lift-order) (. other lift-order)) (call gui-node-precedes box other))
  (where
    (lazy both-routable (and (. box is-flight-routable) (. other is-flight-routable)))
  )
)
