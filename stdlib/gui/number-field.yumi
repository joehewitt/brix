+ NumberField is Box

+ value F64
+ minimum F64?
+ maximum F64?
+ step F64 = 1
+ scrub-step F64?
+ snaps = false
+ precision Size = 2
+ label = ""
+ unit = ""
+ placeholder = ""
+ is-mixed = false
+ is-read-only = false
+ is-scrubbable = true
