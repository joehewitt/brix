+ live-edit-delay = gui-live-edit-delay

• This
    focus-mode = FocusMode.inside
+ event value-changing ValueChange'F64
+ event value-changed ValueChange'F64

_ is-live-applying = false
_ edit-origin F64

. displayed-value-changed < value, is-mixed, precision

────────────────────

<This • flex-row
    <NumberFieldScrubber scrubber • flex-row
        align-y = Alignment.center
        display =
            |? #is-scrubbable && #scrub-handle == NumberFieldScrubHandle.label
                Display.visible
            ??
                Display.hidden
        + <Box icon • flex-row flex:1
            <Label • flex:1
                text-alignment = TextAlignment.center
                text = #label
    <TextInput entry • number-field-entry flex:1
        is-bare = true
        align-y = Alignment.center
        text = number-field-display-text(#value, #precision, #is-mixed)
        placeholder = if #is-mixed then "Mixed" else #placeholder
        is-read-only = #is-read-only
        live-edit-delay = #live-edit-delay
        for event on input
            event.cancel()
        for event on text-selected
            event.cancel()
        for event on text-edited
            accept-edit(event.text, event.phase)
            event.cancel()
        for event on change
            accept-text(event.text)
            event.cancel()
    if #unit.length
        <NumberFieldUnit unit-label
            text = #unit
            align-y = Alignment.center
            is-scrubbable =
                #is-scrubbable && !#is-read-only && #scrub-handle == NumberFieldScrubHandle.unit
    <KeyShortcut "Increment"
        key = .arrow-up
        discoverable = false
        allow-while-input = true
        enabled = !#is-read-only
        action = => do step-from-entry(1)
    <KeyShortcut "Decrement"
        key = .arrow-down
        discoverable = false
        allow-while-input = true
        enabled = !#is-read-only
        action = => do step-from-entry(-1)
    <KeyShortcut "Increment by ten"
        key = KeyModifier.shift + Key.arrow-up
        discoverable = false
        allow-while-input = true
        enabled = !#is-read-only
        action = => do step-from-entry(10)
    <KeyShortcut "Decrement by ten"
        key = KeyModifier.shift + Key.arrow-down
        discoverable = false
        allow-while-input = true
        enabled = !#is-read-only
        action = => do step-from-entry(-10)
    <KeyShortcut "Page Up"
        key = .page-up
        discoverable = false
        allow-while-input = true
        enabled = !#is-read-only
        action = => do step-from-entry(10)
    <KeyShortcut "Page Down"
        key = .page-down
        discoverable = false
        allow-while-input = true
        enabled = !#is-read-only
        action = => do step-from-entry(-10)
    <KeyShortcut "Revert"
        key = .escape
        discoverable = false
        allow-while-input = true
        when = => is-entry-dirty
        action = => do revert-entry()

────────────────────
+ get is-entry-dirty Bool

is-live-applying || entry.text != number-field-display-text(value, precision, is-mixed)

────────────────────
+ do accept-text
    - text String

. parsed = parse-decimal(text)
if parsed
    accept-value(parsed)
entry.text = number-field-display-text(value, precision, is-mixed && !parsed)

────────────────────
+ do accept-edit
    - text String
    - phase ValueChangePhase

. parsed = parse-decimal(text)
if phase == ValueChangePhase.ended
    if is-live-applying
        is-live-applying = false
        accept-value(parsed ?? value, ValueChangePhase.ended)
    else if parsed
        accept-value(parsed)
    entry.text = number-field-display-text(value, precision, is-mixed && !parsed)
    =
=? if !parsed
. live-phase = if is-live-applying then ValueChangePhase.changed else ValueChangePhase.began
if !is-live-applying
    edit-origin = value
is-live-applying = true
accept-value(parsed, live-phase)

────────────────────
+ do accept-value
    - candidate F64
    - phase ValueChangePhase = ValueChangePhase.discrete

=? if !is-effectively-enabled || is-read-only
. next = normalized(candidate)
. old = value
. unchanged = next == old && !is-mixed
=? if unchanged && (phase == ValueChangePhase.discrete || phase == ValueChangePhase.changed)
if !unchanged
    . change = ValueChange'F64(old, next, phase)
    value-changing <- change
    if change.is-canceled
        entry.text = number-field-display-text(value, precision, is-mixed)
        =
value = next
entry.text = number-field-display-text(next, precision, false)
value-changed <- ValueChange'F64(old, next, phase)

────────────────────
+ do step-by
    - steps F64
    - phase ValueChangePhase = ValueChangePhase.discrete

accept-value(value + steps * step, phase)

────────────────────
+ do step-from-entry
    - steps F64

. base = parse-decimal(entry.text) ?? value
accept-value(base + steps * step)
entry.replace-text(number-field-display-text(value, precision, false))

────────────────────
+ do revert-entry

if is-live-applying
    is-live-applying = false
    accept-value(edit-origin, ValueChangePhase.ended)
entry.replace-text(number-field-display-text(value, precision, is-mixed))

────────────────────
+ normalized F64
    - candidate F64

number-field-round(stepped, precision)

.. lower = if minimum then max(candidate, minimum) else candidate
.. bounded = if maximum then min(lower, maximum) ?? lower else lower
.. snapped = number-field-stepped(bounded, step, minimum ?? 0.0, maximum)
.. stepped = if snaps && step > 0 then snapped else bounded

────────────────────
_ do displayed-value-changed

entry.text = number-field-display-text(value, precision, is-mixed)

