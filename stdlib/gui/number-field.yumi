━━━━━━━━━━━━━━━━━━━━
+ do number-field-stepped F64
    - value F64
    - step F64
    - base F64
    - maximum F64?

. snapped = base + round((value - base) / step) * step
if maximum != null && snapped > maximum
    snapped = base + floor((maximum - base) / step + 0.000000001) * step
= snapped

━━━━━━━━━━━━━━━━━━━━
+ number-field-round F64
    - value F64
    - precision Size

round(value * scale) / scale

.. scale = 10.0 %% precision

━━━━━━━━━━━━━━━━━━━━
+ number-field-display-text String
    - value F64
    - precision Size
    - is-mixed Bool

if is-mixed then "" else value.places(precision)

━━━━━━━━━━━━━━━━━━━━
_ NumberFieldScrub

_ active-pointer-id U64?
_ start-x Coord = 0
_ start-value F64

────────────────────
+ do begin
    - handle Box
    - event PointerDownEvent

. owner = handle.ancestor'NumberField
=? if event.button != PointerButton.primary || !owner
=? if !owner.is-effectively-enabled || owner.is-read-only
active-pointer-id = event.pointer-id
start-x = event.point.x
start-value = owner.value
owner.accept-value(start-value, ValueChangePhase.began)

────────────────────
+ do drag
    - handle Box
    - event PointerDragEvent

=? if !is-active(event.pointer-id)
. owner = handle.ancestor'NumberField
=? if !owner
owner.accept-value
    - start-value + (event.point.x - start-x) * (owner.scrub-step ?? owner.step)
    - ValueChangePhase.changed
event.cancel()

────────────────────
+ do end
    - handle Box
    - event PointerUpEvent

=? if !is-active(event.pointer-id)
active-pointer-id = null
. owner = handle.ancestor'NumberField
if owner
    owner.accept-value(owner.value, ValueChangePhase.ended)
event.cancel()

────────────────────
_ is-active
    - pointer-id U64

active-pointer-id != null && active-pointer-id == pointer-id
