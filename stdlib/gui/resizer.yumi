────────────────────

<This
    left = resizer-offset(#edge, Side.left)
    right = resizer-offset(#edge, Side.right)
    top = resizer-offset(#edge, Side.top)
    bottom = resizer-offset(#edge, Side.bottom)
    min-width = if #is-horizontal then SizeSpec.coord(resizer-reach) else SizeSpec.auto
    max-width = if #is-horizontal then SizeSpec.coord(resizer-reach) else SizeSpec.auto
    min-height = if #is-horizontal then SizeSpec.auto else SizeSpec.coord(resizer-reach)
    max-height = if #is-horizontal then SizeSpec.auto else SizeSpec.coord(resizer-reach)
    cursor = if #is-horizontal then CursorStyle.resize-horizontal else CursorStyle.resize-vertical
    drag-cursor = if #is-horizontal then CursorStyle.resize-horizontal else CursorStyle.resize-vertical
    <KeyShortcut "Grow"
        key = resizer-grow-key(#edge)
        discoverable = false
        action = => do nudge(resizer-small-step)
    <KeyShortcut "Shrink"
        key = resizer-grow-key(#edge.opposite)
        discoverable = false
        action = => do nudge(-resizer-small-step)
    <KeyShortcut "Grow more"
        key = KeyModifier.shift + resizer-grow-key(#edge)
        discoverable = false
        action = => do nudge(resizer-large-step)
    <KeyShortcut "Shrink more"
        key = KeyModifier.shift + resizer-grow-key(#edge.opposite)
        discoverable = false
        action = => do nudge(-resizer-large-step)
    <KeyShortcut "Smallest"
        key = .home
        discoverable = false
        action = => do resize-to(min-size)
    <KeyShortcut "Largest"
        key = .end
        discoverable = false
        action = => do resize-to(max-size)
    <KeyShortcut "Reset size"
        key = .enter
        discoverable = false
        action = => do reset-size()

────────────────────
_ gesture ~>

~> idle

~> dragging for press on pointer-down when press.button == PointerButton.primary && press.click-count < 2 && target != null
    do
        note-natural-size()
        start-size = current-size(target!)

    then collapsed(press.pointer-id) for drag on pointer-drag when drag.pointer-id == press.pointer-id && collapses(dragged-size(press, drag))
        do
            drag.cancel()
            size = start-size
            collapse-requested <- this

    for drag on pointer-drag when drag.pointer-id == press.pointer-id
        size = max(min-size, min(max-size, dragged-size(press, drag)))
        drag.cancel()

    then idle for up on pointer-up when up.pointer-id == press.pointer-id
        do
            up.cancel()
            save-size()
            announce-size()

~> collapsed(pointer-id)
    for drag on pointer-drag when drag.pointer-id == pointer-id
        drag.cancel()

    then idle for up on pointer-up when up.pointer-id == pointer-id
        do up.cancel()

────────────────────
for press on pointer-down when press.button == PointerButton.primary && press.click-count >= 2 && target != null

reset-size()
press.cancel()

────────────────────
for event on drag-start

event.cancel()

