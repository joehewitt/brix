+ do gui-app-state AppState?
    - box Box

. host = box.window
=? if !host
= (host as Window).app?.state

━━━━━━━━━━━━━━━━━━━━
_ resizer-offset
    - edge Side
    - side Side

|? side == edge
    PositionOffset.coord(-resizer-reach / 2)
|? side == edge.opposite
    null
??
    PositionOffset.coord(0)

━━━━━━━━━━━━━━━━━━━━
_ resizer-grow-key KeyCombo
    - edge Side

match edge
    | Side.left
        KeyCombo(Key.arrow-left)
    | Side.top
        KeyCombo(Key.arrow-up)
    | Side.bottom
        KeyCombo(Key.arrow-down)
    ??
        KeyCombo(Key.arrow-right)
