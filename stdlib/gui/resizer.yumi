────────────────────
+ do resize-to
    - length Length

note-natural-size()
size = max(min-size, min(max-size, length))
save-size()
announce-size()

────────────────────
_ do nudge
    - delta Length

. box = target
=? if !box
resize-to((size ?? current-size(box)) + delta)

────────────────────
_ dragged-size Length
    - press PointerDownEvent
    - drag PointerDragEvent

if grows-forward then start-size + delta else start-size - delta

.. delta = coordinate(drag.root-point) - coordinate(press.root-point)

────────────────────
_ collapses Bool
    - grown Length

collapse-size != null && grown < collapse-size

────────────────────
_ get store AppState?

gui-app-state(this)

────────────────────
_ get storage-key String?

"resizer:${state-key}" if state-key

────────────────────
_ do restore-size

. key = storage-key
. found = store
=? if !key || !found
. saved = found.read(key, 2)
=? if !saved
. fields = catch? JSONReader("resizer", saved).object()
=? if !fields
. length = catch? fields["size"].number()
. natural = catch? fields["natural"].number()
if natural != null
    natural-size = natural as Length
if length != null
    size = max(min-size, min(max-size, length as Length))

────────────────────
_ do save-size

. key = storage-key
. found = store
. length = size
=? if !key || !found || !length
. entry = Map'String'JSON
    • "size" length as F64
if natural-size
    entry["natural"] = natural-size as F64
found.write(key, 2, entry)

────────────────────
_ do announce-size

. length = size
if length
    resized <- length

────────────────────
_ do note-natural-size

=? if natural-size || size
. box = target
if box
    natural-size = current-size(box)

────────────────────
_ current-size Length
    - box Box

|? is-horizontal
    box.bounds.width - edges.left - edges.right
??
    box.bounds.height - edges.top - edges.bottom

.. edges = box.border-edges

────────────────────
_ coordinate Length
    - point Point

if is-horizontal then point.x else point.y

────────────────────
_ do size-changed

. box = target
. value = size
=? if !box || !value
. spec = SizeSpec.coord(value)
if is-horizontal
    box.min-width = spec
    box.max-width = spec
else
    box.min-height = spec
    box.max-height = spec

