(import ./box)
(import ./button)
(import ./commands)
(import ./events)
(import ./icons/lucide/check)
(import ./icons/lucide/chevron-down)
(import ./icons/lucide/chevron-right)
(import ./keys)
(import ./label)
(import ./placement)
(import ./popup)
(import ./primitives)
(import ./shorthands)
(import ./styles)
(import ./theme)
(import ./window)
(import /BxAppleGUI/BxAppleGUI.h)
(import /core/function)
(import /core/intrinsics)
(import /core/list-cursor)
(import /graphics/color)
(import /graphics/outline)
(import /graphics/primitives)
(import /graphics/style)
(import /graphics/text)
(import /stream/aggregate)
(import /time/duration)
(import /time/timer)
(import /ui/command)
(import /ui/input)
(import /ui/key-combo)
(import /ui/type-select)
(blank)
(prop _ submenu-close-delay _ (= 0.3s))
(prop _ submenu-open-delay _ (= 0.2s))

(style-extend GUIDefaultTheme
  (using GUIBoxMotion)
  (using GUIBoxPaint)
  (using GUIBoxCursor)
  (using GUIBoxPlacement)
  (using GUITextPaint)
  (using GUIFontStyle)
  (using GUIBoxSpacing)
  (using GUIBoxSize)
  (using GUIPopupStyle)
  (using VectorPaintStyle)
  (rule Menu (• bg gui-glass-color) (• text gui-text-color) (• p 5) (• min-w 190)
    (= window-material gui-glass-material)
    (= border-color gui-border-color)
    (= border-width 1)
    (= corner-radius gui-popup-radius)
    (= shadow gui-popup-shadow)
    (= font-family "")
    (= font-size gui-body-font-size)
    (= font-weight (. FontWeight regular))
    (= font-slant (. FontSlant upright))
    (= cursor (. CursorStyle arrow))
    (blank)
    (when-style #is-leaving
      (= animation popup-out)
    )
  )
  (blank)
  (rule MenuItem (• text gui-text-color) (• h 24) (• pl 4) (• pr 8)
    (= corner-radius gui-control-radius)
    (blank)
    (when-style #is-highlighted
      (• bg gui-accent-color)
      (• text gui-accent-text-color)
    )
    (blank)
    (rule menu-item-check (• w 12) (• h 12) (• mx 3)
      (= stroke-width 2)
    )
    (blank)
    (rule menu-item-icon
      (rule icon (• w gui-control-icon-size) (• h gui-control-icon-size) (• mr 6)
        (= align-y (. Alignment center))
      )
    )
    (blank)
    (rule menu-item-shortcut (• text gui-muted-text-color) (• ml 16))
    (blank)
    (rule menu-item-arrow (• text gui-muted-text-color) (• w 10) (• h 10) (• ml 4)
      (= stroke-width 2)
    )
  )
  (blank)
  (rule MenuSeparator (• h 9) (• px 6)
    (rule menu-separator-line (• bg gui-border-color) (• h 1) (• mt 4))
  )
  (blank)
  (rule MenuButton (• pl 10) (• pr 8)
    (when-style #is-open
      (= background-color (call (. gui-pressed-color over) gui-field-color))
    )
    (blank)
    (when-style #is-untitled
      (• pr 6)
      (rule menu-button-arrow (• ml 0))
    )
    (blank)
    (rule button-content
      (= align-x null)
    )
    (blank)
    (rule button-title (• flex 1))
    (blank)
    (rule menu-button-arrow (• text gui-muted-text-color) (• w 10) (• h 10) (• ml 6)
      (= stroke (. Stroke inherit))
      (= stroke-width 2.5)
    )
  )
  (blank)
  (rule MenuBar (• bg gui-window-color) (• h 26) (• px 6) (• py 2)
    (= border-color gui-divider-color)
    (= border-bottom-width 1)
  )
  (blank)
  (rule MenuBarItem (• bg transparent) (• px 10) (• h 26)
    (= shadow null)
    (when-style #is-hover-within
      (• bg gui-hover-color)
    )
    (blank)
    (when-style #is-press-within
      (• bg gui-hover-color)
    )
    (blank)
    (when-style #is-open
      (• bg gui-accent-color)
      (• text gui-accent-text-color)
    )
    (blank)
    (when-style (not #is-effectively-enabled)
      (• bg transparent)
    )
  )
)

(type + Menu (is Popup)
  (prop + highlighted (? MenuItem))
  (blank)
  (prop _ type-select _ (= (call TypeSelect)))
  (prop _ native (? Pointer))
  (prop _ native-entries (of List Box))
  (event _ highlight-moved Bool)
  (event _ submenu-left Menu)
  (event _ submenu-hovered Menu)
  (event _ submenu-kept Menu)
  (blank)
  (rule This (• transient) (• flex-col)
    (= focus-mode (. FocusMode keys))
    (= outside-press-passes false)
    (= overflow-y (. ScrollOverflow auto))
  )
  (content
    (<> This
      (= transform-origin #anchor-origin)
      (<> KeyShortcut (text: "Previous menu item")
        (= key .arrow-up)
        (= discoverable false)
        (= action (=> () :do (call move-highlight -1)))
      )
      (<> KeyShortcut (text: "Next menu item")
        (= key .arrow-down)
        (= discoverable false)
        (= action (=> () :do (call move-highlight 1)))
      )
      (<> KeyShortcut (text: "First menu item")
        (= key .home)
        (= discoverable false)
        (= action (=> () :do (call highlight-edge false)))
      )
      (<> KeyShortcut (text: "Last menu item")
        (= key .end)
        (= discoverable false)
        (= action (=> () :do (call highlight-edge true)))
      )
      (<> KeyShortcut (text: "Choose menu item")
        (= key .enter)
        (= repeat false)
        (= discoverable false)
        (= action (=> () :do (call activate-highlighted)))
      )
      (<> KeyShortcut (text: "Choose menu item")
        (= key .space)
        (= repeat false)
        (= discoverable false)
        (= action (=> () :do (call activate-highlighted)))
      )
      (<> KeyShortcut (text: "Open submenu")
        (= key .arrow-right)
        (= discoverable false)
        (= action (=> () :do (call move-right)))
      )
      (<> KeyShortcut (text: "Close submenu")
        (= key .arrow-left)
        (= discoverable false)
        (= action (=> () :do (call move-left)))
      )
    )
    (blank)
    (state is-open
      (prop _ submenu-closing _
        (machine
          (state idle
            (then (call closing submenu) (trigger for submenu submenu-left))
          )
          (blank)
          (state (call closing submenu)
            (then idle (trigger on (call Timer submenu-close-delay))
              (call close-submenu submenu)
            )
            (then (call closing next) (trigger for next submenu-left)
              (call close-submenu submenu)
            )
            (then idle (trigger on submenu-kept (== (as each Pointer) (as submenu Pointer))))
            (then idle (trigger on submenu-kept)
              (call close-submenu submenu)
            )
          )
        )
      )
      (blank)
      (prop _ submenu-opening _
        (machine
          (state idle)
          (blank)
          (state (call waiting submenu) (trigger for submenu submenu-hovered)
            (then idle (trigger on (call Timer submenu-open-delay))
              (if (not (. submenu is-open))
                (call (. submenu show))
              )
            )
            (then idle (trigger on highlight-moved))
            (then idle (trigger on submenu-kept))
          )
        )
      )
    )
  )
  (subscribe-for (on popup opened (when arrival))
    (for (in item items)
      (call (. item refresh-command-state))
    )
    (= (?. owner-button is-open) true)
  )
  (subscribe-for (on reason dismissed (when arrival))
    (call set-highlight null)
    (= (?. owner-button is-open) false)
  )
  (subscribe-for (on event key-press)
    (call type-select-key event)
  )
  (fn-expr + parent-menu (? Menu) :get
    (match? parent-popup
      (case (: menu Menu)
        menu
      )
    )
  )
  (fn-do + root-menu Menu :get
    (let cursor this)
    (while (. cursor parent-menu)
      (= cursor (!! (. cursor parent-menu)))
    )
    (return cursor)
  )
  (fn-expr + owner-item (? MenuItem) :get
    (match? layout-parent
      (case (: item MenuItem)
        item
      )
    )
  )
  (fn-do + items (list MenuItem) :get
    (let result (list MenuItem))
    (call collect-menu-items this result)
    (return result)
  )
  (fn-do + highlight _
    (param item (? MenuItem))
    (param from-pointer _ (= false))
    (call (?. parent-menu keep-submenu-open) owner-item)
    (return-if (if (== (as item (? Pointer)) (as highlighted (? Pointer)))))
    (blank)
    (let previous highlighted)
    (call set-highlight item)
    (<- highlight-moved true)
    (let entered (?. item submenu))
    (if (and entered (. entered is-open))
      (<- submenu-kept entered)
      (else-if (and entered from-pointer (. (!! item) is-enabled))
        (<- submenu-hovered entered)
      )
    )
    (let left (?. previous submenu))
    (if (and left (. left is-open))
      (if from-pointer
        (<- submenu-left left)
        (else
          (call (. left dismiss))
        )
      )
    )
    (if item
      (call ensure-visible item)
    )
  )
  (fn-do + keep-submenu-open _
    (param item (? MenuItem))
    (return-if (if (not item)))
    (blank)
    (let kept (. item submenu))
    (if kept
      (<- submenu-kept kept)
    )
    (if (!= (as highlighted (? Pointer)) (as item (? Pointer)))
      (call set-highlight item)
    )
    (call (?. parent-menu keep-submenu-open) owner-item)
  )
  (fn-do + move-highlight _
    (param offset Int)
    (let candidates enabled-items)
    (return-if (if (== (. candidates length) 0)))
    (blank)
    (let next (call (. (call ListCursor (. candidates length) (call highlighted-index candidates)) wrapped) offset))
    (call highlight ([] candidates (!! next)))
  )
  (fn-do + highlight-edge _
    (param last Bool)
    (let candidates enabled-items)
    (return-if (if (== (. candidates length) 0)))
    (blank)
    (call highlight (if-expr last ([] candidates (- (. candidates length) 1)) ([] candidates 0)))
  )
  (fn-do + activate-highlighted _
    (call (?. highlighted activate))
  )
  (fn-do + move-right _
    (let item highlighted)
    (if (and item (. item submenu) (. item is-enabled))
      (call open-submenu item)
      (return)
    )
    (call (?. (. root-menu owner-bar-item) move-bar) 1)
  )
  (fn-do + move-left _
    (if parent-menu
      (call dismiss (. DismissReason escape))
      (return)
    )
    (call (?. (. root-menu owner-bar-item) move-bar) -1)
  )
  (fn-do + open-submenu _
    (param item MenuItem)
    (let submenu (. item submenu))
    (return-if (if (not submenu)))
    (blank)
    (<- submenu-kept submenu)
    (call set-highlight item)
    (if (not (. submenu is-open))
      (call (. submenu show))
    )
    (call (. submenu highlight-edge) false)
  )
  (fn-do + choose _
    (param item MenuItem)
    (call (. root-menu dismiss) (. DismissReason chosen))
  )
  (fn-expr + owner-button (? MenuButton) :get
    (match? layout-parent
      (case (: button MenuButton)
        button
      )
    )
  )
  (fn-expr + owner-bar-item (? MenuBarItem) :get
    (match? layout-parent
      (case (: item MenuBarItem)
        item
      )
    )
  )
  (fn-do _ type-select-key _
    (param event KeyPressEvent)
    (let text (. event typed-text))
    (return-if (if (or (not text) (and (== text " ") (not (. type-select is-active))))))
    (blank)
    (let candidates enabled-items)
    (let found (call (. type-select find) text (call menu-item-titles candidates) (call highlighted-index candidates)))
    (if (!= found null)
      (call highlight ([] candidates found))
    )
    (call (. event cancel))
  )
  (fn-do _ close-submenu _
    (param submenu Menu)
    (if (. submenu is-open)
      (call (. submenu dismiss))
    )
  )
  (fn-do _ set-highlight _
    (param item (? MenuItem))
    (= (?. highlighted is-highlighted) false)
    (= highlighted item)
    (= (?. item is-highlighted) true)
  )
  (fn-expr _ enabled-items _ :get
    (spread items)
    (pipe ?> (. each is-enabled))
    (pipe |> List)
  )
  (fn-do _ highlighted-index (? Index)
    (param candidates (list MenuItem))
    (return-if (if (not highlighted)))
    (blank)
    (for (in index (..< 0 (. candidates length)))
      (return-if index (if (== (as ([] candidates index) Pointer) (as highlighted Pointer))))
    )
  )
  (fn-do + native-menu Pointer
    (if (not native)
      (= native (call C:brixGuiMenuCreate "" (as gui-menu-native-event GuiMenuCallback) (as this Pointer)))
    )
    (return (!! native))
  )
  (fn-do + sync-native _
    (return-if (if (not native)))
    (blank)
    (for (in item items)
      (call (. item refresh-command-state))
    )
    (let entries (call (of List Box)))
    (call collect-native-menu-entries this entries)
    (= native-entries entries)
    (call C:brixGuiMenuRemoveAllItems (!! native))
    (for (in entry entries)
      (if (is entry MenuItem)
        (call add-native-item (as entry MenuItem))
        (else
          (call C:brixGuiMenuAddSeparator (!! native))
        )
      )
    )
  )
  (fn-do + choose-native _
    (param index Index)
    (return-if (if (>= index (. native-entries length))))
    (blank)
    (let entry ([] native-entries index))
    (if (is entry MenuItem)
      (call (. (as entry MenuItem) activate))
    )
  )
  (fn-do + release-native _
    (let menu native)
    (= native null)
    (= native-entries (call (of List Box)))
    (if menu
      (call C:brixGuiMenuRelease menu)
    )
  )
  (fn-do _ add-native-item _
    (param item MenuItem)
    (let key (. item native-key))
    (let characters "")
    (let key-kind U32)
    (let modifiers U64)
    (if key
      (match? (. key trigger)
        (case (call (. KeyTrigger characters) text)
          (= characters text)
        )
        (case (call (. KeyTrigger key) pressed)
          (= key-kind (call key-to-native pressed))
        )
      )
      (= modifiers (call pointer-modifiers-to-native (. key modifiers)))
    )
    (let submenu (. item submenu))
    (call C:brixGuiMenuAddItem
      (block
        (arg (!! native))
        (arg (. item display-title))
        (arg characters)
        (arg key-kind)
        (arg modifiers)
        (arg (. item is-enabled))
        (arg (. item is-on))
        (arg (call menu-role-code (. item role)))
        (arg (if-expr submenu (call (. submenu native-menu)) (call Pointer)))
      )
    )
  )
  (fn-do + unmounted _
    (call release-native)
    (call (. super unmounted))
  )
  (fn-expr + default-placement _ :get
    (match anchor
      (case (. PopupAnchor point)
        (call PointPlacement)
      )
      (case (. PopupAnchor pointer)
        (call PointPlacement)
      )
      (default
        (if-expr owner-item submenu-placement (call AnchoredPlacement))
      )
    )
    (where
      (lazy submenu-placement (call AnchoredPlacement (. Side right) (. AnchorPoint start) 0 -6))
    )
  )
)

(type + ContextMenu (is Menu)
  (rule This
    (= context-trigger true)
    (blank)
    (when-style #is-leaving
      (= animation null)
    )
  )
)

(type + MenuRole (is Union)
  (variant undo)
  (variant redo)
  (variant cut)
  (variant copy)
  (variant paste)
  (variant paste-and-match-style)
  (variant delete)
  (variant select-all)
  (variant find)
  (variant settings)
  (variant minimize)
  (variant zoom)
  (variant close-window)
  (variant bring-all-to-front)
  (variant toggle-full-screen)
  (variant zoom-in)
  (variant zoom-out)
  (variant actual-size)
)

(type + MenuItem (is Box)
  (prop + title _ (= ""))
  (prop + key (? KeyCombo))
  (prop + command (? Command))
  (prop + action (? Doer))
  (prop + role (? MenuRole))
  (prop + is-on _ (= false))
  (prop + is-highlighted _ (= false))
  (prop + has-submenu _ (= false))
  (blank)
  (prop _ implied-title _ (= ""))
  (prop _ implied-shortcut _ (= ""))
  (blank)
  (depends hover-changed is-hover-within)
  (blank)
  (rule menu-item-leading)
  (rule menu-item-trailing)
  (fn-do + This _
    (param title _ (= ""))
  )
  (content
    (<> This (• flex-row)
      (<> LucideCheck (• icon) (• menu-item-check)
        (= align-y (. Alignment center))
        (= display (if-expr #is-on (. Display visible) (. Display invisible)))
      )
      (<> Box (• menu-item-icon) (• icon-host) (• flex-row)
        (= align-y (. Alignment center))
      )
      (+<> Box (id: leading) (• menu-item-leading)
        (= align-y (. Alignment center))
      )
      (<> Label (id: title-label)
        (= align-y (. Alignment center))
        (= text (if-expr #title #title #implied-title))
      )
      (<> Box (• flex 1))
      (+<> Box (id: trailing) (• menu-item-trailing) (• flex-row)
        (= align-y (. Alignment center))
      )
      (<> Label (id: shortcut-label) (• menu-item-shortcut)
        (= align-y (. Alignment center))
        (= text-alignment (. TextAlignment right))
        (= text (if-expr #key (. #key symbol-label) #implied-shortcut))
        (= display (if-expr (or #key (> (. #implied-shortcut length) 0)) (. Display visible) (. Display hidden)))
      )
      (<> LucideChevronRight (• icon) (• menu-item-arrow)
        (= align-y (. Alignment center))
        (= display (if-expr #has-submenu (. Display visible) (. Display hidden)))
      )
    )
  )
  (subscribe-for (on event click)
    (call activate)
    (call (. event cancel))
  )
  (fn-do + hover-changed _
    (if is-hover-within
      (call (?. menu highlight) this true)
    )
  )
  (fn-expr + display-title String :get
    (if-expr title title implied-title)
  )
  (fn-expr + menu (? Menu) :get
    (match layout-parent
      (case (: owner Menu)
        owner
      )
      (default
        (call (of ancestor Menu))
      )
    )
  )
  (fn-expr + submenu _ :get
    (call first-child-menu this)
  )
  (fn-do + activate _
    (return-if (if (not is-effectively-enabled)))
    (blank)
    (let owner menu)
    (if submenu
      (call (?. owner open-submenu) this)
      (return)
    )
    (if role
      (call C:brixGuiMenuPerformRole (call menu-role-code role))
    )
    (if (and command (. command is-available))
      (call (. command run))
    )
    (let callback action)
    (if callback
      (call callback
        (block
          (on-error (: error Error)
            (call unhandled-error error)
          )
        )
      )
    )
    (call (?. owner choose) this)
  )
  (fn-expr + native-key _ :get
    (case? role
      (call menu-role-key role)
    )
    (case? key
      key
    )
    (case? (not source)
      null
    )
    (default
      (call menu-command-key this source)
    )
    (where
      (lazy source command)
    )
  )
  (fn-do + refresh-command-state _
    (= has-submenu (!= submenu null))
    (let source command)
    (if role
      (= implied-title (call menu-role-title role))
      (= implied-shortcut (?? (?. (call menu-role-key (!! role)) symbol-label) ""))
      (else-if source
        (= implied-title (. source title))
        (= implied-shortcut (call menu-command-shortcut this source))
      )
    )
    (return-if (if (not source)))
    (blank)
    (= is-enabled (. source is-available))
    (= is-on (. source is-on))
  )
)

(type + MenuSeparator (is Box)
  (content
    (<> This (• flex-col)
      (<> Box (• menu-separator-line))
    )
  )
)

(type + MenuButton (is Button)
  (prop + shows-arrow _ (= true))
  (prop + is-open _ (= false))
  (blank)
  (rule This
    (rule menu-button-arrow
      (= align-y (. Alignment center))
    )
    (blank)
    (when-style #shows-arrow
      (rule button-title
        (<> LucideChevronDown (slot: after) (• menu-button-arrow))
      )
    )
  )
  (fn-do + This _
    (param title _ (= ""))
  )
  (content
    (<> This
      (<> KeyShortcut (text: "Open menu")
        (= key .arrow-down)
        (= discoverable false)
        (= action (=> () :do (call open-menu)))
      )
    )
  )
  (subscribe-for (on event pointer-down)
    (if is-effectively-enabled
      (call (?. menu toggle-on-press) event)
    )
  )
  (subscribe-for (on event click)
    (if is-effectively-enabled
      (call (?. menu toggle-on-click) event)
    )
  )
  (fn-expr + menu _ :get
    (call first-child-menu this)
  )
  (fn-do + open-menu _
    (let popup menu)
    (return-if (if (or (not is-effectively-enabled) (not popup) (. popup is-open))))
    (blank)
    (call (. popup show))
  )
)

(type + MenuBar (is Box)
  (prop + is-native _ (= true))
  (blank)
  (prop _ native (? Pointer))
  (content
    (<> This (• flex-row)
      (= display (if-expr #is-native (. Display hidden) (. Display visible)))
    )
  )
  (fn-expr + bar-items _ :get
    (spread rendered-children)
    (pipe ?*> (only-if (as each MenuBarItem) (if (is each MenuBarItem))))
    (pipe |> List)
  )
  (fn-expr + has-open-menu Bool :get
    (call some bar-items (:where (. each is-open)))
  )
  (fn-do + move-from _
    (param item MenuBarItem)
    (param offset Int)
    (let items bar-items)
    (return-if (if (== (. items length) 0)))
    (blank)
    (let index Int)
    (for (in candidate (..< 0 (. items length)))
      (if (== (as ([] items candidate) Pointer) (as item Pointer))
        (= index candidate)
      )
    )
    (let next (% (+ index offset (. items length)) (. items length)))
    (call (. ([] items next) open-menu))
    (call (?. (. ([] items next) menu) highlight-edge) false)
  )
  (fn-expr + host-window _ :get
    (only-if (as host Window) (if host))
    (where
      (lazy host window)
    )
  )
  (fn-do + sync-native _
    (return-if (if (not native)))
    (blank)
    (call C:brixGuiMenuRemoveAllItems native)
    (for (in item bar-items)
      (let menu (. item menu))
      (if menu
        (call C:brixGuiMenuAddItem
          (block
            (arg (!! native))
            (arg (. item title))
            (arg "")
            (arg 0)
            (arg 0)
            (arg (. item is-enabled))
            (arg false)
            (arg 0)
            (arg (call (. menu native-menu)))
          )
        )
      )
    )
  )
  (fn-do + attach-native _
    (let host host-window)
    (return-if (if (or (not is-native) (not host))))
    (blank)
    (if (not native)
      (= native (call C:brixGuiMenuBarCreate))
    )
    (call sync-native)
    (= (. host native-menu-bar) native)
    (if (. host is-active)
      (call C:brixGuiMenuBarInstall (!! native))
    )
  )
  (fn-do + detach-native _
    (let bar native)
    (return-if (if (not bar)))
    (blank)
    (= native null)
    (let host host-window)
    (if (and host (== (. host native-menu-bar) bar))
      (= (. host native-menu-bar) null)
    )
    (call C:brixGuiMenuBarUninstall bar)
    (call C:brixGuiMenuRelease bar)
  )
  (fn-do + mounted _
    (call (. super mounted))
    (call attach-native)
  )
  (fn-do + unmounted _
    (call detach-native)
    (call (. super unmounted))
  )
)

(type + MenuBarItem (is MenuButton)
  (fn-do + This _
    (param title _ (= ""))
    (= shows-arrow false)
  )
  (subscribe-for (on event pointer-move)
    (let bar (call (of ancestor MenuBar)))
    (if (and bar (not is-open) (. bar has-open-menu))
      (call open-menu)
    )
  )
  (fn-do + move-bar _
    (param offset Int)
    (call (?. (call (of ancestor MenuBar)) move-from) this offset)
  )
)

(fn-do + first-child-menu (? Menu)
  (param node GuiNode)
  (let child (. node %first-child))
  (while child
    (let current child)
    (return-if (as current Menu) (if (is current Menu)))
    (blank)
    (if (. current is-gui-transparent)
      (let nested (call first-child-menu current))
      (return-if nested (if nested))
    )
    (= child (. current %next-sibling))
  )
)

(fn-do _ collect-native-menu-entries _
  (param node GuiNode)
  (param result (of List Box))
  (let child (. node %first-child))
  (while child
    (let current child)
    (if (or (is current MenuItem) (is current MenuSeparator))
      (if (. (as current Box) is-displayed)
        (+= result (as current Box))
      )
      (else-if (or (. current is-gui-transparent) (and (is current Box) (not (is current Popup))))
        (call collect-native-menu-entries current result)
      )
    )
    (= child (. current %next-sibling))
  )
)

(type + GuiMenuCallback (is (c-fn-type Void (param menu-pointer Pointer) (param event-kind U32) (param index U64))))

(fn-do + gui-menu-native-event _
  (param menu-pointer Pointer)
  (param event-kind U32)
  (param index U64)
  (let menu (call (of gc-object-from-pointer Menu) menu-pointer))
  (if (== event-kind 0)
    (call (. menu sync-native))
    (else
      (call (. menu choose-native) (as index Index))
    )
  )
)

(fn-expr _ menu-item-titles _
  (param items (list MenuItem))
  (spread items)
  (pipe *> (. each display-title))
  (pipe |> List)
)

(fn-do _ collect-menu-items _
  (param node GuiNode)
  (param result (list MenuItem))
  (let child (. node %first-child))
  (while child
    (let current child)
    (if (is current MenuItem)
      (if (. (as current MenuItem) is-displayed)
        (+= result (as current MenuItem))
      )
      (else-if (or (. current is-gui-transparent) (and (is current Box) (not (is current Popup))))
        (call collect-menu-items current result)
      )
    )
    (= child (. current %next-sibling))
  )
)

(fn-expr + menu-command-shortcut _
  (param item MenuItem)
  (param command Command)
  (match (. item window)
    (case (: host Window)
      (call (. ", " join)
        (:stream
          (block
            (spread (. host registered-key-bindings))
            (pipe ?*> (call menu-binding-label each command))
          )
        )
      )
    )
    (default
      ""
    )
  )
)

(fn-do + menu-command-key _
  (param item MenuItem)
  (param command Command)
  (let host (. item window))
  (return-if (if (or (not host) (not (is host Window)))))
  (blank)
  (for (in binding (. (as host Window) registered-key-bindings))
    (let target (. binding command-target))
    (if (and target (== (. target identity) (. command identity)) (!= (. binding key trigger) (. KeyTrigger none)))
      (return (. binding key))
    )
  )
)

(fn-expr _ menu-binding-label _
  (param binding KeyBinding)
  (param command Command)
  (case? (or (not target) (!= (. target identity) (. command identity)))
    null
  )
  (case? (not label)
    null
  )
  (default
    label
  )
  (where
    (lazy target (. binding command-target))
    (lazy label (. binding symbol-label))
  )
)

(fn-expr + menu-role-title _
  (param role MenuRole)
  (match role
    (case (. MenuRole undo)
      "Undo"
    )
    (case (. MenuRole redo)
      "Redo"
    )
    (case (. MenuRole cut)
      "Cut"
    )
    (case (. MenuRole copy)
      "Copy"
    )
    (case (. MenuRole paste)
      "Paste"
    )
    (case (. MenuRole paste-and-match-style)
      "Paste and Match Style"
    )
    (case (. MenuRole delete)
      "Delete"
    )
    (case (. MenuRole select-all)
      "Select All"
    )
    (case (. MenuRole find)
      "Find…"
    )
    (case (. MenuRole settings)
      "Settings…"
    )
    (case (. MenuRole minimize)
      "Minimize"
    )
    (case (. MenuRole zoom)
      "Zoom"
    )
    (case (. MenuRole close-window)
      "Close Window"
    )
    (case (. MenuRole bring-all-to-front)
      "Bring All to Front"
    )
    (case (. MenuRole toggle-full-screen)
      "Enter Full Screen"
    )
    (case (. MenuRole zoom-in)
      "Zoom In"
    )
    (case (. MenuRole zoom-out)
      "Zoom Out"
    )
    (case (. MenuRole actual-size)
      "Actual Size"
    )
  )
)

(fn-expr + menu-role-key (? KeyCombo)
  (param role MenuRole)
  (match? role
    (case (. MenuRole undo)
      undo-key
    )
    (case (. MenuRole redo)
      redo-key
    )
    (case (. MenuRole cut)
      cut-key
    )
    (case (. MenuRole copy)
      copy-key
    )
    (case (. MenuRole paste)
      paste-key
    )
    (case (. MenuRole paste-and-match-style)
      (call KeyCombo "Option+Shift+Cmd+V")
    )
    (case (. MenuRole select-all)
      (call KeyCombo "Cmd+A")
    )
    (case (. MenuRole find)
      (call KeyCombo "Cmd+F")
    )
    (case (. MenuRole settings)
      (call KeyCombo "Cmd+,")
    )
    (case (. MenuRole minimize)
      (call KeyCombo "Cmd+M")
    )
    (case (. MenuRole close-window)
      (call KeyCombo "Cmd+W")
    )
    (case (. MenuRole toggle-full-screen)
      (call KeyCombo "Ctrl+Cmd+F")
    )
    (case (. MenuRole zoom-in)
      (+ (. KeyModifier command) "=")
    )
    (case (. MenuRole zoom-out)
      (+ (. KeyModifier command) "-")
    )
    (case (. MenuRole actual-size)
      (+ (. KeyModifier command) "0")
    )
  )
)

(fn-expr _ menu-role-code U32
  (param role (? MenuRole))
  (match role
    (case (. MenuRole undo)
      1
    )
    (case (. MenuRole redo)
      2
    )
    (case (. MenuRole cut)
      3
    )
    (case (. MenuRole copy)
      4
    )
    (case (. MenuRole paste)
      5
    )
    (case (. MenuRole select-all)
      6
    )
    (case (. MenuRole minimize)
      7
    )
    (case (. MenuRole zoom)
      8
    )
    (case (. MenuRole close-window)
      9
    )
    (case (. MenuRole bring-all-to-front)
      10
    )
    (case (. MenuRole toggle-full-screen)
      11
    )
    (case (. MenuRole delete)
      12
    )
    (case (. MenuRole paste-and-match-style)
      13
    )
    (case (. MenuRole zoom-in)
      14
    )
    (case (. MenuRole zoom-out)
      15
    )
    (case (. MenuRole actual-size)
      16
    )
    (default
      0
    )
  )
)
