(import ./box)
(import ./label)
(import ./primitives)
(import ./shorthands)
(import ./styles)
(import ./theme)
(import /graphics/color)
(import /graphics/primitives)
(import /math)
(import /time/duration)
(blank)
(prop _ progress-bar-height Length (= 6))
(prop _ progress-bar-radius Length (= 3))
(prop _ progress-sweep-width F64 (= 0.3))
(prop _ progress-sweep-period _ (= 1.2s))

(style-extend GUIDefaultTheme
  (using GUIBoxPaint)
  (using GUITextPaint)
  (using GUIBoxSize)
  (using GUIBoxSpacing)
  (rule ProgressBar (• flex-col)
    (= window-draggable false)
    (blank)
    (rule progress-caption (• flex-row) (• mb 4))
    (blank)
    (rule progress-percent (• text gui-muted-text-color) (• ml 8))
    (blank)
    (rule progress-track (• flex-row) (• bg gui-track-color) (• h progress-bar-height)
      (= corner-radius progress-bar-radius)
    )
    (blank)
    (rule progress-fill (• bg gui-accent-color) (• h progress-bar-height)
      (= corner-radius progress-bar-radius)
    )
  )
)

(type + ProgressBar (is Box)
  (prop + value F64)
  (prop + minimum F64)
  (prop + maximum F64 (= 1))
  (prop + is-indeterminate _ (= false))
  (prop + label _ (= ""))
  (prop + shows-percent _ (= false))
  (blank)
  (prop _ fill-start F64)
  (prop _ fill-length F64)
  (event _ sweep-requests Bool)
  (blank)
  (depends fill-changed value minimum maximum)
  (depends sweep-changed is-indeterminate)
  (content
    (<> This
      (if (or (. #label length) #shows-percent)
        (<> Box (• progress-caption)
          (<> Label (• flex 1)
            (= text #label)
          )
          (if (and #shows-percent (not #is-indeterminate))
            (<> Label (• progress-percent)
              (= text (str (as (call round (* #fill-length 100)) Int) "%"))
            )
          )
        )
      )
      (<> Box (• progress-track)
        (<> Box
          (= flex #fill-start)
        )
        (<> Box (• progress-fill)
          (= flex #fill-length)
        )
        (<> Box
          (= flex (- 1 #fill-start #fill-length))
        )
      )
    )
    (blank)
    (state is-filling
      (call fill-changed)
      (blank)
      (then is-sweeping (trigger on sweep-requests each))
    )
    (blank)
    (state is-sweeping
      (call advance-sweep 0)
      (blank)
      (for (on tick frames)
        (call advance-sweep (. tick elapsed))
      )
      (blank)
      (then is-filling (trigger on sweep-requests (not each)))
    )
  )
  (fn-do + mounted _
    (call (. super mounted))
    (call sweep-changed)
  )
  (fn-do + unmounted _
    (<- sweep-requests false)
    (call (. super unmounted))
  )
  (fn-expr + fraction F64 :get
    (call progress-fraction value minimum maximum)
  )
  (fn-do _ fill-changed _
    (return-if (if is-sweeping))
    (= fill-start 0)
    (= fill-length fraction)
  )
  (fn-do _ sweep-changed _
    (<- sweep-requests (and is-indeterminate (!= window null)))
  )
  (fn-do _ advance-sweep _
    (param elapsed Nanoseconds)
    (let period (as (as progress-sweep-period Nanoseconds) F64))
    (let phase (/ (% (as elapsed F64) period) period))
    (let lead (- (* phase (+ 1 progress-sweep-width)) progress-sweep-width))
    (= fill-start (call max 0 lead))
    (= fill-length (- (call min 1 (+ lead progress-sweep-width)) fill-start))
  )
)

(fn-expr + progress-fraction F64
  (param value F64)
  (param minimum F64)
  (param maximum F64)
  (case? (or (not (call is-finite value)) (not (call is-finite minimum)) (not (call is-finite maximum)) (<= maximum minimum))
    0
  )
  (default
    (call min 1 (call max 0 (/ (- value minimum) (- maximum minimum))))
  )
)
