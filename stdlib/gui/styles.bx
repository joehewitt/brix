(type + GUIBoxPaint (is Style)
  (prop + background-color (? RGBA) (= null))
  (prop + background-fill (? ShaderFill) (= null))
  (prop + background (? Painter) (= null))
  (prop + background-image (? Image) (= null))
  (prop + background-fit _ (= (. ImageFit none)))
  (prop + background-align-x _ (= (. AnchorPoint center)))
  (prop + background-align-y _ (= (. AnchorPoint center)))
  (prop + background-repeat _ (= (. ImageRepeat none)))
  (prop + background-sampling _ (= (. ImageSampling smooth)))
  (prop + border BorderPainter (= (call DefaultBorderPainter)))
  (prop + border-color (? RGBA) (= null))
  (prop + border-fill (? ShaderFill) (= null))
  (prop + border-width Length (= 0))
  (prop + border-top-width (? Length))
  (prop + border-right-width (? Length))
  (prop + border-bottom-width (? Length))
  (prop + border-left-width (? Length))
  (prop + corner-radius Length (= 0))
  (prop + shape (? BoxShape) (= null))
  (prop + shadow (? Shadow) (= null))
  (prop + backdrop-blur (? Length) (= null))
  (prop + backdrop (? ShaderBackdrop) (= null))
  (prop + filters (list ShaderFilter))
  (prop + mask (? ShaderMask) (= null))
  (prop + window-material (? WindowMaterial) (= null))
  (prop + caches-raster _ (= false))
  (blank)
  (style-domains background-color (domain paint))
  (style-domains background-fill (domain paint))
  (style-domains background (domain paint))
  (style-domains background-image (domain paint))
  (style-domains background-fit (domain paint))
  (style-domains background-align-x (domain paint))
  (style-domains background-align-y (domain paint))
  (style-domains background-repeat (domain paint))
  (style-domains background-sampling (domain paint))
  (style-domains border (domain layout) (domain layout parent) (domain paint))
  (style-domains border-color (domain paint))
  (style-domains border-fill (domain paint))
  (style-domains border-width (domain layout) (domain layout parent) (domain paint))
  (style-domains border-top-width (domain layout) (domain layout parent) (domain paint))
  (style-domains border-right-width (domain layout) (domain layout parent) (domain paint))
  (style-domains border-bottom-width (domain layout) (domain layout parent) (domain paint))
  (style-domains border-left-width (domain layout) (domain layout parent) (domain paint))
  (style-domains corner-radius (domain paint))
  (style-domains shape (domain paint))
  (style-domains shadow (domain paint))
  (style-domains backdrop-blur (domain paint))
  (style-domains backdrop (domain paint))
  (style-domains filters (domain composite) (domain paint))
  (style-domains mask (domain composite) (domain paint))
  (style-domains window-material (domain paint))
  (style-domains caches-raster (domain paint))
)

(type + FocusRing (is Tuple)
  (implements Animatable)
  (prop + color RGBA)
  (prop + width Length (= 2))
  (prop + offset Length (= 2))
  (fn-do + This _
    (param vector (list F64))
    (return (call This (call RGBA (list ([] vector 0) ([] vector 1) ([] vector 2) ([] vector 3))) (call max 0.0 ([] vector 4)) ([] vector 5)))
  )
  (fn-expr + motion-vector (list F64) :get
    (list ([] paint 0) ([] paint 1) ([] paint 2) ([] paint 3) (as width F64) (as offset F64))
    (where
      (lazy paint (. color motion-vector))
    )
  )
  (fn-expr + motion-none-vector (list F64) :get
    (list 0.0 0.0 0.0 0.0 (as width F64) (as offset F64))
  )
)

(type + GUIFocusRingStyle (is Style)
  (prop + focus-ring (? FocusRing) (= null))
  (blank)
  (style-domains focus-ring (domain paint))
)

(type + GUITextPaint (is Style)
  (prop + color RGBA @inherited (= (call RGBA "#e2e2df")))
  (prop + text-fill (? ShaderFill) (= null))
  (blank)
  (style-domains color (domain paint))
  (style-domains text-fill (domain paint))
)

(type + GUIFontStyle (is Style)
  (prop + font-family String @inherited (= ""))
  (prop + font-size Length @inherited (= 13))
  (prop + font-weight FontWeight @inherited (= (. FontWeight regular)))
  (prop + font-slant FontSlant @inherited (= (. FontSlant upright)))
  (blank)
  (style-domains font-family (domain layout) (domain layout parent) (domain paint))
  (style-domains font-size (domain layout) (domain layout parent) (domain paint))
  (style-domains font-weight (domain layout) (domain layout parent) (domain paint))
  (style-domains font-slant (domain layout) (domain layout parent) (domain paint))
)

(type + GUIParagraphStyle (is Style)
  (prop + text-alignment TextAlignment @inherited (= (. TextAlignment left)))
  (prop + line-spacing Length @inherited (= 0))
  (blank)
  (style-domains text-alignment (domain layout) (domain paint))
  (style-domains line-spacing (domain layout) (domain layout parent) (domain paint))
)

(type + GUITextComposition (is Style)
  (prop + text-overflow TextOverflow (= (. TextOverflow truncate-tail)))
  (prop + text-wrap TextWrap (= (. TextWrap no-wrap)))
  (prop + text-wrap-sizing TextWrapSizing (= (. TextWrapSizing available)))
  (blank)
  (style-domains text-overflow (domain layout) (domain layout parent) (domain paint))
  (style-domains text-wrap (domain layout) (domain layout parent) (domain paint))
  (style-domains text-wrap-sizing (domain layout) (domain layout parent) (domain paint))
)

(type + GUIBoxDisplay (is Style)
  (prop + display Display (= (. Display visible)))
  (blank)
  (style-domains display (domain layout) (domain layout parent) (domain active-list parent) (domain paint))
)

(type + GUIBoxCursor (is Style)
  (prop + cursor CursorStyle @inherited (= (. CursorStyle automatic)))
  (prop + drag-cursor (? CursorStyle) (= null))
  (blank)
  (style-domains cursor (domain cursor))
  (style-domains drag-cursor (domain cursor))
)

(type + GUIBoxComposite (is Style)
  (prop + layer (? String) (= null))
  (blank)
  (style-domains layer (domain composite) (domain paint))
)

(type + GUIBoxTransform (is Style)
  (prop + opacity Ratio (= 1%%))
  (prop + translate _ (= (call Point 0 0)))
  (prop + scale _ (= 1.0))
  (prop + rotate Radians (= 0rad))
  (prop + transform-origin _ (= (call Point 0.5 0.5)))
  (prop + transform (? Matrix) (= null))
  (blank)
  (style-domains opacity (domain presentation) (domain vector-composite))
  (style-domains translate (domain presentation))
  (style-domains scale (domain presentation))
  (style-domains rotate (domain presentation))
  (style-domains transform-origin (domain presentation))
  (style-domains transform (domain presentation))
)

(type + GUIBoxMotion (is Style)
  (prop + animation (? KeyframeAnimation) (= null))
  (prop + timeline (? AnimationTimeline) (= null))
  (prop + enter-space _ (= (. EnterSpace claim)))
  (prop + leave-space _ (= (. LeaveSpace keep)))
  (prop + motion-stagger (? Duration) (= null))
  (prop + resize-content _ (= (. ResizeContent reveal)))
  (prop + stack-motion _ (= (. StackMotion free)))
  (prop + match (? String) (= null))
  (prop + match-content _ (= (. MatchContent replace)))
  (prop + swap-transition (? ShaderTransition) (= null))
  (prop + motion (? Motion) (= null))
  (prop + motion.layout (? Motion) (= null))
  (prop + motion.position (? Motion) (= null))
  (prop + motion.size (? Motion) (= null))
  (prop + motion.transform (? Motion) (= null))
  (prop + motion.background-color (? Motion) (= null))
  (prop + motion.background-fill (? Motion) (= null))
  (prop + motion.border-color (? Motion) (= null))
  (prop + motion.border-fill (? Motion) (= null))
  (prop + motion.border-width (? Motion) (= null))
  (prop + motion.corner-radius (? Motion) (= null))
  (prop + motion.shadow (? Motion) (= null))
  (prop + motion.backdrop-blur (? Motion) (= null))
  (prop + motion.backdrop (? Motion) (= null))
  (prop + motion.mask (? Motion) (= null))
  (prop + motion.swap-transition (? Motion) (= null))
  (prop + motion.focus-ring (? Motion) (= null))
  (prop + motion.color (? Motion) (= null))
  (prop + motion.text-fill (? Motion) (= null))
  (prop + motion.opacity (? Motion) (= null))
  (prop + motion.translate (? Motion) (= null))
  (prop + motion.scale (? Motion) (= null))
  (prop + motion.rotate (? Motion) (= null))
  (prop + motion.scroll-indicator-color (? Motion) (= null))
  (prop + motion.flex (? Motion) (= null))
  (prop + motion.gap (? Motion) (= null))
  (prop + motion.padding-top (? Motion) (= null))
  (prop + motion.padding-right (? Motion) (= null))
  (prop + motion.padding-bottom (? Motion) (= null))
  (prop + motion.padding-left (? Motion) (= null))
  (prop + motion.margin-top (? Motion) (= null))
  (prop + motion.margin-right (? Motion) (= null))
  (prop + motion.margin-bottom (? Motion) (= null))
  (prop + motion.margin-left (? Motion) (= null))
  (prop + animates-fills _ (= true))
  (blank)
  (style-domains animates-fills (domain paint))
)

(type + GUIBoxWindowDrag (is Style)
  (prop + window-draggable _ @inherited (= false))
)

(type + GUIBoxFocus (is Style)
  (prop + focus-mode _ (= (. FocusMode none)))
  (prop + focus-group _ (= false))
  (prop + focus-default _ (= false))
  (prop + focus-home _ (= false))
  (prop + claims-focus _ @inherited (= false))
  (prop + keeps-focus _ @inherited (= false))
  (blank)
  (style-domains focus-mode (domain paint))
  (style-domains focus-home (domain paint))
)

(type + GUIBoxPlacement (is Style)
  (prop + flex Float)
  (prop + shrink Float)
  (prop + position (? Position) (= null))
  (prop + anchor Anchor (= (. Anchor parent)))
  (prop + left (? PositionOffset) (= null))
  (prop + top (? PositionOffset) (= null))
  (prop + right (? PositionOffset) (= null))
  (prop + bottom (? PositionOffset) (= null))
  (prop + align-x (? Alignment) (= null))
  (prop + align-y (? Alignment) (= null))
  (blank)
  (style-domains flex (domain layout parent))
  (style-domains shrink (domain layout parent))
  (style-domains position (domain layout parent) (domain active-list parent))
  (style-domains anchor (domain layout parent))
  (style-domains left (domain layout parent))
  (style-domains top (domain layout parent))
  (style-domains right (domain layout parent))
  (style-domains bottom (domain layout parent))
  (style-domains align-x (domain layout parent))
  (style-domains align-y (domain layout parent))
)

(type + GUIBoxSpacing (is Style)
  (prop + margin-top Length (= 0))
  (prop + margin-right Length (= 0))
  (prop + margin-bottom Length (= 0))
  (prop + margin-left Length (= 0))
  (prop + padding-top Length (= 0))
  (prop + padding-right Length (= 0))
  (prop + padding-bottom Length (= 0))
  (prop + padding-left Length (= 0))
  (blank)
  (style-domains margin-top (domain layout parent))
  (style-domains margin-right (domain layout parent))
  (style-domains margin-bottom (domain layout parent))
  (style-domains margin-left (domain layout parent))
  (style-domains padding-top (domain layout) (domain layout parent))
  (style-domains padding-right (domain layout) (domain layout parent))
  (style-domains padding-bottom (domain layout) (domain layout parent))
  (style-domains padding-left (domain layout) (domain layout parent))
)

(type + GUIInlineOutset (is Style)
