  (prop + min-height SizeSpec (= (. SizeSpec auto)))
  (prop + max-height SizeSpec (= (. SizeSpec auto)))
  (blank)
  (style-domains min-width (domain layout) (domain layout parent))
  (style-domains max-width (domain layout) (domain layout parent))
  (style-domains min-height (domain layout) (domain layout parent))
  (style-domains max-height (domain layout) (domain layout parent))
)

(type + GUIBoxLayout (is Style)
  (prop + layout (? Layout) (= null))
  (prop + gap Length (= 0))
  (prop + align-children _ (= (. Alignment stretch)))
  (prop + justify _ (= (. Justify start)))
  (blank)
  (style-domains layout (domain layout) (domain layout parent))
  (style-domains gap (domain layout) (domain layout parent))
  (style-domains align-children (domain layout))
  (style-domains justify (domain layout))
)

(type + GUIBoxScroll (is Style)
  (prop + overflow-x ScrollOverflow (= (. ScrollOverflow visible)))
  (prop + overflow-y ScrollOverflow (= (. ScrollOverflow visible)))
  (prop + overflow-clip-margin Length (= 0))
  (prop + overscroll-behavior-x OverscrollBehavior (= (. OverscrollBehavior auto)))
  (prop + overscroll-behavior-y OverscrollBehavior (= (. OverscrollBehavior auto)))
  (prop + scroll-indicator-x ScrollIndicatorVisibility (= (. ScrollIndicatorVisibility auto)))
  (prop + scroll-indicator-y ScrollIndicatorVisibility (= (. ScrollIndicatorVisibility auto)))
  (prop + scroll-indicator-gutter ScrollIndicatorGutter (= (. ScrollIndicatorGutter overlay)))
  (prop + scroll-indicator-color (? RGBA))
  (prop + scroll-indicator-thickness Length (= 6))
  (prop + scroll-indicator-inset Length (= 2))
  (prop + scroll-indicator-min-length Length (= 18))
  (prop + scroll-anchor _ (= (. ScrollAnchor none)))
  (prop + scroll-blur (? Ratio) (= null))
  (blank)
  (style-domains overflow-x (domain layout) (domain paint))
  (style-domains overflow-y (domain layout) (domain paint))
  (style-domains overflow-clip-margin (domain paint))
  (style-domains overscroll-behavior-x (domain paint))
  (style-domains overscroll-behavior-y (domain paint))
  (style-domains scroll-indicator-x (domain layout))
  (style-domains scroll-indicator-y (domain layout))
  (style-domains scroll-indicator-gutter (domain layout))
  (style-domains scroll-indicator-color (domain paint))
  (style-domains scroll-indicator-thickness (domain layout))
  (style-domains scroll-indicator-inset (domain paint))
  (style-domains scroll-indicator-min-length (domain paint))
  (style-domains scroll-blur (domain paint))
)
