_ SliderRemainder is Box

+ increase-small Doer
+ decrease-small Doer
+ increase-page Doer
+ decrease-page Doer
+ go-minimum Doer
+ go-maximum Doer

────────────────────

<This
    <KeyShortcut "Increase"
        key = .arrow-right
        discoverable = false
        action = increase-small

    <KeyShortcut "Increase"
        key = .arrow-up
        discoverable = false
        action = increase-small

    <KeyShortcut "Decrease"
        key = .arrow-left
        discoverable = false
        action = decrease-small

    <KeyShortcut "Decrease"
        key = .arrow-down
        discoverable = false
        action = decrease-small

    <KeyShortcut "Page Up"
        key = .page-up
        discoverable = false
        action = increase-page

    <KeyShortcut "Page Down"
        key = .page-down
        discoverable = false
        action = decrease-page

    <KeyShortcut "Minimum"
        key = .home
        discoverable = false
        action = go-minimum

    <KeyShortcut "Maximum"
        key = .end
        discoverable = false
        action = go-maximum
