• Slider • flex-row
    corner-radius = slider-thumb-radius

    when #is-vertical
        layout = flex-col

        • SliderTrack • w:4
            min-height = SizeSpec.auto
            max-height = SizeSpec.auto
            left = null
            right = null
            top = PositionOffset.coord(slider-thumb-radius)
            bottom = PositionOffset.coord(slider-thumb-radius)
            align-x = Alignment.center
            align-y = null

        • SliderFill • w:4
            min-height = SizeSpec.auto
            max-height = SizeSpec.auto
            left = null
            right = null
            top = PositionOffset.coord(-slider-thumb-radius)
            bottom = PositionOffset.coord(slider-thumb-radius)
            align-x = Alignment.center
            align-y = null

    when #is-focus-visible
        focus-ring = gui-focus-ring
        motion.focus-ring = gui-motion-quick

    when #is-dragging
        • SliderThumb • bg:gui-accent-color

    when !#is-operable
        • SliderFill • bg:gui-disabled-text-color

        • SliderThumb • bg:gui-well-color
            border-color = gui-disabled-text-color

• SliderTrack • bg:gui-track-color h:4
    corner-radius = slider-track-radius
    left = PositionOffset.coord(slider-thumb-radius)
    right = PositionOffset.coord(slider-thumb-radius)
    align-y = Alignment.center

• SliderFill • bg:gui-accent-bright-color h:4
