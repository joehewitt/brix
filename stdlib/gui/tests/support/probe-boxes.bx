(import /core/markup)
(import /gui/box)
(import /gui/events)
(import /gui/primitives)
(import /gui/window)

(type + ProbeBox (is Box)
  (prop + name String)
  (prop + mounted-count Size (= 0))
  (prop + unmounted-count Size (= 0))
  (fn-do + This _
    (param name _)
  )
  (fn-do + mounted _
    (+= mounted-count 1)
  )
  (fn-do + unmounted _
    (+= unmounted-count 1)
  )
)

(type + ProbeRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue (as this MarkupRootElement))))
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
    (let ignored (. flush applied))
  )
)

(type + PointerTestWindow (is Window)
  (prop + trace (list String))
  (fn-do + This _
    (param trace _)
  )
  (subscribe-for (on event pointer-down)
    (+= trace (str "window:down:" (. event point x) ":" (. event point y)))
  )
  (fn-do + ensure-native _)
  (fn-do + render Bool
    (return false)
  )
  (fn-do + schedule-render _)
)

(type + PointerProbeBox (is Box)
  (prop + name String)
  (prop + trace (list String))
  (prop + cancel-down _ (= false))
  (prop + cancel-up _ (= false))
  (prop + remove-on-down (? Box))
  (prop + close-on-down (? Window))
  (prop + scroll-count Size (= 0))
  (prop + click-events Size (= 0))
  (fn-do + This _
    (param name _)
    (param trace _)
  )
  (subscribe-for (on event pointer-down)
    (+= trace (str name ":down:" (. event point x) ":" (. event point y)))
    (if cancel-down
      (call (. event cancel))
    )
    (if remove-on-down
      (let removing remove-on-down)
      (if (. removing %parent)
        (call markup-remove (!! (. removing %parent)) removing)
      )
    )
    (if close-on-down
      (call (. close-on-down close))
    )
  )
  (subscribe-for (on event pointer-up)
    (+= trace (str name ":up:" (. event point x) ":" (. event point y)))
    (if cancel-up
      (call (. event cancel))
    )
  )
  (subscribe-for (on event pointer-drag)
    (+= trace (str name ":drag:" (. event point x) ":" (. event point y)))
  )
  (subscribe-for (on event scroll)
    (+= scroll-count 1)
    (+= trace (str name ":scroll:" (. event point x) ":" (. event point y)))
  )
  (subscribe-for (on event click)
    (+= click-events 1)
    (+= trace (str name ":click:" (. event point x) ":" (. event point y)))
  )
)

(type + ScrollProbeBox (is Box)
  (rule This
    (= overflow-x (. ScrollOverflow auto))
    (= overflow-y (. ScrollOverflow auto))
    (= scroll-indicator-inset 0)
  )
)

(type + VerticalScrollProbeBox (is ScrollProbeBox)
  (rule This
    (= overflow-x (. ScrollOverflow clip))
    (= overflow-y (. ScrollOverflow auto))
  )
)

(type + FocusProbeBox (is Box)
  (rule This
    (= focus-mode (. FocusMode press))
  )
  (blank)
  (prop + name String)
  (prop + trace (list String))
  (prop + probe-native-focus-handle (? Pointer))
  (prop + focus-enabled _ (= true))
  (prop + focus-count Size (= 0))
  (prop + blur-count Size (= 0))
  (prop + click-count Size (= 0))
  (prop + focus-state-was-current _ (= false))
  (prop + blur-state-was-current _ (= false))
  (prop + native-focus-handle _ (=> probe-native-focus-handle))
  (prop + is-focus-enabled _ (=> focus-enabled))
  (fn-do + This _
    (param name _)
    (param trace _)
  )
  (subscribe-for (on event focus)
    (+= focus-count 1)
    (= focus-state-was-current is-focused)
    (+= trace (str name ":focus"))
  )
  (subscribe-for (on event blur)
    (+= blur-count 1)
    (= blur-state-was-current (not is-focused))
    (+= trace (str name ":blur"))
  )
  (subscribe-for (on event click)
    (+= click-count 1)
    (+= trace (str name ":click"))
  )
)
