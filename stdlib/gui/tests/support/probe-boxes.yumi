━━━━━━━━━━━━━━━━━━━━
+ PointerProbeBox is Box

+ name String
+ trace [String]
+ cancel-down = false
+ cancel-up = false
+ remove-on-down Box?
+ close-on-down Window?
+ scroll-count Size = 0
+ click-events Size = 0

────────────────────
+ This
    - name
    - trace

────────────────────
for event on pointer-down

trace += "$name:down:${event.point.x}:${event.point.y}"
if cancel-down
    event.cancel()
if remove-on-down
    . removing = remove-on-down
    if removing.%parent
        markup-remove(removing.%parent!, removing)
if close-on-down
    close-on-down.close()

────────────────────
for event on pointer-up

trace += "$name:up:${event.point.x}:${event.point.y}"
if cancel-up
    event.cancel()

────────────────────
for event on pointer-drag

trace += "$name:drag:${event.point.x}:${event.point.y}"

────────────────────
for event on scroll

scroll-count += 1
trace += "$name:scroll:${event.point.x}:${event.point.y}"

────────────────────
for event on click

click-events += 1
trace += "$name:click:${event.point.x}:${event.point.y}"

