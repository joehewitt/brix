(import /core/markup)
(import /graphics/point)
(import /graphics/primitives)
(import /gui/box)
(import /gui/events)
(import /gui/primitives)
(import /gui/tests/support/probe-boxes)
(import /gui/window)
(import /test)
(import /ui/input)
(blank)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "GUI Window Drag Routing"))
  (call (. cases run) window-drag-routing-tests)
  (= cases (call (. cases then) "GUI Window Drag Cancellation" window-drag-cancellation-tests))
  (= cases (call (. cases then) "GUI Window Drag Boundaries" window-drag-boundary-tests))
  (= cases (call (. cases then) "GUI Window Press Within" window-press-within-tests))
  (= cases (call (. cases then) "Window Lifecycle" window-lifecycle-tests))
  (= cases (call (. cases then) "GUI Window Event Lifecycle" gui-window-event-lifecycle-tests))
  (return cases)
)

(type + DragProbeBox (is Box)
  (prop + click-count Size)
  (subscribe-for (on event click)
    (+= click-count 1)
  )
)

(type + DragRegionBox (is DragProbeBox)
  (rule This
    (= window-draggable true)
  )
)

(type + DragClipBox (is Box)
  (rule This
    (= overflow-x (. ScrollOverflow clip))
    (= overflow-y (. ScrollOverflow clip))
  )
)

(type + DragTestWindow (is Window)
  (prop + drag-count Size)
  (prop + accepts-drag _ (= true))
  (fn-do + ensure-native _)
  (fn-expr + render _
    true
  )
  (fn-do + schedule-render _)
  (fn-do + begin-window-drag _
    (param event PointerDownEvent)
    (+= drag-count 1)
    (return (and accepts-drag (!= (. event window-drag-token) 0)))
  )
)

(fn-do + window-drag-routing-tests _
  (param t TestCase)
  (let window (call DragTestWindow))
  (= (. window size) (call Dimensions 200 100))
  (let header (call DragRegionBox))
  (let decoration (call DragProbeBox))
  (call markup-append window header)
  (call markup-append header decoration)
  (call (. window open))
  (call (. header arrange-bounds) (call Rect 0 0 200 60))
  (call (. decoration arrange-bounds) (call Rect 0 0 80 60))
  (let title-point (call PointerEventData (call Point 20 20)))
  (call (. window dispatch-pointer-event) (call PointerDownEvent title-point (. PointerButton primary) 1 123))
  (call (. t check) "handoff leaves no pressed state" (not (. decoration is-pressed)))
  (call (. window dispatch-pointer-event) (call PointerUpEvent title-point))
  (call (. t expect) "handoff cannot synthesize a click" 0 (. decoration click-count))
  (call (. window close))
  (return t)
)

(fn-do + window-drag-cancellation-tests _
  (param t TestCase)
  (let window (call DragTestWindow))
  (= (. window size) (call Dimensions 200 100))
  (let header (call DragRegionBox))
  (call markup-append window header)
  (call (. window open))
  (call (. header arrange-bounds) (call Rect 0 0 100 50))
  (let data (call PointerEventData (call Point 20 20)))
  (= (. window accepts-drag) false)
  (call (. window dispatch-pointer-event) (call PointerDownEvent data (. PointerButton primary) 1 123))
  (call (. t check) "native rejection preserves normal capture" (. header is-pressed))
  (call (. window dispatch-pointer-event) (call PointerUpEvent data))
  (call (. t expect) "native rejection preserves click behavior" 1 (. header click-count))
  (call (. window close))
  (return t)
)

(fn-do + window-drag-boundary-tests _
  (param t TestCase)
  (let window (call DragTestWindow))
  (= (. window size) (call Dimensions 200 100))
  (let clip (call DragClipBox))
  (let region (call DragRegionBox))
  (call markup-append window clip)
  (call markup-append clip region)
  (call (. window open))
  (call (. clip arrange-bounds) (call Rect 0 0 50 50))
  (call (. region arrange-bounds) (call Rect 0 0 100 50))
  (call (. window dispatch-pointer-event)
    (block
      (arg (call PointerDownEvent (call PointerEventData (call Point 70 20)) (. PointerButton primary) 1 1))
    )
  )
  (call (. t expect) "clipped overflow cannot start window drag" 0 (. window drag-count))
  (call (. window dispatch-pointer-event)
    (block
      (arg (call PointerDownEvent (call PointerEventData (call Point 30 20)) (. PointerButton primary) 1 3))
    )
  )
  (call (. t expect) "visible region remains draggable" 1 (. window drag-count))
  (call (. window close))
  (return t)
)

(fn-do + window-press-within-tests _
  (param t TestCase)
  (let window (call HoverSwapWindow))
  (call (. window open))
  (call (. window layout))
  (let holder (. window holder))
  (let position (. holder bounds center))
  (call (. window dispatch-pointer-event)
    (block
      (arg (call PointerDownEvent (call PointerEventData position 6) (. PointerButton primary)))
    )
  )
  (call (. window close))
  (call (. t check) "closing the window releases the press" (not (. holder is-press-within)))
  (return t)
)

(type + HoverSwapHolder (is Box)
  (content
    (<> This
      (<> Box (• absolute) (• cover .parent))
    )
  )
)

(type + HoverSwapWindow (is Window)
  (prop + holder HoverSwapHolder)
  (content
    (<> This
      (= size (call Dimensions 120 80))
      (<> HoverSwapHolder (id: holder) (• w 40) (• h 40) (• m 10))
    )
  )
  (fn-do + ensure-native _)
  (fn-do + render Bool
    (return false)
  )
)

(fn-do + window-lifecycle-tests _
  (param t TestCase)
  (let window (call HeadlessWindow))
  (let child (as (!! (. window %first-child)) ProbeBox))
  (call (. window open))
  (call (. window close))
  (call (. t expect) "close releases the mounted tree" 1 (. child unmounted-count))
  (blank)
  (return t)
)

(type + HeadlessWindow (is Window)
  (content
    (<> This
      (<> ProbeBox (id: child) (text: "child"))
    )
  )
  (fn-do + ensure-native _)
)

(fn-do + gui-window-event-lifecycle-tests _
  (param t TestCase)
  (let window (call LifecycleTestWindow))
  (call (. window open))
  (= (. window cancel-next-close) true)
  (call (. t check) "cancelable Closing keeps the window open" (not (call (. window request-close))))
  (call (. t expect) "canceled close does not publish Closed" 0 (. window closed-count))
  (call (. t check) "a canceled close keeps the window's events" (call (. window request-close)))
  (call (. t expect) "each close request publishes Closing" 2 (. window closing-count))
  (blank)
  (call (. window request-close))
  (call (. window close))
  (call (. t expect) "closed window ignores repeated close requests" 2 (. window closing-count))
  (call (. t expect) "Closed publishes exactly once" 1 (. window closed-count))
  (blank)
  (return t)
)

(type + LifecycleTestWindow (is Window)
  (prop + cancel-next-close _ (= false))
  (prop + closing-count Size (= 0))
  (prop + closed-count Size (= 0))
  (subscribe-for (on event closing)
    (+= closing-count 1)
    (if cancel-next-close
      (= cancel-next-close false)
      (call (. event cancel))
    )
  )
  (subscribe-for (on event closed)
    (+= closed-count 1)
  )
  (fn-do + ensure-native _)
  (fn-do + render Bool
    (return false)
  )
)
