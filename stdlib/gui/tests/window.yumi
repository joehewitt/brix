━━━━━━━━━━━━━━━━━━━━
+ do gui-window-event-lifecycle-tests
    - t TestCase

. window = LifecycleTestWindow()
window.open()
window.cancel-next-close = true
t.check("cancelable Closing keeps the window open", !window.request-close())
t.expect("canceled close does not publish Closed", 0, window.closed-count)
t.check("a canceled close keeps the window's events", window.request-close())
t.expect("each close request publishes Closing", 2, window.closing-count)

window.request-close()
window.close()
t.expect("closed window ignores repeated close requests", 2, window.closing-count)
t.expect("Closed publishes exactly once", 1, window.closed-count)

= t

━━━━━━━━━━━━━━━━━━━━
+ LifecycleTestWindow is Window

+ cancel-next-close = false
+ closing-count Size = 0
+ closed-count Size = 0

────────────────────
for event on closing

closing-count += 1
if cancel-next-close
    cancel-next-close = false
    event.cancel()

────────────────────
for event on closed

closed-count += 1

