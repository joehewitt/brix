━━━━━━━━━━━━━━━━━━━━
+ do window-drag-routing-tests
    - t TestCase

. window = DragTestWindow()
window.size = Dimensions(200, 100)
. header = DragRegionBox()
. decoration = DragProbeBox()
markup-append(window, header)
markup-append(header, decoration)
window.open()
header.arrange-bounds(Rect(0, 0, 200, 60))
decoration.arrange-bounds(Rect(0, 0, 80, 60))
. title-point = PointerEventData(Point(20, 20))
window.dispatch-pointer-event(PointerDownEvent(title-point, PointerButton.primary, 1, 123))
t.check("handoff leaves no pressed state", !decoration.is-pressed)
window.dispatch-pointer-event(PointerUpEvent(title-point))
t.expect("handoff cannot synthesize a click", 0, decoration.click-count)
window.close()
= t

━━━━━━━━━━━━━━━━━━━━
+ do window-drag-cancellation-tests
    - t TestCase

. window = DragTestWindow()
window.size = Dimensions(200, 100)
. header = DragRegionBox()
markup-append(window, header)
window.open()
header.arrange-bounds(Rect(0, 0, 100, 50))
. data = PointerEventData(Point(20, 20))
window.accepts-drag = false
window.dispatch-pointer-event(PointerDownEvent(data, PointerButton.primary, 1, 123))
t.check("native rejection preserves normal capture", header.is-pressed)
window.dispatch-pointer-event(PointerUpEvent(data))
t.expect("native rejection preserves click behavior", 1, header.click-count)
window.close()
= t

━━━━━━━━━━━━━━━━━━━━
+ do window-drag-boundary-tests
    - t TestCase

. window = DragTestWindow()
window.size = Dimensions(200, 100)
. clip = DragClipBox()
. region = DragRegionBox()
markup-append(window, clip)
markup-append(clip, region)
window.open()
clip.arrange-bounds(Rect(0, 0, 50, 50))
region.arrange-bounds(Rect(0, 0, 100, 50))
window.dispatch-pointer-event
    - PointerDownEvent(PointerEventData(Point(70, 20)), PointerButton.primary, 1, 1)
t.expect("clipped overflow cannot start window drag", 0, window.drag-count)
window.dispatch-pointer-event
    - PointerDownEvent(PointerEventData(Point(30, 20)), PointerButton.primary, 1, 3)
t.expect("visible region remains draggable", 1, window.drag-count)
window.close()
= t

━━━━━━━━━━━━━━━━━━━━
+ do window-press-within-tests
    - t TestCase

. window = HoverSwapWindow()
window.open()
window.layout()
. holder = window.holder
. position = holder.bounds.center
window.dispatch-pointer-event
    - PointerDownEvent(PointerEventData(position, 6), PointerButton.primary)
window.close()
t.check("closing the window releases the press", !holder.is-press-within)
= t

