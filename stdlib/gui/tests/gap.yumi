━━━━━━━━━━━━━━━━━━━━
+ do tests TestRender

. cases = TestCase("GUI Flex Gap Measurement And Orientation")
cases.run(gap-measurement-tests)
cases = cases.then("GUI Flex Gap Allocation And Margins", gap-allocation-tests)
cases = cases.then("GUI Flex Cross-Axis Alignment", cross-alignment-tests)
= cases

━━━━━━━━━━━━━━━━━━━━
+ do gap-measurement-tests
    - t TestCase

. solo = GapFlexRoot(Orientation.horizontal, 9)
markup-mount-root(solo, solo)
solo.markup-batch-queue.checkpoint()
t.expect("empty flex has no gap", Dimensions(0, 0), solo.measure().content-size)
. only = GapChild(Dimensions(11, 6))
markup-append(solo, only)
solo.markup-batch-queue.checkpoint()
t.expect("single child natural size has no gap", Dimensions(11, 6), solo.measure().content-size)
solo.layout(Rect(3, 4, 20, 10))
t.expect("single child arrangement has no leading gap", 3, only.bounds.left)

. root = GapFlexRoot(Orientation.horizontal, 4)
. first = GapChild(Dimensions(10, 3))
. second = GapChild(Dimensions(20, 5))
. third = GapChild(Dimensions(30, 4))
markup-append(root, first)
markup-append(root, second)
markup-append(root, third)
markup-mount-root(root, root)
root.markup-batch-queue.checkpoint()

t.expect
    - "horizontal natural width includes two gaps"
    - Dimensions(68, 5)
    - root.measure().content-size
root.layout(Rect(2, 3, 68, 12))
t.expect("horizontal flex has no leading gap", 2, first.bounds.left)
t.expect("horizontal flex inserts the first gap", 16, second.bounds.left)
t.expect("horizontal flex inserts the second gap", 40, third.bounds.left)
t.expect("horizontal flex has no trailing gap", 70, third.bounds.right)
t.expect("horizontal gap contributes to scroll extent", 68, root.inner-width)

root.close()
markup-release(root)
solo.close()
markup-release(solo)
= t

━━━━━━━━━━━━━━━━━━━━
+ do gap-allocation-tests
    - t TestCase

. root = GapFlexRoot(Orientation.horizontal, 10)
. fixed = GapChild(Dimensions(20, 4))
. flexible = GapFlexibleChild()
. margined = GapMarginedFlexibleChild()
markup-append(root, fixed)
markup-append(root, flexible)
markup-append(root, margined)
markup-mount-root(root, root)
root.markup-batch-queue.checkpoint()
root.layout(Rect(0, 0, 101, 10))

t.expect("gap is reserved before flexible allocation", 27.5, flexible.width)
t.expect
    - "gap and adjacent leading margin are additive"
    - 16
    - margined.bounds.left - flexible.bounds.right

root.close()
markup-release(root)
= t

