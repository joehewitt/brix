━━━━━━━━━━━━━━━━━━━━
+ do cross-alignment-tests
    - t TestCase

. row = GapFlexRoot(Orientation.horizontal, 0)
. stretched = GapChild(Dimensions(10, 6))
. top = GapChild(Dimensions(10, 6))
. middle = GapChild(Dimensions(10, 6))
. bottom = GapChild(Dimensions(10, 30))
markup-append(row, stretched)
markup-append(row, top)
markup-append(row, middle)
markup-append(row, bottom)
markup-mount-root(row, row)
top.align-y = Alignment.start
middle.align-y = Alignment.center
bottom.align-y = Alignment.end
row.markup-batch-queue.checkpoint()
row.layout(Rect(0, 10, 40, 20))
t.expect("unaligned children stretch across the row", Rect(0, 10, 10, 20), stretched.bounds)
t.expect("start keeps natural height at the top", Rect(10, 10, 10, 6), top.bounds)
t.expect("center centers natural height", Rect(20, 17, 10, 6), middle.bounds)
t.expect("end clamps to the row and aligns to the bottom", Rect(30, 10, 10, 20), bottom.bounds)

. column = GapFlexRoot(Orientation.vertical, 0)
. centered = GapChild(Dimensions(8, 5))
markup-append(column, centered)
markup-mount-root(column, column)
centered.align-x = Alignment.center
column.markup-batch-queue.checkpoint()
column.layout(Rect(0, 0, 30, 20))
t.expect("a column centers on the horizontal axis", Rect(11, 0, 8, 5), centered.bounds)
= t
