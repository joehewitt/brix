(import /core/markup)
(import /graphics/color)
(import /graphics/point)
(import /graphics/primitives)
(import /gui/box)
(import /gui/drag)
(import /gui/events)
(import /gui/keys)
(import /gui/primitives)
(import /gui/window)
(import /test)
(import /time)
(import /ui/input)
(blank)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "GUI Drag Start"))
  (call (. cases run) drag-start-tests)
  (= cases (call (. cases then) "GUI Drag Targets" drag-target-tests))
  (= cases (call (. cases then) "GUI Drag Cancel" drag-cancel-tests))
  (= cases (call (. cases then) "GUI Drag Ghost" drag-ghost-tests))
  (= cases (call (. cases then) "GUI Drag Scroll" drag-scroll-tests))
  (return cases)
)

(fn-do _ drag-start-tests _
  (param t TestCase)
  (let window (call open-drag-window))
  (call down window (call Point 50 50))
  (call drag window (call Point 52 50))
  (call drag window (call Point 54 50))
  (call (. t expect) "the session swallows the pull" 1 (. window pulls))
  (call (. t expect) "the session starts at the press" (call Point 50 50) (. (!! (. window drag-session)) origin))
  (call (. t check) "a session clears the pressed state" (not (. window source is-pressed)))
  (blank)
  (call drag window (call Point 60 50))
  (call (. t expect) "a drag is offered once" "start" (. window story))
  (call (. t expect) "later pulls stay with the session" 1 (. window pulls))
  (call up window (call Point 60 50))
  (call (. t expect) "releasing over nothing ends without a drop" "start end:cancelled" (. window story))
  (call (. t check) "the session ends on release" (== (. window drag-session) null))
  (blank)
  (= (. window begins) false)
  (call (. window log clear))
  (call down window (call Point 50 50))
  (call drag window (call Point 60 50))
  (call drag window (call Point 70 50))
  (call (. t expect) "a declined offer is not repeated" "start" (. window story))
  (call (. t expect) "a declined offer leaves pointer drags alone" 3 (. window pulls))
)

(fn-do _ drag-target-tests _
  (param t TestCase)
  (let window (call open-drag-window))
  (call down window (call Point 50 50))
  (call drag window (call Point 150 50))
  (call drag window (call Point 250 50))
  (call (. t expect) "leaving the target tells it" "start over leave" (. window story))
  (blank)
  (call drag window (call Point 150 50))
  (call up window (call Point 160 50))
  (call (. t expect)
    (block
      (arg "a release over the target drops")
      (arg "start over leave over over drop:item end:dropped")
      (arg (. window story))
    )
  )
  (call (. t expect) "the drop lands at the release point" (call Point 160 50) (. window dropped-at))
  (blank)
  (= (. window accepts) false)
  (call (. window log clear))
  (call down window (call Point 50 50))
  (call drag window (call Point 150 50))
  (call up window (call Point 150 50))
  (call (. t expect) "a refusing target gets no drop" "start end:cancelled" (. window story))
)

(fn-do _ drag-cancel-tests _
  (param t TestCase)
  (let window (call open-drag-window))
  (call down window (call Point 50 50))
  (call drag window (call Point 150 50))
  (call (. window dispatch-key-press) (call KeyPressEvent (. Key escape)))
  (call (. t expect) "escape cancels the drag" "start over leave end:cancelled" (. window story))
  (call (. t check) "escape ends the session" (== (. window drag-session) null))
  (call up window (call Point 150 50))
  (call (. t expect) "a release after a cancel drops nothing" "start over leave end:cancelled" (. window story))
  (blank)
  (call (. window log clear))
  (call down window (call Point 50 50))
  (call drag window (call Point 150 50))
  (call (. window accept-window-deactivated))
  (call (. t expect) "deactivating the window cancels the drag" "start over leave end:cancelled" (. window story))
  (blank)
  (call (. window accept-window-activated))
  (call (. window log clear))
  (call down window (call Point 50 50))
  (call drag window (call Point 150 50))
  (call (. window cancel-drag))
  (call (. t expect) "a drag can be cancelled by hand" "start over leave end:cancelled" (. window story))
  (blank)
  (call (. window log clear))
  (call down window (call Point 50 50))
  (call drag window (call Point 150 50))
  (call (. window dispatch-pointer-event) (call PointerMoveEvent (call held (call Point 160 50))))
  (call move window (call Point 160 50))
  (call (. t expect)
    (block
      (arg "a move with the button up cancels the drag")
      (arg "start over over leave end:cancelled")
      (arg (. window story))
    )
  )
  (blank)
  (call (. window log clear))
  (call down window (call Point 50 50))
  (call drag window (call Point 150 50))
  (call markup-remove window (. window source))
  (call (. window dispatch-key-input) (call KeyInputEvent ""))
  (call (. t check) "removing the source ends the session" (== (. window drag-session) null))
)

(fn-do _ drag-ghost-tests _
  (param t TestCase)
  (let window (call open-drag-window))
  (call down window (call Point 30 40))
  (call drag window (call Point 150 60))
  (let ghost (. (!! (. window drag-session)) ghost))
  (call (. t check) "the source is pictured as the ghost" (!= ghost null))
  (call (. t expect) "the ghost is as large as the source" (call Dimensions 100 100) (. (!! ghost) size))
  (call (. t expect) "the ghost keeps the grip under the pointer" (call Rect 120 20 100 100) (. (!! ghost) frame))
  (call up window (call Point 150 60))
  (blank)
  (= (. window pictured) (. window offstage))
  (call down window (call Point 30 40))
  (call drag window (call Point 150 60))
  (let staged (. (!! (. window drag-session)) ghost))
  (call (. t check) "a box that is not shown can be the ghost" (!= staged null))
  (call (. t expect) "the ghost takes the pictured box's size" (call Dimensions 40 20) (. (!! staged) size))
  (call (. t expect) "a box that is not shown hangs beside the pointer" (call Rect 138 50 40 20) (. (!! staged) frame))
  (call up window (call Point 150 60))
)

(fn-do _ drag-scroll-tests _
  (param t TestCase)
  (let window (call open-drag-window))
  (call down window (call Point 50 50))
  (call drag window (call Point 350 50))
  (call drag window (call Point 350 95))
  (call (. window step-drag-scroll))
  (call (. t expect) "scrolling asks the target again" "start over over over" (. window story))
  (call up window (call Point 350 50))
)

(fn-do _ open-drag-window _
  (<> DragTestWindow (id: window))
  (blank)
  (call (. window open))
  (call (. window layout))
  (return window)
)

(fn-do _ down _
  (param window Window)
  (param point Point)
  (call (. window dispatch-pointer-event) (call PointerDownEvent (call PointerEventData point)))
)

(fn-do _ drag _
  (param window Window)
  (param point Point)
  (call (. window dispatch-pointer-event) (call PointerDragEvent (call PointerEventData point)))
)

(fn-do _ up _
  (param window Window)
  (param point Point)
  (call (. window dispatch-pointer-event) (call PointerUpEvent (call PointerEventData point)))
)

(fn-do _ move _
  (param window Window)
  (param point Point)
  (call (. window dispatch-pointer-event) (call PointerMoveEvent (call PointerEventData point)))
)

(fn-expr _ held _
  (param point Point)
  (call PointerEventData point 0 (. PointerDeviceKind mouse) (call PointerModifiers) 1)
)

(type + DragTestPayload (is Tuple)
  (implements DragPayload)
  (prop + label String)
  (fn-expr + drag-kind _ :get
    "test"
  )
)

(type + DragTestWindow (is Window)
  (prop + begins _ (= true))
  (prop + accepts _ (= true))
  (prop + pictured (? Box))
  (prop + log (list String))
  (prop + pulls _ (= 0))
  (prop + dropped-at Point)
  (prop + story _ (=> (call (. " " join) (in each log))))
  (content
    (<> This (• flex-row)
      (= size (tuple 400 120))
      (<> Box (id: source) (• w 100) (• h 100) (• bg (call RGBA "#e02020")))
      (<> Box (id: target) (• w 100) (• h 100))
      (<> Box (id: other) (• w 100) (• h 100))
      (<> Box (id: scroller) (• flex-col) (• w 100) (• h 100)
        (= overflow-y (. ScrollOverflow auto))
        (<> Box (• w 100) (• h 400))
      )
      (<> Box (id: offstage) (• absolute) (• w 40) (• h 20) (• bg (call RGBA "#20e020"))
        (= display (. Display invisible))
        (= left (call (. PositionOffset coord) 0))
        (= top (call (. PositionOffset coord) 100))
      )
    )
  )
  (subscribe-for (on event (. source drag-start))
    (+= log "start")
    (if begins
      (call (. event begin) (call DragTestPayload "item") pictured)
    )
  )
  (subscribe-for (on event (. source pointer-drag))
    (+= pulls 1)
  )
  (subscribe-for (on event (. source drag-end))
    (let outcome (if-expr (. event dropped) "end:dropped" "end:cancelled"))
    (+= log outcome)
  )
  (subscribe-for (on event (. target drag-over))
    (if (and accepts (is (. event payload) DragTestPayload))
      (+= log "over")
      (call (. event accept))
    )
  )
  (subscribe-for (on event (. target drag-leave))
    (+= log "leave")
  )
  (subscribe-for (on event (. target drop))
    (+= log (str "drop:" (. (as (. event payload) DragTestPayload) label)))
    (= dropped-at (. event point))
  )
  (subscribe-for (on event (. scroller drag-over))
    (+= log "over")
    (call (. event accept) scroller)
  )
  (fn-do + ensure-native _)
  (fn-expr + render _
    true
  )
  (fn-do + schedule-render _)
)
