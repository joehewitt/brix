━━━━━━━━━━━━━━━━━━━━
+ do tests TestRender

. cases = TestCase("GUI Tight Paragraph Sizing")
cases.run(gui-text-tight-sizing-tests)
= cases

━━━━━━━━━━━━━━━━━━━━
+ do gui-text-tight-sizing-tests
    - t TestCase

. catalog = FontCatalog()
. registration = catalog.register("noto-sans/NotoSans-Regular.ttf")
. root = TextTestRoot()
. label = ReactiveTightWordTextLabel()
label.family-name = registration.family
markup-append(root, label)
markup-mount-root(root, root)
root.markup-batch-queue.checkpoint()

. cases [TightTextCase]
cases += TightTextCase("one-line", "A compact message", 200, 1)
cases += TightTextCase("two-line", "A compact message with a notably short tail", 180, 2)
cases += TightTextCase
    - "short-tail-threshold"
    - "The first row fills the cap with ordinary words and the tail is tiny"
    - 230.25
    - 2
cases += TightTextCase
    - "three-line"
    - "A compact message with several words and a short tail"
    - 150
    - 3
for case in cases
    label.text = case.text
    . reference = TextLayout
        - case.text
        - label.effective-font
        - case.maximum-width
        - TextOverflow.clip
        - TextWrap.word
    do use reference
        . measured = label.measure(measure-fit-query(case.maximum-width)).content-size
        . snapshot = label.text-layout-snapshot!
        t.expect("${case.name} reference line count", case.line-count, reference.line-count)
        t.expect("${case.name} tight line count", reference.line-count, snapshot.line-count)
        t.expect("${case.name} tight height", reference.height, measured.height)
        t.check("${case.name} stays under A", measured.width <= case.maximum-width)
        . stable = label.measure(measure-fit-query(measured.width)).content-size
        t.expect("${case.name} is stable when W becomes A", measured, stable)
        t.expect
            - "${case.name} stable remeasure keeps breaks"
            - snapshot
            - label.text-layout-snapshot!
        if measured.width > 0.01
            . narrower = TextLayout
                - case.text
                - label.effective-font
                - measured.width - 0.01
                - TextOverflow.clip
                - TextWrap.word
            do use narrower
                . rejects-narrower = narrower.line-count != reference.line-count
                rejects-narrower = rejects-narrower || narrower.height != reference.height
                t.check("${case.name} rejects a narrower admissible width", rejects-narrower)

. threshold-bubble = TightCappedBubbleParent()
. threshold-label = ThresholdTightWordTextLabel()
threshold-label.family-name = registration.family
threshold-label.text = "The first row fills the cap with ordinary words and the tail is tiny"
markup-append(threshold-bubble, threshold-label)
markup-append(root, threshold-bubble)
root.markup-batch-queue.checkpoint()
. threshold-size = threshold-bubble.measure().border-size
threshold-bubble.layout(Rect(0, 0, threshold-size.width, threshold-size.height))
. threshold-canvas = RasterCanvas(260, 100, 1)
do use threshold-canvas
    threshold-bubble.paint(threshold-canvas)
. threshold-snapshot = threshold-label.text-layout-snapshot!
t.expect("tight threshold paint preserves two lines", 2, threshold-snapshot.line-count)
t.check
    - "tight threshold text stays within its measured Label"
    - threshold-snapshot.size.height <= threshold-label.content-bounds.height

label.close()
threshold-label.close()
threshold-bubble.close()
registration.close()

= t

