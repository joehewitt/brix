━━━━━━━━━━━━━━━━━━━━
+ do anchored-placement-tests
    - t TestCase

. menu = FixedBox(Dimensions(120, 80))
. below = AnchoredPlacement(Side.bottom, AnchorPoint.start, 4)

. flipped = below.place(placement-request(menu, Rect(20, 250, 60, 24)))
t.expect("flips above near bottom edge", Rect(20, 166, 120, 80), flipped.bounds)
t.check("flip reports top side", flipped.side == Side.top)

. shifted = below.place(placement-request(menu, Rect(340, 20, 50, 24)))
t.expect("shifts inside right edge", 280.0, shifted.bounds.x)

. tall = FixedBox(Dimensions(100, 500))
. fitted = below.place(placement-request(tall, Rect(20, 100, 60, 20)))
t.check("fit chooses roomier side", fitted.side == Side.bottom)
t.expect("fit clamps height to room", 176.0, fitted.bounds.height)

. beside = AnchoredPlacement(Side.right, AnchorPoint.start, 2)
. submenu = beside.place(placement-request(menu, Rect(320, 40, 60, 20)))
t.check("submenu flips to left", submenu.side == Side.left)
t.expect("submenu left bounds", Rect(198, 40, 120, 80), submenu.bounds)
= t

