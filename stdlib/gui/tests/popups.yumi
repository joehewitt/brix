+ AbovePopup is Popup

• This • above:0

━━━━━━━━━━━━━━━━━━━━
+ do above-snapping-tests
    - t TestCase

. window = PopupTestWindow()
window.size = Dimensions(400, 300)
. anchor = Box()
. popup = AbovePopup()
markup-append(window, anchor)
markup-append(anchor, popup)
markup-append(popup, Label("Details"))
window.open()
anchor.arrange-bounds(Rect(20, 120.7, 60, 30))
popup.show()
window.dispatch-pointer-exit()
t.check("a popup above its anchor does not cover it", popup.bounds.bottom <= anchor.bounds.y)
t.check
    - "a popup above its anchor stays within a pixel of it"
    - anchor.bounds.y - popup.bounds.bottom < 1
window.close()
= t

━━━━━━━━━━━━━━━━━━━━
+ do anchor-scroll-tests
    - t TestCase

. window = PopupTestWindow()
window.size = Dimensions(400, 300)
. scroller = ScrollProbe()
. anchor = Box()
. popover = Popover()
markup-append(window, scroller)
markup-append(scroller, anchor)
markup-append(anchor, popover)
markup-append(popover, Label("Pinned"))
window.open()
scroller.arrange-bounds(Rect(0, 0, 200, 100))
scroller.inner-width = 200
scroller.inner-height = 400
anchor.arrange-bounds(Rect(10, 40, 50, 20))

popover.show()
window.dispatch-pointer-exit()
. start = popover.bounds.y
scroller.scroll-to(Point(0, 10))
window.dispatch-pointer-exit()
t.expect("the popover follows its scrolled anchor", start - 10, popover.bounds.y)
window.close()
= t

━━━━━━━━━━━━━━━━━━━━
+ do gui-modal-scroll-boundary-tests
    - t TestCase

. trace [String]
. window = PointerTestWindow(trace)
window.size = Dimensions(100, 80)
. underlying = ScrollProbeBox()
. modal = ModalProbePopup(Rect(20, 20, 60, 40))
markup-append(window, underlying)
markup-append(underlying, modal)
window.open()
underlying.arrange-bounds(Rect(0, 0, 100, 80))
underlying.inner-width = 100
underlying.inner-height = 200

window.dispatch-pointer-event
    - ScrollEvent
        - PointerEventData(Point(5, 5))
        - 0
        - 5
        - true
        - ScrollPhase.began

modal.show()
window.dispatch-pointer-event
    - ScrollEvent
        - PointerEventData(Point(5, 5))
        - 0
        - 7
        - true
        - ScrollPhase.changed
t.expect("modal activation clears the background gesture latch", 5, underlying.scroll-y)
window.close()
= t

━━━━━━━━━━━━━━━━━━━━
+ do gui-popup-stack-tests
    - t TestCase

. trace [String]
. window = PointerTestWindow(trace)
window.size = Dimensions(100, 80)
. first = ModalProbePopup(Rect(10, 10, 80, 60))
. nested = ModalProbePopup(Rect(20, 20, 40, 30))
. nested-pointer = PointerProbeBox("nested-pointer", trace)
. later = ModalProbePopup(Rect(60, 10, 30, 60))
markup-append(window, first)
markup-append(first, nested)
markup-append(nested, nested-pointer)
markup-append(window, later)
window.open()
nested-pointer.arrange-bounds(Rect(20, 20, 40, 30))

first.show()
window.dispatch-pointer-exit()
nested.show()
window.dispatch-pointer-exit()
later.show()
window.dispatch-pointer-exit()
t.check("superseded popups report why they closed", first.last-reason == DismissReason.superseded)
t.check
    - "nested popups close with their ancestor"
    - nested.last-reason == DismissReason.ancestor-closed

later.dismiss()
window.dispatch-pointer-exit()

first.show()
nested.show()
window.dispatch-pointer-exit()
window.dispatch-pointer-event(PointerDownEvent(PointerEventData(Point(25, 25), 7)))
first.dismiss()
window.dispatch-pointer-event(PointerUpEvent(PointerEventData(Point(25, 25), 7)))
t.check("closing the stack clears nested pointer capture", !nested-pointer.is-pressed)
t.expect("a closed capture cannot synthesize a click", 0, nested-pointer.click-events)
window.close()
= t

