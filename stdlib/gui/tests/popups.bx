(import /core/markup)
(import /graphics/point)
(import /graphics/primitives)
(import /gui/box)
(import /gui/events)
(import /gui/label)
(import /gui/placement)
(import /gui/popover)
(import /gui/popup)
(import /gui/primitives)
(import /gui/tests/support/probe-boxes)
(import /gui/window)
(import /test)
(blank)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "GUI Popup Anchored Placement"))
  (call (. cases run) anchored-placement-tests)
  (= cases (call (. cases then) "GUI Popup Point Placement" point-placement-tests))
  (= cases (call (. cases then) "GUI Popup Cover Placement" cover-placement-tests))
  (= cases (call (. cases then) "GUI Popup Above Snapping" above-snapping-tests))
  (= cases (call (. cases then) "GUI Popup Anchor Scrolling" anchor-scroll-tests))
  (= cases (call (. cases then) "GUI Modal Popup Boundary" gui-modal-scroll-boundary-tests))
  (= cases (call (. cases then) "GUI Popup Stack" gui-popup-stack-tests))
  (return cases)
)

(type + FixedBox (is Box)
  (prop + fixed Dimensions)
  (fn-do + This _
    (param fixed _)
  )
  (fn-expr + measured-content-size _
    (param query MeasureQuery)
    fixed
  )
)

(fn-expr + placement-request _
  (param popup Box)
  (param anchor Rect)
  (param pointer _ (= (call Point 0 0)))
  (param focus (? Rect) (= null))
  (call PlacementRequest popup anchor (call Rect 0 0 400 300) (call Rect 0 0 400 300) pointer focus)
)

(fn-do + anchored-placement-tests _
  (param t TestCase)
  (let menu (call FixedBox (call Dimensions 120 80)))
  (let below (call AnchoredPlacement (. Side bottom) (. AnchorPoint start) 4))
  (blank)
  (let flipped (call (. below place) (call placement-request menu (call Rect 20 250 60 24))))
  (call (. t expect) "flips above near bottom edge" (call Rect 20 166 120 80) (. flipped bounds))
  (call (. t check) "flip reports top side" (== (. flipped side) (. Side top)))
  (blank)
  (let shifted (call (. below place) (call placement-request menu (call Rect 340 20 50 24))))
  (call (. t expect) "shifts inside right edge" 280.0 (. shifted bounds x))
  (blank)
  (let tall (call FixedBox (call Dimensions 100 500)))
  (let fitted (call (. below place) (call placement-request tall (call Rect 20 100 60 20))))
  (call (. t check) "fit chooses roomier side" (== (. fitted side) (. Side bottom)))
  (call (. t expect) "fit clamps height to room" 176.0 (. fitted bounds height))
  (blank)
  (let beside (call AnchoredPlacement (. Side right) (. AnchorPoint start) 2))
  (let submenu (call (. beside place) (call placement-request menu (call Rect 320 40 60 20))))
  (call (. t check) "submenu flips to left" (== (. submenu side) (. Side left)))
  (call (. t expect) "submenu left bounds" (call Rect 198 40 120 80) (. submenu bounds))
  (return t)
)

(fn-do + point-placement-tests _
  (param t TestCase)
  (let menu (call FixedBox (call Dimensions 120 80)))
  (let at-point (call PointPlacement))
  (let corner (call (. at-point place) (call placement-request menu (call Rect 390 290 0 0))))
  (call (. t expect) "flips to both sides of point" (call Rect 270 210 120 80) (. corner bounds))
  (return t)
)

(fn-do + cover-placement-tests _
  (param t TestCase)
  (let list (call FixedBox (call Dimensions 100 120)))
  (let cover (call CoverPlacement))
  (let focus (call Rect 4 48 92 24))
  (let placed (call (. cover place) (call placement-request list (call Rect 100 100 80 24) (call Point 0 0) focus)))
  (call (. t expect) "selected row sits over anchor" (call Rect 96 52 100 120) (. placed bounds))
  (return t)
)

(type + PopupTestWindow (is Window)
  (fn-do + ensure-native _)
  (fn-expr + render _
    true
  )
  (fn-do + schedule-render _)
)

(type + ScrollProbe (is Box)
  (rule This
    (= overflow-x (. ScrollOverflow clip))
    (= overflow-y (. ScrollOverflow auto))
  )
)

(type + AbovePopup (is Popup)
  (rule This (• above 0))
)

(fn-do + above-snapping-tests _
  (param t TestCase)
  (let window (call PopupTestWindow))
  (= (. window size) (call Dimensions 400 300))
  (let anchor (call Box))
  (let popup (call AbovePopup))
  (call markup-append window anchor)
  (call markup-append anchor popup)
  (call markup-append popup (call Label "Details"))
  (call (. window open))
  (call (. anchor arrange-bounds) (call Rect 20 120.7 60 30))
  (call (. popup show))
  (call (. window dispatch-pointer-exit))
  (call (. t check) "a popup above its anchor does not cover it" (<= (. popup bounds bottom) (. anchor bounds y)))
  (call (. t check)
    (block
      (arg "a popup above its anchor stays within a pixel of it")
      (arg (< (- (. anchor bounds y) (. popup bounds bottom)) 1))
    )
  )
  (call (. window close))
  (return t)
)

(fn-do + anchor-scroll-tests _
  (param t TestCase)
  (let window (call PopupTestWindow))
  (= (. window size) (call Dimensions 400 300))
  (let scroller (call ScrollProbe))
  (let anchor (call Box))
  (let popover (call Popover))
  (call markup-append window scroller)
  (call markup-append scroller anchor)
  (call markup-append anchor popover)
  (call markup-append popover (call Label "Pinned"))
  (call (. window open))
  (call (. scroller arrange-bounds) (call Rect 0 0 200 100))
  (= (. scroller inner-width) 200)
  (= (. scroller inner-height) 400)
  (call (. anchor arrange-bounds) (call Rect 10 40 50 20))
  (blank)
  (call (. popover show))
  (call (. window dispatch-pointer-exit))
  (let start (. popover bounds y))
  (call (. scroller scroll-to) (call Point 0 10))
  (call (. window dispatch-pointer-exit))
  (call (. t expect) "the popover follows its scrolled anchor" (- start 10) (. popover bounds y))
  (call (. window close))
  (return t)
)

(fn-do + gui-modal-scroll-boundary-tests _
  (param t TestCase)
  (let trace (list String))
  (let window (call PointerTestWindow trace))
  (= (. window size) (call Dimensions 100 80))
  (let underlying (call ScrollProbeBox))
  (let modal (call ModalProbePopup (call Rect 20 20 60 40)))
  (call markup-append window underlying)
  (call markup-append underlying modal)
  (call (. window open))
  (call (. underlying arrange-bounds) (call Rect 0 0 100 80))
  (= (. underlying inner-width) 100)
  (= (. underlying inner-height) 200)
  (blank)
  (call (. window dispatch-pointer-event)
    (block
      (arg
        (call ScrollEvent
          (block
            (arg (call PointerEventData (call Point 5 5)))
            (arg 0)
            (arg 5)
            (arg true)
            (arg (. ScrollPhase began))
          )
        )
      )
    )
  )
  (blank)
  (call (. modal show))
  (call (. window dispatch-pointer-event)
    (block
      (arg
        (call ScrollEvent
          (block
            (arg (call PointerEventData (call Point 5 5)))
            (arg 0)
            (arg 7)
            (arg true)
            (arg (. ScrollPhase changed))
          )
        )
      )
    )
  )
  (call (. t expect) "modal activation clears the background gesture latch" 5 (. underlying scroll-y))
  (call (. window close))
  (return t)
)

(fn-do + gui-popup-stack-tests _
  (param t TestCase)
  (let trace (list String))
  (let window (call PointerTestWindow trace))
  (= (. window size) (call Dimensions 100 80))
  (let first (call ModalProbePopup (call Rect 10 10 80 60)))
  (let nested (call ModalProbePopup (call Rect 20 20 40 30)))
  (let nested-pointer (call PointerProbeBox "nested-pointer" trace))
  (let later (call ModalProbePopup (call Rect 60 10 30 60)))
  (call markup-append window first)
  (call markup-append first nested)
  (call markup-append nested nested-pointer)
  (call markup-append window later)
  (call (. window open))
  (call (. nested-pointer arrange-bounds) (call Rect 20 20 40 30))
  (blank)
  (call (. first show))
  (call (. window dispatch-pointer-exit))
  (call (. nested show))
  (call (. window dispatch-pointer-exit))
  (call (. later show))
  (call (. window dispatch-pointer-exit))
  (call (. t check) "superseded popups report why they closed" (== (. first last-reason) (. DismissReason superseded)))
  (call (. t check)
    (block
      (arg "nested popups close with their ancestor")
      (arg (== (. nested last-reason) (. DismissReason ancestor-closed)))
    )
  )
  (blank)
  (call (. later dismiss))
  (call (. window dispatch-pointer-exit))
  (blank)
  (call (. first show))
  (call (. nested show))
  (call (. window dispatch-pointer-exit))
  (call (. window dispatch-pointer-event) (call PointerDownEvent (call PointerEventData (call Point 25 25) 7)))
  (call (. first dismiss))
  (call (. window dispatch-pointer-event) (call PointerUpEvent (call PointerEventData (call Point 25 25) 7)))
  (call (. t check) "closing the stack clears nested pointer capture" (not (. nested-pointer is-pressed)))
  (call (. t expect) "a closed capture cannot synthesize a click" 0 (. nested-pointer click-events))
  (call (. window close))
  (return t)
)

(type + FixedProbePlacement (is Placement)
  (prop + frame Rect)
  (fn-do + This _
    (param frame _)
  )
  (fn-expr + place _
    (param request PlacementRequest)
    (call PlacementResult frame)
  )
)

(type + ModalProbePopup (is Popup)
  (prop + frame Rect)
  (prop + last-reason (? DismissReason))
  (blank)
  (rule This (• modal)
    (= outside-press-dismiss false)
    (= placement (call FixedProbePlacement #frame))
  )
  (fn-do + This _
    (param frame _)
  )
  (subscribe-for (on reason dismissed (when arrival))
    (= last-reason reason)
  )
)
