(import /gui/box)
(import /gui/commands)
(import /gui/events)
(import /gui/keys)
(import /gui/primitives)
(import /gui/window)
(import /test)
(import /time/duration)
(import /ui/input)
(import /ui/key-combo)
(import /ui/keymap)
(import /ui/mode)
(blank)

(main
  (call tests)
)

(fn-expr + tests TestRender
  (header (call test "Scope And Dispatch"))
  (tuple "Scoped | Container | Global" (call active-titles (call scoped-window)))
  (header (call test "Commands, Conflicts, And Modes"))
  (tuple 1 (. (call find-key-binding-conflicts (call (. (call mixed-window) active-key-bindings))) length))
  (tuple "true, true, false" (call held-mode-modifier-states))
  (tuple "true, false, false, true, false" (call remapped-mode-states))
  (tuple "true, false" (call deactivated-mode-states))
  (tuple "true, false, false" (call deactivated-tap-or-hold-states))
  (tuple "true, true, false" (call independently-owned-mode-states))
  (header (call test "Key Mapping Profiles"))
  (tuple "true, false" (call unmapped-held-profile-states))
  (tuple "Cmd+Shift+R, Cmd+R" (call restored-shortcut-labels))
  (tuple "false, true" (call restored-availability-states))
)

(fn-expr _ active-titles _
  (param window ShortcutTestWindow)
  (call (. " | " join) (in (. each display-title) (call (. window active-key-bindings))))
)

(fn-do _ scoped-window _
  (<> ShortcutTestWindow (id: window))
  (blank)
  (= (. window focus-adapter) (call GUIFocusAdapter))
  (call (. window open))
  (call (. window scope request-focus))
  (return window)
)

(fn-do _ mixed-window _
  (<> MixedBindingWindow (id: window))
  (blank)
  (= (. window focus-adapter) (call GUIFocusAdapter))
  (call (. window open))
  (call (. window scope request-focus))
  (return window)
)

(fn-do _ held-mode-modifier-states _
  (let window (call mixed-window))
  (call (. window dispatch-key-press) (call KeyPressEvent (call (. Key unknown) 7) (call PointerModifiers) false 7 "x"))
  (let after-press (. window mode effective-value))
  (call (. window dispatch-modifiers-changed) (call PointerModifiers false false true))
  (let after-modifier (. window mode effective-value))
  (call (. window dispatch-key-release)
    (block
      (arg (call KeyReleaseEvent (call (. Key unknown) 7) (call PointerModifiers false false true) 7 "x"))
    )
  )
  (return (str after-press ", " after-modifier ", " (. window mode effective-value)))
)

(fn-do _ remapped-mode-states _
  (let window (call mixed-window))
  (call (. window dispatch-key-press) (call KeyPressEvent (call (. Key unknown) 7) (call PointerModifiers) false 7 "x"))
  (let after-press (. window mode effective-value))
  (call (. window held-mode set-binding-key) (call KeyCombo "z"))
  (let after-remap (. window mode effective-value))
  (call (. window dispatch-key-press) (call KeyPressEvent (call (. Key unknown) 7) (call PointerModifiers) false 7 "x"))
  (let after-old-key (. window mode effective-value))
  (call (. window dispatch-key-press) (call KeyPressEvent (call (. Key unknown) 8) (call PointerModifiers) false 8 "z"))
  (let after-new-key (. window mode effective-value))
  (call (. window held-mode set-binding-enabled) false)
  (return (str after-press ", " after-remap ", " after-old-key ", " after-new-key ", " (. window mode effective-value)))
)

(fn-do _ deactivated-mode-states _
  (let window (call mixed-window))
  (call (. window dispatch-key-press) (call KeyPressEvent (call (. Key unknown) 7) (call PointerModifiers) false 7 "x"))
  (let after-press (. window mode effective-value))
  (call (. window accept-window-deactivated))
  (return (str after-press ", " (. window mode effective-value)))
)

(fn-do _ deactivated-tap-or-hold-states _
  (let window (call mixed-window))
  (= (. window tap-or-hold-binding hold-threshold) 60000ms)
  (call (. window dispatch-key-press) (call KeyPressEvent (call (. Key unknown) 11) (call PointerModifiers) false 11 "t"))
  (let after-press (. window tap-or-hold-mode effective-value))
  (call (. window accept-window-deactivated))
  (return (str after-press ", " (. window tap-or-hold-mode effective-value) ", " (. window tap-or-hold-mode value)))
)

(fn-do _ independently-owned-mode-states _
  (let window (call mixed-window))
  (call (. window dispatch-key-press) (call KeyPressEvent (call (. Key unknown) 7) (call PointerModifiers) false 7 "x"))
  (call (. window dispatch-key-press) (call KeyPressEvent (call (. Key unknown) 8) (call PointerModifiers) false 8 "y"))
  (call (. window dispatch-key-release) (call KeyReleaseEvent (call (. Key unknown) 7) (call PointerModifiers) 7 "x"))
  (let after-first-release (. window mode effective-value))
  (call (. window dispatch-key-release) (call KeyReleaseEvent (call (. Key unknown) 8) (call PointerModifiers) 8 "y"))
  (return (str "true, " after-first-release ", " (. window mode effective-value)))
)

(fn-do _ refresh-shortcut _
  (let shortcut (call KeyShortcut "Refresh"))
  (= (. shortcut key) (call KeyCombo "Cmd+R"))
  (= (. shortcut stable-key) "example.refresh")
  (return shortcut)
)

(fn-do _ profile-bindings _
  (param window MixedBindingWindow)
  (param shortcut KeyShortcut)
  (= (. window held-mode stable-key) "example.independent")
  (let bindings (list KeyBinding))
  (+= bindings shortcut)
  (+= bindings (. window held-mode))
  (+= bindings (. window second-held-mode))
  (return bindings)
)

(fn-do _ remapping-profile _
  (let mappings (list KeyMapping))
  (+= mappings (call KeyMapping "example.refresh" (call KeyCombo "Cmd+Shift+R")))
  (+= mappings (call KeyMapping "example.independent" null true))
  (return (call KeyMappingProfile mappings))
)

(fn-do _ unmapped-held-profile-states _
  (let window (call mixed-window))
  (let bindings (call profile-bindings window (call refresh-shortcut)))
  (call (. window second-held-mode press) (call KeyPressEvent (call (. Key unknown) 8) (call PointerModifiers) false 8 "y"))
  (let after-press (. window mode effective-value))
  (call apply-key-mapping-profile bindings (call remapping-profile))
  (return (str after-press ", " (. window mode effective-value)))
)

(fn-do _ restored-shortcut-labels _
  (let window (call mixed-window))
  (let shortcut (call refresh-shortcut))
  (let bindings (call profile-bindings window shortcut))
  (call apply-key-mapping-profile bindings (call remapping-profile))
  (let remapped (. shortcut key display-label))
  (call apply-key-mapping-profile bindings (call KeyMappingProfile))
  (return (str remapped ", " (. shortcut key display-label)))
)

(fn-do _ restored-availability-states _
  (let window (call mixed-window))
  (let bindings (call profile-bindings window (call refresh-shortcut)))
  (call apply-key-mapping-profile bindings (call remapping-profile))
  (let remapped (. window held-mode enabled))
  (call apply-key-mapping-profile bindings (call KeyMappingProfile))
  (return (str remapped ", " (. window held-mode enabled)))
)

(type + ShortcutScope (is Box)
  (rule This
    (= focus-mode (. FocusMode keys))
  )
)

(type + ShortcutContainer (is Box)
  (rule This
    (= focus-mode (. FocusMode inside))
  )
)

(type + ShortcutTestWindow (is Window)
  (content
    (<> This
      (= size (tuple 200 200))
      (blank)
      (<> KeyShortcut (text: "Global")
        (= key .escape)
      )
      (blank)
      (<> ShortcutContainer (• absolute) (• cover .parent)
        (<> KeyShortcut (text: "Container")
          (= key .arrow-right)
        )
        (blank)
        (<> ShortcutScope (id: scope) (• absolute) (• cover .parent)
          (<> KeyShortcut (text: "Scoped")
            (= key .arrow-up)
          )
        )
      )
      (blank)
      (<> ShortcutScope (• absolute) (• cover .parent)
        (<> KeyShortcut (text: "Unreachable")
          (= key .arrow-down)
        )
      )
    )
  )
  (fn-do + ensure-native _)
  (fn-do + render Bool
    (return false)
  )
)

(type + MixedBindingWindow (is Window)
  (prop + mode _ (= (call (of Mode Bool) false)))
  (prop + tap-or-hold-mode _ (= (call (of Mode Bool) false)))
  (prop + parts-mode _ (= (call (of Mode Bool) false)))
  (content
    (<> This
      (= size (tuple 200 200))
      (blank)
      (<> KeyShortcut (text: "Global fallback")
        (= key (call KeyCombo (call (. Key function-key) 3)))
      )
      (blank)
      (<> (of KeyMode Bool) (id: held-mode)
        (= title "Held mode")
        (= key (call KeyCombo "x"))
        (= mode mode)
        (= value true)
        (= activation (. KeyModeActivation held))
      )
      (blank)
      (<> (of KeyMode Bool) (id: second-held-mode)
        (= title "Second held mode")
        (= key (call KeyCombo "y"))
        (= mode mode)
        (= value true)
        (= activation (. KeyModeActivation held))
      )
      (blank)
      (<> (of KeyMode Bool) (id: tap-or-hold-binding)
        (= title "Tap or hold mode")
        (= key (call KeyCombo "t"))
        (= mode tap-or-hold-mode)
        (= value true)
        (= activation (. KeyModeActivation tap-or-hold))
      )
      (blank)
      (<> ActionCommand (id: tap-command)
        (= title "Tap command")
      )
      (blank)
      (<> (of KeyMode Bool)
        (= title "Hold part")
        (= key (call KeyCombo "h"))
        (= mode parts-mode)
        (= value true)
        (= activation (. KeyModeActivation held))
      )
      (blank)
      (<> KeyCommand
        (= key (call KeyCombo "h"))
        (= command (. tap-command id))
        (= activation (. KeyCommandActivation tap))
      )
      (blank)
      (<> ShortcutScope (id: scope) (• absolute) (• cover .parent)
        (<> KeyShortcut (text: "First duplicate")
          (= key (call KeyCombo (call (. Key function-key) 2)))
        )
        (<> KeyShortcut (text: "Second duplicate")
          (= key (call KeyCombo (call (. Key function-key) 2)))
        )
        (<> KeyShortcut (text: "Disabled local")
          (= key (call KeyCombo (call (. Key function-key) 3)))
          (= enabled false)
        )
      )
    )
  )
  (fn-do + ensure-native _)
  (fn-do + render Bool
    (return false)
  )
)
