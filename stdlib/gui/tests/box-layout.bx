(import /core/markup)
(import /graphics/point)
(import /graphics/primitives)
(import /gui/box)
(import /gui/layout)
(import /gui/primitives)
(import /gui/tests/support/probe-boxes)
(import /math)
(import /test)
(blank)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "GUI Box Model And Measurement"))
  (call (. cases run) gui-box-model-tests)
  (= cases (call (. cases then) "GUI Flex Flow And Position" gui-layout-position-tests))
  (= cases (call (. cases then) "GUI Flex And Flow Geometry Parity" gui-layout-geometry-parity-tests))
  (= cases (call (. cases then) "GUI Layout Incrementality" gui-layout-incrementality-tests))
  (= cases (call (. cases then) "GUI Fixed Subtree Stability" gui-fixed-subtree-stability-tests))
  (= cases (call (. cases then) "GUI Hidden Layout Boundary" gui-hidden-layout-boundary-tests))
  (= cases (call (. cases then) "GUI Display And Transparency" gui-display-transparency-tests))
  (= cases (call (. cases then) "GUI Flex Constraint Redistribution" gui-flex-constraint-tests))
  (return cases)
)

(fn-do + gui-box-model-tests _
  (param t TestCase)
  (let root (call LayoutFixtureRoot))
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (let measured (as (!! (. root %first-child)) MeasuredBox))
  (let result (call (. measured measure)))
  (blank)
  (call (. t expect) "fixed style sizes constrain content" (call Dimensions 40 20) (. result content-size))
  (call (. t expect) "padding and border surround content" (call Dimensions 54 34) (. result border-size))
  (call (. t expect) "margin surrounds the border box" (call Dimensions 58 38) (. result outer-size))
  (blank)
  (return t)
)

(fn-do + gui-layout-position-tests _
  (param t TestCase)
  (let root (call FlexFixtureRoot))
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (call (. root layout) (call Rect 0 0 201 80))
  (blank)
  (let fixed (as (!! (. root %first-child)) FixedLayoutBox))
  (let first-flex (as (!! (. fixed %next-sibling)) FlexOneBox))
  (let second-flex (as (!! (. first-flex %next-sibling)) FlexTwoBox))
  (let badge (as (!! (. second-flex %next-sibling)) BadgeBox))
  (blank)
  (call (. t check)
    (block
      (arg "flex weights divide the remaining fractional span")
      (arg (< (call abs (- (. second-flex width) (* (. first-flex width) 2))) 0.0001))
    )
  )
  (call (. t check)
    (block
      (arg "flex allocations consume the content width")
      (arg (< (call abs (- (. second-flex bounds right) (. root content-bounds right))) 0.0001))
    )
  )
  (call (. t expect)
    (block
      (arg "absolute child is excluded from flex and pinned top-right")
      (arg (call Rect 186 5 10 8))
      (arg (. badge bounds))
    )
  )
  (blank)
  (return t)
)

(fn-do + gui-layout-geometry-parity-tests _
  (param t TestCase)
  (let overflow (call GUIFlexTestRoot (. Orientation horizontal)))
  (let overflow-a (call GUIArrangeProbeBox 28 4))
  (let overflow-b (call GUIArrangeProbeBox 28 4))
  (let overflow-c (call GUIArrangeProbeBox 28 4))
  (call markup-append overflow overflow-a)
  (call markup-append overflow overflow-b)
  (call markup-append overflow overflow-c)
  (call markup-mount-root overflow overflow)
  (call (. overflow markup-batch-queue checkpoint))
  (call (. overflow layout) (call Rect 0 0 60 10))
  (blank)
  (call (. t expect) "fixed flex children retain natural widths" (call Rect 28 0 28 10) (. overflow-b bounds))
  (call (. t expect) "fixed flex overflow records full inner width" 84 (. overflow inner-width))
  (call (. t expect) "horizontal flex records stretched cross extent" 10 (. overflow inner-height))
  (blank)
  (let underflow (call GUIFlexTestRoot (. Orientation horizontal)))
  (call markup-append underflow (call GUIArrangeProbeBox 20 4))
  (call markup-append underflow (call GUIArrangeProbeBox 20 4))
  (call markup-mount-root underflow underflow)
  (call (. underflow markup-batch-queue checkpoint))
  (call (. underflow layout) (call Rect 0 0 60 10))
  (call (. t expect) "fixed flex underflow leaves unused main space" 40 (. underflow inner-width))
  (blank)
  (let margin-flex (call GUIFlexTestRoot (. Orientation horizontal)))
  (let margin-free (call GUIFlexProbe))
  (let margined (call GUIMarginedFlexProbe))
  (call markup-append margin-flex margin-free)
  (call markup-append margin-flex margined)
  (call markup-mount-root margin-flex margin-flex)
  (call (. margin-flex markup-batch-queue checkpoint))
  (call (. margin-flex layout) (call Rect 0 0 100 10))
  (call (. t expect) "flex margin preserves equal item widths" (. margin-free width) (. margined width))
  (call (. t expect) "flex margin creates an external gap" 12 (- (. margined x) (. margin-free bounds right)))
  (call (. t expect) "margined flex items consume the available span" 100 (. margined bounds right))
  (blank)
  (let vertical-flex (call GUIFlexTestRoot (. Orientation vertical)))
  (let vertical-first (call GUIArrangeProbeBox 3 7))
  (let vertical-second (call GUIArrangeProbeBox 5 6))
  (call markup-append vertical-flex vertical-first)
  (call markup-append vertical-flex vertical-second)
  (call markup-mount-root vertical-flex vertical-flex)
  (call (. vertical-flex markup-batch-queue checkpoint))
  (call (. vertical-flex layout) (call Rect 2 3 40 30))
  (call (. t expect) "vertical flex stretches the cross axis" (call Rect 2 10 40 6) (. vertical-second bounds))
  (blank)
  (let horizontal-flow (call GUIFlowTestRoot (. Orientation horizontal)))
  (let flow-wide (call GUIArrangeProbeBox 10 8))
  (let flow-short (call GUIArrangeProbeBox 20 6))
  (call markup-append horizontal-flow flow-wide)
  (call markup-append horizontal-flow flow-short)
  (call markup-mount-root horizontal-flow horizontal-flow)
  (call (. horizontal-flow markup-batch-queue checkpoint))
  (call (. horizontal-flow layout) (call Rect 0 0 40 20))
  (call (. t expect) "horizontal flow preserves natural cross size" (call Rect 10 0 20 6) (. flow-short bounds))
  (call (. t expect)
    (block
      (arg "horizontal flow records natural inner extents")
      (arg (call Dimensions 30 8))
      (arg (. horizontal-flow inner-size))
    )
  )
  (blank)
  (let vertical-flow (call GUIFlowTestRoot (. Orientation vertical)))
  (let flow-tall (call GUIArrangeProbeBox 10 8))
  (let flow-small (call GUIArrangeProbeBox 20 6))
  (call markup-append vertical-flow flow-tall)
  (call markup-append vertical-flow flow-small)
  (call markup-mount-root vertical-flow vertical-flow)
  (call (. vertical-flow markup-batch-queue checkpoint))
  (call (. vertical-flow layout) (call Rect 0 0 40 30))
  (call (. t expect) "vertical flow stretches child outer width" (call Rect 0 8 40 6) (. flow-small bounds))
  (call (. t expect)
    (block
      (arg "vertical flow records intrinsic cross and main extents")
      (arg (call Dimensions 20 14))
      (arg (. vertical-flow inner-size))
    )
  )
  (blank)
  (let spaced (call GUIPaddedFlowRoot))
  (let spaced-child (call GUISpacedArrangeProbeBox 10 5))
  (call markup-append spaced spaced-child)
  (call markup-mount-root spaced spaced)
  (call (. spaced markup-batch-queue checkpoint))
  (call (. spaced layout) (call Rect 0 0 40 30))
  (call (. t expect) "flow combines parent padding and child margin" (call Rect 5 5 30 5) (. spaced-child bounds))
  (call (. t expect) "flow inner size uses the child outer natural size" (call Dimensions 14 9) (. spaced inner-size))
  (blank)
  (let minimums (call GUIFlexTestRoot (. Orientation horizontal)))
  (call markup-append minimums (call GUIMinFlexProbe))
  (call markup-append minimums (call GUIMinFlexProbe))
  (call markup-mount-root minimums minimums)
  (call (. minimums markup-batch-queue checkpoint))
  (call (. minimums layout) (call Rect 0 0 100 20))
  (call (. t expect) "flex minima may overflow without becoming negative" 140 (. minimums inner-width))
  (blank)
  (let maximums (call GUIFlexTestRoot (. Orientation horizontal)))
  (call markup-append maximums (call GUIMaxFlexProbe))
  (call markup-append maximums (call GUIMaxFlexProbe))
  (call markup-mount-root maximums maximums)
  (call (. maximums markup-batch-queue checkpoint))
  (call (. maximums layout) (call Rect 0 0 100 20))
  (call (. t expect) "all flex maxima leave stable unused space" 60 (. maximums inner-width))
  (blank)
  (return t)
)

(fn-do + gui-layout-incrementality-tests _
  (param t TestCase)
  (let style-grid (call GUIStyleReflowGrid))
  (let style-top (call GUIStyleReflowRow))
  (let style-middle (call GUIStyleReflowRow))
  (let style-bottom (call GUIStyleReflowRow))
  (let style-target (call GUIStyleReflowCell))
  (call markup-append style-grid style-top)
  (call markup-append style-grid style-middle)
  (call markup-append style-grid style-bottom)
  (for (in index (..< 0 3))
    (call markup-append style-top (call GUIStyleReflowCell))
  )
  (call markup-append style-middle (call GUIStyleReflowCell))
  (call markup-append style-middle style-target)
  (call markup-append style-middle (call GUIStyleReflowCell))
  (for (in index (..< 0 3))
    (call markup-append style-bottom (call GUIStyleReflowCell))
  )
  (call markup-mount-root style-grid style-grid)
  (call (. style-grid markup-batch-queue checkpoint))
  (call (. style-grid layout) (call Rect 0 0 24 24))
  (= (. style-target is-expanded) true)
  (call (. style-grid markup-batch-queue checkpoint))
  (call (. style-grid update-layout))
  (call (. t expect) "style size change grows the containing row" 12 (. style-middle height))
  (call (. t expect) "style size change moves the following row" 20 (. style-bottom y))
  (blank)
  (let style-middle-first (as (!! (. style-middle %first-child)) GUIStyleReflowCell))
  (= (. style-target is-expanded) false)
  (= (. style-middle is-vertical) true)
  (call (. style-grid markup-batch-queue checkpoint))
  (call (. style-grid update-layout))
  (call (. t expect) "own style change supersedes child-only invalidation" 24 (. style-middle-first width))
  (call (. t expect) "own layout change arranges the complete child list" 24 (. style-middle inner-height))
  (call (. t expect) "simultaneous parent and child styles reflow ancestors" 32 (. style-bottom y))
  (blank)
  (return t)
)

(fn-do + gui-fixed-subtree-stability-tests _
  (param t TestCase)
  (let root (call ProbeRoot))
  (let host (call GUIShiftLayoutHost))
  (let first (call GUIArrangeProbeBox 10 8))
  (let anchor-host (call GUIShiftLayoutHost))
  (let anchor-flow (call GUIArrangeProbeBox 10 8))
  (let screen (call GUIScreenAnchorArrangeProbe))
  (call markup-append host first)
  (call markup-append anchor-host anchor-flow)
  (call markup-append anchor-host screen)
  (call markup-append root host)
  (call markup-append root anchor-host)
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (call (. root layout) (call Rect 0 0 300 180))
  (call (. host arrange-bounds) (call Rect 20 24 60 24))
  (call (. host update-layout))
  (call (. anchor-host arrange-bounds) (call Rect 20 80 60 24))
  (call (. anchor-host update-layout))
  (blank)
  (let first-before (. first bounds))
  (blank)
  (let delta (call Point 46.5 19.25))
  (call (. host arrange-bounds)
    (block
      (call Rect (+ (. host x) (. delta x)) (+ (. host y) (. delta y)) (. host width) (. host height))
    )
  )
  (call (. t expect)
    (block
      (arg "clean move shifts child absolute bounds immediately")
      (arg
        (call Rect
          (block
            (arg (+ (. first-before x) (. delta x)))
            (arg (+ (. first-before y) (. delta y)))
            (arg (. first-before width))
            (arg (. first-before height))
          )
        )
      )
      (arg (. first bounds))
    )
  )
  (blank)
  (let screen-before (. screen bounds))
  (call (. anchor-host arrange-bounds)
    (block
      (call Rect (+ (. anchor-host x) 18) (. anchor-host y) (. anchor-host width) (. anchor-host height))
    )
  )
  (call (. anchor-host update-layout))
  (call (. t expect) "screen anchor does not inherit parent delta" screen-before (. screen bounds))
  (blank)
  (return t)
)

(fn-do + gui-hidden-layout-boundary-tests _
  (param t TestCase)
  (let root (call GUIFlowTestRoot (. Orientation horizontal)))
  (let hidden (call GUIHiddenLayoutHost))
  (let hidden-child (call GUIArrangeProbeBox 3 2))
  (let trailing (call GUIArrangeProbeBox 4 2))
  (call markup-append hidden hidden-child)
  (call markup-append root hidden)
  (call markup-append root trailing)
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (call (. root layout) (call Rect 0 0 30 8))
  (call (. t expect) "hidden subtree consumes no flow slot" 0 (. trailing x))
  (blank)
  (= (. hidden-child measured-width) 8)
  (call (. root update-layout))
  (blank)
  (= (. hidden is-layout-hidden) false)
  (call (. root markup-batch-queue checkpoint))
  (call (. root update-layout))
  (call (. t expect) "revealed subtree uses its latest measurement" 8 (. hidden width))
  (call (. t expect) "revealed subtree reflows the following sibling" 8 (. trailing x))
  (call (. t expect) "revealed descendant receives settled bounds" (call Rect 0 0 8 2) (. hidden-child bounds))
  (blank)
  (= (. hidden is-layout-hidden) true)
  (call (. root markup-batch-queue checkpoint))
  (call (. root update-layout))
  (call (. t expect) "rehiding rebuilds active links without a gap" 0 (. trailing x))
  (blank)
  (return t)
)

(fn-do + gui-display-transparency-tests _
  (param t TestCase)
  (let root (call TransparencyFixtureRoot))
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (call (. root layout) (call Rect 0 0 100 30))
  (blank)
  (let wrapper (as (!! (. root %first-child)) TransparentProbe))
  (let hidden (as (!! (. wrapper %next-sibling)) Box))
  (let trailing (as (!! (. hidden %next-sibling)) Box))
  (call (. t expect) "hidden child consumes no layout slot" 20 (. trailing x))
  (blank)
  (return t)
)

(fn-do + gui-flex-constraint-tests _
  (param t TestCase)
  (let root (call ClampedFlexFixtureRoot))
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (call (. root layout) (call Rect 0 0 200 30))
  (let capped (as (!! (. root %first-child)) Box))
  (let remainder (as (!! (. capped %next-sibling)) Box))
  (call (. t expect) "flex maximum clamps the first allocation" 40 (. capped width))
  (call (. t expect) "remaining flex space redistributes" 160 (. remainder width))
  (blank)
  (return t)
)

(type + MeasuredBox (is Box)
  (rule This (• w 40) (• h 20) (• p 3) (• m 2)
    (= border-width 4)
  )
)

(type + LayoutFixtureRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue (as this MarkupRootElement))))
  (content
    (<> This (• p 5)
      (<> MeasuredBox)
    )
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
    (let ignored (. flush applied))
  )
)

(type + FixedLayoutBox (is Box)
  (rule This (• w 40))
)

(type + FlexOneBox (is Box)
  (rule This (• flex 1))
)

(type + FlexTwoBox (is Box)
  (rule This (• flex 2))
)

(type + BadgeBox (is Box)
  (rule This (• absolute) (• w 10) (• h 8)
    (= right (call (. PositionOffset coord) 0))
    (= top (call (. PositionOffset coord) 0))
  )
)

(type + FlexFixtureRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue (as this MarkupRootElement))))
  (content
    (<> This (• flex-row) (• p 5)
      (<> FixedLayoutBox)
      (<> FlexOneBox)
      (<> FlexTwoBox)
      (<> BadgeBox)
    )
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
    (let ignored (. flush applied))
  )
)

(type + GUIArrangeProbeBox (is Box)
  (prop + measured-width Length (= 3))
  (prop + measured-height Length (= 1))
  (blank)
  (depends invalidate-content-size measured-width)
  (depends invalidate-content-size measured-height)
  (fn-do + This _
    (param measured-width _ (= 3))
    (param measured-height _ (= 1))
  )
  (fn-expr + measured-content-size _
    (param query MeasureQuery)
    (call Dimensions measured-width measured-height)
  )
)

(type + GUISpacedArrangeProbeBox (is GUIArrangeProbeBox)
  (rule This (• m 2))
)

(type + GUIFlexProbe (is Box)
  (rule This (• flex 1))
)

(type + GUIMarginedFlexProbe (is GUIFlexProbe)
  (rule This (• ml 12))
)

(type + GUIMinFlexProbe (is Box)
  (rule This (• flex 1)
    (= min-width (call (. SizeSpec coord) 70))
  )
)

(type + GUIMaxFlexProbe (is Box)
  (rule This (• flex 1)
    (= max-width (call (. SizeSpec coord) 30))
  )
)

(type + GUIFlexTestRoot (is Box)
  (implements MarkupRootElement)
  (prop + orient Orientation)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue (as this MarkupRootElement))))
  (blank)
  (rule This
    (= layout (call FlexLayout #orient))
  )
  (fn-do + This _
    (param orient _)
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
    (let ignored (. flush applied))
  )
)

(type + GUIFlowTestRoot (is Box)
  (implements MarkupRootElement)
  (prop + orient Orientation)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue (as this MarkupRootElement))))
  (blank)
  (rule This
    (= layout (call FlowLayout #orient))
  )
  (fn-do + This _
    (param orient _)
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
    (let ignored (. flush applied))
  )
)

(type + GUIPaddedFlowRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue (as this MarkupRootElement))))
  (content
    (<> This (• flow-col) (• p 3))
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
    (let ignored (. flush applied))
  )
)

(type + GUIStyleReflowGrid (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue (as this MarkupRootElement))))
  (blank)
  (rule This (• flow-col))
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
    (let ignored (. flush applied))
  )
)

(type + GUIStyleReflowRow (is Box)
  (prop + is-vertical _ (= false))
  (blank)
  (rule This (• flow-row)
    (blank)
    (when-style #is-vertical
      (= layout flow-col)
    )
  )
)

(type + GUIStyleReflowCell (is Box)
  (prop + is-expanded _ (= false))
  (blank)
  (rule This (• w 8) (• h 8)
    (blank)
    (when-style #is-expanded
      (• h 12)
    )
  )
)

(type + GUIShiftLayoutHost (is Box)
  (rule This (• flow-row)
    (= overflow-y (. ScrollOverflow clip))
  )
)

(type + GUIScreenAnchorArrangeProbe (is GUIArrangeProbeBox)
  (rule This (• absolute) (• w 8) (• h 8)
    (= anchor (. Anchor screen))
    (= left (call (. PositionOffset coord) 250))
    (= top (call (. PositionOffset coord) 140))
  )
)

(type + GUIHiddenLayoutHost (is Box)
  (prop + is-layout-hidden _ (= true))
  (blank)
  (rule This (• flow-row)
    (when-style #is-layout-hidden
      (= display (. Display hidden))
    )
  )
)

(type + TransparentProbe (is Box)
  (prop + is-markup-shadow _ (=> true))
)

(type + HiddenProbe (is Box)
  (rule This
    (= display (. Display hidden))
  )
)

(type + TransparencyFixtureRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue (as this MarkupRootElement))))
  (content
    (<> This (• flow-row)
      (<> TransparentProbe
        (<> Box (• w 20) (• h 10))
      )
      (<> HiddenProbe (• w 50) (• h 10))
      (<> Box (• w 15) (• h 10))
    )
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
    (let ignored (. flush applied))
  )
)

(type + CappedFlexBox (is Box)
  (rule This (• flex 1)
    (= max-width (call (. SizeSpec coord) 40))
  )
)

(type + ClampedFlexFixtureRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue (as this MarkupRootElement))))
  (content
    (<> This (• flex-row)
      (<> CappedFlexBox)
      (<> Box (• flex 1))
    )
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
    (let ignored (. flush applied))
  )
)
