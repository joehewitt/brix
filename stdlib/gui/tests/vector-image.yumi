mutation-tests()

━━━━━━━━━━━━━━━━━━━━
+ do mutation-tests TestRender

. cases = TestCase("VectorImage Nested Viewports")
cases.run(vector-image-viewport-tests)
cases = cases.then("VectorImage Transactions", vector-image-transaction-tests)
cases = cases.then("Vector Primitive Invalidation", vector-primitive-invalidation-tests)
cases = cases.then("VectorImage Effects", vector-image-effect-tests)
cases = cases.then("Generated VectorImage Cache", generated-vector-image-tests)
= cases

━━━━━━━━━━━━━━━━━━━━
+ do vector-image-viewport-tests
    - t TestCase

. root = VectorImage()
. child = VectorImage()
child.view-box = Rect(0, 0, 10, 10)
child.group += Rectangle(Rect(0, 0, 10, 10))
markup-append(root, child)
root.group.checkpoint()
child.layout(Rect(20, 30, 40, 20))
root.group.update(Rect(0, 0, 100, 100))
t.check
    - "nested viewport maps into its layout box"
    - near-rect(Rect(30, 30, 20, 20), root.group.paths[0].bounding-box)

child.layout(Rect(60, 10, 10, 30))
root.group.update(Rect(0, 0, 100, 100))
t.check
    - "nested viewport follows its new layout box"
    - near-rect(Rect(60, 20, 10, 10), root.group.paths[0].bounding-box)
= t

━━━━━━━━━━━━━━━━━━━━
+ do vector-image-transaction-tests
    - t TestCase

. root = VectorGroup()
. probe = VectorInvalidationProbe()
root.checkpoint()
root.invalidation-listener = probe.changed
root.begin-update()
. child = PathGraphic(rectangle(Rect(0, 0, 10, 10)))
root += child
child.fill = red
root.checkpoint()
t.expect("checkpoint does not publish", 0, probe.count)
child.opacity = 50%%
root.end-update()
t.expect("transaction publishes once", 1, probe.count)
t.check("transaction includes geometry", (probe.kinds /and/ graphic-change-geometry) != 0)
t.check("transaction includes appearance", (probe.kinds /and/ graphic-change-appearance) != 0)
t.check("transaction includes composite", (probe.kinds /and/ graphic-change-composite) != 0)
= t

━━━━━━━━━━━━━━━━━━━━
+ do vector-primitive-invalidation-tests
    - t TestCase

. image = VectorGroup()
. rectangle = Rectangle(Rect(0, 0, 10, 10))
image += rectangle
image.checkpoint()
image.update(Rect(0, 0, 100, 100))
rectangle.rect = Rect(20, 10, 30, 40)
image.update(Rect(0, 0, 100, 100))
t.check
    - "primitive mutation refreshes cached geometry"
    - near-rect(Rect(20, 10, 30, 40), image.paths[0].bounding-box)
= t

━━━━━━━━━━━━━━━━━━━━
+ do vector-image-effect-tests
    - t TestCase

. image = VectorGroup([rectangle(Rect(0, 0, 10, 10)), rectangle(Rect(5, 0, 10, 10))])
. effects [VectorEffect]
effects += BooleanEffect()
image.effects = VectorEffects(effects)
image.checkpoint()
image.update(Rect(0, 0, 100, 100))
t.expect("boolean effect combines paths", 1, image.paths.length)

image.effects = VectorEffects()
image.checkpoint()
image.update(Rect(0, 0, 100, 100))
t.expect("clearing style effects restores source paths", 2, image.paths.length)
= t

━━━━━━━━━━━━━━━━━━━━
+ do generated-vector-image-tests
    - t TestCase

. counter = GenerationCounter()
. generated = GeneratedVectorImage(counter.generate)
. bounds = Rect(0, 0, 100, 100)
generated.update(bounds)
generated.update(bounds)
t.expect("retained generator evaluates once", 1, counter.generation-count)

generated.invalidate-generation()
generated.update(bounds)
t.expect("invalidated generator reevaluates", 2, counter.generation-count)
= t

━━━━━━━━━━━━━━━━━━━━
+ VectorInvalidationProbe

+ count Size
+ kinds U8

────────────────────
+ do changed
    - changed-kinds U8

count += 1
kinds = kinds /or/ changed-kinds

━━━━━━━━━━━━━━━━━━━━
+ GenerationCounter

+ generation-count Size

────────────────────
+ do generate VectorGroup
    - bounds Rect

generation-count += 1
= VectorGroup([rectangle(bounds)])
