tests()

━━━━━━━━━━━━━━━━━━━━
+ do tests TestRender

. cases = TestCase("Number Field Snapping")
cases.run(number-field-snap-tests)
= cases

━━━━━━━━━━━━━━━━━━━━
+ do number-field-snap-tests
    - t TestCase

. window = InspectorTestWindow()
window.open()
settle-inspector(window)
. field = window.field
field.minimum = 3
field.maximum = 10
field.step = 2
field.snaps = true
field.accept-value(6.2)
t.expect("a typed value goes to the nearest step from the minimum", 7, field.value)
field.accept-value(1)
t.expect("a value below the range is the minimum", 3, field.value)
field.accept-value(40)
t.expect("a value above the range is the last step inside it", 9, field.value)
window.close()
= t

━━━━━━━━━━━━━━━━━━━━
+ do settle-inspector
    - window InspectorTestWindow

. root = window.field.markup-batch-root!
root.markup-batch-queue.checkpoint()
window.layout()

━━━━━━━━━━━━━━━━━━━━
+ InspectorTestWindow is Window

