(import /core/markup)
(import /graphics/point)
(import /graphics/primitives)
(import /gui/events)
(import /gui/primitives)
(import /gui/shorthands)
(import /gui/slider)
(import /gui/window)
(import /test)
(import /ui/input)
(import /ui/value-change-phase)
(blank)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "Slider Pointer Interaction"))
  (call (. cases run) slider-pointer-tests)
  (= cases (call (. cases then) "Slider Gesture Phases" slider-phase-tests))
  (return cases)
)

(fn-do + slider-pointer-tests _
  (param t TestCase)
  (let window (call SliderTestWindow))
  (let slider (. window slider))
  (= (. slider minimum) 0)
  (= (. slider maximum) 100)
  (= (. slider value) 50)
  (= (. slider step) 10)
  (call (. window open))
  (blank)
  (call (. window dispatch-pointer-event)
    (block
      (arg (call PointerDownEvent (call PointerEventData (call Point 64 10.5) 7) (. PointerButton primary)))
    )
  )
  (call (. t expect) "thumb press publishes one began event" 1 (. slider value-changed-count))
  (call (. t expect) "thumb press reports the began phase" (. ValueChangePhase began) (. slider last-phase))
  (blank)
  (call (. window dispatch-pointer-event)
    (block
      (arg (call PointerDragEvent (call PointerEventData (call Point 74 10.5) 7) (. PointerButton primary)))
    )
  )
  (call (. window dispatch-pointer-event)
    (block
      (arg (call PointerDragEvent (call PointerEventData (call Point -20 10.5) 7) (. PointerButton primary)))
    )
  )
  (call (. window dispatch-pointer-event)
    (block
      (arg (call PointerDragEvent (call PointerEventData (call Point 200 10.5) 7) (. PointerButton primary)))
    )
  )
  (call (. t expect) "drag values report the changed phase" (. ValueChangePhase changed) (. slider last-phase))
  (blank)
  (call (. window dispatch-pointer-event)
    (block
      (arg (call PointerUpEvent (call PointerEventData (call Point 200 10.5) 7) (. PointerButton primary)))
    )
  )
  (call (. t expect) "release publishes one ended event" 5 (. slider value-changed-count))
  (call (. t expect) "release reports the ended phase" (. ValueChangePhase ended) (. slider last-phase))
  (blank)
  (call (. window dispatch-pointer-event)
    (block
      (arg (call PointerDownEvent (call PointerEventData (call Point 30 10.5) 8) (. PointerButton primary)))
    )
  )
  (call (. t expect) "track press begins the gesture" (. ValueChangePhase began) (. slider last-phase))
  (call (. window dispatch-pointer-event)
    (block
      (arg (call PointerUpEvent (call PointerEventData (call Point 30 10.5) 8) (. PointerButton primary)))
    )
  )
  (call (. t expect) "track release ends the gesture" 7 (. slider value-changed-count))
  (blank)
  (call (. window close))
  (return t)
)

(fn-do + slider-phase-tests _
  (param t TestCase)
  (let window (call SliderTestWindow))
  (let slider (. window slider))
  (= (. slider minimum) 0)
  (= (. slider maximum) 100)
  (= (. slider value) 50)
  (call (. window open))
  (blank)
  (call (. window dispatch-pointer-event)
    (block
      (arg (call PointerDownEvent (call PointerEventData (call Point 64 10.5) 3) (. PointerButton primary)))
    )
  )
  (call (. window dispatch-pointer-event)
    (block
      (arg (call PointerDragEvent (call PointerEventData (call Point 64 10.5) 3) (. PointerButton primary)))
    )
  )
  (call (. t expect) "a drag without movement publishes only the began event" 1 (. slider value-changed-count))
  (blank)
  (<- (. slider blur) (call BlurEvent))
  (call (. t expect) "blur during a drag ends the gesture" 2 (. slider value-changed-count))
  (call (. t expect) "blur reports the ended phase" (. ValueChangePhase ended) (. slider last-phase))
  (blank)
  (<- (. slider blur) (call BlurEvent))
  (call (. t expect) "blur outside a drag stays silent" 2 (. slider value-changed-count))
  (blank)
  (call (. window dispatch-pointer-event)
    (block
      (arg (call PointerDownEvent (call PointerEventData (call Point 64 10.5) 4) (. PointerButton primary)))
    )
  )
  (= (. slider is-enabled) false)
  (call settle-slider window)
  (call (. t expect) "disabling during a drag ends the gesture" 4 (. slider value-changed-count))
  (call (. t expect) "disabling reports the ended phase" (. ValueChangePhase ended) (. slider last-phase))
  (blank)
  (call (. window close))
  (return t)
)

(fn-do + settle-slider _
  (param window SliderTestWindow)
  (let root (!! (. window slider markup-batch-root)))
  (call (. root markup-batch-queue checkpoint))
  (call (. window layout))
)

(type + SliderTestWindow (is Window)
  (content
    (<> This
      (= size (call Dimensions 120 21))
      (blank)
      (<> SliderProbe (id: slider) (• absolute) (• cover .parent))
    )
  )
  (fn-do + ensure-native _)
  (fn-do + render Bool
    (return false)
  )
)

(type + SliderProbe (is Slider)
  (prop + value-changed-count Size)
  (prop + last-phase ValueChangePhase)
  (subscribe-for (on event value-changed)
    (+= value-changed-count 1)
    (= last-phase (. event phase))
  )
)
