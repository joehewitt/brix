━━━━━━━━━━━━━━━━━━━━
+ MixedBindingWindow is Window

+ mode = Mode'Bool(false)
+ tap-or-hold-mode = Mode'Bool(false)
+ parts-mode = Mode'Bool(false)

────────────────────

<This
    size = (200, 200)

    <KeyShortcut "Global fallback"
        key = KeyCombo(Key.function-key(3))

    <KeyMode'Bool held-mode
        title = "Held mode"
        key = KeyCombo("x")
        mode = mode
        value = true
        activation = KeyModeActivation.held

    <KeyMode'Bool second-held-mode
        title = "Second held mode"
        key = KeyCombo("y")
        mode = mode
        value = true
        activation = KeyModeActivation.held

    <KeyMode'Bool tap-or-hold-binding
        title = "Tap or hold mode"
        key = KeyCombo("t")
        mode = tap-or-hold-mode
        value = true
        activation = KeyModeActivation.tap-or-hold

    <ActionCommand tap-command
        title = "Tap command"

    <KeyMode'Bool
        title = "Hold part"
        key = KeyCombo("h")
        mode = parts-mode
        value = true
        activation = KeyModeActivation.held

    <KeyCommand
        key = KeyCombo("h")
        command = tap-command.id
        activation = KeyCommandActivation.tap

    <ShortcutScope scope • absolute cover:.parent
        <KeyShortcut "First duplicate"
            key = KeyCombo(Key.function-key(2))
        <KeyShortcut "Second duplicate"
            key = KeyCombo(Key.function-key(2))
        <KeyShortcut "Disabled local"
            key = KeyCombo(Key.function-key(3))
            enabled = false

