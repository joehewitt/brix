━━━━━━━━━━━━━━━━━━━━
+ ShortcutTestWindow is Window

────────────────────

<This
    size = (200, 200)

    <KeyShortcut "Global"
        key = .escape

    <ShortcutContainer • absolute cover:.parent
        <KeyShortcut "Container"
            key = .arrow-right

        <ShortcutScope scope • absolute cover:.parent
            <KeyShortcut "Scoped"
                key = .arrow-up

    <ShortcutScope • absolute cover:.parent
        <KeyShortcut "Unreachable"
            key = .arrow-down

