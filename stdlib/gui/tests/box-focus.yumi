━━━━━━━━━━━━━━━━━━━━
+ do tests TestRender

. cases = TestCase("GUI Focus Ownership And Traversal")
cases.run(gui-focus-tests)
cases = cases.then("GUI Keyboard Routing And Defaults", gui-keyboard-tests)
= cases

━━━━━━━━━━━━━━━━━━━━
+ do gui-focus-tests
    - t TestCase

. trace [String]
. window = PointerTestWindow(trace)
window.size = Dimensions(120, 80)
. adapter = ReentrantFocusAdapter()
adapter.host = window
window.focus-adapter = adapter
. first = FocusProbeBox("first", trace)
. shadow = FocusShadowProbe()
. nested = FocusProbeBox("nested", trace)
. disabled = FocusProbeBox("disabled", trace)
disabled.focus-enabled = false
. input = FocusProbeBox("input", trace)
input.focus-mode = FocusMode.input
input.probe-native-focus-handle = input as Pointer
markup-append(window, first)
markup-append(window, shadow)
markup-append(shadow, nested)
markup-append(window, disabled)
markup-append(window, input)

window.open()
first.arrange-bounds(Rect(5, 5, 20, 20))
nested.arrange-bounds(Rect(35, 5, 20, 20))
disabled.arrange-bounds(Rect(65, 5, 20, 20))
input.arrange-bounds(Rect(95, 5, 20, 20))

. candidates = window.focus-candidates()
. flattened-order = candidates.length == 3
if flattened-order
    flattened-order = candidates[0] as Pointer == first as Pointer
if flattened-order
    flattened-order = candidates[1] as Pointer == nested as Pointer
if flattened-order
    flattened-order = candidates[2] as Pointer == input as Pointer
t.check("tab order flattens transparent descendants and skips disabled boxes", flattened-order)

. walk-root = FocusWalkFixtureRoot()
markup-mount-root(walk-root, walk-root)
walk-root.markup-batch-queue.checkpoint()
walk-root.layout(Rect(0, 0, 100, 60))
. walk-candidates = walk-root.focus-candidates()
t.expect("focus walk fixture keeps four reachable candidates", 4, walk-candidates.length)
. forward-matches Size = 0
for index in 0 .. < walk-candidates.length - 1
    . next = walk-root.focus-candidate-after(walk-candidates[index])
    if next && next as Pointer == walk-candidates[index + 1] as Pointer
        forward-matches += 1
t.expect("successor walk matches materialized region order", 3, forward-matches)
. backward-matches Size = 0
for index in 1 .. < walk-candidates.length
    . previous = walk-root.focus-candidate-after(walk-candidates[index], true)
    if previous && previous as Pointer == walk-candidates[index - 1] as Pointer
        backward-matches += 1
t.expect("predecessor walk matches materialized region order", 3, backward-matches)

first.request-focus()
t.check("focus state is visible before Focus publishes", first.focus-state-was-current)
t.expect("synchronous native focus echo does not duplicate Focus", 1, first.focus-count)
t.expect("synchronous native focus echo does not introduce Blur", 0, first.blur-count)

adapter.accepts = false
t.check("native first-responder refusal rejects managed focus", !input.request-focus())
t.check
    - "refusal preserves the previous focus owner"
    - window.focused-box! as Pointer == first as Pointer
adapter.accepts = true

input.request-focus()
input.focus-enabled = false
window.dispatch-key-press(KeyPressEvent(Key.unknown(90), PointerModifiers(), false, 90))
t.check("eligibility changes clear focus before the next dispatch", window.focused-box == null)
t.check("blur state is visible before Blur publishes", input.blur-state-was-current)

input.focus-enabled = true
input.request-focus()
markup-remove(window, input)
window.dispatch-key-press(KeyPressEvent(Key.unknown(91), PointerModifiers(), false, 91))
t.check("removing the owner clears focus and prevents stale routing", window.focused-box == null)

window.close()
= t

━━━━━━━━━━━━━━━━━━━━
+ do gui-keyboard-tests
    - t TestCase

. trace [String]
. window = PointerTestWindow(trace)
window.size = Dimensions(100, 60)
window.focus-adapter = GUIFocusAdapter()
. parent = FocusProbeBox("parent", trace)
parent.focus-mode = FocusMode.none
. press = FocusProbeBox("press", trace)
markup-append(window, parent)
markup-append(parent, press)
window.open()
t.check("press target takes focus", press.request-focus())

window.dispatch-key-press(KeyPressEvent(Key.enter))
window.dispatch-key-press(KeyPressEvent(Key.space))
t.expect("Enter and Space synthesize Click for press focus", 2, press.click-count)
t.expect("synthesized Click uses the ordinary route", 2, parent.click-count)

window.close()
= t

