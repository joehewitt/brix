━━━━━━━━━━━━━━━━━━━━
+ FocusWalkFixtureRoot is Box
    is MarkupRootElement

+ region-items [Size] = List'Size([1, 2])
+ markup-batch-queue := MarkupBatchQueue(this as MarkupRootElement)

────────────────────

<This • flow-col w:100 h:60
    <FocusWalkRow
        row-index = 0

    for item in #region-items
        <FocusWalkRow
            row-index = item

    <FocusWalkHiddenHost
        <FocusWalkRow
            row-index = 97

    <FocusWalkClippedHost
        <FocusWalkRow • absolute
            row-index = 98
            top = PositionOffset.coord(20)

    <FocusWalkRow
        row-index = 3

