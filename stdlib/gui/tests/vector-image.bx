(import /core/markup)
(import /graphics/boolean)
(import /graphics/color)
(import /graphics/effect)
(import /graphics/graphic)
(import /graphics/primitives)
(import /graphics/shapes)
(import /graphics/style)
(import /graphics/tests/support/geometry)
(import /graphics/vector)
(import /graphics/vector-group)
(import /gui/generated-vector-image)
(import /gui/vector-image)
(import /math)
(import /test)
(import /units)
(blank)

(main
  (call mutation-tests)
)

(fn-do + mutation-tests TestRender
  (let cases (call TestCase "VectorImage Nested Viewports"))
  (call (. cases run) vector-image-viewport-tests)
  (= cases (call (. cases then) "VectorImage Transactions" vector-image-transaction-tests))
  (= cases (call (. cases then) "Vector Primitive Invalidation" vector-primitive-invalidation-tests))
  (= cases (call (. cases then) "VectorImage Effects" vector-image-effect-tests))
  (= cases (call (. cases then) "Generated VectorImage Cache" generated-vector-image-tests))
  (return cases)
)

(fn-do + vector-image-viewport-tests _
  (param t TestCase)
  (let root (call VectorImage))
  (let child (call VectorImage))
  (= (. child view-box) (call Rect 0 0 10 10))
  (+= (. child group) (call Rectangle (call Rect 0 0 10 10)))
  (call markup-append root child)
  (call (. root group checkpoint))
  (call (. child layout) (call Rect 20 30 40 20))
  (call (. root group update) (call Rect 0 0 100 100))
  (call (. t check)
    (block
      (arg "nested viewport maps into its layout box")
      (arg (call near-rect (call Rect 30 30 20 20) (. ([] (. root group paths) 0) bounding-box)))
    )
  )
  (blank)
  (call (. child layout) (call Rect 60 10 10 30))
  (call (. root group update) (call Rect 0 0 100 100))
  (call (. t check)
    (block
      (arg "nested viewport follows its new layout box")
      (arg (call near-rect (call Rect 60 20 10 10) (. ([] (. root group paths) 0) bounding-box)))
    )
  )
  (return t)
)

(fn-do + vector-image-transaction-tests _
  (param t TestCase)
  (let root (call VectorGroup))
  (let probe (call VectorInvalidationProbe))
  (call (. root checkpoint))
  (= (. root invalidation-listener) (. probe changed))
  (call (. root begin-update))
  (let child (call PathGraphic (call rectangle (call Rect 0 0 10 10))))
  (+= root child)
  (= (. child fill) red)
  (call (. root checkpoint))
  (call (. t expect) "checkpoint does not publish" 0 (. probe count))
  (= (. child opacity) 50%%)
  (call (. root end-update))
  (call (. t expect) "transaction publishes once" 1 (. probe count))
  (call (. t check) "transaction includes geometry" (!= (/and/ (. probe kinds) graphic-change-geometry) 0))
  (call (. t check) "transaction includes appearance" (!= (/and/ (. probe kinds) graphic-change-appearance) 0))
  (call (. t check) "transaction includes composite" (!= (/and/ (. probe kinds) graphic-change-composite) 0))
  (return t)
)

(fn-do + vector-primitive-invalidation-tests _
  (param t TestCase)
  (let image (call VectorGroup))
  (let rectangle (call Rectangle (call Rect 0 0 10 10)))
  (+= image rectangle)
  (call (. image checkpoint))
  (call (. image update) (call Rect 0 0 100 100))
  (= (. rectangle rect) (call Rect 20 10 30 40))
  (call (. image update) (call Rect 0 0 100 100))
  (call (. t check)
    (block
      (arg "primitive mutation refreshes cached geometry")
      (arg (call near-rect (call Rect 20 10 30 40) (. ([] (. image paths) 0) bounding-box)))
    )
  )
  (return t)
)

(fn-do + vector-image-effect-tests _
  (param t TestCase)
  (let image (call VectorGroup (list (call rectangle (call Rect 0 0 10 10)) (call rectangle (call Rect 5 0 10 10)))))
  (let effects (list VectorEffect))
  (+= effects (call BooleanEffect))
  (= (. image effects) (call VectorEffects effects))
  (call (. image checkpoint))
  (call (. image update) (call Rect 0 0 100 100))
  (call (. t expect) "boolean effect combines paths" 1 (. image paths length))
  (blank)
  (= (. image effects) (call VectorEffects))
  (call (. image checkpoint))
  (call (. image update) (call Rect 0 0 100 100))
  (call (. t expect) "clearing style effects restores source paths" 2 (. image paths length))
  (return t)
)

(fn-do + generated-vector-image-tests _
  (param t TestCase)
  (let counter (call GenerationCounter))
  (let generated (call GeneratedVectorImage (. counter generate)))
  (let bounds (call Rect 0 0 100 100))
  (call (. generated update) bounds)
  (call (. generated update) bounds)
  (call (. t expect) "retained generator evaluates once" 1 (. counter generation-count))
  (blank)
  (call (. generated invalidate-generation))
  (call (. generated update) bounds)
  (call (. t expect) "invalidated generator reevaluates" 2 (. counter generation-count))
  (return t)
)

(type + VectorInvalidationProbe
  (prop + count Size)
  (prop + kinds U8)
  (fn-do + changed _
    (param changed-kinds U8)
    (+= count 1)
    (= kinds (/or/ kinds changed-kinds))
  )
)

(type + GenerationCounter
  (prop + generation-count Size)
  (fn-do + generate VectorGroup
    (param bounds Rect)
    (+= generation-count 1)
    (return (call VectorGroup (list (call rectangle bounds))))
  )
)
