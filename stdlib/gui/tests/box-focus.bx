(import /core/markup)
(import /graphics/primitives)
(import /gui/box)
(import /gui/events)
(import /gui/primitives)
(import /gui/tests/support/probe-boxes)
(import /gui/window)
(import /test)
(import /ui/input)
(blank)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "GUI Focus Ownership And Traversal"))
  (call (. cases run) gui-focus-tests)
  (= cases (call (. cases then) "GUI Keyboard Routing And Defaults" gui-keyboard-tests))
  (return cases)
)

(fn-do + gui-focus-tests _
  (param t TestCase)
  (let trace (list String))
  (let window (call PointerTestWindow trace))
  (= (. window size) (call Dimensions 120 80))
  (let adapter (call ReentrantFocusAdapter))
  (= (. adapter host) window)
  (= (. window focus-adapter) adapter)
  (let first (call FocusProbeBox "first" trace))
  (let shadow (call FocusShadowProbe))
  (let nested (call FocusProbeBox "nested" trace))
  (let disabled (call FocusProbeBox "disabled" trace))
  (= (. disabled focus-enabled) false)
  (let input (call FocusProbeBox "input" trace))
  (= (. input focus-mode) (. FocusMode input))
  (= (. input probe-native-focus-handle) (as input Pointer))
  (call markup-append window first)
  (call markup-append window shadow)
  (call markup-append shadow nested)
  (call markup-append window disabled)
  (call markup-append window input)
  (blank)
  (call (. window open))
  (call (. first arrange-bounds) (call Rect 5 5 20 20))
  (call (. nested arrange-bounds) (call Rect 35 5 20 20))
  (call (. disabled arrange-bounds) (call Rect 65 5 20 20))
  (call (. input arrange-bounds) (call Rect 95 5 20 20))
  (blank)
  (let candidates (call (. window focus-candidates)))
  (let flattened-order (== (. candidates length) 3))
  (if flattened-order
    (= flattened-order (== (as ([] candidates 0) Pointer) (as first Pointer)))
  )
  (if flattened-order
    (= flattened-order (== (as ([] candidates 1) Pointer) (as nested Pointer)))
  )
  (if flattened-order
    (= flattened-order (== (as ([] candidates 2) Pointer) (as input Pointer)))
  )
  (call (. t check) "tab order flattens transparent descendants and skips disabled boxes" flattened-order)
  (blank)
  (let walk-root (call FocusWalkFixtureRoot))
  (call markup-mount-root walk-root walk-root)
  (call (. walk-root markup-batch-queue checkpoint))
  (call (. walk-root layout) (call Rect 0 0 100 60))
  (let walk-candidates (call (. walk-root focus-candidates)))
  (call (. t expect) "focus walk fixture keeps four reachable candidates" 4 (. walk-candidates length))
  (let forward-matches Size 0)
  (for (in index (..< 0 (- (. walk-candidates length) 1)))
    (let next (call (. walk-root focus-candidate-after) ([] walk-candidates index)))
    (if (and next (== (as next Pointer) (as ([] walk-candidates (+ index 1)) Pointer)))
      (+= forward-matches 1)
    )
  )
  (call (. t expect) "successor walk matches materialized region order" 3 forward-matches)
  (let backward-matches Size 0)
  (for (in index (..< 1 (. walk-candidates length)))
    (let previous (call (. walk-root focus-candidate-after) ([] walk-candidates index) true))
    (if (and previous (== (as previous Pointer) (as ([] walk-candidates (- index 1)) Pointer)))
      (+= backward-matches 1)
    )
  )
  (call (. t expect) "predecessor walk matches materialized region order" 3 backward-matches)
  (blank)
  (call (. first request-focus))
  (call (. t check) "focus state is visible before Focus publishes" (. first focus-state-was-current))
  (call (. t expect) "synchronous native focus echo does not duplicate Focus" 1 (. first focus-count))
  (call (. t expect) "synchronous native focus echo does not introduce Blur" 0 (. first blur-count))
  (blank)
  (= (. adapter accepts) false)
  (call (. t check) "native first-responder refusal rejects managed focus" (not (call (. input request-focus))))
  (call (. t check)
    (block
      (arg "refusal preserves the previous focus owner")
      (arg (== (as (!! (. window focused-box)) Pointer) (as first Pointer)))
    )
  )
  (= (. adapter accepts) true)
  (blank)
  (call (. input request-focus))
  (= (. input focus-enabled) false)
  (call (. window dispatch-key-press) (call KeyPressEvent (call (. Key unknown) 90) (call PointerModifiers) false 90))
  (call (. t check) "eligibility changes clear focus before the next dispatch" (== (. window focused-box) null))
  (call (. t check) "blur state is visible before Blur publishes" (. input blur-state-was-current))
  (blank)
  (= (. input focus-enabled) true)
  (call (. input request-focus))
  (call markup-remove window input)
  (call (. window dispatch-key-press) (call KeyPressEvent (call (. Key unknown) 91) (call PointerModifiers) false 91))
  (call (. t check) "removing the owner clears focus and prevents stale routing" (== (. window focused-box) null))
  (blank)
  (call (. window close))
  (return t)
)

(fn-do + gui-keyboard-tests _
  (param t TestCase)
  (let trace (list String))
  (let window (call PointerTestWindow trace))
  (= (. window size) (call Dimensions 100 60))
  (= (. window focus-adapter) (call GUIFocusAdapter))
  (let parent (call FocusProbeBox "parent" trace))
  (= (. parent focus-mode) (. FocusMode none))
  (let press (call FocusProbeBox "press" trace))
  (call markup-append window parent)
  (call markup-append parent press)
  (call (. window open))
  (call (. t check) "press target takes focus" (call (. press request-focus)))
  (blank)
  (call (. window dispatch-key-press) (call KeyPressEvent (. Key enter)))
  (call (. window dispatch-key-press) (call KeyPressEvent (. Key space)))
  (call (. t expect) "Enter and Space synthesize Click for press focus" 2 (. press click-count))
  (call (. t expect) "synthesized Click uses the ordinary route" 2 (. parent click-count))
  (blank)
  (call (. window close))
  (return t)
)

(type + FocusWalkRow (is Box)
  (prop + row-index Size (= 0))
  (blank)
  (rule This (• w 100) (• h 10)
    (= focus-mode (. FocusMode press))
  )
)

(type + FocusWalkHiddenHost (is Box)
  (rule This
    (= display (. Display hidden))
  )
)

(type + FocusWalkClippedHost (is Box)
  (rule This (• w 100) (• h 10)
    (= overflow-x (. ScrollOverflow clip))
    (= overflow-y (. ScrollOverflow clip))
  )
)

(type + FocusWalkFixtureRoot (is Box)
  (implements MarkupRootElement)
  (prop + region-items (list Size) (= (call (of List Size) (list 1 2))))
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue (as this MarkupRootElement))))
  (content
    (<> This (• flow-col) (• w 100) (• h 60)
      (<> FocusWalkRow
        (= row-index 0)
      )
      (blank)
      (for (in item #region-items)
        (<> FocusWalkRow
          (= row-index item)
        )
      )
      (blank)
      (<> FocusWalkHiddenHost
        (<> FocusWalkRow
          (= row-index 97)
        )
      )
      (blank)
      (<> FocusWalkClippedHost
        (<> FocusWalkRow (• absolute)
          (= row-index 98)
          (= top (call (. PositionOffset coord) 20))
        )
      )
      (blank)
      (<> FocusWalkRow
        (= row-index 3)
      )
    )
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
    (let ignored (. flush applied))
  )
)

(type + FocusShadowProbe (is Box)
  (prop + is-markup-shadow _ (=> true))
)

(type + ReentrantFocusAdapter (is GUIFocusAdapter)
  (prop + host (? Window))
  (fn-do + request _
    (param box (? Box))
    (= requested-box box)
    (+= request-count 1)
    (call (?. host accept-native-focus) box)
    (return accepts)
  )
)
