(import /code/structure/rows)
(import /code/syntax)
(import /graphics/primitives)
(import /graphics/text)
(import /gui/box)
(import /gui/markdown)
(import /gui/source-editor/source-style)
(import /gui/styles)
(import /gui/text)
(import /gui/theme)
(import /gui/window)
(import /test)
(blank)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "Markdown Code Spans"))
  (call (. cases run) span-tests)
  (return cases)
)

(fn-do _ span-tests _
  (param t TestCase)
  (let window (call CodeSpanWindow))
  (call (. window open))
  (call settle window)
  (call (. t expect) "an exit takes the editor's exit color" (. (. window exit) $source-exit-color) (. (. window exit) $color))
  (call (. t expect) "a sigil takes the editor's sigil color" (. (. window sigil) $source-sigil-color) (. (. window sigil) $color))
  (call (. t expect) "an import's path takes the preamble color" (. (. window path) $source-imports-prefix-color) (. (. window path) $color))
  (call (. t expect) "a run with no kind takes its role's color" (. (. window role) $gui-syntax-keyword-color) (. (. window role) $color))
  (call (. t expect) "a definition is bold" (. FontWeight bold) (. (. window definition) $font-weight))
  (call (. t expect) "an exit is not bold" (. FontWeight regular) (. (. window exit) $font-weight))
  (call (. t expect) "an optional span is italic" (. FontSlant italic) (. (. window optional) $font-slant))
  (call (. t expect) "a span that is not optional is upright" (. FontSlant upright) (. (. window exit) $font-slant))
  (call (. window close))
  (return t)
)

(fn-do _ settle _
  (param window Window)
  (let root (. window markup-batch-root))
  (if root
    (call (. root markup-batch-queue checkpoint))
  )
  (call (. window layout))
  (if root
    (call (. root markup-batch-queue checkpoint))
  )
  (call (. window layout))
)

(type _ CodeSpanWindow (is Window)
  (using GUIDefaultTheme)
  (content
    (<> This
      (= size (call Dimensions 400 200))
      (<> Text
        (<> MarkdownCodeSpan (id: exit)
          (= run (call MarkdownCodeRun (block (:text "return") (:kind (. SourceSpanKind exit)))))
        )
        (<> MarkdownCodeSpan (id: sigil)
          (= run (call MarkdownCodeRun (block (:text "•") (:kind (. SourceSpanKind punctuation)))))
        )
        (<> MarkdownCodeSpan (id: path)
          (= run (call MarkdownCodeRun (block (:text "/gui") (:kind (. SourceSpanKind string)) (:is-preamble true))))
        )
        (<> MarkdownCodeSpan (id: role)
          (= run (call MarkdownCodeRun (block (:text "if") (:role (. SyntaxRole keyword)))))
        )
        (<> MarkdownCodeSpan (id: definition)
          (= run (call MarkdownCodeRun (block (:text "card") (:kind (. SourceSpanKind definition)))))
        )
        (<> MarkdownCodeSpan (id: optional)
          (= run (call MarkdownCodeRun (block (:text "label") (:kind (. SourceSpanKind identifier)) (:is-optional true))))
        )
      )
    )
  )
)
