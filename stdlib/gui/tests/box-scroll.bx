(import /core/markup)
(import /graphics/point)
(import /graphics/primitives)
(import /gui/events)
(import /gui/primitives)
(import /gui/tests/support/probe-boxes)
(import /gui/window)
(import /test)
(import /ui/input)
(blank)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "GUI Box Scroll State And Reveal"))
  (call (. cases run) gui-box-scroll-state-tests)
  (= cases (call (. cases then) "GUI Box Scroll Geometry" gui-box-scroll-geometry-tests))
  (= cases (call (. cases then) "GUI Nested Scroll Defaults" gui-nested-scroll-default-tests))
  (= cases (call (. cases then) "GUI Scroll Reveal And Focus" gui-scroll-reveal-focus-tests))
  (return cases)
)

(fn-do + gui-box-scroll-state-tests _
  (param t TestCase)
  (let root (call ProbeRoot))
  (let scroller (call ScrollProbeBox))
  (call markup-append root scroller)
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (call (. scroller arrange-bounds) (call Rect 0 0 20 20))
  (= (. scroller inner-width) 100)
  (= (. scroller inner-height) 100)
  (call (. scroller scroll-bounds-visible) (call Rect 70 75 10 10))
  (call (. t expect) "nearest reveal moves the minimum distance" (call Point 60 65) (. scroller scroll-position))
  (blank)
  (call (. scroller scroll-to) (call Point 0 0))
  (call (. scroller scroll-bounds-visible) (call Rect 40 40 40 40))
  (call (. t expect) "oversized nearest reveal keeps its leading edge" (call Point 40 40) (. scroller scroll-position))
  (call (. scroller scroll-to) (call Point 80 80))
  (call (. scroller scroll-bounds-visible) (call Rect 40 40 40 40))
  (call (. t expect)
    (block
      (arg "oversized nearest reveal keeps its trailing edge")
      (arg (call Point 60 60))
      (arg (. scroller scroll-position))
    )
  )
  (return t)
)

(fn-do + gui-box-scroll-geometry-tests _
  (param t TestCase)
  (let trace (list String))
  (let window (call PointerTestWindow trace))
  (= (. window size) (call Dimensions 80 60))
  (let scroller (call ScrollProbeBox))
  (let child (call PointerProbeBox "child" trace))
  (call markup-append window scroller)
  (call markup-append scroller child)
  (call (. window open))
  (call (. scroller arrange-bounds) (call Rect 10 10 30 20))
  (= (. scroller inner-width) 30)
  (= (. scroller inner-height) 60)
  (call (. child arrange-bounds) (call Rect 10 25 20 10))
  (call (. scroller scroll-to) (call Point 0 10))
  (blank)
  (call (. t expect)
    (block
      (arg "route coordinates include live ancestor scroll")
      (arg (call Point 5 1))
      (arg (call (. child point-in-box) (call Point 15 16)))
    )
  )
  (blank)
  (call (. window dispatch-pointer-event) (call PointerDownEvent (call PointerEventData (call Point 15 16) 7)))
  (call (. scroller scroll-to) (call Point 0 12))
  (call (. trace clear))
  (call (. window dispatch-pointer-event)
    (block
      (arg (call PointerDragEvent (call PointerEventData (call Point 15 16) 7) (. PointerButton primary) (call Point 0 0)))
    )
  )
  (call (. t expect)
    (block
      (arg "captured route recomputes after ancestor scrolling")
      (arg "child:drag:5:3")
      (arg ([] trace 0))
    )
  )
  (blank)
  (call (. window close))
  (return t)
)

(fn-do + gui-nested-scroll-default-tests _
  (param t TestCase)
  (let trace (list String))
  (let window (call PointerTestWindow trace))
  (= (. window size) (call Dimensions 120 100))
  (let outer (call HorizontalScrollProbeBox))
  (let inner (call VerticalScrollProbeBox))
  (let target (call PointerProbeBox "target" trace))
  (let other (call VerticalScrollProbeBox))
  (let other-target (call PointerProbeBox "other" trace))
  (call markup-append window outer)
  (call markup-append outer inner)
  (call markup-append inner target)
  (call markup-append window other)
  (call markup-append other other-target)
  (call (. window open))
  (call (. outer arrange-bounds) (call Rect 10 10 60 60))
  (= (. outer inner-width) 100)
  (= (. outer inner-height) 100)
  (call (. inner arrange-bounds) (call Rect 10 10 100 60))
  (= (. inner inner-width) 100)
  (= (. inner inner-height) 100)
  (call (. target arrange-bounds) (call Rect 10 10 20 20))
  (call (. other arrange-bounds) (call Rect 80 10 30 30))
  (= (. other inner-width) 30)
  (= (. other inner-height) 100)
  (call (. other-target arrange-bounds) (call Rect 80 10 20 20))
  (blank)
  (call (. window dispatch-pointer-event)
    (block
      (arg
        (call ScrollEvent
          (block
            (arg (call PointerEventData (call Point 15 15)))
            (arg 5)
            (arg 7)
            (arg true)
            (arg (. ScrollPhase began))
          )
        )
      )
    )
  )
  (call (. t expect) "inner vertical Box consumes precise y" 7 (. inner scroll-y))
  (call (. t expect) "outer horizontal Box consumes precise x" 5 (. outer scroll-x))
  (blank)
  (call (. inner scroll-to) (call Point 0 (. inner scroll-max y)))
  (call (. window dispatch-pointer-event)
    (block
      (arg
        (call ScrollEvent
          (block
            (arg (call PointerEventData (call Point 15 15)))
            (arg 0)
            (arg 10)
            (arg true)
            (arg (. ScrollPhase changed))
          )
        )
      )
    )
  )
  (call (. t expect) "edge remainder chains to the vertical ancestor" 10 (. outer scroll-y))
  (call (. window dispatch-pointer-event)
    (block
      (arg (call ScrollEvent (call PointerEventData (call Point 15 15)) 0 0.25 true (. ScrollPhase changed)))
    )
  )
  (blank)
  (call (. window dispatch-pointer-event)
    (block
      (arg
        (call ScrollEvent
          (block
            (arg (call PointerEventData (call Point 85 15)))
            (arg 0)
            (arg 0)
            (arg true)
            (arg (. ScrollPhase none))
            (arg (. ScrollPhase ended))
          )
        )
      )
    )
  )
  (call (. t expect) "final momentum delivery remains on the latched route" 4 (. target scroll-count))
  (call (. window dispatch-pointer-event)
    (block
      (arg (call ScrollEvent (call PointerEventData (call Point 85 15)) 0 3 true (. ScrollPhase none)))
    )
  )
  (call (. t expect) "final momentum end releases the route latch" 3 (. other scroll-y))
  (call (. t expect) "released route no longer publishes to the original target" 4 (. target scroll-count))
  (blank)
  (call (. window close))
  (return t)
)

(fn-do + gui-scroll-reveal-focus-tests _
  (param t TestCase)
  (let trace (list String))
  (let window (call PointerTestWindow trace))
  (= (. window size) (call Dimensions 80 60))
  (= (. window focus-adapter) (call GUIFocusAdapter))
  (let scroller (call VerticalScrollProbeBox))
  (let target (call FocusProbeBox "target" trace))
  (call markup-append window scroller)
  (call markup-append scroller target)
  (call (. window open))
  (call (. scroller arrange-bounds) (call Rect 0 0 40 30))
  (= (. scroller inner-width) 40)
  (= (. scroller inner-height) 100)
  (call (. target arrange-bounds) (call Rect 0 70 30 10))
  (call (. window update-layout))
  (blank)
  (call (. t check) "focus request reveals before native focus" (call (. target request-focus)))
  (call (. t expect) "focus reveal uses the same Box state" 50 (. scroller scroll-y))
  (blank)
  (call (. target clear-focus))
  (call (. scroller scroll-to) (call Point 0 45))
  (call (. window dispatch-pointer-event) (call PointerDownEvent (call PointerEventData (call Point 5 27))))
  (call (. window dispatch-pointer-event) (call PointerUpEvent (call PointerEventData (call Point 5 27))))
  (call (. t check) "a press focuses a partly shown box" (. target is-focused))
  (call (. t expect) "a press leaves the scroll position alone" 45 (. scroller scroll-y))
  (blank)
  (call (. scroller scroll-to) (call Point 0 0))
  (call (. target invalidate-layout))
  (call (. t check)
    (block
      (arg "dirty layout queues reveal instead of using stale geometry")
      (arg (not (call (. scroller ensure-visible) target)))
    )
  )
  (call (. window update-layout))
  (call (. t expect) "queued reveal settles after layout" 50 (. scroller scroll-y))
  (blank)
  (call (. scroller scroll-to) (call Point 0 0))
  (call (. target invalidate-layout))
  (call (. scroller ensure-visible) target)
  (call markup-remove scroller target)
  (call (. window update-layout))
  (call (. t expect) "queued reveal drops a removed generation" 0 (. scroller scroll-y))
  (blank)
  (call (. window close))
  (blank)
  (let contained-window (call PointerTestWindow trace))
  (= (. contained-window size) (call Dimensions 80 60))
  (let outer (call ScrollProbeBox))
  (let inner (call ContainedVerticalScrollProbeBox))
  (let row (call PointerProbeBox "row" trace))
  (call markup-append contained-window outer)
  (call markup-append outer inner)
  (call markup-append inner row)
  (call (. contained-window open))
  (call (. outer arrange-bounds) (call Rect 0 0 40 30))
  (= (. outer inner-width) 40)
  (= (. outer inner-height) 80)
  (call (. inner arrange-bounds) (call Rect 0 0 40 50))
  (= (. inner inner-width) 40)
  (= (. inner inner-height) 80)
  (call (. row arrange-bounds) (call Rect 0 20 20 10))
  (call (. inner scroll-to) (call Point 0 30))
  (call (. contained-window dispatch-pointer-event)
    (block
      (arg (call ScrollEvent (call PointerEventData (call Point 5 5)) 0 8 true (. ScrollPhase none)))
    )
  )
  (call (. t expect) "contained overscroll does not move an ancestor" 0 (. outer scroll-y))
  (blank)
  (call (. contained-window close))
  (return t)
)

(type + HorizontalScrollProbeBox (is ScrollProbeBox))

(type + ContainedVerticalScrollProbeBox (is VerticalScrollProbeBox)
  (rule This
    (= overscroll-behavior-y (. OverscrollBehavior contain))
  )
)
