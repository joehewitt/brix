tests()

━━━━━━━━━━━━━━━━━━━━
+ do tests TestRender

. cases = TestCase("GUI Drag Start")
cases.run(drag-start-tests)
cases = cases.then("GUI Drag Targets", drag-target-tests)
cases = cases.then("GUI Drag Cancel", drag-cancel-tests)
cases = cases.then("GUI Drag Ghost", drag-ghost-tests)
cases = cases.then("GUI Drag Scroll", drag-scroll-tests)
= cases

━━━━━━━━━━━━━━━━━━━━
_ do drag-start-tests
    - t TestCase

. window = open-drag-window()
down(window, Point(50, 50))
drag(window, Point(52, 50))
drag(window, Point(54, 50))
t.expect("the session swallows the pull", 1, window.pulls)
t.expect("the session starts at the press", Point(50, 50), window.drag-session!.origin)
t.check("a session clears the pressed state", !window.source.is-pressed)

drag(window, Point(60, 50))
t.expect("a drag is offered once", "start", window.story)
t.expect("later pulls stay with the session", 1, window.pulls)
up(window, Point(60, 50))
t.expect("releasing over nothing ends without a drop", "start end:cancelled", window.story)
t.check("the session ends on release", window.drag-session == null)

window.begins = false
window.log.clear()
down(window, Point(50, 50))
drag(window, Point(60, 50))
drag(window, Point(70, 50))
t.expect("a declined offer is not repeated", "start", window.story)
t.expect("a declined offer leaves pointer drags alone", 3, window.pulls)

━━━━━━━━━━━━━━━━━━━━
_ do drag-target-tests
    - t TestCase

. window = open-drag-window()
down(window, Point(50, 50))
drag(window, Point(150, 50))
drag(window, Point(250, 50))
t.expect("leaving the target tells it", "start over leave", window.story)

drag(window, Point(150, 50))
up(window, Point(160, 50))
t.expect
    - "a release over the target drops"
    - "start over leave over over drop:item end:dropped"
    - window.story
t.expect("the drop lands at the release point", Point(160, 50), window.dropped-at)

window.accepts = false
window.log.clear()
down(window, Point(50, 50))
drag(window, Point(150, 50))
up(window, Point(150, 50))
t.expect("a refusing target gets no drop", "start end:cancelled", window.story)

━━━━━━━━━━━━━━━━━━━━
_ do drag-cancel-tests
    - t TestCase

. window = open-drag-window()
down(window, Point(50, 50))
drag(window, Point(150, 50))
window.dispatch-key-press(KeyPressEvent(Key.escape))
t.expect("escape cancels the drag", "start over leave end:cancelled", window.story)
t.check("escape ends the session", window.drag-session == null)
up(window, Point(150, 50))
t.expect("a release after a cancel drops nothing", "start over leave end:cancelled", window.story)

window.log.clear()
down(window, Point(50, 50))
drag(window, Point(150, 50))
window.accept-window-deactivated()
t.expect("deactivating the window cancels the drag", "start over leave end:cancelled", window.story)

window.accept-window-activated()
window.log.clear()
down(window, Point(50, 50))
drag(window, Point(150, 50))
window.cancel-drag()
t.expect("a drag can be cancelled by hand", "start over leave end:cancelled", window.story)

window.log.clear()
down(window, Point(50, 50))
drag(window, Point(150, 50))
window.dispatch-pointer-event(PointerMoveEvent(held(Point(160, 50))))
move(window, Point(160, 50))
t.expect
    - "a move with the button up cancels the drag"
    - "start over over leave end:cancelled"
    - window.story

window.log.clear()
down(window, Point(50, 50))
drag(window, Point(150, 50))
markup-remove(window, window.source)
window.dispatch-key-input(KeyInputEvent(""))
t.check("removing the source ends the session", window.drag-session == null)

━━━━━━━━━━━━━━━━━━━━
_ do drag-ghost-tests
    - t TestCase

. window = open-drag-window()
down(window, Point(30, 40))
drag(window, Point(150, 60))
. ghost = window.drag-session!.ghost
t.check("the source is pictured as the ghost", ghost != null)
t.expect("the ghost is as large as the source", Dimensions(100, 100), ghost!.size)
t.expect("the ghost keeps the grip under the pointer", Rect(120, 20, 100, 100), ghost!.frame)
up(window, Point(150, 60))

window.pictured = window.offstage
down(window, Point(30, 40))
drag(window, Point(150, 60))
. staged = window.drag-session!.ghost
t.check("a box that is not shown can be the ghost", staged != null)
t.expect("the ghost takes the pictured box's size", Dimensions(40, 20), staged!.size)
t.expect("a box that is not shown hangs beside the pointer", Rect(138, 50, 40, 20), staged!.frame)
up(window, Point(150, 60))

━━━━━━━━━━━━━━━━━━━━
_ do drag-scroll-tests
    - t TestCase

. window = open-drag-window()
down(window, Point(50, 50))
drag(window, Point(350, 50))
drag(window, Point(350, 95))
window.step-drag-scroll()
t.expect("scrolling asks the target again", "start over over over", window.story)
up(window, Point(350, 50))

━━━━━━━━━━━━━━━━━━━━
_ do open-drag-window

<DragTestWindow window

window.open()
window.layout()
= window

━━━━━━━━━━━━━━━━━━━━
_ do down
    - window Window
    - point Point

window.dispatch-pointer-event(PointerDownEvent(PointerEventData(point)))

━━━━━━━━━━━━━━━━━━━━
_ do drag
    - window Window
    - point Point

window.dispatch-pointer-event(PointerDragEvent(PointerEventData(point)))

━━━━━━━━━━━━━━━━━━━━
_ do up
    - window Window
    - point Point

window.dispatch-pointer-event(PointerUpEvent(PointerEventData(point)))

━━━━━━━━━━━━━━━━━━━━
_ do move
    - window Window
    - point Point

window.dispatch-pointer-event(PointerMoveEvent(PointerEventData(point)))

━━━━━━━━━━━━━━━━━━━━
_ held
    - point Point

PointerEventData(point, 0, PointerDeviceKind.mouse, PointerModifiers(), 1)

━━━━━━━━━━━━━━━━━━━━
+ DragTestPayload is Tuple
    is DragPayload

+ label String

────────────────────
+ get drag-kind

"test"

━━━━━━━━━━━━━━━━━━━━
+ DragTestWindow is Window

+ begins = true
+ accepts = true
+ pictured Box?
+ log [String]
+ pulls = 0
+ dropped-at Point
+ story => " ".join(each in log)

────────────────────

<This • flex-row
    size = (400, 120)
    <Box source • w:100 h:100 bg:RGBA("#e02020")
    <Box target • w:100 h:100
    <Box other • w:100 h:100
    <Box scroller • flex-col w:100 h:100
        overflow-y = ScrollOverflow.auto
        <Box • w:100 h:400
    <Box offstage • absolute w:40 h:20 bg:RGBA("#20e020")
        display = Display.invisible
        left = PositionOffset.coord(0)
        top = PositionOffset.coord(100)

────────────────────
for event on source.drag-start

log += "start"
if begins
    event.begin(DragTestPayload("item"), pictured)

────────────────────
for event on source.pointer-drag

pulls += 1

────────────────────
for event on source.drag-end

. outcome = if event.dropped then "end:dropped" else "end:cancelled"
log += outcome

────────────────────
for event on target.drag-over

if accepts && event.payload is DragTestPayload
    log += "over"
    event.accept()

────────────────────
for event on target.drag-leave

log += "leave"

────────────────────
for event on target.drop

log += "drop:${(event.payload as DragTestPayload).label}"
dropped-at = event.point

────────────────────
for event on scroller.drag-over

log += "over"
event.accept(scroller)

────────────────────
+ do ensure-native

────────────────────
+ render

true

────────────────────
+ do schedule-render
