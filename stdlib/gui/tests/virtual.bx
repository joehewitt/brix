(import /core/markup)
(import /graphics/color)
(import /graphics/point)
(import /graphics/primitives)
(import /gui/box)
(import /gui/events)
(import /gui/primitives)
(import /gui/virtual)
(import /gui/window)
(import /test)
(import /ui/input)
(import /ui/virtual)
(import /ui/virtual-layout)
(blank)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "GUI Virtual Anchor"))
  (call (. cases run) virtual-anchor-tests)
  (= cases (call (. cases then) "GUI Virtual Two Axis" virtual-two-axis-tests))
  (= cases (call (. cases then) "GUI Virtual Overscan Focus" virtual-overscan-focus-tests))
  (= cases (call (. cases then) "GUI Virtual Input Release" virtual-input-release-tests))
  (= cases (call (. cases then) "GUI Virtual Measured Rows" virtual-measured-row-tests))
  (= cases (call (. cases then) "GUI Virtual Measured Anchor" virtual-measured-anchor-tests))
  (= cases (call (. cases then) "GUI Virtual Measured Growth" virtual-measured-growth-tests))
  (= cases (call (. cases then) "GUI Virtual End Anchor" virtual-end-anchor-tests))
  (= cases (call (. cases then) "GUI Virtual End Anchor Resize" virtual-end-anchor-resize-tests))
  (= cases (call (. cases then) "GUI Virtual Growth Reveal" virtual-growth-reveal-tests))
  (= cases (call (. cases then) "GUI Virtual Scroll Restore" virtual-scroll-restore-tests))
  (= cases (call (. cases then) "GUI Virtual Natural Limit" virtual-natural-limit-tests))
  (= cases (call (. cases then) "GUI Virtual Ancestor Clip" virtual-ancestor-clip-tests))
  (= cases (call (. cases then) "GUI Virtual Nested Clip" virtual-nested-clip-tests))
  (= cases (call (. cases then) "GUI Virtual Side Clip" virtual-side-clip-tests))
  (= cases (call (. cases then) "GUI Virtual Measured Side Clip" virtual-measured-side-clip-tests))
  (return cases)
)

(fn-do _ virtual-growth-reveal-tests _
  (param t TestCase)
  (let window (call open-virtual-window))
  (let region (. window region))
  (let content (. region content-bounds))
  (= (. window source count) 100vcoord)
  (call (. window layout))
  (= (. window source count) 200vcoord)
  (= t
    (call (. t check)
      (block
        (arg "an address the source has just gained scrolls")
        (arg (call (. region scroll-to-address) 199 (. ScrollAlignment end)))
      )
    )
  )
  (= t (call (. t expect) "the scroll is not held to the extent before the growth" 3800.0 (. region scroll-y)))
  (call (. window layout))
  (= t (call (. t expect) "the scroll survives the layout that follows" 3800.0 (. region scroll-y)))
  (let last (!! (call root-for-address region 199)))
  (= t
    (call (. t expect)
      (block
        (arg "the new last row sits at the bottom")
        (arg (. content bottom))
        (arg (. (call (. last presentation-rect) (. last bounds)) bottom))
      )
    )
  )
  (return t)
)

(fn-do _ virtual-scroll-restore-tests _
  (param t TestCase)
  (<> VirtualSwapWindow (id: window))
  (blank)
  (call (. window open))
  (call (. window layout))
  (let region (. window region))
  (let content (. region content-bounds))
  (= (. window source) (call VirtualRangeSource 1000vcoord))
  (call (. region restore-scroll) (call Point 0 4010))
  (= t (call (. t expect) "the scroll waits for the new source" 0.0 (. region scroll-y)))
  (call settle-swap window)
  (= t (call (. t expect) "the new source opens at the restored scroll" 4010.0 (. region scroll-y)))
  (let top (!! (call root-for-address region 200)))
  (= t
    (call (. t expect)
      (block
        (arg "rows are bound at the restored scroll")
        (arg (- (. content y) 10))
        (arg (. (call (. top presentation-rect) (. top bounds)) y))
      )
    )
  )
  (= (. window source) (call VirtualRangeSource 100vcoord))
  (call (. region restore-scroll) (call Point 0 4010))
  (call settle-swap window)
  (= t (call (. t expect) "a restored scroll past the end is held to the extent" 1800.0 (. region scroll-y)))
  (= (. window source) (call VirtualRangeSource 1000vcoord))
  (call settle-swap window)
  (= t (call (. t expect) "a swap without a restored scroll keeps the scroll" 1800.0 (. region scroll-y)))
  (return t)
)

(fn-do _ settle-swap _
  (param window VirtualSwapWindow)
  (let root (. window markup-batch-root))
  (if root
    (call (. root markup-batch-queue checkpoint))
  )
  (call (. window layout))
)

(type + VirtualSwapWindow (is Window)
  (prop + source VirtualRangeSource (= (call VirtualRangeSource 5vcoord)))
  (content
    (<> This (• flex-col)
      (= size (tuple 320 400))
      (blank)
      (<> (of VirtualRegion I64) (id: region) (• h 200)
        (= source #source)
        (= virtual-layout (call VerticalFixedLayout 20vcoord))
        (blank)
        (<> VirtualTestRow (slot: row) (param: slot)
          (= address (. slot #address))
        )
      )
    )
  )
  (fn-do + ensure-native _)
  (fn-do + render Bool
    (return false)
  )
)

(fn-do _ virtual-anchor-tests _
  (param t TestCase)
  (let window (call open-virtual-window))
  (let region (. window region))
  (let content (. region content-bounds))
  (call (. region scroll-to-address) 500000000)
  (call (. window layout))
  (= t (call (. t expect) "the far address aligns to the top" 10000000000.0 (. region scroll-y)))
  (let far (!! (call root-for-address region 500000000)))
  (= t (call (. t expect) "the far row sits at the content top" (. content y) (. far bounds y)))
  (let hit (call (. window hit-test) (call Point 10 (+ (. content y) 5))))
  (= t (call (. t expect) "hit testing reaches far rows" 500000000 (call row-address hit)))
  (blank)
  (call (. region scroll-to) (call Point 0 10000030000))
  (call (. window layout))
  (let drifted (!! (call root-for-address region 500001500)))
  (= t
    (call (. t expect)
      (block
        (arg "rows present at their logical position")
        (arg (. content y))
        (arg (. (call (. drifted presentation-rect) (. drifted bounds)) y))
      )
    )
  )
  (blank)
  (call (. region scroll-to) (call Point 0 10000070000.5))
  (call (. window layout))
  (let rebased (!! (call root-for-address region 500003500)))
  (= t
    (call (. t expect)
      (block
        (arg "rebased rows present with the fraction rounded to the pixel grid")
        (arg (- (. content y) 1))
        (arg (. (call (. rebased presentation-rect) (. rebased bounds)) y))
      )
    )
  )
  (blank)
  (let below (!! (call row-for-address region 500003510)))
  (call (. window control-child invalidate-layout))
  (call (. region ensure-visible) below)
  (call (. window layout))
  (= t (call (. t expect) "ensure-visible scrolls in logical coordinates" 10000070020.0 (. region scroll-y)))
  (return t)
)

(fn-do _ virtual-two-axis-tests _
  (param t TestCase)
  (let window (call open-two-axis-window))
  (let wide (. window wide))
  (call (. wide scroll-to) (call Point 300 40))
  (call (. window layout))
  (call (. wide scroll-to) (call Point 500 40))
  (call (. window layout))
  (call (. wide scroll-to-address) 50)
  (call (. window layout))
  (= t (call (. t expect) "wide addresses keep the horizontal scroll" (call Point 500 1000) (. wide scroll-position)))
  (return t)
)

(fn-do _ virtual-overscan-focus-tests _
  (param t TestCase)
  (let window (call open-virtual-window))
  (let region (. window region))
  (= (. window focus-adapter) (call GUIFocusAdapter))
  (call (. region scroll-to) (call Point 0 20000))
  (call (. window layout))
  (call (. window move-focus))
  (= t (call (. t expect) "traversal starts at the first visible row" 1000 (call row-address (. window focused-box))))
  (blank)
  (call (. region scroll-to) (call Point 0 20040))
  (call (. window layout))
  (call (. window move-focus))
  (= t (call (. t expect) "traversal skips overscan rows" 1002 (call row-address (. window focused-box))))
  (blank)
  (let focused (!! (call row-for-address region 1002)))
  (call (. region scroll-to) (call Point 0 30000))
  (call (. window layout))
  (= t (call (. t check) "recycling a focused row releases focus" (not (. window focused-box))))
  (= t (call (. t expect) "the recycled row receives one blur" 1 (. focused blur-count)))
  (call (. window move-focus))
  (= t (call (. t expect) "traversal resumes at the first visible row" 1500 (call row-address (. window focused-box))))
  (return t)
)

(fn-do _ virtual-input-release-tests _
  (param t TestCase)
  (let window (call open-virtual-window))
  (let region (. window region))
  (let content (. region content-bounds))
  (let point (call Point 10 (+ (. content y) 50)))
  (call (. window dispatch-pointer-event) (call ScrollEvent (call PointerEventData point) 0 1000))
  (blank)
  (let press-point (call Point 10 (+ (. content y) 70)))
  (call (. window dispatch-pointer-event)
    (block
      (arg (call PointerDownEvent (call PointerEventData press-point) (. PointerButton primary) 1 7))
    )
  )
  (let pressed (!! (call row-for-address region 2003)))
  (call (. region scroll-to) (call Point 0 80000))
  (call (. window layout))
  (= t (call (. t check) "recycling a pressed row releases the press" (not (. pressed is-pressed))))
  (call (. window dispatch-pointer-event) (call PointerUpEvent (call PointerEventData press-point)))
  (= t (call (. t expect) "a recycled press does not click" 0 (. pressed click-count)))
  (return t)
)

(fn-do _ root-for-address (? (of VirtualSlotRoot I64))
  (param region (of VirtualRegion I64))
  (param address I64)
  (for (in index (..< 0 (. region pool-size)))
    (let root (call (. region root-at) index))
    (return-if root (if (and root (. root slot is-bound) (== (. root slot address) address))))
  )
  (return null)
)

(fn-do _ row-for-address (? VirtualTestRow)
  (param region (of VirtualRegion I64))
  (param address I64)
  (let root (call root-for-address region address))
  (return-if (if (not root)))
  (return (as (. root %first-child) VirtualTestRow))
)

(fn-expr _ row-address _
  (param box (? Box))
  (match box
    (case (: row VirtualTestRow)
      (. row address)
    )
    (default
      -1
    )
  )
)

(fn-do _ virtual-measured-row-tests _
  (param t TestCase)
  (let window (call open-measured-window))
  (let region (. window region))
  (let content (. region content-bounds))
  (= t
    (call (. t expect)
      (block
        (arg "measured rows replace their estimates in the extent")
        (arg 3060vcoord)
        (arg (. region virtual-extent-y known))
      )
    )
  )
  (let third (!! (call measured-root region 2)))
  (= t (call (. t expect) "rows stack by their measured heights" (+ (. content y) 60) (. third bounds y)))
  (= t (call (. t expect) "rows take their measured height" 60.0 (. third bounds height)))
  (= t (call (. t check) "rows past the measured window depart" (not (call measured-root region 6))))
  (return t)
)

(fn-do _ virtual-measured-anchor-tests _
  (param t TestCase)
  (let window (call open-measured-window))
  (let region (. window region))
  (let content (. region content-bounds))
  (= t (call (. t check) "the region scrolls into unvisited rows" (call (. region scroll-to) (call Point 0 1500))))
  (call (. window layout))
  (let landed (!! (call measured-root region 48)))
  (= t (call (. t expect) "measuring keeps the leading row at the viewport top" 1540.0 (. region scroll-y)))
  (= t
    (call (. t expect)
      (block
        (arg "the leading row presents at the content top")
        (arg (. content y))
        (arg (. (call (. landed presentation-rect) (. landed bounds)) y))
      )
    )
  )
  (= t (call (. t expect) "measured rows correct the extent" 3160vcoord (. region virtual-extent-y known)))
  (blank)
  (= t (call (. t check) "the region scrolls above measured rows" (call (. region scroll-to) (call Point 0 1400))))
  (call (. window layout))
  (= t (call (. t expect) "rows measured above shift the scroll position" 1430.0 (. region scroll-y)))
  (= t
    (call (. t expect)
      (block
        (arg "rows already measured keep their place on screen")
        (arg (+ (. content y) 140))
        (arg (. (call (. landed presentation-rect) (. landed bounds)) y))
      )
    )
  )
  (= t (call (. t expect) "rows measured above grow the extent" 3190vcoord (. region virtual-extent-y known)))
  (blank)
  (= t (call (. t check) "a measured address scrolls" (call (. region scroll-to-address) 48)))
  (call (. window layout))
  (= t (call (. t expect) "measured addresses scroll to their row" 1570.0 (. region scroll-y)))
  (return t)
)

(fn-do _ virtual-measured-growth-tests _
  (param t TestCase)
  (let window (call open-measured-window))
  (let region (. window region))
  (let row (!! (call measured-row region 1)))
  (let below (!! (call measured-root region 2)))
  (let start (. region virtual-extent-y known))
  (= (. row grown) 25)
  (call settle-measured window)
  (= t (call (. t expect) "a growing row takes its new height" 65.0 (. (!! (call measured-root region 1)) bounds height)))
  (= t (call (. t expect) "rows below a growing row move down" (+ (. region content-bounds y) 85) (. below bounds y)))
  (= t (call (. t expect) "a growing row grows the extent" (+ start 25vcoord) (. region virtual-extent-y known)))
  (= t (call (. t expect) "growth below the viewport top keeps the scroll position" 0.0 (. region scroll-y)))
  (blank)
  (call (. region scroll-to) (call Point 0 100))
  (call (. window layout))
  (let visible (!! (call measured-root region 3)))
  (let resting (. (call (. visible presentation-rect) (. visible bounds)) y))
  (= (. row grown) 5)
  (call settle-measured window)
  (= t (call (. t expect) "a row shrinking above the viewport shifts the scroll" 80.0 (. region scroll-y)))
  (= t
    (call (. t expect)
      (block
        (arg "visible rows hold still when a row above shrinks")
        (arg resting)
        (arg (. (call (. visible presentation-rect) (. visible bounds)) y))
      )
    )
  )
  (return t)
)

(fn-do _ virtual-end-anchor-tests _
  (param t TestCase)
  (<> VirtualMeasuredWindow (id: window)
    (= anchors-end true)
  )
  (blank)
  (call (. window open))
  (call (. window layout))
  (let region (. window region))
  (let content (. region content-bounds))
  (= t (call (. t expect) "an end-anchored region opens at its end" (. region scroll-max y) (. region scroll-y)))
  (= t (call (. t expect) "the end reflects measured rows" 2880.0 (. region scroll-y)))
  (let last (!! (call measured-root region 99)))
  (= t
    (call (. t expect)
      (block
        (arg "the last row sits at the viewport bottom")
        (arg (. content bottom))
        (arg (. (call (. last presentation-rect) (. last bounds)) bottom))
      )
    )
  )
  (blank)
  (= (. (!! (call measured-row region 99)) grown) 30)
  (call settle-measured window)
  (= t (call (. t expect) "a growing last row keeps the end in view" 2910.0 (. region scroll-y)))
  (= t (call (. t expect) "the region still rests at its end" (. region scroll-max y) (. region scroll-y)))
  (blank)
  (= (. window source count) 101vcoord)
  (call (. window settle-layout))
  (= t (call (. t expect) "an appended row keeps the end in view" 2950.0 (. region scroll-y)))
  (= t (call (. t check) "the appended row is bound" (!= (call measured-root region 100) null)))
  (blank)
  (let consumed (call (. region scroll-by) (call Point 0 -30) (. ScrollCause wheel)))
  (call (. window layout))
  (= t (call (. t check) "scrolling away stops following the end" (not (. region follows-end))))
  (let away (. region scroll-y))
  (= (. (!! (call measured-row region 99)) grown) 60)
  (call settle-measured window)
  (= t (call (. t expect) "growth leaves a region that stopped following alone" away (. region scroll-y)))
  (blank)
  (call (. region follow-end))
  (call (. window layout))
  (= t (call (. t expect) "following again returns to the end" (. region scroll-max y) (. region scroll-y)))
  (= consumed (call (. region scroll-by) (call Point 0 -100) (. ScrollCause wheel)))
  (= consumed (call (. region scroll-by) (call Point 0 100) (. ScrollCause wheel)))
  (= t (call (. t check) "scrolling back to the end follows it again" (. region follows-end)))
  (return t)
)

(fn-do _ virtual-end-anchor-resize-tests _
  (param t TestCase)
  (<> VirtualWrappedWindow (id: window))
  (blank)
  (call (. window open))
  (call (. window layout))
  (let region (. window region))
  (blank)
  (= (. window size) (tuple 200 400))
  (call (. window layout))
  (let content (. region content-bounds))
  (let last (!! (call measured-root region 99)))
  (= t (call (. t expect) "a narrower region measures its rows again" 32.0 (. last bounds height)))
  (= t (call (. t check) "rows restack without gaps or overlap" (call bound-rows-tile region 99)))
  (= t (call (. t expect) "a width change keeps the end in view" (. region scroll-max y) (. region scroll-y)))
  (= t
    (call (. t expect)
      (block
        (arg "the last row still sits at the viewport bottom")
        (arg (. content bottom))
        (arg (. (call (. last presentation-rect) (. last bounds)) bottom))
      )
    )
  )
  (return t)
)

(fn-do _ measured-root (? (of VirtualSlotRoot I64))
  (param region (of VirtualRegion I64))
  (param address I64)
  (for (in index (..< 0 (. region pool-size)))
    (let root (call (. region root-at) index))
    (return-if root (if (and root (. root slot is-bound) (== (. root slot address) address))))
  )
  (return null)
)

(fn-do _ measured-row (? VirtualMeasuredRow)
  (param region (of VirtualRegion I64))
  (param address I64)
  (let root (call measured-root region address))
  (return-if (if (not root)))
  (return (as (. root %first-child) VirtualMeasuredRow))
)

(fn-do _ settle-measured _
  (param window VirtualMeasuredWindow)
  (let root (. window markup-batch-root))
  (if root
    (call (. root markup-batch-queue checkpoint))
  )
  (call (. window layout))
)

(fn-do _ open-measured-window _
  (<> VirtualMeasuredWindow (id: window))
  (blank)
  (call (. window open))
  (call (. window layout))
  (return window)
)

(fn-expr _ measured-row-height Length
  (param address I64)
  (+ 20.0 (* (% address 3) 20))
)

(type + VirtualMeasuredRow (is Box)
  (prop + address I64)
  (prop + grown Length)
  (blank)
  (rule This
    (= min-height (call (. SizeSpec coord) (+ (call measured-row-height #address) #grown)))
    (= max-height (call (. SizeSpec coord) (+ (call measured-row-height #address) #grown)))
  )
)

(type + VirtualMeasuredWindow (is Window)
  (prop + source _ (:= (call VirtualRangeSource 100vcoord)))
  (prop + row-layout _ (:= (call VerticalMeasuredLayout 30vcoord)))
  (prop + anchors-end _ (= false))
  (content
    (<> This (• flex-col)
      (= size (tuple 320 400))
      (blank)
      (<> (of VirtualRegion I64) (id: region) (• h 200)
        (= source #source)
        (= virtual-layout row-layout)
        (= overscan (call VirtualInsets 40vcoord 0vcoord 40vcoord 0vcoord))
        (= anchors-end #anchors-end)
        (blank)
        (<> VirtualMeasuredRow (slot: row) (param: slot)
          (= address (. slot #address))
        )
      )
    )
  )
  (fn-do + ensure-native _)
  (fn-do + render Bool
    (return false)
  )
)

(fn-do _ bound-rows-tile Bool
  (param region (of VirtualRegion I64))
  (param last I64)
  (let pairs Size)
  (let address last)
  (while (> address 0)
    (let below (call measured-root region address))
    (let above (call measured-root region (- address 1)))
    (if (and below above)
      (return-if false (if (!= (. below bounds y) (. above bounds bottom))))
      (+= pairs 1)
    )
    (-= address 1)
  )
  (return (> pairs 0))
)

(fn-expr _ wrapped-row-height Length
  (param address I64)
  (param width Length)
  (/ (* (+ 1 (% address 3)) 6400) width)
)

(type + VirtualWrappedRow (is Box)
  (prop + address I64)
  (fn-expr + measured-content-size _
    (param query MeasureQuery)
    (call Dimensions width (call wrapped-row-height address width))
    (where
      (lazy width (?? (. query inline available) 320))
    )
  )
)

(type + VirtualWrappedWindow (is Window)
  (prop + source _ (:= (call VirtualRangeSource 100vcoord)))
  (prop + row-layout _ (:= (call VerticalMeasuredLayout 30vcoord)))
  (content
    (<> This (• flex-col)
      (= size (tuple 320 400))
      (blank)
      (<> (of VirtualRegion I64) (id: region) (• h 200)
        (= source #source)
        (= virtual-layout row-layout)
        (= overscan (call VirtualInsets 40vcoord 0vcoord 40vcoord 0vcoord))
        (= anchors-end true)
        (blank)
        (<> VirtualWrappedRow (slot: row) (param: slot)
          (= address (. slot #address))
        )
      )
    )
  )
  (fn-do + ensure-native _)
  (fn-do + render Bool
    (return false)
  )
)

(fn-do _ open-virtual-window _
  (<> VirtualTestWindow (id: window))
  (blank)
  (call (. window open))
  (call (. window layout))
  (return window)
)

(fn-do _ open-two-axis-window _
  (<> VirtualTwoAxisWindow (id: window))
  (blank)
  (call (. window open))
  (call (. window layout))
  (return window)
)

(type + VirtualTestRow (is Box)
  (prop + address I64)
  (prop + blur-count Size)
  (prop + click-count Size)
  (blank)
  (rule This
    (= focus-mode (. FocusMode keys))
    (= background-color (if-expr (== (% #address 2) 0) red blue))
  )
  (subscribe-for (on event blur)
    (+= blur-count 1)
  )
  (subscribe-for (on event click)
    (+= click-count 1)
  )
)

(type + VirtualTestWindow (is Window)
  (prop + source _ (:= (call VirtualRangeSource 1000000000vcoord)))
  (content
    (<> This (• flex-col)
      (= size (tuple 320 400))
      (blank)
      (<> Box (• flex-col)
        (<> (of VirtualRegion I64) (id: region) (• h 200)
          (= source #source)
          (= virtual-layout (call VerticalFixedLayout 20vcoord))
          (= overscan (call VirtualInsets 60vcoord 0vcoord 60vcoord 0vcoord))
          (blank)
          (<> VirtualTestRow (slot: row) (param: slot)
            (= address (. slot #address))
          )
        )
      )
      (blank)
      (<> Box (• flex-col)
        (<> Box (id: control-child) (• h 10))
      )
    )
  )
  (fn-do + ensure-native _)
  (fn-do + render Bool
    (return false)
  )
)

(type + VirtualTwoAxisWindow (is Window)
  (prop + source _ (:= (call VirtualRangeSource 1000vcoord)))
  (content
    (<> This (• flex-col)
      (= size (tuple 320 400))
      (blank)
      (<> (of VirtualRegion I64) (id: wide) (• h 200)
        (= source #source)
        (= virtual-layout (call VerticalFixedLayout 20vcoord 2000vcoord))
        (blank)
        (<> VirtualTestRow (slot: row) (param: slot)
          (= address (. slot #address))
        )
      )
    )
  )
  (fn-do + ensure-native _)
  (fn-do + render Bool
    (return false)
  )
)

(fn-do _ virtual-natural-limit-tests _
  (param t TestCase)
  (<> VirtualNaturalWindow (id: window)
    (= source (call VirtualRangeSource 10vcoord))
  )
  (blank)
  (call (. window open))
  (call (. window layout))
  (let limited (. window limited))
  (= t (call (. t expect) "a region under its maximum height fits its extent" 200.0 (. limited bounds height)))
  (= (. window source) (call VirtualRangeSource 50vcoord))
  (call checkpoint-natural window)
  (call (. window layout))
  (= t (call (. t expect) "a region over its maximum height stops there" 300.0 (. limited bounds height)))
  (= t (call (. t expect) "a limited region scrolls the rest itself" 700.0 (. limited scroll-max y)))
  (= (. window source) (call VirtualRangeSource 40vcoord))
  (call checkpoint-natural window)
  (call (. window layout))
  (= t (call (. t expect) "a change beyond the limit keeps the height" 300.0 (. limited bounds height)))
  (= t (call (. t expect) "a change beyond the limit updates the scroll range" 500.0 (. limited scroll-max y)))
  (= (. window source) (call VirtualRangeSource 5vcoord))
  (call checkpoint-natural window)
  (call (. window layout))
  (= t (call (. t expect) "a source that fits again shrinks the region" 100.0 (. limited bounds height)))
  (return t)
)

(fn-do _ virtual-ancestor-clip-tests _
  (param t TestCase)
  (<> VirtualClipWindow (id: window))
  (blank)
  (call (. window open))
  (call (. window layout))
  (let region (. window region))
  (let scroller (. window scroller))
  (= t (call (. t check) "the first row is bound" (!= (call root-for-address region 0) null)))
  (= t (call (. t check) "the last row in view is bound" (!= (call root-for-address region 14) null)))
  (= t (call (. t check) "rows below the view are not bound" (== (call root-for-address region 19) null)))
  (blank)
  (call (. scroller scroll-to) (call Point 0 1000))
  (call (. window layout))
  (let top (call root-for-address region 45))
  (= t (call (. t check) "rows under the scrolled view are bound" (!= top null)))
  (= t (call (. t check) "rows scrolled out of view are released" (== (call root-for-address region 0) null)))
  (if top
    (= t
      (call (. t expect)
        (block
          (arg "a bound row presents where it scrolled to")
          (arg 0.0)
          (arg (. (call (. top presentation-rect) (. top bounds)) y))
        )
      )
    )
  )
  (let hit (call (. window hit-test) (call Point 10 5)))
  (= t (call (. t expect) "hit testing reaches the scrolled rows" 45 (call row-address hit)))
  (blank)
  (= t
    (call (. t check)
      (block
        (arg "an address beyond the view reveals")
        (arg (call (. region scroll-to-address) 500 (. ScrollAlignment nearest)))
      )
    )
  )
  (call (. window layout))
  (= t (call (. t expect) "revealing an address scrolls the enclosing box" 9720.0 (. scroller scroll-y)))
  (= t (call (. t expect) "revealing an address leaves the region unscrolled" 0.0 (. region scroll-y)))
  (blank)
  (call (. scroller scroll-to) (call Point 0 20200))
  (call (. window layout))
  (= t
    (call (. t check)
      (block
        (arg "a region scrolled out of view keeps its nearest rows")
        (arg (!= (call root-for-address region 999) null))
      )
    )
  )
  (= t
    (call (. t check)
      (block
        (arg "a region scrolled out of view releases the rest")
        (arg (== (call root-for-address region 990) null))
      )
    )
  )
  (blank)
  (call (. scroller scroll-to) (call Point 0 0))
  (call (. window layout))
  (= (. window header-height) 0)
  (let root (. window markup-batch-root))
  (if root
    (call (. root markup-batch-queue checkpoint))
  )
  (call (. window layout))
  (= t (call (. t check) "rows a move reveals are bound" (!= (call root-for-address region 19) null)))
  (return t)
)

(fn-do _ virtual-nested-clip-tests _
  (param t TestCase)
  (<> VirtualNestedClipWindow (id: window))
  (blank)
  (call (. window open))
  (call (. window layout))
  (let region (. window region))
  (let scroller (. window scroller))
  (call (. region scroll-to) (call Point 0 2000))
  (call (. window layout))
  (= t (call (. t check) "its own scroll picks the first row" (!= (call root-for-address region 100) null)))
  (= t (call (. t check) "its own scroll stops at the enclosing view" (== (call root-for-address region 105) null)))
  (call (. scroller scroll-to) (call Point 0 100))
  (call (. window layout))
  (= t (call (. t check) "showing more of the region binds more rows" (!= (call root-for-address region 109) null)))
  (= t
    (call (. t check)
      (block
        (arg "showing more of the region stops at the enclosing view")
        (arg (== (call root-for-address region 110) null))
      )
    )
  )
  (call (. scroller scroll-to) (call Point 0 500))
  (call (. window layout))
  (= t (call (. t check) "hiding the top of the region releases its rows" (== (call root-for-address region 100) null)))
  (= t (call (. t check) "the part still shown stays bound" (!= (call root-for-address region 110) null)))
  (blank)
  (call (. scroller scroll-to) (call Point 0 0))
  (call (. window layout))
  (call (. region scroll-to-address) 300 (. ScrollAlignment nearest))
  (call (. window layout))
  (= t (call (. t expect) "the region scrolls the address into its own view" 5720.0 (. region scroll-y)))
  (= t (call (. t expect) "the enclosing box scrolls the rest of the way" 200.0 (. scroller scroll-y)))
  (return t)
)

(fn-do _ virtual-side-clip-tests _
  (param t TestCase)
  (<> VirtualSideClipWindow (id: window))
  (blank)
  (call (. window open))
  (call (. window layout))
  (let region (. window region))
  (let scroller (. window scroller))
  (= t (call (. t expect) "the region keeps its set width" 200.0 (. region bounds width)))
  (= t
    (call (. t expect)
      (block
        (arg "the enclosing box cuts the region off")
        (arg 120.0)
        (arg (- (. scroller content-bounds right) (. region bounds x)))
      )
    )
  )
  (= t (call (. t expect) "a row cut off at the right spans the region" 200.0 (call side-row-width region 0)))
  (blank)
  (call (. scroller scroll-to) (call Point 100 0))
  (call (. window layout))
  (= t (call (. t expect) "a row scrolled fully into view spans the region" 200.0 (call side-row-width region 0)))
  (blank)
  (call (. scroller scroll-to) (call Point 300 0))
  (call (. window layout))
  (= t (call (. t expect) "a row cut off at the left spans the region" 200.0 (call side-row-width region 0)))
  (let cut (call root-for-address region 0))
  (if cut
    (= t
      (call (. t expect)
        (block
          (arg "a row cut off at the left stays at the region's edge")
          (arg (. region content-bounds x))
          (arg (. cut bounds x))
        )
      )
    )
  )
  (blank)
  (call (. scroller scroll-to) (call Point 500 0))
  (call (. window layout))
  (call (. scroller scroll-to) (call Point 390 0))
  (call (. window layout))
  (= t (call (. t expect) "a row coming back into view spans the region" 200.0 (call side-row-width region 0)))
  (call (. scroller scroll-to) (call Point 0 0))
  (call (. window layout))
  (= t (call (. t expect) "a row scrolled back spans the region" 200.0 (call side-row-width region 0)))
  (return t)
)

(fn-do _ virtual-measured-side-clip-tests _
  (param t TestCase)
  (<> VirtualMeasuredSideClipWindow (id: window))
  (blank)
  (call (. window open))
  (call (. window layout))
  (call (. window layout))
  (let region (. window region))
  (let root (call measured-root region 0))
  (= t (call (. t check) "a measured region cut off at the side binds rows" (!= root null)))
  (if root
    (= t (call (. t expect) "a measured row cut off at the side spans the region" 200.0 (. root bounds width)))
  )
  (return t)
)

(fn-expr _ side-row-width Length
  (param region (of VirtualRegion I64))
  (param address I64)
  (if-expr root (. root bounds width) -1)
  (where
    (lazy root (call root-for-address region address))
  )
)

(fn-do _ checkpoint-natural _
  (param window VirtualNaturalWindow)
  (let root (. window markup-batch-root))
  (if root
    (call (. root markup-batch-queue checkpoint))
  )
)

(type + VirtualClipWindow (is Window)
  (prop + source _ (:= (call VirtualRangeSource 1000vcoord)))
  (prop + header-height Length (= 100))
  (content
    (<> This (• flex-col)
      (= size (tuple 320 400))
      (blank)
      (<> Box (id: scroller) (• flex-col) (• flex 1)
        (= overflow-y (. ScrollOverflow auto))
        (blank)
        (<> Box (id: header)
          (= min-height (call (. SizeSpec coord) #header-height))
          (= max-height (call (. SizeSpec coord) #header-height))
        )
        (<> (of VirtualRegion I64) (id: region)
          (= source #source)
          (= virtual-layout (call VerticalFixedLayout 20vcoord))
          (= overscan (call VirtualInsets 40vcoord 0vcoord 40vcoord 0vcoord))
          (blank)
          (<> VirtualTestRow (slot: row) (param: slot)
            (= address (. slot #address))
          )
        )
        (<> Box (id: footer) (• h 500))
      )
    )
  )
  (fn-do + ensure-native _)
  (fn-do + render Bool
    (return false)
  )
)

(type + VirtualNestedClipWindow (is Window)
  (prop + source _ (:= (call VirtualRangeSource 1000vcoord)))
  (content
    (<> This (• flex-col)
      (= size (tuple 320 400))
      (blank)
      (<> Box (id: scroller) (• flex-col) (• flex 1)
        (= overflow-y (. ScrollOverflow auto))
        (blank)
        (<> Box (• h 300))
        (<> (of VirtualRegion I64) (id: region) (• h 300)
          (= source #source)
          (= virtual-layout (call VerticalFixedLayout 20vcoord))
          (blank)
          (<> VirtualTestRow (slot: row) (param: slot)
            (= address (. slot #address))
          )
        )
        (<> Box (• h 300))
      )
    )
  )
  (fn-do + ensure-native _)
  (fn-do + render Bool
    (return false)
  )
)

(type + VirtualSideClipWindow (is Window)
  (prop + source _ (:= (call VirtualRangeSource 1000vcoord)))
  (content
    (<> This (• flex-col)
      (= size (tuple 320 400))
      (blank)
      (<> Box (id: scroller) (• flex-row) (• flex 1)
        (= overflow-x (. ScrollOverflow auto))
        (blank)
        (<> Box
          (= min-width (call (. SizeSpec coord) 200))
        )
        (<> (of VirtualRegion I64) (id: region)
          (= min-width (call (. SizeSpec coord) 200))
          (= max-width (call (. SizeSpec coord) 200))
          (= source #source)
          (= virtual-layout (call VerticalFixedLayout 20vcoord))
          (blank)
          (<> VirtualTestRow (slot: row) (param: slot)
            (= address (. slot #address))
          )
        )
        (<> Box
          (= min-width (call (. SizeSpec coord) 600))
        )
      )
    )
  )
  (fn-do + ensure-native _)
  (fn-do + render Bool
    (return false)
  )
)

(type + VirtualMeasuredSideClipWindow (is Window)
  (prop + source _ (:= (call VirtualRangeSource 100vcoord)))
  (prop + row-layout _ (:= (call VerticalMeasuredLayout 30vcoord)))
  (content
    (<> This (• flex-col)
      (= size (tuple 320 400))
      (blank)
      (<> Box (id: scroller) (• flex-row) (• flex 1)
        (= overflow-x (. ScrollOverflow auto))
        (blank)
        (<> Box
          (= min-width (call (. SizeSpec coord) 200))
        )
        (<> (of VirtualRegion I64) (id: region)
          (= min-width (call (. SizeSpec coord) 200))
          (= max-width (call (. SizeSpec coord) 200))
          (= source #source)
          (= virtual-layout row-layout)
          (blank)
          (<> VirtualMeasuredRow (slot: row) (param: slot)
            (= address (. slot #address))
          )
        )
        (<> Box
          (= min-width (call (. SizeSpec coord) 600))
        )
      )
    )
  )
  (fn-do + ensure-native _)
  (fn-do + render Bool
    (return false)
  )
)

(type + VirtualNaturalWindow (is Window)
  (prop + source VirtualRangeSource (= (call VirtualRangeSource 50vcoord)))
  (content
    (<> This (• flex-row)
      (= size (tuple 640 400))
      (blank)
      (<> Box (• flex-col) (• flex 1)
        (<> (of VirtualRegion I64) (id: limited)
          (= source #source)
          (= virtual-layout (call VerticalFixedLayout 20vcoord))
          (= max-height (call (. SizeSpec coord) 300))
          (blank)
          (<> VirtualTestRow (slot: row) (param: slot)
            (= address (. slot #address))
          )
        )
      )
    )
  )
  (fn-do + ensure-native _)
  (fn-do + render Bool
    (return false)
  )
)
