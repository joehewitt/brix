(import /core/markup)
(import /graphics/primitives)
(import /gui/box)
(import /gui/layout)
(import /gui/primitives)
(import /test)
(blank)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "GUI Flex Gap Measurement And Orientation"))
  (call (. cases run) gap-measurement-tests)
  (= cases (call (. cases then) "GUI Flex Gap Allocation And Margins" gap-allocation-tests))
  (= cases (call (. cases then) "GUI Flex Cross-Axis Alignment" cross-alignment-tests))
  (return cases)
)

(fn-do + gap-measurement-tests _
  (param t TestCase)
  (let solo (call GapFlexRoot (. Orientation horizontal) 9))
  (call markup-mount-root solo solo)
  (call (. solo markup-batch-queue checkpoint))
  (call (. t expect) "empty flex has no gap" (call Dimensions 0 0) (. (call (. solo measure)) content-size))
  (let only (call GapChild (call Dimensions 11 6)))
  (call markup-append solo only)
  (call (. solo markup-batch-queue checkpoint))
  (call (. t expect) "single child natural size has no gap" (call Dimensions 11 6) (. (call (. solo measure)) content-size))
  (call (. solo layout) (call Rect 3 4 20 10))
  (call (. t expect) "single child arrangement has no leading gap" 3 (. only bounds left))
  (blank)
  (let root (call GapFlexRoot (. Orientation horizontal) 4))
  (let first (call GapChild (call Dimensions 10 3)))
  (let second (call GapChild (call Dimensions 20 5)))
  (let third (call GapChild (call Dimensions 30 4)))
  (call markup-append root first)
  (call markup-append root second)
  (call markup-append root third)
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (blank)
  (call (. t expect)
    (block
      (arg "horizontal natural width includes two gaps")
      (arg (call Dimensions 68 5))
      (arg (. (call (. root measure)) content-size))
    )
  )
  (call (. root layout) (call Rect 2 3 68 12))
  (call (. t expect) "horizontal flex has no leading gap" 2 (. first bounds left))
  (call (. t expect) "horizontal flex inserts the first gap" 16 (. second bounds left))
  (call (. t expect) "horizontal flex inserts the second gap" 40 (. third bounds left))
  (call (. t expect) "horizontal flex has no trailing gap" 70 (. third bounds right))
  (call (. t expect) "horizontal gap contributes to scroll extent" 68 (. root inner-width))
  (blank)
  (call (. root close))
  (call markup-release root)
  (call (. solo close))
  (call markup-release solo)
  (return t)
)

(fn-do + gap-allocation-tests _
  (param t TestCase)
  (let root (call GapFlexRoot (. Orientation horizontal) 10))
  (let fixed (call GapChild (call Dimensions 20 4)))
  (let flexible (call GapFlexibleChild))
  (let margined (call GapMarginedFlexibleChild))
  (call markup-append root fixed)
  (call markup-append root flexible)
  (call markup-append root margined)
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (call (. root layout) (call Rect 0 0 101 10))
  (blank)
  (call (. t expect) "gap is reserved before flexible allocation" 27.5 (. flexible width))
  (call (. t expect)
    (block
      (arg "gap and adjacent leading margin are additive")
      (arg 16)
      (arg (- (. margined bounds left) (. flexible bounds right)))
    )
  )
  (blank)
  (call (. root close))
  (call markup-release root)
  (return t)
)

(type + GapFlexRoot (is Box)
  (implements MarkupRootElement)
  (prop + orient _ (= (. Orientation horizontal)))
  (prop + authored-gap Length)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (rule This
    (= layout (call FlexLayout #orient))
    (= gap #authored-gap)
  )
  (fn-do + This _
    (param orient _)
    (param authored-gap _)
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(type + GapChild (is Box)
  (prop + desired _ (= (call Dimensions 5 4)))
  (fn-do + This _
    (param desired _ (= (call Dimensions 5 4)))
  )
  (fn-expr + measured-content-size _
    (param query MeasureQuery)
    desired
  )
)

(type + GapFlexibleChild (is GapChild)
  (rule This
    (= flex 1)
  )
)

(type + GapMarginedFlexibleChild (is GapFlexibleChild)
  (rule This
    (= margin-left 6)
  )
)

(fn-do + cross-alignment-tests _
  (param t TestCase)
  (let row (call GapFlexRoot (. Orientation horizontal) 0))
  (let stretched (call GapChild (call Dimensions 10 6)))
  (let top (call GapChild (call Dimensions 10 6)))
  (let middle (call GapChild (call Dimensions 10 6)))
  (let bottom (call GapChild (call Dimensions 10 30)))
  (call markup-append row stretched)
  (call markup-append row top)
  (call markup-append row middle)
  (call markup-append row bottom)
  (call markup-mount-root row row)
  (= (. top align-y) (. Alignment start))
  (= (. middle align-y) (. Alignment center))
  (= (. bottom align-y) (. Alignment end))
  (call (. row markup-batch-queue checkpoint))
  (call (. row layout) (call Rect 0 10 40 20))
  (call (. t expect) "unaligned children stretch across the row" (call Rect 0 10 10 20) (. stretched bounds))
  (call (. t expect) "start keeps natural height at the top" (call Rect 10 10 10 6) (. top bounds))
  (call (. t expect) "center centers natural height" (call Rect 20 17 10 6) (. middle bounds))
  (call (. t expect) "end clamps to the row and aligns to the bottom" (call Rect 30 10 10 20) (. bottom bounds))
  (blank)
  (let column (call GapFlexRoot (. Orientation vertical) 0))
  (let centered (call GapChild (call Dimensions 8 5)))
  (call markup-append column centered)
  (call markup-mount-root column column)
  (= (. centered align-x) (. Alignment center))
  (call (. column markup-batch-queue checkpoint))
  (call (. column layout) (call Rect 0 0 30 20))
  (call (. t expect) "a column centers on the horizontal axis" (call Rect 11 0 8 5) (. centered bounds))
  (return t)
)
