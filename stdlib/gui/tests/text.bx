(import /core/markup)
(import /graphics/primitives)
(import /graphics/text)
(import /gui/box)
(import /gui/label)
(import /gui/layout)
(import /gui/primitives)
(import /gui/shorthands)
(import /gui/styles)
(import /gui/text)
(import /math)
(import /test)
(blank)
(prop _ tight-sample _ (= "Shrink wrapped paragraphs keep their line count while hugging the longest line."))
(prop _ wrapping-sample _ (= "The quick brown fox jumps over the lazy dog again and again until it wraps."))
(blank)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "Text Span Placement"))
  (call (. cases run) placement-tests)
  (= cases (call (. cases then) "Flex Wrapped Text Measurement" flex-wrap-tests))
  (= cases (call (. cases then) "Tight Wrap Sizing" tight-sizing-tests))
  (= cases (call (. cases then) "Padded Text Measurement" padded-text-tests))
  (return cases)
)

(fn-do + placement-tests _
  (param t TestCase)
  (let root (call TextTestRoot))
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (call (. root layout) (call Rect 0 0 400 300))
  (blank)
  (let shadowed (!! (call (of find-text-node TextTestShadowSpan) root)))
  (let shadowed-width (. shadowed bounds width))
  (= (. shadowed text) "shadowed words grow longer")
  (call (. root markup-batch-queue checkpoint))
  (call (. root layout) (call Rect 0 0 400 300))
  (call (. t check) "spans inside markup shadows relayout their text" (> (. shadowed bounds width) shadowed-width))
  (let grown-width (. shadowed bounds width))
  (= (. shadowed text) "x")
  (call (. root markup-batch-queue checkpoint))
  (call (. root layout) (call Rect 0 0 400 300))
  (call (. t check) "spans relayout on every text change" (< (. shadowed bounds width) grown-width))
  (= (. root show-inline) true)
  (call (. root markup-batch-queue checkpoint))
  (call (. root layout) (call Rect 0 0 400 300))
  (let inline-child (call (of find-text-node TextTestInlineChild) root))
  (call (. t check)
    (block
      (arg "late inline boxes in shadowed spans lay out their children")
      (arg (and (!= inline-child null) (== (. inline-child bounds width) 8)))
    )
  )
  (call markup-release root)
  (return t)
)

(fn-do + flex-wrap-tests _
  (param t TestCase)
  (let root (call FlexWrapTestRoot))
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (call (. root layout) (call Rect 0 0 600 400))
  (call (. t expect) "wrapped label measures at its share" 2 (. (!! (. root label text-layout-snapshot)) line-count))
  (call (. t expect) "card height follows the wrapped label" (. root label height) (. root card height))
  (call (. t expect)
    (block
      (arg "text measures at max width")
      (arg (. (!! (. root paragraph text-layout-snapshot)) size height))
      (arg (. root paragraph height))
    )
  )
  (call (. t expect) "absolute cover measures at its span" 2 (. (!! (. root covered text-layout-snapshot)) line-count))
  (call (. t expect) "absolute cover height follows wrapped text" (. root covered height) (. root cover height))
  (call markup-release root)
  (return t)
)

(fn-do + tight-sizing-tests _
  (param t TestCase)
  (let root (call TightTestRoot))
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (call (. root layout) (call Rect 0 0 600 400))
  (let tight-lines (. (!! (. root tight-text text-layout-snapshot)) line-count))
  (call (. t check) "tight text wraps under its cap" (> tight-lines 1))
  (call (. t expect)
    (block
      (arg "tight text keeps the capped line count")
      (arg (. (!! (. root wide-text text-layout-snapshot)) line-count))
      (arg tight-lines)
    )
  )
  (blank)
  (= (. root cap) 520)
  (call (. root markup-batch-queue checkpoint))
  (call (. root layout) (call Rect 0 0 600 400))
  (call (. t check)
    (block
      (arg "a wider cap rewraps tight text")
      (arg (< (. (!! (. root tight-text text-layout-snapshot)) line-count) tight-lines))
    )
  )
  (call markup-release root)
  (return t)
)

(fn-do + padded-text-tests _
  (param t TestCase)
  (let root (call PaddedTextTestRoot))
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (let natural (call ceil (. (call (. root plain measure)) outer-size width)))
  (call (. root layout) (call Rect 0 0 (+ natural 20) 400))
  (call (. t expect) "plain text fits the box on one line" 1 (. (!! (. root plain text-layout-snapshot)) line-count))
  (call (. t expect) "padding narrows the wrap width" 2 (. (!! (. root padded text-layout-snapshot)) line-count))
  (call (. t expect)
    (block
      (arg "padded text measures the lines it arranges")
      (arg (. (!! (. root padded text-layout-snapshot)) size height))
      (arg (. root padded height))
    )
  )
  (call (. t expect)
    (block
      (arg "a padded label wraps at its content width")
      (arg 2)
      (arg (. (!! (. root padded-label text-layout-snapshot)) line-count))
    )
  )
  (call markup-release root)
  (return t)
)

(style TextTestTheme
  (using GUIBoxPaint)
  (using GUIFontStyle)
  (using GUITextDecoration)
  (using GUIBoxSize)
)

(type + TextTestRoot (is Box)
  (implements MarkupRootElement)
  (using TextTestTheme)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue (as this MarkupRootElement))))
  (prop + shadow-words (list String) (= (list "short")))
  (prop + show-inline _ (= false))
  (content
    (<> This (• flex-col)
      (<> Text
        (= max-width (call (. SizeSpec coord) 360))
        "Read the "
        (<> Span (text: "linked words here"))
        " "
        (<> Box (• w 20) (• h 10))
        " and "
        (<> Span
          "outer "
          (<> Span (text: "inner")
            (= font-weight (. FontWeight bold))
          )
        )
        (for (in word #shadow-words (keyed-by word))
          (<> TextTestShadow
            (<> TextTestShadowSpan
              (= text word)
              (if #show-inline
                (<> Box (• w 20) (• h 10) (• flex-row)
                  (<> TextTestInlineChild (• w 8) (• h 6))
                )
              )
            )
          )
        )
      )
    )
  )
)

(type + TextTestInlineChild (is Box))

(type + TextTestShadowSpan (is Span))

(fn-do + (of find-text-node T) (? T)
  (param node GuiNode)
  (if (is node T)
    (return (as node T))
  )
  (for (in child (. node children))
    (let found (call (of find-text-node T) child))
    (return-if found (if found))
  )
  (return null)
)

(type + TextTestShadow (is Box)
  (prop + is-markup-shadow _ (=> true))
)

(type + TightTestRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue (as this MarkupRootElement))))
  (prop + cap Length (= 300))
  (prop + tight-text Text)
  (prop + wide-text Text)
  (content
    (<> This (• flex-col)
      (<> Box (• flex-row)
        (<> Text (id: tight-text)
          (= max-width (call (. SizeSpec coord) #cap))
          (= text-wrap-sizing (. TextWrapSizing tight))
          (<> Span (value: tight-sample))
        )
      )
      (<> Box (• flex-row)
        (<> Text (id: wide-text) (• w 300)
          (<> Span (value: tight-sample))
        )
      )
    )
  )
)

(type + PaddedTextTestRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue (as this MarkupRootElement))))
  (prop + plain Text)
  (prop + padded Text)
  (prop + padded-label Label)
  (content
    (<> This (• flex-col)
      (<> Text (id: plain)
        (<> Span (value: wrapping-sample))
      )
      (<> Text (id: padded) (• px 40)
        (<> Span (value: wrapping-sample))
      )
      (<> Label (id: padded-label) (• px 40)
        (= text-wrap (. TextWrap word))
        (= text wrapping-sample)
      )
    )
  )
)

(type + FlexWrapTestRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue (as this MarkupRootElement))))
  (prop + card Box)
  (prop + label Label)
  (prop + paragraph Text)
  (prop + cover Box)
  (prop + covered Label)
  (content
    (<> This (• flex-col)
      (<> Box (• flex-row)
        (<> Box (• flex-col) (• flex 1)
          (<> Box (id: card) (• flex-col)
            (<> Label (id: label)
              (= text-wrap (. TextWrap word))
              (= text wrapping-sample)
            )
          )
        )
        (<> Box (• flex-col) (• flex 1))
      )
      (<> Box (• h 60)
        (<> Box (id: cover) (• flex-col) (• absolute)
          (= left (call (. PositionOffset coord) 0))
          (= right (call (. PositionOffset coord) 300))
          (<> Label (id: covered)
            (= text-wrap (. TextWrap word))
            (= text wrapping-sample)
          )
        )
      )
      (<> Box (• flex-col) (• p 10) (• w 300)
        (<> Text (id: paragraph)
          "The quick brown fox jumps over the lazy dog again and again and again until it wraps."
        )
      )
    )
  )
)
