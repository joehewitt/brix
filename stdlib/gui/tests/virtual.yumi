━━━━━━━━━━━━━━━━━━━━
_ do virtual-natural-limit-tests
    - t TestCase

<VirtualNaturalWindow window
    source = VirtualRangeSource(10vcoord)

window.open()
window.layout()
. limited = window.limited
t = t.expect("a region under its maximum height fits its extent", 200.0, limited.bounds.height)
window.source = VirtualRangeSource(50vcoord)
checkpoint-natural(window)
window.layout()
t = t.expect("a region over its maximum height stops there", 300.0, limited.bounds.height)
t = t.expect("a limited region scrolls the rest itself", 700.0, limited.scroll-max.y)
window.source = VirtualRangeSource(40vcoord)
checkpoint-natural(window)
window.layout()
t = t.expect("a change beyond the limit keeps the height", 300.0, limited.bounds.height)
t = t.expect("a change beyond the limit updates the scroll range", 500.0, limited.scroll-max.y)
window.source = VirtualRangeSource(5vcoord)
checkpoint-natural(window)
window.layout()
t = t.expect("a source that fits again shrinks the region", 100.0, limited.bounds.height)
= t

━━━━━━━━━━━━━━━━━━━━
_ do virtual-ancestor-clip-tests
    - t TestCase

<VirtualClipWindow window

window.open()
window.layout()
. region = window.region
. scroller = window.scroller
t = t.check("the first row is bound", root-for-address(region, 0) != null)
t = t.check("the last row in view is bound", root-for-address(region, 14) != null)
t = t.check("rows below the view are not bound", root-for-address(region, 19) == null)

scroller.scroll-to(Point(0, 1000))
window.layout()
. top = root-for-address(region, 45)
t = t.check("rows under the scrolled view are bound", top != null)
t = t.check("rows scrolled out of view are released", root-for-address(region, 0) == null)
if top
    t = t.expect
        - "a bound row presents where it scrolled to"
        - 0.0
        - top.presentation-rect(top.bounds).y
. hit = window.hit-test(Point(10, 5))
t = t.expect("hit testing reaches the scrolled rows", 45, row-address(hit))

t = t.check
    - "an address beyond the view reveals"
    - region.scroll-to-address(500, ScrollAlignment.nearest)
window.layout()
t = t.expect("revealing an address scrolls the enclosing box", 9720.0, scroller.scroll-y)
t = t.expect("revealing an address leaves the region unscrolled", 0.0, region.scroll-y)

scroller.scroll-to(Point(0, 20200))
window.layout()
t = t.check
    - "a region scrolled out of view keeps its nearest rows"
    - root-for-address(region, 999) != null
t = t.check
    - "a region scrolled out of view releases the rest"
    - root-for-address(region, 990) == null

scroller.scroll-to(Point(0, 0))
window.layout()
window.header-height = 0
. root = window.markup-batch-root
if root
    root.markup-batch-queue.checkpoint()
window.layout()
t = t.check("rows a move reveals are bound", root-for-address(region, 19) != null)
= t

━━━━━━━━━━━━━━━━━━━━
_ do virtual-nested-clip-tests
    - t TestCase

<VirtualNestedClipWindow window

window.open()
window.layout()
. region = window.region
. scroller = window.scroller
region.scroll-to(Point(0, 2000))
window.layout()
t = t.check("its own scroll picks the first row", root-for-address(region, 100) != null)
t = t.check("its own scroll stops at the enclosing view", root-for-address(region, 105) == null)
scroller.scroll-to(Point(0, 100))
window.layout()
t = t.check("showing more of the region binds more rows", root-for-address(region, 109) != null)
t = t.check
    - "showing more of the region stops at the enclosing view"
    - root-for-address(region, 110) == null
scroller.scroll-to(Point(0, 500))
window.layout()
t = t.check("hiding the top of the region releases its rows", root-for-address(region, 100) == null)
t = t.check("the part still shown stays bound", root-for-address(region, 110) != null)

scroller.scroll-to(Point(0, 0))
window.layout()
region.scroll-to-address(300, ScrollAlignment.nearest)
window.layout()
t = t.expect("the region scrolls the address into its own view", 5720.0, region.scroll-y)
t = t.expect("the enclosing box scrolls the rest of the way", 200.0, scroller.scroll-y)
= t

━━━━━━━━━━━━━━━━━━━━
_ do virtual-side-clip-tests
    - t TestCase

<VirtualSideClipWindow window

window.open()
window.layout()
. region = window.region
. scroller = window.scroller
t = t.expect("the region keeps its set width", 200.0, region.bounds.width)
t = t.expect
    - "the enclosing box cuts the region off"
    - 120.0
    - scroller.content-bounds.right - region.bounds.x
t = t.expect("a row cut off at the right spans the region", 200.0, side-row-width(region, 0))

scroller.scroll-to(Point(100, 0))
window.layout()
t = t.expect("a row scrolled fully into view spans the region", 200.0, side-row-width(region, 0))

scroller.scroll-to(Point(300, 0))
window.layout()
t = t.expect("a row cut off at the left spans the region", 200.0, side-row-width(region, 0))
. cut = root-for-address(region, 0)
if cut
    t = t.expect
        - "a row cut off at the left stays at the region's edge"
        - region.content-bounds.x
        - cut.bounds.x

scroller.scroll-to(Point(500, 0))
window.layout()
scroller.scroll-to(Point(390, 0))
window.layout()
t = t.expect("a row coming back into view spans the region", 200.0, side-row-width(region, 0))
scroller.scroll-to(Point(0, 0))
window.layout()
t = t.expect("a row scrolled back spans the region", 200.0, side-row-width(region, 0))
= t

━━━━━━━━━━━━━━━━━━━━
_ do virtual-measured-side-clip-tests
    - t TestCase

<VirtualMeasuredSideClipWindow window

window.open()
window.layout()
window.layout()
. region = window.region
. root = measured-root(region, 0)
t = t.check("a measured region cut off at the side binds rows", root != null)
if root
    t = t.expect("a measured row cut off at the side spans the region", 200.0, root.bounds.width)
= t

━━━━━━━━━━━━━━━━━━━━
_ side-row-width Length
    - region VirtualRegion'I64
    - address I64

if root then root.bounds.width else -1

.. root = root-for-address(region, address)

