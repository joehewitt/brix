+ do tests TestRender

. cases = TestCase("GUI Virtual Anchor")
cases.run(virtual-anchor-tests)
cases = cases.then("GUI Virtual Two Axis", virtual-two-axis-tests)
cases = cases.then("GUI Virtual Overscan Focus", virtual-overscan-focus-tests)
cases = cases.then("GUI Virtual Input Release", virtual-input-release-tests)
cases = cases.then("GUI Virtual Measured Rows", virtual-measured-row-tests)
cases = cases.then("GUI Virtual Measured Anchor", virtual-measured-anchor-tests)
cases = cases.then("GUI Virtual Measured Growth", virtual-measured-growth-tests)
cases = cases.then("GUI Virtual End Anchor", virtual-end-anchor-tests)
cases = cases.then("GUI Virtual End Anchor Resize", virtual-end-anchor-resize-tests)
cases = cases.then("GUI Virtual Growth Reveal", virtual-growth-reveal-tests)
cases = cases.then("GUI Virtual Scroll Restore", virtual-scroll-restore-tests)
cases = cases.then("GUI Virtual Natural Limit", virtual-natural-limit-tests)
cases = cases.then("GUI Virtual Ancestor Clip", virtual-ancestor-clip-tests)
cases = cases.then("GUI Virtual Nested Clip", virtual-nested-clip-tests)
cases = cases.then("GUI Virtual Side Clip", virtual-side-clip-tests)
cases = cases.then("GUI Virtual Measured Side Clip", virtual-measured-side-clip-tests)
= cases

━━━━━━━━━━━━━━━━━━━━
_ do virtual-growth-reveal-tests
    - t TestCase

. window = open-virtual-window()
. region = window.region
. content = region.content-bounds
window.source.count = 100vcoord
window.layout()
window.source.count = 200vcoord
t = t.check
    - "an address the source has just gained scrolls"
    - region.scroll-to-address(199, ScrollAlignment.end)
t = t.expect("the scroll is not held to the extent before the growth", 3800.0, region.scroll-y)
window.layout()
t = t.expect("the scroll survives the layout that follows", 3800.0, region.scroll-y)
. last = root-for-address(region, 199)!
t = t.expect
    - "the new last row sits at the bottom"
    - content.bottom
    - last.presentation-rect(last.bounds).bottom
= t

━━━━━━━━━━━━━━━━━━━━
_ do virtual-scroll-restore-tests
    - t TestCase

<VirtualSwapWindow window

window.open()
window.layout()
. region = window.region
. content = region.content-bounds
window.source = VirtualRangeSource(1000vcoord)
region.restore-scroll(Point(0, 4010))
t = t.expect("the scroll waits for the new source", 0.0, region.scroll-y)
settle-swap(window)
t = t.expect("the new source opens at the restored scroll", 4010.0, region.scroll-y)
. top = root-for-address(region, 200)!
t = t.expect
    - "rows are bound at the restored scroll"
    - content.y - 10
    - top.presentation-rect(top.bounds).y
window.source = VirtualRangeSource(100vcoord)
region.restore-scroll(Point(0, 4010))
settle-swap(window)
t = t.expect("a restored scroll past the end is held to the extent", 1800.0, region.scroll-y)
window.source = VirtualRangeSource(1000vcoord)
settle-swap(window)
t = t.expect("a swap without a restored scroll keeps the scroll", 1800.0, region.scroll-y)
= t

━━━━━━━━━━━━━━━━━━━━
_ do settle-swap
    - window VirtualSwapWindow

. root = window.markup-batch-root
if root
    root.markup-batch-queue.checkpoint()
window.layout()

