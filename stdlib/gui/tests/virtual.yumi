━━━━━━━━━━━━━━━━━━━━
_ do bound-rows-tile Bool
    - region VirtualRegion'I64
    - last I64

. pairs Size
. address = last
while address > 0
    . below = measured-root(region, address)
    . above = measured-root(region, address - 1)
    if below && above
        =? false if below.bounds.y != above.bounds.bottom
        pairs += 1
    address -= 1
= pairs > 0

━━━━━━━━━━━━━━━━━━━━
_ wrapped-row-height Length
    - address I64
    - width Length

(1 + address % 3) * 6400 / width

