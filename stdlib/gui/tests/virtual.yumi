━━━━━━━━━━━━━━━━━━━━
_ do virtual-anchor-tests
    - t TestCase

. window = open-virtual-window()
. region = window.region
. content = region.content-bounds
region.scroll-to-address(500000000)
window.layout()
t = t.expect("the far address aligns to the top", 10000000000.0, region.scroll-y)
. far = root-for-address(region, 500000000)!
t = t.expect("the far row sits at the content top", content.y, far.bounds.y)
. hit = window.hit-test(Point(10, content.y + 5))
t = t.expect("hit testing reaches far rows", 500000000, row-address(hit))

region.scroll-to(Point(0, 10000030000))
window.layout()
. drifted = root-for-address(region, 500001500)!
t = t.expect
    - "rows present at their logical position"
    - content.y
    - drifted.presentation-rect(drifted.bounds).y

region.scroll-to(Point(0, 10000070000.5))
window.layout()
. rebased = root-for-address(region, 500003500)!
t = t.expect
    - "rebased rows present with the fraction rounded to the pixel grid"
    - content.y - 1
    - rebased.presentation-rect(rebased.bounds).y

. below = row-for-address(region, 500003510)!
window.control-child.invalidate-layout()
region.ensure-visible(below)
window.layout()
t = t.expect("ensure-visible scrolls in logical coordinates", 10000070020.0, region.scroll-y)
= t

━━━━━━━━━━━━━━━━━━━━
_ do virtual-two-axis-tests
    - t TestCase

. window = open-two-axis-window()
. wide = window.wide
wide.scroll-to(Point(300, 40))
window.layout()
wide.scroll-to(Point(500, 40))
window.layout()
wide.scroll-to-address(50)
window.layout()
t = t.expect("wide addresses keep the horizontal scroll", Point(500, 1000), wide.scroll-position)
= t

━━━━━━━━━━━━━━━━━━━━
_ do virtual-overscan-focus-tests
    - t TestCase

. window = open-virtual-window()
. region = window.region
window.focus-adapter = GUIFocusAdapter()
region.scroll-to(Point(0, 20000))
window.layout()
window.move-focus()
t = t.expect("traversal starts at the first visible row", 1000, row-address(window.focused-box))

region.scroll-to(Point(0, 20040))
window.layout()
window.move-focus()
t = t.expect("traversal skips overscan rows", 1002, row-address(window.focused-box))

. focused = row-for-address(region, 1002)!
region.scroll-to(Point(0, 30000))
window.layout()
t = t.check("recycling a focused row releases focus", !window.focused-box)
t = t.expect("the recycled row receives one blur", 1, focused.blur-count)
window.move-focus()
t = t.expect("traversal resumes at the first visible row", 1500, row-address(window.focused-box))
= t

━━━━━━━━━━━━━━━━━━━━
_ do virtual-input-release-tests
    - t TestCase

. window = open-virtual-window()
. region = window.region
. content = region.content-bounds
. point = Point(10, content.y + 50)
window.dispatch-pointer-event(ScrollEvent(PointerEventData(point), 0, 1000))

. press-point = Point(10, content.y + 70)
window.dispatch-pointer-event
    - PointerDownEvent(PointerEventData(press-point), PointerButton.primary, 1, 7)
. pressed = row-for-address(region, 2003)!
region.scroll-to(Point(0, 80000))
window.layout()
t = t.check("recycling a pressed row releases the press", !pressed.is-pressed)
window.dispatch-pointer-event(PointerUpEvent(PointerEventData(press-point)))
t = t.expect("a recycled press does not click", 0, pressed.click-count)
= t

━━━━━━━━━━━━━━━━━━━━
_ do root-for-address VirtualSlotRoot'I64?
    - region VirtualRegion'I64
    - address I64

for index in 0 .. < region.pool-size
    . root = region.root-at(index)
    =? root if root && root.slot.is-bound && root.slot.address == address
= null

━━━━━━━━━━━━━━━━━━━━
_ do row-for-address VirtualTestRow?
    - region VirtualRegion'I64
    - address I64

. root = root-for-address(region, address)
=? if !root
= root.%first-child as VirtualTestRow

━━━━━━━━━━━━━━━━━━━━
_ row-address
    - box Box?

match box
    | row VirtualTestRow
        row.address
    ??
        -1

━━━━━━━━━━━━━━━━━━━━
_ do virtual-measured-row-tests
    - t TestCase

. window = open-measured-window()
. region = window.region
. content = region.content-bounds
t = t.expect
    - "measured rows replace their estimates in the extent"
    - 3060vcoord
    - region.virtual-extent-y.known
. third = measured-root(region, 2)!
t = t.expect("rows stack by their measured heights", content.y + 60, third.bounds.y)
t = t.expect("rows take their measured height", 60.0, third.bounds.height)
t = t.check("rows past the measured window depart", !measured-root(region, 6))
= t

━━━━━━━━━━━━━━━━━━━━
_ do virtual-measured-anchor-tests
    - t TestCase

. window = open-measured-window()
. region = window.region
. content = region.content-bounds
t = t.check("the region scrolls into unvisited rows", region.scroll-to(Point(0, 1500)))
window.layout()
. landed = measured-root(region, 48)!
t = t.expect("measuring keeps the leading row at the viewport top", 1540.0, region.scroll-y)
t = t.expect
    - "the leading row presents at the content top"
    - content.y
    - landed.presentation-rect(landed.bounds).y
t = t.expect("measured rows correct the extent", 3160vcoord, region.virtual-extent-y.known)

t = t.check("the region scrolls above measured rows", region.scroll-to(Point(0, 1400)))
window.layout()
t = t.expect("rows measured above shift the scroll position", 1430.0, region.scroll-y)
t = t.expect
    - "rows already measured keep their place on screen"
    - content.y + 140
    - landed.presentation-rect(landed.bounds).y
t = t.expect("rows measured above grow the extent", 3190vcoord, region.virtual-extent-y.known)

t = t.check("a measured address scrolls", region.scroll-to-address(48))
window.layout()
t = t.expect("measured addresses scroll to their row", 1570.0, region.scroll-y)
= t

━━━━━━━━━━━━━━━━━━━━
_ do virtual-measured-growth-tests
    - t TestCase

. window = open-measured-window()
. region = window.region
. row = measured-row(region, 1)!
. below = measured-root(region, 2)!
. start = region.virtual-extent-y.known
row.grown = 25
settle-measured(window)
t = t.expect("a growing row takes its new height", 65.0, measured-root(region, 1)!.bounds.height)
t = t.expect("rows below a growing row move down", region.content-bounds.y + 85, below.bounds.y)
t = t.expect("a growing row grows the extent", start + 25vcoord, region.virtual-extent-y.known)
t = t.expect("growth below the viewport top keeps the scroll position", 0.0, region.scroll-y)

region.scroll-to(Point(0, 100))
window.layout()
. visible = measured-root(region, 3)!
. resting = visible.presentation-rect(visible.bounds).y
row.grown = 5
settle-measured(window)
t = t.expect("a row shrinking above the viewport shifts the scroll", 80.0, region.scroll-y)
t = t.expect
    - "visible rows hold still when a row above shrinks"
    - resting
    - visible.presentation-rect(visible.bounds).y
= t

━━━━━━━━━━━━━━━━━━━━
_ do virtual-end-anchor-tests
    - t TestCase

<VirtualMeasuredWindow window
    anchors-end = true

window.open()
window.layout()
. region = window.region
. content = region.content-bounds
t = t.expect("an end-anchored region opens at its end", region.scroll-max.y, region.scroll-y)
t = t.expect("the end reflects measured rows", 2880.0, region.scroll-y)
. last = measured-root(region, 99)!
t = t.expect
    - "the last row sits at the viewport bottom"
    - content.bottom
    - last.presentation-rect(last.bounds).bottom

measured-row(region, 99)!.grown = 30
settle-measured(window)
t = t.expect("a growing last row keeps the end in view", 2910.0, region.scroll-y)
t = t.expect("the region still rests at its end", region.scroll-max.y, region.scroll-y)

window.source.count = 101vcoord
window.settle-layout()
t = t.expect("an appended row keeps the end in view", 2950.0, region.scroll-y)
t = t.check("the appended row is bound", measured-root(region, 100) != null)

. consumed = region.scroll-by(Point(0, -30), ScrollCause.wheel)
window.layout()
t = t.check("scrolling away stops following the end", !region.follows-end)
. away = region.scroll-y
measured-row(region, 99)!.grown = 60
settle-measured(window)
t = t.expect("growth leaves a region that stopped following alone", away, region.scroll-y)

region.follow-end()
window.layout()
t = t.expect("following again returns to the end", region.scroll-max.y, region.scroll-y)
consumed = region.scroll-by(Point(0, -100), ScrollCause.wheel)
consumed = region.scroll-by(Point(0, 100), ScrollCause.wheel)
t = t.check("scrolling back to the end follows it again", region.follows-end)
= t

━━━━━━━━━━━━━━━━━━━━
_ do virtual-end-anchor-resize-tests
    - t TestCase

<VirtualWrappedWindow window

window.open()
window.layout()
. region = window.region

window.size = (200, 400)
window.layout()
. content = region.content-bounds
. last = measured-root(region, 99)!
t = t.expect("a narrower region measures its rows again", 32.0, last.bounds.height)
t = t.check("rows restack without gaps or overlap", bound-rows-tile(region, 99))
t = t.expect("a width change keeps the end in view", region.scroll-max.y, region.scroll-y)
t = t.expect
    - "the last row still sits at the viewport bottom"
    - content.bottom
    - last.presentation-rect(last.bounds).bottom
= t

