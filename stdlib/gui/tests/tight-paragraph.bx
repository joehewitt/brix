(import /core/markup)
(import /graphics/canvas)
(import /graphics/font-registration)
(import /graphics/primitives)
(import /graphics/text)
(import /gui/box)
(import /gui/label)
(import /gui/layout)
(import /gui/primitives)
(import /test)
(blank)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "GUI Tight Paragraph Sizing"))
  (call (. cases run) gui-text-tight-sizing-tests)
  (return cases)
)

(fn-do + gui-text-tight-sizing-tests _
  (param t TestCase)
  (let catalog (call FontCatalog))
  (let registration (call (. catalog register) "noto-sans/NotoSans-Regular.ttf"))
  (let root (call TextTestRoot))
  (let label (call ReactiveTightWordTextLabel))
  (= (. label family-name) (. registration family))
  (call markup-append root label)
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (blank)
  (let cases (list TightTextCase))
  (+= cases (call TightTextCase "one-line" "A compact message" 200 1))
  (+= cases (call TightTextCase "two-line" "A compact message with a notably short tail" 180 2))
  (+= cases
    (call TightTextCase
      (block
        (arg "short-tail-threshold")
        (arg "The first row fills the cap with ordinary words and the tail is tiny")
        (arg 230.25)
        (arg 2)
      )
    )
  )
  (+= cases
    (call TightTextCase
      (block
        (arg "three-line")
        (arg "A compact message with several words and a short tail")
        (arg 150)
        (arg 3)
      )
    )
  )
  (for (in case cases)
    (= (. label text) (. case text))
    (let reference
      (call TextLayout
        (block
          (arg (. case text))
          (arg (. label effective-font))
          (arg (. case maximum-width))
          (arg (. TextOverflow clip))
          (arg (. TextWrap word))
        )
      )
    )
    (do-use reference
      (let measured (. (call (. label measure) (call measure-fit-query (. case maximum-width))) content-size))
      (let snapshot (!! (. label text-layout-snapshot)))
      (call (. t expect) (str (. case name) " reference line count") (. case line-count) (. reference line-count))
      (call (. t expect) (str (. case name) " tight line count") (. reference line-count) (. snapshot line-count))
      (call (. t expect) (str (. case name) " tight height") (. reference height) (. measured height))
      (call (. t check) (str (. case name) " stays under A") (<= (. measured width) (. case maximum-width)))
      (let stable (. (call (. label measure) (call measure-fit-query (. measured width))) content-size))
      (call (. t expect) (str (. case name) " is stable when W becomes A") measured stable)
      (call (. t expect)
        (block
          (arg (str (. case name) " stable remeasure keeps breaks"))
          (arg snapshot)
          (arg (!! (. label text-layout-snapshot)))
        )
      )
      (if (> (. measured width) 0.01)
        (let narrower
          (call TextLayout
            (block
              (arg (. case text))
              (arg (. label effective-font))
              (arg (- (. measured width) 0.01))
              (arg (. TextOverflow clip))
              (arg (. TextWrap word))
            )
          )
        )
        (do-use narrower
          (let rejects-narrower (!= (. narrower line-count) (. reference line-count)))
          (= rejects-narrower (or rejects-narrower (!= (. narrower height) (. reference height))))
          (call (. t check) (str (. case name) " rejects a narrower admissible width") rejects-narrower)
        )
      )
    )
  )
  (blank)
  (let threshold-bubble (call TightCappedBubbleParent))
  (let threshold-label (call ThresholdTightWordTextLabel))
  (= (. threshold-label family-name) (. registration family))
  (= (. threshold-label text) "The first row fills the cap with ordinary words and the tail is tiny")
  (call markup-append threshold-bubble threshold-label)
  (call markup-append root threshold-bubble)
  (call (. root markup-batch-queue checkpoint))
  (let threshold-size (. (call (. threshold-bubble measure)) border-size))
  (call (. threshold-bubble layout) (call Rect 0 0 (. threshold-size width) (. threshold-size height)))
  (let threshold-canvas (call RasterCanvas 260 100 1))
  (do-use threshold-canvas
    (call (. threshold-bubble paint) threshold-canvas)
  )
  (let threshold-snapshot (!! (. threshold-label text-layout-snapshot)))
  (call (. t expect) "tight threshold paint preserves two lines" 2 (. threshold-snapshot line-count))
  (call (. t check)
    (block
      (arg "tight threshold text stays within its measured Label")
      (arg (<= (. threshold-snapshot size height) (. threshold-label content-bounds height)))
    )
  )
  (blank)
  (call (. label close))
  (call (. threshold-label close))
  (call (. threshold-bubble close))
  (call (. registration close))
  (blank)
  (return t)
)

(type + TextTestRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue (as this MarkupRootElement))))
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
    (let ignored (. flush applied))
  )
)

(type + WordTextLabel (is Label)
  (rule This
    (= text-wrap (. TextWrap word))
    (= text-overflow (. TextOverflow clip))
  )
)

(type + TightWordTextLabel (is WordTextLabel)
  (prop + family-name String (= ""))
  (blank)
  (rule This
    (= font-family #family-name)
    (= text-wrap-sizing (. TextWrapSizing tight))
  )
)

(type + ReactiveTightWordTextLabel (is TightWordTextLabel))

(type + ThresholdTightWordTextLabel (is Label)
  (prop + family-name String)
  (blank)
  (rule This
    (= font-family #family-name)
    (= max-width (call (. SizeSpec coord) 230.25))
    (= text-wrap (. TextWrap word))
    (= text-wrap-sizing (. TextWrapSizing tight))
  )
)

(type + TightBubbleParent (is Box)
  (rule This
    (= layout (call FlowLayout (. Orientation horizontal)))
    (= padding-left 8)
    (= padding-right 8)
    (= padding-top 6)
    (= padding-bottom 6)
  )
)

(type + TightCappedBubbleParent (is TightBubbleParent)
  (prop + text-cap Length (= 230.25))
  (blank)
  (rule This (• pl 9) (• pr 9) (• pt 7) (• pb 7)
    (= max-width (call (. SizeSpec coord) 248.25))
    (= border-width 1)
  )
  (fn-expr + measured-content-size _
    (param query MeasureQuery)
    (. (call (. label measure) (call measure-fit-query text-cap)) outer-size)
    (where
      (lazy label (as (!! %first-child) Box))
    )
  )
)

(type + TightTextCase (is Tuple)
  (prop + name String)
  (prop + text String)
  (prop + maximum-width Length)
  (prop + line-count Int)
)
