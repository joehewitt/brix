/core/markup
/gui/box
/gui/label
/gui/primitives
/gui/window
/test

tests()

━━━━━━━━━━━━━━━━━━━━
+ do tests TestRender

. cases = TestCase("GUI Layout Checkpoint Outside Mutation")
cases.run(layout-checkpoint-outside-tests)
= cases

━━━━━━━━━━━━━━━━━━━━
_ do layout-checkpoint-outside-tests
    - t TestCase

. window = open-checkpoint-window()
. region = window.region
. outside = window.outside

region.base = 12345678
region.invalidate-layout()
window.layout()
t = t.expect("outside data changes during the region checkpoint", "Outside 12345678", outside.text)

window.layout()
t = t.expect("outside relayout is not lost", outside.intrinsic-size.width, outside.bounds.width)
= t

━━━━━━━━━━━━━━━━━━━━
_ do open-checkpoint-window

<CheckpointWindow window

window.open()
= window

━━━━━━━━━━━━━━━━━━━━
+ CheckpointShared

+ outside-text = "Outside"

━━━━━━━━━━━━━━━━━━━━
+ CheckpointRegion is Box

+ shared CheckpointShared?
+ base I64

────────────────────
+ do did-layout

shared?.outside-text = "Outside ${base}"
. root = markup-batch-root
if root
    catch root.markup-batch-queue.checkpoint()
super.did-layout()

━━━━━━━━━━━━━━━━━━━━
+ CheckpointWindow is Window

+ shared := CheckpointShared()

────────────────────

<This • flex-col
    size = (320, 400)

    <Box • flex-row
        <Label outside
            text = shared.#outside-text

    <CheckpointRegion region • h:200
        shared = #shared

