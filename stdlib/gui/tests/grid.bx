(import /core/markup)
(import /graphics/primitives)
(import /gui/box)
(import /gui/layout)
(import /gui/primitives)
(import /gui/text)
(import /math)
(import /test)
(blank)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "GUI Grid Natural Tracks"))
  (call (. cases run) grid-natural-tests)
  (= cases (call (. cases then) "GUI Grid Gaps" grid-gap-tests))
  (= cases (call (. cases then) "GUI Grid Shrinking Tracks" grid-shrink-tests))
  (= cases (call (. cases then) "GUI Grid Fixed And Flex Tracks" grid-track-tests))
  (= cases (call (. cases then) "GUI Grid Cell Alignment" grid-alignment-tests))
  (= cases (call (. cases then) "GUI Grid Floored Text" grid-floored-text-tests))
  (return cases)
)

(fn-do + grid-natural-tests _
  (param t TestCase)
  (let empty (call mounted-grid (call GridLayout 2) (call (of List Dimensions))))
  (call (. t expect) "an empty grid has no size" (call Dimensions 0 0) (. (call (. empty measure)) content-size))
  (blank)
  (let root
    (call mounted-grid
      (block
        (arg (call GridLayout 2))
        (arg (list (call Dimensions 10 3) (call Dimensions 20 5) (call Dimensions 30 4) (call Dimensions 5 8) (call Dimensions 7 2)))
      )
    )
  )
  (call (. t expect)
    (block
      (arg "natural size sums the widest cells and tallest rows")
      (arg (call Dimensions 50 15))
      (arg (. (call (. root measure)) content-size))
    )
  )
  (call (. root layout) (call Rect 2 3 100 40))
  (call (. t expect) "the first cell fills its track" (call Rect 2 3 30 5) (. (call (. root cell) 0) bounds))
  (call (. t expect) "a column starts after the one before it" (call Rect 32 3 20 5) (. (call (. root cell) 1) bounds))
  (call (. t expect) "a row starts under the one before it" (call Rect 2 8 30 8) (. (call (. root cell) 2) bounds))
  (call (. t expect) "a short cell stretches to its row and column" (call Rect 32 8 20 8) (. (call (. root cell) 3) bounds))
  (call (. t expect) "a partial last row keeps its column" (call Rect 2 16 30 2) (. (call (. root cell) 4) bounds))
  (call (. t expect) "tracks keep their natural width in a wider box" 50 (. root inner-width))
  (call (. t expect) "rows set the scroll height" 15 (. root inner-height))
  (return t)
)

(fn-do + grid-gap-tests _
  (param t TestCase)
  (let sizes (list (call Dimensions 10 3) (call Dimensions 20 5) (call Dimensions 30 4) (call Dimensions 5 8)))
  (let root (call mounted-grid (call GridLayout 2) sizes))
  (= (. root authored-gap) 4)
  (call (. root markup-batch-queue checkpoint))
  (call (. t expect) "the box gap separates columns and rows" (call Dimensions 54 17) (. (call (. root measure)) content-size))
  (call (. root layout) (call Rect 0 0 100 40))
  (call (. t expect) "the column gap offsets the second column" 34 (. (call (. root cell) 1) bounds left))
  (call (. t expect) "the row gap offsets the second row" 9 (. (call (. root cell) 2) bounds top))
  (return t)
)

(fn-do + grid-shrink-tests _
  (param t TestCase)
  (let sizes (list (call Dimensions 20 4) (call Dimensions 100 4) (call Dimensions 60 4)))
  (let root (call mounted-grid (call GridLayout 3) sizes))
  (call (. root layout) (call Rect 0 0 120 20))
  (call (. t expect) "a narrow track keeps its natural width" 20 (. (call (. root cell) 0) bounds width))
  (call (. t expect) "the widest track shrinks first" 50 (. (call (. root cell) 1) bounds width))
  (call (. t expect) "wide tracks share the remaining space" 50 (. (call (. root cell) 2) bounds width))
  (call (. t expect) "shrunk tracks fill the box" 120 (. root inner-width))
  (blank)
  (call (. root layout) (call Rect 0 0 50 20))
  (call (. t expect) "tracks narrower than their share all shrink" 16 (. (call (. root cell) 0) bounds width))
  (call (. t expect) "shrunk tracks stay inside the box" 48 (. root inner-width))
  (blank)
  (let floored (call mounted-grid (call GridLayout 3 30) sizes))
  (call (. floored layout) (call Rect 0 0 50 20))
  (call (. t expect) "the floor never widens a track past its content" 20 (. (call (. floored cell) 0) bounds width))
  (call (. t expect) "the floor stops a wide track shrinking" 30 (. (call (. floored cell) 1) bounds width))
  (call (. t expect) "floored tracks overflow the box" 80 (. floored inner-width))
  (return t)
)

(fn-do + grid-track-tests _
  (param t TestCase)
  (let sizes (list (call Dimensions 10 4) (call Dimensions 30 4) (call Dimensions 12 4)))
  (let root (call mounted-grid (call GridLayout (list (call (. GridTrack fixed) 40) (. GridTrack auto) (call (. GridTrack flex) 1))) sizes))
  (call (. root layout) (call Rect 0 0 200 20))
  (call (. t expect) "a fixed track ignores its content" 40 (. (call (. root cell) 0) bounds width))
  (call (. t expect) "an auto track takes its content width" 30 (. (call (. root cell) 1) bounds width))
  (call (. t expect) "a flex track takes the space left over" 130 (. (call (. root cell) 2) bounds width))
  (call (. t expect)
    (block
      (arg "unconstrained flex tracks take their content width")
      (arg (call Dimensions 82 4))
      (arg (. (call (. root measure)) content-size))
    )
  )
  (blank)
  (let shared
    (call mounted-grid
      (block
        (arg (call GridLayout (list (call (. GridTrack flex) 1) (call (. GridTrack flex) 3))))
        (arg (list (call Dimensions 50 4) (call Dimensions 50 4)))
      )
    )
  )
  (call (. shared layout) (call Rect 0 0 200 20))
  (call (. t expect) "flex tracks split space by weight" 50 (. (call (. shared cell) 0) bounds width))
  (call (. t expect) "a heavier flex track takes more" 150 (. (call (. shared cell) 1) bounds width))
  (blank)
  (let crowded
    (call mounted-grid
      (block
        (arg (call GridLayout (list (. GridTrack auto) (call (. GridTrack flex) 1)) 24))
        (arg (list (call Dimensions 90 4) (call Dimensions 60 4)))
      )
    )
  )
  (call (. crowded layout) (call Rect 0 0 100 20))
  (call (. t expect) "a flex track keeps its floor when space runs out" 24 (. (call (. crowded cell) 1) bounds width))
  (call (. t expect) "auto tracks shrink to leave the flex floor" 76 (. (call (. crowded cell) 0) bounds width))
  (return t)
)

(fn-do + grid-alignment-tests _
  (param t TestCase)
  (let root
    (call mounted-grid
      (block
        (arg (call GridLayout 2))
        (arg (list (call Dimensions 40 20) (call Dimensions 10 6) (call Dimensions 10 6) (call Dimensions 30 6)))
      )
    )
  )
  (= (. (call (. root cell) 1) align-y) (. Alignment center))
  (= (. (call (. root cell) 2) align-x) (. Alignment end))
  (call (. root markup-batch-queue checkpoint))
  (call (. root layout) (call Rect 0 0 100 40))
  (call (. t expect)
    (block
      (arg "vertical alignment keeps natural height in the row")
      (arg (call Rect 40 7 30 6))
      (arg (. (call (. root cell) 1) bounds))
    )
  )
  (call (. t expect)
    (block
      (arg "horizontal alignment keeps natural width in the column")
      (arg (call Rect 30 20 10 6))
      (arg (. (call (. root cell) 2) bounds))
    )
  )
  (return t)
)

(fn-do + grid-floored-text-tests _
  (param t TestCase)
  (let root (call GridTestRoot (call GridLayout 2 120)))
  (call markup-append root (call GridTestCell (call Dimensions 40 4)))
  (call markup-append
    (block
      (arg root)
      (arg (call grid-text "A description far too long to fit on one line at the floor of its track."))
    )
  )
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (call (. root layout) (call Rect 0 0 100 200))
  (let prose (as (call grid-child root 1) Text))
  (let lines (!! (. prose text-layout-snapshot)))
  (call (. t expect) "a track that cannot fit stops at its floor" 120 (. prose bounds width))
  (call (. t expect) "text in a floored track wraps at the floor width" 120 (. lines constrained-width))
  (call (. t expect) "the row grows to the wrapped height" (. lines size height) (. prose bounds height))
  (call (. t expect)
    (block
      (arg "cells in the floored row share its height")
      (arg (. prose bounds height))
      (arg (. (call (. root cell) 0) bounds height))
    )
  )
  (return t)
)

(fn-do _ mounted-grid _
  (param layout GridLayout)
  (param sizes (list Dimensions))
  (let root (call GridTestRoot layout))
  (for (in size sizes)
    (call markup-append root (call GridTestCell size))
  )
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (return root)
)

(fn-do _ grid-child Box
  (param root Box)
  (param index Index)
  (let position Index 0)
  (for (in child (. root children))
    (return-if (as child Box) (if (== position index)))
    (+= position 1)
  )
  (throw (call Panic (str "Grid test child " index " does not exist")))
)

(fn-do _ grid-text _
  (param content String)
  (let text (call Text))
  (call markup-append text (call Span content))
  (return text)
)

(type + GridTestRoot (is Box)
  (implements MarkupRootElement)
  (prop + grid GridLayout)
  (prop + authored-gap Length)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (rule This
    (= layout #grid)
    (= gap #authored-gap)
  )
  (fn-do + This _
    (param grid _)
  )
  (fn-do + cell GridTestCell
    (param index Index)
    (let position Index 0)
    (for (in child children)
      (return-if (as child GridTestCell) (if (== position index)))
      (+= position 1)
    )
    (throw (call Panic (str "Grid test cell " index " does not exist")))
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(type + GridTestCell (is Box)
  (prop + desired _ (= (call Dimensions 5 4)))
  (fn-do + This _
    (param desired _ (= (call Dimensions 5 4)))
  )
  (fn-expr + measured-content-size _
    (param query MeasureQuery)
    desired
  )
)
