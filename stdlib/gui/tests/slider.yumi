tests()

━━━━━━━━━━━━━━━━━━━━
+ do tests TestRender

. cases = TestCase("Slider Pointer Interaction")
cases.run(slider-pointer-tests)
cases = cases.then("Slider Gesture Phases", slider-phase-tests)
= cases

━━━━━━━━━━━━━━━━━━━━
+ do slider-pointer-tests
    - t TestCase

. window = SliderTestWindow()
. slider = window.slider
slider.minimum = 0
slider.maximum = 100
slider.value = 50
slider.step = 10
window.open()

window.dispatch-pointer-event
    - PointerDownEvent(PointerEventData(Point(64, 10.5), 7), PointerButton.primary)
t.expect("thumb press publishes one began event", 1, slider.value-changed-count)
t.expect("thumb press reports the began phase", ValueChangePhase.began, slider.last-phase)

window.dispatch-pointer-event
    - PointerDragEvent(PointerEventData(Point(74, 10.5), 7), PointerButton.primary)
window.dispatch-pointer-event
    - PointerDragEvent(PointerEventData(Point(-20, 10.5), 7), PointerButton.primary)
window.dispatch-pointer-event
    - PointerDragEvent(PointerEventData(Point(200, 10.5), 7), PointerButton.primary)
t.expect("drag values report the changed phase", ValueChangePhase.changed, slider.last-phase)

window.dispatch-pointer-event
    - PointerUpEvent(PointerEventData(Point(200, 10.5), 7), PointerButton.primary)
t.expect("release publishes one ended event", 5, slider.value-changed-count)
t.expect("release reports the ended phase", ValueChangePhase.ended, slider.last-phase)

window.dispatch-pointer-event
    - PointerDownEvent(PointerEventData(Point(30, 10.5), 8), PointerButton.primary)
t.expect("track press begins the gesture", ValueChangePhase.began, slider.last-phase)
window.dispatch-pointer-event
    - PointerUpEvent(PointerEventData(Point(30, 10.5), 8), PointerButton.primary)
t.expect("track release ends the gesture", 7, slider.value-changed-count)

window.close()
= t

━━━━━━━━━━━━━━━━━━━━
+ do slider-phase-tests
    - t TestCase

. window = SliderTestWindow()
. slider = window.slider
slider.minimum = 0
slider.maximum = 100
slider.value = 50
window.open()

window.dispatch-pointer-event
    - PointerDownEvent(PointerEventData(Point(64, 10.5), 3), PointerButton.primary)
window.dispatch-pointer-event
    - PointerDragEvent(PointerEventData(Point(64, 10.5), 3), PointerButton.primary)
t.expect("a drag without movement publishes only the began event", 1, slider.value-changed-count)

slider.blur <- BlurEvent()
t.expect("blur during a drag ends the gesture", 2, slider.value-changed-count)
t.expect("blur reports the ended phase", ValueChangePhase.ended, slider.last-phase)

slider.blur <- BlurEvent()
t.expect("blur outside a drag stays silent", 2, slider.value-changed-count)

window.dispatch-pointer-event
    - PointerDownEvent(PointerEventData(Point(64, 10.5), 4), PointerButton.primary)
slider.is-enabled = false
settle-slider(window)
t.expect("disabling during a drag ends the gesture", 4, slider.value-changed-count)
t.expect("disabling reports the ended phase", ValueChangePhase.ended, slider.last-phase)

window.close()
= t

━━━━━━━━━━━━━━━━━━━━
+ do settle-slider
    - window SliderTestWindow

. root = window.slider.markup-batch-root!
root.markup-batch-queue.checkpoint()
window.layout()

