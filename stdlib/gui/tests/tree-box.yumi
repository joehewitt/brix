━━━━━━━━━━━━━━━━━━━━
+ do tests TestRender

. cases = TestCase("GUI TreeBox Virtual")
cases.run(tree-box-virtual-tests)
cases = cases.then("GUI TreeBox Row Height", tree-box-row-height-tests)
cases = cases.then("GUI TreeBox Drag Rows", tree-box-drag-tests)
cases = cases.then("GUI TreeBox Drag Into", tree-box-drag-into-tests)
cases = cases.then("GUI TreeBox Drag Selection", tree-box-drag-selection-tests)
cases = cases.then("GUI TreeBox Ancestor Drag", tree-box-ancestor-drag-tests)
cases = cases.then("GUI TreeBox Ancestor Focus", tree-box-ancestor-focus-tests)
= cases

━━━━━━━━━━━━━━━━━━━━
_ do tree-box-row-height-tests
    - t TestCase

. window = open-drag-tree()
. tree = window.tree
t = t.expect("rows start at the theme's height", 24, tree.row-for-key("guide")!.bounds.y)
t = t.expect("paging starts from the theme's height", 16, tree.page-row-step)
tree.row-height = 30
settle(window)
window.window-clock.finish-all()
t = t.expect("a styled row height restacks the rows", 60, tree.row-for-key("deep")!.bounds.y)
t = t.expect("a styled row height sizes the rows", 30, tree.row-for-key("deep")!.bounds.height)
t = t.expect("paging follows the styled height", 13, tree.page-row-step)

pull(window, Point(60, 195), Point(30, 94))
t = t.check
    - "the row itself follows the pointer"
    - tree.row-for-key("readme")!.material-parent?.is-carried ?? false
t = t.expect
    - "the carried row keeps the styled height"
    - 30
    - tree.row-for-key("readme")!.bounds.height
t = t.expect("the pointer picks a gap by the styled height", 3, tree.drop-gap ?? 99)
t = t.expect("rows below the gap move down a styled row", 120, tree.row-for-key("api")!.bounds.y)
. mark = find-mark(window)
t = t.expect("the mark sits at the styled gap", 90, mark?.bounds.y ?? -1)
t = t.expect("the mark takes the styled height", 30, mark?.bounds.height ?? -1)
t = t.expect("the mark ends where the styled gap ends", 120, mark?.bounds.bottom ?? -1)
release(window, Point(30, 94))
window.close()
= t

━━━━━━━━━━━━━━━━━━━━
_ do tree-box-drag-tests
    - t TestCase

. window = open-drag-tree()
. tree = window.tree

pull(window, Point(60, 156), Point(30, 75))
t = t.expect("a gap opens where the row would land", 3, tree.drop-gap ?? 99)
t = t.expect("the pointer's reach picks the depth", 1, tree.drop-depth)
t = t.expect("rows below the gap move down", 96, tree.row-for-key("api")!.bounds.y)
t = t.expect("rows above the gap stay", 48, tree.row-for-key("deep")!.bounds.y)
. mark = find-mark(window)
t = t.expect("the mark fills the gap", 72, mark!.bounds.y)
t = t.expect("the mark ends where the gap ends", 96, mark!.bounds.bottom)

slide(window, Point(60, 80))
t = t.expect("the gap holds still under the pointer", 3, tree.drop-gap ?? 99)
t = t.expect("reaching right goes deeper", 2, tree.drop-depth)
slide(window, Point(30, 80))
t = t.expect("reaching left comes back out", 1, tree.drop-depth)

slide(window, Point(30, 130))
t = t.expect("the gap follows the pointer", 4, tree.drop-gap ?? 99)
release(window, Point(30, 130))
t = t.expect("releasing reports the drop", "readme>docs@2", window.story)
= t

━━━━━━━━━━━━━━━━━━━━
_ do tree-box-drag-into-tests
    - t TestCase

. window = open-drag-tree()
. tree = window.tree
tree.collapse-key("src")
settle(window)

pull(window, Point(60, 84), Point(60, 112))
t = t.expect("a gap opens below a closed folder", 4, tree.drop-gap ?? 99)
t = t.expect("reaching over a closed folder aims into it", 1, tree.drop-depth)
t = t.expect("the folder that would take the drop is named", "src", tree.drop-key ?? "")
slide(window, Point(20, 88))
t = t.expect("reaching left lands beside the folder", 0, tree.drop-depth)
t = t.check("no folder is named beside it", tree.drop-key == null)
slide(window, Point(60, 112))
t = t.expect("reaching right aims into the folder again", "src", tree.drop-key ?? "")
release(window, Point(60, 112))
t = t.expect("a drop into a folder names no index", "api>src@in", window.story)
tree.expand-key("src")
settle(window)

window.refuses = "guide"
pull(window, Point(60, 156), Point(60, 75))
t = t.expect("a refused parent leaves the gap", 3, tree.drop-gap ?? 99)
t = t.expect("a refused parent gives way to the next depth", 1, tree.drop-depth)
t = t.expect("the parent that takes the drop is named", "docs", tree.drop-key ?? "")
release(window, Point(60, 75))
t = t.expect("the drop lands in the parent that took it", "api>src@in readme>docs@1", window.story)
= t

━━━━━━━━━━━━━━━━━━━━
_ do tree-box-drag-selection-tests
    - t TestCase

. window = open-drag-tree()
click(window, Point(60, 84), 1)
command-click(window, Point(60, 132))

window.dispatch-pointer-event(PointerDownEvent(PointerEventData(Point(60, 84))))
settle(window)
slide(window, Point(60, 160))
release(window, Point(60, 160))
t = t.expect("the drop carries every chosen item", "api+main>root@3", window.story)
= t

