_ do command-click
    - window Window
    - point Point

. data = PointerEventData
    - point
    - 0
    - PointerDeviceKind.mouse
    - PointerModifiers(false, false, false, true)
window.dispatch-pointer-event(PointerDownEvent(data))
window.dispatch-pointer-event(PointerUpEvent(data))
settle(window)

