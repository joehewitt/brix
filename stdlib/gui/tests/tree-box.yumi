_ do tree-box-ancestor-drag-tests
    - t TestCase

. window = open-scrolled-tree()
window.scroller.scroll-to(Point(0, 120))
settle(window)
pull(window, Point(60, 42), Point(60, 200))
t = t.expect("starting a drag leaves the enclosing box where it was", 120, window.scroller.scroll-y)
release(window, Point(60, 200))
= t

━━━━━━━━━━━━━━━━━━━━
_ do tree-box-ancestor-focus-tests
    - t TestCase

. window = open-scrolled-tree()
. tree = window.tree
. scroller = window.scroller
press(window, Key.tab)
t = t.expect("focus leaves a visible cursor row where it is", 0, scroller.scroll-y)
press(window, Key.end)
t = t.check("the last row is in view", row-in-view(scroller, tree.row-for-key("n199")))
tree.clear-focus()
scroller.scroll-to(Point(0, 0))
settle(window)
press(window, Key.tab)
t = t.check("focus reveals the cursor row", row-in-view(scroller, tree.row-for-key("n199")))
= t

