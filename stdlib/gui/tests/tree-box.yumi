━━━━━━━━━━━━━━━━━━━━
_ do find-mark TreeBoxDropMark?
    - node GuiNode

for child in node.children
    =? child as TreeBoxDropMark if child is TreeBoxDropMark
    . found = find-mark(child)
    =? found if found
= null

━━━━━━━━━━━━━━━━━━━━
_ do detach-node
    - parent TreeNode
    - node TreeNode

. children = parent.children
=? if !children
for index in 0 .. < children.length
    if children[index].id == node.id
        children.remove(index)
        =
for child in children
    detach-node(child, node)

━━━━━━━━━━━━━━━━━━━━
_ do settle
    - window Window

. root = window.markup-batch-root
if root
    root.markup-batch-queue.checkpoint()
window.layout()
if root
    root.markup-batch-queue.checkpoint()
window.layout()

