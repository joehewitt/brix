_ do tree-box-virtual-tests
    - t TestCase

<LargeTreeWindow window

window.focus-adapter = GUIFocusAdapter()
window.open()
settle(window)
window.tree.request-focus()
settle(window)
. tree = window.tree

press(window, Key.end)
t = t.check("End reveals the last entry", tree.row-for-key("n4999") != null)
= t

