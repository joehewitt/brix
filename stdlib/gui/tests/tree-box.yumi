━━━━━━━━━━━━━━━━━━━━
+ DragTreeWindow is Window

+ model = TreeModel()
+ refuses = ""
+ log [String]
+ story => " ".join(each in log)

────────────────────

<This
    size = (320, 400)

    <TreeBox'TreeNode tree • absolute cover:.parent
        root-node = model.root
        load-children = tree-node-children
        key-builder = tree-node-key
        auto-expand = tree-node-is-folder
        selection-mode = SelectionMode.multiple
        can-drag = :: node => node.id != "docs"
        can-drop = :: drop => takes(drop)

        <Label (row) - row
            text = row.#item?.text ?? ""

────────────────────
for event on tree.dropped

. names = "+".join(each.id in event.items)
. index = event.index
. place = "in"
if index != null
    place = "$index"
log += "$names>${event.parent.id}@$place"
for node in event.items
    detach-node(model.root, node)
. offset Index = event.index ?? event.parent.children!.length
for node in event.items
    event.parent.children!.insert(node, offset)
    offset += 1
tree.reload()

────────────────────
+ takes
    - drop TreeBoxDrop'TreeNode

|? drop.parent.id == refuses
    false
??
    drop.parent.children != null

