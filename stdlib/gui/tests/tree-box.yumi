━━━━━━━━━━━━━━━━━━━━
_ row-in-view Bool
    - scroller Box
    - row Box?

|? !row
    false
??
    shown.top >= view.top && shown.bottom <= view.bottom

.. shown = row.presentation-rect(row.bounds)
.. view = scroller.content-bounds

