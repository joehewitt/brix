_ do click
    - window Window
    - point Point
    - count U32

window.dispatch-pointer-event
    - PointerDownEvent(PointerEventData(point), PointerButton.primary, count)
window.dispatch-pointer-event(PointerUpEvent(PointerEventData(point)))
settle(window)

