(import /core/markup)
(import /gui/box)
(import /gui/tests/support/probe-boxes)
(import /gui/text-input)
(import /gui/window)
(import /test)
(blank)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "GUI Native Text Input Event Seams"))
  (call (. cases run) gui-control-event-tests)
  (return cases)
)

(fn-do + gui-control-event-tests _
  (param t TestCase)
  (let trace (list String))
  (let window (call PointerTestWindow trace))
  (= (. window focus-adapter) (call GUIFocusAdapter))
  (let input (call HeadlessTextInputProbe))
  (= (. input text) "seed")
  (call markup-append window input)
  (call (. window open))
  (blank)
  (call (. input accept-native-input) "draft")
  (call (. input accept-native-input) "draft")
  (call (. t expect) "native edits publish one realtime Input" 1 (. input input-count))
  (call (. t check) "Input sees the already-updated model" (. input input-state-was-current))
  (call (. input accept-native-commit) "done")
  (call (. t expect) "commit publishes one Change" 1 (. input change-count))
  (call (. t check)
    (block
      (arg "Change carries committed old and new text")
      (arg (and (== (. input last-old-text) "seed") (== (. input last-text) "done")))
    )
  )
  (call (. input accept-native-commit) "done")
  (call (. t expect) "duplicate commit is suppressed" 1 (. input change-count))
  (blank)
  (= (. input text) "model")
  (call (. t expect) "programmatic text writes emit no user event" 2 (. input input-count))
  (call (. t expect) "programmatic text writes emit no Change" 1 (. input change-count))
  (call (. input accept-native-submit) "")
  (call (. t expect) "replacement publishes Change from current model baseline" 2 (. input change-count))
  (call (. t check)
    (block
      (arg "empty replacement preserves old/new payload")
      (arg (and (== (. input last-old-text) "model") (== (. input last-text) "")))
    )
  )
  (blank)
  (call (. window close))
  (return t)
)

(type + HeadlessTextInputProbe (is TextInput)
  (prop + input-count Size (= 0))
  (prop + change-count Size (= 0))
  (prop + input-state-was-current _ (= false))
  (prop + last-old-text _ (= ""))
  (prop + last-text _ (= ""))
  (subscribe-for (on event input)
    (+= input-count 1)
    (= input-state-was-current (== text (. event text)))
  )
  (subscribe-for (on event change)
    (+= change-count 1)
    (= last-old-text (. event old-text))
    (= last-text (. event text))
  )
  (fn-do + mounted _)
  (fn-do + unmounted _)
)
