━━━━━━━━━━━━━━━━━━━━
+ do tests TestRender

. cases = TestCase("Palette Styles")
cases.run(style-tests)
= cases

━━━━━━━━━━━━━━━━━━━━
_ do style-tests
    - t TestCase

. window = open-palette-window()
. palette = window.palette
palette.show()
settle(window)
t.expect("the theme sets the panel width", 520, palette.bounds.width)
t.expect("the theme sets the panel height", 360, palette.bounds.height)
t.expect("the theme centers the panel", 60, palette.bounds.x)
t.expect("the theme places the panel below the top", 56, palette.bounds.y)
t.expect("the theme sets the row height", 25, row-height(palette, 0))
t.expect("rows stack by the themed height", 25, row-top(palette, 1) - row-top(palette, 0))
palette.dismiss()
settle(window)

. berries = window.berries
berries.show()
settle(window)
t.expect("a theme rule resizes a palette", 300, berries.bounds.width)
t.expect("a theme rule moves a palette", 20, berries.bounds.y)
t.expect("a theme rule sets a palette's row height", 40, row-height(berries, 0))
t.expect("rows stack by the rule's height", 40, row-top(berries, 1) - row-top(berries, 0))
berries.row-height = 30
settle(window)
t.expect("a new row height resizes the rows", 30, row-height(berries, 0))
t.expect("a new row height restacks the rows", 30, row-top(berries, 1) - row-top(berries, 0))
window.close()
= t

