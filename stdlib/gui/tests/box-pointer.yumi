━━━━━━━━━━━━━━━━━━━━
+ do tests TestRender

. cases = TestCase("GUI Pointer Hit Testing")
cases.run(gui-pointer-hit-testing-tests)
cases = cases.then("GUI Pointer Routing And Cancellation", gui-pointer-routing-tests)
cases = cases.then("GUI Pointer Hover Capture And Click", gui-pointer-state-tests)
cases = cases.then("GUI Pointer Scroll And Scalar Translation", gui-pointer-scroll-tests)
= cases

━━━━━━━━━━━━━━━━━━━━
+ do gui-pointer-hit-testing-tests
    - t TestCase

. trace [String]
. window = PointerTestWindow(trace)
window.size = Dimensions(100, 100)
. under = PointerProbeBox("under", trace)
. over-box = PointerProbeBox("over", trace)
. shadow = PointerShadowBox("shadow", trace)
. shadow-child = PointerProbeBox("shadow-child", trace)
. overflow-parent = PointerProbeBox("overflow-parent", trace)
. overflow-child = PointerProbeBox("overflow-child", trace)
. hidden = HiddenPointerProbe("hidden", trace)
. invisible = InvisiblePointerProbe("invisible", trace)
markup-append(window, under)
markup-append(window, over-box)
markup-append(window, shadow)
markup-append(shadow, shadow-child)
markup-append(window, overflow-parent)
markup-append(overflow-parent, overflow-child)
markup-append(window, hidden)
markup-append(window, invisible)
window.open()

under.arrange-bounds(Rect(10, 10, 40, 40))
over-box.arrange-bounds(Rect(20, 20, 40, 40))
shadow.arrange-bounds(Rect(0, 0, 0, 0))
shadow-child.arrange-bounds(Rect(62, 10, 20, 20))
overflow-parent.arrange-bounds(Rect(10, 65, 10, 10))
overflow-child.arrange-bounds(Rect(30, 65, 15, 15))
hidden.arrange-bounds(Rect(20, 20, 40, 40))
invisible.arrange-bounds(Rect(20, 20, 40, 40))

. overlap-hit = pointer-box-name(window.hit-test(Point(25, 25)))
t.expect("later painted overlapping sibling wins", "over", overlap-hit)
. shadow-hit = pointer-box-name(window.hit-test(Point(65, 15)))
t.expect("markup shadow does not replace its material child", "shadow-child", shadow-hit)
. overflow-hit = pointer-box-name(window.hit-test(Point(35, 70)))
t.expect("visible overflow is hit outside parent bounds", "overflow-child", overflow-hit)

. indexed-root = IndexedHitFixtureRoot()
markup-mount-root(indexed-root, indexed-root)
indexed-root.markup-batch-queue.checkpoint()
indexed-root.layout(Rect(0, 0, 120, 30))
expect-indexed-hit(t, indexed-root, 0, 15, 1, "unscrolled middle row")
expect-indexed-hit(t, indexed-root, 20, 25, 4, "short scroll last visible row")
expect-indexed-hit(t, indexed-root, 70, 5, 7, "end scroll first row")
indexed-root.scroll-to(Point(0, 70))
. endpoint-path = indexed-root.hit-path(Point(5, 30))!
. endpoint-row = indexed-root.rendered-children[9]
t.check
    - "indexed flow preserves the inclusive final child boundary"
    - endpoint-path.target as Pointer == endpoint-row as Pointer
t.expect("final boundary target-local point", Point(5, 10), endpoint-path.frames[0].point)

. indexed-overflow-root = IndexedOverflowFixtureRoot()
markup-mount-root(indexed-overflow-root, indexed-overflow-root)
indexed-overflow-root.markup-batch-queue.checkpoint()
indexed-overflow-root.layout(Rect(0, 0, 100, 20))
. overflow-host = indexed-overflow-root.rendered-children[0] as IndexedOverflowHost
. indexed-overflow-child = overflow-host.rendered-children[0] as IndexedOverflowChild
. indexed-overflow-path = indexed-overflow-root.hit-path(Point(55, 5))!
t.check
    - "indexed flow retains an escaping descendant as the hit target"
    - indexed-overflow-path.target as Pointer == indexed-overflow-child as Pointer

window.dispatch-pointer-event(PointerDownEvent(PointerEventData(Point(65, 15))))
t.expect
    - "markup shadow is absent from the routed ancestry"
    - "shadow-child:down:3:5,window:down:65:15"
    - ",".join(trace)
window.close()
= t

━━━━━━━━━━━━━━━━━━━━
+ do expect-indexed-hit
    - t TestCase
    - root IndexedHitFixtureRoot
    - scroll-y Length
    - point-y Length
    - expected-index Size
    - name String

root.scroll-to(Point(0, scroll-y))
. expected = root.rendered-children[expected-index] as IndexedHitRow
. point = Point(5, point-y)
. path = root.hit-path(point)!
t.check("$name targets the ordered flow child", path.target as Pointer == expected as Pointer)
t.expect("$name route frame count", 2, path.frames.length)
t.check
    - "$name route order"
    - path.frames[0].owner == expected as Pointer && path.frames[1].owner == root as Pointer
t.expect("$name target-local point", Point(5, 5), path.frames[0].point)
t.expect("$name root-local point", point, path.frames[1].point)

━━━━━━━━━━━━━━━━━━━━
+ do gui-pointer-routing-tests
    - t TestCase

. trace [String]
. window = PointerTestWindow(trace)
window.size = Dimensions(100, 100)
. parent = PointerProbeBox("parent", trace)
. leaf = PointerProbeBox("leaf", trace)
markup-append(window, parent)
markup-append(parent, leaf)
window.open()
parent.arrange-bounds(Rect(10, 10, 70, 70))
leaf.arrange-bounds(Rect(20, 25, 20, 20))

window.dispatch-pointer-event(PointerDownEvent(PointerEventData(Point(25, 30))))
t.expect
    - "target bubbles with route-local coordinates"
    - "leaf:down:5:5,parent:down:15:20,window:down:25:30"
    - ",".join(trace)
window.close()

. canceled-window = PointerTestWindow(trace)
canceled-window.size = Dimensions(100, 100)
. canceled-parent = PointerProbeBox("parent", trace)
. canceled-leaf = PointerProbeBox("leaf", trace)
canceled-leaf.cancel-down = true
markup-append(canceled-window, canceled-parent)
markup-append(canceled-parent, canceled-leaf)
canceled-window.open()
canceled-parent.arrange-bounds(Rect(10, 10, 70, 70))
canceled-leaf.arrange-bounds(Rect(20, 25, 20, 20))
canceled-window.dispatch-pointer-event(PointerDownEvent(PointerEventData(Point(25, 30))))
t.check("down cancellation blocks press and capture", !canceled-leaf.is-pressed)
canceled-window.close()

. canceled-up-window = PointerTestWindow(trace)
canceled-up-window.size = Dimensions(100, 100)
. canceled-up-leaf = PointerProbeBox("leaf", trace)
canceled-up-leaf.cancel-up = true
markup-append(canceled-up-window, canceled-up-leaf)
canceled-up-window.open()
canceled-up-leaf.arrange-bounds(Rect(10, 10, 40, 40))
canceled-up-window.dispatch-pointer-event(PointerDownEvent(PointerEventData(Point(20, 20))))
canceled-up-window.dispatch-pointer-event(PointerUpEvent(PointerEventData(Point(20, 20))))
t.check("up cancellation still clears pressed state", !canceled-up-leaf.is-pressed)
canceled-up-window.close()

trace.clear()
. mutation-window = PointerTestWindow(trace)
mutation-window.size = Dimensions(100, 100)
. removed-parent = PointerProbeBox("parent", trace)
. mutation-leaf = PointerProbeBox("leaf", trace)
mutation-leaf.remove-on-down = removed-parent
markup-append(mutation-window, removed-parent)
markup-append(removed-parent, mutation-leaf)
mutation-window.open()
removed-parent.arrange-bounds(Rect(10, 10, 70, 70))
mutation-leaf.arrange-bounds(Rect(20, 25, 20, 20))
mutation-window.dispatch-pointer-event(PointerDownEvent(PointerEventData(Point(25, 30))))
t.expect
    - "reparented route owner is skipped while Window still receives the event"
    - "leaf:down:5:5,window:down:25:30"
    - ",".join(trace)
t.check("mutated route cannot become capture", !mutation-leaf.is-pressed)
mutation-window.close()

trace.clear()
. closing-window = PointerTestWindow(trace)
closing-window.size = Dimensions(100, 100)
. closing-leaf = PointerProbeBox("leaf", trace)
closing-leaf.close-on-down = closing-window
markup-append(closing-window, closing-leaf)
closing-window.open()
closing-leaf.arrange-bounds(Rect(10, 10, 40, 40))
closing-window.dispatch-pointer-event(PointerDownEvent(PointerEventData(Point(20, 20))))
t.expect
    - "closing during a handler ends routing safely"
    - "leaf:down:10:10"
    - ",".join(trace)
= t

━━━━━━━━━━━━━━━━━━━━
+ do gui-pointer-state-tests
    - t TestCase

. trace [String]
. window = PointerTestWindow(trace)
window.size = Dimensions(100, 100)
. left = PointerProbeBox("left", trace)
. right = PointerProbeBox("right", trace)
markup-append(window, left)
markup-append(window, right)
window.open()
left.arrange-bounds(Rect(5, 10, 35, 35))
right.arrange-bounds(Rect(55, 10, 35, 35))

window.dispatch-pointer-event(PointerDownEvent(PointerEventData(Point(15, 20), 7)))
window.dispatch-pointer-event(PointerUpEvent(PointerEventData(Point(15, 20), 7)))

window.dispatch-pointer-event(PointerDownEvent(PointerEventData(Point(15, 20), 9)))
window.dispatch-pointer-event(PointerUpEvent(PointerEventData(Point(65, 20), 9)))
t.expect("release over another target does not click", 1, left.click-events)
t.check("non-clicking release still clears capture", !left.is-pressed)

window.dispatch-pointer-event(PointerDownEvent(PointerEventData(Point(15, 20), 11)))
window.dispatch-pointer-event(PointerUpEvent(PointerEventData(Point(15, 20), 12)))
t.check("nonmatching pointer release preserves capture", left.is-pressed)
window.dispatch-window-deactivated()
t.check("window deactivation clears capture", !left.is-pressed)

window.dispatch-pointer-event(PointerMoveEvent(PointerEventData(Point(15, 20))))
window.dispatch-pointer-event(PointerDownEvent(PointerEventData(Point(15, 20), 14)))
markup-remove(window, left)
window.dispatch-pointer-event
    - PointerDragEvent(PointerEventData(Point(65, 20), 14), PointerButton.primary, Point(50, 0))
t.check
    - "target removal clears hover and press before later drag"
    - !left.is-hovered && !left.is-pressed
window.close()
= t

━━━━━━━━━━━━━━━━━━━━
+ do gui-pointer-scroll-tests
    - t TestCase

. trace [String]
. window = PointerTestWindow(trace)
window.size = Dimensions(100, 100)
. left = PointerProbeBox("left", trace)
. right = PointerProbeBox("right", trace)
markup-append(window, left)
markup-append(window, right)
window.open()
left.arrange-bounds(Rect(5, 10, 35, 35))
right.arrange-bounds(Rect(55, 10, 35, 35))

window.dispatch-pointer-event(PointerDownEvent(PointerEventData(Point(15, 20))))
window.dispatch-pointer-event
    - ScrollEvent(PointerEventData(Point(65, 20)), 2.5, -4.5, true, ScrollPhase.changed)
t.expect("scroll retargets under current pointer during capture", 0, left.scroll-count)
t.expect("current scroll target receives event", 1, right.scroll-count)
t.check("scroll does not disturb pointer capture", left.is-pressed)

window.dispatch-pointer-event(PointerUpEvent(PointerEventData(Point(15, 20))))
window.close()
= t

━━━━━━━━━━━━━━━━━━━━
+ pointer-box-name
    - box Box?

match box
    |= null
        "null"
    | probe PointerProbeBox
        probe.name
    ??
        "other"

