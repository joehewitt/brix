━━━━━━━━━━━━━━━━━━━━
+ GUIPopupStyle is Style

+ placement Placement? = null
+ modal = false
+ pointer-transparent = false
+ popup-stacking PopupStacking = PopupStacking.auto
+ popup-focus PopupFocus = PopupFocus.none
+ outside-press-dismiss = true
+ outside-press-passes = true
+ escape-dismiss = true
+ focus-loss-dismiss = false
+ deactivate-dismiss = true
+ anchor-hidden-dismiss = true
+ hover-trigger = false
+ hover-delay Seconds = 0.6s
+ hover-linger Seconds = 0.12s
+ hover-warmth Seconds = 0.5s
+ context-trigger = false

. placement -> layout
. modal -> layout
. pointer-transparent -> paint

━━━━━━━━━━━━━━━━━━━━
• GUIPopupShorthands
    using GUIPopupStyle

• below:gap Length = 4
    placement = AnchoredPlacement(Side.bottom, AnchorPoint.start, gap)

• below-matched:gap Length = 4
    placement = AnchoredPlacement(Side.bottom, AnchorPoint.start, gap, 0, true)

• below-center:gap Length = 4
    placement = AnchoredPlacement(Side.bottom, AnchorPoint.center, gap)

• below-end:gap Length = 4
    placement = AnchoredPlacement(Side.bottom, AnchorPoint.end, gap)

• above:gap Length = 4
    placement = AnchoredPlacement(Side.top, AnchorPoint.start, gap)

• above-center:gap Length = 4
    placement = AnchoredPlacement(Side.top, AnchorPoint.center, gap)

• beside:gap Length = 0
    placement = AnchoredPlacement(Side.right, AnchorPoint.start, gap)

• beside-center:gap Length = 8
    placement = AnchoredPlacement(Side.right, AnchorPoint.center, gap)

• at-pointer
    placement = PointPlacement()

• follow-pointer
    placement = PointPlacement(Point(14, 18), true)

• cover-anchor
    placement = CoverPlacement()

• centered:top Length? = null
    placement = CenteredPlacement(top)

• fill-window
    placement = FillPlacement()

• corner:corner Corner = Corner.bottom-right
    placement = CornerPlacement(corner)

• modal
    modal = true
    popup-focus = PopupFocus.first
    outside-press-dismiss = false

• passive
    pointer-transparent = true
    popup-stacking = PopupStacking.hint

• transient
    popup-focus = PopupFocus.first

• persistent
    popup-stacking = PopupStacking.manual
    outside-press-dismiss = false
    escape-dismiss = false
    deactivate-dismiss = false
    anchor-hidden-dismiss = false

━━━━━━━━━━━━━━━━━━━━
+ Popup is Box
    using GUIPopupStyle
    using GUIPopupShorthands

+ anchor = PopupAnchor.owner
+ placed-side Side?
+ arrow-offset Length
+ open-point Point
+ opened-by-press = false
+ holds-popup = false
+ anchor-origin = Point(0.5, 0.5)
+ is-presentation-layer => true
+ painted-shadow => null
+ presentation-native-host => presentation?.host
+ presentation-origin => popup-presentation-frame(this).top-left

+ event opened Popup
+ event dismissed DismissReason

_ presentation PopupPresentation?
_ presenter Window?
_ return-focus Box?
_ toggled-by-press = false
_ event showing Bool
_ event dismissing DismissReason

────────────────────
~> is-closed
    then is-open on showing

~> is-open
    do
        invalidate-layout()
        invalidate-paint()
        opened-by-press = false
        presenter = host-window
        presenter?.present-popup(this)
        begin-entering()
        opened <- this

    then is-closed for reason on dismissing
        do
            invalidate-layout()
            invalidate-paint()
            (host-window ?? presenter)?.withdraw-popup(this, reason)
            presenter = null
            release-presentation()
            dismissed <- reason

────────────────────
+ get parent-popup

ancestor'Popup()

────────────────────
+ get anchor-box Box?

match? anchor
    | PopupAnchor.owner
        layout-parent
    | PopupAnchor.box(box)
        box

────────────────────
+ get placement-focus Rect?

null

────────────────────
+ get default-placement Placement

AnchoredPlacement()

────────────────────
+ do show
    - at PopupAnchor? = null

if at
    anchor = at
. host = host-window
if host
    open-point = host.pointer-location
if is-leaving
    end-departure()
    is-leaving = false
    gui-style-motion.release-held(this)
showing <- true

────────────────────
+ do show-at
    - point Point

show(PopupAnchor.point(point))

────────────────────
+ do dismiss
    - reason = DismissReason.programmatic

=? if is-leaving
if is-open && frame-clock && (leaves-with-motion() || markup-holds-departures(this))
    is-leaving = true
    watch-leaving(=> do finish-dismissing(reason))
    =
dismissing <- reason

────────────────────
_ do finish-dismissing
    - reason DismissReason

end-departure()
dismissing <- reason
is-leaving = false
gui-style-motion.forget(this)

────────────────────
+ do toggle

if is-open
    dismiss()
else
    show()

────────────────────
+ do toggle-on-press
    - event PointerDownEvent

=? if event.button != PointerButton.primary
toggled-by-press = true
toggle()

────────────────────
+ do toggle-on-click
    - event ClickEvent

if toggled-by-press
    toggled-by-press = false
else
    toggle()
event.cancel()

────────────────────
+ anchor-rect Rect
    - host Window

match anchor
    | PopupAnchor.owner
        presented-bounds-of(layout-parent) ?? host.bounds
    | PopupAnchor.box(box)
        presented-bounds-of(box) ?? host.bounds
    | PopupAnchor.rect(rect)
        rect
    | PopupAnchor.point(point)
        Rect(point.x, point.y, 0, 0)
    | PopupAnchor.pointer
        Rect(open-point.x, open-point.y, 0, 0)
    ??
        host.bounds

────────────────────
+ get host-window Window?

host as Window if host

.. host = window

────────────────────
+ get is-anchor-visible

|? !box
    true
??
    box.is-input-visible && box.is-presentation-visible(box.bounds)

.. box = anchor-box

────────────────────
+ do accept-placement
    - result PlacementResult
    - anchor-rect Rect

if placed-side != result.side
    placed-side = result.side
if arrow-offset != result.arrow-offset
    arrow-offset = result.arrow-offset
. placed = result.bounds
. x = if placed.width > 0 then min(max(x-fraction, 0.0), 1.0) else 0.5
    .. x-fraction = (anchor-rect.x + anchor-rect.width / 2 - placed.x) / placed.width
. y = if placed.height > 0 then min(max(y-fraction, 0.0), 1.0) else 0.5
    .. y-fraction = (anchor-rect.y + anchor-rect.height / 2 - placed.y) / placed.height
. side = result.side
. origin = Point(x, y)
if side == Side.bottom
    origin = Point(x, 0)
else if side == Side.top
    origin = Point(x, 1)
else if side == Side.right
    origin = Point(0, y)
else if side == Side.left
    origin = Point(1, y)
if anchor-origin != origin
    anchor-origin = origin

────────────────────
+ do remember-return-focus
    - box Box?

return-focus = box

────────────────────
+ do remember-return-focus-if-empty
    - box Box?

if !return-focus
    return-focus = box

────────────────────
+ do take-return-focus Box?

. box = return-focus
return-focus = null
= box

────────────────────
+ do render-presentation LiveFillState
    - window-native Pointer
    - display-scale F64
    - zoom F64
    - color-space Pointer
    - use-metal Bool
    - live-time F64
    - adds-live-damage Bool

if !presentation
    presentation = PopupPresentation(window-native)
= presentation!.render
    - this
    - display-scale
    - zoom
    - color-space
    - use-metal
    - live-time
    - adds-live-damage

────────────────────
+ do ensure-presentation
    - window-native Pointer

if !presentation
    presentation = PopupPresentation(window-native)

────────────────────
+ do release-presentation

presentation?.close()
presentation = null

────────────────────
+ get is-displayed

is-open && $display != Display.hidden

────────────────────
+ get callout-side

placed-side?.opposite

────────────────────
+ get callout-offset

arrow-offset if placed-side

────────────────────
+ get is-display-visible

is-open && $display == Display.visible

────────────────────
+ do mounted

super.mounted()
set-theme-tag("glass", false)
if is-open
    presenter = host-window
    presenter?.present-popup(this)

────────────────────
+ do unmounted

(host-window ?? presenter)?.withdraw-popup(this)
presenter = null
release-presentation()
super.unmounted()

━━━━━━━━━━━━━━━━━━━━
+ presented-bounds-of Rect?
    - box Box?

box.presentation-rect(box.bounds) if box

━━━━━━━━━━━━━━━━━━━━
+ popup-presentation-frame Rect
    - popup Box

popup.ink-frame

━━━━━━━━━━━━━━━━━━━━
+ PopupPresentation

+ native Pointer
+ host Pointer?
+ scene DisplayScene?
+ surface RasterCanvas?
+ renderer MetalOffscreenRenderer?
+ surface-extent Dimensions
+ surface-scale F64
+ surface-color-space Pointer
+ origin Point
+ is-shown = false
_ live-fills = LiveFillState(false, null, null)

────────────────────
+ This
    - window-native Pointer

native = C:brixGuiPopupCreate(window-native)
host = C:brixGuiPopupGetHost(native)

────────────────────
+ get is-metal

renderer != null

────────────────────
+ do render LiveFillState
    - popup Popup
    - display-scale F64
    - zoom F64
    - color-space Pointer
    - use-metal Bool
    - live-time F64
    - adds-live-damage Bool

=? LiveFillState(false, null, null) if native == Pointer()
. frame = popup-presentation-frame(popup)
. size = Dimensions(max(1, ceil(frame.width * zoom)), max(1, ceil(frame.height * zoom)))
. extent = Dimensions(size.width / zoom, size.height / zoom)
. scale = display-scale * zoom
if !use-metal && renderer
    release-metal()
. rendered-metal = use-metal && render-metal(popup, frame, extent, scale, live-time, adds-live-damage)
. committed = rendered-metal || render-canvas(popup, frame, extent, scale, color-space, live-time, adds-live-damage)
C:brixGuiPopupSetFrame(native, frame.x * zoom, frame.y * zoom, size.width, size.height)
C:brixGuiPopupSetShadow(native, popup.$shadow != null)
C:brixGuiPopupSetPassesPointer(native, popup.$pointer-transparent)
if committed && !rendered-metal
    C:brixGuiPopupCommitFrame(native, surface!.native)
if !is-shown
    is-shown = true
    C:brixGuiPopupSetShown(native, true)
= live-fills

────────────────────
_ do render-metal Bool
    - popup Popup
    - frame Rect
    - extent Dimensions
    - scale F64
    - live-time F64
    - adds-live-damage Bool

. reset = false
if renderer
    . current = renderer
    . same-size = current.width == extent.width && current.height == extent.height
    if !same-size || current.scale != scale
        if current.resize(extent.width, extent.height, scale, transparent)
            reset = true
        else
            release-metal()
if !renderer
    surface?.close()
    surface = null
    scene?.close()
    scene = null
    . candidate = MetalOffscreenRenderer(extent.width, extent.height, scale, transparent, true)
    if !candidate.is-available || !candidate.attach-popup(native)
        candidate.close()
        = false
    renderer = candidate
    reset = true
. active = renderer!
if !scene
    scene = DisplayScene(scale, transparent, active)
    reset = true
. live-scene = scene!
. fill-redraw = active.take-fill-redraw()
maintain-scene(live-scene, popup, frame, scale, reset || fill-redraw, live-time, adds-live-damage)
active.set-fill-time(live-time)
. encoded = live-scene.frame-metal(active)
if !encoded && live-scene.has-damage
    release-metal()
    = false
= true

────────────────────
_ do render-canvas Bool
    - popup Popup
    - frame Rect
    - extent Dimensions
    - scale F64
    - color-space Pointer
    - live-time F64
    - adds-live-damage Bool

. recreated = false
if !surface || surface-extent != extent || surface-scale != scale || space-changed
    surface?.close()
    surface = RasterCanvas(extent, scale, transparent, color-space)
    surface-extent = extent
    surface-scale = scale
    surface-color-space = color-space
    recreated = true
.. space-changed = surface-color-space != color-space
if !scene
    scene = DisplayScene(scale, transparent)
. live-scene = scene!
maintain-scene(live-scene, popup, frame, scale, recreated, live-time, adds-live-damage)
. replayed = live-scene.frames-replayed
live-scene.frame(surface!)
= live-scene.frames-replayed != replayed

────────────────────
_ do maintain-scene
    - live-scene DisplayScene
    - popup Popup
    - frame Rect
    - scale F64
    - is-reset Bool
    - live-time F64
    - adds-live-damage Bool

live-scene.set-live-time(live-time)
live-scene.origin = frame.top-left
live-scene.maintain(popup, scale, transparent)
if is-reset || origin != frame.top-left
    live-scene.add-damage(frame)
origin = frame.top-left
live-fills = live-scene.damage-live-chunks(frame, adds-live-damage)

────────────────────
_ do release-metal

scene?.close()
scene = null
if renderer
    renderer.detach-window(native)
    renderer!.close()
    renderer = null

────────────────────
+ do close

release-metal()
scene?.close()
scene = null
surface?.close()
surface = null
if native != Pointer()
    C:brixGuiPopupRelease(native)
    native = Pointer()
    host = null
