(import ./box)
(import ./placement)
(import ./popup)
(import ./primitives)
(import ./shape)
(import ./shorthands)
(import ./styles)
(import ./theme)
(import /graphics/color)
(import /graphics/outline)
(import /graphics/primitives)

(style-extend GUIDefaultTheme
  (using GUIBoxPaint)
  (using GUITextPaint)
  (using GUIBoxSpacing)
  (using GUIPopupStyle)
  (rule Popover (• bg gui-popup-color) (• text gui-text-color) (• p 14)
    (= border-color gui-border-color)
    (= border-width 1)
    (= corner-radius gui-popup-radius)
    (= shape (call CalloutShape 9))
    (= shadow gui-popup-shadow)
  )
)

(type + Popover (is Popup)
  (rule This (• transient) (• flex-col) (• below-center 1))
)
