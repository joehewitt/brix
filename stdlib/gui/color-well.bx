(import ./box)
(import ./color-picker)
(import ./events)
(import ./icons/lucide/minus)
(import ./popover)
(import ./popup)
(import ./position)
(import ./primitives)
(import ./shorthands)
(import ./styles)
(import ./theme)
(import /graphics/color)
(import /graphics/primitives)
(import /graphics/style)
(import /ui/value-change-phase)

(style-extend GUIDefaultTheme
  (using GUIBoxCursor)
  (using GUIBoxDisplay)
  (using GUIBoxMotion)
  (using GUIBoxPaint)
  (using GUIBoxSize)
  (using GUIBoxSpacing)
  (using GUIFocusRingStyle)
  (using GUITextPaint)
  (using VectorPaintStyle)
  (rule ColorWell (• w 16) (• h 16)
    (= border-color gui-border-color)
    (= border-width 1)
    (= corner-radius gui-control-radius)
    (= cursor (. CursorStyle pointing-hand))
    (blank)
    (rule color-well-mark
      (= display (. Display hidden))
    )
    (blank)
    (when-style #is-open
      (= border-color gui-accent-bright-color)
    )
    (blank)
    (when-style #is-mixed
      (rule color-well-mark
        (= display (. Display visible))
      )
    )
    (blank)
    (when-style (not #is-effectively-enabled)
      (= cursor (. CursorStyle arrow))
    )
    (blank)
    (when-style #is-focus-visible
      (= focus-ring gui-focus-ring)
      (= (. motion focus-ring) gui-motion-quick)
    )
    (blank)
    (rule color-well-mark (• text gui-muted-text-color) (• w 10) (• h 10) (• mx 3)
      (= stroke-width 2)
    )
  )
)

(type + ColorWell (is Box)
  (rule This
    (= focus-mode (. FocusMode press))
    (= window-draggable false)
  )
  (blank)
  (prop + color _ (= (call RGBA 0 0 0)))
  (prop + is-mixed _ (= false))
  (prop + is-open _ (= (. popover #is-open)))
  (event + value-changing (of ValueChange RGBA))
  (event + value-changed (of ValueChange RGBA))
  (content
    (<> This (• flex-row)
      (= background (call ColorSwatchPainter (call color-well-swatch #color #is-mixed)))
      (<> LucideMinus (• icon) (• color-well-mark)
        (= align-y (. Alignment center))
      )
      (<> Popover (id: popover)
        (<> ColorPicker (id: picker)
          (= color #color)
          (for (on event value-changed)
            (call accept-color (. event value) (. event phase))
          )
        )
      )
    )
  )
  (subscribe-for (on event pointer-down)
    (if is-effectively-enabled
      (call (. popover toggle-on-press) event)
    )
  )
  (subscribe-for (on event click)
    (if is-effectively-enabled
      (call (. popover toggle-on-click) event)
    )
    (call (. event cancel))
  )
  (fn-do + accept-color _
    (param next RGBA)
    (param phase ValueChangePhase (= (. ValueChangePhase discrete)))
    (return-if (if (not is-effectively-enabled)))
    (let change (call (of ValueChange RGBA) color next phase))
    (<- value-changing change)
    (return-if (if (. change is-canceled)))
    (= color next)
    (= is-mixed false)
    (<- value-changed (call (of ValueChange RGBA) (. change old-value) next phase))
  )
)

(fn-expr + color-well-swatch RGBA
  (param color RGBA)
  (param is-mixed Bool)
  (if-expr is-mixed transparent color)
)
