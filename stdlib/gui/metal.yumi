. scales = filter.image-scales
. keeps = List'F64()
for keep in filter.keeps
    keeps ++= [keep.x, keep.y, keep.width, keep.height]
C:brixGuiMetalPacketPushFilterLayer
    - renderer
    - rect.x
    - rect.y
    - rect.width
    - rect.height
    - filter.shader.id
    - filter.args.buffer-pointer
    - filter.args.length
    - natives.buffer-pointer
    - scales.buffer-pointer
    - natives.length
    - filter.time
    - opacity
    - filter.resolution.x
    - filter.resolution.y
    - keeps.buffer-pointer
    - filter.keeps.length

