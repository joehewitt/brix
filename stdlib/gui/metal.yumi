━━━━━━━━━━━━━━━━━━━━
+ MetalOffscreenRenderer
    is Closable
    is DisplayGlyphRegistrar

+ width Length
+ height Length
+ scale F64
+ background RGBA

_ renderer Pointer
_ is-closed = false
_ path-capture MetalPathCapture?

────────────────────
+ This
    - render-width Length
    - render-height Length
    - render-scale F64 = 1
    - clear-background RGBA = transparent
    - allow-failure = false

width = render-width
height = render-height
scale = render-scale
background = clear-background
renderer = C:brixGuiMetalRendererCreate
    - width
    - height
    - scale
    - background.red
    - background.green
    - background.blue
    - background.alpha
?! Panic("Unable to create the offscreen Metal renderer")
    if !renderer && !allow-failure

────────────────────
+ do close

if !is-closed
    if renderer
        C:brixGuiMetalRendererRelease(renderer)
        renderer = Pointer()
    is-closed = true

────────────────────
+ do register-display-glyph
    - layout TextLayout

=? null if !layout.native
. packed = C:brixGuiMetalRunRegister(renderer, layout.native)
=? null if packed < 0
. bits = packed as U64
= DisplayGlyphHandle
    - (bits /and/ 4294967295) as U32
    - (bits /rshift/ 32) as U32

────────────────────
+ do release-display-glyph
    - handle DisplayGlyphHandle

C:brixGuiMetalRunRelease(renderer, handle.index, handle.generation)

────────────────────
+ do register-display-image
    - table VectorGeometryTable
    - handle ImageHandle
    - destination Rect

. pixel-width = round(destination.width * scale) as I32
. pixel-height = round(destination.height * scale) as I32
=? false if pixel-width <= 0 || pixel-height <= 0
. resource = table.resolve-image(handle)
=? false if !resource
. found = C:brixGuiMetalImageLookup
    - renderer
    - handle.index
    - handle.generation
    - pixel-width
    - pixel-height
    - resource.template-alpha
=? true if found
. image = C:brixGuiMetalCanvasCreateCGImage(resource.native)
= C:brixGuiMetalImageUpsert
    - renderer
    - handle.index
    - handle.generation
    - pixel-width
    - pixel-height
    - resource.template-alpha
    - image

