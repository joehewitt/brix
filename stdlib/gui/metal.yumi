────────────────────
_ do register-display-path
    - handle VectorGeometryHandle
    - geometry VectorGeometry

. capture = path-capture ?? MetalPathCapture(renderer)
path-capture = capture
C:brixGuiMetalPathBegin(renderer, handle.index, handle.generation)
. captured [Path]
for span in geometry.spans
    . path-index U32 = captured.length as U32
    for index in 0 .. < captured.length
        if captured[index] as Pointer == span.path as Pointer
            path-index = index as U32
    if path-index == captured.length as U32
        span.path.outline(capture)
        path-index = C:brixGuiMetalPathEndPath(renderer)
        captured += span.path
    . fill-role U8 = match span.fill.role
        |= .inherit
            0
        |= .inherited-stroke
            1
        |= .none
            2
        ??
            3
    . stroke-role U8 = match span.stroke.role
        |= .inherit
            0
        |= .none
            2
        ??
            3
    . rule U8 = if span.fill-rule == FillRule.nonzero then 0 else 1
    . width = span.stroke-width ?? -1
    . cap U8 = if span.stroke-cap then cap-code else metal-stroke-inherit
        .. cap-code = line-cap-code(span.stroke-cap) as U8
    . join U8 = if span.stroke-join then join-code else metal-stroke-inherit
        .. join-code = line-join-code(span.stroke-join) as U8
    . alignment U8 = match span.stroke-alignment
        |= .inside
            1
        |= .outside
            2
        ??
            0
    C:brixGuiMetalPathAddSpan
        - renderer
        - path-index
        - fill-role
        - span.fill.index
        - rule
        - stroke-role
        - span.stroke.index
        - width
        - cap
        - join
        - alignment
= C:brixGuiMetalPathEnd(renderer)

