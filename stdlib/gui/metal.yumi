_ MetalStat is I32

| encode-nanos = 0
| walk-nanos = 1
| gpu-nanos = 2
| draw-calls = 3
| pipeline-switches = 4
| packet-bytes = 5
| skipped-ops = 6
| renderer-allocations = 7
| instances = 8
| commits = 9
| presents = 10
| packet-capacity = 11
| glyph-atlas-bytes = 12
| glyph-atlas-uploads = 13
| glyph-atlas-upload-bytes = 14
| glyph-atlas-evictions = 15
| image-atlas-bytes = 16
| run-count = 17
| fallback-runs = 18
| image-atlas-evictions = 19
| drawable-wait-nanos = 20
| maximum-frames-per-second = 21
| fill-draws = 22
| fill-segments = 23
| fill-tiles = 24
| fill-pieces = 25
| fill-lines = 26
| fill-opaque-tiles = 27
| fill-overflows = 28
| fill-redraw-pending = 29
| fill-frames-pending = 30
| layer-passes = 31
| coverage-clips = 32
| image-texture-bytes = 33
| image-texture-evictions = 34
| image-texture-upload-bytes = 35
| image-tile-source-bytes = 36
| image-tile-count = 37
| tile-gpu-nanos = 38
| tiles-rendered = 39

