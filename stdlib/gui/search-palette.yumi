• This
    focus-mode = FocusMode.inside

+ prompt = ""
+ empty-text = ""
+ notice = ""
+ query = ""
+ results [Item] = List'Item()
+ source PaletteSource'Item?
+ key-builder MarkupKeyBuilder'Item?
+ takes-keys [Key] = [Key.arrow-up, Key.arrow-down]
+ selected-index Size = 0
+ selected-item Item? = palette-item-at'Item(#results, #selected-index)
