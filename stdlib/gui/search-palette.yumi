╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do reset

rewrite("")
applied-query = null
apply-query()

────────────────────
+ do rewrite
    - text String

if search-input.text != text
    search-input.replace-text(text)
    search-input.select-range(text.length, text.length)
if query != text
    query = text

────────────────────
+ do refresh

. provider = source
if provider
    results = provider(query)

────────────────────
+ do move-selection
    - offset Int

. count = results.length
=? if count == 0
. next = (selected-index as Int) + offset
next = max(0, (min(next, (count as Int) - 1)))
select(next)

────────────────────
+ do move-selection-page
    - direction Int

move-selection(direction * page-row-count)

────────────────────
+ do select-first

select(0)

────────────────────
+ do select-last

. count = results.length
if count > 0
    select(count - 1)

────────────────────
+ do select
    - index Size

=? if index >= results.length
selected-index = index
selected-key = key-of(results[index])
follows-selection = true
reveal-selection()

────────────────────
+ do select-key
    - key String

selected-key = key
follows-selection = true
. index = index-of-key(key)
if index != null
    selected-index = index
    reveal-selection()

────────────────────
+ do choose-selected

. index = selected-index
=? if index >= results.length
choose(results[index])

────────────────────
+ do choose
    - item Item

dismiss(DismissReason.chosen)
chosen <- item

────────────────────
+ do row-at-index PaletteRow'Item?
    - index Size

=? if !is-live
for position in 0 .. < rows.pool-size
    . root = rows.root-at(position)
    if root && root.slot.is-bound && root.slot.address == (index as I64)
        = match? root.%first-child
            | row PaletteRow'Item
                row
= null

────────────────────
_ get page-row-count Int

|? count < 1
    1
??
    count

.. count = floor(rows.content-bounds.height / rows.row-extent) as Int

────────────────────
_ do apply-query

=? if applied-query == query
applied-query = query
notice = ""
selected-index = 0
selected-key = null
follows-selection = false
if is-live
    . ignored = rows.scroll-to(Point(0, 0))
refresh()

────────────────────
_ do show-results

result-source.replace(results)
. count = results.length
. index = selected-index
if follows-selection && selected-key
    index = index-of-key(selected-key) ?? index
if count == 0
    index = 0
else if index >= count
    index = count - 1
if selected-index != index
    selected-index = index
selected-key = key-of(results[index]) if index < count
if follows-selection
    reveal-selection()

────────────────────
_ index-of-key Size?
    - key String

first(each in 0 .. < results.length when key-of(results[each]) == key)

────────────────────
_ key-of String?
    - item Item

builder(item) if builder

.. builder = key-builder

────────────────────
_ do reveal-selection

=? if !is-live
. ignored = rows.scroll-to-address(selected-index, ScrollAlignment.nearest)

