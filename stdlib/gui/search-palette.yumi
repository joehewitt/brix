────────────────────

<This • flex-col modal
    outside-press-dismiss = true
    outside-press-passes = false

    <Box • palette-field flex-row
        + <Box leading • flex-row
        <TextInput search-input • flex:1
            is-bare = true
            placeholder = #prompt
            passes-keys = #takes-keys
        + <Box trailing • flex-row

    if #results.length == 0 && #empty-text
        <Label • palette-empty
            text = #empty-text
            align-y = Alignment.center

    <VirtualRegion'Item rows • flex:1
        source = result-source
        virtual-layout = VerticalRowLayout()
        overscan-rows = palette-overscan-rows

        <PaletteRow'Item palette-row(row) - slot
            palette = this
            item = slot.#item
            index = slot.#address as Size

            + <Box row - palette-row PaletteRow'Item • flex-row flex:1

    if #notice
        <Label • palette-notice
            text = #notice
            align-y = Alignment.center

    <KeyShortcut "Previous"
        key = .arrow-up
        discoverable = false
        allow-while-input = true
        action = => do move-selection(-1)
    <KeyShortcut "Next"
        key = .arrow-down
        discoverable = false
        allow-while-input = true
        action = => do move-selection(1)
    <KeyShortcut "First"
        key = .home
        discoverable = false
        allow-while-input = true
        action = => do select-first()
    <KeyShortcut "Last"
        key = .end
        discoverable = false
        allow-while-input = true
        action = => do select-last()
    <KeyShortcut "Page Up"
        key = .page-up
        discoverable = false
        allow-while-input = true
        action = => do move-selection-page(-1)
    <KeyShortcut "Page Down"
        key = .page-down
        discoverable = false
        allow-while-input = true
        action = => do move-selection-page(1)
    <KeyShortcut "Choose"
        key = .enter
        repeat = false
        discoverable = false
        allow-while-input = true
        action = => do choose-selected()

