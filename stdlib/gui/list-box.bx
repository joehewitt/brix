(import ./box)
(import ./button)
(import ./choice-control)
(import ./events)
(import ./keys)
(import ./label)
(import ./primitives)
(import ./shorthands)
(import ./styles)
(import ./theme)
(import /core/intrinsics)
(import /core/list-cursor)
(import /graphics/primitives)
(import /graphics/text)
(import /math)
(import /stream/aggregate)
(import /stream/combine)
(import /ui/input)
(import /ui/key-combo)
(import /ui/selection)
(import /ui/type-select)

(style-extend GUIDefaultTheme
  (using GUIBoxPaint)
  (using GUITextPaint)
  (using GUIBoxSpacing)
  (using GUIBoxSize)
  (rule ListBox
    (when-style #is-focused
      (rule ListItem
        (when-style #is-selected
          (• bg gui-accent-color)
          (• text gui-accent-text-color)
        )
      )
    )
    (blank)
    (rule list-empty (• text gui-muted-text-color) (• absolute) (• cover .parent) (• p 12)
      (= text-alignment (. TextAlignment center))
    )
  )
  (blank)
  (rule ListItem (• h 24) (• px 10)
    (when-style #is-selected
      (• bg gui-pressed-color)
      (• text gui-strong-text-color)
    )
  )
)

(type + ListBox (is Box)
  (implements Choosing)
  (rule This
    (= focus-mode (. FocusMode keys))
    (= window-draggable false)
    (= overflow-y (. ScrollOverflow auto))
  )
  (blank)
  (prop + selection-mode _ (= (. SelectionMode single)))
  (prop + selected-key (? String))
  (prop + selected-keys (list String))
  (prop + empty-text _ (= ""))
  (prop + is-empty _ (= true))
  (prop + chooses-on-press _ (= true))
  (event + selection-changing (of SelectionEvent (list String)))
  (event + selection-changed (of SelectionEvent (list String)))
  (event + item-activated ActivateEvent)
  (blank)
  (prop _ selection-anchor (? String))
  (prop _ selected-set (of Map String Bool))
  (prop _ is-selected-set-stale _ (= true))
  (prop _ pending-key (? String))
  (prop _ type-select _ (= (call TypeSelect)))
  (blank)
  (depends selected-keys-changed selected-keys)
  (content
    (<> This (• flex-col)
      (<> KeyShortcut (text: "Previous")
        (= key .arrow-up)
        (= discoverable false)
        (= action (=> () :do (call move-selection -1)))
      )
      (blank)
      (<> KeyShortcut (text: "Next")
        (= key .arrow-down)
        (= discoverable false)
        (= action (=> () :do (call move-selection 1)))
      )
      (blank)
      (<> KeyShortcut (text: "Extend up")
        (= key (+ (. KeyModifier shift) (. Key arrow-up)))
        (= discoverable false)
        (= when (=> () (== selection-mode (. SelectionMode multiple))))
        (= action (=> () :do (call move-selection -1 true)))
      )
      (blank)
      (<> KeyShortcut (text: "Extend down")
        (= key (+ (. KeyModifier shift) (. Key arrow-down)))
        (= discoverable false)
        (= when (=> () (== selection-mode (. SelectionMode multiple))))
        (= action (=> () :do (call move-selection 1 true)))
      )
      (blank)
      (<> KeyShortcut (text: "Page Up")
        (= key .page-up)
        (= discoverable false)
        (= action (=> () :do (call move-selection (- page-row-step) false true)))
      )
      (blank)
      (<> KeyShortcut (text: "Page Down")
        (= key .page-down)
        (= discoverable false)
        (= action (=> () :do (call move-selection page-row-step false true)))
      )
      (blank)
      (<> KeyShortcut (text: "First")
        (= key .home)
        (= discoverable false)
        (= action (=> () :do (call select-edge false)))
      )
      (blank)
      (<> KeyShortcut (text: "Last")
        (= key .end)
        (= discoverable false)
        (= action (=> () :do (call select-edge true)))
      )
      (blank)
      (<> KeyShortcut (text: "Select All")
        (= key (+ (. KeyModifier command) "a"))
        (= discoverable false)
        (= when (=> () (== selection-mode (. SelectionMode multiple))))
        (= action (=> () :do (call select-all)))
      )
      (blank)
      (<> KeyShortcut (text: "Activate")
        (= key .enter)
        (= repeat false)
        (= discoverable false)
        (= action (=> () :do (call commit-selection)))
      )
      (blank)
      (if (and #is-empty #empty-text)
        (<> Label (• list-empty)
          (= text #empty-text)
        )
      )
    )
  )
  (subscribe-for (on event pointer-down)
    (call press-row event)
  )
  (subscribe-for (on event click)
    (let key pending-key)
    (= pending-key null)
    (if (and key (== (call key-of-row (call row-at event)) key))
      (call press-key key (. event modifiers))
    )
  )
  (subscribe-for (on event drag-start)
    (= pending-key null)
  )
  (subscribe-for (on event key-press)
    (call type-select-key event)
  )
  (whenever-rule (trigger children ListItem)
    (call rows-changed)
  )
  (fn-expr + can-scroll _
    (param direction ScrollDirection)
    (and (not is-horizontal) (call (. super can-scroll) direction))
    (where
      (lazy is-horizontal (or (== direction (. ScrollDirection left)) (== direction (. ScrollDirection right))))
    )
  )
  (fn-do + reveal-focus _
    (if (not selected-key)
      (let order (call selection-order))
      (if (. order length)
        (= selected-key ([] order 0))
      )
    )
    (if selected-key
      (call reveal-key selected-key)
      (else
        (call (. super reveal-focus))
      )
    )
  )
  (fn-do + mounted _
    (call (. super mounted))
    (call rows-changed)
  )
  (fn-expr + first-row _ :get
    (|> (call selectable-rows) first)
  )
  (fn-expr + page-row-step Int :get
    (case? (or (<= row-height 0) (< step 1))
      1
    )
    (default
      (as step Int)
    )
    (where
      (lazy viewport (. content-bounds height))
      (lazy step (/ viewport row-height))
      (lazy row-height (?? (. (?. first-row bounds) height) 0))
    )
  )
  (fn-do + is-key-selected Bool
    (param key (? String))
    (return-if false (if (== key null)))
    (if is-selected-set-stale
      (call (. selected-set clear))
      (for (in selected selected-keys)
        (= ([] selected-set selected) true)
      )
      (= is-selected-set-stale false)
    )
    (return (has selected-set key))
  )
  (fn-do + select-key _
    (param key (? String))
    (param extends _ (= false))
    (param toggles _ (= false))
    (= pending-key null)
    (if (not key)
      (= selected-key null)
      (= selection-anchor null)
      (call change-selection (call (of List String)))
      (return)
    )
    (let anchor
      (scope (if-expr (call is-key-selected selection-anchor) kept-anchor selected-key)
        (lazy kept-anchor (?? selection-anchor selected-key))
      )
    )
    (let keys
      (call selection-after-press
        (block
          (arg selection-mode)
          (arg selected-keys)
          (arg key)
          (arg (call selection-order))
          (arg anchor)
          (arg extends)
          (arg toggles)
        )
      )
    )
    (= selection-anchor (if-expr (and extends anchor) anchor key))
    (= selected-key key)
    (call change-selection keys)
    (call reveal-key key)
  )
  (fn-do + select-all _
    (return-if (if (!= selection-mode (. SelectionMode multiple))))
    (call change-selection (call selection-order))
  )
  (fn-do + change-selection _
    (param keys (list String))
    (let old selected-keys)
    (return-if (if (== old keys)))
    (let change (call (of SelectionEvent (list String)) old keys))
    (<- selection-changing change)
    (return-if (if (. change is-canceled)))
    (= selected-keys keys)
    (<- selection-changed (call (of SelectionEvent (list String)) old keys))
  )
  (fn-do + move-selection _
    (param offset Int)
    (param extends _ (= false))
    (param clamps _ (= false))
    (let order (call selection-order))
    (let index (only-if (call (. order find) selected-key) (if selected-key)))
    (if (and (!= index null) (not (. selected-keys length)))
      (call select-key selected-key extends)
      (return)
    )
    (let cursor (call ListCursor (. order length) index))
    (let target
      (scope (if-expr clamps clamped-target (call (. cursor stepped) offset))
        (lazy clamped-target (?? (call (. cursor clamped) offset) (call (. cursor stepped) offset)))
      )
    )
    (if (!= target null)
      (call select-key ([] order target) extends)
      (else-if selected-key
        (call reveal-key selected-key)
      )
    )
  )
  (fn-do + select-edge _
    (param last Bool)
    (let order (call selection-order))
    (return-if (if (not (. order length))))
    (call select-key (if-expr last ([] order (- (. order length) 1)) ([] order 0)))
  )
  (fn-do + activate-selection _
    (call ensure-selection)
    (return-if (if (not selected-key)))
    (<- item-activated (call ActivateEvent))
  )
  (fn-do + commit-selection _
    (call activate-selection)
    (let key selected-key)
    (if key
      (call choose-key key)
    )
  )
  (fn-do + choose-key _
    (param key String)
    (return-if (if (not (call can-choose key))))
    (<- chosen (call ChooseEvent key))
  )
  (fn-expr + can-choose Bool
    (param key String)
    true
  )
  (fn-expr + press-activates Bool
    (param row ListItem)
    true
  )
  (fn-do + ensure-selection _
    (return-if (if (and selected-key (!= (call (. (call selection-order) find) (!! selected-key)) null))))
    (call select-edge false)
  )
  (fn-expr + selection-order (list String)
    (call (of List String)
      (block
        (spread (call selectable-rows))
        (pipe *> (!! (call key-of-row each)))
      )
    )
  )
  (fn-expr + title-for-key String
    (param key String)
    (?? (?. (call listed-row key) text) "")
  )
  (fn-expr + key-of-row (? String)
    (param row (? ListItem))
    (match row
      (case= null
        null
      )
      (default
        (if-expr (. row key) (. row key) (. row text))
      )
    )
  )
  (fn-do + reveal-key _
    (param key String)
    (let row (call listed-row key))
    (if row
      (call (. root ensure-visible)
        (block
          (arg row)
          (arg (. ScrollAlignment nearest))
          (arg (call Insets 0 0 0 0))
          (arg (. ScrollCause focus))
        )
      )
    )
  )
  (fn-do + rows-changed _
    (= is-empty (not first-row))
    (call show-selection)
  )
  (fn-do + show-selection _
    (for (in row (call selectable-rows))
      (let selected (call is-key-selected (call key-of-row row)))
      (if (!= (. row is-selected) selected)
        (= (. row is-selected) selected)
      )
    )
  )
  (fn-expr + row-at _
    (param event GUIEvent)
    (match (. event hit-box)
      (case= null
        null
      )
      (default
        (call valid-row (?? (of (. it ancestor-or-self) ListItem) (of (?. (. it style-target) ancestor-or-self) ListItem)))
      )
    )
  )
  (fn-expr + selectable-rows _ @inline
    (spread active-children)
    (pipe ?*> (call selectable-row each))
  )
  (fn-do + selectable-row _ @inline
    (param node Box)
    (if (is node ListItem)
      (let row (as node ListItem))
      (if (and (. row is-enabled) (. row is-display-visible))
        (return row)
      )
    )
  )
  (fn-expr + valid-row _
    (param row (? ListItem))
    (only-if (call selectable-row row) (if row))
  )
  (fn-do _ listed-row (? ListItem)
    (param key String)
    (for (in row (call selectable-rows))
      (return-if row (if (== (call key-of-row row) key)))
    )
  )
  (fn-do _ press-row _
    (param event PointerDownEvent)
    (= pending-key null)
    (let row (call row-at event))
    (return-if (if (or (not row) (!= (. event button) (. PointerButton primary)) (. event modifiers control) (call press-lands-in-control event row))))
    (let key (call key-of-row row))
    (return-if (if (not key)))
    (if (and (== (. event click-count) 2) (call press-activates row))
      (if chooses-on-press
        (call activate-selection)
        (else
          (call commit-selection)
        )
      )
    )
    (return-if (if (> (. event click-count) 1)))
    (if (call press-waits-for-release key (. event modifiers))
      (= pending-key key)
      (else
        (call press-key key (. event modifiers))
      )
    )
  )
  (fn-do _ press-key _
    (param key String)
    (param modifiers PointerModifiers)
    (call select-key key (. modifiers shift) (. modifiers command))
    (if (and chooses-on-press (not (. modifiers shift)) (not (. modifiers command)))
      (call choose-key key)
    )
  )
  (fn-expr _ press-waits-for-release Bool
    (param key String)
    (param modifiers PointerModifiers)
    (and (not (. modifiers shift)) (call is-key-selected key) (or (. modifiers command) (> (. selected-keys length) 1)))
  )
  (fn-do _ press-lands-in-control Bool
    (param event GUIEvent)
    (param row ListItem)
    (let cursor (? Box) (. event hit-box))
    (while cursor
      (let box cursor)
      (return-if false (if (or (== (as box Pointer) (as row Pointer)) (== (as box Pointer) (as this Pointer)))))
      (return-if true (if (or (is box Button) (call focus-mode-can-focus (. box $focus-mode)))))
      (= cursor (. box material-parent))
    )
    (return false)
  )
  (fn-do _ type-select-key _
    (param event KeyPressEvent)
    (let text (. event typed-text))
    (return-if (if (or (not text) (and (== text " ") (not (. type-select is-active))))))
    (let order (call selection-order))
    (let titles
      (call (of List String)
        (block
          (spread order)
          (pipe *> (call title-for-key each))
        )
      )
    )
    (let found (call (. type-select find) text titles (only-if (call (. order find) selected-key) (if selected-key))))
    (return-if (if (== found null)))
    (call select-key ([] order found))
    (call (. event cancel))
  )
  (fn-do _ selected-keys-changed _
    (= is-selected-set-stale true)
    (call show-selection)
  )
)

(type + ListItem (is Label)
  (rule This
    (= window-draggable false)
  )
  (blank)
  (prop + key _ (= ""))
  (prop + is-selected _ (= false))
  (prop + has-children _ (= false))
)
