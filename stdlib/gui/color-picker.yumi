_ opacity-input TextInput
_ hue F64
_ saturation F64 = 1
_ brightness F64 = 1
_ alpha F64 = 1
_ published-color RGBA?
_ hue-track = HueTrackPainter()

. external-color-changed < color

────────────────────

<This • flex-col
    <PlaneSlider sv-plane • flex:1
        value = Point(#saturation, 1 - #brightness)
        plane-painter = SaturationValuePainter(#hue)
        for event on value-changed
            accept-plane(event.value.x, event.value.y, event.phase)

    <ChannelSlider hue-slider • color-picker-slider
        value = #hue
        track-painter = hue-track
        thumb-color = HSVA(#hue, 1, 1) as RGBA
        for event on value-changed
            accept-hue(event.value, event.phase)

    <ChannelSlider alpha-slider • color-picker-slider
        value = #alpha
        track-painter = AlphaTrackPainter(opaque(#color), #checker-light, #checker-dark)
        thumb-color = #color
        for event on value-changed
            accept-alpha(event.value, event.phase)

    <Box • color-picker-fields flex-row
        <TextInput hex-input • flex:1
            text = hex-text(#color)
            placeholder = "RRGGBB"
            for event on change
                accept-hex-text(event.text)
                event.cancel()

        <TextInput opacity-input • color-picker-opacity
            text = opacity-text(#alpha)
            placeholder = "100%"
            for event on change
                accept-opacity-text(event.text)
                event.cancel()

