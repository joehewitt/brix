────────────────────
+ do mounted

super.mounted()
adopt-color(color)

────────────────────
+ measured-content-size
    - query MeasureQuery

Dimensions(240, 280)

────────────────────
_ do external-color-changed

=? if published-color && pack-rgba8(published-color) == pack-rgba8(color)
adopt-color(color)

────────────────────
_ do adopt-color
    - next RGBA

. hsva = next as HSVA
if hsva.value > 0 && hsva.saturation > 0
    hue = hsva.hue
if hsva.value > 0
    saturation = hsva.saturation
brightness = hsva.value
alpha = clamp-unit(next.alpha)
published-color = next

────────────────────
+ do accept-plane
    - x F64
    - y F64
    - phase ValueChangePhase = ValueChangePhase.discrete

saturation = clamp-unit(x)
brightness = clamp-unit(1 - y)
publish-color(phase)

────────────────────
+ do accept-hue
    - next F64
    - phase ValueChangePhase = ValueChangePhase.discrete

hue = clamp-unit(next)
publish-color(phase)

────────────────────
+ do accept-alpha
    - next F64
    - phase ValueChangePhase = ValueChangePhase.discrete

alpha = clamp-unit(next)
publish-color(phase)

────────────────────
+ do accept-hex-text
    - text String

. parsed = color-input-value(text, alpha)
if !parsed
    hex-input.text = hex-text(color)
    =
adopt-color(parsed)
publish-color(ValueChangePhase.discrete)

────────────────────
+ do accept-opacity-text
    - text String

. parsed = parse-opacity-text(text)
if !parsed
    opacity-input.text = opacity-text(alpha)
    =
accept-alpha(parsed)

────────────────────
_ do publish-color
    - phase ValueChangePhase

. old = color
. next = HSVA(hue, saturation, brightness, alpha) as RGBA
. changed = pack-rgba8(old) != pack-rgba8(next)
if changed
    . change = ValueChange'RGBA(old, next, phase)
    value-changing <- change
    if change.is-canceled
        adopt-color(old)
        =
published-color = next
color = next
=? if !changed && (phase == ValueChangePhase.discrete || phase == ValueChangePhase.changed)
value-changed <- ValueChange'RGBA(old, next, phase)

