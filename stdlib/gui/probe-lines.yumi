━━━━━━━━━━━━━━━━━━━━
+ ProbeLine is Tuple

+ index Size
+ depth Size
+ text String
+ key String
+ location String
+ path String
+ line U32
+ duration String
+ is-group Bool
+ is-collapsed Bool
+ is-system Bool

━━━━━━━━━━━━━━━━━━━━
+ ProbeLineSource
    is VirtualSource'ProbeLine

+ feed ProbeFeed
+ revision := VirtualRevision()
+ shown [Size]
+ collapsed [Size = Bool]
+ filter = ""

_ range VirtualRangeSource
_ counted Size = 0

────────────────────
+ This
    - feed

update()

.. range = VirtualRangeSource(0vcoord)

────────────────────
whenever feed.#is-recording

revision.touch()

────────────────────
+ do update

. rows = feed.trace.rows
while counted < rows.length
    . row = rows[counted]
    counted += 1
    if admits(row)
        shown += row.index
range.count = shown.length as VirtualCoord
revision.touch()

────────────────────
+ do rebuild

shown = List'Size()
counted = 0
revision.bump()
update()

────────────────────
+ do toggle
    - index Size

if collapsed[index] ?? false
    -= collapsed[index]
else
    collapsed[index] = true
rebuild()

────────────────────
+ do set-filter
    - text String

=? if text == filter
filter = text
rebuild()

────────────────────
_ do admits Bool
    - row TraceRow

=? false if row.kind == TraceRowKind.end && row.opening != null
. rows = feed.trace.rows
. parent = row.parent
while parent
    =? false if collapsed[parent] ?? false
    parent = rows[parent].parent
=? true if filter == ""
. wanted = filter.lowercased
= row.text.lowercased.find(wanted) != null || row.key.lowercased.find(wanted) != null

────────────────────
_ line-of ProbeLine
    - row TraceRow

ProbeLine
    - row.index
    - row.depth
    - row.text
    - row.key
    - row.location
    - row.path
    - row.line
    - if row.duration then duration-text(row.duration) else if is-group then pending else ""
    - is-group
    - collapsed[row.index] ?? false
    - row.kind == TraceRowKind.system

.. is-group = row.kind == TraceRowKind.begin
.. pending = if feed.is-recording then "…" else "open"

────────────────────
+ get domain VirtualSequenceDomain

range

────────────────────
+ do bind
    - address I64
    - generation U64
    - target VirtualBindingTarget'ProbeLine

if address < 0 || address >= (shown.length as I64)
    target.fail(generation)
else
    . row = feed.trace.rows[shown[address]]
    target.commit(VirtualKey(revision.value, row.index), line-of(row), generation)

━━━━━━━━━━━━━━━━━━━━
+ ProbeLines is Box
    is Choosing

+ feed ProbeFeed
+ filter = ""
+ source = ProbeLineSource(#feed)
+ event opened ProbeLine

────────────────────

<This • flex-col
    <VirtualRegion'ProbeLine lines • probe-lines flex:1
        source = #source
        virtual-layout = VerticalFixedLayout(probe-row-height)
        overscan = VirtualInsets(probe-row-overscan, 0vcoord, probe-row-overscan, 0vcoord)
        anchors-end = true

        <ProbeRow (row) - slot
            line = slot.#item
            for index on toggled
                toggle(index)
            for chosen on picked
                open(chosen)

────────────────────
whenever feed.#revision

source.update()
feed.seen = feed.revision

────────────────────
whenever #filter

source.set-filter(filter)

────────────────────
_ do toggle
    - index Size

source.toggle(index)

────────────────────
_ do open
    - line ProbeLine

=? if line.path == "" || line.line == 0
opened <- line
chosen <- ChooseEvent()

━━━━━━━━━━━━━━━━━━━━
+ ProbeRow is Box

+ line ProbeLine?
+ depth = #line?.depth ?? 0
+ is-group = #line?.is-group ?? false
+ is-collapsed = #line?.is-collapsed ?? false
+ is-system = #line?.is-system ?? false
+ event toggled Size
+ event picked ProbeLine

────────────────────

<This • probe-row flex-row
    <Box • flex-row flex:1
        padding-left = probe-indent * (#depth as Length)
        if #is-group
            <DisclosureButton • probe-disclosure icon-chevron-right w:16 h:16 min-w:16 min-h:16
                align-y = Alignment.center
                is-open = !#is-collapsed
                action = => do toggle()
        else
            <Box • probe-disclosure-space
        <Label • probe-text flex:1
            text = #line?.text ?? ""
            align-y = Alignment.center
    <Label • probe-duration
        text = #line?.duration ?? ""
        align-y = Alignment.center
    <Label • probe-key
        text = #line?.key ?? ""
        align-y = Alignment.center
    <Label • probe-location
        text = #line?.location ?? ""
        align-y = Alignment.center

────────────────────
for event on click

. shown = line
if shown
    picked <- shown
event.cancel()

────────────────────
_ do toggle

. shown = line
if shown
    toggled <- shown.index

━━━━━━━━━━━━━━━━━━━━
+ do probe-feed-status String
    - revision U64
    - is-recording Bool
    - feed ProbeFeed

. trace = feed.trace
. start = trace.start ?? 0u64
. span = if trace.latest > start then trace.latest - start else 0u64
. state = if is-recording then "Recording" else "Exited (${feed.status ?? 0})"
. problem = if feed.problem then " · ${feed.problem}" else ""
. unmatched = if trace.unmatched.length > 0 then unmatched-note else ""
    .. unmatched-note = " · No probes match ${", ".join(trace.unmatched)}"
= "$state · $record-count records · ${duration-text(span)}$unmatched$problem"
    .. record-count = count-text(trace.rows.length as U64)

━━━━━━━━━━━━━━━━━━━━
+ do probe-feed-counters String
    - revision U64
    - feed ProbeFeed?

=? "" if !feed
. texts [String]
for count in feed.trace.counts
    . owner = if count.owner != "" then " ${count.owner}" else ""
    texts += "${count.key}$owner ${count-text(count.value)}"
for metric in feed.trace.metrics
    if metric.site.kind == TraceMetricKind.timer
        texts += "${metric.site.key} ${count-text(metric.value)}× ${duration-text(metric.total-ns)}"
    else
        texts += "${metric.site.key} ${count-text(metric.value)}"
. ordered = sort(texts) • using :: a, b => if a < b then .lesser else .greater
= " · ".join(ordered)
