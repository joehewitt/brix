(import ./button)
(import ./icon)
(import ./primitives)
(import ./shorthands)
(import ./styles)
(import ./theme)
(import /graphics/color)
(import /graphics/primitives)
(import /units)

(style-extend GUIDefaultTheme
  (using GUIBoxCursor)
  (using GUIBoxPaint)
  (using GUIBoxSize)
  (using GUIBoxSpacing)
  (using GUITextPaint)
  (rule IconButton (• bg transparent) (• text gui-muted-text-color) (• px 0) (• min-w gui-control-height) (• min-h gui-control-height)
    (= shadow null)
    (= cursor (. CursorStyle pointing-hand))
    (= max-height (. SizeSpec auto))
    (blank)
    (when-style #is-untitled
      (• px 0)
    )
    (blank)
    (when-style #is-hover-within
      (• bg gui-hover-color)
      (• text gui-text-color)
    )
    (blank)
    (when-style #is-press-within
      (• bg gui-pressed-color)
    )
    (blank)
    (when-style #is-on
      (• bg gui-accent-color)
      (• text gui-accent-text-color)
    )
    (blank)
    (when-style (not #is-effectively-enabled)
      (• bg transparent)
      (= cursor (. CursorStyle arrow))
    )
    (blank)
    (when-style (not #is-enabled)
      (= opacity 0.25%%)
    )
    (blank)
    (rule icon (• w gui-control-icon-size) (• h gui-control-icon-size) (• mr 0))
  )
)

(type + IconButton (is Button))
