(import /graphics/primitives)
(import /graphics/text)
(import /gui)
(import /gui/icons/lucide/chevron-right)
(import /probes/console)
(import /probes/feed)
(import /probes/model)
(import /probes/trace)
(import /stream/sort)
(import /time/duration)
(import /ui/virtual)
(import /ui/virtual-layout)
(blank)
(prop _ probe-row-height _ (= 20vcoord))
(prop _ probe-row-overscan _ (= 200vcoord))
(prop _ probe-indent Length (= 14))
(prop + probe-filter-delay _ (= 150ms))

(style-extend GUIDefaultTheme
  (using GUIBoxPaint)
  (using GUIBoxSize)
  (using GUIBoxSpacing)
  (using GUIFontStyle)
  (using GUIParagraphStyle)
  (using GUITextComposition)
  (using GUITextPaint)
  (rule ProbeLines
    (rule probe-row (• h 20) (• px 8)
      (= font-family "Menlo")
      (= font-size 12)
      (blank)
      (when-style #is-hover-within
        (• bg gui-hover-color)
      )
      (blank)
      (when-style #is-system
        (rule probe-text (• text gui-warning-color))
      )
    )
    (blank)
    (rule probe-disclosure (• text gui-muted-text-color)
      (rule icon (• w 12) (• h 12))
    )
    (blank)
    (rule probe-disclosure-space (• w 16) (• min-w 16))
    (blank)
    (rule probe-text
      (= text-wrap (. TextWrap no-wrap))
      (= text-overflow (. TextOverflow truncate-tail))
    )
    (blank)
    (rule probe-duration (• text gui-muted-text-color) (• ml 12)
      (= text-wrap (. TextWrap no-wrap))
    )
    (blank)
    (rule probe-key (• text gui-muted-text-color) (• ml 12)
      (= text-wrap (. TextWrap no-wrap))
    )
    (blank)
    (rule probe-location (• text gui-muted-text-color) (• ml 12) (• min-w 120)
      (= text-alignment (. TextAlignment right))
      (= text-wrap (. TextWrap no-wrap))
      (= text-overflow (. TextOverflow truncate-head))
    )
  )
)

(type + ProbeLine (is Tuple)
  (prop + index Size)
  (prop + depth Size)
  (prop + text String)
  (prop + key String)
  (prop + location String)
  (prop + path String)
  (prop + line U32)
  (prop + duration String)
  (prop + is-group Bool)
  (prop + is-collapsed Bool)
  (prop + is-system Bool)
)

(type + ProbeLineSource
  (implements (of VirtualSource ProbeLine))
  (prop + feed ProbeFeed)
  (prop + revision _ (:= (call VirtualRevision)))
  (prop + shown (list Size))
  (prop + collapsed (map Size Bool))
  (prop + filter _ (= ""))
  (blank)
  (prop _ range VirtualRangeSource)
  (prop _ counted Size (= 0))
  (fn-do + This _
    (param feed _)
    (call update)
    (blank)
    (lazy range (call VirtualRangeSource 0vcoord))
  )
  (whenever-rule (. feed #is-recording)
    (call (. revision touch))
  )
  (fn-do + update _
    (let rows (. feed trace rows))
    (while (< counted (. rows length))
      (let row ([] rows counted))
      (+= counted 1)
      (if (call admits row)
        (+= shown (. row index))
      )
    )
    (= (. range count) (as (. shown length) VirtualCoord))
    (call (. revision touch))
  )
  (fn-do + rebuild _
    (= shown (call (of List Size)))
    (= counted 0)
    (call (. revision bump))
    (call update)
  )
  (fn-do + toggle _
    (param index Size)
    (if (?? ([] collapsed index) false)
      (-= ([] collapsed index))
      (else
        (= ([] collapsed index) true)
      )
    )
    (call rebuild)
  )
  (fn-do + set-filter _
    (param text String)
    (return-if (if (== text filter)))
    (= filter text)
    (call rebuild)
  )
  (fn-do _ admits Bool
    (param row TraceRow)
    (return-if false (if (and (== (. row kind) (. TraceRowKind end)) (!= (. row opening) null))))
    (let rows (. feed trace rows))
    (let parent (. row parent))
    (while parent
      (return-if false (if (?? ([] collapsed parent) false)))
      (= parent (. ([] rows parent) parent))
    )
    (return-if true (if (== filter "")))
    (let wanted (. filter lowercased))
    (return (or (!= (call (. row text lowercased find) wanted) null) (!= (call (. row key lowercased find) wanted) null)))
  )
  (fn-expr _ line-of ProbeLine
    (param row TraceRow)
    (call ProbeLine
      (block
        (arg (. row index))
        (arg (. row depth))
        (arg (. row text))
        (arg (. row key))
        (arg (. row location))
        (arg (. row path))
        (arg (. row line))
        (arg (if-expr (. row duration) (call duration-text (. row duration)) (if-expr is-group pending "")))
        (arg is-group)
        (arg (?? ([] collapsed (. row index)) false))
        (arg (== (. row kind) (. TraceRowKind system)))
      )
    )
    (where
      (lazy is-group (== (. row kind) (. TraceRowKind begin)))
      (lazy pending (if-expr (. feed is-recording) "…" "open"))
    )
  )
  (fn-expr + domain VirtualSequenceDomain :get
    range
  )
  (fn-do + bind _
    (param address I64)
    (param generation U64)
    (param target (of VirtualBindingTarget ProbeLine))
    (if (or (< address 0) (>= address (as (. shown length) I64)))
      (call (. target fail) generation)
      (else
        (let row ([] (. feed trace rows) ([] shown address)))
        (call (. target commit) (call VirtualKey (. revision value) (. row index)) (call line-of row) generation)
      )
    )
  )
)

(type + ProbeLines (is Box)
  (implements Choosing)
  (prop + feed ProbeFeed)
  (prop + filter _ (= ""))
  (prop + source _ (= (call ProbeLineSource #feed)))
  (event + opened ProbeLine)
  (blank)
  (rule probe-lines)
  (content
    (<> This (• flex-col)
      (<> (of VirtualRegion ProbeLine) (id: lines) (• probe-lines) (• flex 1)
        (= source #source)
        (= virtual-layout (call VerticalFixedLayout probe-row-height))
        (= overscan (call VirtualInsets probe-row-overscan 0vcoord probe-row-overscan 0vcoord))
        (= anchors-end true)
        (blank)
        (<> ProbeRow (slot: row) (param: slot)
          (= line (. slot #item))
          (for (on index toggled)
            (call toggle index)
          )
          (for (on chosen picked)
            (call open chosen)
          )
        )
      )
    )
  )
  (whenever-rule (. feed #revision)
    (call (. source update))
    (= (. feed seen) (. feed revision))
  )
  (whenever-rule #filter
    (call (. source set-filter) filter)
  )
  (fn-do _ toggle _
    (param index Size)
    (call (. source toggle) index)
  )
  (fn-do _ open _
    (param line ProbeLine)
    (return-if (if (or (== (. line path) "") (== (. line line) 0))))
    (<- opened line)
    (<- chosen (call ChooseEvent))
  )
)

(type + ProbeRow (is Box)
  (prop + line (? ProbeLine))
  (prop + depth _ (= (?? (?. #line depth) 0)))
  (prop + is-group _ (= (?? (?. #line is-group) false)))
  (prop + is-collapsed _ (= (?? (?. #line is-collapsed) false)))
  (prop + is-system _ (= (?? (?. #line is-system) false)))
  (event + toggled Size)
  (event + picked ProbeLine)
  (content
    (<> This (• probe-row) (• flex-row)
      (<> Box (• flex-row) (• flex 1)
        (= padding-left (* probe-indent (as #depth Length)))
        (if #is-group
          (<> DisclosureButton (• probe-disclosure) (• icon-chevron-right) (• w 16) (• h 16) (• min-w 16) (• min-h 16)
            (= align-y (. Alignment center))
            (= is-open (not #is-collapsed))
            (= action (=> () :do (call toggle)))
          )
          (else
            (<> Box (• probe-disclosure-space))
          )
        )
        (<> Label (• probe-text) (• flex 1)
          (= text (?? (?. #line text) ""))
          (= align-y (. Alignment center))
        )
      )
      (<> Label (• probe-duration)
        (= text (?? (?. #line duration) ""))
        (= align-y (. Alignment center))
      )
      (<> Label (• probe-key)
        (= text (?? (?. #line key) ""))
        (= align-y (. Alignment center))
      )
      (<> Label (• probe-location)
        (= text (?? (?. #line location) ""))
        (= align-y (. Alignment center))
      )
    )
  )
  (subscribe-for (on event click)
    (let shown line)
    (if shown
      (<- picked shown)
    )
    (call (. event cancel))
  )
  (fn-do _ toggle _
    (let shown line)
    (if shown
      (<- toggled (. shown index))
    )
  )
)

(fn-do + probe-feed-status String
  (param revision U64)
  (param is-recording Bool)
  (param feed ProbeFeed)
  (let trace (. feed trace))
  (let start (?? (. trace start) 0u64))
  (let span (if-expr (> (. trace latest) start) (- (. trace latest) start) 0u64))
  (let state (if-expr is-recording "Recording" (str "Exited (" (?? (. feed status) 0) ")")))
  (let problem (if-expr (. feed problem) (str " · " (. feed problem)) ""))
  (let unmatched
    (scope (if-expr (> (. trace unmatched length) 0) unmatched-note "")
      (lazy unmatched-note (str " · No probes match " (call (. ", " join) (. trace unmatched))))
    )
  )
  (return
    (scope (str state " · " record-count " records · " (call duration-text span) unmatched problem)
      (lazy record-count (call count-text (as (. trace rows length) U64)))
    )
  )
)

(fn-do + probe-feed-counters String
  (param revision U64)
  (param feed (? ProbeFeed))
  (return-if "" (if (not feed)))
  (let texts (list String))
  (for (in count (. feed trace counts))
    (let owner (if-expr (!= (. count owner) "") (str " " (. count owner)) ""))
    (+= texts (str (. count key) owner " " (call count-text (. count value))))
  )
  (for (in metric (. feed trace metrics))
    (if (== (. metric site kind) (. TraceMetricKind timer))
      (+= texts (str (. metric site key) " " (call count-text (. metric value)) "× " (call duration-text (. metric total-ns))))
      (else
        (+= texts (str (. metric site key) " " (call count-text (. metric value))))
      )
    )
  )
  (let ordered (call sort texts (:using (=> (a b) (if-expr (< a b) .lesser .greater)))))
  (return (call (. " · " join) ordered))
)
