+ This
    - motion Point
    - stills [Rect]

. merged = scroll-blur-merged(stills)
this.motion = motion
still-count = min(merged.length, gui-scroll-blur-stills) as F64
still-0 = scroll-blur-still(merged, 0)
still-1 = scroll-blur-still(merged, 1)
still-2 = scroll-blur-still(merged, 2)
still-3 = scroll-blur-still(merged, 3)

────────────────────
+ ¶ metal

static bool scrollBlurHeld(float2 p, ScrollBlurArgs args) {
    float4 stills[4] = {args.still_0, args.still_1, args.still_2, args.still_3};
    int count = int(args.still_count);
    for (int i = 0; i < count; ++i) {
        float4 r = stills[i];
        if (p.x >= r.x && p.y >= r.y && p.x < r.x + r.z && p.y < r.y + r.w) {
            return true;
        }
    }
    return false;
}

static bool scrollBlurNear(float2 low, float2 high, ScrollBlurArgs args) {
    float4 stills[4] = {args.still_0, args.still_1, args.still_2, args.still_3};
    int count = int(args.still_count);
    for (int i = 0; i < count; ++i) {
        float4 r = stills[i];
        if (high.x >= r.x && high.y >= r.y && low.x < r.x + r.z && low.y < r.y + r.w) {
            return true;
        }
    }
    return false;
}

static float3 scrollBlurMixed(float4 color) {
    float3 magnitude = abs(color.rgb) / max(color.a, 1.0e-5);
    return color.rgb * (0.045 + magnitude * (0.55 + magnitude * 0.405));
}

static float3 scrollBlurUnmixed(float3 mixed) {
    float3 target = abs(mixed);
    float3 color = abs(brixEncodeSRGB(target));
    color -= (color * (0.045 + color * (0.55 + color * 0.405)) - target) / (0.045 + color * (1.1 + color * 1.215));
    return sign(mixed) * color;
}

float4 filter(float2 position, ShaderLayer layer, ScrollBlurArgs args) {
    float span = length(args.motion);
    bool reduced = layer.resolution.x < 1.0 || layer.resolution.y < 1.0;
    if (span <= 0.0 || (!reduced && scrollBlurHeld(position, args))) {
        return layer.sample(position);
    }
    constexpr sampler pixels(coord::pixel, address::clamp_to_edge, filter::linear);
    float2 low = layer.origin + 0.5;
    float2 high = layer.origin + layer.size * layer.scale - 0.5;
    float2 base = layer.origin + position * layer.scale;
    float2 travel = args.motion * layer.scale;
    int taps = clamp(int(ceil(span * layer.scale * 0.5)), 2, 24);
    float2 reach = abs(args.motion) * 0.5;
    bool near = scrollBlurNear(position - reach, position + reach, args);
    float4 sum = float4(0.0);
    float weight = 0.0;
    for (int i = 0; i < taps; ++i) {
        float t = (float(i) + 0.5) / float(taps) - 0.5;
        float2 q = clamp(base + t * travel, low, high);
        if (near && scrollBlurHeld((q - layer.origin) / layer.scale, args)) {
            continue;
        }
        float4 color = layer.texture.sample(pixels, q);
        sum += float4(scrollBlurMixed(color), color.a);
        weight += 1.0;
    }
    if (weight <= 0.0) {
        return layer.sample(position);
    }
    if (sum.a <= 0.0) {
        return float4(0.0);
    }
    float3 color = scrollBlurUnmixed(sum.rgb / sum.a);
    return float4(brixLinearColor(color, layer.space, layer.space), sum.a / weight);
}

━━━━━━━━━━━━━━━━━━━━
+ do scroll-blur-pass ShaderFilter
    - motion Point
    - stills [Rect]
    - scale F64

. kept = List'Rect()
for still in scroll-blur-merged(stills)
    if kept.length < gui-scroll-blur-stills
        kept += still
. base ShaderFilter = ScrollBlur(motion, kept)
. pixels = sqrt(motion.x * motion.x + motion.y * motion.y) * scale
. share = if pixels >= scroll-blur-quarter-span then 0.25 else if pixels >= scroll-blur-half-span then 0.5 else 1.0
. resolution = if abs(motion.y) >= abs(motion.x) then Point(1, share) else Point(share, 1)
= ShaderFilter(base.shader, base.args, base.images, base.is-live, base.frame-rate, base.time, base.arg-kinds, resolution, kept)

━━━━━━━━━━━━━━━━━━━━
+ do scroll-blur-merged [Rect]
    - stills [Rect]

. merged = List'Rect()
for still in stills
    . current = still
    . index = 0
    while index < merged.length
        . joined = scroll-blur-joined(merged[index], current)
        if joined
            current = joined
            merged.remove(index)
            index = 0
        else
            index += 1
    if current.width > 0 && current.height > 0
        merged += current
= merged

━━━━━━━━━━━━━━━━━━━━
_ scroll-blur-joined Rect?
    - a Rect
    - b Rect

|? scroll-blur-holds(a, b)
    a
|? scroll-blur-holds(b, a)
    b
|? same-columns && b.top <= a.bottom + scroll-blur-slack && b.bottom >= a.top - scroll-blur-slack
    Rect(a.x, min(a.top, b.top), a.width, max(a.bottom, b.bottom) - min(a.top, b.top))
|? same-rows && b.left <= a.right + scroll-blur-slack && b.right >= a.left - scroll-blur-slack
    Rect(min(a.left, b.left), a.y, max(a.right, b.right) - min(a.left, b.left), a.height)
??
    null

.. same-columns = abs(a.x - b.x) <= scroll-blur-slack && abs(a.width - b.width) <= scroll-blur-slack
.. same-rows = abs(a.y - b.y) <= scroll-blur-slack && abs(a.height - b.height) <= scroll-blur-slack

━━━━━━━━━━━━━━━━━━━━
_ scroll-blur-holds Bool
    - outer Rect
    - inner Rect

inner.left >= outer.left - slack && inner.right <= outer.right + slack && top && bottom

.. slack = scroll-blur-slack
.. top = inner.top >= outer.top - slack
.. bottom = inner.bottom <= outer.bottom + slack

━━━━━━━━━━━━━━━━━━━━
_ scroll-blur-still Rect
    - stills [Rect]
    - index Size

if index < stills.length then stills[index] else Rect(0, 0, 0, 0)
