./box
/core/markup
/core/style
/stream/aggregate

_ gui-composite = CompositeState()

_ CompositeStep is (box Box?, index Size)
_ CompositeRoute is (box Box, host Box, layer Layer, is-proxy Bool)
_ CompositeList is (layer Layer?, owner Box?)

━━━━━━━━━━━━━━━━━━━━
+ CompositeBoxState

+ layers [Layer]?
+ host Box?
+ below [Box]?
+ above [Box]?

━━━━━━━━━━━━━━━━━━━━
+ Layer is GuiNode

+ name = ""
+ is-default = false

_ sublayers [Layer]
_ parent-layer Layer?
_ owner Box?

. layer-changed < name, is-default

────────────────────
+ This
    - name = ""

────────────────────
+ do get declarer

. cursor Layer = this
while cursor.parent-layer
    cursor = cursor.parent-layer
= cursor.owner

────────────────────
+ do adopt
    - sublayer Layer

sublayer.parent-layer = this
sublayers += sublayer
composite-invalidate()

────────────────────
+ do mounted

super.mounted()
match? composite-layer-holder(this)
    | layer Layer
        parent-layer = layer
        composite-insert-layer(layer.sublayers, this)
    | box Box
        owner = box
        composite-insert-layer(box.declared-layer-list, this)
composite-invalidate()

────────────────────
+ do unmounted

. parent = parent-layer
if parent
    composite-remove-layer(parent.sublayers, this)
    parent-layer = null
. holder = owner
if holder
    composite-remove-layer(holder.declared-layer-list, this)
    owner = null
composite-invalidate()
super.unmounted()

────────────────────
_ do layer-changed

composite-invalidate()

━━━━━━━━━━━━━━━━━━━━
+ do composite-install-window-layers
    - window Box

. layers = window.declared-layer-list
. adornments = Layer("adornments")
adornments.adopt(Layer("focus"))
adornments.adopt(Layer("handles"))
. content = Layer("content")
content.is-default = true
layers.insert(Layer("underlay"), 0)
layers.insert(content, 1)
layers.insert(Layer("flights"), 2)
layers.insert(adornments, 3)
layers.insert(Layer("feedback"), 4)
. index Size = 0
while index < 5
    layers[index].owner = window
    index += 1
composite-invalidate()

━━━━━━━━━━━━━━━━━━━━
+ do composite-register
    - box Box

gui-composite.boxes += box
composite-invalidate()

━━━━━━━━━━━━━━━━━━━━
+ do composite-unregister
    - box Box

. boxes = gui-composite.boxes
. index Size = 0
while index < boxes.length
    if boxes[index] as Pointer == box as Pointer
        boxes.remove(index)
        break
    index += 1
composite-invalidate()

━━━━━━━━━━━━━━━━━━━━
+ do composite-invalidate

gui-composite.generation += 1

━━━━━━━━━━━━━━━━━━━━
+ do composite-style-mask

. state = gui-composite
=? state.style-mask if state.style-mask != 0
. composite = style-domain-named("composite")
. layout = style-domain-named("layout")
. effects = style-domain-named("vector-composite")
=? 0 if composite < 0 || layout < 0 || effects < 0
state.layer-mask = 1u32 /lshift/ (composite as Size)
. shape = (1u32 /lshift/ (layout as Size)) /or/ (1u32 /lshift/ (effects as Size))
state.style-mask = state.layer-mask /or/ shape
= state.style-mask

━━━━━━━━━━━━━━━━━━━━
+ composite-layer-mask

gui-composite.layer-mask

━━━━━━━━━━━━━━━━━━━━
+ do composite-refresh

. state = gui-composite
=? if state.plan-generation == state.generation
state.plan-generation = state.generation
for box in state.relevant
    box.set-composite-relevant(false)
. relevant [Box]
. routes [CompositeRoute]
for box in state.boxes
    composite-mark-relevant(box, relevant)
    . route = composite-route(box)
    if route
        routes += route
state.relevant = relevant
. hostings [CompositeHosting]
for route in routes
    if !composite-has-hosting(hostings, route.host)
        hostings += composite-build-hosting(route.host, routes)
=? if composite-same-plan(state, routes, hostings)
for route in state.routes
    route.box.set-composite-host(null)
for hosting in state.hostings
    hosting.host.set-composite-members(null, null)
. old-routes = state.routes
. old-hostings = state.hostings
state.routes = routes
state.hostings = hostings
for route in routes
    route.box.set-composite-host(route.host)
for hosting in hostings
    hosting.host.set-composite-members(hosting.below, hosting.above)
composite-mark-placements(old-routes, routes)
composite-mark-placements(routes, old-routes)
composite-mark-hostings(old-hostings, hostings)
composite-mark-hostings(hostings, old-hostings)

━━━━━━━━━━━━━━━━━━━━
_ CompositeState

+ generation U64 = 1
+ plan-generation U64
+ boxes [Box]
+ relevant [Box]
+ routes [CompositeRoute]
+ hostings [CompositeHosting]
+ style-mask U32
+ layer-mask U32

━━━━━━━━━━━━━━━━━━━━
_ CompositeHosting

+ host Box
+ below [Box]
+ above [Box]

────────────────────
+ This
    - host
    - below
    - above

━━━━━━━━━━━━━━━━━━━━
_ do composite-mark-placements
    - routes [CompositeRoute]
    - others [CompositeRoute]

for route in routes when !composite-routes-box(others, route.box)
    route.box.material-parent?.composite-placement-changed()

━━━━━━━━━━━━━━━━━━━━
_ composite-routes-box
    - routes [CompositeRoute]
    - box Box

some(routes) • where each.box as Pointer == box as Pointer

━━━━━━━━━━━━━━━━━━━━
_ do composite-mark-hostings
    - hostings [CompositeHosting]
    - others [CompositeHosting]

for hosting in hostings when !composite-keeps-hosting(others, hosting)
    hosting.host.composite-placement-changed()

━━━━━━━━━━━━━━━━━━━━
_ do composite-keeps-hosting Bool
    - hostings [CompositeHosting]
    - hosting CompositeHosting

for other in hostings when other.host as Pointer == hosting.host as Pointer
    = composite-same-boxes(other.below, hosting.below) && same-above
        .. same-above = composite-same-boxes(other.above, hosting.above)
= false

━━━━━━━━━━━━━━━━━━━━
_ do composite-mark-relevant
    - box Box
    - relevant [Box]

. cursor Box? = box
while cursor
    . current = cursor
    =? if current.is-composite-relevant
    current.set-composite-relevant(true)
    relevant += current
    cursor = current.material-parent

━━━━━━━━━━━━━━━━━━━━
_ do composite-resolve
    - box Box
    - name String

. cursor = box.layout-parent
while cursor
    . ancestor = cursor
    . layers = ancestor.composite-layers
    if layers
        . found = composite-find-layer(layers, name)
        =? found if found
    cursor = ancestor.layout-parent

━━━━━━━━━━━━━━━━━━━━
_ do composite-layer-holder
    - layer Layer

. cursor = layer.%parent
while cursor
    . node = cursor
    =? node if !node.is-gui-transparent
    cursor = node.%parent

━━━━━━━━━━━━━━━━━━━━
_ do composite-insert-layer
    - layers [Layer]
    - layer Layer

. index = layers.length
while index > 0 && gui-node-precedes(layer, layers[index - 1])
    index -= 1
layers.insert(layer, index)

━━━━━━━━━━━━━━━━━━━━
_ do composite-remove-layer
    - layers [Layer]
    - layer Layer

. index Size = 0
while index < layers.length
    if layers[index] as Pointer == layer as Pointer
        layers.remove(index)
        =
    index += 1

━━━━━━━━━━━━━━━━━━━━
_ do composite-find-layer Layer?
    - layers [Layer]
    - name String

for layer in layers
    =? layer if layer.name == name
    . nested = composite-find-layer(layer.sublayers, name)
    =? nested if nested

━━━━━━━━━━━━━━━━━━━━
_ do composite-default-layer Layer?
    - layers [Layer]

for layer in layers
    =? layer if layer.is-default
    . nested = composite-default-layer(layer.sublayers)
    =? nested if nested

━━━━━━━━━━━━━━━━━━━━
_ do composite-flatten-layers
    - layers [Layer]
    - ordered [Layer]

for layer in layers
    ordered += layer
    composite-flatten-layers(layer.sublayers, ordered)

━━━━━━━━━━━━━━━━━━━━
_ composite-list
    - box Box

if layer then CompositeList(layer, null) else composite-inherited-list(box)

.. name = box.$layer
.. layer = composite-resolve(box, name) if name

━━━━━━━━━━━━━━━━━━━━
_ composite-inherited-list CompositeList
    - box Box

|? !parent
    CompositeList(null, null)
|? !layers || layers.length == 0
    composite-list(parent)
|? fallback
    CompositeList(fallback, null)
??
    CompositeList(null, parent)

.. parent = box.layout-parent
.. layers = parent.composite-layers
.. fallback = composite-default-layer(layers)

━━━━━━━━━━━━━━━━━━━━
_ composite-same-list
    - left CompositeList
    - right CompositeList

same-layer && left.owner as Pointer? == right.owner as Pointer?

.. same-layer = left.layer as Pointer? == right.layer as Pointer?

━━━━━━━━━━━━━━━━━━━━
_ do composite-route
    - box Box

. flies = box.is-flight-routable
. name = if flies then "flights" else box.$layer
=? if !name
. layer = composite-resolve(box, name)
=? if !layer
=? if composite-same-list(composite-inherited-list(box), CompositeList(layer, null))
. declarer = layer.declarer
. host = (if flies then declarer else null) ?? composite-host-for(box, declarer)
= CompositeRoute(box, host, layer, host as Pointer != declarer as Pointer?)

━━━━━━━━━━━━━━━━━━━━
_ do composite-host-for
    - box Box
    - declarer Box?

. host = box
. cursor = box.layout-parent
while cursor
    . ancestor = cursor
    =? ancestor if ancestor as Pointer? == declarer as Pointer? || ancestor.is-composite-scope
    host = ancestor
    cursor = ancestor.layout-parent
= host

━━━━━━━━━━━━━━━━━━━━
_ do composite-chain-visible
    - box Box
    - host Box

. cursor = box.material-parent
while cursor
    . ancestor = cursor
    =? true if ancestor as Pointer == host as Pointer
    =? false if !ancestor.is-display-visible
    cursor = ancestor.material-parent
= true

━━━━━━━━━━━━━━━━━━━━
_ composite-has-hosting
    - hostings [CompositeHosting]
    - host Box

some(hostings) • where each.host as Pointer == host as Pointer

━━━━━━━━━━━━━━━━━━━━
_ do composite-build-hosting
    - host Box
    - routes [CompositeRoute]

. local [CompositeRoute]
. proxies [CompositeRoute]
for route in routes when route.host as Pointer == host as Pointer
    if composite-chain-visible(route.box, host)
        if route.is-proxy
            proxies += route
        else
            local += route
. lower [Box]
. upper [Box]
composite-split-proxies(host, proxies, lower, upper)
. local-lower [Box]
. local-upper [Box]
composite-split-local(host, local, local-lower, local-upper)
. below = List'Box
    ** lower
    ** local-lower
. above = List'Box
    ** local-upper
    ** upper
= CompositeHosting(host, below, above)

━━━━━━━━━━━━━━━━━━━━
_ do composite-split-local
    - host Box
    - local [CompositeRoute]
    - lower [Box]
    - upper [Box]

=? if local.length == 0
. layers = host.composite-layers
=? if !layers
. fallback = composite-default-layer(layers)
. is-lower = fallback != null
. ordered [Layer]
composite-flatten-layers(layers, ordered)
for layer in ordered
    if layer as Pointer == fallback as Pointer?
        is-lower = false
    . members [Box]
    for route in local when route.layer as Pointer == layer as Pointer
        composite-insert-in-tree-order(members, route.box)
    for member in members
        if is-lower
            lower += member
        else
            upper += member

━━━━━━━━━━━━━━━━━━━━
_ do composite-insert-in-tree-order
    - boxes [Box]
    - box Box

. index = boxes.length
while index > 0 && composite-paints-before(box, boxes[index - 1])
    index -= 1
boxes.insert(box, index)

━━━━━━━━━━━━━━━━━━━━
_ do composite-split-proxies
    - scope Box
    - proxies [CompositeRoute]
    - lower [Box]
    - upper [Box]

=? if proxies.length == 0
. keys [[CompositeStep]]
. boxes [Box]
for route in proxies
    . key = composite-position-key(route.box)
    . index = keys.length
    while index > 0 && composite-key-precedes(key, keys[index - 1])
        index -= 1
    keys.insert(key, index)
    boxes.insert(route.box, index)
. scope-key = composite-position-key(scope)
. index Size = 0
while index < boxes.length
    if composite-key-precedes(keys[index], scope-key)
        lower += boxes[index]
    else
        upper += boxes[index]
    index += 1

━━━━━━━━━━━━━━━━━━━━
_ do composite-position-key [CompositeStep]
    - box Box

. key = composite-list-key(composite-list(box))
key += CompositeStep(box, 0)
= key

━━━━━━━━━━━━━━━━━━━━
_ do composite-list-key
    - list CompositeList

. key [CompositeStep]
. layer = list.layer
if layer
    . declarer = layer.declarer
    if declarer
        key = composite-position-key(declarer)
    for index in composite-layer-path(layer)
        key += CompositeStep(null, index)
    key += CompositeStep(null, 0)
    = key
. owner = list.owner
if owner
    key = composite-position-key(owner)
    key += CompositeStep(null, 0)
= key

━━━━━━━━━━━━━━━━━━━━
_ do composite-layer-path
    - layer Layer

. path [Size]
. cursor Layer? = layer
while cursor
    . current = cursor
    path.insert(composite-layer-index(current), 0)
    cursor = current.parent-layer
= path

━━━━━━━━━━━━━━━━━━━━
_ do composite-layer-index Size
    - layer Layer

. parent = layer.parent-layer
. holder = layer.owner
. siblings [Layer]
if parent
    siblings = parent.sublayers
else if holder
    siblings = holder.declared-layer-list
. index Size = 0
while index < siblings.length
    =? index + 1 if siblings[index] as Pointer == layer as Pointer
    index += 1
= 0

━━━━━━━━━━━━━━━━━━━━
_ do composite-key-precedes
    - left [CompositeStep]
    - right [CompositeStep]

. index Size = 0
while index < left.length && index < right.length
    . a = left[index]
    . b = right[index]
    . a-box = a.box
    . b-box = b.box
    if a-box && b-box
        =? gui-node-precedes(a-box, b-box) if a-box as Pointer != b-box as Pointer
    else if a.index != b.index
        = a.index < b.index
    index += 1
= left.length < right.length

━━━━━━━━━━━━━━━━━━━━
_ do composite-same-plan
    - state CompositeState
    - routes [CompositeRoute]
    - hostings [CompositeHosting]

=? false if state.routes.length != routes.length || state.hostings.length != hostings.length
. index Size = 0
while index < routes.length
    . left = state.routes[index]
    . right = routes[index]
    =? false if left.box as Pointer != right.box as Pointer
    =? false if left.host as Pointer != right.host as Pointer
    index += 1
index = 0
while index < hostings.length
    . left = state.hostings[index]
    . right = hostings[index]
    =? false if left.host as Pointer != right.host as Pointer
    =? false if !composite-same-boxes(left.below, right.below)
    =? false if !composite-same-boxes(left.above, right.above)
    index += 1
= true

━━━━━━━━━━━━━━━━━━━━
_ do composite-same-boxes
    - left [Box]
    - right [Box]

=? false if left.length != right.length
. index Size = 0
while index < left.length
    =? false if left[index] as Pointer != right[index] as Pointer
    index += 1
= true

━━━━━━━━━━━━━━━━━━━━
_ composite-paints-before Bool
    - box Box
    - other Box

if both-routable then box.lift-order < other.lift-order else gui-node-precedes(box, other)

.. both-routable = box.is-flight-routable && other.is-flight-routable
