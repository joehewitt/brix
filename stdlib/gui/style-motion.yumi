━━━━━━━━━━━━━━━━━━━━
+ GUIStyleMotion

_ runs = List'StyleMotionRun()
_ plays = List'KeyframeRun()
_ held = List'KeyframeRun()
_ quiet-mask U32
_ quiet-count Size = 0
_ ranges = Map'String'StyleMotionRange()
_ keys = Map'U64'StyleMotionKeys()
_ layout-slots = Map'String'Size()
_ motion-info StyleInfo?

────────────────────
+ This

ranges["opacity"] = StyleMotionRange(0, 1)
ranges["scale"] = StyleMotionRange(0, null)
ranges["corner-radius"] = StyleMotionRange(0, null)
ranges["backdrop-blur"] = StyleMotionRange(0, null)
ranges["border-width"] = StyleMotionRange(0, null)

────────────────────
+ get running-count Size

runs.length

────────────────────
+ get playing-count Size

plays.length

────────────────────
+ do watch-mounts

. found = motion-style()
=? if !found
for name in ["animation", "enter-space", "match"]
    . offset = slot-named(found, name)
    if offset
        style-report-on-mount(found, offset)
. shown = style-info-named("GUIBoxDisplay")
. display = slot-named(shown, "display") if shown
if shown && display
    style-report-on-mount(shown, display)

────────────────────
+ do watch-mask U64
    - info StyleInfo

. found = motion-style()
=? U64.max if !found
. mask U64
for property in info.properties
    if watches(found, info, property)
        mask = mask /or/ (1u64 /lshift/ property.offset)
= mask

────────────────────
_ watches Bool
    - motion StyleInfo
    - info StyleInfo
    - property StylePropertyInfo

|? property.name == "display" || covers(property)
    true
|? info == motion
    style-motion-watched.find(property.name) != null
??
    keys.key != null || keys.group != null

.. keys = keys-for(motion, info, property)

────────────────────
+ is-motion-property Bool
    - change StyleValueChange
    - name String

change.info == motion-style() && change.info.properties[change.offset].name == name

────────────────────
+ layout-motion Motion?
    - owner MarkupHost
    - name String
    - cause MarkupCause

|? scoped is InstantMotion
    scoped
|? !found
    scoped
??
    read-slot(owner, found, layout-slot(found, name)) ?? layout-fallback ?? scoped

.. scoped = scope-motion(cause)
.. found = motion-style()
.. layout-fallback = read-slot(owner, found, layout-slot(found, "layout"))

────────────────────
_ layout-slot Size?
    - motion StyleInfo
    - name String

if known == Size.max then null else known

.. known = layout-slots[name] ?? find-layout-slot(motion, name)

────────────────────
_ do find-layout-slot Size
    - motion StyleInfo
    - name String

. found = slot-named(motion, "motion.$name") ?? Size.max
layout-slots[name] = found
= found

────────────────────
_ read-slot Motion?
    - owner MarkupHost
    - motion StyleInfo
    - slot Size?

if slot == null then null else style-read-object'Motion(owner, motion, slot)

────────────────────
+ do defer-entrance
    - owner StyleMotionOwner
    - start Duration

. now = owner.frame-clock?.now ?? start
=? if start <= now
for play in plays
    if play.is-entrance && play.owner as Pointer == owner as Pointer
        play.delay = start - now

────────────────────
_ do motion-style StyleInfo?

. found = motion-info ?? style-info-named("GUIBoxMotion")
motion-info = found
= found

────────────────────
+ do covers Bool
    - property StylePropertyInfo

if quiet-count != style-domain-count()
    quiet-mask = 0
    for name in style-motion-quiet-domains
        . domain = style-domain-named(name)
        if domain >= 0
            quiet-mask = quiet-mask /or/ (1u32 /lshift/ (domain as U32))
    quiet-count = style-domain-count()
. domains = property.self-domain-mask /or/ property.parent-domain-mask
= domains != 0 && (domains /or/ quiet-mask) == quiet-mask

────────────────────
+ range StyleMotionRange?
    - property StylePropertyInfo

ranges[property.name]

────────────────────
+ mode StyleLayerMode
    - property StylePropertyInfo

|? style-motion-adding.find(property.name) != null
    StyleLayerMode.adding
|? style-motion-scaling.find(property.name) != null
    StyleLayerMode.scaling
??
    StyleLayerMode.replacing

────────────────────
+ motion-for Motion?
    - owner MarkupHost
    - info StyleInfo
    - property StylePropertyInfo

|? !found
    null
??
    read-slot(owner, found, slots.key) ?? read-slot(owner, found, slots.group) ?? bare-motion

.. found = motion-style()
.. slots = keys-for(found, info, property)
.. bare-motion = read-slot(owner, found, slots.bare)

────────────────────
_ do keys-for StyleMotionKeys
    - motion StyleInfo
    - info StyleInfo
    - property StylePropertyInfo

. code = ((info.style-index as U64) /lshift/ 32) /or/ (property.offset as U64)
. known = keys[code]
=? known if known
. key = slot-named(motion, "motion.${property.name}")
. group = slot-named(motion, "motion.transform") if in-transform-group
    .. in-transform-group = style-motion-transform-group.find(property.name) != null
. bare = slot-named(motion, "motion") if covers(property)
. made = StyleMotionKeys(key, group, bare)
keys[code] = made
= made

────────────────────
_ do slot-named Size?
    - motion StyleInfo
    - name String

for property in motion.properties
    =? property.offset if property.name == name
= null

────────────────────
_ do running StyleMotionRun?
    - node MarkupHost
    - info StyleInfo
    - offset Size

for run in runs
    =? run if run.node as Pointer == node as Pointer && run.info == info && run.offset == offset
= null

────────────────────
+ do entry StyleMotionRun?
    - owner StyleMotionOwner
    - info StyleInfo
    - offset Size

. node = owner as MarkupHost
. found = running(node, info, offset)
=? found if found
. property = info.property-at(offset)
=? null if !property
. settled = style-read-settled(node, info, offset)
style-watch-changes(info, offset)
. made = StyleMotionRun
    - this
    - node
    - owner
    - info
    - offset
    - property
    - StylePresenter(property, settled.bits)
made.range = range(property)
made.mode = mode(property)
runs += made
= made

────────────────────
+ do forget
    - owner StyleMotionOwner

=? if runs.length == 0 && plays.length == 0 && held.length == 0
for play in List'KeyframeRun(held)
    if play.owner as Pointer == owner as Pointer
        held -= play
for play in List'KeyframeRun(plays)
    if play.owner as Pointer == owner as Pointer
        play.cancel()
for run in List'StyleMotionRun(runs)
    if run.owner as Pointer == owner as Pointer
        run.stop()

────────────────────
+ do holds Bool
    - root MarkupHost

for run in runs
    =? true if run.channel != null && style-is-within(run.node, root)
= some(plays) • where each.ends && style-is-within(each.owner, root)

────────────────────
+ do hold
    - play KeyframeRun

held += play

────────────────────
+ do release-held
    - owner StyleMotionOwner

for play in List'KeyframeRun(held)
    if play.owner as Pointer == owner as Pointer
        held -= play
        play.release()

────────────────────
+ do restart-within
    - root MarkupHost

for play in List'KeyframeRun(plays)
    if style-is-within(play.owner, root)
        play.cancel()
for run in List'StyleMotionRun(runs)
    if style-is-within(run.node, root)
        run.stop()
style-unsettle(root)

────────────────────
+ do ended
    - run StyleMotionRun

for index in 0 .. < runs.length
    if runs[index] as Pointer == run as Pointer
        runs.remove(index)
        =

────────────────────
+ do play-ended
    - play KeyframeRun

for index in 0 .. < plays.length
    if plays[index] as Pointer == play as Pointer
        plays.remove(index)
        =

────────────────────
+ do play KeyframeRun
    - owner StyleMotionOwner
    - animation KeyframeAnimation
    - is-styled Bool = false

. started = KeyframeRun(this, owner, animation)
started.is-styled = is-styled
started.is-entrance = is-styled && owner.is-entering
plays += started
started.begin()
= started

────────────────────
+ do replay
    - owner StyleMotionOwner
    - animation KeyframeAnimation

styled-play(owner)?.cancel()
do play(owner, animation, true)

────────────────────
_ do styled-play KeyframeRun?
    - owner StyleMotionOwner

for play in plays
    =? play if play.is-styled && play.owner as Pointer == owner as Pointer
= null

────────────────────
+ do change-value
    - owner StyleMotionOwner
    - change StyleValueChange

. node = owner as MarkupHost
. property = change.info.properties[change.offset]
if change.info == motion-style() && property.name == "animation"
    animation-changed(owner, change)
    =
. run = running(node, change.info, change.offset)
. clock = owner.frame-clock
. scoped = scope-motion(current-markup-cause())
. own = motion-for(node, change.info, property)
. motion = if scoped is InstantMotion then scoped else own ?? (scoped if covers(property))
if !clock || !motion || motion is InstantMotion || !owner.is-motion-visible || owner.snaps-motion
    run?.settle-now()
    =
. ends-none = change.none
. target = if ends-none then style-motion-none-vector(property, change.old-bits) else end-vector
    .. end-vector = style-motion-vector(property, change.bits, false)
. channel = run?.channel
. from = if channel then List'F64(channel.value) else start-vector(property, change)
. moves = change.none || change.old-none || bits-move
    .. bits-move = style-motion-moves(property, change.old-bits, change.bits)
if !target || !from || target.length != from.length || !moves
    run?.settle-now()
    =
if run && !ends-none
    run.presenter.retarget(change.bits)
. now = clock.now
if channel
    run!.ends-none = ends-none
    channel.retarget(target, motion, now)
    =
. start = owner.motion-start
. begins = if start && start > now then start else now
. started = MotionChannel(from, style-motion-precision)
started.retarget(target, motion, begins)
=? if !started.is-moving
. sample = if ends-none then change.old-bits else change.bits
. moving = run ?? StyleMotionRun(this, node, owner, change.info, change.offset, property, presenter)
    .. presenter = StylePresenter(property, sample)
if !run
    moving.range = range(property)
    moving.mode = mode(property)
    runs += moving
moving.channel = started
moving.ends-none = ends-none
moving.present(now)
clock.start(owner, moving)

────────────────────
_ do animation-changed
    - owner StyleMotionOwner
    - change StyleValueChange

. node = owner as MarkupHost
. current = styled-play(owner)
if current && current.is-entrance && !owner.is-entering
    current.is-styled = false
else
    current?.ease-back()
. next = style-read-object'KeyframeAnimation(node, change.info, change.offset)
if next
    do play(owner, next, true)

────────────────────
_ start-vector [F64]?
    - property StylePropertyInfo
    - change StyleValueChange

if change.old-none then style-motion-none-vector(property, change.bits) else old-vector

.. old-vector = style-motion-vector(property, change.old-bits, false)

━━━━━━━━━━━━━━━━━━━━
+ StyleMotionLayer

+ mode StyleLayerMode
+ component Index?
+ values [F64]?

────────────────────
+ This
    - mode
    - component

────────────────────
+ do apply
    - shown [F64]

. given = values
=? if !given
. from = component ?? 0
for index in 0 .. < given.length
    . place = from + index
    if place < shown.length
        match mode
            |= .adding
                shown[place] = shown[place] + given[index]
            |= .scaling
                shown[place] = shown[place] * given[index]
            ??
                shown[place] = given[index]

━━━━━━━━━━━━━━━━━━━━
+ StyleMotionRun
    is FrameAnimation

+ host GUIStyleMotion
+ node MarkupHost
+ owner StyleMotionOwner
+ info StyleInfo
+ offset Size
+ property StylePropertyInfo
+ presenter StylePresenter
+ channel MotionChannel?
+ ends-none = false
+ range StyleMotionRange?
+ mode = StyleLayerMode.replacing
+ layers = List'StyleMotionLayer()

_ is-stopped = false
_ blank [F64]?
_ based = List'F64()
_ opened = List'F64()
_ presented = List'F64()

────────────────────
+ This
    - host
    - node
    - owner
    - info
    - offset
    - property
    - presenter

────────────────────
+ do base [F64]?

. vector = List'F64()
= vector if fill-base(vector)

────────────────────
_ do fill-base Bool
    - into [F64]

into.clear()
. moving = channel
if moving
    into ++= moving.value
    = true
. settled = style-read-settled(node, info, offset)
=? true if style-motion-vector-into(into, property, settled.bits, settled.none)
. vector = style-motion-none-vector(property, settled.bits) ?? blank
=? false if !vector
into ++= vector
= true

────────────────────
+ do adopt
    - sample StyleObjectHolder?

=? if !sample
presenter.adopt(sample)
blank = blank ?? sample.motion-none-vector()

────────────────────
+ do open-vector [F64]?
    - layer StyleMotionLayer

. whole = based
=? null if !fill-base(whole)
. length = if layer.component != null then 1 else whole.length
opened.clear()
do match layer.mode
    |= .adding
        for _ in 0 .. < length
            opened += 0.0
    |= .scaling
        for _ in 0 .. < length
            opened += 1.0
    ??
        . part = layer.component
        =? whole if part == null || part >= whole.length
        opened += whole[part]
= opened

────────────────────
+ do shown [F64]?

. shown = base()
=? null if !shown
for layer in layers
    layer.apply(shown)
= shown

────────────────────
+ do present
    - now Duration? = null

=? if is-stopped
if now
    channel?.update(now)
. values = presented
if !fill-base(values)
    end()
    =
for layer in layers
    layer.apply(values)
. limits = range
if limits && property.is-float
    . low = limits.minimum
    . high = limits.maximum
    if low && values[0] < low
        values[0] = low
    if high && values[0] > high
        values[0] = high
style-present(node, info, offset, presenter.bits(values), false)

────────────────────
+ do settle-now

channel = null
if layers.length == 0
    stop()
    =
owner.frame-clock?.cancel(this)
present()

────────────────────
+ do remove-layer
    - layer StyleMotionLayer

for index in 0 .. < layers.length
    if layers[index] as Pointer == layer as Pointer
        layers.remove(index)
        =

────────────────────
+ do release
    - now Duration? = null

if layers.length == 0 && !channel
    stop()
    =
present(now)

────────────────────
+ do ease-from
    - shown [F64]
    - now Duration

. motion = host.motion-for(node, info, property)
. target = base()
if !motion || motion is InstantMotion || !target || target.length != shown.length || has-layers
    release(now)
    =
.. has-layers = layers.length != 0
. eased = MotionChannel(shown, style-motion-precision)
eased.retarget(if channel then List'F64(channel.target) else target, motion, now)
if !eased.is-moving
    release(now)
    =
channel = eased
present(now)
owner.frame-clock?.start(owner, this)

────────────────────
+ do stop

=? if is-stopped
end()
owner.frame-clock?.cancel(this)

────────────────────
_ do end

is-stopped = true
host.ended(this)
style-unpresent(node, info, offset)

╌╌╌╌╌╌╌╌╌╌ is FrameAnimation ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do advance Bool
    - tick FrameTick

=? false if is-stopped
present(tick.now)
. moving = channel
if moving && !moving.is-moving
    channel = null
    if ends-none && layers.length == 0
        end()
        = false
    if layers.length == 0
        end()
        = false
    present()
= channel != null

────────────────────
+ do finish

=? if is-stopped
channel = null
if layers.length == 0
    end()
    =
present()

━━━━━━━━━━━━━━━━━━━━
+ KeyframeRun
    is FrameAnimation

+ host GUIStyleMotion
+ owner StyleMotionOwner
+ animation KeyframeAnimation
+ is-styled = false
+ is-entrance = false
+ is-done = false
+ is-scrubbed = false
+ delay Duration = 0ns

_ entries = List'StyleMotionRun()
_ layers = List'StyleMotionLayer()
_ tracks = List'KeyframeTrack()
_ waiters = List'Semaphore()

────────────────────
+ This
    - host
    - owner
    - animation

────────────────────
+ do begin

for track in animation.tracks
    . info = track.info
    if info
        . found = host.entry(owner, info, track.offset)
        if found
            found.adopt(track.sample)
            . layer = StyleMotionLayer(host.mode(found.property), track.component)
            found.layers += layer
            entries += found
            layers += layer
            tracks += track
. clock = owner.frame-clock
if !clock || entries.length == 0
    complete(clock?.now)
    =
=? if is-styled && owner.drive-timeline(this)
. start = owner.motion-start
if start && start > clock.now
    delay = start - clock.now
step(0ns, clock.now)
clock.start(owner, this, animation.clock-rate)

────────────────────
+ get ends Bool

!is-done && !is-scrubbed && iterations() != null

────────────────────
+ do scrub
    - progress F64

=? if is-done
is-scrubbed = true
. total = iterations()
. count = if total then total as F64 else 1.0
. seconds = ((animation.duration as Seconds) as F64) * count * clamp(progress, 0.0, 1.0)
. ignored = step((seconds as Seconds) as Nanoseconds, owner.frame-clock?.now ?? 0ns)

────────────────────
+ do wait

=? if is-done
. signal = Semaphore()
waiters += signal
signal.wait()

────────────────────
+ do cancel

=? if is-done
owner.frame-clock?.cancel(this)
complete(owner.frame-clock?.now)

────────────────────
+ do ease-back

=? if is-done
is-done = true
owner.frame-clock?.cancel(this)
ease-out()
signal()

────────────────────
+ do release

ease-out()

────────────────────
_ do ease-out

. now = owner.frame-clock?.now ?? 0ns
for index in 0 .. < entries.length
    . entry = entries[index]
    . shown = entry.shown()
    entry.remove-layer(layers[index])
    if shown
        entry.ease-from(shown, now)
    else
        entry.release(now)

────────────────────
_ do complete
    - now Duration?

is-done = true
for index in 0 .. < entries.length
    entries[index].remove-layer(layers[index])
for entry in entries
    entry.release(now)
signal()

────────────────────
_ do signal

host.play-ended(this)
for waiter in waiters
    waiter.post()
waiters = List'Semaphore()

────────────────────
_ do iterations Size?

match animation.repeat
    |= .forever
        = null
    | .times(count)
        = max(count, 1)
    ??
        = 1

────────────────────
_ do step Bool
    - elapsed Duration
    - now Duration

. span = animation.duration
. spans = (span as Seconds) as F64
. total = iterations()
. turn = if spans > 0 then floor(((elapsed as Seconds) as F64) / spans) as Int else 0
. last = if total then total - 1 else turn
. finished = total != null && turn > last
. iteration = if finished then last else turn
. into = if finished then elapsed - span * last else elapsed - span * iteration
. reversed = is-reversed(iteration)
. moving = false
for index in 0 .. < tracks.length
    . track = tracks[index]
    . layer = layers[index]
    . entry = entries[index]
    . open = entry.open-vector(layer)
    if open
        . local = if reversed then (if into < span then span - into else 0ns) else into
        . values = layer.values ?? List'F64()
        layer.values = values
        if track.fill(values, local, span, style-motion-precision, open) && !reversed
            moving = true
    entry.present(now)
= !finished || moving

────────────────────
_ do is-reversed Bool
    - iteration Int

match animation.direction
    |= .reverse
        = true
    |= .alternate
        = iteration % 2 == 1
    |= .alternate-reverse
        = iteration % 2 == 0
    ??
        = false

╌╌╌╌╌╌╌╌╌╌ is FrameAnimation ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do advance Bool
    - tick FrameTick

=? false if is-done
=? true if step(if tick.elapsed > delay then tick.elapsed - delay else 0ns, tick.now)
if owner.is-leaving
    is-done = true
    host.hold(this)
    signal()
    = false
complete(tick.now)
= false

────────────────────
+ do finish

=? if is-done
complete(owner.frame-clock?.now)
