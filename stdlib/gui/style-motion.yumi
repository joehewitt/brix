+ gui-style-motion := GUIStyleMotion()

_ style-motion-precision = 0.001
_ style-motion-quiet-domains = ["paint", "presentation", "composite", "vector-composite"]

_ style-motion-transform-group = ["translate", "scale", "rotate", "transform"]
_ style-motion-adding = ["translate", "rotate"]
_ style-motion-watched = ["animation", "enter-space", "match", "timeline"]
_ style-motion-scaling = ["scale", "opacity"]

━━━━━━━━━━━━━━━━━━━━
