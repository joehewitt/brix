(import ./box)
(import ./events)
(import ./keys)
(import ./primitives)
(import ./shorthands)
(import ./styles)
(import ./theme)
(import ./window)
(import /data/json)
(import /graphics/point)
(import /graphics/primitives)
(import /math)
(import /ui/app-state)
(import /ui/input)
(import /ui/key-combo)
(blank)
(prop + resizer-reach Length (= 8))
(prop _ resizer-small-step Length (= 8))
(prop _ resizer-large-step Length (= 32))

(style-extend GUIDefaultTheme
  (using GUIBoxComposite)
  (using GUIBoxMotion)
  (using GUIBoxPlacement)
  (using GUIFocusRingStyle)
  (rule Resizer (• absolute)
    (= anchor (. Anchor parent))
    (= layer "handles")
    (blank)
    (when-style #is-focus-visible
      (= focus-ring gui-focus-ring)
      (= (. motion focus-ring) gui-motion-quick)
    )
  )
)

(type + Resizer (is Box)
  (rule This
    (= focus-mode (. FocusMode keys))
  )
  (blank)
  (prop + edge _ (= (. Side right)))
  (prop + min-size Length (= 120))
  (prop + max-size Length (= 640))
  (prop + size (? Length))
  (prop + default-size (? Length))
  (prop + collapse-size (? Length))
  (prop + state-key (? String))
  (prop + is-horizontal _ (= (or (== #edge (. Side left)) (== #edge (. Side right)))))
  (prop + grows-forward _ (=> (or (== edge (. Side right)) (== edge (. Side bottom)))))
  (event + collapse-requested Resizer)
  (event + resized Length)
  (blank)
  (prop _ start-size Length (= 0))
  (prop _ natural-size (? Length))
  (blank)
  (depends size-changed size edge)
  (content
    (<> This
      (= left (call resizer-offset #edge (. Side left)))
      (= right (call resizer-offset #edge (. Side right)))
      (= top (call resizer-offset #edge (. Side top)))
      (= bottom (call resizer-offset #edge (. Side bottom)))
      (= min-width (if-expr #is-horizontal (call (. SizeSpec coord) resizer-reach) (. SizeSpec auto)))
      (= max-width (if-expr #is-horizontal (call (. SizeSpec coord) resizer-reach) (. SizeSpec auto)))
      (= min-height (if-expr #is-horizontal (. SizeSpec auto) (call (. SizeSpec coord) resizer-reach)))
      (= max-height (if-expr #is-horizontal (. SizeSpec auto) (call (. SizeSpec coord) resizer-reach)))
      (= cursor (if-expr #is-horizontal (. CursorStyle resize-horizontal) (. CursorStyle resize-vertical)))
      (= drag-cursor (if-expr #is-horizontal (. CursorStyle resize-horizontal) (. CursorStyle resize-vertical)))
      (<> KeyShortcut (text: "Grow")
        (= key (call resizer-grow-key #edge))
        (= discoverable false)
        (= action (=> () :do (call nudge resizer-small-step)))
      )
      (<> KeyShortcut (text: "Shrink")
        (= key (call resizer-grow-key (. #edge opposite)))
        (= discoverable false)
        (= action (=> () :do (call nudge (- resizer-small-step))))
      )
      (<> KeyShortcut (text: "Grow more")
        (= key (+ (. KeyModifier shift) (call resizer-grow-key #edge)))
        (= discoverable false)
        (= action (=> () :do (call nudge resizer-large-step)))
      )
      (<> KeyShortcut (text: "Shrink more")
        (= key (+ (. KeyModifier shift) (call resizer-grow-key (. #edge opposite))))
        (= discoverable false)
        (= action (=> () :do (call nudge (- resizer-large-step))))
      )
      (<> KeyShortcut (text: "Smallest")
        (= key .home)
        (= discoverable false)
        (= action (=> () :do (call resize-to min-size)))
      )
      (<> KeyShortcut (text: "Largest")
        (= key .end)
        (= discoverable false)
        (= action (=> () :do (call resize-to max-size)))
      )
      (<> KeyShortcut (text: "Reset size")
        (= key .enter)
        (= discoverable false)
        (= action (=> () :do (call reset-size)))
      )
    )
  )
  (prop _ gesture _
    (machine
      (state idle)
      (blank)
      (state dragging (trigger for press pointer-down (and (== (. press button) (. PointerButton primary)) (< (. press click-count) 2) (!= target null)))
        (call note-natural-size)
        (= start-size (call current-size (!! target)))
        (blank)
        (for (on drag pointer-drag (when (and (== (. drag pointer-id) (. press pointer-id)) (not (call collapses (call dragged-size press drag))))))
          (= size (call max min-size (call min max-size (call dragged-size press drag))))
          (call (. drag cancel))
        )
        (blank)
        (then (call collapsed (. press pointer-id)) (trigger for drag pointer-drag (and (== (. drag pointer-id) (. press pointer-id)) (call collapses (call dragged-size press drag))))
          (call (. drag cancel))
          (= size start-size)
          (<- collapse-requested this)
        )
        (blank)
        (then idle (trigger for up pointer-up (== (. up pointer-id) (. press pointer-id)))
          (call (. up cancel))
          (call save-size)
          (call announce-size)
        )
      )
      (blank)
      (state (call collapsed pointer-id)
        (for (on drag pointer-drag (when (== (. drag pointer-id) pointer-id)))
          (call (. drag cancel))
        )
        (blank)
        (then idle (trigger for up pointer-up (== (. up pointer-id) pointer-id))
          (call (. up cancel))
        )
      )
    )
  )
  (subscribe-for (on press pointer-down (when (and (== (. press button) (. PointerButton primary)) (>= (. press click-count) 2) (!= target null))))
    (call reset-size)
    (call (. press cancel))
  )
  (subscribe-for (on event drag-start)
    (call (. event cancel))
  )
  (fn-expr + target _ :get
    (match? layout-parent
      (case (: box Box)
        box
      )
    )
  )
  (fn-do + mounted _
    (call (. super mounted))
    (call restore-size)
    (call size-changed)
  )
  (fn-do + reset-size _
    (let length (?? default-size natural-size))
    (if length
      (call resize-to length)
    )
  )
  (fn-do + resize-to _
    (param length Length)
    (call note-natural-size)
    (= size (call max min-size (call min max-size length)))
    (call save-size)
    (call announce-size)
  )
  (fn-do _ nudge _
    (param delta Length)
    (let box target)
    (return-if (if (not box)))
    (blank)
    (call resize-to (+ (?? size (call current-size box)) delta))
  )
  (fn-expr _ dragged-size Length
    (param press PointerDownEvent)
    (param drag PointerDragEvent)
    (if-expr grows-forward (+ start-size delta) (- start-size delta))
    (where
      (lazy delta (- (call coordinate (. drag root-point)) (call coordinate (. press root-point))))
    )
  )
  (fn-expr _ collapses Bool
    (param grown Length)
    (and (!= collapse-size null) (< grown collapse-size))
  )
  (fn-expr _ store (? AppState) :get
    (call gui-app-state this)
  )
  (fn-expr _ storage-key (? String) :get
    (only-if (str "resizer:" state-key) (if state-key))
  )
  (fn-do _ restore-size _
    (let key storage-key)
    (let found store)
    (return-if (if (or (not key) (not found))))
    (blank)
    (let saved (call (. found read) key 2))
    (return-if (if (not saved)))
    (blank)
    (let fields (catch? (call (. (call JSONReader "resizer" saved) object))))
    (return-if (if (not fields)))
    (blank)
    (let length (catch? (call (. ([] fields "size") number))))
    (let natural (catch? (call (. ([] fields "natural") number))))
    (if (!= natural null)
      (= natural-size (as natural Length))
    )
    (if (!= length null)
      (= size (call max min-size (call min max-size (as length Length))))
    )
  )
  (fn-do _ save-size _
    (let key storage-key)
    (let found store)
    (let length size)
    (return-if (if (or (not key) (not found) (not length))))
    (blank)
    (let entry
      (call (of Map String JSON)
        (block
          (entry "size" (as length F64))
        )
      )
    )
    (if natural-size
      (= ([] entry "natural") (as natural-size F64))
    )
    (call (. found write) key 2 entry)
  )
  (fn-do _ announce-size _
    (let length size)
    (if length
      (<- resized length)
    )
  )
  (fn-do _ note-natural-size _
    (return-if (if (or natural-size size)))
    (blank)
    (let box target)
    (if box
      (= natural-size (call current-size box))
    )
  )
  (fn-expr _ current-size Length
    (param box Box)
    (case? is-horizontal
      (- (. box bounds width) (. edges left) (. edges right))
    )
    (default
      (- (. box bounds height) (. edges top) (. edges bottom))
    )
    (where
      (lazy edges (. box border-edges))
    )
  )
  (fn-expr _ coordinate Length
    (param point Point)
    (if-expr is-horizontal (. point x) (. point y))
  )
  (fn-do _ size-changed _
    (let box target)
    (let value size)
    (return-if (if (or (not box) (not value))))
    (blank)
    (let spec (call (. SizeSpec coord) value))
    (if is-horizontal
      (= (. box min-width) spec)
      (= (. box max-width) spec)
      (else
        (= (. box min-height) spec)
        (= (. box max-height) spec)
      )
    )
  )
)

(fn-do + gui-app-state (? AppState)
  (param box Box)
  (let host (. box window))
  (return-if (if (not host)))
  (return (?. (. (as host Window) app) state))
)

(fn-expr _ resizer-offset _
  (param edge Side)
  (param side Side)
  (case? (== side edge)
    (call (. PositionOffset coord) (/ (- resizer-reach) 2))
  )
  (case? (== side (. edge opposite))
    null
  )
  (default
    (call (. PositionOffset coord) 0)
  )
)

(fn-expr _ resizer-grow-key KeyCombo
  (param edge Side)
  (match edge
    (case (. Side left)
      (call KeyCombo (. Key arrow-left))
    )
    (case (. Side top)
      (call KeyCombo (. Key arrow-up))
    )
    (case (. Side bottom)
      (call KeyCombo (. Key arrow-down))
    )
    (default
      (call KeyCombo (. Key arrow-right))
    )
  )
)
