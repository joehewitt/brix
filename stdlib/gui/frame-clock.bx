(import ./motion-scope)
(import /core/markup)
(import /stream/aggregate)
(import /time/duration)

(type + FrameTick (is Tuple)
  (prop + now Nanoseconds)
  (prop + delta Nanoseconds)
  (prop + elapsed Nanoseconds)
)

(type + FrameAnimation (is Interface)
  (fn-do + advance Bool
    (param tick FrameTick)
  )
  (fn-do + finish _)
)

(type + FrameClockHost (is Interface)
  (fn-do + request-clock-frame _)
)

(type + FrameOwner (is Interface)
  (fn-expr + frame-clock (? FrameClock) :get)
)

(type + FrameClock
  (prop + host FrameClockHost)
  (prop + now Nanoseconds (= 0ns))
  (prop + interval Nanoseconds (= 16666667ns))
  (prop + time-scale _ (= 1.0))
  (blank)
  (prop _ animators _ (= (call (of List FrameAnimator))))
  (prop _ display-time (? Nanoseconds))
  (prop _ was-running _ (= false))
  (fn-do + This _
    (param host _)
  )
  (fn-expr + is-running Bool :get
    (> (. animators length) 0)
  )
  (fn-do + start _
    (param owner (? FrameOwner))
    (param animation FrameAnimation)
    (param frame-rate (? F64) (= null))
    (let running (call animator-of animation))
    (if running
      (= (. running frame-rate) frame-rate)
      (call (. running restart))
      (call (. host request-clock-frame))
      (return)
    )
    (let started (call FrameAnimator owner animation))
    (= (. started frame-rate) frame-rate)
    (+= animators started)
    (call (. host request-clock-frame))
  )
  (fn-expr + next-due Nanoseconds
    (if-expr (or (not was-running) (not previous) (<= wanted 0ns)) 0ns (- (+ previous wanted) (/ interval 2)))
    (where
      (lazy wanted (call wanted-interval))
      (lazy previous display-time)
    )
  )
  (fn-do + cancel _
    (param animation FrameAnimation)
    (= (?. (call animator-of animation) is-done) true)
  )
  (fn-expr + is-animating Bool
    (param animation FrameAnimation)
    (!= (call animator-of animation) null)
  )
  (fn-do + wait _
    (param span Duration)
    (let done (call (of Completion Bool)))
    (let waiting (call FrameWait span done))
    (call start null waiting)
    (finally
      (call cancel waiting)
    )
    (call (. done await))
  )
  (fn-do + tick _
    (param display Nanoseconds)
    (param refresh Nanoseconds)
    (if (> refresh 0ns)
      (= interval refresh)
    )
    (let previous (?? display-time display))
    (return-if (if (and was-running (> display previous) (< (+ (- display previous) (/ interval 2)) (call wanted-interval)))))
    (= display-time display)
    (let real (if-expr (and was-running (> display previous)) (- display previous) interval))
    (call step (* real time-scale))
  )
  (fn-do + advance _
    (param span Duration)
    (call step (as span Nanoseconds))
  )
  (fn-do + finish-all _
    (let running animators)
    (= animators (call (of List FrameAnimator)))
    (= was-running false)
    (for (in animator running)
      (if (not (. animator is-done))
        (= (. animator is-done) true)
        (call (. animator animation finish))
      )
    )
  )
  (fn-do _ animator-of (? FrameAnimator)
    (param animation FrameAnimation)
    (for (in animator animators)
      (return-if animator (if (and (not (. animator is-done)) (== (as (. animator animation) Pointer) (as animation Pointer)))))
    )
    (return null)
  )
  (fn-do _ wanted-interval Nanoseconds
    (let fastest 0.0)
    (for (in animator animators)
      (if (not (. animator is-done))
        (let rate (. animator frame-rate))
        (return-if 0ns (if (or (not rate) (<= rate 0))))
        (if (> rate fastest)
          (= fastest rate)
        )
      )
    )
    (return-if 0ns (if (<= fastest 0)))
    (return (as (/ 1 fastest) Seconds))
  )
  (fn-do _ step _
    (param delta Nanoseconds)
    (+= now delta)
    (let outer (call swap-markup-cause markup-cause-none))
    (let running animators)
    (let count (. running length))
    (for (in index (..< 0 count))
      (let animator ([] running index))
      (if (not (. animator is-done))
        (call advance-animator animator delta)
      )
    )
    (call swap-markup-cause outer)
    (let kept Size 0)
    (for (in index (..< 0 (. animators length)))
      (let animator ([] animators index))
      (if (not (. animator is-done))
        (= ([] animators kept) animator)
        (+= kept 1)
      )
    )
    (call (. animators remove) kept (- (. animators length) kept))
    (= was-running (> (. animators length) 0))
  )
  (fn-do _ advance-animator _
    (param animator FrameAnimator)
    (param delta Nanoseconds)
    (if (not (call (. animator is-attached) this))
      (= (. animator is-done) true)
      (call (. animator animation finish))
      (return)
    )
    (let started (?? (. animator started) (- now delta)))
    (let last (?? (. animator last) started))
    (= (. animator started) started)
    (= (. animator last) now)
    (let restarts (. animator restarts))
    (let keeps (call (. animator animation advance) (call FrameTick now (- now last) (- now started))))
    (if (and (not keeps) (== (. animator restarts) restarts))
      (= (. animator is-done) true)
    )
  )
)

(type _ FrameAnimator
  (prop + owner (? FrameOwner))
  (prop + animation FrameAnimation)
  (prop + started (? Nanoseconds))
  (prop + last (? Nanoseconds))
  (prop + restarts Size (= 0))
  (prop + is-done _ (= false))
  (prop + frame-rate (? F64) (= null))
  (fn-do + This _
    (param owner _)
    (param animation _)
  )
  (fn-expr + is-attached Bool
    (param clock FrameClock)
    (case? (not owner)
      true
    )
    (case? (not attached)
      false
    )
    (default
      (== (as attached Pointer) (as clock Pointer))
    )
    (where
      (lazy attached (. owner frame-clock))
    )
  )
  (fn-do + restart _
    (= started null)
    (= last null)
    (+= restarts 1)
  )
)

(type _ FrameWait
  (implements FrameAnimation)
  (prop + span Nanoseconds)
  (prop + done (of Completion Bool))
  (fn-do + This _
    (param span _)
    (param done _)
  )
  (fn-do + advance Bool
    (param tick FrameTick)
    (return-if true (if (< (. tick elapsed) span)))
    (call finish)
    (return false)
  )
  (fn-do + finish _
    (return-if (if (. done is-finished)))
    (call (. done finish) true)
  )
)

(type + FrameTicks
  (implements (of Usable Void))
  (implements FrameAnimation)
  (prop + owner FrameOwner)
  (blank)
  (prop _ is-wanted _ (= false))
  (blank)
  (delegate (of Broadcastable FrameTick))
  (prop _ ticks _ (:= (call (of AsyncOnDemandChannel FrameTick) this)))
  (fn-do + This _
    (param owner _)
  )
  (fn-do + resume _
    (return-if (if (not is-wanted)))
    (let clock (. owner frame-clock))
    (return-if (if (or (not clock) (call (. clock is-animating) this))))
    (call (. clock start) owner this)
  )
  (fn-do + begin-using _
    (= is-wanted true)
    (call resume)
  )
  (fn-do + end-using _
    (= is-wanted false)
    (call (?. (. owner frame-clock) cancel) this)
  )
  (fn-do + advance Bool
    (param tick FrameTick)
    (return-if false (if (not is-wanted)))
    (let outer (call swap-markup-cause gui-instant-cause))
    (finally
      (call swap-markup-cause outer)
    )
    (<- ticks tick)
    (return is-wanted)
  )
  (fn-do + finish _)
)
