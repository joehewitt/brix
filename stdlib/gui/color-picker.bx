(import ./box)
(import ./events)
(import ./painter)
(import ./plane-slider)
(import ./position)
(import ./primitives)
(import ./shorthands)
(import ./slider)
(import ./styles)
(import ./text-input)
(import ./theme)
(import /core/markup)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/gradient)
(import /graphics/pattern)
(import /graphics/point)
(import /graphics/primitives)
(import /math)
(import /ui/value-change-phase)
(blank)
(prop + color-picker-checker-cell Length (= 5))
(prop + channel-slider-thumb-size Length (= 16))
(prop + channel-slider-ring-width Length (= 3))
(prop + color-picker-checker-light _ (= (call RGBA "#ffffff")))
(prop + color-picker-checker-dark _ (= (call RGBA "#cccccc")))

(style-extend GUIDefaultTheme
  (using GUIBoxPaint)
  (using GUIBoxPlacement)
  (using GUIBoxSize)
  (using GUIBoxSpacing)
  (rule ColorPicker
    (rule color-picker-slider (• h (+ channel-slider-thumb-size (* channel-slider-ring-width 2))) (• mt 12))
    (blank)
    (rule color-picker-fields (• h 28) (• mt 12))
    (blank)
    (rule color-picker-opacity (• w 64) (• ml 8))
  )
  (blank)
  (rule ChannelSlider
    (= corner-radius slider-pill-radius)
    (blank)
    (rule SliderTrack
      (= corner-radius slider-pill-radius)
      (= min-height (. SizeSpec auto))
      (= max-height (. SizeSpec auto))
      (= left (call (. PositionOffset coord) 0))
      (= right (call (. PositionOffset coord) 0))
      (= top (call (. PositionOffset coord) 0))
      (= bottom (call (. PositionOffset coord) 0))
      (= align-y null)
    )
    (blank)
    (rule SliderFill
      (= display (. Display hidden))
    )
    (blank)
    (rule SliderThumb (• bg null) (• w channel-slider-thumb-size) (• h channel-slider-thumb-size)
      (= border-color gui-knob-color)
      (= border-width channel-slider-ring-width)
      (= corner-radius slider-pill-radius)
    )
  )
)

(type + ChannelSlider (is Slider)
  (prop + track-painter (? Painter))
  (prop + thumb-color (? RGBA))
  (blank)
  (depends channel-changed track-painter thumb-color)
  (fn-do + mounted _
    (call (. super mounted))
    (call channel-changed)
  )
  (fn-do _ channel-changed _
    (= (. track background) track-painter)
    (= (. thumb-slot swatch) thumb-color)
  )
)

(type + ColorPicker (is Box)
  (prop + color _ (= (call RGBA 1 0 0)))
  (prop + checker-light _ (= color-picker-checker-light))
  (prop + checker-dark _ (= color-picker-checker-dark))
  (blank)
  (event + value-changing (of ValueChange RGBA))
  (event + value-changed (of ValueChange RGBA))
  (blank)
  (prop _ sv-plane PlaneSlider)
  (prop _ hue-slider ChannelSlider)
  (prop _ alpha-slider ChannelSlider)
  (prop _ hex-input TextInput)
  (prop _ opacity-input TextInput)
  (prop _ hue F64)
  (prop _ saturation F64 (= 1))
  (prop _ brightness F64 (= 1))
  (prop _ alpha F64 (= 1))
  (prop _ published-color (? RGBA))
  (prop _ hue-track _ (= (call HueTrackPainter)))
  (blank)
  (depends external-color-changed color)
  (content
    (<> This (• flex-col)
      (<> PlaneSlider (id: sv-plane) (• flex 1)
        (= value (call Point #saturation (- 1 #brightness)))
        (= plane-painter (call SaturationValuePainter #hue))
        (for (on event value-changed)
          (call accept-plane (. event value x) (. event value y) (. event phase))
        )
      )
      (blank)
      (<> ChannelSlider (id: hue-slider) (• color-picker-slider)
        (= value #hue)
        (= track-painter hue-track)
        (= thumb-color (as (call HSVA #hue 1 1) RGBA))
        (for (on event value-changed)
          (call accept-hue (. event value) (. event phase))
        )
      )
      (blank)
      (<> ChannelSlider (id: alpha-slider) (• color-picker-slider)
        (= value #alpha)
        (= track-painter (call AlphaTrackPainter (call opaque #color) #checker-light #checker-dark))
        (= thumb-color #color)
        (for (on event value-changed)
          (call accept-alpha (. event value) (. event phase))
        )
      )
      (blank)
      (<> Box (• color-picker-fields) (• flex-row)
        (<> TextInput (id: hex-input) (• flex 1)
          (= text (call hex-text #color))
          (= placeholder "RRGGBB")
          (for (on event change)
            (call accept-hex-text (. event text))
            (call (. event cancel))
          )
        )
        (blank)
        (<> TextInput (id: opacity-input) (• color-picker-opacity)
          (= text (call opacity-text #alpha))
          (= placeholder "100%")
          (for (on event change)
            (call accept-opacity-text (. event text))
            (call (. event cancel))
          )
        )
      )
    )
  )
  (fn-do + mounted _
    (call (. super mounted))
    (call adopt-color color)
  )
  (fn-expr + measured-content-size _
    (param query MeasureQuery)
    (call Dimensions 240 280)
  )
  (fn-do _ external-color-changed _
    (return-if (if (and published-color (== (call pack-rgba8 published-color) (call pack-rgba8 color)))))
    (call adopt-color color)
  )
  (fn-do _ adopt-color _
    (param next RGBA)
    (let hsva (as next HSVA))
    (if (and (> (. hsva value) 0) (> (. hsva saturation) 0))
      (= hue (. hsva hue))
    )
    (if (> (. hsva value) 0)
      (= saturation (. hsva saturation))
    )
    (= brightness (. hsva value))
    (= alpha (call clamp-unit (. next alpha)))
    (= published-color next)
  )
  (fn-do + accept-plane _
    (param x F64)
    (param y F64)
    (param phase ValueChangePhase (= (. ValueChangePhase discrete)))
    (= saturation (call clamp-unit x))
    (= brightness (call clamp-unit (- 1 y)))
    (call publish-color phase)
  )
  (fn-do + accept-hue _
    (param next F64)
    (param phase ValueChangePhase (= (. ValueChangePhase discrete)))
    (= hue (call clamp-unit next))
    (call publish-color phase)
  )
  (fn-do + accept-alpha _
    (param next F64)
    (param phase ValueChangePhase (= (. ValueChangePhase discrete)))
    (= alpha (call clamp-unit next))
    (call publish-color phase)
  )
  (fn-do + accept-hex-text _
    (param text String)
    (let parsed (call color-input-value text alpha))
    (if (not parsed)
      (= (. hex-input text) (call hex-text color))
      (return)
    )
    (call adopt-color parsed)
    (call publish-color (. ValueChangePhase discrete))
  )
  (fn-do + accept-opacity-text _
    (param text String)
    (let parsed (call parse-opacity-text text))
    (if (not parsed)
      (= (. opacity-input text) (call opacity-text alpha))
      (return)
    )
    (call accept-alpha parsed)
  )
  (fn-do _ publish-color _
    (param phase ValueChangePhase)
    (let old color)
    (let next (as (call HSVA hue saturation brightness alpha) RGBA))
    (let changed (!= (call pack-rgba8 old) (call pack-rgba8 next)))
    (if changed
      (let change (call (of ValueChange RGBA) old next phase))
      (<- value-changing change)
      (if (. change is-canceled)
        (call adopt-color old)
        (return)
      )
    )
    (= published-color next)
    (= color next)
    (return-if (if (and (not changed) (or (== phase (. ValueChangePhase discrete)) (== phase (. ValueChangePhase changed))))))
    (<- value-changed (call (of ValueChange RGBA) old next phase))
  )
)

(fn-expr + hex-text _
  (param color RGBA)
  (. ([] (as color Hex) (..< 1 7)) uppercased)
)

(fn-expr + opacity-text _
  (param alpha F64)
  (str (as (call round (* (call clamp-unit alpha) 100)) Int) "%")
)

(fn-expr + parse-opacity-text _
  (param text String)
  (match? text
    (~ (seq (* \ws) (! "-") (: percent (of \dec F64)) (* \ws) (? "%") (* \ws) (! .))
      (/ percent 100)
    )
  )
)

(fn-expr _ opaque _
  (param color RGBA)
  (call RGBA (. color red) (. color green) (. color blue))
)

(type + SaturationValuePainter (is Painter)
  (prop + hue F64)
  (fn-do + This _
    (param hue _)
  )
  (fn-do + paint _
    (param node Box)
    (param rect Rect)
    (param canvas Canvas)
    (return-if (if (or (<= (. rect width) 0) (<= (. rect height) 0))))
    (let across (call linear-gradient (. rect left-center) (. rect right-center) white (call RGBA 1 1 1 0)))
    (let down (call linear-gradient (. rect top-center) (. rect bottom-center) transparent black))
    (do-use (. canvas saved-state)
      (= (. canvas stroke-color) null)
      (= (. canvas fill-color) (as (call HSVA hue 1 1) RGBA))
      (call (. canvas rect) rect)
      (call (. canvas fill-gradient) rect across)
      (call (. canvas fill-gradient) rect down)
    )
  )
)

(type + HueTrackPainter (is Painter)
  (fn-do + paint _
    (param node Box)
    (param rect Rect)
    (param canvas Canvas)
    (return-if (if (or (<= (. rect width) 0) (<= (. rect height) 0))))
    (let inset (/ (call min (. rect height) (. rect width)) 2))
    (let start (call Point (+ (. rect x) inset) (+ (. rect y) (/ (. rect height) 2))))
    (let end (call Point (- (. rect right) inset) (+ (. rect y) (/ (. rect height) 2))))
    (call (. canvas fill-gradient) rect (call LinearGradient start end (call hue-spectrum-stops)))
  )
)

(type + AlphaTrackPainter (is Painter)
  (prop + color RGBA)
  (prop + checker-light RGBA)
  (prop + checker-dark RGBA)
  (fn-do + This _
    (param color _)
    (param checker-light _ (= color-picker-checker-light))
    (param checker-dark _ (= color-picker-checker-dark))
  )
  (fn-do + paint _
    (param node Box)
    (param rect Rect)
    (param canvas Canvas)
    (return-if (if (or (<= (. rect width) 0) (<= (. rect height) 0))))
    (call fill-checkerboard canvas rect color-picker-checker-cell checker-light checker-dark)
    (let inset (/ (call min (. rect height) (. rect width)) 2))
    (let start (call Point (+ (. rect x) inset) (+ (. rect y) (/ (. rect height) 2))))
    (let end (call Point (- (. rect right) inset) (+ (. rect y) (/ (. rect height) 2))))
    (let clear (call (. color with-alpha) 0))
    (call (. canvas fill-gradient) rect (call linear-gradient start end clear color))
  )
)

(type + ColorSwatchPainter (is Painter)
  (prop + color RGBA)
  (prop + checker-light RGBA)
  (prop + checker-dark RGBA)
  (fn-do + This _
    (param color _)
    (param checker-light _ (= color-picker-checker-light))
    (param checker-dark _ (= color-picker-checker-dark))
  )
  (fn-do + paint _
    (param node Box)
    (param rect Rect)
    (param canvas Canvas)
    (return-if (if (or (<= (. rect width) 0) (<= (. rect height) 0))))
    (if (< (. color alpha) 1)
      (call fill-checkerboard canvas rect color-picker-checker-cell checker-light checker-dark)
    )
    (do-use (. canvas saved-state)
      (= (. canvas stroke-color) null)
      (= (. canvas fill-color) color)
      (call (. canvas rect) rect)
    )
  )
)

(fn-expr + color-input-value _
  (param text String)
  (param alpha F64)
  (match? source
    (~ (seq (: input \rgb-function) (! .))
      (if-expr (. input has-alpha) (. input color) (call (. input color with-alpha) alpha))
    )
    (~ (seq (: color RGBA) (! .))
      (if-expr (or (== (. source length) 4) (== (. source length) 7)) (call (. color with-alpha) alpha) color)
    )
  )
  (where
    (lazy trimmed (call (. text trim)))
    (lazy source (if-expr (or (call (. trimmed starts-with) "#") (call (. trimmed starts-with) "rgb")) trimmed (str "#" trimmed)))
  )
)
