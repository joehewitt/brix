; benchmark.meta description: Incremental retained bytes per mounted Label over a plain Box at 1k/10k/100k with regression slope.
; benchmark.meta timing: not-recommended
; benchmark.meta profiles: gui,compile-timing
(blank)
(import /BxGC/BxGC.h)
(import /core/markup)
(import /graphics/primitives)
(import /gui/box)
(import /gui/label)
(blank)
(prop _ measured-mounted Size (= 0))
(prop _ measured-laidout Size (= 0))
(prop _ measured-objects Size (= 0))
(prop _ measured-boxes Size (= 0))
(prop _ measured-lane0 Size (= 0))
(prop _ measured-lane1 Size (= 0))
(prop _ measured-lane2 Size (= 0))
(prop _ measured-lane3 Size (= 0))
(blank)

(main
  (let xs (list F64))
  (let mounted-ys (list F64))
  (let laidout-ys (list F64))
  (let checksum Size 0)
  (blank)
  (call measure-variant "plain" 1000)
  (let plain-mounted-1k measured-mounted)
  (let plain-laidout-1k measured-laidout)
  (let plain-objects-1k measured-objects)
  (+= checksum measured-boxes)
  (call measure-variant "label" 1000)
  (let label-mounted-1k measured-mounted)
  (let label-laidout-1k measured-laidout)
  (let label-objects-1k measured-objects)
  (+= checksum measured-boxes)
  (let diff-mounted-1k (- label-mounted-1k plain-mounted-1k))
  (let diff-laidout-1k (- label-laidout-1k plain-laidout-1k))
  (let diff-objects-1k (- label-objects-1k plain-objects-1k))
  (probe-count gui.bench.memory.mounted-bytes-1k diff-mounted-1k)
  (probe-count gui.bench.memory.objects-1k diff-objects-1k)
  (+= xs 1000.0)
  (+= mounted-ys (as diff-mounted-1k F64))
  (+= laidout-ys (as diff-laidout-1k F64))
  (blank)
  (call measure-variant "plain" 10000)
  (let plain-mounted-10k measured-mounted)
  (let plain-laidout-10k measured-laidout)
  (let plain-objects-10k measured-objects)
  (+= checksum measured-boxes)
  (call measure-variant "label" 10000)
  (let label-mounted-10k measured-mounted)
  (let label-laidout-10k measured-laidout)
  (let label-objects-10k measured-objects)
  (+= checksum measured-boxes)
  (let diff-mounted-10k (- label-mounted-10k plain-mounted-10k))
  (let diff-laidout-10k (- label-laidout-10k plain-laidout-10k))
  (let diff-objects-10k (- label-objects-10k plain-objects-10k))
  (probe-count gui.bench.memory.mounted-bytes-10k diff-mounted-10k)
  (probe-count gui.bench.memory.objects-10k diff-objects-10k)
  (+= xs 10000.0)
  (+= mounted-ys (as diff-mounted-10k F64))
  (+= laidout-ys (as diff-laidout-10k F64))
  (blank)
  (call measure-variant "plain" 100000)
  (let plain-mounted-100k measured-mounted)
  (let plain-laidout-100k measured-laidout)
  (let plain-objects-100k measured-objects)
  (+= checksum measured-boxes)
  (call measure-variant "label" 100000)
  (let label-mounted-100k measured-mounted)
  (let label-laidout-100k measured-laidout)
  (let label-objects-100k measured-objects)
  (+= checksum measured-boxes)
  (let diff-mounted-100k (- label-mounted-100k plain-mounted-100k))
  (let diff-laidout-100k (- label-laidout-100k plain-laidout-100k))
  (let diff-objects-100k (- label-objects-100k plain-objects-100k))
  (probe-count gui.bench.memory.mounted-bytes-100k diff-mounted-100k)
  (probe-count gui.bench.memory.objects-100k diff-objects-100k)
  (+= xs 100000.0)
  (+= mounted-ys (as diff-mounted-100k F64))
  (+= laidout-ys (as diff-laidout-100k F64))
  (blank)
  (+= checksum measured-lane3)
  (probe-count gui.bench.memory.lane0-delta measured-lane0)
  (probe-count gui.bench.memory.lane1-delta measured-lane1)
  (probe-count gui.bench.memory.lane2-delta measured-lane2)
  (probe-count gui.bench.memory.lane3-delta measured-lane3)
  (blank)
  (let label-slope (call slope-of xs mounted-ys))
  (let label-slope-bytes (as label-slope Size))
  (probe-count gui.bench.memory.label-slope-bytes label-slope-bytes)
  (blank)
  (print (str "bench-result gui/memory-slope-label checksum=" checksum))
)

(fn-do + settle-live Size
  (call C:brixCollect)
  (call C:brixCollect)
  (return (as (call C:brixGCLiveByteCount) Size))
)

(fn-do + slope-of F64
  (param xs (list F64))
  (param ys (list F64))
  (let n (as (. xs length) F64))
  (let sum-x F64)
  (let sum-y F64)
  (let sum-xy F64)
  (let sum-xx F64)
  (for (in index (..< 0 (. xs length)))
    (let x ([] xs index))
    (let y ([] ys index))
    (+= sum-x x)
    (+= sum-y y)
    (+= sum-xy (* x y))
    (+= sum-xx (* x x))
  )
  (return (/ (- (* n sum-xy) (* sum-x sum-y)) (- (* n sum-xx) (* sum-x sum-x))))
)

(fn-do + measure-variant _
  (param variant String)
  (param cell-count Size)
  (let live0 (call settle-live))
  (let objects0 (call C:brixGCAllocatedObjectCount))
  (let lane0-before (call C:brixGCObjectSidePayloadCount 0))
  (let lane1-before (call C:brixGCObjectSidePayloadCount 1))
  (let lane2-before (call C:brixGCObjectSidePayloadCount 2))
  (let lane3-before (call C:brixGCObjectSidePayloadCount 3))
  (blank)
  (let root (call BenchRoot))
  (call markup-mount-root root root)
  (let rows (/ cell-count 100))
  (let total-boxes Size 1)
  (for (in row-index (..< 0 rows))
    (if (== variant "plain")
      (let row (call PlainRow))
      (call markup-append root row)
      (for (in cell-index (..< 0 100))
        (call markup-append row (call Box))
      )
      (+= total-boxes 101)
      (else-if (== variant "label")
        (let row (call PlainRow))
        (call markup-append root row)
        (for (in cell-index (..< 0 100))
          (let label (call Label))
          (= (. label text) (str "cell " cell-index))
          (call markup-append row label)
        )
        (+= total-boxes 101)
      )
    )
  )
  (blank)
  (call (. root markup-batch-queue checkpoint))
  (let live-mounted (call settle-live))
  (call (. root layout) (call Rect 0 0 1200 800))
  (let live-laid-out (call settle-live))
  (blank)
  (= measured-mounted (- live-mounted live0))
  (= measured-laidout (- live-laid-out live0))
  (= measured-objects (as (- (call C:brixGCAllocatedObjectCount) objects0) Size))
  (= measured-boxes total-boxes)
  (= measured-lane0 (as (- (call C:brixGCObjectSidePayloadCount 0) lane0-before) Size))
  (= measured-lane1 (as (- (call C:brixGCObjectSidePayloadCount 1) lane1-before) Size))
  (= measured-lane2 (as (- (call C:brixGCObjectSidePayloadCount 2) lane2-before) Size))
  (= measured-lane3 (as (- (call C:brixGCObjectSidePayloadCount 3) lane3-before) Size))
  (blank)
  (call (. root close))
  (call markup-release root)
)

(type + BenchRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(type + PlainRow (is Box))
