; benchmark.meta description: CoreGraphics and Metal per-frame time for full-damage, partial-damage, and idle retained-scene modes over a settled 1k-box tree in a real never-shown native window.
; benchmark.meta timing: recommended
; benchmark.meta profiles: gui,gui-metal,compile-timing
(blank)
(import /BxAppleGUI/BxAppleGUI.h)
(import /core/markup)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/primitives)
(import /gui/box)
(import /gui/layout)
(import /gui/metal)
(import /gui/primitives)
(import /gui/scene)
(import /stream/sort)
(import /time/timer)
(blank)

(main
  (let root (call ReuseRoot))
  (call markup-mount-root root root)
  (let target (? ReuseCell))
  (for (in row-index (..< 0 10))
    (let row (call ReuseRow))
    (call markup-append root row)
    (for (in cell-index (..< 0 100))
      (let cell (call ReuseCell))
      (if (and (== row-index 5) (== cell-index 50))
        (= target cell)
      )
      (call markup-append row cell)
    )
  )
  (call (. root markup-batch-queue checkpoint))
  (call (. root layout) (call Rect 0 0 1180 800))
  (blank)
  (let native (call C:brixGuiWindowCreate "gui bench surface-modes (offscreen)" 1180 800))
  (let scale (call C:brixGuiWindowGetBackingScaleFactor native))
  (let background (call RGBA 1 1 1 1))
  (let frames Size 30)
  (let surface (call RasterCanvas 1180 800 scale background))
  (let scene (call DisplayScene scale background))
  (blank)
  ; warm up
  (for (in warm (..< 0 3))
    (call (. root sync-native-geometry))
    (call (. scene maintain) root scale background)
    (call (. scene add-damage) (. root bounds))
    (call (. scene frame) surface)
    (call C:brixGuiWindowCommitFrame
      (block
        (arg native)
        (arg (. surface native))
        (arg (. scene last-frame-damage x))
        (arg (. scene last-frame-damage y))
        (arg (. scene last-frame-damage width))
        (arg (. scene last-frame-damage height))
      )
    )
  )
  (blank)
  ; mode 1: replay the full retained surface
  (let full-damage-ns (list U64))
  (for (in frame (..< 0 frames))
    (let t0 (call monotonic-time-nanoseconds))
    (call (. root sync-native-geometry))
    (call (. scene maintain) root scale background)
    (call (. scene add-damage) (. root bounds))
    (call (. scene frame) surface)
    (call C:brixGuiWindowCommitFrame
      (block
        (arg native)
        (arg (. surface native))
        (arg (. scene last-frame-damage x))
        (arg (. scene last-frame-damage y))
        (arg (. scene last-frame-damage width))
        (arg (. scene last-frame-damage height))
      )
    )
    (let t1 (call monotonic-time-nanoseconds))
    (+= full-damage-ns (- t1 t0))
  )
  (blank)
  ; mode 2: replay only one cell's retained damage
  (let partial-damage-ns (list U64))
  (for (in frame (..< 0 frames))
    (let t2 (call monotonic-time-nanoseconds))
    (call (. root sync-native-geometry))
    (call (. scene maintain) root scale background)
    (call (. scene add-damage) (. (!! target) bounds))
    (call (. scene frame) surface)
    (call C:brixGuiWindowCommitFrame
      (block
        (arg native)
        (arg (. surface native))
        (arg (. scene last-frame-damage x))
        (arg (. scene last-frame-damage y))
        (arg (. scene last-frame-damage width))
        (arg (. scene last-frame-damage height))
      )
    )
    (let t3 (call monotonic-time-nanoseconds))
    (+= partial-damage-ns (- t3 t2))
  )
  (blank)
  ; mode 3: maintain and decline a settled frame with no damage
  (let idle-ns (list U64))
  (for (in frame (..< 0 frames))
    (let t4 (call monotonic-time-nanoseconds))
    (call (. root sync-native-geometry))
    (call (. scene maintain) root scale background)
    (let replay-count (. scene frames-replayed))
    (call (. scene frame) surface)
    (if (!= (. scene frames-replayed) replay-count)
      (call C:brixGuiWindowCommitFrame
        (block
          (arg native)
          (arg (. surface native))
          (arg (. scene last-frame-damage x))
          (arg (. scene last-frame-damage y))
          (arg (. scene last-frame-damage width))
          (arg (. scene last-frame-damage height))
        )
      )
    )
    (let t5 (call monotonic-time-nanoseconds))
    (+= idle-ns (- t5 t4))
  )
  (blank)
  (let full-damage-p50 (call percentile-us full-damage-ns 50))
  (let full-damage-p95 (call percentile-us full-damage-ns 95))
  (let full-damage-p99 (call percentile-us full-damage-ns 99))
  (let full-damage-min (call min-us full-damage-ns))
  (probe-count gui.bench.surface.full-damage-p50-us full-damage-p50)
  (probe-count gui.bench.surface.full-damage-p95-us full-damage-p95)
  (probe-count gui.bench.surface.full-damage-p99-us full-damage-p99)
  (probe-count gui.bench.surface.full-damage-min-us full-damage-min)
  (blank)
  (let partial-damage-p50 (call percentile-us partial-damage-ns 50))
  (let partial-damage-p95 (call percentile-us partial-damage-ns 95))
  (let partial-damage-p99 (call percentile-us partial-damage-ns 99))
  (let partial-damage-min (call min-us partial-damage-ns))
  (probe-count gui.bench.surface.partial-damage-p50-us partial-damage-p50)
  (probe-count gui.bench.surface.partial-damage-p95-us partial-damage-p95)
  (probe-count gui.bench.surface.partial-damage-p99-us partial-damage-p99)
  (probe-count gui.bench.surface.partial-damage-min-us partial-damage-min)
  (blank)
  (let idle-p50 (call percentile-us idle-ns 50))
  (let idle-p95 (call percentile-us idle-ns 95))
  (let idle-p99 (call percentile-us idle-ns 99))
  (let idle-min (call min-us idle-ns))
  (probe-count gui.bench.surface.idle-p50-us idle-p50)
  (probe-count gui.bench.surface.idle-p95-us idle-p95)
  (probe-count gui.bench.surface.idle-p99-us idle-p99)
  (probe-count gui.bench.surface.idle-min-us idle-min)
  (blank)
  (let metal-renderer (call MetalOffscreenRenderer 1180 800 scale background))
  (let metal-scene (call DisplayScene scale background metal-renderer))
  (let metal-full-damage-ns (list U64))
  (let metal-partial-damage-ns (list U64))
  (let metal-idle-ns (list U64))
  (do-use metal-renderer
    ; warm the Metal consumer and its reusable packet/resource rings
    (for (in warm (..< 0 3))
      (call (. root sync-native-geometry))
      (call (. metal-scene maintain) root scale background)
      (call (. metal-scene add-damage) (. root bounds))
      (call (. metal-scene frame-metal) metal-renderer)
    )
    (blank)
    ; mode 1: encode and submit the full retained scene
    (for (in frame (..< 0 frames))
      (let t6 (call monotonic-time-nanoseconds))
      (call (. root sync-native-geometry))
      (call (. metal-scene maintain) root scale background)
      (call (. metal-scene add-damage) (. root bounds))
      (call (. metal-scene frame-metal) metal-renderer)
      (let t7 (call monotonic-time-nanoseconds))
      (+= metal-full-damage-ns (- t7 t6))
    )
    (blank)
    ; mode 2: encode and submit one cell's retained damage
    (for (in frame (..< 0 frames))
      (let t8 (call monotonic-time-nanoseconds))
      (call (. root sync-native-geometry))
      (call (. metal-scene maintain) root scale background)
      (call (. metal-scene add-damage) (. (!! target) bounds))
      (call (. metal-scene frame-metal) metal-renderer)
      (let t9 (call monotonic-time-nanoseconds))
      (+= metal-partial-damage-ns (- t9 t8))
    )
    (blank)
    ; mode 3: maintain and decline a settled Metal frame with no damage
    (for (in frame (..< 0 frames))
      (let t10 (call monotonic-time-nanoseconds))
      (call (. root sync-native-geometry))
      (call (. metal-scene maintain) root scale background)
      (call (. metal-scene frame-metal) metal-renderer)
      (let t11 (call monotonic-time-nanoseconds))
      (+= metal-idle-ns (- t11 t10))
    )
    (call (. metal-renderer finish))
    (call (. metal-scene close))
  )
  (blank)
  (let metal-full-damage-p50 (call percentile-us metal-full-damage-ns 50))
  (let metal-full-damage-p95 (call percentile-us metal-full-damage-ns 95))
  (let metal-full-damage-p99 (call percentile-us metal-full-damage-ns 99))
  (let metal-full-damage-min (call min-us metal-full-damage-ns))
  (probe-count gui.bench.surface.metal-full-damage-p50-us metal-full-damage-p50)
  (probe-count gui.bench.surface.metal-full-damage-p95-us metal-full-damage-p95)
  (probe-count gui.bench.surface.metal-full-damage-p99-us metal-full-damage-p99)
  (probe-count gui.bench.surface.metal-full-damage-min-us metal-full-damage-min)
  (blank)
  (let metal-partial-damage-p50 (call percentile-us metal-partial-damage-ns 50))
  (let metal-partial-damage-p95 (call percentile-us metal-partial-damage-ns 95))
  (let metal-partial-damage-p99 (call percentile-us metal-partial-damage-ns 99))
  (let metal-partial-damage-min (call min-us metal-partial-damage-ns))
  (probe-count gui.bench.surface.metal-partial-damage-p50-us metal-partial-damage-p50)
  (probe-count gui.bench.surface.metal-partial-damage-p95-us metal-partial-damage-p95)
  (probe-count gui.bench.surface.metal-partial-damage-p99-us metal-partial-damage-p99)
  (probe-count gui.bench.surface.metal-partial-damage-min-us metal-partial-damage-min)
  (blank)
  (let metal-idle-p50 (call percentile-us metal-idle-ns 50))
  (let metal-idle-p95 (call percentile-us metal-idle-ns 95))
  (let metal-idle-p99 (call percentile-us metal-idle-ns 99))
  (let metal-idle-min (call min-us metal-idle-ns))
  (probe-count gui.bench.surface.metal-idle-p50-us metal-idle-p50)
  (probe-count gui.bench.surface.metal-idle-p95-us metal-idle-p95)
  (probe-count gui.bench.surface.metal-idle-p99-us metal-idle-p99)
  (probe-count gui.bench.surface.metal-idle-min-us metal-idle-min)
  (blank)
  (call (. scene close))
  (call (. surface close))
  (call C:brixGuiWindowClose native)
  (call C:brixGuiWindowRelease native)
  (call (. root close))
  (call markup-release root)
  (blank)
  (let checksum (+ (* frames 6) 1000))
  (print (str "bench-result gui/surface-modes checksum=" checksum))
)

(fn-expr + percentile-us _
  (param values (list U64))
  (param percentile Size)
  (case? (not values)
    0
  )
  (default
    (/ ([] sorted index) 1000)
  )
  (where
    (lazy sorted (call sort values (:using (=> (left right) (if-expr (< left right) .lesser .greater)))))
    (lazy index (/ (* (- (. sorted length) 1) percentile) 100))
  )
)

(fn-expr + min-us _
  (param values (list U64))
  (case? (not values)
    0
  )
  (default
    (/ ([] sorted 0) 1000)
  )
  (where
    (lazy sorted (call sort values (:using (=> (left right) (if-expr (< left right) .lesser .greater)))))
  )
)

(type + ReuseRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (rule This
    (= layout flow-col)
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(type + ReuseRow (is Box)
  (rule This
    (= layout flow-row)
  )
)

(type + ReuseCell (is Box)
  (rule This (• bg "#8080e6")
    (= min-width (call (. SizeSpec coord) 11))
    (= min-height (call (. SizeSpec coord) 80))
    (= max-width (call (. SizeSpec coord) 11))
    (= max-height (call (. SizeSpec coord) 80))
  )
)
