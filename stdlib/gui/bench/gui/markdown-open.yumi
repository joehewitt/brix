`benchmark.meta description: Opens a 3,000-block Markdown document in the WYSIWYG editor three times, framing the first display through the retained scene.
`benchmark.meta timing: recommended
`benchmark.meta profiles: gui,compile-timing

/gui/bench/fixtures/markdown-bench-fixture

. checksum Size = 0
for round in 0 .. < 3
    . bench = MarkdownBench(markdown-bench-document(markdown-bench-sections), "Section 0")
    checksum += bench.session.text.length
    bench.close()

-- "bench-result gui/markdown-open checksum=$checksum"
