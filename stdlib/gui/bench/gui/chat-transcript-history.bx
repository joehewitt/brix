; benchmark.meta description: Opens a 300-message chat transcript at its end and scrolls to the first message by wheel steps for the first time, framing each step.
; benchmark.meta timing: recommended
; benchmark.meta profiles: gui,compile-timing
(blank)
(import /gui/bench/fixtures/chat-transcript-bench-fixture)
(blank)

(main
  (let checksum (call run-chat-transcript-history))
  (blank)
  (print (str "bench-result gui/chat-transcript-history checksum=" checksum))
)

(fn-do + run-chat-transcript-history Size
  (let bench (call ChatTranscriptBench chat-bench-long-turns))
  (let checksum (call (. bench show) (. bench chat)))
  (let steps Size)
  (while (and (> (. bench scroller scroll-y) 0) (< steps 4000))
    (+= checksum (call (. bench scroll) (- chat-bench-wheel-step)))
    (+= steps 1)
  )
  (call (. bench close))
  (return checksum)
)
