`benchmark.meta description: Native font-cache misses while mounting and painting 200 labels across regular and bold system fonts.
`benchmark.meta timing: not-recommended
`benchmark.meta profiles: gui,compile-timing

/core/markup
/graphics/canvas
/graphics/primitives
/graphics/text
/gui/box
/gui/label
/gui/layout

. label-count Size = 200
. root = FontGridRoot()
markup-mount-root(root, root)
. rows = label-count / 20
for row-index in 0 .. < rows
    . row = FontGridRow()
    markup-append(root, row)
    for cell-index in 0 .. < 20
        . label Label
        if cell-index >= 10
            label = BoldFontLabel()
        label.text = "row $row-index cell $cell-index"
        markup-append(row, label)
root.markup-batch-queue.checkpoint()

. font-created0 = text-font-created-count()
. canvas = RasterCanvas(1200, 800, 2)
do use canvas
    root.layout(Rect(0, 0, 1200, 800))
    root.paint(canvas)
. fonts-created = text-font-created-count() - font-created0

//gui.bench.text.fonts-created += fonts-created
//gui.bench.text.font-labels += label-count
. checksum = fonts-created + label-count

root.close()
markup-release(root)

-- "bench-result gui/label-font-churn checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ FontGridRoot is Box
    is MarkupRootElement

+ markup-batch-queue := MarkupBatchQueue(this)

• This
    layout = flow-col

────────────────────
+ do markup-batch-did-flush
    - flush MarkupBatchFlush

. ignored = flush.applied

━━━━━━━━━━━━━━━━━━━━
+ FontGridRow is Box

• This
    layout = flow-row

━━━━━━━━━━━━━━━━━━━━
+ BoldFontLabel is Label

• This
    font-weight = FontWeight.bold
