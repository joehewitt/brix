; benchmark.meta description: Retained bytes and build allocations for plain boxes, empty VectorImages, styled VectorImages, one-path VectorImages, and Lucide icons.
; benchmark.meta timing: not-recommended
; benchmark.meta profiles: gui,compile-timing
(blank)
(import /BxGC/BxGC.h)
(import /core/markup)
(import /graphics/color)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/style)
(import /graphics/vector)
(import /gui/box)
(import /gui/icons/lucide/activity)
(import /gui/vector-image)
(blank)

(main
  (let item-count Size 1000)
)

(prop _ measured-live Size)
(prop _ measured-objects Size)

(main
  (let checksum Size)
  (blank)
  (call measure-unmounted "box" item-count)
  (probe-count gui.bench.vector-memory.unmounted-box-bytes measured-live)
  (probe-count gui.bench.vector-memory.unmounted-box-objects measured-objects)
  (+= checksum measured-live)
  (blank)
  (call measure-unmounted "empty" item-count)
  (probe-count gui.bench.vector-memory.unmounted-empty-bytes measured-live)
  (probe-count gui.bench.vector-memory.unmounted-empty-objects measured-objects)
  (+= checksum measured-live)
  (blank)
  (call measure-variant "box" item-count)
  (probe-count gui.bench.vector-memory.box-bytes measured-live)
  (probe-count gui.bench.vector-memory.box-objects measured-objects)
  (+= checksum measured-live)
  (blank)
  (call measure-variant "empty" item-count)
  (probe-count gui.bench.vector-memory.empty-bytes measured-live)
  (probe-count gui.bench.vector-memory.empty-objects measured-objects)
  (+= checksum measured-live)
  (blank)
  (call measure-variant "styled" item-count)
  (probe-count gui.bench.vector-memory.styled-bytes measured-live)
  (probe-count gui.bench.vector-memory.styled-objects measured-objects)
  (+= checksum measured-live)
  (blank)
  (call measure-variant "path" item-count)
  (probe-count gui.bench.vector-memory.path-bytes measured-live)
  (probe-count gui.bench.vector-memory.path-objects measured-objects)
  (+= checksum measured-live)
  (blank)
  (call measure-variant "lucide" item-count)
  (probe-count gui.bench.vector-memory.lucide-bytes measured-live)
  (probe-count gui.bench.vector-memory.lucide-objects measured-objects)
  (+= checksum measured-live)
  (blank)
  (print (str "bench-result gui/vector-image-memory checksum=" checksum))
)

(fn-do + settle-live Size
  (call C:brixCollect)
  (call C:brixCollect)
  (return (as (call C:brixGCLiveByteCount) Size))
)

(fn-do + measure-unmounted _
  (param variant String)
  (param count Size)
  (let live0 (call settle-live))
  (let objects0 (call C:brixGCAllocatedObjectCount))
  (let values (list Box))
  (for (in index (..< 0 count))
    (if (== variant "box")
      (+= values (call Box))
      (else
        (+= values (call VectorImage))
      )
    )
  )
  (let live1 (call settle-live))
  (= measured-live (/ (- live1 live0) count))
  (= measured-objects (as (/ (- (call C:brixGCAllocatedObjectCount) objects0) count) Size))
  (+= measured-live (- (. values length) count))
)

(fn-do + measure-variant _
  (param variant String)
  (param count Size)
  (let live0 (call settle-live))
  (let objects0 (call C:brixGCAllocatedObjectCount))
  (let root (call BenchRoot))
  (call markup-mount-root root root)
  (for (in index (..< 0 count))
    (if (== variant "box")
      (call markup-append root (call Box))
      (else-if (== variant "empty")
        (call markup-append root (call VectorImage))
      )
      (else-if (== variant "styled")
        (call markup-append root (call BenchStyledVector))
      )
      (else-if (== variant "path")
        (call markup-append root (call BenchPathVector))
      )
      (else
        (call markup-append root (call LucideActivity))
      )
    )
  )
  (call (. root markup-batch-queue checkpoint))
  (let live1 (call settle-live))
  (= measured-live (/ (- live1 live0) count))
  (= measured-objects (as (/ (- (call C:brixGCAllocatedObjectCount) objects0) count) Size))
  (call (. root close))
  (call markup-release root)
)

(type + BenchRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
    (let ignored (. flush applied))
  )
)

(type + BenchStyledVector (is VectorImage)
  (fn-do + This _
    (= view-box (call Rect 0 0 24 24))
  )
  (content
    (<> This
      (= fill (. Fill none))
      (= stroke black)
      (= stroke-width 2)
    )
  )
)

(type + BenchPathVector (is VectorImage)
  (fn-do + This _
    (= view-box (call Rect 0 0 24 24))
  )
  (content
    (<> This
      (= fill (. Fill none))
      (= stroke black)
      (= stroke-width 2)
      (blank)
      (<> VectorPath
        (= d
          (block
            (item (call M 2 2))
            (item (call L 22 22))
          )
        )
      )
    )
  )
)
