; benchmark.meta description: Opens a 3,000-block Markdown document in the WYSIWYG editor three times, framing the first display through the retained scene.
; benchmark.meta timing: recommended
; benchmark.meta profiles: gui,compile-timing
(blank)
(import /gui/bench/fixtures/markdown-bench-fixture)
(blank)

(main
  (let checksum Size 0)
  (for (in round (..< 0 3))
    (let bench (call MarkdownBench (call markdown-bench-document markdown-bench-sections) "Section 0"))
    (+= checksum (. bench session text length))
    (call (. bench close))
  )
  (blank)
  (print (str "bench-result gui/markdown-open checksum=" checksum))
)
