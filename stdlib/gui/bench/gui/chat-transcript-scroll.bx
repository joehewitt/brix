; benchmark.meta description: Scrolls an 80-message chat transcript end to end by wheel steps after every message has been shown once, framing each step.
; benchmark.meta timing: recommended
; benchmark.meta profiles: gui,compile-timing
(blank)
(import /gui/bench/fixtures/chat-transcript-bench-fixture)
(blank)

(main
  (let checksum (call run-chat-transcript-scroll 4))
  (blank)
  (print (str "bench-result gui/chat-transcript-scroll checksum=" checksum))
)

(fn-do + run-chat-transcript-scroll Size
  (param sweeps Size)
  (let bench (call ChatTranscriptBench chat-bench-visited-turns))
  (let checksum (call (. bench show) (. bench chat)))
  (+= checksum (call (. bench visit) 600))
  (let distance (. bench scroller scroll-max y))
  (for (in round (..< 0 sweeps))
    (+= checksum (call (. bench sweep) distance chat-bench-wheel-step))
  )
  (call (. bench close))
  (return checksum)
)
