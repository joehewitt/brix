; benchmark.meta description: Re-records 300 canvas paths in a 1000x700pt, 2x cell and rebuilds their GPU path set on each of 120 frames with up to three frames in flight.
; benchmark.meta timing: recommended
; benchmark.meta profiles: compile-timing
(blank)
(import /core/markup)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/primitives)
(import /gui/box)
(import /gui/layout)
(import /gui/metal)
(import /gui/primitives)
(import /gui/scene)
(blank)

(main
  (let root (call BenchRoot))
  (call markup-mount-root root root)
  (let art (call ArtCell))
  (call markup-append root art)
  (call (. root markup-batch-queue checkpoint))
  (call (. root layout) (call Rect 0 0 1000 700))
  (blank)
  (let renderer (call MetalOffscreenRenderer 1000 700 2 white))
  (let scene (call DisplayScene 2 white renderer))
  (let checksum Size)
  (do-use renderer
    (call (. scene build) root)
    (call (. scene commit))
    (call (. scene frame-metal) renderer)
    (for (in frame (..< 0 120))
      (= (. art shade) (% frame 16))
      (call (. art invalidate-paint))
      (call (. scene update) root)
      (call (. scene commit))
      (call (. scene frame-metal) renderer)
      (+= checksum (. scene items-encoded))
      (call (. scene reset-frame-counters))
    )
    (call (. renderer finish))
  )
  (blank)
  (call (. scene close))
  (call (. root close))
  (call markup-release root)
  (print (str "bench-result gui/metal-tile-churn checksum=" checksum))
)

(type + BenchRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (rule This
    (= layout flow-col)
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
    (let ignored (. flush applied))
  )
)

(type + ArtCell (is Box)
  (prop + shade Size)
  (blank)
  (rule This
    (= min-width (call (. SizeSpec coord) 1000))
    (= max-width (call (. SizeSpec coord) 1000))
    (= min-height (call (. SizeSpec coord) 700))
    (= max-height (call (. SizeSpec coord) 700))
  )
  (fn-do + paint-background _
    (param canvas Canvas)
    (call (. canvas push))
    (= (. canvas stroke-color) (call RGBA 0.1 0.1 0.2 1))
    (= (. canvas stroke-width) 1)
    (for (in index (..< 0 300))
      (let column (% index 20))
      (let row (/ index 20))
      (let x (as (* column 50) F64))
      (let y (as (* row 46) F64))
      (let tone (/ (as (% (+ index shade) 16) F64) 16))
      (= (. canvas fill-color) (call RGBA tone 0.4 (- 1 tone) 1))
      (call (. canvas begin))
      (call (. canvas move) (+ x 4) (+ y 40))
      (call (. canvas curve) (+ x 10) (+ y 2) (+ x 40) (+ y 2) (+ x 46) (+ y 40))
      (call (. canvas line) (+ x 25) (+ y 28))
      (call (. canvas end) true)
    )
    (call (. canvas pop))
  )
)
