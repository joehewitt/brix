(main
  (let bench (call MarkdownBench (call markdown-bench-document markdown-bench-sections) "Section 0"))
  (let checksum (call (. bench sweep) markdown-bench-wheel-step))
  (call (. bench close))
  (blank)
  (print (str "bench-result gui/markdown-scroll checksum=" checksum))
