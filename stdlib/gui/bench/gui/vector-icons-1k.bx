; benchmark.meta description: Build, retained bytes, paint time, and vector work for 1k identical 24pt Lucide Activity icons in a real never-shown 1180x800 native window.
; benchmark.meta timing: recommended
; benchmark.meta profiles: gui,compile-timing
(blank)
(import /BxAppleGUI/BxAppleGUI.h)
(import /BxGC/BxGC.h)
(import /core/markup)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/primitives)
(import /graphics/vectorgeometry)
(import /gui/box)
(import /gui/icons/lucide/activity)
(import /gui/layout)
(import /gui/primitives)
(import /gui/vector-image)
(import /stream/sort)
(import /time/timer)
(blank)

(main
  (let icon-count Size 1000)
  (let live0 (call settle-live))
  (let build-objects0 (call C:brixGCAllocatedObjectCount))
  (let markup-before (call C:brixGCObjectSidePayloadCount (call C:brixGCMarkupAttachmentsSidePayloadLane)))
  (let style-attachments-before
    (call C:brixGCObjectSidePayloadCount
      (block
        (arg (call C:brixGCStyleAttachmentsSidePayloadLane))
      )
    )
  )
  (let style-templates-before (call C:brixGCObjectSidePayloadCount (call C:brixGCStyleTemplatesSidePayloadLane)))
  (let style-objects-before (call C:brixGCObjectSidePayloadCount (call C:brixGCStyleObjectsSidePayloadLane)))
  (let build0 (call monotonic-time-nanoseconds))
  (let root (call BenchRoot))
  (call markup-mount-root root root)
  (let remaining icon-count)
  (while (> remaining 0)
    (let row (call BenchRow))
    (call markup-append root row)
    (let in-row Size 48)
    (if (< remaining in-row)
      (= in-row remaining)
    )
    (for (in icon-index (..< 0 in-row))
      (call markup-append row (call Icon24))
    )
    (-= remaining in-row)
  )
  (call (. root markup-batch-queue checkpoint))
  (let build1 (call monotonic-time-nanoseconds))
  (let live1 (call settle-live))
  (blank)
  (let native (call C:brixGuiWindowCreate "gui bench vector-icons-1k (offscreen)" 1180 800))
  (let scale (call C:brixGuiWindowGetBackingScaleFactor native))
  (let background (call RGBA 1 1 1 1))
  (call (. root layout) (call Rect 0 0 1180 800))
  (blank)
  (for (in warm (..< 0 3))
    (call render-once root native background scale)
  )
  (blank)
  (let frames Size 30)
  (let paint-ns (list U64))
  (let paint-objects Size 0)
  (let paint-bytes Size 0)
  (for (in frame (..< 0 frames))
    (let canvas (call RasterCanvas 1180 800 scale))
    (call (. canvas erase) background)
    (let objects0 (call C:brixGCAllocatedObjectCount))
    (let bytes0 (call C:brixGCRequestedByteCount))
    (let paint0 (call monotonic-time-nanoseconds))
    (call (. root paint) canvas)
    (+= paint-objects (as (- (call C:brixGCAllocatedObjectCount) objects0) Size))
    (+= paint-bytes (as (- (call C:brixGCRequestedByteCount) bytes0) Size))
    (+= paint-ns (- (call monotonic-time-nanoseconds) paint0))
    (call C:brixGuiWindowCommitFrame native (. canvas native) 0 0 (. canvas width) (. canvas height))
    (call (. canvas close))
  )
  (blank)
  (let build-us (/ (- build1 build0) 1000))
  (let built-live-bytes-per-icon (/ (- live1 live0) icon-count))
  (let built-objects-per-icon (/ (- (call C:brixGCAllocatedObjectCount) build-objects0) icon-count))
  (let markup-per-icon
    (scope (/ (- markup-after markup-before) icon-count)
      (lazy markup-after (call C:brixGCObjectSidePayloadCount (call C:brixGCMarkupAttachmentsSidePayloadLane)))
    )
  )
  (let style-attachments-per-icon
    (scope (/ (- attachments-after style-attachments-before) icon-count)
      (lazy attachments-after (call C:brixGCObjectSidePayloadCount (call C:brixGCStyleAttachmentsSidePayloadLane)))
    )
  )
  (let style-templates-per-icon
    (scope (/ (- templates-after style-templates-before) icon-count)
      (lazy templates-after (call C:brixGCObjectSidePayloadCount (call C:brixGCStyleTemplatesSidePayloadLane)))
    )
  )
  (let style-objects-per-icon
    (scope (/ (- objects-after style-objects-before) icon-count)
      (lazy objects-after (call C:brixGCObjectSidePayloadCount (call C:brixGCStyleObjectsSidePayloadLane)))
    )
  )
  (let paint-p50-us (call percentile-us paint-ns 50))
  (let paint-p95-us (call percentile-us paint-ns 95))
  (let paint-p99-us (call percentile-us paint-ns 99))
  (let paint-min-us (call min-us paint-ns))
  (let paint-objects-per-icon (/ paint-objects frames icon-count))
  (let paint-bytes-per-icon (/ paint-bytes frames icon-count))
  (let geometry-parses-per-frame Size 0)
  (let state-pushes-per-icon Size 0)
  (let resource-table (call vector-geometry-table-for root))
  (let atlas-entries (. resource-table atlas-entry-count))
  (let atlas-bytes (. resource-table atlas-bytes))
  (blank)
  (probe-count gui.bench.vector.build-us build-us)
  (probe-count gui.bench.vector.built-live-bytes-per-icon built-live-bytes-per-icon)
  (probe-count gui.bench.vector.built-objects-per-icon built-objects-per-icon)
  (probe-count gui.bench.vector.markup-per-icon markup-per-icon)
  (probe-count gui.bench.vector.style-attachments-per-icon style-attachments-per-icon)
  (probe-count gui.bench.vector.style-templates-per-icon style-templates-per-icon)
  (probe-count gui.bench.vector.style-objects-per-icon style-objects-per-icon)
  (probe-count gui.bench.vector.paint-p50-us paint-p50-us)
  (probe-count gui.bench.vector.paint-p95-us paint-p95-us)
  (probe-count gui.bench.vector.paint-p99-us paint-p99-us)
  (probe-count gui.bench.vector.paint-min-us paint-min-us)
  (probe-count gui.bench.vector.paint-objects-per-icon paint-objects-per-icon)
  (probe-count gui.bench.vector.paint-bytes-per-icon paint-bytes-per-icon)
  (probe-count gui.bench.vector.geometry-parses-per-frame geometry-parses-per-frame)
  (probe-count gui.bench.vector.state-pushes-per-icon state-pushes-per-icon)
  (probe-count gui.bench.vector.atlas-entries atlas-entries)
  (probe-count gui.bench.vector.atlas-bytes atlas-bytes)
  (blank)
  (call C:brixGuiWindowClose native)
  (call C:brixGuiWindowRelease native)
  (call (. root close))
  (call markup-release root)
  (blank)
  (let checksum (+ icon-count frames geometry-parses-per-frame state-pushes-per-icon))
  (+= checksum (+ atlas-entries atlas-bytes))
  (print (str "bench-result gui/vector-icons-1k checksum=" checksum))
)

(fn-do + settle-live Size
  (call C:brixCollect)
  (call C:brixCollect)
  (return (as (call C:brixGCLiveByteCount) Size))
)

(fn-expr + percentile-us _
  (param values (list U64))
  (param percentile Size)
  (case? (not values)
    0
  )
  (default
    (/ ([] sorted index) 1000)
  )
  (where
    (lazy sorted (call sort values (:using (=> (left right) (if-expr (< left right) .lesser .greater)))))
    (lazy index (/ (* (- (. sorted length) 1) percentile) 100))
  )
)

(fn-expr + min-us _
  (param values (list U64))
  (case? (not values)
    0
  )
  (default
    (/ ([] sorted 0) 1000)
  )
  (where
    (lazy sorted (call sort values (:using (=> (left right) (if-expr (< left right) .lesser .greater)))))
  )
)

(fn-do + render-once _
  (param root Box)
  (param native Pointer)
  (param background RGBA)
  (param scale F64)
  (let canvas (call RasterCanvas 1180 800 scale))
  (call (. canvas erase) background)
  (call (. root paint) canvas)
  (call C:brixGuiWindowCommitFrame native (. canvas native) 0 0 (. canvas width) (. canvas height))
  (call (. canvas close))
)

(type + BenchRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (rule This
    (= layout flow-col)
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
    (let ignored (. flush applied))
  )
)

(type + BenchRow (is Box)
  (rule This
    (= layout flow-row)
  )
)

(type + Icon24 (is LucideActivity)
  (rule This
    (= min-width (call (. SizeSpec coord) 24))
    (= max-width (call (. SizeSpec coord) 24))
    (= min-height (call (. SizeSpec coord) 24))
    (= max-height (call (. SizeSpec coord) 24))
  )
  (content
    (<> This
      (= stroke "#334155")
    )
  )
)
