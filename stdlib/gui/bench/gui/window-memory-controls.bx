; benchmark.meta description: Opens a 1200x820 window of 40 labels and 40 buttons, lets it settle for 7 seconds, and records the footprint and its GPU, surface, malloc and collector parts while the window is still open.
; benchmark.meta timing: not-recommended
; benchmark.meta profiles: memory
(blank)
(import /BxAppleGUI/BxAppleGUI.h)
(import /BxCore/BxCore.h)
(import /stdlib.h)
(import /core/markup)
(import /graphics/primitives)
(import /gui/app)
(import /gui/button)
(import /gui/label)
(import /gui/window)
(blank)

(main
  (let app (call App))
  (let window (call Window))
  (= (. window size) (call Dimensions 1200 820))
  (+= app window)
  (let checksum (as 0 Size))
  (for (in index (..< 0 40))
    (let text (str "Setting number " index))
    (call markup-append window (call Label text))
    (call markup-append window (call Button (str "Apply " index)))
    (+= checksum (. text length))
  )
  (call (. window open))
  (call C:brixGuiAppScheduleStop (!! (. app native)) 7000000000)
  (call C:brixGuiAppRun (!! (. app native)))
  (call C:brixBenchRecordProcessMemory)
  (print (str "bench-result gui/window-memory-controls checksum=" checksum))
  (call C:exit 0)
)
