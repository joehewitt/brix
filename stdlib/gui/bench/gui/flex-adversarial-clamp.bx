; benchmark.meta description: Reverse-ordered equal-weight cap construction versus a one-pass clamp control at 4k flex children.
; benchmark.meta timing: not-recommended
; benchmark.meta profiles: gui,compile-timing
(blank)
(import /BxGC/BxGC.h)
(import /core/markup)
(import /graphics/primitives)
(import /gui/box)
(import /gui/layout)
(import /gui/primitives)
(import /gui/shorthands)
(import /math)
(import /stream/sort)
(import /time/timer)
(blank)
(prop _ layout-visits Size (= 0))
(prop _ checksum Size (= 0))
(blank)

(main
  (call clamp-scenarios 4000 9)
  (blank)
  (print (str "bench-result gui/flex-adversarial-clamp checksum=" checksum))
)

(fn-do + clamp-scenarios _
  (param fanout Size)
  (param iterations Size)
  ; Place each cap between successive shares, then reverse child order so each newly
  ; clamped child occurs before the prior pass's sweep position.
  (let available 900.0)
  (let caps (list Float))
  (let remaining available)
  (let previous-share Float)
  (for (in index (..< 0 fanout))
    (let share (/ remaining (as (- fanout index) Float)))
    (let cap
      (block
        (case? (== index 0)
          (* share 1.1)
        )
        (default
          (/ (+ share previous-share) 2)
        )
      )
    )
    (+= caps cap)
    (-= remaining cap)
    (= previous-share share)
  )
  (blank)
  (call measure-clamp caps fanout iterations true)
  (blank)
  ; Control: every cap is violated by the initial proposal, so the loop settles in one pass.
  (let first-share (/ available (as fanout Float)))
  (let one-pass-caps (list Float))
  (for (in index (..< 0 fanout))
    (+= one-pass-caps (* first-share 1.5))
  )
  (call measure-clamp one-pass-caps fanout iterations false)
)

(fn-do + measure-clamp _
  (param caps (list Float))
  (param fanout Size)
  (param iterations Size)
  (param is-adversarial Bool)
  (let root (call ClampRoot))
  (call markup-mount-root root root)
  (let cells (list ClampCell))
  (for (in index (..< 0 fanout))
    (let cell (call ClampCell))
    (= (. cell cap) ([] caps (- fanout 1 index)))
    (+= cells cell)
    (call markup-append root cell)
  )
  (call (. root markup-batch-queue checkpoint))
  (call (. root layout) (call Rect 0 0 1200 900))
  (blank)
  (let clamped-count Size 0)
  (for (in index (..< 0 fanout))
    (if (< (call abs (- (. ([] cells index) bounds height) ([] caps (- fanout 1 index)))) 0.01)
      (+= clamped-count 1)
    )
  )
  (throw (call Panic "flex clamp construction did not clamp every child") (if (!= clamped-count fanout)))
  (blank)
  (let times (list U64))
  (let objects Size 0)
  (let bytes Size 0)
  (for (in iteration (..< 0 iterations))
    (call (. root invalidate-layout))
    (= layout-visits 0)
    (let objects0 (call C:brixGCAllocatedObjectCount))
    (let bytes0 (call C:brixGCRequestedByteCount))
    (let time0 (call monotonic-time-nanoseconds))
    (call (. root update-layout))
    (let time1 (call monotonic-time-nanoseconds))
    (+= times (- time1 time0))
    (= objects (as (- (call C:brixGCAllocatedObjectCount) objects0) Size))
    (= bytes (as (- (call C:brixGCRequestedByteCount) bytes0) Size))
  )
  (blank)
  (let p50 (call percentile-us times 50))
  (let p95 (call percentile-us times 95))
  (if is-adversarial
    (probe-count gui.bench.flex-clamp.adversarial.clamped clamped-count)
    (probe-count gui.bench.flex-clamp.adversarial.layout-visits layout-visits)
    (probe-count gui.bench.flex-clamp.adversarial.objects objects)
    (probe-count gui.bench.flex-clamp.adversarial.bytes bytes)
    (probe-count gui.bench.flex-clamp.adversarial.p50-us p50)
    (probe-count gui.bench.flex-clamp.adversarial.p95-us p95)
    (else
      (probe-count gui.bench.flex-clamp.one-pass.clamped clamped-count)
      (probe-count gui.bench.flex-clamp.one-pass.layout-visits layout-visits)
      (probe-count gui.bench.flex-clamp.one-pass.objects objects)
      (probe-count gui.bench.flex-clamp.one-pass.bytes bytes)
      (probe-count gui.bench.flex-clamp.one-pass.p50-us p50)
      (probe-count gui.bench.flex-clamp.one-pass.p95-us p95)
    )
  )
  (+= checksum (+ clamped-count layout-visits objects bytes))
  (blank)
  (call (. root close))
  (call markup-release root)
)

(fn-expr + percentile-us _
  (param values (list U64))
  (param percentile Size)
  (case? (not values)
    0
  )
  (default
    (/ ([] sorted index) 1000)
  )
  (where
    (lazy sorted (call sort values (:using (=> (left right) (if-expr (< left right) .lesser .greater)))))
    (lazy index (/ (* (- (. sorted length) 1) percentile) 100))
  )
)

(type + ClampRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (rule This
    (= layout flex-col)
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
  (fn-do + did-layout _
    (+= layout-visits 1)
    (call (. super did-layout))
  )
)

(type + ClampCell (is Box)
  (prop + cap Float)
  (blank)
  (rule This (• flex 1))
  (fn-expr + constrained-outer-main-size Length
    (param proposed Length)
    (param orient Orientation)
    (param available Length)
    (if-expr (< proposed cap) cap proposed)
  )
)
