`benchmark.meta description: Focus candidate collection, advance, reverse-order, and wrap costs over 10k focusable rows.
`benchmark.meta timing: recommended
`benchmark.meta profiles: gui,compile-timing

/BxGC/BxGC.h
/core/markup
/graphics/canvas
/graphics/color
/graphics/point
/graphics/primitives
/gui/box
/gui/events
/gui/layout
/gui/primitives
/stream/sort
/time/timer

_ checksum Size = 0

. row-count Size = 10000
. root = FocusRoot()
markup-mount-root(root, root)
. viewport = FocusViewport()
markup-append(root, viewport)
for row-index in 0 .. < row-count
    markup-append(viewport, FocusRow(row-index))
root.markup-batch-queue.checkpoint()
root.layout(Rect(0, 0, 1200, 320))

` Keep one materialized list outside the measured regions to select stable midpoint and
` endpoint probes. Every reported metric below measures the production successor walk.
. warm = root.focus-candidates()
. middle = warm[warm.length / 2]
. last = warm[warm.length - 1]

. objects0 = C:brixGCAllocatedObjectCount()
. bytes0 = C:brixGCRequestedByteCount()
. counted = focus-advance(root, middle)
. candidate-objects = C:brixGCAllocatedObjectCount() - objects0
. candidate-bytes = C:brixGCRequestedByteCount() - bytes0

. reps Size = 30
. candidate-times [U64]
for rep in 0 .. < reps
    . t0 = monotonic-time-nanoseconds()
    . candidate = focus-advance(root, middle)
    . t1 = monotonic-time-nanoseconds()
    candidate-times += t1 - t0

//gui.bench.focus.candidates-objects += candidate-objects
//gui.bench.focus.candidates-bytes += candidate-bytes
//gui.bench.focus.candidates-p50-us += percentile-us(candidate-times, 50)
//gui.bench.focus.candidates-p95-us += percentile-us(candidate-times, 95)
//gui.bench.focus.candidates-min-us += min-us(candidate-times)

. advance-times [U64]
for rep in 0 .. < reps
    . t0 = monotonic-time-nanoseconds()
    . next = focus-advance(root, middle, false)
    . t1 = monotonic-time-nanoseconds()
    advance-times += t1 - t0

//gui.bench.focus.advance-p50-ns += percentile-ns(advance-times, 50)
//gui.bench.focus.advance-min-ns += min-ns(advance-times)

. wrap-times [U64]
for rep in 0 .. < reps
    . t0 = monotonic-time-nanoseconds()
    . wrapped = focus-advance(root, last, false)
    . t1 = monotonic-time-nanoseconds()
    wrap-times += t1 - t0

//gui.bench.focus.wrap-p50-us += percentile-us(wrap-times, 50)

` Stable order checksum: one forward and backward move from the midpoint, then last-to-first wrap.
. forward = focus-advance(root, middle, false) as FocusRow?
. backward = focus-advance(root, middle, true) as FocusRow?
. wrapped = focus-advance(root, last, false) as FocusRow?
checksum += forward!.row-index + backward!.row-index + wrapped!.row-index

root.close()
markup-release(root)

-- "bench-result gui/focus-move-10k checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ focus-advance Box
    - root Box
    - current Box
    - going-backward = false

root.focus-candidate-after(current, going-backward) ?? root.focus-candidate-at-edge(going-backward)!

