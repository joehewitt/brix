`benchmark.meta description: Opens a 300-message chat transcript at its end and scrolls to the first message by wheel steps for the first time, framing each step.
`benchmark.meta timing: recommended
`benchmark.meta profiles: gui,compile-timing

/gui/bench/fixtures/chat-transcript-bench-fixture

. checksum = run-chat-transcript-history()

-- "bench-result gui/chat-transcript-history checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ do run-chat-transcript-history Size

. bench = ChatTranscriptBench(chat-bench-long-turns)
. checksum = bench.show(bench.chat)
. steps Size
while bench.scroller.scroll-y > 0 && steps < 4000
    checksum += bench.scroll(-chat-bench-wheel-step)
    steps += 1
bench.close()
= checksum
