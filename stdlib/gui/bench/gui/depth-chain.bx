; benchmark.meta description: Paint, sync, and hit-path walk timing over single-child chains of depth 100 and 1000.
; benchmark.meta timing: recommended
; benchmark.meta profiles: gui,compile-timing
(blank)
(import /BxGC/BxGC.h)
(import /core/markup)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/point)
(import /graphics/primitives)
(import /gui/box)
(import /gui/layout)
(import /gui/primitives)
(import /stream/sort)
(import /time/timer)
(blank)
(prop _ checksum Size (= 0))
(blank)

(main
  (call depth-scenario 100)
  (call depth-scenario 1000)
  (blank)
  (print (str "bench-result gui/depth-chain checksum=" checksum))
)

(fn-do + depth-scenario _
  (param depth Size)
  (let root (call ChainRoot))
  (call markup-mount-root root root)
  (let cursor Box root)
  (for (in level (..< 0 depth))
    (let next (call ChainBox))
    (call markup-append cursor next)
    (= cursor next)
  )
  (call (. root markup-batch-queue checkpoint))
  (call (. root layout) (call Rect 0 0 800 600))
  (blank)
  (let canvas (call RasterCanvas 800 600 2))
  (do-use canvas
    (call (. root paint) canvas)
    (blank)
    (let reps Size 30)
    (let paint-ns (list U64))
    (let sync-ns (list U64))
    (let hit-ns (list U64))
    (for (in rep (..< 0 reps))
      (let t0 (call monotonic-time-nanoseconds))
      (call (. root paint) canvas)
      (let t1 (call monotonic-time-nanoseconds))
      (+= paint-ns (- t1 t0))
    )
    (blank)
    (for (in rep (..< 0 reps))
      (let t2 (call monotonic-time-nanoseconds))
      (call (. root sync-native-geometry))
      (let t3 (call monotonic-time-nanoseconds))
      (+= sync-ns (- t3 t2))
    )
    (blank)
    (let path-length Size 0)
    (for (in rep (..< 0 reps))
      (let t4 (call monotonic-time-nanoseconds))
      (let path (call (. root hit-path) (call Point 5 5)))
      (let t5 (call monotonic-time-nanoseconds))
      (+= hit-ns (- t5 t4))
      (= path-length (. (!! path) frames length))
    )
    (blank)
    (let paint-p50 (call percentile-us paint-ns 50))
    (let paint-p95 (call percentile-us paint-ns 95))
    (let paint-p99 (call percentile-us paint-ns 99))
    (let paint-min (call min-us paint-ns))
    (let sync-p50 (call percentile-us sync-ns 50))
    (let sync-p95 (call percentile-us sync-ns 95))
    (let sync-p99 (call percentile-us sync-ns 99))
    (let sync-min (call min-us sync-ns))
    (let hit-p50 (call percentile-us hit-ns 50))
    (let hit-p95 (call percentile-us hit-ns 95))
    (let hit-p99 (call percentile-us hit-ns 99))
    (let hit-min (call min-us hit-ns))
    (if (== depth 100)
      (probe-count gui.bench.depth.hit-frames-100 path-length)
      (probe-count gui.bench.depth.root-walk-steps-100 0)
      (probe-count gui.bench.depth.paint-p50-us-100 paint-p50)
      (probe-count gui.bench.depth.paint-p95-us-100 paint-p95)
      (probe-count gui.bench.depth.paint-p99-us-100 paint-p99)
      (probe-count gui.bench.depth.paint-min-us-100 paint-min)
      (probe-count gui.bench.depth.sync-p50-us-100 sync-p50)
      (probe-count gui.bench.depth.sync-p95-us-100 sync-p95)
      (probe-count gui.bench.depth.sync-p99-us-100 sync-p99)
      (probe-count gui.bench.depth.sync-min-us-100 sync-min)
      (probe-count gui.bench.depth.hit-p50-us-100 hit-p50)
      (probe-count gui.bench.depth.hit-p95-us-100 hit-p95)
      (probe-count gui.bench.depth.hit-p99-us-100 hit-p99)
      (probe-count gui.bench.depth.hit-min-us-100 hit-min)
      (else
        (probe-count gui.bench.depth.hit-frames-1000 path-length)
        (probe-count gui.bench.depth.root-walk-steps-1000 0)
        (probe-count gui.bench.depth.paint-p50-us-1000 paint-p50)
        (probe-count gui.bench.depth.paint-p95-us-1000 paint-p95)
        (probe-count gui.bench.depth.paint-p99-us-1000 paint-p99)
        (probe-count gui.bench.depth.paint-min-us-1000 paint-min)
        (probe-count gui.bench.depth.sync-p50-us-1000 sync-p50)
        (probe-count gui.bench.depth.sync-p95-us-1000 sync-p95)
        (probe-count gui.bench.depth.sync-p99-us-1000 sync-p99)
        (probe-count gui.bench.depth.sync-min-us-1000 sync-min)
        (probe-count gui.bench.depth.hit-p50-us-1000 hit-p50)
        (probe-count gui.bench.depth.hit-p95-us-1000 hit-p95)
        (probe-count gui.bench.depth.hit-p99-us-1000 hit-p99)
        (probe-count gui.bench.depth.hit-min-us-1000 hit-min)
      )
    )
    (blank)
    (+= checksum (+ depth path-length))
  )
  (blank)
  (call (. root close))
  (call markup-release root)
)

(fn-expr + percentile-us _
  (param values (list U64))
  (param percentile Size)
  (case? (not values)
    0
  )
  (default
    (/ ([] sorted index) 1000)
  )
  (where
    (lazy sorted (call sort values (:using (=> (left right) (if-expr (< left right) .lesser .greater)))))
    (lazy index (/ (* (- (. sorted length) 1) percentile) 100))
  )
)

(fn-expr + min-us _
  (param values (list U64))
  (case? (not values)
    0
  )
  (default
    (/ ([] sorted 0) 1000)
  )
  (where
    (lazy sorted (call sort values (:using (=> (left right) (if-expr (< left right) .lesser .greater)))))
  )
)

(type + ChainRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (rule This
    (= layout flow-col)
    (= min-width (call (. SizeSpec coord) 600))
    (= min-height (call (. SizeSpec coord) 400))
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(type + ChainBox (is Box)
  (rule This
    (= layout flow-col)
    (= min-width (call (. SizeSpec coord) 600))
    (= min-height (call (. SizeSpec coord) 400))
  )
)
