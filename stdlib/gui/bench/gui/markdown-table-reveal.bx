(blank)
(import /gui/bench/fixtures/markdown-bench-fixture)
(blank)

(main
  (let source (call markdown-bench-table-document markdown-bench-tables markdown-bench-table-rows))
  (let checksum Size 0)
  (for (in round (..< 0 4))
    (let bench (call MarkdownBench source "Table 0" (str "| T" (+ (* round 10) 5) "-12 |")))
    (+= checksum (?? (call (. bench window editor top-line)) 0))
    (call (. bench close))
  )
  (blank)
  (print (str "bench-result gui/markdown-table-reveal checksum=" checksum))
)
