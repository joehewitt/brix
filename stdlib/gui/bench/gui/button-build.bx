; benchmark.meta description: Builds buttons, each with leading and trailing slot outlets that apply style rules.
; benchmark.meta timing: recommended
; benchmark.meta profiles: timing
(blank)
(import /core/markup)
(import /gui)
(blank)

(main
  (let count Size 5000)
  (let checksum Size 0)
  (for (in index (..< 0 count))
    (let button (call Button (str "Apply " index)))
    (+= checksum (. button title length))
  )
  (print (str "bench-result gui/button-build checksum=" checksum))
)
