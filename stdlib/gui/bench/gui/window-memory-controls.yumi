`benchmark.meta description: Opens a 1200x820 window of 40 labels and 40 buttons, lets it settle for 7 seconds, and records the footprint and its GPU, surface, malloc and collector parts while the window is still open.
`benchmark.meta timing: not-recommended
`benchmark.meta profiles: memory

/BxAppleGUI/BxAppleGUI.h
/BxCore/BxCore.h
/stdlib.h
/core/markup
/graphics/primitives
/gui/app
/gui/button
/gui/label
/gui/window

. app = App()
. window = Window()
window.size = Dimensions(1200, 820)
app += window
. checksum = 0 as Size
for index in 0 .. < 40
    . text = "Setting number $index"
    markup-append(window, Label(text))
    markup-append(window, Button("Apply $index"))
    checksum += text.length
window.open()
C:brixGuiAppScheduleStop(app.native!, 7000000000)
C:brixGuiAppRun(app.native!)
C:brixBenchRecordProcessMemory()
-- "bench-result gui/window-memory-controls checksum=$checksum"
C:exit(0)
