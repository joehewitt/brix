`benchmark.meta description: Opens a 300-message chat transcript from a short one and returns, framing each selection through the retained scene.
`benchmark.meta timing: recommended
`benchmark.meta profiles: gui,compile-timing

/gui/bench/fixtures/chat-transcript-bench-fixture

. checksum = run-chat-transcript-open(6)

-- "bench-result gui/chat-transcript-open checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ do run-chat-transcript-open Size
    - rounds Size

. bench = ChatTranscriptBench(chat-bench-long-turns)
. checksum = bench.chat.messages.length
for round in 0 .. < rounds
    checksum += bench.show(bench.chat)
    checksum += bench.show(bench.blank)
bench.close()
= checksum
