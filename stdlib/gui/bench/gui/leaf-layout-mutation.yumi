`benchmark.meta description: Layout visits, measure calls, and TextLayouts created after a single leaf layout invalidation in 1k and 10k box trees, via counting subclasses.
`benchmark.meta timing: not-recommended
`benchmark.meta profiles: gui,compile-timing

/BxGC/BxGC.h
/core/markup
/graphics/canvas
/graphics/color
/graphics/point
/graphics/primitives
/graphics/text
/gui/box
/gui/layout
/gui/primitives

_ paint-visits Size = 0
_ sync-visits Size = 0
_ measure-calls Size = 0
_ layout-visits Size = 0
_ cells-list [CountingCell]
_ checksum Size = 0

layout-scenario(1000)
layout-scenario(10000)

-- "bench-result gui/leaf-layout-mutation checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ do layout-scenario
    - cell-count Size

cells-list = List'CountingCell()
. root = build-tree(cell-count)
. canvas = RasterCanvas(1200, 900, 2)
do use canvas
    ` settle: one full paint so nothing is initially invalid
    root.paint(canvas)

    . target = cells-list[cells-list.length / 2]
    target.invalidate-layout()
    root.markup-batch-queue.checkpoint()
    reset-counters()
    . objects0 = C:brixGCAllocatedObjectCount()
    . bytes0 = C:brixGCRequestedByteCount()
    . text-layouts0 = text-layout-created-count()
    root.update-layout()
    root.sync-native-geometry()
    root.paint(canvas)
    . frame-objects = C:brixGCAllocatedObjectCount() - objects0
    . frame-bytes = C:brixGCRequestedByteCount() - bytes0
    . frame-text-layouts = text-layout-created-count() - text-layouts0

    ?! Panic("leaf layout mutation visited more than three layouts")
        if layout-visits > 3
    ?! Panic("leaf layout mutation remeasured a settled child")
        if measure-calls

    if cell-count == 1000
        //gui.bench.leaf.layout-visits-1k += layout-visits
        //gui.bench.leaf.measure-calls-1k += measure-calls
        //gui.bench.leaf.text-layouts-1k += frame-text-layouts
        //gui.bench.leaf.paint-visits-1k += paint-visits
        //gui.bench.leaf.sync-visits-1k += sync-visits
        //gui.bench.leaf.objects-1k += frame-objects
        //gui.bench.leaf.bytes-1k += frame-bytes
    else
        //gui.bench.leaf.layout-visits-10k += layout-visits
        //gui.bench.leaf.measure-calls-10k += measure-calls
        //gui.bench.leaf.text-layouts-10k += frame-text-layouts
        //gui.bench.leaf.paint-visits-10k += paint-visits
        //gui.bench.leaf.sync-visits-10k += sync-visits
        //gui.bench.leaf.objects-10k += frame-objects
        //gui.bench.leaf.bytes-10k += frame-bytes

    checksum += layout-visits * 1000 + measure-calls * 100 + paint-visits + sync-visits

root.close()
markup-release(root)

━━━━━━━━━━━━━━━━━━━━
+ do reset-counters

paint-visits = 0
sync-visits = 0
measure-calls = 0
layout-visits = 0

━━━━━━━━━━━━━━━━━━━━
+ do build-tree CountingRoot
    - cell-count Size

. root = CountingRoot()
markup-mount-root(root, root)
. rows = cell-count / 100
for row-index in 0 .. < rows
    . row = CountingRow()
    markup-append(root, row)
    for cell-index in 0 .. < 100
        . cell = CountingCell()
        cells-list += cell
        markup-append(row, cell)
root.markup-batch-queue.checkpoint()
root.layout(Rect(0, 0, 1200, 900))
= root

━━━━━━━━━━━━━━━━━━━━
+ CountingRoot is Box
    is MarkupRootElement

+ markup-batch-queue := MarkupBatchQueue(this)

• This
    layout = flow-col

────────────────────
+ do markup-batch-did-flush
    - flush MarkupBatchFlush

────────────────────
+ do paint-traversal-visit

paint-visits += 1

────────────────────
+ do sync-native-geometry-traversal-visit

sync-visits += 1

────────────────────
+ do did-layout

layout-visits += 1
super.did-layout()

