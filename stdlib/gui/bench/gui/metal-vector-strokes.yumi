    max-height = SizeSpec.coord(100)

────────────────────
+ This
    - first
    - complex
    - hairline

────────────────────
+ do paint-self
    - canvas Canvas

. table = vector-geometry-table-for(markup-batch-root)
if !handles
    for serial in first .. < first + 500
        . key = if hairline then serial + 40000 else serial * 2 + (if complex then 1 else 0)
        handles += table.intern-geometry
            - key as U64
            - => vector-strokes-geometry(serial, complex, hairline)
. origin = bounds.top-left
for serial in first .. < first + 500
    . hue = ((serial % 12) as F64) / 12
    . palette =
        * RGBA(0.2 + hue * 0.7, 0.45, 0.9 - hue * 0.6, if serial % 7 == 0 then 0.6 else 1)
        * RGBA(0.1, 0.15 + hue * 0.5, 0.3, if serial % 9 == 0 then 0.7 else 1)
        * RGBA(0.95, 0.8 - hue * 0.5, 0.2, 1)
    . x = origin.x + ((serial * 37) % 1520) as F64
    . y = origin.y + ((serial * 53) % 40) as F64
    . transform = matrix-from-translation(Point(x, y))
    if serial % 10 == 3
        . angle = ((serial % 7) as F64) * 0.23rad + 0.1rad
        transform = matrix-from-rotation(angle, Point(x + 30, y + 30)).concatenate(transform)
    canvas.fill-color = null
    canvas.stroke-color = RGBA(0.35, 0.1, 0.45, 1)
    canvas.stroke-width =
        |? hairline
            ((1 + serial % 3) as F64) * 0.15
        ??
            ((1 + serial % 4) as F64) * 0.75
    canvas.stroke-cap = if serial % 16 == 6 then LineCap.round else LineCap.square
    canvas.stroke-join = if serial % 3 == 0 then LineJoin.bevel else LineJoin.round
    . painted = table.paint-vector(handles[serial - first], canvas, palette, transform)

━━━━━━━━━━━━━━━━━━━━
_ do vector-strokes-geometry
    - serial Size
    - complex Bool
    - hairline Bool

. spans [VectorGeometrySpan]
. span = (20 + (serial * 7) % 44) as F64
. none = VectorGeometryPaint(VectorGeometryPaintRole.none, 0)
. outer = Path()
if complex
    . center = Point(6 + span * 0.5, 6 + span * 0.5)
    . petals = 48
    for petal in 0 .. < petals
        . start = (petal as F64) * 2 * π / (petals as F64)
        . step = 2 * π / (petals as F64)
        . radius = if petal % 2 == 0 then span * 0.5 else span * 0.4
        . next = if petal % 2 == 0 then span * 0.4 else span * 0.5
        . head = center + Point(cos(start) * radius, sin(start) * radius)
        . tail = center + Point(cos(start + step) * next, sin(start + step) * next)
        . bulge = span * 0.55
        if petal == 0
            outer.move-to(head)
        outer.cubic-curve-to
            - center + Point(cos(start + step / 3) * bulge, sin(start + step / 3) * bulge)
            - center + Point(cos(start + step * 2 / 3) * bulge, sin(start + step * 2 / 3) * bulge)
            - tail
else
    . lean = ((serial % 29) as F64) * 0.5
    . a = Point(6, 12)
    . b = Point(6 + span + lean, 18)
    . c = Point(6 + span * 0.4, 12 + span * 0.8 + lean * 0.5)
    outer.move-to(a)
    outer.cubic-curve-to(a + Point(span * 0.3, -span * 0.4), b + Point(-span * 0.3, -span * 0.4), b)
    outer.cubic-curve-to(b + Point(span * 0.15, span * 0.3), c + Point(0, -span * 0.3), c)
    outer.line-to(a)
if serial % 6 != 5
    outer.close()
. caps = [LineCap.butt, LineCap.round, LineCap.square]
. joins = [LineJoin.miter, LineJoin.round, LineJoin.bevel]
. fill = VectorGeometryPaint(VectorGeometryPaintRole.color, 0)
. stroke = VectorGeometryPaint(VectorGeometryPaintRole.color, 1)
. width = (1 + serial % 3) as F64
do match? serial % 20
    |? it >= 17
        width = 3
    |? it >= 14
        fill = none
        width = 2
    |? it >= 10
        stroke = none
if hairline
    width = ((1 + serial % 3) as F64) * 0.15
. inherited = serial % 8 == 6
if inherited
    spans += VectorGeometrySpan
        - outer
        - fill
        - VectorGeometryPaint(VectorGeometryPaintRole.inherit, 0)
        - null
        - null
        - null
        - FillRule.nonzero
else
    spans += VectorGeometrySpan
        - outer
        - fill
        - stroke
        - width
        - caps[serial % 3]
        - joins[(serial / 3) % 3]
        - FillRule.nonzero
if serial % 4 == 0
    . inner = Path()
    inner.move-to(Point(12, 26))
    inner.cubic-curve-to(Point(18, 18), Point(30, 18), Point(36, 26))
    inner.cubic-curve-to(Point(30, 34), Point(18, 34), Point(12, 26))
    inner.close()
    spans += VectorGeometrySpan
        - inner
        - VectorGeometryPaint(VectorGeometryPaintRole.color, 2)
        - stroke
        - if hairline then 0.2 else 1.5
        - LineCap.butt
        - LineJoin.round
        - FillRule.nonzero
= VectorGeometry(Rect(0, 0, 110, 110), Rect(0, 0, 110, 110), spans, false, inherited)

