. table = vector-geometry-table-for(markup-batch-root)
if !handles
    for serial in 0 .. < 10
        handles += table.intern-geometry((serial + 10000) as U64, => stroke-grid-geometry(serial))
. origin = bounds.top-left
for serial in 0 .. < 10
    . palette = [RGBA(0.15, 0.25, 0.6, 1), RGBA(0.95, 0.75, 0.3, 0.8)]
    . x = origin.x + ((serial % 3) * 130 + 5) as F64
    . y = origin.y + ((serial / 3) * 95 + 5) as F64
    . transform = matrix-from-translation(Point(x, y))
    if skewed
        transform = transform.shear(Dimensions(0.3, 0.15)).scale(Dimensions(0.85, 0.8))
    canvas.fill-color = null
    canvas.stroke-color = null
    . painted = table.paint-vector(handles[serial], canvas, palette, transform)

━━━━━━━━━━━━━━━━━━━━
_ do stroke-grid-geometry
    - serial Size

. spans [VectorGeometrySpan]
. none = VectorGeometryPaint(VectorGeometryPaintRole.none, 0)
. stroke = VectorGeometryPaint(VectorGeometryPaintRole.color, 0)
if serial == 9
    . shape = Path()
    shape.move-to(Point(20, 20))
    shape.cubic-curve-to(Point(60, 0), Point(100, 40), Point(80, 70))
    shape.line-to(Point(30, 75))
    shape.close()
    spans += VectorGeometrySpan
        - shape
        - VectorGeometryPaint(VectorGeometryPaintRole.color, 1)
        - stroke
        - 6
        - LineCap.butt
        - LineJoin.round
        - FillRule.nonzero
else
    . caps = [LineCap.butt, LineCap.round, LineCap.square]
    . joins = [LineJoin.miter, LineJoin.round, LineJoin.bevel]
    . path = Path()
    path.move-to(Point(15, 70))
    path.line-to(Point(35, 20))
    path.line-to(Point(55, 65))
    path.cubic-curve-to(Point(70, 10), Point(95, 10), Point(105, 60))
    spans += VectorGeometrySpan
        - path
        - none
        - stroke
        - 8
        - caps[serial % 3]
        - joins[serial / 3]
        - FillRule.nonzero
= VectorGeometry(Rect(0, 0, 120, 90), Rect(0, 0, 120, 90), spans, false, false)

