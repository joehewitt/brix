`benchmark.meta description: Five thousand filled and stroked vector items with mixed widths, caps, joins, inherited strokes, open and closed outlines, and rotations through DisplayScene on Metal at 1600x1000 and scale 2, as simple, complex, and hairline paths, plus grids of every cap and join, of inside, outside, and stacked strokes with hairline widths, and of dashes on lines, and of dashes on curves or with overlapping caps, under identity and skewing transforms, with frame CPU, GPU, stroke work, fallback, and CoreGraphics parity evidence.
`benchmark.meta timing: not-recommended
`benchmark.meta profiles: gui-metal

/core/markup
/graphics/canvas
/graphics/color
/graphics/matrix
/graphics/path
/graphics/point
/graphics/primitives
/graphics/vectorgeometry
/gui/box
/gui/layout
/gui/metal
/gui/primitives
/gui/scene
/math
/stream/sort
/time/timer

. simple = run-vector-strokes(false, false)
. complex = run-vector-strokes(true, false)
. hairline = run-vector-strokes(false, true)
. grid = run-stroke-grid()
. styles = run-stroke-panels(0)
. dash-lines = run-stroke-panels(1)
. dash-curves = run-stroke-panels(2)
//gui.bench.metal.stroke-cpu-p50-ns += simple.cpu-p50
//gui.bench.metal.stroke-gpu-p50-ns += simple.gpu-p50
//gui.bench.metal.stroke-segments += simple.segments
//gui.bench.metal.stroke-lines += simple.lines
//gui.bench.metal.stroke-pieces += simple.pieces
//gui.bench.metal.stroke-draws += simple.draws
//gui.bench.metal.stroke-overflows += simple.overflows
//gui.bench.metal.stroke-diff-ppm += simple.diff-ppm
//gui.bench.metal.stroke-detail-ppm += simple.detail-ppm
//gui.bench.metal.stroke-gross-ppm += simple.gross-ppm
//gui.bench.metal.stroke-max-delta += simple.max-delta
//gui.bench.metal.stroke-complex-cpu-p50-ns += complex.cpu-p50
//gui.bench.metal.stroke-complex-gpu-p50-ns += complex.gpu-p50
//gui.bench.metal.stroke-complex-segments += complex.segments
//gui.bench.metal.stroke-complex-lines += complex.lines
//gui.bench.metal.stroke-complex-overflows += complex.overflows
//gui.bench.metal.stroke-complex-gross-ppm += complex.gross-ppm
//gui.bench.metal.stroke-complex-max-delta += complex.max-delta
//gui.bench.metal.stroke-grid-detail-ppm += grid.detail-ppm
//gui.bench.metal.stroke-grid-gross-ppm += grid.gross-ppm
//gui.bench.metal.stroke-grid-max-delta += grid.max-delta
//gui.bench.metal.stroke-hairline-cpu-p50-ns += hairline.cpu-p50
//gui.bench.metal.stroke-hairline-gpu-p50-ns += hairline.gpu-p50
//gui.bench.metal.stroke-hairline-lines += hairline.lines
//gui.bench.metal.stroke-hairline-gross-ppm += hairline.gross-ppm
//gui.bench.metal.stroke-hairline-max-delta += hairline.max-delta
//gui.bench.metal.stroke-style-detail-ppm += styles.detail-ppm
//gui.bench.metal.stroke-style-gross-ppm += styles.gross-ppm
//gui.bench.metal.stroke-style-max-delta += styles.max-delta
//gui.bench.metal.stroke-dash-line-detail-ppm += dash-lines.detail-ppm
//gui.bench.metal.stroke-dash-line-gross-ppm += dash-lines.gross-ppm
//gui.bench.metal.stroke-dash-line-max-delta += dash-lines.max-delta
//gui.bench.metal.stroke-dash-curve-gross-ppm += dash-curves.gross-ppm
//gui.bench.metal.stroke-dash-curve-max-delta += dash-curves.max-delta
?! Panic("Vector strokes differ from CoreGraphics beyond the GR-D21 budget")
    if simple.gross-ppm > 100 || grid.gross-ppm > 100
?! Panic("Aligned, stacked, or dashed strokes differ from CoreGraphics beyond the GR-D21 budget")
    if styles.gross-ppm > 100 || dash-lines.gross-ppm > 100
. checksum = simple.segments + complex.segments + simple.pieces + grid.draws + styles.draws
checksum += dash-lines.draws + dash-curves.draws
-- "bench-result gui/metal-vector-strokes checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ VectorStrokesResult is Tuple

+ cpu-p50 U64
+ gpu-p50 U64
+ segments I64
+ lines I64
+ pieces I64
+ draws I64
+ overflows I64
+ diff-ppm I64
+ detail-ppm I64
+ gross-ppm I64
+ max-delta I64

━━━━━━━━━━━━━━━━━━━━
_ do run-vector-strokes
    - complex Bool
    - hairline Bool

. root = VectorStrokesRoot()
for band in 0 .. < 10
    markup-append(root, VectorStrokesBand(band * 500, complex, hairline))
markup-mount-root(root, root)
root.markup-batch-queue.checkpoint()
root.layout(Rect(0, 0, 1600, 1000))
. renderer = MetalOffscreenRenderer(1600, 1000, 2, white)
. scene = DisplayScene(2, white, renderer)
. reference = RasterCanvas(1600, 1000, 2, white)
. elapsed [U64]
. gpu [U64]
. result VectorStrokesResult
do use renderer
    do use reference
        scene.build(root)
        scene.commit()
        scene.frame-metal(renderer)
        renderer.finish()
        for warmup in 0 .. < 6
            scene.add-damage(root.bounds)
            scene.frame-metal(renderer)
        renderer.finish()
        for frame in 0 .. < 31
            scene.add-damage(root.bounds)
            . started = monotonic-time-nanoseconds()
            scene.frame-metal(renderer)
            elapsed += monotonic-time-nanoseconds() - started
            renderer.finish()
            if renderer.gpu-nanos >= 0
                gpu += renderer.gpu-nanos as U64
        root.paint(reference)
        result = vector-strokes-result
            - renderer
            - reference
            - vector-strokes-median(elapsed)
            - vector-strokes-median(gpu)
        vector-strokes-check(scene, renderer)
scene.close()
root.close()
markup-release(root)
= result

━━━━━━━━━━━━━━━━━━━━
_ do run-stroke-grid

. root = VectorStrokesRoot()
markup-append(root, StrokeGridPanel(false))
markup-append(root, StrokeGridPanel(true))
markup-mount-root(root, root)
root.markup-batch-queue.checkpoint()
root.layout(Rect(0, 0, 400, 800))
. renderer = MetalOffscreenRenderer(400, 800, 2, white)
. scene = DisplayScene(2, white, renderer)
. reference = RasterCanvas(400, 800, 2, white)
. result VectorStrokesResult
do use renderer
    do use reference
        scene.build(root)
        scene.commit()
        scene.frame-metal(renderer)
        renderer.finish()
        root.paint(reference)
        result = vector-strokes-result(renderer, reference, 0, 0)
        vector-strokes-check(scene, renderer)
scene.close()
root.close()
markup-release(root)
= result

━━━━━━━━━━━━━━━━━━━━
_ do vector-strokes-result
    - renderer MetalOffscreenRenderer
    - reference RasterCanvas
    - cpu-p50 U64
    - gpu-p50 U64

. diff = renderer.diff(reference, 2)
. detail = renderer.diff(reference, 10)
. gross = renderer.diff(reference, 48)
= VectorStrokesResult
    - cpu-p50
    - gpu-p50
    - renderer.fill-segments
    - renderer.fill-lines
    - renderer.fill-pieces
    - renderer.fill-draws
    - renderer.fill-overflows
    - (diff.differing-pixels * 1000000) / diff.pixel-count
    - (detail.differing-pixels * 1000000) / detail.pixel-count
    - (gross.differing-pixels * 1000000) / gross.pixel-count
    - diff.maximum-channel-delta

━━━━━━━━━━━━━━━━━━━━
_ do vector-strokes-check
    - scene DisplayScene
    - renderer MetalOffscreenRenderer

?! Panic("Vector strokes fell back to CoreGraphics tiles")
    if scene.metal-tile-fallbacks != 0
?! Panic("Vector strokes skipped Metal operations")
    if renderer.skipped-ops != 0

━━━━━━━━━━━━━━━━━━━━
_ vector-strokes-median
    - samples [U64]

sorted[sorted.length / 2]

.. sorted = sort(samples) • using :: left, right => if left < right then .lesser else .greater

