    canvas.stroke-dash = 0

━━━━━━━━━━━━━━━━━━━━
_ stroke-style-dash
    - kind Size
    - serial Size

match kind
    |= 0
        0
    |= 1
        (6 + (serial * 5) % 6) as F64
    |? serial % 4 == 3
        3
    ??
        (3 + (serial * 5) % 8) as F64

━━━━━━━━━━━━━━━━━━━━
_ do stroke-style-shape
    - shape Size

. path = Path()
do match shape
    |= 0
        path.move-to(Point(15, 20))
        path.cubic-curve-to(Point(50, 0), Point(85, 30), Point(70, 70))
        path.line-to(Point(25, 100))
        path.close()
    |= 1
        path.move-to(Point(15, 90))
        path.line-to(Point(30, 20))
        path.cubic-curve-to(Point(60, 0), Point(80, 40), Point(75, 100))
    |= 2
        path.move-to(Point(45, 5))
        path.line-to(Point(70, 100))
        path.line-to(Point(5, 40))
        path.line-to(Point(85, 40))
        path.line-to(Point(20, 100))
        path.close()
    |= 3
        path.move-to(Point(10, 90))
        path.line-to(Point(30, 20))
        path.line-to(Point(50, 90))
        path.line-to(Point(70, 20))
        path.line-to(Point(90, 90))
    |= 4
        path.move-to(Point(10, 10))
        path.line-to(Point(85, 10))
        path.line-to(Point(85, 50))
        path.line-to(Point(10, 50))
        path.close()
        path.move-to(Point(15, 65))
        path.line-to(Point(85, 105))
        path.move-to(Point(15, 105))
        path.line-to(Point(50, 75))
        path.line-to(Point(85, 80))
    |= 5
        path.move-to(Point(10, 60))
        path.cubic-curve-to(Point(25, 0), Point(45, 0), Point(50, 60))
        path.cubic-curve-to(Point(55, 120), Point(80, 120), Point(90, 60))
    ??
        path.move-to(Point(50, 10))
        path.cubic-curve-to(Point(80, 10), Point(90, 40), Point(90, 60))
        path.cubic-curve-to(Point(90, 90), Point(70, 110), Point(50, 110))
        path.cubic-curve-to(Point(25, 110), Point(10, 85), Point(10, 60))
        path.cubic-curve-to(Point(10, 30), Point(25, 10), Point(50, 10))
        path.close()
= path

━━━━━━━━━━━━━━━━━━━━
_ do stroke-style-geometry
    - kind Size
    - serial Size

. spans [VectorGeometrySpan]
. none = VectorGeometryPaint(VectorGeometryPaintRole.none, 0)
. fill = VectorGeometryPaint(VectorGeometryPaintRole.color, 1)
. stroke = VectorGeometryPaint(VectorGeometryPaintRole.color, 0)
. accent = VectorGeometryPaint(VectorGeometryPaintRole.color, 2)
. caps = [LineCap.butt, LineCap.round, LineCap.square]
. joins = [LineJoin.miter, LineJoin.round, LineJoin.bevel]
. alignments = [StrokeAlignment.inside, StrokeAlignment.outside, StrokeAlignment.center]
. cap = caps[serial % 3]
. join = joins[(serial / 3) % 3]
if kind == 0 && serial < 9
    . shape = stroke-style-shape(if serial < 3 then 0 else if serial < 6 then 1 else 2)
    . rule = if serial >= 6 then FillRule.even-odd else FillRule.nonzero
    spans += VectorGeometrySpan
        - shape
        - fill
        - stroke
        - 8
        - LineCap.round
        - LineJoin.miter
        - rule
        - alignments[serial % 3]
else if kind == 0 && serial < 11
    . shape = stroke-style-shape(0)
    spans += VectorGeometrySpan(shape, fill, none, null, null, null, FillRule.nonzero)
    spans += VectorGeometrySpan
        - shape
        - none
        - accent
        - 10
        - LineCap.butt
        - LineJoin.round
        - FillRule.nonzero
        - alignments[serial - 9]
    spans += VectorGeometrySpan
        - shape
        - none
        - stroke
        - 3
        - LineCap.butt
        - LineJoin.miter
        - FillRule.nonzero
else if kind == 0
    . widths [Length] = [0.1, 0.25, 0.4, 0.5]
    for index in 0 .. < widths.length
        . offset = (index * 25) as F64
        . hair = Path()
        hair.move-to(Point(8, 12 + offset))
        hair.cubic-curve-to(Point(35, offset - 6), Point(60, offset + 30), Point(92, 10 + offset))
        hair.line-to(Point(70, 22 + offset))
        spans += VectorGeometrySpan
            - hair
            - none
            - stroke
            - widths[index]
            - LineCap.butt
            - LineJoin.miter
            - FillRule.nonzero
else if kind == 1
    . shapes [Size] = [3, 2, 4]
    . shape = stroke-style-shape(shapes[serial % 3])
    . rule = if serial % 3 == 1 then FillRule.even-odd else FillRule.nonzero
    if serial == 9
        spans += VectorGeometrySpan
            - shape
            - fill
            - stroke
            - 6
            - LineCap.butt
            - LineJoin.miter
            - FillRule.nonzero
            - StrokeAlignment.inside
    else if serial == 10
        spans += VectorGeometrySpan
            - shape
            - fill
            - VectorGeometryPaint(VectorGeometryPaintRole.inherit, 0)
            - null
            - null
            - null
            - rule
    else
        spans += VectorGeometrySpan(shape, none, stroke, 5, cap, join, rule)
else if serial % 4 == 3
    spans += VectorGeometrySpan
        - stroke-style-shape(4)
        - none
        - stroke
        - 5
        - caps[1 + serial % 2]
        - join
        - FillRule.nonzero
else
    . shape = stroke-style-shape(if serial % 3 == 0 then 5 else if serial % 3 == 1 then 6 else 1)
    spans += VectorGeometrySpan(shape, none, stroke, 5, cap, join, FillRule.nonzero)
. inherited = kind == 1 && serial == 10
= VectorGeometry(Rect(0, 0, 100, 120), Rect(0, 0, 100, 120), spans, false, inherited)
