. table = vector-geometry-table-for(markup-batch-root)
if !handles
    for serial in 0 .. < 12
        . key = 20000 + kind * 100 + serial
        handles += table.intern-geometry(key as U64, => stroke-style-geometry(kind, serial))
. origin = bounds.top-left
for serial in 0 .. < 12
    . palette = [RGBA(0.15, 0.25, 0.6, 1), RGBA(0.95, 0.75, 0.3, 1), RGBA(0.8, 0.2, 0.3, 0.7)]
    . x = origin.x + ((serial % 4) * 100 + 5) as F64
