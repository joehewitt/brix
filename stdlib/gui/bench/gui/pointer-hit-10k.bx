; benchmark.meta description: Hit-path timing and allocation over a clipped 10k-row list.
; benchmark.meta timing: recommended
; benchmark.meta profiles: gui,compile-timing
(blank)
(import /BxGC/BxGC.h)
(import /core/markup)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/point)
(import /graphics/primitives)
(import /gui/box)
(import /gui/keys)
(import /gui/layout)
(import /gui/primitives)
(import /gui/window)
(import /stream/sort)
(import /time/timer)
(blank)
(prop _ hit-visits Size (= 0))
(prop _ checksum Size (= 0))
(blank)

(main
  (let row-count Size 10000)
  (let root (call HitRoot))
  (= (. root size) (call Dimensions 1200 320))
  (let viewport (call HitViewport))
  (call markup-append root viewport)
  (for (in row-index (..< 0 row-count))
    (call markup-append viewport (call HitRow row-index))
  )
  (call (. root open))
  (call (. root layout) (call Rect 0 0 1200 320))
  (blank)
  ; Probe over the top visible row. Near-start is the reverse-scan worst case; near-end
  ; also catches whole-list materialization when the target is close to the last sibling.
  (let point (call Point 600 10))
  (call (. viewport scroll-to) (call Point 0 100))
  (call measure-hit root point true)
  (blank)
  (call (. viewport scroll-to) (call Point 0 (- (* (as row-count F64) 8.0) 320.0)))
  (call measure-hit root point false)
  (blank)
  (call (. root close))
  (call markup-release root)
  (blank)
  (print (str "bench-result gui/pointer-hit-10k checksum=" checksum))
)

(fn-do + measure-hit _
  (param root Box)
  (param point Point)
  (param is-near-start Bool)
  (let warm (call (. root hit-path) point))
  (blank)
  (= hit-visits 0)
  (let objects0 (call C:brixGCAllocatedObjectCount))
  (let bytes0 (call C:brixGCRequestedByteCount))
  (let counted (call (. root hit-path) point))
  (let objects (- (call C:brixGCAllocatedObjectCount) objects0))
  (let bytes (- (call C:brixGCRequestedByteCount) bytes0))
  (let visits hit-visits)
  (let target-row (as (. (!! counted) target) (? HitRow)))
  (let target-index (. (!! target-row) row-index))
  (blank)
  (let reps Size 30)
  (let times (list U64))
  (for (in rep (..< 0 reps))
    (let t0 (call monotonic-time-nanoseconds))
    (let path (call (. root hit-path) point))
    (let t1 (call monotonic-time-nanoseconds))
    (+= times (- t1 t0))
  )
  (blank)
  (let p50 (call percentile-us times 50))
  (let p95 (call percentile-us times 95))
  (let low (call min-us times))
  (if is-near-start
    (probe-count gui.bench.hit.near-start-visits visits)
    (probe-count gui.bench.hit.near-start-objects objects)
    (probe-count gui.bench.hit.near-start-bytes bytes)
    (probe-count gui.bench.hit.near-start-p50-us p50)
    (probe-count gui.bench.hit.near-start-p95-us p95)
    (probe-count gui.bench.hit.near-start-min-us low)
    (else
      (probe-count gui.bench.hit.near-end-visits visits)
      (probe-count gui.bench.hit.near-end-objects objects)
      (probe-count gui.bench.hit.near-end-bytes bytes)
      (probe-count gui.bench.hit.near-end-p50-us p50)
      (probe-count gui.bench.hit.near-end-p95-us p95)
      (probe-count gui.bench.hit.near-end-min-us low)
    )
  )
  (blank)
  (+= checksum (+ target-index visits))
)

(fn-expr + percentile-us _
  (param values (list U64))
  (param percentile Size)
  (case? (not values)
    0
  )
  (default
    (/ ([] sorted index) 1000)
  )
  (where
    (lazy sorted (call sort values (:using (=> (left right) (if-expr (< left right) .lesser .greater)))))
    (lazy index (/ (* (- (. sorted length) 1) percentile) 100))
  )
)

(fn-expr + min-us _
  (param values (list U64))
  (case? (not values)
    0
  )
  (default
    (/ ([] sorted 0) 1000)
  )
  (where
    (lazy sorted (call sort values (:using (=> (left right) (if-expr (< left right) .lesser .greater)))))
  )
)

(type + HitRoot (is Window)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (rule This
    (= layout flow-col)
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
  (fn-do + ensure-native _)
  (fn-do + render Bool
    (return false)
  )
  (fn-do + schedule-render _)
)

(type + HitViewport (is Box)
  (rule This
    (= layout flow-col)
    (= overflow-y (. ScrollOverflow auto))
    (= min-height (call (. SizeSpec coord) 320))
    (= max-height (call (. SizeSpec coord) 320))
    (= min-width (call (. SizeSpec coord) 1200))
    (= max-width (call (. SizeSpec coord) 1200))
  )
)

(type + HitRow (is Box)
  (prop + row-index Size)
  (blank)
  (rule This
    (= min-width (call (. SizeSpec coord) 1200))
    (= max-width (call (. SizeSpec coord) 1200))
    (= min-height (call (. SizeSpec coord) 8))
    (= max-height (call (. SizeSpec coord) 8))
  )
  (fn-do + This _
    (param row-index _)
  )
  (fn-do + clips-content _ :get
    (+= hit-visits 1)
    (return false)
  )
)
