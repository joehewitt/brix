`benchmark.meta description: TextLayouts constructed for one label change in a 20-label flow row, via the graphics text-layout-created counter.
`benchmark.meta timing: not-recommended
`benchmark.meta profiles: gui,compile-timing

/core/markup
/graphics/canvas
/graphics/color
/graphics/primitives
/graphics/text
/gui/box
/gui/label
/gui/layout
/gui/primitives

. label-count Size = 200
. root = GridRoot()
markup-mount-root(root, root)
. labels [Label]
. rows = label-count / 20
for row-index in 0 .. < rows
    . row = GridRow()
    markup-append(root, row)
    for cell-index in 0 .. < 20
        . label = Label()
        label.text = "row $row-index cell $cell-index"
        labels += label
        markup-append(row, label)
root.markup-batch-queue.checkpoint()
. mount-count0 = text-layout-created-count()
root.layout(Rect(0, 0, 1200, 800))
. mount-count1 = text-layout-created-count()
. mount-layouts = mount-count1 - mount-count0

. checksum Size = 0
. canvas = RasterCanvas(1200, 800, 2)
do use canvas
    . count0 = text-layout-created-count()
    root.paint(canvas)
    . count1 = text-layout-created-count()
    . first-paint-layouts = count1 - count0

    root.paint(canvas)
    . count2 = text-layout-created-count()
    . repaint-layouts = count2 - count1

    labels[0].text = "changed"
    root.markup-batch-queue.checkpoint()
    root.update-layout()
    root.paint(canvas)
    . count3 = text-layout-created-count()
    . change-layouts = count3 - count2

    ?! Panic("row text mutation created more than two TextLayouts")
        if change-layouts > 2

    //gui.bench.text.row-labels += label-count
    //gui.bench.text.row-mount-layouts += mount-layouts
    //gui.bench.text.row-first-paint-layouts += first-paint-layouts
    //gui.bench.text.row-repaint-layouts += repaint-layouts
    //gui.bench.text.row-change-layouts += change-layouts
    checksum += label-count + mount-layouts + first-paint-layouts + repaint-layouts + change-layouts

root.close()
markup-release(root)

-- "bench-result gui/row-text-mutation checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ GridRoot is Box
    is MarkupBatch

+ markup-batch-queue := MarkupBatchQueue(this)

• This
    layout = flow-col

────────────────────
+ do markup-batch-did-flush
    - flush MarkupBatchFlush

━━━━━━━━━━━━━━━━━━━━
