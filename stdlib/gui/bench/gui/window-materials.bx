; benchmark.meta description: Renders a never-shown transparent Window holding nine window-material boxes, a sidebar, a HUD content area, six rounded cards, and a callout card, through the native window path, recolouring every material box each frame and then resizing them each frame, and reports frame CPU percentiles and material mask renders.
; benchmark.meta timing: not-recommended
; benchmark.meta profiles: gui-metal
(blank)
(import /graphics/color)
(import /graphics/primitives)
(import /gui)
(import /stream/sort)
(import /time/timer)
(blank)

(main
  (let warmup-frames Size 10)
  (let measured-frames Size 60)
  (let window (call MaterialsBenchWindow))
  (call (. window open))
  (= (. window allow-native) true)
  (let panels (list Box))
  (call materials-bench-collect window panels)
  (throw (call Panic "window-materials expected nine material boxes") (if (!= (. panels length) 9)))
  (blank)
  (let repaint (list U64))
  (for (in frame (..< 0 (+ warmup-frames measured-frames)))
    (let tint (call RGBA 1 1 1 (+ 0.02 (* 0.01 (as (% frame 5) F64)))))
    (for (in panel panels)
      (= (. panel background-color) tint)
    )
    (let elapsed (call materials-bench-frame window))
    (if (>= frame warmup-frames)
      (+= repaint elapsed)
    )
  )
  (blank)
  (let resize (list U64))
  (for (in frame (..< 0 (+ warmup-frames measured-frames)))
    (= (. (!! (. window sidebar)) min-width) (call (. SizeSpec coord) (+ 200 (* (as (% frame 8) F64) 10))))
    (let elapsed (call materials-bench-frame window))
    (if (>= frame warmup-frames)
      (+= resize elapsed)
    )
  )
  (blank)
  (probe-count gui.bench.materials.repaint-cpu-p50-ns (call materials-bench-percentile repaint 50))
  (probe-count gui.bench.materials.repaint-cpu-p99-ns (call materials-bench-percentile repaint 99))
  (probe-count gui.bench.materials.resize-cpu-p50-ns (call materials-bench-percentile resize 50))
  (probe-count gui.bench.materials.resize-cpu-p99-ns (call materials-bench-percentile resize 99))
  (blank)
  (let checksum (+ (. panels length) (. window native-artifact-count)))
  (call (. window close))
  (print (str "bench-result gui/window-materials checksum=" checksum))
)

(fn-do _ materials-bench-frame _
  (param window MaterialsBenchWindow)
  (let started (call monotonic-time-nanoseconds))
  (let root (. window markup-batch-root))
  (if root
    (catch (call (. root markup-batch-queue checkpoint)))
  )
  (call (. window layout))
  (let rendered (call (. window render)))
  (let elapsed (- (call monotonic-time-nanoseconds) started))
  (throw (call Panic "window-materials rendered no frame") (if (not rendered)))
  (return elapsed)
)

(fn-do _ materials-bench-collect _
  (param node GuiNode)
  (param into (list Box))
  (if (and (is node Box) (!= (. (as node Box) $window-material) null))
    (+= into (as node Box))
  )
  (for (in child (. node children))
    (call materials-bench-collect child into)
  )
)

(fn-expr _ materials-bench-percentile U64
  (param values (list U64))
  (param percentile Size)
  (case? (not values)
    0
  )
  (default
    ([] sorted (/ (* (- (. sorted length) 1) percentile) 100))
  )
  (where
    (lazy sorted (call sort values (:using (=> (left right) (if-expr (< left right) .lesser .greater)))))
  )
)

(type _ MaterialsBenchWindow (is Window)
  (prop + allow-native _ (= false))
  (prop + sidebar (? Box))
  (content
    (<> This (• flex-row)
      (= size (tuple 1200 900))
      (= background null)
      (= use-metal false)
      (blank)
      (<> Box (id: sidebar) (• flex-col) (• w 240) (• p 16)
        (= window-material (. WindowMaterial sidebar))
      )
      (blank)
      (<> Box (• flex-col) (• flex 1) (• p 24)
        (= window-material (. WindowMaterial hud))
        (<> Box (• flex-row) (• h 180)
          (<> Box (• flex 1)
            (= corner-radius 16)
            (= window-material (. WindowMaterial popover))
          )
          (<> Box (• flex 1) (• ml 16)
            (= corner-radius 16)
            (= window-material (. WindowMaterial popover))
          )
          (<> Box (• flex 1) (• ml 16)
            (= corner-radius 16)
            (= window-material (. WindowMaterial popover))
          )
        )
        (<> Box (• flex-row) (• h 180) (• mt 16)
          (<> Box (• flex 1)
            (= corner-radius 24)
            (= window-material (. WindowMaterial menu))
          )
          (<> Box (• flex 1) (• ml 16)
            (= corner-radius 24)
            (= window-material (. WindowMaterial menu))
          )
          (<> Box (• flex 1) (• ml 16)
            (= corner-radius 24)
            (= window-material (. WindowMaterial menu))
          )
        )
        (<> Box (• flex-row) (• h 160) (• mt 28)
          (<> Box (• flex 1)
            (= corner-radius 12)
            (= shape (call CalloutShape 10))
            (= window-material (. WindowMaterial popover))
          )
        )
      )
    )
  )
  (fn-do + ensure-native _
    (if allow-native
      (call (. super ensure-native))
    )
  )
)
