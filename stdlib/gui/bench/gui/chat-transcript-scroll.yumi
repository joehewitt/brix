`benchmark.meta description: Scrolls an 80-message chat transcript end to end by wheel steps after every message has been shown once, framing each step.
`benchmark.meta timing: recommended
`benchmark.meta profiles: gui,compile-timing

/gui/bench/fixtures/chat-transcript-bench-fixture

. checksum = run-chat-transcript-scroll(4)

-- "bench-result gui/chat-transcript-scroll checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ do run-chat-transcript-scroll Size
    - sweeps Size

. bench = ChatTranscriptBench(chat-bench-visited-turns)
. checksum = bench.show(bench.chat)
checksum += bench.visit(600)
. distance = bench.scroller.scroll-max.y
for round in 0 .. < sweeps
    checksum += bench.sweep(distance, chat-bench-wheel-step)
bench.close()
= checksum
