; benchmark.meta description: TextLayouts constructed for one label change in a 20-label flow row, via the graphics text-layout-created counter.
; benchmark.meta timing: not-recommended
; benchmark.meta profiles: gui,compile-timing
(blank)
(import /core/markup)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/primitives)
(import /graphics/text)
(import /gui/box)
(import /gui/label)
(import /gui/layout)
(import /gui/primitives)
(blank)

(main
  (let label-count Size 200)
  (let root (call GridRoot))
  (call markup-mount-root root root)
  (let labels (list Label))
  (let rows (/ label-count 20))
  (for (in row-index (..< 0 rows))
    (let row (call GridRow))
    (call markup-append root row)
    (for (in cell-index (..< 0 20))
      (let label (call Label))
      (= (. label text) (str "row " row-index " cell " cell-index))
      (+= labels label)
      (call markup-append row label)
    )
  )
  (call (. root markup-batch-queue checkpoint))
  (let mount-count0 (call text-layout-created-count))
  (call (. root layout) (call Rect 0 0 1200 800))
  (let mount-count1 (call text-layout-created-count))
  (let mount-layouts (- mount-count1 mount-count0))
  (blank)
  (let checksum Size 0)
  (let canvas (call RasterCanvas 1200 800 2))
  (do-use canvas
    (let count0 (call text-layout-created-count))
    (call (. root paint) canvas)
    (let count1 (call text-layout-created-count))
    (let first-paint-layouts (- count1 count0))
    (blank)
    (call (. root paint) canvas)
    (let count2 (call text-layout-created-count))
    (let repaint-layouts (- count2 count1))
    (blank)
    (= (. ([] labels 0) text) "changed")
    (call (. root markup-batch-queue checkpoint))
    (call (. root update-layout))
    (call (. root paint) canvas)
    (let count3 (call text-layout-created-count))
    (let change-layouts (- count3 count2))
    (blank)
    (throw (call Panic "row text mutation created more than two TextLayouts") (if (> change-layouts 2)))
    (blank)
    (probe-count gui.bench.text.row-labels label-count)
    (probe-count gui.bench.text.row-mount-layouts mount-layouts)
    (probe-count gui.bench.text.row-first-paint-layouts first-paint-layouts)
    (probe-count gui.bench.text.row-repaint-layouts repaint-layouts)
    (probe-count gui.bench.text.row-change-layouts change-layouts)
    (+= checksum (+ label-count mount-layouts first-paint-layouts repaint-layouts change-layouts))
  )
  (blank)
  (call (. root close))
  (call markup-release root)
  (blank)
  (print (str "bench-result gui/row-text-mutation checksum=" checksum))
)

(type + GridRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (rule This
    (= layout flow-col)
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(type + GridRow (is Box)
  (rule This
    (= layout flow-row)
  )
)
