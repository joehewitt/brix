━━━━━━━━━━━━━━━━━━━━
+ InboxWindow is Window
    using SparseEditsTheme

+ threads [InboxThread]
+ query = ""
+ row-font-size Length = 13

────────────────────

<This • flex-col
    size = (900, 700)

    <Box • inbox-header
        <Label "Inbox" • inbox-title
        <TextInput draft • flex:1
            placeholder = "Reply"
    <Box • thread-list
        font-size = #row-font-size
        for item in matching-threads(#threads, #query) keyed by item.id
            <ThreadRow
                thread = item

