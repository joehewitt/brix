`benchmark.meta description: Apply-and-settle time of one sparse edit among 1k and 3k live rows of markup with tracked reads: a row label, an equal write, a hover, a keystroke, the rows' font size, and a filter and its reversal over plain and virtual rows, with what building the rows costs.
`benchmark.meta timing: recommended
`benchmark.meta profiles: sparse-edits

/YuGC/YuGC.h
/core/virtual
/core/virtual-layout
/graphics/canvas
/graphics/color
/graphics/point
/graphics/primitives
/graphics/text
/gui
/gui/scene
/stream/sort
/time/timer

_ row-height = 28.0
_ header-height = 44.0
_ title-x = 240.0
_ edited-row Index = 12
_ inbox-topics = ["budget", "launch", "hiring", "design", "travel", "review", "offsite", "roadmap", "invoice", "support"]

. checksum Size
checksum += run-plain(1000)
checksum += run-plain(3000)
checksum += run-virtual(1000)
checksum += run-virtual(3000)

-- "bench-result gui/sparse-edits checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ do run-plain Size
    - count Size

. threads = inbox-threads(count)
. objects-before = allocated-objects()
. started = monotonic-time-nanoseconds()
. window = InboxWindow()
window.threads = threads
window.open()
window.layout()
. scene = DisplayScene(2, white)
. canvas = RasterCanvas(900, 700, 2, white)
. checksum Size
do use scene
    do use canvas
        scene.build(window)
        scene.commit()
        scene.frame(canvas)
        . build-us = (monotonic-time-nanoseconds() - started) / 1000
        . build-objects = allocated-objects() - objects-before
        . frame = SettleFrame(window, scene, canvas)
        . edited = threads[edited-row]
        . edited-point = row-point(edited-row)
        . next-point = row-point(edited-row + 1)

        . label-edit = :: step Size => do
            edited.title = "Edited $step"
        . label-us = frame.p50-us(21, label-edit)
        ?! Panic("sparse-edits label edit did not reach its row")
            if label-at(window, edited-point) != "Edited 20"

        . label-objects-before = allocated-objects()
        . ignored = frame.timed(21, label-edit)
        . label-objects = allocated-objects() - label-objects-before

        . equal-edit = :: step Size => do
            edited.title = "Edited 21"
        . equal-us = frame.p50-us(21, equal-edit)
        ?! Panic("sparse-edits equal write changed its row")
            if label-at(window, edited-point) != "Edited 21"

        . hover-edit = :: step Size => do
            . point = if step % 2 == 0 then edited-point else next-point
            window.dispatch-pointer-event(PointerMoveEvent(PointerEventData(point)))
        . hover-us = frame.p50-us(21, hover-edit)
        ?! Panic("sparse-edits hover did not reach its row")
            if !window.hit-path(edited-point)!.target.is-hovered

        . keystroke-edit = :: step Size => do
            window.draft.accept-native-input("${window.draft.text}k")
        . keystroke-us = frame.p50-us(21, keystroke-edit)
        ?! Panic("sparse-edits keystrokes did not reach the draft")
            if window.draft.text.length != 21

        . font-edit = :: step Size => do
            window.row-font-size = if step % 2 == 0 then 14 else 13
        . font-us = frame.p50-us(7, font-edit)

        . narrow = :: step Size => do
            window.query = inbox-topics[0]
        . widen = :: step Size => do
            window.query = ""
        . narrows [U64]
        . widens [U64]
        for step in 0 .. < 7
            narrows += frame.timed(step, narrow)
            ?! Panic("sparse-edits filter did not narrow the rows")
                if label-at(window, row-point(1)) != "budget thread 10"
            widens += frame.timed(step, widen)
            ?! Panic("sparse-edits filter did not restore the rows")
                if label-at(window, row-point(1)) != "launch thread 1"
        . filter-us = median-us(narrows)
        . unfilter-us = median-us(widens)

        if count == 1000
            //gui.bench.sparse.build-us-1k += build-us
            //gui.bench.sparse.build-objects-1k += build-objects
            //gui.bench.sparse.label-us-1k += label-us
            //gui.bench.sparse.label-objects-1k += label-objects
            //gui.bench.sparse.equal-us-1k += equal-us
            //gui.bench.sparse.hover-us-1k += hover-us
            //gui.bench.sparse.keystroke-us-1k += keystroke-us
            //gui.bench.sparse.font-us-1k += font-us
            //gui.bench.sparse.filter-us-1k += filter-us
            //gui.bench.sparse.unfilter-us-1k += unfilter-us
        else
            //gui.bench.sparse.build-us-3k += build-us
            //gui.bench.sparse.build-objects-3k += build-objects
            //gui.bench.sparse.label-us-3k += label-us
            //gui.bench.sparse.label-objects-3k += label-objects
            //gui.bench.sparse.equal-us-3k += equal-us
            //gui.bench.sparse.hover-us-3k += hover-us
            //gui.bench.sparse.keystroke-us-3k += keystroke-us
            //gui.bench.sparse.font-us-3k += font-us
            //gui.bench.sparse.filter-us-3k += filter-us
            //gui.bench.sparse.unfilter-us-3k += unfilter-us
        checksum = count + window.draft.text.length + window.threads.length

window.close()
= checksum

━━━━━━━━━━━━━━━━━━━━
+ do run-virtual Size
    - count Size

. threads = inbox-threads(count)
. objects-before = allocated-objects()
. started = monotonic-time-nanoseconds()
. window = VirtualInboxWindow()
window.thread-source.replace(threads)
window.open()
window.layout()
. scene = DisplayScene(2, white)
. canvas = RasterCanvas(900, 700, 2, white)
. checksum Size
do use scene
    do use canvas
        scene.build(window)
        scene.commit()
        scene.frame(canvas)
        . build-us = (monotonic-time-nanoseconds() - started) / 1000
        . build-objects = allocated-objects() - objects-before
        . frame = SettleFrame(window, scene, canvas)

        . narrowed = matching-threads(threads, inbox-topics[0])
        . narrow = :: step Size => do
            window.thread-source.replace(narrowed)
        . widen = :: step Size => do
            window.thread-source.replace(threads)
        . narrows [U64]
        . widens [U64]
        for step in 0 .. < 7
            narrows += frame.timed(step, narrow)
            ?! Panic("sparse-edits virtual filter did not narrow the rows")
                if label-at(window, row-point(1)) != "budget thread 10"
            widens += frame.timed(step, widen)
            ?! Panic("sparse-edits virtual filter did not restore the rows")
                if label-at(window, row-point(1)) != "launch thread 1"
        . filter-us = median-us(narrows)
        . unfilter-us = median-us(widens)

        if count == 1000
            //gui.bench.sparse.virtual-build-us-1k += build-us
            //gui.bench.sparse.virtual-build-objects-1k += build-objects
            //gui.bench.sparse.virtual-filter-us-1k += filter-us
            //gui.bench.sparse.virtual-unfilter-us-1k += unfilter-us
        else
            //gui.bench.sparse.virtual-build-us-3k += build-us
            //gui.bench.sparse.virtual-build-objects-3k += build-objects
            //gui.bench.sparse.virtual-filter-us-3k += filter-us
            //gui.bench.sparse.virtual-unfilter-us-3k += unfilter-us
        checksum = count + window.thread-source.count

window.close()
= checksum

━━━━━━━━━━━━━━━━━━━━
+ inbox-threads [InboxThread]
    - count Size

** 0 .. < count
*> InboxThread(each, "Sender ${each % 97}", "${inbox-topics[each % inbox-topics.length]} thread $each")
|> List

━━━━━━━━━━━━━━━━━━━━
+ matching-threads [InboxThread]
    - threads [InboxThread]
    - query String

** threads
?> !query || each.title.starts-with("$query ")
|> List

━━━━━━━━━━━━━━━━━━━━
+ row-point Point
    - row Index

Point(title-x, header-height + ((row as F64) + 0.5) * row-height)

━━━━━━━━━━━━━━━━━━━━
+ label-at String
    - window Window
    - point Point

(window.hit-path(point)?.target as Label?)?.text ?? ""

━━━━━━━━━━━━━━━━━━━━
+ allocated-objects U64

C:yumiGCAllocatedObjectCount() + C:yumiGCThreadPendingAllocatedObjectCount()

━━━━━━━━━━━━━━━━━━━━
+ median-us U64
    - values [U64]

sorted[sorted.length / 2] / 1000
.. sorted = sort(values) • using :: left, right => if left < right then .lesser else .greater

━━━━━━━━━━━━━━━━━━━━
+ SettleFrame

+ window Window
+ scene DisplayScene
+ canvas RasterCanvas

────────────────────
+ This
    - window
    - scene
    - canvas

────────────────────
+ do settle

. queue = window.markup-batch-root!.markup-batch-queue
queue.checkpoint()
. passes Size = 1
while queue.actions && passes < 64
    queue.checkpoint()
    passes += 1
window.layout()
scene.update(window)
scene.commit()
scene.frame(canvas)

────────────────────
+ do timed U64
    - step Size
    - edit Statement'Size

. started = monotonic-time-nanoseconds()
edit(step)
settle()
= monotonic-time-nanoseconds() - started

────────────────────
+ do p50-us U64
    - steps Size
    - edit Statement'Size

. times [U64]
for step in 0 .. < steps
    times += timed(step, edit)
= median-us(times)

━━━━━━━━━━━━━━━━━━━━
+ InboxThread

+ id Index
+ sender String
+ title String

────────────────────
+ This
    - id
    - sender
    - title

