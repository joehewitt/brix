`benchmark.meta description: Renders a never-shown transparent Window holding nine window-material boxes, a sidebar, a HUD content area, six rounded cards, and a callout card, through the native window path, recolouring every material box each frame and then resizing them each frame, and reports frame CPU percentiles and material mask renders.
`benchmark.meta timing: not-recommended
`benchmark.meta profiles: gui-metal

/graphics/color
/graphics/primitives
/gui
/stream/sort
/time/timer

. warmup-frames Size = 10
. measured-frames Size = 60
. window = MaterialsBenchWindow()
window.open()
window.allow-native = true
. panels [Box]
materials-bench-collect(window, panels)
?! Panic("window-materials expected nine material boxes")
    if panels.length != 9

. repaint [U64]
for frame in 0 .. < warmup-frames + measured-frames
    . tint = RGBA(1, 1, 1, 0.02 + 0.01 * ((frame % 5) as F64))
    for panel in panels
        panel.background-color = tint
    . elapsed = materials-bench-frame(window)
    if frame >= warmup-frames
        repaint += elapsed

. resize [U64]
for frame in 0 .. < warmup-frames + measured-frames
    window.sidebar!.min-width = SizeSpec.coord(200 + ((frame % 8) as F64) * 10)
    . elapsed = materials-bench-frame(window)
    if frame >= warmup-frames
        resize += elapsed

//gui.bench.materials.repaint-cpu-p50-ns += materials-bench-percentile(repaint, 50)
//gui.bench.materials.repaint-cpu-p99-ns += materials-bench-percentile(repaint, 99)
//gui.bench.materials.resize-cpu-p50-ns += materials-bench-percentile(resize, 50)
//gui.bench.materials.resize-cpu-p99-ns += materials-bench-percentile(resize, 99)

. checksum = panels.length + window.native-artifact-count
window.close()
-- "bench-result gui/window-materials checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ do materials-bench-frame
    - window MaterialsBenchWindow

. started = monotonic-time-nanoseconds()
. root = window.markup-batch-root
if root
    catch root.markup-batch-queue.checkpoint()
window.layout()
. rendered = window.render()
. elapsed = monotonic-time-nanoseconds() - started
?! Panic("window-materials rendered no frame")
    if !rendered
= elapsed

━━━━━━━━━━━━━━━━━━━━
_ do materials-bench-collect
    - node GuiNode
    - into [Box]

if node is Box && (node as Box).$window-material != null
    into += node as Box
for child in node.children
    materials-bench-collect(child, into)

━━━━━━━━━━━━━━━━━━━━
_ materials-bench-percentile U64
    - values [U64]
    - percentile Size

|? !values
    0
??
    sorted[((sorted.length - 1) * percentile) / 100]

.. sorted = sort(values) • using :: left, right => if left < right then .lesser else .greater

━━━━━━━━━━━━━━━━━━━━
_ MaterialsBenchWindow is Window

+ allow-native = false
+ sidebar Box?

────────────────────

<This • flex-row
    size = (1200, 900)
    background = null
    use-metal = false

    <Box sidebar • flex-col w:240 p:16
        window-material = WindowMaterial.sidebar

    <Box • flex-col flex:1 p:24
        window-material = WindowMaterial.hud
        <Box • flex-row h:180
            <Box • flex:1
                corner-radius = 16
                window-material = WindowMaterial.popover
            <Box • flex:1 ml:16
                corner-radius = 16
                window-material = WindowMaterial.popover
            <Box • flex:1 ml:16
                corner-radius = 16
                window-material = WindowMaterial.popover
        <Box • flex-row h:180 mt:16
            <Box • flex:1
                corner-radius = 24
                window-material = WindowMaterial.menu
            <Box • flex:1 ml:16
