`benchmark.meta description: Streams a 600-word Markdown reply into the end of a 300-message chat transcript, framing every delta.
`benchmark.meta timing: recommended
`benchmark.meta profiles: gui,compile-timing

/gui/bench/fixtures/chat-transcript-bench-fixture

. checksum = run-chat-transcript-stream(4)

-- "bench-result gui/chat-transcript-stream checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ do run-chat-transcript-stream Size
    - replies Size

. bench = ChatTranscriptBench(chat-bench-long-turns)
. checksum = bench.show(bench.chat)
for reply in 0 .. < replies
    bench.chat.begin-turn("Stream reply ${reply + 1}")
    checksum += bench.frame()
    for word in chat-bench-reply(reply * 4).split(" ")
        append-chat-bench-reply(bench.chat, "$word ")
        checksum += bench.frame()
    bench.chat.finish-reply()
    checksum += bench.frame()
bench.close()
= checksum
