━━━━━━━━━━━━━━━━━━━━
+ percentile-us
    - values [U64]
    - percentile Size

|? !values
    0
??
    sorted[index] / 1000

.. sorted = sort(values) • using :: left, right => if left < right then .lesser else .greater
.. index = ((sorted.length - 1) * percentile) / 100

━━━━━━━━━━━━━━━━━━━━
+ FlowFanRoot is Box
    is MarkupBatch

+ markup-batch-queue := MarkupBatchQueue(this)

• This
    layout = flow-col

────────────────────
+ do markup-batch-did-flush
    - flush MarkupBatchFlush

────────────────────
+ do did-layout

layout-visits += 1
super.did-layout()

━━━━━━━━━━━━━━━━━━━━
+ FlowFanCell is Box

• This
    min-width = SizeSpec.coord(11)
    max-width = SizeSpec.coord(11)
    min-height = SizeSpec.coord(8)
    max-height = SizeSpec.coord(8)

    when #is-pressed
        min-height = SizeSpec.coord(12)
        max-height = SizeSpec.coord(12)

────────────────────
+ do measure MeasureResult
    - query MeasureQuery = measure-fit-query()

measure-calls += 1
= super.measure(query)

────────────────────
+ do measured-content-size Dimensions
    - query MeasureQuery

content-measures += 1
= super.measured-content-size(query)

────────────────────
+ do did-layout

layout-visits += 1
super.did-layout()

