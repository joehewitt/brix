`benchmark.meta description: Incremental flow layout cost after same-size, middle height, and widest-child mutations at 1k and 10k direct-child fanout.
`benchmark.meta timing: not-recommended
`benchmark.meta profiles: gui,compile-timing

/YuGC/YuGC.h
/core/markup
/graphics/primitives
/gui/box
/gui/layout
/gui/primitives
/stream/sort
/time/timer

_ measure-calls Size = 0
_ content-measures Size = 0
_ layout-visits Size = 0
_ checksum Size = 0

fanout-scenarios(1000, 9)
fanout-scenarios(10000, 9)

-- "bench-result gui/flow-fanout-mutation checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ do reset-counters

measure-calls = 0
content-measures = 0
layout-visits = 0

━━━━━━━━━━━━━━━━━━━━
+ do fanout-scenarios
    - fanout Size
    - iterations Size

. root = FlowFanRoot()
markup-mount-root(root, root)
. cells [FlowFanCell]
for index in 0 .. < fanout
    . cell = FlowFanCell()
    cells += cell
    markup-append(root, cell)
. wide = FlowWideCell()
markup-append(root, wide)
root.markup-batch-queue.checkpoint()
root.layout(Rect(0, 0, 1200, 900))

. middle = cells[fanout / 2]
measure-same-size(root, middle, fanout, iterations)
measure-height-change(root, middle, fanout, iterations)
measure-cross-shrink(root, wide, fanout, iterations)

root.close()
markup-release(root)

━━━━━━━━━━━━━━━━━━━━
+ do measure-same-size
    - root FlowFanRoot
    - target FlowFanCell
    - fanout Size
    - iterations Size

. times [U64]
. objects Size = 0
. bytes Size = 0
for iteration in 0 .. < iterations
    target.invalidate-content-size()
    reset-counters()
    . objects0 = C:yumiGCAllocatedObjectCount()
    . bytes0 = C:yumiGCRequestedByteCount()
    . time0 = monotonic-time-nanoseconds()
    root.update-layout()
    . time1 = monotonic-time-nanoseconds()
    times += time1 - time0
    objects = (C:yumiGCAllocatedObjectCount() - objects0) as Size
    bytes = (C:yumiGCRequestedByteCount() - bytes0) as Size

. p50 = percentile-us(times, 50)
. p95 = percentile-us(times, 95)
if fanout == 1000
    //gui.bench.flow-fanout.same-size.measure-calls-1k += measure-calls
    //gui.bench.flow-fanout.same-size.content-measures-1k += content-measures
    //gui.bench.flow-fanout.same-size.layout-visits-1k += layout-visits
    //gui.bench.flow-fanout.same-size.objects-1k += objects
    //gui.bench.flow-fanout.same-size.bytes-1k += bytes
    //gui.bench.flow-fanout.same-size.p50-us-1k += p50
    //gui.bench.flow-fanout.same-size.p95-us-1k += p95
else
    //gui.bench.flow-fanout.same-size.measure-calls-10k += measure-calls
    //gui.bench.flow-fanout.same-size.content-measures-10k += content-measures
    //gui.bench.flow-fanout.same-size.layout-visits-10k += layout-visits
    //gui.bench.flow-fanout.same-size.objects-10k += objects
    //gui.bench.flow-fanout.same-size.bytes-10k += bytes
    //gui.bench.flow-fanout.same-size.p50-us-10k += p50
    //gui.bench.flow-fanout.same-size.p95-us-10k += p95
checksum += measure-calls + content-measures + layout-visits + objects + bytes

━━━━━━━━━━━━━━━━━━━━
+ do measure-height-change
    - root FlowFanRoot
    - target FlowFanCell
    - fanout Size
    - iterations Size

. times [U64]
. objects Size = 0
. bytes Size = 0
for iteration in 0 .. < iterations
    target.is-pressed = !target.is-pressed
    root.markup-batch-queue.checkpoint()
    reset-counters()
    . objects0 = C:yumiGCAllocatedObjectCount()
    . bytes0 = C:yumiGCRequestedByteCount()
    . time0 = monotonic-time-nanoseconds()
    root.update-layout()
    . time1 = monotonic-time-nanoseconds()
    times += time1 - time0
    objects = (C:yumiGCAllocatedObjectCount() - objects0) as Size
    bytes = (C:yumiGCRequestedByteCount() - bytes0) as Size

. p50 = percentile-us(times, 50)
