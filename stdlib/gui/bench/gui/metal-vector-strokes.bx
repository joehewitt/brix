; benchmark.meta description: Five thousand filled and stroked vector items with mixed widths, caps, joins, inherited strokes, open and closed outlines, and rotations through DisplayScene on Metal at 1600x1000 and scale 2, as simple, complex, and hairline paths, plus grids of every cap and join, of inside, outside, and stacked strokes with hairline widths, and of dashes on lines, and of dashes on curves or with overlapping caps, under identity and skewing transforms, with frame CPU, GPU, stroke work, fallback, and CoreGraphics parity evidence.
; benchmark.meta timing: not-recommended
; benchmark.meta profiles: gui-metal
(blank)
(import /core/markup)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/matrix)
(import /graphics/path)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/vectorgeometry)
(import /gui/box)
(import /gui/layout)
(import /gui/metal)
(import /gui/primitives)
(import /gui/scene)
(import /math)
(import /stream/sort)
(import /time/timer)
(blank)

(main
  (let simple (call run-vector-strokes false false))
  (let complex (call run-vector-strokes true false))
  (let hairline (call run-vector-strokes false true))
  (let grid (call run-stroke-grid))
  (let styles (call run-stroke-panels 0))
  (let dash-lines (call run-stroke-panels 1))
  (let dash-curves (call run-stroke-panels 2))
  (probe-count gui.bench.metal.stroke-cpu-p50-ns (. simple cpu-p50))
  (probe-count gui.bench.metal.stroke-gpu-p50-ns (. simple gpu-p50))
  (probe-count gui.bench.metal.stroke-segments (. simple segments))
  (probe-count gui.bench.metal.stroke-lines (. simple lines))
  (probe-count gui.bench.metal.stroke-pieces (. simple pieces))
  (probe-count gui.bench.metal.stroke-draws (. simple draws))
  (probe-count gui.bench.metal.stroke-overflows (. simple overflows))
  (probe-count gui.bench.metal.stroke-diff-ppm (. simple diff-ppm))
  (probe-count gui.bench.metal.stroke-detail-ppm (. simple detail-ppm))
  (probe-count gui.bench.metal.stroke-gross-ppm (. simple gross-ppm))
  (probe-count gui.bench.metal.stroke-max-delta (. simple max-delta))
  (probe-count gui.bench.metal.stroke-complex-cpu-p50-ns (. complex cpu-p50))
  (probe-count gui.bench.metal.stroke-complex-gpu-p50-ns (. complex gpu-p50))
  (probe-count gui.bench.metal.stroke-complex-segments (. complex segments))
  (probe-count gui.bench.metal.stroke-complex-lines (. complex lines))
  (probe-count gui.bench.metal.stroke-complex-overflows (. complex overflows))
  (probe-count gui.bench.metal.stroke-complex-gross-ppm (. complex gross-ppm))
  (probe-count gui.bench.metal.stroke-complex-max-delta (. complex max-delta))
  (probe-count gui.bench.metal.stroke-grid-detail-ppm (. grid detail-ppm))
  (probe-count gui.bench.metal.stroke-grid-gross-ppm (. grid gross-ppm))
  (probe-count gui.bench.metal.stroke-grid-max-delta (. grid max-delta))
  (probe-count gui.bench.metal.stroke-hairline-cpu-p50-ns (. hairline cpu-p50))
  (probe-count gui.bench.metal.stroke-hairline-gpu-p50-ns (. hairline gpu-p50))
  (probe-count gui.bench.metal.stroke-hairline-lines (. hairline lines))
  (probe-count gui.bench.metal.stroke-hairline-gross-ppm (. hairline gross-ppm))
  (probe-count gui.bench.metal.stroke-hairline-max-delta (. hairline max-delta))
  (probe-count gui.bench.metal.stroke-style-detail-ppm (. styles detail-ppm))
  (probe-count gui.bench.metal.stroke-style-gross-ppm (. styles gross-ppm))
  (probe-count gui.bench.metal.stroke-style-max-delta (. styles max-delta))
  (probe-count gui.bench.metal.stroke-dash-line-detail-ppm (. dash-lines detail-ppm))
  (probe-count gui.bench.metal.stroke-dash-line-gross-ppm (. dash-lines gross-ppm))
  (probe-count gui.bench.metal.stroke-dash-line-max-delta (. dash-lines max-delta))
  (probe-count gui.bench.metal.stroke-dash-curve-gross-ppm (. dash-curves gross-ppm))
  (probe-count gui.bench.metal.stroke-dash-curve-max-delta (. dash-curves max-delta))
  (throw (call Panic "Vector strokes differ from CoreGraphics beyond the GR-D21 budget") (if (or (> (. simple gross-ppm) 100) (> (. grid gross-ppm) 100))))
  (throw (call Panic "Aligned, stacked, or dashed strokes differ from CoreGraphics beyond the GR-D21 budget") (if (or (> (. styles gross-ppm) 100) (> (. dash-lines gross-ppm) 100))))
  (let checksum (+ (. simple segments) (. complex segments) (. simple pieces) (. grid draws) (. styles draws)))
  (+= checksum (+ (. dash-lines draws) (. dash-curves draws)))
  (print (str "bench-result gui/metal-vector-strokes checksum=" checksum))
)

(type _ VectorStrokesResult (is Tuple)
  (prop + cpu-p50 U64)
  (prop + gpu-p50 U64)
  (prop + segments I64)
  (prop + lines I64)
  (prop + pieces I64)
  (prop + draws I64)
  (prop + overflows I64)
  (prop + diff-ppm I64)
  (prop + detail-ppm I64)
  (prop + gross-ppm I64)
  (prop + max-delta I64)
)

(fn-do _ run-vector-strokes _
  (param complex Bool)
  (param hairline Bool)
  (let root (call VectorStrokesRoot))
  (for (in band (..< 0 10))
    (call markup-append root (call VectorStrokesBand (* band 500) complex hairline))
  )
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (call (. root layout) (call Rect 0 0 1600 1000))
  (let renderer (call MetalOffscreenRenderer 1600 1000 2 white))
  (let scene (call DisplayScene 2 white renderer))
  (let reference (call RasterCanvas 1600 1000 2 white))
  (let elapsed (list U64))
  (let gpu (list U64))
  (let result VectorStrokesResult)
  (do-use renderer
    (do-use reference
      (call (. scene build) root)
      (call (. scene commit))
      (call (. scene frame-metal) renderer)
      (call (. renderer finish))
      (for (in warmup (..< 0 6))
        (call (. scene add-damage) (. root bounds))
        (call (. scene frame-metal) renderer)
      )
      (call (. renderer finish))
      (for (in frame (..< 0 31))
        (call (. scene add-damage) (. root bounds))
        (let started (call monotonic-time-nanoseconds))
        (call (. scene frame-metal) renderer)
        (+= elapsed (- (call monotonic-time-nanoseconds) started))
        (call (. renderer finish))
        (if (>= (. renderer gpu-nanos) 0)
          (+= gpu (as (. renderer gpu-nanos) U64))
        )
      )
      (call (. root paint) reference)
      (= result
        (call vector-strokes-result
          (block
            (arg renderer)
            (arg reference)
            (arg (call vector-strokes-median elapsed))
            (arg (call vector-strokes-median gpu))
          )
        )
      )
      (call vector-strokes-check scene renderer)
    )
  )
  (call (. scene close))
  (call (. root close))
  (call markup-release root)
  (return result)
)

(fn-do _ run-stroke-grid _
  (let root (call VectorStrokesRoot))
  (call markup-append root (call StrokeGridPanel false))
  (call markup-append root (call StrokeGridPanel true))
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (call (. root layout) (call Rect 0 0 400 800))
  (let renderer (call MetalOffscreenRenderer 400 800 2 white))
  (let scene (call DisplayScene 2 white renderer))
  (let reference (call RasterCanvas 400 800 2 white))
  (let result VectorStrokesResult)
  (do-use renderer
    (do-use reference
      (call (. scene build) root)
      (call (. scene commit))
      (call (. scene frame-metal) renderer)
      (call (. renderer finish))
      (call (. root paint) reference)
      (= result (call vector-strokes-result renderer reference 0 0))
      (call vector-strokes-check scene renderer)
    )
  )
  (call (. scene close))
  (call (. root close))
  (call markup-release root)
  (return result)
)

(fn-do _ vector-strokes-result _
  (param renderer MetalOffscreenRenderer)
  (param reference RasterCanvas)
  (param cpu-p50 U64)
  (param gpu-p50 U64)
  (let diff (call (. renderer diff) reference 2))
  (let detail (call (. renderer diff) reference 10))
  (let gross (call (. renderer diff) reference 48))
  (return
    (call VectorStrokesResult
      (block
        (arg cpu-p50)
        (arg gpu-p50)
        (arg (. renderer fill-segments))
        (arg (. renderer fill-lines))
        (arg (. renderer fill-pieces))
        (arg (. renderer fill-draws))
        (arg (. renderer fill-overflows))
        (arg (/ (* (. diff differing-pixels) 1000000) (. diff pixel-count)))
        (arg (/ (* (. detail differing-pixels) 1000000) (. detail pixel-count)))
        (arg (/ (* (. gross differing-pixels) 1000000) (. gross pixel-count)))
        (arg (. diff maximum-channel-delta))
      )
    )
  )
)

(fn-do _ vector-strokes-check _
  (param scene DisplayScene)
  (param renderer MetalOffscreenRenderer)
  (throw (call Panic "Vector strokes fell back to CoreGraphics tiles") (if (!= (. scene metal-tile-fallbacks) 0)))
  (throw (call Panic "Vector strokes skipped Metal operations") (if (!= (. renderer skipped-ops) 0)))
)

(fn-expr _ vector-strokes-median _
  (param samples (list U64))
  ([] sorted (/ (. sorted length) 2))
  (where
    (lazy sorted (call sort samples (:using (=> (left right) (if-expr (< left right) .lesser .greater)))))
  )
)

(type _ VectorStrokesRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (rule This
    (= layout flow-col)
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
    (let ignored (. flush applied))
  )
)

(type _ VectorStrokesBand (is Box)
  (prop + first Size)
  (prop + complex Bool)
  (prop + hairline Bool)
  (prop _ handles (list VectorGeometryHandle))
  (blank)
  (rule This
    (= min-width (call (. SizeSpec coord) 1600))
    (= max-width (call (. SizeSpec coord) 1600))
    (= min-height (call (. SizeSpec coord) 100))
    (= max-height (call (. SizeSpec coord) 100))
  )
  (fn-do + This _
    (param first _)
    (param complex _)
    (param hairline _)
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let table (call vector-geometry-table-for markup-batch-root))
    (if (not handles)
      (for (in serial (..< first (+ first 500)))
        (let key (if-expr hairline (+ serial 40000) (+ (* serial 2) (if-expr complex 1 0))))
        (+= handles
          (call (. table intern-geometry)
            (block
              (arg (as key U64))
              (arg (=> () (call vector-strokes-geometry serial complex hairline)))
            )
          )
        )
      )
    )
    (let origin (. bounds top-left))
    (for (in serial (..< first (+ first 500)))
      (let hue (/ (as (% serial 12) F64) 12))
      (let palette
        (block
          (item (call RGBA (+ 0.2 (* hue 0.7)) 0.45 (- 0.9 (* hue 0.6)) (if-expr (== (% serial 7) 0) 0.6 1)))
          (item (call RGBA 0.1 (+ 0.15 (* hue 0.5)) 0.3 (if-expr (== (% serial 9) 0) 0.7 1)))
          (item (call RGBA 0.95 (- 0.8 (* hue 0.5)) 0.2 1))
        )
      )
      (let x (as (+ (. origin x) (% (* serial 37) 1520)) F64))
      (let y (as (+ (. origin y) (% (* serial 53) 40)) F64))
      (let transform (call matrix-from-translation (call Point x y)))
      (if (== (% serial 10) 3)
        (let angle (+ (* (as (% serial 7) F64) 0.23rad) 0.1rad))
        (= transform (call (. (call matrix-from-rotation angle (call Point (+ x 30) (+ y 30))) concatenate) transform))
      )
      (= (. canvas fill-color) null)
      (= (. canvas stroke-color) (call RGBA 0.35 0.1 0.45 1))
      (= (. canvas stroke-width)
        (block
          (case? hairline
            (* (as (+ 1 (% serial 3)) F64) 0.15)
          )
          (default
            (* (as (+ 1 (% serial 4)) F64) 0.75)
          )
        )
      )
      (= (. canvas stroke-cap) (if-expr (== (% serial 16) 6) (. LineCap round) (. LineCap square)))
      (= (. canvas stroke-join) (if-expr (== (% serial 3) 0) (. LineJoin bevel) (. LineJoin round)))
      (let painted (call (. table paint-vector) ([] handles (- serial first)) canvas palette transform))
    )
  )
)

(fn-do _ vector-strokes-geometry _
  (param serial Size)
  (param complex Bool)
  (param hairline Bool)
  (let spans (list VectorGeometrySpan))
  (let span (as (+ 20 (% (* serial 7) 44)) F64))
  (let none (call VectorGeometryPaint (. VectorGeometryPaintRole none) 0))
  (let outer (call Path))
  (if complex
    (let center (call Point (+ 6 (* span 0.5)) (+ 6 (* span 0.5))))
    (let petals 48)
    (for (in petal (..< 0 petals))
      (let start (/ (* (as petal F64) 2 π) (as petals F64)))
      (let step (/ (* 2 π) (as petals F64)))
      (let radius (if-expr (== (% petal 2) 0) (* span 0.5) (* span 0.4)))
      (let next (if-expr (== (% petal 2) 0) (* span 0.4) (* span 0.5)))
      (let head (+ center (call Point (* (call cos start) radius) (* (call sin start) radius))))
      (let tail (+ center (call Point (* (call cos (+ start step)) next) (* (call sin (+ start step)) next))))
      (let bulge (* span 0.55))
      (if (== petal 0)
        (call (. outer move-to) head)
      )
      (call (. outer cubic-curve-to)
        (block
          (arg (+ center (call Point (* (call cos (+ start (/ step 3))) bulge) (* (call sin (+ start (/ step 3))) bulge))))
          (arg (+ center (call Point (* (call cos (+ start (/ (* step 2) 3))) bulge) (* (call sin (+ start (/ (* step 2) 3))) bulge))))
          (arg tail)
        )
      )
    )
    (else
      (let lean (* (as (% serial 29) F64) 0.5))
      (let a (call Point 6 12))
      (let b (call Point (+ 6 span lean) 18))
      (let c (call Point (+ 6 (* span 0.4)) (+ 12 (* span 0.8) (* lean 0.5))))
      (call (. outer move-to) a)
      (call (. outer cubic-curve-to) (+ a (call Point (* span 0.3) (* (- span) 0.4))) (+ b (call Point (* (- span) 0.3) (* (- span) 0.4))) b)
      (call (. outer cubic-curve-to) (+ b (call Point (* span 0.15) (* span 0.3))) (+ c (call Point 0 (* (- span) 0.3))) c)
      (call (. outer line-to) a)
    )
  )
  (if (!= (% serial 6) 5)
    (call (. outer close))
  )
  (let caps (list (. LineCap butt) (. LineCap round) (. LineCap square)))
  (let joins (list (. LineJoin miter) (. LineJoin round) (. LineJoin bevel)))
  (let fill (call VectorGeometryPaint (. VectorGeometryPaintRole color) 0))
  (let stroke (call VectorGeometryPaint (. VectorGeometryPaintRole color) 1))
  (let width (as (+ 1 (% serial 3)) F64))
  (match? (% serial 20)
    (case? (>= it 17)
      (= width 3)
    )
    (case? (>= it 14)
      (= fill none)
      (= width 2)
    )
    (case? (>= it 10)
      (= stroke none)
    )
  )
  (if hairline
    (= width (* (as (+ 1 (% serial 3)) F64) 0.15))
  )
  (let inherited (== (% serial 8) 6))
  (if inherited
    (+= spans
      (call VectorGeometrySpan
        (block
          (arg outer)
          (arg fill)
          (arg (call VectorGeometryPaint (. VectorGeometryPaintRole inherit) 0))
          (arg null)
          (arg null)
          (arg null)
          (arg (. FillRule nonzero))
        )
      )
    )
    (else
      (+= spans
        (call VectorGeometrySpan
          (block
            (arg outer)
            (arg fill)
            (arg stroke)
            (arg width)
            (arg ([] caps (% serial 3)))
            (arg ([] joins (% (/ serial 3) 3)))
            (arg (. FillRule nonzero))
          )
        )
      )
    )
  )
  (if (== (% serial 4) 0)
    (let inner (call Path))
    (call (. inner move-to) (call Point 12 26))
    (call (. inner cubic-curve-to) (call Point 18 18) (call Point 30 18) (call Point 36 26))
    (call (. inner cubic-curve-to) (call Point 30 34) (call Point 18 34) (call Point 12 26))
    (call (. inner close))
    (+= spans
      (call VectorGeometrySpan
        (block
          (arg inner)
          (arg (call VectorGeometryPaint (. VectorGeometryPaintRole color) 2))
          (arg stroke)
          (arg (if-expr hairline 0.2 1.5))
          (arg (. LineCap butt))
          (arg (. LineJoin round))
          (arg (. FillRule nonzero))
        )
      )
    )
  )
  (return (call VectorGeometry (call Rect 0 0 110 110) (call Rect 0 0 110 110) spans false inherited))
)

(type _ StrokeGridPanel (is Box)
  (prop + skewed Bool)
  (prop _ handles (list VectorGeometryHandle))
  (blank)
  (rule This
    (= min-width (call (. SizeSpec coord) 400))
    (= max-width (call (. SizeSpec coord) 400))
    (= min-height (call (. SizeSpec coord) 400))
    (= max-height (call (. SizeSpec coord) 400))
  )
  (fn-do + This _
    (param skewed _)
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let table (call vector-geometry-table-for markup-batch-root))
    (if (not handles)
      (for (in serial (..< 0 10))
        (+= handles (call (. table intern-geometry) (as (+ serial 10000) U64) (=> () (call stroke-grid-geometry serial))))
      )
    )
    (let origin (. bounds top-left))
    (for (in serial (..< 0 10))
      (let palette (list (call RGBA 0.15 0.25 0.6 1) (call RGBA 0.95 0.75 0.3 0.8)))
      (let x (as (+ (. origin x) (+ (* (% serial 3) 130) 5)) F64))
      (let y (as (+ (. origin y) (+ (* (/ serial 3) 95) 5)) F64))
      (let transform (call matrix-from-translation (call Point x y)))
      (if skewed
        (= transform (call (. (call (. transform shear) (call Dimensions 0.3 0.15)) scale) (call Dimensions 0.85 0.8)))
      )
      (= (. canvas fill-color) null)
      (= (. canvas stroke-color) null)
      (let painted (call (. table paint-vector) ([] handles serial) canvas palette transform))
    )
  )
)

(fn-do _ stroke-grid-geometry _
  (param serial Size)
  (let spans (list VectorGeometrySpan))
  (let none (call VectorGeometryPaint (. VectorGeometryPaintRole none) 0))
  (let stroke (call VectorGeometryPaint (. VectorGeometryPaintRole color) 0))
  (if (== serial 9)
    (let shape (call Path))
    (call (. shape move-to) (call Point 20 20))
    (call (. shape cubic-curve-to) (call Point 60 0) (call Point 100 40) (call Point 80 70))
    (call (. shape line-to) (call Point 30 75))
    (call (. shape close))
    (+= spans
      (call VectorGeometrySpan
        (block
          (arg shape)
          (arg (call VectorGeometryPaint (. VectorGeometryPaintRole color) 1))
          (arg stroke)
          (arg 6)
          (arg (. LineCap butt))
          (arg (. LineJoin round))
          (arg (. FillRule nonzero))
        )
      )
    )
    (else
      (let caps (list (. LineCap butt) (. LineCap round) (. LineCap square)))
      (let joins (list (. LineJoin miter) (. LineJoin round) (. LineJoin bevel)))
      (let path (call Path))
      (call (. path move-to) (call Point 15 70))
      (call (. path line-to) (call Point 35 20))
      (call (. path line-to) (call Point 55 65))
      (call (. path cubic-curve-to) (call Point 70 10) (call Point 95 10) (call Point 105 60))
      (+= spans
        (call VectorGeometrySpan
          (block
            (arg path)
            (arg none)
            (arg stroke)
            (arg 8)
            (arg ([] caps (% serial 3)))
            (arg ([] joins (/ serial 3)))
            (arg (. FillRule nonzero))
          )
        )
      )
    )
  )
  (return (call VectorGeometry (call Rect 0 0 120 90) (call Rect 0 0 120 90) spans false false))
)

(fn-do _ run-stroke-panels _
  (param kind Size)
  (let root (call VectorStrokesRoot))
  (call markup-append root (call StrokeStylePanel kind false))
  (call markup-append root (call StrokeStylePanel kind true))
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (call (. root layout) (call Rect 0 0 400 800))
  (let renderer (call MetalOffscreenRenderer 400 800 2 white))
  (let scene (call DisplayScene 2 white renderer))
  (let reference (call RasterCanvas 400 800 2 white))
  (let result VectorStrokesResult)
  (do-use renderer
    (do-use reference
      (call (. scene build) root)
      (call (. scene commit))
      (call (. scene frame-metal) renderer)
      (call (. renderer finish))
      (call (. root paint) reference)
      (= result (call vector-strokes-result renderer reference 0 0))
      (call vector-strokes-check scene renderer)
    )
  )
  (call (. scene close))
  (call (. root close))
  (call markup-release root)
  (return result)
)

(type _ StrokeStylePanel (is Box)
  (prop + kind Size)
  (prop + skewed Bool)
  (prop _ handles (list VectorGeometryHandle))
  (blank)
  (rule This
    (= min-width (call (. SizeSpec coord) 400))
    (= max-width (call (. SizeSpec coord) 400))
    (= min-height (call (. SizeSpec coord) 400))
    (= max-height (call (. SizeSpec coord) 400))
  )
  (fn-do + This _
    (param kind _)
    (param skewed _)
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let table (call vector-geometry-table-for markup-batch-root))
    (if (not handles)
      (for (in serial (..< 0 12))
        (let key (+ 20000 (* kind 100) serial))
        (+= handles (call (. table intern-geometry) (as key U64) (=> () (call stroke-style-geometry kind serial))))
      )
    )
    (let origin (. bounds top-left))
    (for (in serial (..< 0 12))
      (let palette (list (call RGBA 0.15 0.25 0.6 1) (call RGBA 0.95 0.75 0.3 1) (call RGBA 0.8 0.2 0.3 0.7)))
      (let x (as (+ (. origin x) (+ (* (% serial 4) 100) 5)) F64))
      (let y (as (+ (. origin y) (+ (* (/ serial 4) 130) 5)) F64))
      (let transform (call matrix-from-translation (call Point x y)))
      (if skewed
        (= transform (call (. (call (. transform shear) (call Dimensions 0.3 0.15)) scale) (call Dimensions 0.85 0.8)))
      )
      (= (. canvas fill-color) null)
      (= (. canvas stroke-color) (call RGBA 0.35 0.1 0.45 1))
      (= (. canvas stroke-width) 4)
      (= (. canvas stroke-cap) (. LineCap round))
      (= (. canvas stroke-join) (. LineJoin bevel))
      (= (. canvas stroke-dash) (call stroke-style-dash kind serial))
      (let painted (call (. table paint-vector) ([] handles serial) canvas palette transform))
      (= (. canvas stroke-dash) 0)
    )
  )
)

(fn-expr _ stroke-style-dash _
  (param kind Size)
  (param serial Size)
  (match kind
    (case= 0
      0
    )
    (case= 1
      (as (+ 6 (% (* serial 5) 6)) F64)
    )
    (case? (== (% serial 4) 3)
      3
    )
    (default
      (as (+ 3 (% (* serial 5) 8)) F64)
    )
  )
)

(fn-do _ stroke-style-shape _
  (param shape Size)
  (let path (call Path))
  (match shape
    (case= 0
      (call (. path move-to) (call Point 15 20))
      (call (. path cubic-curve-to) (call Point 50 0) (call Point 85 30) (call Point 70 70))
      (call (. path line-to) (call Point 25 100))
      (call (. path close))
    )
    (case= 1
      (call (. path move-to) (call Point 15 90))
      (call (. path line-to) (call Point 30 20))
      (call (. path cubic-curve-to) (call Point 60 0) (call Point 80 40) (call Point 75 100))
    )
    (case= 2
      (call (. path move-to) (call Point 45 5))
      (call (. path line-to) (call Point 70 100))
      (call (. path line-to) (call Point 5 40))
      (call (. path line-to) (call Point 85 40))
      (call (. path line-to) (call Point 20 100))
      (call (. path close))
    )
    (case= 3
      (call (. path move-to) (call Point 10 90))
      (call (. path line-to) (call Point 30 20))
      (call (. path line-to) (call Point 50 90))
      (call (. path line-to) (call Point 70 20))
      (call (. path line-to) (call Point 90 90))
    )
    (case= 4
      (call (. path move-to) (call Point 10 10))
      (call (. path line-to) (call Point 85 10))
      (call (. path line-to) (call Point 85 50))
      (call (. path line-to) (call Point 10 50))
      (call (. path close))
      (call (. path move-to) (call Point 15 65))
      (call (. path line-to) (call Point 85 105))
      (call (. path move-to) (call Point 15 105))
      (call (. path line-to) (call Point 50 75))
      (call (. path line-to) (call Point 85 80))
    )
    (case= 5
      (call (. path move-to) (call Point 10 60))
      (call (. path cubic-curve-to) (call Point 25 0) (call Point 45 0) (call Point 50 60))
      (call (. path cubic-curve-to) (call Point 55 120) (call Point 80 120) (call Point 90 60))
    )
    (default
      (call (. path move-to) (call Point 50 10))
      (call (. path cubic-curve-to) (call Point 80 10) (call Point 90 40) (call Point 90 60))
      (call (. path cubic-curve-to) (call Point 90 90) (call Point 70 110) (call Point 50 110))
      (call (. path cubic-curve-to) (call Point 25 110) (call Point 10 85) (call Point 10 60))
      (call (. path cubic-curve-to) (call Point 10 30) (call Point 25 10) (call Point 50 10))
      (call (. path close))
    )
  )
  (return path)
)

(fn-do _ stroke-style-geometry _
  (param kind Size)
  (param serial Size)
  (let spans (list VectorGeometrySpan))
  (let none (call VectorGeometryPaint (. VectorGeometryPaintRole none) 0))
  (let fill (call VectorGeometryPaint (. VectorGeometryPaintRole color) 1))
  (let stroke (call VectorGeometryPaint (. VectorGeometryPaintRole color) 0))
  (let accent (call VectorGeometryPaint (. VectorGeometryPaintRole color) 2))
  (let caps (list (. LineCap butt) (. LineCap round) (. LineCap square)))
  (let joins (list (. LineJoin miter) (. LineJoin round) (. LineJoin bevel)))
  (let alignments (list (. StrokeAlignment inside) (. StrokeAlignment outside) (. StrokeAlignment center)))
  (let cap ([] caps (% serial 3)))
  (let join ([] joins (% (/ serial 3) 3)))
  (if (and (== kind 0) (< serial 9))
    (let shape (call stroke-style-shape (if-expr (< serial 3) 0 (if-expr (< serial 6) 1 2))))
    (let rule (if-expr (>= serial 6) (. FillRule even-odd) (. FillRule nonzero)))
    (+= spans
      (call VectorGeometrySpan
        (block
          (arg shape)
          (arg fill)
          (arg stroke)
          (arg 8)
          (arg (. LineCap round))
          (arg (. LineJoin miter))
          (arg rule)
          (arg ([] alignments (% serial 3)))
        )
      )
    )
    (else-if (and (== kind 0) (< serial 11))
      (let shape (call stroke-style-shape 0))
      (+= spans (call VectorGeometrySpan shape fill none null null null (. FillRule nonzero)))
      (+= spans
        (call VectorGeometrySpan
          (block
            (arg shape)
            (arg none)
            (arg accent)
            (arg 10)
            (arg (. LineCap butt))
            (arg (. LineJoin round))
            (arg (. FillRule nonzero))
            (arg ([] alignments (- serial 9)))
          )
        )
      )
      (+= spans
        (call VectorGeometrySpan
          (block
            (arg shape)
            (arg none)
            (arg stroke)
            (arg 3)
            (arg (. LineCap butt))
            (arg (. LineJoin miter))
            (arg (. FillRule nonzero))
          )
        )
      )
    )
    (else-if (== kind 0)
      (let widths (list Length) (list 0.1 0.25 0.4 0.5))
      (for (in index (..< 0 (. widths length)))
        (let offset (as (* index 25) F64))
        (let hair (call Path))
        (call (. hair move-to) (call Point 8 (+ 12 offset)))
        (call (. hair cubic-curve-to) (call Point 35 (- offset 6)) (call Point 60 (+ offset 30)) (call Point 92 (+ 10 offset)))
        (call (. hair line-to) (call Point 70 (+ 22 offset)))
        (+= spans
          (call VectorGeometrySpan
            (block
              (arg hair)
              (arg none)
              (arg stroke)
              (arg ([] widths index))
              (arg (. LineCap butt))
              (arg (. LineJoin miter))
              (arg (. FillRule nonzero))
            )
          )
        )
      )
    )
    (else-if (== kind 1)
      (let shapes (list Size) (list 3 2 4))
      (let shape (call stroke-style-shape ([] shapes (% serial 3))))
      (let rule (if-expr (== (% serial 3) 1) (. FillRule even-odd) (. FillRule nonzero)))
      (if (== serial 9)
        (+= spans
          (call VectorGeometrySpan
            (block
              (arg shape)
              (arg fill)
              (arg stroke)
              (arg 6)
              (arg (. LineCap butt))
              (arg (. LineJoin miter))
              (arg (. FillRule nonzero))
              (arg (. StrokeAlignment inside))
            )
          )
        )
        (else-if (== serial 10)
          (+= spans
            (call VectorGeometrySpan
              (block
                (arg shape)
                (arg fill)
                (arg (call VectorGeometryPaint (. VectorGeometryPaintRole inherit) 0))
                (arg null)
                (arg null)
                (arg null)
                (arg rule)
              )
            )
          )
        )
        (else
          (+= spans (call VectorGeometrySpan shape none stroke 5 cap join rule))
        )
      )
    )
    (else-if (== (% serial 4) 3)
      (+= spans
        (call VectorGeometrySpan
          (block
            (arg (call stroke-style-shape 4))
            (arg none)
            (arg stroke)
            (arg 5)
            (arg ([] caps (+ 1 (% serial 2))))
            (arg join)
            (arg (. FillRule nonzero))
          )
        )
      )
    )
    (else
      (let shape (call stroke-style-shape (if-expr (== (% serial 3) 0) 5 (if-expr (== (% serial 3) 1) 6 1))))
      (+= spans (call VectorGeometrySpan shape none stroke 5 cap join (. FillRule nonzero)))
    )
  )
  (let inherited (and (== kind 1) (== serial 10)))
  (return (call VectorGeometry (call Rect 0 0 100 120) (call Rect 0 0 100 120) spans false inherited))
)
