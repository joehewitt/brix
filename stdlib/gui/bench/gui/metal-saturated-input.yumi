_ SaturatedSurface is Box

+ step Size = 0
+ blur-groups Size = 0
+ arrival-times [U64]
+ arrival-steps [Size]

• This
    min-width = SizeSpec.coord(1200)
    max-width = SizeSpec.coord(1200)
    min-height = SizeSpec.coord(900)
    max-height = SizeSpec.coord(900)

────────────────────
for event on pointer-down

arrival-times += monotonic-time-nanoseconds()
arrival-steps += step

────────────────────
+ do paint-self
    - canvas Canvas

canvas.stroke-color = null
for index in 0 .. < 1000
    . shade = ((index + step) % 20) as F64
    canvas.fill-color = RGBA(0.2 + 0.03 * shade, 0.3, 0.6, 1)
    canvas.rect(Rect(((index % 50) * 24) as F64, ((index / 50) * 44) as F64, 20, 40))
for group in 0 .. < blur-groups
    canvas.begin-blur(6)
    canvas.fill-color = RGBA(0.9, 0.4, 0.2, 0.25)
    canvas.rect(Rect(20, 20, 1160, 860))
    canvas.end-blur()
