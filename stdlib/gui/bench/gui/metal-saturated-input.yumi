`benchmark.meta description: Animates a default Window CAMetalLayer through a light phase, a phase whose frames spin for 1.5 refresh intervals, and a phase of eight full-window blur groups, posting single clicks and 16-click bursts through the app event queue, and reports how long input, the main dispatch queue, and the collector wait while frames run back to back.
`benchmark.meta timing: not-recommended
`benchmark.meta profiles: gui-metal

/BxAppleGUI/BxAppleGUI.h
/BxGC/BxGC.h
/core/intrinsics
/core/markup
/core/task
/graphics/canvas
/graphics/color
/graphics/primitives
/gui/app
/gui/box
/gui/keys
/gui/layout
/gui/primitives
/gui/window
/stream/sort
/time/duration
/time/timer

. app = App()
. window = SaturatedWindow()
app += window
window.size = Dimensions(1200, 900)
. surface = SaturatedSurface()
window.surfaces += surface
markup-append(window, surface)

C:brixGuiAppDebugMainLoopProbeStart(20000000)
window.open()
if !window.finished
    C:brixGuiAppScheduleStop(app.native!, 40000000000)
    C:brixGuiAppRun(app.native!)
if window.did-fallback
    app.close()
    ?! Panic("Metal window presentation was unavailable and fell back to CoreGraphics")
if !window.finished
    app.close()
    ?! Panic("Saturated animation exceeded its 40-second execution bound")

. checksum = window.phases-reported
app.close()
-- "bench-result gui/metal-saturated-input checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ saturated-percentile U64
    - values [U64]
    - percentile Size

|? !values
    0
??
    sorted[index]

.. sorted = sort(values) • using :: left, right => if left < right then .lesser else .greater
.. index = ((sorted.length - 1) * percentile) / 100

━━━━━━━━━━━━━━━━━━━━
_ SaturatedWindow is Window

+ surfaces [SaturatedSurface]
+ did-fallback = false
+ finished = false
+ phases-reported Size = 0

_ phase Size = 0
_ phase-frame Size = 0
_ phase-started U64
_ phase-spin U64
_ refresh U64 = 8333333
_ frame-index Size = 0
_ work [U64]
_ waits [U64]
_ frame-ids [I64]
_ click-latencies [U64]
_ burst-latencies [U64]
_ burst-frames [U64]
_ click-pending = false
_ click-is-burst = false
_ click-post-time U64
_ click-post-frame Size = 0
_ clicks-expected Size = 0
_ offers-started Size = 0

• This
    layout = flow-col

────────────────────
+ do render Bool

=? false if finished
. started = monotonic-time-nanoseconds()
if phase-started == 0
    begin-phase(started)

. spun Size = 0
while monotonic-time-nanoseconds() - started < phase-spin
    spun += 1

. surface = surfaces[0]
settle-clicks(surface)
surface.step = frame-index
surface.blur-groups = if phase == 3 then 8 else 0
surface.invalidate-paint()

. did-render = super.render()
. ended = monotonic-time-nanoseconds()
if did-render && is-metal-rendering
    . frame = last-metal-frame-id
    frame-ids += frame
    work += ended - started
    waits += metal-frame-drawable-wait-nanos(frame) as U64
else if !is-metal-rendering
    did-fallback = true

if !click-pending && phase-frame % 12 == 6
    click-is-burst = phase-frame % 60 == 30
    . count Size = if click-is-burst then 16 else 1
    click-pending = true
    click-post-frame = frame-index
    click-post-time = monotonic-time-nanoseconds()
    clicks-expected += count
    for index in 0 .. < count
        C:brixGuiWindowDebugPostMouseClick(native!, 300, 300)

frame-index += 1
phase-frame += 1
. now = monotonic-time-nanoseconds()
. phase-length Size = if phase == 0 then 40 else 150
. phase-over = phase-frame >= phase-length || now - phase-started > 5000000000
if did-fallback
    finished = true
    app?.stop()
else if phase-over
    report-phase(surface, now)
    phase += 1
    if phase > 3
        finished = true
        app?.stop()
    else
        begin-phase(now)
        schedule-render()
else
    schedule-render()
= did-render

────────────────────
_ do settle-clicks
    - surface SaturatedSurface

=? if !click-pending || surface.arrival-times.length < clicks-expected
. latency = surface.arrival-times[clicks-expected - 1] - click-post-time
if click-is-burst
    burst-latencies += latency
    burst-frames += (surface.arrival-steps[clicks-expected - 1] - click-post-frame) as U64
else
    click-latencies += latency
click-pending = false

────────────────────
_ do begin-phase
    - now U64

. interval = C:brixGuiWindowGetLastFrameRefreshIntervalNanoseconds(native!)
if interval > 0
    refresh = interval
phase-started = now
phase-frame = 0
phase-spin = if phase == 2 then refresh * 3 / 2 else 0
work = List'U64()
waits = List'U64()
frame-ids = List'I64()
click-latencies = List'U64()
burst-latencies = List'U64()
burst-frames = List'U64()
offers-started = C:brixGCFrameBudgetOfferCount() as Size
. ignored = C:brixGuiAppDebugMainLoopProbeValue(3)

────────────────────
_ do report-phase
    - surface SaturatedSurface
    - now U64

settle-clicks(surface)
if click-pending
    if click-is-burst
        burst-latencies += now - click-post-time
        burst-frames += (frame-index - click-post-frame) as U64
    else
        click-latencies += now - click-post-time
    click-pending = false
phases-reported += 1
=? if phase == 0

. frames = work.length as U64
=? if frames == 0
. wall = now - phase-started
. frames-per-second = frames * 1000000000 / wall
. blocked U64
for value in waits
    blocked += value
. blocked-percent = blocked * 100 / wall
. gpu [U64]
. presented [U64]
for frame in frame-ids
    . nanos = metal-frame-gpu-nanos(frame)
    if nanos >= 0
        gpu += nanos as U64
    . shown = metal-frame-presented-time-nanoseconds(frame)
    if shown > 0
        presented += shown as U64
. slow-presents U64
for index in 1 .. < presented.length
    if presented[index] > presented[index - 1] + refresh * 3 / 2
        slow-presents += 1
. click-p50 = saturated-percentile(click-latencies, 50)
. burst-drain = saturated-percentile(burst-latencies, 100)
. burst-drain-frames = saturated-percentile(burst-frames, 100)
. wait-p50 = saturated-percentile(waits, 50)
. gpu-p50 = saturated-percentile(gpu, 50)
. dispatch-max = C:brixGuiAppDebugMainLoopProbeValue(1) as U64
. sleeps = (C:brixGuiAppDebugMainLoopProbeValue(2) as U64) * 100 / frames
. offers = ((C:brixGCFrameBudgetOfferCount() - offers-started) as U64) * 100 / frames
match? phase
    |= 1
        //gui.bench.metal.sat-light-frames-per-second += frames-per-second
        //gui.bench.metal.sat-light-click-p50-ns += click-p50
        //gui.bench.metal.sat-light-burst-drain-ns += burst-drain
        //gui.bench.metal.sat-light-burst-drain-frames += burst-drain-frames
        //gui.bench.metal.sat-light-main-dispatch-max-ns += dispatch-max
        //gui.bench.metal.sat-light-drawable-wait-p50-ns += wait-p50
        //gui.bench.metal.sat-light-slow-presents += slow-presents
    |= 2
        //gui.bench.metal.sat-cpu-frames-per-second += frames-per-second
        //gui.bench.metal.sat-cpu-click-p50-ns += click-p50
        //gui.bench.metal.sat-cpu-burst-drain-ns += burst-drain
        //gui.bench.metal.sat-cpu-burst-drain-frames += burst-drain-frames
        //gui.bench.metal.sat-cpu-main-dispatch-max-ns += dispatch-max
        //gui.bench.metal.sat-cpu-loop-sleeps-per-100-frames += sleeps
        //gui.bench.metal.sat-cpu-gc-offers-per-100-frames += offers
    |= 3
        //gui.bench.metal.sat-gpu-frames-per-second += frames-per-second
        //gui.bench.metal.sat-gpu-click-p50-ns += click-p50
        //gui.bench.metal.sat-gpu-burst-drain-ns += burst-drain
        //gui.bench.metal.sat-gpu-burst-drain-frames += burst-drain-frames
        //gui.bench.metal.sat-gpu-main-dispatch-max-ns += dispatch-max
        //gui.bench.metal.sat-gpu-loop-sleeps-per-100-frames += sleeps
        //gui.bench.metal.sat-gpu-gc-offers-per-100-frames += offers
        //gui.bench.metal.sat-gpu-blocked-percent += blocked-percent
        //gui.bench.metal.sat-gpu-drawable-wait-p50-ns += wait-p50
        //gui.bench.metal.sat-gpu-gpu-p50-ns += gpu-p50

