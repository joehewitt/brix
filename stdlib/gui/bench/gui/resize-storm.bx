; benchmark.meta description: Coalesces injected resize and backing-scale storms at the native callback boundary and proves latest-size frame commits.
; benchmark.meta timing: not-recommended
; benchmark.meta profiles: gui-probes,gui
(blank)
(import /BxAppleGUI/BxAppleGUI.h)
(import /core/intrinsics)
(import /core/task)
(import /graphics/canvas)
(blank)

(main
  (let resize-notification-count Size 200)
  (let backing-notification-count Size 80)
  (let state (call ResizeStormState))
  (= (. state native) (call C:brixGuiWindowCreate "gui bench resize-storm (offscreen)" 420 320))
  (call C:brixGuiWindowSetContentSizeChangedCallback
    (block
      (arg (!! (. state native)))
      (arg (as resize-storm-size-callback ResizeStormSizeCallback))
      (arg (as state Pointer))
    )
  )
  (call C:brixGuiWindowSetBackingScaleChangedCallback
    (block
      (arg (!! (. state native)))
      (arg (as resize-storm-backing-scale-callback ResizeStormActionCallback))
      (arg (as state Pointer))
    )
  )
  (blank)
  (for (in index (..< 0 resize-notification-count))
    (call C:brixGuiWindowDebugInjectContentSize (!! (. state native)) (+ 420 index) (+ 320 index))
  )
  (for (in index (..< 0 backing-notification-count))
    (call C:brixGuiWindowDebugInjectBackingScaleChange (!! (. state native)))
  )
  (blank)
  (call (. state done wait))
  (blank)
  (let resize-notifications (call C:brixGuiWindowDebugResizeNotificationCount (!! (. state native))))
  (let resize-services (call C:brixGuiWindowDebugResizeCallbacksServiced (!! (. state native))))
  (let resize-coalesced (call C:brixGuiWindowDebugResizeCoalescedCount (!! (. state native))))
  (let resize-pending (call C:brixGuiWindowDebugResizePendingCount (!! (. state native))))
  (let resize-pending-high-water (call C:brixGuiWindowDebugResizePendingHighWaterMark (!! (. state native))))
  (let resize-frames (call C:brixGuiWindowDebugResizeFrameCommitCount (!! (. state native))))
  (let resize-frames-high-water
    (call C:brixGuiWindowDebugResizeFramesPerCallbackHighWaterMark
      (block
        (arg (!! (. state native)))
      )
    )
  )
  (let obsolete-renders (call C:brixGuiWindowDebugResizeObsoleteSizeRenderCount (!! (. state native))))
  (let backing-notifications (call C:brixGuiWindowDebugBackingScaleNotificationCount (!! (. state native))))
  (let backing-services (call C:brixGuiWindowDebugBackingScaleCallbacksServiced (!! (. state native))))
  (let backing-coalesced (call C:brixGuiWindowDebugBackingScaleCoalescedCount (!! (. state native))))
  (let backing-pending (call C:brixGuiWindowDebugBackingScalePendingCount (!! (. state native))))
  (let backing-pending-high-water
    (call C:brixGuiWindowDebugBackingScalePendingHighWaterMark
      (block
        (arg (!! (. state native)))
      )
    )
  )
  (blank)
  (throw (call Panic "resize storm did not service the initial latest size and one follow-up") (if (or (!= resize-notifications (as (+ resize-notification-count 1) U64)) (!= resize-services 2))))
  (throw (call Panic "resize storm did not report every replaced notification as coalesced") (if (!= resize-coalesced (as (- resize-notification-count 1) U64))))
  (throw (call Panic "resize pending slot exceeded one task or remained wedged") (if (or (!= resize-pending 0) (!= resize-pending-high-water 1))))
  (throw (call Panic "a serviced resize committed more or less than one frame") (if (or (!= resize-frames 2) (!= resize-frames-high-water 1) (!= (. state frames-committed) 2))))
  (throw (call Panic "resize storm committed an obsolete native size") (if (or (!= obsolete-renders 0) (!= (. state obsolete-renders) 0))))
  (let final-width (call C:brixGuiWindowGetContentWidth (!! (. state native))))
  (let final-height (call C:brixGuiWindowGetContentHeight (!! (. state native))))
  (throw (call Panic "resize storm did not finish at the newest injected dimensions") (if (or (!= final-width 900) (!= final-height 700))))
  (let backing-counts-match (== backing-notifications (as backing-notification-count U64)))
  (= backing-counts-match (and backing-counts-match (== backing-services 1)))
  (let expected-backing-coalesced (as (- backing-notification-count 1) U64))
  (= backing-counts-match (and backing-counts-match (== backing-coalesced expected-backing-coalesced)))
  (throw (call Panic "backing-scale storm did not coalesce to one callback") (if (not backing-counts-match)))
  (throw (call Panic "backing-scale pending slot exceeded one task or remained wedged") (if (or (!= backing-pending 0) (!= backing-pending-high-water 1))))
  (throw (call Panic "other main-queue work did not run between resize renders") (if (not (. state backing-between-resizes))))
  (blank)
  (probe-count gui.bench.resize.notifications resize-notifications)
  (probe-count gui.bench.resize.callbacks-serviced resize-services)
  (probe-count gui.bench.resize.coalesced resize-coalesced)
  (probe-count gui.bench.resize.pending-high-water resize-pending-high-water)
  (probe-count gui.bench.resize.frames-committed resize-frames)
  (probe-count gui.bench.resize.frames-per-callback-high-water resize-frames-high-water)
  (probe-count gui.bench.resize.obsolete-sizes-rendered obsolete-renders)
  (probe-count gui.bench.backing-scale.notifications backing-notifications)
  (probe-count gui.bench.backing-scale.callbacks-serviced backing-services)
  (probe-count gui.bench.backing-scale.coalesced backing-coalesced)
  (probe-count gui.bench.backing-scale.pending-high-water backing-pending-high-water)
  (probe-count gui.adapter.resize.obsolete-sizes-rendered (. state obsolete-renders))
  (blank)
  (call C:brixGuiWindowClose (!! (. state native)))
  (call C:brixGuiWindowRelease (!! (. state native)))
  (= (. state native) null)
  (blank)
  (let checksum (+ resize-notifications resize-services resize-coalesced resize-frames))
  (+= checksum (+ backing-notifications backing-services backing-coalesced))
  (print (str "bench-result gui/resize-storm checksum=" checksum))
)

(type + ResizeStormSizeCallback (is (c-fn-type Void (param context Pointer) (param width F64) (param height F64))))

(type + ResizeStormActionCallback (is (c-fn-type Void (param context Pointer))))

(type + ResizeStormState
  (prop + native (? Pointer))
  (prop + done _ (:= (call Semaphore)))
  (prop + resize-services Size (= 0))
  (prop + frames-committed Size (= 0))
  (prop + obsolete-renders Size (= 0))
  (prop + backing-between-resizes _ (= false))
)

(fn-do + resize-storm-size-callback _
  (param context Pointer)
  (param width F64)
  (param height F64)
  (let state (call (of gc-object-from-pointer ResizeStormState) context))
  (+= (. state resize-services) 1)
  (probe-count gui.adapter.resize.callbacks-serviced)
  (blank)
  (let scale (call C:brixGuiWindowGetBackingScaleFactor (!! (. state native))))
  (let canvas (call RasterCanvas (as width I32) (as height I32) scale))
  (do-use canvas
    (call C:brixGuiWindowCommitFrame (!! (. state native)) (. canvas native) 0 0 (. canvas width) (. canvas height))
  )
  (+= (. state frames-committed) 1)
  (probe-count gui.adapter.resize.frames-committed)
  (blank)
  (let current-size-is-latest (== (call C:brixGuiWindowGetContentWidth (!! (. state native))) width))
  (let current-height-is-latest (== (call C:brixGuiWindowGetContentHeight (!! (. state native))) height))
  (= current-size-is-latest (and current-size-is-latest current-height-is-latest))
  (if (not current-size-is-latest)
    (+= (. state obsolete-renders) 1)
  )
  (blank)
  (if (== (. state resize-services) 1)
    (call C:brixGuiWindowDebugInjectContentSize (!! (. state native)) 900 700)
    (else
      (call (. state done post))
    )
  )
)

(fn-do + resize-storm-backing-scale-callback _
  (param context Pointer)
  (let state (call (of gc-object-from-pointer ResizeStormState) context))
  (probe-count gui.adapter.backing-scale.callbacks-serviced)
  (= (. state backing-between-resizes) (== (. state resize-services) 1))
)
