; benchmark.meta description: Apply-and-settle time of one sparse edit among 1k and 3k live rows of markup with tracked reads: a row label, an equal write, a hover, a keystroke, the rows' font size, and a filter and its reversal over plain and virtual rows, with what building the rows costs.
; benchmark.meta timing: recommended
; benchmark.meta profiles: sparse-edits
(blank)
(import /BxGC/BxGC.h)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/text)
(import /gui)
(import /gui/scene)
(import /stream/sort)
(import /time/timer)
(import /ui/virtual)
(import /ui/virtual-layout)
(blank)
(prop _ row-height _ (= 28.0))
(prop _ header-height _ (= 44.0))
(prop _ title-x _ (= 240.0))
(prop _ edited-row Index (= 12))
(prop _ inbox-topics _
  (=
    (call List
      (block
        (item "budget")
        (item "launch")
        (item "hiring")
        (item "design")
        (item "travel")
        (item "review")
        (item "offsite")
        (item "roadmap")
        (item "invoice")
        (item "support")
      )
    )
  )
)
(blank)

(main
  (let checksum Size)
  (+= checksum (call run-plain 1000))
  (+= checksum (call run-plain 3000))
  (+= checksum (call run-virtual 1000))
  (+= checksum (call run-virtual 3000))
  (blank)
  (print (str "bench-result gui/sparse-edits checksum=" checksum))
)

(fn-do + run-plain Size
  (param count Size)
  (let threads (call inbox-threads count))
  (let objects-before (call allocated-objects))
  (let started (call monotonic-time-nanoseconds))
  (let window (call InboxWindow))
  (= (. window threads) threads)
  (call (. window open))
  (call (. window layout))
  (let scene (call DisplayScene 2 white))
  (let canvas (call RasterCanvas 900 700 2 white))
  (let checksum Size)
  (do-use scene
    (do-use canvas
      (call (. scene build) window)
      (call (. scene commit))
      (call (. scene frame) canvas)
      (let build-us (/ (- (call monotonic-time-nanoseconds) started) 1000))
      (let build-objects (- (call allocated-objects) objects-before))
      (let frame (call SettleFrame window scene canvas))
      (let edited ([] threads edited-row))
      (let edited-point (call row-point edited-row))
      (let next-point (call row-point (+ edited-row 1)))
      (blank)
      (let label-edit
        (=> ((: step Size)) :do
          (block
            (= (. edited title) (str "Edited " step))
          )
        )
      )
      (let label-us (call (. frame p50-us) 21 label-edit))
      (throw (call Panic "sparse-edits label edit did not reach its row") (if (!= (call label-at window edited-point) "Edited 20")))
      (blank)
      (let label-objects-before (call allocated-objects))
      (let ignored (call (. frame timed) 21 label-edit))
      (let label-objects (- (call allocated-objects) label-objects-before))
      (blank)
      (let equal-edit
        (=> ((: step Size)) :do
          (block
            (= (. edited title) "Edited 21")
          )
        )
      )
      (let equal-us (call (. frame p50-us) 21 equal-edit))
      (throw (call Panic "sparse-edits equal write changed its row") (if (!= (call label-at window edited-point) "Edited 21")))
      (blank)
      (let hover-edit
        (=> ((: step Size)) :do
          (block
            (let point (if-expr (== (% step 2) 0) edited-point next-point))
            (call (. window dispatch-pointer-event) (call PointerMoveEvent (call PointerEventData point)))
          )
        )
      )
      (let hover-us (call (. frame p50-us) 21 hover-edit))
      (throw (call Panic "sparse-edits hover did not reach its row") (if (not (. (!! (call (. window hit-path) edited-point)) target is-hovered))))
      (blank)
      (let keystroke-edit
        (=> ((: step Size)) :do
          (block
            (call (. window draft accept-native-input) (str (. window draft text) "k"))
          )
        )
      )
      (let keystroke-us (call (. frame p50-us) 21 keystroke-edit))
      (throw (call Panic "sparse-edits keystrokes did not reach the draft") (if (!= (. window draft text length) 21)))
      (blank)
      (let font-edit
        (=> ((: step Size)) :do
          (block
            (= (. window row-font-size) (if-expr (== (% step 2) 0) 14 13))
          )
        )
      )
      (let font-us (call (. frame p50-us) 7 font-edit))
      (blank)
      (let narrow
        (=> ((: step Size)) :do
          (block
            (= (. window query) ([] inbox-topics 0))
          )
        )
      )
      (let widen
        (=> ((: step Size)) :do
          (block
            (= (. window query) "")
          )
        )
      )
      (let narrows (list U64))
      (let widens (list U64))
      (for (in step (..< 0 7))
        (+= narrows (call (. frame timed) step narrow))
        (throw (call Panic "sparse-edits filter did not narrow the rows") (if (!= (call label-at window (call row-point 1)) "budget thread 10")))
        (blank)
        (+= widens (call (. frame timed) step widen))
        (throw (call Panic "sparse-edits filter did not restore the rows") (if (!= (call label-at window (call row-point 1)) "launch thread 1")))
      )
      (let filter-us (call median-us narrows))
      (let unfilter-us (call median-us widens))
      (blank)
      (if (== count 1000)
        (probe-count gui.bench.sparse.build-us-1k build-us)
        (probe-count gui.bench.sparse.build-objects-1k build-objects)
        (probe-count gui.bench.sparse.label-us-1k label-us)
        (probe-count gui.bench.sparse.label-objects-1k label-objects)
        (probe-count gui.bench.sparse.equal-us-1k equal-us)
        (probe-count gui.bench.sparse.hover-us-1k hover-us)
        (probe-count gui.bench.sparse.keystroke-us-1k keystroke-us)
        (probe-count gui.bench.sparse.font-us-1k font-us)
        (probe-count gui.bench.sparse.filter-us-1k filter-us)
        (probe-count gui.bench.sparse.unfilter-us-1k unfilter-us)
        (else
          (probe-count gui.bench.sparse.build-us-3k build-us)
          (probe-count gui.bench.sparse.build-objects-3k build-objects)
          (probe-count gui.bench.sparse.label-us-3k label-us)
          (probe-count gui.bench.sparse.label-objects-3k label-objects)
          (probe-count gui.bench.sparse.equal-us-3k equal-us)
          (probe-count gui.bench.sparse.hover-us-3k hover-us)
          (probe-count gui.bench.sparse.keystroke-us-3k keystroke-us)
          (probe-count gui.bench.sparse.font-us-3k font-us)
          (probe-count gui.bench.sparse.filter-us-3k filter-us)
          (probe-count gui.bench.sparse.unfilter-us-3k unfilter-us)
        )
      )
      (= checksum (+ count (. window draft text length) (. window threads length)))
    )
  )
  (blank)
  (call (. window close))
  (return checksum)
)

(fn-do + run-virtual Size
  (param count Size)
  (let threads (call inbox-threads count))
  (let objects-before (call allocated-objects))
  (let started (call monotonic-time-nanoseconds))
  (let window (call VirtualInboxWindow))
  (call (. window thread-source replace) threads)
  (call (. window open))
  (call (. window layout))
  (let scene (call DisplayScene 2 white))
  (let canvas (call RasterCanvas 900 700 2 white))
  (let checksum Size)
  (do-use scene
    (do-use canvas
      (call (. scene build) window)
      (call (. scene commit))
      (call (. scene frame) canvas)
      (let build-us (/ (- (call monotonic-time-nanoseconds) started) 1000))
      (let build-objects (- (call allocated-objects) objects-before))
      (let frame (call SettleFrame window scene canvas))
      (blank)
      (let narrowed (call matching-threads threads ([] inbox-topics 0)))
      (let narrow
        (=> ((: step Size)) :do
          (block
            (call (. window thread-source replace) narrowed)
          )
        )
      )
      (let widen
        (=> ((: step Size)) :do
          (block
            (call (. window thread-source replace) threads)
          )
        )
      )
      (let narrows (list U64))
      (let widens (list U64))
      (for (in step (..< 0 7))
        (+= narrows (call (. frame timed) step narrow))
        (throw (call Panic "sparse-edits virtual filter did not narrow the rows") (if (!= (call label-at window (call row-point 1)) "budget thread 10")))
        (blank)
        (+= widens (call (. frame timed) step widen))
        (throw (call Panic "sparse-edits virtual filter did not restore the rows") (if (!= (call label-at window (call row-point 1)) "launch thread 1")))
      )
      (let filter-us (call median-us narrows))
      (let unfilter-us (call median-us widens))
      (blank)
      (if (== count 1000)
        (probe-count gui.bench.sparse.virtual-build-us-1k build-us)
        (probe-count gui.bench.sparse.virtual-build-objects-1k build-objects)
        (probe-count gui.bench.sparse.virtual-filter-us-1k filter-us)
        (probe-count gui.bench.sparse.virtual-unfilter-us-1k unfilter-us)
        (else
          (probe-count gui.bench.sparse.virtual-build-us-3k build-us)
          (probe-count gui.bench.sparse.virtual-build-objects-3k build-objects)
          (probe-count gui.bench.sparse.virtual-filter-us-3k filter-us)
          (probe-count gui.bench.sparse.virtual-unfilter-us-3k unfilter-us)
        )
      )
      (= checksum (+ count (. window thread-source count)))
    )
  )
  (blank)
  (call (. window close))
  (return checksum)
)

(fn-expr + inbox-threads (list InboxThread)
  (param count Size)
  (spread (..< 0 count))
  (pipe *> (call InboxThread each (str "Sender " (% each 97)) (str ([] inbox-topics (% each (. inbox-topics length))) " thread " each)))
  (pipe |> List)
)

(fn-expr + matching-threads (list InboxThread)
  (param threads (list InboxThread))
  (param query String)
  (spread threads)
  (pipe ?> (or (not query) (call (. each title starts-with) (str query " "))))
  (pipe |> List)
)

(fn-expr + row-point Point
  (param row Index)
  (call Point title-x (+ header-height (* (+ (as row F64) 0.5) row-height)))
)

(fn-expr + label-at String
  (param window Window)
  (param point Point)
  (?? (?. (as (?. (call (. window hit-path) point) target) (? Label)) text) "")
)

(fn-expr + allocated-objects U64
  (+ (call C:brixGCAllocatedObjectCount) (call C:brixGCThreadPendingAllocatedObjectCount))
)

(fn-expr + median-us U64
  (param values (list U64))
  (/ ([] sorted (/ (. sorted length) 2)) 1000)
  (where
    (lazy sorted (call sort values (:using (=> (left right) (if-expr (< left right) .lesser .greater)))))
  )
)

(type + SettleFrame
  (prop + window Window)
  (prop + scene DisplayScene)
  (prop + canvas RasterCanvas)
  (fn-do + This _
    (param window _)
    (param scene _)
    (param canvas _)
  )
  (fn-do + settle _
    (let queue (. (!! (. window markup-batch-root)) markup-batch-queue))
    (call (. queue checkpoint))
    (let passes Size 1)
    (while (and (. queue actions) (< passes 64))
      (call (. queue checkpoint))
      (+= passes 1)
    )
    (call (. window layout))
    (call (. scene update) window)
    (call (. scene commit))
    (call (. scene frame) canvas)
  )
  (fn-do + timed U64
    (param step Size)
    (param edit (of Statement Size))
    (let started (call monotonic-time-nanoseconds))
    (call edit step)
    (call settle)
    (return (- (call monotonic-time-nanoseconds) started))
  )
  (fn-do + p50-us U64
    (param steps Size)
    (param edit (of Statement Size))
    (let times (list U64))
    (for (in step (..< 0 steps))
      (+= times (call timed step edit))
    )
    (return (call median-us times))
  )
)

(type + InboxThread
  (prop + id Index)
  (prop + sender String)
  (prop + title String)
  (fn-do + This _
    (param id _)
    (param sender _)
    (param title _)
  )
)

(style SparseEditsTheme
  (using GUIDefaultTheme)
  (rule inbox-header (• flex-row) (• items-center) (• h 44) (• px 12) (• bg gui-panel-color))
  (blank)
  (rule inbox-title (• w 120)
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule thread-list (• flex-col) (• flex 1)
    (= overflow-y (. ScrollOverflow auto))
  )
  (blank)
  (rule thread-row (• flex-row) (• items-center) (• h 28) (• px 12)
    (blank)
    (when-style #is-hover-within
      (• bg gui-hover-color)
    )
  )
  (blank)
  (rule thread-sender (• w 160) (• text gui-muted-text-color))
)

(type + ThreadRow (is Box)
  (using SparseEditsTheme)
  (prop + thread (? InboxThread))
  (blank)
  (rule This (• thread-row))
  (content
    (<> This
      (<> Label (• thread-sender)
        (= text (?? (?. #thread #sender) ""))
      )
      (<> Label (• flex 1)
        (= text (?? (?. #thread #title) ""))
      )
    )
  )
)

(type + InboxWindow (is Window)
  (using SparseEditsTheme)
  (prop + threads (list InboxThread))
  (prop + query _ (= ""))
  (prop + row-font-size Length (= 13))
  (content
    (<> This (• flex-col)
      (= size (tuple 900 700))
      (blank)
      (<> Box (• inbox-header)
        (<> Label (text: "Inbox") (• inbox-title))
        (<> TextInput (id: draft) (• flex 1)
          (= placeholder "Reply")
        )
      )
      (<> Box (• thread-list)
        (= font-size #row-font-size)
        (for (in item (call matching-threads #threads #query) (keyed-by (. item id)))
          (<> ThreadRow
            (= thread item)
          )
        )
      )
    )
  )
  (fn-do + ensure-native _)
  (fn-do + render Bool
    (return false)
  )
  (fn-do + schedule-render _)
)

(type + VirtualInboxWindow (is Window)
  (using SparseEditsTheme)
  (prop + thread-source _ (:= (call (of VirtualListSource InboxThread))))
  (content
    (<> This (• flex-col)
      (= size (tuple 900 700))
      (blank)
      (<> Box (• inbox-header)
        (<> Label (text: "Inbox") (• inbox-title))
      )
      (<> (of VirtualRegion InboxThread) (id: region) (• flex 1)
        (= source thread-source)
        (= virtual-layout (call VerticalFixedLayout 28vcoord))
        (blank)
        (<> ThreadRow (slot: row) (param: slot)
          (= thread (. slot #item))
        )
      )
    )
  )
  (fn-do + ensure-native _)
  (fn-do + render Bool
    (return false)
  )
  (fn-do + schedule-render _)
)
