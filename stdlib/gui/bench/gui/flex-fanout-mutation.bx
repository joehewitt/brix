; benchmark.meta description: Flex-column re-arrange cost after a no-op content-size invalidation at 1k and 10k direct-child fanout, for all-flex and weight-zero children.
; benchmark.meta timing: not-recommended
; benchmark.meta profiles: gui,compile-timing
(blank)
(import /BxGC/BxGC.h)
(import /core/markup)
(import /graphics/primitives)
(import /gui/box)
(import /gui/layout)
(import /gui/primitives)
(import /gui/shorthands)
(import /stream/sort)
(import /time/timer)
(blank)
(prop _ measure-calls Size (= 0))
(prop _ content-measures Size (= 0))
(prop _ layout-visits Size (= 0))
(prop _ checksum Size (= 0))
(blank)

(main
  (call fanout-scenarios 1000 9)
  (call fanout-scenarios 10000 9)
  (blank)
  (print (str "bench-result gui/flex-fanout-mutation checksum=" checksum))
)

(fn-do + reset-counters _
  (= measure-calls 0)
  (= content-measures 0)
  (= layout-visits 0)
)

(fn-do + fanout-scenarios _
  (param fanout Size)
  (param iterations Size)
  (let flex-root (call FlexFanRoot))
  (call markup-mount-root flex-root flex-root)
  (let flex-cells (list FlexFanCell))
  (for (in index (..< 0 fanout))
    (let cell (call FlexFanCell))
    (+= flex-cells cell)
    (call markup-append flex-root cell)
  )
  (call (. flex-root markup-batch-queue checkpoint))
  (call (. flex-root layout) (call Rect 0 0 1200 900))
  (call measure-flex-pokes flex-root ([] flex-cells (/ fanout 2)) fanout iterations)
  (call (. flex-root close))
  (call markup-release flex-root)
  (blank)
  (let fixed-root (call FlexFanRoot))
  (call markup-mount-root fixed-root fixed-root)
  (let fixed-cells (list FlexFixedCell))
  (for (in index (..< 0 fanout))
    (let cell (call FlexFixedCell))
    (+= fixed-cells cell)
    (call markup-append fixed-root cell)
  )
  (call (. fixed-root markup-batch-queue checkpoint))
  (call (. fixed-root layout) (call Rect 0 0 1200 900))
  (call measure-fixed-pokes fixed-root ([] fixed-cells (/ fanout 2)) fanout iterations)
  (call (. fixed-root close))
  (call markup-release fixed-root)
)

(fn-do + measure-flex-pokes _
  (param root FlexFanRoot)
  (param target FlexFanCell)
  (param fanout Size)
  (param iterations Size)
  (let times (list U64))
  (let objects Size 0)
  (let bytes Size 0)
  (for (in iteration (..< 0 iterations))
    (call (. target invalidate-content-size))
    (call reset-counters)
    (let objects0 (call C:brixGCAllocatedObjectCount))
    (let bytes0 (call C:brixGCRequestedByteCount))
    (let time0 (call monotonic-time-nanoseconds))
    (call (. root update-layout))
    (let time1 (call monotonic-time-nanoseconds))
    (+= times (- time1 time0))
    (= objects (as (- (call C:brixGCAllocatedObjectCount) objects0) Size))
    (= bytes (as (- (call C:brixGCRequestedByteCount) bytes0) Size))
  )
  (blank)
  (let p50 (call percentile-us times 50))
  (let p95 (call percentile-us times 95))
  (if (== fanout 1000)
    (probe-count gui.bench.flex-fanout.all-flex.measure-calls-1k measure-calls)
    (probe-count gui.bench.flex-fanout.all-flex.content-measures-1k content-measures)
    (probe-count gui.bench.flex-fanout.all-flex.layout-visits-1k layout-visits)
    (probe-count gui.bench.flex-fanout.all-flex.objects-1k objects)
    (probe-count gui.bench.flex-fanout.all-flex.bytes-1k bytes)
    (probe-count gui.bench.flex-fanout.all-flex.p50-us-1k p50)
    (probe-count gui.bench.flex-fanout.all-flex.p95-us-1k p95)
    (else
      (probe-count gui.bench.flex-fanout.all-flex.measure-calls-10k measure-calls)
      (probe-count gui.bench.flex-fanout.all-flex.content-measures-10k content-measures)
      (probe-count gui.bench.flex-fanout.all-flex.layout-visits-10k layout-visits)
      (probe-count gui.bench.flex-fanout.all-flex.objects-10k objects)
      (probe-count gui.bench.flex-fanout.all-flex.bytes-10k bytes)
      (probe-count gui.bench.flex-fanout.all-flex.p50-us-10k p50)
      (probe-count gui.bench.flex-fanout.all-flex.p95-us-10k p95)
    )
  )
  (+= checksum (+ measure-calls content-measures layout-visits objects bytes))
)

(fn-do + measure-fixed-pokes _
  (param root FlexFanRoot)
  (param target FlexFixedCell)
  (param fanout Size)
  (param iterations Size)
  (let times (list U64))
  (let objects Size 0)
  (let bytes Size 0)
  (for (in iteration (..< 0 iterations))
    (call (. target invalidate-content-size))
    (call reset-counters)
    (let objects0 (call C:brixGCAllocatedObjectCount))
    (let bytes0 (call C:brixGCRequestedByteCount))
    (let time0 (call monotonic-time-nanoseconds))
    (call (. root update-layout))
    (let time1 (call monotonic-time-nanoseconds))
    (+= times (- time1 time0))
    (= objects (as (- (call C:brixGCAllocatedObjectCount) objects0) Size))
    (= bytes (as (- (call C:brixGCRequestedByteCount) bytes0) Size))
  )
  (blank)
  (let p50 (call percentile-us times 50))
  (let p95 (call percentile-us times 95))
  (if (== fanout 1000)
    (probe-count gui.bench.flex-fanout.weight-zero.measure-calls-1k measure-calls)
    (probe-count gui.bench.flex-fanout.weight-zero.content-measures-1k content-measures)
    (probe-count gui.bench.flex-fanout.weight-zero.layout-visits-1k layout-visits)
    (probe-count gui.bench.flex-fanout.weight-zero.objects-1k objects)
    (probe-count gui.bench.flex-fanout.weight-zero.bytes-1k bytes)
    (probe-count gui.bench.flex-fanout.weight-zero.p50-us-1k p50)
    (probe-count gui.bench.flex-fanout.weight-zero.p95-us-1k p95)
    (else
      (probe-count gui.bench.flex-fanout.weight-zero.measure-calls-10k measure-calls)
      (probe-count gui.bench.flex-fanout.weight-zero.content-measures-10k content-measures)
      (probe-count gui.bench.flex-fanout.weight-zero.layout-visits-10k layout-visits)
      (probe-count gui.bench.flex-fanout.weight-zero.objects-10k objects)
      (probe-count gui.bench.flex-fanout.weight-zero.bytes-10k bytes)
      (probe-count gui.bench.flex-fanout.weight-zero.p50-us-10k p50)
      (probe-count gui.bench.flex-fanout.weight-zero.p95-us-10k p95)
    )
  )
  (+= checksum (+ measure-calls content-measures layout-visits objects bytes))
)

(fn-expr + percentile-us _
  (param values (list U64))
  (param percentile Size)
  (case? (not values)
    0
  )
  (default
    (/ ([] sorted index) 1000)
  )
  (where
    (lazy sorted (call sort values (:using (=> (left right) (if-expr (< left right) .lesser .greater)))))
    (lazy index (/ (* (- (. sorted length) 1) percentile) 100))
  )
)

(type + FlexFanRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (rule This
    (= layout flex-col)
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
  (fn-do + did-layout _
    (+= layout-visits 1)
    (call (. super did-layout))
  )
)

(type + FlexFanCell (is Box)
  (rule This (• flex 1))
  (fn-do + measure MeasureResult
    (param query MeasureQuery (= (call measure-fit-query)))
    (+= measure-calls 1)
    (return (call (. super measure) query))
  )
  (fn-do + measured-content-size Dimensions
    (param query MeasureQuery)
    (+= content-measures 1)
    (return (call (. super measured-content-size) query))
  )
  (fn-do + did-layout _
    (+= layout-visits 1)
    (call (. super did-layout))
  )
)

(type + FlexFixedCell (is Box)
  (rule This
    (= min-width (call (. SizeSpec coord) 11))
    (= max-width (call (. SizeSpec coord) 11))
    (= min-height (call (. SizeSpec coord) 8))
    (= max-height (call (. SizeSpec coord) 8))
  )
  (fn-do + measure MeasureResult
    (param query MeasureQuery (= (call measure-fit-query)))
    (+= measure-calls 1)
    (return (call (. super measure) query))
  )
  (fn-do + measured-content-size Dimensions
    (param query MeasureQuery)
    (+= content-measures 1)
    (return (call (. super measured-content-size) query))
  )
  (fn-do + did-layout _
    (+= layout-visits 1)
    (call (. super did-layout))
  )
)
