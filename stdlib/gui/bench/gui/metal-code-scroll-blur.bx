; benchmark.meta description: Offscreen Metal frames scrolling a 1200x900 CodeEditor one and three rows at a time through 4,000 lines of plain text, first sharp, then under the scroll blur filter sized from each frame's distance, with GPU time taken from the three-row frames and the first blurred frame timed on its own.
; benchmark.meta timing: not-recommended
; benchmark.meta profiles: gui-metal
(blank)
(import /code/code-session)
(import /core/markup)
(import /graphics/color)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/shader)
(import /gui)
(import /gui/code-editor)
(import /gui/metal)
(import /gui/scene)
(import /gui/scroll-blur)
(import /math)
(import /stream/sort)
(import /time/timer)
(blank)
(prop _ code-scroll-line-count Size (= 4000))
(prop _ code-scroll-start-line Size (= 200))
(prop _ code-scroll-warmup Size (= 12))
(prop _ code-scroll-frames Size (= 60))
(prop _ code-scroll-long-step Size (= 3))
(prop _ code-scroll-shutter _ (= 0.5))
(prop _ code-scroll-most Length (= 40))
(blank)

(main
  (let root (call CodeScrollBenchRoot))
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (call (. root code show) (call CodeSession (call (. "\n" join) (in (call code-scroll-line each) (..< 0 code-scroll-line-count)))))
  (call (. root markup-batch-queue checkpoint))
  (call (. root layout) (call Rect 0 0 1200 900))
  (let scene (call DisplayScene 2 white))
  (let renderer (call MetalOffscreenRenderer 1200 900 2 white))
  (let checksum Size)
  (do-use renderer
    (call (. scene build) root)
    (call (. scene commit))
    (call (. scene frame-metal) renderer)
    (call (. renderer finish))
    (let sharp (call code-scroll-pass root scene renderer false))
    (let blurred (call code-scroll-pass root scene renderer true))
    (throw (call Panic "Blurred code scroll frames drew no filter pass") (if (<= (. blurred draw-calls) (. sharp draw-calls))))
    (probe-count gui.bench.metal.code-scroll-cpu-p50-ns (call code-scroll-percentile (. sharp cpu) 50))
    (probe-count gui.bench.metal.code-scroll-cpu-p99-ns (call code-scroll-percentile (. sharp cpu) 99))
    (probe-count gui.bench.metal.code-scroll-gpu-p50-ns (call code-scroll-percentile (. sharp gpu) 50))
    (probe-count gui.bench.metal.code-blur-cpu-p50-ns (call code-scroll-percentile (. blurred cpu) 50))
    (probe-count gui.bench.metal.code-blur-cpu-p99-ns (call code-scroll-percentile (. blurred cpu) 99))
    (probe-count gui.bench.metal.code-blur-gpu-p50-ns (call code-scroll-percentile (. blurred gpu) 50))
    (probe-count gui.bench.metal.code-blur-first-cpu-ns (. blurred first))
    (= checksum (+ (as (. blurred top) Int) (. sharp draw-calls) (. blurred draw-calls)))
  )
  (call (. scene close))
  (call (. root close))
  (call markup-release root)
  (print (str "bench-result gui/metal-code-scroll-blur checksum=" checksum))
)

(type _ CodeScrollBenchRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (content
    (<> This (• flex-col)
      (<> CodeEditor (id: code) (• flex 1))
    )
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
    (let ignored (. flush applied))
  )
)

(type _ CodeScrollPass
  (prop + cpu (list U64))
  (prop + gpu (list U64))
  (prop + draw-calls Size)
  (prop + first U64)
  (prop + top Length)
)

(fn-do _ code-scroll-pass CodeScrollPass
  (param root CodeScrollBenchRoot)
  (param scene DisplayScene)
  (param renderer MetalOffscreenRenderer)
  (param blurs Bool)
  (let pass (call CodeScrollPass))
  (let code (. root code))
  (let line code-scroll-start-line)
  (call (. code scroll-to-line) line)
  (call (. root update-layout))
  (call (. scene update) root)
  (call (. scene commit))
  (call (. scene frame-metal) renderer)
  (call (. renderer finish))
  (for (in index (..< 0 (+ code-scroll-warmup code-scroll-frames)))
    (let before (. code text-scroll y))
    (let step (if-expr (== (% index 2) 0) code-scroll-long-step 1))
    (+= line step)
    (let started (call monotonic-time-nanoseconds))
    (call (. code scroll-to-line) line)
    (call (. root update-layout))
    (let moved (- (. code text-scroll y) before))
    (if blurs
      (let blur
        (call scroll-blur-pass
          (block
            (arg (call Point 0 (call min (* moved code-scroll-shutter) code-scroll-most)))
            (arg (call (of List Rect)))
            (arg 2)
          )
        )
      )
      (= (. code filters) (list blur))
      (call (. root markup-batch-queue checkpoint))
    )
    (call (. scene update) root)
    (call (. scene commit))
    (call (. scene frame-metal) renderer)
    (let spent (- (call monotonic-time-nanoseconds) started))
    (call (. renderer finish))
    (throw (call Panic "Code scroll frame did not move") (if (<= moved 0)))
    (throw (call Panic "Code scroll frame skipped Metal operations") (if (!= (. renderer skipped-ops) 0)))
    (blank)
    (if (== index 0)
      (= (. pass first) spent)
    )
    (if (>= index code-scroll-warmup)
      (+= (. pass cpu) spent)
      (+= (. pass draw-calls) (as (. renderer draw-calls) Size))
      (if (and (== step code-scroll-long-step) (>= (. renderer gpu-nanos) 0))
        (+= (. pass gpu) (as (. renderer gpu-nanos) U64))
      )
    )
  )
  (throw (call Panic "Code scroll frames reported no GPU time") (if (== (. pass gpu length) 0)))
  (blank)
  (= (. pass top) (. code text-scroll y))
  (if blurs
    (= (. code filters) (call (of List ShaderFilter)))
    (call (. root markup-batch-queue checkpoint))
  )
  (return pass)
)

(fn-expr _ code-scroll-line String
  (param index Size)
  (match (% index 6)
    (case= 0
      "━━━━━━━━━━━━━━━━━━━━"
    )
    (case= 1
      (str "+ do bench-step-" index " Size")
    )
    (case= 2
      (str "    - offset Size = " index)
    )
    (case= 3
      ""
    )
    (case= 4
      (str ". total = offset * " index " + measure(items[" index " % 16], scale)")
    )
    (default
      (str "= total + clamp(offset - " index ", 0, limit) // checked")
    )
  )
)

(fn-expr _ code-scroll-percentile U64
  (param values (list U64))
  (param percentile Size)
  (case? (not values)
    0
  )
  (default
    ([] sorted index)
  )
  (where
    (lazy sorted (call sort values (:using (=> (left right) (if-expr (< left right) .lesser .greater)))))
    (lazy index (/ (* (- (. sorted length) 1) percentile) 100))
  )
)
