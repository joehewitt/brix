`benchmark.meta description: Hit-path timing and allocation over a clipped 10k-row list.
`benchmark.meta timing: recommended
`benchmark.meta profiles: gui,compile-timing

/BxGC/BxGC.h
/core/markup
/graphics/canvas
/graphics/color
/graphics/point
/graphics/primitives
/gui/box
/gui/keys
/gui/layout
/gui/primitives
/gui/window
/stream/sort
/time/timer

_ hit-visits Size = 0
_ checksum Size = 0

. row-count Size = 10000
. root = HitRoot()
root.size = Dimensions(1200, 320)
. viewport = HitViewport()
markup-append(root, viewport)
for row-index in 0 .. < row-count
    markup-append(viewport, HitRow(row-index))
root.open()
root.layout(Rect(0, 0, 1200, 320))

` Probe over the top visible row. Near-start is the reverse-scan worst case; near-end
` also catches whole-list materialization when the target is close to the last sibling.
. point = Point(600, 10)
viewport.scroll-to(Point(0, 100))
measure-hit(root, point, true)

viewport.scroll-to(Point(0, (row-count as F64) * 8.0 - 320.0))
measure-hit(root, point, false)

root.close()
markup-release(root)

-- "bench-result gui/pointer-hit-10k checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ do measure-hit
    - root Box
    - point Point
    - is-near-start Bool

. warm = root.hit-path(point)

hit-visits = 0
. objects0 = C:brixGCAllocatedObjectCount()
. bytes0 = C:brixGCRequestedByteCount()
. counted = root.hit-path(point)
. objects = C:brixGCAllocatedObjectCount() - objects0
. bytes = C:brixGCRequestedByteCount() - bytes0
. visits = hit-visits
. target-row = counted!.target as HitRow?
. target-index = target-row!.row-index

. reps Size = 30
. times [U64]
for rep in 0 .. < reps
    . t0 = monotonic-time-nanoseconds()
    . path = root.hit-path(point)
    . t1 = monotonic-time-nanoseconds()
    times += t1 - t0

. p50 = percentile-us(times, 50)
. p95 = percentile-us(times, 95)
. low = min-us(times)
if is-near-start
    //gui.bench.hit.near-start-visits += visits
    //gui.bench.hit.near-start-objects += objects
    //gui.bench.hit.near-start-bytes += bytes
    //gui.bench.hit.near-start-p50-us += p50
    //gui.bench.hit.near-start-p95-us += p95
    //gui.bench.hit.near-start-min-us += low
else
    //gui.bench.hit.near-end-visits += visits
    //gui.bench.hit.near-end-objects += objects
    //gui.bench.hit.near-end-bytes += bytes
    //gui.bench.hit.near-end-p50-us += p50
    //gui.bench.hit.near-end-p95-us += p95
    //gui.bench.hit.near-end-min-us += low

checksum += target-index + visits

━━━━━━━━━━━━━━━━━━━━
+ percentile-us
    - values [U64]
    - percentile Size

|? !values
    0
??
    sorted[index] / 1000

.. sorted = sort(values) • using :: left, right => if left < right then .lesser else .greater
.. index = ((sorted.length - 1) * percentile) / 100

━━━━━━━━━━━━━━━━━━━━
+ min-us
    - values [U64]

|? !values
    0
??
    sorted[0] / 1000

.. sorted = sort(values) • using :: left, right => if left < right then .lesser else .greater

