; benchmark.meta description: Pans a canvas of 100 mock pages, each a background, 30 rows of icon, text line and every third row a badge, through DisplayScene on Metal at 1600x1000 and scale 2 under a content transform, zoomed in on a few pages, at a quarter scale, and far out with every page in view, with frame CPU, GPU, draw calls, encoded items, and CoreGraphics parity evidence per view.
; benchmark.meta timing: not-recommended
; benchmark.meta profiles: gui-metal
(blank)
(import /core/markup)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/matrix)
(import /graphics/path)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/text)
(import /graphics/vectorgeometry)
(import /gui/box)
(import /gui/layout)
(import /gui/metal)
(import /gui/primitives)
(import /gui/scene)
(import /math)
(import /stream/sort)
(import /time/timer)
(blank)
(prop _ pages-line-count _ (= 32))
(prop _ pages-words _ (= (list "Lorem" "ipsum" "dolor" "sit" "amet," "consectetur" "adipiscing" "elit," "sed" "do" "eiusmod" "tempor" "incididunt" "ut" "labore" "et" "dolore" "magna" "aliqua.")))

(main
  (let near (call run-canvas-pages 1.0 (call Point -120 -80)))
  (let mid (call run-canvas-pages 0.25 (call Point 40 20)))
  (let far (call run-canvas-pages 0.08 (call Point 200 120)))
  (probe-count gui.bench.metal.pages-near-cpu-p50-ns (. near cpu-p50))
  (probe-count gui.bench.metal.pages-near-gpu-p50-ns (. near gpu-p50))
  (probe-count gui.bench.metal.pages-near-draw-calls (. near draw-calls))
  (probe-count gui.bench.metal.pages-near-items (. near items))
  (probe-count gui.bench.metal.pages-near-diff-ppm (. near diff-ppm))
  (probe-count gui.bench.metal.pages-mid-cpu-p50-ns (. mid cpu-p50))
  (probe-count gui.bench.metal.pages-mid-gpu-p50-ns (. mid gpu-p50))
  (probe-count gui.bench.metal.pages-mid-draw-calls (. mid draw-calls))
  (probe-count gui.bench.metal.pages-mid-items (. mid items))
  (probe-count gui.bench.metal.pages-mid-diff-ppm (. mid diff-ppm))
  (probe-count gui.bench.metal.pages-far-cpu-p50-ns (. far cpu-p50))
  (probe-count gui.bench.metal.pages-far-gpu-p50-ns (. far gpu-p50))
  (probe-count gui.bench.metal.pages-far-draw-calls (. far draw-calls))
  (probe-count gui.bench.metal.pages-far-items (. far items))
  (probe-count gui.bench.metal.pages-far-diff-ppm (. far diff-ppm))
  (let checksum (+ (. near items) (. mid items) (. far items)))
  (print (str "bench-result gui/metal-canvas-pages checksum=" checksum))
)

(type _ CanvasPagesResult (is Tuple)
  (prop + cpu-p50 U64)
  (prop + gpu-p50 U64)
  (prop + draw-calls I64)
  (prop + items I64)
  (prop + diff-ppm I64)
)

(fn-do _ run-canvas-pages _
  (param scale F64)
  (param offset Point)
  (let root (call CanvasPagesRoot))
  (let canvas (call CanvasPagesView))
  (= (. canvas view-scale) scale)
  (= (. canvas view-offset) offset)
  (call markup-append root canvas)
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (call (. root layout) (call Rect 0 0 1600 1000))
  (let renderer (call MetalOffscreenRenderer 1600 1000 2 white))
  (let scene (call DisplayScene 2 white renderer))
  (let reference (call RasterCanvas 1600 1000 2 white))
  (let elapsed (list U64))
  (let gpu (list U64))
  (let items 0)
  (let result CanvasPagesResult)
  (do-use renderer
    (do-use reference
      (call (. scene build) root)
      (call (. scene commit))
      (call (. scene frame-metal) renderer)
      (call (. renderer finish))
      (for (in frame (..< 0 37))
        (= (. canvas view-offset) (+ offset (call Point (* 0.25 (as (% frame 2) F64)) 0)))
        (call (. canvas invalidate-content-transform))
        (call (. scene reset-frame-counters))
        (let started (call monotonic-time-nanoseconds))
        (call (. scene update) root)
        (call (. scene commit))
        (call (. scene frame-metal) renderer)
        (let spent (- (call monotonic-time-nanoseconds) started))
        (call (. renderer finish))
        (if (>= frame 6)
          (+= elapsed spent)
          (if (>= (. renderer gpu-nanos) 0)
            (+= gpu (as (. renderer gpu-nanos) U64))
          )
          (= items (as (. scene items-encoded) I64))
        )
      )
      (call (. scene add-damage) (. root bounds))
      (call (. scene frame-metal) renderer)
      (call (. renderer finish))
      (call (. root paint) reference)
      (let diff (call (. renderer diff) reference 10))
      (= result
        (call CanvasPagesResult
          (block
            (arg (call canvas-pages-median elapsed))
            (arg (call canvas-pages-median gpu))
            (arg (. renderer draw-calls))
            (arg items)
            (arg (/ (* (. diff differing-pixels) 1000000) (. diff pixel-count)))
          )
        )
      )
      (throw (call Panic "Canvas pages fell back to CoreGraphics tiles") (if (!= (. scene metal-tile-fallbacks) 0)))
      (throw (call Panic "Canvas pages skipped Metal operations") (if (!= (. renderer skipped-ops) 0)))
    )
  )
  (call (. scene close))
  (call (. root close))
  (call markup-release root)
  (return result)
)

(fn-expr _ canvas-pages-median _
  (param samples (list U64))
  ([] sorted (/ (. sorted length) 2))
  (where
    (lazy sorted (call sort samples (:using (=> (left right) (if-expr (< left right) .lesser .greater)))))
  )
)

(type _ CanvasPagesRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (rule This
    (= layout flow-col)
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
    (let ignored (. flush applied))
  )
)

(type _ CanvasPagesView (is Box)
  (prop + view-scale F64 (= 1.0))
  (prop + view-offset _ (= (call Point 0 0)))
  (prop _ layouts (list TextLayout))
  (prop _ handles (list VectorGeometryHandle))
  (prop _ palettes (list (list RGBA)))
  (blank)
  (rule This
    (= min-width (call (. SizeSpec coord) 1600))
    (= max-width (call (. SizeSpec coord) 1600))
    (= min-height (call (. SizeSpec coord) 1000))
    (= max-height (call (. SizeSpec coord) 1000))
  )
  (fn-expr + content-transform _ :get
    (call (. (call matrix-from-translation view-offset) scale) (call Dimensions view-scale view-scale))
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let table (call vector-geometry-table-for markup-batch-root))
    (if (not layouts)
      (for (in line (..< 0 pages-line-count))
        (let words (list String))
        (for (in word (..< 0 7))
          (+= words ([] pages-words (% (+ (* line 3) (* word 5)) (. pages-words length))))
        )
        (+= layouts (call TextLayout (call (. " " join) words) (call Font "Helvetica" 12) 400))
      )
      (+= handles (call (. table intern-geometry) (as 810001 U64) (=> () (call canvas-pages-geometry 8))))
      (+= handles (call (. table intern-geometry) (as 810002 U64) (=> () (call canvas-pages-geometry 24))))
      (for (in tone (..< 0 16))
        (let hue (/ (as tone F64) 16))
        (+= palettes (list (call RGBA (+ 0.2 (* hue 0.7)) 0.45 (- 0.9 (* hue 0.6)) 1)))
      )
      (+= palettes (list (call RGBA 0.96 0.96 0.97 1)))
    )
    (= (. canvas text-color) (call RGBA 0.1 0.1 0.15 1))
    (for (in page (..< 0 100))
      (let x (* (as (% page 10) F64) 440))
      (let y (* (as (/ page 10) F64) 640))
      (let ignored (call (. table paint-vector) ([] handles 0) canvas ([] palettes 16) (call (. (call matrix-from-translation (call Point x y)) scale) (call Dimensions 4 6))))
      (for (in row (..< 0 30))
        (let top (+ y 20 (* (as row F64) 19)))
        (let icon (call (. table paint-vector) ([] handles 0) canvas ([] palettes (% row 16)) (call (. (call matrix-from-translation (call Point (+ x 16) top)) scale) (call Dimensions 0.14 0.14))))
        (call (. canvas draw-text) ([] layouts (% (+ row page) pages-line-count)) (call Rect (+ x 36) top 320 16))
        (if (== (% row 3) 0)
          (let badge (call (. table paint-vector) ([] handles 1) canvas ([] palettes (% (+ row 5) 16)) (call (. (call matrix-from-translation (call Point (+ x 366) top)) scale) (call Dimensions 0.14 0.14))))
        )
      )
    )
  )
)

(fn-do _ canvas-pages-geometry VectorGeometry
  (param segments Int)
  (let outline (call Path))
  (let center (call Point 50 50))
  (let step (/ (* 2 π) (as segments F64)))
  (for (in index (..< 0 segments))
    (let start (* (as index F64) step))
    (let head (+ center (call Point (* (call cos start) 46) (* (call sin start) 46))))
    (let tail (+ center (call Point (* (call cos (+ start step)) 46) (* (call sin (+ start step)) 46))))
    (let bulge (* 46 (+ 1 (* 0.3 (/ 3 (as (+ segments 3) F64))))))
    (if (== index 0)
      (call (. outline move-to) head)
    )
    (call (. outline cubic-curve-to)
      (block
        (arg (+ center (call Point (* (call cos (+ start (/ step 3))) bulge) (* (call sin (+ start (/ step 3))) bulge))))
        (arg (+ center (call Point (* (call cos (+ start (/ (* step 2) 3))) bulge) (* (call sin (+ start (/ (* step 2) 3))) bulge))))
        (arg tail)
      )
    )
  )
  (call (. outline close))
  (let none (call VectorGeometryPaint (. VectorGeometryPaintRole none) 0))
  (let color (call VectorGeometryPaint (. VectorGeometryPaintRole color) 0))
  (return (call VectorGeometry (call Rect 0 0 100 100) (call Rect -10 -10 120 120) (list (call VectorGeometrySpan outline color none null null null (. FillRule nonzero))) false false))
)
