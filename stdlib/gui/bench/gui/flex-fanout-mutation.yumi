`benchmark.meta description: Flex-column re-arrange cost after a no-op content-size invalidation at 1k and 10k direct-child fanout, for all-flex and weight-zero children.
`benchmark.meta timing: not-recommended
`benchmark.meta profiles: gui,compile-timing

/YuGC/YuGC.h
/core/markup
/graphics/primitives
/gui/box
/gui/layout
/gui/primitives
/gui/shorthands
/stream/sort
/time/timer

_ measure-calls Size = 0
_ content-measures Size = 0
_ layout-visits Size = 0
_ checksum Size = 0

fanout-scenarios(1000, 9)
fanout-scenarios(10000, 9)

-- "bench-result gui/flex-fanout-mutation checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ do reset-counters

measure-calls = 0
content-measures = 0
layout-visits = 0

━━━━━━━━━━━━━━━━━━━━
+ do fanout-scenarios
    - fanout Size
    - iterations Size

. flex-root = FlexFanRoot()
markup-mount-root(flex-root, flex-root)
. flex-cells [FlexFanCell]
for index in 0 .. < fanout
    . cell = FlexFanCell()
    flex-cells += cell
    markup-append(flex-root, cell)
flex-root.markup-batch-queue.checkpoint()
flex-root.layout(Rect(0, 0, 1200, 900))
measure-flex-pokes(flex-root, flex-cells[fanout / 2], fanout, iterations)
flex-root.close()
markup-release(flex-root)

. fixed-root = FlexFanRoot()
markup-mount-root(fixed-root, fixed-root)
. fixed-cells [FlexFixedCell]
for index in 0 .. < fanout
    . cell = FlexFixedCell()
    fixed-cells += cell
    markup-append(fixed-root, cell)
fixed-root.markup-batch-queue.checkpoint()
fixed-root.layout(Rect(0, 0, 1200, 900))
measure-fixed-pokes(fixed-root, fixed-cells[fanout / 2], fanout, iterations)
fixed-root.close()
markup-release(fixed-root)

━━━━━━━━━━━━━━━━━━━━
+ do measure-flex-pokes
    - root FlexFanRoot
    - target FlexFanCell
    - fanout Size
    - iterations Size

. times [U64]
. objects Size = 0
. bytes Size = 0
for iteration in 0 .. < iterations
    target.invalidate-content-size()
    reset-counters()
    . objects0 = C:yumiGCAllocatedObjectCount()
    . bytes0 = C:yumiGCRequestedByteCount()
    . time0 = monotonic-time-nanoseconds()
    root.update-layout()
    . time1 = monotonic-time-nanoseconds()
    times += time1 - time0
    objects = (C:yumiGCAllocatedObjectCount() - objects0) as Size
    bytes = (C:yumiGCRequestedByteCount() - bytes0) as Size

. p50 = percentile-us(times, 50)
. p95 = percentile-us(times, 95)
if fanout == 1000
    //gui.bench.flex-fanout.all-flex.measure-calls-1k += measure-calls
    //gui.bench.flex-fanout.all-flex.content-measures-1k += content-measures
    //gui.bench.flex-fanout.all-flex.layout-visits-1k += layout-visits
    //gui.bench.flex-fanout.all-flex.objects-1k += objects
    //gui.bench.flex-fanout.all-flex.bytes-1k += bytes
    //gui.bench.flex-fanout.all-flex.p50-us-1k += p50
    //gui.bench.flex-fanout.all-flex.p95-us-1k += p95
else
    //gui.bench.flex-fanout.all-flex.measure-calls-10k += measure-calls
    //gui.bench.flex-fanout.all-flex.content-measures-10k += content-measures
    //gui.bench.flex-fanout.all-flex.layout-visits-10k += layout-visits
    //gui.bench.flex-fanout.all-flex.objects-10k += objects
    //gui.bench.flex-fanout.all-flex.bytes-10k += bytes
    //gui.bench.flex-fanout.all-flex.p50-us-10k += p50
    //gui.bench.flex-fanout.all-flex.p95-us-10k += p95
checksum += measure-calls + content-measures + layout-visits + objects + bytes

