; benchmark.meta description: Native font-cache misses while mounting and painting 200 labels across regular and bold system fonts.
; benchmark.meta timing: not-recommended
; benchmark.meta profiles: gui,compile-timing
(blank)
(import /core/markup)
(import /graphics/canvas)
(import /graphics/primitives)
(import /graphics/text)
(import /gui/box)
(import /gui/label)
(import /gui/layout)
(blank)

(main
  (let label-count Size 200)
  (let root (call FontGridRoot))
  (call markup-mount-root root root)
  (let rows (/ label-count 20))
  (for (in row-index (..< 0 rows))
    (let row (call FontGridRow))
    (call markup-append root row)
    (for (in cell-index (..< 0 20))
      (let label Label)
      (if (>= cell-index 10)
        (= label (call BoldFontLabel))
      )
      (= (. label text) (str "row " row-index " cell " cell-index))
      (call markup-append row label)
    )
  )
  (call (. root markup-batch-queue checkpoint))
  (blank)
  (let font-created0 (call text-font-created-count))
  (let canvas (call RasterCanvas 1200 800 2))
  (do-use canvas
    (call (. root layout) (call Rect 0 0 1200 800))
    (call (. root paint) canvas)
  )
  (let fonts-created (- (call text-font-created-count) font-created0))
  (blank)
  (probe-count gui.bench.text.fonts-created fonts-created)
  (probe-count gui.bench.text.font-labels label-count)
  (let checksum (+ fonts-created label-count))
  (blank)
  (call (. root close))
  (call markup-release root)
  (blank)
  (print (str "bench-result gui/label-font-churn checksum=" checksum))
)

(type + FontGridRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (rule This
    (= layout flow-col)
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
    (let ignored (. flush applied))
  )
)

(type + FontGridRow (is Box)
  (rule This
    (= layout flow-row)
  )
)

(type + BoldFontLabel (is Label)
  (rule This
    (= font-weight (. FontWeight bold))
  )
)
