`benchmark.meta description: Coalesces injected resize and backing-scale storms at the native callback boundary and proves latest-size frame commits.
`benchmark.meta timing: not-recommended
`benchmark.meta profiles: gui-probes,gui

/BxAppleGUI/BxAppleGUI.h
/core/intrinsics
/core/task
/graphics/canvas

. resize-notification-count Size = 200
. backing-notification-count Size = 80
. state = ResizeStormState()
state.native = C:brixGuiWindowCreate("gui bench resize-storm (offscreen)", 420, 320)
C:brixGuiWindowSetContentSizeChangedCallback
    - state.native!
    - resize-storm-size-callback as ResizeStormSizeCallback
    - state as Pointer
C:brixGuiWindowSetBackingScaleChangedCallback
    - state.native!
    - resize-storm-backing-scale-callback as ResizeStormActionCallback
    - state as Pointer

for index in 0 .. < resize-notification-count
    C:brixGuiWindowDebugInjectContentSize(state.native!, 420 + index, 320 + index)
for index in 0 .. < backing-notification-count
    C:brixGuiWindowDebugInjectBackingScaleChange(state.native!)

state.done.wait()

. resize-notifications = C:brixGuiWindowDebugResizeNotificationCount(state.native!)
. resize-services = C:brixGuiWindowDebugResizeCallbacksServiced(state.native!)
. resize-coalesced = C:brixGuiWindowDebugResizeCoalescedCount(state.native!)
. resize-pending = C:brixGuiWindowDebugResizePendingCount(state.native!)
. resize-pending-high-water = C:brixGuiWindowDebugResizePendingHighWaterMark(state.native!)
. resize-frames = C:brixGuiWindowDebugResizeFrameCommitCount(state.native!)
. resize-frames-high-water = C:brixGuiWindowDebugResizeFramesPerCallbackHighWaterMark
    - state.native!
. obsolete-renders = C:brixGuiWindowDebugResizeObsoleteSizeRenderCount(state.native!)
. backing-notifications = C:brixGuiWindowDebugBackingScaleNotificationCount(state.native!)
. backing-services = C:brixGuiWindowDebugBackingScaleCallbacksServiced(state.native!)
. backing-coalesced = C:brixGuiWindowDebugBackingScaleCoalescedCount(state.native!)
. backing-pending = C:brixGuiWindowDebugBackingScalePendingCount(state.native!)
. backing-pending-high-water = C:brixGuiWindowDebugBackingScalePendingHighWaterMark
    - state.native!

?! Panic("resize storm did not service the initial latest size and one follow-up")
    if resize-notifications != (resize-notification-count + 1) as U64 || resize-services != 2
?! Panic("resize storm did not report every replaced notification as coalesced")
    if resize-coalesced != (resize-notification-count - 1) as U64
?! Panic("resize pending slot exceeded one task or remained wedged")
    if resize-pending != 0 || resize-pending-high-water != 1
?! Panic("a serviced resize committed more or less than one frame")
    if resize-frames != 2 || resize-frames-high-water != 1 || state.frames-committed != 2
?! Panic("resize storm committed an obsolete native size")
    if obsolete-renders != 0 || state.obsolete-renders != 0
. final-width = C:brixGuiWindowGetContentWidth(state.native!)
. final-height = C:brixGuiWindowGetContentHeight(state.native!)
?! Panic("resize storm did not finish at the newest injected dimensions")
    if final-width != 900 || final-height != 700
. backing-counts-match = backing-notifications == backing-notification-count as U64
backing-counts-match = backing-counts-match && backing-services == 1
. expected-backing-coalesced = (backing-notification-count - 1) as U64
backing-counts-match = backing-counts-match && backing-coalesced == expected-backing-coalesced
?! Panic("backing-scale storm did not coalesce to one callback")
    if !backing-counts-match
?! Panic("backing-scale pending slot exceeded one task or remained wedged")
    if backing-pending != 0 || backing-pending-high-water != 1
?! Panic("other main-queue work did not run between resize renders")
    if !state.backing-between-resizes

//gui.bench.resize.notifications += resize-notifications
//gui.bench.resize.callbacks-serviced += resize-services
//gui.bench.resize.coalesced += resize-coalesced
//gui.bench.resize.pending-high-water += resize-pending-high-water
//gui.bench.resize.frames-committed += resize-frames
//gui.bench.resize.frames-per-callback-high-water += resize-frames-high-water
//gui.bench.resize.obsolete-sizes-rendered += obsolete-renders
//gui.bench.backing-scale.notifications += backing-notifications
//gui.bench.backing-scale.callbacks-serviced += backing-services
//gui.bench.backing-scale.coalesced += backing-coalesced
//gui.bench.backing-scale.pending-high-water += backing-pending-high-water
//gui.adapter.resize.obsolete-sizes-rendered += state.obsolete-renders

C:brixGuiWindowClose(state.native!)
C:brixGuiWindowRelease(state.native!)
state.native = null

. checksum = resize-notifications + resize-services + resize-coalesced + resize-frames
checksum += backing-notifications + backing-services + backing-coalesced
-- "bench-result gui/resize-storm checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ ResizeStormSizeCallback is (*C) Void
    - context Pointer
    - width F64
    - height F64

━━━━━━━━━━━━━━━━━━━━
+ ResizeStormActionCallback is (*C) Void
    - context Pointer

━━━━━━━━━━━━━━━━━━━━
+ ResizeStormState

+ native Pointer?
+ done := Semaphore()
+ resize-services Size = 0
+ frames-committed Size = 0
+ obsolete-renders Size = 0
+ backing-between-resizes = false

━━━━━━━━━━━━━━━━━━━━
+ do resize-storm-size-callback
    - context Pointer
    - width F64
    - height F64

. state = gc-object-from-pointer'ResizeStormState(context)
state.resize-services += 1
//gui.adapter.resize.callbacks-serviced ++

. scale = C:brixGuiWindowGetBackingScaleFactor(state.native!)
. canvas = RasterCanvas(width as I32, height as I32, scale)
do use canvas
    C:brixGuiWindowCommitFrame(state.native!, canvas.native, 0, 0, canvas.width, canvas.height)
state.frames-committed += 1
//gui.adapter.resize.frames-committed ++

. current-size-is-latest = C:brixGuiWindowGetContentWidth(state.native!) == width
. current-height-is-latest = C:brixGuiWindowGetContentHeight(state.native!) == height
current-size-is-latest = current-size-is-latest && current-height-is-latest
if !current-size-is-latest
    state.obsolete-renders += 1

if state.resize-services == 1
    C:brixGuiWindowDebugInjectContentSize(state.native!, 900, 700)
else
    state.done.post()

━━━━━━━━━━━━━━━━━━━━
+ do resize-storm-backing-scale-callback
    - context Pointer

. state = gc-object-from-pointer'ResizeStormState(context)
//gui.adapter.backing-scale.callbacks-serviced ++
state.backing-between-resizes = state.resize-services == 1
