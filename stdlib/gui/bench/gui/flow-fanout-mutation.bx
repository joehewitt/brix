; benchmark.meta description: Incremental flow layout cost after same-size, middle height, and widest-child mutations at 1k and 10k direct-child fanout.
; benchmark.meta timing: not-recommended
; benchmark.meta profiles: gui,compile-timing
(blank)
(import /BxGC/BxGC.h)
(import /core/markup)
(import /graphics/primitives)
(import /gui/box)
(import /gui/layout)
(import /gui/primitives)
(import /stream/sort)
(import /time/timer)
(blank)
(prop _ measure-calls Size (= 0))
(prop _ content-measures Size (= 0))
(prop _ layout-visits Size (= 0))
(prop _ checksum Size (= 0))
(blank)

(main
  (call fanout-scenarios 1000 9)
  (call fanout-scenarios 10000 9)
  (blank)
  (print (str "bench-result gui/flow-fanout-mutation checksum=" checksum))
)

(fn-do + reset-counters _
  (= measure-calls 0)
  (= content-measures 0)
  (= layout-visits 0)
)

(fn-do + fanout-scenarios _
  (param fanout Size)
  (param iterations Size)
  (let root (call FlowFanRoot))
  (call markup-mount-root root root)
  (let cells (list FlowFanCell))
  (for (in index (..< 0 fanout))
    (let cell (call FlowFanCell))
    (+= cells cell)
    (call markup-append root cell)
  )
  (let wide (call FlowWideCell))
  (call markup-append root wide)
  (call (. root markup-batch-queue checkpoint))
  (call (. root layout) (call Rect 0 0 1200 900))
  (blank)
  (let middle ([] cells (/ fanout 2)))
  (call measure-same-size root middle fanout iterations)
  (call measure-height-change root middle fanout iterations)
  (call measure-cross-shrink root wide fanout iterations)
  (blank)
  (call (. root close))
  (call markup-release root)
)

(fn-do + measure-same-size _
  (param root FlowFanRoot)
  (param target FlowFanCell)
  (param fanout Size)
  (param iterations Size)
  (let times (list U64))
  (let objects Size 0)
  (let bytes Size 0)
  (for (in iteration (..< 0 iterations))
    (call (. target invalidate-content-size))
    (call reset-counters)
    (let objects0 (call C:brixGCAllocatedObjectCount))
    (let bytes0 (call C:brixGCRequestedByteCount))
    (let time0 (call monotonic-time-nanoseconds))
    (call (. root update-layout))
    (let time1 (call monotonic-time-nanoseconds))
    (+= times (- time1 time0))
    (= objects (as (- (call C:brixGCAllocatedObjectCount) objects0) Size))
    (= bytes (as (- (call C:brixGCRequestedByteCount) bytes0) Size))
  )
  (blank)
  (let p50 (call percentile-us times 50))
  (let p95 (call percentile-us times 95))
  (if (== fanout 1000)
    (probe-count gui.bench.flow-fanout.same-size.measure-calls-1k measure-calls)
    (probe-count gui.bench.flow-fanout.same-size.content-measures-1k content-measures)
    (probe-count gui.bench.flow-fanout.same-size.layout-visits-1k layout-visits)
    (probe-count gui.bench.flow-fanout.same-size.objects-1k objects)
    (probe-count gui.bench.flow-fanout.same-size.bytes-1k bytes)
    (probe-count gui.bench.flow-fanout.same-size.p50-us-1k p50)
    (probe-count gui.bench.flow-fanout.same-size.p95-us-1k p95)
    (else
      (probe-count gui.bench.flow-fanout.same-size.measure-calls-10k measure-calls)
      (probe-count gui.bench.flow-fanout.same-size.content-measures-10k content-measures)
      (probe-count gui.bench.flow-fanout.same-size.layout-visits-10k layout-visits)
      (probe-count gui.bench.flow-fanout.same-size.objects-10k objects)
      (probe-count gui.bench.flow-fanout.same-size.bytes-10k bytes)
      (probe-count gui.bench.flow-fanout.same-size.p50-us-10k p50)
      (probe-count gui.bench.flow-fanout.same-size.p95-us-10k p95)
    )
  )
  (+= checksum (+ measure-calls content-measures layout-visits objects bytes))
)

(fn-do + measure-height-change _
  (param root FlowFanRoot)
  (param target FlowFanCell)
  (param fanout Size)
  (param iterations Size)
  (let times (list U64))
  (let objects Size 0)
  (let bytes Size 0)
  (for (in iteration (..< 0 iterations))
    (= (. target is-pressed) (not (. target is-pressed)))
    (call (. root markup-batch-queue checkpoint))
    (call reset-counters)
    (let objects0 (call C:brixGCAllocatedObjectCount))
    (let bytes0 (call C:brixGCRequestedByteCount))
    (let time0 (call monotonic-time-nanoseconds))
    (call (. root update-layout))
    (let time1 (call monotonic-time-nanoseconds))
    (+= times (- time1 time0))
    (= objects (as (- (call C:brixGCAllocatedObjectCount) objects0) Size))
    (= bytes (as (- (call C:brixGCRequestedByteCount) bytes0) Size))
  )
  (blank)
  (let p50 (call percentile-us times 50))
  (let p95 (call percentile-us times 95))
  (if (== fanout 1000)
    (probe-count gui.bench.flow-fanout.height-change.measure-calls-1k measure-calls)
    (probe-count gui.bench.flow-fanout.height-change.content-measures-1k content-measures)
    (probe-count gui.bench.flow-fanout.height-change.layout-visits-1k layout-visits)
    (probe-count gui.bench.flow-fanout.height-change.objects-1k objects)
    (probe-count gui.bench.flow-fanout.height-change.bytes-1k bytes)
    (probe-count gui.bench.flow-fanout.height-change.p50-us-1k p50)
    (probe-count gui.bench.flow-fanout.height-change.p95-us-1k p95)
    (else
      (probe-count gui.bench.flow-fanout.height-change.measure-calls-10k measure-calls)
      (probe-count gui.bench.flow-fanout.height-change.content-measures-10k content-measures)
      (probe-count gui.bench.flow-fanout.height-change.layout-visits-10k layout-visits)
      (probe-count gui.bench.flow-fanout.height-change.objects-10k objects)
      (probe-count gui.bench.flow-fanout.height-change.bytes-10k bytes)
      (probe-count gui.bench.flow-fanout.height-change.p50-us-10k p50)
      (probe-count gui.bench.flow-fanout.height-change.p95-us-10k p95)
    )
  )
  (+= checksum (+ measure-calls content-measures layout-visits objects bytes))
)

(fn-do + measure-cross-shrink _
  (param root FlowFanRoot)
  (param target FlowWideCell)
  (param fanout Size)
  (param iterations Size)
  (let times (list U64))
  (let objects Size 0)
  (let bytes Size 0)
  (for (in iteration (..< 0 iterations))
    (= (. target is-pressed) (not (. target is-pressed)))
    (call (. root markup-batch-queue checkpoint))
    (call reset-counters)
    (let objects0 (call C:brixGCAllocatedObjectCount))
    (let bytes0 (call C:brixGCRequestedByteCount))
    (let time0 (call monotonic-time-nanoseconds))
    (call (. root update-layout))
    (let time1 (call monotonic-time-nanoseconds))
    (+= times (- time1 time0))
    (= objects (as (- (call C:brixGCAllocatedObjectCount) objects0) Size))
    (= bytes (as (- (call C:brixGCRequestedByteCount) bytes0) Size))
  )
  (blank)
  (let p50 (call percentile-us times 50))
  (let p95 (call percentile-us times 95))
  (if (== fanout 1000)
    (probe-count gui.bench.flow-fanout.cross-shrink.measure-calls-1k measure-calls)
    (probe-count gui.bench.flow-fanout.cross-shrink.content-measures-1k content-measures)
    (probe-count gui.bench.flow-fanout.cross-shrink.layout-visits-1k layout-visits)
    (probe-count gui.bench.flow-fanout.cross-shrink.objects-1k objects)
    (probe-count gui.bench.flow-fanout.cross-shrink.bytes-1k bytes)
    (probe-count gui.bench.flow-fanout.cross-shrink.p50-us-1k p50)
    (probe-count gui.bench.flow-fanout.cross-shrink.p95-us-1k p95)
    (else
      (probe-count gui.bench.flow-fanout.cross-shrink.measure-calls-10k measure-calls)
      (probe-count gui.bench.flow-fanout.cross-shrink.content-measures-10k content-measures)
      (probe-count gui.bench.flow-fanout.cross-shrink.layout-visits-10k layout-visits)
      (probe-count gui.bench.flow-fanout.cross-shrink.objects-10k objects)
      (probe-count gui.bench.flow-fanout.cross-shrink.bytes-10k bytes)
      (probe-count gui.bench.flow-fanout.cross-shrink.p50-us-10k p50)
      (probe-count gui.bench.flow-fanout.cross-shrink.p95-us-10k p95)
    )
  )
  (+= checksum (+ measure-calls content-measures layout-visits objects bytes))
)

(fn-expr + percentile-us _
  (param values (list U64))
  (param percentile Size)
  (case? (not values)
    0
  )
  (default
    (/ ([] sorted index) 1000)
  )
  (where
    (lazy sorted (call sort values (:using (=> (left right) (if-expr (< left right) .lesser .greater)))))
    (lazy index (/ (* (- (. sorted length) 1) percentile) 100))
  )
)

(type + FlowFanRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (rule This
    (= layout flow-col)
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
  (fn-do + did-layout _
    (+= layout-visits 1)
    (call (. super did-layout))
  )
)

(type + FlowFanCell (is Box)
  (rule This
    (= min-width (call (. SizeSpec coord) 11))
    (= max-width (call (. SizeSpec coord) 11))
    (= min-height (call (. SizeSpec coord) 8))
    (= max-height (call (. SizeSpec coord) 8))
    (blank)
    (when-style #is-pressed
      (= min-height (call (. SizeSpec coord) 12))
      (= max-height (call (. SizeSpec coord) 12))
    )
  )
  (fn-do + measure MeasureResult
    (param query MeasureQuery (= (call measure-fit-query)))
    (+= measure-calls 1)
    (return (call (. super measure) query))
  )
  (fn-do + measured-content-size Dimensions
    (param query MeasureQuery)
    (+= content-measures 1)
    (return (call (. super measured-content-size) query))
  )
  (fn-do + did-layout _
    (+= layout-visits 1)
    (call (. super did-layout))
  )
)

(type + FlowWideCell (is FlowFanCell)
  (rule This
    (= min-width (call (. SizeSpec coord) 50))
    (= max-width (call (. SizeSpec coord) 50))
    (blank)
    (when-style #is-pressed
      (= min-width (call (. SizeSpec coord) 11))
      (= max-width (call (. SizeSpec coord) 11))
      (= min-height (call (. SizeSpec coord) 8))
      (= max-height (call (. SizeSpec coord) 8))
    )
  )
)
