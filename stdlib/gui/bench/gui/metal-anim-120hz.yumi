`benchmark.meta description: Presents 600 1k-cell animation frames with alternating full and partial damage through a default Window CAMetalLayer and verifies pacing, CPU/GPU work, allocation, and idle presentation gates.
`benchmark.meta timing: not-recommended
`benchmark.meta profiles: gui-metal

/BxAppleGUI/BxAppleGUI.h
/BxGC/BxGC.h
/core/intrinsics
/core/markup
/core/task
/graphics/canvas
/graphics/color
/graphics/primitives
/graphics/text
/gui/app
/gui/box
/gui/keys
/gui/layout
/gui/primitives
/gui/window
/stream/sort
/time/duration
/time/timer

. warmup-frames Size = 20
. measured-frames Size = 600
. app = App()
. window = MetalAnimationWindow(warmup-frames, measured-frames)
app += window
window.size = Dimensions(1200, 900)

. header = MetalAnimationRow()
markup-append(window, header)
for index in 0 .. < 8
    markup-append(header, MetalAnimationCaption("Animated panel column $index"))
for row-index in 0 .. < 10
    . row = MetalAnimationRow()
    markup-append(window, row)
    for cell-index in 0 .. < 100
        . cell = MetalAnimationCell()
        window.cells += cell
        markup-append(row, cell)

window.frame-ids.reserve(measured-frames)
window.cpu-work-nanoseconds.reserve(measured-frames)
window.open()
if !window.finished
    C:brixGuiAppScheduleStop(app.native!, 15000000000)
    C:brixGuiAppRun(app.native!)
window.did-timeout = !window.finished
if window.did-timeout
    app.close()
    ?! Panic("Metal animation exceeded its 15-second execution bound")
if window.did-fallback
    app.close()
    ?! Panic("Metal window presentation was unavailable and fell back to CoreGraphics")

window.finish-metal-rendering()
. waits Size = 0
. last-frame = window.frame-ids[window.frame-ids.length - 1]
while window.metal-frame-presented-time-nanoseconds(last-frame) <= 0 && waits < 1000
    1ms.wait()
    waits += 1
. idle-before = window.metal-present-count
100ms.wait()
. idle-presents = window.metal-present-count - idle-before
. gpu-nanoseconds [U64]
. presented-nanoseconds [U64]
gpu-nanoseconds.reserve(measured-frames)
presented-nanoseconds.reserve(measured-frames)
for frame in window.frame-ids
    . gpu = window.metal-frame-gpu-nanos(frame)
    . presented = window.metal-frame-presented-time-nanoseconds(frame)
    if gpu < 0 || presented <= 0
        app.close()
        ?! Panic("Metal presentation frame statistics expired before collection")
    gpu-nanoseconds += gpu as U64
    presented-nanoseconds += presented as U64

. present-intervals [U64]
present-intervals.reserve(presented-nanoseconds.length - 1)
for index in 1 .. < presented-nanoseconds.length
    . previous = presented-nanoseconds[index - 1]
    . current = presented-nanoseconds[index]
    if current <= previous
        app.close()
        ?! Panic("Metal presentation timestamps were not strictly increasing")
    present-intervals += current - previous
if !present-intervals
    app.close()
    ?! Panic("Metal animation did not produce presented-frame intervals")

. present-p99 = metal-animation-percentile(present-intervals, 99)
. cpu-p99 = metal-animation-percentile(window.cpu-work-nanoseconds, 99)
. gpu-p99 = metal-animation-percentile(gpu-nanoseconds, 99)
. wait-p50 = metal-animation-percentile(window.drawable-wait-nanoseconds, 50)
. maximum-fps = window.metal-maximum-frames-per-second
. interval-limit = 16800000u64
if maximum-fps >= 120
    interval-limit = 8400000

if present-p99 > interval-limit
    app.close()
    ?! Panic("present interval p99 exceeded the display-rate gate")
if cpu-p99 > 4000000
    app.close()
    ?! Panic("Metal window CPU work p99 exceeded 4 ms")
if gpu-p99 > 2000000
    app.close()
    ?! Panic("Metal window GPU p99 exceeded 2 ms")
if window.metal-renderer-allocations != 0
    app.close()
    ?! Panic("Metal window allocated renderer resources after warmup")
if window.maximum-frame-objects != 0
    app.close()
    ?! Panic("Metal window allocated managed objects inside a warm frame")
if idle-presents != 0
    app.close()
    ?! Panic("an idle Metal window presented a frame")
if window.frame-ids.length != measured-frames
    app.close()
    ?! Panic("Metal animation did not collect exactly 600 measured frames")

//gui.bench.metal.anim-present-interval-p99-ns += present-p99
//gui.bench.metal.anim-cpu-work-p99-ns += cpu-p99
//gui.bench.metal.anim-gpu-p99-ns += gpu-p99
//gui.bench.metal.anim-drawable-wait-p50-ns += wait-p50
//gui.bench.metal.anim-maximum-fps += maximum-fps
//gui.bench.metal.anim-presented-frames += window.frame-ids.length
//gui.bench.metal.anim-renderer-allocations += window.metal-renderer-allocations
//gui.bench.metal.anim-gc-objects += window.maximum-frame-objects
//gui.bench.metal.anim-idle-presents += idle-presents

. checksum = present-p99 as Size
checksum += cpu-p99 as Size
checksum += gpu-p99 as Size
checksum += maximum-fps as Size
app.close()
-- "bench-result gui/metal-anim-120hz checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ metal-animation-percentile U64
    - values [U64]
    - percentile Size

|? !values
    0
??
    sorted[index]

.. sorted = sort(values) • using :: left, right => if left < right then .lesser else .greater
.. index = ((sorted.length - 1) * percentile) / 100

━━━━━━━━━━━━━━━━━━━━
_ MetalAnimationWindow is Window

+ cells [MetalAnimationCell]
+ frame-ids [I64]
+ cpu-work-nanoseconds [U64]
+ drawable-wait-nanoseconds [U64]
+ did-fallback = false
+ did-timeout = false
+ finished = false
+ maximum-frame-objects I64

_ warmup-frames Size
_ measured-frames Size
_ frame-index Size

• This
    layout = flow-col

────────────────────
+ This
    - warmup-count Size
    - measured-count Size

warmup-frames = warmup-count
measured-frames = measured-count
drawable-wait-nanoseconds.reserve(measured-count)

────────────────────
+ do render Bool

. now = monotonic-time-nanoseconds()
. objects0 = C:brixGCAllocatedObjectCount()
. started = now
. shade = frame-index % 20
for index in 0 .. < cells.length
    . phase = (index + frame-index) % 3
    . level = 0.3 + 0.03 * (shade as F64)
    if phase == 0
        cells[index].cell-color = RGBA(level, 0.2, 0.2, 1)
    else if phase == 1
        cells[index].cell-color = RGBA(0.2, level, 0.2, 1)
    else
        cells[index].cell-color = RGBA(0.2, 0.2, level, 1)
    cells[index].invalidate-paint()
if frame-index % 2 == 0
    invalidate-paint()

. did-render = super.render()
. elapsed = monotonic-time-nanoseconds() - started
. frame-objects = C:brixGCAllocatedObjectCount() - objects0

if did-render && is-metal-rendering
    . frame = last-metal-frame-id
    if frame-index == warmup-frames - 1
        mark-metal-renderer-allocations()
    else if frame-index >= warmup-frames
        . wait = metal-frame-drawable-wait-nanos(frame)
        . work = elapsed
        if wait > 0 && (wait as U64) < work
            work -= wait as U64
        frame-ids += frame
        cpu-work-nanoseconds += work
        drawable-wait-nanoseconds += wait as U64
        if frame-objects > maximum-frame-objects
            maximum-frame-objects = frame-objects as I64
else if !is-metal-rendering
    did-fallback = true

frame-index += 1
if did-fallback
    finished = true
    app?.stop()
else if frame-index >= warmup-frames + measured-frames
    finished = true
    app?.stop()
else
    schedule-render()
= did-render

