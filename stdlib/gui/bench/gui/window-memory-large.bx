; benchmark.meta description: Opens an empty 1200x820 window, lets it settle for 7 seconds, and records the footprint and its GPU, surface, malloc and collector parts while the window is still open.
; benchmark.meta timing: not-recommended
; benchmark.meta profiles: memory
(blank)
(import /BxAppleGUI/BxAppleGUI.h)
(import /BxCore/BxCore.h)
(import /graphics/primitives)
(import /gui/app)
(import /gui/window)
(import /stdlib.h)
(blank)

(main
  (let app (call App))
  (let window (call Window))
  (= (. window size) (call Dimensions 1200 820))
  (+= app window)
  (call (. window open))
  (call C:brixGuiAppScheduleStop (!! (. app native)) 7000000000)
  (call C:brixGuiAppRun (!! (. app native)))
  (call C:brixBenchRecordProcessMemory)
  (let checksum (as (* (. window size width) (. window size height)) Size))
  (print (str "bench-result gui/window-memory-large checksum=" checksum))
  (call C:exit 0)
)
