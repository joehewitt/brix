`benchmark.meta description: Opens a Markdown document of 40 wide 24-row tables four times, restoring the view into a table as a tab switch does, and frames the first display through the retained scene.
`benchmark.meta timing: recommended
`benchmark.meta profiles: gui,compile-timing

/gui/bench/fixtures/markdown-bench-fixture

. source = markdown-bench-table-document(markdown-bench-tables, markdown-bench-table-rows)
. checksum Size = 0
for round in 0 .. < 4
    . bench = MarkdownBench(source, "Table 0", "| T${round * 10 + 5}-12 |")
    checksum += bench.window.editor.top-line() ?? 0
    bench.close()

-- "bench-result gui/markdown-table-reveal checksum=$checksum"
