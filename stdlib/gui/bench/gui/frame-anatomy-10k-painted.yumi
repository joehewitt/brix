`benchmark.meta description: Per-phase frame timing and allocation deltas for 10k painted boxes against a real never-shown native window at 1180x800.
`benchmark.meta timing: recommended
`benchmark.meta profiles: gui,compile-timing

/YuAppleGUI/YuAppleGUI.h
/YuGC/YuGC.h
/core/markup
/graphics/canvas
/graphics/color
/graphics/primitives
/gui/box
/gui/layout
/gui/primitives
/gui/scene
/gui/window
/stream/sort
/time/timer

. cell-count Size = 10000
. painted-cells = true
. root = BenchRoot()
markup-mount-root(root, root)
. background = RGBA(1, 1, 1, 1)

. rows = cell-count / 100
for row-index in 0 .. < rows
    . row = BenchRow()
    markup-append(root, row)
    for cell-index in 0 .. < 100
        if painted-cells
            markup-append(row, PaintedCell())
        else
            markup-append(row, PlainCell())

root.markup-batch-queue.checkpoint()
. native = C:yumiGuiWindowCreate("gui bench frame-anatomy-10k-painted (offscreen)", 1180, 800)
. scale = C:yumiGuiWindowGetBackingScaleFactor(native)
. layout0 = monotonic-time-nanoseconds()
root.layout(Rect(0, 0, 1180, 800))
. layout1 = monotonic-time-nanoseconds()
root.update-layout()
. layout2 = monotonic-time-nanoseconds()
. surface = RasterCanvas(1180, 800, scale, background)
. scene = DisplayScene(scale, background)

for warm in 0 .. < 3
    render-once(scene, root, surface, native, background, scale)

. frames Size = 30
. create-ns [U64]
. erase-ns [U64]
. sync-ns [U64]
. paint-ns [U64]
. commit-ns [U64]
. close-ns [U64]
. total-ns [U64]
. sync-objects Size = 0
. paint-objects Size = 0
. paint-bytes Size = 0

for frame in 0 .. < frames
    . t0 = monotonic-time-nanoseconds()
    . t1 = monotonic-time-nanoseconds()
    . t2 = monotonic-time-nanoseconds()
    . sync-objects0 = C:yumiGCAllocatedObjectCount()
    root.sync-native-geometry()
    sync-objects += (C:yumiGCAllocatedObjectCount() - sync-objects0) as Size
    . t3 = monotonic-time-nanoseconds()
    . paint-objects0 = C:yumiGCAllocatedObjectCount()
    . paint-bytes0 = C:yumiGCRequestedByteCount()
    scene.maintain(root, scale, background)
    . replay-count = scene.frames-replayed
    scene.frame(surface)
    paint-objects += (C:yumiGCAllocatedObjectCount() - paint-objects0) as Size
    paint-bytes += (C:yumiGCRequestedByteCount() - paint-bytes0) as Size
    . t4 = monotonic-time-nanoseconds()
    if scene.frames-replayed != replay-count
        C:yumiGuiWindowCommitFrame
            - native
            - surface.native
            - scene.last-frame-damage.x
            - scene.last-frame-damage.y
            - scene.last-frame-damage.width
            - scene.last-frame-damage.height
    . t5 = monotonic-time-nanoseconds()
    . t6 = monotonic-time-nanoseconds()
    create-ns += t1 - t0
    erase-ns += t2 - t1
    sync-ns += t3 - t2
    paint-ns += t4 - t3
    commit-ns += t5 - t4
    close-ns += t6 - t5
    total-ns += t6 - t0

. create-p50 = percentile-us(create-ns, 50)
. create-p95 = percentile-us(create-ns, 95)
. create-p99 = percentile-us(create-ns, 99)
. create-min = min-us(create-ns)
. erase-p50 = percentile-us(erase-ns, 50)
. erase-p95 = percentile-us(erase-ns, 95)
. erase-p99 = percentile-us(erase-ns, 99)
. erase-min = min-us(erase-ns)
. sync-p50 = percentile-us(sync-ns, 50)
. sync-p95 = percentile-us(sync-ns, 95)
. sync-p99 = percentile-us(sync-ns, 99)
. sync-min = min-us(sync-ns)
. paint-p50 = percentile-us(paint-ns, 50)
. paint-p95 = percentile-us(paint-ns, 95)
. paint-p99 = percentile-us(paint-ns, 99)
. paint-min = min-us(paint-ns)
. commit-p50 = percentile-us(commit-ns, 50)
. commit-p95 = percentile-us(commit-ns, 95)
. commit-p99 = percentile-us(commit-ns, 99)
. commit-min = min-us(commit-ns)
. close-p50 = percentile-us(close-ns, 50)
. close-p95 = percentile-us(close-ns, 95)
. close-p99 = percentile-us(close-ns, 99)
. close-min = min-us(close-ns)
. total-p50 = percentile-us(total-ns, 50)
. total-p95 = percentile-us(total-ns, 95)
. total-p99 = percentile-us(total-ns, 99)
. total-min = min-us(total-ns)

//gui.bench.frame.create-p50-us += create-p50
//gui.bench.frame.create-p95-us += create-p95
//gui.bench.frame.create-p99-us += create-p99
//gui.bench.frame.create-min-us += create-min
//gui.bench.frame.erase-p50-us += erase-p50
//gui.bench.frame.erase-p95-us += erase-p95
//gui.bench.frame.erase-p99-us += erase-p99
//gui.bench.frame.erase-min-us += erase-min
//gui.bench.frame.sync-p50-us += sync-p50
//gui.bench.frame.sync-p95-us += sync-p95
//gui.bench.frame.sync-p99-us += sync-p99
//gui.bench.frame.sync-min-us += sync-min
//gui.bench.frame.paint-p50-us += paint-p50
//gui.bench.frame.paint-p95-us += paint-p95
//gui.bench.frame.paint-p99-us += paint-p99
//gui.bench.frame.paint-min-us += paint-min
//gui.bench.frame.commit-p50-us += commit-p50
//gui.bench.frame.commit-p95-us += commit-p95
//gui.bench.frame.commit-p99-us += commit-p99
//gui.bench.frame.commit-min-us += commit-min
//gui.bench.frame.close-p50-us += close-p50
//gui.bench.frame.close-p95-us += close-p95
//gui.bench.frame.close-p99-us += close-p99
//gui.bench.frame.close-min-us += close-min
//gui.bench.frame.total-p50-us += total-p50
//gui.bench.frame.total-p95-us += total-p95
//gui.bench.frame.total-p99-us += total-p99
//gui.bench.frame.total-min-us += total-min

. layout-full-us = (layout1 - layout0) / 1000
. layout-clean-us = (layout2 - layout1) / 1000
. scale-x100 = (scale * 100.0) as Size
//gui.bench.frame.layout-full-us += layout-full-us
//gui.bench.frame.layout-clean-us += layout-clean-us
//gui.bench.frame.sync-objects += sync-objects / frames
//gui.bench.frame.paint-objects += paint-objects / frames
//gui.bench.frame.paint-bytes += paint-bytes / frames
//gui.bench.frame.scale-x100 += scale-x100
//gui.bench.frame.window-width += 1180
//gui.bench.frame.window-height += 800
//gui.bench.frame.frames += frames

scene.close()
surface.close()
C:yumiGuiWindowClose(native)
C:yumiGuiWindowRelease(native)
root.close()
markup-release(root)

. checksum = cell-count + frames + (root.inner-width as Size) + (root.inner-height as Size)
-- "bench-result gui/frame-anatomy-10k-painted checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ percentile-us
    - values [U64]
    - percentile Size

|? !values
    0
??
    sorted[index] / 1000

.. sorted = sort(values) • using :: left, right => if left < right then .lesser else .greater
.. index = ((sorted.length - 1) * percentile) / 100

━━━━━━━━━━━━━━━━━━━━
+ min-us
    - values [U64]

|? !values
    0
??
    sorted[0] / 1000

.. sorted = sort(values) • using :: left, right => if left < right then .lesser else .greater

━━━━━━━━━━━━━━━━━━━━
+ do render-once
    - scene DisplayScene
    - root Box
    - surface RasterCanvas
    - native Pointer
    - background RGBA
    - scale F64

root.sync-native-geometry()
scene.maintain(root, scale, background)
. replay-count = scene.frames-replayed
scene.frame(surface)
if scene.frames-replayed != replay-count
    C:yumiGuiWindowCommitFrame
        - native
        - surface.native
        - scene.last-frame-damage.x
        - scene.last-frame-damage.y
        - scene.last-frame-damage.width
        - scene.last-frame-damage.height

━━━━━━━━━━━━━━━━━━━━
