`benchmark.meta description: Reverse-ordered equal-weight cap construction versus a one-pass clamp control at 4k flex children.
`benchmark.meta timing: not-recommended
`benchmark.meta profiles: gui,compile-timing

/YuGC/YuGC.h
/core/markup
/graphics/primitives
/gui/box
/gui/layout
/gui/primitives
/gui/shorthands
/math
/stream/sort
/time/timer

_ layout-visits Size = 0
_ checksum Size = 0

clamp-scenarios(4000, 9)

-- "bench-result gui/flex-adversarial-clamp checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ do clamp-scenarios
    - fanout Size
    - iterations Size

` Place each cap between successive shares, then reverse child order so each newly
` clamped child occurs before the prior pass's sweep position.
. available = 900.0
. caps [Float]
. remaining = available
. previous-share Float
for index in 0 .. < fanout
    . share = remaining / ((fanout - index) as Float)
    . cap =
        |? index == 0
            share * 1.1
        ??
            (share + previous-share) / 2
    caps += cap
    remaining -= cap
    previous-share = share

measure-clamp(caps, fanout, iterations, true)

` Control: every cap is violated by the initial proposal, so the loop settles in one pass.
. first-share = available / (fanout as Float)
. one-pass-caps [Float]
for index in 0 .. < fanout
    one-pass-caps += first-share * 1.5
measure-clamp(one-pass-caps, fanout, iterations, false)

━━━━━━━━━━━━━━━━━━━━
+ do measure-clamp
    - caps [Float]
    - fanout Size
    - iterations Size
    - is-adversarial Bool

. root = ClampRoot()
markup-mount-root(root, root)
. cells [ClampCell]
for index in 0 .. < fanout
    . cell = ClampCell()
    cell.cap = caps[fanout - 1 - index]
    cells += cell
    markup-append(root, cell)
root.markup-batch-queue.checkpoint()
root.layout(Rect(0, 0, 1200, 900))

. clamped-count Size = 0
for index in 0 .. < fanout
    if abs(cells[index].bounds.height - caps[fanout - 1 - index]) < 0.01
        clamped-count += 1
?! Panic("flex clamp construction did not clamp every child")
    if clamped-count != fanout

. times [U64]
. objects Size = 0
. bytes Size = 0
for iteration in 0 .. < iterations
    root.invalidate-layout()
    layout-visits = 0
    . objects0 = C:yumiGCAllocatedObjectCount()
    . bytes0 = C:yumiGCRequestedByteCount()
    . time0 = monotonic-time-nanoseconds()
    root.update-layout()
    . time1 = monotonic-time-nanoseconds()
    times += time1 - time0
    objects = (C:yumiGCAllocatedObjectCount() - objects0) as Size
    bytes = (C:yumiGCRequestedByteCount() - bytes0) as Size

. p50 = percentile-us(times, 50)
. p95 = percentile-us(times, 95)
if is-adversarial
    //gui.bench.flex-clamp.adversarial.clamped += clamped-count
    //gui.bench.flex-clamp.adversarial.layout-visits += layout-visits
    //gui.bench.flex-clamp.adversarial.objects += objects
    //gui.bench.flex-clamp.adversarial.bytes += bytes
    //gui.bench.flex-clamp.adversarial.p50-us += p50
    //gui.bench.flex-clamp.adversarial.p95-us += p95
else
    //gui.bench.flex-clamp.one-pass.clamped += clamped-count
    //gui.bench.flex-clamp.one-pass.layout-visits += layout-visits
    //gui.bench.flex-clamp.one-pass.objects += objects
    //gui.bench.flex-clamp.one-pass.bytes += bytes
    //gui.bench.flex-clamp.one-pass.p50-us += p50
    //gui.bench.flex-clamp.one-pass.p95-us += p95
checksum += clamped-count + layout-visits + objects + bytes

root.close()
markup-release(root)

━━━━━━━━━━━━━━━━━━━━
+ percentile-us
    - values [U64]
    - percentile Size

|? !values
    0
??
    sorted[index] / 1000

.. sorted = sort(values) • using :: left, right => if left < right then .lesser else .greater
.. index = ((sorted.length - 1) * percentile) / 100

━━━━━━━━━━━━━━━━━━━━
