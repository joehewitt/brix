`benchmark.meta description: Retained invalidation-descent and native-sync visits after one leaf paint invalidation in 1k and 10k box trees.
`benchmark.meta timing: not-recommended
`benchmark.meta profiles: gui,compile-timing

/YuGC/YuGC.h
/core/markup
/graphics/canvas
/graphics/color
/graphics/point
/graphics/primitives
/gui/box
/gui/layout
/gui/primitives
/gui/scene

_ paint-visits Size = 0
_ sync-visits Size = 0
_ measure-calls Size = 0
_ layout-visits Size = 0
_ cells-list [CountingCell]
_ checksum Size = 0

paint-scenario(1000)
paint-scenario(10000)

-- "bench-result gui/leaf-paint-mutation checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ do paint-scenario
    - cell-count Size

cells-list = List'CountingCell()
. root = build-tree(cell-count)
. canvas = RasterCanvas(1200, 900, 2)
. scene = DisplayScene(2, transparent)
do use canvas
    ` Settle the packed scene and its persistent surface before the measured mutation.
    scene.build(root)
    scene.commit()
    scene.frame(canvas)

    . target = cells-list[cells-list.length / 2]
    target.invalidate-paint()
    reset-counters()
    . objects0 = C:yumiGCAllocatedObjectCount()
    . bytes0 = C:yumiGCRequestedByteCount()
    root.sync-native-geometry()
    scene.update(root)
    ` Legacy paint-visits output now carries the retained invalidation descent count.
    paint-visits = scene.boxes-visited
    scene.commit()
    scene.frame(canvas)
    . frame-objects = C:yumiGCAllocatedObjectCount() - objects0
    . frame-bytes = C:yumiGCRequestedByteCount() - bytes0

    if cell-count == 1000
        //gui.bench.leaf.paint-visits-1k += paint-visits
        //gui.bench.leaf.sync-visits-1k += sync-visits
        //gui.bench.leaf.objects-1k += frame-objects
        //gui.bench.leaf.bytes-1k += frame-bytes
    else
        //gui.bench.leaf.paint-visits-10k += paint-visits
        //gui.bench.leaf.sync-visits-10k += sync-visits
        //gui.bench.leaf.objects-10k += frame-objects
        //gui.bench.leaf.bytes-10k += frame-bytes

    checksum += paint-visits + sync-visits

scene.close()
root.close()
markup-release(root)

━━━━━━━━━━━━━━━━━━━━
+ do reset-counters

paint-visits = 0
sync-visits = 0
measure-calls = 0
layout-visits = 0

━━━━━━━━━━━━━━━━━━━━
+ do build-tree CountingRoot
    - cell-count Size

. root = CountingRoot()
markup-mount-root(root, root)
. rows = cell-count / 100
for row-index in 0 .. < rows
    . row = CountingRow()
    markup-append(root, row)
    for cell-index in 0 .. < 100
        . cell = CountingCell()
        cells-list += cell
        markup-append(row, cell)
root.markup-batch-queue.checkpoint()
root.layout(Rect(0, 0, 1200, 900))
= root

━━━━━━━━━━━━━━━━━━━━
+ CountingRoot is Box
    is MarkupRootElement

+ markup-batch-queue := MarkupBatchQueue(this)

• This
    layout = flow-col

────────────────────
