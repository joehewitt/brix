    - flush MarkupBatchFlush

────────────────────
+ do paint-traversal-visit

paint-visits += 1

────────────────────
+ do sync-native-geometry-traversal-visit

sync-visits += 1

────────────────────
+ do did-layout

layout-visits += 1
super.did-layout()

━━━━━━━━━━━━━━━━━━━━
