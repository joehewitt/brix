; benchmark.meta description: Presents 600 1k-cell animation frames with alternating full and partial damage through a default Window CAMetalLayer and verifies pacing, CPU/GPU work, allocation, and idle presentation gates.
; benchmark.meta timing: not-recommended
; benchmark.meta profiles: gui-metal
(blank)
(import /BxAppleGUI/BxAppleGUI.h)
(import /BxGC/BxGC.h)
(import /core/intrinsics)
(import /core/markup)
(import /core/task)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/primitives)
(import /graphics/text)
(import /gui/app)
(import /gui/box)
(import /gui/keys)
(import /gui/layout)
(import /gui/primitives)
(import /gui/window)
(import /stream/sort)
(import /time/duration)
(import /time/timer)
(blank)

(main
  (let warmup-frames Size 20)
  (let measured-frames Size 600)
  (let app (call App))
  (let window (call MetalAnimationWindow warmup-frames measured-frames))
  (+= app window)
  (= (. window size) (call Dimensions 1200 900))
  (blank)
  (let header (call MetalAnimationRow))
  (call markup-append window header)
  (for (in index (..< 0 8))
    (call markup-append header (call MetalAnimationCaption (str "Animated panel column " index)))
  )
  (for (in row-index (..< 0 10))
    (let row (call MetalAnimationRow))
    (call markup-append window row)
    (for (in cell-index (..< 0 100))
      (let cell (call MetalAnimationCell))
      (+= (. window cells) cell)
      (call markup-append row cell)
    )
  )
  (blank)
  (call (. window frame-ids reserve) measured-frames)
  (call (. window cpu-work-nanoseconds reserve) measured-frames)
  (call (. window open))
  (if (not (. window finished))
    (call C:brixGuiAppScheduleStop (!! (. app native)) 15000000000)
    (call C:brixGuiAppRun (!! (. app native)))
  )
  (= (. window did-timeout) (not (. window finished)))
  (if (. window did-timeout)
    (call (. app close))
    (throw (call Panic "Metal animation exceeded its 15-second execution bound"))
  )
  (if (. window did-fallback)
    (call (. app close))
    (throw (call Panic "Metal window presentation was unavailable and fell back to CoreGraphics"))
  )
  (blank)
  (call (. window finish-metal-rendering))
  (let waits Size 0)
  (let last-frame ([] (. window frame-ids) (- (. window frame-ids length) 1)))
  (while (and (<= (call (. window metal-frame-presented-time-nanoseconds) last-frame) 0) (< waits 1000))
    (call (. 1ms wait))
    (+= waits 1)
  )
  (let idle-before (. window metal-present-count))
  (call (. 100ms wait))
  (let idle-presents (- (. window metal-present-count) idle-before))
  (let gpu-nanoseconds (list U64))
  (let presented-nanoseconds (list U64))
  (call (. gpu-nanoseconds reserve) measured-frames)
  (call (. presented-nanoseconds reserve) measured-frames)
  (for (in frame (. window frame-ids))
    (let gpu (call (. window metal-frame-gpu-nanos) frame))
    (let presented (call (. window metal-frame-presented-time-nanoseconds) frame))
    (if (or (< gpu 0) (<= presented 0))
      (call (. app close))
      (throw (call Panic "Metal presentation frame statistics expired before collection"))
    )
    (+= gpu-nanoseconds (as gpu U64))
    (+= presented-nanoseconds (as presented U64))
  )
  (blank)
  (let present-intervals (list U64))
  (call (. present-intervals reserve) (- (. presented-nanoseconds length) 1))
  (for (in index (..< 1 (. presented-nanoseconds length)))
    (let previous ([] presented-nanoseconds (- index 1)))
    (let current ([] presented-nanoseconds index))
    (if (<= current previous)
      (call (. app close))
      (throw (call Panic "Metal presentation timestamps were not strictly increasing"))
    )
    (+= present-intervals (- current previous))
  )
  (if (not present-intervals)
    (call (. app close))
    (throw (call Panic "Metal animation did not produce presented-frame intervals"))
  )
  (blank)
  (let present-p99 (call metal-animation-percentile present-intervals 99))
  (let cpu-p99 (call metal-animation-percentile (. window cpu-work-nanoseconds) 99))
  (let gpu-p99 (call metal-animation-percentile gpu-nanoseconds 99))
  (let wait-p50 (call metal-animation-percentile (. window drawable-wait-nanoseconds) 50))
  (let maximum-fps (. window metal-maximum-frames-per-second))
  (let interval-limit 16800000u64)
  (if (>= maximum-fps 120)
    (= interval-limit 8400000)
  )
  (blank)
  (if (> present-p99 interval-limit)
    (call (. app close))
    (throw (call Panic "present interval p99 exceeded the display-rate gate"))
  )
  (if (> cpu-p99 4000000)
    (call (. app close))
    (throw (call Panic "Metal window CPU work p99 exceeded 4 ms"))
  )
  (if (> gpu-p99 2000000)
    (call (. app close))
    (throw (call Panic "Metal window GPU p99 exceeded 2 ms"))
  )
  (if (!= (. window metal-renderer-allocations) 0)
    (call (. app close))
    (throw (call Panic "Metal window allocated renderer resources after warmup"))
  )
  (if (!= (. window maximum-frame-objects) 0)
    (call (. app close))
    (throw (call Panic "Metal window allocated managed objects inside a warm frame"))
  )
  (if (!= idle-presents 0)
    (call (. app close))
    (throw (call Panic "an idle Metal window presented a frame"))
  )
  (if (!= (. window frame-ids length) measured-frames)
    (call (. app close))
    (throw (call Panic "Metal animation did not collect exactly 600 measured frames"))
  )
  (blank)
  (probe-count gui.bench.metal.anim-present-interval-p99-ns present-p99)
  (probe-count gui.bench.metal.anim-cpu-work-p99-ns cpu-p99)
  (probe-count gui.bench.metal.anim-gpu-p99-ns gpu-p99)
  (probe-count gui.bench.metal.anim-drawable-wait-p50-ns wait-p50)
  (probe-count gui.bench.metal.anim-maximum-fps maximum-fps)
  (probe-count gui.bench.metal.anim-presented-frames (. window frame-ids length))
  (probe-count gui.bench.metal.anim-renderer-allocations (. window metal-renderer-allocations))
  (probe-count gui.bench.metal.anim-gc-objects (. window maximum-frame-objects))
  (probe-count gui.bench.metal.anim-idle-presents idle-presents)
  (blank)
  (let checksum (as present-p99 Size))
  (+= checksum (as cpu-p99 Size))
  (+= checksum (as gpu-p99 Size))
  (+= checksum (as maximum-fps Size))
  (call (. app close))
  (print (str "bench-result gui/metal-anim-120hz checksum=" checksum))
)

(fn-expr _ metal-animation-percentile U64
  (param values (list U64))
  (param percentile Size)
  (case? (not values)
    0
  )
  (default
    ([] sorted index)
  )
  (where
    (lazy sorted (call sort values (:using (=> (left right) (if-expr (< left right) .lesser .greater)))))
    (lazy index (/ (* (- (. sorted length) 1) percentile) 100))
  )
)

(type _ MetalAnimationWindow (is Window)
  (prop + cells (list MetalAnimationCell))
  (prop + frame-ids (list I64))
  (prop + cpu-work-nanoseconds (list U64))
  (prop + drawable-wait-nanoseconds (list U64))
  (prop + did-fallback _ (= false))
  (prop + did-timeout _ (= false))
  (prop + finished _ (= false))
  (prop + maximum-frame-objects I64)
  (blank)
  (prop _ warmup-frames Size)
  (prop _ measured-frames Size)
  (prop _ frame-index Size)
  (blank)
  (rule This
    (= layout flow-col)
  )
  (fn-do + This _
    (param warmup-count Size)
    (param measured-count Size)
    (= warmup-frames warmup-count)
    (= measured-frames measured-count)
    (call (. drawable-wait-nanoseconds reserve) measured-count)
  )
  (fn-do + render Bool
    (let now (call monotonic-time-nanoseconds))
    (let objects0 (call C:brixGCAllocatedObjectCount))
    (let started now)
    (let shade (% frame-index 20))
    (for (in index (..< 0 (. cells length)))
      (let phase (% (+ index frame-index) 3))
      (let level (+ 0.3 (* 0.03 (as shade F64))))
      (if (== phase 0)
        (= (. ([] cells index) cell-color) (call RGBA level 0.2 0.2 1))
        (else-if (== phase 1)
          (= (. ([] cells index) cell-color) (call RGBA 0.2 level 0.2 1))
        )
        (else
          (= (. ([] cells index) cell-color) (call RGBA 0.2 0.2 level 1))
        )
      )
      (call (. ([] cells index) invalidate-paint))
    )
    (if (== (% frame-index 2) 0)
      (call invalidate-paint)
    )
    (blank)
    (let did-render (call (. super render)))
    (let elapsed (- (call monotonic-time-nanoseconds) started))
    (let frame-objects (- (call C:brixGCAllocatedObjectCount) objects0))
    (blank)
    (if (and did-render is-metal-rendering)
      (let frame last-metal-frame-id)
      (if (== frame-index (- warmup-frames 1))
        (call mark-metal-renderer-allocations)
        (else-if (>= frame-index warmup-frames)
          (let wait (call metal-frame-drawable-wait-nanos frame))
          (let work elapsed)
          (if (and (> wait 0) (< (as wait U64) work))
            (-= work (as wait U64))
          )
          (+= frame-ids frame)
          (+= cpu-work-nanoseconds work)
          (+= drawable-wait-nanoseconds (as wait U64))
          (if (> frame-objects maximum-frame-objects)
            (= maximum-frame-objects (as frame-objects I64))
          )
        )
      )
      (else-if (not is-metal-rendering)
        (= did-fallback true)
      )
    )
    (blank)
    (+= frame-index 1)
    (if did-fallback
      (= finished true)
      (call (?. app stop))
      (else-if (>= frame-index (+ warmup-frames measured-frames))
        (= finished true)
        (call (?. app stop))
      )
      (else
        (call schedule-render)
      )
    )
    (return did-render)
  )
)

(type _ MetalAnimationRow (is Box)
  (rule This
    (= layout flow-row)
    (= min-width (call (. SizeSpec coord) 1200))
    (= max-width (call (. SizeSpec coord) 1200))
    (= min-height (call (. SizeSpec coord) 80))
    (= max-height (call (. SizeSpec coord) 80))
  )
)

(type _ MetalAnimationCell (is Box)
  (prop + cell-color _ (= (call RGBA 0.2 0.4 0.9 1)))
  (blank)
  (rule This
    (= min-width (call (. SizeSpec coord) 12))
    (= max-width (call (. SizeSpec coord) 12))
    (= min-height (call (. SizeSpec coord) 80))
    (= max-height (call (. SizeSpec coord) 80))
  )
  (fn-do + paint-background _
    (param canvas Canvas)
    (= (. canvas fill-color) cell-color)
    (= (. canvas stroke-color) null)
    (call (. canvas rect) bounds)
  )
)

(type _ MetalAnimationCaption (is Box)
  (prop _ text-layout TextLayout)
  (blank)
  (rule This
    (= min-width (call (. SizeSpec coord) 150))
    (= max-width (call (. SizeSpec coord) 150))
    (= min-height (call (. SizeSpec coord) 80))
    (= max-height (call (. SizeSpec coord) 80))
  )
  (fn-do + This _
    (param text String)
    (lazy text-layout (call TextLayout text (call Font "Helvetica" 12) 145))
  )
  (fn-do + close _
    (call (. text-layout close))
    (call (. super close))
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (= (. canvas text-color) (call RGBA "#1f2937"))
    (call (. canvas draw-text) text-layout bounds)
  )
)
