; benchmark.meta description: TextLayouts constructed per tight word-wrapped measure and per measure-plus-paint, via the graphics text-layout-created counter.
; benchmark.meta timing: not-recommended
; benchmark.meta profiles: gui,compile-timing
(blank)
(import /core/markup)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/primitives)
(import /graphics/text)
(import /gui/box)
(import /gui/label)
(import /gui/layout)
(import /gui/primitives)
(blank)

(main
  (let root (call GridRoot))
  (call markup-mount-root root root)
  (let label (call TightLabel))
  (let long-text "The quick brown fox jumps over the lazy dog and keeps on running ")
  (= (. label text) (+ long-text "through the measured meadow"))
  (call markup-append root label)
  (call (. root markup-batch-queue checkpoint))
  (blank)
  (let checksum Size 0)
  (let count0 (call text-layout-created-count))
  (let query (call MeasureQuery (call fit-axis-query 220) (call fit-axis-query null)))
  (call (. label measure) query)
  (let count1 (call text-layout-created-count))
  (let constrained-layouts (- count1 count0))
  (blank)
  (call (. label measure))
  (let count2 (call text-layout-created-count))
  (let unconstrained-layouts (- count2 count1))
  (blank)
  (call (. label arrange-bounds) (call Rect 0 0 220 200))
  (let canvas (call RasterCanvas 400 300 2))
  (do-use canvas
    (call (. label paint) canvas)
    (let count3 (call text-layout-created-count))
    (let first-paint-layouts (- count3 count2))
    (call (. label paint) canvas)
    (let count4 (call text-layout-created-count))
    (let repaint-layouts (- count4 count3))
    (let measure-paint-layouts (+ unconstrained-layouts first-paint-layouts))
    (blank)
    (probe-count gui.bench.text.tight-constrained-layouts constrained-layouts)
    (probe-count gui.bench.text.tight-unconstrained-layouts unconstrained-layouts)
    (probe-count gui.bench.text.tight-first-paint-layouts first-paint-layouts)
    (probe-count gui.bench.text.tight-repaint-layouts repaint-layouts)
    (probe-count gui.bench.text.tight-measure-paint-layouts measure-paint-layouts)
    (+= checksum (+ constrained-layouts unconstrained-layouts first-paint-layouts repaint-layouts))
    (blank)
    (let sequence (call TightLabel))
    (= (. sequence text) (+ long-text "through the measured meadow"))
    (call markup-append root sequence)
    (call (. root markup-batch-queue checkpoint))
    (let sequence-count0 (call text-layout-created-count))
    (let sequence-size (. (call (. sequence measure) query) border-size))
    (call (. sequence arrange-bounds) (call Rect 0 0 (. sequence-size width) (. sequence-size height)))
    (call (. sequence paint) canvas)
    (let sequence-count1 (call text-layout-created-count))
    (let sequence-layouts (- sequence-count1 sequence-count0))
    (call (. sequence measure) query)
    (call (. sequence paint) canvas)
    (let sequence-count2 (call text-layout-created-count))
    (let sequence-warm-layouts (- sequence-count2 sequence-count1))
    (probe-count gui.bench.text.tight-sequence-layouts sequence-layouts)
    (probe-count gui.bench.text.tight-sequence-warm-layouts sequence-warm-layouts)
    (+= checksum (+ sequence-layouts sequence-warm-layouts))
  )
  (blank)
  (call (. root close))
  (call markup-release root)
  (blank)
  (print (str "bench-result gui/tight-text-measure checksum=" checksum))
)

(type + TightLabel (is Label)
  (rule This
    (= text-wrap (. TextWrap word))
    (= text-wrap-sizing (. TextWrapSizing tight))
  )
)

(type + GridRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (rule This
    (= layout flow-col)
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(type + GridRow (is Box)
  (rule This
    (= layout flow-row)
  )
)
