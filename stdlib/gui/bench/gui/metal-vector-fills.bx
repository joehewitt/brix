; benchmark.meta description: Five thousand fill-only vector items with mixed alpha, fill rules, palettes, clips, and rotations through DisplayScene on Metal at 1600x1000 and scale 2, as simple and complex paths, with frame CPU, GPU, fill work, tile fallback, overflow, and CoreGraphics parity evidence.
; benchmark.meta timing: not-recommended
; benchmark.meta profiles: gui-metal
(blank)
(import /core/markup)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/matrix)
(import /graphics/path)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/vectorgeometry)
(import /gui/box)
(import /gui/layout)
(import /gui/metal)
(import /gui/primitives)
(import /gui/scene)
(import /math)
(import /stream/sort)
(import /time/timer)
(blank)

(main
  (let simple (call run-vector-fills false))
  (let complex (call run-vector-fills true))
  (probe-count gui.bench.metal.fill-cpu-p50-ns (. simple cpu-p50))
  (probe-count gui.bench.metal.fill-gpu-p50-ns (. simple gpu-p50))
  (probe-count gui.bench.metal.fill-segments (. simple segments))
  (probe-count gui.bench.metal.fill-tiles (. simple tiles))
  (probe-count gui.bench.metal.fill-pieces (. simple pieces))
  (probe-count gui.bench.metal.fill-opaque-tiles (. simple opaque-tiles))
  (probe-count gui.bench.metal.fill-draw-calls (. simple draw-calls))
  (probe-count gui.bench.metal.fill-overflows (. simple overflows))
  (probe-count gui.bench.metal.fill-diff-ppm (. simple diff-ppm))
  (probe-count gui.bench.metal.fill-max-delta (. simple max-delta))
  (probe-count gui.bench.metal.fill-gross-ppm (. simple gross-ppm))
  (probe-count gui.bench.metal.fill-complex-cpu-p50-ns (. complex cpu-p50))
  (probe-count gui.bench.metal.fill-complex-gpu-p50-ns (. complex gpu-p50))
  (probe-count gui.bench.metal.fill-complex-segments (. complex segments))
  (probe-count gui.bench.metal.fill-complex-overflows (. complex overflows))
  (probe-count gui.bench.metal.fill-complex-diff-ppm (. complex diff-ppm))
  (probe-count gui.bench.metal.fill-complex-max-delta (. complex max-delta))
  (probe-count gui.bench.metal.fill-complex-gross-ppm (. complex gross-ppm))
  (let checksum (+ (. simple segments) (. complex segments) (. simple tiles) (. complex tiles)))
  (print (str "bench-result gui/metal-vector-fills checksum=" checksum))
)

(type _ VectorFillsResult (is Tuple)
  (prop + cpu-p50 U64)
  (prop + gpu-p50 U64)
  (prop + segments I64)
  (prop + tiles I64)
  (prop + pieces I64)
  (prop + opaque-tiles I64)
  (prop + draw-calls I64)
  (prop + overflows I64)
  (prop + diff-ppm I64)
  (prop + max-delta I64)
  (prop + gross-ppm I64)
)

(fn-do _ run-vector-fills _
  (param complex Bool)
  (let root (call VectorFillsRoot))
  (for (in band (..< 0 10))
    (call markup-append root (call VectorFillsBand (* band 500) complex))
  )
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (call (. root layout) (call Rect 0 0 1600 1000))
  (let renderer (call MetalOffscreenRenderer 1600 1000 2 white))
  (let scene (call DisplayScene 2 white renderer))
  (let reference (call RasterCanvas 1600 1000 2 white))
  (let elapsed (list U64))
  (let gpu (list U64))
  (let result VectorFillsResult)
  (do-use renderer
    (do-use reference
      (call (. scene build) root)
      (call (. scene commit))
      (call (. scene frame-metal) renderer)
      (call (. renderer finish))
      (for (in warmup (..< 0 6))
        (call (. scene add-damage) (. root bounds))
        (call (. scene frame-metal) renderer)
      )
      (call (. renderer finish))
      (for (in frame (..< 0 31))
        (call (. scene add-damage) (. root bounds))
        (let started (call monotonic-time-nanoseconds))
        (call (. scene frame-metal) renderer)
        (+= elapsed (- (call monotonic-time-nanoseconds) started))
        (call (. renderer finish))
        (if (>= (. renderer gpu-nanos) 0)
          (+= gpu (as (. renderer gpu-nanos) U64))
        )
      )
      (call (. root paint) reference)
      (let diff (call (. renderer diff) reference 2))
      (let gross (call (. renderer diff) reference 10))
      (= result
        (call VectorFillsResult
          (block
            (arg (call vector-fills-median elapsed))
            (arg (call vector-fills-median gpu))
            (arg (. renderer fill-segments))
            (arg (. renderer fill-tiles))
            (arg (. renderer fill-pieces))
            (arg (. renderer fill-opaque-tiles))
            (arg (. renderer draw-calls))
            (arg (. renderer fill-overflows))
            (arg (/ (* (. diff differing-pixels) 1000000) (. diff pixel-count)))
            (arg (. diff maximum-channel-delta))
            (arg (/ (* (. gross differing-pixels) 1000000) (. gross pixel-count)))
          )
        )
      )
      (throw (call Panic "Vector fills fell back to CoreGraphics tiles") (if (!= (. scene metal-tile-fallbacks) 0)))
      (throw (call Panic "Vector fills skipped Metal operations") (if (!= (. renderer skipped-ops) 0)))
      (throw (call Panic "Vector fills did not draw every span on the GPU") (if (!= (. renderer fill-draws) 6250)))
      (throw (call Panic "Vector fills differ from CoreGraphics beyond the GR-D13 budget") (if (> (. result gross-ppm) 100)))
    )
  )
  (call (. scene close))
  (call (. root close))
  (call markup-release root)
  (return result)
)

(fn-expr _ vector-fills-median _
  (param samples (list U64))
  ([] sorted (/ (. sorted length) 2))
  (where
    (lazy sorted (call sort samples (:using (=> (left right) (if-expr (< left right) .lesser .greater)))))
  )
)

(type _ VectorFillsRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (rule This
    (= layout flow-col)
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
    (let ignored (. flush applied))
  )
)

(type _ VectorFillsBand (is Box)
  (prop + first Size)
  (prop + complex Bool)
  (prop _ handles (list VectorGeometryHandle))
  (blank)
  (rule This
    (= min-width (call (. SizeSpec coord) 1600))
    (= max-width (call (. SizeSpec coord) 1600))
    (= min-height (call (. SizeSpec coord) 100))
    (= max-height (call (. SizeSpec coord) 100))
  )
  (fn-do + This _
    (param first _)
    (param complex _)
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let table (call vector-geometry-table-for markup-batch-root))
    (if (not handles)
      (for (in serial (..< first (+ first 500)))
        (let key (+ (* serial 2) (if-expr complex 1 0)))
        (+= handles (call (. table intern-geometry) (as key U64) (=> () (call vector-fills-geometry serial complex))))
      )
    )
    (let origin (. bounds top-left))
    (for (in serial (..< first (+ first 500)))
      (let hue (/ (as (% serial 12) F64) 12))
      (let palette
        (block
          (item (call RGBA (+ 0.2 (* hue 0.7)) 0.45 (- 0.9 (* hue 0.6)) (if-expr (== (% serial 7) 0) 0.6 1)))
          (item (call RGBA 0.95 (- 0.8 (* hue 0.5)) 0.2 (if-expr (== (% serial 9) 0) 0.7 1)))
        )
      )
      (let x (as (+ (. origin x) (% (* serial 37) 1520)) F64))
      (let y (as (+ (. origin y) (% (* serial 53) 40)) F64))
      (let transform (call matrix-from-translation (call Point x y)))
      (if (== (% serial 10) 3)
        (let angle (+ (* (as (% serial 7) F64) 0.23rad) 0.1rad))
        (= transform (call (. (call matrix-from-rotation angle (call Point (+ x 30) (+ y 30))) concatenate) transform))
      )
      (= (. canvas fill-color) (call RGBA 0.1 0.6 0.3 1))
      (= (. canvas stroke-color) null)
      (let clip (? Rect) (only-if (call Rect x y 40 36) (if (== (% serial 13) 5))))
      (let painted (call (. table paint-vector) ([] handles (- serial first)) canvas palette transform clip))
    )
  )
)

(fn-do _ vector-fills-geometry _
  (param serial Size)
  (param complex Bool)
  (let spans (list VectorGeometrySpan))
  (let span (as (+ 20 (% (* serial 7) 44)) F64))
  (let none (call VectorGeometryPaint (. VectorGeometryPaintRole none) 0))
  (let rule (if-expr (== (% serial 11) 0) (. FillRule even-odd) (. FillRule nonzero)))
  (let role (if-expr (== (% serial 5) 1) (. VectorGeometryPaintRole inherit) (. VectorGeometryPaintRole color)))
  (let outer (call Path))
  (if complex
    (let center (call Point (+ 4 (* span 0.5)) (+ 4 (* span 0.5))))
    (let petals 48)
    (for (in petal (..< 0 petals))
      (let start (/ (* (as petal F64) 2 π) (as petals F64)))
      (let step (/ (* 2 π) (as petals F64)))
      (let radius (if-expr (== (% petal 2) 0) (* span 0.5) (* span 0.4)))
      (let next (if-expr (== (% petal 2) 0) (* span 0.4) (* span 0.5)))
      (let head (+ center (call Point (* (call cos start) radius) (* (call sin start) radius))))
      (let tail (+ center (call Point (* (call cos (+ start step)) next) (* (call sin (+ start step)) next))))
      (let bulge (* span 0.55))
      (if (== petal 0)
        (call (. outer move-to) head)
      )
      (call (. outer cubic-curve-to)
        (block
          (arg (+ center (call Point (* (call cos (+ start (/ step 3))) bulge) (* (call sin (+ start (/ step 3))) bulge))))
          (arg (+ center (call Point (* (call cos (+ start (/ (* step 2) 3))) bulge) (* (call sin (+ start (/ (* step 2) 3))) bulge))))
          (arg tail)
        )
      )
    )
    (call (. outer close))
    (else
      (let lean (* (as (% serial 29) F64) 0.5))
      (let a (call Point 4 10))
      (let b (call Point (+ 4 span lean) 16))
      (let c (call Point (+ 4 (* span 0.4)) (+ 10 (* span 0.8) (* lean 0.5))))
      (call (. outer move-to) a)
      (call (. outer cubic-curve-to) (+ a (call Point (* span 0.3) (* (- span) 0.4))) (+ b (call Point (* (- span) 0.3) (* (- span) 0.4))) b)
      (call (. outer cubic-curve-to) (+ b (call Point (* span 0.15) (* span 0.3))) (+ c (call Point 0 (* (- span) 0.3))) c)
      (call (. outer line-to) a)
    )
  )
  (if (== (% serial 11) 0)
    (call (. outer move-to) (call Point (* span 0.3) 14))
    (call (. outer line-to) (call Point (* span 0.5) 14))
    (call (. outer line-to) (call Point (* span 0.4) 22))
    (call (. outer close))
  )
  (+= spans (call VectorGeometrySpan outer (call VectorGeometryPaint role 0) none null null null rule))
  (if (== (% serial 4) 0)
    (let inner (call Path))
    (call (. inner move-to) (call Point 10 24))
    (call (. inner cubic-curve-to) (call Point 16 16) (call Point 28 16) (call Point 34 24))
    (call (. inner cubic-curve-to) (call Point 28 32) (call Point 16 32) (call Point 10 24))
    (call (. inner close))
    (+= spans
      (call VectorGeometrySpan
        (block
          (arg inner)
          (arg (call VectorGeometryPaint (. VectorGeometryPaintRole color) 1))
          (arg none)
          (arg null)
          (arg null)
          (arg null)
          (arg (. FillRule nonzero))
        )
      )
    )
  )
  (return (call VectorGeometry (call Rect 0 0 100 100) (call Rect 0 0 100 100) spans (== (% serial 5) 1) false))
)
