; benchmark.meta description: Incremental retained bytes per scroll-enabled Box after one scroll, at 1k/10k with collect-twice.
; benchmark.meta timing: not-recommended
; benchmark.meta profiles: gui,compile-timing
(blank)
(import /BxGC/BxGC.h)
(import /core/markup)
(import /graphics/point)
(import /graphics/primitives)
(import /gui/box)
(import /gui/primitives)
(blank)
(prop _ measured-bytes Size (= 0))
(prop _ measured-cells Size (= 0))
(blank)

(main
  (let xs (list F64))
  (let ys (list F64))
  (let checksum Size 0)
  (blank)
  (call measure-variant false 1000)
  (let enabled-1k measured-bytes)
  (+= checksum measured-cells)
  (call measure-variant true 1000)
  (let scrolled-1k measured-bytes)
  (+= checksum measured-cells)
  (let delta-1k (- scrolled-1k enabled-1k))
  (probe-count gui.bench.memory.scroll-bytes-1k delta-1k)
  (+= xs 1000.0)
  (+= ys (as delta-1k F64))
  (blank)
  (call measure-variant false 10000)
  (let enabled-10k measured-bytes)
  (+= checksum measured-cells)
  (call measure-variant true 10000)
  (let scrolled-10k measured-bytes)
  (+= checksum measured-cells)
  (let delta-10k (- scrolled-10k enabled-10k))
  (probe-count gui.bench.memory.scroll-bytes-10k delta-10k)
  (+= xs 10000.0)
  (+= ys (as delta-10k F64))
  (blank)
  (let scroll-slope-bytes (as (call slope-of xs ys) Size))
  (probe-count gui.bench.memory.scroll-slope-bytes scroll-slope-bytes)
  (blank)
  (print (str "bench-result gui/memory-slope-scroll checksum=" checksum))
)

(fn-do + settle-live Size
  (call C:brixCollect)
  (call C:brixCollect)
  (return (as (call C:brixGCLiveByteCount) Size))
)

(fn-expr + slope-of F64
  (param xs (list F64))
  (param ys (list F64))
  (/ (- ([] ys 1) ([] ys 0)) dx)
  (where
    (lazy dx (- ([] xs 1) ([] xs 0)))
  )
)

(fn-do + measure-variant _
  (param should-scroll Bool)
  (param cell-count Size)
  (let live0 (call settle-live))
  (let root (call BenchRoot))
  (call markup-mount-root root root)
  (let cells (list Box))
  (let rows (/ cell-count 100))
  (for (in row-index (..< 0 rows))
    (let row (call PlainRow))
    (call markup-append root row)
    (for (in cell-index (..< 0 100))
      (let cell (call ScrollCell))
      (+= cells cell)
      (call markup-append row cell)
    )
  )
  (blank)
  (call (. root markup-batch-queue checkpoint))
  (call (. root layout) (call Rect 0 0 1200 800))
  (if should-scroll
    (for (in cell cells)
      (call (. cell arrange-bounds) (call Rect 0 0 10 10))
      (= (. cell inner-height) 20)
      (call (. cell scroll-by) (call Point 0 1))
    )
  )
  (blank)
  (let live (call settle-live))
  (= measured-bytes (- live live0))
  (= measured-cells (. cells length))
  (blank)
  (call (. root close))
  (call markup-release root)
)

(type + BenchRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(type + PlainRow (is Box))

(type + ScrollCell (is Box)
  (rule This
    (= overflow-y (. ScrollOverflow scroll))
  )
)
