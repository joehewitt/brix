; benchmark.meta description: Layout visits, measure calls, and TextLayouts created after a single leaf layout invalidation in 1k and 10k box trees, via counting subclasses.
; benchmark.meta timing: not-recommended
; benchmark.meta profiles: gui,compile-timing
(blank)
(import /BxGC/BxGC.h)
(import /core/markup)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/text)
(import /gui/box)
(import /gui/layout)
(import /gui/primitives)
(blank)
(prop _ paint-visits Size (= 0))
(prop _ sync-visits Size (= 0))
(prop _ measure-calls Size (= 0))
(prop _ layout-visits Size (= 0))
(prop _ cells-list (list CountingCell))
(prop _ checksum Size (= 0))
(blank)

(main
  (call layout-scenario 1000)
  (call layout-scenario 10000)
  (blank)
  (print (str "bench-result gui/leaf-layout-mutation checksum=" checksum))
)

(fn-do + layout-scenario _
  (param cell-count Size)
  (= cells-list (call (of List CountingCell)))
  (let root (call build-tree cell-count))
  (let canvas (call RasterCanvas 1200 900 2))
  (do-use canvas
    ; settle: one full paint so nothing is initially invalid
    (call (. root paint) canvas)
    (blank)
    (let target ([] cells-list (/ (. cells-list length) 2)))
    (call (. target invalidate-layout))
    (call (. root markup-batch-queue checkpoint))
    (call reset-counters)
    (let objects0 (call C:brixGCAllocatedObjectCount))
    (let bytes0 (call C:brixGCRequestedByteCount))
    (let text-layouts0 (call text-layout-created-count))
    (call (. root update-layout))
    (call (. root sync-native-geometry))
    (call (. root paint) canvas)
    (let frame-objects (- (call C:brixGCAllocatedObjectCount) objects0))
    (let frame-bytes (- (call C:brixGCRequestedByteCount) bytes0))
    (let frame-text-layouts (- (call text-layout-created-count) text-layouts0))
    (blank)
    (throw (call Panic "leaf layout mutation visited more than three layouts") (if (> layout-visits 3)))
    (throw (call Panic "leaf layout mutation remeasured a settled child") (if measure-calls))
    (blank)
    (if (== cell-count 1000)
      (probe-count gui.bench.leaf.layout-visits-1k layout-visits)
      (probe-count gui.bench.leaf.measure-calls-1k measure-calls)
      (probe-count gui.bench.leaf.text-layouts-1k frame-text-layouts)
      (probe-count gui.bench.leaf.paint-visits-1k paint-visits)
      (probe-count gui.bench.leaf.sync-visits-1k sync-visits)
      (probe-count gui.bench.leaf.objects-1k frame-objects)
      (probe-count gui.bench.leaf.bytes-1k frame-bytes)
      (else
        (probe-count gui.bench.leaf.layout-visits-10k layout-visits)
        (probe-count gui.bench.leaf.measure-calls-10k measure-calls)
        (probe-count gui.bench.leaf.text-layouts-10k frame-text-layouts)
        (probe-count gui.bench.leaf.paint-visits-10k paint-visits)
        (probe-count gui.bench.leaf.sync-visits-10k sync-visits)
        (probe-count gui.bench.leaf.objects-10k frame-objects)
        (probe-count gui.bench.leaf.bytes-10k frame-bytes)
      )
    )
    (blank)
    (+= checksum (+ (* layout-visits 1000) (* measure-calls 100) paint-visits sync-visits))
  )
  (blank)
  (call (. root close))
  (call markup-release root)
)

(fn-do + reset-counters _
  (= paint-visits 0)
  (= sync-visits 0)
  (= measure-calls 0)
  (= layout-visits 0)
)

(fn-do + build-tree CountingRoot
  (param cell-count Size)
  (let root (call CountingRoot))
  (call markup-mount-root root root)
  (let rows (/ cell-count 100))
  (for (in row-index (..< 0 rows))
    (let row (call CountingRow))
    (call markup-append root row)
    (for (in cell-index (..< 0 100))
      (let cell (call CountingCell))
      (+= cells-list cell)
      (call markup-append row cell)
    )
  )
  (call (. root markup-batch-queue checkpoint))
  (call (. root layout) (call Rect 0 0 1200 900))
  (return root)
)

(type + CountingRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (rule This
    (= layout flow-col)
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
  (fn-do + paint-traversal-visit _
    (+= paint-visits 1)
  )
  (fn-do + sync-native-geometry-traversal-visit _
    (+= sync-visits 1)
  )
  (fn-do + did-layout _
    (+= layout-visits 1)
    (call (. super did-layout))
  )
)

(type + CountingRow (is Box)
  (rule This
    (= layout flow-row)
  )
  (fn-do + paint-traversal-visit _
    (+= paint-visits 1)
  )
  (fn-do + sync-native-geometry-traversal-visit _
    (+= sync-visits 1)
  )
  (fn-do + measure MeasureResult
    (param query MeasureQuery (= (call measure-fit-query)))
    (+= measure-calls 1)
    (return (call (. super measure) query))
  )
  (fn-do + did-layout _
    (+= layout-visits 1)
    (call (. super did-layout))
  )
)

(type + CountingCell (is Box)
  (rule This (• bg "#8080e6")
    (= min-width (call (. SizeSpec coord) 11))
    (= min-height (call (. SizeSpec coord) 8))
    (= max-width (call (. SizeSpec coord) 11))
    (= max-height (call (. SizeSpec coord) 8))
  )
  (fn-do + paint-traversal-visit _
    (+= paint-visits 1)
  )
  (fn-do + sync-native-geometry-traversal-visit _
    (+= sync-visits 1)
  )
  (fn-do + measure MeasureResult
    (param query MeasureQuery (= (call measure-fit-query)))
    (+= measure-calls 1)
    (return (call (. super measure) query))
  )
  (fn-do + did-layout _
    (+= layout-visits 1)
    (call (. super did-layout))
  )
)
