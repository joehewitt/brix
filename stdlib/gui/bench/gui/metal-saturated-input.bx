; benchmark.meta description: Animates a default Window CAMetalLayer through a light phase, a phase whose frames spin for 1.5 refresh intervals, and a phase of eight full-window blur groups, posting single clicks and 16-click bursts through the app event queue, and reports how long input, the main dispatch queue, and the collector wait while frames run back to back.
; benchmark.meta timing: not-recommended
; benchmark.meta profiles: gui-metal
(blank)
(import /BxAppleGUI/BxAppleGUI.h)
(import /BxGC/BxGC.h)
(import /core/intrinsics)
(import /core/markup)
(import /core/task)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/primitives)
(import /gui/app)
(import /gui/box)
(import /gui/keys)
(import /gui/layout)
(import /gui/primitives)
(import /gui/window)
(import /stream/sort)
(import /time/duration)
(import /time/timer)
(blank)

(main
  (let app (call App))
  (let window (call SaturatedWindow))
  (+= app window)
  (= (. window size) (call Dimensions 1200 900))
  (let surface (call SaturatedSurface))
  (+= (. window surfaces) surface)
  (call markup-append window surface)
  (blank)
  (call C:brixGuiAppDebugMainLoopProbeStart 20000000)
  (call (. window open))
  (if (not (. window finished))
    (call C:brixGuiAppScheduleStop (!! (. app native)) 40000000000)
    (call C:brixGuiAppRun (!! (. app native)))
  )
  (if (. window did-fallback)
    (call (. app close))
    (throw (call Panic "Metal window presentation was unavailable and fell back to CoreGraphics"))
  )
  (if (not (. window finished))
    (call (. app close))
    (throw (call Panic "Saturated animation exceeded its 40-second execution bound"))
  )
  (blank)
  (let checksum (. window phases-reported))
  (call (. app close))
  (print (str "bench-result gui/metal-saturated-input checksum=" checksum))
)

(fn-expr _ saturated-percentile U64
  (param values (list U64))
  (param percentile Size)
  (case? (not values)
    0
  )
  (default
    ([] sorted index)
  )
  (where
    (lazy sorted (call sort values (:using (=> (left right) (if-expr (< left right) .lesser .greater)))))
    (lazy index (/ (* (- (. sorted length) 1) percentile) 100))
  )
)

(type _ SaturatedWindow (is Window)
  (prop + surfaces (list SaturatedSurface))
  (prop + did-fallback _ (= false))
  (prop + finished _ (= false))
  (prop + phases-reported Size (= 0))
  (blank)
  (prop _ phase Size (= 0))
  (prop _ phase-frame Size (= 0))
  (prop _ phase-started U64)
  (prop _ phase-spin U64)
  (prop _ refresh U64 (= 8333333))
  (prop _ frame-index Size (= 0))
  (prop _ work (list U64))
  (prop _ waits (list U64))
  (prop _ frame-ids (list I64))
  (prop _ click-latencies (list U64))
  (prop _ burst-latencies (list U64))
  (prop _ burst-frames (list U64))
  (prop _ click-pending _ (= false))
  (prop _ click-is-burst _ (= false))
  (prop _ click-post-time U64)
  (prop _ click-post-frame Size (= 0))
  (prop _ clicks-expected Size (= 0))
  (prop _ offers-started Size (= 0))
  (blank)
  (rule This
    (= layout flow-col)
  )
  (fn-do + render Bool
    (return-if false (if finished))
    (let started (call monotonic-time-nanoseconds))
    (if (== phase-started 0)
      (call begin-phase started)
    )
    (blank)
    (let spun Size 0)
    (while (< (- (call monotonic-time-nanoseconds) started) phase-spin)
      (+= spun 1)
    )
    (blank)
    (let surface ([] surfaces 0))
    (call settle-clicks surface)
    (= (. surface step) frame-index)
    (= (. surface blur-groups) (if-expr (== phase 3) 8 0))
    (call (. surface invalidate-paint))
    (blank)
    (let did-render (call (. super render)))
    (let ended (call monotonic-time-nanoseconds))
    (if (and did-render is-metal-rendering)
      (let frame last-metal-frame-id)
      (+= frame-ids frame)
      (+= work (- ended started))
      (+= waits (as (call metal-frame-drawable-wait-nanos frame) U64))
      (else-if (not is-metal-rendering)
        (= did-fallback true)
      )
    )
    (blank)
    (if (and (not click-pending) (== (% phase-frame 12) 6))
      (= click-is-burst (== (% phase-frame 60) 30))
      (let count Size (if-expr click-is-burst 16 1))
      (= click-pending true)
      (= click-post-frame frame-index)
      (= click-post-time (call monotonic-time-nanoseconds))
      (+= clicks-expected count)
      (for (in index (..< 0 count))
        (call C:brixGuiWindowDebugPostMouseClick (!! native) 300 300)
      )
    )
    (blank)
    (+= frame-index 1)
    (+= phase-frame 1)
    (let now (call monotonic-time-nanoseconds))
    (let phase-length Size (if-expr (== phase 0) 40 150))
    (let phase-over (or (>= phase-frame phase-length) (> (- now phase-started) 5000000000)))
    (if did-fallback
      (= finished true)
      (call (?. app stop))
      (else-if phase-over
        (call report-phase surface now)
        (+= phase 1)
        (if (> phase 3)
          (= finished true)
          (call (?. app stop))
          (else
            (call begin-phase now)
            (call schedule-render)
          )
        )
      )
      (else
        (call schedule-render)
      )
    )
    (return did-render)
  )
  (fn-do _ settle-clicks _
    (param surface SaturatedSurface)
    (return-if (if (or (not click-pending) (< (. surface arrival-times length) clicks-expected))))
    (let latency (- ([] (. surface arrival-times) (- clicks-expected 1)) click-post-time))
    (if click-is-burst
      (+= burst-latencies latency)
      (+= burst-frames (as (- ([] (. surface arrival-steps) (- clicks-expected 1)) click-post-frame) U64))
      (else
        (+= click-latencies latency)
      )
    )
    (= click-pending false)
  )
  (fn-do _ begin-phase _
    (param now U64)
    (let interval (call C:brixGuiWindowGetLastFrameRefreshIntervalNanoseconds (!! native)))
    (if (> interval 0)
      (= refresh interval)
    )
    (= phase-started now)
    (= phase-frame 0)
    (= phase-spin (if-expr (== phase 2) (/ (* refresh 3) 2) 0))
    (= work (call (of List U64)))
    (= waits (call (of List U64)))
    (= frame-ids (call (of List I64)))
    (= click-latencies (call (of List U64)))
    (= burst-latencies (call (of List U64)))
    (= burst-frames (call (of List U64)))
    (= offers-started (as (call C:brixGCFrameBudgetOfferCount) Size))
    (let ignored (call C:brixGuiAppDebugMainLoopProbeValue 3))
  )
  (fn-do _ report-phase _
    (param surface SaturatedSurface)
    (param now U64)
    (call settle-clicks surface)
    (if click-pending
      (if click-is-burst
        (+= burst-latencies (- now click-post-time))
        (+= burst-frames (as (- frame-index click-post-frame) U64))
        (else
          (+= click-latencies (- now click-post-time))
        )
      )
      (= click-pending false)
    )
    (+= phases-reported 1)
    (return-if (if (== phase 0)))
    (blank)
    (let frames (as (. work length) U64))
    (return-if (if (== frames 0)))
    (let wall (- now phase-started))
    (let frames-per-second (/ (* frames 1000000000) wall))
    (let blocked U64)
    (for (in value waits)
      (+= blocked value)
    )
    (let blocked-percent (/ (* blocked 100) wall))
    (let gpu (list U64))
    (let presented (list U64))
    (for (in frame frame-ids)
      (let nanos (call metal-frame-gpu-nanos frame))
      (if (>= nanos 0)
        (+= gpu (as nanos U64))
      )
      (let shown (call metal-frame-presented-time-nanoseconds frame))
      (if (> shown 0)
        (+= presented (as shown U64))
      )
    )
    (let slow-presents U64)
    (for (in index (..< 1 (. presented length)))
      (if (> ([] presented index) (+ ([] presented (- index 1)) (/ (* refresh 3) 2)))
        (+= slow-presents 1)
      )
    )
    (let click-p50 (call saturated-percentile click-latencies 50))
    (let burst-drain (call saturated-percentile burst-latencies 100))
    (let burst-drain-frames (call saturated-percentile burst-frames 100))
    (let wait-p50 (call saturated-percentile waits 50))
    (let gpu-p50 (call saturated-percentile gpu 50))
    (let dispatch-max (as (call C:brixGuiAppDebugMainLoopProbeValue 1) U64))
    (let sleeps (/ (* (as (call C:brixGuiAppDebugMainLoopProbeValue 2) U64) 100) frames))
    (let offers (/ (* (as (- (call C:brixGCFrameBudgetOfferCount) offers-started) U64) 100) frames))
    (match? phase
      (case= 1
        (probe-count gui.bench.metal.sat-light-frames-per-second frames-per-second)
        (probe-count gui.bench.metal.sat-light-click-p50-ns click-p50)
        (probe-count gui.bench.metal.sat-light-burst-drain-ns burst-drain)
        (probe-count gui.bench.metal.sat-light-burst-drain-frames burst-drain-frames)
        (probe-count gui.bench.metal.sat-light-main-dispatch-max-ns dispatch-max)
        (probe-count gui.bench.metal.sat-light-drawable-wait-p50-ns wait-p50)
        (probe-count gui.bench.metal.sat-light-slow-presents slow-presents)
      )
      (case= 2
        (probe-count gui.bench.metal.sat-cpu-frames-per-second frames-per-second)
        (probe-count gui.bench.metal.sat-cpu-click-p50-ns click-p50)
        (probe-count gui.bench.metal.sat-cpu-burst-drain-ns burst-drain)
        (probe-count gui.bench.metal.sat-cpu-burst-drain-frames burst-drain-frames)
        (probe-count gui.bench.metal.sat-cpu-main-dispatch-max-ns dispatch-max)
        (probe-count gui.bench.metal.sat-cpu-loop-sleeps-per-100-frames sleeps)
        (probe-count gui.bench.metal.sat-cpu-gc-offers-per-100-frames offers)
      )
      (case= 3
        (probe-count gui.bench.metal.sat-gpu-frames-per-second frames-per-second)
        (probe-count gui.bench.metal.sat-gpu-click-p50-ns click-p50)
        (probe-count gui.bench.metal.sat-gpu-burst-drain-ns burst-drain)
        (probe-count gui.bench.metal.sat-gpu-burst-drain-frames burst-drain-frames)
        (probe-count gui.bench.metal.sat-gpu-main-dispatch-max-ns dispatch-max)
        (probe-count gui.bench.metal.sat-gpu-loop-sleeps-per-100-frames sleeps)
        (probe-count gui.bench.metal.sat-gpu-gc-offers-per-100-frames offers)
        (probe-count gui.bench.metal.sat-gpu-blocked-percent blocked-percent)
        (probe-count gui.bench.metal.sat-gpu-drawable-wait-p50-ns wait-p50)
        (probe-count gui.bench.metal.sat-gpu-gpu-p50-ns gpu-p50)
      )
    )
  )
)

(type _ SaturatedSurface (is Box)
  (prop + step Size (= 0))
  (prop + blur-groups Size (= 0))
  (prop + arrival-times (list U64))
  (prop + arrival-steps (list Size))
  (blank)
  (rule This
    (= min-width (call (. SizeSpec coord) 1200))
    (= max-width (call (. SizeSpec coord) 1200))
    (= min-height (call (. SizeSpec coord) 900))
    (= max-height (call (. SizeSpec coord) 900))
  )
  (subscribe-for (on event pointer-down)
    (+= arrival-times (call monotonic-time-nanoseconds))
    (+= arrival-steps step)
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (= (. canvas stroke-color) null)
    (for (in index (..< 0 1000))
      (let shade (as (% (+ index step) 20) F64))
      (= (. canvas fill-color) (call RGBA (+ 0.2 (* 0.03 shade)) 0.3 0.6 1))
      (call (. canvas rect) (call Rect (as (* (% index 50) 24) F64) (as (* (/ index 50) 44) F64) 20 40))
    )
    (for (in group (..< 0 blur-groups))
      (call (. canvas begin-blur) 6)
      (= (. canvas fill-color) (call RGBA 0.9 0.4 0.2 0.25))
      (call (. canvas rect) (call Rect 20 20 1160 860))
      (call (. canvas end-blur))
    )
  )
)
