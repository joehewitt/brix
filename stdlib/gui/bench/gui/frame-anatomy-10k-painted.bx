; benchmark.meta description: Per-phase frame timing and allocation deltas for 10k painted boxes against a real never-shown native window at 1180x800.
; benchmark.meta timing: recommended
; benchmark.meta profiles: gui,compile-timing
(blank)
(import /BxAppleGUI/BxAppleGUI.h)
(import /BxGC/BxGC.h)
(import /core/markup)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/primitives)
(import /gui/box)
(import /gui/layout)
(import /gui/primitives)
(import /gui/scene)
(import /gui/window)
(import /stream/sort)
(import /time/timer)
(blank)

(main
  (let cell-count Size 10000)
  (let painted-cells true)
  (let root (call BenchRoot))
  (call markup-mount-root root root)
  (let background (call RGBA 1 1 1 1))
  (blank)
  (let rows (/ cell-count 100))
  (for (in row-index (..< 0 rows))
    (let row (call BenchRow))
    (call markup-append root row)
    (for (in cell-index (..< 0 100))
      (if painted-cells
        (call markup-append row (call PaintedCell))
        (else
          (call markup-append row (call PlainCell))
        )
      )
    )
  )
  (blank)
  (call (. root markup-batch-queue checkpoint))
  (let native (call C:brixGuiWindowCreate "gui bench frame-anatomy-10k-painted (offscreen)" 1180 800))
  (let scale (call C:brixGuiWindowGetBackingScaleFactor native))
  (let layout0 (call monotonic-time-nanoseconds))
  (call (. root layout) (call Rect 0 0 1180 800))
  (let layout1 (call monotonic-time-nanoseconds))
  (call (. root update-layout))
  (let layout2 (call monotonic-time-nanoseconds))
  (let surface (call RasterCanvas 1180 800 scale background))
  (let scene (call DisplayScene scale background))
  (blank)
  (for (in warm (..< 0 3))
    (call render-once scene root surface native background scale)
  )
  (blank)
  (let frames Size 30)
  (let create-ns (list U64))
  (let erase-ns (list U64))
  (let sync-ns (list U64))
  (let paint-ns (list U64))
  (let commit-ns (list U64))
  (let close-ns (list U64))
  (let total-ns (list U64))
  (let sync-objects Size 0)
  (let paint-objects Size 0)
  (let paint-bytes Size 0)
  (blank)
  (for (in frame (..< 0 frames))
    (let t0 (call monotonic-time-nanoseconds))
    (let t1 (call monotonic-time-nanoseconds))
    (let t2 (call monotonic-time-nanoseconds))
    (let sync-objects0 (call C:brixGCAllocatedObjectCount))
    (call (. root sync-native-geometry))
    (+= sync-objects (as (- (call C:brixGCAllocatedObjectCount) sync-objects0) Size))
    (let t3 (call monotonic-time-nanoseconds))
    (let paint-objects0 (call C:brixGCAllocatedObjectCount))
    (let paint-bytes0 (call C:brixGCRequestedByteCount))
    (call (. scene maintain) root scale background)
    (let replay-count (. scene frames-replayed))
    (call (. scene frame) surface)
    (+= paint-objects (as (- (call C:brixGCAllocatedObjectCount) paint-objects0) Size))
    (+= paint-bytes (as (- (call C:brixGCRequestedByteCount) paint-bytes0) Size))
    (let t4 (call monotonic-time-nanoseconds))
    (if (!= (. scene frames-replayed) replay-count)
      (call C:brixGuiWindowCommitFrame
        (block
          (arg native)
          (arg (. surface native))
          (arg (. scene last-frame-damage x))
          (arg (. scene last-frame-damage y))
          (arg (. scene last-frame-damage width))
          (arg (. scene last-frame-damage height))
        )
      )
    )
    (let t5 (call monotonic-time-nanoseconds))
    (let t6 (call monotonic-time-nanoseconds))
    (+= create-ns (- t1 t0))
    (+= erase-ns (- t2 t1))
    (+= sync-ns (- t3 t2))
    (+= paint-ns (- t4 t3))
    (+= commit-ns (- t5 t4))
    (+= close-ns (- t6 t5))
    (+= total-ns (- t6 t0))
  )
  (blank)
  (let create-p50 (call percentile-us create-ns 50))
  (let create-p95 (call percentile-us create-ns 95))
  (let create-p99 (call percentile-us create-ns 99))
  (let create-min (call min-us create-ns))
  (let erase-p50 (call percentile-us erase-ns 50))
  (let erase-p95 (call percentile-us erase-ns 95))
  (let erase-p99 (call percentile-us erase-ns 99))
  (let erase-min (call min-us erase-ns))
  (let sync-p50 (call percentile-us sync-ns 50))
  (let sync-p95 (call percentile-us sync-ns 95))
  (let sync-p99 (call percentile-us sync-ns 99))
  (let sync-min (call min-us sync-ns))
  (let paint-p50 (call percentile-us paint-ns 50))
  (let paint-p95 (call percentile-us paint-ns 95))
  (let paint-p99 (call percentile-us paint-ns 99))
  (let paint-min (call min-us paint-ns))
  (let commit-p50 (call percentile-us commit-ns 50))
  (let commit-p95 (call percentile-us commit-ns 95))
  (let commit-p99 (call percentile-us commit-ns 99))
  (let commit-min (call min-us commit-ns))
  (let close-p50 (call percentile-us close-ns 50))
  (let close-p95 (call percentile-us close-ns 95))
  (let close-p99 (call percentile-us close-ns 99))
  (let close-min (call min-us close-ns))
  (let total-p50 (call percentile-us total-ns 50))
  (let total-p95 (call percentile-us total-ns 95))
  (let total-p99 (call percentile-us total-ns 99))
  (let total-min (call min-us total-ns))
  (blank)
  (probe-count gui.bench.frame.create-p50-us create-p50)
  (probe-count gui.bench.frame.create-p95-us create-p95)
  (probe-count gui.bench.frame.create-p99-us create-p99)
  (probe-count gui.bench.frame.create-min-us create-min)
  (probe-count gui.bench.frame.erase-p50-us erase-p50)
  (probe-count gui.bench.frame.erase-p95-us erase-p95)
  (probe-count gui.bench.frame.erase-p99-us erase-p99)
  (probe-count gui.bench.frame.erase-min-us erase-min)
  (probe-count gui.bench.frame.sync-p50-us sync-p50)
  (probe-count gui.bench.frame.sync-p95-us sync-p95)
  (probe-count gui.bench.frame.sync-p99-us sync-p99)
  (probe-count gui.bench.frame.sync-min-us sync-min)
  (probe-count gui.bench.frame.paint-p50-us paint-p50)
  (probe-count gui.bench.frame.paint-p95-us paint-p95)
  (probe-count gui.bench.frame.paint-p99-us paint-p99)
  (probe-count gui.bench.frame.paint-min-us paint-min)
  (probe-count gui.bench.frame.commit-p50-us commit-p50)
  (probe-count gui.bench.frame.commit-p95-us commit-p95)
  (probe-count gui.bench.frame.commit-p99-us commit-p99)
  (probe-count gui.bench.frame.commit-min-us commit-min)
  (probe-count gui.bench.frame.close-p50-us close-p50)
  (probe-count gui.bench.frame.close-p95-us close-p95)
  (probe-count gui.bench.frame.close-p99-us close-p99)
  (probe-count gui.bench.frame.close-min-us close-min)
  (probe-count gui.bench.frame.total-p50-us total-p50)
  (probe-count gui.bench.frame.total-p95-us total-p95)
  (probe-count gui.bench.frame.total-p99-us total-p99)
  (probe-count gui.bench.frame.total-min-us total-min)
  (blank)
  (let layout-full-us (/ (- layout1 layout0) 1000))
  (let layout-clean-us (/ (- layout2 layout1) 1000))
  (let scale-x100 (as (* scale 100.0) Size))
  (probe-count gui.bench.frame.layout-full-us layout-full-us)
  (probe-count gui.bench.frame.layout-clean-us layout-clean-us)
  (probe-count gui.bench.frame.sync-objects (/ sync-objects frames))
  (probe-count gui.bench.frame.paint-objects (/ paint-objects frames))
  (probe-count gui.bench.frame.paint-bytes (/ paint-bytes frames))
  (probe-count gui.bench.frame.scale-x100 scale-x100)
  (probe-count gui.bench.frame.window-width 1180)
  (probe-count gui.bench.frame.window-height 800)
  (probe-count gui.bench.frame.frames frames)
  (blank)
  (call (. scene close))
  (call (. surface close))
  (call C:brixGuiWindowClose native)
  (call C:brixGuiWindowRelease native)
  (call (. root close))
  (call markup-release root)
  (blank)
  (let checksum (+ cell-count frames (as (. root inner-width) Size) (as (. root inner-height) Size)))
  (print (str "bench-result gui/frame-anatomy-10k-painted checksum=" checksum))
)

(fn-expr + percentile-us _
  (param values (list U64))
  (param percentile Size)
  (case? (not values)
    0
  )
  (default
    (/ ([] sorted index) 1000)
  )
  (where
    (lazy sorted (call sort values (:using (=> (left right) (if-expr (< left right) .lesser .greater)))))
    (lazy index (/ (* (- (. sorted length) 1) percentile) 100))
  )
)

(fn-expr + min-us _
  (param values (list U64))
  (case? (not values)
    0
  )
  (default
    (/ ([] sorted 0) 1000)
  )
  (where
    (lazy sorted (call sort values (:using (=> (left right) (if-expr (< left right) .lesser .greater)))))
  )
)

(fn-do + render-once _
  (param scene DisplayScene)
  (param root Box)
  (param surface RasterCanvas)
  (param native Pointer)
  (param background RGBA)
  (param scale F64)
  (call (. root sync-native-geometry))
  (call (. scene maintain) root scale background)
  (let replay-count (. scene frames-replayed))
  (call (. scene frame) surface)
  (if (!= (. scene frames-replayed) replay-count)
    (call C:brixGuiWindowCommitFrame
      (block
        (arg native)
        (arg (. surface native))
        (arg (. scene last-frame-damage x))
        (arg (. scene last-frame-damage y))
        (arg (. scene last-frame-damage width))
        (arg (. scene last-frame-damage height))
      )
    )
  )
)

(type + BenchRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (rule This
    (= layout flow-col)
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(type + BenchRow (is Box)
  (rule This
    (= layout flow-row)
  )
)

(type + PlainCell (is Box)
  (rule This
    (= min-width (call (. SizeSpec coord) 11))
    (= min-height (call (. SizeSpec coord) 8))
    (= max-width (call (. SizeSpec coord) 11))
    (= max-height (call (. SizeSpec coord) 8))
  )
)

(type + PaintedCell (is Box)
  (rule This (• bg "#8080e6")
    (= min-width (call (. SizeSpec coord) 11))
    (= min-height (call (. SizeSpec coord) 8))
    (= max-width (call (. SizeSpec coord) 11))
    (= max-height (call (. SizeSpec coord) 8))
  )
)
