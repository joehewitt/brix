`benchmark.meta description: Retained live bytes per plain mounted Box at 1k/10k/100k, with regression slope, allocation counts, and side-payload lanes after collect-twice.
`benchmark.meta timing: not-recommended
`benchmark.meta profiles: gui,compile-timing

/YuGC/YuGC.h
/core/markup
/graphics/primitives
/gui/box

_ measured-mounted Size = 0
_ measured-laidout Size = 0
_ measured-objects Size = 0
_ measured-boxes Size = 0
_ measured-lane0 Size = 0
_ measured-lane1 Size = 0
_ measured-lane2 Size = 0
_ measured-lane3 Size = 0

. xs [F64]
. mounted-ys [F64]
. laidout-ys [F64]
. checksum Size = 0

measure-variant("plain", 1000)
//gui.bench.memory.mounted-bytes-1k += measured-mounted
//gui.bench.memory.objects-1k += measured-objects
xs += measured-boxes as F64
mounted-ys += measured-mounted as F64
laidout-ys += measured-laidout as F64
checksum += measured-boxes

measure-variant("plain", 10000)
//gui.bench.memory.mounted-bytes-10k += measured-mounted
//gui.bench.memory.objects-10k += measured-objects
xs += measured-boxes as F64
mounted-ys += measured-mounted as F64
laidout-ys += measured-laidout as F64
checksum += measured-boxes

measure-variant("plain", 100000)
//gui.bench.memory.mounted-bytes-100k += measured-mounted
//gui.bench.memory.objects-100k += measured-objects
xs += measured-boxes as F64
mounted-ys += measured-mounted as F64
laidout-ys += measured-laidout as F64
checksum += measured-boxes

checksum += measured-lane3
//gui.bench.memory.lane0-delta += measured-lane0
//gui.bench.memory.lane1-delta += measured-lane1
//gui.bench.memory.lane2-delta += measured-lane2
//gui.bench.memory.lane3-delta += measured-lane3

. mounted-slope = slope-of(xs, mounted-ys)
. laidout-slope = slope-of(xs, laidout-ys)
. mounted-slope-bytes = mounted-slope as Size
. laidout-slope-bytes = laidout-slope as Size
//gui.bench.memory.box-mounted-slope-bytes += mounted-slope-bytes
//gui.bench.memory.box-laidout-slope-bytes += laidout-slope-bytes

-- "bench-result gui/memory-slope-box checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ do settle-live Size

C:yumiCollect()
C:yumiCollect()
= C:yumiGCLiveByteCount() as Size

━━━━━━━━━━━━━━━━━━━━
+ do slope-of F64
    - xs [F64]
    - ys [F64]

. n = xs.length as F64
. sum-x F64
. sum-y F64
. sum-xy F64
. sum-xx F64
for index in 0 .. < xs.length
    . x = xs[index]
    . y = ys[index]
    sum-x += x
    sum-y += y
    sum-xy += x * y
    sum-xx += x * x
= (n * sum-xy - sum-x * sum-y) / (n * sum-xx - sum-x * sum-x)

━━━━━━━━━━━━━━━━━━━━
+ do measure-variant
    - variant String
    - cell-count Size

. live0 = settle-live()
. objects0 = C:yumiGCAllocatedObjectCount()
. lane0-before = C:yumiGCObjectSidePayloadCount(0)
. lane1-before = C:yumiGCObjectSidePayloadCount(1)
. lane2-before = C:yumiGCObjectSidePayloadCount(2)
. lane3-before = C:yumiGCObjectSidePayloadCount(3)

. root = BenchRoot()
markup-mount-root(root, root)
. rows = cell-count / 100
. total-boxes Size = 1
for row-index in 0 .. < rows
    if variant == "plain"
        . row = PlainRow()
        markup-append(root, row)
        for cell-index in 0 .. < 100
            markup-append(row, Box())
        total-boxes += 101

root.markup-batch-queue.checkpoint()
. live-mounted = settle-live()
root.layout(Rect(0, 0, 1200, 800))
. live-laid-out = settle-live()

measured-mounted = live-mounted - live0
measured-laidout = live-laid-out - live0
measured-objects = (C:yumiGCAllocatedObjectCount() - objects0) as Size
measured-boxes = total-boxes
measured-lane0 = (C:yumiGCObjectSidePayloadCount(0) - lane0-before) as Size
measured-lane1 = (C:yumiGCObjectSidePayloadCount(1) - lane1-before) as Size
measured-lane2 = (C:yumiGCObjectSidePayloadCount(2) - lane2-before) as Size
measured-lane3 = (C:yumiGCObjectSidePayloadCount(3) - lane3-before) as Size

root.close()
markup-release(root)

━━━━━━━━━━━━━━━━━━━━
+ BenchRoot is Box
    is MarkupBatch

+ markup-batch-queue := MarkupBatchQueue(this)

────────────────────
+ do markup-batch-did-flush
    - flush MarkupBatchFlush

━━━━━━━━━━━━━━━━━━━━
+ PlainRow is Box
