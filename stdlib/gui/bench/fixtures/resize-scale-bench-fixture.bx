(import /BxAppleGUI/BxAppleGUI.h)
(import /BxGC/BxGC.h)
(import /core/markup)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/primitives)
(import /graphics/text)
(import /gui/box)
(import /gui/label)
(import /gui/layout)
(import /gui/primitives)
(import /gui/scene)
(import /stream/sort)
(import /time/timer)

(fn-do + run-gui-resize-scale-horizontal Size
  (return (call run-gui-resize-scale 0))
)

(fn-do + run-gui-resize-scale-vertical Size
  (return (call run-gui-resize-scale 1))
)

(fn-do + run-gui-resize-scale-both _
  (return (call run-gui-resize-scale 2))
)

(fn-do + run-gui-resize-scale-noop Size
  (return (call run-gui-resize-scale 3))
)

(fn-do _ run-gui-resize-scale Size
  (param mode Size)
  (let root (call build-gui-resize-scale-root))
  (let background RGBA "#08111f")
  (let native (call C:brixGuiWindowCreate "gui resize scale bench (offscreen)" 1360 860))
  (let scale (call C:brixGuiWindowGetBackingScaleFactor native))
  (let initial-width (call gui-resize-scale-width mode 0))
  (let initial-height (call gui-resize-scale-height mode 0))
  (call (. root layout) (call Rect 0 0 (as initial-width Coord) (as initial-height Coord)))
  (let surface
    (call RasterCanvas
      (block
        (arg (as initial-width I32))
        (arg (as initial-height I32))
        (arg scale)
        (arg background)
      )
    )
  )
  (let surface-width initial-width)
  (let surface-height initial-height)
  (let scene (call DisplayScene scale background))
  (call (. root sync-native-geometry))
  (call (. scene maintain) root scale background)
  (call (. scene add-damage) (. root bounds))
  (call (. scene frame) surface)
  (call C:brixGuiWindowCommitFrame
    (block
      (arg native)
      (arg (. surface native))
      (arg (. scene last-frame-damage x))
      (arg (. scene last-frame-damage y))
      (arg (. scene last-frame-damage width))
      (arg (. scene last-frame-damage height))
    )
  )
  (blank)
  (let warmup-frames Size 3)
  (for (in warmup (..< 0 warmup-frames))
    (let sequence-index (+ warmup 1))
    (let width (call gui-resize-scale-width mode sequence-index))
    (let height (call gui-resize-scale-height mode sequence-index))
    (call (. root layout) (call Rect 0 0 (as width Coord) (as height Coord)))
    (if (or (!= width surface-width) (!= height surface-height))
      (call (. surface close))
      (= surface (call RasterCanvas (as width I32) (as height I32) scale background))
      (= surface-width width)
      (= surface-height height)
    )
    (call (. root sync-native-geometry))
    (call (. scene maintain) root scale background)
    (call (. scene add-damage) (. root bounds))
    (call (. scene frame) surface)
    (call C:brixGuiWindowCommitFrame
      (block
        (arg native)
        (arg (. surface native))
        (arg (. scene last-frame-damage x))
        (arg (. scene last-frame-damage y))
        (arg (. scene last-frame-damage width))
        (arg (. scene last-frame-damage height))
      )
    )
  )
  (blank)
  (let frames Size 120)
  (let total-ns (list U64))
  (let layout-ns (list U64))
  (let create-ns (list U64))
  (let sync-ns (list U64))
  (let paint-ns (list U64))
  (let commit-ns (list U64))
  (call (. total-ns reserve) frames)
  (call (. layout-ns reserve) frames)
  (call (. create-ns reserve) frames)
  (call (. sync-ns reserve) frames)
  (call (. paint-ns reserve) frames)
  (call (. commit-ns reserve) frames)
  (let allocated-objects Size)
  (let allocated-bytes Size)
  (let layout-objects Size)
  (let layout-bytes Size)
  (let paint-objects Size)
  (let paint-bytes Size)
  (let surface-recreates Size)
  (let misses-120hz Size)
  (let misses-60hz Size)
  (let text-layouts0 (call text-layout-created-count))
  (blank)
  (for (in frame (..< 0 frames))
    (let sequence-index (+ warmup-frames frame 1))
    (let width (call gui-resize-scale-width mode sequence-index))
    (let height (call gui-resize-scale-height mode sequence-index))
    (let objects0 (call C:brixGCAllocatedObjectCount))
    (let bytes0 (call C:brixGCRequestedByteCount))
    (let t0 (call monotonic-time-nanoseconds))
    (blank)
    (probe-group + gui.frame.phase.layout)
    (call (. root layout) (call Rect 0 0 (as width Coord) (as height Coord)))
    (probe-group - gui.frame.phase.layout)
    (let t1 (call monotonic-time-nanoseconds))
    (let objects1 (call C:brixGCAllocatedObjectCount))
    (let bytes1 (call C:brixGCRequestedByteCount))
    (blank)
    (probe-group + gui.frame.phase.create)
    (let surface-recreated (or (!= width surface-width) (!= height surface-height)))
    (if surface-recreated
      (call (. surface close))
      (= surface (call RasterCanvas (as width I32) (as height I32) scale background))
      (= surface-width width)
      (= surface-height height)
      (+= surface-recreates 1)
    )
    (probe-group - gui.frame.phase.create)
    (let t2 (call monotonic-time-nanoseconds))
    (blank)
    (probe-group + gui.frame.phase.sync)
    (call (. root sync-native-geometry))
    (probe-group - gui.frame.phase.sync)
    (let t3 (call monotonic-time-nanoseconds))
    (let objects3 (call C:brixGCAllocatedObjectCount))
    (let bytes3 (call C:brixGCRequestedByteCount))
    (blank)
    (probe-group + gui.frame.phase.paint)
    (call (. scene maintain) root scale background)
    (if surface-recreated
      (call (. scene add-damage) (. root bounds))
    )
    (let replay-count (. scene frames-replayed))
    (call (. scene frame) surface)
    (let did-replay (!= (. scene frames-replayed) replay-count))
    (probe-group - gui.frame.phase.paint)
    (let t4 (call monotonic-time-nanoseconds))
    (let objects4 (call C:brixGCAllocatedObjectCount))
    (let bytes4 (call C:brixGCRequestedByteCount))
    (blank)
    (probe-group + gui.frame.phase.commit)
    (if did-replay
      (call C:brixGuiWindowCommitFrame
        (block
          (arg native)
          (arg (. surface native))
          (arg (. scene last-frame-damage x))
          (arg (. scene last-frame-damage y))
          (arg (. scene last-frame-damage width))
          (arg (. scene last-frame-damage height))
        )
      )
    )
    (probe-group - gui.frame.phase.commit)
    (let t5 (call monotonic-time-nanoseconds))
    (blank)
    (let elapsed (- t5 t0))
    (+= total-ns elapsed)
    (+= layout-ns (- t1 t0))
    (+= create-ns (- t2 t1))
    (+= sync-ns (- t3 t2))
    (+= paint-ns (- t4 t3))
    (+= commit-ns (- t5 t4))
    (+= allocated-objects (as (- (call C:brixGCAllocatedObjectCount) objects0) Size))
    (+= allocated-bytes (as (- (call C:brixGCRequestedByteCount) bytes0) Size))
    (+= layout-objects (as (- objects1 objects0) Size))
    (+= layout-bytes (as (- bytes1 bytes0) Size))
    (+= paint-objects (as (- objects4 objects3) Size))
    (+= paint-bytes (as (- bytes4 bytes3) Size))
    (if (> elapsed 8333333)
      (+= misses-120hz 1)
    )
    (if (> elapsed 16666667)
      (+= misses-60hz 1)
    )
  )
  (blank)
  (let text-layouts (- (call text-layout-created-count) text-layouts0))
  (probe-count gui.bench.resize-scale.frames frames)
  (probe-count gui.bench.resize-scale.frame-p50-us (call gui-resize-scale-percentile-us total-ns 50))
  (probe-count gui.bench.resize-scale.frame-p95-us (call gui-resize-scale-percentile-us total-ns 95))
  (probe-count gui.bench.resize-scale.frame-p99-us (call gui-resize-scale-percentile-us total-ns 99))
  (probe-count gui.bench.resize-scale.layout-p50-us (call gui-resize-scale-percentile-us layout-ns 50))
  (probe-count gui.bench.resize-scale.layout-p95-us (call gui-resize-scale-percentile-us layout-ns 95))
  (probe-count gui.bench.resize-scale.layout-p99-us (call gui-resize-scale-percentile-us layout-ns 99))
  (probe-count gui.bench.resize-scale.create-p50-us (call gui-resize-scale-percentile-us create-ns 50))
  (probe-count gui.bench.resize-scale.create-p95-us (call gui-resize-scale-percentile-us create-ns 95))
  (probe-count gui.bench.resize-scale.create-p99-us (call gui-resize-scale-percentile-us create-ns 99))
  (probe-count gui.bench.resize-scale.sync-p50-us (call gui-resize-scale-percentile-us sync-ns 50))
  (probe-count gui.bench.resize-scale.sync-p95-us (call gui-resize-scale-percentile-us sync-ns 95))
  (probe-count gui.bench.resize-scale.sync-p99-us (call gui-resize-scale-percentile-us sync-ns 99))
  (probe-count gui.bench.resize-scale.paint-p50-us (call gui-resize-scale-percentile-us paint-ns 50))
  (probe-count gui.bench.resize-scale.paint-p95-us (call gui-resize-scale-percentile-us paint-ns 95))
  (probe-count gui.bench.resize-scale.paint-p99-us (call gui-resize-scale-percentile-us paint-ns 99))
  (probe-count gui.bench.resize-scale.commit-p50-us (call gui-resize-scale-percentile-us commit-ns 50))
  (probe-count gui.bench.resize-scale.commit-p95-us (call gui-resize-scale-percentile-us commit-ns 95))
  (probe-count gui.bench.resize-scale.commit-p99-us (call gui-resize-scale-percentile-us commit-ns 99))
  (probe-count gui.bench.resize-scale.misses-120hz misses-120hz)
  (probe-count gui.bench.resize-scale.misses-60hz misses-60hz)
  (probe-count gui.bench.resize-scale.objects-per-frame (/ allocated-objects frames))
  (probe-count gui.bench.resize-scale.bytes-per-frame (/ allocated-bytes frames))
  (probe-count gui.bench.resize-scale.layout-objects-per-frame (/ layout-objects frames))
  (probe-count gui.bench.resize-scale.layout-bytes-per-frame (/ layout-bytes frames))
  (probe-count gui.bench.resize-scale.paint-objects-per-frame (/ paint-objects frames))
  (probe-count gui.bench.resize-scale.paint-bytes-per-frame (/ paint-bytes frames))
  (probe-count gui.bench.resize-scale.surface-recreates surface-recreates)
  (probe-count gui.bench.resize-scale.text-layouts text-layouts)
  (blank)
  (let checksum (+ frames surface-recreates text-layouts misses-120hz misses-60hz))
  (+= checksum (call gui-resize-scale-percentile-us total-ns 50))
  (call (. scene close))
  (call (. surface close))
  (call C:brixGuiWindowClose native)
  (call C:brixGuiWindowRelease native)
  (call (. root close))
  (call markup-release root)
  (return checksum)
)

(fn-expr _ gui-resize-scale-width Size
  (param mode Size)
  (param frame Size)
  (case? (or (== mode 1) (== mode 3))
    1360
  )
  (default
    (+ 1120 (call gui-resize-scale-triangle frame 240 8))
  )
)

(fn-expr _ gui-resize-scale-height Size
  (param mode Size)
  (param frame Size)
  (case? (or (== mode 0) (== mode 3))
    860
  )
  (default
    (+ 700 (call gui-resize-scale-triangle frame 160 4))
  )
)

(fn-do _ gui-resize-scale-triangle Size
  (param frame Size)
  (param span Size)
  (param step Size)
  (let half-period (/ span step))
  (let position (% frame (* half-period 2)))
  (if (> position half-period)
    (= position (- (* half-period 2) position))
  )
  (return (* position step))
)

(fn-expr _ gui-resize-scale-percentile-us Size
  (param values (list U64))
  (param percentile Size)
  (case? (not values)
    0
  )
  (default
    (as (/ ([] sorted index) 1000) Size)
  )
  (where
    (lazy sorted (call sort values (:using (=> (left right) (if-expr (< left right) .lesser .greater)))))
    (lazy index (/ (* (- (. sorted length) 1) percentile) 100))
  )
)

(fn-do _ build-gui-resize-scale-root _
  (let root (call GUIResizeScaleRoot))
  (call markup-mount-root root root)
  (blank)
  (let header (call GUIResizeScaleHeader))
  (call markup-append root header)
  (let header-copy (call GUIResizeScaleFlexColumn))
  (call markup-append header header-copy)
  (call append-gui-resize-scale-label header-copy "Static Layout Scale · Resize Benchmark")
  (call append-gui-resize-scale-label
    (block
      (arg header-copy)
      (arg "1,000 cells · 480 rows + labels · deterministic frame sequence")
    )
  )
  (let tags (call GUIResizeScaleFlowRow))
  (call markup-append header tags)
  (call append-gui-resize-scale-pill tags "CORE GRAPHICS")
  (call append-gui-resize-scale-pill tags "STATIC")
  (call append-gui-resize-scale-pill tags "2,000+ BOXES")
  (blank)
  (let stats (call GUIResizeScaleStats))
  (call markup-append root stats)
  (call append-gui-resize-scale-stat stats "CELLS" "1,000")
  (call append-gui-resize-scale-stat stats "ROW BOXES" "480")
  (call append-gui-resize-scale-stat stats "ROW LABELS" "480")
  (call append-gui-resize-scale-stat stats "FRAME WORK" "RESIZE ONLY")
  (blank)
  (let main (call GUIResizeScaleMain))
  (call markup-append root main)
  (let left-panel (call GUIResizeScalePanel))
  (call markup-append main left-panel)
  (call append-gui-resize-scale-panel-header
    (block
      (arg left-panel)
      (arg "FIXED CELL MATRIX")
      (arg "40 × 25 physical cells inside flexible ancestors")
      (arg "1,025 GRID NODES")
    )
  )
  (let stage (call GUIResizeScaleStage))
  (call markup-append left-panel stage)
  (let grid (call GUIResizeScaleGrid))
  (call markup-append stage grid)
  (for (in row-index (..< 0 25))
    (let row (call GUIResizeScaleGridRow))
    (call markup-append grid row)
    (for (in column-index (..< 0 40))
      (call markup-append row (call GUIResizeScaleCell))
    )
  )
  (let districts (call GUIResizeScaleFlowRow))
  (call markup-append stage districts)
  (for (in district-index (..< 0 12))
    (call append-gui-resize-scale-pill
      (block
        (arg districts)
        (arg (call gui-resize-scale-district district-index))
      )
    )
  )
  (blank)
  (let right-panel (call GUIResizeScaleFeedPanel))
  (call markup-append main right-panel)
  (call append-gui-resize-scale-panel-header
    (block
      (arg right-panel)
      (arg "PHYSICAL INCIDENT FEED")
      (arg "480 row boxes · 480 retained text labels")
      (arg "960 FEED NODES")
    )
  )
  (let filter (call GUIResizeScaleFilter))
  (call markup-append right-panel filter)
  (call append-gui-resize-scale-label filter "Static filter chrome with intrinsic text")
  (call append-gui-resize-scale-pill filter "NO INPUT")
  (let note (call GUIResizeScaleNote))
  (call markup-append right-panel note)
  (call append-gui-resize-scale-label
    (block
      (arg note)
      (arg "No scroll, animation, mutation, or scheduled render work")
    )
  )
  (let feed (call GUIResizeScaleFeed))
  (call markup-append right-panel feed)
  (for (in index (..< 0 480))
    (call markup-append feed (call GUIResizeScaleFeedRow index))
  )
  (blank)
  (let footer (call GUIResizeScaleFooter))
  (call markup-append root footer)
  (call append-gui-resize-scale-pill footer "STATIC")
  (call append-gui-resize-scale-pill footer "NO TIMERS")
  (call append-gui-resize-scale-pill footer "NO MUTATIONS")
  (call append-gui-resize-scale-pill footer "NO AUTO-SCROLL")
  (call append-gui-resize-scale-label footer "Resize continuously across both axes")
  (blank)
  (call (. root markup-batch-queue checkpoint))
  (return root)
)

(fn-do _ append-gui-resize-scale-label _
  (param parent Box)
  (param value String)
  (let label (call GUIResizeScaleText))
  (= (. label text) value)
  (call markup-append parent label)
  (return label)
)

(fn-do _ append-gui-resize-scale-pill _
  (param parent Box)
  (param value String)
  (let pill (call GUIResizeScalePill))
  (= (. pill text) value)
  (call markup-append parent pill)
)

(fn-do _ append-gui-resize-scale-stat _
  (param parent Box)
  (param title String)
  (param value String)
  (let card (call GUIResizeScaleStat))
  (call markup-append parent card)
  (let copy (call GUIResizeScaleStatCopy))
  (call markup-append card copy)
  (call append-gui-resize-scale-label copy title)
  (call append-gui-resize-scale-label copy value)
  (let bars (call GUIResizeScaleBars))
  (call markup-append card bars)
  (call markup-append bars (call GUIResizeScaleBarA))
  (call markup-append bars (call GUIResizeScaleBarB))
  (call markup-append bars (call GUIResizeScaleBarC))
)

(fn-do _ append-gui-resize-scale-panel-header _
  (param parent Box)
  (param kicker String)
  (param title String)
  (param pill String)
  (let header (call GUIResizeScalePanelHeader))
  (call markup-append parent header)
  (let copy (call GUIResizeScaleFlexColumn))
  (call markup-append header copy)
  (call append-gui-resize-scale-label copy kicker)
  (call append-gui-resize-scale-label copy title)
  (call append-gui-resize-scale-pill header pill)
)

(fn-expr _ gui-resize-scale-district _
  (param index Size)
  (match (% index 8)
    (case 0
      "NORTH"
    )
    (case 1
      "HARBOR"
    )
    (case 2
      "MARKET"
    )
    (case 3
      "CIVIC"
    )
    (case 4
      "UNION"
    )
    (case 5
      "SOMA"
    )
    (case 6
      "MISSION"
    )
    (default
      "SUNSET"
    )
  )
)

(fn-expr _ gui-resize-scale-category _
  (param index Size)
  (match (% index 5)
    (case 0
      "FIRE"
    )
    (case 1
      "MEDICAL"
    )
    (case 2
      "TRAFFIC"
    )
    (case 3
      "TRANSIT"
    )
    (default
      "UTILITY"
    )
  )
)

(type + GUIResizeScaleRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (rule This (• flex-col) (• p 14) (• bg "#08111f"))
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(type + GUIResizeScaleHeader (is Box)
  (rule This (• flex-row) (• h 72) (• px 18) (• py 10) (• bg "#0f1d32") (• border))
)

(type + GUIResizeScaleFlexColumn (is Box)
  (rule This (• flex-col) (• flex 1))
)

(type + GUIResizeScaleFlowRow (is Box)
  (rule This (• flow-row))
)

(type + GUIResizeScaleText (is Label)
  (rule This (• text white)
    (= font-size 11)
  )
)

(type + GUIResizeScalePill (is Label)
  (rule This (• text white) (• bg "#12304a") (• border) (• px 8) (• py 5) (• ml 7)
    (= font-size 9)
  )
)

(type + GUIResizeScaleStats (is Box)
  (rule This (• flex-row) (• h 92) (• mt 12))
)

(type + GUIResizeScaleStat (is Box)
  (rule This (• flex-row) (• flex 1) (• p 12) (• ml 10) (• bg "#101f35") (• border))
)

(type + GUIResizeScaleStatCopy (is Box)
  (rule This (• flex-col) (• w 155))
)

(type + GUIResizeScaleBars (is Box)
  (rule This (• flex-row) (• flex 1) (• ml 10) (• h 14))
)

(type + GUIResizeScaleBarA (is Box)
  (rule This (• flex 3) (• bg "#14b8a6"))
)

(type + GUIResizeScaleBarB (is Box)
  (rule This (• flex 2) (• bg "#0ea5e9"))
)

(type + GUIResizeScaleBarC (is Box)
  (rule This (• flex 1) (• bg "#8b5cf6"))
)

(type + GUIResizeScaleMain (is Box)
  (rule This (• flex-row) (• flex 1) (• mt 12))
)

(type + GUIResizeScalePanel (is Box)
  (rule This (• flex-col) (• flex 1) (• p 12) (• bg "#0d192b") (• border))
)

(type + GUIResizeScaleFeedPanel (is Box)
  (rule This (• flex-col) (• w 432) (• ml 12) (• p 12) (• bg "#0d192b") (• border))
)

(type + GUIResizeScalePanelHeader (is Box)
  (rule This (• flex-row) (• h 40))
)

(type + GUIResizeScaleStage (is Box)
  (rule This (• flex-col) (• flex 1) (• mt 10) (• p 10) (• bg "#07101d") (• border))
)

(type + GUIResizeScaleGrid (is Box)
  (rule This (• flow-col) (• w 600) (• h 375))
)

(type + GUIResizeScaleGridRow (is Box)
  (rule This (• flow-row) (• w 600) (• h 15))
)

(type + GUIResizeScaleCell (is Box)
  (rule This (• w 15) (• h 15))
  (fn-do + paint-background _
    (param canvas Canvas)
    (call (. canvas push))
    (= (. canvas fill-color) "#0e7490")
    (= (. canvas stroke-color) null)
    (call (. canvas rect) bounds)
    (call (. canvas pop))
  )
)

(type + GUIResizeScaleFilter (is Box)
  (rule This (• flex-row) (• h 29) (• mt 9) (• px 9) (• bg "#101f35") (• border))
)

(type + GUIResizeScaleNote (is Box)
  (rule This (• flex-row) (• h 25) (• mt 7) (• px 8) (• bg "#0b1626") (• border))
)

(type + GUIResizeScaleFeed (is Box)
  (rule This (• flow-col) (• flex 1) (• mt 9) (• bg "#07101d") (• border)
    (= overflow-x (. ScrollOverflow clip))
    (= overflow-y (. ScrollOverflow auto))
    (= scroll-indicator-y (. ScrollIndicatorVisibility always))
    (= scroll-indicator-gutter (. ScrollIndicatorGutter stable))
  )
)

(type + GUIResizeScaleFeedRow (is Box)
  (prop + index Size)
  (blank)
  (rule This (• h 18))
  (fn-do + This _
    (param index _)
    (let label (call GUIResizeScaleFeedText))
    (let id (+ 10000 index))
    (let unit (+ 10 (% index 89)))
    (let category (call gui-resize-scale-category index))
    (let district (call gui-resize-scale-district index))
    (= (. label text) (str "#" id "  " category " · " district " · unit " unit))
    (call markup-append this label)
  )
  (fn-do + paint-background _
    (param canvas Canvas)
    (call (. canvas push))
    (match (% index 5)
      (case 0
        (= (. canvas fill-color) "#172554")
      )
      (case 1
        (= (. canvas fill-color) "#134e4a")
      )
      (case 2
        (= (. canvas fill-color) "#3f1d42")
      )
      (case 3
        (= (. canvas fill-color) "#3b2f12")
      )
      (default
        (= (. canvas fill-color) "#1e293b")
      )
    )
    (= (. canvas stroke-color) null)
    (call (. canvas rect) bounds)
    (call (. canvas pop))
  )
)

(type + GUIResizeScaleFeedText (is Label)
  (rule This (• absolute) (• cover .parent) (• px 5) (• text white)
    (= font-family "Menlo")
    (= font-size 10)
  )
)

(type + GUIResizeScaleFooter (is Box)
  (rule This (• flex-row) (• h 48) (• mt 12) (• px 12) (• py 8) (• bg "#0f1d32") (• border))
)
