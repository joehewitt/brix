    is MarkupBatch

+ source := VirtualRangeSource(gui-virtual-count)
+ virtual-layout := VerticalFixedLayout(gui-virtual-row-height)
+ markup-batch-queue := MarkupBatchQueue(this)
+ labeled = true

────────────────────

<This • flex-col
    <GuiVirtualBenchRegion region • flex:1
        source = #source
        virtual-layout = #virtual-layout
        overscan = VirtualInsets(72vcoord, 0vcoord, 72vcoord, 0vcoord)

        <GuiVirtualFrameRow (row) - slot
            address = slot.#address
            labeled = #labeled

────────────────────
+ do markup-batch-did-flush
    - flush MarkupBatchFlush

. ignored = flush.applied

━━━━━━━━━━━━━━━━━━━━
+ GuiVirtualFrameRow is Box

+ address I64
+ labeled = true

• This • flex-row
    background-color = if #address % 2 == 0 then "#e8eef7" else "#ffffff"

────────────────────

<This
    if #labeled
        <Label • flex:1
            text = "Row ${#address + 1}"

        <Label
            text = "${#address % 97}"
    else
        <Box • h:12 bg:"#2563eb" w:(gui-virtual-bar-width(#address))

━━━━━━━━━━━━━━━━━━━━
_ gui-virtual-bar-width
    - address I64

((address % 37) * 30 + 16) as Length
