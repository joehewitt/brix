    - region VirtualRegion'I64

//gui.virtual.pool.high-water += region.pool-size

━━━━━━━━━━━━━━━━━━━━
_ do assert-gui-virtual-no-growth
    - delta GuiVirtualStats
    - allocated-objects Size
    - layouts Size
    - scenario String

?! Panic("gui/virtual-fixed $scenario created a slot or root after prewarm")
    if delta.pool-created != 0 || delta.roots-created != 0
?! Panic("gui/virtual-fixed $scenario grew the reusable placement buffer after prewarm")
    if delta.placement-buffer-grows != 0
. budget = layouts * gui-virtual-layout-object-budget + bind-budget
    .. bind-budget = delta.source-binds * gui-virtual-bind-object-budget
?! Panic("gui/virtual-fixed $scenario allocated $allocated-objects objects, over its budget of $budget")
    if !gui-virtual-has-runtime-probes() && allocated-objects > budget

━━━━━━━━━━━━━━━━━━━━
_ gui-virtual-has-runtime-probes Bool

if probes then probes.size > 0 else false

.. probes = env("PROBES_ENABLED")

━━━━━━━━━━━━━━━━━━━━
_ gui-virtual-stats
    - region VirtualRegion'I64

GuiVirtualStats
    - recycler.pool-created
    - recycler.pool-high-water
    - region.roots-created
    - recycler.window-refreshes
    - recycler.placements-emitted
    - recycler.layout-addresses-inspected
    - recycler.rebinds
    - recycler.source-binds
    - recycler.departures
    - recycler.placement-buffer-grows
    - recycler.stale-commits

.. recycler = region.stats

━━━━━━━━━━━━━━━━━━━━
_ gui-virtual-stats-delta
    - opening GuiVirtualStats
    - closing GuiVirtualStats

GuiVirtualStats
    - closing.pool-created - opening.pool-created
    - closing.pool-high-water - opening.pool-high-water
    - closing.roots-created - opening.roots-created
    - closing.window-refreshes - opening.window-refreshes
    - closing.placements-emitted - opening.placements-emitted
    - closing.layout-addresses-inspected - opening.layout-addresses-inspected
    - closing.rebinds - opening.rebinds
    - closing.source-binds - opening.source-binds
    - closing.departures - opening.departures
    - closing.placement-buffer-grows - opening.placement-buffer-grows
    - closing.stale-commits - opening.stale-commits

━━━━━━━━━━━━━━━━━━━━
_ do gui-virtual-checksum Size
    - delta GuiVirtualStats
    - allocated-objects Size
    - allocated-bytes Size

. checksum = delta.window-refreshes * 3 + delta.placements-emitted * 5
checksum += delta.source-binds * 7 + delta.rebinds * 11
checksum += allocated-objects * 13 + allocated-bytes * 17
= checksum

━━━━━━━━━━━━━━━━━━━━
+ GuiVirtualBenchRegion is VirtualRegion'I64

• This
    scroll-indicator-x = ScrollIndicatorVisibility.hidden
    scroll-indicator-y = ScrollIndicatorVisibility.hidden

━━━━━━━━━━━━━━━━━━━━
+ GuiVirtualKernelRoot is Box
    is MarkupBatch

+ source := VirtualRangeSource(gui-virtual-count)
+ virtual-layout := VerticalFixedLayout(gui-virtual-row-height)
+ markup-batch-queue := MarkupBatchQueue(this)

────────────────────

<This • flex-col
    <GuiVirtualBenchRegion region • flex:1
        source = #source
        virtual-layout = #virtual-layout
        overscan = VirtualInsets(72vcoord, 0vcoord, 72vcoord, 0vcoord)

        <GuiVirtualKernelRow (row) - slot
            item = slot.#item

────────────────────
+ do markup-batch-did-flush
    - flush MarkupBatchFlush

. ignored = flush.applied

