_ gui-virtual-count VirtualCoord = 1000000000vcoord
_ gui-virtual-row-height VirtualCoord = 24vcoord
_ gui-virtual-opening-scroll F64 = 24001
_ gui-virtual-width F64 = 1200
_ gui-virtual-height F64 = 480
_ gui-virtual-tall-height F64 = 960
_ gui-virtual-window-rows Size = 0
_ gui-virtual-pool-high-water Size = 0
_ gui-virtual-layout-object-budget Size = 8
_ gui-virtual-bind-object-budget Size = 4
_ gui-virtual-live-slack Size = 4096

━━━━━━━━━━━━━━━━━━━━
+ GuiVirtualStats is Tuple

+ pool-created Size
+ pool-high-water Size
+ roots-created Size
+ window-refreshes Size
+ placements-emitted Size
+ layout-addresses-inspected Size
+ rebinds Size
+ source-binds Size
+ departures Size
+ placement-buffer-grows Size
+ stale-commits Size

━━━━━━━━━━━━━━━━━━━━
+ do run-gui-virtual-stable-window

. root = prepare-gui-virtual-kernel()
run-gui-virtual-held-steps(root, 2)
. held-before = gui-virtual-stats(root.region)
. held-objects-before = C:yumiGCAllocatedObjectCount()
. held-bytes-before = C:yumiGCAllocatedByteCount()
run-gui-virtual-held-steps(root, 4096)
. held-objects = (C:yumiGCAllocatedObjectCount() - held-objects-before) as Size
. held-bytes = (C:yumiGCAllocatedByteCount() - held-bytes-before) as Size
. held = gui-virtual-stats-delta(held-before, gui-virtual-stats(root.region))
emit-gui-virtual-stats(held, held-objects, held-bytes)
assert-gui-virtual-no-growth(held, held-objects, 0, "stable-window held")
?! Panic("gui/virtual-fixed-stable-window refreshed its window while scrolling inside it")
    if held.window-refreshes != 0 || held.source-binds != 0 || held.rebinds != 0

run-gui-virtual-refresh-steps(root, 2)
. refresh-before = gui-virtual-stats(root.region)
. refresh-objects-before = C:yumiGCAllocatedObjectCount()
. refresh-bytes-before = C:yumiGCAllocatedByteCount()
run-gui-virtual-refresh-steps(root, 4096)
. refresh-objects = (C:yumiGCAllocatedObjectCount() - refresh-objects-before) as Size
. refresh-bytes = (C:yumiGCAllocatedByteCount() - refresh-bytes-before) as Size
. refreshed = gui-virtual-stats-delta(refresh-before, gui-virtual-stats(root.region))
emit-gui-virtual-stats(refreshed, refresh-objects, refresh-bytes)
emit-gui-virtual-high-water(root.region)
assert-gui-virtual-no-growth(refreshed, refresh-objects, 4096, "stable-window refresh")
?! Panic("gui/virtual-fixed-stable-window rebound an unchanged placement window")
    if refreshed.source-binds != 0 || refreshed.rebinds != 0
. expected-placements = 4096 * gui-virtual-window-rows
?! Panic("gui/virtual-fixed-stable-window produced unexpected refresh or placement counts")
    if refreshed.window-refreshes != 4096 || refreshed.placements-emitted != expected-placements

. checksum = gui-virtual-checksum(held, held-objects, held-bytes)
checksum += gui-virtual-checksum(refreshed, refresh-objects, refresh-bytes)
release-gui-virtual-kernel(root)
= checksum

━━━━━━━━━━━━━━━━━━━━
_ do run-gui-virtual-held-steps
    - root GuiVirtualKernelRoot
    - count Size

. step Size = 0
while step < count
    . y = if step % 2 == 0 then gui-virtual-opening-scroll else gui-virtual-opening-scroll + 10.5
    gui-virtual-scroll-step(root, y)
    step += 1

━━━━━━━━━━━━━━━━━━━━
_ do run-gui-virtual-refresh-steps
    - root GuiVirtualKernelRoot
    - count Size

. step Size = 0
while step < count
    . y = if step % 2 == 0 then gui-virtual-opening-scroll else gui-virtual-opening-scroll + 1
    root.region.scroll-to(Point(0, y))
    root.region.invalidate-bindings()
    root.update-layout()
    step += 1

━━━━━━━━━━━━━━━━━━━━
+ do run-gui-virtual-adjacent-scroll

. root = prepare-gui-virtual-kernel()
run-gui-virtual-adjacent-steps(root, gui-virtual-opening-scroll, gui-virtual-window-rows)
gui-virtual-scroll-step(root, gui-virtual-opening-scroll)
. start-stats = gui-virtual-stats(root.region)
. objects-before = C:yumiGCAllocatedObjectCount()
. bytes-before = C:yumiGCAllocatedByteCount()
run-gui-virtual-adjacent-steps(root, gui-virtual-opening-scroll, 4096)
. allocated-objects = (C:yumiGCAllocatedObjectCount() - objects-before) as Size
. allocated-bytes = (C:yumiGCAllocatedByteCount() - bytes-before) as Size
. delta = gui-virtual-stats-delta(start-stats, gui-virtual-stats(root.region))
emit-gui-virtual-stats(delta, allocated-objects, allocated-bytes)
emit-gui-virtual-high-water(root.region)
assert-gui-virtual-no-growth(delta, allocated-objects, 4096, "adjacent-scroll")
?! Panic("gui/virtual-fixed-adjacent-scroll did not rotate exactly one slot per row")
    if delta.source-binds != 4096 || delta.rebinds != 4096 || delta.window-refreshes != 4096
?! Panic("gui/virtual-fixed-adjacent-scroll changed the prewarmed pool high-water")
    if root.region.pool-size != gui-virtual-pool-high-water

. checksum = gui-virtual-checksum(delta, allocated-objects, allocated-bytes)
release-gui-virtual-kernel(root)
= checksum

━━━━━━━━━━━━━━━━━━━━
_ do run-gui-virtual-adjacent-steps
    - root GuiVirtualKernelRoot
    - opening-scroll F64
    - count Size

. step Size = 0
. y = opening-scroll
while step < count
    y += gui-virtual-length(gui-virtual-row-height)
    gui-virtual-scroll-step(root, y)
    step += 1

━━━━━━━━━━━━━━━━━━━━
+ do run-gui-virtual-jump-ladder

. root = prepare-gui-virtual-kernel()
run-gui-virtual-jump-steps(root, 1)
gui-virtual-scroll-step(root, gui-virtual-row-scroll(42000))
. start-stats = gui-virtual-stats(root.region)
. objects-before = C:yumiGCAllocatedObjectCount()
. bytes-before = C:yumiGCAllocatedByteCount()
run-gui-virtual-jump-steps(root, 256)
. allocated-objects = (C:yumiGCAllocatedObjectCount() - objects-before) as Size
. allocated-bytes = (C:yumiGCAllocatedByteCount() - bytes-before) as Size
. delta = gui-virtual-stats-delta(start-stats, gui-virtual-stats(root.region))
emit-gui-virtual-stats(delta, allocated-objects, allocated-bytes)
emit-gui-virtual-high-water(root.region)
assert-gui-virtual-no-growth(delta, allocated-objects, 1024, "jump-ladder")
. jumped-rows = 1024 * gui-virtual-window-rows
?! Panic("gui/virtual-fixed-jump-ladder refresh count was distance-dependent")
    if delta.window-refreshes != 1024
?! Panic("gui/virtual-fixed-jump-ladder did not bind exactly one window per jump")
    if delta.source-binds != jumped-rows || delta.rebinds != jumped-rows
?! Panic("gui/virtual-fixed-jump-ladder emitted or inspected more than one window per jump")
    if delta.placements-emitted != jumped-rows || delta.layout-addresses-inspected != jumped-rows

. checksum = gui-virtual-checksum(delta, allocated-objects, allocated-bytes)
release-gui-virtual-kernel(root)
= checksum

━━━━━━━━━━━━━━━━━━━━
_ do run-gui-virtual-jump-steps
    - root GuiVirtualKernelRoot
    - count Size

. cycle Size = 0
while cycle < count
    gui-virtual-scroll-step(root, gui-virtual-row-scroll(1000))
    . near-anchor = root.region.virtual-anchor.y
    gui-virtual-scroll-step(root, gui-virtual-row-scroll(1000000))
    gui-virtual-scroll-step(root, gui-virtual-row-scroll(500000000))
    gui-virtual-scroll-step(root, gui-virtual-row-scroll(999999970))
    ?! Panic("gui/virtual-fixed-jump-ladder kept a distant anchor")
        if root.region.virtual-anchor.y == near-anchor
    cycle += 1

━━━━━━━━━━━━━━━━━━━━
+ do run-gui-virtual-lifetime Size

. root = prepare-gui-virtual-kernel()
. opening-revision = root.source.revision.value
C:yumiCollect()
C:yumiCollect()
. opening-live-bytes = C:yumiGCLiveByteCount()
. checksum = run-gui-virtual-lifetime-phases(root)

root.source.revision.value = opening-revision
gui-virtual-scroll-step(root, gui-virtual-opening-scroll)
root.layout(Rect(0, 0, gui-virtual-width, gui-virtual-height))
C:yumiCollect()
C:yumiCollect()
. final-live-bytes = C:yumiGCLiveByteCount()
//gui.virtual.lifetime.opening-live-bytes += opening-live-bytes
//gui.virtual.lifetime.final-live-bytes += final-live-bytes
. live-byte-limit = opening-live-bytes + gui-virtual-live-slack
?! Panic("gui/virtual-fixed-lifetime live memory grew from $opening-live-bytes to $final-live-bytes, beyond its unpainted dirty-list slack")
    if !gui-virtual-has-runtime-probes() && final-live-bytes > live-byte-limit
?! Panic("gui/virtual-fixed-lifetime exceeded the prewarmed pool capacity")
    if root.region.pool-size != gui-virtual-pool-high-water

release-gui-virtual-kernel(root)
= (checksum + final-live-bytes) as Size

━━━━━━━━━━━━━━━━━━━━
_ do run-gui-virtual-lifetime-phases
    - root GuiVirtualKernelRoot

run-gui-virtual-resize-steps(root, 2)
. checksum Size = 0

. resize-before = gui-virtual-stats(root.region)
. resize-objects-before = C:yumiGCAllocatedObjectCount()
. resize-bytes-before = C:yumiGCAllocatedByteCount()
run-gui-virtual-resize-steps(root, 256)
. resize-objects = (C:yumiGCAllocatedObjectCount() - resize-objects-before) as Size
. resize-bytes = (C:yumiGCAllocatedByteCount() - resize-bytes-before) as Size
. resize-delta = gui-virtual-stats-delta(resize-before, gui-virtual-stats(root.region))
emit-gui-virtual-stats(resize-delta, resize-objects, resize-bytes)
assert-gui-virtual-no-growth(resize-delta, resize-objects, 512, "lifetime-resize")
checksum += gui-virtual-checksum(resize-delta, resize-objects, resize-bytes)

run-gui-virtual-revision-steps(root, 2)
. revision-before = gui-virtual-stats(root.region)
. revision-objects-before = C:yumiGCAllocatedObjectCount()
. revision-bytes-before = C:yumiGCAllocatedByteCount()
run-gui-virtual-revision-steps(root, 256)
. revision-objects = (C:yumiGCAllocatedObjectCount() - revision-objects-before) as Size
. revision-bytes = (C:yumiGCAllocatedByteCount() - revision-bytes-before) as Size
. revision-delta = gui-virtual-stats-delta(revision-before, gui-virtual-stats(root.region))
emit-gui-virtual-stats(revision-delta, revision-objects, revision-bytes)
assert-gui-virtual-no-growth(revision-delta, revision-objects, 256, "lifetime-revision")
?! Panic("gui/virtual-fixed-lifetime revision reset bound more than one active window")
    if revision-delta.source-binds > 256 * gui-virtual-window-rows
checksum += gui-virtual-checksum(revision-delta, revision-objects, revision-bytes)

run-gui-virtual-adjacent-steps(root, gui-virtual-opening-scroll, gui-virtual-window-rows)
gui-virtual-scroll-step(root, gui-virtual-opening-scroll)
. adjacent-before = gui-virtual-stats(root.region)
. adjacent-objects-before = C:yumiGCAllocatedObjectCount()
. adjacent-bytes-before = C:yumiGCAllocatedByteCount()
run-gui-virtual-adjacent-steps(root, gui-virtual-opening-scroll, 65536)
. adjacent-objects = (C:yumiGCAllocatedObjectCount() - adjacent-objects-before) as Size
. adjacent-bytes = (C:yumiGCAllocatedByteCount() - adjacent-bytes-before) as Size
. adjacent-delta = gui-virtual-stats-delta(adjacent-before, gui-virtual-stats(root.region))
emit-gui-virtual-stats(adjacent-delta, adjacent-objects, adjacent-bytes)
assert-gui-virtual-no-growth(adjacent-delta, adjacent-objects, 65536, "lifetime-adjacent")
?! Panic("gui/virtual-fixed-lifetime adjacent phase did not bind exactly one entering row")
    if adjacent-delta.source-binds != 65536 || adjacent-delta.rebinds != 65536
checksum += gui-virtual-checksum(adjacent-delta, adjacent-objects, adjacent-bytes)
emit-gui-virtual-high-water(root.region)

= checksum

━━━━━━━━━━━━━━━━━━━━
_ do run-gui-virtual-resize-steps
    - root GuiVirtualKernelRoot
    - count Size

. cycle Size = 0
while cycle < count
    root.layout(Rect(0, 0, gui-virtual-width, gui-virtual-tall-height))
    root.layout(Rect(0, 0, gui-virtual-width, gui-virtual-height))
    cycle += 1

━━━━━━━━━━━━━━━━━━━━
_ do run-gui-virtual-revision-steps
    - root GuiVirtualKernelRoot
    - count Size

. cycle Size = 0
while cycle < count
    root.source.bump-revision()
    root.update-layout()
    cycle += 1

━━━━━━━━━━━━━━━━━━━━
_ do prepare-gui-virtual-kernel

. root = GuiVirtualKernelRoot()
markup-mount-root(root, root)
root.markup-batch-queue.checkpoint()
root.layout(Rect(0, 0, gui-virtual-width, gui-virtual-height))
gui-virtual-scroll-step(root, gui-virtual-opening-scroll)
gui-virtual-window-rows = gui-virtual-window-placements(root)
root.layout(Rect(0, 0, gui-virtual-width, gui-virtual-tall-height))
root.layout(Rect(0, 0, gui-virtual-width, gui-virtual-height))
gui-virtual-scroll-step(root, gui-virtual-opening-scroll + 1)
gui-virtual-scroll-step(root, gui-virtual-opening-scroll)
gui-virtual-pool-high-water = root.region.pool-size
?! Panic("gui virtual kernel did not bind a full window before measuring")
    if gui-virtual-window-rows == 0
= root

━━━━━━━━━━━━━━━━━━━━
_ do release-gui-virtual-kernel
    - root GuiVirtualKernelRoot

root.close()
markup-release(root)

━━━━━━━━━━━━━━━━━━━━
_ do gui-virtual-window-placements Size
    - root GuiVirtualKernelRoot

. start-stats = root.region.stats
root.region.invalidate-bindings()
root.update-layout()
= root.region.stats.placements-emitted - start-stats.placements-emitted

━━━━━━━━━━━━━━━━━━━━
_ do gui-virtual-scroll-step
    - root Box
    - y F64

. region = gui-virtual-region-of(root)
region.scroll-to(Point(0, y))
root.update-layout()

━━━━━━━━━━━━━━━━━━━━
_ gui-virtual-region-of VirtualRegion'I64
    - root Box

|? root is GuiVirtualFrameRoot
    (root as GuiVirtualFrameRoot).region
??
    (root as GuiVirtualKernelRoot).region

━━━━━━━━━━━━━━━━━━━━
_ gui-virtual-row-scroll
    - address I64

(address * 24 + 1) as F64

━━━━━━━━━━━━━━━━━━━━
_ gui-virtual-length
    - value VirtualCoord

(value as I64) as F64

━━━━━━━━━━━━━━━━━━━━
+ do run-gui-virtual-fixed-frame

. root = GuiVirtualFrameRoot()
markup-mount-root(root, root)
root.markup-batch-queue.checkpoint()
root.layout(Rect(0, 0, gui-virtual-width, gui-virtual-height))
. scene = DisplayScene(2, white)
. canvas = RasterCanvas(1200, 480, 2, white)
. held [U64]
. crossing [U64]
. jumps [U64]
held.reserve(64)
crossing.reserve(256)
jumps.reserve(64)
. checksum Size
do use canvas
    gui-virtual-scroll-step(root, gui-virtual-opening-scroll)
    scene.build(root)
    scene.commit()
    scene.frame(canvas)
    . y = gui-virtual-opening-scroll
    for warmup in 0 .. < 32
        y += 24
        . ignored = gui-virtual-frame(root, scene, canvas, y)
    . opening = gui-virtual-stats(root.region)

    scene.reset-frame-counters()
    . held-before = gui-virtual-stats(root.region)
    for frame in 0 .. < 64
        . offset = ((frame % 16) as F64) * 0.625
        held += gui-virtual-frame(root, scene, canvas, y + offset)
    . held-rebuilt = scene.chunks-rebuilt
    . held-delta = gui-virtual-stats-delta(held-before, gui-virtual-stats(root.region))
    ?! Panic("gui/virtual-fixed-frame refreshed its window during held scroll frames")
        if held-delta.window-refreshes != 0 || held-delta.source-binds != 0

    scene.reset-frame-counters()
    . crossing-before = gui-virtual-stats(root.region)
    for frame in 0 .. < 256
        y += 24
        crossing += gui-virtual-frame(root, scene, canvas, y)
    . crossing-rebuilt = scene.chunks-rebuilt
    . crossing-delta = gui-virtual-stats-delta(crossing-before, gui-virtual-stats(root.region))
    ?! Panic("gui/virtual-fixed-frame did not bind exactly one row per crossing frame")
        if crossing-delta.source-binds != 256

    y += 24
    root.region.scroll-to(Point(0, y))
    . objects0 = C:yumiGCAllocatedObjectCount()
    . bytes0 = C:yumiGCRequestedByteCount()
    root.update-layout()
    scene.update(root)
    scene.commit()
    scene.frame(canvas)
    . frame-objects = (C:yumiGCAllocatedObjectCount() - objects0) as Size
    . frame-bytes = (C:yumiGCRequestedByteCount() - bytes0) as Size

    scene.reset-frame-counters()
    . jump-before = gui-virtual-stats(root.region)
    for frame in 0 .. < 64
        . address = gui-virtual-jump-address(frame)
        jumps += gui-virtual-frame(root, scene, canvas, gui-virtual-row-scroll(address) + 0.5)
    . jump-rebuilt = scene.chunks-rebuilt
    . jump-delta = gui-virtual-stats-delta(jump-before, gui-virtual-stats(root.region))

    //gui.virtual.frame.held-p50-ns += gui-virtual-percentile(held, 50)
    //gui.virtual.frame.held-p95-ns += gui-virtual-percentile(held, 95)
    //gui.virtual.frame.held-rebuilt-chunks += held-rebuilt
    //gui.virtual.frame.crossing-p50-ns += gui-virtual-percentile(crossing, 50)
    //gui.virtual.frame.crossing-p95-ns += gui-virtual-percentile(crossing, 95)
    //gui.virtual.frame.crossing-rebuilt-chunks += crossing-rebuilt
    //gui.virtual.frame.crossing-objects += frame-objects
    //gui.virtual.frame.crossing-bytes += frame-bytes
    //gui.virtual.frame.jump-p50-ns += gui-virtual-percentile(jumps, 50)
    //gui.virtual.frame.jump-p95-ns += gui-virtual-percentile(jumps, 95)
    //gui.virtual.frame.jump-rebuilt-chunks += jump-rebuilt
    //gui.virtual.frame.jump-binds += jump-delta.source-binds
    emit-gui-virtual-stats
        - gui-virtual-stats-delta(opening, gui-virtual-stats(root.region))
        - frame-objects
        - frame-bytes
    emit-gui-virtual-high-water(root.region)
    checksum = held-rebuilt + crossing-rebuilt + jump-rebuilt
    checksum += crossing-delta.source-binds + jump-delta.source-binds

scene.close()
root.close()
markup-release(root)
= checksum

━━━━━━━━━━━━━━━━━━━━
_ do gui-virtual-frame
    - root GuiVirtualFrameRoot
    - scene DisplayScene
    - canvas RasterCanvas
    - y F64

. started = monotonic-time-nanoseconds()
root.region.scroll-to(Point(0, y))
root.update-layout()
scene.update(root)
scene.commit()
scene.frame(canvas)
= monotonic-time-nanoseconds() - started

━━━━━━━━━━━━━━━━━━━━
_ gui-virtual-jump-address I64
    - frame Size

match frame % 4
    |= 0
        1000
    |= 1
        1000000
    |= 2
        500000000
    ??
        999999970

━━━━━━━━━━━━━━━━━━━━
+ do run-gui-metal-virtual-scroll

. root = GuiVirtualFrameRoot()
root.labeled = false
markup-mount-root(root, root)
root.markup-batch-queue.checkpoint()
root.layout(Rect(0, 0, gui-virtual-width, gui-virtual-height))
. scene = DisplayScene(2, white)
. renderer = MetalOffscreenRenderer(1200, 480, 2, white)
. reference = RasterCanvas(1200, 480, 2, white)
. elapsed [U64]
elapsed.reserve(60)
. y = gui-virtual-row-scroll(500000000) + 0.25
. maximum-chunks Size
. rebuilt-chunks Size
. checksum Size
do use renderer
    do use reference
        gui-virtual-scroll-step(root, y)
        scene.build(root)
        scene.commit()
        scene.frame-metal(renderer)
        for warmup in 0 .. < 12
            y += 10.25
            gui-virtual-metal-frame(root, scene, renderer, y)
        renderer.finish()

        . start-stats = gui-virtual-stats(root.region)
        for frame in 0 .. < 60
            y += 10.25
            scene.reset-frame-counters()
            . started = monotonic-time-nanoseconds()
            gui-virtual-metal-frame(root, scene, renderer, y)
            elapsed += monotonic-time-nanoseconds() - started
            if scene.chunks-encoded > maximum-chunks
                maximum-chunks = scene.chunks-encoded
            rebuilt-chunks += scene.chunks-rebuilt
        renderer.finish()
        . delta = gui-virtual-stats-delta(start-stats, gui-virtual-stats(root.region))

        renderer.mark-renderer-allocations()
        y += 10.25
        root.region.scroll-to(Point(0, y))
        scene.reset-frame-counters()
        . objects0 = C:yumiGCAllocatedObjectCount()
        root.update-layout()
        scene.update(root)
        scene.commit()
        scene.frame-metal(renderer)
        . objects = (C:yumiGCAllocatedObjectCount() - objects0) as Size
        renderer.finish()
        reference.erase(white)
        root.paint(reference)
        . diff = renderer.diff(reference)
        ?! Panic("gui/metal-virtual-scroll diverged from the CoreGraphics oracle in ${diff.differing-pixels} pixels")
            if diff.differing-pixels != 0
        . anchor-distance = (root.region.content-offset.y * 1000) as U64
        //gui.bench.metal.virtual-scroll-p50-ns += gui-virtual-percentile(elapsed, 50)
        //gui.bench.metal.virtual-scroll-p99-ns += gui-virtual-percentile(elapsed, 99)
        //gui.bench.metal.virtual-scroll-chunks += maximum-chunks
        //gui.bench.metal.virtual-scroll-rebuilt-chunks += rebuilt-chunks
        //gui.bench.metal.virtual-scroll-binds += delta.source-binds
        //gui.bench.metal.virtual-scroll-objects += objects
        //gui.bench.metal.virtual-scroll-renderer-allocations += renderer.renderer-allocations
        //gui.bench.metal.virtual-scroll-differing-pixels += diff.differing-pixels
        //gui.bench.metal.virtual-scroll-max-delta += diff.maximum-channel-delta
        //gui.bench.metal.virtual-scroll-offset-milli += anchor-distance
        checksum = maximum-chunks + rebuilt-chunks + delta.source-binds

scene.close()
root.close()
markup-release(root)
= checksum

━━━━━━━━━━━━━━━━━━━━
_ do gui-virtual-metal-frame
    - root GuiVirtualFrameRoot
    - scene DisplayScene
    - renderer MetalOffscreenRenderer
    - y F64

root.region.scroll-to(Point(0, y))
root.update-layout()
scene.update(root)
scene.commit()
scene.frame-metal(renderer)

━━━━━━━━━━━━━━━━━━━━
_ gui-virtual-percentile U64
    - values [U64]
    - percentile Size

|? !values
    0
??
    sorted[index]

.. sorted = sort(values) • using :: left, right => if left < right then .lesser else .greater
.. index = ((sorted.length - 1) * percentile) / 100

