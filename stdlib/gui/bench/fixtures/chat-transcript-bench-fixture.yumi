+ chat-bench-long-turns Size = 150
+ chat-bench-visited-turns Size = 40
+ chat-bench-wheel-step Length = 120

━━━━━━━━━━━━━━━━━━━━
+ ChatTranscriptBench

+ window ChatTranscriptBenchWindow
+ scene DisplayScene
+ canvas RasterCanvas
+ chat AIChatSession
+ blank AIChatSession

────────────────────
+ This
    - turns Size

.. window = ChatTranscriptBenchWindow()
window.open()
window.layout()
scene = DisplayScene(2, black)
canvas = RasterCanvas(1080, 760, 2, black)
blank = window.store.active
add-chat-bench-turn(blank, "Hello", "Hi. What would you like to talk about?")
chat = window.store.new-session()
fill-chat-bench-session(chat, turns)
window.store.select(blank)
scene.build(window)
scene.commit()
scene.frame(canvas)
frame()

────────────────────
+ get scroller Box

chat-bench-find-transcript(window)!.rows

────────────────────
+ do show Size
    - session AIChatSession

window.store.select(session)
= frame()

────────────────────
+ do frame Size

. queue = window.markup-batch-root!.markup-batch-queue
queue.checkpoint()
. checkpoints Size = 1
while queue.actions && checkpoints < 64
    queue.checkpoint()
    checkpoints += 1
window.layout()
scene.update(window)
scene.commit()
scene.frame(canvas)
= 1

────────────────────
+ do scroll Size
    - delta Length

. ignored = scroller.scroll-by(Point(0, delta), ScrollCause.wheel)
= frame()

────────────────────
+ do visit Size
    - step Length

. checksum Size
while scroller.scroll-y > 0
    checksum += scroll(-step)
while scroller.scroll-y < scroller.scroll-max.y
    checksum += scroll(step)
= checksum

────────────────────
+ do sweep Size
    - distance Length
    - step Length

. checksum Size
. travelled Length = 0
while travelled < distance
    checksum += scroll(-step)
    travelled += step
travelled = 0
while travelled < distance
    checksum += scroll(step)
    travelled += step
= checksum

────────────────────
+ do close

scene.close()
canvas.close()
window.close()

━━━━━━━━━━━━━━━━━━━━
+ do fill-chat-bench-session
    - session AIChatSession
    - turns Size

for turn in 0 .. < turns
    add-chat-bench-turn
        - session
        - "Question ${turn + 1}: how does part ${turn % 7 + 1} of the system behave under load?"
        - chat-bench-reply(turn)

━━━━━━━━━━━━━━━━━━━━
+ do add-chat-bench-turn
    - session AIChatSession
    - prompt String
    - reply String

session.begin-turn(prompt)
append-chat-bench-reply(session, reply)
session.finish-reply()

━━━━━━━━━━━━━━━━━━━━
+ do append-chat-bench-reply
    - session AIChatSession
    - text String

if session.reply!.parts.length
    session.apply-event(AIPartDeltaEvent("text", AITextDelta(text)))
else
    session.apply-event(AIPartBeginEvent(AITextPart("text", text)))

━━━━━━━━━━━━━━━━━━━━
+ chat-bench-reply
    - turn Size

match turn % 4
    | 0
        chat-bench-document(turn)
    | 1
        "Short answer for turn ${turn + 1}: it holds steady, and the queue drains within a few **milliseconds**."
    | 2
        chat-bench-steps(turn)
    ??
        chat-bench-table(turn)

━━━━━━━━━━━━━━━━━━━━
_ chat-bench-document
    - turn Size

"\n".join
    * "## Behaviour under load, part ${turn % 7 + 1}"
    * ""
    * "The scheduler keeps a *bounded* run queue per worker, so a burst of work spreads across workers instead of piling onto one. Each worker steals from its neighbours only when its own queue is empty, which keeps `steal` rare in the steady state."
    * ""
    * "### What changes as load rises"
    * ""
    * "- Queue depth grows until the **high-water mark** is reached"
    * "- New work is then admitted at the rate old work completes"
    * "- Latency rises smoothly rather than falling off a cliff"
    * ""
    * "1. Measure the baseline with one worker"
    * "2. Double the workers until throughput stops scaling"
    * "3. Record the point where latency doubles"
    * ""
    * "```yumi"
    * "+ admitted"
    * "    - depth Size"
    * "    - limit Size"
    * ""
    * "depth < limit"
    * "```"
    * ""
    * "| Workers | Throughput | Latency |"
    * "| :-- | --: | --: |"
    * "| 1 | 1,200 | 4 ms |"
    * "| 4 | 4,500 | 5 ms |"
    * "| 16 | 14,000 | 9 ms |"
    * ""
    * "> Past sixteen workers the shared allocator becomes the limit, not the scheduler."
    * ""
    * "In short, the system degrades gracefully: throughput flattens, latency climbs slowly, and nothing is dropped."

━━━━━━━━━━━━━━━━━━━━
_ chat-bench-steps
    - turn Size

"\n".join
    * "There are three things to check for turn ${turn + 1}:"
    * ""
    * "1. Whether the queue depth stays under the limit"
    * "2. Whether any worker is starved for longer than a tick"
    * "3. Whether `steal` shows up in the profile at all"
    * ""
    * "```"
    * "depth=${turn * 3 + 12} limit=256 starved=0"
    * "```"
    * ""
    * "If all three look healthy, the part is behaving as designed and no tuning is needed."

━━━━━━━━━━━━━━━━━━━━
_ chat-bench-table
    - turn Size

"\n".join
    * "Here is the summary for turn ${turn + 1}."
    * ""
    * "| Metric | Before | After |"
    * "| :-- | --: | --: |"
    * "| Queue depth | ${turn + 40} | ${turn + 12} |"
    * "| Steals per second | 310 | 18 |"
    * ""
    * "The second column is what you should expect once the limit is in place. The first is what an *unbounded* queue looks like under the same burst."

━━━━━━━━━━━━━━━━━━━━
_ chat-bench-find-transcript ChatTranscript?
    - node GuiNode

if node is ChatTranscript then node as ChatTranscript else nested

.. nested =
    ** node.children
    ?*> chat-bench-find-transcript(each)
    |> first

━━━━━━━━━━━━━━━━━━━━
+ ChatTranscriptBenchWindow is Window

+ store = AIChatStore([AIChatService("bench", "Bench", AIProvider(), "bench-model")])
+ caches := ChatBlockCaches()
+ branchings := ChatBranchings()
+ active-branching = branchings.branching(#store.#active)

────────────────────

<This • flex-row
    title = "Chat"
    size = Dimensions(1080, 760)

    <ChatSidebar • w:260
        store = #store
        branching = #active-branching
    <Box • flex-col flex:1
        for session in [#store.#active] keyed by session.id
            <ChatWorkspace • flex:1
                branching = branchings.branching(session)
                services = #store.#services
                caches = caches

