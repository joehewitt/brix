(import /BxGC/BxGC.h)
(import /core/markup)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/point)
(import /graphics/primitives)
(import /gui/box)
(import /gui/label)
(import /gui/metal)
(import /gui/primitives)
(import /gui/scene)
(import /gui/virtual)
(import /os/env)
(import /stream/sort)
(import /time/timer)
(import /ui/virtual)
(import /ui/virtual-layout)
(import /ui/virtual-recycler)
(blank)
(prop _ gui-virtual-count VirtualCoord (= 1000000000vcoord))
(prop _ gui-virtual-row-height VirtualCoord (= 24vcoord))
(prop _ gui-virtual-opening-scroll F64 (= 24001))
(prop _ gui-virtual-width F64 (= 1200))
(prop _ gui-virtual-height F64 (= 480))
(prop _ gui-virtual-tall-height F64 (= 960))
(prop _ gui-virtual-window-rows Size (= 0))
(prop _ gui-virtual-pool-high-water Size (= 0))
(prop _ gui-virtual-layout-object-budget Size (= 8))
(prop _ gui-virtual-bind-object-budget Size (= 4))
(prop _ gui-virtual-live-slack Size (= 4096))

(type + GuiVirtualStats (is Tuple)
  (prop + pool-created Size)
  (prop + pool-high-water Size)
  (prop + roots-created Size)
  (prop + window-refreshes Size)
  (prop + placements-emitted Size)
  (prop + layout-addresses-inspected Size)
  (prop + rebinds Size)
  (prop + source-binds Size)
  (prop + departures Size)
  (prop + placement-buffer-grows Size)
  (prop + stale-commits Size)
)

(fn-do + run-gui-virtual-stable-window _
  (let root (call prepare-gui-virtual-kernel))
  (call run-gui-virtual-held-steps root 2)
  (let held-before (call gui-virtual-stats (. root region)))
  (let held-objects-before (call C:brixGCAllocatedObjectCount))
  (let held-bytes-before (call C:brixGCAllocatedByteCount))
  (call run-gui-virtual-held-steps root 4096)
  (let held-objects (as (- (call C:brixGCAllocatedObjectCount) held-objects-before) Size))
  (let held-bytes (as (- (call C:brixGCAllocatedByteCount) held-bytes-before) Size))
  (let held (call gui-virtual-stats-delta held-before (call gui-virtual-stats (. root region))))
  (call emit-gui-virtual-stats held held-objects held-bytes)
  (call assert-gui-virtual-no-growth held held-objects 0 "stable-window held")
  (throw (call Panic "gui/virtual-fixed-stable-window refreshed its window while scrolling inside it") (if (or (!= (. held window-refreshes) 0) (!= (. held source-binds) 0) (!= (. held rebinds) 0))))
  (blank)
  (call run-gui-virtual-refresh-steps root 2)
  (let refresh-before (call gui-virtual-stats (. root region)))
  (let refresh-objects-before (call C:brixGCAllocatedObjectCount))
  (let refresh-bytes-before (call C:brixGCAllocatedByteCount))
  (call run-gui-virtual-refresh-steps root 4096)
  (let refresh-objects (as (- (call C:brixGCAllocatedObjectCount) refresh-objects-before) Size))
  (let refresh-bytes (as (- (call C:brixGCAllocatedByteCount) refresh-bytes-before) Size))
  (let refreshed (call gui-virtual-stats-delta refresh-before (call gui-virtual-stats (. root region))))
  (call emit-gui-virtual-stats refreshed refresh-objects refresh-bytes)
  (call emit-gui-virtual-high-water (. root region))
  (call assert-gui-virtual-no-growth refreshed refresh-objects 4096 "stable-window refresh")
  (throw (call Panic "gui/virtual-fixed-stable-window rebound an unchanged placement window") (if (or (!= (. refreshed source-binds) 0) (!= (. refreshed rebinds) 0))))
  (let expected-placements (* 4096 gui-virtual-window-rows))
  (throw (call Panic "gui/virtual-fixed-stable-window produced unexpected refresh or placement counts") (if (or (!= (. refreshed window-refreshes) 4096) (!= (. refreshed placements-emitted) expected-placements))))
  (blank)
  (let checksum (call gui-virtual-checksum held held-objects held-bytes))
  (+= checksum (call gui-virtual-checksum refreshed refresh-objects refresh-bytes))
  (call release-gui-virtual-kernel root)
  (return checksum)
)

(fn-do _ run-gui-virtual-held-steps _
  (param root GuiVirtualKernelRoot)
  (param count Size)
  (let step Size 0)
  (while (< step count)
    (let y (if-expr (== (% step 2) 0) gui-virtual-opening-scroll (+ gui-virtual-opening-scroll 10.5)))
    (call gui-virtual-scroll-step root y)
    (+= step 1)
  )
)

(fn-do _ run-gui-virtual-refresh-steps _
  (param root GuiVirtualKernelRoot)
  (param count Size)
  (let step Size 0)
  (while (< step count)
    (let y (if-expr (== (% step 2) 0) gui-virtual-opening-scroll (+ gui-virtual-opening-scroll 1)))
    (call (. root region scroll-to) (call Point 0 y))
    (call (. root region invalidate-bindings))
    (call (. root update-layout))
    (+= step 1)
  )
)

(fn-do + run-gui-virtual-adjacent-scroll _
  (let root (call prepare-gui-virtual-kernel))
  (call run-gui-virtual-adjacent-steps root gui-virtual-opening-scroll gui-virtual-window-rows)
  (call gui-virtual-scroll-step root gui-virtual-opening-scroll)
  (let start-stats (call gui-virtual-stats (. root region)))
  (let objects-before (call C:brixGCAllocatedObjectCount))
  (let bytes-before (call C:brixGCAllocatedByteCount))
  (call run-gui-virtual-adjacent-steps root gui-virtual-opening-scroll 4096)
  (let allocated-objects (as (- (call C:brixGCAllocatedObjectCount) objects-before) Size))
  (let allocated-bytes (as (- (call C:brixGCAllocatedByteCount) bytes-before) Size))
  (let delta (call gui-virtual-stats-delta start-stats (call gui-virtual-stats (. root region))))
  (call emit-gui-virtual-stats delta allocated-objects allocated-bytes)
  (call emit-gui-virtual-high-water (. root region))
  (call assert-gui-virtual-no-growth delta allocated-objects 4096 "adjacent-scroll")
  (throw (call Panic "gui/virtual-fixed-adjacent-scroll did not rotate exactly one slot per row") (if (or (!= (. delta source-binds) 4096) (!= (. delta rebinds) 4096) (!= (. delta window-refreshes) 4096))))
  (throw (call Panic "gui/virtual-fixed-adjacent-scroll changed the prewarmed pool high-water") (if (!= (. root region pool-size) gui-virtual-pool-high-water)))
  (blank)
  (let checksum (call gui-virtual-checksum delta allocated-objects allocated-bytes))
  (call release-gui-virtual-kernel root)
  (return checksum)
)

(fn-do _ run-gui-virtual-adjacent-steps _
  (param root GuiVirtualKernelRoot)
  (param opening-scroll F64)
  (param count Size)
  (let step Size 0)
  (let y opening-scroll)
  (while (< step count)
    (+= y (call gui-virtual-length gui-virtual-row-height))
    (call gui-virtual-scroll-step root y)
    (+= step 1)
  )
)

(fn-do + run-gui-virtual-jump-ladder _
  (let root (call prepare-gui-virtual-kernel))
  (call run-gui-virtual-jump-steps root 1)
  (call gui-virtual-scroll-step root (call gui-virtual-row-scroll 42000))
  (let start-stats (call gui-virtual-stats (. root region)))
  (let objects-before (call C:brixGCAllocatedObjectCount))
  (let bytes-before (call C:brixGCAllocatedByteCount))
  (call run-gui-virtual-jump-steps root 256)
  (let allocated-objects (as (- (call C:brixGCAllocatedObjectCount) objects-before) Size))
  (let allocated-bytes (as (- (call C:brixGCAllocatedByteCount) bytes-before) Size))
  (let delta (call gui-virtual-stats-delta start-stats (call gui-virtual-stats (. root region))))
  (call emit-gui-virtual-stats delta allocated-objects allocated-bytes)
  (call emit-gui-virtual-high-water (. root region))
  (call assert-gui-virtual-no-growth delta allocated-objects 1024 "jump-ladder")
  (let jumped-rows (* 1024 gui-virtual-window-rows))
  (throw (call Panic "gui/virtual-fixed-jump-ladder refresh count was distance-dependent") (if (!= (. delta window-refreshes) 1024)))
  (throw (call Panic "gui/virtual-fixed-jump-ladder did not bind exactly one window per jump") (if (or (!= (. delta source-binds) jumped-rows) (!= (. delta rebinds) jumped-rows))))
  (throw (call Panic "gui/virtual-fixed-jump-ladder emitted or inspected more than one window per jump") (if (or (!= (. delta placements-emitted) jumped-rows) (!= (. delta layout-addresses-inspected) jumped-rows))))
  (blank)
  (let checksum (call gui-virtual-checksum delta allocated-objects allocated-bytes))
  (call release-gui-virtual-kernel root)
  (return checksum)
)

(fn-do _ run-gui-virtual-jump-steps _
  (param root GuiVirtualKernelRoot)
  (param count Size)
  (let cycle Size 0)
  (while (< cycle count)
    (call gui-virtual-scroll-step root (call gui-virtual-row-scroll 1000))
    (let near-anchor (. root region virtual-anchor y))
    (call gui-virtual-scroll-step root (call gui-virtual-row-scroll 1000000))
    (call gui-virtual-scroll-step root (call gui-virtual-row-scroll 500000000))
    (call gui-virtual-scroll-step root (call gui-virtual-row-scroll 999999970))
    (throw (call Panic "gui/virtual-fixed-jump-ladder kept a distant anchor") (if (== (. root region virtual-anchor y) near-anchor)))
    (+= cycle 1)
  )
)

(fn-do + run-gui-virtual-lifetime Size
  (let root (call prepare-gui-virtual-kernel))
  (let opening-revision (. root source revision value))
  (call C:brixCollect)
  (call C:brixCollect)
  (let opening-live-bytes (call C:brixGCLiveByteCount))
  (let checksum (call run-gui-virtual-lifetime-phases root))
  (blank)
  (= (. root source revision value) opening-revision)
  (call gui-virtual-scroll-step root gui-virtual-opening-scroll)
  (call (. root layout) (call Rect 0 0 gui-virtual-width gui-virtual-height))
  (call C:brixCollect)
  (call C:brixCollect)
  (let final-live-bytes (call C:brixGCLiveByteCount))
  (probe-count gui.virtual.lifetime.opening-live-bytes opening-live-bytes)
  (probe-count gui.virtual.lifetime.final-live-bytes final-live-bytes)
  (let live-byte-limit (+ opening-live-bytes gui-virtual-live-slack))
  (throw (call Panic (str "gui/virtual-fixed-lifetime live memory grew from " opening-live-bytes " to " final-live-bytes ", beyond its unpainted dirty-list slack")) (if (and (not (call gui-virtual-has-runtime-probes)) (> final-live-bytes live-byte-limit))))
  (throw (call Panic "gui/virtual-fixed-lifetime exceeded the prewarmed pool capacity") (if (!= (. root region pool-size) gui-virtual-pool-high-water)))
  (blank)
  (call release-gui-virtual-kernel root)
  (return (as (+ checksum final-live-bytes) Size))
)

(fn-do _ run-gui-virtual-lifetime-phases _
  (param root GuiVirtualKernelRoot)
  (call run-gui-virtual-resize-steps root 2)
  (let checksum Size 0)
  (blank)
  (let resize-before (call gui-virtual-stats (. root region)))
  (let resize-objects-before (call C:brixGCAllocatedObjectCount))
  (let resize-bytes-before (call C:brixGCAllocatedByteCount))
  (call run-gui-virtual-resize-steps root 256)
  (let resize-objects (as (- (call C:brixGCAllocatedObjectCount) resize-objects-before) Size))
  (let resize-bytes (as (- (call C:brixGCAllocatedByteCount) resize-bytes-before) Size))
  (let resize-delta (call gui-virtual-stats-delta resize-before (call gui-virtual-stats (. root region))))
  (call emit-gui-virtual-stats resize-delta resize-objects resize-bytes)
  (call assert-gui-virtual-no-growth resize-delta resize-objects 512 "lifetime-resize")
  (+= checksum (call gui-virtual-checksum resize-delta resize-objects resize-bytes))
  (blank)
  (call run-gui-virtual-revision-steps root 2)
  (let revision-before (call gui-virtual-stats (. root region)))
  (let revision-objects-before (call C:brixGCAllocatedObjectCount))
  (let revision-bytes-before (call C:brixGCAllocatedByteCount))
  (call run-gui-virtual-revision-steps root 256)
  (let revision-objects (as (- (call C:brixGCAllocatedObjectCount) revision-objects-before) Size))
  (let revision-bytes (as (- (call C:brixGCAllocatedByteCount) revision-bytes-before) Size))
  (let revision-delta (call gui-virtual-stats-delta revision-before (call gui-virtual-stats (. root region))))
  (call emit-gui-virtual-stats revision-delta revision-objects revision-bytes)
  (call assert-gui-virtual-no-growth revision-delta revision-objects 256 "lifetime-revision")
  (throw (call Panic "gui/virtual-fixed-lifetime revision reset bound more than one active window") (if (> (. revision-delta source-binds) (* 256 gui-virtual-window-rows))))
  (+= checksum (call gui-virtual-checksum revision-delta revision-objects revision-bytes))
  (blank)
  (call run-gui-virtual-adjacent-steps root gui-virtual-opening-scroll gui-virtual-window-rows)
  (call gui-virtual-scroll-step root gui-virtual-opening-scroll)
  (let adjacent-before (call gui-virtual-stats (. root region)))
  (let adjacent-objects-before (call C:brixGCAllocatedObjectCount))
  (let adjacent-bytes-before (call C:brixGCAllocatedByteCount))
  (call run-gui-virtual-adjacent-steps root gui-virtual-opening-scroll 65536)
  (let adjacent-objects (as (- (call C:brixGCAllocatedObjectCount) adjacent-objects-before) Size))
  (let adjacent-bytes (as (- (call C:brixGCAllocatedByteCount) adjacent-bytes-before) Size))
  (let adjacent-delta (call gui-virtual-stats-delta adjacent-before (call gui-virtual-stats (. root region))))
  (call emit-gui-virtual-stats adjacent-delta adjacent-objects adjacent-bytes)
  (call assert-gui-virtual-no-growth adjacent-delta adjacent-objects 65536 "lifetime-adjacent")
  (throw (call Panic "gui/virtual-fixed-lifetime adjacent phase did not bind exactly one entering row") (if (or (!= (. adjacent-delta source-binds) 65536) (!= (. adjacent-delta rebinds) 65536))))
  (+= checksum (call gui-virtual-checksum adjacent-delta adjacent-objects adjacent-bytes))
  (call emit-gui-virtual-high-water (. root region))
  (blank)
  (return checksum)
)

(fn-do _ run-gui-virtual-resize-steps _
  (param root GuiVirtualKernelRoot)
  (param count Size)
  (let cycle Size 0)
  (while (< cycle count)
    (call (. root layout) (call Rect 0 0 gui-virtual-width gui-virtual-tall-height))
    (call (. root layout) (call Rect 0 0 gui-virtual-width gui-virtual-height))
    (+= cycle 1)
  )
)

(fn-do _ run-gui-virtual-revision-steps _
  (param root GuiVirtualKernelRoot)
  (param count Size)
  (let cycle Size 0)
  (while (< cycle count)
    (call (. root source bump-revision))
    (call (. root update-layout))
    (+= cycle 1)
  )
)

(fn-do _ prepare-gui-virtual-kernel _
  (let root (call GuiVirtualKernelRoot))
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (call (. root layout) (call Rect 0 0 gui-virtual-width gui-virtual-height))
  (call gui-virtual-scroll-step root gui-virtual-opening-scroll)
  (= gui-virtual-window-rows (call gui-virtual-window-placements root))
  (call (. root layout) (call Rect 0 0 gui-virtual-width gui-virtual-tall-height))
  (call (. root layout) (call Rect 0 0 gui-virtual-width gui-virtual-height))
  (call gui-virtual-scroll-step root (+ gui-virtual-opening-scroll 1))
  (call gui-virtual-scroll-step root gui-virtual-opening-scroll)
  (= gui-virtual-pool-high-water (. root region pool-size))
  (throw (call Panic "gui virtual kernel did not bind a full window before measuring") (if (== gui-virtual-window-rows 0)))
  (return root)
)

(fn-do _ release-gui-virtual-kernel _
  (param root GuiVirtualKernelRoot)
  (call (. root close))
  (call markup-release root)
)

(fn-do _ gui-virtual-window-placements Size
  (param root GuiVirtualKernelRoot)
  (let start-stats (. root region stats))
  (call (. root region invalidate-bindings))
  (call (. root update-layout))
  (return (- (. root region stats placements-emitted) (. start-stats placements-emitted)))
)

(fn-do _ gui-virtual-scroll-step _
  (param root Box)
  (param y F64)
  (let region (call gui-virtual-region-of root))
  (call (. region scroll-to) (call Point 0 y))
  (call (. root update-layout))
)

(fn-expr _ gui-virtual-region-of (of VirtualRegion I64)
  (param root Box)
  (case? (is root GuiVirtualFrameRoot)
    (. (as root GuiVirtualFrameRoot) region)
  )
  (default
    (. (as root GuiVirtualKernelRoot) region)
  )
)

(fn-expr _ gui-virtual-row-scroll _
  (param address I64)
  (as (+ (* address 24) 1) F64)
)

(fn-expr _ gui-virtual-length _
  (param value VirtualCoord)
  (as (as value I64) F64)
)

(fn-do + run-gui-virtual-fixed-frame _
  (let root (call GuiVirtualFrameRoot))
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (call (. root layout) (call Rect 0 0 gui-virtual-width gui-virtual-height))
  (let scene (call DisplayScene 2 white))
  (let canvas (call RasterCanvas 1200 480 2 white))
  (let held (list U64))
  (let crossing (list U64))
  (let jumps (list U64))
  (call (. held reserve) 64)
  (call (. crossing reserve) 256)
  (call (. jumps reserve) 64)
  (let checksum Size)
  (do-use canvas
    (call gui-virtual-scroll-step root gui-virtual-opening-scroll)
    (call (. scene build) root)
    (call (. scene commit))
    (call (. scene frame) canvas)
    (let y gui-virtual-opening-scroll)
    (for (in warmup (..< 0 32))
      (+= y 24)
      (let ignored (call gui-virtual-frame root scene canvas y))
    )
    (let opening (call gui-virtual-stats (. root region)))
    (blank)
    (call (. scene reset-frame-counters))
    (let held-before (call gui-virtual-stats (. root region)))
    (for (in frame (..< 0 64))
      (let offset (* (as (% frame 16) F64) 0.625))
      (+= held (call gui-virtual-frame root scene canvas (+ y offset)))
    )
    (let held-rebuilt (. scene chunks-rebuilt))
    (let held-delta (call gui-virtual-stats-delta held-before (call gui-virtual-stats (. root region))))
    (throw (call Panic "gui/virtual-fixed-frame refreshed its window during held scroll frames") (if (or (!= (. held-delta window-refreshes) 0) (!= (. held-delta source-binds) 0))))
    (blank)
    (call (. scene reset-frame-counters))
    (let crossing-before (call gui-virtual-stats (. root region)))
    (for (in frame (..< 0 256))
      (+= y 24)
      (+= crossing (call gui-virtual-frame root scene canvas y))
    )
    (let crossing-rebuilt (. scene chunks-rebuilt))
    (let crossing-delta (call gui-virtual-stats-delta crossing-before (call gui-virtual-stats (. root region))))
    (throw (call Panic "gui/virtual-fixed-frame did not bind exactly one row per crossing frame") (if (!= (. crossing-delta source-binds) 256)))
    (blank)
    (+= y 24)
    (call (. root region scroll-to) (call Point 0 y))
    (let objects0 (call C:brixGCAllocatedObjectCount))
    (let bytes0 (call C:brixGCRequestedByteCount))
    (call (. root update-layout))
    (call (. scene update) root)
    (call (. scene commit))
    (call (. scene frame) canvas)
    (let frame-objects (as (- (call C:brixGCAllocatedObjectCount) objects0) Size))
    (let frame-bytes (as (- (call C:brixGCRequestedByteCount) bytes0) Size))
    (blank)
    (call (. scene reset-frame-counters))
    (let jump-before (call gui-virtual-stats (. root region)))
    (for (in frame (..< 0 64))
      (let address (call gui-virtual-jump-address frame))
      (+= jumps (call gui-virtual-frame root scene canvas (+ (call gui-virtual-row-scroll address) 0.5)))
    )
    (let jump-rebuilt (. scene chunks-rebuilt))
    (let jump-delta (call gui-virtual-stats-delta jump-before (call gui-virtual-stats (. root region))))
    (blank)
    (probe-count gui.virtual.frame.held-p50-ns (call gui-virtual-percentile held 50))
    (probe-count gui.virtual.frame.held-p95-ns (call gui-virtual-percentile held 95))
    (probe-count gui.virtual.frame.held-rebuilt-chunks held-rebuilt)
    (probe-count gui.virtual.frame.crossing-p50-ns (call gui-virtual-percentile crossing 50))
    (probe-count gui.virtual.frame.crossing-p95-ns (call gui-virtual-percentile crossing 95))
    (probe-count gui.virtual.frame.crossing-rebuilt-chunks crossing-rebuilt)
    (probe-count gui.virtual.frame.crossing-objects frame-objects)
    (probe-count gui.virtual.frame.crossing-bytes frame-bytes)
    (probe-count gui.virtual.frame.jump-p50-ns (call gui-virtual-percentile jumps 50))
    (probe-count gui.virtual.frame.jump-p95-ns (call gui-virtual-percentile jumps 95))
    (probe-count gui.virtual.frame.jump-rebuilt-chunks jump-rebuilt)
    (probe-count gui.virtual.frame.jump-binds (. jump-delta source-binds))
    (call emit-gui-virtual-stats
      (block
        (arg (call gui-virtual-stats-delta opening (call gui-virtual-stats (. root region))))
        (arg frame-objects)
        (arg frame-bytes)
      )
    )
    (call emit-gui-virtual-high-water (. root region))
    (= checksum (+ held-rebuilt crossing-rebuilt jump-rebuilt))
    (+= checksum (+ (. crossing-delta source-binds) (. jump-delta source-binds)))
  )
  (blank)
  (call (. scene close))
  (call (. root close))
  (call markup-release root)
  (return checksum)
)

(fn-do _ gui-virtual-frame _
  (param root GuiVirtualFrameRoot)
  (param scene DisplayScene)
  (param canvas RasterCanvas)
  (param y F64)
  (let started (call monotonic-time-nanoseconds))
  (call (. root region scroll-to) (call Point 0 y))
  (call (. root update-layout))
  (call (. scene update) root)
  (call (. scene commit))
  (call (. scene frame) canvas)
  (return (- (call monotonic-time-nanoseconds) started))
)

(fn-expr _ gui-virtual-jump-address I64
  (param frame Size)
  (match (% frame 4)
    (case= 0
      1000
    )
    (case= 1
      1000000
    )
    (case= 2
      500000000
    )
    (default
      999999970
    )
  )
)

(fn-do + run-gui-metal-virtual-scroll _
  (let root (call GuiVirtualFrameRoot))
  (= (. root labeled) false)
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (call (. root layout) (call Rect 0 0 gui-virtual-width gui-virtual-height))
  (let scene (call DisplayScene 2 white))
  (let renderer (call MetalOffscreenRenderer 1200 480 2 white))
  (let reference (call RasterCanvas 1200 480 2 white))
  (let elapsed (list U64))
  (call (. elapsed reserve) 60)
  (let y (+ (call gui-virtual-row-scroll 500000000) 0.25))
  (let maximum-chunks Size)
  (let rebuilt-chunks Size)
  (let checksum Size)
  (do-use renderer
    (do-use reference
      (call gui-virtual-scroll-step root y)
      (call (. scene build) root)
      (call (. scene commit))
      (call (. scene frame-metal) renderer)
      (for (in warmup (..< 0 12))
        (+= y 10.25)
        (call gui-virtual-metal-frame root scene renderer y)
      )
      (call (. renderer finish))
      (blank)
      (let start-stats (call gui-virtual-stats (. root region)))
      (for (in frame (..< 0 60))
        (+= y 10.25)
        (call (. scene reset-frame-counters))
        (let started (call monotonic-time-nanoseconds))
        (call gui-virtual-metal-frame root scene renderer y)
        (+= elapsed (- (call monotonic-time-nanoseconds) started))
        (if (> (. scene chunks-encoded) maximum-chunks)
          (= maximum-chunks (. scene chunks-encoded))
        )
        (+= rebuilt-chunks (. scene chunks-rebuilt))
      )
      (call (. renderer finish))
      (let delta (call gui-virtual-stats-delta start-stats (call gui-virtual-stats (. root region))))
      (blank)
      (call (. renderer mark-renderer-allocations))
      (+= y 10.25)
      (call (. root region scroll-to) (call Point 0 y))
      (call (. scene reset-frame-counters))
      (let objects0 (call C:brixGCAllocatedObjectCount))
      (call (. root update-layout))
      (call (. scene update) root)
      (call (. scene commit))
      (call (. scene frame-metal) renderer)
      (let objects (as (- (call C:brixGCAllocatedObjectCount) objects0) Size))
      (call (. renderer finish))
      (call (. reference erase) white)
      (call (. root paint) reference)
      (let diff (call (. renderer diff) reference))
      (throw (call Panic (str "gui/metal-virtual-scroll diverged from the CoreGraphics oracle in " (. diff differing-pixels) " pixels")) (if (!= (. diff differing-pixels) 0)))
      (let anchor-distance (as (* (. root region content-offset y) 1000) U64))
      (probe-count gui.bench.metal.virtual-scroll-p50-ns (call gui-virtual-percentile elapsed 50))
      (probe-count gui.bench.metal.virtual-scroll-p99-ns (call gui-virtual-percentile elapsed 99))
      (probe-count gui.bench.metal.virtual-scroll-chunks maximum-chunks)
      (probe-count gui.bench.metal.virtual-scroll-rebuilt-chunks rebuilt-chunks)
      (probe-count gui.bench.metal.virtual-scroll-binds (. delta source-binds))
      (probe-count gui.bench.metal.virtual-scroll-objects objects)
      (probe-count gui.bench.metal.virtual-scroll-renderer-allocations (. renderer renderer-allocations))
      (probe-count gui.bench.metal.virtual-scroll-differing-pixels (. diff differing-pixels))
      (probe-count gui.bench.metal.virtual-scroll-max-delta (. diff maximum-channel-delta))
      (probe-count gui.bench.metal.virtual-scroll-offset-milli anchor-distance)
      (= checksum (+ maximum-chunks rebuilt-chunks (. delta source-binds)))
    )
  )
  (blank)
  (call (. scene close))
  (call (. root close))
  (call markup-release root)
  (return checksum)
)

(fn-do _ gui-virtual-metal-frame _
  (param root GuiVirtualFrameRoot)
  (param scene DisplayScene)
  (param renderer MetalOffscreenRenderer)
  (param y F64)
  (call (. root region scroll-to) (call Point 0 y))
  (call (. root update-layout))
  (call (. scene update) root)
  (call (. scene commit))
  (call (. scene frame-metal) renderer)
)

(fn-expr _ gui-virtual-percentile U64
  (param values (list U64))
  (param percentile Size)
  (case? (not values)
    0
  )
  (default
    ([] sorted index)
  )
  (where
    (lazy sorted (call sort values (:using (=> (left right) (if-expr (< left right) .lesser .greater)))))
    (lazy index (/ (* (- (. sorted length) 1) percentile) 100))
  )
)

(fn-do _ emit-gui-virtual-stats _
  (param delta GuiVirtualStats)
  (param allocated-objects Size)
  (param allocated-bytes Size)
  (probe-count gui.virtual.pool.created (. delta pool-created))
  (probe-count gui.virtual.roots.created (. delta roots-created))
  (probe-count gui.virtual.window.refreshes (. delta window-refreshes))
  (probe-count gui.virtual.placements.emitted (. delta placements-emitted))
  (probe-count gui.virtual.layout.addresses-inspected (. delta layout-addresses-inspected))
  (probe-count gui.virtual.rebinds (. delta rebinds))
  (probe-count gui.virtual.source.binds (. delta source-binds))
  (probe-count gui.virtual.departures (. delta departures))
  (probe-count gui.virtual.placement-buffer-grows (. delta placement-buffer-grows))
  (probe-count gui.virtual.stale-commits (. delta stale-commits))
  (probe-count gui.virtual.objects allocated-objects)
  (probe-count gui.virtual.bytes allocated-bytes)
)

(fn-do _ emit-gui-virtual-high-water _
  (param region (of VirtualRegion I64))
  (probe-count gui.virtual.pool.high-water (. region pool-size))
)

(fn-do _ assert-gui-virtual-no-growth _
  (param delta GuiVirtualStats)
  (param allocated-objects Size)
  (param layouts Size)
  (param scenario String)
  (throw (call Panic (str "gui/virtual-fixed " scenario " created a slot or root after prewarm")) (if (or (!= (. delta pool-created) 0) (!= (. delta roots-created) 0))))
  (throw (call Panic (str "gui/virtual-fixed " scenario " grew the reusable placement buffer after prewarm")) (if (!= (. delta placement-buffer-grows) 0)))
  (let budget
    (scope (+ (* layouts gui-virtual-layout-object-budget) bind-budget)
      (lazy bind-budget (* (. delta source-binds) gui-virtual-bind-object-budget))
    )
  )
  (throw (call Panic (str "gui/virtual-fixed " scenario " allocated " allocated-objects " objects, over its budget of " budget)) (if (and (not (call gui-virtual-has-runtime-probes)) (> allocated-objects budget))))
)

(fn-expr _ gui-virtual-has-runtime-probes Bool
  (if-expr probes (> (. probes size) 0) false)
  (where
    (lazy probes (call env "PROBES_ENABLED"))
  )
)

(fn-expr _ gui-virtual-stats _
  (param region (of VirtualRegion I64))
  (call GuiVirtualStats
    (block
      (arg (. recycler pool-created))
      (arg (. recycler pool-high-water))
      (arg (. region roots-created))
      (arg (. recycler window-refreshes))
      (arg (. recycler placements-emitted))
      (arg (. recycler layout-addresses-inspected))
      (arg (. recycler rebinds))
      (arg (. recycler source-binds))
      (arg (. recycler departures))
      (arg (. recycler placement-buffer-grows))
      (arg (. recycler stale-commits))
    )
  )
  (where
    (lazy recycler (. region stats))
  )
)

(fn-expr _ gui-virtual-stats-delta _
  (param opening GuiVirtualStats)
  (param closing GuiVirtualStats)
  (call GuiVirtualStats
    (block
      (arg (- (. closing pool-created) (. opening pool-created)))
      (arg (- (. closing pool-high-water) (. opening pool-high-water)))
      (arg (- (. closing roots-created) (. opening roots-created)))
      (arg (- (. closing window-refreshes) (. opening window-refreshes)))
      (arg (- (. closing placements-emitted) (. opening placements-emitted)))
      (arg (- (. closing layout-addresses-inspected) (. opening layout-addresses-inspected)))
      (arg (- (. closing rebinds) (. opening rebinds)))
      (arg (- (. closing source-binds) (. opening source-binds)))
      (arg (- (. closing departures) (. opening departures)))
      (arg (- (. closing placement-buffer-grows) (. opening placement-buffer-grows)))
      (arg (- (. closing stale-commits) (. opening stale-commits)))
    )
  )
)

(fn-do _ gui-virtual-checksum Size
  (param delta GuiVirtualStats)
  (param allocated-objects Size)
  (param allocated-bytes Size)
  (let checksum (+ (* (. delta window-refreshes) 3) (* (. delta placements-emitted) 5)))
  (+= checksum (+ (* (. delta source-binds) 7) (* (. delta rebinds) 11)))
  (+= checksum (+ (* allocated-objects 13) (* allocated-bytes 17)))
  (return checksum)
)

(type + GuiVirtualBenchRegion (is (of VirtualRegion I64))
  (rule This
    (= scroll-indicator-x (. ScrollIndicatorVisibility hidden))
    (= scroll-indicator-y (. ScrollIndicatorVisibility hidden))
  )
)

(type + GuiVirtualKernelRoot (is Box)
  (implements MarkupRootElement)
  (prop + source _ (:= (call VirtualRangeSource gui-virtual-count)))
  (prop + virtual-layout _ (:= (call VerticalFixedLayout gui-virtual-row-height)))
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (content
    (<> This (• flex-col)
      (<> GuiVirtualBenchRegion (id: region) (• flex 1)
        (= source #source)
        (= virtual-layout #virtual-layout)
        (= overscan (call VirtualInsets 72vcoord 0vcoord 72vcoord 0vcoord))
        (blank)
        (<> GuiVirtualKernelRow (slot: row) (param: slot)
          (= item (. slot #item))
        )
      )
    )
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
    (let ignored (. flush applied))
  )
)

(type + GuiVirtualKernelRow (is Box)
  (prop + item I64)
)

(type + GuiVirtualFrameRoot (is Box)
  (implements MarkupRootElement)
  (prop + source _ (:= (call VirtualRangeSource gui-virtual-count)))
  (prop + virtual-layout _ (:= (call VerticalFixedLayout gui-virtual-row-height)))
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (prop + labeled _ (= true))
  (content
    (<> This (• flex-col)
      (<> GuiVirtualBenchRegion (id: region) (• flex 1)
        (= source #source)
        (= virtual-layout #virtual-layout)
        (= overscan (call VirtualInsets 72vcoord 0vcoord 72vcoord 0vcoord))
        (blank)
        (<> GuiVirtualFrameRow (slot: row) (param: slot)
          (= address (. slot #address))
          (= labeled #labeled)
        )
      )
    )
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
    (let ignored (. flush applied))
  )
)

(type + GuiVirtualFrameRow (is Box)
  (prop + address I64)
  (prop + labeled _ (= true))
  (blank)
  (rule This (• flex-row)
    (= background-color (if-expr (== (% #address 2) 0) "#e8eef7" "#ffffff"))
  )
  (content
    (<> This
      (if #labeled
        (<> Label (• flex 1)
          (= text (str "Row " (+ #address 1)))
        )
        (blank)
        (<> Label
          (= text (str (% #address 97)))
        )
        (else
          (<> Box (• h 12) (• bg "#2563eb") (• w (call gui-virtual-bar-width #address)))
        )
      )
    )
  )
)

(fn-expr _ gui-virtual-bar-width _
  (param address I64)
  (as (+ (* (% address 37) 30) 16) Length)
)
