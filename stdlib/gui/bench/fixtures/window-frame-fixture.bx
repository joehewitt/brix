(import /BxAppleGUI/BxAppleGUI.h)
(import /graphics/point)
(import /graphics/primitives)
(import /gui)
(import /math)
(import /stream/sort)
(import /time/duration)
(import /time/timer)
(blank)
(prop + window-bench-size _ (= (call Dimensions 1440 900)))
(prop + window-bench-scale F64 (= 2))
(prop _ window-bench-present-lag I64 (= 8))
(prop _ window-bench-latency-limit I64 (= 20))

(type + WindowBenchLog
  (prop + window Window)
  (prop + steps Size)
  (prop _ frames (list I64))
  (prop _ input-us (list U64))
  (prop _ tick-us (list U64))
  (prop _ update-us (list U64))
  (prop _ layout-us (list U64))
  (prop _ record-us (list U64))
  (prop _ encode-us (list U64))
  (prop _ walk-us (list U64))
  (prop _ native-us (list U64))
  (prop _ commit-us (list U64))
  (prop _ total-us (list U64))
  (prop _ latency-us (list U64))
  (prop _ step-us (list U64))
  (prop _ latency-outliers Size)
  (prop _ is-started _ (= false))
  (prop _ last-frame I64 (= -1))
  (prop _ last-stamp F64 (= 0.0))
  (fn-do + This _
    (param window _)
  )
  (fn-do + start _
    (let size (. window size))
    (let scale (. window backing-scale))
    (throw (call Panic (str "Bench window is " size " at scale " scale ", not " window-bench-size " at " window-bench-scale)) (if (or (!= size window-bench-size) (!= scale window-bench-scale))))
    (= is-started true)
  )
  (fn-do + after-frame _
    (param committed Bool)
    (return-if (if (not is-started)))
    (blank)
    (+= steps 1)
    (return-if (if (not committed)))
    (blank)
    (let frame (. window last-metal-frame-id))
    (let times (. window last-frame-times))
    (return-if (if (or (== frame last-frame) (not times))))
    (blank)
    (= last-frame frame)
    (+= frames frame)
    (+= input-us (call micros (. times input)))
    (+= tick-us (call micros (. times tick)))
    (+= update-us (call micros (. times update)))
    (+= layout-us (call micros (. times layout)))
    (+= record-us (call micros (. times record)))
    (+= encode-us (call micros (. times encode)))
    (+= walk-us (call micros (. times walk)))
    (+= native-us (call micros (. times native)))
    (+= commit-us (call micros (. times commit)))
    (+= total-us (call micros (. times total)))
    (call note-latency (- frame window-bench-present-lag))
  )
  (fn-do + timed _
    (param started U64)
    (+= step-us (/ (- (call monotonic-time-nanoseconds) started) 1000))
  )
  (fn-do + scroll _
    (param point Point)
    (param delta Point)
    (param phase ScrollPhase)
    (param modifiers U64 (= 0))
    (call send 4 point delta modifiers 0 0 (as phase U64))
  )
  (fn-do + move _
    (param point Point)
    (call send 0 point (call Point 0 0) 0 0 0 0)
  )
  (fn-do + press _
    (param point Point)
    (call send 1 point (call Point 0 0) 0 1 1 0)
  )
  (fn-do + drag _
    (param point Point)
    (param delta Point)
    (call send 3 point delta 0 1 0 0)
  )
  (fn-do + release _
    (param point Point)
    (call send 2 point (call Point 0 0) 0 0 1 0)
  )
  (fn-do + finish _
    (param name String)
    (param checksum Size)
    (call report)
    (print (str "bench-result " name " checksum=" checksum))
    (let app (. window app))
    (if app
      (catch (call (. app quit)))
    )
  )
  (fn-do _ note-latency _
    (param frame I64)
    (let latency (call (. window metal-frame-input-latency-nanos) frame))
    (throw (call Panic (str "Frame " frame " shows input " latency " ns after it was presented")) (if (< latency -1)))
    (return-if (if (< latency 0)))
    (blank)
    (let limit (* (as (. window last-frame-refresh-interval) I64) window-bench-latency-limit))
    (if (> latency limit)
      (+= latency-outliers 1)
    )
    (+= latency-us (/ (as latency U64) 1000))
  )
  (fn-do _ send _
    (param kind U32)
    (param point Point)
    (param delta Point)
    (param modifiers U64)
    (param buttons U64)
    (param clicks U32)
    (param phase U64)
    (return-if (if (not (. window native))))
    (blank)
    (let stamp (call C:brixGuiEventClockSeconds))
    (throw (call Panic (str "Scripted input stamp " stamp " does not follow " last-stamp)) (if (<= stamp last-stamp)))
    (= last-stamp stamp)
    (call gui-window-pointer-event
      (block
        (arg (as window Pointer))
        (arg kind)
        (arg 0)
        (arg 0)
        (arg 0)
        (arg buttons)
        (arg modifiers)
        (arg (as (. point x) F64))
        (arg (as (. point y) F64))
        (arg (as (. delta x) F64))
        (arg (as (. delta y) F64))
        (arg stamp)
        (arg clicks)
        (arg (== kind 4))
        (arg phase)
        (arg 0)
      )
    )
  )
  (fn-do _ report _
    (let gpu-us (list U64))
    (let settled (- (as (. frames length) I64) window-bench-present-lag))
    (for (in index (..< 0 settled))
      (let spent (call (. window metal-frame-gpu-nanos) ([] frames index)))
      (if (>= spent 0)
        (+= gpu-us (/ (as spent U64) 1000))
      )
    )
    (probe-count gui.bench.window.input-p50-us (call window-bench-percentile input-us 50))
    (probe-count gui.bench.window.input-p95-us (call window-bench-percentile input-us 95))
    (probe-count gui.bench.window.tick-p50-us (call window-bench-percentile tick-us 50))
    (probe-count gui.bench.window.tick-p95-us (call window-bench-percentile tick-us 95))
    (probe-count gui.bench.window.update-p50-us (call window-bench-percentile update-us 50))
    (probe-count gui.bench.window.update-p95-us (call window-bench-percentile update-us 95))
    (probe-count gui.bench.window.layout-p50-us (call window-bench-percentile layout-us 50))
    (probe-count gui.bench.window.layout-p95-us (call window-bench-percentile layout-us 95))
    (probe-count gui.bench.window.record-p50-us (call window-bench-percentile record-us 50))
    (probe-count gui.bench.window.record-p95-us (call window-bench-percentile record-us 95))
    (probe-count gui.bench.window.encode-p50-us (call window-bench-percentile encode-us 50))
    (probe-count gui.bench.window.encode-p95-us (call window-bench-percentile encode-us 95))
    (probe-count gui.bench.window.walk-p50-us (call window-bench-percentile walk-us 50))
    (probe-count gui.bench.window.walk-p95-us (call window-bench-percentile walk-us 95))
    (probe-count gui.bench.window.native-p50-us (call window-bench-percentile native-us 50))
    (probe-count gui.bench.window.native-p95-us (call window-bench-percentile native-us 95))
    (probe-count gui.bench.window.commit-p50-us (call window-bench-percentile commit-us 50))
    (probe-count gui.bench.window.commit-p95-us (call window-bench-percentile commit-us 95))
    (probe-count gui.bench.window.total-p50-us (call window-bench-percentile total-us 50))
    (probe-count gui.bench.window.total-p95-us (call window-bench-percentile total-us 95))
    (probe-count gui.bench.window.gpu-p50-us (call window-bench-percentile gpu-us 50))
    (probe-count gui.bench.window.gpu-p95-us (call window-bench-percentile gpu-us 95))
    (probe-count gui.bench.window.latency-p50-us (call window-bench-percentile latency-us 50))
    (probe-count gui.bench.window.latency-p95-us (call window-bench-percentile latency-us 95))
    (probe-count gui.bench.window.step-p50-us (call window-bench-percentile step-us 50))
    (probe-count gui.bench.window.step-p95-us (call window-bench-percentile step-us 95))
    (probe-count gui.bench.window.frames (as (. frames length) U64))
    (probe-count gui.bench.window.steps (as steps U64))
    (probe-count gui.bench.window.latency-samples (as (. latency-us length) U64))
    (probe-count gui.bench.window.latency-outliers (as latency-outliers U64))
    (probe-count gui.bench.window.refresh-us (call micros (. window last-frame-refresh-interval)))
  )
)

(fn-expr _ micros U64
  (param value Nanoseconds)
  (/ (as (call max 0 (as value I64)) U64) 1000)
)

(fn-expr + window-bench-percentile U64
  (param values (list U64))
  (param percentile Size)
  (case? (not values)
    0
  )
  (default
    ([] sorted index)
  )
  (where
    (lazy sorted (call sort values (:using (=> (left right) (if-expr (< left right) .lesser .greater)))))
    (lazy index (/ (* (- (. sorted length) 1) percentile) 100))
  )
)
