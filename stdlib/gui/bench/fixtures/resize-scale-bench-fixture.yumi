━━━━━━━━━━━━━━━━━━━━
_ do gui-resize-scale-triangle Size
    - frame Size
    - span Size
    - step Size

. half-period = span / step
. position = frame % (half-period * 2)
if position > half-period
    position = half-period * 2 - position
= position * step

━━━━━━━━━━━━━━━━━━━━
_ gui-resize-scale-percentile-us Size
    - values [U64]
    - percentile Size

|? !values
    0
??
    (sorted[index] / 1000) as Size

.. sorted = sort(values) • using :: left, right => if left < right then .lesser else .greater
.. index = ((sorted.length - 1) * percentile) / 100

━━━━━━━━━━━━━━━━━━━━
_ do build-gui-resize-scale-root

. root = GUIResizeScaleRoot()
markup-mount-root(root, root)

. header = GUIResizeScaleHeader()
markup-append(root, header)
. header-copy = GUIResizeScaleFlexColumn()
markup-append(header, header-copy)
append-gui-resize-scale-label(header-copy, "Static Layout Scale · Resize Benchmark")
append-gui-resize-scale-label
    - header-copy
    - "1,000 cells · 480 rows + labels · deterministic frame sequence"
. tags = GUIResizeScaleFlowRow()
markup-append(header, tags)
append-gui-resize-scale-pill(tags, "CORE GRAPHICS")
append-gui-resize-scale-pill(tags, "STATIC")
append-gui-resize-scale-pill(tags, "2,000+ BOXES")

. stats = GUIResizeScaleStats()
markup-append(root, stats)
append-gui-resize-scale-stat(stats, "CELLS", "1,000")
append-gui-resize-scale-stat(stats, "ROW BOXES", "480")
append-gui-resize-scale-stat(stats, "ROW LABELS", "480")
append-gui-resize-scale-stat(stats, "FRAME WORK", "RESIZE ONLY")

. main = GUIResizeScaleMain()
markup-append(root, main)
. left-panel = GUIResizeScalePanel()
markup-append(main, left-panel)
append-gui-resize-scale-panel-header
    - left-panel
    - "FIXED CELL MATRIX"
    - "40 × 25 physical cells inside flexible ancestors"
    - "1,025 GRID NODES"
. stage = GUIResizeScaleStage()
markup-append(left-panel, stage)
. grid = GUIResizeScaleGrid()
markup-append(stage, grid)
for row-index in 0 .. < 25
    . row = GUIResizeScaleGridRow()
    markup-append(grid, row)
    for column-index in 0 .. < 40
        markup-append(row, GUIResizeScaleCell())
. districts = GUIResizeScaleFlowRow()
markup-append(stage, districts)
for district-index in 0 .. < 12
    append-gui-resize-scale-pill
        - districts
        - gui-resize-scale-district(district-index)

. right-panel = GUIResizeScaleFeedPanel()
markup-append(main, right-panel)
append-gui-resize-scale-panel-header
    - right-panel
    - "PHYSICAL INCIDENT FEED"
    - "480 row boxes · 480 retained text labels"
    - "960 FEED NODES"
. filter = GUIResizeScaleFilter()
markup-append(right-panel, filter)
append-gui-resize-scale-label(filter, "Static filter chrome with intrinsic text")
append-gui-resize-scale-pill(filter, "NO INPUT")
. note = GUIResizeScaleNote()
markup-append(right-panel, note)
append-gui-resize-scale-label
    - note
    - "No scroll, animation, mutation, or scheduled render work"
. feed = GUIResizeScaleFeed()
markup-append(right-panel, feed)
for index in 0 .. < 480
    markup-append(feed, GUIResizeScaleFeedRow(index))

. footer = GUIResizeScaleFooter()
markup-append(root, footer)
append-gui-resize-scale-pill(footer, "STATIC")
append-gui-resize-scale-pill(footer, "NO TIMERS")
append-gui-resize-scale-pill(footer, "NO MUTATIONS")
append-gui-resize-scale-pill(footer, "NO AUTO-SCROLL")
append-gui-resize-scale-label(footer, "Resize continuously across both axes")

root.markup-batch-queue.checkpoint()
= root

━━━━━━━━━━━━━━━━━━━━
