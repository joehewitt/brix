━━━━━━━━━━━━━━━━━━━━
_ do run-gui-resize-scale Size
    - mode Size

. root = build-gui-resize-scale-root()
. background RGBA = "#08111f"
. native = C:yumiGuiWindowCreate("gui resize scale bench (offscreen)", 1360, 860)
. scale = C:yumiGuiWindowGetBackingScaleFactor(native)
. initial-width = gui-resize-scale-width(mode, 0)
. initial-height = gui-resize-scale-height(mode, 0)
root.layout(Rect(0, 0, initial-width as Coord, initial-height as Coord))
. surface = RasterCanvas
    - initial-width as I32
    - initial-height as I32
    - scale
    - background
. surface-width = initial-width
. surface-height = initial-height
. scene = DisplayScene(scale, background)
root.sync-native-geometry()
scene.maintain(root, scale, background)
scene.add-damage(root.bounds)
scene.frame(surface)
C:yumiGuiWindowCommitFrame
    - native
    - surface.native
    - scene.last-frame-damage.x
    - scene.last-frame-damage.y
    - scene.last-frame-damage.width
    - scene.last-frame-damage.height

. warmup-frames Size = 3
for warmup in 0 .. < warmup-frames
    . sequence-index = warmup + 1
    . width = gui-resize-scale-width(mode, sequence-index)
    . height = gui-resize-scale-height(mode, sequence-index)
    root.layout(Rect(0, 0, width as Coord, height as Coord))
    if width != surface-width || height != surface-height
        surface.close()
        surface = RasterCanvas(width as I32, height as I32, scale, background)
        surface-width = width
        surface-height = height
    root.sync-native-geometry()
    scene.maintain(root, scale, background)
    scene.add-damage(root.bounds)
    scene.frame(surface)
    C:yumiGuiWindowCommitFrame
        - native
        - surface.native
        - scene.last-frame-damage.x
        - scene.last-frame-damage.y
        - scene.last-frame-damage.width
        - scene.last-frame-damage.height

. frames Size = 120
. total-ns [U64]
. layout-ns [U64]
. create-ns [U64]
. sync-ns [U64]
. paint-ns [U64]
. commit-ns [U64]
total-ns.reserve(frames)
layout-ns.reserve(frames)
create-ns.reserve(frames)
sync-ns.reserve(frames)
paint-ns.reserve(frames)
commit-ns.reserve(frames)
. allocated-objects Size
. allocated-bytes Size
. layout-objects Size
. layout-bytes Size
. paint-objects Size
. paint-bytes Size
. surface-recreates Size
. misses-120hz Size
. misses-60hz Size
. text-layouts0 = text-layout-created-count()

for frame in 0 .. < frames
    . sequence-index = warmup-frames + frame + 1
    . width = gui-resize-scale-width(mode, sequence-index)
    . height = gui-resize-scale-height(mode, sequence-index)
    . objects0 = C:yumiGCAllocatedObjectCount()
    . bytes0 = C:yumiGCRequestedByteCount()
    . t0 = monotonic-time-nanoseconds()

    //+gui.frame.phase.layout
    root.layout(Rect(0, 0, width as Coord, height as Coord))
    //-gui.frame.phase.layout
    . t1 = monotonic-time-nanoseconds()
    . objects1 = C:yumiGCAllocatedObjectCount()
    . bytes1 = C:yumiGCRequestedByteCount()

    //+gui.frame.phase.create
    . surface-recreated = width != surface-width || height != surface-height
    if surface-recreated
        surface.close()
        surface = RasterCanvas(width as I32, height as I32, scale, background)
        surface-width = width
        surface-height = height
        surface-recreates += 1
    //-gui.frame.phase.create
    . t2 = monotonic-time-nanoseconds()

    //+gui.frame.phase.sync
    root.sync-native-geometry()
    //-gui.frame.phase.sync
    . t3 = monotonic-time-nanoseconds()
    . objects3 = C:yumiGCAllocatedObjectCount()
    . bytes3 = C:yumiGCRequestedByteCount()

    //+gui.frame.phase.paint
    scene.maintain(root, scale, background)
    if surface-recreated
        scene.add-damage(root.bounds)
    . replay-count = scene.frames-replayed
    scene.frame(surface)
    . did-replay = scene.frames-replayed != replay-count
    //-gui.frame.phase.paint
    . t4 = monotonic-time-nanoseconds()
    . objects4 = C:yumiGCAllocatedObjectCount()
    . bytes4 = C:yumiGCRequestedByteCount()

    //+gui.frame.phase.commit
    if did-replay
        C:yumiGuiWindowCommitFrame
            - native
            - surface.native
            - scene.last-frame-damage.x
            - scene.last-frame-damage.y
            - scene.last-frame-damage.width
            - scene.last-frame-damage.height
    //-gui.frame.phase.commit
    . t5 = monotonic-time-nanoseconds()

    . elapsed = t5 - t0
    total-ns += elapsed
    layout-ns += t1 - t0
    create-ns += t2 - t1
    sync-ns += t3 - t2
    paint-ns += t4 - t3
    commit-ns += t5 - t4
    allocated-objects += (C:yumiGCAllocatedObjectCount() - objects0) as Size
    allocated-bytes += (C:yumiGCRequestedByteCount() - bytes0) as Size
    layout-objects += (objects1 - objects0) as Size
    layout-bytes += (bytes1 - bytes0) as Size
    paint-objects += (objects4 - objects3) as Size
    paint-bytes += (bytes4 - bytes3) as Size
    if elapsed > 8333333
        misses-120hz += 1
    if elapsed > 16666667
        misses-60hz += 1

. text-layouts = text-layout-created-count() - text-layouts0
//gui.bench.resize-scale.frames += frames
//gui.bench.resize-scale.frame-p50-us += gui-resize-scale-percentile-us(total-ns, 50)
//gui.bench.resize-scale.frame-p95-us += gui-resize-scale-percentile-us(total-ns, 95)
//gui.bench.resize-scale.frame-p99-us += gui-resize-scale-percentile-us(total-ns, 99)
//gui.bench.resize-scale.layout-p50-us += gui-resize-scale-percentile-us(layout-ns, 50)
//gui.bench.resize-scale.layout-p95-us += gui-resize-scale-percentile-us(layout-ns, 95)
//gui.bench.resize-scale.layout-p99-us += gui-resize-scale-percentile-us(layout-ns, 99)
//gui.bench.resize-scale.create-p50-us += gui-resize-scale-percentile-us(create-ns, 50)
//gui.bench.resize-scale.create-p95-us += gui-resize-scale-percentile-us(create-ns, 95)
//gui.bench.resize-scale.create-p99-us += gui-resize-scale-percentile-us(create-ns, 99)
//gui.bench.resize-scale.sync-p50-us += gui-resize-scale-percentile-us(sync-ns, 50)
//gui.bench.resize-scale.sync-p95-us += gui-resize-scale-percentile-us(sync-ns, 95)
//gui.bench.resize-scale.sync-p99-us += gui-resize-scale-percentile-us(sync-ns, 99)
//gui.bench.resize-scale.paint-p50-us += gui-resize-scale-percentile-us(paint-ns, 50)
//gui.bench.resize-scale.paint-p95-us += gui-resize-scale-percentile-us(paint-ns, 95)
//gui.bench.resize-scale.paint-p99-us += gui-resize-scale-percentile-us(paint-ns, 99)
//gui.bench.resize-scale.commit-p50-us += gui-resize-scale-percentile-us(commit-ns, 50)
//gui.bench.resize-scale.commit-p95-us += gui-resize-scale-percentile-us(commit-ns, 95)
//gui.bench.resize-scale.commit-p99-us += gui-resize-scale-percentile-us(commit-ns, 99)
//gui.bench.resize-scale.misses-120hz += misses-120hz
//gui.bench.resize-scale.misses-60hz += misses-60hz
//gui.bench.resize-scale.objects-per-frame += allocated-objects / frames
//gui.bench.resize-scale.bytes-per-frame += allocated-bytes / frames
//gui.bench.resize-scale.layout-objects-per-frame += layout-objects / frames
//gui.bench.resize-scale.layout-bytes-per-frame += layout-bytes / frames
//gui.bench.resize-scale.paint-objects-per-frame += paint-objects / frames
//gui.bench.resize-scale.paint-bytes-per-frame += paint-bytes / frames
//gui.bench.resize-scale.surface-recreates += surface-recreates
//gui.bench.resize-scale.text-layouts += text-layouts

. checksum = frames + surface-recreates + text-layouts + misses-120hz + misses-60hz
checksum += gui-resize-scale-percentile-us(total-ns, 50)
scene.close()
surface.close()
C:yumiGuiWindowClose(native)
C:yumiGuiWindowRelease(native)
root.close()
markup-release(root)
= checksum

