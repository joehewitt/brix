_ gui-resize-scale-district
    - index Size

match index % 8
    | 0
        "NORTH"
    | 1
        "HARBOR"
    | 2
        "MARKET"
    | 3
        "CIVIC"
    | 4
        "UNION"
    | 5
        "SOMA"
    | 6
        "MISSION"
    ??
        "SUNSET"

━━━━━━━━━━━━━━━━━━━━
_ gui-resize-scale-category
    - index Size

match index % 5
    | 0
        "FIRE"
    | 1
        "MEDICAL"
    | 2
        "TRAFFIC"
    | 3
        "TRANSIT"
    ??
        "UTILITY"

