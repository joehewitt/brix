markup-append(card, copy)
append-gui-resize-scale-label(copy, title)
append-gui-resize-scale-label(copy, value)
. bars = GUIResizeScaleBars()
markup-append(card, bars)
markup-append(bars, GUIResizeScaleBarA())
markup-append(bars, GUIResizeScaleBarB())
markup-append(bars, GUIResizeScaleBarC())

