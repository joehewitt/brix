(fn-do + run-metal-backdrop-blur _
  (let root (call SceneBenchRoot))
  (for (in row-index (..< 0 25))
    (let row (call SceneBenchRow))
    (call markup-append root row)
    (for (in cell-index (..< 0 25))
      (call markup-append row (call SceneBenchGroundCell (+ (* row-index 25) cell-index)))
    )
  )
  (let panels (list SceneBenchBackdropPanel)
    (block
      (item (call SceneBenchBackdropPanel (call Rect 0 0 1200 56) 0 30 (call RGBA 1 1 1 0.55) 1%%))
      (item (call SceneBenchBackdropPanel (call Rect 0 56 240 844) 0 40 (call RGBA 0.95 0.96 0.98 0.5) 1%%))
      (item (call SceneBenchBackdropPanel (call Rect 320 120 360 260) 18 24 (call RGBA 1 1 1 0.35) 1%%))
      (item (call SceneBenchBackdropPanel (call Rect 740 200 380 300) 28 60 (call RGBA 0.1 0.12 0.2 0.3) 1%%))
      (item (call SceneBenchBackdropPanel (call Rect 360 470 300 220) 22 16 (call RGBA 1 1 1 0.4) 0.8%%))
      (item (call SceneBenchBackdropPanel (call Rect 760 560 200 60) 30 3 (call RGBA 1 1 1 0.5) 1%%))
      (item (call SceneBenchBackdropPanel (call Rect 980 620 180 240) 14 120 (call RGBA 0 0 0 0.25) 1%%))
    )
  )
  (for (in panel panels)
    (call markup-append root panel)
  )
  (call run-metal-paint-grid "metal-backdrop-blur" root)
)

(fn-do + run-metal-blend-modes _
  (let photo (call scene-bench-photo 36 24))
  (let modes (list BlendMode)
    (case-each (in code (..< 0 28))
      (as (as code I32) BlendMode)
    )
  )
  (let steady-modes (list BlendMode) (case-each (in mode modes (when (not (call scene-bench-blend-amplifies mode))))))
  (call run-metal-paint-grid "metal-blend-modes" (call scene-bench-blend-grid modes photo) false)
  (call check-metal-parity "metal-blend-modes" (call scene-bench-blend-grid steady-modes photo))
  (call (. photo close))
)

(fn-expr _ scene-bench-blend-amplifies _
  (param mode BlendMode)
  (or is-dodge-or-burn (== mode (. BlendMode hue)) (== mode (. BlendMode saturation)))
  (where
    (lazy is-dodge-or-burn (or (== mode (. BlendMode color-dodge)) (== mode (. BlendMode color-burn))))
  )
)

(fn-do _ scene-bench-blend-grid _
  (param modes (list BlendMode))
  (param photo RasterCanvas)
  (let root (call SceneBenchRoot))
  (for (in row-index (..< 0 25))
    (let row (call SceneBenchRow))
    (call markup-append root row)
    (for (in cell-index (..< 0 25))
      (let index (+ (* row-index 25) cell-index))
      (let mode ([] modes (% index (. modes length))))
      (call markup-append row (call SceneBenchBlendCell mode (% (/ index (. modes length)) 3) photo))
    )
  )
  (return root)
)

(fn-do _ scene-bench-photo _
  (param width F64)
  (param height F64)
  (let photo (call RasterCanvas (as width I32) (as height I32) 2 (call RGBA 0.95 0.85 0.4 1)))
  (call (. photo fill-gradient)
    (block
      (arg (call Rect 0 0 width height))
      (arg
        (call linear-gradient
          (block
            (arg (call Point 0 0))
            (arg (call Point width height))
            (arg (call RGBA 0.9 0.3 0.2 1))
            (arg (call RGBA 0.2 0.4 0.9 0.7))
          )
        )
      )
    )
  )
  (= (. photo fill-color) (call RGBA 1 1 1 1))
  (call (. photo oval) (call Rect (* width 0.2) (* height 0.2) (* height 0.6) (* height 0.6)))
  (return photo)
)

(fn-do _ run-metal-paint-grid _
  (param name String)
  (param root SceneBenchRoot)
  (param gated Bool (= true))
  (call mount-scene-bench-root root (call Rect 0 0 1200 900))
  (let scene (call DisplayScene 2 white))
  (let renderer (call MetalOffscreenRenderer 1200 900 2 white))
  (let reference (call RasterCanvas 1200 900 2 white))
  (let elapsed (list U64))
  (let gpu (list U64))
  (let checksum Size)
  (do-use renderer
    (do-use reference
      (call (. scene build) root)
      (call (. scene commit))
      (call (. scene frame-metal) renderer)
      (for (in warmup (..< 0 6))
        (call (. scene add-damage) (. root bounds))
        (call (. scene frame-metal) renderer)
      )
      (call (. renderer finish))
      (= (. scene metal-tile-fallbacks) 0)
      (for (in frame (..< 0 30))
        (call (. scene add-damage) (. root bounds))
        (let started (call monotonic-time-nanoseconds))
        (call (. scene frame-metal) renderer)
        (+= elapsed (- (call monotonic-time-nanoseconds) started))
        (call (. renderer finish))
        (if (>= (. renderer gpu-nanos) 0)
          (+= gpu (as (. renderer gpu-nanos) U64))
        )
      )
      (call (. root paint) reference)
      (let diff (call (. renderer diff) reference 2))
      (let gross (call (. renderer diff) reference 10))
      (probe-count gui.bench.metal.frame-count 625)
      (probe-count gui.bench.metal.frame-cpu-p50-ns (call scene-percentile elapsed 50))
      (probe-count gui.bench.metal.frame-cpu-p99-ns (call scene-percentile elapsed 99))
      (probe-count gui.bench.metal.frame-gpu-p50-ns (call scene-percentile gpu 50))
      (probe-count gui.bench.metal.frame-draw-calls (as (. renderer draw-calls) U64))
      (probe-count gui.bench.metal.frame-pipeline-switches (as (. renderer pipeline-switches) U64))
      (probe-count gui.bench.metal.frame-packet-bytes (as (. renderer packet-bytes) U64))
      (probe-count gui.bench.metal.frame-differing-pixels (as (. diff differing-pixels) U64))
      (probe-count gui.bench.metal.frame-max-delta (as (. diff maximum-channel-delta) U64))
      (throw (call Panic (str name " fell back to opaque tiles")) (if (or (!= (. scene opaque-demotions) 0) (!= (. scene metal-tile-fallbacks) 0))))
      (throw (call Panic (str name " skipped Metal operations")) (if (!= (. renderer skipped-ops) 0)))
      (throw (call Panic (str name " differs from CoreGraphics beyond GR-D13")) (if (and gated (> (* (. gross differing-pixels) 10000) (. gross pixel-count)))))
      (= checksum (+ (. scene items-encoded) (as (. renderer draw-calls) Size)))
    )
  )
  (call (. scene close))
  (call release-scene-bench-root root)
  (print (str "bench-result gui/" name " checksum=" checksum))
)

(fn-do _ check-metal-parity _
  (param name String)
  (param root SceneBenchRoot)
  (call mount-scene-bench-root root (call Rect 0 0 1200 900))
  (let scene (call DisplayScene 2 white))
  (let renderer (call MetalOffscreenRenderer 1200 900 2 white))
  (let reference (call RasterCanvas 1200 900 2 white))
  (do-use renderer
    (do-use reference
      (call (. scene build) root)
      (call (. scene commit))
      (call (. scene frame-metal) renderer)
      (call (. renderer finish))
      (= (. scene metal-tile-fallbacks) 0)
      (for (in warmup (..< 0 3))
        (call (. scene add-damage) (. root bounds))
        (call (. scene frame-metal) renderer)
      )
      (call (. renderer finish))
      (call (. root paint) reference)
      (let gross (call (. renderer diff) reference 10))
      (let fell-back (or (!= (. scene opaque-demotions) 0) (!= (. scene metal-tile-fallbacks) 0)))
      (throw (call Panic (str name " falls back or skips Metal operations")) (if (or fell-back (!= (. renderer skipped-ops) 0))))
      (throw (call Panic (str name " differs from CoreGraphics beyond GR-D13")) (if (> (* (. gross differing-pixels) 10000) (. gross pixel-count))))
    )
  )
  (call (. scene close))
  (call release-scene-bench-root root)
)

(fn-expr _ scene-percentile U64
  (param values (list U64))
  (param percentile Size)
  (case? (not values)
    0
  )
  (default
    ([] sorted index)
  )
  (where
    (lazy sorted (call sort values (:using (=> (left right) (if-expr (< left right) .lesser .greater)))))
    (lazy index (/ (* (- (. sorted length) 1) percentile) 100))
  )
)

(fn-do _ build-scene-bench-grid SceneBenchRoot
  (param count Size)
  (= scene-bench-cells (call (of List SceneBenchCell)))
  (let root (call SceneBenchRoot))
  (let rows (/ count 100))
  (for (in row-index (..< 0 rows))
    (let row (call SceneBenchRow))
    (call markup-append root row)
    (for (in cell-index (..< 0 100))
      (let cell (call SceneBenchCell))
      (+= scene-bench-cells cell)
      (call markup-append row cell)
    )
  )
  (call mount-scene-bench-root root (call Rect 0 0 1200 900))
  (return root)
)

(fn-do _ build-scene-bench-text _
  (param count Size)
  (param pressure Bool)
  (param pressure-offset Size (= 0))
  (= scene-bench-text-cells (call (of List SceneBenchTextCell)))
  (let root (call SceneBenchRoot))
  (for (in index (..< 0 count))
    (let absolute-index (+ index pressure-offset))
    (let font-size F64)
    (let text String)
    (let maximum-width F64 1200)
    (if pressure
      (= font-size (+ 16.0 (* absolute-index 4)))
      (= maximum-width 2000)
      (= text "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789 !@#\$%^&*()[]{}<>?")
      (else
        (= font-size (+ 11.0 (% index 5)))
        (= text (str "Retained Metal label " index ": quick brown fox 0123456789"))
      )
    )
    (let cell (call SceneBenchTextCell text font-size maximum-width))
    (+= scene-bench-text-cells cell)
    (call markup-append root cell)
  )
  (let dimensions (call Rect 0 0 1200 900))
  (if pressure
    (let group (/ pressure-offset 16))
    (= dimensions (call Rect 0 (as (* group 225) F64) 1200 225))
  )
  (call mount-scene-bench-root root dimensions)
  (for (in index (..< 0 (. scene-bench-text-cells length)))
    (if pressure
      (let absolute-index (+ index pressure-offset))
      (let group (/ absolute-index 16))
      (let group-index (% absolute-index 16))
      (let column (% group-index 4))
      (let row (/ group-index 4))
      (let cell-bounds
        (call Rect
          (block
            (arg (as (* column 300) F64))
            (arg (as (+ (* group 225) (* row 56)) F64))
            (arg 300)
            (arg 56)
          )
        )
      )
      (call (. ([] scene-bench-text-cells index) layout) cell-bounds)
      (else
        (call (. ([] scene-bench-text-cells index) layout) (call Rect 0 (as (* index 14) F64) 1200 14))
      )
    )
  )
  (return root)
)

(fn-do _ build-scene-bench-vectors SceneBenchRoot
  (param count Size)
  (= scene-bench-vector-images (call (of List SceneBenchSharedVectorImage)))
  (let root (call SceneBenchRoot))
  (for (in index (..< 0 count))
    (let image (call SceneBenchSharedVectorImage))
    (+= scene-bench-vector-images image)
    (call markup-append root image)
  )
  (call mount-scene-bench-root root (call Rect 0 0 1200 240))
  (for (in index (..< 0 (. scene-bench-vector-images length)))
    (let column (% index 50))
    (let row (/ index 50))
    (let image-bounds
      (call Rect
        (block
          (arg (as (* column 24) F64))
          (arg (as (* row 12) F64))
          (arg 24)
          (arg 12)
        )
      )
    )
    (call (. ([] scene-bench-vector-images index) layout) image-bounds)
  )
  (return root)
)

(fn-do _ mount-scene-bench-root _
  (param root SceneBenchRoot)
  (param rect Rect)
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (call (. root layout) rect)
)

(fn-do _ release-scene-bench-root _
  (param root SceneBenchRoot)
  (call (. root close))
  (call markup-release root)
)

(type _ SceneBenchRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (rule This
    (= layout flow-col)
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(type _ SceneBenchRow (is Box)
  (rule This
    (= layout flow-row)
  )
)

(type _ SceneBenchCell (is Box)
  (prop + color _ (= blue))
  (blank)
  (rule This
    (= min-width (call (. SizeSpec coord) 11))
    (= max-width (call (. SizeSpec coord) 11))
    (= min-height (call (. SizeSpec coord) 8))
    (= max-height (call (. SizeSpec coord) 8))
  )
  (fn-do + paint-background _
    (param canvas Canvas)
    (call (. canvas push))
    (= (. canvas fill-color) color)
    (= (. canvas stroke-color) null)
    (call (. canvas rect) bounds)
    (call (. canvas pop))
  )
)

(type _ SceneBenchShapeCell (is Box)
  (prop + is-callout _ (= false))
  (blank)
  (rule This
    (= min-width (call (. SizeSpec coord) 16))
    (= max-width (call (. SizeSpec coord) 16))
    (= min-height (call (. SizeSpec coord) 12))
    (= max-height (call (. SizeSpec coord) 12))
    (= margin-right 6)
    (= margin-bottom 8)
    (= background-color "#ffffff")
    (= border-color "#c9ccd6")
    (= border-width 1)
    (= corner-radius 4)
    (= shadow (call Shadow (call RGBA "#0f172a40") 6 0 2))
    (= shape (only-if (call CalloutShape 3 (. Side top)) (if #is-callout)))
  )
)

(type _ SceneBenchGradientCell (is Box)
  (prop + variant Size)
  (blank)
  (rule This (• w 40) (• h 28) (• mr 4) (• mb 4))
  (fn-do + This _
    (param variant _)
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let rect bounds)
    (let center (. rect center))
    (let stops (list GradientStop)
      (block
        (item (call GradientStop 0%% (call RGBA 0.9 0.3 0.2 1)))
        (item (call GradientStop 0.45%% (call RGBA 0.95 0.85 0.3 1)))
        (item (call GradientStop 1%% (call RGBA 0.2 0.4 0.9 1)))
      )
    )
    (match (% variant 6)
      (case= 0
        (call (. canvas fill-gradient)
          (block
            (arg rect)
            (arg
              (call linear-gradient
                (block
                  (arg (. rect top-center))
                  (arg (. rect bottom-center))
                  (arg (call RGBA 0.96 0.96 0.94 1))
                  (arg (call RGBA 0.35 0.37 0.45 1))
                )
              )
            )
          )
        )
      )
      (case= 1
        (call (. canvas fill-gradient)
          (block
            (arg rect)
            (arg (call LinearGradient (call Point (. rect x) (. rect y)) (call Point (. rect right) (. rect bottom)) stops))
          )
        )
      )
      (case= 2
        (call (. canvas fill-gradient)
          (block
            (arg rect)
            (arg (call radial-gradient center 22 (call RGBA 1 1 0.85 1) (call RGBA 0.45 0.15 0.35 1)))
          )
        )
      )
      (case= 3
        (call (. canvas fill-gradient)
          (block
            (arg rect)
            (arg (call RadialGradient (call Point (+ (. rect x) 10) (+ (. rect y) 8)) 2 center 24 stops))
          )
        )
      )
      (case= 4
        (let angle (* (% variant 7) 0.9rad))
        (call (. canvas fill-gradient) rect (call ConicGradient center angle stops))
      )
      (default
        (do-use (. canvas saved-state)
          (call (. canvas transform) (call (. (call Matrix) rotate) 0.3rad center))
          (call (. canvas fill-gradient)
            (block
              (arg (call (. rect pad) -4))
              (arg
                (call linear-gradient
                  (block
                    (arg (. rect left-center))
                    (arg (. rect right-center))
                    (arg (call RGBA 0.1 0.6 0.5 0.2))
                    (arg (call RGBA 0.1 0.6 0.5 1))
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

(type _ SceneBenchShaderCell (is Box)
  (prop + variant Size)
  (prop + phase F64)
  (blank)
  (rule This (• w 40) (• h 28) (• mr 4) (• mb 4))
  (fn-do + This _
    (param variant _)
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let rect bounds)
    (let shader ([] (call scene-bench-shaders) (% (/ variant 25) 4)))
    (let args (list F64) (list (+ 4 (as (% variant 5) F64)) (+ phase (as (% variant 7) F64))))
    (if (== (% variant 5) 4)
      (do-use (. canvas saved-state)
        (call (. canvas transform) (call (. (call Matrix) rotate) 0.3rad (. rect center)))
        (call (. canvas fill-shader) (call (. rect pad) -4) shader args)
      )
      (else
        (call (. canvas fill-shader) rect shader args)
      )
    )
  )
)

(type _ SceneBenchImageCell (is Box)
  (prop + variant Size)
  (prop + photo RasterCanvas)
  (prop + small RasterCanvas)
  (prop + icon RasterCanvas)
  (blank)
  (rule This (• w 40) (• h 28) (• mr 4) (• mb 4))
  (fn-do + This _
    (param variant _)
    (param photo _)
    (param small _)
    (param icon _)
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let rect bounds)
    (let center (. rect center))
    (match (% variant 6)
      (case= 0
        (call (. canvas draw-image) photo (call Rect (+ (. rect x) 2) (+ (. rect y) 2) 36 24))
      )
      (case= 1
        (call (. canvas draw-image) small rect)
      )
      (case= 2
        (= (. canvas fill-color) (call RGBA 0.2 0.5 0.3 1))
        (call (. canvas draw-image) icon (call Rect (- (. center x) 10) (- (. center y) 10) 20 20) true)
      )
      (case= 3
        (do-use (. canvas saved-state)
          (call (. canvas transform) (call (. (call Matrix) rotate) 0.3rad center))
          (call (. canvas draw-image) small (call Rect (- (. center x) 16) (- (. center y) 10) 32 20))
        )
      )
      (case= 4
        (do-use (. canvas saved-state)
          (call (. canvas transform) (call (. (call Matrix) rotate) -0.5rad center))
          (= (. canvas fill-color) (call RGBA 0.7 0.2 0.4 1))
          (call (. canvas draw-image) icon (call Rect (- (. center x) 10) (- (. center y) 10) 20 20) true)
        )
      )
      (default
        (call (. canvas draw-image) photo (call Rect (+ (. rect x) 5) (+ (. rect y) 4) 30 20))
      )
    )
  )
)

(type _ SceneBenchMaskCell (is Box)
  (prop + variant Size)
  (prop + mask RasterCanvas)
  (prop + photo RasterCanvas)
  (blank)
  (rule This (• w 40) (• h 28) (• mr 4) (• mb 4))
  (fn-do + This _
    (param variant _)
    (param mask _)
    (param photo _)
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let rect bounds)
    (let kind (% variant 4))
    (let area (call Rect (+ (. rect x) 2) (+ (. rect y) 2) 36 24))
    (do-use (. canvas saved-state)
      (if (== kind 3)
        (call (. canvas transform) (call (. (call Matrix) rotate) 0.3rad (. rect center)))
      )
      (call (. canvas clip-mask) mask area)
      (match kind
        (case= 0
          (= (. canvas fill-color) (call RGBA 0.2 0.45 0.85 1))
          (call (. canvas rect) rect)
        )
        (case= 1
          (call (. canvas fill-gradient)
            (block
              (arg rect)
              (arg
                (call linear-gradient
                  (block
                    (arg (. rect top-left))
                    (arg (. rect bottom-right))
                    (arg (call RGBA 0.9 0.3 0.2 1))
                    (arg (call RGBA 0.2 0.4 0.9 1))
                  )
                )
              )
            )
          )
        )
        (case= 2
          (call (. canvas draw-image) photo area)
        )
        (default
          (= (. canvas fill-color) (call RGBA 0.7 0.2 0.4 1))
          (call (. canvas oval) rect)
        )
      )
    )
  )
)

(type _ SceneBenchLayerMaskCell (is Box)
  (prop + variant Size)
  (prop + photo RasterCanvas)
  (blank)
  (rule This (• w 40) (• h 28) (• mr 4) (• mb 4))
  (fn-do + This _
    (param variant _)
    (param photo _)
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let rect bounds)
    (let kind (% variant 4))
    (let black (call RGBA 0 0 0 1))
    (do-use (. canvas saved-state)
      (if (== kind 3)
        (call (. canvas transform) (call (. (call Matrix) rotate) 0.3rad (. rect center)))
      )
      (call (. canvas begin-mask))
      (if (== kind 1)
        (call (. canvas fill-gradient)
          (block
            (arg rect)
            (arg (call linear-gradient (. rect left-center) (. rect right-center) black (call RGBA 0 0 0 0)))
          )
        )
        (else
          (= (. canvas fill-color) black)
          (call (. canvas oval) (call Rect (+ (. rect x) 2) (+ (. rect y) 2) 30 22))
          (= (. canvas fill-color) (call RGBA 0 0 0 0.4))
          (call (. canvas oval) (call Rect (+ (. rect x) 16) (+ (. rect y) 6) 22 18))
        )
      )
      (call (. canvas end-mask))
      (match kind
        (case= 0
          (= (. canvas fill-color) (call RGBA 0.2 0.45 0.85 1))
          (call (. canvas rect) rect)
          (= (. canvas fill-color) (call RGBA 0.9 0.3 0.2 0.6))
          (call (. canvas oval) (call Rect (+ (. rect x) 8) (+ (. rect y) 4) 26 20))
        )
        (case= 1
          (call (. canvas draw-image) photo (call Rect (+ (. rect x) 2) (+ (. rect y) 2) 36 24))
        )
        (case= 2
          (call (. canvas fill-gradient)
            (block
              (arg rect)
              (arg
                (call linear-gradient
                  (block
                    (arg (. rect top-left))
                    (arg (. rect bottom-right))
                    (arg (call RGBA 0.9 0.3 0.2 1))
                    (arg (call RGBA 0.2 0.4 0.9 1))
                  )
                )
              )
            )
          )
        )
        (default
          (= (. canvas fill-color) (call RGBA 0.7 0.2 0.4 1))
          (call (. canvas oval) rect)
        )
      )
    )
  )
)

(type _ SceneBenchBlendCell (is Box)
  (prop + mode BlendMode)
  (prop + kind Size)
  (prop + photo RasterCanvas)
  (blank)
  (rule This (• w 40) (• h 28) (• mr 4) (• mb 4))
  (fn-do + This _
    (param mode _)
    (param kind _)
    (param photo _)
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let rect bounds)
    (= (. canvas fill-color) (call RGBA 0.2 0.45 0.85 1))
    (call (. canvas rect) (call Rect (. rect x) (. rect y) (* (. rect width) 0.5) (. rect height)))
    (= (. canvas fill-color) (call RGBA 0.95 0.75 0.2 0.6))
    (call (. canvas oval) (call Rect (+ (. rect x) 10) (+ (. rect y) 2) 24 16))
    (call (. canvas fill-gradient)
      (block
        (arg (call Rect (. rect x) (+ (. rect y) 19) (. rect width) 9))
        (arg
          (call linear-gradient
            (block
              (arg (. rect left-center))
              (arg (. rect right-center))
              (arg (call RGBA 0.1 0.8 0.3 1))
              (arg (call RGBA 0.8 0.1 0.6 0.3))
            )
          )
        )
      )
    )
    (do-use (. canvas saved-state)
      (call (. canvas clip) rect)
      (= (. canvas blend-mode) mode)
      (match kind
        (case= 0
          (= (. canvas fill-color) (call RGBA 0.9 0.3 0.2 0.7))
          (call (. canvas oval) (call Rect (+ (. rect x) 2) (+ (. rect y) 6) 20 18))
          (= (. canvas fill-color) (call RGBA 0.3 0.8 0.4 0.8))
          (call (. canvas rect) (call Rect (+ (. rect x) 20) (+ (. rect y) 1) 18 10))
          (call (. canvas draw-image) photo (call Rect (+ (. rect x) 20) (+ (. rect y) 13) 18 12))
        )
        (case= 1
          (call (. canvas transform) (call (. (call Matrix) rotate) 0.4rad (. rect center)))
          (= (. canvas fill-color) (call RGBA 0.6 0.2 0.8 0.9))
          (call (. canvas begin))
          (call (. canvas move) (+ (. rect x) 4) (+ (. rect y) 6))
          (call (. canvas line) (+ (. rect x) 36) (+ (. rect y) 9))
          (call (. canvas line) (+ (. rect x) 28) (+ (. rect y) 25))
          (call (. canvas line) (+ (. rect x) 7) (+ (. rect y) 20))
          (call (. canvas end) true)
        )
        (default
          (call (. canvas begin-opacity) 0.85%%)
          (= (. canvas fill-color) (call RGBA 0.9 0.3 0.2 1))
          (call (. canvas oval) (call Rect (+ (. rect x) 4) (+ (. rect y) 4) 18 18))
          (= (. canvas fill-color) (call RGBA 0.2 0.7 0.9 0.6))
          (call (. canvas rect) (call Rect (+ (. rect x) 16) (+ (. rect y) 8) 18 14))
          (call (. canvas end-opacity))
        )
      )
    )
  )
)

(type _ SceneBenchShadowCell (is Box)
  (prop + variant Size)
  (blank)
  (rule This (• w 40) (• h 28) (• mr 4) (• mb 4))
  (fn-do + This _
    (param variant _)
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let rect bounds)
    (let kind (% variant 4))
    (let hue (/ (as (% variant 9) F64) 9))
    (= (. canvas fill-color) (call RGBA 0.92 0.9 0.85 1))
    (call (. canvas rect) (call Rect (. rect x) (+ (. rect y) 20) (. rect width) 8))
    (do-use (. canvas saved-state)
      (match kind
        (case= 0
          (call scene-bench-shadow-wedge canvas rect)
          (call (. canvas shadow-path) (call Shadow (call RGBA 0 0 0 0.5) 3 2 3))
        )
        (case= 1
          (call (. canvas begin))
          (call (. canvas outline-path) (call Outline (call Rect (+ (. rect x) 6) (+ (. rect y) 4) 26 16) 6))
          (call (. canvas shadow-path) (call Shadow (call RGBA 0.1 0.1 0.3 0.6) 6 0 3))
        )
        (case= 2
          (call (. canvas transform) (call (. (call Matrix) rotate) 0.3rad (. rect center)))
          (call scene-bench-shadow-wedge canvas rect)
          (call (. canvas shadow-path) (call Shadow (call RGBA 0 0 0 0.45) 4 3 2))
        )
        (default
          (call (. canvas clip-outline) (call Outline rect 8))
          (call (. canvas begin-opacity) 0.8%%)
          (call scene-bench-shadow-wedge canvas rect)
          (call (. canvas shadow-path) (call Shadow (call RGBA 0.2 0 0.1 0.7) 2 1 1))
          (call (. canvas end-opacity))
        )
      )
      (= (. canvas fill-color) (call RGBA (+ 0.3 (* hue 0.6)) 0.55 (- 0.9 (* hue 0.5)) 1))
      (if (== kind 1)
        (call (. canvas outline) (call Outline (call Rect (+ (. rect x) 6) (+ (. rect y) 4) 26 16) 6))
        (else
          (call scene-bench-shadow-wedge canvas rect)
          (call (. canvas end))
        )
      )
    )
  )
)

(type _ SceneBenchBlurCell (is Box)
  (prop + variant Size)
  (blank)
  (rule This (• w 40) (• h 28) (• mr 4) (• mb 4))
  (fn-do + This _
    (param variant _)
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let rect bounds)
    (let kind (% variant 4))
    (let hue (/ (as (% variant 9) F64) 9))
    (= (. canvas fill-color) (call RGBA 0.92 0.9 0.85 1))
    (call (. canvas rect) (call Rect (. rect x) (+ (. rect y) 20) (. rect width) 8))
    (do-use (. canvas saved-state)
      (match? kind
        (case= 1
          (call (. canvas transform) (call (. (call Matrix) rotate) 0.3rad (. rect center)))
        )
        (case= 2
          (call (. canvas clip-outline) (call Outline rect 8))
        )
        (case= 3
          (call (. canvas begin-opacity) 0.8%%)
        )
      )
      (call (. canvas begin-blur) (+ 1.5 (as kind F64)))
      (= (. canvas fill-color) (call RGBA (+ 0.3 (* hue 0.6)) 0.55 (- 0.9 (* hue 0.5)) 1))
      (call scene-bench-shadow-wedge canvas rect)
      (call (. canvas end))
      (= (. canvas fill-color) (call RGBA 0.95 0.4 0.2 0.85))
      (call (. canvas oval) (call Rect (+ (. rect x) 20) (+ (. rect y) 10) 14 12))
      (call (. canvas end-blur))
      (if (== kind 3)
        (call (. canvas end-opacity))
      )
    )
  )
)

(type _ SceneBenchGroundCell (is Box)
  (prop + variant Size)
  (blank)
  (rule This (• w 44) (• h 32) (• mr 4) (• mb 4))
  (fn-do + This _
    (param variant _)
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let rect bounds)
    (let hue (/ (as (% variant 11) F64) 11))
    (= (. canvas fill-color) (call RGBA 0.98 0.97 0.94 1))
    (call (. canvas rect) rect)
    (for (in stripe (..< 0 4))
      (= (. canvas fill-color) (call RGBA (- 0.9 (* hue 0.6)) (+ 0.3 (* hue 0.5)) (+ 0.35 (* (as stripe F64) 0.15)) 1))
      (call (. canvas rect) (call Rect (as (+ (. rect x) (* stripe 11)) F64) (. rect y) 5 (. rect height)))
    )
    (= (. canvas fill-color) (call RGBA 0.1 (+ 0.12 (* hue 0.3)) 0.2 1))
    (call (. canvas oval) (call Rect (+ (. rect x) 12) (+ (. rect y) 6) 20 20))
  )
)

(type _ SceneBenchFilterFrame (is Box)
  (rule This
    (= layout flow-col)
  )
)

(type _ SceneBenchBackdropPanel (is Box)
  (rule This (• absolute)
    (= anchor (. Anchor parent))
  )
  (fn-do + This _
    (param frame Rect)
    (param radius Length)
    (param blur Length)
    (param tint RGBA)
    (param fade Ratio)
    (= left (call (. PositionOffset coord) (. frame x)))
    (= top (call (. PositionOffset coord) (. frame y)))
    (= min-width (call (. SizeSpec coord) (. frame width)))
    (= max-width (call (. SizeSpec coord) (. frame width)))
    (= min-height (call (. SizeSpec coord) (. frame height)))
    (= max-height (call (. SizeSpec coord) (. frame height)))
    (= corner-radius radius)
    (= backdrop-blur blur)
    (= background-color tint)
    (= opacity fade)
    (if (> radius 0)
      (= shadow (call Shadow (call RGBA 0 0 0 0.3) 12 0 4))
    )
  )
)

(fn-do _ scene-bench-shadow-wedge _
  (param canvas Canvas)
  (param rect Rect)
  (call (. canvas begin))
  (call (. canvas move) (+ (. rect x) 5) (+ (. rect y) 5))
  (call (. canvas line) (+ (. rect x) 33) (+ (. rect y) 8))
  (call (. canvas line) (+ (. rect x) 24) (+ (. rect y) 22))
  (call (. canvas line) (+ (. rect x) 9) (+ (. rect y) 18))
  (call (. canvas enclose))
)

(type _ SceneBenchTextCell (is Box)
  (prop + text-layout TextLayout)
  (fn-do + This _
    (param text String)
    (param font-size F64)
    (param maximum-width F64)
    (lazy text-layout (call TextLayout text (call Font "Helvetica" font-size (. FontWeight regular)) maximum-width))
  )
  (fn-do + close _
    (call (. text-layout close))
    (call (. super close))
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (call (. canvas push))
    (call (. canvas clip) bounds)
    (= (. canvas text-color) (call RGBA "#1f2937"))
    (call (. canvas draw-text) text-layout bounds)
    (call (. canvas pop))
  )
)

(type _ SceneBenchSharedVectorImage (is VectorImage)
  (fn-do + This _
    (= view-box (call Rect 0 0 24 12))
  )
  (content
    (<> This
      (= fill "#2563eb")
      (= stroke (. Stroke none))
      (blank)
      (<> Circle
        (= center (call Point 12 6))
        (= radius 5)
      )
    )
  )
)

(type _ SceneBenchScroll (is Box)
  (rule This
    (= layout flow-col)
    (= overflow-y (. ScrollOverflow auto))
    (= scroll-indicator-y (. ScrollIndicatorVisibility hidden))
    (= min-width (call (. SizeSpec coord) 1200))
    (= max-width (call (. SizeSpec coord) 1200))
    (= min-height (call (. SizeSpec coord) 320))
    (= max-height (call (. SizeSpec coord) 320))
