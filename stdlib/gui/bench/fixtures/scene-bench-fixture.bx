(blank)
(prop _ scene-bench-cells (list SceneBenchCell))
(prop _ scene-bench-shader-cache (list Shader))
(prop _ scene-bench-text-cells (list SceneBenchTextCell))
(prop _ scene-bench-vector-images (list SceneBenchSharedVectorImage))

(fn-do + run-scene-leaf-mutation _
  (let checksum Size)
  (+= checksum (call run-scene-leaf-scale 1000))
  (+= checksum (call run-scene-leaf-scale 10000))
  (print (str "bench-result gui/scene-leaf-mutation checksum=" checksum))
)

(fn-do _ run-scene-leaf-scale Size
  (param count Size)
  (let root (call build-scene-bench-grid count))
  (let scene (call DisplayScene 2 white))
  (let surface (call RasterCanvas 1200 900 2 white))
  (let elapsed (list U64))
  (let target ([] scene-bench-cells (/ (. scene-bench-cells length) 2)))
  (do-use surface
    (call (. scene build) root)
    (call (. scene commit))
    (call (. scene frame) surface)
    (call (. scene reset-frame-counters))
    (for (in frame (..< 0 30))
      (= (. target color) (if-expr (== (% frame 2) 0) red blue))
      (call (. target invalidate-paint))
      (let started (call monotonic-time-nanoseconds))
      (call (. scene update) root)
      (call (. scene commit))
      (call (. scene frame) surface)
      (+= elapsed (- (call monotonic-time-nanoseconds) started))
    )
    (blank)
    (= (. target color) green)
    (call (. target invalidate-paint))
    (let objects0 (call C:brixGCAllocatedObjectCount))
    (let bytes0 (call C:brixGCRequestedByteCount))
    (call (. scene update) root)
    (call (. scene commit))
    (call (. scene frame) surface)
    (let objects (- (call C:brixGCAllocatedObjectCount) objects0))
    (let bytes (- (call C:brixGCRequestedByteCount) bytes0))
    (blank)
    (if (== count 1000)
      (probe-count gui.bench.scene.leaf-p50-ns-1k (call scene-percentile elapsed 50))
      (probe-count gui.bench.scene.leaf-chunks-rebuilt-1k (. scene chunks-rebuilt))
      (probe-count gui.bench.scene.leaf-chunks-drawn-1k (. scene chunks-drawn))
      (probe-count gui.bench.scene.leaf-objects-1k objects)
      (probe-count gui.bench.scene.leaf-bytes-1k bytes)
      (else
        (probe-count gui.bench.scene.leaf-p50-ns-10k (call scene-percentile elapsed 50))
        (probe-count gui.bench.scene.leaf-chunks-rebuilt-10k (. scene chunks-rebuilt))
        (probe-count gui.bench.scene.leaf-chunks-drawn-10k (. scene chunks-drawn))
        (probe-count gui.bench.scene.leaf-objects-10k objects)
        (probe-count gui.bench.scene.leaf-bytes-10k bytes)
      )
    )
  )
  (blank)
  (let result (+ (. scene chunks-rebuilt) (. scene chunks-drawn) (. scene items-drawn)))
  (call (. scene close))
  (call release-scene-bench-root root)
  (return result)
)

(fn-do + run-scene-scroll-10k _
  (let root (call SceneBenchRoot))
  (let viewport (call SceneBenchScroll))
  (call markup-append root viewport)
  (for (in index (..< 0 10000))
    (call markup-append viewport (call SceneBenchScrollCell))
  )
  (call mount-scene-bench-root root (call Rect 0 0 1200 320))
  (blank)
  (let scene (call DisplayScene 2 white))
  (let surface (call RasterCanvas 1200 320 2 white))
  (let elapsed (list U64))
  (do-use surface
    (call (. scene build) root)
    (call (. scene commit))
    (call (. scene frame) surface)
    (call (. scene reset-frame-counters))
    (let offset F64 1000)
    (for (in frame (..< 0 30))
      (+= offset 10)
      (call (. viewport scroll-to) (call Point 0 offset))
      (let started (call monotonic-time-nanoseconds))
      (call (. scene update) root)
      (call (. scene commit))
      (call (. scene frame) surface)
      (+= elapsed (- (call monotonic-time-nanoseconds) started))
    )
    (blank)
    (+= offset 10)
    (call (. viewport scroll-to) (call Point 0 offset))
    (let objects0 (call C:brixGCAllocatedObjectCount))
    (let bytes0 (call C:brixGCRequestedByteCount))
    (call (. scene update) root)
    (let objects-after-update (call C:brixGCAllocatedObjectCount))
    (call (. scene commit))
    (let objects-after-commit (call C:brixGCAllocatedObjectCount))
    (call (. scene frame) surface)
    (let objects-after-replay (call C:brixGCAllocatedObjectCount))
    (let objects (- objects-after-replay objects0))
    (let bytes (- (call C:brixGCRequestedByteCount) bytes0))
    (probe-count gui.bench.scene.scroll-p50-ns (call scene-percentile elapsed 50))
    (probe-count gui.bench.scene.scroll-p99-ns (call scene-percentile elapsed 99))
    (probe-count gui.bench.scene.scroll-chunks-rebuilt (. scene chunks-rebuilt))
    (probe-count gui.bench.scene.scroll-chunks-drawn (. scene chunks-drawn))
    (probe-count gui.bench.scene.scroll-objects objects)
    (probe-count gui.bench.scene.scroll-bytes bytes)
    (probe-count gui.bench.scene.scroll-update-objects (- objects-after-update objects0))
    (probe-count gui.bench.scene.scroll-commit-objects (- objects-after-commit objects-after-update))
    (probe-count gui.bench.scene.scroll-replay-objects (- objects-after-replay objects-after-commit))
  )
  (blank)
  (print (str "bench-result gui/scene-scroll-10k checksum=" (+ (. scene chunks-drawn) (. scene cull-tests))))
  (call (. scene close))
  (call release-scene-bench-root root)
)

(fn-do + run-scene-idle _
  (let root (call build-scene-bench-grid 10000))
  (let scene (call DisplayScene 2 white))
  (let surface (call RasterCanvas 1200 900 2 white))
  (let elapsed (list U64))
  (do-use surface
    (call (. scene build) root)
    (call (. scene commit))
    (call (. scene frame) surface)
    (let replays0 (. scene frames-replayed))
    (let draws0 (. scene chunks-drawn))
    (for (in frame (..< 0 1000))
      (let started (call monotonic-time-nanoseconds))
      (call (. scene frame) surface)
      (+= elapsed (- (call monotonic-time-nanoseconds) started))
    )
    (probe-count gui.bench.scene.idle-p50-ns (call scene-percentile elapsed 50))
    (probe-count gui.bench.scene.idle-replays (- (. scene frames-replayed) replays0))
    (probe-count gui.bench.scene.idle-draws (- (. scene chunks-drawn) draws0))
  )
  (blank)
  (print (str "bench-result gui/scene-idle checksum=" (. scene frames-idle)))
  (call (. scene close))
  (call release-scene-bench-root root)
)

(fn-do + run-scene-settled-frame _
  (let checksum Size)
  (+= checksum (call run-scene-settled-scale 1000))
  (+= checksum (call run-scene-settled-scale 10000))
  (print (str "bench-result gui/scene-settled-frame checksum=" checksum))
)

(fn-do _ run-scene-settled-scale Size
  (param count Size)
  (let root (call build-scene-bench-grid count))
  (let scene (call DisplayScene 2 white))
  (let surface (call RasterCanvas 1200 900 2 white))
  (let elapsed (list U64))
  (do-use surface
    (call (. scene build) root)
    (call (. scene commit))
    (call (. scene frame) surface)
    (call (. scene reset-frame-counters))
    (for (in frame (..< 0 30))
      (call (. scene add-damage) (. root bounds))
      (let started (call monotonic-time-nanoseconds))
      (call (. scene frame) surface)
      (+= elapsed (- (call monotonic-time-nanoseconds) started))
    )
    (if (== count 1000)
      (probe-count gui.bench.scene.settled-p50-ns-1k (call scene-percentile elapsed 50))
      (else
        (probe-count gui.bench.scene.settled-p50-ns-10k (call scene-percentile elapsed 50))
      )
    )
  )
  (blank)
  (let result (. scene items-drawn))
  (call (. scene close))
  (call release-scene-bench-root root)
  (return result)
)

(fn-do + run-scene-build _
  (let root (call build-scene-bench-grid 10000))
  (let scene (call DisplayScene 2 white))
  (let started (call monotonic-time-nanoseconds))
  (call (. scene build) root)
  (call (. scene commit))
  (let elapsed (- (call monotonic-time-nanoseconds) started))
  (probe-count gui.bench.scene.build-ns-10k elapsed)
  (probe-count gui.bench.scene.build-boxes-10k (. scene boxes-visited))
  (probe-count gui.bench.scene.build-items-10k (. scene items-built))
  (print (str "bench-result gui/scene-build checksum=" (+ (. scene boxes-visited) (. scene items-built))))
  (call (. scene close))
  (call release-scene-bench-root root)
)

(fn-do + run-metal-frame-anatomy-1k _
  (let checksum (call run-metal-frame-anatomy 1000))
  (print (str "bench-result gui/metal-frame-anatomy-1k checksum=" checksum))
)

(fn-do + run-metal-frame-anatomy-10k _
  (let checksum (call run-metal-frame-anatomy 10000))
  (print (str "bench-result gui/metal-frame-anatomy-10k checksum=" checksum))
)

(fn-do _ run-metal-frame-anatomy Size
  (param count Size)
  (let root (call build-scene-bench-grid count))
  (let scene (call DisplayScene 2 white))
  (let renderer (call MetalOffscreenRenderer 1200 900 2 white))
  (let reference (call RasterCanvas 1200 900 2 white))
  (let elapsed (list U64))
  (let gpu (list U64))
  (let idle (list U64))
  (let result Size)
  (call (. elapsed reserve) 30)
  (call (. gpu reserve) 30)
  (call (. idle reserve) 1000)
  (do-use renderer
    (do-use reference
      (call (. scene build) root)
      (call (. scene commit))
      (call (. scene frame-metal) renderer)
      (for (in warmup (..< 0 6))
        (call (. scene add-damage) (. root bounds))
        (call (. scene frame-metal) renderer)
      )
      (call (. renderer finish))
      (blank)
      (for (in frame (..< 0 30))
        (call (. scene add-damage) (. root bounds))
        (let started (call monotonic-time-nanoseconds))
        (call (. scene frame-metal) renderer)
        (+= elapsed (- (call monotonic-time-nanoseconds) started))
        (call (. renderer finish))
        (if (>= (. renderer gpu-nanos) 0)
          (+= gpu (as (. renderer gpu-nanos) U64))
        )
      )
      (blank)
      (call (. renderer finish))
      (call (. renderer mark-renderer-allocations))
      (call (. scene add-damage) (. root bounds))
      (let objects0 (call C:brixGCAllocatedObjectCount))
      (call (. scene frame-metal) renderer)
      (let objects (- (call C:brixGCAllocatedObjectCount) objects0))
      (call (. renderer finish))
      (blank)
      (let commits (. renderer commits))
      (for (in frame (..< 0 1000))
        (let started (call monotonic-time-nanoseconds))
        (call (. scene frame-metal) renderer)
        (+= idle (- (call monotonic-time-nanoseconds) started))
      )
      (let idle-commits (- (. renderer commits) commits))
      (blank)
      (call (. root paint) reference)
      (let diff (call (. renderer diff) reference))
      (probe-count gui.bench.metal.frame-count count)
      (probe-count gui.bench.metal.frame-cpu-p50-ns (call scene-percentile elapsed 50))
      (probe-count gui.bench.metal.frame-cpu-p99-ns (call scene-percentile elapsed 99))
      (probe-count gui.bench.metal.frame-gpu-p50-ns (call scene-percentile gpu 50))
      (probe-count gui.bench.metal.frame-draw-calls (as (. renderer draw-calls) U64))
      (probe-count gui.bench.metal.frame-pipeline-switches (as (. renderer pipeline-switches) U64))
      (probe-count gui.bench.metal.frame-packet-bytes (as (. renderer packet-bytes) U64))
      (probe-count gui.bench.metal.frame-renderer-allocations (. renderer renderer-allocations))
      (probe-count gui.bench.metal.frame-gc-objects objects)
      (probe-count gui.bench.metal.frame-differing-pixels (as (. diff differing-pixels) U64))
      (probe-count gui.bench.metal.frame-max-delta (as (. diff maximum-channel-delta) U64))
      (probe-count gui.bench.metal.idle-p50-ns (call scene-percentile idle 50))
      (probe-count gui.bench.metal.idle-commits idle-commits)
      (= result (+ (as (. renderer packet-bytes) Size) (as (. renderer draw-calls) Size)))
      (+= result (. scene items-encoded))
    )
  )
  (blank)
  (call (. scene close))
  (call release-scene-bench-root root)
  (return result)
)

(fn-do + run-metal-leaf-mutation _
  (let checksum Size)
  (+= checksum (call run-metal-leaf-scale 1000))
  (+= checksum (call run-metal-leaf-scale 10000))
  (print (str "bench-result gui/metal-leaf-mutation checksum=" checksum))
)

(fn-do _ run-metal-leaf-scale Size
  (param count Size)
  (let root (call build-scene-bench-grid count))
  (let scene (call DisplayScene 2 white))
  (let renderer (call MetalOffscreenRenderer 1200 900 2 white))
  (let target ([] scene-bench-cells (/ (. scene-bench-cells length) 2)))
  (let elapsed (list U64))
  (call (. elapsed reserve) 30)
  (let maximum-chunks Size)
  (let maximum-cull-tests Size)
  (let result Size)
  (do-use renderer
    (call (. scene build) root)
    (call (. scene commit))
    (call (. scene frame-metal) renderer)
    (for (in warmup (..< 0 6))
      (= (. target color) (if-expr (== (% warmup 2) 0) red blue))
      (call (. target invalidate-paint))
      (call (. scene update) root)
      (call (. scene commit))
      (call (. scene frame-metal) renderer)
    )
    (call (. renderer finish))
    (blank)
    (for (in frame (..< 0 30))
      (= (. target color) (if-expr (== (% frame 2) 0) red blue))
      (call (. target invalidate-paint))
      (call (. scene reset-frame-counters))
      (let started (call monotonic-time-nanoseconds))
      (call (. scene update) root)
      (call (. scene commit))
      (call (. scene frame-metal) renderer)
      (+= elapsed (- (call monotonic-time-nanoseconds) started))
      (if (> (. scene chunks-encoded) maximum-chunks)
        (= maximum-chunks (. scene chunks-encoded))
      )
      (if (> (. scene cull-tests) maximum-cull-tests)
        (= maximum-cull-tests (. scene cull-tests))
      )
    )
    (blank)
    (call (. renderer finish))
    (call (. renderer mark-renderer-allocations))
    (= (. target color) green)
    (call (. target invalidate-paint))
    (call (. scene reset-frame-counters))
    (let objects0 (call C:brixGCAllocatedObjectCount))
    (call (. scene update) root)
    (call (. scene commit))
    (call (. scene frame-metal) renderer)
    (let objects (- (call C:brixGCAllocatedObjectCount) objects0))
    (call (. renderer finish))
    (if (== count 1000)
      (probe-count gui.bench.metal.leaf-p50-ns-1k (call scene-percentile elapsed 50))
      (probe-count gui.bench.metal.leaf-chunks-1k maximum-chunks)
      (probe-count gui.bench.metal.leaf-cull-tests-1k maximum-cull-tests)
      (probe-count gui.bench.metal.leaf-objects-1k objects)
      (probe-count gui.bench.metal.leaf-renderer-allocations-1k (. renderer renderer-allocations))
      (else
        (probe-count gui.bench.metal.leaf-p50-ns-10k (call scene-percentile elapsed 50))
        (probe-count gui.bench.metal.leaf-chunks-10k maximum-chunks)
        (probe-count gui.bench.metal.leaf-cull-tests-10k maximum-cull-tests)
        (probe-count gui.bench.metal.leaf-objects-10k objects)
        (probe-count gui.bench.metal.leaf-renderer-allocations-10k (. renderer renderer-allocations))
      )
    )
    (= result (+ maximum-chunks maximum-cull-tests (. scene items-encoded)))
  )
  (blank)
  (call (. scene close))
  (call release-scene-bench-root root)
  (return result)
)

(fn-do + run-metal-scroll-10k _
  (let root (call SceneBenchRoot))
  (let viewport (call SceneBenchScroll))
  (call markup-append root viewport)
  (for (in index (..< 0 10000))
    (call markup-append viewport (call SceneBenchScrollCell))
  )
  (call mount-scene-bench-root root (call Rect 0 0 1200 320))
  (let scene (call DisplayScene 2 white))
  (let renderer (call MetalOffscreenRenderer 1200 320 2 white))
  (let reference (call RasterCanvas 1200 320 2 white))
  (let elapsed (list U64))
  (call (. elapsed reserve) 30)
  (let offset F64 1000)
  (let maximum-chunks Size)
  (let rebuilt-chunks Size)
  (do-use renderer
    (do-use reference
      (call (. viewport scroll-to) (call Point 0 offset))
      (call (. scene build) root)
      (call (. scene commit))
      (call (. scene frame-metal) renderer)
      (for (in warmup (..< 0 6))
        (+= offset 10)
        (call (. viewport scroll-to) (call Point 0 offset))
        (call (. scene update) root)
        (call (. scene commit))
        (call (. scene frame-metal) renderer)
      )
      (call (. renderer finish))
      (blank)
      (for (in frame (..< 0 30))
        (+= offset 10)
        (call (. viewport scroll-to) (call Point 0 offset))
        (call (. scene reset-frame-counters))
        (let started (call monotonic-time-nanoseconds))
        (call (. scene update) root)
        (call (. scene commit))
        (call (. scene frame-metal) renderer)
        (+= elapsed (- (call monotonic-time-nanoseconds) started))
        (if (> (. scene chunks-encoded) maximum-chunks)
          (= maximum-chunks (. scene chunks-encoded))
        )
        (+= rebuilt-chunks (. scene chunks-rebuilt))
      )
      (blank)
      (call (. renderer finish))
      (call (. renderer mark-renderer-allocations))
      (+= offset 10)
      (call (. viewport scroll-to) (call Point 0 offset))
      (call (. scene reset-frame-counters))
      (let objects0 (call C:brixGCAllocatedObjectCount))
      (call (. scene update) root)
      (call (. scene commit))
      (call (. scene frame-metal) renderer)
      (let objects (- (call C:brixGCAllocatedObjectCount) objects0))
      (call (. renderer finish))
      (call (. reference erase) white)
      (call (. root paint) reference)
      (let diff (call (. renderer diff) reference))
      (probe-count gui.bench.metal.scroll-p50-ns (call scene-percentile elapsed 50))
      (probe-count gui.bench.metal.scroll-p99-ns (call scene-percentile elapsed 99))
      (probe-count gui.bench.metal.scroll-chunks maximum-chunks)
      (probe-count gui.bench.metal.scroll-rebuilt-chunks rebuilt-chunks)
      (probe-count gui.bench.metal.scroll-objects objects)
      (probe-count gui.bench.metal.scroll-renderer-allocations (. renderer renderer-allocations))
      (probe-count gui.bench.metal.scroll-differing-pixels (as (. diff differing-pixels) U64))
      (probe-count gui.bench.metal.scroll-max-delta (as (. diff maximum-channel-delta) U64))
    )
  )
  (blank)
  (let checksum (+ maximum-chunks rebuilt-chunks (. scene cull-tests)))
  (print (str "bench-result gui/metal-scroll-10k checksum=" checksum))
  (call (. scene close))
  (call release-scene-bench-root root)
)

(fn-do + run-metal-text-mixed _
  (let root (call build-scene-bench-text 61 false))
  (let renderer (call MetalOffscreenRenderer 1200 900 2 white))
  (let scene (call DisplayScene 2 white renderer))
  (let reference (call RasterCanvas 1200 900 2 white))
  (let elapsed (list U64))
  (call (. elapsed reserve) 30)
  (let objects U64)
  (let diff MetalPixelDiff)
  (let checksum Size)
  (do-use renderer
    (do-use reference
      (call (. scene build) root)
      (call (. scene commit))
      (call (. scene frame-metal) renderer)
      (for (in warmup (..< 0 6))
        (call (. scene add-damage) (. root bounds))
        (call (. scene frame-metal) renderer)
      )
      (call (. renderer finish))
      (blank)
      (for (in frame (..< 0 30))
        (call (. scene add-damage) (. root bounds))
        (let started (call monotonic-time-nanoseconds))
        (call (. scene frame-metal) renderer)
        (+= elapsed (- (call monotonic-time-nanoseconds) started))
      )
      (call (. renderer finish))
      (blank)
      (call (. renderer mark-renderer-allocations))
      (call (. scene add-damage) (. root bounds))
      (let objects0 (call C:brixGCAllocatedObjectCount))
      (call (. scene frame-metal) renderer)
      (= objects (- (call C:brixGCAllocatedObjectCount) objects0))
      (call (. renderer finish))
      (call (. root paint) reference)
      (= diff (call (. renderer diff) reference))
      (blank)
      (probe-count gui.gpu.glyph-atlas-bytes (. renderer glyph-atlas-bytes))
      (probe-count gui.gpu.glyph-atlas-uploads (. renderer glyph-atlas-uploads))
      (probe-count gui.gpu.glyph-atlas-evictions (. renderer glyph-atlas-evictions))
      (probe-count gui.bench.metal.text-cpu-p50-ns (call scene-percentile elapsed 50))
      (probe-count gui.bench.metal.text-draw-calls (as (. renderer draw-calls) U64))
      (probe-count gui.bench.metal.text-glyph-atlas-bytes (. renderer glyph-atlas-bytes))
      (probe-count gui.bench.metal.text-glyph-uploads (. renderer glyph-atlas-uploads))
      (probe-count gui.bench.metal.text-glyph-evictions (. renderer glyph-atlas-evictions))
      (probe-count gui.bench.metal.text-run-count (. renderer run-count))
      (probe-count gui.bench.metal.text-width-delta-micros text-width-delta
        (block
          (lazy text-width-delta (as (call round (* (. renderer maximum-run-width-delta) 1000000)) U64))
        )
      )
      (probe-count gui.bench.metal.text-diff-ppm (as (call round (* (. diff differing-ratio) 1000000)) U64))
      (probe-count gui.bench.metal.text-renderer-allocations (. renderer renderer-allocations))
      (probe-count gui.bench.metal.text-gc-objects objects)
      (= checksum (. renderer run-count))
      (+= checksum (as (. diff differing-pixels) Size))
      (call (. scene close))
    )
  )
  (blank)
  (print (str "bench-result gui/metal-text-mixed checksum=" checksum))
  (call release-scene-bench-root root)
)

(fn-do + run-metal-atlas-pressure _
  (let renderer (call MetalOffscreenRenderer 1200 900 1 white))
  (let reference (call RasterCanvas 1200 900 1 white))
  (let roots (list SceneBenchRoot))
  (let scenes (list DisplayScene))
  (let probe-items (list DisplayItem))
  (let probe-clips (list Rect))
  (let probe-palette (list U32))
  (let probe-shapes (list DisplayShape))
  (let probe-handle (? DisplayGlyphHandle))
  (let upload-total I64)
  (let fallback-total I64)
  (let diff MetalPixelDiff)
  (let checksum Size)
  (do-use renderer
    (do-use reference
      (for (in group (..< 0 4))
        (let root (call build-scene-bench-text 16 true (* group 16)))
        (let scene (call DisplayScene 1 white renderer))
        (+= roots root)
        (+= scenes scene)
        (call (. scene build) root)
        (call (. scene commit))
        (call (. scene frame-metal) renderer)
        (+= upload-total (. renderer glyph-atlas-uploads))
        (+= fallback-total (. renderer fallback-runs))
      )
      (= probe-handle
        (call (. renderer register-display-glyph)
          (block
            (arg (. ([] scene-bench-text-cells (- (. scene-bench-text-cells length) 1)) text-layout))
          )
        )
      )
      (throw (call Panic "Unable to retain pressure-probe glyph run") (if (not probe-handle)))
      (for (in frame (..< 0 80))
        (let group (% frame 4))
        (let subpixel (* (as (% frame 4) F32) 0.25))
        (call (. probe-items clear))
        (+= probe-items
          (call DisplayItem
            (block
              (arg 2)
              (arg 2)
              (arg 0)
              (arg subpixel)
              (arg (as (* group 225) F32))
              (arg 1200)
              (arg 225)
              (arg 0)
              (arg (. probe-handle index))
              (arg (. probe-handle generation))
              (arg (call pack-rgba8 (call RGBA "#1f2937")))
              (arg 0)
            )
          )
        )
        (call (. renderer begin-packet))
        (call (. renderer append-items)
          (block
            (arg (. probe-items buffer-pointer))
            (arg (. probe-items length))
            (arg (. probe-clips buffer-pointer))
            (arg (. probe-clips length))
            (arg (. probe-palette buffer-pointer))
            (arg (. probe-palette length))
            (arg (. probe-shapes buffer-pointer))
            (arg (. probe-shapes length))
          )
        )
        (let probe-frame
          (call (. renderer commit-packet)
            (block
              (arg 1)
              (arg (call Rect 0 (as (* group 225) F64) 1200 225))
            )
          )
        )
        (throw (call Panic "Unable to commit pressure-probe packet") (if (< probe-frame 0)))
        (+= upload-total (. renderer glyph-atlas-uploads))
        (+= fallback-total (. renderer fallback-runs))
        (call (. ([] scenes group) add-damage) (. ([] roots group) bounds))
        (call (. ([] scenes group) frame-metal) renderer)
        (+= upload-total (. renderer glyph-atlas-uploads))
        (+= fallback-total (. renderer fallback-runs))
      )
      (call (. renderer finish))
      (blank)
      (for (in group (..< 0 4))
        (call (. ([] scenes group) add-damage) (. ([] roots group) bounds))
        (call (. ([] scenes group) frame-metal) renderer)
        (+= upload-total (. renderer glyph-atlas-uploads))
        (+= fallback-total (. renderer fallback-runs))
      )
      (call (. renderer finish))
      (for (in root roots)
        (call (. root paint) reference)
      )
      (= diff (call (. renderer diff) reference))
      (call (. renderer release-display-glyph) probe-handle)
      (blank)
      (probe-count gui.gpu.glyph-atlas-bytes (. renderer glyph-atlas-bytes))
      (probe-count gui.gpu.glyph-atlas-uploads upload-total)
      (probe-count gui.gpu.glyph-atlas-evictions (. renderer glyph-atlas-evictions))
      (probe-count gui.bench.metal.pressure-glyph-atlas-bytes (. renderer glyph-atlas-bytes))
      (probe-count gui.bench.metal.pressure-glyph-uploads upload-total)
      (probe-count gui.bench.metal.pressure-glyph-evictions (. renderer glyph-atlas-evictions))
      (probe-count gui.bench.metal.pressure-fallback-runs fallback-total)
      (probe-count gui.bench.metal.pressure-run-count (. renderer run-count))
      (probe-count gui.bench.metal.pressure-diff-ppm (as (call round (* (. diff differing-ratio) 1000000)) U64))
      (= checksum upload-total)
      (+= checksum (as (. renderer glyph-atlas-evictions) Size))
      (for (in scene scenes)
        (call (. scene close))
      )
    )
  )
  (blank)
  (print (str "bench-result gui/metal-atlas-pressure checksum=" checksum))
  (for (in root roots)
    (call release-scene-bench-root root)
  )
)

(fn-do + run-metal-vector-shared _
  (let root (call build-scene-bench-vectors 1000))
  (let renderer (call MetalOffscreenRenderer 1200 240 2 white))
  (let scene (call DisplayScene 2 white renderer))
  (let reference (call RasterCanvas 1200 240 2 white))
  (let elapsed (list U64))
  (call (. elapsed reserve) 30)
  (let diff MetalPixelDiff)
  (let initial-draw-calls I64)
  (let checksum Size)
  (do-use renderer
    (do-use reference
      (call (. scene build) root)
      (call (. scene commit))
      (call (. scene frame-metal) renderer)
      (for (in warmup (..< 0 6))
        (call (. scene add-damage) (. root bounds))
        (call (. scene frame-metal) renderer)
      )
      (call (. renderer finish))
      (blank)
      (for (in frame (..< 0 30))
        (call (. scene add-damage) (. root bounds))
        (let started (call monotonic-time-nanoseconds))
        (call (. scene frame-metal) renderer)
        (+= elapsed (- (call monotonic-time-nanoseconds) started))
      )
      (call (. renderer finish))
      (call (. renderer mark-renderer-allocations))
      (call (. scene add-damage) (. root bounds))
      (call (. scene frame-metal) renderer)
      (call (. renderer finish))
      (= initial-draw-calls (. renderer draw-calls))
      (call (. root paint) reference)
      (= diff (call (. renderer diff) reference))
      (blank)
      (probe-count gui.bench.metal.vector-cpu-p50-ns (call scene-percentile elapsed 50))
      (probe-count gui.bench.metal.vector-draw-calls initial-draw-calls)
      (probe-count gui.bench.metal.vector-diff-ppm (as (call round (* (. diff differing-ratio) 1000000)) U64))
      (probe-count gui.bench.metal.vector-renderer-allocations (. renderer renderer-allocations))
      (= checksum initial-draw-calls)
      (call (. scene close))
    )
  )
  (blank)
  (print (str "bench-result gui/metal-vector-shared checksum=" checksum))
  (call release-scene-bench-root root)
)

(fn-do + run-metal-shapes-1k _
  (let root (call SceneBenchRoot))
  (for (in row-index (..< 0 20))
    (let row (call SceneBenchRow))
    (call markup-append root row)
    (for (in cell-index (..< 0 50))
      (let cell (call SceneBenchShapeCell))
      (= (. cell is-callout) (== (% (+ row-index cell-index) 4) 0))
      (call markup-append row cell)
    )
  )
  (call mount-scene-bench-root root (call Rect 0 0 1200 900))
  (let scene (call DisplayScene 2 white))
  (let renderer (call MetalOffscreenRenderer 1200 900 2 white))
  (let reference (call RasterCanvas 1200 900 2 white))
  (let elapsed (list U64))
  (let gpu (list U64))
  (let checksum Size)
  (do-use renderer
    (do-use reference
      (call (. scene build) root)
      (call (. scene commit))
      (call (. scene frame-metal) renderer)
      (for (in warmup (..< 0 6))
        (call (. scene add-damage) (. root bounds))
        (call (. scene frame-metal) renderer)
      )
      (call (. renderer finish))
      (for (in frame (..< 0 30))
        (call (. scene add-damage) (. root bounds))
        (let started (call monotonic-time-nanoseconds))
        (call (. scene frame-metal) renderer)
        (+= elapsed (- (call monotonic-time-nanoseconds) started))
        (call (. renderer finish))
        (if (>= (. renderer gpu-nanos) 0)
          (+= gpu (as (. renderer gpu-nanos) U64))
        )
      )
      (call (. root paint) reference)
      (let diff (call (. renderer diff) reference))
      (probe-count gui.bench.metal.frame-count 1000)
      (probe-count gui.bench.metal.frame-cpu-p50-ns (call scene-percentile elapsed 50))
      (probe-count gui.bench.metal.frame-cpu-p99-ns (call scene-percentile elapsed 99))
      (probe-count gui.bench.metal.frame-gpu-p50-ns (call scene-percentile gpu 50))
      (probe-count gui.bench.metal.frame-draw-calls (as (. renderer draw-calls) U64))
      (probe-count gui.bench.metal.frame-pipeline-switches (as (. renderer pipeline-switches) U64))
      (probe-count gui.bench.metal.frame-packet-bytes (as (. renderer packet-bytes) U64))
      (probe-count gui.bench.metal.frame-differing-pixels (as (. diff differing-pixels) U64))
      (probe-count gui.bench.metal.frame-max-delta (as (. diff maximum-channel-delta) U64))
      (throw (call Panic "Shaped boxes fell back to opaque tiles") (if (!= (. scene opaque-demotions) 0)))
      (throw (call Panic "Shaped boxes skipped Metal operations") (if (!= (. renderer skipped-ops) 0)))
      (= checksum (+ (. scene items-encoded) (as (. renderer draw-calls) Size)))
    )
  )
  (call (. scene close))
  (call release-scene-bench-root root)
  (print (str "bench-result gui/metal-shapes-1k checksum=" checksum))
)

(fn-do + run-metal-gradients _
  (let root (call SceneBenchRoot))
  (for (in row-index (..< 0 25))
    (let row (call SceneBenchRow))
    (call markup-append root row)
    (for (in cell-index (..< 0 25))
      (call markup-append row (call SceneBenchGradientCell (+ (* row-index 25) cell-index)))
    )
  )
  (call mount-scene-bench-root root (call Rect 0 0 1200 900))
  (let scene (call DisplayScene 2 white))
  (let renderer (call MetalOffscreenRenderer 1200 900 2 white))
  (let reference (call RasterCanvas 1200 900 2 white))
  (let elapsed (list U64))
  (let gpu (list U64))
  (let checksum Size)
  (do-use renderer
    (do-use reference
      (call (. scene build) root)
      (call (. scene commit))
      (call (. scene frame-metal) renderer)
      (for (in warmup (..< 0 6))
        (call (. scene add-damage) (. root bounds))
        (call (. scene frame-metal) renderer)
      )
      (call (. renderer finish))
      (for (in frame (..< 0 30))
        (call (. scene add-damage) (. root bounds))
        (let started (call monotonic-time-nanoseconds))
        (call (. scene frame-metal) renderer)
        (+= elapsed (- (call monotonic-time-nanoseconds) started))
        (call (. renderer finish))
        (if (>= (. renderer gpu-nanos) 0)
          (+= gpu (as (. renderer gpu-nanos) U64))
        )
      )
      (call (. root paint) reference)
      (let diff (call (. renderer diff) reference 2))
      (let gross (call (. renderer diff) reference 10))
      (probe-count gui.bench.metal.frame-count 625)
      (probe-count gui.bench.metal.frame-cpu-p50-ns (call scene-percentile elapsed 50))
      (probe-count gui.bench.metal.frame-cpu-p99-ns (call scene-percentile elapsed 99))
      (probe-count gui.bench.metal.frame-gpu-p50-ns (call scene-percentile gpu 50))
      (probe-count gui.bench.metal.frame-draw-calls (as (. renderer draw-calls) U64))
      (probe-count gui.bench.metal.frame-pipeline-switches (as (. renderer pipeline-switches) U64))
      (probe-count gui.bench.metal.frame-packet-bytes (as (. renderer packet-bytes) U64))
      (probe-count gui.bench.metal.frame-differing-pixels (as (. diff differing-pixels) U64))
      (probe-count gui.bench.metal.frame-max-delta (as (. diff maximum-channel-delta) U64))
      (throw (call Panic "Gradients fell back to opaque tiles") (if (or (!= (. scene opaque-demotions) 0) (!= (. scene metal-tile-fallbacks) 0))))
      (throw (call Panic "Gradients skipped Metal operations") (if (!= (. renderer skipped-ops) 0)))
      (throw (call Panic "Gradients differ from CoreGraphics beyond GR-D13") (if (> (* (. gross differing-pixels) 10000) (. gross pixel-count))))
      (= checksum (+ (. scene items-encoded) (as (. renderer draw-calls) Size)))
    )
  )
  (call (. scene close))
  (call release-scene-bench-root root)
  (print (str "bench-result gui/metal-gradients checksum=" checksum))
)

(fn-do + run-metal-fill-shaders _
  (let root (call SceneBenchRoot))
  (let cells (list SceneBenchShaderCell))
  (for (in row-index (..< 0 25))
    (let row (call SceneBenchRow))
    (call markup-append root row)
    (for (in cell-index (..< 0 25))
      (let cell (call SceneBenchShaderCell (+ (* row-index 25) cell-index)))
      (+= cells cell)
      (call markup-append row cell)
    )
  )
  (call mount-scene-bench-root root (call Rect 0 0 1200 900))
  (let scene (call DisplayScene 2 white))
  (let renderer (call MetalOffscreenRenderer 1200 900 2 white))
  (let reference (call RasterCanvas 1200 900 2 white))
  (let elapsed (list U64))
  (let gpu (list U64))
  (let animated (list U64))
  (let checksum Size)
  (do-use renderer
    (do-use reference
      (call (. scene build) root)
      (call (. scene commit))
      (call (. scene frame-metal) renderer)
      (for (in warmup (..< 0 6))
        (call (. scene add-damage) (. root bounds))
        (call (. scene frame-metal) renderer)
      )
      (call (. renderer finish))
      (for (in frame (..< 0 30))
        (call (. scene add-damage) (. root bounds))
        (let started (call monotonic-time-nanoseconds))
        (call (. scene frame-metal) renderer)
        (+= elapsed (- (call monotonic-time-nanoseconds) started))
        (call (. renderer finish))
        (if (>= (. renderer gpu-nanos) 0)
          (+= gpu (as (. renderer gpu-nanos) U64))
        )
      )
      (call (. root paint) reference)
      (let diff (call (. renderer diff) reference 2))
      (let gross (call (. renderer diff) reference 10))
      (probe-count gui.bench.metal.frame-count 625)
      (probe-count gui.bench.metal.frame-cpu-p50-ns (call scene-percentile elapsed 50))
      (probe-count gui.bench.metal.frame-cpu-p99-ns (call scene-percentile elapsed 99))
      (probe-count gui.bench.metal.frame-gpu-p50-ns (call scene-percentile gpu 50))
      (probe-count gui.bench.metal.frame-draw-calls (as (. renderer draw-calls) U64))
      (probe-count gui.bench.metal.frame-pipeline-switches (as (. renderer pipeline-switches) U64))
      (probe-count gui.bench.metal.frame-packet-bytes (as (. renderer packet-bytes) U64))
      (probe-count gui.bench.metal.frame-differing-pixels (as (. diff differing-pixels) U64))
      (probe-count gui.bench.metal.frame-max-delta (as (. diff maximum-channel-delta) U64))
      (throw (call Panic "Fill shaders fell back to opaque tiles") (if (or (!= (. scene opaque-demotions) 0) (!= (. scene metal-tile-fallbacks) 0))))
      (throw (call Panic "Fill shaders skipped Metal operations") (if (!= (. renderer skipped-ops) 0)))
      (throw (call Panic "Fill shaders differ from CoreGraphics beyond GR-D13") (if (> (* (. gross differing-pixels) 10000) (. gross pixel-count))))
      (= checksum (+ (. scene items-encoded) (as (. renderer draw-calls) Size)))
      (for (in frame (..< 0 36))
        (for (in cell cells)
          (= (. cell phase) (* (as frame F64) 0.2))
          (call (. cell invalidate-paint))
        )
        (let started (call monotonic-time-nanoseconds))
        (call (. scene update) root)
        (call (. scene commit))
        (call (. scene frame-metal) renderer)
        (if (>= frame 6)
          (+= animated (- (call monotonic-time-nanoseconds) started))
        )
        (call (. renderer finish))
      )
      (probe-count gui.bench.metal.shader-anim-cpu-p50-ns (call scene-percentile animated 50))
      (probe-count gui.bench.metal.shader-anim-cpu-p99-ns (call scene-percentile animated 99))
      (throw (call Panic "Animated fill shaders skipped Metal operations") (if (!= (. renderer skipped-ops) 0)))
    )
  )
  (call (. scene close))
  (call release-scene-bench-root root)
  (print (str "bench-result gui/metal-fill-shaders checksum=" checksum))
)

(fn-do + run-metal-box-filters _
  (let root (call SceneBenchRoot))
  (let frame (call SceneBenchFilterFrame))
  (call markup-append root frame)
  (for (in row-index (..< 0 25))
    (let row (call SceneBenchRow))
    (call markup-append frame row)
    (for (in cell-index (..< 0 25))
      (let cell (call SceneBenchGroundCell (+ (* row-index 25) cell-index)))
      (if (== cell-index row-index)
        (= (. cell filters) (list (call Pixelate 4)))
      )
      (call markup-append row cell)
    )
  )
  (= (. frame filters) (list (call CRT)))
  (call mount-scene-bench-root root (call Rect 0 0 1200 900))
  (let scene (call DisplayScene 2 white))
  (let renderer (call MetalOffscreenRenderer 1200 900 2 white))
  (let reference (call RasterCanvas 1200 900 2 white))
  (let elapsed (list U64))
  (let gpu (list U64))
  (let animated (list U64))
  (let animated-gpu (list U64))
  (let checksum Size)
  (do-use renderer
    (do-use reference
      (call (. scene build) root)
      (call (. scene commit))
      (call (. scene frame-metal) renderer)
      (for (in warmup (..< 0 6))
        (call (. scene add-damage) (. root bounds))
        (call (. scene frame-metal) renderer)
      )
      (call (. renderer finish))
      (for (in index (..< 0 30))
        (call (. scene add-damage) (. root bounds))
        (let started (call monotonic-time-nanoseconds))
        (call (. scene frame-metal) renderer)
        (+= elapsed (- (call monotonic-time-nanoseconds) started))
        (call (. renderer finish))
        (if (>= (. renderer gpu-nanos) 0)
          (+= gpu (as (. renderer gpu-nanos) U64))
        )
      )
      (call (. root paint) reference)
      (let diff (call (. renderer diff) reference 2))
      (let gross (call (. renderer diff) reference 10))
      (probe-count gui.bench.metal.frame-count 625)
      (probe-count gui.bench.metal.frame-cpu-p50-ns (call scene-percentile elapsed 50))
      (probe-count gui.bench.metal.frame-cpu-p99-ns (call scene-percentile elapsed 99))
      (probe-count gui.bench.metal.frame-gpu-p50-ns (call scene-percentile gpu 50))
      (probe-count gui.bench.metal.frame-draw-calls (as (. renderer draw-calls) U64))
      (probe-count gui.bench.metal.frame-pipeline-switches (as (. renderer pipeline-switches) U64))
      (probe-count gui.bench.metal.frame-packet-bytes (as (. renderer packet-bytes) U64))
      (probe-count gui.bench.metal.frame-differing-pixels (as (. diff differing-pixels) U64))
      (probe-count gui.bench.metal.frame-max-delta (as (. diff maximum-channel-delta) U64))
      (throw (call Panic "Box filters fell back to opaque tiles") (if (or (!= (. scene opaque-demotions) 0) (!= (. scene metal-tile-fallbacks) 0))))
      (throw (call Panic "Box filters skipped Metal operations") (if (!= (. renderer skipped-ops) 0)))
      (throw (call Panic "Box filters differ from CoreGraphics beyond GR-D13") (if (> (* (. gross differing-pixels) 10000) (. gross pixel-count))))
      (= checksum (+ (. scene items-encoded) (as (. renderer draw-calls) Size)))
      (for (in index (..< 0 36))
        (= (. frame filters) (list (call CRT (+ 0.08 (/ (as index F64) 600)))))
        (call (. root markup-batch-queue checkpoint))
        (let started (call monotonic-time-nanoseconds))
        (call (. scene update) root)
        (call (. scene commit))
        (call (. scene frame-metal) renderer)
        (if (>= index 6)
          (+= animated (- (call monotonic-time-nanoseconds) started))
        )
        (call (. renderer finish))
        (if (and (>= index 6) (>= (. renderer gpu-nanos) 0))
          (+= animated-gpu (as (. renderer gpu-nanos) U64))
        )
      )
      (probe-count gui.bench.metal.filter-anim-cpu-p50-ns (call scene-percentile animated 50))
      (probe-count gui.bench.metal.filter-anim-cpu-p99-ns (call scene-percentile animated 99))
      (probe-count gui.bench.metal.filter-anim-gpu-p50-ns (call scene-percentile animated-gpu 50))
      (throw (call Panic "Animated box filters skipped Metal operations") (if (!= (. renderer skipped-ops) 0)))
    )
  )
  (call (. scene close))
  (call release-scene-bench-root root)
  (print (str "bench-result gui/metal-box-filters checksum=" checksum))
)

(fn-do _ scene-bench-shaders _
  (if (not scene-bench-shader-cache)
    (= scene-bench-shader-cache
      (block
        (item (call Shader (call scene-bench-rings-source)))
        (item (call Shader (call scene-bench-checker-source)))
        (item (call Shader (call scene-bench-plasma-source)))
        (item (call Shader (call scene-bench-vignette-source)))
      )
    )
  )
  (return scene-bench-shader-cache)
)

(fn-expr _ scene-bench-rings-source _
  (paragraph
    "float4 shade(float2 position, float2 size, ShaderArgs args) {"
    "    float d = length(position - size * 0.5);"
    "    return float4(0.5 + 0.5 * sin(d * args[0] * 0.25 + args[1]), 0.4, 0.7, 1.0);"
    "}"
  )
)

(fn-expr _ scene-bench-checker-source _
  (paragraph
    "float4 shade(float2 position, float2 size, ShaderArgs args) {"
    "    float2 cell = floor((position + args[1]) / args[0]);"
    "    float on = fmod(abs(cell.x + cell.y), 2.0);"
    "    return float4(on, 0.6, 1.0 - on, 0.85);"
    "}"
  )
)

(fn-expr _ scene-bench-plasma-source _
  (paragraph
    "float4 shade(float2 position, float2 size, ShaderArgs args) {"
    "    float2 uv = position / size;"
    "    float v = sin(uv.x * 9.0 + args[1]) + sin(uv.y * 7.0 - args[1])"
    "        + sin((uv.x + uv.y) * args[0]);"
    "    return float4(0.5 + 0.5 * sin(v), 0.5 + 0.5 * cos(v), 0.8, 1.0);"
    "}"
  )
)

(fn-expr _ scene-bench-vignette-source _
  (paragraph
    "float4 shade(float2 position, float2 size, ShaderArgs args) {"
    "    float2 uv = position / size - 0.5;"
    "    float edge = smoothstep(0.1, 0.7, length(uv) + 0.05 * sin(args[1]));"
    "    return float4(args[0] / 9.0, 0.3, 0.6, edge);"
    "}"
  )
)

(fn-do + run-metal-images _
  (let photo (call scene-bench-photo 36 24))
  (let small (call scene-bench-photo 24 16))
  (let icon (call RasterCanvas 16 16 2 transparent))
  (= (. icon fill-color) (call RGBA 0 0 0 1))
  (call (. icon oval) (call Rect 1 1 14 14))
  (= (. icon fill-color) (call RGBA 0 0 0 0.4))
  (call (. icon rect) (call Rect 4 4 8 8))
  (let root (call SceneBenchRoot))
  (for (in row-index (..< 0 25))
    (let row (call SceneBenchRow))
    (call markup-append root row)
    (for (in cell-index (..< 0 25))
      (call markup-append row (call SceneBenchImageCell (+ (* row-index 25) cell-index) photo small icon))
    )
  )
  (call run-metal-paint-grid "metal-images" root)
  (call (. photo close))
  (call (. small close))
  (call (. icon close))
)

(fn-do + run-metal-masks _
  (let mask (call RasterCanvas 36 24 2 transparent))
  (call (. mask fill-gradient)
    (block
      (arg (call Rect 0 0 36 24))
      (arg (call linear-gradient (call Point 0 0) (call Point 36 0) (call RGBA 0 0 0 1) (call RGBA 0 0 0 0.15)))
    )
  )
  (= (. mask fill-color) (call RGBA 0 0 0 1))
  (call (. mask oval) (call Rect 18 2 16 16))
  (let photo (call scene-bench-photo 36 24))
  (let root (call SceneBenchRoot))
  (for (in row-index (..< 0 25))
    (let row (call SceneBenchRow))
    (call markup-append root row)
    (for (in cell-index (..< 0 25))
      (call markup-append row (call SceneBenchMaskCell (+ (* row-index 25) cell-index) mask photo))
    )
  )
  (call run-metal-paint-grid "metal-masks" root)
  (call (. mask close))
  (call (. photo close))
)

(fn-do + run-metal-layer-masks _
  (let photo (call scene-bench-photo 36 24))
