+ do run-metal-frame-anatomy-10k

. checksum = run-metal-frame-anatomy(10000)
-- "bench-result gui/metal-frame-anatomy-10k checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ do run-metal-frame-anatomy Size
    - count Size

. root = build-scene-bench-grid(count)
. scene = DisplayScene(2, white)
. renderer = MetalOffscreenRenderer(1200, 900, 2, white)
. reference = RasterCanvas(1200, 900, 2, white)
. elapsed [U64]
. gpu [U64]
. idle [U64]
. result Size
elapsed.reserve(30)
gpu.reserve(30)
idle.reserve(1000)
do use renderer
    do use reference
        scene.build(root)
        scene.commit()
        scene.frame-metal(renderer)
        for warmup in 0 .. < 6
            scene.add-damage(root.bounds)
            scene.frame-metal(renderer)
        renderer.finish()

        for frame in 0 .. < 30
            scene.add-damage(root.bounds)
            . started = monotonic-time-nanoseconds()
            scene.frame-metal(renderer)
            elapsed += monotonic-time-nanoseconds() - started
            renderer.finish()
            if renderer.gpu-nanos >= 0
                gpu += renderer.gpu-nanos as U64

        renderer.finish()
        renderer.mark-renderer-allocations()
        scene.add-damage(root.bounds)
        . objects0 = C:brixGCAllocatedObjectCount()
        scene.frame-metal(renderer)
        . objects = C:brixGCAllocatedObjectCount() - objects0
        renderer.finish()

        . commits = renderer.commits
        for frame in 0 .. < 1000
            . started = monotonic-time-nanoseconds()
            scene.frame-metal(renderer)
            idle += monotonic-time-nanoseconds() - started
        . idle-commits = renderer.commits - commits

        root.paint(reference)
        . diff = renderer.diff(reference)
        //gui.bench.metal.frame-count += count
        //gui.bench.metal.frame-cpu-p50-ns += scene-percentile(elapsed, 50)
        //gui.bench.metal.frame-cpu-p99-ns += scene-percentile(elapsed, 99)
        //gui.bench.metal.frame-gpu-p50-ns += scene-percentile(gpu, 50)
        //gui.bench.metal.frame-draw-calls += renderer.draw-calls as U64
        //gui.bench.metal.frame-pipeline-switches += renderer.pipeline-switches as U64
        //gui.bench.metal.frame-packet-bytes += renderer.packet-bytes as U64
        //gui.bench.metal.frame-renderer-allocations += renderer.renderer-allocations
        //gui.bench.metal.frame-gc-objects += objects
        //gui.bench.metal.frame-differing-pixels += diff.differing-pixels as U64
        //gui.bench.metal.frame-max-delta += diff.maximum-channel-delta as U64
        //gui.bench.metal.idle-p50-ns += scene-percentile(idle, 50)
        //gui.bench.metal.idle-commits += idle-commits
        result = (renderer.packet-bytes as Size) + (renderer.draw-calls as Size)
        result += scene.items-encoded

scene.close()
release-scene-bench-root(root)
= result

