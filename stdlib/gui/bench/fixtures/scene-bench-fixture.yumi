+ do run-metal-fill-shaders

. root = SceneBenchRoot()
. cells [SceneBenchShaderCell]
for row-index in 0 .. < 25
    . row = SceneBenchRow()
    markup-append(root, row)
    for cell-index in 0 .. < 25
        . cell = SceneBenchShaderCell(row-index * 25 + cell-index)
        cells += cell
        markup-append(row, cell)
mount-scene-bench-root(root, Rect(0, 0, 1200, 900))
. scene = DisplayScene(2, white)
. renderer = MetalOffscreenRenderer(1200, 900, 2, white)
. reference = RasterCanvas(1200, 900, 2, white)
. elapsed [U64]
. gpu [U64]
. animated [U64]
. checksum Size
do use renderer
    do use reference
        scene.build(root)
        scene.commit()
        scene.frame-metal(renderer)
        for warmup in 0 .. < 6
            scene.add-damage(root.bounds)
            scene.frame-metal(renderer)
        renderer.finish()
        for frame in 0 .. < 30
            scene.add-damage(root.bounds)
            . started = monotonic-time-nanoseconds()
            scene.frame-metal(renderer)
            elapsed += monotonic-time-nanoseconds() - started
            renderer.finish()
            if renderer.gpu-nanos >= 0
                gpu += renderer.gpu-nanos as U64
        root.paint(reference)
        . diff = renderer.diff(reference, 2)
        . gross = renderer.diff(reference, 10)
        //gui.bench.metal.frame-count += 625
        //gui.bench.metal.frame-cpu-p50-ns += scene-percentile(elapsed, 50)
        //gui.bench.metal.frame-cpu-p99-ns += scene-percentile(elapsed, 99)
        //gui.bench.metal.frame-gpu-p50-ns += scene-percentile(gpu, 50)
        //gui.bench.metal.frame-draw-calls += renderer.draw-calls as U64
        //gui.bench.metal.frame-pipeline-switches += renderer.pipeline-switches as U64
        //gui.bench.metal.frame-packet-bytes += renderer.packet-bytes as U64
        //gui.bench.metal.frame-differing-pixels += diff.differing-pixels as U64
        //gui.bench.metal.frame-max-delta += diff.maximum-channel-delta as U64
        ?! Panic("Fill shaders fell back to opaque tiles")
            if scene.opaque-demotions != 0 || scene.metal-tile-fallbacks != 0
        ?! Panic("Fill shaders skipped Metal operations")
            if renderer.skipped-ops != 0
        ?! Panic("Fill shaders differ from CoreGraphics beyond GR-D13")
            if gross.differing-pixels * 10000 > gross.pixel-count
        checksum = scene.items-encoded + (renderer.draw-calls as Size)
        for frame in 0 .. < 36
            for cell in cells
                cell.phase = (frame as F64) * 0.2
                cell.invalidate-paint()
            . started = monotonic-time-nanoseconds()
            scene.update(root)
            scene.commit()
            scene.frame-metal(renderer)
            if frame >= 6
                animated += monotonic-time-nanoseconds() - started
            renderer.finish()
        //gui.bench.metal.shader-anim-cpu-p50-ns += scene-percentile(animated, 50)
        //gui.bench.metal.shader-anim-cpu-p99-ns += scene-percentile(animated, 99)
        ?! Panic("Animated fill shaders skipped Metal operations")
            if renderer.skipped-ops != 0
scene.close()
release-scene-bench-root(root)
-- "bench-result gui/metal-fill-shaders checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
+ do run-metal-box-filters

. root = SceneBenchRoot()
. frame = SceneBenchFilterFrame()
markup-append(root, frame)
for row-index in 0 .. < 25
    . row = SceneBenchRow()
    markup-append(frame, row)
    for cell-index in 0 .. < 25
        . cell = SceneBenchGroundCell(row-index * 25 + cell-index)
        if cell-index == row-index
            cell.filters = [Pixelate(4)]
        markup-append(row, cell)
frame.filters = [CRT()]
mount-scene-bench-root(root, Rect(0, 0, 1200, 900))
. scene = DisplayScene(2, white)
. renderer = MetalOffscreenRenderer(1200, 900, 2, white)
. reference = RasterCanvas(1200, 900, 2, white)
. elapsed [U64]
. gpu [U64]
. animated [U64]
. animated-gpu [U64]
. checksum Size
do use renderer
    do use reference
        scene.build(root)
        scene.commit()
        scene.frame-metal(renderer)
        for warmup in 0 .. < 6
            scene.add-damage(root.bounds)
            scene.frame-metal(renderer)
        renderer.finish()
        for index in 0 .. < 30
            scene.add-damage(root.bounds)
            . started = monotonic-time-nanoseconds()
            scene.frame-metal(renderer)
            elapsed += monotonic-time-nanoseconds() - started
            renderer.finish()
            if renderer.gpu-nanos >= 0
                gpu += renderer.gpu-nanos as U64
        root.paint(reference)
        . diff = renderer.diff(reference, 2)
        . gross = renderer.diff(reference, 10)
        //gui.bench.metal.frame-count += 625
        //gui.bench.metal.frame-cpu-p50-ns += scene-percentile(elapsed, 50)
        //gui.bench.metal.frame-cpu-p99-ns += scene-percentile(elapsed, 99)
        //gui.bench.metal.frame-gpu-p50-ns += scene-percentile(gpu, 50)
        //gui.bench.metal.frame-draw-calls += renderer.draw-calls as U64
        //gui.bench.metal.frame-pipeline-switches += renderer.pipeline-switches as U64
        //gui.bench.metal.frame-packet-bytes += renderer.packet-bytes as U64
        //gui.bench.metal.frame-differing-pixels += diff.differing-pixels as U64
        //gui.bench.metal.frame-max-delta += diff.maximum-channel-delta as U64
        ?! Panic("Box filters fell back to opaque tiles")
            if scene.opaque-demotions != 0 || scene.metal-tile-fallbacks != 0
        ?! Panic("Box filters skipped Metal operations")
            if renderer.skipped-ops != 0
        ?! Panic("Box filters differ from CoreGraphics beyond GR-D13")
            if gross.differing-pixels * 10000 > gross.pixel-count
        checksum = scene.items-encoded + (renderer.draw-calls as Size)
        for index in 0 .. < 36
            frame.filters = [CRT(0.08 + (index as F64) / 600)]
            root.markup-batch-queue.checkpoint()
            . started = monotonic-time-nanoseconds()
            scene.update(root)
            scene.commit()
            scene.frame-metal(renderer)
            if index >= 6
                animated += monotonic-time-nanoseconds() - started
            renderer.finish()
            if index >= 6 && renderer.gpu-nanos >= 0
                animated-gpu += renderer.gpu-nanos as U64
        //gui.bench.metal.filter-anim-cpu-p50-ns += scene-percentile(animated, 50)
        //gui.bench.metal.filter-anim-cpu-p99-ns += scene-percentile(animated, 99)
        //gui.bench.metal.filter-anim-gpu-p50-ns += scene-percentile(animated-gpu, 50)
        ?! Panic("Animated box filters skipped Metal operations")
            if renderer.skipped-ops != 0
scene.close()
release-scene-bench-root(root)
-- "bench-result gui/metal-box-filters checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ do scene-bench-shaders

if !scene-bench-shader-cache
    scene-bench-shader-cache =
        * Shader(scene-bench-rings-source())
        * Shader(scene-bench-checker-source())
        * Shader(scene-bench-plasma-source())
        * Shader(scene-bench-vignette-source())
= scene-bench-shader-cache

━━━━━━━━━━━━━━━━━━━━
_ " scene-bench-rings-source

float4 shade(float2 position, float2 size, ShaderArgs args) {
    float d = length(position - size * 0.5);
    return float4(0.5 + 0.5 * sin(d * args[0] * 0.25 + args[1]), 0.4, 0.7, 1.0);
}

━━━━━━━━━━━━━━━━━━━━
_ " scene-bench-checker-source

float4 shade(float2 position, float2 size, ShaderArgs args) {
    float2 cell = floor((position + args[1]) / args[0]);
    float on = fmod(abs(cell.x + cell.y), 2.0);
    return float4(on, 0.6, 1.0 - on, 0.85);
}

━━━━━━━━━━━━━━━━━━━━
_ " scene-bench-plasma-source

float4 shade(float2 position, float2 size, ShaderArgs args) {
    float2 uv = position / size;
    float v = sin(uv.x * 9.0 + args[1]) + sin(uv.y * 7.0 - args[1])
        + sin((uv.x + uv.y) * args[0]);
    return float4(0.5 + 0.5 * sin(v), 0.5 + 0.5 * cos(v), 0.8, 1.0);
}

━━━━━━━━━━━━━━━━━━━━
_ " scene-bench-vignette-source

float4 shade(float2 position, float2 size, ShaderArgs args) {
    float2 uv = position / size - 0.5;
    float edge = smoothstep(0.1, 0.7, length(uv) + 0.05 * sin(args[1]));
    return float4(args[0] / 9.0, 0.3, 0.6, edge);
}

