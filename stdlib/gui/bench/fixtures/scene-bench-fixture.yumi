_ SceneBenchGradientCell is Box

+ variant Size

• This • w:40 h:28 mr:4 mb:4

────────────────────
+ This
    - variant

────────────────────
+ do paint-self
    - canvas Canvas

. rect = bounds
. center = rect.center
. stops [GradientStop] =
    * GradientStop(0%%, RGBA(0.9, 0.3, 0.2, 1))
    * GradientStop(0.45%%, RGBA(0.95, 0.85, 0.3, 1))
    * GradientStop(1%%, RGBA(0.2, 0.4, 0.9, 1))
match variant % 6
    |= 0
        canvas.fill-gradient
            - rect
            - linear-gradient
                - rect.top-center
                - rect.bottom-center
                - RGBA(0.96, 0.96, 0.94, 1)
                - RGBA(0.35, 0.37, 0.45, 1)
    |= 1
        canvas.fill-gradient
            - rect
            - LinearGradient(Point(rect.x, rect.y), Point(rect.right, rect.bottom), stops)
    |= 2
        canvas.fill-gradient
            - rect
            - radial-gradient(center, 22, RGBA(1, 1, 0.85, 1), RGBA(0.45, 0.15, 0.35, 1))
    |= 3
        canvas.fill-gradient
            - rect
            - RadialGradient(Point(rect.x + 10, rect.y + 8), 2, center, 24, stops)
    |= 4
        . angle = (variant % 7) * 0.9rad
        canvas.fill-gradient(rect, ConicGradient(center, angle, stops))
    ??
        do use canvas.saved-state
            canvas.transform(Matrix().rotate(0.3rad, center))
            canvas.fill-gradient
                - rect.pad(-4)
                - linear-gradient
                    - rect.left-center
                    - rect.right-center
                    - RGBA(0.1, 0.6, 0.5, 0.2)
                    - RGBA(0.1, 0.6, 0.5, 1)

