run-metal-paint-grid("metal-blend-modes", scene-bench-blend-grid(modes, photo), false)
check-metal-parity("metal-blend-modes", scene-bench-blend-grid(steady-modes, photo))
photo.close()

━━━━━━━━━━━━━━━━━━━━
_ scene-bench-blend-amplifies
    - mode BlendMode

is-dodge-or-burn || mode == BlendMode.hue || mode == BlendMode.saturation

.. is-dodge-or-burn = mode == BlendMode.color-dodge || mode == BlendMode.color-burn

━━━━━━━━━━━━━━━━━━━━
_ do scene-bench-blend-grid
    - modes [BlendMode]
    - photo RasterCanvas

. root = SceneBenchRoot()
for row-index in 0 .. < 25
    . row = SceneBenchRow()
    markup-append(root, row)
    for cell-index in 0 .. < 25
        . index = row-index * 25 + cell-index
        . mode = modes[index % modes.length]
        markup-append(row, SceneBenchBlendCell(mode, (index / modes.length) % 3, photo))
= root

━━━━━━━━━━━━━━━━━━━━
_ do scene-bench-photo
    - width F64
    - height F64

. photo = RasterCanvas(width as I32, height as I32, 2, RGBA(0.95, 0.85, 0.4, 1))
photo.fill-gradient
    - Rect(0, 0, width, height)
    - linear-gradient
        - Point(0, 0)
        - Point(width, height)
        - RGBA(0.9, 0.3, 0.2, 1)
        - RGBA(0.2, 0.4, 0.9, 0.7)
photo.fill-color = RGBA(1, 1, 1, 1)
photo.oval(Rect(width * 0.2, height * 0.2, height * 0.6, height * 0.6))
= photo

━━━━━━━━━━━━━━━━━━━━
_ do run-metal-paint-grid
    - name String
    - root SceneBenchRoot
    - gated Bool = true

mount-scene-bench-root(root, Rect(0, 0, 1200, 900))
. scene = DisplayScene(2, white)
. renderer = MetalOffscreenRenderer(1200, 900, 2, white)
. reference = RasterCanvas(1200, 900, 2, white)
. elapsed [U64]
. gpu [U64]
. checksum Size
do use renderer
    do use reference
        scene.build(root)
        scene.commit()
        scene.frame-metal(renderer)
        for warmup in 0 .. < 6
            scene.add-damage(root.bounds)
            scene.frame-metal(renderer)
        renderer.finish()
        scene.metal-tile-fallbacks = 0
        for frame in 0 .. < 30
            scene.add-damage(root.bounds)
            . started = monotonic-time-nanoseconds()
            scene.frame-metal(renderer)
            elapsed += monotonic-time-nanoseconds() - started
            renderer.finish()
            if renderer.gpu-nanos >= 0
                gpu += renderer.gpu-nanos as U64
        root.paint(reference)
        . diff = renderer.diff(reference, 2)
        . gross = renderer.diff(reference, 10)
        //gui.bench.metal.frame-count += 625
        //gui.bench.metal.frame-cpu-p50-ns += scene-percentile(elapsed, 50)
        //gui.bench.metal.frame-cpu-p99-ns += scene-percentile(elapsed, 99)
        //gui.bench.metal.frame-gpu-p50-ns += scene-percentile(gpu, 50)
        //gui.bench.metal.frame-draw-calls += renderer.draw-calls as U64
        //gui.bench.metal.frame-pipeline-switches += renderer.pipeline-switches as U64
        //gui.bench.metal.frame-packet-bytes += renderer.packet-bytes as U64
        //gui.bench.metal.frame-differing-pixels += diff.differing-pixels as U64
        //gui.bench.metal.frame-max-delta += diff.maximum-channel-delta as U64
        ?! Panic("${name} fell back to opaque tiles")
            if scene.opaque-demotions != 0 || scene.metal-tile-fallbacks != 0
        ?! Panic("${name} skipped Metal operations")
            if renderer.skipped-ops != 0
        ?! Panic("${name} differs from CoreGraphics beyond GR-D13")
            if gated && gross.differing-pixels * 10000 > gross.pixel-count
        checksum = scene.items-encoded + (renderer.draw-calls as Size)
scene.close()
release-scene-bench-root(root)
-- "bench-result gui/${name} checksum=$checksum"

━━━━━━━━━━━━━━━━━━━━
_ do check-metal-parity
    - name String
    - root SceneBenchRoot

mount-scene-bench-root(root, Rect(0, 0, 1200, 900))
. scene = DisplayScene(2, white)
. renderer = MetalOffscreenRenderer(1200, 900, 2, white)
. reference = RasterCanvas(1200, 900, 2, white)
do use renderer
    do use reference
        scene.build(root)
        scene.commit()
        scene.frame-metal(renderer)
        renderer.finish()
        scene.metal-tile-fallbacks = 0
        for warmup in 0 .. < 3
            scene.add-damage(root.bounds)
            scene.frame-metal(renderer)
        renderer.finish()
        root.paint(reference)
        . gross = renderer.diff(reference, 10)
        . fell-back = scene.opaque-demotions != 0 || scene.metal-tile-fallbacks != 0
        ?! Panic("${name} falls back or skips Metal operations")
            if fell-back || renderer.skipped-ops != 0
        ?! Panic("${name} differs from CoreGraphics beyond GR-D13")
            if gross.differing-pixels * 10000 > gross.pixel-count
scene.close()
release-scene-bench-root(root)

━━━━━━━━━━━━━━━━━━━━
_ scene-percentile U64
    - values [U64]
    - percentile Size

|? !values
    0
??
    sorted[index]

.. sorted = sort(values) • using :: left, right => if left < right then .lesser else .greater
.. index = ((sorted.length - 1) * percentile) / 100

━━━━━━━━━━━━━━━━━━━━
_ do build-scene-bench-grid SceneBenchRoot
    - count Size

scene-bench-cells = List'SceneBenchCell()
. root = SceneBenchRoot()
. rows = count / 100
for row-index in 0 .. < rows
    . row = SceneBenchRow()
    markup-append(root, row)
    for cell-index in 0 .. < 100
        . cell = SceneBenchCell()
        scene-bench-cells += cell
        markup-append(row, cell)
mount-scene-bench-root(root, Rect(0, 0, 1200, 900))
= root

━━━━━━━━━━━━━━━━━━━━
_ do build-scene-bench-text
    - count Size
    - pressure Bool
    - pressure-offset Size = 0

scene-bench-text-cells = List'SceneBenchTextCell()
. root = SceneBenchRoot()
for index in 0 .. < count
    . absolute-index = index + pressure-offset
    . font-size F64
    . text String
    . maximum-width F64 = 1200
    if pressure
        font-size = 16.0 + absolute-index * 4
        maximum-width = 2000
        text = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789 !@#$%^&*()[]{}<>?"
    else
        font-size = 11.0 + index % 5
        text = "Retained Metal label $index: quick brown fox 0123456789"
    . cell = SceneBenchTextCell(text, font-size, maximum-width)
    scene-bench-text-cells += cell
    markup-append(root, cell)
. dimensions = Rect(0, 0, 1200, 900)
if pressure
    . group = pressure-offset / 16
    dimensions = Rect(0, (group * 225) as F64, 1200, 225)
mount-scene-bench-root(root, dimensions)
for index in 0 .. < scene-bench-text-cells.length
    if pressure
        . absolute-index = index + pressure-offset
        . group = absolute-index / 16
        . group-index = absolute-index % 16
        . column = group-index % 4
        . row = group-index / 4
        . cell-bounds = Rect
            - (column * 300) as F64
            - (group * 225 + row * 56) as F64
            - 300
            - 56
        scene-bench-text-cells[index].layout(cell-bounds)
    else
        scene-bench-text-cells[index].layout(Rect(0, (index * 14) as F64, 1200, 14))
= root

━━━━━━━━━━━━━━━━━━━━
_ do build-scene-bench-vectors SceneBenchRoot
    - count Size

scene-bench-vector-images = List'SceneBenchSharedVectorImage()
. root = SceneBenchRoot()
for index in 0 .. < count
    . image = SceneBenchSharedVectorImage()
    scene-bench-vector-images += image
    markup-append(root, image)
mount-scene-bench-root(root, Rect(0, 0, 1200, 240))
for index in 0 .. < scene-bench-vector-images.length
    . column = index % 50
    . row = index / 50
    . image-bounds = Rect
        - (column * 24) as F64
        - (row * 12) as F64
        - 24
        - 12
    scene-bench-vector-images[index].layout(image-bounds)
= root

━━━━━━━━━━━━━━━━━━━━
_ do mount-scene-bench-root
    - root SceneBenchRoot
    - rect Rect

markup-mount-root(root, root)
root.markup-batch-queue.checkpoint()
root.layout(rect)

━━━━━━━━━━━━━━━━━━━━
_ do release-scene-bench-root
    - root SceneBenchRoot

root.close()
markup-release(root)

