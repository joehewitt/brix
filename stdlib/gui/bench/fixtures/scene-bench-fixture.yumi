━━━━━━━━━━━━━━━━━━━━
_ do run-metal-leaf-scale Size
    - count Size

. root = build-scene-bench-grid(count)
. scene = DisplayScene(2, white)
. renderer = MetalOffscreenRenderer(1200, 900, 2, white)
. target = scene-bench-cells[scene-bench-cells.length / 2]
. elapsed [U64]
elapsed.reserve(30)
. maximum-chunks Size
. maximum-cull-tests Size
. result Size
do use renderer
    scene.build(root)
    scene.commit()
    scene.frame-metal(renderer)
    for warmup in 0 .. < 6
        target.color = if warmup % 2 == 0 then red else blue
        target.invalidate-paint()
        scene.update(root)
        scene.commit()
        scene.frame-metal(renderer)
    renderer.finish()

    for frame in 0 .. < 30
        target.color = if frame % 2 == 0 then red else blue
        target.invalidate-paint()
        scene.reset-frame-counters()
        . started = monotonic-time-nanoseconds()
        scene.update(root)
        scene.commit()
        scene.frame-metal(renderer)
        elapsed += monotonic-time-nanoseconds() - started
        if scene.chunks-encoded > maximum-chunks
            maximum-chunks = scene.chunks-encoded
        if scene.cull-tests > maximum-cull-tests
            maximum-cull-tests = scene.cull-tests

    renderer.finish()
    renderer.mark-renderer-allocations()
    target.color = green
    target.invalidate-paint()
    scene.reset-frame-counters()
    . objects0 = C:brixGCAllocatedObjectCount()
    scene.update(root)
    scene.commit()
    scene.frame-metal(renderer)
    . objects = C:brixGCAllocatedObjectCount() - objects0
    renderer.finish()
    if count == 1000
        //gui.bench.metal.leaf-p50-ns-1k += scene-percentile(elapsed, 50)
        //gui.bench.metal.leaf-chunks-1k += maximum-chunks
        //gui.bench.metal.leaf-cull-tests-1k += maximum-cull-tests
        //gui.bench.metal.leaf-objects-1k += objects
        //gui.bench.metal.leaf-renderer-allocations-1k += renderer.renderer-allocations
    else
        //gui.bench.metal.leaf-p50-ns-10k += scene-percentile(elapsed, 50)
        //gui.bench.metal.leaf-chunks-10k += maximum-chunks
        //gui.bench.metal.leaf-cull-tests-10k += maximum-cull-tests
        //gui.bench.metal.leaf-objects-10k += objects
        //gui.bench.metal.leaf-renderer-allocations-10k += renderer.renderer-allocations
    result = maximum-chunks + maximum-cull-tests + scene.items-encoded

scene.close()
release-scene-bench-root(root)
= result

