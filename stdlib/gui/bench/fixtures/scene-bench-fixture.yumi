+ do run-metal-scroll-10k

. root = SceneBenchRoot()
. viewport = SceneBenchScroll()
markup-append(root, viewport)
for index in 0 .. < 10000
    markup-append(viewport, SceneBenchScrollCell())
mount-scene-bench-root(root, Rect(0, 0, 1200, 320))
. scene = DisplayScene(2, white)
. renderer = MetalOffscreenRenderer(1200, 320, 2, white)
. reference = RasterCanvas(1200, 320, 2, white)
. elapsed [U64]
elapsed.reserve(30)
. offset F64 = 1000
. maximum-chunks Size
. rebuilt-chunks Size
do use renderer
    do use reference
        viewport.scroll-to(Point(0, offset))
        scene.build(root)
        scene.commit()
        scene.frame-metal(renderer)
        for warmup in 0 .. < 6
            offset += 10
            viewport.scroll-to(Point(0, offset))
            scene.update(root)
            scene.commit()
            scene.frame-metal(renderer)
        renderer.finish()

        for frame in 0 .. < 30
            offset += 10
            viewport.scroll-to(Point(0, offset))
            scene.reset-frame-counters()
            . started = monotonic-time-nanoseconds()
            scene.update(root)
            scene.commit()
            scene.frame-metal(renderer)
            elapsed += monotonic-time-nanoseconds() - started
            if scene.chunks-encoded > maximum-chunks
                maximum-chunks = scene.chunks-encoded
            rebuilt-chunks += scene.chunks-rebuilt

        renderer.finish()
        renderer.mark-renderer-allocations()
        offset += 10
        viewport.scroll-to(Point(0, offset))
        scene.reset-frame-counters()
        . objects0 = C:brixGCAllocatedObjectCount()
        scene.update(root)
        scene.commit()
        scene.frame-metal(renderer)
        . objects = C:brixGCAllocatedObjectCount() - objects0
        renderer.finish()
        reference.erase(white)
        root.paint(reference)
        . diff = renderer.diff(reference)
        //gui.bench.metal.scroll-p50-ns += scene-percentile(elapsed, 50)
        //gui.bench.metal.scroll-p99-ns += scene-percentile(elapsed, 99)
        //gui.bench.metal.scroll-chunks += maximum-chunks
        //gui.bench.metal.scroll-rebuilt-chunks += rebuilt-chunks
        //gui.bench.metal.scroll-objects += objects
        //gui.bench.metal.scroll-renderer-allocations += renderer.renderer-allocations
        //gui.bench.metal.scroll-differing-pixels += diff.differing-pixels as U64
        //gui.bench.metal.scroll-max-delta += diff.maximum-channel-delta as U64

. checksum = maximum-chunks + rebuilt-chunks + scene.cull-tests
-- "bench-result gui/metal-scroll-10k checksum=$checksum"
scene.close()
release-scene-bench-root(root)

