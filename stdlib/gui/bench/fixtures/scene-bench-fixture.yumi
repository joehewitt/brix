━━━━━━━━━━━━━━━━━━━━
+ do run-metal-atlas-pressure

. renderer = MetalOffscreenRenderer(1200, 900, 1, white)
. reference = RasterCanvas(1200, 900, 1, white)
. roots [SceneBenchRoot]
. scenes [DisplayScene]
. probe-items [DisplayItem]
. probe-clips [Rect]
. probe-palette [U32]
. probe-shapes [DisplayShape]
. probe-handle DisplayGlyphHandle?
. upload-total I64
. fallback-total I64
. diff MetalPixelDiff
. checksum Size
do use renderer
    do use reference
        for group in 0 .. < 4
            . root = build-scene-bench-text(16, true, group * 16)
            . scene = DisplayScene(1, white, renderer)
            roots += root
            scenes += scene
            scene.build(root)
            scene.commit()
            scene.frame-metal(renderer)
            upload-total += renderer.glyph-atlas-uploads
            fallback-total += renderer.fallback-runs
        probe-handle = renderer.register-display-glyph
            - scene-bench-text-cells[scene-bench-text-cells.length - 1].text-layout
        ?! Panic("Unable to retain pressure-probe glyph run")
            if !probe-handle
        for frame in 0 .. < 80
            . group = frame % 4
            . subpixel = ((frame % 4) as F32) * 0.25
            probe-items.clear()
            probe-items += DisplayItem
                - 2
                - 2
                - 0
                - subpixel
                - (group * 225) as F32
                - 1200
                - 225
                - 0
                - probe-handle.index
                - probe-handle.generation
                - pack-rgba8(RGBA("#1f2937"))
                - 0
            renderer.begin-packet()
            renderer.append-items
                - probe-items.buffer-pointer
                - probe-items.length
                - probe-clips.buffer-pointer
                - probe-clips.length
                - probe-palette.buffer-pointer
                - probe-palette.length
                - probe-shapes.buffer-pointer
                - probe-shapes.length
            . probe-frame = renderer.commit-packet
                - 1
                - Rect(0, (group * 225) as F64, 1200, 225)
            ?! Panic("Unable to commit pressure-probe packet")
                if probe-frame < 0
            upload-total += renderer.glyph-atlas-uploads
            fallback-total += renderer.fallback-runs
            scenes[group].add-damage(roots[group].bounds)
            scenes[group].frame-metal(renderer)
            upload-total += renderer.glyph-atlas-uploads
            fallback-total += renderer.fallback-runs
        renderer.finish()

        for group in 0 .. < 4
            scenes[group].add-damage(roots[group].bounds)
            scenes[group].frame-metal(renderer)
            upload-total += renderer.glyph-atlas-uploads
            fallback-total += renderer.fallback-runs
        renderer.finish()
        for root in roots
            root.paint(reference)
        diff = renderer.diff(reference)
        renderer.release-display-glyph(probe-handle)

        //gui.gpu.glyph-atlas-bytes += renderer.glyph-atlas-bytes
        //gui.gpu.glyph-atlas-uploads += upload-total
        //gui.gpu.glyph-atlas-evictions += renderer.glyph-atlas-evictions
        //gui.bench.metal.pressure-glyph-atlas-bytes += renderer.glyph-atlas-bytes
        //gui.bench.metal.pressure-glyph-uploads += upload-total
        //gui.bench.metal.pressure-glyph-evictions += renderer.glyph-atlas-evictions
        //gui.bench.metal.pressure-fallback-runs += fallback-total
        //gui.bench.metal.pressure-run-count += renderer.run-count
        //gui.bench.metal.pressure-diff-ppm += round(diff.differing-ratio * 1000000) as U64
        checksum = upload-total
        checksum += renderer.glyph-atlas-evictions as Size
        for scene in scenes
            scene.close()

-- "bench-result gui/metal-atlas-pressure checksum=$checksum"
for root in roots
    release-scene-bench-root(root)

━━━━━━━━━━━━━━━━━━━━
+ do run-metal-vector-shared

. root = build-scene-bench-vectors(1000)
. renderer = MetalOffscreenRenderer(1200, 240, 2, white)
. scene = DisplayScene(2, white, renderer)
. reference = RasterCanvas(1200, 240, 2, white)
. elapsed [U64]
elapsed.reserve(30)
. diff MetalPixelDiff
. initial-draw-calls I64
. checksum Size
do use renderer
    do use reference
        scene.build(root)
        scene.commit()
        scene.frame-metal(renderer)
        for warmup in 0 .. < 6
            scene.add-damage(root.bounds)
            scene.frame-metal(renderer)
        renderer.finish()

        for frame in 0 .. < 30
            scene.add-damage(root.bounds)
            . started = monotonic-time-nanoseconds()
            scene.frame-metal(renderer)
            elapsed += monotonic-time-nanoseconds() - started
        renderer.finish()
        renderer.mark-renderer-allocations()
        scene.add-damage(root.bounds)
        scene.frame-metal(renderer)
        renderer.finish()
        initial-draw-calls = renderer.draw-calls
        root.paint(reference)
        diff = renderer.diff(reference)

        //gui.bench.metal.vector-cpu-p50-ns += scene-percentile(elapsed, 50)
        //gui.bench.metal.vector-draw-calls += initial-draw-calls
        //gui.bench.metal.vector-diff-ppm += round(diff.differing-ratio * 1000000) as U64
        //gui.bench.metal.vector-renderer-allocations += renderer.renderer-allocations
        checksum = initial-draw-calls
        scene.close()

-- "bench-result gui/metal-vector-shared checksum=$checksum"
release-scene-bench-root(root)

