+ variant Size

• This • w:40 h:28 mr:4 mb:4

────────────────────
+ This
    - variant

────────────────────
+ do paint-self
    - canvas Canvas

. rect = bounds
. kind = variant % 4
. hue = ((variant % 9) as F64) / 9
canvas.fill-color = RGBA(0.92, 0.9, 0.85, 1)
canvas.rect(Rect(rect.x, rect.y + 20, rect.width, 8))
do use canvas.saved-state
    match kind
        |= 0
            scene-bench-shadow-wedge(canvas, rect)
            canvas.shadow-path(Shadow(RGBA(0, 0, 0, 0.5), 3, 2, 3))
        |= 1
            canvas.begin()
            canvas.outline-path(Outline(Rect(rect.x + 6, rect.y + 4, 26, 16), 6))
            canvas.shadow-path(Shadow(RGBA(0.1, 0.1, 0.3, 0.6), 6, 0, 3))
        |= 2
            canvas.transform(Matrix().rotate(0.3rad, rect.center))
            scene-bench-shadow-wedge(canvas, rect)
            canvas.shadow-path(Shadow(RGBA(0, 0, 0, 0.45), 4, 3, 2))
        ??
            canvas.clip-outline(Outline(rect, 8))
            canvas.begin-opacity(0.8%%)
            scene-bench-shadow-wedge(canvas, rect)
            canvas.shadow-path(Shadow(RGBA(0.2, 0, 0.1, 0.7), 2, 1, 1))
            canvas.end-opacity()
    canvas.fill-color = RGBA(0.3 + hue * 0.6, 0.55, 0.9 - hue * 0.5, 1)
    if kind == 1
        canvas.outline(Outline(Rect(rect.x + 6, rect.y + 4, 26, 16), 6))
    else
        scene-bench-shadow-wedge(canvas, rect)
        canvas.end()

