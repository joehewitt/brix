━━━━━━━━━━━━━━━━━━━━
_ do run-scene-leaf-scale Size
    - count Size

. root = build-scene-bench-grid(count)
. scene = DisplayScene(2, white)
. surface = RasterCanvas(1200, 900, 2, white)
. elapsed [U64]
. target = scene-bench-cells[scene-bench-cells.length / 2]
do use surface
    scene.build(root)
    scene.commit()
    scene.frame(surface)
    scene.reset-frame-counters()
    for frame in 0 .. < 30
        target.color = if frame % 2 == 0 then red else blue
        target.invalidate-paint()
        . started = monotonic-time-nanoseconds()
        scene.update(root)
        scene.commit()
        scene.frame(surface)
        elapsed += monotonic-time-nanoseconds() - started

    target.color = green
    target.invalidate-paint()
    . objects0 = C:brixGCAllocatedObjectCount()
    . bytes0 = C:brixGCRequestedByteCount()
    scene.update(root)
    scene.commit()
    scene.frame(surface)
    . objects = C:brixGCAllocatedObjectCount() - objects0
    . bytes = C:brixGCRequestedByteCount() - bytes0

    if count == 1000
        //gui.bench.scene.leaf-p50-ns-1k += scene-percentile(elapsed, 50)
        //gui.bench.scene.leaf-chunks-rebuilt-1k += scene.chunks-rebuilt
        //gui.bench.scene.leaf-chunks-drawn-1k += scene.chunks-drawn
        //gui.bench.scene.leaf-objects-1k += objects
        //gui.bench.scene.leaf-bytes-1k += bytes
    else
        //gui.bench.scene.leaf-p50-ns-10k += scene-percentile(elapsed, 50)
        //gui.bench.scene.leaf-chunks-rebuilt-10k += scene.chunks-rebuilt
        //gui.bench.scene.leaf-chunks-drawn-10k += scene.chunks-drawn
        //gui.bench.scene.leaf-objects-10k += objects
        //gui.bench.scene.leaf-bytes-10k += bytes

. result = scene.chunks-rebuilt + scene.chunks-drawn + scene.items-drawn
scene.close()
release-scene-bench-root(root)
= result

━━━━━━━━━━━━━━━━━━━━
+ do run-scene-scroll-10k

. root = SceneBenchRoot()
. viewport = SceneBenchScroll()
markup-append(root, viewport)
for index in 0 .. < 10000
    markup-append(viewport, SceneBenchScrollCell())
mount-scene-bench-root(root, Rect(0, 0, 1200, 320))

. scene = DisplayScene(2, white)
. surface = RasterCanvas(1200, 320, 2, white)
. elapsed [U64]
do use surface
    scene.build(root)
    scene.commit()
    scene.frame(surface)
    scene.reset-frame-counters()
    . offset F64 = 1000
    for frame in 0 .. < 30
        offset += 10
        viewport.scroll-to(Point(0, offset))
        . started = monotonic-time-nanoseconds()
        scene.update(root)
        scene.commit()
        scene.frame(surface)
        elapsed += monotonic-time-nanoseconds() - started

    offset += 10
    viewport.scroll-to(Point(0, offset))
    . objects0 = C:brixGCAllocatedObjectCount()
    . bytes0 = C:brixGCRequestedByteCount()
    scene.update(root)
    . objects-after-update = C:brixGCAllocatedObjectCount()
    scene.commit()
    . objects-after-commit = C:brixGCAllocatedObjectCount()
    scene.frame(surface)
    . objects-after-replay = C:brixGCAllocatedObjectCount()
    . objects = objects-after-replay - objects0
    . bytes = C:brixGCRequestedByteCount() - bytes0
    //gui.bench.scene.scroll-p50-ns += scene-percentile(elapsed, 50)
    //gui.bench.scene.scroll-p99-ns += scene-percentile(elapsed, 99)
    //gui.bench.scene.scroll-chunks-rebuilt += scene.chunks-rebuilt
    //gui.bench.scene.scroll-chunks-drawn += scene.chunks-drawn
    //gui.bench.scene.scroll-objects += objects
    //gui.bench.scene.scroll-bytes += bytes
    //gui.bench.scene.scroll-update-objects += objects-after-update - objects0
    //gui.bench.scene.scroll-commit-objects += objects-after-commit - objects-after-update
    //gui.bench.scene.scroll-replay-objects += objects-after-replay - objects-after-commit

-- "bench-result gui/scene-scroll-10k checksum=${scene.chunks-drawn + scene.cull-tests}"
scene.close()
release-scene-bench-root(root)

