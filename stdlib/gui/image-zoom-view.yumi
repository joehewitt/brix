+ GUIImageZoomStyle is Style

+ pixelate-ratio F64? = 4
+ pixel-grid-ratio F64? = 12
+ pixel-grid-color = RGBA(0.5, 0.5, 0.5, 0.45)
+ fit-insets = Insets(0, 0, 0, 0)
+ page-color = RGBA(1, 1, 1, 1)

. pixelate-ratio -> paint
. pixel-grid-ratio -> paint
. pixel-grid-color -> paint
. fit-insets -> paint
. page-color -> paint

