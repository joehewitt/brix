────────────────────
_ do handle-scroll
    - event ScrollEvent

=? if !has-content
. is-modified = event.modifiers.command || event.modifiers.control || event.modifiers.option
if framing.is-fit && !is-modified && !framing.is-pinching
    prepare-swipe()
    if swipe.handle(event)
        event.cancel()
        =
. ignored = framing.handle-scroll(event)
event.cancel()

────────────────────
_ do prepare-swipe

. content = content-bounds
swipe.page = Dimensions(content.width, content.height)
swipe.has-previous-x = page-size(Orientation.horizontal, -1) != null
swipe.has-next-x = page-size(Orientation.horizontal, 1) != null
swipe.has-previous-y = page-size(Orientation.vertical, -1) != null
swipe.has-next-y = page-size(Orientation.vertical, 1) != null

────────────────────
_ neighbor Image?
    - axis Orientation
    - step Int

|? step == 0
    image
|? axis == Orientation.horizontal
    if step > 0 then next-x else previous-x
??
    if step > 0 then next-y else previous-y

────────────────────
_ do reframe

is-zoomed = !framing.is-fit
if is-zoomed
    swipe.reset()
invalidate-paint()
if framing.immerse(chrome?.zoom-chrome() ?? List'Rect())
    is-immersed = framing.is-immersed
    immersed <- is-immersed
=? if framing.zoom == shown-zoom
shown-zoom = framing.zoom
zoomed <- ImageZoomEvent(effective-zoom, framing.is-fit)

────────────────────
_ do turn
    - axis Orientation
    - step Int

. arriving = neighbor(axis, step)
. leaving = image
if arriving && !arriving.is-released
    if axis == Orientation.horizontal
        previous-x = leaving if step > 0
        next-x = if step > 0 then null else leaving
        previous-y = null
        next-y = null
    else
        previous-y = leaving if step > 0
        next-y = if step > 0 then null else leaving
        previous-x = null
        next-x = null
    image = arriving
swiped <- SwipeEvent(axis, step)
invalidate-paint()

────────────────────
_ do paint-neighbor
    - canvas Canvas
    - shift Point

=? if shift.x == 0 && shift.y == 0
. axis = if shift.x != 0 then Orientation.horizontal else Orientation.vertical
. step = if shift.x < 0 || shift.y < 0 then 1 else -1
. size = page-size(axis, step)
=? if !size
. content = content-bounds
. reach-x = if axis == Orientation.horizontal then (step as F64) * content.width else 0.0
. reach-y = if axis == Orientation.vertical then (step as F64) * content.height else 0.0
. rect = image-fit-rect(size, fit-frame, $image-fit, $image-align-x, $image-align-y)
paint-page
    - canvas
    - Rect(rect.x + shift.x + reach-x, rect.y + shift.y + reach-y, rect.width, rect.height)
    - axis
    - step
    - $image-sampling

────────────────────
_ do handle-magnify
    - event MagnifyEvent

=? if !has-content
if framing.handle-magnify(event)
    swipe.reset()
    event.cancel()

────────────────────
_ do handle-pointer-down
    - event PointerDownEvent

=? if !has-content
. ignored = framing.handle-pointer-down(event)

────────────────────
_ do handle-pointer-drag
    - event PointerDragEvent

=? if !has-content
if framing.handle-pointer-drag(event)
    event.cancel()

────────────────────
_ do paint-pixel-grid
    - canvas Canvas
    - pixels Dimensions
    - rect Rect
    - visible Rect

. scale = device-scale
. columns = pixels.width as I32
. rows = pixels.height as I32
. step-x = rect.width / pixels.width
. step-y = rect.height / pixels.height
. line = 1 / scale
canvas.fill-color = $pixel-grid-color
canvas.stroke-color = null
. first-column = max(1, ceil((visible.x - rect.x) / step-x) as I32)
. last-column = min(columns - 1, floor((visible.right - rect.x) / step-x) as I32)
for column in first-column .. last-column
    . x = round((rect.x + (column as F64) * step-x) * scale) / scale
    canvas.rect(Rect(x, visible.y, line, visible.height))
. first-row = max(1, ceil((visible.y - rect.y) / step-y) as I32)
. last-row = min(rows - 1, floor((visible.bottom - rect.y) / step-y) as I32)
for row in first-row .. last-row
    . y = round((rect.y + (row as F64) * step-y) * scale) / scale
    canvas.rect(Rect(visible.x, y, visible.width, line))

────────────────────
+ zoom-bounds ZoomBounds

ZoomBounds(natural, fitted, min-zoom, max-zoom, ink-insets)

.. fitted = image-fit-rect(natural, fit-frame, $image-fit, $image-align-x, $image-align-y)

────────────────────
+ get image-rect

|? has-content
    framing.placed()
??
    null

────────────────────
+ do paint-self
    - canvas Canvas

. content = content-bounds
=? if content.width <= 0 || content.height <= 0
if !image && blank
    do use canvas.saved-state
        canvas.clip(content)
        canvas.fill-color = $page-color
        canvas.stroke-color = null
        canvas.rect(framing.placed())
=? if !page-size(Orientation.horizontal, 0)
. shift = if framing.is-fit then swipe.offset else Point(0, 0)
. placed = framing.placed()
. rect = Rect(placed.x + shift.x, placed.y + shift.y, placed.width, placed.height)
. ratio = device-pixel-ratio
. pixelate = $pixelate-ratio
. grid = $pixel-grid-ratio
. is-pixelated = $image-sampling == ImageSampling.pixelated || is-ratio-pixelated
.. is-ratio-pixelated = pixelate != null && ratio >= pixelate
do use canvas.saved-state
    canvas.clip(content)
    paint-page
        - canvas
        - rect
        - Orientation.horizontal
        - 0
        - if is-pixelated then ImageSampling.pixelated else ImageSampling.smooth
    paint-neighbor(canvas, shift)
    . pixels = page-pixels(Orientation.horizontal, 0)
    if pixels && grid != null && ratio >= grid
        . left = max(content.x, rect.x)
        . top = max(content.y, rect.y)
        . right = min(content.right, rect.right)
        . bottom = min(content.bottom, rect.bottom)
        if right > left && bottom > top
            paint-pixel-grid • canvas canvas
                - pixels
                - rect
                - Rect(left, top, right - left, bottom - top)
