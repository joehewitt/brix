+ ImageZoomView is ImageView
    is ZoomOwner
    using GUIImageZoomStyle

+ max-zoom F64 = 64
+ blank Dimensions?
+ is-zoomed = false
+ is-immersed = false
+ previous-x Image?
+ next-x Image?
+ previous-y Image?
+ next-y Image?
+ chrome ZoomChrome?
+ ink-insets = Insets(0, 0, 0, 0)
+ event zoomed ImageZoomEvent
+ event immersed Bool
+ event landing SwipeEvent
+ event swiped SwipeEvent

_ swipe := SwipeTracker(this)
_ framing := ZoomFrame(this, this)
_ shown-zoom F64? = null

. invalidate-paint < blank

• This
    when #is-zoomed
        cursor = CursorStyle.open-hand
        drag-cursor = CursorStyle.closed-hand

