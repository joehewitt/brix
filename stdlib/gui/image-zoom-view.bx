(import ./box)
(import ./events)
(import ./image-view)
(import ./primitives)
(import ./swipe)
(import ./window)
(import ./zoom)
(import /core/style)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/image)
(import /graphics/point)
(import /graphics/primitives)
(import /math)
(import /ui/input)

(type + ImageZoomEvent (is GUIEvent)
  (prop + zoom F64)
  (prop + is-fit Bool)
  (fn-do + This _
    (param zoom F64)
    (param is-fit Bool)
    (param data PointerEventData (= (call PointerEventData)))
  )
)

(type + GUIImageZoomStyle (is Style)
  (prop + pixelate-ratio (? F64) (= 4))
  (prop + pixel-grid-ratio (? F64) (= 12))
  (prop + pixel-grid-color _ (= (call RGBA 0.5 0.5 0.5 0.45)))
  (prop + fit-insets _ (= (call Insets 0 0 0 0)))
  (prop + page-color _ (= (call RGBA 1 1 1 1)))
  (blank)
  (style-domains pixelate-ratio (domain paint))
  (style-domains pixel-grid-ratio (domain paint))
  (style-domains pixel-grid-color (domain paint))
  (style-domains fit-insets (domain paint))
  (style-domains page-color (domain paint))
)

(type + ImageZoomView (is ImageView)
  (implements ZoomOwner)
  (using GUIImageZoomStyle)
  (prop + max-zoom F64 (= 64))
  (prop + blank (? Dimensions))
  (prop + is-zoomed _ (= false))
  (prop + is-immersed _ (= false))
  (prop + previous-x (? Image))
  (prop + next-x (? Image))
  (prop + previous-y (? Image))
  (prop + next-y (? Image))
  (prop + chrome (? ZoomChrome))
  (prop + ink-insets _ (= (call Insets 0 0 0 0)))
  (event + zoomed ImageZoomEvent)
  (event + immersed Bool)
  (event + landing SwipeEvent)
  (event + swiped SwipeEvent)
  (blank)
  (prop _ swipe _ (:= (call SwipeTracker this)))
  (prop _ framing _ (:= (call ZoomFrame this this)))
  (prop _ shown-zoom (? F64) (= null))
  (blank)
  (depends invalidate-paint blank)
  (blank)
  (rule This
    (when-style #is-zoomed
      (= cursor (. CursorStyle open-hand))
      (= drag-cursor (. CursorStyle closed-hand))
    )
  )
  (subscribe-for (on event scroll)
    (call handle-scroll event)
  )
  (subscribe-for (on event magnify)
    (call handle-magnify event)
  )
  (subscribe-for (on event pointer-down)
    (call handle-pointer-down event)
  )
  (subscribe-for (on event pointer-drag)
    (call handle-pointer-drag event)
  )
  (subscribe-for (on event pointer-up)
    (call (. framing handle-pointer-up))
  )
  (subscribe-for (on _ (. framing moved))
    (call reframe)
  )
  (subscribe-for (on _ (. swipe moved))
    (call invalidate-paint)
  )
  (subscribe-for (on event (. swipe landing))
    (<- landing (call SwipeEvent (. event axis) (. event step)))
  )
  (subscribe-for (on event (. swipe turned))
    (call turn (. event axis) (. event step))
  )
  (fn-expr + zoom (? F64) :get
    (. framing zoom)
  )
  (fn-expr + is-fit _ :get
    (. framing is-fit)
  )
  (fn-expr + fit-zoom F64 :get
    (case? (or (<= (. natural width) 0) (<= (. natural height) 0))
      1
    )
    (default
      (/ (. fitted width) (. natural width))
    )
    (where
      (lazy fitted (call image-fit-size natural fit-frame $image-fit))
    )
  )
  (fn-expr + natural Dimensions :get
    (?? (call page-size (. Orientation horizontal) 0) blank (call Dimensions 0 0))
  )
  (fn-expr + has-content Bool :get
    (or (!= (call page-size (. Orientation horizontal) 0) null) (!= blank null))
  )
  (fn-expr + fit-frame Rect :get
    (call (. content-bounds inset) $fit-insets)
  )
  (fn-expr + effective-zoom F64 :get
    (?? (. framing zoom) fit-zoom)
  )
  (fn-expr + min-zoom F64 :get
    (call min fit-zoom 1)
  )
  (fn-expr + device-pixel-ratio F64 :get
    (match (call page-pixels (. Orientation horizontal) 0)
      (case= null
        0
      )
      (case (: pixels Dimensions)
        (case? (<= (. pixels width) 0)
          0
        )
        (default
          (* (/ (. (call (. framing placed)) width) (. pixels width)) device-scale)
        )
      )
    )
  )
  (fn-do + zoom-to _
    (param level F64)
    (param anchor (? Point) (= null))
    (return-if (if (not has-content)))
    (call (. framing zoom-to) level anchor)
  )
  (fn-do + zoom-by _
    (param factor F64)
    (param anchor (? Point) (= null))
    (return-if (if (not has-content)))
    (call (. framing zoom-by) factor anchor)
  )
  (fn-do + fit _
    (call (. framing fit))
  )
  (fn-expr + page-size (? Dimensions)
    (param axis Orientation)
    (param step Int)
    (if-expr (or (not shown) (. shown is-released)) null (. shown size))
    (where
      (lazy shown (call neighbor axis step))
    )
  )
  (fn-expr + page-pixels (? Dimensions)
    (param axis Orientation)
    (param step Int)
    (if-expr (or (not shown) (. shown is-released)) null (call Dimensions (. shown pixel-width) (. shown pixel-height)))
    (where
      (lazy shown (call neighbor axis step))
    )
  )
  (fn-do + paint-page _
    (param canvas Canvas)
    (param rect Rect)
    (param axis Orientation)
    (param step Int)
    (param sampling ImageSampling)
    (let shown (call neighbor axis step))
    (return-if (if (or (not shown) (. shown is-released))))
    (call (. shown draw) (:destination canvas)
      (block
        (arg rect)
        (arg sampling)
      )
    )
  )
  (fn-do + pan-by _
    (param delta Point)
    (return-if (if (not has-content)))
    (call (. framing pan-by) delta)
  )
  (fn-do _ handle-scroll _
    (param event ScrollEvent)
    (return-if (if (not has-content)))
    (let is-modified (or (. event modifiers command) (. event modifiers control) (. event modifiers option)))
    (if (and (. framing is-fit) (not is-modified) (not (. framing is-pinching)))
      (call prepare-swipe)
      (if (call (. swipe handle) event)
        (call (. event cancel))
        (return)
      )
    )
    (let ignored (call (. framing handle-scroll) event))
    (call (. event cancel))
  )
  (fn-do _ prepare-swipe _
    (let content content-bounds)
    (= (. swipe page) (call Dimensions (. content width) (. content height)))
    (= (. swipe has-previous-x) (!= (call page-size (. Orientation horizontal) -1) null))
    (= (. swipe has-next-x) (!= (call page-size (. Orientation horizontal) 1) null))
    (= (. swipe has-previous-y) (!= (call page-size (. Orientation vertical) -1) null))
    (= (. swipe has-next-y) (!= (call page-size (. Orientation vertical) 1) null))
  )
  (fn-expr _ neighbor (? Image)
    (param axis Orientation)
    (param step Int)
    (case? (== step 0)
      image
    )
    (case? (== axis (. Orientation horizontal))
      (if-expr (> step 0) next-x previous-x)
    )
    (default
      (if-expr (> step 0) next-y previous-y)
    )
  )
  (fn-do _ reframe _
    (= is-zoomed (not (. framing is-fit)))
    (if is-zoomed
      (call (. swipe reset))
    )
    (call invalidate-paint)
    (if (call (. framing immerse) (?? (call (?. chrome zoom-chrome)) (call (of List Rect))))
      (= is-immersed (. framing is-immersed))
      (<- immersed is-immersed)
    )
    (return-if (if (== (. framing zoom) shown-zoom)))
    (= shown-zoom (. framing zoom))
    (<- zoomed (call ImageZoomEvent effective-zoom (. framing is-fit)))
  )
  (fn-do _ turn _
    (param axis Orientation)
    (param step Int)
    (let arriving (call neighbor axis step))
    (let leaving image)
    (if (and arriving (not (. arriving is-released)))
      (if (== axis (. Orientation horizontal))
        (= previous-x (only-if leaving (if (> step 0))))
        (= next-x (if-expr (> step 0) null leaving))
        (= previous-y null)
        (= next-y null)
        (else
          (= previous-y (only-if leaving (if (> step 0))))
          (= next-y (if-expr (> step 0) null leaving))
          (= previous-x null)
          (= next-x null)
        )
      )
      (= image arriving)
    )
    (<- swiped (call SwipeEvent axis step))
    (call invalidate-paint)
  )
  (fn-do _ paint-neighbor _
    (param canvas Canvas)
    (param shift Point)
    (return-if (if (and (== (. shift x) 0) (== (. shift y) 0))))
    (let axis (if-expr (!= (. shift x) 0) (. Orientation horizontal) (. Orientation vertical)))
    (let step (if-expr (or (< (. shift x) 0) (< (. shift y) 0)) 1 -1))
    (let size (call page-size axis step))
    (return-if (if (not size)))
    (let content content-bounds)
    (let reach-x (if-expr (== axis (. Orientation horizontal)) (* (as step F64) (. content width)) 0.0))
    (let reach-y (if-expr (== axis (. Orientation vertical)) (* (as step F64) (. content height)) 0.0))
    (let rect (call image-fit-rect size fit-frame $image-fit $image-align-x $image-align-y))
    (call paint-page
      (block
        (arg canvas)
        (arg (call Rect (+ (. rect x) (. shift x) reach-x) (+ (. rect y) (. shift y) reach-y) (. rect width) (. rect height)))
        (arg axis)
        (arg step)
        (arg $image-sampling)
      )
    )
  )
  (fn-do _ handle-magnify _
    (param event MagnifyEvent)
    (return-if (if (not has-content)))
    (if (call (. framing handle-magnify) event)
      (call (. swipe reset))
      (call (. event cancel))
    )
  )
  (fn-do _ handle-pointer-down _
    (param event PointerDownEvent)
    (return-if (if (not has-content)))
    (let ignored (call (. framing handle-pointer-down) event))
  )
  (fn-do _ handle-pointer-drag _
    (param event PointerDragEvent)
    (return-if (if (not has-content)))
    (if (call (. framing handle-pointer-drag) event)
      (call (. event cancel))
    )
  )
  (fn-do _ paint-pixel-grid _
    (param canvas Canvas)
    (param pixels Dimensions)
    (param rect Rect)
    (param visible Rect)
    (let scale device-scale)
    (let columns (as (. pixels width) I32))
    (let rows (as (. pixels height) I32))
    (let step-x (/ (. rect width) (. pixels width)))
    (let step-y (/ (. rect height) (. pixels height)))
    (let line (/ 1 scale))
    (= (. canvas fill-color) $pixel-grid-color)
    (= (. canvas stroke-color) null)
    (let first-column (call max 1 (as (call ceil (/ (- (. visible x) (. rect x)) step-x)) I32)))
    (let last-column (call min (- columns 1) (as (call floor (/ (- (. visible right) (. rect x)) step-x)) I32)))
    (for (in column (.. first-column last-column))
      (let x (/ (call round (* (+ (. rect x) (* (as column F64) step-x)) scale)) scale))
      (call (. canvas rect) (call Rect x (. visible y) line (. visible height)))
    )
    (let first-row (call max 1 (as (call ceil (/ (- (. visible y) (. rect y)) step-y)) I32)))
    (let last-row (call min (- rows 1) (as (call floor (/ (- (. visible bottom) (. rect y)) step-y)) I32)))
    (for (in row (.. first-row last-row))
      (let y (/ (call round (* (+ (. rect y) (* (as row F64) step-y)) scale)) scale))
      (call (. canvas rect) (call Rect (. visible x) y (. visible width) line))
    )
  )
  (fn-expr + zoom-bounds ZoomBounds
    (call ZoomBounds natural fitted min-zoom max-zoom ink-insets)
    (where
      (lazy fitted (call image-fit-rect natural fit-frame $image-fit $image-align-x $image-align-y))
    )
  )
  (fn-expr + image-rect _ :get
    (case? has-content
      (call (. framing placed))
    )
    (default
      null
    )
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let content content-bounds)
    (return-if (if (or (<= (. content width) 0) (<= (. content height) 0))))
    (if (and (not image) blank)
      (do-use (. canvas saved-state)
        (call (. canvas clip) content)
        (= (. canvas fill-color) $page-color)
        (= (. canvas stroke-color) null)
        (call (. canvas rect) (call (. framing placed)))
      )
    )
    (return-if (if (not (call page-size (. Orientation horizontal) 0))))
    (let shift (if-expr (. framing is-fit) (. swipe offset) (call Point 0 0)))
    (let placed (call (. framing placed)))
    (let rect (call Rect (+ (. placed x) (. shift x)) (+ (. placed y) (. shift y)) (. placed width) (. placed height)))
    (let ratio device-pixel-ratio)
    (let pixelate $pixelate-ratio)
    (let grid $pixel-grid-ratio)
    (let is-pixelated (or (== $image-sampling (. ImageSampling pixelated)) is-ratio-pixelated))
    (lazy is-ratio-pixelated (and (!= pixelate null) (>= ratio pixelate)))
    (do-use (. canvas saved-state)
      (call (. canvas clip) content)
      (call paint-page
        (block
          (arg canvas)
          (arg rect)
          (arg (. Orientation horizontal))
          (arg 0)
          (arg (if-expr is-pixelated (. ImageSampling pixelated) (. ImageSampling smooth)))
        )
      )
      (call paint-neighbor canvas shift)
      (let pixels (call page-pixels (. Orientation horizontal) 0))
      (if (and pixels (!= grid null) (>= ratio grid))
        (let left (call max (. content x) (. rect x)))
        (let top (call max (. content y) (. rect y)))
        (let right (call min (. content right) (. rect right)))
        (let bottom (call min (. content bottom) (. rect bottom)))
        (if (and (> right left) (> bottom top))
          (call paint-pixel-grid (:canvas canvas)
            (block
              (arg pixels)
              (arg rect)
              (arg (call Rect left top (- right left) (- bottom top)))
            )
          )
        )
      )
    )
  )
)
