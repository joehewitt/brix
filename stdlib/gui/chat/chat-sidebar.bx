(import ./chat-branching)
(import ./chat-theme)
(import /ai)
(import /gui)
(import /gui/icons/lucide/square-pen)
(import /stream/aggregate)

(type + ChatNode (is Tuple)
  (prop + session (? AIChatSession))
  (prop + branch-id String)
)

(type + ChatChoice (is Tuple)
  (prop + session AIChatSession)
  (prop + branch-id String)
)

(type + ChatSidebar (is Sidebar)
  (prop + store AIChatStore)
  (prop + branching ChatBranching)
  (event + chosen ChatChoice)
  (content
    (<> This
      (<> SidebarSection (• pt 10)
        (<> SidebarItem (id: new-button) (text: "New chat") (• icon-square-pen))
        (if (!= (. #store #error) null)
          (<> Text (• chat-error) (• mx gui-sidebar-row-inset) (• px tree-box-row-inset) (• py 6)
            (<> Span
              (= text (?? (. #store #error) ""))
            )
          )
        )
      )
      (<> SidebarSection
        (<> ChatTree (id: tree)
          (= store #store)
          (= selected-path (call chat-selected-path (. #store #active) (. #branching #focus)))
        )
      )
    )
  )
  (subscribe-for (on event (. new-button click))
    (call (. store new-session))
    (call (. event cancel))
  )
  (subscribe-for (on choice (. tree chosen))
    (<- chosen choice)
  )
)

(type + ChatTree (is Box)
  (prop + store AIChatStore)
  (prop + selected-path (list String))
  (prop + can-drag (? (of TreeBoxItemPredicate ChatNode)))
  (prop + current-key _ (= (if-expr (> (. #selected-path length) 0) ([] #selected-path (- (. #selected-path length) 1)) "")))
  (event + chosen ChatChoice)
  (content
    (<> This (• flex-col)
      (<> (of TreeBox ChatNode) (id: tree) (• flex 1)
        (= root-node (call ChatNode null ""))
        (= load-children (=> (node) (call chat-node-children node store)))
        (= key-builder chat-node-key)
        (= selected-keys (list #current-key))
        (= can-drag #can-drag)
        (= is-ordered false)
        (blank)
        (<> ChatNodeRow (slot: row) (param: row)
          (= node (!! (. row #item)))
        )
      )
    )
  )
  (subscribe-for (on event (. tree selection-changed))
    (let node (?. (call (. tree entry-for-key) (. tree selected-key)) item))
    (let session (?. node session))
    (if session
      (<- chosen (call ChatChoice session (. (!! node) branch-id)))
    )
  )
  (whenever-rule (. store #revision)
    (call (. tree reload))
    (call reveal)
  )
  (whenever-rule #selected-path
    (call reveal)
  )
  (fn-do _ reveal _
    (let ignored (call (. tree reveal-key-path) selected-path))
  )
)

(type + ChatNodeRow (is Box)
  (prop + node ChatNode)
  (prop + title _
    (=
      (call chat-node-title
        (block
          (arg (!! (. #node session)))
          (arg (. #node branch-id))
          (arg (. (!! (. #node session)) document #branches))
          (arg (. (!! (. #node session)) document #title))
        )
      )
    )
  )
  (content
    (<> This (• flex-row) (• flex 1)
      (<> Label (• flex 1)
        (= text #title)
        (= align-y (. Alignment center))
      )
    )
  )
)

(fn-expr + chat-node-key _
  (param node ChatNode)
  (if-expr (. node session) (call chat-key (. node session) (. node branch-id)) "")
)

(fn-expr + chat-key _
  (param session AIChatSession)
  (param branch-id String)
  (str (. session id) "/" branch-id)
)

(fn-expr + chat-node-children (list ChatNode)
  (param node ChatNode)
  (param store AIChatStore)
  (case? (. node session)
    (call chat-branch-nodes (. node session) (. node branch-id))
  )
  (default
    (in (call ChatNode each (. each chat root-branch-id)) (. store sessions) (when (and (not (. each is-empty)) (== (. each document marks archived-at) null))))
  )
)

(fn-expr + chat-branch-nodes (list ChatNode)
  (param session AIChatSession)
  (param parent-id String)
  (in (call ChatNode session (. each id)) branches (when (and (not (. each is-collapsed)) (== (call chat-visible-parent branches each) parent-id))))
  (where
    (lazy branches (. session document branches))
  )
)

(fn-expr + chat-node-title String
  (param session AIChatSession)
  (param branch-id String)
  (param branches (list AIChatBranchSummary))
  (param title (? String))
  (case? (== branch-id (. session chat root-branch-id))
    (?? title "New chat")
  )
  (default
    (?? (?. (call chat-summary-for branches branch-id) title) "Side chat")
  )
)

(fn-do + chat-selected-path (list String)
  (param session AIChatSession)
  (param focus (? AIChatSession))
  (let path (call (of List String)))
  (+= path (call chat-key session (. session chat root-branch-id)))
  (return-if path (if (not focus)))
  (blank)
  (let branches (. session document branches))
  (let trail (call (of List String)))
  (let current (? String) (. focus branch-id))
  (while current
    (let found (call chat-summary-for branches current))
    (if (not found)
      (break)
    )
    (if (and (not (. found is-collapsed)) (. found parent-branch-id))
      (call (. trail insert) (. found id) 0)
    )
    (= current (. found parent-branch-id))
  )
  (for (in id trail)
    (+= path (call chat-key session id))
  )
  (return path)
)

(fn-do _ chat-visible-parent (? String)
  (param branches (list AIChatBranchSummary))
  (param branch AIChatBranchSummary)
  (let parent (. branch parent-branch-id))
  (while parent
    (let found (call chat-summary-for branches parent))
    (return-if parent (if (or (not found) (not (. found is-collapsed)))))
    (blank)
    (= parent (. found parent-branch-id))
  )
  (return null)
)

(fn-expr _ chat-summary-for (? AIChatBranchSummary)
  (param branches (list AIChatBranchSummary))
  (param branch-id String)
  (call first (in each branches (when (== (. each id) branch-id))))
)
