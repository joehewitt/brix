• chat-jump-button • bg:gui-field-color
    corner-radius = 16
    border-color = gui-border-color
    border-width = 1

    when #is-hover-within
        background-color = gui-hover-color.over(gui-field-color)

    when #is-press-within
        background-color = gui-pressed-color.over(gui-field-color)

• chat-bare • bg:transparent px:0
    shadow = null
    min-height = SizeSpec.auto
    max-height = SizeSpec.auto
    font-size = inherit
    corner-radius = 0

    when #is-untitled
        • pl:0

        • button-title
            display = Display.hidden

    when #is-hover-within
        • bg:transparent

    when #is-press-within
        • bg:transparent
        scale = 1

    • button-content
        align-x = Alignment.start

