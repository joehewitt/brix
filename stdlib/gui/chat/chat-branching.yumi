./chat-memory
/ai
/stream/aggregate

━━━━━━━━━━━━━━━━━━━━
+ ChatBranching

+ root AIChatSession
+ focus AIChatSession?
+ error String?
+ memory = ChatViewMemory()
+ event stopping AIChatSession

_ queues = Map'String'AIChatQueue()
+ main = chat-main-session(root, root.document.#revision, #focus)

────────────────────
+ This
    - root

────────────────────
+ get document

root.document

────────────────────
+ do open
    - branch-id String

error = null
if branch-id == root.branch-id
    focus = null
    =
. opened = document.session(branch-id)
    catch failure Error
        error = "$failure"
        =
focus = opened

────────────────────
+ do close

focus = null

────────────────────
+ do send
    - session AIChatSession
    - prompt String
    - images [AIImage] = List'AIImage()
    - context String? = null

error = null
session.send(prompt, context, false, images)
    catch failure Error
        error = "$failure"

────────────────────
+ do steer Bool
    - session AIChatSession
    - prompt String

. failure = catch session.send(prompt, null, true)
= failure is not Error

────────────────────
+ do queue-for AIChatQueue
    - session AIChatSession

. found = queues[session.branch-id]
=? found if found
. made = AIChatQueue(session)
queues[session.branch-id] = made
= made

────────────────────
+ do side-chat
    - session AIChatSession
    - prompt String
    - images [AIImage] = List'AIImage()

error = null
. anchor = chat-latest-message(session)
if !anchor
    send(session, prompt, images)
    =
. side = document.side-chat(session.branch-id, anchor)
    catch failure Error
        error = "$failure"
        =
focus = side
side.send(prompt, null, false, images)
    catch failure Error
        error = "$failure"

────────────────────
+ do stop
    - session AIChatSession

session.stop()
    catch failure Error
        error = "$failure"

────────────────────
+ do stop-all
    - session AIChatSession

session.stop-all()
    catch failure Error
        error = "$failure"

────────────────────
+ do request-stop
    - session AIChatSession

stopping <- session

────────────────────
+ do collapse
    - session AIChatSession
    - message-id String

error = null
document.collapse(session.branch-id, message-id)
    catch failure Error
        error = "$failure"

────────────────────
+ do unfold
    - branch-id String

error = null
document.unfold(branch-id)
    catch failure Error
        error = "$failure"
settle-focus()

────────────────────
+ do remove
    - branch-id String

error = null
document.remove(branch-id)
    catch failure Error
        error = "$failure"
settle-focus()

────────────────────
+ do dismiss

error = null

────────────────────
_ do settle-focus

. current = focus
if current && !current.branch
    focus = null

━━━━━━━━━━━━━━━━━━━━
+ ChatBranchings

_ branchings = Map'String'ChatBranching()

────────────────────
+ do branching ChatBranching
    - session AIChatSession

. found = branchings[session.id]
=? found if found != null
. made = ChatBranching(session)
branchings[session.id] = made
= made

━━━━━━━━━━━━━━━━━━━━
+ chat-folds [AIChatBranch]
    - branches [AIChatBranch]

** branches
?> each.is-collapsed
|> List

━━━━━━━━━━━━━━━━━━━━
+ chat-crumb-title
    - session AIChatSession
    - branch AIChatBranch

|? !branch.parent-branch-id
    session.document.title ?? "Chat"
??
    chat-branch-title(branch)

━━━━━━━━━━━━━━━━━━━━
_ chat-main-session AIChatSession
    - root AIChatSession
    - revision U64
    - focus AIChatSession?

match focus?.branch?.parent-branch-id
    |= null
        root
    |? it == root.branch-id
        root
    | parent String
        (catch? root.document.session(parent)) ?? root

━━━━━━━━━━━━━━━━━━━━
_ do chat-latest-message String?
    - session AIChatSession

. transcript = catch? chat-transcript(session.chat, session.branch-id)
=? if !transcript || !transcript.length
= transcript[transcript.length - 1].id
