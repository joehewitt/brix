(import ./chat-attachments)
(import ./chat-caches)
(import ./chat-memory)
(import ./chat-parts)
(import ./chat-theme)
(import /ai)
(import /graphics/point)
(import /graphics/primitives)
(import /gui)
(import /gui/icons/lucide/arrow-up)
(import /gui/icons/lucide/square)
(import /gui/icons/lucide/x)
(import /ui/input)
(blank)
(prop _ chat-composer-max-lines Size (= 8))
(prop _ chat-attachment-limit _ (= (call Dimensions 72 72)))

(type + ChatComposer (is Box)
  (prop + is-busy _ (= false))
  (prop + can-queue _ (= false))
  (prop + has-draft _ (= false))
  (prop + has-extra _ (= false))
  (prop + is-queueing _ (= (and #is-busy #can-queue #has-draft)))
  (prop + placeholder _ (= "Send a message"))
  (prop + branch-modifiers (? PointerModifiers) (= null))
  (prop + images (? AIImageStore))
  (prop + caches _ (= (call ChatBlockCaches)))
  (prop + attachments (list AIImage))
  (prop + problem (? String))
  (prop + flight-key (? String) (= null))
  (event + send ChatDraft)
  (event + queue ChatDraft)
  (event + branch ChatDraft)
  (event + stop Bool)
  (event + drafted ChatDraft)
  (blank)
  (prop _ flight-text _ (= ""))
  (blank)
  (depends extra-changed has-extra)
  (blank)
  (rule chat-composer-leading)
  (rule chat-composer-trailing)
  (content
    (<> This (• chat-composer) (• flex-col)
      (= align-y (. Alignment end))
      (= focus-group true)
      (<> Box (• chat-composer-row) (• flex-row)
        (<> ChatComposerField (id: field-box) (• chat-composer-field) (• flex-col) (• flex 1) (• px 8)
          (if (> (. #attachments length) 0)
            (<> Box (• flex-row) (• pt 12) (• pl 8)
              (for (in image #attachments)
                (<> ChatAttachmentChip (• chat-attachment) (• mr 8)
                  (= image image)
                  (= images images)
                  (= caches caches)
                  (blank)
                  (for (on _ removing)
                    (call detach image)
                  )
                )
              )
            )
          )
          (if (!= #problem null)
            (<> Label (• chat-composer-problem) (• h 18) (• mt 8) (• ml 8)
              (= text (?? #problem ""))
            )
          )
          (<> Box (• flex-row)
            (+<> Box (id: leading) (• chat-composer-leading) (• my 8)
              (= align-y (. Alignment end))
            )
            (<> Box (• flex-row) (• flex 1) (• ml 8)
              (<> TextInput (id: field) (• chat-composer-input) (• flex 1)
                (= focus-default true)
                (= placeholder #placeholder)
                (= is-bare true)
                (= wraps true)
                (= centers-wrapped-text true)
                (= max-lines chat-composer-max-lines)
              )
              (if (!= #flight-key null)
                (<> ChatDraftGhost (• chat-bubble-text) (• chat-draft-ghost) (• absolute)
                  (= anchor (. Anchor parent))
                  (= left (call (. PositionOffset coord) -14))
                  (= bottom (call (. PositionOffset coord) 4))
                  (= match #flight-key)
                  (<> Span
                    (= text #flight-text)
                  )
                )
              )
            )
            (+<> Box (id: trailing) (• chat-composer-trailing) (• flex-row) (• my 8)
              (= align-y (. Alignment end))
            )
            (<> ChatSendButton (id: send-button) (• chat-send-button) (• w 30) (• h 30) (• my 8) (• ml 8)
              (= align-y (. Alignment end))
              (= is-busy (and #is-busy (not #is-queueing)))
              (= is-idle (and (not #is-busy) (not #has-draft)))
            )
          )
        )
      )
    )
  )
  (subscribe-for (on event (. field input))
    (= flight-text (. event text))
    (call settle-draft (. event text))
  )
  (subscribe-for (on event (. field submit))
    (call submit-draft (. event modifiers))
    (call (. event cancel))
  )
  (subscribe-for (on event (. send-button click))
    (if (and is-busy (not is-queueing))
      (<- stop true)
      (else
        (call submit-draft (. event modifiers))
      )
    )
    (call (. event cancel))
  )
  (subscribe-for (on event paste)
    (let entries (if-expr images (. event clipboard images) (call (of List ClipboardEntry))))
    (if (. entries length)
      (call (. event cancel))
      (do-new
        (inline (call attach-entries entries))
      )
    )
  )
  (subscribe-for (on event drag-over)
    (if (and images (call chat-takes-images (. event payload)))
      (= (. field-box is-armed) true)
      (call (. event accept))
    )
  )
  (subscribe-for (on _ drag-leave (when arrival))
    (= (. field-box is-armed) false)
  )
  (subscribe-for (on event drop (when arrival))
    (= (. field-box is-armed) false)
    (do-new
      (inline (call attach-drop (as (. event payload) ClipboardDrag)))
    )
  )
  (fn-do + draft _
    (param text String)
    (= (. field text) text)
    (= flight-text text)
    (call settle-draft text)
    (let ignored (call (. field request-focus)))
  )
  (fn-do + restore _
    (param draft ChatDraft)
    (= (. field text) (. draft text))
    (= flight-text (. draft text))
    (= attachments (call (of List AIImage) (. draft images)))
    (= has-draft (not (. draft is-empty)))
  )
  (fn-do + send-draft _
    (param queues _ (= false))
    (return-if (if (and is-busy (not can-queue))))
    (let draft (call take-draft))
    (return-if (if (and (. draft is-empty) (not has-extra))))
    (if queues
      (<- queue draft)
      (else
        (<- send draft)
      )
    )
  )
  (fn-do + branch-draft _
    (let draft (call take-draft))
    (if (or (not (. draft is-empty)) has-extra)
      (<- branch draft)
    )
  )
  (fn-expr + is-multiline Bool :get
    (!= (call (. field text find) "\n") null)
  )
  (fn-do _ submit-draft _
    (param modifiers PointerModifiers)
    (if (and (!= branch-modifiers null) (call chat-modifiers-match branch-modifiers modifiers))
      (call branch-draft)
      (else
        (call send-draft (call chat-modifiers-match (call chat-queue-modifiers) modifiers))
      )
    )
  )
  (fn-do _ take-draft ChatDraft
    (let draft (call ChatDraft (call (. field text trim)) attachments))
    (return-if draft (if (. draft is-empty)))
    (= (. field text) "")
    (= attachments (call (of List AIImage)))
    (= problem null)
    (call settle-draft "")
    (return draft)
  )
  (fn-do _ settle-draft _
    (param text String)
    (= has-draft (or (> (. (call (. text trim)) length) 0) (> (. attachments length) 0) has-extra))
    (<- drafted (call ChatDraft text (call (of List AIImage) attachments)))
  )
  (fn-do _ extra-changed _
    (= has-draft (or (> (. (call (. field text trim)) length) 0) (> (. attachments length) 0) has-extra))
  )
  (fn-do _ attach-entries _
    (param entries (list ClipboardEntry))
    (= problem null)
    (for (in entry entries)
      (let made (catch (call chat-attachment entry (!! images))))
      (if (is made Error)
        (= problem (. (as made Error) message))
        (else
          (+= attachments made)
        )
      )
    )
    (call settle-draft (. field text))
  )
  (fn-do _ attach-drop _
    (param drag ClipboardDrag)
    (= problem null)
    (let made (call chat-dropped-attachments drag (!! images)))
    (if (not (. made length))
      (= problem "None of the dropped images could be read")
    )
    (for (in image made)
      (+= attachments image)
    )
    (call settle-draft (. field text))
  )
  (fn-do _ detach _
    (param image AIImage)
    (= attachments (call (of List AIImage) (in each attachments (when (!= (as each Pointer) (as image Pointer))))))
    (= problem null)
    (call settle-draft (. field text))
  )
)

(type + ChatDraftGhost (is Text)
  (fn-expr + hit-contains _
    (param point Point)
    false
  )
)

(type + ChatComposerField (is Box)
  (prop + is-armed _ (= false))
)

(type + ChatAttachmentChip (is Box)
  (prop + image AIImage)
  (prop + images (? AIImageStore))
  (prop + caches ChatBlockCaches)
  (event + removing AIImage)
  (content
    (<> This (• flex-col)
      (<> ChatImage
        (= image #image)
        (= images images)
        (= thumbnails (. caches thumbnails))
        (= limit chat-attachment-limit)
      )
      (<> IconButton (id: remove-button) (• chat-attachment-remove) (• icon-x) (• absolute) (• w 18) (• h 18)
        (= anchor (. Anchor parent))
        (= top (call (. PositionOffset coord) 4))
        (= right (call (. PositionOffset coord) 4))
      )
    )
  )
  (subscribe-for (on event (. remove-button click))
    (<- removing image)
    (call (. event cancel))
  )
)

(type + ChatSendButton (is IconButton)
  (prop + is-busy _ (= false))
  (prop + is-idle _ (= false))
  (blank)
  (rule This
    (when-style #is-busy
      (own-rule icon-host
        (<> LucideSquare (slot: first-child) (• icon))
      )
    )
    (blank)
    (when-style (not #is-busy)
      (own-rule icon-host
        (<> LucideArrowUp (slot: first-child) (• icon))
      )
    )
  )
)

(fn-expr _ chat-queue-modifiers PointerModifiers
  (call PointerModifiers
    (block
      (:command true)
    )
  )
)

(fn-expr _ chat-modifiers-match _
  (param wanted PointerModifiers)
  (param pressed PointerModifiers)
  (and same-command same-shift same-option same-control)
  (where
    (lazy same-command (== (. wanted command) (. pressed command)))
    (lazy same-shift (== (. wanted shift) (. pressed shift)))
    (lazy same-option (== (. wanted option) (. pressed option)))
    (lazy same-control (== (. wanted control) (. pressed control)))
  )
)
