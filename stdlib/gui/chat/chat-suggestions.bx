(import ./chat-theme)
(import /ai)
(import /graphics/text)
(import /gui)
(import /gui/icons/lucide/arrow-up-right)
(import /gui/icons/lucide/message-square)
(import /gui/icons/lucide/play)
(import /gui/icons/lucide/x)

(style-extend GUIDefaultTheme
  (using GUIBoxCursor)
  (rule chat-suggestion (• bg gui-well-color)
    (= border-color gui-border-color)
    (= border-width 1)
    (= corner-radius gui-card-radius)
  )
  (blank)
  (rule chat-suggestion-link (• bg gui-well-color)
    (= border-color gui-border-color)
    (= border-width 1)
    (= corner-radius gui-card-radius)
    (= cursor (. CursorStyle pointing-hand))
    (blank)
    (when-style #is-hover-within
      (• bg gui-hover-color)
    )
  )
  (blank)
  (rule chat-suggestion-static (• bg gui-well-color)
    (= border-color gui-border-color)
    (= border-width 1)
    (= corner-radius gui-card-radius)
  )
  (blank)
  (rule chat-suggestion-link-icon (• text gui-muted-text-color) (• w 14) (• h 14))
  (blank)
  (rule chat-suggestion-link-title (• text gui-strong-text-color)
    (= font-size gui-body-font-size)
    (= font-weight (. FontWeight medium))
    (= text-wrap (. TextWrap no-wrap))
    (= text-overflow (. TextOverflow truncate-tail))
  )
  (blank)
  (rule chat-suggestion-link-action (• text gui-muted-text-color)
    (= font-size gui-footnote-font-size)
    (= text-wrap (. TextWrap no-wrap))
  )
  (blank)
  (rule chat-suggestion-kind (• bg gui-hover-color) (• text gui-muted-text-color) (• px 6) (• py 2)
    (= corner-radius 4)
    (= font-size gui-footnote-font-size)
    (= font-weight (. FontWeight medium))
    (= text-wrap (. TextWrap no-wrap))
  )
  (blank)
  (rule chat-suggestion-title (• text gui-strong-text-color)
    (= font-size gui-body-font-size)
    (= font-weight (. FontWeight bold))
    (= line-spacing 3)
  )
  (blank)
  (rule chat-suggestion-summary (• text gui-muted-text-color)
    (= font-size gui-callout-font-size)
    (= line-spacing 3)
  )
)

(type + ChatSuggestedTaskState (is Union)
  (variant open)
  (variant started (tuple (: chat-id (? String))))
  (variant dismissed)
)

(type-line + ChatSuggestedTaskResolver (is (fn-type ChatSuggestedTaskState (param task AISuggestedTask))))

(type + ChatSuggestedTaskActionKind (is Union)
  (variant start)
  (variant do-here)
  (variant dismiss)
  (variant open-chat)
)

(type + ChatSuggestedTaskAction (is Tuple)
  (prop + task AISuggestedTask)
  (prop + kind ChatSuggestedTaskActionKind)
  (prop + chat-id (? String) (= null))
)

(type + ChatSuggestedTaskView (is Box)
  (prop + task AISuggestedTask)
  (prop + state ChatSuggestedTaskState (= (. ChatSuggestedTaskState open)))
  (prop + current-chat-id (? String) (= null))
  (prop + started-chat-id (? String) (= (call chat-suggestion-started-id #state)))
  (prop + is-started _ (= (is #state .started)))
  (prop + is-dismissed _ (= (is #state .dismissed)))
  (prop + is-here _ (= (and (!= #started-chat-id null) (!= #current-chat-id null) (== #started-chat-id #current-chat-id))))
  (prop + can-open _ (= (and (!= #started-chat-id null) (not #is-here))))
  (event + acted ChatSuggestedTaskAction)
  (content
    (<> This (• flex-col)
      (= display (if-expr #is-dismissed (. Display hidden) (. Display visible)))
      (if #is-started
        (if #can-open
          (<> Box (• chat-suggestion-link) (• flex-row) (• items-center) (• px 12) (• py 9)
            (<> LucideMessageSquare (• icon) (• chat-suggestion-link-icon) (• mr 8))
            (<> Label (• chat-suggestion-link-title) (• flex 1)
              (= text (. #task title))
            )
            (<> Label (• chat-suggestion-link-action) (• ml 10) (• mr 4)
              (= text "Open chat")
            )
            (<> LucideArrowUpRight (• icon) (• chat-suggestion-link-icon))
            (for (on event click)
              (call open-chat)
              (call (. event cancel))
            )
          )
          (else
            (<> Box (• chat-suggestion-static) (• flex-row) (• items-center) (• px 12) (• py 9)
              (<> LucideMessageSquare (• icon) (• chat-suggestion-link-icon) (• mr 8))
              (<> Label (• chat-suggestion-link-title) (• flex 1)
                (= text (. #task title))
              )
              (<> Label (• chat-suggestion-link-action) (• ml 10)
                (= text (if-expr #is-here "Started here" "Started"))
              )
            )
          )
        )
        (else
          (<> Box (• chat-suggestion) (• flex-col) (• px 14) (• pt 11) (• pb 10)
            (<> Box (• flex-row) (• items-center)
              (<> Label (• chat-suggestion-kind) (• mr 8)
                (= text (call chat-suggestion-kind-label (. #task kind)))
              )
              (<> Text (• chat-suggestion-title) (• flex 1)
                (<> Span
                  (= text (. #task title))
                )
              )
              (<> IconButton (id: dismiss-button) (• icon-x) (• w 22) (• h 22)
                (= action (=> () :do (call dismiss)))
                (<> Tooltip (text: "Dismiss"))
              )
            )
            (if (> (. #task summary length) 0)
              (<> Text (• chat-suggestion-summary) (• mt 4)
                (<> Span
                  (= text (. #task summary))
                )
              )
            )
            (<> Box (• flex-row) (• items-center) (• mt 10)
              (<> Button (id: start-button) (• mr 8)
                (= title "Start")
                (= role (. ButtonRole default))
                (= action (=> () :do (call trigger (. ChatSuggestedTaskActionKind start))))
                (<> LucidePlay (slot: leading) (• icon))
              )
              (<> Button (id: here-button)
                (= title "Do it here")
                (= action (=> () :do (call trigger (. ChatSuggestedTaskActionKind do-here))))
              )
            )
          )
        )
      )
    )
  )
  (fn-do _ trigger _
    (param kind ChatSuggestedTaskActionKind)
    (<- acted (call ChatSuggestedTaskAction task kind))
  )
  (fn-do _ dismiss _
    (<- acted (call ChatSuggestedTaskAction task (. ChatSuggestedTaskActionKind dismiss)))
  )
  (fn-do _ open-chat _
    (let target started-chat-id)
    (return-if (if (not target)))
    (<- acted (call ChatSuggestedTaskAction task (. ChatSuggestedTaskActionKind open-chat) target))
  )
)

(fn-expr _ chat-suggestion-started-id (? String)
  (param state ChatSuggestedTaskState)
  (match state
    (case (call .started chat-id)
      chat-id
    )
    (default
      null
    )
  )
)

(fn-expr _ chat-suggestion-kind-label String
  (param kind String)
  (match kind
    (case= "bug"
      "Bug"
    )
    (case= "perf"
      "Perf"
    )
    (case= "cleanup"
      "Cleanup"
    )
    (default
      "Follow-up"
    )
  )
)
