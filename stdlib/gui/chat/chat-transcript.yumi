+ is-launched = #launch != null
+ text = ai-parts-text(#message.parts)
+ event open Bool
+ event expanding Bool

────────────────────

<This • chat-prompt flex-row
    <Box • flex:1
    if #is-collapsed
        <Button bubble • chat-bare chat-bubble px:14 py:9
            <Box (leading) • flex-col flex:1
                <Text • chat-bubble-text
                    <Span
                        text = chat-prompt-summary(#message.parts)
    else
        <ChatPromptCard • chat-bubble flex-col px:14 pt:9
            padding-bottom = if #text.length > 0 then 0 else 9
            launch = #launch
            match = #launch?.key
            if chat-prompt-images(#message.parts).length > 0
                <Box • flex-row py:2
                    for image in chat-prompt-images(#message.parts)
                        <ChatImage • chat-image mr:6
                            image = image
                            images = images
                            thumbnails = caches.thumbnails
                            limit = chat-prompt-image-limit
            if #text.length > 0
                <ChatPromptBody • chat-prompt-body flex-col
                    <MarkdownView • chat-bubble-markdown
                        text = #text
                        cache = caches.cache-for("${#message.id}/prompt")
            if #is-long || #is-expanded
                <Button more • chat-bare chat-stack-toggle mt:2 mb:8
                    title = if #is-expanded then "Show less" else "Show more"

────────────────────
for event on bubble.click

open <- true
event.cancel()

────────────────────
for event on more.click

expanding <- !state.is-expanded
state.is-expanded = !state.is-expanded
event.cancel()

────────────────────
+ do note-body
    - body ChatPromptBody

=? if state.is-expanded
. overflowing = body.has-vertical-overflow
if overflowing != is-long
    is-long = overflowing

