+ ChatTranscript is Box
    is ChatImageOpener

+ session AIChatSession
+ branching ChatBranching
+ services [AIChatService]
+ caches = ChatBlockCaches()
+ images AIImageStore?
+ gutter VirtualCoord = 0vcoord
+ top-inset Length = 0
+ greeting = ""
+ has-folds = false
+ insertion = ChatInsertion.pins-prompt
+ event answering String
+ source = ChatMessageSource(#session, #has-folds)
+ is-end-hidden = false
+ is-launching = #launched?.#is-flying ?? false

_ jumped I64?
_ launched ChatLaunch?
_ is-denied = session.document.#service.access?.#is-granted == false
_ row-inset = if #is-denied then 0 else #top-inset
_ row-leading = chat-row-leading + (ceil(#row-inset) as VirtualCoord)
_ prompt-inset = chat-prompt-inset + #row-inset

────────────────────

<This • flex-col
    if session.document.#is-empty
        <Label • chat-empty h:28
            margin-top = 144 + #top-inset
            text = #greeting
        if #services.length > 1
            <SegmentedControl'AIChatService • mt:20
                align-x = Alignment.center
                selected = session.document.#service
                for event on selection-changing
                    . failure = catch session.document.choose(event.value)
                    if failure is AIError
                        event.cancel()
                for service in #services keyed by service.id
                    <Segment'AIChatService
                        title = service.title
                        value = service
                        <ChatServiceIcon (leading) • icon
                            icon = service.icon
                            display = if service.icon != null then Display.visible else Display.hidden
    if #is-denied
        <ChatAccessCard
            margin-top = 24 + (if session.document.#is-empty then 0 else #top-inset)
            service = session.document.#service
            access = session.document.#service.access!
    <VirtualRegion'ChatRow rows • chat-transcript flex:1
        source = #source
        virtual-layout = chat-row-layout(#source, row-leading, gutter)
        overscan = VirtualInsets(chat-row-overscan, 0vcoord, chat-row-overscan, 0vcoord)
        retention = VirtualInsets(chat-row-retention, 0vcoord, chat-row-retention, 0vcoord)
        anchors-end = true

        <Box (row) - slot • flex-col
            <Box • chat-column flex-col pl:18
                for row in [slot.#item] keyed by row.key
                    <ChatMessageRow
                        row = row
                        session = session
                        branching = branching
                        caches = caches
                        images = images
                        has-folds = #has-folds
                        launch = chat-row-launch(#launched, row)
                        for toggled on toggle
                            fold-toggle(toggled)
                        for pinned on pin
                            pin-row(pinned)
                        for shrunk on shrink
                            pin-row(shrunk) • reveals-start true
                        for text on answer
                            answering <- text
    <ChatImageViewer viewer
        images = images

────────────────────
whenever #gutter

if | layout VerticalMeasuredLayout = rows.virtual-layout
    layout.trailing = chat-row-trailing + gutter

────────────────────
whenever #row-leading

if | layout VerticalMeasuredLayout = rows.virtual-layout
    layout.leading = row-leading

────────────────────
whenever session.#turn-count

show-turn()

────────────────────
whenever session.#is-busy

if !session.is-busy
    launched = null

────────────────────
whenever #is-launching

if !is-launching
    launched = null

────────────────────
for _ on rows.scroll-changed when arrival

check-end()

────────────────────
whenever rows.#virtual-extent-y

check-end()

────────────────────
whenever rows.#follows-end

check-end()

────────────────────
+ do jump-to-start

jumped = null
rows.restore-scroll(Point(0, 0))

────────────────────
+ do jump-to-end

jumped = null
rows.follow-end()
is-end-hidden = false

────────────────────
+ do launch
    - key String

. address = source.prompt-address()
=? if address == null
launched = ChatLaunch(source.row-at(address).message.id, key)

────────────────────
+ do page
    - forward Bool

jumped = null
. step = max
    - rows.content-bounds.height - (gutter as Length) - row-inset - chat-page-overlap
    - chat-page-overlap
. target = if forward then ahead else max(rows.scroll-y - step, 0)
    .. ahead = min(rows.scroll-y + step, rows.scroll-max.y)
rows.restore-scroll(Point(rows.scroll-x, target))

────────────────────
+ do jump-to-prompt
    - forward Bool

. found = prompt-beyond(forward)
if found == null
    if forward
        jump-to-end()
    else
        jump-to-start()
    =
jumped = found
. ignored = rows.glide-to-address(found, prompt-inset)

────────────────────
_ do prompt-beyond I64?
    - forward Bool

. origin = jumped if rows.is-gliding
. count = source.row-count() as I64
. step I64 = if forward then 1 else -1
. index I64 = if forward then 0 else count - 1
while index >= 0 && index < count
    if chat-row-is-prompt(source.row-at(index)) && is-beyond(index, origin, forward)
        = index
    index += step
= null

────────────────────
_ is-beyond Bool
    - address I64
    - origin I64?
    - forward Bool

|? origin != null
    if forward then address > origin else address < origin
|? offset == null
    false
??
    if forward then offset > prompt-inset + 1 else offset < prompt-inset - 1

.. offset = rows.address-offset(address)

────────────────────
_ do check-end

. extent = rows.virtual-extent-y.known as Length
. hidden = !rows.follows-end && rows.scroll-y + rows.content-bounds.height < extent - chat-end-slack
if hidden != is-end-hidden
    is-end-hidden = hidden

────────────────────
_ do show-turn

if insertion == ChatInsertion.pins-prompt
    . address = source.prompt-address()
    if address != null
        jumped = null
        . ignored = rows.glide-to-address(address, prompt-inset)
        =
jumped = null
rows.glide-to-end()
is-end-hidden = false

────────────────────
+ do open-image
    - image AIImage

. pictures = chat-viewer-pictures(session.messages)
for index in 0 .. < pictures.length
    if pictures[index] as Pointer == image as Pointer
        viewer.present(pictures, index)
        =
viewer.present([image], 0)

────────────────────
+ do mounted

super.mounted()
restore-scroll()

────────────────────
+ do unmounted

keep-scroll()
super.unmounted()

────────────────────
_ do keep-scroll

if rows.follows-end
    branching.memory.keep-scroll(session.branch-id, ChatScrollMark("", 0, true))
    =
. count = source.row-count()
=? if count == 0
. top I64
. top-offset Length = 0
for address in 0 .. < count
    . offset = rows.address-offset(address)
    if offset != null && offset <= 0
        top = address
        top-offset = offset
. row = source.row-at(top)
branching.memory.keep-scroll(session.branch-id, ChatScrollMark(row.message.id, top-offset, false))

────────────────────
_ do restore-scroll

. mark = branching.memory.scroll-for(session.branch-id)
=? if !mark || mark.is-at-end
. shown = source.message-address(mark.message-id)
=? if shown == null
rows.pin-address(shown, mark.offset)

────────────────────
_ do pin-row
    - row ChatRow
    - reveals-start = false

. shown = source.message-address(row.message.id)
=? if shown == null
. offset = rows.address-offset(shown)
=? if offset == null
rows.pin-address(shown, if reveals-start && offset < row-inset then prompt-inset else offset)

────────────────────
_ do fold-toggle
    - row ChatRow

. id = row.message.id
. shown = source.message-address(id)
. offset = rows.address-offset(shown) if shown != null
if row.fold
    branching.unfold(row.fold.id)
else
    branching.collapse(session, id)
. moved = source.message-address(id)
if moved != null && offset != null
    rows.pin-address(moved, offset)

━━━━━━━━━━━━━━━━━━━━
+ ChatMessageRow is Box

+ row ChatRow
+ session AIChatSession
+ branching ChatBranching
+ caches ChatBlockCaches
+ images AIImageStore?
+ has-folds = false
+ launch ChatLaunch? = null
+ message = #row.message
+ fold = #row.fold
+ is-user = #message.role == AIMessageRole.user
+ is-folded = #fold != null
+ can-collapse =
    |? #has-folds && #is-user && !session.#is-busy
        chat-can-collapse-at
            - session.document.#chat
            - session.branch-id
            - #message.id
    ??
        false
+ can-unfold = !session.#is-busy && chat-fold-unfolds(session.document.#chat, #fold)
+ can-toggle = if #is-folded then #can-unfold else #can-collapse
+ is-open = #is-folded && branching.#focus?.branch-id == #fold!.id
+ is-fold-revealed = #is-folded || #is-hover-within
+ has-actions = !#is-folded && (#is-user || #message.#finish-reason != null)
+ has-menu = !#is-folded
+ can-copy = false
+ question = ai-reply-question(#message.#parts) if #row.is-last && #message.#finish-reason != null && !session.#is-busy
+ event toggle ChatRow
+ event pin ChatRow
+ event shrink ChatRow
+ event answer String

────────────────────

<This • flex-row
    if #has-menu
        <ContextMenu message-menu
            <MenuItem "Copy"
                key = copy-key
                is-enabled = #can-copy
                action = => do copy-selection()
            <MenuItem "Copy Message"
                action = => do copy-message()
    <Box message-column • flex-col flex:1
        if #is-folded
            <ChatPrompt fold-prompt
                message = #message
                caches = caches
                images = images
                is-collapsed = true
                is-open = #is-open
        else if #is-user
            <ChatPrompt prompt
                message = #message
                caches = caches
                images = images
                state = branching.memory.prompt-for(#message.id)
                launch = #launch
        else
            <ChatReply reply
                message = #message
                session = session
                messages = session.#messages
                caches = caches
                images = images
                memory = branching.memory
                is-wake = #row.is-wake
        if #has-actions
            <ChatMessageActions • mt:2
                message = #message
                is-user = #is-user
                is-shown = message-column.#is-hover-within
        if #question != null
            <ChatQuestionView question-view • mt:10
                question = #question!
        if !#has-actions
            <Box • h:18
    <Box • flex-col w:18
        if #can-toggle || #is-folded
            <ChatFoldButton fold-button • w:16 h:16 ml:2 mt:10
                is-collapsed = #is-folded
                is-revealed = #is-fold-revealed
                is-enabled = #can-toggle

────────────────────
for event on fold-button.click

toggle <- row
event.cancel()

────────────────────
for _ on reply.resizing

pin <- row

────────────────────
for expanded on prompt.expanding

if expanded
    pin <- row
else
    shrink <- row

────────────────────
for text on question-view.answering

answer <- text

────────────────────
for _ on fold-prompt.open

branching.open(fold!.id)

────────────────────
for _ on message-menu.opened when arrival

can-copy = chat-message-selection(this) != null

────────────────────
_ do copy-selection

. view = chat-message-selection(this)
if view
    . ignored = Clipboard().write-text(view.selected-source())

────────────────────
_ do copy-message

. ignored = Clipboard().write-text(chat-copy-text(message.parts))

