+ row-count Size

current-rows().length

────────────────────
+ row-at ChatRow
    - address I64

current-rows()[address]

────────────────────
+ do prompt-address I64?

. found = current-rows()
. index = found.length
while index > 0
    index -= 1
    . row = found[index]
    =? index as I64 if row.fold == null && row.message.role == AIMessageRole.user
= null

────────────────────
+ do message-address I64?
    - id String

. found = current-rows()
. index Index
while index < found.length
    =? index as I64 if found[index].message.id == id
    index += 1
= null

────────────────────
+ get known-count VirtualCoord

current-rows().length

────────────────────
+ get estimated-count VirtualCoord?

current-rows().length as VirtualCoord

────────────────────
+ get is-final Bool

true

────────────────────
+ address-at I64
    - index VirtualCoord

index

────────────────────
+ index-of VirtualCoord?
    - address I64

|? address < 0 || address >= (current-rows().length as I64)
    null
??
    address as VirtualCoord

────────────────────
+ get domain VirtualSequenceDomain

this

────────────────────
+ do bind
    - address I64
    - generation U64
    - target VirtualBindingTarget'ChatRow

. found = current-rows()
if address < 0 || address >= (found.length as I64)
    target.fail(generation)
else
    target.commit(VirtualKey(revision.value, address), found[address], generation)

────────────────────
+ do identity-at U64?
    - address I64

. found = current-rows()
=? if address < 0 || address >= (found.length as I64)
= hash-for(found[address].key) as U64

────────────────────
_ do current-rows [ChatRow]

. key = session.revision + session.document.revision
if !is-built || key != built
    rows = chat-rows(session, has-folds)
    if rows.length > 0
        . last = rows[rows.length - 1]
        rows[rows.length - 1] = ChatRow
            - last.key
            - last.message
            - last.fold
            - true
            - last.is-wake
    built = key
    is-built = true
= rows

━━━━━━━━━━━━━━━━━━━━
_ do chat-rows [ChatRow]
    - session AIChatSession
    - has-folds Bool

. chat = session.chat
. folds = if has-folds then chat-folds(child-branches) else List'AIChatBranch()
    .. child-branches = chat-child-branches(chat, session.branch-id)
. owned = Map'String'Bool()
for message in session.messages
    owned[message.id] = true
. rows = List'ChatRow()
for fold in folds
    . anchor = fold.fork-message-id
    if !anchor || !(owned has anchor)
        chat-add-fold(rows, fold)
. previous AIMessageRole? = null
for message in session.messages
    . is-wake = message.role == AIMessageRole.assistant && previous == AIMessageRole.assistant
    previous = message.role
    rows += ChatRow(message.id, message) • is-wake is-wake
    for fold in folds
        if fold.fork-message-id == message.id
            chat-add-fold(rows, fold)
= rows

━━━━━━━━━━━━━━━━━━━━
_ chat-row-launch ChatLaunch?
    - launched ChatLaunch?
    - row ChatRow

|? launched && launched.message-id == row.message.id
    launched
??
    null

━━━━━━━━━━━━━━━━━━━━
_ chat-row-is-prompt Bool
    - row ChatRow

row.fold == null && row.message.role == AIMessageRole.user

━━━━━━━━━━━━━━━━━━━━
_ do chat-add-fold
    - rows [ChatRow]
    - fold AIChatBranch

. prompt = chat-branch-prompt(fold)
if prompt
    rows += ChatRow("fold:${fold.id}", prompt, fold)

━━━━━━━━━━━━━━━━━━━━
_ chat-fold-unfolds
    - chat AIChat
    - fold AIChatBranch?

fold != null && chat-can-unfold(chat, fold.id)

━━━━━━━━━━━━━━━━━━━━
_ chat-row-layout
    - source ChatMessageSource
    - leading VirtualCoord
    - gutter VirtualCoord

VerticalMeasuredLayout(chat-row-estimate, estimate, leading, chat-row-trailing + gutter)

.. estimate = :: address, width => chat-message-estimate(source.row-at(address).message, width)

━━━━━━━━━━━━━━━━━━━━
_ chat-message-estimate
    - message AIChatMessage
    - width VirtualCoord

lines * chat-estimated-line + chat-estimated-gap

.. column = if width > chat-estimated-column then chat-estimated-column else width
.. line-size = (if is-narrow then 1vcoord else column / chat-estimated-char-span)
.. is-narrow = column < chat-estimated-char-span
.. found = 1vcoord + chat-message-lines(message, line-size)
.. is-clamped = message.role == AIMessageRole.user && found > chat-estimated-prompt-lines
.. lines = if is-clamped then chat-estimated-prompt-lines else found

━━━━━━━━━━━━━━━━━━━━
_ do chat-message-lines VirtualCoord
    - message AIChatMessage
    - line-size VirtualCoord

. size Size = 0
. calls Size = 0
. images Size = 0
. rows Size = 0
. run Size = 0
for part in message.parts
    if part is AIImagePart
        run += 1
    else
        images += chat-run-images(run)
        rows += chat-run-rows(run)
        run = 0
    if | text AITextPart = part
        size += text.text.size
    else if | reasoning AIReasoningPart = part
        size += reasoning.text.size
    else if | call AIToolCallPart = part
        size += ai-call-reply(call)?.size ?? 0
        calls += 1
images += chat-run-images(run)
rows += chat-run-rows(run)
. image-lines = (images as VirtualCoord) * chat-estimated-image-lines + row-lines
    .. row-lines = (rows as VirtualCoord) * chat-estimated-image-row-lines
= (size as VirtualCoord) / line-size + (calls as VirtualCoord) + image-lines

━━━━━━━━━━━━━━━━━━━━
_ chat-run-images Size
    - run Size

if run == 1 then 1 else 0

━━━━━━━━━━━━━━━━━━━━
_ chat-run-rows Size
    - run Size

if run > 1 then (run + chat-estimated-image-columns - 1) / chat-estimated-image-columns else 0
