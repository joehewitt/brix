./chat-attachments
./chat-caches
./chat-memory
./chat-parts
./chat-theme
/ai
/graphics/point
/graphics/primitives
/gui
/gui/icons/lucide/arrow-up
/gui/icons/lucide/square
/gui/icons/lucide/x
/ui/input

_ chat-composer-max-lines Size = 8
_ chat-attachment-limit = Dimensions(72, 72)

━━━━━━━━━━━━━━━━━━━━
+ ChatComposer is Box

+ is-busy = false
+ can-queue = false
+ has-draft = false
+ has-extra = false
+ is-queueing = #is-busy && #can-queue && #has-draft
+ placeholder = "Send a message"
+ branch-modifiers PointerModifiers? = null
+ images AIImageStore?
+ caches = ChatBlockCaches()
+ attachments [AIImage]
+ problem String?
+ flight-key String? = null
+ event send ChatDraft
+ event queue ChatDraft
+ event branch ChatDraft
+ event stop Bool
+ event drafted ChatDraft

_ flight-text = ""

. extra-changed < has-extra

────────────────────

<This • chat-composer flex-col
    align-y = Alignment.end
    focus-group = true
    <Box • chat-composer-row flex-row
        <ChatComposerField field-box • chat-composer-field flex-col flex:1 px:8
            if #attachments.length > 0
                <Box • flex-row pt:12 pl:8
                    for image in #attachments
                        <ChatAttachmentChip • chat-attachment mr:8
                            image = image
                            images = images
                            caches = caches

                            for _ on removing
                                detach(image)
            if #problem != null
                <Label • chat-composer-problem h:18 mt:8 ml:8
                    text = #problem ?? ""
            <Box • flex-row
                + <Box leading • chat-composer-leading my:8
                    align-y = Alignment.end
                <Box • flex-row flex:1 ml:8
                    <TextInput field • chat-composer-input flex:1
                        focus-default = true
                        placeholder = #placeholder
                        is-bare = true
                        wraps = true
                        centers-wrapped-text = true
                        max-lines = chat-composer-max-lines
                    if #flight-key != null
                        <ChatDraftGhost • chat-bubble-text chat-draft-ghost absolute
                            anchor = Anchor.parent
                            left = PositionOffset.coord(-14)
                            bottom = PositionOffset.coord(4)
                            match = #flight-key
                            <Span
                                text = #flight-text
                + <Box trailing • chat-composer-trailing flex-row my:8
                    align-y = Alignment.end
                <ChatSendButton send-button • chat-send-button w:30 h:30 my:8 ml:8
                    align-y = Alignment.end
                    is-busy = #is-busy && !#is-queueing
                    is-idle = !#is-busy && !#has-draft

────────────────────
for event on field.input

flight-text = event.text
settle-draft(event.text)

────────────────────
for event on field.submit

submit-draft(event.modifiers)
event.cancel()

────────────────────
for event on send-button.click

if is-busy && !is-queueing
    stop <- true
else
    submit-draft(event.modifiers)
event.cancel()

────────────────────
for event on paste

. entries = if images then event.clipboard.images else List'ClipboardEntry()
if entries.length
    event.cancel()
    do new attach-entries(entries)

────────────────────
for event on drag-over

if images && chat-takes-images(event.payload)
    field-box.is-armed = true
    event.accept()

────────────────────
for _ on drag-leave when arrival

field-box.is-armed = false

────────────────────
for event on drop when arrival

field-box.is-armed = false
do new attach-drop(event.payload as ClipboardDrag)

────────────────────
+ do draft
    - text String

field.text = text
flight-text = text
settle-draft(text)
. ignored = field.request-focus()

────────────────────
+ do restore
    - draft ChatDraft

field.text = draft.text
flight-text = draft.text
attachments = List'AIImage(draft.images)
has-draft = !draft.is-empty

────────────────────
+ do send-draft
    - queues = false

=? if is-busy && !can-queue
. draft = take-draft()
=? if draft.is-empty && !has-extra
if queues
    queue <- draft
else
    send <- draft

────────────────────
+ do branch-draft

. draft = take-draft()
if !draft.is-empty || has-extra
    branch <- draft

────────────────────
+ get is-multiline Bool

field.text.find("\n") != null

────────────────────
_ do submit-draft
    - modifiers PointerModifiers

if branch-modifiers != null && chat-modifiers-match(branch-modifiers, modifiers)
    branch-draft()
else
    send-draft(chat-modifiers-match(chat-queue-modifiers(), modifiers))

────────────────────
_ do take-draft ChatDraft

. draft = ChatDraft(field.text.trim(), attachments)
=? draft if draft.is-empty
field.text = ""
attachments = List'AIImage()
problem = null
settle-draft("")
= draft

────────────────────
_ do settle-draft
    - text String

has-draft = text.trim().length > 0 || attachments.length > 0 || has-extra
drafted <- ChatDraft(text, List'AIImage(attachments))

────────────────────
_ do extra-changed

has-draft = field.text.trim().length > 0 || attachments.length > 0 || has-extra

────────────────────
_ do attach-entries
    - entries [ClipboardEntry]

problem = null
for entry in entries
    . made = catch chat-attachment(entry, images!)
    if made is Error
        problem = (made as Error).message
    else
        attachments += made
settle-draft(field.text)

────────────────────
_ do attach-drop
    - drag ClipboardDrag

problem = null
. made = chat-dropped-attachments(drag, images!)
if !made.length
    problem = "None of the dropped images could be read"
for image in made
    attachments += image
settle-draft(field.text)

────────────────────
_ do detach
    - image AIImage

attachments = List'AIImage(each in attachments when each as Pointer != image as Pointer)
problem = null
settle-draft(field.text)

━━━━━━━━━━━━━━━━━━━━
+ ChatDraftGhost is Text

────────────────────
+ hit-contains
    - point Point

false

━━━━━━━━━━━━━━━━━━━━
+ ChatComposerField is Box

+ is-armed = false

━━━━━━━━━━━━━━━━━━━━
+ ChatAttachmentChip is Box

+ image AIImage
+ images AIImageStore?
+ caches ChatBlockCaches
+ event removing AIImage

────────────────────

<This • flex-col
    <ChatImage
        image = #image
        images = images
        thumbnails = caches.thumbnails
        limit = chat-attachment-limit
    <IconButton remove-button • chat-attachment-remove icon-x absolute w:18 h:18
        anchor = Anchor.parent
        top = PositionOffset.coord(4)
        right = PositionOffset.coord(4)

────────────────────
for event on remove-button.click

removing <- image
event.cancel()

━━━━━━━━━━━━━━━━━━━━
+ ChatSendButton is IconButton

+ is-busy = false
+ is-idle = false

• This
    when #is-busy
        • own icon-host
            <LucideSquare (first-child) • icon

    when !#is-busy
        • own icon-host
            <LucideArrowUp (first-child) • icon

━━━━━━━━━━━━━━━━━━━━
_ chat-queue-modifiers PointerModifiers

PointerModifiers()
    • command true

━━━━━━━━━━━━━━━━━━━━
_ chat-modifiers-match
    - wanted PointerModifiers
    - pressed PointerModifiers

same-command && same-shift && same-option && same-control

.. same-command = wanted.command == pressed.command
.. same-shift = wanted.shift == pressed.shift
.. same-option = wanted.option == pressed.option
.. same-control = wanted.control == pressed.control
