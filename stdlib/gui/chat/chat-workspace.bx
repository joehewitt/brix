(import ./chat-access)
(import ./chat-branching)
(import ./chat-caches)
(import ./chat-composer)
(import ./chat-memory)
(import ./chat-queue)
(import ./chat-suggestions)
(import ./chat-theme)
(import ./chat-transcript)
(import /ai)
(import /graphics/primitives)
(import /gui)
(import /gui/icons/lucide/arrow-down)
(import /gui/icons/lucide/merge)
(import /gui/icons/lucide/trash-2)
(import /gui/icons/lucide/x)
(import /gui/markdown)
(import /math)
(import /ui/input)
(import /ui/virtual)
(blank)
(prop _ chat-composer-rest VirtualCoord (= 76vcoord))
(prop _ chat-dock-scroll-room Length (= 10))
(prop _ chat-dock-backdrop-top Length (= 20))

(type + ChatWording (is Tuple)
  (prop + greeting _ (= ""))
  (prop + placeholder _ (= "Send a message"))
  (prop + branch-placeholder _ (= "Send a message"))
)

(type + ChatWorkspace (is Box)
  (prop + branching ChatBranching)
  (prop + references (? MarkdownReferences))
  (prop + reference-origin (? String))
  (prop + services (list AIChatService))
  (prop + caches _ (= (call ChatBlockCaches)))
  (prop + images (? AIImageStore))
  (prop + wording _ (= (call ChatWording)))
  (prop + branch-modifiers (? PointerModifiers) (= null))
  (prop + has-folds _ (= false))
  (prop + insertion _ (= (. ChatInsertion pins-prompt)))
  (prop + top-inset Length (= 0))
  (prop + suggestion-state (? ChatSuggestedTaskResolver) (= null))
  (prop + suggestion-revision U64 (= 0))
  (event + suggested-task ChatSuggestedTaskAction)
  (blank)
  (prop _ pane-inset _ (= (if-expr (!= (. branching #error) null) 0 #top-inset)))
  (content
    (<> This (• flex-col)
      (if (!= (. branching #error) null)
        (<> Box (• chat-branch-error) (• flex-row) (• px 16) (• py 8)
          (= margin-top #top-inset)
          (<> Text (• chat-error) (• flex 1)
            (= align-y (. Alignment center))
            (<> Span
              (= text (?? (. branching #error) ""))
            )
          )
          (<> IconButton (id: dismiss-button) (• icon-x) (• w 22) (• h 22))
        )
      )
      (<> MarkdownReferenceScope (• flex-row) (• flex 1)
        (= references #references)
        (= origin #reference-origin)
        (for (in main (list (. branching #main)) (keyed-by (. main branch-id)))
          (<> ChatPane (• flex 1)
            (= session main)
            (= branching branching)
            (= services #services)
            (= caches caches)
            (= images images)
            (= wording #wording)
            (= branch-modifiers #branch-modifiers)
            (= has-folds #has-folds)
            (= insertion #insertion)
            (= top-inset #pane-inset)
            (= suggestion-state #suggestion-state)
            (= suggestion-revision #suggestion-revision)
            (for (on action suggested-task)
              (<- suggested-task action)
            )
          )
        )
        (if (!= (. branching #focus) null)
          (for (in side (list (!! (. branching #focus))) (keyed-by (. side branch-id)))
            (<> ChatPane (• chat-side-pane) (• w 480)
              (= session side)
              (= branching branching)
              (= services #services)
              (= caches caches)
              (= images images)
              (= wording #wording)
              (= branch-modifiers #branch-modifiers)
              (= has-folds #has-folds)
              (= insertion #insertion)
              (= is-side true)
              (= top-inset #pane-inset)
              (= suggestion-state #suggestion-state)
              (= suggestion-revision #suggestion-revision)
              (for (on action suggested-task)
                (<- suggested-task action)
              )
            )
          )
        )
      )
    )
  )
  (subscribe-for (on event (. dismiss-button click))
    (call (. branching dismiss))
    (call (. event cancel))
  )
)

(type + ChatPane (is Box)
  (prop + session AIChatSession)
  (prop + branching ChatBranching)
  (prop + services (list AIChatService) (= (call (of List AIChatService))))
  (prop + caches _ (= (call ChatBlockCaches)))
  (prop + images (? AIImageStore))
  (prop + wording _ (= (call ChatWording)))
  (prop + branch-modifiers (? PointerModifiers) (= null))
  (prop + has-folds _ (= false))
  (prop + insertion _ (= (. ChatInsertion pins-prompt)))
  (prop + is-side _ (= false))
  (prop + is-branch _ (= (!= (. #session branch-id) (. branching root branch-id))))
  (prop + queue _ (= (call (. branching queue-for) #session)))
  (prop + has-queue _ (= (> (. #queue #items length) 0)))
  (prop + behind _ (= (call (. #session working-behind) (. #session tool-tasks #revision))))
  (prop + is-working-behind _ (= (> (. #behind length) 0)))
  (prop + dock-height Length (= 0))
  (prop + gutter _ (= (call chat-dock-gutter #dock-height)))
  (prop + top-inset Length (= 0))
  (prop + is-connected _ (= (?? (?. (. #session document #service access) #is-granted) true)))
  (prop + is-asking _ (= (and (. #session #is-busy) (?? (?. (. #session document #service tool-access) #is-asking) false))))
  (prop + suggestion-state (? ChatSuggestedTaskResolver) (= null))
  (prop + suggestion-revision U64 (= 0))
  (event + suggested-task ChatSuggestedTaskAction)
  (blank)
  (prop _ flights Size)
  (prop _ flight-key _ (= (str "chat-flight-" (. #session branch-id) "-" #flights)))
  (content
    (<> This (• flex-col)
      (if #is-branch
        (<> ChatPaneHeader
          (= margin-top #top-inset)
          (= session #session)
          (= branching branching)
          (= is-side #is-side)
        )
      )
      (<> ChatTranscript (id: transcript) (• flex 1)
        (= session #session)
        (= branching branching)
        (= services #services)
        (= caches caches)
        (= images images)
        (= gutter #gutter)
        (= top-inset (if-expr #is-branch 0 #top-inset))
        (= greeting (. #wording greeting))
        (= has-folds #has-folds)
        (= insertion #insertion)
        (= suggestion-state #suggestion-state)
        (= suggestion-revision #suggestion-revision)
      )
      (<> ChatDock (id: dock) (• absolute) (• flex-col)
        (= anchor (. Anchor parent))
        (= left (call (. PositionOffset coord) 0))
        (= right (call (. PositionOffset coord) chat-dock-scroll-room))
        (= bottom (call (. PositionOffset coord) 0))
        (<> Box (• chat-dock-backdrop)
          (= background-color (if-expr #is-side $gui-panel-color $gui-window-color))
          (= anchor (. Anchor parent))
          (= left (call (. PositionOffset coord) 0))
          (= right (call (. PositionOffset coord) 0))
          (= top (call (. PositionOffset coord) chat-dock-backdrop-top))
          (= bottom (call (. PositionOffset coord) 0))
        )
        (if (. transcript #is-end-hidden)
          (<> Box (• h 0)
            (<> IconButton (id: jump-button) (• chat-jump-button) (• icon-arrow-down) (• absolute) (• w 32) (• h 32)
              (= anchor (. Anchor parent))
              (= bottom (call (. PositionOffset coord) 10))
              (= align-x (. Alignment center))
            )
          )
        )
        (if #has-queue
          (<> ChatQueueView
            (= queue #queue)
          )
        )
        (if #is-asking
          (<> ChatAccessRequest (• mt 8) (• mb 20)
            (= access (!! (. #session document #service tool-access)))
          )
        )
        (<> ChatComposer (id: composer)
          (= focus-default (not #is-side))
          (= can-queue true)
          (= is-busy (or (. session #is-busy) #is-working-behind))
          (= placeholder (if-expr (. transcript #is-launching) "" (call chat-pane-placeholder #wording #is-branch)))
          (= branch-modifiers #branch-modifiers)
          (= images images)
          (= caches caches)
          (= flight-key #flight-key)
          (= display (if-expr (and #is-connected (not #is-asking)) (. Display visible) (. Display hidden)))
        )
      )
      (if #is-side
        (<> Resizer
          (= edge (. Side left))
          (= min-size 320)
          (= max-size 960)
          (= state-key "chat-side-pane")
        )
      )
      (<> ConfirmDialog (id: stop-dialog)
        (= title "Stop background tasks?")
        (= message (call chat-stop-message #behind))
        (= accept-title "Stop All")
      )
    )
  )
  (subscribe-for (on height (. dock measured))
    (= dock-height height)
  )
  (subscribe-for (on prompt (. composer send))
    (call send-prompt prompt (:flies true))
  )
  (subscribe-for (on prompt (. composer queue))
    (call queue-prompt prompt)
  )
  (subscribe-for (on text (. transcript answering))
    (call send-prompt (call ChatDraft text))
  )
  (subscribe-for (on action (. transcript suggested-task))
    (if (== (. action kind) (. ChatSuggestedTaskActionKind do-here))
      (call send-prompt (call ChatDraft (. action task prompt)))
    )
    (<- suggested-task action)
  )
  (subscribe-for (on draft (. composer drafted))
    (call (. branching memory keep-draft) (. session branch-id) draft)
  )
  (subscribe-for (on prompt (. composer branch))
    (call (. branching side-chat) session (. prompt text) (. prompt images))
  )
  (subscribe-for (on _ (. composer stop))
    (call request-stop)
  )
  (subscribe-for (on stopped (. branching stopping))
    (if (== (. stopped branch-id) (. session branch-id))
      (call request-stop)
    )
  )
  (subscribe-for (on _ (. stop-dialog accepted) (when arrival))
    (call (. branching stop-all) session)
  )
  (subscribe-for (on event (. jump-button click))
    (call (. transcript jump-to-end))
    (call (. event cancel))
  )
  (subscribe-for (on event key-press)
    (let modifiers (. event modifiers))
    (let is-plain (and (not (. modifiers shift)) (not (. modifiers command)) (not (. modifiers option)) (not (. modifiers control))))
    (let is-command (and (. modifiers command) (not (. modifiers shift)) (not (. modifiers option)) (not (. modifiers control))))
    (let is-jump (and is-command (not (and (. composer is-focus-within) (. composer is-multiline)))))
    (if (and is-plain (== (. event key) (. Key home)))
      (call (. transcript jump-to-start))
      (call (. event cancel))
      (else-if (and is-plain (== (. event key) (. Key end)))
        (call (. transcript jump-to-end))
        (call (. event cancel))
      )
      (else-if (and is-plain (== (. event key) (. Key page-up)))
        (call (. transcript page) false)
        (call (. event cancel))
      )
      (else-if (and is-plain (== (. event key) (. Key page-down)))
        (call (. transcript page) true)
        (call (. event cancel))
      )
      (else-if (and is-jump (== (. event key) (. Key arrow-up)))
        (call (. transcript jump-to-prompt) false)
        (call (. event cancel))
      )
      (else-if (and is-jump (== (. event key) (. Key arrow-down)))
        (call (. transcript jump-to-prompt) true)
        (call (. event cancel))
      )
    )
  )
  (fn-do + mounted _
    (call (. super mounted))
    (call (. composer restore) (call (. branching memory draft-for) (. session branch-id)))
  )
  (fn-do _ send-prompt _
    (param prompt ChatDraft)
    (param flies _ (= false))
    (return-if (if (not is-connected)))
    (return-if (if (and (. session is-busy) (not (. prompt images length)) (call (. branching steer) session (. prompt text)))))
    (blank)
    (if (or (. session is-busy) has-queue)
      (call (. queue add) (. prompt text) (. prompt images))
      (return)
    )
    (let count (. session messages length))
    (call (. branching send) session (. prompt text) (. prompt images))
    (if (and flies (> (. session messages length) count))
      (call (. transcript launch) flight-key)
      (+= flights 1)
    )
  )
  (fn-do _ queue-prompt _
    (param prompt ChatDraft)
    (return-if (if (not is-connected)))
    (blank)
    (call (. queue add) (. prompt text) (. prompt images))
  )
  (fn-do _ request-stop _
    (if is-working-behind
      (call (. stop-dialog show))
      (else
        (call (. branching stop) session)
      )
    )
  )
)

(type + ChatPaneHeader (is Box)
  (prop + session AIChatSession)
  (prop + branching ChatBranching)
  (prop + is-side _ (= false))
  (prop + trail _ (= (call chat-branch-trail (. #session document #chat) (. #session branch-id))))
  (prop + can-unfold _ (= (and (not (. session #is-busy)) (call chat-can-unfold (. #session document #chat) (. #session branch-id)))))
  (content
    (<> This (• chat-pane-header) (• flex-row) (• h 44) (• pl 16) (• pr 10)
      (for (in crumb #trail (keyed-by (. crumb id)))
        (<> Box (• flex-row) (• items-center)
          (= align-y (. Alignment center))
          (if (!= (. crumb parent-branch-id) null)
            (<> Label (• chat-crumb-divider) (• px 4)
              (= text "›")
            )
          )
          (<> Button (• chat-crumb) (• h 26) (• px 6)
            (= title (call chat-crumb-title session crumb))
            (= is-on (== (. crumb id) (. session branch-id)))
            (for (on event click)
              (call (. branching open) (. crumb id))
              (call (. event cancel))
            )
          )
        )
      )
      (<> Box (• flex 1))
      (if #is-side
        (<> IconButton (id: unfold-button) (• icon-merge) (• w 26) (• h 26)
          (= align-y (. Alignment center))
          (= is-enabled #can-unfold)
        )
        (<> IconButton (id: remove-button) (• icon-trash-2) (• w 26) (• h 26) (• ml 2)
          (= align-y (. Alignment center))
        )
        (<> IconButton (id: close-button) (• icon-x) (• w 26) (• h 26) (• ml 2)
          (= align-y (. Alignment center))
        )
      )
    )
  )
  (subscribe-for (on event (. unfold-button click))
    (call (. branching unfold) (. session branch-id))
    (call (. event cancel))
  )
  (subscribe-for (on event (. remove-button click))
    (call (. branching remove) (. session branch-id))
    (call (. event cancel))
  )
  (subscribe-for (on event (. close-button click))
    (call (. branching close))
    (call (. event cancel))
  )
)

(type + ChatDock (is Box)
  (event + measured Length)
  (blank)
  (prop _ last-height Length)
  (fn-do + did-layout _
    (call (. super did-layout))
    (let found (. bounds height))
    (return-if (if (== found last-height)))
    (blank)
    (= last-height found)
    (<- measured found)
  )
)

(fn-expr _ chat-dock-gutter VirtualCoord
  (param height Length)
  (if-expr (> height 0) (as (call ceil height) VirtualCoord) chat-composer-rest)
)

(fn-expr _ chat-stop-message String
  (param tasks (list AIToolTask))
  (case? (== (. tasks length) 1)
    (str "“" (. ([] tasks 0) title) "” is still running in the background. Stopping ends it, and nothing resumes until you send another message.")
  )
  (default
    (str (. tasks length) " tasks are still running in the background. Stopping ends them, and nothing resumes until you send another message.")
  )
)

(fn-expr + chat-is-working Bool
  (param session AIChatSession)
  (param is-busy Bool)
  (param revision U64)
  (or is-busy (> (. (call (. session working-behind) revision) length) 0))
)

(fn-expr _ chat-pane-placeholder String
  (param wording ChatWording)
  (param is-branch Bool)
  (case? is-branch
    (. wording branch-placeholder)
  )
  (default
    (. wording placeholder)
  )
)
