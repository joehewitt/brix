━━━━━━━━━━━━━━━━━━━━
+ do chat-copy-text String
    - parts [AIMessagePart]

. texts = List'String()
for part in parts
    if | text AITextPart = part
        . trimmed = text.text.trim()
        if trimmed.length > 0
            texts += trimmed
= "\n\n".join(texts)

━━━━━━━━━━━━━━━━━━━━
+ chat-message-selection MarkdownView?
    - row Box

selected if selected && selected.is-within(row)

.. selected = markdown-selected-view()

━━━━━━━━━━━━━━━━━━━━
+ chat-relative-time String
    - stamp Timestamp
    - current DateTime

|? !sent
    ""
|? seconds < 60
    "Just now"
|? seconds < 3600
    chat-ago(seconds / 60, "minute")
|? days == 0 || seconds < 6 * 3600
    chat-ago(seconds / 3600, "hour")
|? days == 1
    "Yesterday"
|? days < 7
    chat-capitalized(sent.day-of-week.name)
|? sent.year == current.year
    date
??
    "$date, ${sent.year}"

.. sent = parse-iso8601(stamp, current.zone)
.. seconds = (current.since-epoch - sent.since-epoch) as I64
.. days = (current.since-epoch / 86400 - sent.since-epoch / 86400) as I64
.. date = "${chat-capitalized(sent.month.short-name)} ${sent.day.number + 1}"

━━━━━━━━━━━━━━━━━━━━
_ chat-ago String
    - count I64
    - unit String

if count == 1 then "1 $unit ago" else "$count ${unit}s ago"

━━━━━━━━━━━━━━━━━━━━
_ chat-capitalized String
    - text String

if text.length then "${text[0 .. < 1].uppercased}${text[1 ...]}" else text
