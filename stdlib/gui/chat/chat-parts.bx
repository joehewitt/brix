(import ./chat-caches)
(import ./chat-tasks)
(import ./chat-theme)
(import /ai)
(import /data/json)
(import /graphics/image)
(import /graphics/primitives)
(import /graphics/thumbnail-cache)
(import /gui)
(import /gui/markdown)
(import /math)
(import /os/path)
(import /stream/aggregate)
(blank)
(prop _ chat-image-width Length (= 512))
(prop _ chat-image-columns Size (= 4))
(prop _ chat-image-gap Length (= 4))

(type + ChatPartView (is Box)
  (prop + part AIMessagePart)
  (prop + message AIChatMessage)
  (prop + messages (list AIChatMessage))
  (prop + caches ChatBlockCaches)
  (prop + images (? AIImageStore))
  (prop + shows-tasks _ (= true))
  (prop + image-run _ (= (call chat-image-run (. #message #parts) #part)))
  (content
    (<> This (• flex-col)
      (match #part
        (case (: text AITextPart)
          (<> MarkdownView
            (= text (. text #text))
            (= cache (call (. caches cache-for) (call chat-part-key message text)))
          )
        )
        (case (: reasoning AIReasoningPart)
          (if (> (. reasoning #text size) 0)
            (<> MarkdownView
              (= text (. reasoning #text))
              (= cache (call (. caches cache-for) (call chat-part-key message reasoning)))
            )
          )
        )
        (case (: call AIToolCallPart)
          (if (!= (call ai-call-reply call) null)
            (<> MarkdownView
              (= text (!! (call ai-call-reply call)))
              (= cache (call (. caches cache-for) (call chat-part-key message call)))
            )
          )
          (if (call ai-is-task-call call)
            (if (and #shows-tasks (call ai-is-last-task-call (. message #parts) call))
              (<> ChatTaskList (• chat-tasks)
                (= tasks (call ai-tasks messages message (. message #parts)))
                (= is-live (== (. message #finish-reason) null))
              )
            )
            (else-if (!= (call chat-tool-title (. call #arguments)) null)
              (<> ChatToolCall (• chat-tool)
                (= title (!! (call chat-tool-title (. call #arguments))))
              )
            )
          )
          (if (call chat-is-working call (. message #parts) (. message #finish-reason))
            (<> Label (• chat-waiting) (• h 22) (• mb 10)
              (= text (if-expr (call ai-is-image-call call) "Generating image…" "Working…"))
            )
          )
        )
        (case (: image AIImagePart)
          (if (== #image-run null)
            (<> ChatImage (• chat-image) (• mb 10)
              (= image (. image #image))
              (= images images)
              (= thumbnails (. caches thumbnails))
            )
            (else-if (> (. (!! #image-run) length) 0)
              (<> ChatImageGrid (• mb 10)
                (= pictures (!! #image-run))
                (= images images)
                (= thumbnails (. caches thumbnails))
              )
            )
          )
        )
        (case (: extension AIExtensionPart)
          (if (== (. extension part-type) ai-compaction-part)
            (<> Label (• chat-compaction) (• h 20)
              (= text "Earlier messages were compacted")
            )
            (else-if (== (. extension part-type) ai-steer-part)
              (<> Box (• flex-row) (• mt 4) (• mb 14)
                (<> Box (• flex 1))
                (<> Box (• chat-bubble) (• flex-col) (• px 14) (• pt 9)
                  (<> MarkdownView (• chat-bubble-markdown)
                    (= text (call chat-steer-text extension))
                    (= cache (call (. caches cache-for) (call chat-part-key message extension)))
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)

(type + ChatToolCall (is Box)
  (prop + title String)
  (content
    (<> This (• flex-col)
      (<> Box (• chat-tool-line) (• flex-row) (• h 28) (• px 10) (• items-center)
        (<> Label (• chat-tool-title) (• flex 1)
          (= text #title)
        )
      )
    )
  )
)

(type + ChatImageGrid (is Box)
  (prop + pictures (list AIImage))
  (prop + images (? AIImageStore))
  (prop + thumbnails ThumbnailCache)
  (content
    (<> This (• flex-col)
      (for (in row (call chat-image-rows #pictures))
        (<> Box (• flex-row)
          (= margin-bottom chat-image-gap)
          (for (in picture row)
            (<> Box (• flex-col) (• flex 1)
              (= max-width (call (. SizeSpec coord) (. (call chat-image-cell) width)))
              (= margin-right chat-image-gap)
              (if (!= picture null)
                (<> ChatImage (• chat-image)
                  (= image picture)
                  (= images images)
                  (= thumbnails thumbnails)
                  (= limit (call chat-image-cell))
                  (= is-cell true)
                )
              )
            )
          )
        )
      )
    )
  )
)

(type + ChatImageOpener (is Interface)
  (fn-do + open-image _
    (param image AIImage)
  )
)

(type + ChatImage (is Box)
  (implements ThumbnailClient)
  (prop + image AIImage)
  (prop + images (? AIImageStore))
  (prop + thumbnails ThumbnailCache)
  (prop + limit _ (= (call Dimensions chat-image-width (* chat-image-width 2))))
  (prop + is-cell _ (= false))
  (prop + shown (? Image))
  (prop + is-missing _ (= false))
  (prop + frame _ (= (call chat-image-frame #image #limit)))
  (blank)
  (prop _ ticket (? ThumbnailTicket))
  (prop _ is-mounted _ (= false))
  (blank)
  (depends image-changed image)
  (content
    (<> This (• flex-col)
      (= align-x (. Alignment start))
      (if (!= #shown null)
        (<> ImageView (• flex 1)
          (= image #shown)
        )
        (else
          (<> Label (• chat-waiting) (• flex 1)
            (= align-x (. Alignment center))
            (= align-y (. Alignment center))
            (= text (if-expr #is-missing "Image unavailable" "Loading image…"))
          )
        )
      )
    )
  )
  (subscribe-for (on event click)
    (let opener (call (of ancestor ChatImageOpener)))
    (if opener
      (call (. opener open-image) image)
      (call (. event cancel))
    )
  )
  (fn-do _ image-changed _
    (call invalidate-layout)
    (call release)
    (return-if (if (not is-mounted)))
    (let path (call chat-image-path image images))
    (if (not path)
      (= is-missing true)
      (return)
    )
    (let pixels (as (* (. frame width) 2) I32))
    (let requested (call (. thumbnails request) path pixels this))
    (if (. requested is-settled)
      (call adopt requested)
      (else
        (= ticket requested)
      )
    )
  )
  (fn-do _ adopt _
    (param settled ThumbnailTicket)
    (= ticket settled)
    (= shown (. settled image))
    (= is-missing (not (. settled image)))
  )
  (fn-do _ release _
    (let held ticket)
    (= ticket null)
    (= shown null)
    (= is-missing false)
    (if held
      (call (. thumbnails cancel) held)
    )
  )
  (fn-expr + thumbnail-priority F64
    (param ticket ThumbnailTicket)
    0
  )
  (fn-do + thumbnail-loaded _
    (param loaded ThumbnailTicket)
    (if (and ticket (== (as ticket Pointer) (as loaded Pointer)))
      (call adopt loaded)
    )
  )
  (fn-expr + measured-content-size _
    (param query MeasureQuery)
    (call chat-image-fitted frame limit is-cell (. (call derived-child-measure-query query) inline available))
  )
  (fn-do + mounted _
    (call (. super mounted))
    (= is-mounted true)
    (call image-changed)
  )
  (fn-do + unmounted _
    (= is-mounted false)
    (call release)
    (call (. super unmounted))
  )
)

(fn-expr + chat-is-working _
  (param call AIToolCallPart)
  (param parts (list AIMessagePart))
  (param finish-reason (? AIFinishReason))
  (and awaits-result (== finish-reason null) (== (call chat-tool-result parts call) null))
  (where
    (lazy awaits-result (or (call ai-is-image-call call) (!= (call ai-call-reply call) null)))
  )
)

(fn-do + chat-image-run (? (list AIImage))
  (param parts (list AIMessagePart))
  (param part AIMessagePart)
  (return-if null (if (is-not part AIImagePart)))
  (let wanted (call ai-part-id part))
  (let start (? Index) null)
  (for (in index (..< 0 (. parts length)))
    (if (is ([] parts index) AIImagePart)
      (if (== start null)
        (= start index)
      )
      (if (== (call ai-part-id ([] parts index)) wanted)
        (let first start)
        (let run (call (of List AIImage)))
        (let end first)
        (while (and (< end (. parts length)) (is ([] parts end) AIImagePart))
          (+= run (. (as ([] parts end) AIImagePart) image))
          (+= end 1)
        )
        (return-if null (if (< (. run length) 2)))
        (return (if-expr (== index first) run (call (of List AIImage))))
      )
      (else
        (= start null)
      )
    )
  )
  (return null)
)

(fn-do _ chat-image-rows (list (list (? AIImage)))
  (param pictures (list AIImage))
  (let rows (call (of List (list (? AIImage)))))
  (let row (call (of List (? AIImage))))
  (for (in picture pictures)
    (+= row picture)
    (if (== (. row length) chat-image-columns)
      (+= rows row)
      (= row (call (of List (? AIImage))))
    )
  )
  (if row
    (while (< (. row length) chat-image-columns)
      (+= row null)
    )
    (+= rows row)
  )
  (return rows)
)

(fn-expr _ chat-image-cell Dimensions
  (call Dimensions side side)
  (where
    (lazy side (/ images-width (as chat-image-columns Length)))
    (lazy images-width (- chat-image-width (* chat-image-gap (as (- chat-image-columns 1) Length))))
  )
)

(fn-expr _ chat-image-frame Dimensions
  (param image AIImage)
  (param limit Dimensions)
  (case? (and (. image width) (. image height))
    (call Dimensions (* wide scale) (* tall scale))
  )
  (default
    (call Dimensions (. limit width) (. limit width))
  )
  (where
    (lazy wide (as (. image width) Length))
    (lazy tall (as (. image height) Length))
    (lazy fit (call min (/ (. limit width) wide) (/ (. limit height) tall)))
    (lazy scale (call min fit 1.0))
  )
)

(fn-expr + chat-image-fitted Dimensions
  (param frame Dimensions)
  (param limit Dimensions)
  (param is-cell Bool)
  (param available (? Length))
  (case? (or (== available null) (<= basis 0) (>= available basis))
    frame
  )
  (default
    (call Dimensions (* (. frame width) scale) (* (. frame height) scale))
  )
  (where
    (lazy basis (if-expr is-cell (. limit width) (. frame width)))
    (lazy scale (/ (call max available 0) basis))
  )
)

(fn-do + chat-image-path (? Path)
  (param image AIImage)
  (param images (? AIImageStore))
  (if (= (| (: stored AIPathSource)) (. image file source))
    (return (call Path (. stored path) 0))
  )
  (let id (call (?. images id) image))
  (return (only-if (call (. (!! images) path) id) (if id)))
)

(fn-expr _ chat-steer-text String
  (param part AIExtensionPart)
  (match (. part data)
    (case (: text String)
      text
    )
    (default
      ""
    )
  )
)

(fn-expr + chat-part-key _
  (param message AIChatMessage)
  (param part AIMessagePart)
  (str (. message id) "/" (call ai-part-id part))
)

(fn-do + chat-tool-result (? AIToolResultPart)
  (param parts (list AIMessagePart))
  (param call AIToolCallPart)
  (for (in part parts)
    (if (= (| (: result AIToolResultPart)) part)
      (return-if result (if (== (. result call-id) (. call call-id))))
    )
  )
  (return null)
)

(fn-expr + chat-tool-title (? String)
  (param arguments JSON)
  (only-if (call chat-first-line description) (if description))
  (where
    (lazy description (call ai-argument arguments "description"))
  )
)

(fn-expr _ chat-first-line _
  (param text String)
  (if-expr (!= break null) (str (call (. ([] trimmed (..< 0 break)) trim)) " …") trimmed)
  (where
    (lazy trimmed (call (. text trim)))
    (lazy break (call (. trimmed find) "\n"))
  )
)
