./chat-branching
./chat-theme
/ai
/gui
/gui/icons/lucide/square-pen
/stream/aggregate

━━━━━━━━━━━━━━━━━━━━
+ ChatNode is Tuple

+ session AIChatSession?
+ branch-id String

━━━━━━━━━━━━━━━━━━━━
+ ChatChoice is Tuple

+ session AIChatSession
+ branch-id String

━━━━━━━━━━━━━━━━━━━━
+ ChatSidebar is Sidebar

+ store AIChatStore
+ branching ChatBranching
+ event chosen ChatChoice

────────────────────

<This
    <SidebarSection • pt:10
        <SidebarItem new-button "New chat" • icon-square-pen
        if #store.#error != null
            <Text • chat-error mx:gui-sidebar-row-inset px:tree-box-row-inset py:6
                <Span
                    text = #store.#error ?? ""
    <SidebarSection
        <ChatTree tree
            store = #store
            selected-path = chat-selected-path(#store.#active, #branching.#focus)

────────────────────
for event on new-button.click

store.new-session()
event.cancel()

────────────────────
for choice on tree.chosen

chosen <- choice

━━━━━━━━━━━━━━━━━━━━
+ ChatTree is Box

+ store AIChatStore
+ selected-path [String]
+ can-drag TreeBoxItemPredicate'ChatNode?
+ current-key = if #selected-path.length > 0 then #selected-path[#selected-path.length - 1] else ""
+ event chosen ChatChoice

────────────────────

<This • flex-col
    <TreeBox'ChatNode tree • flex:1
        root-node = ChatNode(null, "")
        load-children = :: node => chat-node-children(node, store)
        key-builder = chat-node-key
        selected-keys = [#current-key]
        can-drag = #can-drag
        is-ordered = false

        <ChatNodeRow (row) - row
            node = row.#item!

────────────────────
for event on tree.selection-changed

. node = tree.entry-for-key(tree.selected-key)?.item
. session = node?.session
if session
    chosen <- ChatChoice(session, node!.branch-id)

────────────────────
whenever store.#revision

tree.reload()
reveal()

────────────────────
whenever #selected-path

reveal()

────────────────────
_ do reveal

. ignored = tree.reveal-key-path(selected-path)

━━━━━━━━━━━━━━━━━━━━
+ ChatNodeRow is Box

+ node ChatNode
+ title = chat-node-title
    - #node.session!
    - #node.branch-id
    - #node.session!.document.#branches
    - #node.session!.document.#title

────────────────────

<This • flex-row flex:1
    <Label • flex:1
        text = #title
        align-y = Alignment.center

━━━━━━━━━━━━━━━━━━━━
+ chat-node-key
    - node ChatNode

if node.session then chat-key(node.session, node.branch-id) else ""

━━━━━━━━━━━━━━━━━━━━
+ chat-key
    - session AIChatSession
    - branch-id String

"${session.id}/$branch-id"

━━━━━━━━━━━━━━━━━━━━
+ chat-node-children [ChatNode]
    - node ChatNode
    - store AIChatStore

|? node.session
    chat-branch-nodes(node.session, node.branch-id)
??
    ChatNode(each, each.chat.root-branch-id) in store.sessions when !each.is-empty && each.document.marks.archived-at == null

━━━━━━━━━━━━━━━━━━━━
+ chat-branch-nodes [ChatNode]
    - session AIChatSession
    - parent-id String

ChatNode(session, each.id) in branches when !each.is-collapsed && chat-visible-parent(branches, each) == parent-id

.. branches = session.document.branches

━━━━━━━━━━━━━━━━━━━━
+ chat-node-title String
    - session AIChatSession
    - branch-id String
    - branches [AIChatBranchSummary]
    - title String?

|? branch-id == session.chat.root-branch-id
    title ?? "New chat"
??
    chat-summary-for(branches, branch-id)?.title ?? "Side chat"

━━━━━━━━━━━━━━━━━━━━
+ do chat-selected-path [String]
    - session AIChatSession
    - focus AIChatSession?

. path = List'String()
path += chat-key(session, session.chat.root-branch-id)
=? path if !focus
. branches = session.document.branches
. trail = List'String()
. current String? = focus.branch-id
while current
    . found = chat-summary-for(branches, current)
    if !found
        break
    if !found.is-collapsed && found.parent-branch-id
        trail.insert(found.id, 0)
    current = found.parent-branch-id
for id in trail
    path += chat-key(session, id)
= path

━━━━━━━━━━━━━━━━━━━━
_ do chat-visible-parent String?
    - branches [AIChatBranchSummary]
    - branch AIChatBranchSummary

. parent = branch.parent-branch-id
while parent
    . found = chat-summary-for(branches, parent)
    =? parent if !found || !found.is-collapsed
    parent = found.parent-branch-id
= null

━━━━━━━━━━━━━━━━━━━━
_ chat-summary-for AIChatBranchSummary?
    - branches [AIChatBranchSummary]
    - branch-id String

first(each in branches when each.id == branch-id)
