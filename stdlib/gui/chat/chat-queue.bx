(import ./chat-theme)
(import /ai)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/text)
(import /gui)
(import /gui/icons/lucide/check)
(import /gui/icons/lucide/grip-vertical)
(import /gui/icons/lucide/pencil)
(import /gui/icons/lucide/x)
(blank)
(prop _ chat-queue-max-lines Size (= 6))

(type + ChatQueueDrag (is Tuple)
  (implements DragPayload)
  (prop + view ChatQueueView)
  (prop + row ChatQueueRow)
  (fn-expr + drag-kind _ :get
    "chat.queued"
  )
)

(type + ChatQueueView (is Box)
  (prop + queue AIChatQueue)
  (prop + items _ (= (. #queue #items)))
  (content
    (<> This (• chat-queue-row) (• flex-row)
      (<> Box (id: rows) (• flex-col) (• flex 1)
        (for (in item #items (keyed-by (. item id)))
          (<> ChatQueueRow
            (= item item)
            (= queue queue)
          )
        )
      )
    )
  )
  (subscribe-for (on event drag-over)
    (if (is (. event payload) ChatQueueDrag)
      (let drag (as (. event payload) ChatQueueDrag))
      (if (== (. drag view) this)
        (call (. event accept) this)
      )
    )
  )
  (subscribe-for (on event drop (when arrival))
    (if (is (. event payload) ChatQueueDrag)
      (let drag (as (. event payload) ChatQueueDrag))
      (let index (. drag row carry-slot))
      (if (and (== (. drag view) this) (!= index null))
        (call (. queue move) (. drag row item id) index)
      )
    )
  )
)

(type + ChatQueueRow (is Box)
  (prop + item AIQueuedPrompt)
  (prop + queue AIChatQueue)
  (prop + is-editing _ (= (== (. #queue #editing) (. #item id))))
  (blank)
  (prop _ view (of Ancestor ChatQueueView))
  (blank)
  (rule chat-queue-input)
  (content
    (<> This (• chat-queue-entry) (• flex-col)
      (<> Box (• chat-queued) (• flex-row) (• pl 8) (• pr 6) (• py 5) (• mb 4)
        (<> LucideGripVertical (• icon) (• chat-queue-grip) (• w 14) (• h 14) (• mr 6)
          (= align-y (. Alignment center))
        )
        (if #is-editing
          (<> TextInput (id: editor) (• chat-queue-input) (• flex 1)
            (= text (. #item text))
            (= is-bare true)
            (= wraps true)
            (= max-lines chat-queue-max-lines)
          )
          (<> IconButton (id: save-button) (• icon-check) (• w 24) (• h 24) (• ml 4)
            (= align-y (. Alignment center))
          )
          (else
            (<> Label (• chat-queue-text) (• flex 1)
              (= text (call chat-queued-label #item))
              (= align-y (. Alignment center))
              (= text-overflow (. TextOverflow truncate-tail))
            )
            (<> IconButton (id: edit-button) (• icon-pencil) (• w 24) (• h 24) (• ml 4)
              (= align-y (. Alignment center))
            )
          )
        )
        (<> IconButton (id: cancel-button) (• icon-x) (• w 24) (• h 24) (• ml 2)
          (= align-y (. Alignment center))
        )
      )
    )
  )
  (subscribe-for (on event drag-start)
    (let owner view)
    (if (and owner (not is-editing))
      (let ignored (call (. event carry) (call ChatQueueDrag owner this)))
    )
  )
  (subscribe-for (on event (. edit-button click))
    (call (. queue edit) (. item id))
    (call (. event cancel))
  )
  (subscribe-for (on event (. save-button click))
    (call save)
    (call (. event cancel))
  )
  (subscribe-for (on event (. editor submit))
    (call save)
    (call (. event cancel))
  )
  (subscribe-for (on event (. cancel-button click))
    (if is-editing
      (call (. queue finish-editing))
      (else
        (call (. queue remove) (. item id))
      )
    )
    (call (. event cancel))
  )
  (fn-do _ save _
    (let text (call (. editor text trim)))
    (if (or (. text length) (. item images length))
      (call (. queue replace) (. item id) text)
      (else
        (call (. queue remove) (. item id))
      )
    )
  )
)

(fn-expr _ chat-queued-label String
  (param item AIQueuedPrompt)
  (case? (not count)
    (. item text)
  )
  (case? (not (. item text length))
    pictures
  )
  (default
    (str (. item text) " · " pictures)
  )
  (where
    (lazy count (. item images length))
    (lazy pictures (if-expr (== count 1) "1 image" (str count " images")))
  )
)
