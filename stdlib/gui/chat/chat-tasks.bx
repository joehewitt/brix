(import ./chat-theme)
(import /ai)
(import /graphics/color)
(import /graphics/primitives)
(import /graphics/text)
(import /gui)
(import /gui/icons/lucide/circle)
(import /gui/icons/lucide/circle-check)
(import /gui/icons/lucide/circle-dot)
(import /gui/icons/lucide/loader-circle)

(style-extend GUIDefaultTheme
  (rule chat-tasks (• bg transparent) (• px 10) (• py 6) (• mb 10)
    (= border-color gui-border-color)
    (= border-width 1)
    (= corner-radius 8)
  )
  (blank)
  (rule ChatTaskLine
    (rule chat-task-icon (• text gui-muted-text-color))
    (blank)
    (when-style #is-done
      (rule chat-task-subject (• text gui-muted-text-color))
    )
    (blank)
    (when-style #is-off-request
      (rule chat-task-subject (• text chat-warn-color))
      (rule chat-task-glyph (• text chat-warn-color))
    )
  )
  (blank)
  (rule chat-task-glyph (• text gui-muted-text-color)
    (= font-size gui-body-font-size)
  )
)

(type + ChatTaskList (is Box)
  (prop + tasks (list AITask))
  (prop + is-live _ (= false))
  (content
    (<> This (• flex-col)
      (= display (if-expr (> (. #tasks length) 0) (. Display visible) (. Display hidden)))
      (for (in task #tasks (keyed-by (. task id)))
        (<> ChatTaskLine
          (= task task)
          (= is-live #is-live)
        )
      )
    )
  )
)

(type + ChatTaskLine (is Box)
  (prop + task AITask)
  (prop + is-live _ (= false))
  (prop + is-off-request _ (= false))
  (prop + is-done _ (= (== (. #task status) (. AITaskStatus done))))
  (prop + is-active _ (= (== (. #task status) (. AITaskStatus active))))
  (content
    (<> This (• flex-row)
      (if #is-off-request
        (<> Label (• chat-task-glyph) (• chat-task-icon) (• w 22) (• h 22)
          (= text "↳")
        )
        (else-if #is-done
          (<> LucideCircleCheck (• icon) (• chat-task-icon) (• w 14) (• h 14) (• mt 5) (• mr 8))
        )
        (else-if (and #is-active #is-live)
          (<> LucideLoaderCircle (• icon) (• spinner) (• chat-task-icon) (• w 14) (• h 14) (• mt 5) (• mr 8))
        )
        (else-if #is-active
          (<> LucideCircleDot (• icon) (• chat-task-icon) (• w 14) (• h 14) (• mt 5) (• mr 8))
        )
        (else
          (<> LucideCircle (• icon) (• chat-task-icon) (• w 14) (• h 14) (• mt 5) (• mr 8))
        )
      )
      (<> Label (• chat-task-subject) (• flex 1) (• h 24)
        (= text (. #task subject))
        (= align-y (. Alignment center))
        (= text-overflow (. TextOverflow truncate-tail))
      )
    )
  )
)
