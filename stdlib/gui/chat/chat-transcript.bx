(import /units)
(blank)
(prop _ chat-row-overscan VirtualCoord (= 600vcoord))
(prop _ chat-row-retention VirtualCoord (= 20000vcoord))
(prop _ chat-row-estimate VirtualCoord (= 80vcoord))
(prop _ chat-row-leading VirtualCoord (= 24vcoord))
(prop _ chat-row-trailing VirtualCoord (= 8vcoord))
(prop _ chat-estimated-line VirtualCoord (= 22vcoord))
(prop _ chat-estimated-gap VirtualCoord (= 18vcoord))
(prop _ chat-estimated-char-span VirtualCoord (= 14vcoord))
(prop _ chat-estimated-column VirtualCoord (= 760vcoord))
(prop _ chat-estimated-image-lines VirtualCoord (= 20vcoord))
(prop _ chat-estimated-image-row-lines VirtualCoord (= 6vcoord))
(prop _ chat-estimated-image-columns Size (= 4))
(prop _ chat-estimated-prompt-lines VirtualCoord (= 15vcoord))
(prop _ chat-prompt-image-limit _ (= (call Dimensions 160 160)))
(prop _ chat-prompt-inset Length (= 24))
(prop _ chat-end-slack Length (= 24))
(prop _ chat-page-overlap Length (= 40))

(type + ChatServiceIcon (is Box)
  (prop + icon (? AIServiceIcon))
  (content
    (<> This (• flex-row)
      (if (== #icon (. AIServiceIcon claude))
        (<> ClaudeIcon (• flex 1))
        (else-if (== #icon (. AIServiceIcon codex))
          (<> CodexIcon (• flex 1))
        )
        (else-if (== #icon (. AIServiceIcon openai))
          (<> OpenAIIcon (• flex 1))
        )
      )
    )
  )
)

(type + ChatInsertion (is Union)
  (variant pins-end)
  (variant pins-prompt)
)

(type + ChatRow (is Tuple)
  (prop + key String)
  (prop + message AIChatMessage)
  (prop + fold (? AIChatBranch) (= null))
  (prop + is-last _ (= false))
  (prop + is-wake _ (= false))
)

(type + ChatLaunch
  (prop + message-id String)
  (prop + key String)
  (prop + is-flying _ (= true))
  (fn-do + This _
    (param message-id _)
    (param key _)
  )
)

(type + ChatTranscript (is Box)
  (implements ChatImageOpener)
  (prop + session AIChatSession)
  (prop + branching ChatBranching)
  (prop + services (list AIChatService))
  (prop + caches _ (= (call ChatBlockCaches)))
  (prop + images (? AIImageStore))
  (prop + gutter VirtualCoord (= 0vcoord))
  (prop + top-inset Length (= 0))
  (prop + greeting _ (= ""))
  (prop + has-folds _ (= false))
  (prop + insertion _ (= (. ChatInsertion pins-prompt)))
  (event + answering String)
  (prop + source _ (= (call ChatMessageSource #session #has-folds)))
  (prop + is-end-hidden _ (= false))
  (prop + is-launching _ (= (?? (?. #launched #is-flying) false)))
  (blank)
  (prop _ jumped (? I64))
  (prop _ launched (? ChatLaunch))
  (prop _ is-denied _ (= (== (?. (. session document #service access) #is-granted) false)))
  (prop _ row-inset _ (= (if-expr #is-denied 0 #top-inset)))
  (prop _ row-leading _ (= (+ chat-row-leading (as (call ceil #row-inset) VirtualCoord))))
  (prop _ prompt-inset _ (= (+ chat-prompt-inset #row-inset)))
  (content
    (<> This (• flex-col)
      (if (. session document #is-empty)
        (<> Label (• chat-empty) (• h 28)
          (= margin-top (+ 144 #top-inset))
          (= text #greeting)
        )
        (if (> (. #services length) 1)
          (<> (of SegmentedControl AIChatService) (• mt 20)
            (= align-x (. Alignment center))
            (= selected (. session document #service))
            (for (on event selection-changing)
              (let failure (catch (call (. session document choose) (. event value))))
              (if (is failure AIError)
                (call (. event cancel))
              )
            )
            (for (in service #services (keyed-by (. service id)))
              (<> (of Segment AIChatService)
                (= title (. service title))
                (= value service)
                (<> ChatServiceIcon (slot: leading) (• icon)
                  (= icon (. service icon))
                  (= display (if-expr (!= (. service icon) null) (. Display visible) (. Display hidden)))
                )
              )
            )
          )
        )
      )
      (if #is-denied
        (<> ChatAccessCard
          (= margin-top (+ 24 (if-expr (. session document #is-empty) 0 #top-inset)))
          (= service (. session document #service))
          (= access (!! (. session document #service access)))
        )
      )
      (<> (of VirtualRegion ChatRow) (id: rows) (• chat-transcript) (• flex 1)
        (= source #source)
        (= virtual-layout (call chat-row-layout #source row-leading gutter))
        (= overscan (call VirtualInsets chat-row-overscan 0vcoord chat-row-overscan 0vcoord))
        (= retention (call VirtualInsets chat-row-retention 0vcoord chat-row-retention 0vcoord))
        (= anchors-end true)
        (blank)
        (<> Box (slot: row) (param: slot) (• flex-col)
          (<> Box (• chat-column) (• flex-col) (• pl 18)
            (for (in row (list (. slot #item)) (keyed-by (. row key)))
              (<> ChatMessageRow
                (= row row)
                (= session session)
                (= branching branching)
                (= caches caches)
                (= images images)
                (= has-folds #has-folds)
                (= launch (call chat-row-launch #launched row))
                (for (on toggled toggle)
                  (call fold-toggle toggled)
                )
                (for (on pinned pin)
                  (call pin-row pinned)
                )
                (for (on shrunk shrink)
                  (call pin-row shrunk (:reveals-start true))
                )
                (for (on text answer)
                  (<- answering text)
                )
              )
            )
          )
        )
      )
      (<> ChatImageViewer (id: viewer)
        (= images images)
      )
    )
  )
  (whenever-rule #gutter
    (if (= (| (: layout VerticalMeasuredLayout)) (. rows virtual-layout))
      (= (. layout trailing) (+ chat-row-trailing gutter))
    )
  )
  (whenever-rule #row-leading
    (if (= (| (: layout VerticalMeasuredLayout)) (. rows virtual-layout))
      (= (. layout leading) row-leading)
    )
  )
  (whenever-rule (. session #turn-count)
    (call show-turn)
  )
  (whenever-rule (. session #is-busy)
    (if (not (. session is-busy))
      (= launched null)
    )
  )
  (whenever-rule #is-launching
    (if (not is-launching)
      (= launched null)
    )
  )
  (subscribe-for (on _ (. rows scroll-changed) (when arrival))
    (call check-end)
  )
  (whenever-rule (. rows #virtual-extent-y)
    (call check-end)
  )
  (whenever-rule (. rows #follows-end)
    (call check-end)
  )
  (fn-do + jump-to-start _
    (= jumped null)
    (call (. rows restore-scroll) (call Point 0 0))
  )
  (fn-do + jump-to-end _
    (= jumped null)
    (call (. rows follow-end))
    (= is-end-hidden false)
  )
  (fn-do + launch _
    (param key String)
    (let address (call (. source prompt-address)))
    (return-if (if (== address null)))
    (= launched (call ChatLaunch (. (call (. source row-at) address) message id) key))
  )
  (fn-do + page _
    (param forward Bool)
    (= jumped null)
    (let step
      (call max
        (block
          (arg (- (. rows content-bounds height) (as gutter Length) row-inset chat-page-overlap))
          (arg chat-page-overlap)
        )
      )
    )
    (let target
      (scope (if-expr forward ahead (call max (- (. rows scroll-y) step) 0))
        (lazy ahead (call min (+ (. rows scroll-y) step) (. rows scroll-max y)))
      )
    )
    (call (. rows restore-scroll) (call Point (. rows scroll-x) target))
  )
  (fn-do + jump-to-prompt _
    (param forward Bool)
    (let found (call prompt-beyond forward))
    (if (== found null)
      (if forward
        (call jump-to-end)
        (else
          (call jump-to-start)
        )
      )
      (return)
    )
    (= jumped found)
    (let ignored (call (. rows glide-to-address) found prompt-inset))
  )
  (fn-do _ prompt-beyond (? I64)
    (param forward Bool)
    (let origin (only-if jumped (if (. rows is-gliding))))
    (let count (as (call (. source row-count)) I64))
    (let step I64 (if-expr forward 1 -1))
    (let index I64 (if-expr forward 0 (- count 1)))
    (while (and (>= index 0) (< index count))
      (if (and (call chat-row-is-prompt (call (. source row-at) index)) (call is-beyond index origin forward))
        (return index)
      )
      (+= index step)
    )
    (return null)
  )
  (fn-expr _ is-beyond Bool
    (param address I64)
    (param origin (? I64))
    (param forward Bool)
    (case? (!= origin null)
      (if-expr forward (> address origin) (< address origin))
    )
    (case? (== offset null)
      false
    )
    (default
      (if-expr forward (> offset (+ prompt-inset 1)) (< offset (- prompt-inset 1)))
    )
    (where
      (lazy offset (call (. rows address-offset) address))
    )
  )
  (fn-do _ check-end _
    (let extent (as (. rows virtual-extent-y known) Length))
    (let hidden (and (not (. rows follows-end)) (< (+ (. rows scroll-y) (. rows content-bounds height)) (- extent chat-end-slack))))
    (if (!= hidden is-end-hidden)
      (= is-end-hidden hidden)
    )
  )
  (fn-do _ show-turn _
    (if (== insertion (. ChatInsertion pins-prompt))
      (let address (call (. source prompt-address)))
      (if (!= address null)
        (= jumped null)
        (let ignored (call (. rows glide-to-address) address prompt-inset))
        (return)
      )
    )
    (= jumped null)
    (call (. rows glide-to-end))
    (= is-end-hidden false)
  )
  (fn-do + open-image _
    (param image AIImage)
    (let pictures (call chat-viewer-pictures (. session messages)))
    (for (in index (..< 0 (. pictures length)))
      (if (== (as ([] pictures index) Pointer) (as image Pointer))
        (call (. viewer present) pictures index)
        (return)
      )
    )
    (call (. viewer present) (list image) 0)
  )
  (fn-do + mounted _
    (call (. super mounted))
    (call restore-scroll)
  )
  (fn-do + unmounted _
    (call keep-scroll)
    (call (. super unmounted))
  )
  (fn-do _ keep-scroll _
    (if (. rows follows-end)
      (call (. branching memory keep-scroll) (. session branch-id) (call ChatScrollMark "" 0 true))
      (return)
    )
    (let count (call (. source row-count)))
    (return-if (if (== count 0)))
    (let top I64)
    (let top-offset Length 0)
    (for (in address (..< 0 count))
      (let offset (call (. rows address-offset) address))
      (if (and (!= offset null) (<= offset 0))
        (= top address)
        (= top-offset offset)
      )
    )
    (let row (call (. source row-at) top))
    (call (. branching memory keep-scroll) (. session branch-id) (call ChatScrollMark (. row message id) top-offset false))
  )
  (fn-do _ restore-scroll _
    (let mark (call (. branching memory scroll-for) (. session branch-id)))
    (return-if (if (or (not mark) (. mark is-at-end))))
    (let shown (call (. source message-address) (. mark message-id)))
    (return-if (if (== shown null)))
    (call (. rows pin-address) shown (. mark offset))
  )
  (fn-do _ pin-row _
    (param row ChatRow)
    (param reveals-start _ (= false))
    (let shown (call (. source message-address) (. row message id)))
    (return-if (if (== shown null)))
    (let offset (call (. rows address-offset) shown))
    (return-if (if (== offset null)))
    (call (. rows pin-address) shown (if-expr (and reveals-start (< offset row-inset)) prompt-inset offset))
  )
  (fn-do _ fold-toggle _
    (param row ChatRow)
    (let id (. row message id))
    (let shown (call (. source message-address) id))
    (let offset (only-if (call (. rows address-offset) shown) (if (!= shown null))))
    (if (. row fold)
      (call (. branching unfold) (. row fold id))
      (else
        (call (. branching collapse) session id)
      )
    )
    (let moved (call (. source message-address) id))
    (if (and (!= moved null) (!= offset null))
      (call (. rows pin-address) moved offset)
    )
  )
)

(type + ChatMessageRow (is Box)
  (prop + row ChatRow)
  (prop + session AIChatSession)
  (prop + branching ChatBranching)
  (prop + caches ChatBlockCaches)
  (prop + images (? AIImageStore))
  (prop + has-folds _ (= false))
  (prop + launch (? ChatLaunch) (= null))
  (prop + message _ (= (. #row message)))
  (prop + fold _ (= (. #row fold)))
  (prop + is-user _ (= (== (. #message role) (. AIMessageRole user))))
  (prop + is-folded _ (= (!= #fold null)))
  (prop + can-collapse _
    (=
      (block
        (case? (and #has-folds #is-user (not (. session #is-busy)))
          (call chat-can-collapse-at
            (block
              (arg (. session document #chat))
              (arg (. session branch-id))
              (arg (. #message id))
            )
          )
        )
        (default
          false
        )
      )
    )
  )
  (prop + can-unfold _ (= (and (not (. session #is-busy)) (call chat-fold-unfolds (. session document #chat) #fold))))
  (prop + can-toggle _ (= (if-expr #is-folded #can-unfold #can-collapse)))
  (prop + is-open _ (= (and #is-folded (== (?. (. branching #focus) branch-id) (. (!! #fold) id)))))
  (prop + is-fold-revealed _ (= (or #is-folded #is-hover-within)))
  (prop + has-actions _ (= (and (not #is-folded) (or #is-user (!= (. #message #finish-reason) null)))))
  (prop + has-menu _ (= (not #is-folded)))
  (prop + can-copy _ (= false))
  (prop + question _ (= (only-if (call ai-reply-question (. #message #parts)) (if (and (. #row is-last) (!= (. #message #finish-reason) null) (not (. session #is-busy)))))))
  (event + toggle ChatRow)
  (event + pin ChatRow)
  (event + shrink ChatRow)
  (event + answer String)
  (content
    (<> This (• flex-row)
      (if #has-menu
        (<> ContextMenu (id: message-menu)
          (<> MenuItem (text: "Copy")
            (= key copy-key)
            (= is-enabled #can-copy)
            (= action (=> () :do (call copy-selection)))
          )
          (<> MenuItem (text: "Copy Message")
            (= action (=> () :do (call copy-message)))
          )
        )
      )
      (<> Box (id: message-column) (• flex-col) (• flex 1)
        (if #is-folded
          (<> ChatPrompt (id: fold-prompt)
            (= message #message)
            (= caches caches)
            (= images images)
            (= is-collapsed true)
            (= is-open #is-open)
          )
          (else-if #is-user
            (<> ChatPrompt (id: prompt)
              (= message #message)
              (= caches caches)
              (= images images)
              (= state (call (. branching memory prompt-for) (. #message id)))
              (= launch #launch)
            )
          )
          (else
            (<> ChatReply (id: reply)
              (= message #message)
              (= session session)
              (= messages (. session #messages))
              (= caches caches)
              (= images images)
              (= memory (. branching memory))
              (= is-wake (. #row is-wake))
            )
          )
        )
        (if #has-actions
          (<> ChatMessageActions (• mt 2)
            (= message #message)
            (= is-user #is-user)
            (= is-shown (. message-column #is-hover-within))
          )
        )
        (if (!= #question null)
          (<> ChatQuestionView (id: question-view) (• mt 10)
            (= question (!! #question))
          )
        )
        (if (not #has-actions)
          (<> Box (• h 18))
        )
      )
      (<> Box (• flex-col) (• w 18)
        (if (or #can-toggle #is-folded)
          (<> ChatFoldButton (id: fold-button) (• w 16) (• h 16) (• ml 2) (• mt 10)
            (= is-collapsed #is-folded)
            (= is-revealed #is-fold-revealed)
            (= is-enabled #can-toggle)
          )
        )
      )
    )
  )
  (subscribe-for (on event (. fold-button click))
    (<- toggle row)
    (call (. event cancel))
  )
  (subscribe-for (on _ (. reply resizing))
    (<- pin row)
  )
  (subscribe-for (on expanded (. prompt expanding))
    (if expanded
      (<- pin row)
      (else
        (<- shrink row)
      )
    )
  )
  (subscribe-for (on text (. question-view answering))
    (<- answer text)
  )
  (subscribe-for (on _ (. fold-prompt open))
    (call (. branching open) (. (!! fold) id))
  )
  (subscribe-for (on _ (. message-menu opened) (when arrival))
    (= can-copy (!= (call chat-message-selection this) null))
  )
  (fn-do _ copy-selection _
    (let view (call chat-message-selection this))
    (if view
      (let ignored (call (. (call Clipboard) write-text) (call (. view selected-source))))
    )
  )
  (fn-do _ copy-message _
    (let ignored (call (. (call Clipboard) write-text) (call chat-copy-text (. message parts))))
  )
)

(type + ChatPrompt (is Box)
  (prop + message AIChatMessage)
  (prop + caches ChatBlockCaches)
  (prop + images (? AIImageStore))
  (prop + state _ (= (call ChatPromptState)))
  (prop + is-collapsed _ (= false))
  (prop + is-open _ (= false))
  (prop + is-long _ (= false))
  (prop + is-expanded _ (= (. #state #is-expanded)))
  (prop + launch (? ChatLaunch) (= null))
  (prop + is-launched _ (= (!= #launch null)))
  (prop + text _ (= (call ai-parts-text (. #message parts))))
  (event + open Bool)
  (event + expanding Bool)
  (content
    (<> This (• chat-prompt) (• flex-row)
      (<> Box (• flex 1))
      (if #is-collapsed
        (<> Button (id: bubble) (• chat-bare) (• chat-bubble) (• px 14) (• py 9)
          (<> Box (slot: leading) (• flex-col) (• flex 1)
            (<> Text (• chat-bubble-text)
              (<> Span
                (= text (call chat-prompt-summary (. #message parts)))
              )
            )
          )
        )
        (else
          (<> ChatPromptCard (• chat-bubble) (• flex-col) (• px 14) (• pt 9)
            (= padding-bottom (if-expr (> (. #text length) 0) 0 9))
            (= launch #launch)
            (= match (?. #launch key))
            (if (> (. (call chat-prompt-images (. #message parts)) length) 0)
              (<> Box (• flex-row) (• py 2)
                (for (in image (call chat-prompt-images (. #message parts)))
                  (<> ChatImage (• chat-image) (• mr 6)
                    (= image image)
                    (= images images)
                    (= thumbnails (. caches thumbnails))
                    (= limit chat-prompt-image-limit)
                  )
                )
              )
            )
            (if (> (. #text length) 0)
              (<> ChatPromptBody (• chat-prompt-body) (• flex-col)
                (<> MarkdownView (• chat-bubble-markdown)
                  (= text #text)
                  (= cache (call (. caches cache-for) (str (. #message id) "/prompt")))
                )
              )
            )
            (if (or #is-long #is-expanded)
              (<> Button (id: more) (• chat-bare) (• chat-stack-toggle) (• mt 2) (• mb 8)
                (= title (if-expr #is-expanded "Show less" "Show more"))
              )
            )
          )
        )
      )
    )
  )
  (subscribe-for (on event (. bubble click))
    (<- open true)
    (call (. event cancel))
  )
  (subscribe-for (on event (. more click))
    (<- expanding (not (. state is-expanded)))
    (= (. state is-expanded) (not (. state is-expanded)))
    (call (. event cancel))
  )
  (fn-do + note-body _
    (param body ChatPromptBody)
    (return-if (if (. state is-expanded)))
    (let overflowing (. body has-vertical-overflow))
    (if (!= overflowing is-long)
      (= is-long overflowing)
    )
  )
)

(type + ChatPromptCard (is Box)
  (prop + launch (? ChatLaunch))
  (blank)
  (depends flight-changed is-flying)
  (fn-do _ flight-changed _
    (= (?. launch is-flying) is-flying)
  )
)

(type + ChatPromptBody (is Box)
  (prop _ prompt (of Ancestor ChatPrompt))
  (fn-do + did-layout _
    (call (. super did-layout))
    (call (?. prompt note-body) this)
  )
)

(fn-expr _ chat-prompt-images (list AIImage)
  (param parts (list AIMessagePart))
  (call (of List AIImage) (in (. (as each AIImagePart) image) parts (when (is each AIImagePart))))
)

(fn-expr _ chat-prompt-summary String
  (param parts (list AIMessagePart))
  (case? (or (. text length) (not count))
    text
  )
  (case? (== count 1)
    "1 image"
  )
  (default
    (str count " images")
  )
  (where
    (lazy text (call ai-parts-text parts))
    (lazy count (. (call chat-prompt-images parts) length))
  )
)

(type + ChatFoldButton (is IconButton)
  (prop + is-collapsed _ (= false))
  (prop + is-revealed _ (= false))
  (blank)
  (rule This (• min-w 16) (• min-h 16)
    (rule icon (• w 12) (• h 12))
    (blank)
    (when-style (not #is-revealed)
      (= opacity 0%%)
    )
    (blank)
    (when-style #is-collapsed
      (own-rule icon-host
        (<> LucideChevronLeft (slot: first-child) (• icon))
      )
    )
    (blank)
    (when-style (not #is-collapsed)
      (own-rule icon-host
        (<> LucideChevronDown (slot: first-child) (• icon))
      )
    )
  )
)

(type + ChatMessageSource
  (implements VirtualSequenceDomain)
  (implements (of VirtualSource ChatRow))
  (prop + session AIChatSession)
  (prop + has-folds _ (= false))
  (prop + revision _ (:= (call VirtualRevision)))
  (blank)
  (prop _ rows _ (= (call (of List ChatRow))))
  (prop _ built U64)
  (prop _ is-built _ (= false))
  (fn-do + This _
    (param session _)
    (param has-folds _ (= false))
    (= (. revision value) (+ (. session revision) (. session document revision)))
  )
  (whenever-rule (+ (. session #revision) (. session document #revision))
    (= (. revision value) (+ (. session revision) (. session document revision)))
  )
  (fn-expr + row-count Size
    (. (call current-rows) length)
  )
  (fn-expr + row-at ChatRow
    (param address I64)
    ([] (call current-rows) address)
  )
  (fn-do + prompt-address (? I64)
    (let found (call current-rows))
    (let index (. found length))
    (while (> index 0)
      (-= index 1)
      (let row ([] found index))
      (return-if (as index I64) (if (and (== (. row fold) null) (== (. row message role) (. AIMessageRole user)))))
    )
    (return null)
  )
  (fn-do + message-address (? I64)
    (param id String)
    (let found (call current-rows))
    (let index Index)
    (while (< index (. found length))
      (return-if (as index I64) (if (== (. ([] found index) message id) id)))
      (+= index 1)
    )
    (return null)
  )
  (fn-expr + known-count VirtualCoord :get
    (. (call current-rows) length)
  )
  (fn-expr + estimated-count (? VirtualCoord) :get
    (as (. (call current-rows) length) VirtualCoord)
  )
  (fn-expr + is-final Bool :get
    true
  )
  (fn-expr + address-at I64
    (param index VirtualCoord)
    index
  )
  (fn-expr + index-of (? VirtualCoord)
    (param address I64)
    (case? (or (< address 0) (>= address (as (. (call current-rows) length) I64)))
      null
    )
    (default
      (as address VirtualCoord)
    )
  )
  (fn-expr + domain VirtualSequenceDomain :get
    this
  )
  (fn-do + bind _
    (param address I64)
    (param generation U64)
    (param target (of VirtualBindingTarget ChatRow))
    (let found (call current-rows))
    (if (or (< address 0) (>= address (as (. found length) I64)))
      (call (. target fail) generation)
      (else
        (call (. target commit) (call VirtualKey (. revision value) address) ([] found address) generation)
      )
    )
  )
  (fn-do + identity-at (? U64)
    (param address I64)
    (let found (call current-rows))
    (return-if (if (or (< address 0) (>= address (as (. found length) I64)))))
    (return (as (call hash-for (. ([] found address) key)) U64))
  )
  (fn-do _ current-rows (list ChatRow)
    (let key (+ (. session revision) (. session document revision)))
    (if (or (not is-built) (!= key built))
      (= rows (call chat-rows session has-folds))
      (if (> (. rows length) 0)
        (let last ([] rows (- (. rows length) 1)))
        (= ([] rows (- (. rows length) 1))
          (call ChatRow
            (block
              (arg (. last key))
              (arg (. last message))
              (arg (. last fold))
              (arg true)
              (arg (. last is-wake))
            )
          )
        )
      )
      (= built key)
      (= is-built true)
    )
    (return rows)
  )
)

(fn-do _ chat-rows (list ChatRow)
  (param session AIChatSession)
  (param has-folds Bool)
  (let chat (. session chat))
  (let folds
    (scope (if-expr has-folds (call chat-folds child-branches) (call (of List AIChatBranch)))
      (lazy child-branches (call chat-child-branches chat (. session branch-id)))
    )
  )
  (let owned (call (of Map String Bool)))
  (for (in message (. session messages))
    (= ([] owned (. message id)) true)
  )
  (let rows (call (of List ChatRow)))
  (for (in fold folds)
    (let anchor (. fold fork-message-id))
    (if (or (not anchor) (not (has owned anchor)))
      (call chat-add-fold rows fold)
    )
  )
  (let previous (? AIMessageRole) null)
  (for (in message (. session messages))
    (let is-wake (and (== (. message role) (. AIMessageRole assistant)) (== previous (. AIMessageRole assistant))))
    (= previous (. message role))
    (+= rows (call ChatRow (. message id) message (:is-wake is-wake)))
    (for (in fold folds)
      (if (== (. fold fork-message-id) (. message id))
        (call chat-add-fold rows fold)
      )
    )
  )
  (return rows)
)

(fn-expr _ chat-row-launch (? ChatLaunch)
  (param launched (? ChatLaunch))
  (param row ChatRow)
  (case? (and launched (== (. launched message-id) (. row message id)))
    launched
  )
  (default
    null
  )
)

(fn-expr _ chat-row-is-prompt Bool
  (param row ChatRow)
  (and (== (. row fold) null) (== (. row message role) (. AIMessageRole user)))
)

(fn-do _ chat-add-fold _
  (param rows (list ChatRow))
  (param fold AIChatBranch)
  (let prompt (call chat-branch-prompt fold))
  (if prompt
    (+= rows (call ChatRow (str "fold:" (. fold id)) prompt fold))
  )
)

(fn-expr _ chat-fold-unfolds _
  (param chat AIChat)
  (param fold (? AIChatBranch))
  (and (!= fold null) (call chat-can-unfold chat (. fold id)))
)

(fn-expr _ chat-row-layout _
  (param source ChatMessageSource)
  (param leading VirtualCoord)
  (param gutter VirtualCoord)
  (call VerticalMeasuredLayout chat-row-estimate estimate leading (+ chat-row-trailing gutter))
  (where
    (lazy estimate (=> (address width) (call chat-message-estimate (. (call (. source row-at) address) message) width)))
  )
)

(fn-expr _ chat-message-estimate _
  (param message AIChatMessage)
  (param width VirtualCoord)
  (+ (* lines chat-estimated-line) chat-estimated-gap)
  (where
    (lazy column (if-expr (> width chat-estimated-column) chat-estimated-column width))
    (lazy line-size (if-expr is-narrow 1vcoord (/ column chat-estimated-char-span)))
    (lazy is-narrow (< column chat-estimated-char-span))
    (lazy found (+ 1vcoord (call chat-message-lines message line-size)))
    (lazy is-clamped (and (== (. message role) (. AIMessageRole user)) (> found chat-estimated-prompt-lines)))
    (lazy lines (if-expr is-clamped chat-estimated-prompt-lines found))
  )
)

(fn-do _ chat-message-lines VirtualCoord
  (param message AIChatMessage)
  (param line-size VirtualCoord)
  (let size Size 0)
  (let calls Size 0)
  (let images Size 0)
  (let rows Size 0)
  (let run Size 0)
  (for (in part (. message parts))
    (if (is part AIImagePart)
      (+= run 1)
      (else
        (+= images (call chat-run-images run))
        (+= rows (call chat-run-rows run))
        (= run 0)
      )
    )
    (if (= (| (: text AITextPart)) part)
      (+= size (. text text size))
      (else-if (= (| (: reasoning AIReasoningPart)) part)
        (+= size (. reasoning text size))
      )
      (else-if (= (| (: call AIToolCallPart)) part)
        (+= size (?? (?. (call ai-call-reply call) size) 0))
        (+= calls 1)
      )
    )
  )
  (+= images (call chat-run-images run))
  (+= rows (call chat-run-rows run))
  (let image-lines
    (scope (+ (* (as images VirtualCoord) chat-estimated-image-lines) row-lines)
      (lazy row-lines (* (as rows VirtualCoord) chat-estimated-image-row-lines))
    )
  )
  (return (+ (/ (as size VirtualCoord) line-size) (as calls VirtualCoord) image-lines))
)

(fn-expr _ chat-run-images Size
  (param run Size)
  (if-expr (== run 1) 1 0)
)

(fn-expr _ chat-run-rows Size
  (param run Size)
  (if-expr (> run 1) (/ (- (+ run chat-estimated-image-columns) 1) chat-estimated-image-columns) 0)
)
