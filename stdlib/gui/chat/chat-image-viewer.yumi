+ is-missing = false

_ loaded = Map'Size'Image()
_ serial Size

• This • flex-col fill-window
    focus-mode = FocusMode.keys
    background-color = RGBA("#000000d9")
    popup-focus = PopupFocus.first
    deactivate-dismiss = false

────────────────────

<This
    <ImageZoomView view • flex:1
        image = #shown
        previous-x = #before
        next-x = #after
        fit-insets = Insets
            - chat-viewer-margin
            - chat-viewer-margin
            - chat-viewer-margin
            - chat-viewer-margin
    if #is-missing
        <Label • chat-viewer-text absolute
            anchor = Anchor.parent
            top = PositionOffset.coord(chat-viewer-margin)
            align-x = Alignment.center
            text = "Image unavailable"
    <Box • absolute flex-row items-center
        anchor = Anchor.parent
        top = PositionOffset.coord(14)
        right = PositionOffset.coord(14)
        if #pictures.length > 1
            <Label • chat-viewer-text mr:10
                text = "${#index + 1} of ${#pictures.length}"
        <IconButton close-button • chat-viewer-close icon-x w:30 h:30

────────────────────
for event on close-button.click

dismiss()
event.cancel()

────────────────────
for event on click

. rect = view.image-rect
if !rect || !rect.contains(view.point-in-box(event.root-point))
    dismiss()
    event.cancel()

────────────────────
for event on key-press

if event.key == Key.arrow-left
    step(-1)
    event.cancel()
else if event.key == Key.arrow-right
    step(1)
    event.cancel()

────────────────────
for event on view.swiped

if event.axis == Orientation.horizontal
    index = ((index as Int) + event.step) as Size
    settle()

────────────────────
for _ on dismissed when arrival

serial += 1
release-all()

────────────────────
+ do present
    - shown-pictures [AIImage]
    - start Size

release-all()
pictures = shown-pictures
index = if start < shown-pictures.length then start else 0
show()
view.fit()
settle()

────────────────────
+ do step
    - offset Int

. next = (index as Int) + offset
=? if next < 0 || next >= pictures.length as Int
index = next as Size
view.fit()
settle()

────────────────────
_ do settle

serial += 1
is-missing = false
refresh()
do new fill(serial)

────────────────────
_ do refresh

shown = loaded[index]
before = loaded[index - 1] if index > 0
after = loaded[index + 1]

────────────────────
_ do fill
    - wanted Size

for offset in [0, 1, -1]
    =? if wanted != serial
    . at = (index as Int) + offset
    if at >= 0 && at < pictures.length as Int && !loaded[at]
        . slot = at as Size
        . made = load-picture(pictures[slot])
        if wanted != serial || loaded[slot]
            made?.release()
            =
        if made
            loaded[slot] = made
            refresh()
        else if slot == index
            is-missing = true
prune()

────────────────────
_ do load-picture Image?
    - picture AIImage

. path = chat-image-path(picture, images)
=? null if !path
= catch? load-image(path)

────────────────────
_ do prune

. far = List'Size()
for key, image in loaded
    if key + 1 < index || key > index + 1
        image.release()
        far += key
for key in far
    -= loaded[key]

────────────────────
_ do release-all

for _, image in loaded
    image.release()
loaded.clear()
shown = null
before = null
after = null
is-missing = false

━━━━━━━━━━━━━━━━━━━━
+ do chat-viewer-pictures [AIImage]
    - messages [AIChatMessage]

. found = List'AIImage()
for message in messages
    for part in message.parts
        if | image AIImagePart = part
            found += image.image
= found
