(import /graphics/color)
(import /graphics/text)
(import /gui)
(import /units)

(style-extend GUIDefaultTheme
  (using GUITextDecoration)
  (using GUIBoxCursor)
  (using GUIBoxTransform)
  (using GUIPopupStyle)
  (rule chat-transcript
    (= overflow-y (. ScrollOverflow auto))
  )
  (blank)
  (rule chat-column (• max-w 760)
    (= min-width (call (. SizeSpec percent) 100%))
    (= align-x (. Alignment center))
    (= font-size 14)
  )
  (blank)
  (rule chat-empty (• text gui-muted-text-color)
    (= font-size 20)
    (= text-alignment (. TextAlignment center))
  )
  (blank)
  (rule chat-access (• bg gui-popup-color) (• max-w 460)
    (= min-width (call (. SizeSpec percent) 60%))
    (= align-x (. Alignment center))
    (= border-color gui-border-color)
    (= border-width 1)
    (= corner-radius 12)
  )
  (blank)
  (rule chat-access-title (• text gui-strong-text-color)
    (= font-size 15)
  )
  (blank)
  (rule chat-access-field
    (= border-color gui-border-color)
    (= border-width 1)
  )
  (blank)
  (rule chat-access-text (• text gui-muted-text-color)
    (= font-size gui-callout-font-size)
    (= line-spacing 3)
  )
  (blank)
  (rule chat-dock-backdrop (• absolute))
  (blank)
  (rule chat-jump-button (• bg gui-field-color)
    (= corner-radius 16)
    (= border-color gui-border-color)
    (= border-width 1)
    (blank)
    (when-style #is-hover-within
      (= background-color (call (. gui-hover-color over) gui-field-color))
    )
    (blank)
    (when-style #is-press-within
      (= background-color (call (. gui-pressed-color over) gui-field-color))
    )
  )
  (blank)
  (rule chat-bare (• bg transparent) (• px 0)
    (= shadow null)
    (= min-height (. SizeSpec auto))
    (= max-height (. SizeSpec auto))
    (= font-size inherit)
    (= corner-radius 0)
    (blank)
    (when-style #is-untitled
      (• pl 0)
      (blank)
      (rule button-title
        (= display (. Display hidden))
      )
    )
    (blank)
    (when-style #is-hover-within
      (• bg transparent)
    )
    (blank)
    (when-style #is-press-within
      (• bg transparent)
      (= scale 1)
    )
    (blank)
    (rule button-content
      (= align-x (. Alignment start))
    )
  )
  (blank)
  (rule chat-side-pane (• bg gui-panel-color)
    (= border-color gui-border-color)
    (= border-left-width 1)
  )
  (blank)
  (rule chat-pane-header
    (= border-color gui-divider-color)
    (= border-bottom-width 1)
  )
  (blank)
  (rule chat-crumb (• bg transparent) (• text gui-muted-text-color)
    (= shadow null)
    (= font-size gui-body-font-size)
    (= corner-radius 6)
    (blank)
    (when-style #is-hover-within
      (• bg gui-hover-color)
      (• text gui-text-color)
    )
    (blank)
    (when-style #is-on
      (• bg transparent)
      (• text gui-strong-text-color)
    )
  )
  (blank)
  (rule chat-crumb-divider (• text gui-muted-text-color)
    (= font-size gui-body-font-size)
  )
  (blank)
  (rule chat-branch-error
    (= border-color gui-divider-color)
    (= border-bottom-width 1)
  )
  (blank)
  (rule chat-compaction (• text gui-muted-text-color) (• mb 10)
    (= font-size gui-callout-font-size)
  )
  (blank)
  (rule chat-bubble (• bg gui-field-color) (• max-w 560)
    (= corner-radius 16)
    (= border-color gui-field-color)
    (= border-width 1)
  )
  (blank)
  (rule chat-prompt
    (when-style #is-launched
      (rule chat-bubble
        (= (. motion position) gui-motion-smooth)
        (= (. motion size) gui-motion-smooth)
      )
    )
    (blank)
    (when-style #is-collapsed
      (rule chat-bubble (• bg transparent)
        (= border-color gui-border-color)
        (= cursor (. CursorStyle pointing-hand))
      )
      (blank)
      (rule chat-bubble-text (• text gui-muted-text-color))
    )
    (blank)
    (when-style #is-open
      (rule chat-bubble
        (= border-color gui-accent-color)
      )
    )
    (blank)
    (when-style #is-expanded
      (rule chat-prompt-body
        (= max-height (. SizeSpec auto))
      )
    )
  )
  (blank)
  (rule chat-prompt-body (• max-h 320)
    (= overflow-y (. ScrollOverflow clip))
  )
  (blank)
  (rule chat-stack-toggle (• text gui-muted-text-color) (• h 20)
    (= font-size gui-callout-font-size)
    (= cursor (. CursorStyle pointing-hand))
    (blank)
    (when-style #is-hover-within
      (• text gui-text-color)
    )
  )
  (blank)
  (rule chat-bubble-text
    (= line-spacing 4)
    (= text-wrap-sizing (. TextWrapSizing tight))
  )
  (blank)
  (rule chat-bubble-markdown
    (rule markdown-prose
      (= text-wrap-sizing (. TextWrapSizing tight))
    )
  )
  (blank)
  (rule chat-waiting (• text gui-muted-text-color))
  (blank)
  (rule chat-error (• text chat-error-color))
  (blank)
  (rule chat-tool (• mb 10))
  (blank)
  (rule chat-image (• bg gui-field-color)
    (= corner-radius 8)
    (= cursor (. CursorStyle pointing-hand))
  )
  (blank)
  (rule chat-tool-line (• bg gui-field-color)
    (= border-color gui-border-color)
    (= border-width 1)
    (= corner-radius 8)
  )
  (blank)
  (rule chat-tool-title (• text gui-muted-text-color)
    (= text-wrap (. TextWrap no-wrap))
    (= text-overflow (. TextOverflow truncate-tail))
  )
  (blank)
  (rule chat-composer (• px 18) (• pt 8) (• pb 20))
  (blank)
  (rule chat-composer-row (• max-w 760)
    (= min-width (call (. SizeSpec percent) 100%))
    (= align-x (. Alignment center))
  )
  (blank)
  (rule chat-queue-row (• max-w 760) (• px 18)
    (= min-width (call (. SizeSpec percent) 100%))
    (= align-x (. Alignment center))
  )
  (blank)
  (rule chat-queued (• bg gui-field-color)
    (= border-color gui-border-color)
    (= border-width 1)
    (= corner-radius gui-card-radius)
  )
  (blank)
  (rule chat-queue-entry
    (= (. motion position) gui-motion-quick)
    (blank)
    (when-style #is-carried
      (rule chat-queued
        (= shadow gui-lifted-shadow)
      )
    )
  )
  (blank)
  (rule chat-queue-grip (• text gui-muted-text-color)
    (= cursor (. CursorStyle open-hand))
  )
  (blank)
  (rule chat-queue-text
    (= text-wrap (. TextWrap no-wrap))
  )
  (blank)
  (rule chat-composer-field (• bg gui-field-color)
    (= border-color gui-border-color)
    (= border-width 1)
    (= corner-radius 23)
    (blank)
    (when-style #is-armed
      (= border-color gui-accent-bright-color)
    )
  )
  (blank)
  (rule chat-attachment (• bg gui-panel-color)
    (= border-color gui-border-color)
    (= border-width 1)
    (= corner-radius 8)
    (= overflow-x (. ScrollOverflow clip))
    (= overflow-y (. ScrollOverflow clip))
  )
  (blank)
  (rule chat-attachment-remove (• bg gui-window-color)
    (= corner-radius 9)
  )
  (blank)
  (rule chat-composer-problem (• text chat-error-color)
    (= font-size gui-callout-font-size)
  )
  (blank)
  (rule chat-composer-input
    (= font-size 14)
    (= line-spacing 4)
    (blank)
    (when-style #is-bare
      (• py 8)
    )
  )
  (blank)
  (rule chat-draft-ghost (• px 14) (• py 9)
    (= max-width (call (. SizeSpec percent) 100%))
    (= opacity 0%%)
    (= font-size 14)
  )
  (blank)
  (rule chat-send-button (• bg gui-accent-color) (• text gui-accent-text-color)
    (= corner-radius 15)
    (blank)
    (when-style #is-hover-within
      (• bg gui-accent-bright-color)
      (• text gui-accent-text-color)
    )
    (blank)
    (when-style #is-press-within
      (• bg gui-accent-color)
    )
    (blank)
    (when-style #is-idle
      (• bg gui-pressed-color)
      (• text gui-muted-text-color)
      (= cursor (. CursorStyle arrow))
    )
    (blank)
    (rule icon (• w 16) (• h 16)
      (= stroke-width 2.25)
    )
    (blank)
    (when-style #is-busy
      (= background-color (call RGBA "#bd4141"))
      (rule icon (• w 12) (• h 12)
        (= stroke-width 2.5)
      )
    )
  )
)
