/graphics/thumbnail-cache
/gui/markdown

━━━━━━━━━━━━━━━━━━━━
+ ChatBlockCaches

+ thumbnails = ThumbnailCache()
_ caches = Map'String'MarkdownBlockCache()

────────────────────
+ do cache-for
    - key String

. found = caches[key]
=? found if found
. cache = MarkdownBlockCache()
caches[key] = cache
= cache

────────────────────
+ is-filled
    - key String

caches[key]?.is-filled ?? false
