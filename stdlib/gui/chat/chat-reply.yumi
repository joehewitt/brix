━━━━━━━━━━━━━━━━━━━━
+ ChatToolDetail is Box

+ use ChatToolUse
+ provider AIProvider
+ task AIToolTask?
+ status ChatToolStatus
+ shown-input = chat-tool-input(#provider, #use.call, #use.call.#arguments)
+ output = chat-tool-output(#use, #task?.#output, #task?.#is-backgrounded ?? false, #status)
+ is-failed = #status == ChatToolStatus.failed

_ is-shown = false
_ is-watching = false

────────────────────

<This • flex-col
    if #shown-input != null
        <Box • markdown-code-block flex-col px:10 py:7 mb:6
            <Text • markdown-code
                <Span
                    text = #shown-input!
    <Box • markdown-code-block chat-tool-output flex-col px:10 py:7
        <Text • markdown-code
            <Span
                text = #output

────────────────────
whenever #task

watch()

────────────────────
whenever #status

watch()

────────────────────
+ do mounted

super.mounted()
is-shown = true
watch()

────────────────────
+ do unmounted

is-shown = false
super.unmounted()

────────────────────
_ do watch

=? if is-watching || !is-shown
. watched = task
=? if !watched || !watched.is-running
is-watching = true
do new
    follow(watched)

────────────────────
_ do follow
    - watched AIToolTask

while is-shown && watched.is-running
    . text = provider.read-task-output(watched)
    if text != null && watched.is-running
        watched.show-output(text)
    chat-tool-poll.wait()
is-watching = false

━━━━━━━━━━━━━━━━━━━━
+ do chat-reply-segments [ChatSegment]
    - beat U64
    - parts [AIMessagePart]

. results = Map'String'AIToolResultPart()
for part in parts
    if | result AIToolResultPart = part
        results[result.call-id] = result
. segments = List'ChatSegment()
. group [ChatToolUse]? = null
for part in parts
    if | text AITextPart = part
        if text.text.size > 0
            group = null
            segments += ChatSegment(text.id, part) • text text
    else if | reasoning AIReasoningPart = part
        if reasoning.text.size > 0
            group = null
            segments += ChatSegment(reasoning.id, part) • thinking reasoning
    else if | call AIToolCallPart = part
        if chat-groups-call(call)
            if !group
                . made = List'ChatToolUse()
                segments += ChatSegment("tools:${call.id}", part) • uses made
                group = made
            group += ChatToolUse(call, results[call.call-id])
        else if !ai-is-question-call(call) && is-last-or-not-task
            group = null
            segments += ChatSegment(call.id, part)
        .. is-last-or-not-task = !ai-is-task-call(call) || ai-is-last-task-call(parts, call)
    else if | extension AIExtensionPart = part
        if extension.part-type == ai-compaction-part || extension.part-type == ai-steer-part
            group = null
            segments += ChatSegment(extension.id, part)
    else if part is not AIToolResultPart
        group = null
        segments += ChatSegment(ai-part-id(part), part)
= segments

━━━━━━━━━━━━━━━━━━━━
_ do chat-reply-last-work Size?
    - segments [ChatSegment]

. found Size? = null
for index in 0 .. < segments.length
    if segments[index].thinking || segments[index].uses
        found = index
= found

━━━━━━━━━━━━━━━━━━━━
_ do chat-reply-visible [ChatSegment]
    - segments [ChatSegment]
    - last-work Size?
    - is-folded Bool

=? segments if !is-folded || last-work == null
. shown = List'ChatSegment()
for index in 0 .. < segments.length
    . segment = segments[index]
    if index > last-work || (!segment.text && !segment.thinking && !segment.uses)
        shown += segment
= shown

━━━━━━━━━━━━━━━━━━━━
_ chat-reply-elapsed Duration?
    - tick U64
    - saved Duration?
    - session AIChatSession
    - id String

|? saved != null
    saved
|? session.reply?.id == id
    session.reply-elapsed
??
    null

━━━━━━━━━━━━━━━━━━━━
+ chat-elapsed-text String?
    - elapsed Duration?

|? elapsed == null
    null
|? seconds < 60
    "${seconds}s"
|? seconds < 3600
    "${seconds / 60}m ${seconds % 60}s"
??
    "${seconds / 3600}h ${seconds / 60 % 60}m"

.. seconds = (elapsed / 1s) as I64

━━━━━━━━━━━━━━━━━━━━
_ chat-worked-text String
    - elapsed String?

if elapsed != null then "Worked $elapsed" else "Worked"

━━━━━━━━━━━━━━━━━━━━
_ chat-reply-tail-key String?
    - segments [ChatSegment]

segments[segments.length - 1].key if segments.length

━━━━━━━━━━━━━━━━━━━━
_ do chat-reply-pends Bool
    - parts [AIMessagePart]
    - segments [ChatSegment]

=? true if !segments.length
. tail = segments[segments.length - 1]
=? false if tail.uses
if | call AIToolCallPart = tail.part
    =? false if chat-is-working(call, parts, null)
= true

━━━━━━━━━━━━━━━━━━━━
_ chat-groups-call Bool
    - call AIToolCallPart

is-ordinary && !ai-is-question-call(call) && ai-call-reply(call) == null

.. is-ordinary = !ai-is-task-call(call) && !ai-is-image-call(call)

━━━━━━━━━━━━━━━━━━━━
+ chat-tool-status ChatToolStatus
    - use ChatToolUse
    - task-status AIToolTaskStatus?
    - is-behind Bool
    - is-live Bool

|? task-status == AIToolTaskStatus.running && is-behind
    ChatToolStatus.behind
|? task-status == AIToolTaskStatus.running
    ChatToolStatus.running
|? task-status == AIToolTaskStatus.failed || (use.result?.is-error ?? false)
    ChatToolStatus.failed
|? task-status == AIToolTaskStatus.stopped
    ChatToolStatus.stopped
|? use.result != null
    ChatToolStatus.done
|? is-live
    ChatToolStatus.running
??
    ChatToolStatus.stopped

━━━━━━━━━━━━━━━━━━━━
_ do chat-tool-statuses [ChatToolStatus]
    - revision U64
    - tasks AIToolTasks
    - uses [ChatToolUse]
    - is-live Bool

. found = List'ChatToolStatus()
for use in uses
    . task = tasks.for-call(use.call.call-id)
    found += chat-tool-status(use, task?.status, task?.is-backgrounded ?? false, is-live)
= found

━━━━━━━━━━━━━━━━━━━━
_ chat-tasks-open Bool
    - tasks [AITask]

some(tasks) • where each.status != AITaskStatus.done

━━━━━━━━━━━━━━━━━━━━
_ chat-reply-tail-tools String?
    - segments [ChatSegment]

segments[segments.length - 1].key if segments.length > 0 && tail-has-uses

.. tail-has-uses = segments[segments.length - 1].uses != null

━━━━━━━━━━━━━━━━━━━━
_ chat-group-status ChatToolStatus
    - statuses [ChatToolStatus]
    - is-active Bool

|? is-active || statuses.find(ChatToolStatus.running) != null
    ChatToolStatus.running
|? statuses.find(ChatToolStatus.behind) != null
    ChatToolStatus.behind
??
    statuses[statuses.length - 1]

━━━━━━━━━━━━━━━━━━━━
_ chat-group-title String
    - provider AIProvider
    - uses [ChatToolUse]
    - arguments JSON
    - shows-latest Bool

|? shows-latest
    chat-tool-label(provider, uses[uses.length - 1].call, arguments)
??
    chat-tools-summary(provider, uses)

━━━━━━━━━━━━━━━━━━━━
+ do chat-tools-summary String
    - provider AIProvider
    - uses [ChatToolUse]

. kinds = List'AIToolKind()
. counts = List'Size()
. seen = List'String()
for use in uses
    . kind = provider.tool-kind(use.call)
    . found = kinds.find(kind)
    . at = found ?? kinds.length
    if found == null
        kinds += kind
        counts += 0
    . input = provider.tool-input(use.call) if chat-tool-kind-files(kind)
    if input == null || seen.find("$at:$input") == null
        counts[at] = counts[at] + 1
    if input != null
        seen += "$at:$input"
. phrases = List'String()
for index in 0 .. < kinds.length
    phrases += chat-tool-phrase(kinds[index], counts[index])
. text = ", ".join(phrases)
= "${text[0 .. < 1].uppercased}${text[1 ...]}"

━━━━━━━━━━━━━━━━━━━━
_ chat-tool-kind-files Bool
    - kind AIToolKind

kind == AIToolKind.read || kind == AIToolKind.write || kind == AIToolKind.edit

━━━━━━━━━━━━━━━━━━━━
_ chat-tool-phrase String
    - kind AIToolKind
    - count Size

match kind
    |= AIToolKind.command
        chat-counted(count, "ran a command", "ran $count commands")
    |= AIToolKind.read
        chat-counted(count, "read a file", "read $count files")
    |= AIToolKind.write
        chat-counted(count, "wrote a file", "wrote $count files")
    |= AIToolKind.edit
        chat-counted(count, "edited a file", "edited $count files")
    |= AIToolKind.search
        chat-counted(count, "searched for a pattern", "searched for $count patterns")
    |= AIToolKind.fetch
        chat-counted(count, "fetched a page", "fetched $count pages")
    |= AIToolKind.web-search
        chat-counted(count, "searched the web", "searched the web $count times")
    |= AIToolKind.agent
        chat-counted(count, "ran an agent", "ran $count agents")
    |= AIToolKind.skill
        chat-counted(count, "used a skill", "used $count skills")
    |= AIToolKind.tool-search
        "loaded tools"
    ??
        chat-counted(count, "used a tool", "used $count tools")

━━━━━━━━━━━━━━━━━━━━
_ chat-counted String
    - count Size
    - one String
    - many String

if count == 1 then one else many

━━━━━━━━━━━━━━━━━━━━
+ chat-tool-label String
    - provider AIProvider
    - call AIToolCallPart
    - arguments JSON

provider.tool-title(call) ?? chat-tool-title(arguments) ?? call.tool-name

━━━━━━━━━━━━━━━━━━━━
_ chat-tool-input String?
    - provider AIProvider
    - call AIToolCallPart
    - arguments JSON

provider.tool-input(call) ?? chat-tool-arguments(arguments)

━━━━━━━━━━━━━━━━━━━━
_ do chat-tool-arguments String?
    - arguments JSON

. fields = match? arguments
    | [String = JSON]
=? null if !fields || !fields.length
. lines = List'String()
for key, value in fields
    if | text String = value
        lines += "$key: $text"
    else
        lines += "$key: ${to-json(value)}"
= "\n".join(lines)

━━━━━━━━━━━━━━━━━━━━
_ chat-tool-output String
    - use ChatToolUse
    - shown String?
    - is-behind Bool
    - status ChatToolStatus

|? shown != null && (is-behind || use.result == null)
    shown
|? use.result != null
    use.result.text-output ?? to-json(use.result.output)
|? status == ChatToolStatus.running || status == ChatToolStatus.behind
    "Waiting for output…"
??
    "No output"

━━━━━━━━━━━━━━━━━━━━
_ chat-behind-text String
    - count Size

|? count == 1
    "1 in background"
??
    "$count in background"

━━━━━━━━━━━━━━━━━━━━
+ do chat-worker-line String?
    - parts [AIMessagePart]

. index = parts.length
while index > 0
    index -= 1
    if | text AITextPart = parts[index]
        . trimmed = text.text.trim()
        if trimmed.length > 0
            . ending = trimmed.find("\n")
            = if ending != null then trimmed[0 .. < ending] else trimmed
    else if | reasoning AIReasoningPart = parts[index]
        . trimmed = reasoning.text.trim()
        if trimmed.length > 0
            . last String? = null
            for line in trimmed.split("\n")
                last = line
            = last?.trim() ?? trimmed
= null
