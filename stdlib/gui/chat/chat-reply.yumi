+ ChatToolGroupView is Box

+ uses [ChatToolUse]
+ session AIChatSession
+ memory ChatViewMemory
+ state ChatToolState
+ is-live = false
+ is-active = false
+ elapsed String? = null
+ provider = #session.service.provider
+ tasks = #provider.tool-tasks
+ statuses = chat-tool-statuses(#tasks.#revision, #tasks, #uses, #is-live)
+ status = chat-group-status(#statuses, #is-active)
+ behind = count(each in #statuses when each == ChatToolStatus.behind)
+ latest = #uses[#uses.length - 1]
+ is-single = #uses.length == 1
+ title = chat-group-title(#provider, #uses, #latest.call.#arguments, #is-active || #is-single)
+ is-open = #state.#is-open
+ is-running = #status == ChatToolStatus.running
+ event resizing Bool

────────────────────

<This • chat-tool-group flex-col
