━━━━━━━━━━━━━━━━━━━━
+ ChatToolStatus is Union

| running
| behind
| done
| failed
| stopped

━━━━━━━━━━━━━━━━━━━━
+ ChatToolUse is Tuple

+ call AIToolCallPart
+ result AIToolResultPart?

━━━━━━━━━━━━━━━━━━━━
+ ChatSegment is Tuple

+ key String
+ part AIMessagePart
+ text AITextPart? = null
+ thinking AIReasoningPart? = null
+ uses [ChatToolUse]? = null

━━━━━━━━━━━━━━━━━━━━
+ ChatReply is Box

+ message AIChatMessage
+ session AIChatSession
+ messages [AIChatMessage]
+ caches ChatBlockCaches
+ images AIImageStore?
+ memory ChatViewMemory
+ is-wake = false
+ beat U64
+ is-live = #message.#finish-reason == null
+ is-stopped = #message.#finish-reason == AIFinishReason.cancellation
+ segments = chat-reply-segments(#beat, #message.#parts)
+ tail-key = chat-reply-tail-key(#segments)
+ is-pending = #is-live && chat-reply-pends(#message.#parts, #segments)
+ tick U64
+ elapsed = chat-reply-elapsed(#tick, #message.#elapsed, #session, #message.id)
+ elapsed-text = chat-elapsed-text(#elapsed)
+ work = memory.tool-for("${#message.id}/work")
+ last-work = chat-reply-last-work(#segments)
+ has-work = !#is-live && #last-work != null
+ visible-segments = chat-reply-visible(#segments, #last-work, #has-work && !#work.#is-open)
+ tasks = ai-tasks(#messages, #message, #message.#parts)
+ is-anchored = #is-live && chat-tasks-open(#tasks)
+ tail-tools = chat-reply-tail-tools(#visible-segments)
+ event resizing Bool

_ is-shown = false
_ is-ticking = false

────────────────────

<This • flex-col
    if #is-wake
        <Label • chat-wake h:20 mb:6
            text = "Continued after background work"
    if #has-work
        <ChatWorkLine
            elapsed = #elapsed-text
            state = #work
            for _ on toggled
                resizing <- true
    for segment in #visible-segments keyed by segment.key
        <ChatSegmentView
            segment = segment
            message = message
            session = session
            messages = messages
            caches = caches
            images = images
            memory = memory
            is-live = #is-live
            is-active = #is-live && segment.key == #tail-key
            elapsed = #elapsed-text if #is-live && segment.key == #tail-key
            shows-tasks = !#is-anchored
            anchored = #tasks if #is-anchored && segment.key == #tail-tools
            for _ on growing
                resizing <- true
    if #is-anchored && #tail-tools == null
        <ChatTaskList • chat-tasks
            tasks = #tasks
            is-live = true
    if #is-pending
        <Box • chat-tool-group flex-row items-center h:26
            <ChatToolIcon • mr:8
                status = ChatToolStatus.running
            <Label • chat-tool-summary chat-tool-live
                text = "Thinking…"
            if #elapsed-text != null
                <Label • chat-tool-time ml:8
                    text = #elapsed-text ?? ""
    if message.#error != null
        <Text • chat-error
            <Span
                text = message.#error?.service-message ?? ""
    if #is-stopped
        <Label • chat-stopped h:20
            text = "Stopped"

────────────────────
for _ on session.streamed

if message.finish-reason == null
    beat += 1

────────────────────
whenever #is-live

tick-live()

────────────────────
+ do mounted

super.mounted()
is-shown = true
tick-live()

────────────────────
+ do unmounted

is-shown = false
super.unmounted()

────────────────────
_ do tick-live

=? if is-ticking || !is-shown || !is-live
is-ticking = true
do new
    count-seconds()

────────────────────
_ do count-seconds

while is-shown && is-live
    (chat-reply-tick - session.reply-elapsed % chat-reply-tick).wait()
    tick += 1
is-ticking = false

