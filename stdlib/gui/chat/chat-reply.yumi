<This • flex-col
    if #anchored != null
        <ChatTaskList • chat-tasks
            tasks = #anchored!
            is-live = true
    if #segment.text != null
        <MarkdownView
            text = #segment.text!.#text
            cache = caches.cache-for(chat-part-key(message, #segment.part))
    else if #segment.thinking?.is-update ?? false
        <MarkdownView
            text = #segment.thinking!.#text
            cache = caches.cache-for(chat-part-key(message, #segment.part))
    else if #segment.thinking != null
        <MarkdownView • chat-thinking
            text = #segment.thinking!.#text
            cache = caches.cache-for(chat-part-key(message, #segment.part))
    else if #segment.uses != null
        <ChatToolGroupView
            uses = #segment.uses!
            session = session
            memory = memory
            state = memory.tool-for("${message.id}/${#segment.key}")
            is-live = #is-live
            is-active = #is-active
            elapsed = #elapsed
            for _ on resizing
                growing <- true
    else
        <ChatPartView
            part = #segment.part
            message = message
            messages = messages
            caches = caches
            images = images
            shows-tasks = #shows-tasks

