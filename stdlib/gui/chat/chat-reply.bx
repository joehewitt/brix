(import ./chat-caches)
(import ./chat-memory)
(import ./chat-parts)
(import ./chat-tasks)
(import ./chat-theme)
(import /ai)
(import /data/json)
(import /graphics/primitives)
(import /graphics/shader-fills)
(import /graphics/text)
(import /gui)
(import /gui/disclosure)
(import /gui/icons/lucide/circle-stop)
(import /gui/icons/lucide/circle-x)
(import /gui/markdown)
(import /stream/aggregate)
(import /time/duration)
(blank)
(prop _ chat-tool-poll Duration (= 1s))
(prop _ chat-reply-tick Duration (= 1s))
(prop _ chat-tool-dot-size Length (= 8))

(style-extend GUIDefaultTheme
  (using GUIBoxCursor)
  (rule chat-thinking (• text gui-muted-text-color))
  (blank)
  (rule chat-tool-group (• mb 10))
  (blank)
  (rule chat-tool-header
    (= cursor (. CursorStyle pointing-hand))
    (= align-x (. Alignment start))
    (blank)
    (when-style #is-hover-within
      (rule chat-tool-summary (• text gui-text-color))
      (rule chat-tool-name (• text gui-text-color))
      (rule chat-tool-chevron (• text gui-text-color))
    )
  )
  (blank)
  (rule chat-tool-summary (• text gui-muted-text-color)
    (= text-wrap (. TextWrap no-wrap))
  )
  (blank)
  (rule chat-tool-live
    (= text-fill (call Shimmer gui-muted-text-color gui-strong-text-color))
  )
  (blank)
  (rule ChatToolGroupView
    (when-style #is-running
      (rule chat-tool-summary
        (= text-fill (call Shimmer gui-muted-text-color gui-strong-text-color))
      )
    )
  )
  (blank)
  (rule chat-tool-name (• text gui-muted-text-color)
    (= font-size gui-callout-font-size)
    (= text-wrap (. TextWrap no-wrap))
  )
  (blank)
  (rule chat-tool-time (• text gui-muted-text-color)
    (= text-wrap (. TextWrap no-wrap))
  )
  (blank)
  (rule chat-tool-note (• text gui-muted-text-color)
    (= font-size gui-footnote-font-size)
    (= text-wrap (. TextWrap no-wrap))
  )
  (blank)
  (rule chat-tool-chevron (• text gui-muted-text-color))
  (blank)
  (rule chat-tool-icon (• text gui-muted-text-color))
  (blank)
  (rule chat-tool-pulse (• bg gui-strong-text-color) (• w chat-tool-dot-size) (• h chat-tool-dot-size) (• min-w chat-tool-dot-size)
    (= corner-radius (/ chat-tool-dot-size 2))
    (= animation pulse)
  )
  (blank)
  (rule chat-tool-failed (• text chat-error-color))
  (blank)
  (rule chat-tool-output (• max-h 240)
    (= overflow-y (. ScrollOverflow auto))
  )
  (blank)
  (rule ChatToolDetail
    (when-style #is-failed
      (rule chat-tool-output (• text chat-error-color))
    )
  )
  (blank)
  (rule chat-wake (• text gui-muted-text-color)
    (= font-size gui-callout-font-size)
  )
  (blank)
  (rule chat-stopped (• text gui-muted-text-color)
    (= font-size gui-callout-font-size)
  )
)

(type + ChatToolStatus (is Union)
  (variant running)
  (variant behind)
  (variant done)
  (variant failed)
  (variant stopped)
)

(type + ChatToolUse (is Tuple)
  (prop + call AIToolCallPart)
  (prop + result (? AIToolResultPart))
)

(type + ChatSegment (is Tuple)
  (prop + key String)
  (prop + part AIMessagePart)
  (prop + text (? AITextPart) (= null))
  (prop + thinking (? AIReasoningPart) (= null))
  (prop + uses (? (list ChatToolUse)) (= null))
)

(type + ChatReply (is Box)
  (prop + message AIChatMessage)
  (prop + session AIChatSession)
  (prop + messages (list AIChatMessage))
  (prop + caches ChatBlockCaches)
  (prop + images (? AIImageStore))
  (prop + memory ChatViewMemory)
  (prop + is-wake _ (= false))
  (prop + beat U64)
  (prop + is-live _ (= (== (. #message #finish-reason) null)))
  (prop + is-stopped _ (= (== (. #message #finish-reason) (. AIFinishReason cancellation))))
  (prop + segments _ (= (call chat-reply-segments #beat (. #message #parts))))
  (prop + tail-key _ (= (call chat-reply-tail-key #segments)))
  (prop + is-pending _ (= (and #is-live (call chat-reply-pends (. #message #parts) #segments))))
  (prop + tick U64)
  (prop + elapsed _ (= (call chat-reply-elapsed #tick (. #message #elapsed) #session (. #message id))))
  (prop + elapsed-text _ (= (call chat-elapsed-text #elapsed)))
  (prop + work _ (= (call (. memory tool-for) (str (. #message id) "/work"))))
  (prop + last-work _ (= (call chat-reply-last-work #segments)))
  (prop + has-work _ (= (and (not #is-live) (!= #last-work null))))
  (prop + visible-segments _ (= (call chat-reply-visible #segments #last-work (and #has-work (not (. #work #is-open))))))
  (prop + tasks _ (= (call ai-tasks #messages #message (. #message #parts))))
  (prop + is-anchored _ (= (and #is-live (call chat-tasks-open #tasks))))
  (prop + tail-tools _ (= (call chat-reply-tail-tools #visible-segments)))
  (event + resizing Bool)
  (blank)
  (prop _ is-shown _ (= false))
  (prop _ is-ticking _ (= false))
  (content
    (<> This (• flex-col)
      (if #is-wake
        (<> Label (• chat-wake) (• h 20) (• mb 6)
          (= text "Continued after background work")
        )
      )
      (if #has-work
        (<> ChatWorkLine
          (= elapsed #elapsed-text)
          (= state #work)
          (for (on _ toggled)
            (<- resizing true)
          )
        )
      )
      (for (in segment #visible-segments (keyed-by (. segment key)))
        (<> ChatSegmentView
          (= segment segment)
          (= message message)
          (= session session)
          (= messages messages)
          (= caches caches)
          (= images images)
          (= memory memory)
          (= is-live #is-live)
          (= is-active (and #is-live (== (. segment key) #tail-key)))
          (= elapsed (only-if #elapsed-text (if (and #is-live (== (. segment key) #tail-key)))))
          (= shows-tasks (not #is-anchored))
          (= anchored (only-if #tasks (if (and #is-anchored (== (. segment key) #tail-tools)))))
          (for (on _ growing)
            (<- resizing true)
          )
        )
      )
      (if (and #is-anchored (== #tail-tools null))
        (<> ChatTaskList (• chat-tasks)
          (= tasks #tasks)
          (= is-live true)
        )
      )
      (if #is-pending
        (<> Box (• chat-tool-group) (• flex-row) (• items-center) (• h 26)
          (<> ChatToolIcon (• mr 8)
            (= status (. ChatToolStatus running))
          )
          (<> Label (• chat-tool-summary) (• chat-tool-live)
            (= text "Thinking…")
          )
          (if (!= #elapsed-text null)
            (<> Label (• chat-tool-time) (• ml 8)
              (= text (?? #elapsed-text ""))
            )
          )
        )
      )
      (if (!= (. message #error) null)
        (<> Text (• chat-error)
          (<> Span
            (= text (?? (?. (. message #error) service-message) ""))
          )
        )
      )
      (if #is-stopped
        (<> Label (• chat-stopped) (• h 20)
          (= text "Stopped")
        )
      )
    )
  )
  (subscribe-for (on _ (. session streamed))
    (if (== (. message finish-reason) null)
      (+= beat 1)
    )
  )
  (whenever-rule #is-live
    (call tick-live)
  )
  (fn-do + mounted _
    (call (. super mounted))
    (= is-shown true)
    (call tick-live)
  )
  (fn-do + unmounted _
    (= is-shown false)
    (call (. super unmounted))
  )
  (fn-do _ tick-live _
    (return-if (if (or is-ticking (not is-shown) (not is-live))))
    (blank)
    (= is-ticking true)
    (do-new
      (call count-seconds)
    )
  )
  (fn-do _ count-seconds _
    (while (and is-shown is-live)
      (call (. (- chat-reply-tick (% (. session reply-elapsed) chat-reply-tick)) wait))
      (+= tick 1)
    )
    (= is-ticking false)
  )
)

(type + ChatWorkLine (is Box)
  (prop + elapsed (? String))
  (prop + state ChatToolState)
  (prop + is-open _ (= (. #state #is-open)))
  (event + toggled Bool)
  (content
    (<> This (• chat-tool-group) (• flex-col)
      (<> Button (id: header) (• chat-bare) (• chat-tool-header) (• h 26)
        (<> Box (slot: leading) (• flex-row) (• flex 1) (• items-center)
          (<> Label (• chat-tool-summary) (• flex 1)
            (= text (call chat-worked-text #elapsed))
          )
          (<> DisclosureChevron (• icon) (• chat-tool-chevron) (• w 12) (• h 12) (• ml 6)
            (= is-open #is-open)
          )
        )
      )
    )
  )
  (subscribe-for (on event (. header click))
    (<- toggled true)
    (= (. state is-open) (not (. state is-open)))
    (call (. event cancel))
  )
)

(type + ChatSegmentView (is Box)
  (prop + segment ChatSegment)
  (prop + message AIChatMessage)
  (prop + session AIChatSession)
  (prop + messages (list AIChatMessage))
  (prop + caches ChatBlockCaches)
  (prop + images (? AIImageStore))
  (prop + memory ChatViewMemory)
  (prop + is-live _ (= false))
  (prop + is-active _ (= false))
  (prop + elapsed (? String) (= null))
  (prop + shows-tasks _ (= true))
  (prop + anchored (? (list AITask)) (= null))
  (event + growing Bool)
  (content
    (<> This (• flex-col)
      (if (!= #anchored null)
        (<> ChatTaskList (• chat-tasks)
          (= tasks (!! #anchored))
          (= is-live true)
        )
      )
      (if (!= (. #segment text) null)
        (<> MarkdownView
          (= text (. (!! (. #segment text)) #text))
          (= cache (call (. caches cache-for) (call chat-part-key message (. #segment part))))
        )
        (else-if (?? (?. (. #segment thinking) is-update) false)
          (<> MarkdownView
            (= text (. (!! (. #segment thinking)) #text))
            (= cache (call (. caches cache-for) (call chat-part-key message (. #segment part))))
          )
        )
        (else-if (!= (. #segment thinking) null)
          (<> MarkdownView (• chat-thinking)
            (= text (. (!! (. #segment thinking)) #text))
            (= cache (call (. caches cache-for) (call chat-part-key message (. #segment part))))
          )
        )
        (else-if (!= (. #segment uses) null)
          (<> ChatToolGroupView
            (= uses (!! (. #segment uses)))
            (= session session)
            (= memory memory)
            (= state (call (. memory tool-for) (str (. message id) "/" (. #segment key))))
            (= is-live #is-live)
            (= is-active #is-active)
            (= elapsed #elapsed)
            (for (on _ resizing)
              (<- growing true)
            )
          )
        )
        (else
          (<> ChatPartView
            (= part (. #segment part))
            (= message message)
            (= messages messages)
            (= caches caches)
            (= images images)
            (= shows-tasks #shows-tasks)
          )
        )
      )
    )
  )
)

(type + ChatToolGroupView (is Box)
  (prop + uses (list ChatToolUse))
  (prop + session AIChatSession)
  (prop + memory ChatViewMemory)
  (prop + state ChatToolState)
  (prop + is-live _ (= false))
  (prop + is-active _ (= false))
  (prop + elapsed (? String) (= null))
  (prop + provider _ (= (. #session service provider)))
  (prop + tasks _ (= (. #provider tool-tasks)))
  (prop + statuses _ (= (call chat-tool-statuses (. #tasks #revision) #tasks #uses #is-live)))
  (prop + status _ (= (call chat-group-status #statuses #is-active)))
  (prop + behind _ (= (call count (in each #statuses (when (== each (. ChatToolStatus behind)))))))
  (prop + latest _ (= ([] #uses (- (. #uses length) 1))))
  (prop + is-single _ (= (== (. #uses length) 1)))
  (prop + title _ (= (call chat-group-title #provider #uses (. #latest call #arguments) (or #is-active #is-single))))
  (prop + is-open _ (= (. #state #is-open)))
  (prop + is-running _ (= (== #status (. ChatToolStatus running))))
  (event + resizing Bool)
  (content
    (<> This (• chat-tool-group) (• flex-col)
      (<> Button (id: header) (• chat-bare) (• chat-tool-header) (• h 26)
        (<> Box (slot: leading) (• flex-row) (• flex 1) (• items-center)
          (if (!= #status (. ChatToolStatus done))
            (<> ChatToolIcon (• mr 8)
              (= status #status)
            )
          )
          (<> Label (• chat-tool-summary) (• shrink 1)
            (= text #title)
            (= text-overflow (. TextOverflow truncate-tail))
          )
          (if (!= #elapsed null)
            (<> Label (• chat-tool-time) (• ml 8)
              (= text (?? #elapsed ""))
            )
          )
          (if (> #behind 0)
            (<> Label (• chat-tool-note) (• ml 8)
              (= text (call chat-behind-text #behind))
            )
          )
          (<> DisclosureChevron (• icon) (• chat-tool-chevron) (• w 12) (• h 12) (• ml 6)
            (= is-open #is-open)
          )
        )
      )
      (if #is-open
        (if #is-single
          (<> ChatToolDetail (• ml 22) (• mb 4)
            (= use #latest)
            (= provider #provider)
            (= task (call ai-tool-task (. #tasks #revision) #tasks (. #latest call call-id)))
            (= status #status)
          )
          (else
            (<> Box (• flex-col) (• ml 22)
              (for (in use #uses (keyed-by (. use call id)))
                (<> ChatToolRowView
                  (= use use)
                  (= provider #provider)
                  (= task (call ai-tool-task (. #tasks #revision) #tasks (. use call call-id)))
                  (= state (call (. memory tool-for) (. use call call-id)))
                  (= is-live #is-live)
                  (for (on _ toggled)
                    (<- resizing true)
                  )
                )
              )
            )
          )
        )
      )
    )
  )
  (subscribe-for (on event (. header click))
    (<- resizing true)
    (= (. state is-open) (not (. state is-open)))
    (call (. event cancel))
  )
)

(type + ChatToolRowView (is Box)
  (prop + use ChatToolUse)
  (prop + provider AIProvider)
  (prop + task (? AIToolTask))
  (prop + state ChatToolState)
  (prop + is-live _ (= false))
  (prop + status _ (= (call chat-tool-status #use (?. #task #status) (?? (?. #task #is-backgrounded) false) #is-live)))
  (prop + title _ (= (call chat-tool-label #provider (. #use call) (. #use call #arguments))))
  (prop + is-open _ (= (. #state #is-open)))
  (event + toggled Bool)
  (content
    (<> This (• flex-col)
      (<> Button (id: header) (• chat-bare) (• chat-tool-header) (• h 24)
        (<> Box (slot: leading) (• flex-row) (• flex 1) (• items-center)
          (if (!= #status (. ChatToolStatus done))
            (<> ChatToolIcon (• mr 8)
              (= status #status)
            )
          )
          (<> Label (• chat-tool-name) (• flex 1)
            (= text #title)
            (= text-overflow (. TextOverflow truncate-tail))
          )
          (if (== #status (. ChatToolStatus behind))
            (<> Label (• chat-tool-note) (• ml 8)
              (= text "In background")
            )
          )
          (<> DisclosureChevron (• icon) (• chat-tool-chevron) (• w 12) (• h 12) (• ml 6)
            (= is-open #is-open)
          )
        )
      )
      (if #is-open
        (<> ChatToolDetail (• ml 22) (• mb 6)
          (= use #use)
          (= provider #provider)
          (= task #task)
          (= status #status)
        )
      )
    )
  )
  (subscribe-for (on event (. header click))
    (<- toggled true)
    (= (. state is-open) (not (. state is-open)))
    (call (. event cancel))
  )
)

(type + ChatToolIcon (is Box)
  (prop + status ChatToolStatus)
  (content
    (<> This (• flex-row) (• w 14) (• h 14) (• justify-center) (• items-center)
      (if (or (== #status (. ChatToolStatus running)) (== #status (. ChatToolStatus behind)))
        (<> Box (• chat-tool-pulse))
        (else-if (== #status (. ChatToolStatus failed))
          (<> LucideCircleX (• icon) (• chat-tool-failed) (• w 14) (• h 14))
        )
        (else-if (== #status (. ChatToolStatus stopped))
          (<> LucideCircleStop (• icon) (• chat-tool-icon) (• w 14) (• h 14))
        )
      )
    )
  )
)

(type + ChatToolDetail (is Box)
  (prop + use ChatToolUse)
  (prop + provider AIProvider)
  (prop + task (? AIToolTask))
  (prop + status ChatToolStatus)
  (prop + shown-input _ (= (call chat-tool-input #provider (. #use call) (. #use call #arguments))))
  (prop + output _ (= (call chat-tool-output #use (?. #task #output) (?? (?. #task #is-backgrounded) false) #status)))
  (prop + is-failed _ (= (== #status (. ChatToolStatus failed))))
  (blank)
  (prop _ is-shown _ (= false))
  (prop _ is-watching _ (= false))
  (content
    (<> This (• flex-col)
      (if (!= #shown-input null)
        (<> Box (• markdown-code-block) (• flex-col) (• px 10) (• py 7) (• mb 6)
          (<> Text (• markdown-code)
            (<> Span
              (= text (!! #shown-input))
            )
          )
        )
      )
      (<> Box (• markdown-code-block) (• chat-tool-output) (• flex-col) (• px 10) (• py 7)
        (<> Text (• markdown-code)
          (<> Span
            (= text #output)
          )
        )
      )
    )
  )
  (whenever-rule #task
    (call watch)
  )
  (whenever-rule #status
    (call watch)
  )
  (fn-do + mounted _
    (call (. super mounted))
    (= is-shown true)
    (call watch)
  )
  (fn-do + unmounted _
    (= is-shown false)
    (call (. super unmounted))
  )
  (fn-do _ watch _
    (return-if (if (or is-watching (not is-shown))))
    (blank)
    (let watched task)
    (return-if (if (or (not watched) (not (. watched is-running)))))
    (blank)
    (= is-watching true)
    (do-new
      (call follow watched)
    )
  )
  (fn-do _ follow _
    (param watched AIToolTask)
    (while (and is-shown (. watched is-running))
      (let text (call (. provider read-task-output) watched))
      (if (and (!= text null) (. watched is-running))
        (call (. watched show-output) text)
      )
      (call (. chat-tool-poll wait))
    )
    (= is-watching false)
  )
)

(fn-do + chat-reply-segments (list ChatSegment)
  (param beat U64)
  (param parts (list AIMessagePart))
  (let results (call (of Map String AIToolResultPart)))
  (for (in part parts)
    (if (= (| (: result AIToolResultPart)) part)
      (= ([] results (. result call-id)) result)
    )
  )
  (let segments (call (of List ChatSegment)))
  (let group (? (list ChatToolUse)) null)
  (for (in part parts)
    (if (= (| (: text AITextPart)) part)
      (if (> (. text text size) 0)
        (= group null)
        (+= segments (call ChatSegment (. text id) part (:text text)))
      )
      (else-if (= (| (: reasoning AIReasoningPart)) part)
        (if (> (. reasoning text size) 0)
          (= group null)
          (+= segments (call ChatSegment (. reasoning id) part (:thinking reasoning)))
        )
      )
      (else-if (= (| (: call AIToolCallPart)) part)
        (if (call chat-groups-call call)
          (if (not group)
            (let made (call (of List ChatToolUse)))
            (+= segments (call ChatSegment (str "tools:" (. call id)) part (:uses made)))
            (= group made)
          )
          (+= group (call ChatToolUse call ([] results (. call call-id))))
          (else-if (and (not (call ai-is-question-call call)) (not (call ai-is-suggestion-call call)) is-last-or-not-task)
            (= group null)
            (+= segments (call ChatSegment (. call id) part))
          )
        )
        (lazy is-last-or-not-task (or (not (call ai-is-task-call call)) (call ai-is-last-task-call parts call)))
      )
      (else-if (= (| (: extension AIExtensionPart)) part)
        (if (or (== (. extension part-type) ai-compaction-part) (== (. extension part-type) ai-steer-part))
          (= group null)
          (+= segments (call ChatSegment (. extension id) part))
        )
      )
      (else-if (is-not part AIToolResultPart)
        (= group null)
        (+= segments (call ChatSegment (call ai-part-id part) part))
      )
    )
  )
  (return segments)
)

(fn-do _ chat-reply-last-work (? Size)
  (param segments (list ChatSegment))
  (let found (? Size) null)
  (for (in index (..< 0 (. segments length)))
    (if (or (. ([] segments index) thinking) (. ([] segments index) uses))
      (= found index)
    )
  )
  (return found)
)

(fn-do _ chat-reply-visible (list ChatSegment)
  (param segments (list ChatSegment))
  (param last-work (? Size))
  (param is-folded Bool)
  (return-if segments (if (or (not is-folded) (== last-work null))))
  (blank)
  (let shown (call (of List ChatSegment)))
  (for (in index (..< 0 (. segments length)))
    (let segment ([] segments index))
    (if (or (> index last-work) (and (not (. segment text)) (not (. segment thinking)) (not (. segment uses))))
      (+= shown segment)
    )
  )
  (return shown)
)

(fn-expr _ chat-reply-elapsed (? Duration)
  (param tick U64)
  (param saved (? Duration))
  (param session AIChatSession)
  (param id String)
  (case? (!= saved null)
    saved
  )
  (case? (== (?. (. session reply) id) id)
    (. session reply-elapsed)
  )
  (default
    null
  )
)

(fn-expr + chat-elapsed-text (? String)
  (param elapsed (? Duration))
  (case? (== elapsed null)
    null
  )
  (case? (< seconds 60)
    (str seconds "s")
  )
  (case? (< seconds 3600)
    (str (/ seconds 60) "m " (% seconds 60) "s")
  )
  (default
    (str (/ seconds 3600) "h " (% (/ seconds 60) 60) "m")
  )
  (where
    (lazy seconds (as (/ elapsed 1s) I64))
  )
)

(fn-expr _ chat-worked-text String
  (param elapsed (? String))
  (if-expr (!= elapsed null) (str "Worked " elapsed) "Worked")
)

(fn-expr _ chat-reply-tail-key (? String)
  (param segments (list ChatSegment))
  (only-if (. ([] segments (- (. segments length) 1)) key) (if (. segments length)))
)

(fn-do _ chat-reply-pends Bool
  (param parts (list AIMessagePart))
  (param segments (list ChatSegment))
  (return-if true (if (not (. segments length))))
  (blank)
  (let tail ([] segments (- (. segments length) 1)))
  (return-if false (if (. tail uses)))
  (blank)
  (if (= (| (: call AIToolCallPart)) (. tail part))
    (return-if false (if (call chat-is-working call parts null)))
  )
  (return true)
)

(fn-expr _ chat-groups-call Bool
  (param call AIToolCallPart)
  (and is-ordinary (not (call ai-is-question-call call)) (not (call ai-is-suggestion-call call)) (== (call ai-call-reply call) null))
  (where
    (lazy is-ordinary (and (not (call ai-is-task-call call)) (not (call ai-is-image-call call))))
  )
)

(fn-expr + chat-tool-status ChatToolStatus
  (param use ChatToolUse)
  (param task-status (? AIToolTaskStatus))
  (param is-behind Bool)
  (param is-live Bool)
  (case? (and (== task-status (. AIToolTaskStatus running)) is-behind)
    (. ChatToolStatus behind)
  )
  (case? (== task-status (. AIToolTaskStatus running))
    (. ChatToolStatus running)
  )
  (case? (or (== task-status (. AIToolTaskStatus failed)) (?? (?. (. use result) is-error) false))
    (. ChatToolStatus failed)
  )
  (case? (== task-status (. AIToolTaskStatus stopped))
    (. ChatToolStatus stopped)
  )
  (case? (!= (. use result) null)
    (. ChatToolStatus done)
  )
  (case? is-live
    (. ChatToolStatus running)
  )
  (default
    (. ChatToolStatus stopped)
  )
)

(fn-do _ chat-tool-statuses (list ChatToolStatus)
  (param revision U64)
  (param tasks AIToolTasks)
  (param uses (list ChatToolUse))
  (param is-live Bool)
  (let found (call (of List ChatToolStatus)))
  (for (in use uses)
    (let task (call (. tasks for-call) (. use call call-id)))
    (+= found (call chat-tool-status use (?. task status) (?? (?. task is-backgrounded) false) is-live))
  )
  (return found)
)

(fn-expr _ chat-tasks-open Bool
  (param tasks (list AITask))
  (call some tasks (:where (!= (. each status) (. AITaskStatus done))))
)

(fn-expr _ chat-reply-tail-tools (? String)
  (param segments (list ChatSegment))
  (only-if (. ([] segments (- (. segments length) 1)) key) (if (and (> (. segments length) 0) tail-has-uses)))
  (where
    (lazy tail-has-uses (!= (. ([] segments (- (. segments length) 1)) uses) null))
  )
)

(fn-expr _ chat-group-status ChatToolStatus
  (param statuses (list ChatToolStatus))
  (param is-active Bool)
  (case? (or is-active (!= (call (. statuses find) (. ChatToolStatus running)) null))
    (. ChatToolStatus running)
  )
  (case? (!= (call (. statuses find) (. ChatToolStatus behind)) null)
    (. ChatToolStatus behind)
  )
  (default
    ([] statuses (- (. statuses length) 1))
  )
)

(fn-expr _ chat-group-title String
  (param provider AIProvider)
  (param uses (list ChatToolUse))
  (param arguments JSON)
  (param shows-latest Bool)
  (case? shows-latest
    (call chat-tool-label provider (. ([] uses (- (. uses length) 1)) call) arguments)
  )
  (default
    (call chat-tools-summary provider uses)
  )
)

(fn-do + chat-tools-summary String
  (param provider AIProvider)
  (param uses (list ChatToolUse))
  (let kinds (call (of List AIToolKind)))
  (let counts (call (of List Size)))
  (let seen (call (of List String)))
  (for (in use uses)
    (let kind (call (. provider tool-kind) (. use call)))
    (let found (call (. kinds find) kind))
    (let at (?? found (. kinds length)))
    (if (== found null)
      (+= kinds kind)
      (+= counts 0)
    )
    (let input (only-if (call (. provider tool-input) (. use call)) (if (call chat-tool-kind-files kind))))
    (if (or (== input null) (== (call (. seen find) (str at ":" input)) null))
      (= ([] counts at) (+ ([] counts at) 1))
    )
    (if (!= input null)
      (+= seen (str at ":" input))
    )
  )
  (let phrases (call (of List String)))
  (for (in index (..< 0 (. kinds length)))
    (+= phrases (call chat-tool-phrase ([] kinds index) ([] counts index)))
  )
  (let text (call (. ", " join) phrases))
  (return (str (. ([] text (..< 0 1)) uppercased) ([] text (... 1))))
)

(fn-expr _ chat-tool-kind-files Bool
  (param kind AIToolKind)
  (or (== kind (. AIToolKind read)) (== kind (. AIToolKind write)) (== kind (. AIToolKind edit)))
)

(fn-expr _ chat-tool-phrase String
  (param kind AIToolKind)
  (param count Size)
  (match kind
    (case= (. AIToolKind command)
      (call chat-counted count "ran a command" (str "ran " count " commands"))
    )
    (case= (. AIToolKind read)
      (call chat-counted count "read a file" (str "read " count " files"))
    )
    (case= (. AIToolKind write)
      (call chat-counted count "wrote a file" (str "wrote " count " files"))
    )
    (case= (. AIToolKind edit)
      (call chat-counted count "edited a file" (str "edited " count " files"))
    )
    (case= (. AIToolKind search)
      (call chat-counted count "searched for a pattern" (str "searched for " count " patterns"))
    )
    (case= (. AIToolKind fetch)
      (call chat-counted count "fetched a page" (str "fetched " count " pages"))
    )
    (case= (. AIToolKind web-search)
      (call chat-counted count "searched the web" (str "searched the web " count " times"))
    )
    (case= (. AIToolKind agent)
      (call chat-counted count "ran an agent" (str "ran " count " agents"))
    )
    (case= (. AIToolKind skill)
      (call chat-counted count "used a skill" (str "used " count " skills"))
    )
    (case= (. AIToolKind tool-search)
      "loaded tools"
    )
    (default
      (call chat-counted count "used a tool" (str "used " count " tools"))
    )
  )
)

(fn-expr _ chat-counted String
  (param count Size)
  (param one String)
  (param many String)
  (if-expr (== count 1) one many)
)

(fn-expr + chat-tool-label String
  (param provider AIProvider)
  (param call AIToolCallPart)
  (param arguments JSON)
  (?? (call (. provider tool-title) call) (call chat-tool-title arguments) (. call tool-name))
)

(fn-expr _ chat-tool-input (? String)
  (param provider AIProvider)
  (param call AIToolCallPart)
  (param arguments JSON)
  (?? (call (. provider tool-input) call) (call chat-tool-arguments arguments))
)

(fn-do _ chat-tool-arguments (? String)
  (param arguments JSON)
  (let fields
    (match? arguments
      (case (map String JSON))
    )
  )
  (return-if null (if (or (not fields) (not (. fields length)))))
  (blank)
  (let lines (call (of List String)))
  (for (in (tuple key value) fields)
    (if (= (| (: text String)) value)
      (+= lines (str key ": " text))
      (else
        (+= lines (str key ": " (call to-json value)))
      )
    )
  )
  (return (call (. "\n" join) lines))
)

(fn-expr _ chat-tool-output String
  (param use ChatToolUse)
  (param shown (? String))
  (param is-behind Bool)
  (param status ChatToolStatus)
  (case? (and (!= shown null) (or is-behind (== (. use result) null)))
    shown
  )
  (case? (!= (. use result) null)
    (?? (. use result text-output) (call to-json (. use result output)))
  )
  (case? (or (== status (. ChatToolStatus running)) (== status (. ChatToolStatus behind)))
    "Waiting for output…"
  )
  (default
    "No output"
  )
)

(fn-expr _ chat-behind-text String
  (param count Size)
  (case? (== count 1)
    "1 in background"
  )
  (default
    (str count " in background")
  )
)

(fn-do + chat-worker-line (? String)
  (param parts (list AIMessagePart))
  (let index (. parts length))
  (while (> index 0)
    (-= index 1)
    (if (= (| (: text AITextPart)) ([] parts index))
      (let trimmed (call (. text text trim)))
      (if (> (. trimmed length) 0)
        (let ending (call (. trimmed find) "\n"))
        (return (if-expr (!= ending null) ([] trimmed (..< 0 ending)) trimmed))
      )
      (else-if (= (| (: reasoning AIReasoningPart)) ([] parts index))
        (let trimmed (call (. reasoning text trim)))
        (if (> (. trimmed length) 0)
          (let last (? String) null)
          (for (in line (call (. trimmed split) "\n"))
            (= last line)
          )
          (return (?? (call (?. last trim)) trimmed))
        )
      )
    )
  )
  (return null)
)
