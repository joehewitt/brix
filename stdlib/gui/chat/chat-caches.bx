(import /graphics/thumbnail-cache)
(import /gui/markdown)

(type + ChatBlockCaches
  (prop + thumbnails _ (= (call ThumbnailCache)))
  (prop _ caches _ (= (call (of Map String MarkdownBlockCache))))
  (fn-do + cache-for _
    (param key String)
    (let found ([] caches key))
    (return-if found (if found))
    (blank)
    (let cache (call MarkdownBlockCache))
    (= ([] caches key) cache)
    (return cache)
  )
  (fn-expr + is-filled _
    (param key String)
    (?? (?. ([] caches key) is-filled) false)
  )
)
