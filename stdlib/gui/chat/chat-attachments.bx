(import /ai)
(import /graphics/image)
(import /gui)
(import /math)
(import /os/file)
(import /os/path)
(import /stream/aggregate)
(blank)
(prop + chat-attachment-limits _ (= (call ChatImageLimits 1568 3750000)))

(type + ChatImageLimits (is Tuple)
  (prop + pixels I32)
  (prop + bytes Size)
)

(fn-do + chat-attachment AIImage (?! Error)
  (param entry ClipboardEntry)
  (param store AIImageStore)
  (param limits _ (= chat-attachment-limits))
  (let file (. entry path))
  (return-if (call chat-file-attachment file store limits) (if file))
  (blank)
  (let type (call (. entry conforming-type) clipboard-image-type))
  (let bytes (only-if (call (. entry read-data) type) (if type)))
  (throw (call IOError "The clipboard item holds no image") (if (not bytes)))
  (return (call chat-image-attachment bytes (!! type) store limits))
)

(fn-do + chat-file-attachment AIImage (?! Error)
  (param file Path)
  (param store AIImageStore)
  (param limits _ (= chat-attachment-limits))
  (let type (?? (call clipboard-path-type file) ""))
  (throw (call IOError (str (. file name) " is not an image")) (if (not (call clipboard-type-conforms type clipboard-image-type))))
  (return (call chat-image-attachment (call read-file-bytes file) type store limits))
)

(fn-expr + chat-takes-images Bool
  (param payload DragPayload)
  (case? (is payload ClipboardDrag)
    (call some (. (as payload ClipboardDrag) clipboard items) (:where (or (. each is-image) (. each is-promised-image))))
  )
  (default
    false
  )
)

(fn-do + chat-dropped-attachments (list AIImage)
  (param drag ClipboardDrag)
  (param store AIImageStore)
  (param limits _ (= chat-attachment-limits))
  (let items (. drag clipboard items))
  (let promised (call some items (:where (. each is-promised-image))))
  (let attached (call (of List AIImage)))
  (for (in item items)
    (if (and (. item is-image) (== (. item promised-type) null))
      (+=? attached (catch? (call chat-attachment item store limits)))
    )
  )
  (for (in file (if-expr promised (call (. drag receive-promised-files)) (call (of List Path))))
    (+=? attached (catch? (call chat-file-attachment file store limits)))
  )
  (return attached)
)

(fn-do _ chat-image-attachment AIImage (?! Error)
  (param bytes ([] Byte))
  (param type String)
  (param store AIImageStore)
  (param limits ChatImageLimits)
  (let decoded (use (call decode-image bytes 1 (. limits pixels))))
  (let width (as (. decoded pixel-width) Size))
  (let height (as (. decoded pixel-height) Size))
  (let format (call chat-attachment-format type))
  (let is-whole (< (call max width height) (as (. limits pixels) Size)))
  (return-if (call chat-kept store bytes format width height) (if (and format is-whole fits-limit)))
  (blank)
  (lazy fits-limit (<= (. bytes size) (. limits bytes)))
  (let is-photo
    (scope (or (call clipboard-type-conforms type "public.jpeg") is-heif)
      (lazy is-heif (call clipboard-type-conforms type "public.heif-standard"))
    )
  )
  (let png (only-if (call (. decoded canvas encode-png)) (if (not is-photo))))
  (return-if (call chat-kept store png ai-format-png width height) (if (and png (<= (. png size) (. limits bytes)))))
  (return (call chat-kept store (call (. decoded canvas encode-jpeg)) ai-format-jpeg width height))
)

(fn-do _ chat-kept AIImage (?! Error)
  (param store AIImageStore)
  (param bytes ([] Byte))
  (param format String)
  (param width Size)
  (param height Size)
  (return (call (. store attach) (call AIImage (call AIFile (call AIBytesSource bytes) format) width height)))
)

(fn-expr _ chat-attachment-format (? String)
  (param type String)
  (case? (call clipboard-type-conforms type "public.png")
    ai-format-png
  )
  (case? (call clipboard-type-conforms type "public.jpeg")
    ai-format-jpeg
  )
  (case? (call clipboard-type-conforms type "com.compuserve.gif")
    ai-format-gif
  )
  (case? (call clipboard-type-conforms type "org.webmproject.webp")
    ai-format-webp
  )
  (default
    null
  )
)
