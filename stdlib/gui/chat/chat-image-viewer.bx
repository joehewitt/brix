(import ./chat-parts)
(import /ai)
(import /graphics/color)
(import /graphics/image)
(import /graphics/primitives)
(import /graphics/text)
(import /gui)
(import /gui/icons/lucide/x)
(import /ui/input)
(blank)
(prop _ chat-viewer-margin Length (= 56))

(style-extend GUIDefaultTheme
  (rule chat-viewer-text
    (= color (call RGBA "#ffffffb3"))
    (= font-size gui-callout-font-size)
    (= text-wrap (. TextWrap no-wrap))
  )
  (blank)
  (rule chat-viewer-close
    (= color (call RGBA "#ffffffcc"))
    (blank)
    (when-style #is-hover-within
      (= background-color (call RGBA "#ffffff26"))
      (= color (call RGBA "#ffffff"))
    )
    (blank)
    (when-style #is-press-within
      (= background-color (call RGBA "#ffffff40"))
    )
  )
)

(type + ChatImageViewer (is Popup)
  (prop + images (? AIImageStore))
  (prop + pictures (list AIImage))
  (prop + index Size)
  (prop + shown (? Image))
  (prop + before (? Image))
  (prop + after (? Image))
  (prop + is-missing _ (= false))
  (blank)
  (prop _ loaded _ (= (call (of Map Size Image))))
  (prop _ serial Size)
  (blank)
  (rule This (• flex-col) (• fill-window)
    (= focus-mode (. FocusMode keys))
    (= background-color (call RGBA "#000000d9"))
    (= popup-focus (. PopupFocus first))
    (= deactivate-dismiss false)
  )
  (content
    (<> This
      (<> ImageZoomView (id: view) (• flex 1)
        (= image #shown)
        (= previous-x #before)
        (= next-x #after)
        (= fit-insets
          (call Insets
            (block
              (arg chat-viewer-margin)
              (arg chat-viewer-margin)
              (arg chat-viewer-margin)
              (arg chat-viewer-margin)
            )
          )
        )
      )
      (if #is-missing
        (<> Label (• chat-viewer-text) (• absolute)
          (= anchor (. Anchor parent))
          (= top (call (. PositionOffset coord) chat-viewer-margin))
          (= align-x (. Alignment center))
          (= text "Image unavailable")
        )
      )
      (<> Box (• absolute) (• flex-row) (• items-center)
        (= anchor (. Anchor parent))
        (= top (call (. PositionOffset coord) 14))
        (= right (call (. PositionOffset coord) 14))
        (if (> (. #pictures length) 1)
          (<> Label (• chat-viewer-text) (• mr 10)
            (= text (str (+ #index 1) " of " (. #pictures length)))
          )
        )
        (<> IconButton (id: close-button) (• chat-viewer-close) (• icon-x) (• w 30) (• h 30))
      )
    )
  )
  (subscribe-for (on event (. close-button click))
    (call dismiss)
    (call (. event cancel))
  )
  (subscribe-for (on event click)
    (let rect (. view image-rect))
    (if (or (not rect) (not (call (. rect contains) (call (. view point-in-box) (. event root-point)))))
      (call dismiss)
      (call (. event cancel))
    )
  )
  (subscribe-for (on event key-press)
    (if (== (. event key) (. Key arrow-left))
      (call step -1)
      (call (. event cancel))
      (else-if (== (. event key) (. Key arrow-right))
        (call step 1)
        (call (. event cancel))
      )
    )
  )
  (subscribe-for (on event (. view swiped))
    (if (== (. event axis) (. Orientation horizontal))
      (= index (as (+ (as index Int) (. event step)) Size))
      (call settle)
    )
  )
  (subscribe-for (on _ dismissed (when arrival))
    (+= serial 1)
    (call release-all)
  )
  (fn-do + present _
    (param shown-pictures (list AIImage))
    (param start Size)
    (call release-all)
    (= pictures shown-pictures)
    (= index (if-expr (< start (. shown-pictures length)) start 0))
    (call show)
    (call (. view fit))
    (call settle)
  )
  (fn-do + step _
    (param offset Int)
    (let next (+ (as index Int) offset))
    (return-if (if (or (< next 0) (>= next (as (. pictures length) Int)))))
    (blank)
    (= index (as next Size))
    (call (. view fit))
    (call settle)
  )
  (fn-do _ settle _
    (+= serial 1)
    (= is-missing false)
    (call refresh)
    (do-new
      (inline (call fill serial))
    )
  )
  (fn-do _ refresh _
    (= shown ([] loaded index))
    (= before (only-if ([] loaded (- index 1)) (if (> index 0))))
    (= after ([] loaded (+ index 1)))
  )
  (fn-do _ fill _
    (param wanted Size)
    (for (in offset (list 0 1 -1))
      (return-if (if (!= wanted serial)))
      (blank)
      (let at (+ (as index Int) offset))
      (if (and (>= at 0) (< at (as (. pictures length) Int)) (not ([] loaded at)))
        (let slot (as at Size))
        (let made (call load-picture ([] pictures slot)))
        (if (or (!= wanted serial) ([] loaded slot))
          (call (?. made release))
          (return)
        )
        (if made
          (= ([] loaded slot) made)
          (call refresh)
          (else-if (== slot index)
            (= is-missing true)
          )
        )
      )
    )
    (call prune)
  )
  (fn-do _ load-picture (? Image)
    (param picture AIImage)
    (let path (call chat-image-path picture images))
    (return-if null (if (not path)))
    (return (catch? (call load-image path)))
  )
  (fn-do _ prune _
    (let far (call (of List Size)))
    (for (in (tuple key image) loaded)
      (if (or (< (+ key 1) index) (> key (+ index 1)))
        (call (. image release))
        (+= far key)
      )
    )
    (for (in key far)
      (-= ([] loaded key))
    )
  )
  (fn-do _ release-all _
    (for (in (tuple _ image) loaded)
      (call (. image release))
    )
    (call (. loaded clear))
    (= shown null)
    (= before null)
    (= after null)
    (= is-missing false)
  )
)

(fn-do + chat-viewer-pictures (list AIImage)
  (param messages (list AIChatMessage))
  (let found (call (of List AIImage)))
  (for (in message messages)
    (for (in part (. message parts))
      (if (= (| (: image AIImagePart)) part)
        (+= found (. image image))
      )
    )
  )
  (return found)
)
