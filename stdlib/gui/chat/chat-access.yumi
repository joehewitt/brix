./chat-theme
/ai
/gui

━━━━━━━━━━━━━━━━━━━━
+ ChatAccessCard is Box

+ service AIChatService
+ access AIAccess

────────────────────

<This • chat-access flex-col px:20 pt:16 pb:16
    <Label • chat-access-title h:22
        text = "Connect ${#service.title}"
    <Text • chat-access-text mt:6
        <Span
            text = chat-access-message(#service, #access, #access.#account, #access.#is-checking)
    if #access.#problem != null
        <Text • chat-error chat-access-text mt:8
            <Span
                text = #access.#problem ?? ""
    if #access.kind == AIAccessKind.api-key
        <ChatAccessKeyPrompt • mt:14
            access = #access
    else if #access.#account != null || !#access.#is-checking
        <Box • flex-row mt:14
            <Box • flex:1
            <Button
                title = chat-access-action(#access, #access.#account)
                role = ButtonRole.default
                is-enabled = !#access.#is-checking
                action = => do act()

────────────────────
whenever #access

inspect(false)

────────────────────
+ do mounted

super.mounted()
inspect(false)

────────────────────
_ do act

if ai-access-can-approve(access.account)
    access.approve()
else
    inspect(true)

────────────────────
_ do inspect
    - is-forced Bool

=? if access.kind != AIAccessKind.approval || access.is-checking
=? if !is-forced && access.account != null
do new access.check(service.provider)

━━━━━━━━━━━━━━━━━━━━
+ ChatAccessRequest is Box

+ access AIAccess

────────────────────

<This • chat-access flex-col px:20 pt:16 pb:16
    <Label • chat-access-title h:22
        text = "${#access.name} API Key Needed"
    <Text • chat-access-text mt:6
        <Span
            text = chat-access-request(#access, #access.#asking)
    if #access.#problem != null
        <Text • chat-error chat-access-text mt:8
            <Span
                text = #access.#problem ?? ""
    <ChatAccessKeyPrompt • mt:14
        access = #access
        can-decline = true
        for _ on declined
            access.decline()

━━━━━━━━━━━━━━━━━━━━
+ ChatAccessKeyPrompt is Box

+ access AIAccess
+ can-decline = false
+ shows-key-entry = false
+ event declined Bool

────────────────────

<This • flex-col
    if #access.has-found-key && !#shows-key-entry
        <Box • flex-row
            <Box • flex:1
            if #can-decline
                <Button • mr:8
                    title = "Cancel"
                    role = ButtonRole.cancel
                    action = => do decline()
            <Button
                title = "Use Another Key"
                action = => do enter-another()
            <Button • ml:8
                title = "Use ${#access.variable ?? "Found Key"}"
                role = ButtonRole.default
                action = => do access.approve()
    else
        <ChatAccessKeyEntry
            access = #access
            can-cancel = #access.has-found-key || #can-decline
            focuses = #shows-key-entry || #can-decline
            for _ on dismissed
                leave-entry()

────────────────────
whenever #access

shows-key-entry = false

────────────────────
_ do enter-another

shows-key-entry = true

────────────────────
_ do leave-entry

if access.has-found-key
    shows-key-entry = false
else
    decline()

────────────────────
_ do decline

declined <- true

━━━━━━━━━━━━━━━━━━━━
+ ChatAccessKeyEntry is Box

+ access AIAccess
+ can-cancel = false
+ focuses = false
+ event dismissed Bool

────────────────────

<This • flex-row
    <TextInput key-field • chat-access-field flex:1
        placeholder = "${#access.name} API key"
        is-secure = true
        for event on submit
            access.enter(event.text)
            event.cancel()
    if #can-cancel
        <Button • ml:8
            title = "Cancel"
            role = ButtonRole.cancel
            action = => do dismiss()
    <Button • ml:8
        title = "Save Key"
        role = ButtonRole.default
        action = => do access.enter(key-field.text)

────────────────────
+ do mounted

super.mounted()
if focuses
    . ignored = key-field.request-focus()

────────────────────
_ do dismiss

dismissed <- true

━━━━━━━━━━━━━━━━━━━━
_ chat-access-action String
    - access AIAccess
    - account AIAccount?

if ai-access-can-approve(account) then "Use ${access.name}" else "Check Again"

━━━━━━━━━━━━━━━━━━━━
_ chat-access-message String
    - service AIChatService
    - access AIAccess
    - account AIAccount?
    - is-checking Bool

|? access.kind == AIAccessKind.api-key && access.has-found-key
    "Found your ${access.name} API key in the ${access.variable ?? ""} environment variable. Use it to chat with ${service.title}, or use another key. Usage is billed to the key's ${access.name} account."
|? access.kind == AIAccessKind.api-key
    "Paste your ${access.name} API key to chat with ${service.title}. Usage is billed to that ${access.name} account, and the key is kept only on this Mac."
??
    match account
        |= null
            if is-checking then "Checking your ${access.name} sign-in…" else no-account
        | known AIAccount
            chat-access-status(service, access, known)

.. no-account = "${access.name} did not report an account."

━━━━━━━━━━━━━━━━━━━━
_ chat-access-request String
    - access AIAccess
    - asking String?

|? access.has-found-key
    "${lead}Found your ${access.name} API key in the ${access.variable ?? ""} environment variable. Use it, or use another key. Usage is billed to the key's ${access.name} account."
??
    "${lead}Paste your ${access.name} API key. Usage is billed to that ${access.name} account, and the key is kept only on this Mac."

.. lead = if asking then "$asking " else ""

━━━━━━━━━━━━━━━━━━━━
_ chat-access-status String
    - service AIChatService
    - access AIAccess
    - account AIAccount

match account.status
    | AIAccountStatus.missing
        "$name is not installed on this Mac."
    | AIAccountStatus.signed-out
        "$name is not signed in. To connect, $sign-in in Terminal, then check again."
    | AIAccountStatus.signed-in
        |? account.billing == AIAccountBilling.api
            "$name is $who with an API key, which bills per use instead of your subscription. To use your subscription, $sign-in in Terminal, then check again."
        ??
            "${service.title} chats will run $name on this Mac, $who. Usage counts toward your subscription$plan. This app never sees your password or tokens."

.. name = access.name
.. who = if account.email then "signed in as ${account.email}" else "signed in"
.. plan = if account.plan then " (${account.plan})" else ""
.. sign-in = if access.sign-in then "run `${access.sign-in}`" else "sign in to ${access.name}"
