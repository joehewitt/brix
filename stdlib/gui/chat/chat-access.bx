(import ./chat-theme)
(import /ai)
(import /gui)

(type + ChatAccessCard (is Box)
  (prop + service AIChatService)
  (prop + access AIAccess)
  (content
    (<> This (• chat-access) (• flex-col) (• px 20) (• pt 16) (• pb 16)
      (<> Label (• chat-access-title) (• h 22)
        (= text (str "Connect " (. #service title)))
      )
      (<> Text (• chat-access-text) (• mt 6)
        (<> Span
          (= text (call chat-access-message #service #access (. #access #account) (. #access #is-checking)))
        )
      )
      (if (!= (. #access #problem) null)
        (<> Text (• chat-error) (• chat-access-text) (• mt 8)
          (<> Span
            (= text (?? (. #access #problem) ""))
          )
        )
      )
      (if (== (. #access kind) (. AIAccessKind api-key))
        (<> ChatAccessKeyPrompt (• mt 14)
          (= access #access)
        )
        (else-if (or (!= (. #access #account) null) (not (. #access #is-checking)))
          (<> Box (• flex-row) (• mt 14)
            (<> Box (• flex 1))
            (<> Button
              (= title (call chat-access-action #access (. #access #account)))
              (= role (. ButtonRole default))
              (= is-enabled (not (. #access #is-checking)))
              (= action (=> () :do (call act)))
            )
          )
        )
      )
    )
  )
  (whenever-rule #access
    (call inspect false)
  )
  (fn-do + mounted _
    (call (. super mounted))
    (call inspect false)
  )
  (fn-do _ act _
    (if (call ai-access-can-approve (. access account))
      (call (. access approve))
      (else
        (call inspect true)
      )
    )
  )
  (fn-do _ inspect _
    (param is-forced Bool)
    (return-if (if (or (!= (. access kind) (. AIAccessKind approval)) (. access is-checking))))
    (return-if (if (and (not is-forced) (!= (. access account) null))))
    (blank)
    (do-new @detached
      (call (. access check) (. service provider))
    )
  )
)

(type + ChatAccessRequest (is Box)
  (prop + access AIAccess)
  (content
    (<> This (• chat-access) (• flex-col) (• px 20) (• pt 16) (• pb 16)
      (<> Label (• chat-access-title) (• h 22)
        (= text (str (. #access name) " API Key Needed"))
      )
      (<> Text (• chat-access-text) (• mt 6)
        (<> Span
          (= text (call chat-access-request #access (. #access #asking)))
        )
      )
      (if (!= (. #access #problem) null)
        (<> Text (• chat-error) (• chat-access-text) (• mt 8)
          (<> Span
            (= text (?? (. #access #problem) ""))
          )
        )
      )
      (<> ChatAccessKeyPrompt (• mt 14)
        (= access #access)
        (= can-decline true)
        (for (on _ declined)
          (call (. access decline))
        )
      )
    )
  )
)

(type + ChatAccessKeyPrompt (is Box)
  (prop + access AIAccess)
  (prop + can-decline _ (= false))
  (prop + shows-key-entry _ (= false))
  (event + declined Bool)
  (content
    (<> This (• flex-col)
      (if (and (. #access has-found-key) (not #shows-key-entry))
        (<> Box (• flex-row)
          (<> Box (• flex 1))
          (if #can-decline
            (<> Button (• mr 8)
              (= title "Cancel")
              (= role (. ButtonRole cancel))
              (= action (=> () :do (call decline)))
            )
          )
          (<> Button
            (= title "Use Another Key")
            (= action (=> () :do (call enter-another)))
          )
          (<> Button (• ml 8)
            (= title (str "Use " (?? (. #access variable) "Found Key")))
            (= role (. ButtonRole default))
            (= action (=> () :do (call (. access approve))))
          )
        )
        (else
          (<> ChatAccessKeyEntry
            (= access #access)
            (= can-cancel (or (. #access has-found-key) #can-decline))
            (= focuses (or #shows-key-entry #can-decline))
            (for (on _ dismissed)
              (call leave-entry)
            )
          )
        )
      )
    )
  )
  (whenever-rule #access
    (= shows-key-entry false)
  )
  (fn-do _ enter-another _
    (= shows-key-entry true)
  )
  (fn-do _ leave-entry _
    (if (. access has-found-key)
      (= shows-key-entry false)
      (else
        (call decline)
      )
    )
  )
  (fn-do _ decline _
    (<- declined true)
  )
)

(type + ChatAccessKeyEntry (is Box)
  (prop + access AIAccess)
  (prop + can-cancel _ (= false))
  (prop + focuses _ (= false))
  (event + dismissed Bool)
  (content
    (<> This (• flex-row)
      (<> TextInput (id: key-field) (• chat-access-field) (• flex 1)
        (= placeholder (str (. #access name) " API key"))
        (= is-secure true)
        (for (on event submit)
          (call (. access enter) (. event text))
          (call (. event cancel))
        )
      )
      (if #can-cancel
        (<> Button (• ml 8)
          (= title "Cancel")
          (= role (. ButtonRole cancel))
          (= action (=> () :do (call dismiss)))
        )
      )
      (<> Button (• ml 8)
        (= title "Save Key")
        (= role (. ButtonRole default))
        (= action (=> () :do (call (. access enter) (. key-field text))))
      )
    )
  )
  (fn-do + mounted _
    (call (. super mounted))
    (if focuses
      (let ignored (call (. key-field request-focus)))
    )
  )
  (fn-do _ dismiss _
    (<- dismissed true)
  )
)

(fn-expr _ chat-access-action String
  (param access AIAccess)
  (param account (? AIAccount))
  (if-expr (call ai-access-can-approve account) (str "Use " (. access name)) "Check Again")
)

(fn-expr _ chat-access-message String
  (param service AIChatService)
  (param access AIAccess)
  (param account (? AIAccount))
  (param is-checking Bool)
  (case? (and (== (. access kind) (. AIAccessKind api-key)) (. access has-found-key))
    (str "Found your " (. access name) " API key in the " (?? (. access variable) "") " environment variable. Use it to chat with " (. service title) ", or use another key. Usage is billed to the key's " (. access name) " account.")
  )
  (case? (== (. access kind) (. AIAccessKind api-key))
    (str "Paste your " (. access name) " API key to chat with " (. service title) ". Usage is billed to that " (. access name) " account, and the key is kept only on this Mac.")
  )
  (default
    (match account
      (case= null
        (if-expr is-checking (str "Checking your " (. access name) " sign-in…") no-account)
      )
      (case (: known AIAccount)
        (call chat-access-status service access known)
      )
    )
  )
  (where
    (lazy no-account (str (. access name) " did not report an account."))
  )
)

(fn-expr _ chat-access-request String
  (param access AIAccess)
  (param asking (? String))
  (case? (. access has-found-key)
    (str lead "Found your " (. access name) " API key in the " (?? (. access variable) "") " environment variable. Use it, or use another key. Usage is billed to the key's " (. access name) " account.")
  )
  (default
    (str lead "Paste your " (. access name) " API key. Usage is billed to that " (. access name) " account, and the key is kept only on this Mac.")
  )
  (where
    (lazy lead (if-expr asking (str asking " ") ""))
  )
)

(fn-expr _ chat-access-status String
  (param service AIChatService)
  (param access AIAccess)
  (param account AIAccount)
  (match (. account status)
    (case (. AIAccountStatus missing)
      (str name " is not installed on this Mac.")
    )
    (case (. AIAccountStatus signed-out)
      (str name " is not signed in. To connect, " sign-in " in Terminal, then check again.")
    )
    (case (. AIAccountStatus signed-in)
      (case? (== (. account billing) (. AIAccountBilling api))
        (str name " is " who " with an API key, which bills per use instead of your subscription. To use your subscription, " sign-in " in Terminal, then check again.")
      )
      (default
        (str (. service title) " chats will run " name " on this Mac, " who ". Usage counts toward your subscription" plan ". This app never sees your password or tokens.")
      )
    )
  )
  (where
    (lazy name (. access name))
    (lazy who (if-expr (. account email) (str "signed in as " (. account email)) "signed in"))
    (lazy plan (if-expr (. account plan) (str " (" (. account plan) ")") ""))
    (lazy sign-in (if-expr (. access sign-in) (str "run `" (. access sign-in) "`") (str "sign in to " (. access name))))
  )
)
