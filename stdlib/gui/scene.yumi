────────────────────
+ do rect
    - rect Rect

if shape-fill
    begin()
    rect-path(rect)
    end(true)
    =
=? if !chunk
. current = chunk
. shape = root-clip-shape
if shape
    if fill-color && !fill-paint && !stroke-color && rect.contains(shape.extent, 0.01)
        record-outline-fill(shape)
        =
    promote-root-clip()
recorded-commands += display-shape-command(DisplayCommandKind.rect, rect, this)
. styled = stroke-color && (stroke-dash > 0 || stroke-join != LineJoin.miter || stroke-brush)
. painted = fill-color && fill-paint
if styled || painted || ((fill-color || stroke-color) && !translates)
    record-styled
        - DisplayStyledShape.rect
        - rect
        - display-stroke-ink(rect, this)
        - 0
        - 0
        - 0
        - false
        - FillRule.nonzero
        - null
        - null
        - null
        - null
        - fill-paint
        - stroke-brush
    =
contain-root-clip(if stroke-color then rect.inflate(stroke-width) else rect)
if fill-color
    . quad = current.add-item
        - display-item(DisplayItemKind.quad, rect, 0, pack-rgba8(fill-color!))
        - if current-state == 0 then root-ink(rect) else rect
        - current-state
    current.set-item-color(quad, fill-color!)
    current.set-item-exact(quad, rect, 0)
if stroke-color
    . ink = rect.inflate(stroke-width)
    if root-clip-active
        ink = ink.intersection(clip-rect)
    . border = current.add-item
        - display-item(DisplayItemKind.border, rect, stroke-width, pack-rgba8(stroke-color!))
        - ink
        - current-state
    current.set-item-color(border, stroke-color!)
    current.set-item-exact(border, rect, stroke-width)

