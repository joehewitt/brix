    =

is-replaying = true
do finally is-replaying = false
expand-damage(false)
. clip = align-damage-to-device(damage)
. local = Rect(clip.x - origin.x, clip.y - origin.y, clip.width, clip.height)
. is-full-surface = local.x <= 0 && local.y <= 0
is-full-surface = is-full-surface && local.right >= renderer.width
is-full-surface = is-full-surface && local.bottom >= renderer.height
