_ do display-entry-index Index?
    - members [DisplayEntry]
    - target DisplayEntry

. index Size
while index < members.length
    . entry = members[index]
    . same-chunk = entry.chunk as Pointer? == target.chunk as Pointer?
    =? index if same-chunk && entry.group as Pointer? == target.group as Pointer?
    index += 1

━━━━━━━━━━━━━━━━━━━━
_ display-sprite-scale-step I64
    - scale F64

ceil(log(max(scale, 0.0625)) / display-sprite-step) as I64

━━━━━━━━━━━━━━━━━━━━
_ display-frame-align Size
    - offset Size

((offset + 15) / 16) * 16

━━━━━━━━━━━━━━━━━━━━
_ do frame-path-fits Bool
    - verbs CPointer'U8
    - verb-count Size
    - coord-count Size
    - start U32
    - count U32
    - coord-start U32

. first = start as Size
. length = count as Size
=? false if first > verb-count || length > verb-count - first
. needed Size
for index in first .. < first + length
    . verb = verbs[index]
    if verb == DisplayPathVerb.move || verb == DisplayPathVerb.line
        needed += 2
    else if verb == DisplayPathVerb.curve
        needed += 6
    else if verb != DisplayPathVerb.enclose
        = false
. coord = coord-start as Size
= coord <= coord-count && needed <= coord-count - coord

━━━━━━━━━━━━━━━━━━━━
_ do frame-style-usable Bool
    - wire DisplayPathStyleWire
    - usable [Bool]
    - gradients CPointer'DisplayGradientWire

if wire.gradient != 0
    . slot = (wire.gradient - 1) as Size
    =? false if slot >= usable.length || !usable[slot]
    =? false if gradients[slot].kind == display-gradient-brush
if wire.brush != 0
    . slot = (wire.brush - 1) as Size
    =? false if slot >= usable.length || !usable[slot]
    =? false if gradients[slot].kind != display-gradient-brush
= true

━━━━━━━━━━━━━━━━━━━━
_ do frame-arguments [F64]
    - frame DisplayFrame
    - start U32
    - count U32

. source = frame.table(.args) as CPointer'F64
. values [F64]
for index in 0 .. < (count as Size)
    values += source[(start as Size) + index]
= values

━━━━━━━━━━━━━━━━━━━━
_ do frame-gradient Gradient
    - frame DisplayFrame
    - wire DisplayGradientWire

. source = frame.table(.stops) as CPointer'GradientStop
. stops [GradientStop]
for index in 0 .. < (wire.stop-count as Size)
    stops += source[(wire.stop-start as Size) + index]
= match wire.kind
    |= display-gradient-radial
        RadialGradient(wire.start, wire.start-radius, wire.end, wire.end-radius, stops)
    |= display-gradient-conic
        ConicGradient(wire.start, wire.start-radius, stops)
    ??
        LinearGradient(wire.start, wire.end, stops)

━━━━━━━━━━━━━━━━━━━━
_ do display-frame-style DisplayPathStyle
    - wire DisplayPathStyleWire
    - frame DisplayFrame
    - shaders [U32 = Shader]

. flags = wire.paint
. fill RGBA? = wire.fill if (flags /and/ 1) != 0
. stroke RGBA? = wire.stroke if (flags /and/ 2) != 0
. gradient Gradient?
. shadow Shadow?
. shader Shader?
. shader-args [F64]?
. paint Paint?
. brush Brush?
. gradients = frame.table(.gradients) as CPointer'DisplayGradientWire
if wire.gradient != 0
    . source = gradients[(wire.gradient - 1) as Size]
    if source.kind == display-gradient-paint
        paint = Paint
            - shaders[source.shader]!
            - frame-arguments(frame, source.stop-start, source.stop-count)
        fill = RGBA(source.start.x, source.start.y, source.end.x, source.end.y)
    else if source.kind == display-gradient-shader
        shader = shaders[source.shader]
        shader-args = frame-arguments(frame, source.stop-start, source.stop-count)
        fill = null
        stroke = null
    else
        gradient = frame-gradient(frame, source)
        fill = null
        stroke = null
if wire.brush != 0
    . source = gradients[(wire.brush - 1) as Size]
    . values = frame-arguments(frame, source.stop-start, source.stop-count)
    . extra [F64]
    for index in 12 .. < values.length
        extra += values[index]
    stroke = RGBA(source.start.x, source.start.y, source.end.x, source.end.y)
    brush = Brush
        - shaders[source.shader]!
        - extra
        - values[0]
        - values[1]
        - values[2]
        - values[3]
        - values[4]
        - values[5] if values[6] != 0
        - values[7]
        - values[8]
        - values[9]
        - values[10]
        - values[11]
if (flags /and/ 16) != 0
    shadow = Shadow(wire.fill, wire.shadow-blur, wire.shadow-x, wire.shadow-y)
= DisplayPathStyle
    - fill
    - stroke
    - wire.stroke-width
    - display-frame-cap(wire.stroke-style /and/ 15)
    - display-frame-join((wire.stroke-style /rshift/ 4) /and/ 15)
    - wire.dash
    - if (flags /and/ 8) != 0 then FillRule.even-odd else FillRule.nonzero
    - (flags /and/ 4) != 0
    - gradient
    - shadow
    - shader
    - shader-args
    - paint
    - brush

━━━━━━━━━━━━━━━━━━━━
_ display-frame-cap LineCap
    - code U32

|? LineCap.round if code == 1
|? LineCap.square if code == 2
?? LineCap.butt

━━━━━━━━━━━━━━━━━━━━
_ display-frame-join LineJoin
    - code U32

|? LineJoin.round if code == 1
|? LineJoin.bevel if code == 2
?? LineJoin.miter

━━━━━━━━━━━━━━━━━━━━
_ display-item
    - kind U8
    - rect Rect
    - value F64
    - data0 U32
    - data1 U32 = 0
    - data2 U32 = 0
    - data3 U32 = 0

DisplayItem
    - kind
    - 0
    - 0
    - rect.x as F32
    - rect.y as F32
    - rect.width as F32
    - rect.height as F32
    - value as F32
    - data0
    - data1
    - data2
    - data3

━━━━━━━━━━━━━━━━━━━━
_ display-shape
    - shape Outline
    - shadow Shadow?

DisplayShape
    - shape.effective-radius as F32
    - outline-side-code(shape.arrow) as F32
    - (shape.arrow?.offset ?? 0) as F32
    - (shape.arrow?.size ?? 0) as F32
    - (shadow?.blur ?? 0) as F32
    - (shadow?.x ?? 0) as F32
    - (shadow?.y ?? 0) as F32
    - (shadow?.spread ?? 0) as F32

━━━━━━━━━━━━━━━━━━━━
_ display-shape-outline
    - rect Rect
    - shape DisplayShape

Outline(rect, shape.radius, arrow)

.. arrow = OutlineArrow(side, shape.offset, shape.size) if side
.. side = display-shape-side(shape.side)

━━━━━━━━━━━━━━━━━━━━
_ display-command-outline
    - command DisplayCommand

Outline(command.rect, command.point1.x, arrow)

.. arrow = OutlineArrow(side, command.point2.x, command.point2.y) if side
.. side = display-shape-side(command.point1.y)

━━━━━━━━━━━━━━━━━━━━
_ display-outline-within
    - inner Outline
    - outer Outline

outer.bounds.contains(inner.bounds, 0.01) && arrows && corners

.. arrows = display-points-near(display-arrow-tip(inner), display-arrow-tip(outer))
.. corners = rounded || straight.contains(inner.bounds, 0.01)
.. straight = outer.bounds.pad(outer.effective-radius)
.. rounded = inner.effective-radius >= outer.effective-radius - 0.01

━━━━━━━━━━━━━━━━━━━━
_ display-outline-inset
    - inner Outline
    - outer Outline
    - amount Length

bounds && radius && arrows

.. bounds = display-rects-near(inner.bounds.pad(-amount), outer.bounds)
.. radius = abs(inner.effective-radius - max(0, outer.effective-radius - amount)) < 0.01
.. arrows = inner.arrow?.side == outer.arrow?.side && abs(inner-offset - outer-offset) < 0.01
.. inner-offset = (inner.arrow?.offset ?? 0) + (if inner.arrow then amount else 0)
.. outer-offset = outer.arrow?.offset ?? 0

━━━━━━━━━━━━━━━━━━━━
_ display-rects-near
    - a Rect
    - b Rect

abs(a.x - b.x) < 0.01 && abs(a.y - b.y) < 0.01 && sizes

.. sizes = abs(a.width - b.width) < 0.01 && abs(a.height - b.height) < 0.01

━━━━━━━━━━━━━━━━━━━━
_ display-points-near
    - a Point?
    - b Point?

(!a && !b) || (a != null && b != null && abs(a.x - b.x) < 0.01 && abs(a.y - b.y) < 0.01)

━━━━━━━━━━━━━━━━━━━━
_ display-arrow-tip
    - shape Outline

match? shape.arrow?.side
    |= Side.top
        Point(shape.bounds.x + shape.arrow-tip, shape.bounds.y - size)
    |= Side.bottom
        Point(shape.bounds.x + shape.arrow-tip, shape.bounds.bottom + size)
    |= Side.left
        Point(shape.bounds.x - size, shape.bounds.y + shape.arrow-tip)
    |= Side.right
        Point(shape.bounds.right + size, shape.bounds.y + shape.arrow-tip)

.. size = shape.arrow?.size ?? 0

━━━━━━━━━━━━━━━━━━━━
_ display-shape-side
    - code F64

match? code
    |= 0
        Side.top
    |= 1
        Side.bottom
    |= 2
        Side.left
    |= 3
        Side.right

━━━━━━━━━━━━━━━━━━━━
_ display-item-rect
    - item DisplayItem

Rect(item.x as F64, item.y as F64, item.width as F64, item.height as F64)

━━━━━━━━━━━━━━━━━━━━
_ display-path-paint
    - has-fill Bool
    - has-stroke Bool
    - closed Bool
    - fill-rule FillRule
    - has-shadow Bool = false

fill /or/ stroke /or/ enclosed /or/ even-odd /or/ shadowed

.. fill = if has-fill then 1u32 else 0u32
.. stroke = if has-stroke then 2u32 else 0u32
.. enclosed = if closed then 4u32 else 0u32
.. even-odd = if fill-rule == FillRule.even-odd then 8u32 else 0u32
.. shadowed = if has-shadow then 16u32 else 0u32

━━━━━━━━━━━━━━━━━━━━
_ display-stroke-style
    - cap LineCap
    - join LineJoin

cap-code /or/ (join-code /lshift/ 4)

.. cap-code = line-cap-code(cap) as U32
.. join-code = line-join-code(join) as U32

━━━━━━━━━━━━━━━━━━━━
_ do display-shape-command DisplayCommand
    - kind U8
    - rect Rect
    - canvas Canvas

. command = DisplayCommand
    - kind
    - rect
    - Point(0, 0)
    - Point(0, 0)
    - Point(0, 0)
    - Matrix()
    - canvas.fill-color
    - canvas.stroke-color
    - canvas.stroke-width
    - canvas.stroke-cap
    - canvas.stroke-join
command = command.stroke-dash = canvas.stroke-dash
= command

━━━━━━━━━━━━━━━━━━━━
_ display-stroke-ink
    - rect Rect
    - canvas Canvas

|? !canvas.stroke-color
    rect
??
    rect.inflate(max(reach, scattered))

.. reach = if mitered then canvas.stroke-width * 5 else canvas.stroke-width
.. mitered = canvas.stroke-join == LineJoin.miter
.. brush = canvas.stroke-brush
.. scattered =
    |? brush
        canvas.stroke-width * (0.5 * (1 + abs(brush.size-jitter)) + 1.2 * abs(brush.scatter)) + 1
    ??
        0.0

━━━━━━━━━━━━━━━━━━━━
_ display-outline-state
    - parent U32
    - kind U8
    - shape Outline

DisplayState
    - parent
    - kind
    - Matrix()
    - shape.bounds
    - shape.radius
    - outline-side-code(shape.arrow) as F64
    - shape.arrow?.offset ?? 0
    - shape.arrow?.size ?? 0

━━━━━━━━━━━━━━━━━━━━
_ display-outline-clip-command
    - shape Outline

DisplayCommand
    - DisplayCommandKind.clip-outline
    - shape.bounds
    - Point(shape.radius, outline-side-code(shape.arrow) as Coord)
    - Point(shape.arrow?.offset ?? 0, shape.arrow?.size ?? 0)

━━━━━━━━━━━━━━━━━━━━
_ display-clipped-ink
    - rect Rect
    - clip Rect
    - has-clip Bool

if has-clip then rect.intersection(clip) else rect

━━━━━━━━━━━━━━━━━━━━
_ display-alignment-code U16
    - alignment TextAlignment

match alignment
    |= TextAlignment.center
        1
    |= TextAlignment.right
        2
    ??
        0

━━━━━━━━━━━━━━━━━━━━
_ display-alignment
    - code U16

match code
    |= 1
        TextAlignment.center
    |= 2
        TextAlignment.right
    ??
        TextAlignment.left

━━━━━━━━━━━━━━━━━━━━
_ do next-display-record-generation

display-record-generation += 1
if !display-record-generation
    display-record-generation = 1
= display-record-generation

━━━━━━━━━━━━━━━━━━━━
_ do next-display-scene-generation

display-scene-generation += 1
if !display-scene-generation
    display-scene-generation = 1
= display-scene-generation

━━━━━━━━━━━━━━━━━━━━
_ display-damage-areas-join Bool
    - first Rect
    - second Rect

display-rects-overlap(first.inflate(2), second) || display-damage-join-growth(first, second) <= 0

━━━━━━━━━━━━━━━━━━━━
_ display-damage-join-growth F64
    - first Rect
    - second Rect

joined.width * joined.height - (first.width * first.height + second.width * second.height) * 1.25

.. joined = first + second

━━━━━━━━━━━━━━━━━━━━
_ do display-chunk-path-clip U32
    - chunk DisplayChunk

. side = chunk.side
=? 0 if !side
for index in 1 .. < side.states.length
    =? index as U32 if side.states[index].kind == DisplayStateKind.clip-path
= 0

━━━━━━━━━━━━━━━━━━━━
_ display-coords-equal Bool
    - left [F64]
    - right [F64]

left == right

━━━━━━━━━━━━━━━━━━━━
_ display-chunk-is-empty
    - chunk DisplayChunk

if chunk.is-opaque then (chunk.commands?.length ?? 0) == 0 else chunk.items.length == 0

━━━━━━━━━━━━━━━━━━━━
_ display-box-is-dirty
    - box Box

paint-invalid || box.is-retained-presentation-invalid || below

.. below = box.is-retained-paint-invalid-below || box.$is-paint-invalid-below
.. paint-invalid = box.is-retained-paint-invalid || box.$is-paint-invalid

━━━━━━━━━━━━━━━━━━━━
_ display-box-needs-group
    - box Box

box.clips-content || box.is-composite-host || has-many-children

.. first = box.retained-rendered-first-child
.. has-many-children = first != null && box.retained-rendered-next-child(first) != null

━━━━━━━━━━━━━━━━━━━━
_ display-entry-bounds
    - entry DisplayEntry

|? chunk
    chunk.bounds
??
    group.outer

.. chunk = entry.chunk
.. group = entry.group!

━━━━━━━━━━━━━━━━━━━━
_ do display-detect-order
    - members [DisplayEntry]

. count Size
. first-top F64
. first-left F64
. highest-top F64
. highest-bottom F64
. highest-left F64
. highest-right F64
. top-lag F64
. bottom-lag F64
. left-lag F64
. right-lag F64
for entry in members
    . current = display-entry-bounds(entry)
    if current.is-empty
        continue
    if count > 0
        top-lag = max(top-lag, highest-top - current.top)
        bottom-lag = max(bottom-lag, highest-bottom - current.bottom)
        left-lag = max(left-lag, highest-left - current.left)
        right-lag = max(right-lag, highest-right - current.right)
        highest-top = max(highest-top, current.top)
        highest-bottom = max(highest-bottom, current.bottom)
        highest-left = max(highest-left, current.left)
        highest-right = max(highest-right, current.right)
    else
        first-top = current.top
        first-left = current.left
        highest-top = current.top
        highest-bottom = current.bottom
        highest-left = current.left
        highest-right = current.right
    count += 1
=? DisplayOrder(DisplayAxis.none, 0, 0) if count < 2
. vertical-score = highest-top - first-top - top-lag - bottom-lag
. horizontal-score = highest-left - first-left - left-lag - right-lag
=
    |? vertical-score <= 0 && horizontal-score <= 0
        DisplayOrder(DisplayAxis.none, 0, 0)
    |? vertical-score >= horizontal-score
        DisplayOrder(DisplayAxis.vertical, top-lag, bottom-lag)
    ??
        DisplayOrder(DisplayAxis.horizontal, left-lag, right-lag)

━━━━━━━━━━━━━━━━━━━━
_ display-order-before
    - order DisplayOrder
    - bounds Rect
    - damage Rect

|? order.axis == DisplayAxis.vertical
    bounds.bottom + order.end-lag <= damage.top
??
    bounds.right + order.end-lag <= damage.left

━━━━━━━━━━━━━━━━━━━━
_ display-order-stop
    - order DisplayOrder
    - damage Rect

|? order.axis == DisplayAxis.vertical
    damage.bottom + order.start-lag
??
    damage.right + order.start-lag

━━━━━━━━━━━━━━━━━━━━
_ display-state-outline
    - state DisplayState

Outline(state.rect, state.radius, arrow)

.. arrow = OutlineArrow(side, state.offset, state.size) if side
.. side = display-shape-side(state.side)

━━━━━━━━━━━━━━━━━━━━
_ display-item-culled
    - table DisplayChunkSide
    - state U32
    - ink Rect
    - damage Rect

|? ink.width < 0 || ink.height < 0
    false
|? state == 0
    !display-rects-overlap(ink, damage)
??
    match table.state-ink-bounds(state, ink)
        |= null
            true
        ??
            !display-rects-overlap(it, damage)

━━━━━━━━━━━━━━━━━━━━
_ display-pixel-rect
    - bounds Rect
    - scale F64

Rect(left, top, ceil(bounds.right - left), ceil(bounds.bottom - top))

.. left = floor(bounds.x * scale) / scale
.. top = floor(bounds.y * scale) / scale

━━━━━━━━━━━━━━━━━━━━
_ display-image-uses-texture
    - image RasterCanvas
    - sampling F32

|? sampling > 0 || image.color-space != ColorSpace.srgb || image.pixel-format != PixelFormat.rgba8
    true
??
    max(image.pixel-width, image.pixel-height) > display-texture-image-threshold

━━━━━━━━━━━━━━━━━━━━
_ display-image-scaled
    - image RasterCanvas
    - device-width F64
    - device-height F64

abs(device-width - image.pixel-width) > 0.5 || abs(device-height - image.pixel-height) > 0.5

━━━━━━━━━━━━━━━━━━━━
_ display-pattern-fits-texture
    - image RasterCanvas

image.pixel-width <= limit && image.pixel-height <= limit

.. limit = display-pattern-texture-limit

━━━━━━━━━━━━━━━━━━━━
_ display-matrix-is-axis-aligned
    - matrix Matrix

matrix.b == 0 && matrix.c == 0 && matrix.a > 0 && matrix.d > 0

━━━━━━━━━━━━━━━━━━━━
_ raster-cells RasterSpan
    - rect Rect
    - offset Point
    - scale F64

RasterSpan(left, top, right, bottom)

.. extent = (raster-tile-pixels as F64) / scale
.. left = floor((rect.left - offset.x) / extent) as I32
.. top = floor((rect.top - offset.y) / extent) as I32
.. right = ceil((rect.right - offset.x) / extent) as I32
.. bottom = ceil((rect.bottom - offset.y) / extent) as I32

━━━━━━━━━━━━━━━━━━━━
_ raster-key U64
    - chunk DisplayChunk
    - column I32
    - row I32
    - scale F64

address /xor/ (cell * 11400714819323198485)

.. address = ((chunk as Pointer).address as U64)
.. across = ((column + 32768) as U64) /and/ 65535
.. down = (((row + 32768) as U64) /and/ 65535) /lshift/ 16
.. density = ((round(scale * 64) as U64) /and/ 65535) /lshift/ 32
.. cell = across /or/ down /or/ density /or/ (1u64 /lshift/ 63)

━━━━━━━━━━━━━━━━━━━━
_ do raster-side-is-content Bool
    - side DisplayChunkSide

. under [Bool]
under += false
. index Size = 1
while index < side.states.length
    under += index == (side.content-state as Size) || under[side.states[index].parent]
    index += 1
= all(side.item-states) • where under[each]

━━━━━━━━━━━━━━━━━━━━
_ display-rects-overlap
    - left Rect
    - right Rect

|? left.right <= right.left || right.right <= left.left
    false
|? left.bottom <= right.top || right.bottom <= left.top
    false
??
    true

━━━━━━━━━━━━━━━━━━━━
_ display-box-needs-layer
    - box Box

box.computed-opacity < 1%% || box.has-layer-filters || box.painted-transform != null

━━━━━━━━━━━━━━━━━━━━
_ display-layer-cycle FrameCycle?
    - filter ShaderFilter

if !cycle || cycle.active-per-width != 0 then null else cycle

.. cycle = shader-cycle(filter.args, filter.arg-kinds)

━━━━━━━━━━━━━━━━━━━━
_ display-live-key U64
    - box Box
    - phase U8

(box as Pointer).address * 4 + phase

━━━━━━━━━━━━━━━━━━━━
_ display-matrices-equal
    - a Matrix?
    - b Matrix?

|? a == null || b == null
    a == null && b == null
??
    a == b

━━━━━━━━━━━━━━━━━━━━
_ do display-filters-equal Bool
    - a [ShaderFilter]
    - b [ShaderFilter]

=? false if a.length != b.length
for index in 0 .. < a.length
    . left = a[index]
    . right = b[index]
    =? false if left.shader.id != right.shader.id || left.args != right.args || images-differ || passes-differ
    .. images-differ = left.images != right.images
    .. passes-differ = left.resolution != right.resolution || left.keeps != right.keeps
= true
