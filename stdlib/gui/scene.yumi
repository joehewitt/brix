        - tile-damage.height / device-scale

. damaged-pixels = if is-split then split-damaged-pixels() else device-pixels(clip)
last-damaged-pixels = damaged-pixels
//gui.frame.damaged-pixels += damaged-pixels as U64
//gui.gpu.draw-calls += renderer.draw-calls as U64
//gui.gpu.pipeline-switches += renderer.pipeline-switches as U64
//gui.gpu.encode-nanos += renderer.encode-nanos as U64
//gui.gpu.walk-nanos += renderer.walk-nanos as U64
if renderer.gpu-nanos >= 0
    //gui.gpu.gpu-nanos += renderer.gpu-nanos as U64
//gui.gpu.packet-bytes += renderer.packet-bytes as U64
//gui.gpu.unrenderable-ops += renderer.skipped-ops as U64
clear-damage()
trim-metal-tile-canvases()
metal-frames-encoded += 1
= true

────────────────────
+ layer-group-for DisplayGroup?
    - box Box

node-for(box)?.layer-group

────────────────────
_ do absorb-damage-area
    - rect Rect

. merged = rect
. index Size = 0
while index < damage-areas.length
    . area = damage-areas[index]
    if display-damage-areas-join(area, merged)
        merged = merged + area
        damage-areas.remove(index, 1)
        index = 0
    else
        index += 1
damage-areas += merged

────────────────────
_ do merge-closest-damage-areas

. best-first Size = 0
. best-second Size = 1
. best-growth = -1.0
for first in 0 .. < damage-areas.length
    for second in first + 1 .. < damage-areas.length
        . growth = display-damage-join-growth(damage-areas[first], damage-areas[second])
        if best-growth < 0 || growth < best-growth
            best-first = first
            best-second = second
            best-growth = growth
. merged = damage-areas[best-first] + damage-areas[best-second]
damage-areas.remove(best-second, 1)
damage-areas.remove(best-first, 1)
absorb-damage-area(merged)

────────────────────
_ do local-damage-areas [F64]

. values = List'F64()
for area in damage-areas
    . aligned = align-damage-to-device(area)
    values ++= [aligned.x - origin.x, aligned.y - origin.y, aligned.width, aligned.height]
= values

────────────────────
_ do split-damaged-pixels Size

. total Size = 0
for area in damage-areas
    total += device-pixels(align-damage-to-device(area))
= total

────────────────────
_ device-pixels Size
    - rect Rect

(ceil(rect.width * scale) as Size) * (ceil(rect.height * scale) as Size)

────────────────────
_ do clear-damage

has-damage = false
damage = display-no-rect
damage-areas.clear()

────────────────────
_ damage-touches Bool
    - visible Rect

some(damage-areas) • where display-rects-overlap(visible, each) && !each.contains(visible, 0.01)

────────────────────
_ live-resting Bool
    - cycle FrameCycle?
    - epoch F64?

if !cycle || epoch == null then false else cycle.is-resting(recorder.live-time - epoch)

────────────────────
_ live-wake F64
    - cycle FrameCycle
    - epoch F64

epoch + cycle.next-start(recorder.live-time - epoch)

────────────────────
_ earliest-wake F64
    - wake F64?
    - at F64

if wake != null then min(wake, at) else at

────────────────────
_ do damage-live-chunk Bool
    - chunk DisplayChunk
    - bounds Rect
    - rate F64?

. slot = due-live-slot(chunk.live-slot, rate)
=? false if !slot
chunk.live-slot = slot
add-damage(bounds)
= true

────────────────────
_ do damage-live-group Bool
    - group DisplayGroup
    - bounds Rect
    - rate F64?

. slot = due-live-slot(group.live-slot, rate)
=? false if !slot
group.live-slot = slot
add-damage(bounds)
= true

────────────────────
_ due-live-slot F64?
    - last F64
    - rate F64?

|? !rate || rate <= 0
    last
|? slot <= last
    null
??
    slot

.. interval = 1 / rate
.. slot = floor((recorder.live-time + interval / 8) / interval)

────────────────────
_ do refresh-group-liveness
    - group DisplayGroup

. live = group.owner.$animates-fills && (some(group.filters) • where each.is-live)
if !live
    group.is-live = false
    group.live-epoch = null
    group.live-cycle = null
    =
. top = 0.0
. is-capped = true
. cycle FrameCycle? = null
. is-cycled = true
for filter in group.filters
    if filter.is-live
        . wanted = filter.frame-rate
        if wanted
            top = max(top, wanted)
        else
            is-capped = false
        . found = display-layer-cycle(filter)
        if !found || (cycle && cycle != found)
            is-cycled = false
        cycle = found
group.live-rate = top if is-capped && top > 0
. group-cycle = cycle if is-cycled
if group.live-cycle != group-cycle
    group.live-cycle = group-cycle
    group.is-live-settled = false
group.live-epoch = group.live-epoch ?? recorder.live-time
=? if group.is-live
group.is-live = true
. known = some(live-groups) • where each as Pointer == group as Pointer
if !known
    live-groups += group

────────────────────
_ do group-filters [ShaderFilter]
    - group DisplayGroup

. epoch = group.live-epoch
=? group.filters if !epoch
. time = max(0, recorder.live-time - epoch)
. timed = List'ShaderFilter()
for filter in group.filters
    if filter.is-live
        timed += ShaderFilter
            - filter.shader
            - filter.args
            - filter.images
            - true
            - filter.frame-rate
            - time
            - filter.arg-kinds
    else
        timed += filter
= timed

────────────────────
_ do keep-live-epochs

kept-group-epochs.clear()
kept-chunk-epochs.clear()
for group in live-groups
    if group.is-live && group.live-epoch != null
        kept-group-epochs[display-live-key(group.owner, 0)] = group.live-epoch
for chunk in live-chunks
    if chunk.is-live && chunk.live-epoch != null
        kept-chunk-epochs[display-live-key(chunk.owner, chunk.phase)] = chunk.live-epoch

────────────────────
_ do frame-metal-chunk Bool
    - chunk DisplayChunk
    - renderer MetalOffscreenRenderer

is-replaying = true
do finally is-replaying = false
renderer.begin-packet()
current-metal-resource-renderer = renderer.native
current-metal-resource-epoch = renderer.image-atlas-evictions + renderer.image-texture-evictions
flush-released-chunks(renderer)
encode-metal-chunk(chunk, renderer)
. frame = renderer.commit-packet(0, Rect(0, 0, renderer.width, renderer.height))
trim-metal-tile-canvases()
metal-frames-encoded += 1
= frame >= 0

────────────────────
_ node-for
    - box Box

|? !pointer
    null
??
    gc-object-from-pointer'DisplayBoxNode(pointer)

.. pointer = box.retained-scene-node-for(generation)

────────────────────
_ do release-chunk-glyph-handles
    - chunk DisplayChunk

=? if !glyph-registrar
. handles = chunk.glyph-handles
=? if !handles
for handle in handles
    glyph-registrar!.release-display-glyph(handle)
handles.clear()

────────────────────
_ do release-all-glyph-handles

=? if !glyph-registrar
release-node-glyph-handles(root-nodes)

────────────────────
_ do release-node-glyph-handles
    - list [DisplayBoxNode]

for node in list
    if node.pre
        release-chunk-glyph-handles(node.pre)
    if node.post
        release-chunk-glyph-handles(node.post)
    if node.group
        release-node-glyph-handles(node.group.nodes)
    if node.layer-group
        release-node-glyph-handles(node.layer-group.nodes)

────────────────────
_ do record-chunk
    - chunk DisplayChunk

//+gui.scene.record-chunk
release-chunk-glyph-handles(chunk)
chunk.reset()
. unsupported-before = recorder.unsupported-calls
recorder.begin-chunk(chunk)
if chunk.phase == DisplayPhase.pre
    chunk.owner.paint-box-background(recorder)
    . self-start = recorder.recorded-commands.length
    . self-unsupported = recorder.unsupported-calls
    chunk.owner.paint-box-self(recorder)
    if !recorder.has-paint-since(self-start)
        while recorder.recorded-commands.length > self-start
            recorder.recorded-commands.pop()
        recorder.unsupported-calls = self-unsupported
else
    chunk.owner.paint-box-border(recorder)
    chunk.indicator-start = chunk.items.length
    record-indicator-items(chunk)
    chunk.indicator-count = chunk.items.length - chunk.indicator-start
    if chunk.owner as Pointer != chunk.owner.root as Pointer
        chunk.owner.paint-overlay(recorder)
    chunk.owner.paint-focus-ring(recorder)
recorder.end-chunk()

if recorder.unsupported-calls != unsupported-before && recorder.has-paint-since(0)
    chunk.demote-to-opaque()
    if !chunk.needs-tile
        recorder.keep-commands(chunk)
    opaque-demotions += 1
    //gui.scene.opaque-demotions ++
if !chunk.is-live
    chunk.live-epoch = null
else
    . known = some(live-chunks) • where each as Pointer == chunk as Pointer
    if !known
        live-chunks += chunk
. side = chunk.side
if side && side.has-antialiased
    has-antialiased-content = true
if side && side.has-shaded-fill
    has-shaded-fill-content = true
if side && side.has-backdrop
    has-backdrop-content = true
//-gui.scene.record-chunk

────────────────────
_ do record-indicator-items
    - chunk DisplayChunk

. color = chunk.owner.retained-scroll-indicator-color
. horizontal = chunk.owner.scroll-indicator-bounds(Orientation.horizontal)
if horizontal.width > 0 && horizontal.height > 0
    . horizontal-shape = chunk.shapes.length as U32
    chunk.shapes += display-shape(gui-scroll-indicator-outline(horizontal), null)
    . horizontal-item = chunk.add-item
        - indicator-display-item(horizontal, color, horizontal-shape)
        - horizontal
    chunk.set-item-color(horizontal-item, color)
. vertical = chunk.owner.scroll-indicator-bounds(Orientation.vertical)
if vertical.width > 0 && vertical.height > 0
    . vertical-shape = chunk.shapes.length as U32
    chunk.shapes += display-shape(gui-scroll-indicator-outline(vertical), null)
    . vertical-item = chunk.add-item
        - indicator-display-item(vertical, color, vertical-shape)
        - vertical
    chunk.set-item-color(vertical-item, color)

────────────────────
_ indicator-display-item
    - bounds Rect
    - color RGBA
    - shape-index U32

DisplayItem
    - DisplayItemKind.quad
    - display-item-has-shape
    - 0
    - bounds.x as F32
    - bounds.y as F32
    - bounds.width as F32
    - bounds.height as F32
    - gui-scroll-indicator-outline(bounds).effective-radius as F32
    - pack-rgba8(color)
    - shape-index
    - 0
    - 0

────────────────────
_ do update-indicator-items
    - chunk DisplayChunk

. horizontal = chunk.owner.scroll-indicator-bounds(Orientation.horizontal)
. has-horizontal = horizontal.width > 0 && horizontal.height > 0
. vertical = chunk.owner.scroll-indicator-bounds(Orientation.vertical)
. has-vertical = vertical.width > 0 && vertical.height > 0
. next-count Size
if has-horizontal
    next-count += 1
if has-vertical
    next-count += 1
if next-count != chunk.indicator-count
    rebuild-chunk(chunk)
    =

. old = chunk.bounds
. had-old = chunk.has-bounds
. exact = chunk.owner.retained-scroll-indicator-color
. index = chunk.indicator-start
if has-horizontal
    . horizontal-shape = chunk.items[index].data1
    chunk.shapes[horizontal-shape] = display-shape(gui-scroll-indicator-outline(horizontal), null)
    chunk.items[index] = indicator-display-item(horizontal, exact, horizontal-shape)
    chunk.set-item-color(index as U32, exact)
    index += 1
if has-vertical
    . vertical-shape = chunk.items[index].data1
    chunk.shapes[vertical-shape] = display-shape(gui-scroll-indicator-outline(vertical), null)
    chunk.items[index] = indicator-display-item(vertical, exact, vertical-shape)
    chunk.set-item-color(index as U32, exact)
chunk.bounds = display-no-rect
chunk.has-bounds = false
. item-index Size
while item-index < chunk.items.length
    chunk.add-ink(display-item-rect(chunk.items[item-index]))
    item-index += 1
if had-old
    add-damage(window-bounds(old, chunk.parent))
if chunk.has-bounds
    add-damage(window-bounds(chunk.bounds, chunk.parent))
if had-old != chunk.has-bounds || old != chunk.bounds
    schedule-group-refresh(chunk.parent)

────────────────────
_ do build-box
    - box Box
    - members [DisplayEntry]
    - parent-visible Bool
    - parent DisplayGroup? = null

. visible = parent-visible && box.is-display-visible
if !visible
    box.clear-retained-paint-invalidation()
    box.$is-paint-invalid = false
    box.$is-paint-invalid-below = false
    =
boxes-visited += 1
. old = node-for(box)
. node = DisplayBoxNode(box)
link-node(node, parent)
box.set-retained-scene-node(node as Pointer, generation)
if box.is-markup-shadow
    place-children(box, members, visible, true, parent)
    box.clear-retained-paint-invalidation()
    box.$is-paint-invalid = false
    box.$is-paint-invalid-below = false
    =

. box-members = members
. box-parent = parent
. layer-group DisplayGroup?
if display-box-needs-layer(box)
    . group = DisplayGroup(box, parent)
    group.is-layer = true
    group.live-epoch = old?.layer-group?.live-epoch ?? kept-group-epochs[display-live-key(box, 0)]
    refresh-group-properties(group)
    node.layer-group = group
    layer-group = group
    box-members = group.members
    box-parent = group

. pre = acquire-chunk(box, DisplayPhase.pre)
pre.live-epoch = old?.pre?.live-epoch ?? kept-chunk-epochs[display-live-key(box, DisplayPhase.pre)]
record-chunk(pre)
append-chunk(pre, box-members, node, true, box-parent)

if display-box-needs-group(box)
    . group = DisplayGroup(box, box-parent)
    node.group = group
    refresh-group-properties(group)
    place-children(box, group.members, visible, true, group)
    finalize-group(group)
    if group.members.length > 0
        //gui.scene.groups-built ++
        box-members += DisplayEntry(null, group)
else
    place-children(box, box-members, visible, true, box-parent)

. post = acquire-chunk(box, DisplayPhase.post)
post.live-epoch = old?.post?.live-epoch ?? kept-epoch
    .. kept-epoch = kept-chunk-epochs[display-live-key(box, DisplayPhase.post)]
record-chunk(post)
append-chunk(post, box-members, node, false, box-parent, box.has-retained-scroll-indicator)
if layer-group
    . group = layer-group
    finalize-group(group)
    if group.members.length > 0
        //gui.scene.groups-built ++
        members += DisplayEntry(null, group)
box.clear-transparent-paint-state()
box.clear-retained-paint-invalidation()
box.clear-retained-presentation-invalidation()
box.$is-paint-invalid = false
box.$is-paint-invalid-below = false

────────────────────
_ do append-chunk
    - chunk DisplayChunk
    - members [DisplayEntry]
    - node DisplayBoxNode
    - is-pre Bool
    - parent DisplayGroup? = null
    - force = false

if !force && display-chunk-is-empty(chunk)
    spare-empty-chunk(chunk)
    =
chunk.parent = parent
if is-pre
    node.pre = chunk
else
    node.post = chunk
//gui.scene.chunks-built ++
items-built += chunk.items.length
members += DisplayEntry(chunk, null)

────────────────────
_ do update-box Bool
    - box Box
    - parent-visible Bool

boxes-visited += 1
. visible = parent-visible && box.is-display-visible
if !visible
    . had-node = node-for(box) != null
    box.clear-retained-paint-invalidation()
    box.$is-paint-invalid = false
    box.$is-paint-invalid-below = false
    = had-node
. node = node-for(box)
=? true if !node
. layer-toggled = display-box-needs-layer(box) != (node.layer-group != null)
. group-needed = !box.is-markup-shadow && node.group == null && display-box-needs-group(box)
box.clear-retained-presentation-invalidation()

if node.layer-group && !layer-toggled
    . layer-group = node.layer-group
    . old-opacity = layer-group.opacity
    . old-filters = layer-group.filters
    . old-region = layer-group.region
    . old-transform = layer-group.transform
    refresh-group-properties(layer-group)
    . has-filters = layer-group.filters.length > 0
    . region-changed = has-filters && old-region != layer-group.region
    . filter-changed = !display-filters-equal(old-filters, layer-group.filters) || region-changed
    . transform-changed = !display-matrices-equal(old-transform, layer-group.transform)
    if old-opacity != layer-group.opacity || filter-changed || transform-changed
        if layer-group.has-outer
            add-damage(window-bounds(layer-group.outer, layer-group.parent))
        if transform-changed
            //gui.scene.layer-retransforms ++
            place-layer-outer(layer-group)
            advance-group-generation(layer-group)
            if layer-group.has-outer
                add-damage(window-bounds(layer-group.outer, layer-group.parent))
        if has-filters
            add-damage(window-bounds(layer-group.region, layer-group.parent))
        schedule-group-refresh(layer-group)

. translation-changed = false
if node.group
    . group = node.group
    . old-rounded-clip = group.rounded-clip
    . old-clip = group.clip
    . old-has-clip = group.has-clip
    . old-shape-clip = group.shape-clip-revision
    . old-translation = group.translation
    . old-outer = group.outer
    . old-has-outer = group.has-outer
    refresh-group-properties(group)
    . clip-changed = old-rounded-clip != group.rounded-clip
    clip-changed = clip-changed || old-clip != group.clip
    clip-changed = clip-changed || old-has-clip != group.has-clip
    clip-changed = clip-changed || old-shape-clip != group.shape-clip-revision
    translation-changed = clip-changed || old-translation != group.translation
    if translation-changed
        //gui.scene.transform-updates ++
        if clip-changed
            finalize-group(group)
        else
            advance-group-generation(group)
        if old-has-outer
            add-damage(window-bounds(old-outer, group.parent))
        if group.has-outer
            add-damage(window-bounds(group.outer, group.parent))
        schedule-group-refresh(group.parent)

. entries-changed = false
. legacy-self-paint = box.$is-paint-invalid && !box.is-retained-paint-invalid-below
if box.is-retained-paint-invalid || legacy-self-paint
    if box.is-retained-move-only-invalidation
        retain-moved-node(node)
    else if box.is-retained-transform-only-invalidation && retain-transformed-node(node)
        //gui.scene.chunks-retransformed ++
    else if !box.is-markup-shadow
        . scroll-only = translation-changed && box.is-retained-scroll-only-invalidation
        scroll-only = scroll-only && !box.$is-paint-invalid
        if !scroll-only && update-node-chunk(node, true)
            entries-changed = true
        . post = node.post
        if post && scroll-only
            update-indicator-items(post)
        else if !scroll-only || box.has-retained-scroll-indicator
            if update-node-chunk(node, false)
                entries-changed = true
        node.recorded-origin = box.bounds.top-left
    box.clear-retained-self-paint-invalidation()
    box.$is-paint-invalid = false

. children-changed = node.child-list-generation != box.retained-child-list-generation
if children-changed || box.is-retained-paint-invalid-below || box.$is-paint-invalid-below
    . relink = children-changed
    . listed = !children-changed && box.retained-paint-dirty-child-count > 0
    if children-changed
        update-current-children(box, visible)
    else if listed
        relink = update-listed-children(box, visible)
    else
        relink = update-dirty-children(box, visible)
    relink = relink || node.composite-relink
    if relink && (!node.group || relink-children(box, node, visible))
        entries-changed = true
    if listed
        box.clear-listed-shadow-paint-state()
    else
        box.clear-transparent-paint-state()
    box.clear-retained-paint-invalidation()
    box.$is-paint-invalid-below = false
= entries-changed || layer-toggled || group-needed

────────────────────
_ do update-listed-children
    - box Box
    - visible Bool

. changed = false
. dirty-count = box.retained-paint-dirty-child-count
. dirty-index Size
while dirty-index < dirty-count
    . dirty-child = box.retained-paint-dirty-child(dirty-index)
    if dirty-child && update-child(dirty-child, visible)
        changed = true
    dirty-index += 1
= changed

────────────────────
_ do update-dirty-children
    - box Box
    - visible Bool

. changed = false
. child = box.retained-rendered-first-child
while child
    . next = box.retained-rendered-next-child(child)
    if display-box-is-dirty(child) && update-child(child, visible)
        changed = true
    child = next
= changed

────────────────────
_ do update-current-children
    - box Box
    - visible Bool

. child = box.retained-rendered-first-child
while child
    . next = box.retained-rendered-next-child(child)
    if display-box-is-dirty(child)
        . ignored = update-child(child, visible)
    child = next

────────────────────
_ do update-child Bool
    - child Box
    - visible Bool

. host = child.composite-host
=? update-box(child, visible) if !host
=? false if !update-box(child, visible)
. host-node = node-for(host)
. root = scene-root
if !host-node && root
    host-node = node-for(root)
if host-node
    host-node.composite-relink = true
= false

────────────────────
_ do update-node-chunk
    - node DisplayBoxNode
    - is-pre Bool

. box = node.owner
. forced = !is-pre && box.has-retained-scroll-indicator
. existing = if is-pre then node.pre else node.post
if existing
    rebuild-chunk(existing)
    =? false if forced || !display-chunk-is-empty(existing)
    release-chunk-glyph-handles(existing)
    release-chunk-key(existing)
    if is-pre
        node.pre = null
    else
        node.post = null
    = !unsplice-chunk(existing)
//gui.scene.missing-chunk-recordings ++
. candidate = acquire-chunk(box, if is-pre then DisplayPhase.pre else DisplayPhase.post)
record-chunk(candidate)
if !forced && display-chunk-is-empty(candidate)
    spare-empty-chunk(candidate)
    = false
if is-pre
    node.pre = candidate
else
    node.post = candidate
= !splice-chunk(node, candidate, is-pre)

────────────────────
_ do acquire-chunk DisplayChunk
    - box Box
    - phase U8

. chunk = spare-chunk ?? DisplayChunk(box, phase)
spare-chunk = null
chunk.owner = box
chunk.phase = phase
chunk.parent = null
= chunk

────────────────────
_ do spare-empty-chunk
    - chunk DisplayChunk

=? if chunk.is-live
release-chunk-glyph-handles(chunk)
spare-chunk = chunk

────────────────────
_ do splice-chunk Bool
    - node DisplayBoxNode
    - chunk DisplayChunk
    - is-pre Bool

. group = node.layer-group ?? node.container
. members = if group then group.members else roots
=? false if members.length == 0
. anchor = if is-pre then leading-anchor(node) else trailing-anchor(node)
=? false if !anchor.known
. entry = anchor.entry
=? false if !entry
. index = display-entry-index(members, entry)
=? false if !index
chunk.parent = group
members.insert(DisplayEntry(chunk, null), if is-pre then index else index + 1)
//gui.scene.chunks-spliced ++
if chunk.has-bounds
    add-damage(window-bounds(chunk.bounds, group))
schedule-group-refresh(group)
= true

────────────────────
_ do unsplice-chunk Bool
    - chunk DisplayChunk

. group = chunk.parent
. members = if group then group.members else roots
. index = display-entry-index(members, DisplayEntry(chunk, null))
=? false if !index
members.remove(index)
=? false if group && members.length == 0
//gui.scene.chunks-unspliced ++
schedule-group-refresh(group)
= true

────────────────────
_ leading-anchor DisplayAnchor
    - node DisplayBoxNode

if !inner.known || inner.entry then inner else display-chunk-anchor(node.post)

.. inner = inner-first-anchor(node.owner, node)

────────────────────
_ trailing-anchor DisplayAnchor
    - node DisplayBoxNode

if !inner.known || inner.entry then inner else display-chunk-anchor(node.pre)

.. inner = inner-last-anchor(node.owner, node)

────────────────────
_ subtree-first-anchor DisplayAnchor
    - box Box

|? !box.is-display-visible
    display-no-anchor
|? !node
    display-unknown-anchor
|? layer
    display-group-anchor(layer)
|? node.pre
    display-chunk-anchor(node.pre)
|? !inner.known || inner.entry
    inner
??
    display-chunk-anchor(node.post)

.. node = node-for(box)
.. layer = node.layer-group
.. inner = inner-first-anchor(box, node)

────────────────────
_ subtree-last-anchor DisplayAnchor
    - box Box

|? !box.is-display-visible
    display-no-anchor
|? !node
    display-unknown-anchor
|? layer
    display-group-anchor(layer)
|? node.post
    display-chunk-anchor(node.post)
|? !inner.known || inner.entry
    inner
??
    display-chunk-anchor(node.pre)

.. node = node-for(box)
.. layer = node.layer-group
.. inner = inner-last-anchor(box, node)

────────────────────
_ do inner-first-anchor DisplayAnchor
    - box Box
    - node DisplayBoxNode

. group = node.group
=? display-group-anchor(group) if group
=? display-unknown-anchor if box.composite-state
. child = box.retained-rendered-first-child
while child
    . current = child
    if !current.is-composite-routed
        . anchor = subtree-first-anchor(current)
        =? anchor if !anchor.known || anchor.entry
    child = box.retained-rendered-next-child(current)
= display-no-anchor

────────────────────
_ do inner-last-anchor DisplayAnchor
    - box Box
    - node DisplayBoxNode

. group = node.group
=? display-group-anchor(group) if group
=? display-unknown-anchor if box.composite-state
. child = box.retained-rendered-last-child
while child
    . current = child
    if !current.is-composite-routed
        . anchor = subtree-last-anchor(current)
        =? anchor if !anchor.known || anchor.entry
    child = box.retained-rendered-previous-child(current)
= display-no-anchor

────────────────────
_ do relink-children Bool
    - box Box
    - node DisplayBoxNode
    - visible Bool

. group = node.group!
. was-empty = group.members.length == 0
. refill = begin-refill(group)
node.composite-relink = false
place-children(box, group.members, visible, false, group)
finish-refill(group, refill)
node.child-list-generation = box.retained-child-list-generation
= was-empty != (group.members.length == 0)

────────────────────
_ do relink-roots
    - tree-root Box

. previous = roots
roots = List'DisplayEntry()
. old-nodes = root-nodes
root-nodes = List'DisplayBoxNode()
root-refill-stamp = next-refill-stamp()
link-box(tree-root, roots, true, null)
for node in old-nodes
    if !node.container && node.link-stamp != root-refill-stamp
        drop-node(node)
damage-refill(previous, roots, root-refill-stamp)
relinks += 1
root-order-refresh-pending = true

────────────────────
_ do link-box
    - box Box
    - members [DisplayEntry]
    - parent-visible Bool
    - parent DisplayGroup?

. visible = parent-visible && box.is-display-visible
if !visible
    box.clear-retained-paint-invalidation()
    box.$is-paint-invalid = false
    box.$is-paint-invalid-below = false
    =
. node = node-for(box)
if !node
    build-box(box, members, visible, parent)
    =
link-node(node, parent)

if box.is-markup-shadow
    link-children(box, members, visible, parent)
    node.child-list-generation = box.retained-child-list-generation
    =

. needs-layer = display-box-needs-layer(box)
if needs-layer && !node.layer-group
    . group = DisplayGroup(box, parent)
    group.is-layer = true
    refresh-group-properties(group)
    node.layer-group = group
    //gui.scene.layers-wrapped ++
else if !needs-layer && node.layer-group
    node.layer-group = null
    //gui.scene.layers-unwrapped ++
. layer-group = node.layer-group
if layer-group
    . refill = begin-refill(layer-group)
    adopt-group(layer-group, parent)
    link-box-entries(box, node, layer-group.members, visible, layer-group)
    finish-refill(layer-group, refill)
    if layer-group.members.length > 0
        members += DisplayEntry(null, layer-group)
else
    link-box-entries(box, node, members, visible, parent)

────────────────────
_ do adopt-group
    - group DisplayGroup
    - parent DisplayGroup?

group.parent = parent
if group.refresh-pending
    schedule-group-refresh(parent)

────────────────────
_ do link-box-entries
    - box Box
    - node DisplayBoxNode
    - members [DisplayEntry]
    - visible Bool
    - parent DisplayGroup?

. pre = node.pre
if pre
    pre.parent = parent
    members += DisplayEntry(pre, null)
. grouped = !node.group && display-box-needs-group(box)
if grouped
    . created = DisplayGroup(box, parent)
    refresh-group-properties(created)
    node.group = created
    //gui.scene.groups-wrapped ++
. group = node.group
if group
    adopt-group(group, parent)
    . children-changed = node.child-list-generation != box.retained-child-list-generation
    if children-changed
        update-current-children(box, visible)
    if children-changed || grouped
        . ignored = relink-children(box, node, visible)
    if group.members.length > 0
        members += DisplayEntry(null, group)
else
    link-children(box, members, visible, parent)
    node.child-list-generation = box.retained-child-list-generation
. post = node.post
if post
    post.parent = parent
    members += DisplayEntry(post, null)

────────────────────
_ do link-children
    - box Box
    - members [DisplayEntry]
    - visible Bool
    - parent DisplayGroup?

place-children(box, members, visible, false, parent)

────────────────────
_ do place-children
    - box Box
    - members [DisplayEntry]
    - visible Bool
    - building Bool
    - parent DisplayGroup?

. record = box.composite-state
if record
    place-routed(members, visible, building, parent, record.below)
. child = box.retained-rendered-first-child
while child
    . next = box.retained-rendered-next-child(child)
    if !child.is-composite-routed
        if building
            build-box(child, members, visible, parent)
        else
            link-box(child, members, visible, parent)
    child = next
if record
    place-routed(members, visible, building, parent, record.above)

────────────────────
_ do place-routed
    - members [DisplayEntry]
    - visible Bool
    - building Bool
    - parent DisplayGroup?
    - routed [Box]?

=? if !routed
for member in routed
    if building
        build-box(member, members, visible, parent)
    else
        link-box(member, members, visible, parent)

────────────────────
_ do link-node
    - node DisplayBoxNode
    - parent DisplayGroup?

node.container = parent
if parent
    parent.nodes += node
    node.link-stamp = parent.refill-stamp
else
    root-nodes += node
    node.link-stamp = root-refill-stamp

────────────────────
_ do next-refill-stamp

refill-stamp-counter += 1
if !refill-stamp-counter
    refill-stamp-counter = 1
= refill-stamp-counter

────────────────────
_ do begin-refill
    - group DisplayGroup

. refill = DisplayRefill(group.nodes, group.members)
group.members = group.spare-members ?? List'DisplayEntry()
group.nodes = group.spare-nodes ?? List'DisplayBoxNode()
group.spare-members = null
group.spare-nodes = null
group.refill-stamp = next-refill-stamp()
= refill

────────────────────
_ do finish-refill
    - group DisplayGroup
    - refill DisplayRefill

for node in refill.nodes
    if node.link-stamp != group.refill-stamp && node.container as Pointer? == group as Pointer?
        drop-node(node)
finalize-group(group)
damage-refill(refill.members, group.members, group.refill-stamp, group)
schedule-group-refresh(group.parent)
relinks += 1
refill.members.clear()
refill.nodes.clear()
group.spare-members = refill.members
group.spare-nodes = refill.nodes

────────────────────
_ do damage-refill
    - previous [DisplayEntry]
    - current [DisplayEntry]
    - stamp U32
    - parent DisplayGroup? = null

. index Size
while index < previous.length
    mark-previous-entry(previous[index], stamp, index)
    index += 1
. reordered = false
. has-last = false
. last-index Size
for entry in current
    . previous-index = previous-entry-index(entry, stamp)
    mark-linked-entry(entry, stamp)
    if previous-index == null
        damage-entry(entry, parent)
    else
        reordered = reordered || (has-last && previous-index < last-index)
        last-index = previous-index
        has-last = true
for entry in previous
    if !is-linked-entry(entry, stamp)
        damage-entry(entry, parent)
if reordered
    for entry in current
        damage-entry(entry, parent)

────────────────────
_ do damage-entry
    - entry DisplayEntry
    - parent DisplayGroup?

add-damage(window-bounds(display-entry-bounds(entry), parent))

────────────────────
_ do mark-previous-entry
    - entry DisplayEntry
    - stamp U32
    - index Index

. chunk = entry.chunk
. group = entry.group
if chunk
    chunk.refill-mark = stamp
    chunk.refill-index = index
else if group
    group.refill-mark = stamp
    group.refill-index = index

────────────────────
_ previous-entry-index
    - entry DisplayEntry
    - stamp U32

|? chunk
    chunk.refill-index if chunk.refill-mark == stamp
|? group
    group.refill-index if group.refill-mark == stamp
??
    null

.. chunk = entry.chunk
.. group = entry.group

────────────────────
_ do mark-linked-entry
    - entry DisplayEntry
    - stamp U32

. chunk = entry.chunk
. group = entry.group
if chunk
    chunk.linked-mark = stamp
else if group
    group.linked-mark = stamp

────────────────────
_ is-linked-entry
    - entry DisplayEntry
    - stamp U32

|? chunk
    chunk.linked-mark == stamp
|? group
    group.linked-mark == stamp
??
    false

.. chunk = entry.chunk
.. group = entry.group

────────────────────
_ do detach-node
    - node DisplayBoxNode

. current = node-for(node.owner)
if current && current as Pointer == node as Pointer
    node.owner.set-retained-scene-node(Pointer(), 0)

────────────────────
_ do drop-node
    - node DisplayBoxNode

detach-node(node)
. pre = node.pre
if pre
    release-chunk-glyph-handles(pre)
    release-chunk-key(pre)
. post = node.post
if post
    release-chunk-glyph-handles(post)
    release-chunk-key(post)
. group = node.group
if group
    drop-group-shape-clip(group)
    drop-group-nodes(group)
. layer-group = node.layer-group
if layer-group
    layer-group.is-live = false
    drop-group-nodes(layer-group)

────────────────────
_ do drop-group-nodes
    - group DisplayGroup

for node in group.nodes
    if node.container as Pointer? == group as Pointer?
        drop-node(node)
group.nodes.clear()

────────────────────
_ do retain-transformed-node
    - node DisplayBoxNode

. chunk = node.pre
=? false if !chunk || chunk.is-opaque
. side = chunk.side
=? false if !side || side.content-state == 0
. transform = node.owner.content-transform
=? false if !transform
. content = side.states[side.content-state]
side.states[side.content-state] = content.matrix = transform
side.refresh-states()
. old = chunk.bounds
. had-old = chunk.has-bounds
chunk.refresh-bounds()
chunk.bump-record-generation()
if had-old
    add-damage(window-bounds(old, chunk.parent))
if chunk.has-bounds
    add-damage(window-bounds(chunk.bounds, chunk.parent))
if had-old != chunk.has-bounds || old != chunk.bounds
    schedule-group-refresh(chunk.parent)
= true

────────────────────
_ do retain-moved-node
    - node DisplayBoxNode

. current-origin = node.owner.bounds.top-left
. delta = current-origin - node.recorded-origin
if delta != Point(0, 0)
    if node.pre
        retain-moved-chunk(node.pre, delta)
    if node.post
        retain-moved-chunk(node.post, delta)
node.recorded-origin = current-origin

────────────────────
_ do retain-moved-chunk
    - chunk DisplayChunk
    - delta Point

. side = chunk.side
. side-unshiftable = side != null && (has-styles || side.gradient-wires.length > 0)
    .. has-styles = side.states.length > 1 || side.styled-wires.length > 0
. unshiftable = chunk.needs-tile || side-unshiftable
if chunk.is-opaque || unshiftable
    //gui.scene.opaque-move-fallbacks ++
    rebuild-chunk(chunk)
else
    rebase-chunk(chunk, delta)

────────────────────
_ do rebase-chunk
    - chunk DisplayChunk
    - delta Point

. old = chunk.bounds
. had-old = chunk.has-bounds
. dx = delta.x as F32
. dy = delta.y as F32
. item-index Size
while item-index < chunk.items.length
    . item = chunk.items[item-index]
    chunk.items[item-index] = DisplayItem
        - item.kind
        - item.flags
        - item.aux
        - item.x + dx
        - item.y + dy
        - item.width
        - item.height
        - item.value
        - item.data0
        - item.data1
        - item.data2
        - item.data3
    item-index += 1
. clip-index Size
while clip-index < chunk.clips.length
    chunk.clips[clip-index] = chunk.clips[clip-index] + delta
    clip-index += 1
. known-exacts = chunk.exacts
if known-exacts
    . exact-index Size
    while exact-index < known-exacts.rects.length
        known-exacts.rects[exact-index] = known-exacts.rects[exact-index] + delta
        exact-index += 1
. side = chunk.side
if side
    . ink-index Size
    while ink-index < side.item-inks.length
        . ink = side.item-inks[ink-index]
        if ink.width >= 0 && ink.height >= 0
            side.item-inks[ink-index] = ink + delta
        ink-index += 1
    . transform-index Size
    while transform-index < side.transforms.length
        . matrix = side.transforms[transform-index]
        side.transforms[transform-index] = Matrix
            - matrix.a
            - matrix.c
            - matrix.b
            - matrix.d
            - matrix.tx + delta.x
            - matrix.ty + delta.y
        transform-index += 1
. kept = chunk.commands
if kept
    . command-index Size
    while command-index < kept.length
        kept[command-index] = rebase-command(kept[command-index], delta)
        command-index += 1
if chunk.has-bounds
    chunk.bounds = chunk.bounds + delta
//gui.scene.eligible-move-rebases ++
if had-old
    add-damage(window-bounds(old, chunk.parent))
if chunk.has-bounds
    add-damage(window-bounds(chunk.bounds, chunk.parent))
schedule-group-refresh(chunk.parent)

────────────────────
_ do rebase-command
    - command DisplayCommand
    - delta Point

. rect = command.rect
. tile-origin = command.point1
. kind = command.kind
if kind == DisplayCommandKind.rect || kind == DisplayCommandKind.text || is-image
    rect = rect + delta
else if kind == DisplayCommandKind.image-pattern
    rect = rect + delta
    tile-origin = tile-origin + delta
else if kind == DisplayCommandKind.clip || kind == DisplayCommandKind.clip-outline
    rect = rect + delta
.. is-image = kind == DisplayCommandKind.image
= DisplayCommand
    - command.kind
    - rect
    - tile-origin
    - command.point2
    - command.point3
    - command.matrix
    - command.fill
    - command.stroke
    - command.stroke-width
    - command.stroke-cap
    - command.stroke-join
    - command.layout
    - command.image
    - command.alignment
    - command.flag
    - command.fill-rule
    - command.item-index
    - command.gradient
    - command.stroke-dash
    - command.blend
    - command.shader
    - command.shader-args
    - command.shader-images
    - command.sampling

────────────────────
_ do rebuild-chunk
    - chunk DisplayChunk

. old = chunk.bounds
. had-old = chunk.has-bounds
record-chunk(chunk)
chunks-rebuilt += 1
//gui.frame.display-chunks-rebuilt ++
if had-old
    add-damage(window-bounds(old, chunk.parent))
if chunk.has-bounds
    add-damage(window-bounds(chunk.bounds, chunk.parent))
if had-old != chunk.has-bounds || old != chunk.bounds
    schedule-group-refresh(chunk.parent)

────────────────────
_ do schedule-group-refresh
    - start DisplayGroup?

. group DisplayGroup? = start
if !group
    root-order-refresh-pending = true
while group
    =? if group.refresh-pending
    group.refresh-pending = true
    if !group.parent
        root-order-refresh-pending = true
    group = group.parent

────────────────────
_ do flush-group-refreshes

=? if !root-order-refresh-pending
//+gui.scene.group-refresh
refresh-pending-groups(roots)
root-order = display-detect-order(roots)
root-order-refresh-pending = false
//-gui.scene.group-refresh

────────────────────
_ do refresh-pending-groups
    - members [DisplayEntry]

for entry in members
    if entry.group
        . group = entry.group
        if group.refresh-pending
            refresh-pending-groups(group.members)
            finalize-group(group)
            group.refresh-pending = false
            //gui.scene.group-refreshes ++

────────────────────
_ do refresh-group-properties
    - group DisplayGroup

if group.is-layer
    group.opacity = group.owner.computed-opacity
    group.filters = group.owner.layer-filters
    group.region = group.owner.bounds
    group.transform = group.owner.painted-transform
    if group.filters.length > 0
        has-filter-content = true
    refresh-group-liveness(group)
    group.has-clip = false
    group.clip = display-no-rect
    group.translation = Point(0, 0)
    =
group.has-clip = group.owner.clips-content
group.owner.set-retained-native-clip-required(group.has-clip)
if group.has-clip
    group.rounded-clip = group.owner.content-rounded-bounds
    group.clip = group.rounded-clip.bounds
    group.translation = group.owner.content-scroll-translation
else
    group.clip = display-no-rect
    group.translation = Point(0, 0)
refresh-group-shape-clip(group)

────────────────────
_ do refresh-group-shape-clip
    - group DisplayGroup

. owner = group.owner
. shape = owner.$shape if group.has-clip
if !shape || !shape.clips-content
    drop-group-shape-clip(group)
    =
. chunk = group.shape-clip ?? DisplayChunk(owner, DisplayPhase.pre)
. generation = chunk.path-generation
chunk.reset()
recorder.begin-chunk(chunk)
owner.clip-content-shape(recorder)
recorder.end-chunk()
. state = display-chunk-path-clip(chunk)
group.shape-clip = chunk
if state == 0
    drop-group-shape-clip(group)
    =
group.shape-clip-state = state
. coords = chunk.side!.path-coords
if group.shape-clip-coords.length > 0 && display-coords-equal(coords, group.shape-clip-coords)
    chunk.path-generation = generation
    =
group.shape-clip-coords.clear()
for coord in coords
    group.shape-clip-coords += coord
group.shape-clip-revision += 1

────────────────────
_ do drop-group-shape-clip
    - group DisplayGroup

. chunk = group.shape-clip
=? if !chunk
release-chunk-key(chunk)
group.shape-clip = null
group.shape-clip-state = 0
group.shape-clip-coords.clear()
group.shape-clip-revision += 1

────────────────────
_ do place-layer-outer
    - group DisplayGroup

. transform = group.transform
group.outer = if transform && group.has-inner then transform.transform(group.inner) else group.inner
group.has-outer = group.has-inner
group.owner.set-retained-display-ink-bounds(group.outer, group.has-outer)

────────────────────
_ do advance-group-generation
    - group DisplayGroup

group.record-generation = next-display-record-generation()

────────────────────
_ do finalize-group
    - group DisplayGroup

advance-group-generation(group)
group.order = display-detect-order(group.members)
. ink-bounds = display-no-rect
. has-ink-bounds = false
for entry in group.members
    . entry-rect = display-entry-bounds(entry)
    if entry-rect.is-empty
        continue
    if has-ink-bounds
        ink-bounds = ink-bounds + entry-rect
    else
        ink-bounds = entry-rect
        has-ink-bounds = true
group.owner.set-retained-display-ink-bounds(ink-bounds, has-ink-bounds)
if group.is-layer && group.filters.length > 0
    group.inner = group.region
    group.has-inner = !group.region.is-empty
    place-layer-outer(group)
else if group.is-layer
    group.inner = ink-bounds
    group.has-inner = has-ink-bounds
    place-layer-outer(group)
else if group.has-clip
    group.outer = group.clip
    group.has-outer = group.clip.width > 0 && group.clip.height > 0
else
    group.outer = ink-bounds
    group.has-outer = has-ink-bounds

────────────────────
_ do expand-damage
    - whole-shaded-fills Bool

if !has-backdrop-content && !has-filter-content
    expand-antialiased-damage(whole-shaded-fills)
    =
for pass in 0 .. < 8
    . previous = damage-revision
    expand-antialiased-damage(whole-shaded-fills)
    if has-backdrop-content
        expand-backdrop-members(roots)
    if has-filter-content
        expand-filter-members(roots)
    =? if damage-revision == previous

────────────────────
_ do expand-filter-members
    - members [DisplayEntry]

for entry in members
    . group = entry.group
    if group
        if group.filters.length > 0 && group.has-outer
            . visible = window-bounds(group.outer, group.parent)
            if damage-touches(visible)
                add-damage(visible)
        expand-filter-members(group.members)

────────────────────
_ do expand-antialiased-damage
    - whole-shaded-fills Bool

=? if !has-antialiased-content && !(whole-shaded-fills && has-shaded-fill-content)
. root = scene-root
=? if root && damage.contains(root.bounds, 0.01)
. areas = damage-snapshot
for pass in 0 .. < 8
    . previous = damage-revision
    areas.clear()
    areas ++= damage-areas
    for area in areas
        expand-antialiased-members(roots, root-order, area, whole-shaded-fills)
    =? if damage-revision == previous

────────────────────
_ do expand-backdrop-members
    - members [DisplayEntry]

for entry in members
    . chunk = entry.chunk
    if chunk
        . side = chunk.side
        if side && side.has-backdrop
            expand-chunk-backdrops(chunk, side)
    else if entry.group
        expand-backdrop-members(entry.group.members)

────────────────────
_ do expand-chunk-backdrops
    - chunk DisplayChunk
    - side DisplayChunkSide

. index Size
while index < chunk.items.length
    . kind = chunk.items[index].kind
    if kind == DisplayItemKind.backdrop || kind == DisplayItemKind.backdrop-shader
        . state = side.item-states[index]
        . ink = side.item-inks[index]
        . placed = if state == 0 then ink else side.state-ink-bounds(state, ink)
        if placed
            . sampled = window-bounds(placed, chunk.parent).pad(-display-backdrop-pixel-reach)
            if damage-touches(sampled)
                add-damage(sampled)
    index += 1

────────────────────
_ do expand-antialiased-members
    - members [DisplayEntry]
    - order DisplayOrder
    - local-damage Rect
    - whole-shaded-fills Bool

. index = first-member-toward(members, order, local-damage)
. axis = order.axis
. stop = display-order-stop(order, local-damage)
while index < members.length
    . entry = members[index]
    . bounds = display-entry-bounds(entry)
    if axis == DisplayAxis.vertical && bounds.top >= stop && !bounds.is-empty
        break
    if axis == DisplayAxis.horizontal && bounds.left >= stop && !bounds.is-empty
        break
    if display-rects-overlap(bounds, local-damage)
        . chunk = entry.chunk
        if chunk
            . side = chunk.side
            . grows = side && (side.has-antialiased || (whole-shaded-fills && side.has-shaded-fill))
            if grows && !local-damage.contains(bounds, 0.01)
                add-damage(window-bounds(bounds, chunk.parent))
        else if entry.group
            . group = entry.group
            . local = local-damage
            if group.has-clip
                . visible = group.clip.intersection(local-damage)
                local = Rect
                    - visible.x - group.translation.x
                    - visible.y - group.translation.y
                    - visible.width
                    - visible.height
            if local.width > 0 && local.height > 0
                expand-antialiased-members(group.members, group.order, local, whole-shaded-fills)
    index += 1

────────────────────
_ do draw-members
    - members [DisplayEntry]
    - order DisplayOrder
    - surface RasterCanvas
    - local-damage Rect

. index = first-member-toward(members, order, local-damage)
. axis = order.axis
. stop = display-order-stop(order, local-damage)
while index < members.length
    . entry = members[index]
    cull-tests += 1
    //gui.scene.cull-tests ++
    . bounds = display-entry-bounds(entry)
    if axis == DisplayAxis.vertical && bounds.top >= stop && !bounds.is-empty
        break
    if axis == DisplayAxis.horizontal && bounds.left >= stop && !bounds.is-empty
        break
    if display-rects-overlap(bounds, local-damage)
        if entry.chunk
            draw-chunk(entry.chunk, surface, local-damage)
        else if entry.group
            draw-group(entry.group, surface, local-damage)
    index += 1

────────────────────
_ do draw-group
    - group DisplayGroup
    - surface RasterCanvas
    - parent-damage Rect

. local = parent-damage
if group.is-layer
    =? if group.opacity <= 0%%
    . transform = group.transform
    if transform
        . inverse = transform.create-inverse()
        =? if !inverse
        local = inverse.transform(parent-damage)
    do use surface.saved-state
        if transform
            surface.transform-content(transform)
        if group.opacity < 1%%
            surface.begin-opacity(group.opacity)
        . filters = group-filters(group)
        for index in 0 .. < filters.length
            surface.begin-filter(group.region, filters[filters.length - 1 - index])
        draw-members(group.members, group.order, surface, local)
        for filter in filters
            surface.end-filter()
        if group.opacity < 1%%
            surface.end-opacity()
    =
if group.has-clip
    . visible = group.clip.intersection(parent-damage)
    =? if visible.width <= 0 || visible.height <= 0
    surface.push()
    group.rounded-clip.clip(surface)
    if group.shape-clip
        group.owner.clip-content-shape(surface)
    surface.translate(group.translation.x, group.translation.y)
    local = Rect
        - visible.x - group.translation.x
        - visible.y - group.translation.y
        - visible.width
        - visible.height
draw-members(group.members, group.order, surface, local)
if group.has-clip
    surface.pop()

────────────────────
_ do encode-metal-members
    - members [DisplayEntry]
    - order DisplayOrder
    - local-damage Rect
    - renderer MetalOffscreenRenderer

. index = first-member-toward(members, order, local-damage)
. axis = order.axis
. stop = display-order-stop(order, local-damage)
while index < members.length
    . entry = members[index]
    cull-tests += 1
    //gui.scene.cull-tests ++
    . bounds = display-entry-bounds(entry)
    if axis == DisplayAxis.vertical && bounds.top >= stop && !bounds.is-empty
        break
    if axis == DisplayAxis.horizontal && bounds.left >= stop && !bounds.is-empty
        break
    if display-rects-overlap(bounds, local-damage)
        if entry.chunk
            encode-metal-chunk(entry.chunk, renderer, local-damage)
        else if entry.group
            encode-metal-group(entry.group, local-damage, renderer)
    index += 1

────────────────────
_ do encode-metal-group
    - group DisplayGroup
    - parent-damage Rect
    - renderer MetalOffscreenRenderer

. local = parent-damage
if group.is-layer
    =? if group.opacity <= 0%%
    . transform = group.transform
    . turned = transform != null && !transform.is-translation
    if transform
        . inverse = transform.create-inverse()
        =? if !inverse
        local = inverse.transform(parent-damage)
        if turned
            renderer.push-transform-layer
                - transform
                - if group.filters.length > 0 then 1%% else group.opacity
        else
            renderer.push-translate(transform.translation)
    . filters = group-filters(group)
    for index in 0 .. < filters.length
        . outermost = index == 0
        renderer.push-filter-layer
            - group.region
            - filters[filters.length - 1 - index]
            - if outermost then group.opacity else 1%%
    . layered = filters.length == 0 && group.opacity < 1%% && !turned
    if layered
        renderer.push-layer(group.opacity)
    encode-metal-members(group.members, group.order, local, renderer)
    if layered
        renderer.pop-layer()
    for filter in filters
        renderer.pop-layer()
    if turned
        renderer.pop-layer()
    else if transform
        renderer.pop-translate()
    =
if group.has-clip
    . visible = group.clip.intersection(parent-damage)
    =? if visible.width <= 0 || visible.height <= 0
    renderer.push-rounded-clip(group.rounded-clip)
    if group.shape-clip
        push-metal-shape-clip(group, renderer)
    renderer.push-translate(group.translation)
    local = Rect
        - visible.x - group.translation.x
        - visible.y - group.translation.y
        - visible.width
        - visible.height
encode-metal-members(group.members, group.order, local, renderer)
if group.has-clip
    renderer.pop-translate()
    if group.shape-clip
        renderer.pop-clip()
    renderer.pop-clip()

────────────────────
_ do push-metal-shape-clip
    - group DisplayGroup
    - renderer MetalOffscreenRenderer

. chunk = group.shape-clip!
. side = chunk.side!
side.refresh-wire-states()
. path-set = renderer.chunk-paths
    - (chunk as Pointer).address
    - chunk.path-generation
    - chunk.items.buffer-pointer
    - 0
    - side.path-verbs.buffer-pointer
    - side.path-verbs.length
    - side.path-coords.buffer-pointer
    - side.path-coords.length
    - side.styled-wires.buffer-pointer
    - 0
    - side.gradient-wires.buffer-pointer
    - 0
    - side.gradient-stops.buffer-pointer
    - 0
    - side.shader-args.buffer-pointer
    - 0
    - side.wire-states.buffer-pointer
    - side.wire-states.length
. state = side.states[group.shape-clip-state as Size]
renderer.push-path-clip(path-set, group.shape-clip-state, state.fill-rule == FillRule.even-odd)

────────────────────
_ do encode-metal-chunk
    - chunk DisplayChunk
    - renderer MetalOffscreenRenderer
    - damage Rect? = null

chunks-encoded += 1
=? if damage && encode-raster-chunk(chunk, damage, renderer)
if !chunk.is-opaque && !chunk.needs-tile && ensure-metal-chunk-resources(chunk, renderer)
    if append-metal-items(chunk, renderer)
        items-encoded += chunk.items.length
        //gui.frame.visible-display-items += chunk.items.length as U64
        =
metal-tile-fallbacks += 1
//gui.scene.metal-tile-fallbacks ++
. key = (chunk as Pointer).address as U64
. rect = display-pixel-rect(chunk.bounds, renderer.scale)
. handle = renderer.tile-lookup(key, chunk.record-generation)
if !handle
    handle = register-metal-opaque-tile(chunk, rect, renderer, key)
if handle
    renderer.append-tile(handle - 1, rect)
    items-encoded += 1
    //gui.frame.visible-display-items ++

────────────────────
_ do append-metal-items
    - chunk DisplayChunk
    - renderer MetalOffscreenRenderer
    - wires [DisplayStateWire]? = null

. side = chunk.side
if !side
    = renderer.append-items
        - chunk.items.buffer-pointer
        - chunk.items.length
        - chunk.clips.buffer-pointer
        - chunk.clips.length
        - chunk.vector-palette.buffer-pointer
        - chunk.vector-palette.length
        - chunk.shapes.buffer-pointer
        - chunk.shapes.length
side.refresh-wire-states()
. states = wires ?? side.wire-states
. path-set I64 = -1
if side.styled-wires.length > 0 || side.shape-clips > 0 || side.gradient-wires.length > 0
    path-set = renderer.chunk-paths
        - (chunk as Pointer).address
        - chunk.path-generation
        - chunk.items.buffer-pointer
        - chunk.items.length
        - side.path-verbs.buffer-pointer
        - side.path-verbs.length
        - side.path-coords.buffer-pointer
        - side.path-coords.length
        - side.styled-wires.buffer-pointer
        - side.styled-wires.length
        - side.gradient-wires.buffer-pointer
        - side.gradient-wires.length
        - side.gradient-stops.buffer-pointer
        - side.gradient-stops.length
        - side.shader-args.buffer-pointer
        - side.shader-args.length
        - states.buffer-pointer
        - states.length
= renderer.append-items
    - chunk.items.buffer-pointer
    - chunk.items.length
    - chunk.clips.buffer-pointer
    - chunk.clips.length
    - chunk.vector-palette.buffer-pointer
    - chunk.vector-palette.length
    - chunk.shapes.buffer-pointer
    - chunk.shapes.length
    - side.transforms.buffer-pointer
    - side.transforms.length
    - side.item-transforms.buffer-pointer
    - side.vector-colors.buffer-pointer
    - side.vector-colors.length
    - side.item-strokes.buffer-pointer
    - side.item-dashes.buffer-pointer
    - states.buffer-pointer
    - states.length
    - side.item-states.buffer-pointer
    - side.image-identities.buffer-pointer
    - side.image-identities.length
    - path-set

────────────────────
_ do encode-raster-chunk Bool
    - chunk DisplayChunk
    - damage Rect
    - renderer MetalOffscreenRenderer

=? false if !chunk.owner.$caches-raster || chunk.is-live
. found = raster-view(chunk)
=? false if !found
. view = found
. scale = renderer.scale
. visible = raster-span(chunk, view, damage, scale)
=? true if !visible
. span = visible
. generation = chunk.path-generation
. missing = false
for row in span.top .. < span.bottom
    for column in span.left .. < span.right
        if renderer.tile-lookup-rendered(raster-key(chunk, column, row, scale), generation) == 0
            raster-wants += RasterTile(chunk, column, row, generation)
            missing = true
plan-raster-margin(chunk, view, span, scale, renderer)
=? false if missing
. size = (raster-tile-pixels as F64) / scale
. clip = view.clip
if clip
    renderer.push-clip(clip)
for row in span.top .. < span.bottom
    for column in span.left .. < span.right
        . handle = renderer.tile-lookup-rendered(raster-key(chunk, column, row, scale), generation)
        . x = view.offset.x + (column as F64) * size
        . y = view.offset.y + (row as F64) * size
        renderer.append-tile(handle - 1, Rect(x, y, size, size))
if clip
    renderer.pop-clip()
= true

────────────────────
_ do raster-view RasterView?
    - chunk DisplayChunk

=? null if chunk.is-opaque || chunk.needs-tile
. found = chunk.side
=? null if !found
. side = found
=? null if side.content-state == 0
. content = side.states[side.content-state]
=? null if !content.full.is-translation
. cursor = content.parent
while cursor != 0
    . state = side.states[cursor]
    . is-plain-clip = state.kind == DisplayStateKind.clip && state.radius == 0
    . is-shift = state.kind == DisplayStateKind.transform && state.matrix.is-translation
    =? null if !is-plain-clip && !is-shift
    cursor = state.parent
=? null if !is-raster-content(chunk, side)
. clip Rect? = content.clip-bounds if content.has-clip-bounds
= RasterView(Point(content.full.tx, content.full.ty), clip)

────────────────────
_ do is-raster-content Bool
    - chunk DisplayChunk
    - side DisplayChunkSide

=? chunk.is-raster-content if chunk.raster-generation == chunk.path-generation
chunk.raster-generation = chunk.path-generation
chunk.is-raster-content = raster-side-is-content(side)
= chunk.is-raster-content

────────────────────
_ do raster-span RasterSpan?
    - chunk DisplayChunk
    - view RasterView
    - area Rect
    - scale F64

. visible = area.intersection(chunk.bounds)
. clip = view.clip
if clip
    visible = visible.intersection(clip)
=? null if visible.is-empty
= raster-cells(visible, view.offset, scale)

────────────────────
_ do plan-raster-margin
    - chunk DisplayChunk
    - view RasterView
    - span RasterSpan
    - scale F64
    - renderer MetalOffscreenRenderer

. whole = raster-cells(chunk.bounds, view.offset, scale)
. left = max(span.left - 1, whole.left)
. top = max(span.top - 1, whole.top)
. right = min(span.right + 1, whole.right)
. bottom = min(span.bottom + 1, whole.bottom)
. generation = chunk.path-generation
for row in top .. < bottom
    for column in left .. < right
        . in-columns = column >= span.left && column < span.right
        . inside = in-columns && row >= span.top && row < span.bottom
        .. key = raster-key(chunk, column, row, scale)
        if !inside && renderer.tile-lookup-rendered(key, generation) == 0
            raster-wants += RasterTile(chunk, column, row, generation)

────────────────────
_ do render-raster-tiles
    - renderer MetalOffscreenRenderer

=? if raster-wants.length == 0
. scale = renderer.scale
. size = (raster-tile-pixels as F64) / scale
. columns = ((((renderer.width as F64) * scale) as I32)) / raster-tile-pixels
. rows = ((((renderer.height as F64) * scale) as I32)) / raster-tile-pixels
. capacity = columns * rows
if capacity <= 0
    raster-wants.clear()
    =
renderer.begin-packet()
current-metal-resource-renderer = renderer.native
current-metal-resource-epoch = renderer.image-atlas-evictions + renderer.image-texture-evictions
flush-released-chunks(renderer)
. slot I32
for want in raster-wants
    if slot >= capacity
        break
    . chunk = want.chunk
    . key = raster-key(chunk, want.column, want.row, scale)
    if chunk.path-generation != want.generation
        continue
    if renderer.tile-lookup-rendered(key, want.generation) != 0
        continue
    if !chunk.owner.$caches-raster || !raster-view(chunk)
        continue
    if !ensure-metal-chunk-resources(chunk, renderer) || is-texture-pending(chunk)
        continue
    . x = (slot % columns) * raster-tile-pixels
    . y = (slot / columns) * raster-tile-pixels
    . reserved = renderer.tile-reserve
        - key
        - want.generation
        - raster-tile-pixels
        - raster-tile-pixels
        - size
        - size
        - x
        - y
    if reserved == 0
        continue
    . left = (x as F64) / scale
    . top = (y as F64) / scale
    renderer.push-clip(Rect(left, top, size, size))
    renderer.push-translate
        - Point(left - (want.column as F64) * size, top - (want.row as F64) * size)
    append-raster-items(chunk, renderer)
    renderer.pop-translate()
    renderer.pop-clip()
    slot += 1
raster-wants.clear()
renderer.commit-tiles()

────────────────────
_ do render-sprites
    - renderer MetalOffscreenRenderer

sprite-pass += 1
. pass = sprite-pass
. kept Size = 0
for index in 0 .. < sprite-chunks.length
    . chunk = sprite-chunks[index]
    if chunk.sprite-count > 0 && chunk.sprite-mark != pass
        chunk.sprite-mark = pass
        sprite-chunks[kept] = chunk
        kept += 1
sprite-chunks.remove(kept, sprite-chunks.length - kept)
for chunk in recorder.sprite-chunks
    if chunk.sprite-count > 0 && chunk.sprite-mark != pass
        chunk.sprite-mark = pass
        sprite-chunks += chunk
recorder.sprite-chunks.clear()
. wants = sprite-wants
for chunk in sprite-chunks
    for index in 0 .. < chunk.sprite-count
        . item = chunk.items[chunk.sprite-items![index] as Size]
        . key = (item.data0 as U64) /or/ ((item.data1 as U64) /lshift/ 32)
        if renderer.tile-lookup-rendered(key, item.data2) == 0 && !is-sprite-wanted(wants, key)
            wants += DisplaySpriteWant(chunk.sprites![index], key, item.data2, item.value)
. next Size = 0
while next < wants.length
    next = render-sprite-batch(wants, next, renderer)
wants.clear()

────────────────────
_ is-sprite-wanted Bool
    - wants [DisplaySpriteWant]
    - key U64

some(wants) • where each.key == key

────────────────────
_ do render-sprite-batch Size
    - wants [DisplaySpriteWant]
    - start Size
    - renderer MetalOffscreenRenderer

. scale = renderer.scale
. width = ((renderer.width as F64) * scale) as I32
. height = ((renderer.height as F64) * scale) as I32
renderer.begin-packet()
current-metal-resource-renderer = renderer.native
current-metal-resource-epoch = renderer.image-atlas-evictions + renderer.image-texture-evictions
flush-released-chunks(renderer)
. x I32
. y I32
. shelf I32
. index = start
while index < wants.length
    . want = wants[index]
    . sprite = want.sprite
    . bounds = sprite.bounds
    . resolution = min
        - want.pixel-scale
        - min((width as F64) / bounds.width, (height as F64) / bounds.height)
    . pixel-width = min(ceil(bounds.width * resolution) as I32, width)
    . pixel-height = min(ceil(bounds.height * resolution) as I32, height)
    if x + pixel-width > width
        x = 0
        y += shelf
        shelf = 0
    if y + pixel-height > height && index > start
        break
    if ensure-metal-chunk-resources(sprite.chunk, renderer)
        . points-width = (pixel-width as F64) / resolution
        . points-height = (pixel-height as F64) / resolution
        . reserved = renderer.tile-reserve
            - want.key
            - want.generation
            - pixel-width
            - pixel-height
            - points-width
            - points-height
            - x
            - y
        if reserved != 0
            . left = (x as F64) / scale
            . top = (y as F64) / scale
            . zoom = resolution / scale
            renderer.push-clip
                - Rect(left, top, (pixel-width as F64) / scale, (pixel-height as F64) / scale)
            renderer.push-transform
                - Matrix(zoom, 0, 0, zoom, left - bounds.x * zoom, top - bounds.y * zoom)
            append-metal-items(sprite.chunk, renderer)
            renderer.pop-transform()
            renderer.pop-clip()
        x += pixel-width + 2
        shelf = max(shelf, pixel-height + 2)
    index += 1
renderer.commit-tiles()
= index

────────────────────
_ do append-raster-items Bool
    - chunk DisplayChunk
    - renderer MetalOffscreenRenderer

. side = chunk.side!
side.refresh-wire-states()
raster-wires.clear()
for wire in side.wire-states
    raster-wires += wire
. rooted = raster-wires[side.content-state]
rooted = rooted.parent = 0
rooted = rooted.matrix = Matrix()
raster-wires[side.content-state] = rooted
= append-metal-items(chunk, renderer, raster-wires)

────────────────────
_ is-texture-pending Bool
    - chunk DisplayChunk

some(pending-texture-chunks) • where each as Pointer == chunk as Pointer

────────────────────
_ do ensure-metal-chunk-resources
    - chunk DisplayChunk
    - renderer MetalOffscreenRenderer

. cached-renderer = chunk.metal-resource-renderer
if cached-renderer && current-metal-resource-renderer
    . same-renderer = cached-renderer == current-metal-resource-renderer
    . same-epoch = chunk.metal-resource-epoch == current-metal-resource-epoch
    =? true if same-renderer && same-epoch
. all-registered = true
. movable = false
. pending = false
. item-index Size
while item-index < chunk.items.length
    . item = chunk.items[item-index]
    . transform = chunk.item-transform(item-index)
    if item.kind == DisplayItemKind.vector
        . handle = VectorGeometryHandle(item.data0, item.data1)
        if !renderer.register-display-vector(resource-table, handle)
            all-registered = false
    else if transform && !display-matrix-is-axis-aligned(transform)
        all-registered = false
    else if item.kind == DisplayItemKind.glyph
        if lacks-glyph-handle && !register-chunk-glyph(chunk, item-index)
            all-registered = false
        .. lacks-glyph-handle = (item.flags /and/ display-item-has-glyph-handle) == 0
    else if item.kind == DisplayItemKind.image
        . handle = ImageHandle(item.data0, item.data1)
        . full = display-item-full(item-index, chunk.side)
        . moves = display-item-moves(item-index, chunk.side)
        . exact = display-matrix-is-axis-aligned(full)
        . has-source = false
        if !exact || moves
            has-source = renderer.register-display-image-source(resource-table, handle)
            if !has-source
                all-registered = false
        if exact
            . rect = display-item-rect(item)
            . device = Rect(rect.x, rect.y, rect.width * full.a, rect.height * full.d)
            if !renderer.register-display-image(resource-table, handle, device) && !has-source
                all-registered = false
        if moves
            movable = true
    else if item.kind == DisplayItemKind.canvas-image
        . image = chunk.side!.images[item.aux]
        . serial = (item.data0 as U64) /or/ ((item.data1 as U64) /lshift/ 32)
        . template-alpha = (item.flags /and/ display-item-template-alpha) != 0
        . full = display-item-full(item-index, chunk.side)
        . moves = display-item-moves(item-index, chunk.side)
        . exact = display-matrix-is-axis-aligned(full)
        . rect = display-item-rect(item)
        . scaling = full.scaling
        . scaled = display-image-scaled
            - image
            - rect.width * abs(scaling.width) * scale
            - rect.height * abs(scaling.height) * scale
        .. uses-texture = display-image-uses-texture(image, item.value)
        if image.is-gpu-resident || uses-texture || (scaled && !template-alpha)
            . state = renderer.register-canvas-texture(image)
            if state == TextureResidency.missing
                all-registered = false
            else if state == TextureResidency.pending
                pending = true
        else
            . has-source = false
            if !exact || moves
                has-source = renderer.register-canvas-image-source(image, serial, template-alpha)
                if !has-source
                    all-registered = false
            if exact
                . device = Rect(rect.x, rect.y, rect.width * full.a, rect.height * full.d)
                . registered = renderer.register-canvas-image(image, serial, device, template-alpha)
                if !registered && !has-source
                    all-registered = false
        if moves
            movable = true
    else if item.kind == DisplayItemKind.canvas-pattern
        . image = chunk.side!.images[item.aux]
        if !image.is-gpu-resident && !display-pattern-fits-texture(image)
            all-registered = false
        else
            . state = renderer.register-canvas-texture(image)
            if state == TextureResidency.missing
                all-registered = false
            else if state == TextureResidency.pending
                pending = true
        if display-item-moves(item-index, chunk.side)
            movable = true
    item-index += 1
. side = chunk.side
if side
    for state in side.states
        if state.kind == DisplayStateKind.clip-mask
            if !renderer.register-canvas-image-source(side.images[state.image], state.serial, true)
                all-registered = false
if pending && all-registered
    pending-texture-chunks += chunk
if all-registered && !movable && !pending
    chunk.metal-resource-renderer = renderer.native
    chunk.metal-resource-epoch = current-metal-resource-epoch
= all-registered

────────────────────
_ do register-chunk-glyph Bool
    - chunk DisplayChunk
    - item-index Size

. registrar = glyph-registrar
=? false if !registrar
. layout = chunk.glyph-layouts![chunk.item-glyph-layouts[item-index] as Size]
. registration = registrar.register-display-glyph(layout)
=? false if !registration
. item = chunk.items[item-index]
chunk.items[item-index] = DisplayItem
    - item.kind
    - item.flags /or/ display-item-has-glyph-handle
    - item.aux
    - item.x
    - item.y
    - item.width
    - item.height
    - item.value
    - registration.index
    - registration.generation
    - item.data2
    - item.data3
. handles = chunk.glyph-handles ?? List'DisplayGlyphHandle()
chunk.glyph-handles = handles
handles += registration
= true

────────────────────
_ display-item-full
    - item-index Size
    - side DisplayChunkSide?

|? !side
    Matrix()
??
    side.states[side.item-states[item-index]].full

────────────────────
_ do display-item-moves
    - item-index Size
    - side DisplayChunkSide?

=? false if !side
. cursor = side.item-states[item-index]
while cursor != 0
    . kind = side.states[cursor].kind
    =? true if kind == DisplayStateKind.transform || kind == DisplayStateKind.content
    cursor = side.states[cursor].parent
= false

────────────────────
_ do register-metal-opaque-tile
    - chunk DisplayChunk
    - rect Rect
    - renderer MetalOffscreenRenderer
    - key U64

. width = rect.width as I32
. height = rect.height as I32
=? 0u64 if width <= 0 || height <= 0
. surface = metal-tile-canvas(width, height, renderer.scale)
surface.push()
surface.translate(-rect.x, -rect.y)
if chunk.is-opaque || chunk.needs-tile
    replay-commands(chunk, surface)
else
    draw-chunk-items(chunk, surface, rect)
surface.pop()
= renderer.tile-upsert(key, chunk.record-generation, surface, rect.width, rect.height)

────────────────────
_ do metal-tile-canvas
    - width I32
    - height I32
    - pixel-scale F64

for index in 0 .. < metal-tile-canvases.length
    . pooled = metal-tile-canvases[index]
    if pooled.width == width && pooled.height == height && pooled.scale == pixel-scale
        metal-tile-canvas-frames[index] = metal-frames-encoded
        pooled.erase(transparent)
        = pooled
if metal-tile-canvases.length >= metal-tile-canvas-limit
    metal-tile-canvases[0].close()
    metal-tile-canvases.remove(0)
    metal-tile-canvas-frames.remove(0)
. created = RasterCanvas(width, height, pixel-scale)
metal-tile-canvases += created
metal-tile-canvas-frames += metal-frames-encoded
= created

────────────────────
_ do trim-metal-tile-canvases

. index Size
while index < metal-tile-canvases.length
    if metal-tile-canvas-frames[index] + 1 < metal-frames-encoded
        metal-tile-canvases[index].close()
        metal-tile-canvases.remove(index)
        metal-tile-canvas-frames.remove(index)
    else
        index += 1

────────────────────
_ do release-chunk-key
    - chunk DisplayChunk

chunk.is-live = false
chunk.live-epoch = null
=? if !current-metal-resource-renderer || releases-all-chunks
released-chunk-keys += (chunk as Pointer).address

────────────────────
_ do flush-released-chunks
    - renderer MetalOffscreenRenderer

if releases-all-chunks
    renderer.release-all-chunks()
    releases-all-chunks = false
for key in released-chunk-keys
    renderer.release-chunk(key)
released-chunk-keys.clear()

────────────────────
_ do draw-chunk
    - chunk DisplayChunk
    - surface RasterCanvas
    - local-damage Rect

chunks-drawn += 1
if chunk.is-opaque
    replay-commands(chunk, surface, local-damage)
    =
draw-chunk-items(chunk, surface, local-damage)

────────────────────
_ do draw-chunk-items
    - chunk DisplayChunk
    - surface RasterCanvas
    - local-damage Rect

. side = chunk.side
if !side
    . index Size
    while index < chunk.items.length
        draw-item(chunk, chunk.items[index], index, surface)
        index += 1
    =
. table = side
replay-states.clear()
. index Size
while index < chunk.items.length
    . state = table.item-states[index]
    . hidden = table.mask-layers > 0 && table.mask-owner(state) != 0
    if !hidden && !display-item-culled(table, state, table.item-inks[index], local-damage)
        sync-replay-state(chunk, table, state, surface)
        draw-item(chunk, chunk.items[index], index, surface)
    index += 1
unwind-replay-states(table, 0, surface)

────────────────────
_ do sync-replay-state
    - chunk DisplayChunk
    - table DisplayChunkSide
    - state U32
    - surface RasterCanvas

=? if replay-states.length > 0 && replay-states[replay-states.length - 1] == state
=? if replay-states.length == 0 && state == 0
replay-path.clear()
. cursor = state
while cursor != 0
    replay-path += cursor
    cursor = table.states[cursor].parent
. depth Size
while depth < replay-states.length && depth < replay-path.length
    if replay-states[depth] != replay-path[replay-path.length - 1 - depth]
        break
    depth += 1
unwind-replay-states(table, depth, surface)
while replay-states.length < replay-path.length
    . next = replay-path[replay-path.length - 1 - replay-states.length]
    apply-replay-state(chunk, table, table.states[next], surface)
    replay-states += next

────────────────────
_ do replay-mask
    - chunk DisplayChunk
    - table DisplayChunkSide
    - source U32
    - surface RasterCanvas

. outer-path = replay-path
replay-path = List'U32()
. depth = replay-states.length
surface.begin-mask()
. index Size
while index < chunk.items.length
    . state = table.item-states[index]
    if table.mask-owner(state) == source
        sync-replay-state(chunk, table, state, surface)
        draw-item(chunk, chunk.items[index], index, surface)
    index += 1
unwind-replay-states(table, depth, surface)
surface.end-mask()
replay-path = outer-path

────────────────────
_ do unwind-replay-states
    - table DisplayChunkSide
    - depth Size
    - surface RasterCanvas

while replay-states.length > depth
    . state = replay-states.pop()
    . kind = table.states[state].kind
    if kind == DisplayStateKind.layer
        surface.end-opacity()
    else if kind == DisplayStateKind.blur
        surface.end-blur()
    surface.pop()

────────────────────
_ do apply-replay-state
    - chunk DisplayChunk
    - table DisplayChunkSide
    - state DisplayState
    - surface RasterCanvas

surface.push()
. kind = state.kind
if kind == DisplayStateKind.transform || kind == DisplayStateKind.content
    surface.transform(state.matrix)
else if kind == DisplayStateKind.clip
    surface.clip(state.rect)
else if kind == DisplayStateKind.clip-outline
    surface.clip-outline(display-state-outline(state))
else if kind == DisplayStateKind.clip-path
    surface.begin()
    trace-display-path(table, state.path-start, state.path-count, state.coord-start, surface)
    surface.clip-path(state.fill-rule)
else if kind == DisplayStateKind.layer
    surface.begin-opacity(state.opacity)
else if kind == DisplayStateKind.blur
    surface.begin-blur(state.radius)
else if kind == DisplayStateKind.clip-mask
    surface.clip-mask(table.images[state.image], state.rect)
else if kind == DisplayStateKind.clip-layer-mask
    replay-mask(chunk, table, state.source, surface)
else if kind == DisplayStateKind.blend
    surface.blend-mode = state.blend

────────────────────
_ do trace-display-path
    - table DisplayChunkSide
    - start U32
    - count U32
    - coord-start U32
    - surface RasterCanvas

surface.trace-path-buffer
    - table.path-verbs.buffer-pointer + (start as Index)
    - count
    - table.path-coords.buffer-pointer + (coord-start as Index)

────────────────────
_ do draw-item
    - chunk DisplayChunk
    - item DisplayItem
    - item-index Size
    - surface RasterCanvas

items-drawn += 1
//gui.frame.visible-display-items ++
. rect = chunk.item-rect(item-index, item)
if item.kind == DisplayItemKind.quad
    surface.fill-color = chunk.item-color(item-index, item.data0)
    surface.stroke-color = null
    if (item.flags /and/ display-item-has-shape) != 0
        surface.outline(display-shape-outline(rect, chunk.shapes[item.data1]))
    else
        surface.rect(rect)
else if item.kind == DisplayItemKind.border
    surface.fill-color = null
    surface.stroke-color = chunk.item-color(item-index, item.data0)
    . width = chunk.item-value(item-index, item)
    surface.stroke-width = width
    surface.stroke-join = LineJoin.miter
    surface.stroke-dash = 0
    if (item.flags /and/ display-item-has-shape) != 0
        . outer = display-shape-outline(rect, chunk.shapes[item.data1])
        if item.aux == 1
            do use surface.saved-state
                surface.clip-outline(outer)
                surface.outline(outer.grow(-width / 2))
        else
            surface.outline(outer.grow(-width / 2))
    else
        surface.rect(rect)
else if item.kind == DisplayItemKind.shadow
    . shape = chunk.shapes[item.data1]
    . color = chunk.item-color(item-index, item.data0)
    surface.shadow
        - display-shape-outline(rect, shape)
        - Shadow(color, shape.blur, shape.x, shape.y, shape.spread)
else if item.kind == DisplayItemKind.glyph
    do use surface.saved-state
        if (item.flags /and/ display-item-has-clip) != 0
            surface.clip(chunk.clips[item.data3])
        surface.text-color = chunk.item-color(item-index, item.data2)
        . layout-index = chunk.item-glyph-layouts[item-index]
        surface.text-fill = still-fill(chunk, chunk.glyph-fills![layout-index])
        surface.draw-text(chunk.glyph-layouts![layout-index], rect, display-alignment(item.aux))
else if item.kind == DisplayItemKind.vector
    draw-vector-item(chunk, item, item-index, surface)
else if item.kind == DisplayItemKind.styled
    draw-styled-item(chunk, item, rect, surface)
else if item.kind == DisplayItemKind.backdrop
    surface.backdrop-blur-in-clip(rect, item.value)
else if item.kind == DisplayItemKind.backdrop-shader
    surface.backdrop-shader-in-clip
        - rect
        - still-backdrop(chunk, chunk.side!.backdrop-shaders[item.data0])
        - item.value
else if item.kind == DisplayItemKind.canvas-image
    . table = chunk.side!
    do use surface.saved-state
        if (item.flags /and/ display-item-has-clip) != 0
            surface.clip(chunk.clips[item.data3])
        . has-tint = (item.flags /and/ display-item-has-tint) != 0
        surface.fill-color = chunk.item-color(item-index, item.data2) if has-tint
        . is-template = (item.flags /and/ display-item-template-alpha) != 0
        . sampling = if item.value > 0 then ImageSampling.pixelated else ImageSampling.smooth
        surface.draw-image(table.images[item.aux], rect, is-template, sampling)
else if item.kind == DisplayItemKind.canvas-pattern
    do use surface.saved-state
        if (item.flags /and/ display-item-has-clip) != 0
            surface.clip(chunk.clips[item.data3])
        . sampling = if item.value > 0 then ImageSampling.pixelated else ImageSampling.smooth
        surface.fill-image(chunk.side!.images[item.aux], rect, chunk.clips[item.data2], sampling)
else if item.kind == DisplayItemKind.image
    . resource = resource-table.resolve-image(ImageHandle(item.data0, item.data1))
    if resource
        . tint RGBA?
        if (item.flags /and/ display-item-has-tint) != 0
            tint = chunk.item-color(item-index, item.data2)
        resource.draw • destination surface
            - rect
            - tint

────────────────────
_ do draw-styled-item
    - chunk DisplayChunk
    - item DisplayItem
    - rect Rect
    - surface RasterCanvas

. table = chunk.side!
. style = table.path-styles[item.data3]
. has-clip = (item.flags /and/ display-item-has-clip) != 0
if has-clip
    surface.push()
    surface.clip(chunk.clips[item.aux])
surface.fill-color = style.fill
surface.stroke-color = style.stroke
surface.stroke-width = style.stroke-width
surface.stroke-cap = style.stroke-cap
surface.stroke-join = style.stroke-join
surface.stroke-dash = style.stroke-dash
. op = item.value as U8
if style.shape-fill
    surface.shape-fill = still-fill(chunk, style.shape-fill)
    surface.begin()
    trace-display-path(table, item.data0, item.data1, item.data2, surface)
    surface.end(style.closed, style.fill-rule)
    surface.shape-fill = null
else if style.gradient
    surface.fill-gradient(rect, style.gradient)
else if style.shader
    surface.fill-shader(rect, style.shader, style.shader-args!)
else if op == DisplayStyledShape.rect
    surface.rect(rect)
else if op == DisplayStyledShape.oval
    surface.oval(rect)
else if style.shadow
    surface.begin()
    trace-display-path(table, item.data0, item.data1, item.data2, surface)
    surface.shadow-path(style.shadow)
else
    surface.fill-paint = style.paint
    surface.stroke-brush = style.brush
    surface.begin()
    trace-display-path(table, item.data0, item.data1, item.data2, surface)
    surface.end(style.closed, style.fill-rule)
    surface.fill-paint = null
    surface.stroke-brush = null
if has-clip
    surface.pop()

────────────────────
_ do draw-vector-item
    - chunk DisplayChunk
    - item DisplayItem
    - item-index Size
    - surface RasterCanvas

. handle = VectorGeometryHandle(item.data0, item.data1)
. geometry = resource-table.require(handle)
. view = geometry.view-box
=? if view.width <= 0 || view.height <= 0
. transform = chunk.item-transform(item-index)!
. colors = chunk.side!.vector-colors
do use surface.saved-state
    if (item.flags /and/ display-item-has-clip) != 0
        surface.clip(chunk.clips[item.aux])
    . inherited-offset = item.data2 + item.data3
    if (item.flags /and/ display-item-has-inherited-fill) != 0
        surface.fill-color = colors[inherited-offset]
        inherited-offset += 1
    else
        surface.fill-color = null
    if (item.flags /and/ display-item-has-inherited-stroke) != 0
        surface.stroke-color = colors[inherited-offset]
    else
        surface.stroke-color = null
    surface.stroke-width = chunk.item-value(item-index, item)
    . style-index = chunk.side!.item-styles[item-index]
    if style-index != 4294967295
        . style = chunk.side!.path-styles[style-index]
        surface.stroke-cap = style.stroke-cap
        surface.stroke-join = style.stroke-join
        surface.stroke-dash = style.stroke-dash
    . cached = resource-table.paint-vector-cached
        - handle
        - surface
        - colors
        - item.data2
        - item.data3
        - transform
    if !cached
        surface.transform(transform)
        geometry.paint-offset(surface, colors, item.data2)

────────────────────
_ still-fill ShaderFill?
    - chunk DisplayChunk
    - fill ShaderFill?

|? !fill
    null
|? !fill.is-live
    fill
??
    ShaderFill(fill.shader, fill.args, true, fill.frame-rate, max(0, recorder.live-time - epoch))

.. epoch = chunk.live-epoch ?? recorder.live-time

────────────────────
_ still-backdrop ShaderFilter
    - chunk DisplayChunk
    - backdrop ShaderFilter

|? !backdrop.is-live || !chunk.owner.$animates-fills
    backdrop
??
    ShaderFilter
        - backdrop.shader
        - backdrop.args
        - backdrop.images
        - true
        - backdrop.frame-rate
        - max(0, recorder.live-time - epoch)
        - backdrop.arg-kinds

.. epoch = chunk.live-epoch ?? recorder.live-time

────────────────────
_ do command-text-fill ShaderFill?
    - chunk DisplayChunk
    - layout TextLayout

. layouts = chunk.glyph-layouts
=? null if !layouts
for index in 0 .. < layouts.length
    =? still-fill(chunk, chunk.glyph-fills![index]) if same-layout
    .. same-layout = layouts[index] as Pointer == layout as Pointer
= null

────────────────────
_ do replay-commands
    - chunk DisplayChunk
    - surface RasterCanvas
    - local-damage Rect? = null

. side = chunk.side
. commands = chunk.commands
=? if !commands
. index Size
while index < commands.length
    . command = commands[index]
    if command.kind == DisplayCommandKind.push
        surface.push()
    else if command.kind == DisplayCommandKind.pop
        surface.pop()
    else if command.kind == DisplayCommandKind.clip
        surface.clip(command.rect)
    else if command.kind == DisplayCommandKind.clip-path
        . state = side!.states[command.item-index]
        surface.begin()
        trace-display-path(side!, state.path-start, state.path-count, state.coord-start, surface)
        surface.clip-path(state.fill-rule)
    else if command.kind == DisplayCommandKind.clip-mask
        surface.clip-mask(command.image!, command.rect)
    else if command.kind == DisplayCommandKind.begin-mask
        surface.begin-mask()
    else if command.kind == DisplayCommandKind.end-mask
        surface.end-mask()
    else if command.kind == DisplayCommandKind.blend
        surface.blend-mode = command.blend
    else if command.kind == DisplayCommandKind.clip-outline
        surface.clip-outline(display-command-outline(command))
    else if command.kind == DisplayCommandKind.transform
        surface.transform(command.matrix)
    else if command.kind == DisplayCommandKind.rect
        apply-command-state(command, surface)
        surface.rect(command.rect)
    else if command.kind == DisplayCommandKind.oval
        apply-command-state(command, surface)
        surface.oval(command.rect)
    else if command.kind == DisplayCommandKind.gradient
        surface.fill-gradient(command.rect, command.gradient!)
    else if command.kind == DisplayCommandKind.shader
        surface.fill-shader(command.rect, command.shader!, command.shader-args!)
    else if command.kind == DisplayCommandKind.begin-filter
        surface.begin-filter
            - command.rect
            - ShaderFilter(command.shader!, command.shader-args!, command.shader-images!)
    else if command.kind == DisplayCommandKind.end-filter
        surface.end-filter()
    else if command.kind == DisplayCommandKind.text
        surface.text-color = command.fill ?? transparent
        surface.text-fill = command-text-fill(chunk, command.layout!)
        surface.draw-text(command.layout!, command.rect, command.alignment)
    else if command.kind == DisplayCommandKind.image
        surface.fill-color = command.fill
        surface.draw-image(command.image!, command.rect, command.flag, command.sampling)
    else if command.kind == DisplayCommandKind.image-pattern
        . tile = Rect(command.point1.x, command.point1.y, command.point2.x, command.point2.y)
        surface.fill-image(command.image!, command.rect, tile, command.sampling)
    else if command.kind == DisplayCommandKind.item
        . item-index = command.item-index as Size
        . visible = !local-damage || !side || side.item-states[item-index] != 0
        if visible || !display-item-culled(side!, 0, side!.item-inks[item-index], local-damage!)
            draw-item
                - chunk
                - chunk.items[item-index]
                - item-index
                - surface
    else if command.kind == DisplayCommandKind.frame
        replay-frame-items(chunk, command, surface)
    else if command.kind == DisplayCommandKind.erase
        surface.erase(command.fill)
    else if command.kind == DisplayCommandKind.begin-opacity
        surface.begin-opacity(command.point1.x)
    else if command.kind == DisplayCommandKind.end-opacity
        surface.end-opacity()
    else if command.kind == DisplayCommandKind.begin-blur
        surface.begin-blur(command.point1.x)
    else if command.kind == DisplayCommandKind.end-blur
        surface.end-blur()
    index += 1

────────────────────
_ do replay-frame-items
    - chunk DisplayChunk
    - command DisplayCommand
    - surface RasterCanvas

. table = chunk.side!
. outer = command.point1.y as U32
. first = command.item-index as Size
. count = command.point1.x as Size
replay-states.clear()
replay-path.clear()
. cursor = outer
while cursor != 0
    replay-path += cursor
    cursor = table.states[cursor].parent
while replay-path.length > 0
    replay-states += replay-path.pop()
. depth = replay-states.length
for index in first .. < first + count
    . state = table.item-states[index]
    . hidden = table.mask-layers > 0 && table.mask-owner(state) > outer
    if !hidden
        sync-replay-state(chunk, table, state, surface)
        draw-item(chunk, chunk.items[index], index, surface)
unwind-replay-states(table, depth, surface)
replay-states.clear()

────────────────────
_ do apply-command-state
    - command DisplayCommand
    - surface RasterCanvas

surface.fill-color = command.fill
surface.stroke-color = command.stroke
surface.stroke-width = command.stroke-width
surface.stroke-cap = command.stroke-cap
surface.stroke-join = command.stroke-join
surface.stroke-dash = command.stroke-dash

────────────────────
_ do first-member-toward
    - members [DisplayEntry]
    - order DisplayOrder
    - local-damage Rect

=? 0 if order.axis == DisplayAxis.none || members.length == 0
. head = display-entry-bounds(members[0])
=? 0 if !head.is-empty && !display-order-before(order, head, local-damage)
. low Size
. high = members.length
while low < high
    cull-tests += 1
    //gui.scene.cull-tests ++
    . middle = (low + high) / 2
    . probe = middle
    . bounds = display-entry-bounds(members[probe])
    while bounds.is-empty && probe + 1 < high
        probe += 1
        bounds = display-entry-bounds(members[probe])
    if !bounds.is-empty && display-order-before(order, bounds, local-damage)
        low = probe + 1
    else
        high = middle
= low

────────────────────
_ do window-bounds
    - local Rect
    - parent DisplayGroup?

. result = local
. group = parent
while group
    . transform = group.transform
    if transform
        result = transform.transform(result)
    if group.has-clip
        result = (result + group.translation).intersection(group.clip)
    group = group.parent
= result

────────────────────
_ align-damage-to-device
    - rect Rect

Rect(left, top, right - left, bottom - top)

.. left = floor(rect.left * scale) / scale
.. top = floor(rect.top * scale) / scale
.. right = ceil(rect.right * scale) / scale
.. bottom = ceil(rect.bottom * scale) / scale

━━━━━━━━━━━━━━━━━━━━
+ do draw-display-frame Bool
    - canvas Canvas
    - frame DisplayFrame
    - shaders [U32 = Shader]
    - placement Matrix
    - bounds Rect

do match? canvas
    | recorder DisplayRecorder
        = recorder.draw-frame(frame, shaders, placement, bounds)
    | raster RasterCanvas
        . replay = display-frame-replay
        . chunk = replay.chunk
        chunk.reset()
        . recorder = replay.scene.recorder
        recorder.begin-chunk(chunk)
        . drawn = recorder.draw-frame(frame, shaders, placement, bounds)
        recorder.end-chunk()
        if drawn
            replay.scene.draw-chunk
                - chunk
                - raster
                - Rect(-1000000000, -1000000000, 2000000000, 2000000000)
        = drawn
= false

━━━━━━━━━━━━━━━━━━━━
+ do draw-display-sprite Bool
    - canvas Canvas
    - sprite DisplaySprite
    - pixel-scale F64? = null
    - sampling = ImageSampling.smooth

do match? canvas
    | recorder DisplayRecorder
        = recorder.draw-sprite(sprite, pixel-scale, sampling)
= false

━━━━━━━━━━━━━━━━━━━━
+ do display-frame-format U64

. hash = display-frame-magic
for index in 0 .. < display-frame-table-count
    hash = (hash /xor/ ((index as DisplayFrameTable).width as U64)) * 11400714819323198485
    hash = hash /xor/ (hash /rshift/ 29)
= hash

━━━━━━━━━━━━━━━━━━━━
+ merged-live-fills LiveFillState
    - first LiveFillState
    - second LiveFillState

|? !second.is-visible
    LiveFillState(first.is-visible, first.frame-rate, wake)
|? !first.is-visible
    LiveFillState(true, second.frame-rate, wake)
??
    LiveFillState(true, rate, wake)

.. wake = if first.wake-at != null && second.wake-at != null then earlier-wake else any-wake
.. earlier-wake = min(first.wake-at, second.wake-at)
.. any-wake = first.wake-at ?? second.wake-at
.. rate = higher-rate if first.frame-rate != null && second.frame-rate != null
.. higher-rate = max(first.frame-rate, second.frame-rate)

━━━━━━━━━━━━━━━━━━━━
_ DisplayItemKind is U8

| quad
| border
| glyph
| vector
| image
| opaque
| shadow = 7
| styled = 8
| canvas-image = 9
| backdrop = 10
| canvas-pattern = 11
| sprite = 12
| backdrop-shader = 13

━━━━━━━━━━━━━━━━━━━━
_ DisplayStyledShape is U8

| rect
| oval
| path

━━━━━━━━━━━━━━━━━━━━
_ DisplayStateKind is U8

| root
| transform
| content
| clip
| clip-outline
| clip-path
| layer
| clip-mask
| mask-layer
| clip-layer-mask
| blend
| blur

━━━━━━━━━━━━━━━━━━━━
_ DisplayPathVerb is U8

| move
| line
| curve
| enclose

━━━━━━━━━━━━━━━━━━━━
_ DisplayPhase is U8

| pre
| post

━━━━━━━━━━━━━━━━━━━━
_ DisplayAxis is U8

| none
| vertical
| horizontal

━━━━━━━━━━━━━━━━━━━━
_ DisplayCommandKind is U8

| push
| pop
| clip
| transform
| rect
| oval
| text
| image
| vector
| erase
| item = 16
| clip-path = 17
| clip-outline = 19
| gradient = 20
| begin-opacity = 21
| end-opacity = 22
| clip-mask = 23
| begin-mask = 24
| end-mask = 25
| blend = 26
| begin-blur = 27
| end-blur = 28
| shader = 29
| begin-filter = 30
| end-filter = 31
| image-pattern = 32
| frame = 33

━━━━━━━━━━━━━━━━━━━━
_ DisplayState is Tuple

+ parent U32
+ kind U8
+ matrix Matrix = Matrix()
+ rect Rect = display-no-rect
+ radius F64
+ side F64
+ offset F64
+ size F64
+ path-start U32
+ path-count U32
+ coord-start U32
+ fill-rule FillRule = FillRule.nonzero
+ opacity F64 = 1
+ full Matrix = Matrix()
+ clip-bounds Rect = display-no-rect
+ has-clip-bounds = false
+ local-ink Rect = display-no-rect
+ has-local-ink = false
+ image U32
+ serial U64
+ source U32
+ blend = BlendMode.normal

