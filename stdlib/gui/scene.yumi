_ display-damage-area-limit Size = 4
_ display-backdrop-pixel-reach F64 = 1
_ display-gradient-linear U32 = 1
_ display-gradient-radial U32 = 2
_ display-gradient-conic U32 = 3
_ display-gradient-shader U32 = 4
_ display-gradient-paint U32 = 5
_ display-gradient-brush U32 = 6
_ display-frame-magic U64 = 3550328824200053849u64
_ display-frame-table-count Size = (DisplayFrameTable.args as Size) + 1
_ display-frame-header-bytes Size = 32 + display-frame-table-count * 16
_ display-culling-item-count Size = 32
_ display-texture-image-threshold I32 = 512
_ display-pattern-texture-limit I32 = 2048
_ display-unknown-ink = Rect(0, 0, -1, -1)
_ display-item-has-clip U8 = 1
_ display-item-has-glyph-handle U8 = 2
_ display-item-has-tint U8 = 4
_ display-item-has-inherited-fill U8 = 8
_ display-item-has-inherited-stroke U8 = 16
_ display-item-template-alpha U8 = 32
_ display-item-has-shape U8 = 64
_ display-item-has-transform U8 = 128
_ display-no-rect = Rect(0, 0, 0, 0)
_ display-no-anchor = DisplayAnchor(null, true)
_ display-unknown-anchor = DisplayAnchor(null, false)
_ display-scene-generation U32
_ display-record-generation U32
_ metal-tile-canvas-limit Size = 4
_ raster-tile-pixels I32 = 512
_ display-sprite-serial U64
_ display-sprite-step F64 = 0.17328679513998632
_ display-frame-replay := DisplayFrameReplay()
_ display-sprite-recorder := DisplayRecorder()
_ display-sprite-owner := Box()

+ LiveFillState is (is-visible Bool, frame-rate F64?, wake-at F64?)
_ RasterView is (offset Point, clip Rect?)
_ RasterSpan is (left I32, top I32, right I32, bottom I32)
_ RasterTile is (chunk DisplayChunk, column I32, row I32, generation U32)
_ DisplaySpriteWant is (sprite DisplaySprite, key U64, generation U32, pixel-scale F64)
_ DisplayEntry is (chunk DisplayChunk?, group DisplayGroup?)
_ DisplayAnchor is (entry DisplayEntry?, known Bool)
_ DisplayOrder is (axis U8, start-lag F64, end-lag F64)
_ DisplayRefill is (nodes [DisplayBoxNode], members [DisplayEntry])
_ SavedDisplayClip is (rect Rect, has Bool, shape Outline?, state U32)

━━━━━━━━━━━━━━━━━━━━
+ DisplayItem is Tuple

+ kind U8
+ flags U8
+ aux U16
+ x F32
+ y F32
+ width F32
+ height F32
+ value F32
+ data0 U32
+ data1 U32
+ data2 U32
+ data3 U32

━━━━━━━━━━━━━━━━━━━━
+ DisplayShape is Tuple

+ radius F32
+ side F32
+ offset F32
+ size F32
+ blur F32
+ x F32
+ y F32
+ spread F32

━━━━━━━━━━━━━━━━━━━━
+ DisplayRecorder is Canvas

+ unsupported-calls Size
+ sprite-chunks [DisplayChunk]
+ live-time F64

_ chunk DisplayChunk?
_ recorded-commands [DisplayCommand]
_ clip-rect Rect
_ has-clip-rect = false
_ clip-stack [SavedDisplayClip]
_ clip-shape Outline?
_ current-state U32
_ path-open = false
_ path-start U32
_ path-coord-start U32
_ recording-scale F64 = 1
_ glyph-registrar DisplayGlyphRegistrar?
_ resource-table VectorGeometryTable?

────────────────────
+ This

super(0, 0)

────────────────────
+ get blend-mode

chunk?.side?.blend-at(current-state) ?? BlendMode.normal

────────────────────
+ get scale

recording-scale

────────────────────
+ do blend-mode = mode BlendMode

=? if !chunk || blend-mode == mode
. command = DisplayCommand(DisplayCommandKind.blend)
recorded-commands += command.blend = mode
. state = DisplayState(0, DisplayStateKind.blend)
enter-state(state.blend = mode)

────────────────────
+ do push

if chunk
    recorded-commands += DisplayCommand(DisplayCommandKind.push)
clip-stack += SavedDisplayClip(clip-rect, has-clip-rect, clip-shape, current-state)
super.push()

────────────────────
+ do pop

if chunk
    recorded-commands += DisplayCommand(DisplayCommandKind.pop)
if clip-stack.length > 0
    . saved = clip-stack.pop()
    clip-rect = saved.rect
    has-clip-rect = saved.has
    clip-shape = saved.shape
    current-state = saved.state
super.pop()

