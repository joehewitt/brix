    candidate.close()

────────────────────
+ do close

. target = scene
if target
    target.release-chunk-glyph-handles(chunk!)
    target.close()
. gpu = renderer
if gpu
    gpu.close()
scene = null
chunk = null
renderer = null
canvas.close()

────────────────────
+ get uses-gpu Bool

renderer != null

────────────────────
+ do begin Canvas

. target = scene
if !target
    canvas.erase(background)
    = canvas
. current = chunk!
target.release-chunk-glyph-handles(current)
current.reset()
target.recorder.begin-chunk(current)
= target.recorder

────────────────────
+ do end Bool

. target = scene
=? true if !target
. current = chunk!
target.recorder.end-chunk()
=? false if !target.frame-metal-chunk(current, renderer!)
= renderer!.read-into(canvas)

━━━━━━━━━━━━━━━━━━━━
