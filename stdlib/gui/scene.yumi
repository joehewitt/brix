. kept Size = 0
. visible = false
. rate = 0.0
. is-capped = true
. wake F64? = null
for index in 0 .. < live-chunks.length
    . chunk = live-chunks[index]
    if chunk.is-live && chunk.owner.frame-clock
        live-chunks[kept] = chunk
        kept += 1
        if chunk.has-bounds && chunk.owner.is-paint-visible
            . bounds = window-bounds(chunk.bounds, chunk.parent).intersection(view)
            if bounds.width > 0 && bounds.height > 0
                . resting = live-resting(chunk.live-cycle, chunk.live-epoch)
                if resting && chunk.is-live-settled
                    wake = earliest-wake(wake, live-wake(chunk.live-cycle!, chunk.live-epoch!))
                else
                    if !resting
                        chunk.is-live-settled = false
