────────────────────
+ This
    - width I32
    - height I32
    - scale F64 = 1
    - clear-background RGBA = white

background = clear-background
canvas = RasterCanvas(width, height, scale, clear-background)
. candidate = MetalOffscreenRenderer(width, height, scale, clear-background, true)
if candidate.is-available
    renderer = candidate
    scene = DisplayScene(scale, clear-background, candidate)
    chunk = DisplayChunk(Box(), DisplayPhase.pre)
