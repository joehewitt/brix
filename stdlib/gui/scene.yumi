for index in 0 .. < live-groups.length
    . group = live-groups[index]
    if group.is-live && group.owner.frame-clock
        live-groups[kept-groups] = group
        kept-groups += 1
        if group.has-outer && group.owner.is-paint-visible
            . bounds = window-bounds(group.outer, group.parent).intersection(view)
            if bounds.width > 0 && bounds.height > 0
                . resting = live-resting(group.live-cycle, group.live-epoch)
                if resting && group.is-live-settled
                    wake = earliest-wake(wake, live-wake(group.live-cycle!, group.live-epoch!))
