=? if !chunk
. current = chunk
. fill = recorded-fill(current, text-fill)
promote-root-clip()
recorded-commands += DisplayCommand
    - DisplayCommandKind.text
    - rect
    - Point(0, 0)
    - Point(0, 0)
    - Point(0, 0)
    - Matrix()
    - text-color
    - null
    - 0
    - LineCap.butt
    - LineJoin.miter
    - layout
    - null
    - alignment
    - false
    - FillRule.nonzero
    - 0
    - null
    - 0
    - BlendMode.normal
    - fill?.shader
    - fill?.args

. flags U8
. layout-index = current.add-glyph-layout(layout, fill)
. paint = if fill then record-text-fill(current, fill, layout, rect, alignment) else 0
if root-clip-active
    flags = flags /or/ display-item-has-clip
. item = display-item(DisplayItemKind.glyph, rect, paint, layout-index, 0, pack-rgba8(text-color))
item = DisplayItem
    - item.kind
    - flags
    - display-alignment-code(alignment)
    - item.x
    - item.y
    - item.width
    - item.height
    - item.value
    - item.data0
    - item.data1
    - item.data2
    - 0
if root-clip-active
    . clip-index = current.clips.length as U32
    current.clips += clip-rect
    item = DisplayItem
        - item.kind
        - item.flags
        - item.aux
        - item.x
        - item.y
        - item.width
        - item.height
        - item.value
        - item.data0
        - item.data1
        - item.data2
        - clip-index
. item-index = current.add-item(item, root-ink(rect), current-state)
current.item-glyph-layouts[item-index] = layout-index
current.set-item-color(item-index, text-color)
current.set-item-exact(item-index, rect, 0)

────────────────────
+ do record-vector-geometry
    - index U32
    - generation U32
    - palette [RGBA]
    - transform Matrix
    - clip Rect?

=? false if !chunk
. current = chunk
. table = resource-table
=? false if !table
. geometry = table.resolve(VectorGeometryHandle(index, generation))
=? false if !geometry
. view = geometry.view-box
=? false if view.width <= 0 || view.height <= 0
promote-root-clip()
. rect = transform.transform(view)
. offset = current.vector-palette.length as U32
for color in palette
    current.add-vector-color(color)
. flags U8 = display-item-has-transform
. aux U16
if fill-color
    flags = flags /or/ display-item-has-inherited-fill
    current.add-vector-color(fill-color!)
if stroke-color
    flags = flags /or/ display-item-has-inherited-stroke
    current.add-vector-color(stroke-color!)
. ink = clip ?? rect
. has-item-clip = root-clip-active || clip != null
. item-clip = clip ?? clip-rect
if root-clip-active && clip
    item-clip = clip-rect.intersection(clip)
if has-item-clip
    flags = flags /or/ display-item-has-clip
    aux = current.clips.length as U16
    current.clips += item-clip
    ink = ink.intersection(item-clip)
. item = display-item
    - DisplayItemKind.vector
    - rect
    - stroke-width
    - index
    - generation
    - offset
    - palette.length as U32
item = DisplayItem
    - item.kind
    - flags
    - aux
    - item.x
    - item.y
    - item.width
    - item.height
    - item.value
    - item.data0
    - item.data1
    - item.data2
    - item.data3
. item-index = current.add-item(item, ink, current-state)
current.set-item-transform(item-index, transform)
current.set-item-exact(item-index, display-item-rect(item), stroke-width)
. styles = current.side!
styles.has-antialiased = true
styles.item-styles[item-index] = styles.path-styles.length as U32
styles.item-strokes[item-index] = display-stroke-style(stroke-cap, stroke-join)
styles.item-dashes[item-index] = stroke-dash as F32
styles.path-styles += DisplayPathStyle
    - fill-color
    - stroke-color
    - stroke-width
    - stroke-cap
    - stroke-join
    - stroke-dash
    - FillRule.nonzero
    - false
record-item-command(item-index)
= true

────────────────────
+ do record-image-resource
    - index U32
    - generation U32
    - rect Rect
    - tint RGBA?

=? false if !chunk
promote-root-clip()
. flags U8
. packed-tint U32
. resource ImageResource?
if resource-table
    resource = resource-table.resolve-image(ImageHandle(index, generation))
. can-record = true
if glyph-registrar && resource-table && current-state == 0
    can-record = false
    if resource
        can-record = glyph-registrar.register-display-image
            - resource-table
            - ImageHandle(index, generation)
            - rect
=? false if !can-record
if resource && resource.template-alpha
    flags = flags /or/ display-item-template-alpha
if tint
    flags = flags /or/ display-item-has-tint
    packed-tint = pack-rgba8(tint)
if root-clip-active
    flags = flags /or/ display-item-has-clip
. item = display-item(DisplayItemKind.image, rect, 0, index, generation, packed-tint)
if root-clip-active
    . clip-index = chunk!.clips.length as U32
    chunk!.clips += clip-rect
    item = DisplayItem
        - item.kind
        - flags
        - item.aux
        - item.x
        - item.y
        - item.width
        - item.height
        - item.value
        - item.data0
        - item.data1
        - item.data2
        - clip-index
else
    item = DisplayItem
        - item.kind
        - flags
        - item.aux
        - item.x
        - item.y
        - item.width
        - item.height
        - item.value
        - item.data0
        - item.data1
        - item.data2
        - item.data3
. item-index = chunk!.add-item(item, root-ink(rect), current-state)
if tint
    chunk!.set-item-color(item-index, tint)
chunk!.set-item-exact(item-index, rect, 0)
record-item-command(item-index)
= true

────────────────────
+ do shadow
    - shape Outline
    - shadow Shadow

=? if !chunk
. current = chunk
=? if shadow.color.alpha <= 0 || shape.bounds.width <= 0 || shape.bounds.height <= 0
promote-root-clip()
if root-clip-active
    materialize-root-clip()
. shape-index = current.shapes.length as U32
current.shapes += display-shape(shape, shadow)
. item = DisplayItem
    - DisplayItemKind.shadow
    - display-item-has-shape
    - 0
    - shape.bounds.x as F32
    - shape.bounds.y as F32
    - shape.bounds.width as F32
    - shape.bounds.height as F32
    - shape.effective-radius as F32
    - pack-rgba8(shadow.color)
    - shape-index
    - 0
    - 0
. item-index = current.add-item(item, root-ink(shadow.extent(shape.extent)), current-state)
current.set-item-color(item-index, shadow.color)
current.set-item-exact(item-index, shape.bounds, shape.effective-radius)
record-item-command(item-index)

────────────────────
+ do shadow-path
    - shadow Shadow

=? if !chunk
. was-open = path-open
path-open = false
if !was-open
    unsupported-calls += 1
    =
=? if shadow.color.alpha <= 0
promote-root-clip()
. table = chunk!.side!
. count = (table.path-verbs.length as U32) - path-start
=? if count == 0
. bounds = table.state-path-bounds(path-start, path-coord-start, count)
record-styled
    - DisplayStyledShape.path
    - bounds
    - shadow.extent(bounds).pad(-1)
    - count
    - path-start
    - path-coord-start
    - false
    - FillRule.nonzero
    - null
    - shadow
record-item-command((chunk!.items.length - 1) as U32)

────────────────────
+ do backdrop-blur
    - shape Outline
    - radius Length

=? if !chunk
. current = chunk
. b = shape.bounds
=? if b.width <= 0 || b.height <= 0
push()
clip-outline(shape)
materialize-root-clip()
current.ensure-side().has-backdrop = true
. item = DisplayItem
    - DisplayItemKind.backdrop
    - 0
    - 0
    - b.x as F32
    - b.y as F32
    - b.width as F32
    - b.height as F32
    - radius as F32
    - 0
    - 0
    - 0
    - 0
. item-index = current.add-item(item, b, current-state)
record-item-command(item-index)
pop()

────────────────────
+ do backdrop-shader
    - shape Outline
    - backdrop ShaderFilter
    - blur Length = 0

=? if !chunk
. current = chunk
. b = shape.bounds
=? if b.width <= 0 || b.height <= 0
push()
clip-outline(shape)
materialize-root-clip()
. side = current.ensure-side()
side.has-backdrop = true
. live = backdrop.is-live && current.owner.$animates-fills
. gradient = side.add-shader
    - b
    - backdrop.shader
    - backdrop.args
    - live-fill-epoch(current, live, backdrop.frame-rate, display-layer-cycle(backdrop))
side.backdrop-shaders += backdrop
. slot = (side.backdrop-shaders.length - 1) as U32
. item = DisplayItem
    - DisplayItemKind.backdrop-shader
    - 0
    - 0
    - b.x as F32
    - b.y as F32
    - b.width as F32
    - b.height as F32
    - blur as F32
    - slot
    - gradient
    - 0
    - 0
. item-index = current.add-item(item, b, current-state)
record-item-command(item-index)
pop()

────────────────────
+ do begin-opacity
    - opacity Ratio

=? if !chunk
recorded-commands += DisplayCommand
    - DisplayCommandKind.begin-opacity
    - display-no-rect
    - Point(opacity, 0)
. state = DisplayState(0, DisplayStateKind.layer)
enter-state(state.opacity = opacity)

────────────────────
+ do end-opacity

=? if !chunk
recorded-commands += DisplayCommand(DisplayCommandKind.end-opacity)
. table = chunk!.ensure-side()
. cursor = current-state
while cursor != 0 && table.states[cursor].kind != DisplayStateKind.layer
    cursor = table.states[cursor].parent
if cursor == 0
    unsupported-calls += 1
    =
current-state = table.states[cursor].parent

────────────────────
+ do begin

=? if !chunk
. table = chunk.ensure-side()
path-open = true
path-start = table.path-verbs.length as U32
path-coord-start = table.path-coords.length as U32

────────────────────
+ do enclose

=? if !chunk
append-path-verb(DisplayPathVerb.enclose)

────────────────────
+ do end
    - closed Bool = false
    - fill-rule FillRule = FillRule.nonzero

=? if !chunk
. was-open = path-open
path-open = false
if !was-open
    unsupported-calls += 1
    =
. shading = recorded-fill(chunk, shape-fill)
=? if !fill-color && !stroke-color && !shading
promote-root-clip()
. table = chunk!.side!
. count = (table.path-verbs.length as U32) - path-start
=? if count == 0
. bounds = table.state-path-bounds(path-start, path-coord-start, count)
if shading
    record-styled
        - DisplayStyledShape.path
        - bounds
        - bounds
        - count
        - path-start
        - path-coord-start
        - closed
        - fill-rule
        • shading
    record-item-command((chunk!.items.length - 1) as U32)
    =? if !stroke-color
record-styled
    - DisplayStyledShape.path
    - bounds
    - display-stroke-ink(bounds, this)
    - count
    - path-start
    - path-coord-start
    - closed
    - fill-rule
    - null
    - null
    - null
    - null
    - fill-paint
    - stroke-brush
    • fills !shading
record-item-command((chunk!.items.length - 1) as U32)

────────────────────
+ do trace-path
    - verbs Array'PathVerb
    - coords Array'Coord
    - count Size

trace-canvas-path(this, verbs, coords, count)

────────────────────
_ get root-clip-active

current-state == 0 && has-clip-rect

────────────────────
_ get root-clip-shape

clip-shape if current-state == 0

────────────────────
_ get translates

chunk?.side?.translates-at(current-state) ?? true

────────────────────
+ do configure
    - scale F64
    - registrar DisplayGlyphRegistrar?
    - resources VectorGeometryTable? = null

recording-scale = scale
glyph-registrar = registrar
resource-table = resources

────────────────────
+ do draw-sprite Bool
    - sprite DisplaySprite
    - pixel-scale F64? = null
    - sampling = ImageSampling.smooth

=? false if !chunk
. rect = sprite.bounds
=? true if rect.width <= 0 || rect.height <= 0
materialize-root-clip()
. current = chunk!
. full = current.ensure-side().states[current-state].full
. step = display-sprite-scale-step
    - pixel-scale ?? recording-scale * sqrt(abs(full.a * full.d - full.b * full.c))
. key = (1u64 /lshift/ 62) /or/ (sprite.serial /lshift/ 8) /or/ (((step + 128) as U64) /and/ 255)
. resolution = pixel-scale ?? exp((step as F64) * display-sprite-step)
. item = DisplayItem
    - DisplayItemKind.sprite
    - 0
    - if sampling == ImageSampling.pixelated then 1 else 0
    - rect.x as F32
    - rect.y as F32
    - rect.width as F32
    - rect.height as F32
    - resolution as F32
    - (key /and/ 4294967295) as U32
    - (key /rshift/ 32) as U32
    - sprite.version
    - 0
. sprites = current.sprites ?? List'DisplaySprite()
. placed = current.sprite-items ?? List'U32()
current.sprites = sprites
current.sprite-items = placed
if sprites.length == 0
    sprite-chunks += current
placed += current.add-item
    - item
    - if current-state == 0 then root-ink(rect) else rect
    - current-state
sprites += sprite
= true

────────────────────
+ do draw-frame Bool
    - frame DisplayFrame
    - shaders [U32 = Shader]
    - placement Matrix
    - bounds Rect

=? false if !chunk || !frame.is-valid
. current = chunk
. table = current.ensure-side()
. saved = current-state
. first = current.items.length
. marked = recorded-commands.length
enter-state(DisplayState(0, DisplayStateKind.transform).matrix = placement)
enter-state(DisplayState(0, DisplayStateKind.clip).rect = bounds)
. base = current-state
current-state = saved
. verb-offset = table.path-verbs.length as U32
. coord-offset = table.path-coords.length as U32
. gradient-offset = table.gradient-wires.length as U32
. verb-count = frame.count(.path-verbs)
. coord-count = frame.count(.path-coords)
. verbs = frame.table(.path-verbs) as CPointer'U8
. coords = frame.table(.path-coords) as CPointer'F64
for index in 0 .. < verb-count
    table.path-verbs += verbs[index]
for index in 0 .. < coord-count
    table.path-coords += coords[index]
. usable = append-frame-gradients(frame, shaders, table)
. mapped = append-frame-states(frame, table, base, verb-offset, coord-offset)
. state-count = mapped.length
. items = frame.table(.items) as CPointer'DisplayItem
. item-count = frame.count(.items)
. item-states = frame.table(.item-states) as CPointer'U32
. item-inks = frame.table(.item-inks) as CPointer'Rect
. item-colors = frame.table(.item-colors) as CPointer'U32
. item-exacts = frame.table(.item-exacts) as CPointer'U32
. clips = frame.table(.clips) as CPointer'Rect
. shapes = frame.table(.shapes) as CPointer'DisplayShape
. colors = frame.table(.colors) as CPointer'RGBA
. exact-rects = frame.table(.exact-rects) as CPointer'Rect
. exact-values = frame.table(.exact-values) as CPointer'F64
. styles = frame.table(.styles) as CPointer'DisplayPathStyleWire
. gradients = frame.table(.gradients) as CPointer'DisplayGradientWire
. style-count = frame.count(.styles)
. exact-count = min(frame.count(.exact-rects), frame.count(.exact-values))
. per-item = min(item-count, frame.count(.item-states))
. inked = frame.count(.item-inks)
. colored = frame.count(.item-colors)
. exacted = frame.count(.item-exacts)
for index in 0 .. < per-item
    . item = items[index]
    . kind = item.kind
    . rectangular = kind == DisplayItemKind.quad || kind == DisplayItemKind.border
    . drawable = rectangular || kind == DisplayItemKind.shadow
    if !drawable && kind != DisplayItemKind.styled
        continue
    . local-state = item-states[index] as Size
    if local-state >= state-count
        continue
    . placed = item
    if (item.flags /and/ display-item-has-clip) != 0
        if (item.aux as Size) >= frame.count(.clips)
            continue
    if (item.flags /and/ display-item-has-shape) != 0
        if (item.data1 as Size) >= frame.count(.shapes)
            continue
    . state = mapped[local-state]
    if is-quad-or-border && !table.translates-at(state)
        . tone = rgba8(item.data0)
        if index < colored && (item-colors[index] as Size) < frame.count(.colors)
            tone = colors[item-colors[index] as Size]
        . box = display-item-rect(item)
        . value = item.value as F64
        if index < exacted && (item-exacts[index] as Size) < exact-count
            box = exact-rects[item-exacts[index] as Size]
            value = exact-values[item-exacts[index] as Size]
        . shape Outline?
        if (item.flags /and/ display-item-has-shape) != 0
            shape = display-shape-outline(box, shapes[item.data1 as Index])
        restyle-frame-item(kind, state, box, value, tone, item.aux == 1, shape)
        continue
    .. is-quad-or-border = kind == DisplayItemKind.quad || kind == DisplayItemKind.border
    if kind == DisplayItemKind.styled
        . ordinal = item.data3 as Size
        if ordinal >= style-count
            continue
        . wire = styles[ordinal]
        if !frame-style-usable(wire, usable, gradients)
            continue
        .. path-fits = frame-path-fits
            - verbs
            - verb-count
            - coord-count
            - item.data0
            - item.data1
            - item.data2
        if (item.value as U8) == DisplayStyledShape.path && !path-fits
            continue
        if (item.value as U8) == DisplayStyledShape.path
            placed = placed.data0 = item.data0 + verb-offset
            placed = placed.data2 = item.data2 + coord-offset
        placed = placed.data3 = table.path-styles.length as U32
        table.path-styles += display-frame-style(wire, frame, shaders)
        . gradient-index = if wire.gradient != 0 then wire.gradient + gradient-offset else 0u32
        . brush-index = if wire.brush != 0 then wire.brush + gradient-offset else 0u32
        . remapped = wire.gradient = gradient-index
        table.styled-wires += remapped.brush = brush-index
        table.has-antialiased = true
    if (item.flags /and/ display-item-has-clip) != 0
        placed = placed.aux = current.clips.length as U16
        current.clips += clips[item.aux as Index]
    if (item.flags /and/ display-item-has-shape) != 0
        placed = placed.data1 = current.shapes.length as U32
        current.shapes += shapes[item.data1 as Index]
    . ink = if index < inked then item-inks[index] else display-unknown-ink
    . added = current.add-item(placed, ink, state)
    if index < colored
        . slot = item-colors[index] as Size
        if slot < frame.count(.colors)
            current.set-item-color(added, colors[slot])
    if index < exacted
        . slot = item-exacts[index] as Size
        if slot < exact-count
            current.set-item-exact(added, exact-rects[slot], exact-values[slot])
while recorded-commands.length > marked
    recorded-commands.pop()
. count = current.items.length - first
if count > 0
    . replayed = DisplayCommand
        - DisplayCommandKind.frame
        - display-no-rect
        - Point(count as F64, saved as F64)
    recorded-commands += replayed.item-index = first as U32
= true

────────────────────
_ do begin-chunk
    - next DisplayChunk

chunk = next
recorded-commands.clear()
has-clip-rect = false
clip-shape = null
clip-stack.clear()
current-state = 0
path-open = false

────────────────────
_ do end-chunk

. current = chunk
if current && current.needs-tile
    keep-commands(current)
chunk = null

────────────────────
_ do keep-commands
    - target DisplayChunk

. kept = target.commands ?? List'DisplayCommand()
target.commands = kept
kept.clear()
kept ++= recorded-commands

────────────────────
_ do has-paint-since
    - start Size

. index = start
while index < recorded-commands.length
    . command = recorded-commands[index]
    . kind = command.kind
    do match? kind
        |? it == DisplayCommandKind.rect || it == DisplayCommandKind.oval
            =? true if command.fill || command.stroke
        |? it == DisplayCommandKind.text || it == DisplayCommandKind.image || it == DisplayCommandKind.item
            = true
        |? it == DisplayCommandKind.frame
            = true
        |? it == DisplayCommandKind.image-pattern
            = true
        |? it == DisplayCommandKind.erase
            = true
        |? it == DisplayCommandKind.gradient || it == DisplayCommandKind.shader
            = true
    index += 1
= false

────────────────────
_ root-ink
    - rect Rect

display-clipped-ink(rect, clip-rect, root-clip-active)

────────────────────
_ do enter-state
    - state DisplayState

materialize-root-clip()
current-state = chunk!.ensure-side().add-state(state.parent = current-state)

────────────────────
_ do materialize-root-clip

=? if current-state != 0
. table = chunk!.ensure-side()
if has-clip-rect
    . clip-state = DisplayState(0, DisplayStateKind.clip)
    current-state = table.add-state(clip-state.rect = clip-rect)
. shape = clip-shape
if shape
    . outline = display-outline-state(current-state, DisplayStateKind.clip-outline, shape)
    current-state = table.add-state(outline)

────────────────────
_ do promote-root-clip

=? if !root-clip-shape
materialize-root-clip()

────────────────────
_ do contain-root-clip
    - extent Rect

if root-clip-active && !clip-rect.contains(extent, 0.01)
    materialize-root-clip()

────────────────────
_ do fill-outline
    - shape Outline

. clipping = root-clip-shape
if clipping
    . covers = shape.is-rectangular && shape.bounds.contains(clipping.extent, 0.01)
    if covers || shape == clipping
        record-outline-fill(clipping)
        =
    if !display-outline-within(shape, clipping)
        promote-root-clip()
contain-root-clip(shape.extent)
record-outline-fill(shape)

────────────────────
_ do stroke-outline
    - shape Outline

. inset = stroke-width / 2
. outer = shape.grow(inset)
. clipping = root-clip-shape
if clipping
    if display-outline-inset(shape, clipping, inset)
        record-outline-border(clipping, true)
        =
    if !display-outline-within(outer, clipping)
        promote-root-clip()
contain-root-clip(outer.extent)
if outer.arrow
    unsupported-calls += 1
record-outline-border(outer, false)

────────────────────
_ do record-outline-fill
    - shape Outline

. current = chunk!
. shape-index = current.shapes.length as U32
current.shapes += display-shape(shape, null)
. item = DisplayItem
    - DisplayItemKind.quad
    - display-item-has-shape
    - 0
    - shape.bounds.x as F32
    - shape.bounds.y as F32
    - shape.bounds.width as F32
    - shape.bounds.height as F32
    - shape.effective-radius as F32
    - pack-rgba8(fill-color!)
    - shape-index
    - 0
    - 0
. item-index = current.add-item(item, root-ink(shape.extent), current-state)
current.set-item-color(item-index, fill-color!)
current.set-item-exact(item-index, shape.bounds, shape.effective-radius)
record-item-command(item-index)

────────────────────
_ do record-outline-border
    - outer Outline
    - clipped Bool

. current = chunk!
. shape-index = current.shapes.length as U32
current.shapes += display-shape(outer, null)
. item = DisplayItem
    - DisplayItemKind.border
    - display-item-has-shape
    - if clipped then 1 else 0
    - outer.bounds.x as F32
    - outer.bounds.y as F32
    - outer.bounds.width as F32
    - outer.bounds.height as F32
    - stroke-width as F32
    - pack-rgba8(stroke-color!)
    - shape-index
    - 0
    - 0
. item-index = current.add-item(item, root-ink(outer.extent), current-state)
current.set-item-color(item-index, stroke-color!)
current.set-item-exact(item-index, outer.bounds, stroke-width)
record-item-command(item-index)

────────────────────
_ do record-item-command
    - item-index U32

recorded-commands += DisplayCommand
    - DisplayCommandKind.item
    - display-no-rect
    - Point(0, 0)
    - Point(0, 0)
    - Point(0, 0)
    - Matrix()
    - null
    - null
    - 0
    - LineCap.butt
    - LineJoin.miter
    - null
    - null
    - TextAlignment.left
    - false
    - FillRule.nonzero
    - item-index

────────────────────
_ do record-styled
    - op U8
    - rect Rect
    - ink Rect
    - path-count U32
    - verb-start U32
    - coord-start U32
    - closed = false
    - fill-rule FillRule = FillRule.nonzero
    - gradient Gradient? = null
    - shadow Shadow? = null
    - shader Shader? = null
    - shader-args [F64]? = null
    - paint Paint? = null
    - brush Brush? = null
    - shading ShaderFill? = null
    - fills = true

. current = chunk!
. table = current.ensure-side()
. style-index = table.path-styles.length as U32
. fill = fill-color if fills
. stroke = stroke-color
. gradient-index U32
. brush-index U32
. painted = paint != null && fill != null
. brushed = brush != null && stroke != null
if painted
    gradient-index = table.add-paint(paint!, fill!)
if brushed
    brush-index = table.add-brush(brush!, stroke!)
if gradient
    fill = null
    stroke = null
    gradient-index = table.add-gradient(gradient)
if shader
    fill = null
    stroke = null
    gradient-index = table.add-shader(rect, shader, shader-args!)
if shading
    fill = null
    stroke = null
    gradient-index = table.add-shader
        - rect
        - shading.shader
        - shading.args
        - live-fill-epoch
            - current
            - shading.is-live
            - shading.frame-rate
            - shader-cycle(shading.args, shading.arg-kinds)?.at-width(rect.width)
if shadow
    fill = shadow.color
    stroke = null
table.path-styles += DisplayPathStyle
    - fill
    - stroke
    - stroke-width
    - stroke-cap
    - stroke-join
    - stroke-dash
    - fill-rule
    - closed
    - gradient
    - shadow
    - shading?.shader ?? shader
    - shading?.args ?? shader-args
    - paint if painted
    - brush if brushed
    - shading
. flags U8
. aux U16
if root-clip-active
    flags = flags /or/ display-item-has-clip
    aux = current.clips.length as U16
    current.clips += clip-rect
. item = DisplayItem
    - DisplayItemKind.styled
    - flags
    - aux
    - rect.x as F32
    - rect.y as F32
    - rect.width as F32
    - rect.height as F32
    - op
    - verb-start
    - path-count
    - coord-start
    - style-index
. local-ink = if current-state == 0 then root-ink(ink) else ink
. item-index = current.add-item(item, local-ink, current-state)
current.set-item-exact(item-index, rect, op)
table.styled-wires += DisplayPathStyleWire
    - if gradient || shader || shading || painted then white else fill ?? transparent
    - if brushed then transparent else stroke ?? transparent
    - stroke-width
    - stroke-dash
    - shadow?.x ?? 0
    - shadow?.y ?? 0
    - shadow?.blur ?? 0
    - display-path-paint
        - fill != null || gradient != null || shader != null || shading != null
        - stroke != null && !brushed
        - closed
        - fill-rule
        - shadow != null
    - display-stroke-style(stroke-cap, stroke-join)
    - gradient-index
    - brush-index
if gradient || shader || shading
    table.has-shaded-fill = true
else
    table.has-antialiased = true

────────────────────
_ do record-text-fill U32
    - current DisplayChunk
    - fill ShaderFill
    - layout TextLayout
    - rect Rect
    - alignment TextAlignment

. code = display-alignment-code(alignment)
. width = layout.width
. height = layout.height
. x = if code == 1 then centered-x else if code == 2 then rect.right - width else rect.x
    .. centered-x = rect.x + (rect.width - width) / 2
. frame = Rect(x, rect.y + (rect.height - height) / 2, width, height)
= current.ensure-side().add-shader
    - frame
    - fill.shader
    - fill.args
    - live-fill-epoch
        - current
        - fill.is-live
        - fill.frame-rate
        - shader-cycle(fill.args, fill.arg-kinds)?.at-width(frame.width)

────────────────────
_ recorded-fill ShaderFill?
    - current DisplayChunk
    - fill ShaderFill?

|? !fill
    null
|? !fill.is-live || current.owner.$animates-fills
    fill
??
    ShaderFill(fill.shader, fill.args)

────────────────────
_ do live-fill-epoch F64
    - current DisplayChunk
    - is-live Bool
    - rate F64?
    - cycle FrameCycle?

=? -1.0 if !is-live
. kept = current.live-rate
if !current.is-live
    current.live-rate = rate
    current.live-cycle = cycle
    current.is-live-settled = false
else
    current.live-rate = max(kept, rate) if kept != null && rate != null
    if current.live-cycle != cycle
        current.live-cycle = null
current.is-live = true
. epoch = current.live-epoch ?? live-time
current.live-epoch = epoch
= epoch

────────────────────
_ do append-path-verb
    - verb U8

if !path-open
    unsupported-calls += 1
    =
chunk!.side!.path-verbs += verb

────────────────────
_ do append-path-point
    - x Coord
    - y Coord

=? if !path-open
. table = chunk!.side!
table.path-coords += x
table.path-coords += y

────────────────────
_ do restyle-frame-item
    - kind U8
    - state U32
    - box Rect
    - value F64
    - color RGBA
    - clipped Bool
    - shape Outline?

. held-state = current-state
. held-fill = fill-color
. held-stroke = stroke-color
. held-width = stroke-width
. held-join = stroke-join
. held-dash = stroke-dash
. held-paint = fill-paint
. held-brush = stroke-brush
current-state = state
fill-paint = null
stroke-brush = null
if kind == DisplayItemKind.quad
    fill-color = color
    stroke-color = null
    if shape
        outline(shape)
    else
        rect(box)
else
    fill-color = null
    stroke-color = color
    stroke-width = value
    stroke-join = LineJoin.miter
    stroke-dash = 0
    if shape && clipped
        push()
        clip-outline(shape)
        outline(shape.grow(-value / 2))
        pop()
    else if shape
        outline(shape.grow(-value / 2))
    else
        rect(box)
current-state = held-state
fill-color = held-fill
stroke-color = held-stroke
stroke-width = held-width
stroke-join = held-join
stroke-dash = held-dash
fill-paint = held-paint
stroke-brush = held-brush

────────────────────
_ do append-frame-gradients [Bool]
    - frame DisplayFrame
    - shaders [U32 = Shader]
    - table DisplayChunkSide

. stop-offset = table.gradient-stops.length as U32
. arg-offset = table.shader-args.length as U32
. stop-count = frame.count(.stops)
. arg-count = frame.count(.args)
. stops = frame.table(.stops) as CPointer'GradientStop
. args = frame.table(.args) as CPointer'F64
for index in 0 .. < stop-count
    table.gradient-stops += stops[index]
for index in 0 .. < arg-count
    table.shader-args += args[index]
. gradients = frame.table(.gradients) as CPointer'DisplayGradientWire
. usable [Bool]
for index in 0 .. < frame.count(.gradients)
    . wire = gradients[index]
    . kind = wire.kind
    . shaded = kind >= display-gradient-shader
    . shader = shaders[wire.shader] if shaded
    . limit = if shaded then arg-count else stop-count
    . start = wire.stop-start as Size
    . fits = start <= limit && (wire.stop-count as Size) <= limit - start
    . known = kind >= display-gradient-linear && kind <= display-gradient-brush
    . brushes = kind != display-gradient-brush || wire.stop-count >= 12
    usable += known && fits && brushes && (!shaded || shader != null)
    . offset = if shaded then arg-offset else stop-offset
    . shader-id = shader?.id ?? 0u32
    . placed = wire.stop-start = wire.stop-start + offset
    table.gradient-wires += placed.shader = shader-id
= usable

────────────────────
_ do append-frame-states [U32]
    - frame DisplayFrame
    - table DisplayChunkSide
    - base U32
    - verb-offset U32
    - coord-offset U32

. wires = frame.table(.states) as CPointer'DisplayStateWire
. count = frame.count(.states)
. verbs = frame.table(.path-verbs) as CPointer'U8
. verb-count = frame.count(.path-verbs)
. coord-count = frame.count(.path-coords)
. mapped [U32]
mapped += base
for index in 1 .. < count
    . wire = wires[index]
    . parent = if (wire.parent as Size) < index then mapped[wire.parent] else base
    . kind = wire.kind as U8
    . known = kind >= DisplayStateKind.transform && kind <= DisplayStateKind.blur
    . blended = wire.blend >= 0 && wire.blend <= 27
    .. path-fits = frame-path-fits
        - verbs
        - verb-count
        - coord-count
        - wire.path-start
        - wire.path-count
        - wire.coord-start
    . traced = kind != DisplayStateKind.clip-path || path-fits
    . sourced = kind != DisplayStateKind.clip-layer-mask || (wire.source as Size) < index
    if !known || !traced || !sourced || !blended
        mapped += parent
        continue
    . placed-kind = kind
    if kind == DisplayStateKind.content
        placed-kind = DisplayStateKind.transform
    else if kind == DisplayStateKind.clip-mask
        placed-kind = DisplayStateKind.clip
    . state = DisplayState
        - parent
        - placed-kind
        - wire.matrix
        - wire.rect
        - wire.radius
        - wire.side
        - wire.offset
        - wire.size
        - wire.path-start + verb-offset
        - wire.path-count
        - wire.coord-start + coord-offset
        - if wire.fill-rule == 1 then FillRule.even-odd else FillRule.nonzero
        - wire.opacity
    state = state.serial = wire.serial
    state = state.blend = wire.blend as BlendMode
    if kind == DisplayStateKind.clip-layer-mask
        state = state.source = mapped[wire.source]
    mapped += table.add-state(state)
= mapped

━━━━━━━━━━━━━━━━━━━━
+ DisplayFrame is Tuple

+ data Pointer
+ size Size

────────────────────
+ do get is-valid Bool

=? false if !data || size < display-frame-header-bytes
. words = data as CPointer'U64
=? false if words[0] != display-frame-magic || words[1] != display-frame-format()
=? false if (words[2] as Size) > size || (words[3] as Size) != display-frame-table-count
for index in 0 .. < display-frame-table-count
    . offset = words[4 + index * 2] as Size
    . count = words[5 + index * 2] as Size
    =? false if offset < display-frame-header-bytes || offset > size || (offset /and/ 7) != 0
    =? false if count > (size - offset) / (index as DisplayFrameTable).width
= words[5 + (DisplayFrameTable.states as Size) * 2] > 0

────────────────────
_ table Pointer
    - kind DisplayFrameTable

data + ((data as CPointer'U64)[4 + (kind as Size) * 2] as Size)

────────────────────
_ count Size
    - kind DisplayFrameTable

(data as CPointer'U64)[5 + (kind as Size) * 2] as Size

━━━━━━━━━━━━━━━━━━━━
+ DisplayFrameRecorder

+ unsupported Size
+ shaders [Shader]

_ recorder = DisplayRecorder()
_ chunk = DisplayChunk(Box(), DisplayPhase.pre)
_ spans [DisplayFrameSpan]

────────────────────
+ get item-count Size

chunk.items.length

────────────────────
+ get ink-bounds Rect?

chunk.bounds if chunk.has-bounds

────────────────────
+ do get byte-size Size

. total = display-frame-header-bytes
for index in 0 .. < spans.length
    total = display-frame-align(total + spans[index].count * (index as DisplayFrameTable).width)
= total

────────────────────
+ do begin Canvas

chunk.reset()
chunk.ensure-side()
spans.clear()
recorder.unsupported-calls = 0
recorder.begin-chunk(chunk)
= recorder

────────────────────
+ do end

recorder.end-chunk()
unsupported = recorder.unsupported-calls
. side = chunk.ensure-side()
. exacts = chunk.ensure-exacts()
side.refresh-wire-states()
shaders.clear()
for style in side.path-styles
    collect-shader(style.shader)
    collect-shader(style.paint?.shader)
    collect-shader(style.brush?.shader)
spans.clear()
spans += DisplayFrameSpan(chunk.items.buffer-pointer as Pointer, chunk.items.length)
spans += DisplayFrameSpan(chunk.clips.buffer-pointer as Pointer, chunk.clips.length)
spans += DisplayFrameSpan(chunk.shapes.buffer-pointer as Pointer, chunk.shapes.length)
spans += DisplayFrameSpan(side.colors.buffer-pointer as Pointer, side.colors.length)
spans += DisplayFrameSpan(side.item-colors.buffer-pointer as Pointer, side.item-colors.length)
spans += DisplayFrameSpan(side.wire-states.buffer-pointer as Pointer, side.wire-states.length)
spans += DisplayFrameSpan(side.item-states.buffer-pointer as Pointer, side.item-states.length)
spans += DisplayFrameSpan(side.item-inks.buffer-pointer as Pointer, side.item-inks.length)
spans += DisplayFrameSpan(exacts.item-slots.buffer-pointer as Pointer, exacts.item-slots.length)
spans += DisplayFrameSpan(exacts.rects.buffer-pointer as Pointer, exacts.rects.length)
spans += DisplayFrameSpan(exacts.values.buffer-pointer as Pointer, exacts.values.length)
spans += DisplayFrameSpan(side.path-verbs.buffer-pointer, side.path-verbs.length)
spans += DisplayFrameSpan(side.path-coords.buffer-pointer as Pointer, side.path-coords.length)
spans += DisplayFrameSpan(side.styled-wires.buffer-pointer as Pointer, side.styled-wires.length)
spans += DisplayFrameSpan(side.gradient-wires.buffer-pointer as Pointer, side.gradient-wires.length)
spans += DisplayFrameSpan(side.gradient-stops.buffer-pointer as Pointer, side.gradient-stops.length)
spans += DisplayFrameSpan(side.shader-args.buffer-pointer as Pointer, side.shader-args.length)

────────────────────
+ do write
    - target Pointer

. words = target as CPointer'U64
words[0] = display-frame-magic
words[1] = display-frame-format()
words[3] = display-frame-table-count as U64
. offset = display-frame-header-bytes
for index in 0 .. < spans.length
    . span = spans[index]
    . bytes = span.count * (index as DisplayFrameTable).width
    words[4 + index * 2] = offset as U64
    words[5 + index * 2] = span.count as U64
    if bytes > 0
        C:memcpy(target + offset, span.data, bytes)
    offset = display-frame-align(offset + bytes)
words[2] = offset as U64

────────────────────
_ do collect-shader
    - shader Shader?

. found = shader
=? if !found
for known in shaders
    =? if known.id == found.id
shaders += found

━━━━━━━━━━━━━━━━━━━━
+ DisplayFrameRaster
    is Closable

+ canvas RasterCanvas

_ background RGBA
_ renderer MetalOffscreenRenderer?
