────────────────────
+ do transform-content
    - matrix Matrix

=? if !chunk
recorded-commands += DisplayCommand
    - DisplayCommandKind.transform
    - display-no-rect
    - Point(0, 0)
    - Point(0, 0)
    - Point(0, 0)
    - matrix
. table = chunk!.ensure-side()
. kind = if table.content-state == 0 then DisplayStateKind.content else DisplayStateKind.transform
. state = DisplayState(0, kind)
enter-state(state.matrix = matrix)
if kind == DisplayStateKind.content
    table.content-state = current-state

────────────────────
+ do outline
    - shape Outline

if shape-fill
    begin()
    outline-path(shape)
    end(true)
    =
=? if !chunk
if shape.is-rectangular && !root-clip-shape
    rect(shape.bounds)
    =
if (stroke-color && (stroke-dash > 0 || stroke-join != LineJoin.miter)) || !translates
    begin()
    outline-path(shape)
    end()
    =
if fill-color
    fill-outline(shape)
if stroke-color
    stroke-outline(shape)

────────────────────
+ do clip
    - rect Rect

=? if !chunk
recorded-commands += DisplayCommand(DisplayCommandKind.clip, rect)
if current-state != 0 || clip-shape
    enter-state(DisplayState(0, DisplayStateKind.clip).rect = rect)
    =
if has-clip-rect
    clip-rect = clip-rect.intersection(rect)
else
    clip-rect = rect
    has-clip-rect = true

────────────────────
+ do clip-outline
    - shape Outline

=? if !chunk
. current = chunk
if current-state != 0
    recorded-commands += display-outline-clip-command(shape)
    enter-state(display-outline-state(0, DisplayStateKind.clip-outline, shape))
    =
if shape.is-rectangular
    clip(shape.bounds)
    =
. extent = shape.extent
recorded-commands += display-outline-clip-command(shape)
if clip-shape || (has-clip-rect && !clip-rect.contains(extent, 0.01))
    enter-state(display-outline-state(0, DisplayStateKind.clip-outline, shape))
    =
clip-shape = shape
if has-clip-rect
    clip-rect = clip-rect.intersection(extent)
else
    clip-rect = extent
    has-clip-rect = true

────────────────────
+ do clip-path
    - fill-rule FillRule = FillRule.nonzero

=? if !chunk
if !path-open
    unsupported-calls += 1
    =
path-open = false
. table = chunk.ensure-side()
. count = (table.path-verbs.length as U32) - path-start
. bounds = table.state-path-bounds(path-start, path-coord-start, count)
enter-state
    - DisplayState
        - 0
        - DisplayStateKind.clip-path
        - Matrix()
        - bounds
        - 0
        - 0
        - 0
        - 0
        - path-start
        - count
        - path-coord-start
        - fill-rule
. command = DisplayCommand(DisplayCommandKind.clip-path)
recorded-commands += command.item-index = current-state

────────────────────
+ do clip-mask
    - image RasterCanvas
    - rect Rect

=? if !chunk
. command = DisplayCommand(DisplayCommandKind.clip-mask, rect)
recorded-commands += command.image = image
. table = chunk!.ensure-side()
. state = DisplayState(0, DisplayStateKind.clip-mask, Matrix(), rect)
state = state.image = table.images.length as U32
state = state.serial = image.content-serial
table.images += image
table.image-identities += image.identity
enter-state(state)

────────────────────
+ do begin-mask

=? if !chunk
recorded-commands += DisplayCommand(DisplayCommandKind.begin-mask)
clip-stack += SavedDisplayClip(clip-rect, has-clip-rect, clip-shape, current-state)
super.push()
enter-state(DisplayState(0, DisplayStateKind.mask-layer))

────────────────────
+ do end-mask

=? if !chunk
. table = chunk.ensure-side()
. source = current-state
while source != 0 && table.states[source].kind != DisplayStateKind.mask-layer
    source = table.states[source].parent
if source == 0 || clip-stack.length == 0
    unsupported-calls += 1
    =
recorded-commands += DisplayCommand(DisplayCommandKind.end-mask)
. saved = clip-stack.pop()
clip-rect = saved.rect
has-clip-rect = saved.has
clip-shape = saved.shape
current-state = saved.state
super.pop()
. state = DisplayState(0, DisplayStateKind.clip-layer-mask)
enter-state(state.source = source)

────────────────────
+ do begin-blur
    - radius Length

=? if !chunk
recorded-commands += DisplayCommand
    - DisplayCommandKind.begin-blur
    - display-no-rect
    - Point(radius, 0)
. state = DisplayState(0, DisplayStateKind.blur)
enter-state(state.radius = radius)

────────────────────
+ do end-blur

=? if !chunk
recorded-commands += DisplayCommand(DisplayCommandKind.end-blur)
. table = chunk!.ensure-side()
. cursor = current-state
while cursor != 0 && table.states[cursor].kind != DisplayStateKind.blur
    cursor = table.states[cursor].parent
if cursor == 0
    unsupported-calls += 1
    =
current-state = table.states[cursor].parent

────────────────────
+ do draw-image
    - image RasterCanvas
    - rect Rect
    - template-alpha Bool = false
    - sampling = ImageSampling.smooth

=? if !chunk
. current = chunk
. command = DisplayCommand
    - DisplayCommandKind.image
    - rect
    - Point(0, 0)
    - Point(0, 0)
    - Point(0, 0)
    - Matrix()
    - fill-color
    - null
    - 0
    - LineCap.butt
    - LineJoin.miter
    - null
    - image
    - TextAlignment.left
    - template-alpha
recorded-commands += command.sampling = sampling
promote-root-clip()
. table = current.ensure-side()
if table.images.length >= 65535
    current.needs-tile = true
. image-index = table.images.length as U16
table.images += image
table.image-identities += image.identity
. serial = image.content-serial
. flags U8
. clip-index U32
if root-clip-active
    flags = flags /or/ display-item-has-clip
    clip-index = current.clips.length as U32
    current.clips += clip-rect
if template-alpha
    flags = flags /or/ display-item-template-alpha
if fill-color
    flags = flags /or/ display-item-has-tint
. item = DisplayItem
    - DisplayItemKind.canvas-image
    - flags
    - image-index
    - rect.x as F32
    - rect.y as F32
    - rect.width as F32
    - rect.height as F32
    - if sampling == ImageSampling.pixelated then 1 else 0
    - (serial /and/ 4294967295) as U32
    - (serial /rshift/ 32) as U32
    - pack-rgba8(fill-color ?? transparent)
    - clip-index
. item-index = current.add-item(item, root-ink(rect), current-state)
if fill-color
    current.set-item-color(item-index, fill-color!)
current.set-item-exact(item-index, rect, 0)

