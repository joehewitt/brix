────────────────────
_ This
    - chunk-owner Box
    - chunk-phase U8

.. owner = chunk-owner
phase = chunk-phase

────────────────────
+ get sprite-count Size

sprites?.length ?? 0

────────────────────
_ do reset

record-generation = next-display-record-generation()
path-generation = record-generation
items.clear()
glyph-layouts?.clear()
glyph-fills?.clear()
item-glyph-layouts.clear()
glyph-handles?.clear()
clips.clear()
shapes.clear()
vector-palette.clear()
. current = side
if current
    current.clear()
. known-exacts = exacts
if known-exacts
    known-exacts.clear()
commands?.clear()
sprites?.clear()
sprite-items?.clear()
bounds = display-no-rect
has-bounds = false
is-opaque = false
needs-tile = false
is-live = false
live-rate = null
indicator-start = 0
indicator-count = 0
metal-resource-renderer = null
metal-resource-epoch = -1

────────────────────
_ do add-glyph-layout U32
    - layout TextLayout
    - fill ShaderFill?

. layouts = glyph-layouts ?? List'TextLayout()
. fills = glyph-fills ?? List'(ShaderFill?)()
glyph-layouts = layouts
glyph-fills = fills
. index = layouts.length as U32
layouts += layout
fills += fill
= index

────────────────────
_ do bump-record-generation

record-generation = next-display-record-generation()

────────────────────
_ do refresh-bounds

bounds = display-no-rect
has-bounds = false
. table = side!
if table.has-prefix-bounds
    add-ink(table.prefix-bounds)
. index Size
while index < items.length
    . ink = table.item-inks[index]
    . state = table.item-states[index]
    if ink.width >= 0 && ink.height >= 0
        if state == 0
            add-ink(ink)
        else
            . placed = table.state-ink-bounds(state, ink)
            if placed
                add-ink(placed)
    index += 1

────────────────────
_ do add-ink
    - rect Rect

=? if rect.width <= 0 || rect.height <= 0
if has-bounds
    bounds = bounds + rect
else
    bounds = rect
    has-bounds = true

────────────────────
_ do add-item
    - item DisplayItem
    - ink Rect
    - state U32 = 0

. index = items.length as U32
items += item
item-glyph-layouts += 4294967295
. existing = side
if state != 0 || (!existing && items.length >= display-culling-item-count)
    ensure-side()
. current = side
if current
    current.item-colors += 4294967295
    current.item-transforms += 4294967295
    current.item-states += state
    current.item-inks += ink
    current.item-styles += 4294967295
    current.item-strokes += 0
    current.item-dashes += 0
. known-exacts = exacts
if known-exacts
    known-exacts.item-slots += 4294967295
if state == 0
    add-ink(ink)
else
    . table = side!
    table.include-state-ink(state, ink)
    . placed = table.state-ink-bounds(state, ink)
    if placed
        add-ink(placed)
= index

────────────────────
_ do ensure-side

. existing = side
=? existing if existing
. created = DisplayChunkSide()
created.states += DisplayState(0, DisplayStateKind.root)
created.prefix-bounds = bounds
created.has-prefix-bounds = has-bounds
for index in 0 .. < items.length
    created.item-colors += 4294967295
    created.item-transforms += 4294967295
    created.item-states += 0
    created.item-inks += display-unknown-ink
    created.item-styles += 4294967295
    created.item-strokes += 0
    created.item-dashes += 0
for packed in vector-palette
    created.vector-colors += rgba8(packed)
side = created
= created

────────────────────
_ do set-item-color
    - item-index U32
    - color RGBA

if rgba8(pack-rgba8(color)) == color
    . current = side
    if current
        current.item-colors[item-index] = 4294967295
    =
. table = ensure-side()
. slot = table.item-colors[item-index]
if slot != 4294967295
    table.colors[slot] = color
    =
table.item-colors[item-index] = table.colors.length as U32
table.colors += color

────────────────────
_ item-color
    - item-index Size
    - packed U32

match current
    |= null
        rgba8(packed)
    ??
        match current.item-colors[item-index]
            |= 4294967295u32
                rgba8(packed)
            ??
                current.colors[it]

.. current = side

────────────────────
_ do set-item-exact
    - item-index U32
    - rect Rect
    - value F64

. item = items[item-index]
. rect-exact = display-item-rect(item) == rect
. value-exact = (item.value as F64) == value
=? if rect-exact && value-exact
. table = ensure-exacts()
table.item-slots[item-index] = table.rects.length as U32
table.rects += rect
table.values += value

────────────────────
_ do ensure-exacts DisplayChunkExacts

. existing = exacts
=? existing if existing
. created = DisplayChunkExacts()
for index in 0 .. < items.length
    created.item-slots += 4294967295
exacts = created
= created

────────────────────
_ item-rect
    - item-index Size
    - item DisplayItem

match current
    |= null
        display-item-rect(item)
    ??
        match current.item-slots[item-index]
            |= 4294967295u32
                display-item-rect(item)
            ??
                current.rects[it]

.. current = exacts

────────────────────
_ item-value
    - item-index Size
    - item DisplayItem

match current
    |= null
        item.value
    ??
        match current.item-slots[item-index]
            |= 4294967295u32
                item.value
            ??
                current.values[it]

.. current = exacts

────────────────────
_ do set-item-transform
    - item-index U32
    - transform Matrix

. table = ensure-side()
table.item-transforms[item-index] = table.transforms.length as U32
table.transforms += transform

────────────────────
_ item-transform
    - item-index Size

match current
    |= null
        null
    ??
        match current.item-transforms[item-index]
            |= 4294967295u32
                null
            ??
                current.transforms[it]

.. current = side

────────────────────
_ do add-vector-color
    - color RGBA

. table = ensure-side()
vector-palette += pack-rgba8(color)
table.vector-colors += color

────────────────────
_ do demote-to-opaque

is-opaque = true
. owner-bounds = owner.bounds.pad(-owner.focus-ring-reach)
bounds = if has-bounds then owner-bounds + bounds else owner-bounds
has-bounds = bounds.width > 0 && bounds.height > 0

━━━━━━━━━━━━━━━━━━━━
_ DisplayChunkExacts

+ item-slots [U32]
+ rects [Rect]
+ values [F64]

────────────────────
_ do clear

item-slots.clear()
rects.clear()
values.clear()

━━━━━━━━━━━━━━━━━━━━
_ DisplayChunkSide

+ vector-colors [RGBA]
+ colors [RGBA]
+ item-colors [U32]
+ transforms [Matrix]
+ item-transforms [U32]
+ states [DisplayState]
+ wire-states [DisplayStateWire]
+ wire-dirty = true
+ item-states [U32]
+ item-inks [Rect]
+ item-styles [U32]
+ item-strokes [U32]
+ item-dashes [F32]
+ path-verbs [U8]
+ path-coords [F64]
+ path-styles [DisplayPathStyle]
+ styled-wires [DisplayPathStyleWire]
+ gradient-wires [DisplayGradientWire]
+ gradient-stops [GradientStop]
+ shader-args [F64]
+ images [RasterCanvas]
+ image-identities [U64]
+ backdrop-shaders [ShaderFilter]
+ shape-clips Size
+ mask-layers Size
+ blur-layers Size
+ has-backdrop = false
+ content-state U32
+ has-antialiased = false
+ has-shaded-fill = false
+ prefix-bounds Rect
+ has-prefix-bounds = false

────────────────────
_ do clear

vector-colors.clear()
colors.clear()
item-colors.clear()
transforms.clear()
item-transforms.clear()
states.clear()
states += DisplayState(0, DisplayStateKind.root)
wire-dirty = true
item-states.clear()
item-inks.clear()
item-styles.clear()
item-strokes.clear()
item-dashes.clear()
path-verbs.clear()
path-coords.clear()
path-styles.clear()
styled-wires.clear()
gradient-wires.clear()
gradient-stops.clear()
shader-args.clear()
images.clear()
image-identities.clear()
backdrop-shaders.clear()
shape-clips = 0
mask-layers = 0
blur-layers = 0
has-backdrop = false
content-state = 0
has-antialiased = false
has-shaded-fill = false
prefix-bounds = display-no-rect
has-prefix-bounds = false

────────────────────
_ do add-gradient
    - gradient Gradient

. stops = gradient.stops
. stop-start = gradient-stops.length as U32
. stop-count = stops.length as U32
for stop in stops
    gradient-stops += stop
do match gradient
    | linear LinearGradient
        gradient-wires += DisplayGradientWire
            - linear.start
            - linear.end
            - 0
            - 0
            - display-gradient-linear
            - stop-start
            - stop-count
    | radial RadialGradient
        gradient-wires += DisplayGradientWire
            - radial.start-center
            - radial.end-center
            - radial.start-radius
            - radial.end-radius
            - display-gradient-radial
            - stop-start
            - stop-count
    | conic ConicGradient
        gradient-wires += DisplayGradientWire
            - conic.center
            - conic.center
            - conic.angle
            - 0
            - display-gradient-conic
            - stop-start
            - stop-count
= gradient-wires.length as U32

────────────────────
_ do add-shader
    - rect Rect
    - shader Shader
    - args [F64]
    - epoch F64 = -1

. arg-start = shader-args.length as U32
for arg in args
    shader-args += arg
gradient-wires += DisplayGradientWire
    - rect.top-left
    - Point(rect.width, rect.height)
    - 0
    - epoch
    - display-gradient-shader
    - arg-start
    - args.length as U32
    - shader.id
= gradient-wires.length as U32

────────────────────
_ do add-paint
    - paint Paint
    - color RGBA

. arg-start = shader-args.length as U32
for arg in paint.args
    shader-args += arg
gradient-wires += DisplayGradientWire
    - Point(color.red, color.green)
    - Point(color.blue, color.alpha)
    - 0
    - 0
    - display-gradient-paint
    - arg-start
    - paint.args.length as U32
    - paint.shader.id
= gradient-wires.length as U32

────────────────────
_ do add-brush
    - brush Brush
    - color RGBA

. arg-start = shader-args.length as U32
append-brush-arguments(brush, shader-args)
gradient-wires += DisplayGradientWire
    - Point(color.red, color.green)
    - Point(color.blue, color.alpha)
    - 0
    - 0
    - display-gradient-brush
    - arg-start
    - (shader-args.length as U32) - arg-start
    - brush.shader.id
= gradient-wires.length as U32

────────────────────
_ do mask-owner
    - state U32

. cursor = state
while cursor != 0 && states[cursor].kind != DisplayStateKind.mask-layer
    cursor = states[cursor].parent
= cursor

────────────────────
_ do translates-at
    - state U32

. cursor = state
while cursor != 0
    . entry = states[cursor]
    . kind = entry.kind
    =? false if kind == DisplayStateKind.content
    =? false if kind == DisplayStateKind.transform && !entry.matrix.is-translation
    cursor = entry.parent
= true

────────────────────
_ do blend-at
    - state U32

. cursor = state
while cursor != 0
    . kind = states[cursor].kind
    =? states[cursor].blend if kind == DisplayStateKind.blend
    =? BlendMode.normal if kind == DisplayStateKind.layer || kind == DisplayStateKind.mask-layer
    =? BlendMode.normal if kind == DisplayStateKind.blur
    cursor = states[cursor].parent
= BlendMode.normal

────────────────────
_ do add-state
    - state DisplayState

. parent = states[state.parent]
. placed = state
placed = placed.full = parent.full
placed = placed.clip-bounds = parent.clip-bounds
placed = placed.has-clip-bounds = parent.has-clip-bounds
placed = placed.local-ink = display-no-rect
placed = placed.has-local-ink = false
placed = resolve-state(placed, parent)
. index = states.length as U32
states += placed
if state.kind == DisplayStateKind.clip-outline || state.kind == DisplayStateKind.clip-path
    shape-clips += 1
if state.kind == DisplayStateKind.mask-layer
    mask-layers += 1
if state.kind == DisplayStateKind.blur
    blur-layers += 1
wire-dirty = true
= index

────────────────────
_ do resolve-state
    - state DisplayState
    - parent DisplayState

. placed = state
. kind = state.kind
if kind == DisplayStateKind.transform || kind == DisplayStateKind.content
    placed = placed.full = parent.full.concatenate(state.matrix)
    placed = placed.clip-bounds = parent.clip-bounds
    placed = placed.has-clip-bounds = parent.has-clip-bounds
    = placed
placed = placed.full = parent.full
. clip Rect? = null
if kind == DisplayStateKind.clip || kind == DisplayStateKind.clip-outline
    clip = parent.full.transform(state.rect)
else if kind == DisplayStateKind.clip-path || kind == DisplayStateKind.clip-mask
    clip = parent.full.transform(state.rect)
if clip
    . bounded = clip
    if parent.has-clip-bounds
        bounded = parent.clip-bounds.intersection(bounded)
    placed = placed.clip-bounds = bounded
    placed = placed.has-clip-bounds = true
else
    placed = placed.clip-bounds = parent.clip-bounds
    placed = placed.has-clip-bounds = parent.has-clip-bounds
= placed

────────────────────
_ do refresh-states

. index Size = 1
while index < states.length
    . state = states[index]
    states[index] = resolve-state(state, states[state.parent])
    index += 1
wire-dirty = true

────────────────────
_ do refresh-wire-states

=? if !wire-dirty
wire-states.clear()
for state in states
    wire-states += DisplayStateWire
        - state.parent
        - state.kind
        - state.matrix
        - state.rect
        - state.opacity
        - state.radius
        - state.side
        - state.offset
        - state.size
        - state.path-start
        - state.path-count
        - state.coord-start
        - if state.fill-rule == FillRule.even-odd then 1u32 else 0u32
        - state.serial
        - state.source
        - state.blend
wire-dirty = false

────────────────────
_ do include-state-ink
    - state U32
    - ink Rect

=? if ink.width < 0 || ink.height < 0
. current = states[state]
if current.has-local-ink
    states[state] = current.local-ink = current.local-ink + ink
else
    . updated = current.local-ink = ink
    states[state] = updated.has-local-ink = true

────────────────────
_ do state-ink-bounds
    - state U32
    - ink Rect

=? null if ink.width < 0 || ink.height < 0
. current = states[state]
. placed = current.full.transform(ink)
. bounds = current
if blur-layers > 0
    . cursor = state
    while cursor != 0
        . entry = states[cursor]
        if entry.kind == DisplayStateKind.blur
            . matrix = entry.full
            . scale = sqrt(abs(matrix.a * matrix.d - matrix.b * matrix.c))
            placed = placed.pad(-(entry.radius * scale + 1))
            bounds = entry
        cursor = entry.parent
if bounds.has-clip-bounds
    placed = placed.intersection(bounds.clip-bounds)
=? null if placed.width <= 0 || placed.height <= 0
= placed

────────────────────
_ do state-path-bounds
    - start U32
    - coord-start U32
    - count U32

. coord = coord-start as Index
. min-x F64
. min-y F64
. max-x F64
. max-y F64
. found = false
for verb-index in 0 .. < (count as Size)
    . verb = path-verbs[(start as Index) + verb-index]
    . pairs Size = 0
    if verb == DisplayPathVerb.move || verb == DisplayPathVerb.line
        pairs = 1
    else if verb == DisplayPathVerb.curve
        pairs = 3
    for pair in 0 .. < pairs
        . x = path-coords[coord]
        . y = path-coords[coord + 1]
        coord += 2
        if found
            min-x = min(min-x, x)
            min-y = min(min-y, y)
            max-x = max(max-x, x)
            max-y = max(max-y, y)
        else
            min-x = x
            min-y = y
            max-x = x
            max-y = y
            found = true
= Rect(min-x, min-y, max-x - min-x, max-y - min-y)

