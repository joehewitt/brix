(import ./box)
(import ./events)
(import ./keys)
(import ./layout)
(import ./position)
(import ./primitives)
(import ./shorthands)
(import ./styles)
(import ./theme)
(import /core/function)
(import /core/intrinsics)
(import /core/markup)
(import /graphics/color)
(import /graphics/point)
(import /graphics/primitives)
(import /math)
(import /ui/input)
(import /ui/value-change-phase)
(blank)
(prop _ slider-thumb-size Length (= 15))
(prop _ slider-thumb-radius Length (= (/ slider-thumb-size 2)))
(prop _ slider-track-radius Length (= 2))
(prop + slider-pill-radius Length (= 1000))

(style-extend GUIDefaultTheme
  (using GUIBoxPaint)
  (using GUIFocusRingStyle)
  (using GUIBoxSize)
  (using GUIBoxPlacement)
  (using GUIBoxLayout)
  (using GUIBoxMotion)
  (rule Slider (• flex-row)
    (= corner-radius slider-thumb-radius)
    (blank)
    (when-style #is-vertical
      (= layout flex-col)
      (blank)
      (rule SliderTrack (• w 4)
        (= min-height (. SizeSpec auto))
        (= max-height (. SizeSpec auto))
        (= left null)
        (= right null)
        (= top (call (. PositionOffset coord) slider-thumb-radius))
        (= bottom (call (. PositionOffset coord) slider-thumb-radius))
        (= align-x (. Alignment center))
        (= align-y null)
      )
      (blank)
      (rule SliderFill (• w 4)
        (= min-height (. SizeSpec auto))
        (= max-height (. SizeSpec auto))
        (= left null)
        (= right null)
        (= top (call (. PositionOffset coord) (- slider-thumb-radius)))
        (= bottom (call (. PositionOffset coord) slider-thumb-radius))
        (= align-x (. Alignment center))
        (= align-y null)
      )
    )
    (blank)
    (when-style #is-focus-visible
      (= focus-ring gui-focus-ring)
      (= (. motion focus-ring) gui-motion-quick)
    )
    (blank)
    (when-style #is-dragging
      (rule SliderThumb (• bg gui-accent-color))
    )
    (blank)
    (when-style (not #is-operable)
      (rule SliderFill (• bg gui-disabled-text-color))
      (blank)
      (rule SliderThumb (• bg gui-well-color)
        (= border-color gui-disabled-text-color)
      )
    )
  )
  (blank)
  (rule SliderTrack (• bg gui-track-color) (• h 4)
    (= corner-radius slider-track-radius)
    (= left (call (. PositionOffset coord) slider-thumb-radius))
    (= right (call (. PositionOffset coord) slider-thumb-radius))
    (= align-y (. Alignment center))
  )
  (blank)
  (rule SliderFill (• bg gui-accent-bright-color) (• h 4)
    (= corner-radius slider-track-radius)
    (= left (call (. PositionOffset coord) slider-thumb-radius))
    (= right (call (. PositionOffset coord) (- slider-thumb-radius)))
    (= align-y (. Alignment center))
  )
  (blank)
  (rule SliderThumb (• w 11) (• h 11)
    (= background-color (call (. gui-field-color over) gui-window-color))
    (= border-color gui-accent-bright-color)
    (= border-width 2)
    (= corner-radius slider-thumb-radius)
  )
  (blank)
  (rule SliderThumbSwatch
    (= corner-radius slider-pill-radius)
  )
)

(type + Slider (is Box)
  (rule This
    (= focus-mode (. FocusMode keys))
    (= window-draggable false)
  )
  (blank)
  (prop + minimum F64)
  (prop + maximum F64 (= 1))
  (prop + value F64 (= 0))
  (prop + default-value (? F64))
  (prop + step F64)
  (prop + orientation _ (= (. Orientation horizontal)))
  (prop + is-vertical _ (= (== #orientation (. Orientation vertical))))
  (prop + is-operable _ (= true))
  (prop + is-focus-enabled _ (=> is-operable))
  (event + value-changing (of ValueChange F64))
  (event + value-changed (of ValueChange F64))
  (blank)
  (prop _ drag-thumb-offset Length)
  (prop _ render-ratio F64)
  (prop _ render-remainder F64 (= 1))
  (event _ inoperable Bool)
  (event _ unmounting Bool)
  (blank)
  (depends slider-state-changed minimum maximum value is-effectively-enabled)
  (content
    (<> This
      (<> SliderTrack (id: track) (• absolute)
        (= anchor (. Anchor parent))
      )
      (blank)
      (<> SliderFillSlot
        (= flex (if-expr #is-vertical #render-remainder #render-ratio))
        (if (not #is-vertical)
          (<> SliderFill (• absolute)
            (= anchor (. Anchor parent))
          )
        )
      )
      (blank)
      (<> SliderThumbSlot (id: thumb-slot))
      (blank)
      (<> SliderRemainder
        (= flex (if-expr #is-vertical #render-ratio #render-remainder))
        (if #is-vertical
          (<> SliderFill (• absolute)
            (= anchor (. Anchor parent))
          )
        )
        (= increase-small (=> () :do (call accept-user-value (+ effective-value small-increment))))
        (= decrease-small (=> () :do (call accept-user-value (- effective-value small-increment))))
        (= increase-page (=> () :do (call accept-user-value (+ effective-value (* small-increment 10)))))
        (= decrease-page (=> () :do (call accept-user-value (- effective-value (* small-increment 10)))))
        (= go-minimum (=> () :do (call accept-user-value minimum)))
        (= go-maximum (=> () :do (call accept-user-value maximum)))
      )
    )
    (blank)
    (state is-idle)
    (blank)
    (state is-dragging (trigger for press pointer-down (and (== (. press button) (. PointerButton primary)) is-operable (not is-dragging) (not (call resets press))))
      (if (call event-target-is-thumb press)
        (= drag-thumb-offset (- thumb-center (call along (. press point))))
        (call accept-user-value effective-value (. ValueChangePhase began))
        (else
          (= drag-thumb-offset 0)
          (call accept-pointer-position (call along (. press point)) (. ValueChangePhase began))
        )
      )
      (blank)
      (for (on drag pointer-drag (when (and (== (. drag pointer-id) (. press pointer-id)) (== (. drag button) (. PointerButton primary)))))
        (call accept-pointer-position (call along (. drag point)) (. ValueChangePhase changed))
        (call (. drag cancel))
      )
      (blank)
      (then is-idle (trigger for up pointer-up (and (== (. up pointer-id) (. press pointer-id)) (== (. up button) (. PointerButton primary))))
        (call accept-pointer-position (call along (. up point)) (. ValueChangePhase ended))
        (call (. up cancel))
      )
      (blank)
      (then (call awaiting-release (. press pointer-id)) (trigger on blur))
      (then (call awaiting-release (. press pointer-id)) (trigger on inoperable))
      (then is-idle (trigger on unmounting)
        (call publish-drag-ended)
      )
    )
    (blank)
    (state (call awaiting-release pointer-id)
      (call publish-drag-ended)
      (blank)
      (for (on drag pointer-drag (when (and (== (. drag pointer-id) pointer-id) (== (. drag button) (. PointerButton primary)))))
        (call (. drag cancel))
      )
      (blank)
      (then is-idle (trigger for up pointer-up (and (== (. up pointer-id) pointer-id) (== (. up button) (. PointerButton primary))))
        (call (. up cancel))
      )
      (blank)
      (then is-idle (trigger on unmounting))
    )
  )
  (subscribe-for (on press pointer-down (when (or (!= (. press button) (. PointerButton primary)) (not is-operable) is-dragging)))
    (call (. press cancel))
  )
  (subscribe-for (on press pointer-down (when (and (== (. press button) (. PointerButton primary)) is-operable (not is-dragging) (call resets press))))
    (let reset default-value)
    (if (!= reset null)
      (call accept-user-value reset)
    )
    (call (. press cancel))
  )
  (fn-do + mounted _
    (call (. super mounted))
    (call slider-state-changed)
  )
  (fn-do + unmounted _
    (<- unmounting true)
    (call (. super unmounted))
  )
  (fn-expr + measured-content-size _
    (param query MeasureQuery)
    (case? is-vertical
      (call Dimensions (call max 21 (. thumb width)) 120)
    )
    (default
      (call Dimensions 120 (call max 21 (. thumb height)))
    )
    (where
      (lazy thumb (. (call (. thumb-slot measure) query) outer-size))
    )
  )
  (fn-do _ slider-state-changed _
    (= is-operable (and is-effectively-enabled has-valid-range))
    (= render-ratio (call calculate-render-ratio))
    (= render-remainder (- 1 render-ratio))
    (if (not is-operable)
      (<- inoperable true)
    )
  )
  (fn-do + accept-user-value _
    (param candidate F64)
    (param phase ValueChangePhase (= (. ValueChangePhase discrete)))
    (return-if (if (not is-operable)))
    (let next (call normalized-user-value candidate))
    (let old effective-value)
    (if (== next old)
      (if (!= value next)
        (= value next)
      )
      (return-if (if (or (== phase (. ValueChangePhase discrete)) (== phase (. ValueChangePhase changed)))))
      (else
        (let change (call (of ValueChange F64) old next phase))
        (<- value-changing change)
        (return-if (if (. change is-canceled)))
        (= value next)
      )
    )
    (<- value-changed (call (of ValueChange F64) old next phase))
  )
  (fn-do _ accept-pointer-position _
    (param pointer Length)
    (param phase ValueChangePhase)
    (let travel track-travel)
    (if (<= travel 0)
      (call accept-user-value effective-value phase)
      (return)
    )
    (let offset (/ (- (+ pointer drag-thumb-offset) track-start) travel))
    (let ratio (if-expr is-vertical (- 1 offset) offset))
    (call accept-user-value (+ minimum (* ratio (- maximum minimum))) phase)
  )
  (fn-expr _ normalized-user-value _
    (param candidate F64)
    (case? (or (not (call is-finite candidate)) (<= candidate minimum))
      minimum
    )
    (case? (>= candidate maximum)
      maximum
    )
    (case? (or (not (call is-finite step)) (<= step 0))
      candidate
    )
    (default
      (call min maximum (call max minimum (+ minimum (* (call round (/ (- candidate minimum) step)) step))))
    )
  )
  (fn-expr _ has-valid-range _ :get
    (and (call is-finite minimum) (call is-finite maximum) (> maximum minimum))
  )
  (fn-expr _ effective-value _ :get
    (case? (or (not has-valid-range) (not (call is-finite value)) (<= value minimum))
      minimum
    )
    (case? (>= value maximum)
      maximum
    )
    (default
      value
    )
  )
  (fn-expr _ calculate-render-ratio _
    (case? (not has-valid-range)
      0
    )
    (default
      (/ (- effective-value minimum) (- maximum minimum))
    )
  )
  (fn-expr _ small-increment _ :get
    (case? (and (call is-finite step) (> step 0))
      step
    )
    (default
      (* (- maximum minimum) 0.01)
    )
  )
  (fn-expr _ track-start Length :get
    (case? is-vertical
      (+ (- (. content-bounds y) (. bounds y)) (/ (. thumb-slot height) 2))
    )
    (default
      (+ (- (. content-bounds x) (. bounds x)) (/ (. thumb-slot width) 2))
    )
  )
  (fn-expr _ track-travel Length :get
    (case? is-vertical
      (call max 0 (- (. content-bounds height) (. thumb-slot height)))
    )
    (default
      (call max 0 (- (. content-bounds width) (. thumb-slot width)))
    )
  )
  (fn-expr _ thumb-center Length :get
    (+ track-start (* (if-expr is-vertical (- 1 ratio) ratio) track-travel))
    (where
      (lazy ratio (call calculate-render-ratio))
    )
  )
  (fn-expr _ along Length
    (param point Point)
    (if-expr is-vertical (. point y) (. point x))
  )
  (fn-expr _ resets Bool
    (param press PointerDownEvent)
    (and (!= default-value null) (>= (. press click-count) 2) (call event-target-is-thumb press))
  )
  (fn-expr _ event-target-is-thumb _
    (param event GUIEvent)
    (case? (not thumb)
      false
    )
    (default
      (== (as owner (? Pointer)) (as this (? Pointer)))
    )
    (where
      (lazy thumb (of (?. (. event hit-box) ancestor-or-self) SliderThumb))
      (lazy owner (of (. thumb ancestor) Slider))
    )
  )
  (fn-do _ publish-drag-ended _
    (let current effective-value)
    (<- value-changed (call (of ValueChange F64) current current (. ValueChangePhase ended)))
  )
)

(type + SliderTrack (is Box))

(type + SliderFill (is Box))

(type + SliderThumb (is Box)
  (prop + swatch (? RGBA))
  (content
    (<> This (• flex-row)
      (if #swatch
        (<> SliderThumbSwatch (• flex 1)
          (= background-color #swatch)
        )
      )
    )
  )
)

(type + SliderThumbSwatch (is Box))

(type _ SliderFillSlot (is Box))

(type + SliderThumbSlot (is Box)
  (prop + swatch (? RGBA))
  (content
    (<> This
      (<> SliderThumb (id: thumb) (• absolute) (• center .parent)
        (= swatch #swatch)
      )
    )
  )
  (fn-do + measured-content-size _
    (param query MeasureQuery)
    (let size (. (call (. thumb measure) query) outer-size))
    (let width (. size width))
    (if (. query inline available)
      (= width (call min width (. query inline available)))
    )
    (return (call Dimensions width (. size height)))
  )
)

(type _ SliderRemainder (is Box)
  (prop + increase-small Doer)
  (prop + decrease-small Doer)
  (prop + increase-page Doer)
  (prop + decrease-page Doer)
  (prop + go-minimum Doer)
  (prop + go-maximum Doer)
  (content
    (<> This
      (<> KeyShortcut (text: "Increase")
        (= key .arrow-right)
        (= discoverable false)
        (= action increase-small)
      )
      (blank)
      (<> KeyShortcut (text: "Increase")
        (= key .arrow-up)
        (= discoverable false)
        (= action increase-small)
      )
      (blank)
      (<> KeyShortcut (text: "Decrease")
        (= key .arrow-left)
        (= discoverable false)
        (= action decrease-small)
      )
      (blank)
      (<> KeyShortcut (text: "Decrease")
        (= key .arrow-down)
        (= discoverable false)
        (= action decrease-small)
      )
      (blank)
      (<> KeyShortcut (text: "Page Up")
        (= key .page-up)
        (= discoverable false)
        (= action increase-page)
      )
      (blank)
      (<> KeyShortcut (text: "Page Down")
        (= key .page-down)
        (= discoverable false)
        (= action decrease-page)
      )
      (blank)
      (<> KeyShortcut (text: "Minimum")
        (= key .home)
        (= discoverable false)
        (= action go-minimum)
      )
      (blank)
      (<> KeyShortcut (text: "Maximum")
        (= key .end)
        (= discoverable false)
        (= action go-maximum)
      )
    )
  )
)
