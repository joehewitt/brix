./box
./primitives
/core/style
/graphics/canvas
/graphics/image
/graphics/primitives

━━━━━━━━━━━━━━━━━━━━
+ GUIImageStyle is Style

+ image-fit = ImageFit.contain
+ image-align-x = AnchorPoint.center
+ image-align-y = AnchorPoint.center
+ image-sampling = ImageSampling.smooth

. image-fit -> paint
. image-align-x -> paint
. image-align-y -> paint
. image-sampling -> paint

━━━━━━━━━━━━━━━━━━━━
+ ImageView is Box
    using GUIImageStyle

+ image Image?

_ held Image?
_ image-revision = #image?.#revision ?? 0

. image-changed < image
. invalidate-paint < image-revision

────────────────────
+ This
    - image Image? = null

hold(image)

────────────────────
+ get image-rect Rect?

|? image
    image-fit-rect(image!.size, content-bounds, $image-fit, $image-align-x, $image-align-y)
??
    null

────────────────────
_ do image-changed

hold(image)
invalidate-content-size()
invalidate-paint()

────────────────────
_ do hold
    - current Image?

=? if current == held
current?.retain()
held?.release()
held = current

╌╌╌╌╌╌╌╌╌╌ is Box ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do close

hold(null)
super.close()

────────────────────
+ do paint-self
    - canvas Canvas

. current = held
=? if !current || current.is-released
. content = content-bounds
=? if content.width <= 0 || content.height <= 0
. rect = image-fit-rect(current.size, content, $image-fit, $image-align-x, $image-align-y)
do use canvas.saved-state
    canvas.clip(content)
    current.draw • destination canvas
        - rect
        - $image-sampling

────────────────────
+ measured-content-size
    - query MeasureQuery

|? natural.width <= 0 || natural.height <= 0
    natural
|? width-only
    Dimensions(width, natural.height * width / natural.width)
|? height-only
    Dimensions(natural.width * height / natural.height, height)
??
    natural

.. natural = image?.size ?? Dimensions(0, 0)
.. width = constrained-axis-size(natural.width, query.inline, $min-width, $max-width)
.. height = constrained-axis-size(natural.height, query.block, $min-height, $max-height)
.. width-only = width != natural.width && height == natural.height
.. height-only = height != natural.height && width == natural.width
