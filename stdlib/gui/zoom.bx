(import ./box)
(import ./events)
(import ./pinch)
(import ./primitives)
(import /graphics/point)
(import /graphics/primitives)
(import /math)
(import /ui/input)
(blank)
(prop _ zoom-wheel-line Length (= 40))
(prop _ zoom-precise-rate F64 (= 0.01))
(prop _ zoom-line-rate F64 (= 0.15))

(type + ZoomBounds (is Tuple)
  (prop + natural Dimensions)
  (prop + fitted Rect)
  (prop + low F64)
  (prop + high F64)
  (prop + ink _ (= (call Insets 0 0 0 0)))
)

(type + ZoomOwner (is Interface)
  (fn-do + zoom-bounds ZoomBounds)
)

(type + ZoomChrome (is Interface)
  (fn-do + zoom-chrome (list Rect))
)

(type + ZoomFrame
  (prop + box Box)
  (prop + owner ZoomOwner)
  (prop + zoom (? F64) (= null))
  (prop + center (? Point) (= null))
  (prop + is-immersed _ (= false))
  (event + moved Bool)
  (blank)
  (prop _ immersed-zoom (? F64) (= null))
  (prop _ pinch _ (:= (call PinchTracker box)))
  (prop _ drag-origin (? Point))
  (prop _ drag-center _ (= (call Point 0 0)))
  (fn-do + This _
    (param box _)
    (param owner _)
  )
  (subscribe-for (on change (. pinch moved))
    (call show (call (. owner zoom-bounds)) (. change scale) (. change anchor))
  )
  (subscribe-for (on change (. pinch ended))
    (call zoom-to (. change scale) (. change anchor))
  )
  (fn-expr + is-fit Bool :get
    (== zoom null)
  )
  (fn-expr + is-pinching Bool :get
    (. pinch is-active)
  )
  (fn-do + immerse Bool
    (param chrome (list Rect))
    (let level zoom)
    (let is-held (and is-immersed (!= level null) (== level immersed-zoom)))
    (let covering (or is-held (and (!= level null) (call zoom-covers (call inked) chrome))))
    (= immersed-zoom level)
    (return-if false (if (== covering is-immersed)))
    (blank)
    (= is-immersed covering)
    (return true)
  )
  (fn-expr + fit-zoom F64
    (call zoom-fit-level (call (. owner zoom-bounds)))
  )
  (fn-expr + effective-zoom F64
    (?? zoom (call fit-zoom))
  )
  (fn-expr + placed Rect
    (call placed-in (call (. owner zoom-bounds)))
  )
  (fn-do + zoom-to _
    (param level F64)
    (param anchor (? Point) (= null))
    (let bounds (call (. owner zoom-bounds)))
    (let next (call max (. bounds low) (call min (call max (. bounds high) (. bounds low)) level)))
    (if (and (<= next (call zoom-fit-level bounds)) (>= (. bounds low) (call zoom-fit-level bounds)))
      (call fit)
      (return)
    )
    (call show bounds next anchor)
  )
  (fn-do + zoom-by _
    (param factor F64)
    (param anchor (? Point) (= null))
    (return-if (if (<= factor 0)))
    (blank)
    (call zoom-to (* (call effective-zoom) factor) anchor)
  )
  (fn-do + fit _
    (call (. pinch reset))
    (= zoom null)
    (= center null)
    (<- moved is-fit)
  )
  (fn-do + pan-by _
    (param delta Point)
    (let level zoom)
    (return-if (if (== level null)))
    (blank)
    (let bounds (call (. owner zoom-bounds)))
    (let origin (call visible-center bounds))
    (= center (call clamped bounds (call Point (+ (. origin x) (/ (. delta x) level)) (+ (. origin y) (/ (. delta y) level))) level))
    (<- moved is-fit)
  )
  (fn-do + handle-scroll Bool
    (param event ScrollEvent)
    (if (or (. event modifiers command) (. event modifiers control) (. event modifiers option))
      (let rate (if-expr (. event is-precise) zoom-precise-rate zoom-line-rate))
      (call zoom-by (call exp (* (- (. event delta-y)) rate)) (. event point))
      (return true)
    )
    (return-if false (if (== zoom null)))
    (blank)
    (let line (if-expr (. event is-precise) 1 zoom-wheel-line))
    (call pan-by (call Point (* (. event delta-x) line) (* (. event delta-y) line)))
    (return true)
  )
  (fn-do + handle-magnify Bool
    (param event MagnifyEvent)
    (let bounds (call (. owner zoom-bounds)))
    (return-if false (if (or (<= (. bounds natural width) 0) (<= (. bounds natural height) 0))))
    (blank)
    (= (. pinch low) (. bounds low))
    (= (. pinch high) (call max (. bounds high) (. bounds low)))
    (return (call (. pinch handle) event (?? zoom (call zoom-fit-level bounds))))
  )
  (fn-do + handle-pointer-down Bool
    (param event PointerDownEvent)
    (return-if false (if (!= (. event button) (. PointerButton primary))))
    (blank)
    (if (== (. event click-count) 2)
      (= drag-origin null)
      (if (== zoom null)
        (call zoom-to (call max 1 (* (call fit-zoom) 2)) (. event point))
        (else
          (call fit)
        )
      )
      (return true)
    )
    (= drag-origin (. event point))
    (= drag-center (call visible-center (call (. owner zoom-bounds))))
    (return false)
  )
  (fn-do + handle-pointer-drag Bool
    (param event PointerDragEvent)
    (let origin drag-origin)
    (let level zoom)
    (return-if false (if (or (not origin) (== level null))))
    (blank)
    (let target
      (call Point
        (block
          (arg (- (. drag-center x) (/ (- (. event point x) (. origin x)) level)))
          (arg (- (. drag-center y) (/ (- (. event point y) (. origin y)) level)))
        )
      )
    )
    (= center (call clamped (call (. owner zoom-bounds)) target level))
    (<- moved is-fit)
    (return true)
  )
  (fn-do + handle-pointer-up _
    (= drag-origin null)
  )
  (fn-expr _ inked Rect
    (case? (<= (. bounds natural width) 0)
      rect
    )
    (default
      (call (. rect inset) (call Insets (* (. ink top) scale) (* (. ink right) scale) (* (. ink bottom) scale) (* (. ink left) scale)))
    )
    (where
      (lazy bounds (call (. owner zoom-bounds)))
      (lazy rect (call placed-in bounds))
      (lazy scale (/ (. rect width) (. bounds natural width)))
      (lazy ink (. bounds ink))
    )
  )
  (fn-do _ show _
    (param bounds ZoomBounds)
    (param level F64)
    (param anchor (? Point))
    (return-if (if (or (<= (. bounds natural width) 0) (<= (. bounds natural height) 0))))
    (blank)
    (let prior (?? zoom (call zoom-fit-level bounds)))
    (return-if (if (or (<= prior 0) (<= level 0))))
    (blank)
    (let content (. box content-bounds))
    (let frame (. box bounds))
    (let focus (if-expr anchor (call Point (+ (. anchor x) (. frame x)) (+ (. anchor y) (. frame y))) (. content center)))
    (let offset-x (- (. focus x) (. content center x)))
    (let offset-y (- (. focus y) (. content center y)))
    (let origin (call visible-center bounds))
    (let target (call Point (+ (. origin x) (/ offset-x prior)) (+ (. origin y) (/ offset-y prior))))
    (= zoom level)
    (= center (call clamped bounds (call Point (- (. target x) (/ offset-x level)) (- (. target y) (/ offset-y level))) level))
    (<- moved is-fit)
  )
  (fn-expr _ placed-in Rect
    (param bounds ZoomBounds)
    (match zoom
      (case= null
        (. bounds fitted)
      )
      (case (: level F64)
        (call Rect
          (block
            (arg (- (. content center x) (* (. focus x) level)))
            (arg (- (. content center y) (* (. focus y) level)))
            (arg (* (. natural width) level))
            (arg (* (. natural height) level))
          )
        )
        (blank)
        (lazy focus (call clamped bounds (?? center (call Point (/ (. natural width) 2) (/ (. natural height) 2))) level))
      )
    )
    (where
      (lazy natural (. bounds natural))
      (lazy content (. box content-bounds))
    )
  )
  (fn-expr _ visible-center Point
    (param bounds ZoomBounds)
    (case? (<= scale 0)
      (call Point 0 0)
    )
    (default
      (call Point (/ (- (. content center x) (. rect x)) scale) (/ (- (. content center y) (. rect y)) scale))
    )
    (where
      (lazy rect (call placed-in bounds))
      (lazy scale (if-expr (> (. bounds natural width) 0) (/ (. rect width) (. bounds natural width)) 0.0))
      (lazy content (. box content-bounds))
    )
  )
  (fn-expr _ clamped Point
    (param bounds ZoomBounds)
    (param target Point)
    (param level F64)
    (call Point
      (block
        (arg (call zoom-clamp-axis (. target x) level (. middle x) (. natural width) (. fitted x) (. fitted right)))
        (arg (call zoom-clamp-axis (. target y) level (. middle y) (. natural height) (. fitted y) (. fitted bottom)))
      )
    )
    (where
      (lazy natural (. bounds natural))
      (lazy fitted (. bounds fitted))
      (lazy middle (. box content-bounds center))
    )
  )
)

(fn-expr _ zoom-fit-level F64
  (param bounds ZoomBounds)
  (case? (or (<= (. bounds natural width) 0) (<= (. bounds natural height) 0))
    1
  )
  (default
    (/ (. bounds fitted width) (. bounds natural width))
  )
)

(fn-expr _ zoom-clamp-axis F64
  (param value F64)
  (param level F64)
  (param middle F64)
  (param extent F64)
  (param start F64)
  (param end F64)
  (/ (- middle (call clamp (- middle (* value level)) (call min start (- end span)) (call max start (- end span)))) level)
  (where
    (lazy span (* extent level))
  )
)

(fn-do + zoom-covers Bool
  (param rect Rect)
  (param chrome (list Rect))
  (for (in area chrome)
    (let overlap (call (. rect intersection) area))
    (return-if true (if (and (> (. overlap width) 0) (> (. overlap height) 0))))
  )
  (return false)
)
