(import /code/file-text)
(import /graphics/primitives)
(import /graphics/text)
(import /gui)
(import /gui/icons/lucide/case-sensitive)
(import /gui/icons/lucide/regex)
(import /gui/icons/lucide/whole-word)
(import /os/path)
(import /time/duration)
(blank)
(prop _ file-text-search-delay _ (= 80ms))

(style-extend GUIDefaultTheme
  (using GUIBoxPaint)
  (using GUIBoxSize)
  (using GUIBoxSpacing)
  (using GUIFontStyle)
  (using GUITextComposition)
  (using GUITextPaint)
  (rule FileTextPalette (• w 760) (• h 420)
    (rule file-text-match
      (= font-family "Menlo")
      (= font-size 12)
      (= text-wrap (. TextWrap no-wrap))
      (= text-overflow (. TextOverflow truncate-tail))
    )
    (blank)
    (rule file-text-location (• text gui-muted-text-color) (• ml 12)
      (= text-wrap (. TextWrap no-wrap))
      (= text-overflow (. TextOverflow truncate-head))
    )
  )
)

(type + FileTextPalette (is (of Palette FileTextMatch))
  (prop + folder Path)
  (prop + matches (list FileTextMatch))
  (prop + is-searching _ (= false))
  (prop + is-truncated _ (= false))
  (prop + matches-case _ (= false))
  (prop + matches-word _ (= false))
  (prop + is-regex _ (= false))
  (prop + prompt _ (= "Find in files"))
  (prop + empty-text _ (= (call file-text-empty-text #query #is-searching)))
  (prop + results _ (= #matches))
  (prop + key-builder _ (= (=> (match) (str (. match path) ":" (. match line) ":" (. match column)))))
  (blank)
  (prop _ active (? FileTextSearch))
  (prop _ request U64)
  (prop _ is-fresh _ (= false))
  (prop _ last-query _ (= ""))
  (content
    (<> This
      (<> Box (slot: trailing) (• flex-row) (• items-center)
        (<> IconButton (• icon-case-sensitive) (• w 22) (• h 20) (• ml 2)
          (= is-on #matches-case)
          (= action (=> () :do (call toggle-case)))
          (<> Tooltip (text: "Match Case (⌥⌘C)"))
        )
        (<> IconButton (• icon-whole-word) (• w 22) (• h 20) (• ml 2)
          (= is-on #matches-word)
          (= action (=> () :do (call toggle-word)))
          (<> Tooltip (text: "Match Whole Word (⌥⌘W)"))
        )
        (<> IconButton (• icon-regex) (• w 22) (• h 20) (• ml 2)
          (= is-on #is-regex)
          (= action (=> () :do (call toggle-regex)))
          (<> Tooltip (text: "Use Regular Expression (⌥⌘R)"))
        )
      )
      (blank)
      (<> FileTextRow (slot: row) (param: row)
        (= match (. row #item))
      )
      (blank)
      (<> KeyShortcut (text: "Match Case")
        (= key (call KeyCombo "Option+Cmd+C"))
        (= discoverable false)
        (= allow-while-input true)
        (= action (=> () :do (call toggle-case)))
      )
      (<> KeyShortcut (text: "Match Whole Word")
        (= key (call KeyCombo "Option+Cmd+W"))
        (= discoverable false)
        (= allow-while-input true)
        (= action (=> () :do (call toggle-word)))
      )
      (<> KeyShortcut (text: "Use Regular Expression")
        (= key (call KeyCombo "Option+Cmd+R"))
        (= discoverable false)
        (= allow-while-input true)
        (= action (=> () :do (call toggle-regex)))
      )
    )
  )
  (subscribe-for (on reason dismissed (when arrival))
    (= last-query query)
    (call stop)
    (= matches (call (of List FileTextMatch)))
  )
  (fn-do + refresh _
    (+= request 1)
    (call stop)
    (= is-truncated false)
    (if (not query)
      (= is-searching false)
      (= matches (call (of List FileTextMatch)))
      (return)
    )
    (= is-searching true)
    (let current request)
    (do-new
      (inline (call begin current))
    )
  )
  (fn-do + show-seeded _
    (param seed String)
    (let text (if-expr seed seed last-query))
    (call show)
    (return-if (if (not text)))
    (call rewrite text)
    (call (. search-input select-range) 0 (. text length))
  )
  (fn-do _ toggle-case _
    (= matches-case (not matches-case))
    (call renew)
  )
  (fn-do _ toggle-word _
    (= matches-word (not matches-word))
    (call renew)
  )
  (fn-do _ toggle-regex _
    (= is-regex (not is-regex))
    (call renew)
  )
  (fn-do _ renew _
    (call (. search-input request-focus))
    (call refresh)
  )
  (fn-do _ begin _
    (param current U64)
    (call (. file-text-search-delay wait))
    (return-if (if (or (!= current request) (not is-open))))
    (let asked (call FileTextQuery query is-regex (only-if true (if matches-case)) matches-word))
    (let search (call FileTextSearch folder asked))
    (= active search)
    (= is-fresh true)
    (for (on batch (. search found))
      (if (== current request)
        (call take batch)
      )
    )
    (for (on ended (. search finished))
      (if (== current request)
        (if is-fresh
          (= matches (call (of List FileTextMatch)))
        )
        (= is-fresh false)
        (= is-searching false)
        (= is-truncated (. ended is-truncated))
      )
    )
    (call (. search start))
  )
  (fn-do _ take _
    (param batch (list FileTextMatch))
    (let merged (if-expr is-fresh (call (of List FileTextMatch)) (call (of List FileTextMatch) matches)))
    (= is-fresh false)
    (for (in match batch)
      (+= merged match)
    )
    (= matches merged)
  )
  (fn-do _ stop _
    (let search active)
    (= active null)
    (call (?. search close))
  )
)

(type + FileTextRow (is Box)
  (prop + match (? FileTextMatch))
  (blank)
  (rule This (• flex-row) (• flex 1))
  (content
    (<> This
      (<> MatchLabel (• file-text-match) (• flex 1)
        (= text (call file-text-shown #match))
        (= hits (call file-text-hits #match))
        (= align-y (. Alignment center))
      )
      (<> Label (• file-text-location)
        (= text (call file-text-place #match))
        (= align-y (. Alignment center))
      )
    )
  )
)

(fn-expr _ file-text-shown String
  (param match (? FileTextMatch))
  (case? (not match)
    ""
  )
  (default
    (call (. bytes slice-string) (..< (call file-text-indent bytes) (. bytes size)))
  )
  (where
    (lazy bytes (as (. match text) ([] Byte)))
  )
)

(fn-do _ file-text-hits (list MatchSpan)
  (param match (? FileTextMatch))
  (let spans (list MatchSpan))
  (return-if spans (if (not match)))
  (let indent (call file-text-indent (. match text)))
  (for (in hit (. match hits))
    (if (> (. hit end) indent)
      (let start (if-expr (> (. hit start) indent) (- (. hit start) indent) 0))
      (+= spans (call MatchSpan start (- (. hit end) indent)))
    )
  )
  (return spans)
)

(fn-do _ file-text-indent Size
  (param bytes ([] Byte))
  (let count Size 0)
  (while (and (< count (. bytes size)) (or (== ([] bytes count) 32) (== ([] bytes count) 9)))
    (+= count 1)
  )
  (return count)
)

(fn-expr _ file-text-place String
  (param match (? FileTextMatch))
  (if-expr match (str (. match path) ":" (+ (. match line) 1)) "")
)

(fn-expr _ file-text-empty-text String
  (param query String)
  (param is-searching Bool)
  (case? (not query)
    "Type to search file contents"
  )
  (case? is-searching
    "Searching…"
  )
  (default
    "No matches"
  )
)
