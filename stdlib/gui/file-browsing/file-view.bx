(import ./file-menu)
(import /graphics/color)
(import /graphics/primitives)
(import /gui/box)
(import /gui/clipboard)
(import /gui/drag)
(import /gui/events)
(import /gui/keys)
(import /gui/primitives)
(import /os/file-session)
(import /os/file-tree)
(import /os/path)
(import /stream/aggregate)
(import /ui/input)
(import /ui/key-combo)

(type + FileMark (is Tuple)
  (prop + text String)
  (prop + color RGBA)
  (prop + is-dot _ (= false))
)

(type _ FileRenameCommit (is Tuple)
  (prop + key String)
  (prop + name String)
  (prop + keeps-focus Bool)
)

(type + FileView (is Box)
  (rule This
    (= focus-mode (. FocusMode inside))
  )
  (blank)
  (prop + files FileTree)
  (prop + session FileSession (= (call FileSession)))
  (prop + marks (? (of Map String (list FileMark))))
  (prop + context-node (? FileNode))
  (prop + context-targets (list FileNode))
  (prop + context-owner (? FileNode))
  (blank)
  (prop _ retained (of Map String FileNode) (= (call (of Map String FileNode))))
  (prop _ discarded (? FileNode))
  (event _ rename-requested FileNode)
  (event _ rename-committed FileRenameCommit)
  (event _ rename-canceled Bool)
  (content
    (<> This
      (<> KeyShortcut (id: rename-shortcut) (text: "Rename")
        (= key (call KeyCombo "F2"))
        (= stable-key "files.rename")
        (= repeat false)
        (= action (=> () :do (call begin-rename (call selected-node))))
      )
      (<> KeyShortcut (id: trash-shortcut) (text: "Move to Trash")
        (= key (call KeyCombo "Cmd+Backspace"))
        (= stable-key "files.trash")
        (= repeat false)
        (= action (=> () :do (call (. menu trash) (call selected-nodes))))
      )
      (blank)
      (<> FileMenu (id: menu)
        (= files files)
        (= session session)
        (= node #context-node)
        (= folder #context-owner)
        (= targets #context-targets)
        (= rename-key (. rename-shortcut key))
        (= trash-key (. trash-shortcut key))
        (<+ leading)
      )
    )
    (blank)
    (state is-idle)
    (blank)
    (state (call renaming node) (trigger for node rename-requested)
      (then is-idle (trigger for commit rename-committed (== (. commit key) (. node key)))
        (= discarded null)
        (call report (call attempt-rename node (. commit name)))
        (if (. commit keeps-focus)
          (call show-node node)
          (call focus-list)
        )
      )
      (blank)
      (then is-idle (trigger on rename-canceled)
        (call discard node)
        (call focus-list)
      )
    )
  )
  (subscribe-for (on event pointer-down)
    (if (or (== (. event button) (. PointerButton secondary)) (. event modifiers control))
      (= context-node (call pressed-node event))
      (= context-owner (call pressed-owner event))
      (= context-targets (call targets-for context-node))
    )
  )
  (subscribe-for (on request (. menu rename-requested))
    (call show-node (. request node))
    (call begin-rename (. request node) (. request discards))
  )
  (subscribe-for (on node (. session revealed))
    (call choose node)
    (if (. node is-directory)
      (call expand-node node)
    )
    (call show-node node (. ScrollAlignment center))
    (call focus-list)
  )
  (whenever-rule (. session #current)
    (call follow-current)
  )
  (fn-do + unmounted _
    (call retain-only (call (of Map String FileNode)))
    (call (. super unmounted))
  )
  (fn-expr + selected-node (? FileNode)
    null
  )
  (fn-expr + selected-nodes (list FileNode)
    (if-expr node (list node) (call (of List FileNode)))
    (where
      (lazy node (call selected-node))
    )
  )
  (fn-do + show-node _
    (param node FileNode)
    (param alignment _ (= (. ScrollAlignment nearest)))
  )
  (fn-do + expand-node _
    (param node FileNode)
  )
  (fn-do + focus-list _)
  (fn-do + follow-current _)
  (fn-expr + pressed-node (? FileNode)
    (param event GUIEvent)
    null
  )
  (fn-expr + pressed-owner (? FileNode)
    (param event GUIEvent)
    null
  )
  (fn-do + reveal Bool
    (param target Path)
    (let node (call (. files find) target))
    (return-if false (if (not node)))
    (call show-node node)
    (return true)
  )
  (fn-do + begin-rename _
    (param node (? FileNode))
    (param discards _ (= false))
    (return-if (if (or (not node) (not (. node parent)))))
    (= discarded (only-if node (if discards)))
    (<- rename-requested node)
  )
  (fn-do + commit-rename _
    (param key String)
    (param name String)
    (param keeps-focus Bool)
    (<- rename-committed (call FileRenameCommit key name keeps-focus))
  )
  (fn-do + cancel-rename _
    (<- rename-canceled true)
  )
  (fn-expr + accepts Bool
    (param nodes (list FileNode))
    (param owner FileNode)
    (and (. owner is-directory) (not blocked))
    (where
      (lazy blocked (call some nodes (:where (or (== (?. (. each parent) key) (. owner key)) (call file-node-is-within owner each)))))
    )
  )
  (fn-do + move _
    (param nodes (list FileNode))
    (param owner FileNode)
    (call report (call attempt-move nodes owner))
  )
  (fn-do + drop-operation DropOperation
    (param payload DragPayload)
    (param owner FileNode)
    (param modifiers PointerModifiers)
    (return-if (. DropOperation none) (if (or (not (. owner is-directory)) (not (is payload ClipboardDrag)))))
    (let paths (. (as payload ClipboardDrag) clipboard paths))
    (return-if (. DropOperation none) (if (== (. paths length) 0)))
    (return-if (. DropOperation copy) (if (. modifiers option)))
    (let device (call file-view-device (. owner path)))
    (for (in path paths)
      (return-if (. DropOperation copy) (if (!= (call file-view-device path) device)))
    )
    (return (. DropOperation move))
  )
  (fn-do + receive _
    (param payload DragPayload)
    (param owner FileNode)
    (param modifiers PointerModifiers)
    (let operation (call drop-operation payload owner modifiers))
    (return-if (if (== operation (. DropOperation none))))
    (let paths (. (as payload ClipboardDrag) clipboard paths))
    (call report (call attempt-receive paths owner (== operation (. DropOperation copy))))
  )
  (fn-do + open _
    (param node (? FileNode))
    (if node
      (<- (. session opened) node)
    )
  )
  (fn-do + note-selection _
    (call choose (call selected-node))
  )
  (fn-do + choose _
    (param node (? FileNode))
    (if (!= (?. (. session current) key) (?. node key))
      (= (. session current) node)
    )
  )
  (fn-do + retain-only _
    (param next (of Map String FileNode))
    (for (in pair (. retained items))
      (if (not (has next (. pair key)))
        (call (. files release) (. pair value))
      )
    )
    (for (in pair (. next items))
      (if (not (has retained (. pair key)))
        (call (. files retain) (. pair value))
      )
    )
    (= retained next)
  )
  (fn-do _ targets-for (list FileNode)
    (param node (? FileNode))
    (return-if (call (of List FileNode)) (if (not node)))
    (let key (. node key))
    (let selected (call selected-nodes))
    (return-if selected (if (call some selected (:where (== (. each key) key)))))
    (return (list node))
  )
  (fn-do _ discard _
    (param node FileNode)
    (let kept discarded)
    (= discarded null)
    (return-if (if (or (not kept) (!= (. kept key) (. node key)))))
    (call report (call attempt-discard node))
  )
  (fn-do _ report _
    (param message (? String))
    (if message
      (<- (. session failed) message)
    )
  )
  (fn-do _ attempt-rename (? String)
    (param node FileNode)
    (param name String)
    (call (. files rename) node name
      (block
        (on-error (: failure Error)
          (return (str "Could not rename " (. node name) ": " (. failure message)))
        )
      )
    )
    (return null)
  )
  (fn-do _ attempt-move (? String)
    (param nodes (list FileNode))
    (param owner FileNode)
    (call (. files move) nodes owner
      (block
        (on-error (: failure Error)
          (return (str "Could not move into " (. owner path name) ": " (. failure message)))
        )
      )
    )
    (return null)
  )
  (fn-do _ attempt-discard (? String)
    (param node FileNode)
    (call (. node path delete)
      (block
        (on-error (: failure Error)
          (return (str "Could not remove " (. node name) ": " (. failure message)))
        )
      )
    )
    (call (. files removed) node)
    (return null)
  )
  (fn-do _ attempt-receive (? String)
    (param paths (list Path))
    (param owner FileNode)
    (param copies Bool)
    (call (. files receive) paths owner copies
      (block
        (on-error (: failure Error)
          (return
            (paragraph
              (str "Could not " (if-expr copies "copy" "move") " into " (. owner path name) ": " (. failure message))
            )
          )
        )
      )
    )
    (return null)
  )
)

(fn-do _ file-view-device (? U64)
  (param path Path)
  (let found (catch? (. path stat)))
  (return (?. found dev))
)
