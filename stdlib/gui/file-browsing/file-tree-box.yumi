━━━━━━━━━━━━━━━━━━━━
+ FileTreeBox is FileView

+ has-sticky-parents = false
+ sticky-inset Length = 0

_ pending-expanded [String]?

────────────────────

<This • flex-col
    <TreeBox'FileNode tree • flex:1
        root-node = files.root
        load-children = :: node => files.children-of(node)
        item-has-children = :: node => node.is-directory
        item-title = :: node => node.name
        key-builder = :: node => node.key
        is-ordered = false
        has-sticky-parents = #has-sticky-parents
        sticky-inset = #sticky-inset
        has-chevrons = false
        selection-mode = SelectionMode.multiple
        can-drag = :: node => is-idle
        item-path = :: node => node.path
        can-drop = :: drop => accepts(drop.items, drop.parent)
        payload-operation = :: drop => drop-operation(drop.payload, drop.parent, drop.modifiers)

        <FileRow (row) - row
            item = row.#item!

────────────────────
for touched on files.changed

tree.reload()

────────────────────
for event on tree.selection-changed

choose(tree-selection())

────────────────────
for event on tree.item-activated

for node in selected-nodes()
    open(node)

────────────────────
for event on tree.dropped

if event.source
    move(event.items, event.parent)
else
    receive(event.payload, event.parent, event.modifiers)

────────────────────
whenever tree.#entries

sync-retained()
restore-expanded()

────────────────────
whenever tree.#expansion-revision

note-expanded()

╌╌╌╌╌╌╌╌╌╌ is MarkupElement ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do mounted

super.mounted()
pending-expanded = List'String(session.expanded)
follow-current()

╌╌╌╌╌╌╌╌╌╌ is FileView ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ selected-node FileNode?

node if node && !node.is-detached

.. node = session.current

────────────────────
+ selected-nodes [FileNode]

List'FileNode
    ** tree.selected-items
    ?> !each.is-detached

────────────────────
+ do show-node
    - node FileNode
    - alignment = ScrollAlignment.nearest

. ignored = tree.reveal-key-path(files.keys-to(node), alignment)

────────────────────
+ do expand-node
    - node FileNode

tree.expand-items([node])

────────────────────
+ do focus-list

tree.request-focus()

────────────────────
+ do follow-current

. node = session.current
=? if tree-selection()?.key == node?.key
tree.selected-key = node?.key
tree.selected-keys = file-node-keys(node)

────────────────────
+ pressed-node FileNode?
    - event GUIEvent

tree.item-at(event)

╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌

────────────────────
_ do restore-expanded

. paths = pending-expanded
=? if !paths
pending-expanded = null
. nodes [FileNode]
for path in paths
    . node = files.find(files.root.path / path)
    if node && node.is-directory && node.parent
        nodes += node
tree.expand-items(nodes)

────────────────────
_ do note-expanded

=? if pending-expanded
. paths = List'String
    ** tree.expanded-items()
    ?*> each.relative-path if each.parent && !each.is-detached
session.expanded = paths
session.expansion-changed <- paths

────────────────────
_ tree-selection FileNode?

tree.entry-for-key(keys[0])?.item if keys.length == 1

.. keys = tree.selected-keys

────────────────────
_ do sync-retained

. next = Map'String'FileNode()
for entry in tree.entries
    if entry.is-expanded
        next[entry.key] = entry.item
retain-only(next)

━━━━━━━━━━━━━━━━━━━━
_ file-node-keys [String]
    - node FileNode?

|? node
    [node.key]
??
    List'String()
