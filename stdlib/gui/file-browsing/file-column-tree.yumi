• extend GUIDefaultTheme
    using GUIBoxSize
    using GUITextPaint
    using GUIVirtualRowStyle

• FileColumnTree
    row-height = 28

    • ColumnTreeDetail • min-w:320

    • ColumnTreeColumn
        when #is-focused
            • ListItem
                when #is-selected
                    • file-icon • text:gui-accent-text-color

                    • folder-icon • text:gui-accent-text-color

━━━━━━━━━━━━━━━━━━━━
+ FileColumnTree is FileView

+ detail-node FileNode? = columns.#detail-item

────────────────────

<This • flex-col
    <ColumnTree'FileNode columns • flex:1
        root-node = files.root
        load-children = :: node => files.children-of(node)
        item-has-children = :: node => node.is-directory
        key-builder = :: node => node.key
        can-drag = :: node => is-idle
        can-drop = :: drop => accepts(drop.items, drop.parent)

        <FileRow (row) - row
            item = row.#item!

        <FileInfoPane (detail) • flex:1
            files = files
            node = #detail-node

────────────────────
for touched on files.changed

columns.refresh()

────────────────────
for event on columns.selection-changed

note-selection()

────────────────────
for event on columns.active-column-changed

note-selection()

────────────────────
for event on columns.item-activated

open(selected-node())

────────────────────
for event on columns.dropped

move(event.items, event.parent)

────────────────────
whenever columns.#owners

sync-retained()
follow-current()

╌╌╌╌╌╌╌╌╌╌ is FileView ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ selected-node FileNode?

columns.selected-item-at(columns.active-index)

────────────────────
+ do show-node
    - node FileNode
    - alignment = ScrollAlignment.nearest

columns.refresh()
. ignored = columns.select-path(files.keys-to(node))

────────────────────
+ do focus-list

columns.focus-active()

────────────────────
+ do follow-current

. node = session.current
=? if !node || node.is-detached || selected-node()?.key == node.key
. ignored = columns.select-path(files.keys-to(node))

────────────────────
+ pressed-node FileNode?
    - event GUIEvent

columns.item-at(event)

────────────────────
+ pressed-owner FileNode?
    - event GUIEvent

columns.owner-at(event)

╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌

────────────────────
_ do sync-retained

. next = Map'String'FileNode()
for owner in columns.owners
    next[owner.key] = owner
retain-only(next)
