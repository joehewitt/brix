(import /graphics/color)
(import /graphics/primitives)
(import /gui/box)
(import /gui/icon)
(import /gui/icons/lucide/file)
(import /gui/icons/lucide/file-archive)
(import /gui/icons/lucide/file-code)
(import /gui/icons/lucide/file-image)
(import /gui/icons/lucide/file-json)
(import /gui/icons/lucide/file-symlink)
(import /gui/icons/lucide/file-text)
(import /gui/icons/lucide/folder)
(import /gui/icons/lucide/folder-symlink)
(import /gui/shorthands)
(import /gui/styles)
(import /gui/theme)
(import /os/path)
(blank)
(prop _ file-glyphs _ (:= (call file-glyph-table)))

(style-extend GUIDefaultTheme
  (using GUIBoxSize)
  (using GUITextPaint)
  (rule file-icon (• text gui-muted-text-color))
  (blank)
  (rule folder-icon (• text gui-folder-icon-color))
  (blank)
  (rule file-glyph-icon (• w 15) (• h 15))
)

(type + FileIcon (is Box)
  (prop + glyph FileGlyph (= (. FileGlyph file)))
  (content
    (<> This (• flex-row)
      (match #glyph
        (case= (. FileGlyph folder)
          (<> LucideFolder (• icon) (• folder-icon) (• file-glyph-icon))
        )
        (case= (. FileGlyph folder-link)
          (<> LucideFolderSymlink (• icon) (• folder-icon) (• file-glyph-icon))
        )
        (case= (. FileGlyph file)
          (<> LucideFile (• icon) (• file-icon) (• file-glyph-icon))
        )
        (case= (. FileGlyph file-link)
          (<> LucideFileSymlink (• icon) (• file-icon) (• file-glyph-icon))
        )
        (case= (. FileGlyph code)
          (<> LucideFileCode (• icon) (• file-icon) (• file-glyph-icon))
        )
        (case= (. FileGlyph text)
          (<> LucideFileText (• icon) (• file-icon) (• file-glyph-icon))
        )
        (case= (. FileGlyph data)
          (<> LucideFileJson (• icon) (• file-icon) (• file-glyph-icon))
        )
        (case= (. FileGlyph image)
          (<> LucideFileImage (• icon) (• file-icon) (• file-glyph-icon))
        )
        (case= (. FileGlyph archive)
          (<> LucideFileArchive (• icon) (• file-icon) (• file-glyph-icon))
        )
      )
    )
  )
)

(type + FileGlyph (is Union)
  (variant folder)
  (variant folder-link)
  (variant file)
  (variant file-link)
  (variant code)
  (variant text)
  (variant data)
  (variant image)
  (variant archive)
)

(fn-expr + file-glyph FileGlyph
  (param is-directory Bool)
  (param kind PathKind)
  (param name String)
  (case? (and is-directory (== kind (. PathKind link)))
    (. FileGlyph folder-link)
  )
  (case? is-directory
    (. FileGlyph folder)
  )
  (case? (== kind (. PathKind link))
    (. FileGlyph file-link)
  )
  (default
    (?? ([] file-glyphs (call file-extension name)) (. FileGlyph file))
  )
)

(fn-expr + file-extension String
  (param name String)
  (. (call Path name 0) ext lowercased)
)

(fn-do _ file-glyph-table (of Map String FileGlyph)
  (let table (call (of Map String FileGlyph)))
  (for (in ext (list "bx" "ts" "tsx" "js" "jsx" "mjs" "py" "rb" "go" "rs" "swift" "java" "kt"))
    (= ([] table ext) (. FileGlyph code))
  )
  (for (in ext (list "c" "h" "cc" "cpp" "hpp" "m" "mm" "sh" "zsh" "html" "css" "sql" "lua"))
    (= ([] table ext) (. FileGlyph code))
  )
  (for (in ext (list "md" "txt" "rtf" "log" "pdf"))
    (= ([] table ext) (. FileGlyph text))
  )
  (for (in ext (list "json" "yml" "yaml" "toml" "xml" "plist" "csv" "lock"))
    (= ([] table ext) (. FileGlyph data))
  )
  (for (in ext (list "png" "jpg" "jpeg" "gif" "svg" "webp" "heic" "icns" "ico"))
    (= ([] table ext) (. FileGlyph image))
  )
  (for (in ext (list "zip" "tar" "gz" "tgz" "bz2" "xz" "dmg" "pkg"))
    (= ([] table ext) (. FileGlyph archive))
  )
  (return table)
)
