(import ./file-icon)
(import /code/file-names)
(import /data/fuzzy)
(import /graphics/color)
(import /graphics/primitives)
(import /graphics/style)
(import /gui/box)
(import /gui/button)
(import /gui/events)
(import /gui/icon)
(import /gui/icons/lucide/chevron-right)
(import /gui/icons/lucide/search)
(import /gui/keys)
(import /gui/label)
(import /gui/match-label)
(import /gui/popup)
(import /gui/primitives)
(import /gui/search-palette)
(import /gui/shorthands)
(import /gui/styles)
(import /gui/theme)
(import /math)
(import /os/file-tree)
(import /os/path)
(import /stream/sort)
(import /time/debounced)
(import /ui/input)
(import /units)

(style-extend GUIDefaultTheme
  (using GUIBoxPaint)
  (using GUIBoxScroll)
  (using GUIBoxSize)
  (using GUIBoxSpacing)
  (using GUITextPaint)
  (using VectorPaintStyle)
  (rule FilePalette
    (rule file-palette-chevron (• text gui-muted-text-color) (• w 12) (• h 12)
      (= stroke-width 2)
    )
    (blank)
    (rule file-palette-search (• text gui-muted-text-color) (• w 14) (• h 14) (• mr 6)
      (= stroke-width 2)
    )
    (blank)
    (rule file-palette-trail
      (= max-width (call (. SizeSpec percent) 60%))
      (= overflow-x (. ScrollOverflow auto))
      (= scroll-indicator-x (. ScrollIndicatorVisibility hidden))
    )
    (blank)
    (rule file-palette-crumb (• bg transparent) (• h 20) (• px 3) (• my 4)
      (= shadow null)
      (= corner-radius gui-control-radius)
      (blank)
      (when-style #is-hover-within
        (• bg gui-hover-color)
      )
    )
    (blank)
    (rule file-palette-crumb-chevron (• mx 1))
    (blank)
    (rule file-palette-detail (• text gui-muted-text-color) (• ml 8))
    (blank)
    (rule PaletteRow
      (when-style #is-highlighted
        (rule file-palette-chevron (• text gui-accent-text-color))
        (blank)
        (rule file-icon (• text gui-accent-text-color))
        (blank)
        (rule folder-icon (• text gui-accent-text-color))
        (blank)
        (rule file-palette-detail (• text gui-accent-text-color))
      )
    )
  )
)

(type + FilePalette (is (of Palette FilePaletteItem))
  (prop + files FileTree)
  (prop + names (? FileNameIndex))
  (prop + searches-checkouts _ (= false))
  (prop + start (? Path))
  (prop + recent (list FilePaletteItem))
  (prop + shows-file (? FileNameFilter))
  (prop + enters-folders _ (= false))
  (prop + folder Path (= (call Path "/" 0)))
  (prop + is-confined _ (= false))
  (prop + items (list FilePaletteItem))
  (prop + trail (list FilePaletteCrumb) (= (call file-palette-trail #folder (. files root path))))
  (prop + prompt _ (= (call file-palette-prompt #trail)))
  (prop + empty-text _ (= (call file-palette-empty-text #query)))
  (prop + results _ (= (call file-palette-results #items #query #recent #found)))
  (event + line-chosen FilePaletteSpot)
  (prop + key-builder _ (= (=> (item) (. item key))))
  (prop + takes-keys _ (= (list (. Key arrow-up) (. Key arrow-down) (. Key arrow-left) (. Key arrow-right))))
  (blank)
  (prop _ found (? (list FilePaletteItem)))
  (prop _ watch (? Closable))
  (prop _ is-searching _ (= false))
  (prop _ checkouts (map String FileNameIndex))
  (prop _ schedule-relist _ (:= (call throttled file-tree-flush-delay (. this relist))))
  (content
    (<> This
      (<> Box (slot: leading) (• flex-row)
        (<> LucideSearch (• icon) (• file-palette-search)
          (= align-y (. Alignment center))
        )
        (<> FilePaletteTrail (• flex-row) (• file-palette-trail)
          (for (in crumb #trail)
            (<> Box (• flex-row)
              (<> Button (• file-palette-crumb)
                (= title (. crumb name))
                (= action (=> () :do (call open-crumb (. crumb path))))
              )
              (<> LucideChevronRight (• icon) (• file-palette-chevron) (• file-palette-crumb-chevron)
                (= align-y (. Alignment center))
              )
            )
          )
        )
      )
      (blank)
      (<> FilePaletteRow (slot: row) (param: row)
        (= item (. row #item))
      )
      (blank)
      (<> KeyShortcut (text: "Open Folder")
        (= key .arrow-right)
        (= discoverable false)
        (= allow-while-input true)
        (= action (=> () :do (call enter-selected)))
      )
      (<> KeyShortcut (text: "Parent Folder")
        (= key .arrow-left)
        (= discoverable false)
        (= allow-while-input true)
        (= action (=> () :do (call leave)))
      )
    )
  )
  (subscribe-for (on event key-press)
    (if (== (. event key) (. Key tab))
      (call enter-selected)
      (call (. event cancel))
      (else-if (and (== (. event key) (. Key backspace)) (not query))
        (call leave)
        (call (. event cancel))
      )
    )
  )
  (subscribe-for (on reason dismissed (when arrival))
    (call unwatch)
    (= items (call (of List FilePaletteItem)))
    (= found null)
  )
  (fn-do + refresh _
    (let spot (call file-palette-spot query))
    (if (!= (call (. spot name find) "/") null)
      (call walk spot)
      (else
        (call search)
      )
    )
  )
  (fn-do + choose-selected _
    (let spot (call file-palette-spot query))
    (if (and (== (. spot name) "") (!= (. spot line) null))
      (call dismiss (. DismissReason chosen))
      (<- line-chosen spot)
      (else
        (call (. super choose-selected))
      )
    )
  )
  (fn-expr _ boundary _ :get
    (only-if (. files root path) (if is-confined))
  )
  (fn-do + show _
    (param at (? PopupAnchor) (= null))
    (if (not is-open)
      (call (?. names start))
      (call open-folder (call file-palette-existing (?? start (. files root path)) boundary))
    )
    (call (. super show) at)
  )
  (fn-do + choose _
    (param item FilePaletteItem)
    (if (and enters-folders (. item is-directory))
      (call enter item)
      (return)
    )
    (let spot (call file-palette-spot query))
    (if (or (== (. spot line) null) (. item is-directory))
      (call (. super choose) item)
      (else
        (call (. super choose)
          (block
            (arg
              (call FilePaletteItem
                (block
                  (arg (. item path))
                  (arg (. item name))
                  (arg (. item kind))
                  (arg (. item is-directory))
                  (arg (. item detail))
                  (arg (. item name-hits))
                  (arg (. item detail-hits))
                  (arg (. spot line))
                  (arg (. spot column))
                )
              )
            )
          )
        )
      )
    )
  )
  (fn-do + unmounted _
    (call unwatch)
    (for (in index (. checkouts values))
      (call (. index close))
    )
    (call (. checkouts clear))
    (call (. super unmounted))
  )
  (fn-do + open-folder _
    (param location Path)
    (= folder location)
    (= found null)
    (= items (call file-palette-list location (. files hides-name) shows-file))
    (call watch-folder location)
  )
  (fn-do + enter _
    (param item FilePaletteItem)
    (return-if (if (not (. item is-directory))))
    (blank)
    (call open-folder (. item path))
    (call reset)
  )
  (fn-do + enter-selected _
    (let item selected-item)
    (if item
      (call enter item)
    )
  )
  (fn-do + open-crumb _
    (param location Path)
    (call (. search-input request-focus))
    (return-if (if (== (str location) (str folder))))
    (blank)
    (let origin folder)
    (call open-folder location)
    (if query
      (call search)
      (else
        (let child (call file-palette-child-toward location origin))
        (if child
          (call select-key (str child))
        )
      )
    )
  )
  (fn-do + leave _
    (return-if (if (call is-boundary folder)))
    (blank)
    (let above (. folder parent))
    (return-if (if (not above)))
    (blank)
    (let left folder)
    (call open-folder above)
    (call reset)
    (call select-key (str left))
  )
  (fn-do _ search _
    (if (or (not (call index-for folder)) (not (. (call file-palette-spot query) name)))
      (= found null)
      (return)
    )
    (return-if (if is-searching))
    (blank)
    (= is-searching true)
    (do-new
      (inline (call seek))
    )
  )
  (fn-do _ seek _
    (while is-open
      (let asked (. (call file-palette-spot query) name))
      (let place folder)
      (let index (call index-for place))
      (let scope (call (?. index relative) place))
      (if (or (not asked) (not index) (== scope null) (!= (call (. asked find) "/") null))
        (= found null)
        (break)
      )
      (let matches (call (. index search) asked scope))
      (if (and (== asked (. (call file-palette-spot query) name)) (== place folder))
        (= found (call file-palette-found index matches scope shows-file))
        (break)
      )
    )
    (= is-searching false)
  )
  (fn-do _ index-for (? FileNameIndex)
    (param location Path)
    (return-if names (if (or names (not searches-checkouts))))
    (blank)
    (let top (call file-palette-checkout location))
    (return-if null (if (not top)))
    (blank)
    (let key (str top))
    (let known ([] checkouts key))
    (return-if known (if known))
    (blank)
    (let made (call FileNameIndex top))
    (call (. made start))
    (= ([] checkouts key) made)
    (return made)
  )
  (fn-do _ watch-folder _
    (param location Path)
    (call unwatch)
    (= watch (catch? (call listen location)))
  )
  (fn-do _ listen Closable (?! Error)
    (param location Path)
    (let stream (call (. location watch)))
    (for (on event stream)
      (call schedule-relist)
    )
    (return stream)
  )
  (fn-do _ unwatch _
    (let stream watch)
    (= watch null)
    (if stream
      (catch? (call (. stream close)))
    )
  )
  (fn-do _ relist _
    (return-if (if (not is-open)))
    (blank)
    (let location (call file-palette-existing folder boundary))
    (if (== location folder)
      (= items (call file-palette-list location (. files hides-name) shows-file))
      (else
        (call open-folder location)
      )
    )
  )
  (fn-do _ walk _
    (param spot FilePaletteSpot)
    (let parts (call (of List String) (call (. spot name split) "/")))
    (let last (- (. parts length) 1))
    (let rest ([] parts last))
    (let location folder)
    (for (in index (..< 0 last))
      (let part ([] parts index))
      (if (and (== part "") (== index 0))
        (= location (?? boundary (call Path "/" 0)))
        (else-if (== part "..")
          (if (not (call is-boundary location))
            (= location (?? (. location parent) location))
          )
        )
        (else-if (and (!= part "") (!= part "."))
          (let listed
            (match location
              (case= folder
                items
              )
              (default
                (call file-palette-list location (. files hides-name) shows-file)
              )
            )
          )
          (let target (call file-palette-folder listed part))
          (if (not target)
            (= rest (str part (call (. "/" join) ([] parts (... (+ index 1))))))
            (break)
          )
          (= location (. target path))
        )
      )
    )
    (if (!= location folder)
      (call open-folder location)
    )
    (call rewrite (+ rest (. spot suffix)))
  )
  (fn-expr _ is-boundary _
    (param location Path)
    (and is-confined (== (str location) (str (. files root path))))
  )
)

(type + FilePaletteItem
  (prop + path Path)
  (prop + name String)
  (prop + sort-name String)
  (prop + kind PathKind)
  (prop + is-directory Bool)
  (prop + detail String)
  (prop + name-hits (list MatchSpan))
  (prop + detail-hits (list MatchSpan))
  (prop + line (? Size))
  (prop + column (? Size))
  (prop + is-recent Bool)
  (fn-do + This _
    (param path _)
    (param name _)
    (param kind _)
    (param is-directory _)
    (param detail String (= ""))
    (param name-hits (list MatchSpan) (= (call (of List MatchSpan))))
    (param detail-hits (list MatchSpan) (= (call (of List MatchSpan))))
    (param line (? Size) (= null))
    (param column (? Size) (= null))
    (param is-recent _ (= false))
    (= sort-name (. name lowercased))
  )
  (fn-expr + key String :get
    (if-expr is-recent (str "recent:" path) (str path))
  )
)

(type + FilePaletteSpot (is Tuple)
  (prop + name String)
  (prop + suffix String)
  (prop + line (? Size))
  (prop + column (? Size))
)

(type + FilePaletteCrumb (is Tuple)
  (prop + name String)
  (prop + path Path)
)

(type + FilePaletteRow (is Box)
  (prop + item (? FilePaletteItem))
  (content
    (<> This (• flex-row) (• flex 1)
      (<> FileIcon (• mr 8)
        (= glyph (call file-palette-glyph #item))
        (= align-y (. Alignment center))
      )
      (<> MatchLabel
        (= text (?? (?. #item name) ""))
        (= hits (?? (?. #item name-hits) (call (of List MatchSpan))))
        (= align-y (. Alignment center))
      )
      (<> MatchLabel (• file-palette-detail) (• flex 1)
        (= text (?? (?. #item detail) ""))
        (= hits (?? (?. #item detail-hits) (call (of List MatchSpan))))
        (= align-y (. Alignment center))
      )
      (if (?? (?. #item is-directory) false)
        (<> LucideChevronRight (• icon) (• file-palette-chevron)
          (= align-y (. Alignment center))
        )
      )
    )
  )
)

(fn-expr + file-palette-spot FilePaletteSpot
  (param query String)
  (case? (== colon null)
    (call FilePaletteSpot query "")
  )
  (case? (> (. parts length) 2)
    (call FilePaletteSpot query "")
  )
  (case? (or (and ([] parts 0) (== line null)) (and (> (. parts length) 1) ([] parts 1) (== column null)))
    (call FilePaletteSpot query "")
  )
  (default
    (call FilePaletteSpot
      (block
        (arg ([] query (..< 0 colon)))
        (arg ([] query (... colon)))
        (arg (call file-palette-index line))
        (arg (call file-palette-index column))
      )
    )
  )
  (where
    (lazy colon (call (. query find) ":"))
    (lazy parts (call (of List String) (call (. ([] query (... (+ colon 1))) split) ":")))
    (lazy line (call file-palette-number ([] parts 0)))
    (lazy column (only-if (call file-palette-number ([] parts 1)) (if (> (. parts length) 1))))
  )
)

(type _ FilePaletteTrail (is Box)
  (prop _ pinned-width (? Length))
  (fn-do + did-layout _
    (call (. super did-layout))
    (return-if (if (== inner-width pinned-width)))
    (blank)
    (= pinned-width inner-width)
    (let ignored (call scroll-to-end (. Orientation horizontal)))
  )
)

(fn-expr _ file-palette-glyph FileGlyph
  (param item (? FilePaletteItem))
  (case? (not item)
    (. FileGlyph file)
  )
  (default
    (call file-glyph (. item is-directory) (. item kind) (. item name))
  )
)

(fn-do _ file-palette-list (list FilePaletteItem)
  (param location Path)
  (param hides FileNameFilter)
  (param shows (? FileNameFilter))
  (let listed (?? (call file-entries location hides) (call (of List FileEntry))))
  (let unsorted
    (call (of List FilePaletteItem)
      (block
        (spread listed)
        (pipe ?*> (only-if (call FilePaletteItem (/ location (. each name)) (. each name) (. each kind) (. each is-directory)) (if (call file-palette-shows (. each name) (. each is-directory) shows))))
      )
    )
  )
  (return (call sort unsorted (:using file-order)))
)

(fn-expr _ file-palette-shows Bool
  (param name String)
  (param is-directory Bool)
  (param shows (? FileNameFilter))
  (or is-directory (not shows) (call shows name))
)

(fn-do _ file-palette-checkout (? Path)
  (param location Path)
  (let cursor (? Path) location)
  (while cursor
    (let candidate cursor)
    (return-if candidate (if (. (/ candidate ".git") exists)))
    (blank)
    (= cursor (. candidate parent))
  )
  (return null)
)

(fn-do _ file-palette-matches (list FilePaletteItem)
  (param items (list FilePaletteItem))
  (param query String)
  (return-if items (if (or (not query) (!= (call (. query find) "/") null))))
  (blank)
  (let pattern (call FuzzyQuery query))
  (let marked (list FilePaletteItem))
  (for (in item (call fuzzy-ranked items query (=> (item) (. item name))))
    (let hits (call match-spans (call (. pattern positions) (. item name)) 0))
    (+= marked
      (call FilePaletteItem
        (block
          (arg (. item path))
          (arg (. item name))
          (arg (. item kind))
          (arg (. item is-directory))
          (arg (. item detail))
          (arg hits)
          (arg (call (of List MatchSpan)))
          (arg null)
          (arg null)
          (arg (. item is-recent))
        )
      )
    )
  )
  (return marked)
)

(fn-expr _ file-palette-results (list FilePaletteItem)
  (param items (list FilePaletteItem))
  (param query String)
  (param recent (list FilePaletteItem))
  (param found (? (list FilePaletteItem)))
  (case? (and (not name) (!= (. spot line) null))
    (call (of List FilePaletteItem))
  )
  (case? (not name)
    (++ recent items)
  )
  (case? (!= (call (. name find) "/") null)
    (call file-palette-matches items name)
  )
  (case? (!= found null)
    (++ (call file-palette-matches recent name) found)
  )
  (default
    (++ (call file-palette-matches recent name) (call file-palette-matches items name))
  )
  (where
    (lazy spot (call file-palette-spot query))
    (lazy name (. spot name))
  )
)

(fn-do _ file-palette-found (list FilePaletteItem)
  (param index FileNameIndex)
  (param matches (list FileNameMatch))
  (param scope String)
  (param shows (? FileNameFilter))
  (let skip Index (if-expr scope (+ (. scope size) 1) 0))
  (let found (list FilePaletteItem))
  (for (in match matches (when (call file-palette-shows (. match entry name) (. match entry is-directory) shows)))
    (let entry (. match entry))
    (let kind (if-expr (. entry is-directory) (. PathKind directory) (. PathKind file)))
    (let name-start (- (. entry path size) (. entry name size)))
    (let has-folder (> name-start skip))
    (let slash (- name-start 1))
    (let detail (if-expr has-folder (call (. (call byte-view (. entry path)) slice-string) (..< skip slash)) ""))
    (let name-hits (list MatchSpan))
    (let detail-hits (list MatchSpan))
    (if (. match is-in-name)
      (= name-hits (call match-spans (. match positions) 0))
      (else
        (let inside (list Index))
        (let outside (list Index))
        (for (in position (. match positions))
          (if (and has-folder (< position slash))
            (+= outside position)
            (else-if (>= position name-start)
              (+= inside position)
            )
          )
        )
        (= name-hits (call match-spans inside name-start))
        (= detail-hits (call match-spans outside skip))
      )
    )
    (+= found
      (call FilePaletteItem
        (block
          (arg (/ (. index root) (. entry path)))
          (arg (. entry name))
          (arg kind)
          (arg (. entry is-directory))
          (arg detail)
          (arg name-hits)
          (arg detail-hits)
        )
      )
    )
  )
  (return found)
)

(fn-do _ file-palette-folder (? FilePaletteItem)
  (param items (list FilePaletteItem))
  (param name String)
  (for (in item items)
    (return-if item (if (and (. item is-directory) (== (. item name) name))))
  )
  (for (in item (call fuzzy-ranked items name (=> (item) (. item name))))
    (return-if item (if (. item is-directory)))
  )
  (return null)
)

(fn-do _ file-palette-existing Path
  (param location Path)
  (param boundary (? Path))
  (let cursor location)
  (while (not (call file-palette-is-folder cursor))
    (return-if cursor (if (and (!= boundary null) (== (str cursor) (str boundary)))))
    (blank)
    (let above (. cursor parent))
    (return-if cursor (if (not above)))
    (blank)
    (= cursor above)
  )
  (return cursor)
)

(fn-expr _ file-palette-is-folder Bool
  (param location Path)
  (?? (catch? (. location is-dir)) false)
)

(fn-do _ file-palette-trail (list FilePaletteCrumb)
  (param folder Path)
  (param root Path)
  (let inner (call (. folder relative-to) root))
  (let location (if-expr inner root (call Path separator 0)))
  (let crumbs (list FilePaletteCrumb))
  (for (in name (. (?? inner folder) components))
    (= location (/ location name))
    (+= crumbs (call FilePaletteCrumb name location))
  )
  (return crumbs)
)

(fn-expr _ file-palette-child-toward (? Path)
  (param location Path)
  (param origin Path)
  (only-if (/ location ([] names 0)) (if (and names (> (. names length) 0))))
  (where
    (lazy names (?. (call (. origin relative-to) location) components))
  )
)

(fn-expr _ file-palette-prompt _
  (param trail (list FilePaletteCrumb))
  (if-expr (== (. trail length) 0) "Find in this folder" "")
)

(fn-expr _ file-palette-empty-text String
  (param query String)
  (case? (and (not (. spot name)) (!= (. spot line) null) (!= (. spot column) null))
    (str "Go to line " (+ (. spot line) 1) ", column " (+ (. spot column) 1))
  )
  (case? (and (not (. spot name)) (!= (. spot line) null))
    (str "Go to line " (+ (. spot line) 1))
  )
  (case? query
    "Nothing here matches"
  )
  (default
    "This folder is empty"
  )
  (where
    (lazy spot (call file-palette-spot query))
  )
)

(fn-expr _ file-palette-index (? Size)
  (param number (? Size))
  (only-if (- (call max number 1) 1) (if (!= number null)))
)

(fn-do _ file-palette-number (? Size)
  (param text String)
  (return-if null (if (not text)))
  (blank)
  (let value Size 0)
  (for (in char text)
    (return-if null (if (or (< char '0') (> char '9'))))
    (blank)
    (= value (+ (* value 10) (- (as char U32) (as '0' U32))))
  )
  (return value)
)
