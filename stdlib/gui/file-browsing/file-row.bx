(import ./file-icon)
(import ./file-view)
(import /graphics/primitives)
(import /gui/box)
(import /gui/disclosure)
(import /gui/events)
(import /gui/label)
(import /gui/primitives)
(import /gui/shorthands)
(import /gui/styles)
(import /gui/text-input)
(import /gui/theme)
(import /gui/tree-box)
(import /os/file-tree)
(import /ui/input)
(blank)
(prop + file-mark-dot-size Length (= 7))

(style-extend GUIDefaultTheme
  (using GUIBoxPaint)
  (using GUIBoxSize)
  (rule file-mark-dot (• w file-mark-dot-size) (• h file-mark-dot-size)
    (= corner-radius (/ file-mark-dot-size 2))
  )
)

(type + FileRow (is Box)
  (prop + item FileNode)
  (prop + is-renaming _ (= (== (?. (?. #view #renaming) key) (. #item key))))
  (prop + marks _ (= (?[] (?. #view #marks) (. #item relative-path))))
  (prop + shows-chevron _ (= (and (. #item is-directory) #is-row-hovered (== (?? (?. #tree-row #chevron-width) 1) 0))))
  (blank)
  (prop _ view (of Ancestor FileView))
  (prop _ tree-row (of Ancestor (of TreeBoxItem FileNode)))
  (prop _ is-row-hovered _ (= (?? (?. #tree-row #is-hover-within) false)))
  (content
    (<> This (• flex-row) (• flex 1)
      (if #shows-chevron
        (<> DisclosureChevron (• icon) (• file-icon) (• file-glyph-icon) (• mr 6)
          (= align-y (. Alignment center))
          (= is-open (?? (?. #tree-row #is-expanded) false))
        )
        (else
          (<> FileIcon (• mr 6)
            (= glyph (call file-glyph (. #item is-directory) (. #item kind) (. #item #name)))
            (= align-y (. Alignment center))
          )
        )
      )
      (if #is-renaming
        (<> FileRenameInput (id: rename-input) (• flex 1) (• mr 6)
          (= node-key (. item key))
          (= text (. item name))
          (= align-y (. Alignment center))
        )
        (else
          (<> Label (• flex 1)
            (= text (. #item #name))
            (= align-y (. Alignment center))
          )
        )
      )
      (for (in mark (?? #marks (call (of List FileMark))))
        (<> FileMarkView (• ml 6)
          (= mark mark)
          (= align-y (. Alignment center))
        )
      )
    )
  )
)

(type + FileMarkView (is Box)
  (prop + mark FileMark)
  (blank)
  (rule file-mark)
  (content
    (<> This (• flex-row) (• items-center)
      (if (. #mark is-dot)
        (<> Box (• file-mark-dot)
          (= background-color (. #mark color))
        )
        (else
          (<> Label (• file-mark)
            (= text (. #mark text))
            (= color (. #mark color))
          )
        )
      )
    )
  )
)

(type + FileRenameInput (is TextInput)
  (prop + node-key _ (= ""))
  (blank)
  (prop _ view (of Ancestor FileView))
  (fn-do + mounted _
    (call (. super mounted))
    (call request-focus)
  )
  (subscribe-for (on event focus)
    (call select-range 0 (call file-stem-length text))
  )
  (subscribe-for (on event key-press)
    (if (== (. event key) (. Key escape))
      (call (?. view cancel-rename))
      (call (. event cancel))
    )
  )
  (subscribe-for (on event submit)
    (call (?. view commit-rename) node-key text true)
  )
  (subscribe-for (on event blur)
    (call (?. view commit-rename) node-key text false)
  )
)

(fn-expr + file-stem-length Size
  (param name String)
  (if-expr (or (== dot null) (== dot 0)) (. name length) dot)
  (where
    (lazy dot (call (. name find-reverse) "."))
  )
)
