────────────────────
+ do did-layout

super.did-layout()
=? if inner-width == pinned-width
pinned-width = inner-width
. ignored = scroll-to-end(Orientation.horizontal)

━━━━━━━━━━━━━━━━━━━━
_ file-palette-glyph FileGlyph
    - item FilePaletteItem?

|? !item
    FileGlyph.file
??
    file-glyph(item.is-directory, item.kind, item.name)

━━━━━━━━━━━━━━━━━━━━
_ do file-palette-list [FilePaletteItem]
    - location Path
    - hides FileNameFilter
    - shows FileNameFilter?

. listed = file-entries(location, hides) ?? List'FileEntry()
. unsorted = List'FilePaletteItem
    ** listed
    ?*> FilePaletteItem(location / each.name, each.name, each.kind, each.is-directory) if file-palette-shows(each.name, each.is-directory, shows)
= sort(unsorted) • using file-order

━━━━━━━━━━━━━━━━━━━━
_ file-palette-shows Bool
    - name String
    - is-directory Bool
    - shows FileNameFilter?

is-directory || !shows || shows(name)

━━━━━━━━━━━━━━━━━━━━
_ do file-palette-checkout Path?
    - location Path

. cursor Path? = location
while cursor
    . candidate = cursor
    =? candidate if (candidate / ".git").exists
    cursor = candidate.parent
= null

━━━━━━━━━━━━━━━━━━━━
_ do file-palette-matches [FilePaletteItem]
    - items [FilePaletteItem]
    - query String

=? items if !query || query.find("/") != null
. pattern = FuzzyQuery(query)
. marked [FilePaletteItem]
for item in fuzzy-ranked(items, query, :: item => item.name)
    . hits = match-spans(pattern.positions(item.name), 0)
    marked += FilePaletteItem
        - item.path
        - item.name
        - item.kind
        - item.is-directory
        - item.detail
        - hits
        - List'MatchSpan()
        - null
        - null
        - item.is-recent
= marked

━━━━━━━━━━━━━━━━━━━━
_ file-palette-results [FilePaletteItem]
    - items [FilePaletteItem]
    - query String
    - recent [FilePaletteItem]
    - found [FilePaletteItem]?

|? !name && spot.line != null
    List'FilePaletteItem()
|? !name
    recent ++ items
|? name.find("/") != null
    file-palette-matches(items, name)
|? found != null
    file-palette-matches(recent, name) ++ found
??
    file-palette-matches(recent, name) ++ file-palette-matches(items, name)

.. spot = file-palette-spot(query)
.. name = spot.name

━━━━━━━━━━━━━━━━━━━━
_ do file-palette-found [FilePaletteItem]
    - index FileNameIndex
    - matches [FileNameMatch]
    - scope String
    - shows FileNameFilter?

. skip Index = if scope then scope.size + 1 else 0
. found [FilePaletteItem]
for match in matches when file-palette-shows(match.entry.name, match.entry.is-directory, shows)
    . entry = match.entry
    . kind = if entry.is-directory then PathKind.directory else PathKind.file
    . name-start = entry.path.size - entry.name.size
    . has-folder = name-start > skip
    . slash = name-start - 1
    . detail = if has-folder then byte-view(entry.path).slice-string(skip .. < slash) else ""
    . name-hits [MatchSpan]
    . detail-hits [MatchSpan]
    if match.is-in-name
        name-hits = match-spans(match.positions, 0)
    else
        . inside [Index]
        . outside [Index]
        for position in match.positions
            if has-folder && position < slash
                outside += position
            else if position >= name-start
                inside += position
        name-hits = match-spans(inside, name-start)
        detail-hits = match-spans(outside, skip)
    found += FilePaletteItem
        - index.root / entry.path
        - entry.name
        - kind
        - entry.is-directory
        - detail
        - name-hits
        - detail-hits
= found

━━━━━━━━━━━━━━━━━━━━
_ do file-palette-folder FilePaletteItem?
    - items [FilePaletteItem]
    - name String

for item in items
    =? item if item.is-directory && item.name == name
for item in fuzzy-ranked(items, name, :: item => item.name)
    =? item if item.is-directory
= null

━━━━━━━━━━━━━━━━━━━━
_ do file-palette-existing Path
    - location Path
    - boundary Path?

. cursor = location
while !file-palette-is-folder(cursor)
    =? cursor if boundary != null && "$cursor" == "${boundary}"
    . above = cursor.parent
    =? cursor if !above
    cursor = above
= cursor

━━━━━━━━━━━━━━━━━━━━
_ file-palette-is-folder Bool
    - location Path

catch? location.is-dir ?? false

━━━━━━━━━━━━━━━━━━━━
_ do file-palette-trail [FilePaletteCrumb]
    - folder Path
    - root Path

. inner = folder.relative-to(root)
. location = if inner then root else Path(separator, 0)
. crumbs [FilePaletteCrumb]
for name in (inner ?? folder).components
    location = location / name
    crumbs += FilePaletteCrumb(name, location)
= crumbs

━━━━━━━━━━━━━━━━━━━━
_ file-palette-child-toward Path?
    - location Path
    - origin Path

location / names[0] if names && names.length > 0

.. names = origin.relative-to(location)?.components

━━━━━━━━━━━━━━━━━━━━
_ file-palette-prompt
    - trail [FilePaletteCrumb]

if trail.length == 0 then "Find in this folder" else ""

━━━━━━━━━━━━━━━━━━━━
_ file-palette-empty-text String
    - query String

|? !spot.name && spot.line != null && spot.column != null
    "Go to line ${spot.line + 1}, column ${spot.column + 1}"
|? !spot.name && spot.line != null
    "Go to line ${spot.line + 1}"
|? query
    "Nothing here matches"
??
    "This folder is empty"

.. spot = file-palette-spot(query)

━━━━━━━━━━━━━━━━━━━━
_ file-palette-index Size?
    - number Size?

max(number, 1) - 1 if number != null

━━━━━━━━━━━━━━━━━━━━
_ do file-palette-number Size?
    - text String

=? null if !text
. value Size = 0
for char in text
    =? null if char < '0' || char > '9'
    value = value * 10 + ((char as U32) - ('0' as U32))
= value
