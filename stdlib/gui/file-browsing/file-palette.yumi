━━━━━━━━━━━━━━━━━━━━
+ file-palette-spot FilePaletteSpot
    - query String

|? colon == null
    FilePaletteSpot(query, "")
|? parts.length > 2
    FilePaletteSpot(query, "")
|? (parts[0] && line == null) || (parts.length > 1 && parts[1] && column == null)
    FilePaletteSpot(query, "")
??
    FilePaletteSpot
        - query[0 .. < colon]
        - query[colon ...]
        - file-palette-index(line)
        - file-palette-index(column)

.. colon = query.find(":")
.. parts = List'String(query[colon + 1 ...].split(":"))
.. line = file-palette-number(parts[0])
.. column = file-palette-number(parts[1]) if parts.length > 1

