_ get boundary

files.root.path if is-confined

╌╌╌╌╌╌╌╌╌╌ is Palette'FilePaletteItem ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do show
    - at PopupAnchor? = null

if !is-open
    names?.start()
    open-folder(file-palette-existing(start ?? files.root.path, boundary))
super.show(at)

────────────────────
+ do choose
    - item FilePaletteItem

if enters-folders && item.is-directory
    enter(item)
    =
. spot = file-palette-spot(query)
if spot.line == null || item.is-directory
    super.choose(item)
else
    super.choose
        - FilePaletteItem
            - item.path
            - item.name
            - item.kind
            - item.is-directory
            - item.detail
            - item.name-hits
            - item.detail-hits
            - spot.line
            - spot.column

────────────────────
+ do unmounted

unwatch()
for index in checkouts.values
    index.close()
checkouts.clear()
super.unmounted()

╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do open-folder
    - location Path

folder = location
found = null
items = file-palette-list(location, files.hides-name, shows-file)
watch-folder(location)

────────────────────
+ do enter
    - item FilePaletteItem

=? if !item.is-directory
open-folder(item.path)
reset()

────────────────────
+ do enter-selected

. item = selected-item
if item
    enter(item)

────────────────────
+ do open-crumb
    - location Path

search-input.request-focus()
=? if "$location" == "$folder"
. origin = folder
open-folder(location)
if query
    search()
else
    . child = file-palette-child-toward(location, origin)
    if child
        select-key("${child}")

────────────────────
+ do leave

=? if is-boundary(folder)
. above = folder.parent
=? if !above
. left = folder
open-folder(above)
reset()
select-key("$left")

────────────────────
_ do search

if !index-for(folder) || !file-palette-spot(query).name
    found = null
    =
=? if is-searching
is-searching = true
do new seek()

────────────────────
_ do seek

while is-open
    . asked = file-palette-spot(query).name
    . place = folder
    . index = index-for(place)
    . scope = index?.relative(place)
    if !asked || !index || scope == null || asked.find("/") != null
        found = null
        break
    . matches = index.search(asked, scope)
    if asked == file-palette-spot(query).name && place == folder
        found = file-palette-found(index, matches, scope, shows-file)
        break
is-searching = false

────────────────────
_ do index-for FileNameIndex?
    - location Path

=? names if names || !searches-checkouts
. top = file-palette-checkout(location)
=? null if !top
. key = "${top}"
. known = checkouts[key]
=? known if known
. made = FileNameIndex(top)
made.start()
checkouts[key] = made
= made

────────────────────
_ do watch-folder
    - location Path

unwatch()
watch = catch? listen(location)

────────────────────
_ do listen Closable ?! Error
    - location Path

. stream = location.watch()
for event on stream
    schedule-relist()
= stream

────────────────────
_ do unwatch

. stream = watch
watch = null
if stream
    catch? stream.close()

────────────────────
_ do relist

=? if !is-open
. location = file-palette-existing(folder, boundary)
if location == folder
    items = file-palette-list(location, files.hides-name, shows-file)
else
    open-folder(location)

────────────────────
_ do walk
    - spot FilePaletteSpot

. parts = List'String(spot.name.split("/"))
. last = parts.length - 1
. rest = parts[last]
. location = folder
for index in 0 .. < last
    . part = parts[index]
    if part == "" && index == 0
        location = boundary ?? Path("/", 0)
    else if part == ".."
        if !is-boundary(location)
            location = location.parent ?? location
    else if part != "" && part != "."
        . listed = if location == folder then items else file-palette-list(location, files.hides-name, shows-file)
        . target = file-palette-folder(listed, part)
        if !target
            rest = "$part${"/".join(parts[index + 1 ...])}"
            break
        location = target.path
if location != folder
    open-folder(location)
rewrite(rest + spot.suffix)

────────────────────
_ is-boundary
    - location Path

is-confined && "$location" == "${files.root.path}"

