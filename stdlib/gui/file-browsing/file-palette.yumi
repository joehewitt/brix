+ This
    - path
    - name
    - kind
    - is-directory
    - detail String = ""
    - name-hits [MatchSpan] = List'MatchSpan()
    - detail-hits [MatchSpan] = List'MatchSpan()
    - line Size? = null
    - column Size? = null
    - is-recent = false

sort-name = name.lowercased

────────────────────
+ get key String

if is-recent then "recent:$path" else "$path"

