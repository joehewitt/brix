━━━━━━━━━━━━━━━━━━━━
+ FilePalette is Palette'FilePaletteItem

+ files FileTree
+ names FileNameIndex?
+ searches-checkouts = false
+ start Path?
+ recent [FilePaletteItem]
+ shows-file FileNameFilter?
+ enters-folders = false
+ folder Path = Path("/", 0)
+ is-confined = false
+ items [FilePaletteItem]
+ trail [FilePaletteCrumb] = file-palette-trail(#folder, files.root.path)
+ prompt = file-palette-prompt(#trail)
+ empty-text = file-palette-empty-text(#query)
+ results = file-palette-results(#items, #query, #recent, #found)
+ event line-chosen FilePaletteSpot
+ key-builder = :: item => item.key
+ takes-keys = [Key.arrow-up, Key.arrow-down, Key.arrow-left, Key.arrow-right]

_ found [FilePaletteItem]?
_ watch Closable?
_ is-searching = false
_ checkouts [String = FileNameIndex]
_ schedule-relist := throttled(file-tree-flush-delay, this.relist)

────────────────────

<This
    <Box (leading) • flex-row
        <LucideSearch • icon file-palette-search
            align-y = Alignment.center
        <FilePaletteTrail • flex-row file-palette-trail
            for crumb in #trail
                <Box • flex-row
                    <Button • file-palette-crumb
                        title = crumb.name
                        action = => do open-crumb(crumb.path)
                    <LucideChevronRight • icon file-palette-chevron file-palette-crumb-chevron
                        align-y = Alignment.center

    <FilePaletteRow (row) - row
        item = row.#item

    <KeyShortcut "Open Folder"
        key = .arrow-right
        discoverable = false
        allow-while-input = true
        action = => do enter-selected()
    <KeyShortcut "Parent Folder"
        key = .arrow-left
        discoverable = false
        allow-while-input = true
        action = => do leave()

────────────────────
for event on key-press

if event.key == Key.tab
    enter-selected()
    event.cancel()
else if event.key == Key.backspace && !query
    leave()
    event.cancel()

────────────────────
for reason on dismissed when arrival

unwatch()
items = List'FilePaletteItem()
found = null

╌╌╌╌╌╌╌╌╌╌ is Palette'FilePaletteItem ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do refresh

. spot = file-palette-spot(query)
if spot.name.find("/") != null
    walk(spot)
else
    search()

────────────────────
+ do choose-selected

. spot = file-palette-spot(query)
if spot.name == "" && spot.line != null
    dismiss(DismissReason.chosen)
    line-chosen <- spot
else
    super.choose-selected()

