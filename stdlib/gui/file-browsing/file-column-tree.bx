(import ./file-icon)
(import ./file-info)
(import ./file-row)
(import ./file-view)
(import /graphics/color)
(import /graphics/primitives)
(import /gui/box)
(import /gui/column-tree)
(import /gui/events)
(import /gui/list-box)
(import /gui/primitives)
(import /gui/shorthands)
(import /gui/styles)
(import /gui/theme)
(import /gui/virtual)
(import /os/file-tree)

(style-extend GUIDefaultTheme
  (using GUIBoxSize)
  (using GUITextPaint)
  (using GUIVirtualRowStyle)
  (rule FileColumnTree
    (= row-height 28)
    (blank)
    (rule ColumnTreeDetail (• min-w 320))
    (blank)
    (rule ColumnTreeColumn
      (when-style #is-focused
        (rule ListItem
          (when-style #is-selected
            (rule file-icon (• text gui-accent-text-color))
            (blank)
            (rule folder-icon (• text gui-accent-text-color))
          )
        )
      )
    )
  )
)

(type + FileColumnTree (is FileView)
  (prop + detail-node (? FileNode) (= (. columns #detail-item)))
  (content
    (<> This (• flex-col)
      (<> (of ColumnTree FileNode) (id: columns) (• flex 1)
        (= root-node (. files root))
        (= load-children (=> (node) (call (. files children-of) node)))
        (= item-has-children (=> (node) (. node is-directory)))
        (= key-builder (=> (node) (. node key)))
        (= can-drag (=> (node) is-idle))
        (= can-drop (=> (drop) (call accepts (. drop items) (. drop parent))))
        (blank)
        (<> FileRow (slot: row) (param: row)
          (= item (!! (. row #item)))
        )
        (blank)
        (<> FileInfoPane (slot: detail) (• flex 1)
          (= files files)
          (= node #detail-node)
        )
      )
    )
  )
  (subscribe-for (on touched (. files changed))
    (call (. columns refresh))
  )
  (subscribe-for (on event (. columns selection-changed))
    (call note-selection)
  )
  (subscribe-for (on event (. columns active-column-changed))
    (call note-selection)
  )
  (subscribe-for (on event (. columns item-activated))
    (call open (call selected-node))
  )
  (subscribe-for (on event (. columns dropped))
    (call move (. event items) (. event parent))
  )
  (whenever-rule (. columns #owners)
    (call sync-retained)
    (call follow-current)
  )
  (fn-expr + selected-node (? FileNode)
    (call (. columns selected-item-at) (. columns active-index))
  )
  (fn-do + show-node _
    (param node FileNode)
    (param alignment _ (= (. ScrollAlignment nearest)))
    (call (. columns refresh))
    (let ignored (call (. columns select-path) (call (. files keys-to) node)))
  )
  (fn-do + focus-list _
    (call (. columns focus-active))
  )
  (fn-do + follow-current _
    (let node (. session current))
    (return-if (if (or (not node) (. node is-detached) (== (?. (call selected-node) key) (. node key)))))
    (let ignored (call (. columns select-path) (call (. files keys-to) node)))
  )
  (fn-expr + pressed-node (? FileNode)
    (param event GUIEvent)
    (call (. columns item-at) event)
  )
  (fn-expr + pressed-owner (? FileNode)
    (param event GUIEvent)
    (call (. columns owner-at) event)
  )
  (fn-do _ sync-retained _
    (let next (call (of Map String FileNode)))
    (for (in owner (. columns owners))
      (= ([] next (. owner key)) owner)
    )
    (call retain-only next)
  )
)
