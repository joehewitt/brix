━━━━━━━━━━━━━━━━━━━━
+ FileInfoPane is Box

+ files FileTree
+ node FileNode?
+ revision Size = 0
+ info FileInfo = file-info(#revision, #node?.#name ?? "", #node)

_ observed-node FileNode?

────────────────────

<This • flex-col file-info
    <FileIcon • file-info-icon
        glyph = #info.glyph
        align-x = Alignment.center
    <Label • file-info-name
        text = #node?.#name ?? ""
    <Label • file-info-summary
        text = #info.summary
    <Box • file-info-rule
    <Label • file-info-heading
        text = "Information"
    <FileInfoRow "Kind"
        value = #info.kind
    <FileInfoRow "Size"
        value = #info.size
    <FileInfoRow "Created"
        value = #info.created
    <FileInfoRow "Modified"
        value = #info.modified
    <FileInfoRow "Where"
        value = #info.location

────────────────────
whenever #node

observe(node)

────────────────────
for changed on files.modified

if changed.key == node?.key
    revision += 1

────────────────────
+ do unmounted

observe(null)
super.unmounted()

────────────────────
_ do observe
    - next FileNode?

. previous = observed-node
=? if previous?.key == next?.key
observed-node = next
if previous
    files.unobserve(previous)
if next
    files.observe(next)

