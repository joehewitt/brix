━━━━━━━━━━━━━━━━━━━━
+ FileInfo is Tuple

+ glyph FileGlyph
+ kind String
+ size String
+ created String
+ modified String
+ location String
+ summary String

━━━━━━━━━━━━━━━━━━━━
_ do file-info FileInfo
    - revision Size
    - name String
    - node FileNode?

=? FileInfo(FileGlyph.file, "", "", "", "", "", "") if !node
. glyph = file-glyph(node.is-directory, node.kind, name)
. kind = file-kind-text(glyph, file-extension(name))
. path = node.path
. location = "${path.parent ?? path}"
. size = catch? path.size
. created = catch? path.created
. modified = catch? path.modified
=? FileInfo(glyph, kind, "--", "--", "--", location, kind) if size == null || !created || !modified
. size-text = if node.is-directory then "--" else file-size-text(size)
= FileInfo
    - glyph
    - kind
    - size-text
    - created.readable
    - modified.readable
    - location
    - if node.is-directory then kind else "$kind · $size-text"

━━━━━━━━━━━━━━━━━━━━
_ file-kind-text String
    - glyph FileGlyph
    - extension String

match glyph
    |= FileGlyph.folder
        "Folder"
    |= FileGlyph.folder-link
        "Folder link"
    |= FileGlyph.file-link
        "Symbolic link"
    |= FileGlyph.code
        "$label source"
    |= FileGlyph.text
        "$label document"
    |= FileGlyph.data
        "$label data"
    |= FileGlyph.image
        "$label image"
    |= FileGlyph.archive
        "$label archive"
    ??
        if extension then "$label file" else "Document"

.. label = extension.uppercased
