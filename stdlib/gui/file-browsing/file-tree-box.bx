(import ./file-icon)
(import ./file-row)
(import ./file-view)
(import /graphics/color)
(import /graphics/primitives)
(import /gui/box)
(import /gui/events)
(import /gui/list-box)
(import /gui/primitives)
(import /gui/shorthands)
(import /gui/styles)
(import /gui/theme)
(import /gui/tree-box)
(import /os/file-tree)
(import /ui/selection)

(style-extend GUIDefaultTheme
  (using GUITextPaint)
  (rule FileTreeBox
    (rule TreeBox
      (when-style #is-focused
        (rule ListItem
          (when-style #is-selected
            (rule file-icon (• text gui-accent-text-color))
            (blank)
            (rule folder-icon (• text gui-accent-text-color))
          )
        )
      )
    )
  )
)

(type + FileTreeBox (is FileView)
  (prop + has-sticky-parents _ (= false))
  (prop + sticky-inset Length (= 0))
  (blank)
  (prop _ pending-expanded (? (list String)))
  (content
    (<> This (• flex-col)
      (<> (of TreeBox FileNode) (id: tree) (• flex 1)
        (= root-node (. files root))
        (= load-children (=> (node) (call (. files children-of) node)))
        (= item-has-children (=> (node) (. node is-directory)))
        (= item-title (=> (node) (. node name)))
        (= key-builder (=> (node) (. node key)))
        (= is-ordered false)
        (= has-sticky-parents #has-sticky-parents)
        (= sticky-inset #sticky-inset)
        (= has-chevrons false)
        (= selection-mode (. SelectionMode multiple))
        (= can-drag (=> (node) is-idle))
        (= item-path (=> (node) (. node path)))
        (= can-drop (=> (drop) (call accepts (. drop items) (. drop parent))))
        (= payload-operation (=> (drop) (call drop-operation (. drop payload) (. drop parent) (. drop modifiers))))
        (blank)
        (<> FileRow (slot: row) (param: row)
          (= item (!! (. row #item)))
        )
      )
    )
  )
  (subscribe-for (on touched (. files changed))
    (call (. tree reload))
  )
  (subscribe-for (on event (. tree selection-changed))
    (call choose (call tree-selection))
  )
  (subscribe-for (on event (. tree item-activated))
    (for (in node (call selected-nodes))
      (call open node)
    )
  )
  (subscribe-for (on event (. tree dropped))
    (if (. event source)
      (call move (. event items) (. event parent))
      (else
        (call receive (. event payload) (. event parent) (. event modifiers))
      )
    )
  )
  (whenever-rule (. tree #entries)
    (call sync-retained)
    (call restore-expanded)
  )
  (whenever-rule (. tree #expansion-revision)
    (call note-expanded)
  )
  (fn-do + mounted _
    (call (. super mounted))
    (= pending-expanded (call (of List String) (. session expanded)))
    (call follow-current)
  )
  (fn-expr + selected-node (? FileNode)
    (only-if node (if (and node (not (. node is-detached)))))
    (where
      (lazy node (. session current))
    )
  )
  (fn-expr + selected-nodes (list FileNode)
    (spread (. tree selected-items))
    (pipe ?> (not (. each is-detached)))
  )
  (fn-do + show-node _
    (param node FileNode)
    (param alignment _ (= (. ScrollAlignment nearest)))
    (let ignored (call (. tree reveal-key-path) (call (. files keys-to) node) alignment))
  )
  (fn-do + expand-node _
    (param node FileNode)
    (call (. tree expand-items) (list node))
  )
  (fn-do + focus-list _
    (call (. tree request-focus))
  )
  (fn-do + follow-current _
    (let node (. session current))
    (return-if (if (== (?. (call tree-selection) key) (?. node key))))
    (= (. tree selected-key) (?. node key))
    (= (. tree selected-keys) (call file-node-keys node))
  )
  (fn-expr + pressed-node (? FileNode)
    (param event GUIEvent)
    (call (. tree item-at) event)
  )
  (fn-do _ restore-expanded _
    (let paths pending-expanded)
    (return-if (if (not paths)))
    (= pending-expanded null)
    (let nodes (list FileNode))
    (for (in path paths)
      (let node (call (. files find) (/ (. files root path) path)))
      (if (and node (. node is-directory) (. node parent))
        (+= nodes node)
      )
    )
    (call (. tree expand-items) nodes)
  )
  (fn-do _ note-expanded _
    (return-if (if pending-expanded))
    (let paths
      (call (of List String)
        (block
          (spread (call (. tree expanded-items)))
          (pipe ?*> (only-if (. each relative-path) (if (and (. each parent) (not (. each is-detached))))))
        )
      )
    )
    (= (. session expanded) paths)
    (<- (. session expansion-changed) paths)
  )
  (fn-expr _ tree-selection (? FileNode)
    (only-if (?. (call (. tree entry-for-key) ([] keys 0)) item) (if (== (. keys length) 1)))
    (where
      (lazy keys (. tree selected-keys))
    )
  )
  (fn-do _ sync-retained _
    (let next (call (of Map String FileNode)))
    (for (in entry (. tree entries))
      (if (. entry is-expanded)
        (= ([] next (. entry key)) (. entry item))
      )
    )
    (call retain-only next)
  )
)

(fn-expr _ file-node-keys (list String)
  (param node (? FileNode))
  (case? node
    (list (. node key))
  )
  (default
    (call (of List String))
  )
)
