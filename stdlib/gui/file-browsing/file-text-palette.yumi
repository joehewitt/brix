━━━━━━━━━━━━━━━━━━━━
+ FileTextPalette is Palette'FileTextMatch

+ folder Path
+ matches [FileTextMatch]
+ is-searching = false
+ is-truncated = false
+ matches-case = false
+ matches-word = false
+ is-regex = false
+ prompt = "Find in files"
+ empty-text = file-text-empty-text(#query, #is-searching)
+ results = #matches
+ key-builder = :: match => "${match.path}:${match.line}:${match.column}"

_ active FileTextSearch?
_ request U64
_ is-fresh = false
_ last-query = ""

────────────────────

<This
    <Box (trailing) • flex-row items-center
        <IconButton • icon-case-sensitive w:22 h:20 ml:2
            is-on = #matches-case
            action = => do toggle-case()
            <Tooltip "Match Case (⌥⌘C)"
        <IconButton • icon-whole-word w:22 h:20 ml:2
            is-on = #matches-word
            action = => do toggle-word()
            <Tooltip "Match Whole Word (⌥⌘W)"
        <IconButton • icon-regex w:22 h:20 ml:2
            is-on = #is-regex
            action = => do toggle-regex()
            <Tooltip "Use Regular Expression (⌥⌘R)"

    <FileTextRow (row) - row
        match = row.#item

    <KeyShortcut "Match Case"
        key = KeyCombo("Option+Cmd+C")
        discoverable = false
        allow-while-input = true
        action = => do toggle-case()
    <KeyShortcut "Match Whole Word"
        key = KeyCombo("Option+Cmd+W")
        discoverable = false
        allow-while-input = true
        action = => do toggle-word()
    <KeyShortcut "Use Regular Expression"
        key = KeyCombo("Option+Cmd+R")
        discoverable = false
        allow-while-input = true
        action = => do toggle-regex()

────────────────────
for reason on dismissed when arrival

last-query = query
stop()
matches = List'FileTextMatch()

────────────────────
+ do refresh

request += 1
stop()
is-truncated = false
if !query
    is-searching = false
    matches = List'FileTextMatch()
    =
is-searching = true
. current = request
do new begin(current)

────────────────────
+ do show-seeded
    - seed String

. text = if seed then seed else last-query
show()
=? if !text
rewrite(text)
search-input.select-range(0, text.length)

────────────────────
_ do toggle-case

matches-case = !matches-case
renew()

────────────────────
_ do toggle-word

matches-word = !matches-word
renew()

────────────────────
_ do toggle-regex

is-regex = !is-regex
renew()

────────────────────
_ do renew

search-input.request-focus()
refresh()

────────────────────
_ do begin
    - current U64

file-text-search-delay.wait()
=? if current != request || !is-open
. asked = FileTextQuery(query, is-regex, true if matches-case, matches-word)
. search = FileTextSearch(folder, asked)
active = search
is-fresh = true
for batch on search.found
    if current == request
        take(batch)
for ended on search.finished
    if current == request
        if is-fresh
            matches = List'FileTextMatch()
        is-fresh = false
        is-searching = false
        is-truncated = ended.is-truncated
search.start()

────────────────────
_ do take
    - batch [FileTextMatch]

. merged = if is-fresh then List'FileTextMatch() else List'FileTextMatch(matches)
is-fresh = false
for match in batch
    merged += match
matches = merged

────────────────────
_ do stop

. search = active
active = null
search?.close()

━━━━━━━━━━━━━━━━━━━━
+ FileTextRow is Box

+ match FileTextMatch?

• This • flex-row flex:1

────────────────────

<This
    <MatchLabel • file-text-match flex:1
        text = file-text-shown(#match)
        hits = file-text-hits(#match)
        align-y = Alignment.center
    <Label • file-text-location
        text = file-text-place(#match)
        align-y = Alignment.center

━━━━━━━━━━━━━━━━━━━━
_ file-text-shown String
    - match FileTextMatch?

|? !match
    ""
??
    bytes.slice-string(file-text-indent(bytes) .. < bytes.size)

.. bytes = match.text as Byte[]

━━━━━━━━━━━━━━━━━━━━
_ do file-text-hits [MatchSpan]
    - match FileTextMatch?

. spans [MatchSpan]
=? spans if !match
. indent = file-text-indent(match.text)
for hit in match.hits
    if hit.end > indent
        . start = if hit.start > indent then hit.start - indent else 0
        spans += MatchSpan(start, hit.end - indent)
= spans

━━━━━━━━━━━━━━━━━━━━
_ do file-text-indent Size
    - bytes Byte[]

. count Size = 0
while count < bytes.size && (bytes[count] == 32 || bytes[count] == 9)
    count += 1
= count

━━━━━━━━━━━━━━━━━━━━
_ file-text-place String
    - match FileTextMatch?

if match then "${match.path}:${match.line + 1}" else ""

━━━━━━━━━━━━━━━━━━━━
_ file-text-empty-text String
    - query String
    - is-searching Bool

|? !query
    "Type to search file contents"
|? is-searching
    "Searching…"
??
    "No matches"
