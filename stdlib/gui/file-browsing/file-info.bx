(import ./file-icon)
(import /graphics/color)
(import /graphics/primitives)
(import /graphics/style)
(import /graphics/text)
(import /gui/box)
(import /gui/label)
(import /gui/primitives)
(import /gui/shorthands)
(import /gui/styles)
(import /gui/theme)
(import /os/file)
(import /os/file-tree)
(import /os/path)
(import /time/datetime)

(style-extend GUIDefaultTheme
  (using GUIBoxPaint)
  (using GUIBoxSize)
  (using GUIBoxSpacing)
  (using GUIFontStyle)
  (using GUIParagraphStyle)
  (using GUITextPaint)
  (using VectorPaintStyle)
  (rule file-info (• p 24)
    (rule file-glyph-icon (• w 96) (• h 96)
      (= stroke-width 1)
    )
  )
  (blank)
  (rule file-info-icon (• mt 24) (• mb 16))
  (blank)
  (rule file-info-name (• h 28)
    (= font-size 18)
    (= font-weight (. FontWeight bold))
    (= text-alignment (. TextAlignment center))
  )
  (blank)
  (rule file-info-summary (• text gui-muted-text-color) (• h 20)
    (= text-alignment (. TextAlignment center))
  )
  (blank)
  (rule file-info-rule (• h 1) (• mt 20) (• mb 12) (• bg gui-divider-color))
  (blank)
  (rule file-info-heading (• h 24)
    (= font-weight (. FontWeight bold))
  )
  (blank)
  (rule file-info-row (• h 24))
  (blank)
  (rule file-info-title (• text gui-muted-text-color) (• w 80))
)

(type + FileInfoPane (is Box)
  (prop + files FileTree)
  (prop + node (? FileNode))
  (prop + revision Size (= 0))
  (prop + info FileInfo (= (call file-info #revision (?? (?. #node #name) "") #node)))
  (blank)
  (prop _ observed-node (? FileNode))
  (content
    (<> This (• flex-col) (• file-info)
      (<> FileIcon (• file-info-icon)
        (= glyph (. #info glyph))
        (= align-x (. Alignment center))
      )
      (<> Label (• file-info-name)
        (= text (?? (?. #node #name) ""))
      )
      (<> Label (• file-info-summary)
        (= text (. #info summary))
      )
      (<> Box (• file-info-rule))
      (<> Label (• file-info-heading)
        (= text "Information")
      )
      (<> FileInfoRow (text: "Kind")
        (= value (. #info kind))
      )
      (<> FileInfoRow (text: "Size")
        (= value (. #info size))
      )
      (<> FileInfoRow (text: "Created")
        (= value (. #info created))
      )
      (<> FileInfoRow (text: "Modified")
        (= value (. #info modified))
      )
      (<> FileInfoRow (text: "Where")
        (= value (. #info location))
      )
    )
  )
  (whenever-rule #node
    (call observe node)
  )
  (subscribe-for (on changed (. files modified))
    (if (== (. changed key) (?. node key))
      (+= revision 1)
    )
  )
  (fn-do + unmounted _
    (call observe null)
    (call (. super unmounted))
  )
  (fn-do _ observe _
    (param next (? FileNode))
    (let previous observed-node)
    (return-if (if (== (?. previous key) (?. next key))))
    (= observed-node next)
    (if previous
      (call (. files unobserve) previous)
    )
    (if next
      (call (. files observe) next)
    )
  )
)

(type + FileInfoRow (is Box)
  (prop + title _ (= ""))
  (prop + value _ (= ""))
  (blank)
  (rule file-info-value)
  (fn-do + This _
    (param title _ (= ""))
  )
  (content
    (<> This (• flex-row) (• file-info-row)
      (<> Label (• file-info-title)
        (= text #title)
      )
      (<> Label (• file-info-value) (• flex 1)
        (= text #value)
        (= text-alignment (. TextAlignment right))
      )
    )
  )
)

(type + FileInfo (is Tuple)
  (prop + glyph FileGlyph)
  (prop + kind String)
  (prop + size String)
  (prop + created String)
  (prop + modified String)
  (prop + location String)
  (prop + summary String)
)

(fn-do _ file-info FileInfo
  (param revision Size)
  (param name String)
  (param node (? FileNode))
  (return-if (call FileInfo (. FileGlyph file) "" "" "" "" "" "") (if (not node)))
  (let glyph (call file-glyph (. node is-directory) (. node kind) name))
  (let kind (call file-kind-text glyph (call file-extension name)))
  (let path (. node path))
  (let location (str (?? (. path parent) path)))
  (let size (catch? (. path size)))
  (let created (catch? (. path created)))
  (let modified (catch? (. path modified)))
  (return-if (call FileInfo glyph kind "--" "--" "--" location kind) (if (or (== size null) (not created) (not modified))))
  (let size-text (if-expr (. node is-directory) "--" (call file-size-text size)))
  (return
    (call FileInfo
      (block
        (arg glyph)
        (arg kind)
        (arg size-text)
        (arg (. created readable))
        (arg (. modified readable))
        (arg location)
        (arg (if-expr (. node is-directory) kind (str kind " · " size-text)))
      )
    )
  )
)

(fn-expr _ file-kind-text String
  (param glyph FileGlyph)
  (param extension String)
  (match glyph
    (case= (. FileGlyph folder)
      "Folder"
    )
    (case= (. FileGlyph folder-link)
      "Folder link"
    )
    (case= (. FileGlyph file-link)
      "Symbolic link"
    )
    (case= (. FileGlyph code)
      (str label " source")
    )
    (case= (. FileGlyph text)
      (str label " document")
    )
    (case= (. FileGlyph data)
      (str label " data")
    )
    (case= (. FileGlyph image)
      (str label " image")
    )
    (case= (. FileGlyph archive)
      (str label " archive")
    )
    (default
      (if-expr extension (str label " file") "Document")
    )
  )
  (where
    (lazy label (. extension uppercased))
  )
)
