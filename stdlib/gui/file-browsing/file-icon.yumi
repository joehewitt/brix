_ file-glyphs := file-glyph-table()

━━━━━━━━━━━━━━━━━━━━
• extend GUIDefaultTheme
    using GUIBoxSize
    using GUITextPaint

• file-icon • text:gui-muted-text-color

• folder-icon • text:gui-folder-icon-color

• file-glyph-icon • w:15 h:15

━━━━━━━━━━━━━━━━━━━━
+ FileIcon is Box

+ glyph FileGlyph = FileGlyph.file

────────────────────

<This • flex-row
    match #glyph
        |= FileGlyph.folder
            <LucideFolder • icon folder-icon file-glyph-icon
        |= FileGlyph.folder-link
            <LucideFolderSymlink • icon folder-icon file-glyph-icon
        |= FileGlyph.file
            <LucideFile • icon file-icon file-glyph-icon
        |= FileGlyph.file-link
            <LucideFileSymlink • icon file-icon file-glyph-icon
        |= FileGlyph.code
            <LucideFileCode • icon file-icon file-glyph-icon
        |= FileGlyph.text
            <LucideFileText • icon file-icon file-glyph-icon
        |= FileGlyph.data
            <LucideFileJson • icon file-icon file-glyph-icon
        |= FileGlyph.image
            <LucideFileImage • icon file-icon file-glyph-icon
        |= FileGlyph.archive
            <LucideFileArchive • icon file-icon file-glyph-icon

━━━━━━━━━━━━━━━━━━━━
+ FileGlyph is Union

| folder
| folder-link
| file
| file-link
| code
| text
| data
| image
| archive

━━━━━━━━━━━━━━━━━━━━
+ file-glyph FileGlyph
    - is-directory Bool
    - kind PathKind
    - name String

|? is-directory && kind == PathKind.link
    FileGlyph.folder-link
|? is-directory
    FileGlyph.folder
|? kind == PathKind.link
    FileGlyph.file-link
??
    file-glyphs[file-extension(name)] ?? FileGlyph.file

━━━━━━━━━━━━━━━━━━━━
+ file-extension String
    - name String

Path(name, 0).ext.lowercased

━━━━━━━━━━━━━━━━━━━━
_ do file-glyph-table Map'String'FileGlyph

. table = Map'String'FileGlyph()
for ext in ["yumi", "ts", "tsx", "js", "jsx", "mjs", "py", "rb", "go", "rs", "swift", "java", "kt"]
    table[ext] = FileGlyph.code
for ext in ["c", "h", "cc", "cpp", "hpp", "m", "mm", "sh", "zsh", "html", "css", "sql", "lua"]
    table[ext] = FileGlyph.code
for ext in ["md", "txt", "rtf", "log", "pdf"]
    table[ext] = FileGlyph.text
for ext in ["json", "yml", "yaml", "toml", "xml", "plist", "csv", "lock"]
    table[ext] = FileGlyph.data
for ext in ["png", "jpg", "jpeg", "gif", "svg", "webp", "heic", "icns", "ico"]
    table[ext] = FileGlyph.image
for ext in ["zip", "tar", "gz", "tgz", "bz2", "xz", "dmg", "pkg"]
    table[ext] = FileGlyph.archive
= table
