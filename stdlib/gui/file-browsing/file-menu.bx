(import /gui/box)
(import /gui/clipboard)
(import /gui/desktop)
(import /gui/menu)
(import /os/file-session)
(import /os/file-tree)
(import /ui/key-combo)

(type + FileRenameRequest (is Tuple)
  (prop + node FileNode)
  (prop + discards Bool)
)

(type + FileMenu (is ContextMenu)
  (prop + files FileTree)
  (prop + session FileSession)
  (prop + node (? FileNode))
  (prop + folder (? FileNode))
  (prop + targets (list FileNode))
  (prop + rename-key (? KeyCombo))
  (prop + trash-key (? KeyCombo))
  (prop + can-create _ (= (?? (?. #node is-directory) true)))
  (prop + can-modify _ (= true))
  (event + rename-requested FileRenameRequest)
  (content
    (<> This
      (+<> Box (id: leading) (• flex-col))
      (if #can-modify
        (if #can-create
          (<> MenuItem (text: "New File")
            (= action (=> () :do (call create false)))
          )
          (<> MenuItem (text: "New Folder")
            (= action (=> () :do (call create true)))
          )
          (<> MenuSeparator)
        )
        (<> MenuItem (text: "Rename…")
          (= key #rename-key)
          (= is-enabled (== (. #targets length) 1))
          (= action (=> () :do (call rename)))
        )
        (if (not #can-create)
          (<> MenuItem (text: "Duplicate")
            (= is-enabled (== (. #targets length) 1))
            (= action (=> () :do (call duplicate)))
          )
        )
        (<> MenuItem (text: "Move to Trash")
          (= key #trash-key)
          (= is-enabled (> (. #targets length) 0))
          (= action (=> () :do (call trash targets)))
        )
        (<> MenuSeparator)
      )
      (<> MenuItem (text: "Copy Path")
        (= action (=> () :do (call copy-paths)))
      )
      (<> MenuItem (text: "Open in Finder")
        (= action (=> () :do (call reveal)))
      )
    )
  )
  (fn-do + trash _
    (param nodes (list FileNode))
    (for (in node nodes)
      (if (and (. node parent) (not (. node is-detached)))
        (call report (call attempt-trash node))
      )
    )
  )
  (fn-do _ create _
    (param is-folder Bool)
    (let made (call attempt-create (call creation-folder) is-folder))
    (if made
      (<- rename-requested (call FileRenameRequest made false))
    )
  )
  (fn-do _ rename _
    (let pressed node)
    (if (and pressed (. pressed parent))
      (<- rename-requested (call FileRenameRequest pressed false))
    )
  )
  (fn-do _ duplicate _
    (let pressed node)
    (return-if (if (not pressed)))
    (blank)
    (let made (call attempt-duplicate pressed))
    (if made
      (<- rename-requested (call FileRenameRequest made true))
    )
  )
  (fn-expr _ creation-folder FileNode
    (match node
      (case= null
        (?? folder (. files root))
      )
      (case? (. it is-directory)
        it
      )
      (default
        (?? (. it parent) (. files root))
      )
    )
  )
  (fn-expr _ listed-nodes (list FileNode)
    (if-expr (. targets length) targets (list (?? folder (. files root))))
  )
  (fn-do _ copy-paths _
    (let ignored (call (. (call Clipboard) write-text) (call (. "\n" join) (in (str (. each path)) (call listed-nodes)))))
  )
  (fn-do _ reveal _
    (let ignored (call reveal-in-file-viewer (. (?? node folder (. files root)) path)))
  )
  (fn-do _ report _
    (param message (? String))
    (if message
      (<- (. session failed) message)
    )
  )
  (fn-do _ attempt-create (? FileNode)
    (param owner FileNode)
    (param is-folder Bool)
    (let made
      (call (. files create) owner is-folder
        (block
          (on-error (: failure Error)
            (<- (. session failed) (str "Could not create an item in " (. owner path name) ": " (. failure message)))
            (return null)
          )
        )
      )
    )
    (return made)
  )
  (fn-do _ attempt-duplicate (? FileNode)
    (param node FileNode)
    (let made
      (call (. files duplicate) node
        (block
          (on-error (: failure Error)
            (<- (. session failed) (str "Could not duplicate " (. node name) ": " (. failure message)))
            (return null)
          )
        )
      )
    )
    (return made)
  )
  (fn-do _ attempt-trash (? String)
    (param node FileNode)
    (call move-to-trash (. node path)
      (block
        (on-error (: failure Error)
          (return (. failure message))
        )
      )
    )
    (call (. files removed) node)
    (return null)
  )
)
