+ file-mark-dot-size Length = 7

━━━━━━━━━━━━━━━━━━━━
• extend GUIDefaultTheme
    using GUIBoxPaint
    using GUIBoxSize

• file-mark-dot • w:file-mark-dot-size h:file-mark-dot-size
    corner-radius = file-mark-dot-size / 2

━━━━━━━━━━━━━━━━━━━━
+ FileRow is Box

+ item FileNode
+ is-renaming = #view?.#renaming?.key == #item.key
+ marks = #view?.#marks?[#item.relative-path]
+ shows-chevron = #item.is-directory && #is-row-hovered && (#tree-row?.#chevron-width ?? 1) == 0

_ view Ancestor'FileView
_ tree-row Ancestor'(TreeBoxItem'FileNode)
_ is-row-hovered = #tree-row?.#is-hover-within ?? false

────────────────────

<This • flex-row flex:1
    if #shows-chevron
        <DisclosureChevron • icon file-icon file-glyph-icon mr:6
            align-y = Alignment.center
            is-open = #tree-row?.#is-expanded ?? false
    else
        <FileIcon • mr:6
            glyph = file-glyph(#item.is-directory, #item.kind, #item.#name)
            align-y = Alignment.center
    if #is-renaming
        <FileRenameInput rename-input • flex:1 mr:6
            node-key = item.key
            text = item.name
            align-y = Alignment.center
    else
        <Label • flex:1
            text = #item.#name
            align-y = Alignment.center
    for mark in #marks ?? List'FileMark()
        <FileMarkView • ml:6
            mark = mark
            align-y = Alignment.center

━━━━━━━━━━━━━━━━━━━━
+ FileMarkView is Box

+ mark FileMark

────────────────────

<This • flex-row items-center
    if #mark.is-dot
        <Box • file-mark-dot
            background-color = #mark.color
    else
        <Label • file-mark
            text = #mark.text
            color = #mark.color

━━━━━━━━━━━━━━━━━━━━
+ FileRenameInput is TextInput

+ node-key = ""

_ view Ancestor'FileView

╌╌╌╌╌╌╌╌╌╌ is Box ╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do mounted

super.mounted()
request-focus()

╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌

────────────────────
for event on focus

select-range(0, file-stem-length(text))

────────────────────
for event on key-press

if event.key == Key.escape
    view?.cancel-rename()
    event.cancel()

────────────────────
for event on submit

view?.commit-rename(node-key, text, true)

────────────────────
for event on blur

view?.commit-rename(node-key, text, false)

━━━━━━━━━━━━━━━━━━━━
+ file-stem-length Size
    - name String

if dot == null || dot == 0 then name.length else dot

.. dot = name.find-reverse(".")
