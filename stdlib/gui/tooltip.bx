(import ./box)
(import ./label)
(import ./placement)
(import ./popup)
(import ./primitives)
(import ./shorthands)
(import ./styles)
(import ./theme)
(import /graphics/color)
(import /graphics/outline)
(import /graphics/primitives)
(import /graphics/text)
(import /time/duration)
(import /units)
(blank)
(prop _ tooltip-max-width Length (= 420))

(style-extend GUIDefaultTheme
  (using GUIBoxMotion)
  (using GUIBoxPaint)
  (using GUIBoxTransform)
  (using GUITextPaint)
  (using GUIFontStyle)
  (using GUIBoxSpacing)
  (using GUIBoxSize)
  (using GUITextComposition)
  (using GUIPopupStyle)
  (rule Tooltip (• bg gui-popup-color) (• text gui-text-color) (• px 8) (• py 4)
    (= border-color gui-border-color)
    (= border-width 1)
    (= corner-radius gui-popup-radius)
    (= shadow gui-popup-shadow)
    (= font-size gui-callout-font-size)
    (blank)
    (rule tooltip-text (• max-w tooltip-max-width)
      (= text-wrap (. TextWrap word))
      (= text-wrap-sizing (. TextWrapSizing tight))
    )
  )
  (blank)
  (rule HoverCard (• bg gui-popup-color) (• text gui-text-color) (• p 12)
    (= border-color gui-border-color)
    (= border-width 1)
    (= corner-radius gui-popup-radius)
    (= shadow gui-popup-shadow)
    (= motion gui-motion-quick)
    (blank)
    (when-style #is-entering
      (= opacity 0%%)
    )
    (blank)
    (when-style #is-leaving
      (= opacity 0%%)
    )
  )
)

(type + Tooltip (is Popup)
  (prop + text _ (= ""))
  (blank)
  (rule This (• passive) (• flex-col) (• above-center 6)
    (= hover-trigger true)
    (= hover-delay 1.6s)
  )
  (fn-do + This _
    (param text _ (= ""))
  )
  (content
    (<> This
      (<> Label (id: tooltip-label) (• tooltip-text)
        (= text #text)
      )
    )
  )
)

(type + HoverCard (is Popup)
  (rule This (• flex-col) (• below 8)
    (= hover-trigger true)
    (= hover-delay 0.45s)
    (= popup-stacking (. PopupStacking hint))
  )
)
