./clipboard
./icon
./icon-button
/gui/icons/lucide/check
/gui/icons/lucide/copy
/time/duration

_ copy-button-settle Duration = 1500ms

━━━━━━━━━━━━━━━━━━━━
+ CopyButton is IconButton

+ text = ""
+ is-copied = false

_ settler Task?

• This
    when !#is-copied
        • own icon-host
            <LucideCopy (first-child) • icon

    when #is-copied
        • own icon-host
            <LucideCheck (first-child) • icon

────────────────────
for event on click

write()
event.cancel()

────────────────────
+ do write Bool

=? false if !Clipboard().write-text(text)
is-copied = true
settler?.cancel-later()
settler = do new
    copy-button-settle.wait()
    is-copied = false
= true
