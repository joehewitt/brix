━━━━━━━━━━━━━━━━━━━━
• GUIMotionTheme
    using GUIBoxTransform

+ gui-motion-quick Motion = spring(180ms)
+ gui-motion-smooth Motion = spring(320ms)
+ gui-motion-bouncy Motion = spring(420ms, 0.3)
+ gui-animates-fills = true

• spin animation 1s
    repeat = Repeat.forever
    frame-rate = 30
    rotate = 0 .. 2 * π

• shake:distance Length animation 360ms
    translate.x
        at 0% = 0
        at 20% = -distance
        at 40% = distance
        at 60% = -distance / 2
        at 80% = distance / 2
        at 100% = 0

• pop-in animation 220ms
    opacity = 0%% .. • motion ease-out(160ms)
    scale = 0.94 .. • motion gui-motion-bouncy
    translate = Point(0, 6) .. Point(0, 0)

• popup-out animation 120ms
    opacity = .. 0%% • motion ease-in(120ms)

• fade-in animation 1s
    opacity = 0%% ..

• breathe animation 1200ms
    repeat = Repeat.forever
    direction = AnimationDirection.alternate
    opacity = 1%% .. 0.6%%

• pulse animation 1400ms
    repeat = Repeat.forever
    opacity
        at 0% = 1%%
        at 50% = 0.35%% • easing Easing.ease-in-out
        at 100% = 1%% • easing Easing.ease-in-out
    scale
        at 0% = 1.15
        at 50% = 0.8 • easing Easing.ease-in-out
        at 100% = 1.15 • easing Easing.ease-in-out

• overshoot:peak F64 motion 280ms
    at 0% = 0
    at 65% = peak
    at 100% = 1 • motion spring(140ms)

━━━━━━━━━━━━━━━━━━━━
• GUIReducedMotionTheme is GUIMotionTheme for reduce-motion

+ gui-motion-quick = instant
+ gui-motion-smooth = ease-out(120ms)
+ gui-motion-bouncy = ease-out(120ms)
+ gui-animates-fills = false

• pop-in animation 120ms
    opacity = 0%% ..

• popup-out animation 100ms
    opacity = .. 0%%

• shake:distance Length animation 240ms
    opacity
        at 0% = 1%%
        at 50% = 0.4%%
        at 100% = 1%%

• pulse animation 1400ms
    repeat = Repeat.forever
    opacity
        at 0% = 1%%
        at 50% = 0.35%% • easing Easing.ease-in-out
        at 100% = 1%% • easing Easing.ease-in-out

• overshoot:peak F64 motion 120ms
    at 0% = 0
    at 100% = 1

