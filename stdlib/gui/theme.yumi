━━━━━━━━━━━━━━━━━━━━
• GUILightGlassTheme is GUILightTheme for glass

+ gui-field-color = RGBA("#ffffff99")

━━━━━━━━━━━━━━━━━━━━
• GUILightInactiveGlassTheme is GUILightInactiveTheme for glass

+ gui-field-color = RGBA("#ffffff99")

━━━━━━━━━━━━━━━━━━━━
+ GUIAccents is Tuple

+ dark-control RGBA
+ dark-selection RGBA
+ dark-unemphasized RGBA
+ light-control RGBA
+ light-selection RGBA
+ light-unemphasized RGBA

━━━━━━━━━━━━━━━━━━━━
+ do gui-use-accents
    - accents GUIAccents

style-set-theme-slot
    - GUIDefaultTheme
    - "gui-accent-bright-color"
    - gui-color-bits(accents.dark-control)
    - false
style-set-theme-slot
    - GUIDefaultTheme
    - "gui-accent-color"
    - gui-color-bits(accents.dark-selection)
    - false
style-set-theme-slot
    - GUILightTheme
    - "gui-accent-bright-color"
    - gui-color-bits(accents.light-control)
    - false
style-set-theme-slot
    - GUILightTheme
    - "gui-accent-color"
    - gui-color-bits(accents.light-selection)
    - false
style-set-theme-slot
    - GUIInactiveTheme
    - "gui-accent-color"
    - gui-color-bits(accents.dark-unemphasized)
    - false
style-set-theme-slot
    - GUILightInactiveTheme
    - "gui-accent-color"
    - gui-color-bits(accents.light-unemphasized)
    - false
style-set-theme-slot
    - GUIGlassTheme
    - "gui-accent-bright-color"
    - gui-color-bits(accents.dark-control)
    - false
style-set-theme-slot
    - GUIGlassTheme
    - "gui-accent-color"
    - gui-color-bits(accents.dark-selection)
    - false
style-set-theme-slot
    - GUILightGlassTheme
    - "gui-accent-bright-color"
    - gui-color-bits(accents.light-control)
    - false
style-set-theme-slot
    - GUILightGlassTheme
    - "gui-accent-color"
    - gui-color-bits(accents.light-selection)
    - false
style-set-theme-slot
    - GUIInactiveGlassTheme
    - "gui-accent-color"
    - gui-color-bits(accents.dark-unemphasized)
    - false
style-set-theme-slot
    - GUILightInactiveGlassTheme
    - "gui-accent-color"
    - gui-color-bits(accents.light-unemphasized)
    - false

━━━━━━━━━━━━━━━━━━━━
_ gui-color-bits I64
    - color RGBA

style-intern-holder(StyleWideHolder'RGBA(color))
