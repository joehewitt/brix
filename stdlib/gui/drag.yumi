+ operation = DropOperation.none
+ payload => session.payload

────────────────────
+ This
    - data PointerEventData
    - session

────────────────────
+ do accept
    - scrolling Box? = null
    - dropping = DropOperation.copy

acceptor = gc-object-from-pointer'Box(route-frames[route-index].owner)
scroller = scrolling
operation = dropping
cancel()

