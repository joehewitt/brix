━━━━━━━━━━━━━━━━━━━━
+ DragStartEvent is GUIEvent

+ pointer Point
+ session DragSession?
+ exported DragExport?

────────────────────
+ This
    - data PointerEventData
    - pointer

────────────────────
+ do begin
    - payload DragPayload
    - snapshot Box? = null
    - grab Point? = null

. owner = gc-object-from-pointer'Box(route-frames[route-index].owner)
. started = DragSession(payload, owner, root-point, pointer, modifiers, pointer-id)
started.pending-snapshot = snapshot ?? owner
started.grab = grab
session = started
cancel()
= started

────────────────────
+ do carry DragSession
    - payload DragPayload
    - box Box? = null
    - stack [Box] = List'Box()

. owner = gc-object-from-pointer'Box(route-frames[route-index].owner)
. started = DragSession(payload, owner, root-point, pointer, modifiers, pointer-id)
started.carried += box ?? owner
for follower in stack
    started.carried += follower
session = started
cancel()
= started

────────────────────
+ do export
    - items [ClipboardItem]
    - image Image
    - frame Rect

exported = DragExport(items, image, frame)
cancel()

