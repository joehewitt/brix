+ drag-start-distance Length = 3
+ drag-scroll-edge Length = 28
+ drag-scroll-step Length = 12
+ drag-scroll-interval = 16ms
+ drag-promise-timeout-milliseconds U64 = 30000
+ drag-stack-depth Index = 3
+ drag-stack-step Length = 3
_ drag-pace-window = 0.1

