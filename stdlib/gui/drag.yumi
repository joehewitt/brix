"paths"

━━━━━━━━━━━━━━━━━━━━
+ drag-paths [Path]?
    - payload DragPayload

found if found.length > 0

.. found = if payload is ClipboardDrag then clipboard-paths else other-paths
.. clipboard-paths = (payload as ClipboardDrag).clipboard.paths
.. other-paths = if payload is PathsDrag then (payload as PathsDrag).paths else List'Path()

━━━━━━━━━━━━━━━━━━━━
+ DropOperation is U32

| none = 0
| copy = 1
| link = 2
| move = 3

━━━━━━━━━━━━━━━━━━━━
+ ClipboardDrag is Tuple
    is DragPayload

+ clipboard Clipboard
+ sequence U64

────────────────────
+ get drag-kind

"clipboard"

────────────────────
+ do receive-promised-files [Path]

. done = Semaphore'U64()
do new thread
    done.post(C:yumiGuiDragWaitPromisedFiles(sequence, drag-promise-timeout-milliseconds))
. count = done.await() ?? 0
do finally C:yumiGuiDragReleasePromisedFiles(sequence)
. files [Path]
for index in 0 .. < count
    . file = C:yumiGuiDragPromisedFile(sequence, index)
    if file
        files += file as String
= files

━━━━━━━━━━━━━━━━━━━━
+ DragGhost

+ image RasterCanvas
+ size Dimensions
+ grab Point
+ origin Point
+ native Pointer = Pointer()
+ is-shown = false

────────────────────
+ This
    - image
    - size
    - grab
    - origin

────────────────────
+ get frame

Rect(origin.x, origin.y, size.width, size.height)

────────────────────
+ do follow
    - point Point

origin = Point(point.x - grab.x, point.y - grab.y)

────────────────────
+ do present
    - window-native Pointer
    - zoom F64

if native == Pointer()
    native = C:yumiGuiPopupCreate(window-native)
    C:yumiGuiPopupSetConstrained(native, false)
=? if native == Pointer()
C:yumiGuiPopupSetFrame
    - native
    - origin.x * zoom
    - origin.y * zoom
    - size.width * zoom
    - size.height * zoom
=? if is-shown
is-shown = true
C:yumiGuiPopupSetPassesPointer(native, true)
C:yumiGuiPopupCommitFrame(native, image.native)
C:yumiGuiPopupSetShown(native, true)

────────────────────
+ do close

if native != Pointer()
    C:yumiGuiPopupRelease(native)
    native = Pointer()
is-shown = false
image.close()

━━━━━━━━━━━━━━━━━━━━
+ DragSession

+ payload DragPayload
+ source Box?
+ origin Point
+ point Point
+ modifiers PointerModifiers
+ pointer-id U64
+ target Box?
+ scroller Box?
+ ghost DragGhost?
+ grab Point?
+ pending-snapshot Box?
+ carried [Box]
+ operation = DropOperation.none
+ is-accepted => target != null

_ times = List'F64()
_ places = List'Point()

────────────────────
+ This
    - payload
    - source
    - origin
    - point
    - modifiers
    - pointer-id

────────────────────
+ do sample
    - at Point
    - time F64

while times && time - times[0] > drag-pace-window * 2
    times.remove(0)
    places.remove(0)
times += time
places += at

────────────────────
+ do get pace Point

=? Point(0, 0) if places.length < 2
. last = times.length - 1
. now = times[last]
. index = last
while index > 0 && now - times[index - 1] <= drag-pace-window
    index -= 1
. elapsed = now - times[index]
=? Point(0, 0) if elapsed <= 0
. from = places[index]
. to = places[last]
= Point((to.x - from.x) / elapsed, (to.y - from.y) / elapsed)

━━━━━━━━━━━━━━━━━━━━
