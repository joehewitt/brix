/core/markup
/math/motion

+ gui-instant-cause = MotionScope(instant, false)
+ gui-still-cause = MotionScope(instant, true)

━━━━━━━━━━━━━━━━━━━━
+ MotionScope is MarkupCause
    is Usable'Void

+ motion Motion
+ is-still Bool

_ outer MarkupCause?

────────────────────
+ This
    - motion
    - is-still

────────────────────
+ do begin-using

outer = swap-markup-cause(this)

────────────────────
+ do end-using

swap-markup-cause(outer ?? markup-cause-write)
outer = null

━━━━━━━━━━━━━━━━━━━━
+ motion MotionScope
    - motion Motion

MotionScope(motion, false)

━━━━━━━━━━━━━━━━━━━━
+ scope-motion Motion?
    - cause MarkupCause

(cause as MotionScope).motion if cause is MotionScope

━━━━━━━━━━━━━━━━━━━━
+ scope-stills Bool
    - cause MarkupCause

cause is MotionScope && (cause as MotionScope).is-still
