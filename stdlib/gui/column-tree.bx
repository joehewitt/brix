  (fn-do + select _
    (param selected-index Int)
    (param index Index)
    (return-if (if (>= index (. levels length))))
    (blank)
    (let current ([] levels index))
    (return-if (if (and (== (. current selected-index) selected-index) (not (. current is-multiple)))))
    (blank)
    (let next-levels (call (of List (of ColumnTreeLevel Item)) levels))
    (= ([] next-levels index)
      (call (of ColumnTreeLevel Item)
        (block
          (arg (. current id))
          (arg (. current owner))
          (arg (. current owner-key))
          (arg (. current entries))
          (arg (. current entries-id))
          (arg selected-index)
        )
      )
    )
    (= levels next-levels)
    (return true)
  )
  (fn-do + select-many _
    (param selected-index Int)
    (param selection (list String))
    (param index Index)
    (return-if (if (>= index (. levels length))))
    (blank)
    (let current ([] levels index))
    (return-if (if (and (== (. current selected-index) selected-index) (== (. current selection) selection))))
    (blank)
    (let next-levels (call (of List (of ColumnTreeLevel Item)) levels))
    (= ([] next-levels index)
      (call (of ColumnTreeLevel Item)
        (block
          (arg (. current id))
          (arg (. current owner))
          (arg (. current owner-key))
          (arg (. current entries))
          (arg (. current entries-id))
          (arg selected-index)
          (arg selection)
        )
      )
    )
    (= levels next-levels)
    (return true)
  )
  (fn-do + ensure-selection _
    (param index Index)
    (return-if (if (>= index (. levels length))))
    (blank)
    (let level ([] levels index))
    (return-if (if (and (>= (. level selected-index) 0) (< (. level selected-index) (. level entries length)))))
    (return-if (if (not (. level entries))))
    (blank)
    (return (call select 0 index))
  )
  (fn-do + index-of _
    (param target (of ColumnTreeLevel Item))
    (let index Index 0)
    (for (in candidate levels)
      (if (== (. candidate id) (. target id))
        (return index)
      )
      (+= index 1)
    )
  )
  (fn-do + level-id _
    (param index Index)
    (return-if (. ([] levels index) id) (if (< index (. levels length))))
  )
  (fn-do + selected-entry-at (? (of ColumnTreeEntry Item))
    (param index Index)
    (return-if (if (>= index (. levels length))))
    (return (. ([] levels index) selected-entry))
  )
  (fn-do + selected-item-at (? Item)
    (param index Index)
    (let entry (call selected-entry-at index))
    (return-if (if (not entry)))
    (return (. entry item))
  )
)

(type _ ColumnTreeViewportRetention
  (prop + width Length (= 0))
  (blank)
  (prop _ slots _ (= (call (of List Length))))
  (fn-do + retain _
    (param widths (list Length))
    (for (in slot widths)
      (+= slots slot)
      (+= width slot)
    )
  )
  (fn-do + consume _
    (return-if (if (not slots)))
    (blank)
    (-= width ([] slots (- (. slots length) 1)))
    (call (. slots remove) (- (. slots length) 1))
  )
  (fn-do + release _
    (call (. slots clear))
    (= width 0)
  )
  (fn-do + release-if-unscrolled _
    (param scroll-x Length)
    (if (== scroll-x 0)
      (call release)
    )
  )
)

(fn-do _ (of column-tree-no-children Item) (? (list Item))
  (param item Item)
)

(fn-do _ (of column-tree-level-column Item) _
  (param live-columns (list (of ColumnTreeColumn Item)))
  (param levels (list (of ColumnTreeLevel Item)))
  (param index Index)
  (param level-id (? String))
  (return-if (if (>= index (. levels length))))
  (blank)
  (let current-id (. ([] levels index) id))
  (return-if (if (and (!= level-id null) (!= level-id current-id))))
  (blank)
  (for (in column live-columns)
    (if (== (?. (. column level) id) current-id)
      (return column)
    )
  )
)

(fn-do _ (of column-tree-level-selected-index Item) (? Index)
  (param level (? (of ColumnTreeLevel Item)))
  (return-if (if (or (not level) (< (. level selected-index) 0))))
  (return (as (. level selected-index) Index))
)

(fn-do _ (of column-tree-selected-item-from Item) (? Item)
  (param active-index Index)
  (param levels (list (of ColumnTreeLevel Item)))
  (return-if (if (>= active-index (. levels length))))
  (blank)
  (let entry (. ([] levels active-index) selected-entry))
  (return-if (if (not entry)))
  (return (. entry item))
)

(fn-do _ (of column-tree-selected-items-from Item) (list Item)
  (param levels (list (of ColumnTreeLevel Item)))
  (let items (list Item) (call (of List Item)))
  (let index (. levels length))
  (while (> index 0)
    (-= index 1)
    (let level ([] levels index))
    (if (. level selected-entry)
      (for (in entry (. level entries))
        (if (call (. level is-key-selected) (. entry key))
          (+= items (. entry item))
        )
      )
      (return items)
    )
  )
  (return items)
)

(fn-do _ (of column-tree-kept-selection Item) (list String)
  (param keys (list String))
  (param entries (list (of ColumnTreeEntry Item)))
  (let kept (list String))
  (for (in key keys)
    (if (!= (call (of column-tree-index-of-key Item) entries key) null)
      (+= kept key)
    )
  )
  (return-if (call (of List String)) (if (< (. kept length) 2)))
  (return kept)
)

(fn-do _ (of column-tree-owners-from Item) (list Item)
  (param levels (list (of ColumnTreeLevel Item)))
  (let owners (list Item) (call (of List Item)))
  (for (in level levels)
    (+= owners (. level owner))
  )
  (return owners)
)

(fn-do _ (of column-tree-detail-item-from Item) (? Item)
  (param levels (list (of ColumnTreeLevel Item)))
  (param provider (of ColumnTreeChildProvider Item))
  (param revision Size)
  (param cache (of Map String Bool))
  (param predicate (? (of ColumnTreeItemPredicate Item)))
  (let index (. levels length))
  (while (> index 0)
    (-= index 1)
    (let entry (. ([] levels index) selected-entry))
    (if entry
      (return-if null (if (or (. ([] levels index) is-multiple) (call (of column-tree-entry-has-children Item) entry provider cache predicate))))
      (return (. entry item))
    )
  )
  (return null)
)

(fn-expr _ (of column-tree-can-enter-from Item) Bool
  (param index Index)
  (param levels (list (of ColumnTreeLevel Item)))
  (param provider (of ColumnTreeChildProvider Item))
  (param revision Size)
  (param cache (of Map String Bool))
  (param predicate (? (of ColumnTreeItemPredicate Item)))
  (case? (>= index (. levels length))
    (> (. levels length) 0)
  )
  (case? (. ([] levels index) is-multiple)
    false
  )
  (case? (< (+ index 1) (. levels length))
    true
  )
  (default
    (if-expr entry (call (of column-tree-entry-has-children Item) entry provider cache predicate) false)
  )
  (where
    (lazy entry (. ([] levels index) selected-entry))
  )
)

(fn-do _ (of column-tree-entry-has-children Item) Bool
  (param entry (of ColumnTreeEntry Item))
  (param provider (of ColumnTreeChildProvider Item))
  (param cache (of Map String Bool))
  (param predicate (? (of ColumnTreeItemPredicate Item)))
  (if predicate
    (return (call predicate (. entry item)))
  )
  (let cached ([] cache (. entry key)))
  (return-if cached (if (!= cached null)))
  (blank)
  (let children (call provider (. entry item)))
  (let found (and (!= children null) (> (. children length) 0)))
  (= ([] cache (. entry key)) found)
  (return found)
)

(fn-do _ (of column-tree-index-of-key Item) (? Index)
  (param entries (list (of ColumnTreeEntry Item)))
  (param key (? String))
  (return-if (if (not key)))
  (blank)
  (let index Index 0)
  (for (in entry entries)
    (return-if index (if (== (. entry key) key)))
    (blank)
    (+= index 1)
  )
)

(fn-do _ (of column-tree-entries-match Item) Bool
  (param current (list (of ColumnTreeEntry Item)))
  (param next (list (of ColumnTreeEntry Item)))
  (return-if false (if (!= (. current length) (. next length))))
  (blank)
  (let index Index 0)
  (while (< index (. current length))
    (let a ([] current index))
    (let b ([] next index))
    (return-if false (if (or (!= (. a key) (. b key)) (not (== (. a item) (. b item))))))
    (blank)
    (+= index 1)
  )
  (return true)
)
