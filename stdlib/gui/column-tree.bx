  )
  (fn-do + unmounted _
    (= is-live false)
    (call (. super unmounted))
  )
  (fn-expr + entries (list (of ColumnTreeEntry Item)) :get
    (?? (?. level entries) (call (of List (of ColumnTreeEntry Item))))
  )
  (fn-expr + selected-item (? Item) :get
    (?. (?. level selected-entry) item)
  )
  (fn-do + row-for-key (? (of ColumnTreeItem Item))
    (param key (? String))
    (return-if (if (or (not key) (not is-live))))
    (blank)
    (let live-key key)
    (for (in index (..< 0 (. rows pool-size)))
      (let row (call pool-row index))
      (return-if row (if (and row (== (?. (. row entry) key) live-key))))
    )
    (return null)
  )
  (fn-expr + row-index-at Index
    (param point Point)
    (as (call floor (/ (call max 0 (+ (- (. local y) top) (. rows scroll-y))) (. rows row-extent))) Index)
    (where
      (lazy local (call (. rows point-in-box) point))
      (lazy top (- (. rows content-bounds y) (. rows bounds y)))
    )
  )
  (fn-do + refresh-rows _
    (return-if (if (not is-live)))
    (blank)
    (for (in index (..< 0 (. rows pool-size)))
      (let row (call pool-row index))
      (if row
        (call sync-row row)
      )
    )
  )
  (fn-do + sync-row _
    (param row (of ColumnTreeItem Item))
    (let model level)
    (let owner tree)
    (let entry (. row entry))
    (let selected false)
    (let targeted false)
    (let dragged false)
    (let parent false)
    (if (and entry model owner)
      (= selected (call (. model is-key-selected) (. entry key)))
      (= targeted (and (== (. entry key) (. owner drop-key)) (== (. model id) (. owner drop-level-id))))
      (= dragged (call (. owner is-dragged-key) (. entry key)))
      (= parent (call (. owner has-children-of) entry))
    )
    (if (!= (. row is-selected) selected)
      (= (. row is-selected) selected)
    )
    (if (!= (. row is-drop-target) targeted)
      (= (. row is-drop-target) targeted)
    )
    (if (!= (. row is-dragged) dragged)
      (= (. row is-dragged) dragged)
    )
    (if (!= (. row has-children) parent)
      (= (. row has-children) parent)
    )
  )
  (fn-do _ sync-level _
    (let model level)
    (return-if (if (not model)))
    (blank)
    (if (!= (. model entries-id) shown-entries-id)
      (= shown-entries-id (. model entries-id))
      (call (. entry-source replace) (. model entries))
    )
    (call refresh-rows)
    (let key (. model selected-key))
    (let keys (. model selected-keys))
    (if (or (!= key selected-key) (!= keys selected-keys))
      (= selected-key key)
      (= selected-keys keys)
    )
    (if (!= key shown-selected-key)
      (= shown-selected-key key)
      (call request-reveal)
    )
  )
  (fn-do _ selection-owner-for-update _
    (if tree
      (return tree)
    )
    (blank)
    (let owner selection-owner)
    (if (and owner (== (. owner active-column) this))
      (return owner)
    )
  )
  (fn-do _ pool-row (? (of ColumnTreeItem Item))
    (param index Index)
    (let root (call (. rows root-at) index))
    (return-if (if (or (not root) (not (. root slot is-bound)))))
    (return
      (match? (. root %first-child)
        (case (: row (of ColumnTreeItem Item))
          row
        )
      )
    )
  )
  (fn-do _ request-reveal _
    (= reveal-pending true)
    (if is-live
      (call (. rows invalidate-bindings))
    )
  )
  (fn-do _ reveal-index _
    (param index (? Index))
    (return-if (if (or (== index null) (not is-live))))
    (blank)
    (let ignored (call (. rows scroll-to-address) index (. ScrollAlignment nearest)))
  )
)

(type + (of ColumnTreeItem Item) (is ListItem)
  (prop + column (? (of ColumnTreeColumn Item)))
  (prop + entry (? (of ColumnTreeEntry Item)))
  (prop + item (? Item) (= (?. #entry item)))
  (prop + is-drop-target _ (= false))
  (prop + is-dragged _ (= false))
  (blank)
  (rule This (• flex-row))
  (whenever-rule #entry
    (call (?. column sync-row) this)
  )
  (fn-do + mounted _
    (call (. super mounted))
    (call (?. column sync-row) this)
  )
)

(type + ColumnTreeDetail (is Box))

(type + ColumnTreeColumnSpace (is Box)
  (prop + span Length (= 0))
  (blank)
  (rule This
    (= min-width (call (. SizeSpec coord) span))
    (= max-width (call (. SizeSpec coord) span))
  )
)

(type + (of ColumnTreeChildProvider ColumnItem) (is (fn-type (? (list ColumnItem)) (param item ColumnItem))))

(type + (of ColumnTreeItemPredicate ColumnItem) (is (fn-type Bool (param item ColumnItem))))

(type + (of ColumnTreeDropPredicate ColumnItem) (is (fn-type Bool (param drop (of ColumnTreeDrop ColumnItem)))))

(type + (of ColumnTreeDrag Item) (is Tuple)
  (implements DragPayload)
  (prop + tree (of ColumnTree Item))
  (prop + items (list Item))
  (fn-expr + drag-kind _ :get
    "column-tree.rows"
  )
)

(type + (of ColumnTreeDrop Item) (is Tuple)
  (prop + items (list Item))
  (prop + parent Item)
  (prop + source (of ColumnTree Item))
)

(type _ (of ColumnTreePlacement Item) (is Tuple)
  (prop + key (? String))
  (prop + level-id String)
  (prop + drop (of ColumnTreeDrop Item))
)

(type + (of ColumnTreeEntry Item)
  (prop + item Item)
  (prop + key String)
  (fn-do + This _
    (param item _)
    (param key _)
  )
)

(type _ ColumnFocusRequest (is Tuple)
  (prop + index Index)
  (prop + level-id String)
)

(type _ ColumnScrollRequest (is Tuple)
  (prop + index Index)
  (prop + level-id String)
)

(type _ (of ColumnTreeLevel Item)
  (prop + id String)
  (prop + owner Item)
  (prop + owner-key String)
  (prop + entries (list (of ColumnTreeEntry Item)))
  (prop + entries-id Size)
  (prop + selected-index Int (= -1))
  (prop + selection (list String))
  (fn-do + This _
    (param id _)
    (param owner _)
    (param owner-key _)
    (param entries _)
    (param entries-id _)
    (param selected-index _ (= -1))
    (param selection (list String) (= (call (of List String))))
  )
  (fn-do + selected-entry (? (of ColumnTreeEntry Item)) :get
    (return-if (if (< selected-index 0)))
    (blank)
    (let index (as selected-index Index))
    (return-if ([] entries index) (if (< index (. entries length))))
  )
  (fn-expr + selected-key (? String) :get
    (?. selected-entry key)
  )
  (fn-expr + is-multiple Bool :get
    (> (. selection length) 1)
  )
  (fn-expr + selected-keys (list String) :get
    (case? is-multiple
      selection
    )
    (case? key
      (list key)
    )
    (default
      (call (of List String))
    )
    (where
      (lazy key selected-key)
    )
  )
  (fn-expr + is-key-selected Bool
    (param key String)
    (if-expr is-multiple (has selection key) (== key selected-key))
  )
)

(type _ (of ColumnTreePath Item)
  (prop + levels (list (of ColumnTreeLevel Item)))
  (prop + active-index Index)
  (blank)
  (prop _ next-level-id Size)
  (prop _ next-entries-id Size)
  (fn-do + clear _
    (= levels (call (of List (of ColumnTreeLevel Item))))
    (= active-index 0)
  )
  (fn-do + focus _
    (param index Index)
    (return-if (if (>= index (. levels length))))
    (blank)
    (= active-index index)
    (return true)
  )
  (fn-do + append _
    (param owner Item)
    (param owner-key String)
    (param entries (list (of ColumnTreeEntry Item)))
    (param selected-index Int (= -1))
    (+= next-level-id 1)
    (+= next-entries-id 1)
    (let next-levels (call (of List (of ColumnTreeLevel Item)) levels))
    (+= next-levels
      (call (of ColumnTreeLevel Item)
        (block
          (arg (str next-level-id))
          (arg owner)
          (arg owner-key)
          (arg entries)
          (arg next-entries-id)
          (arg selected-index)
        )
      )
    )
    (= levels next-levels)
  )
  (fn-do + replace _
    (param index Index)
    (param owner Item)
    (param owner-key String)
    (param entries (list (of ColumnTreeEntry Item)))
    (param selected-index Int)
    (param selection (list String) (= (call (of List String))))
    (return-if (if (>= index (. levels length))))
    (blank)
    (+= next-entries-id 1)
    (let next-levels (call (of List (of ColumnTreeLevel Item)) levels))
    (= ([] next-levels index)
      (call (of ColumnTreeLevel Item)
        (block
          (arg (. ([] levels index) id))
          (arg owner)
          (arg owner-key)
          (arg entries)
          (arg next-entries-id)
          (arg selected-index)
          (arg selection)
        )
      )
    )
    (= levels next-levels)
  )
  (fn-do + truncate-after Size
    (param index Index)
    (let before-count (. levels length))
    (let next-count (+ index 1))
    (return-if 0 (if (<= before-count next-count)))
