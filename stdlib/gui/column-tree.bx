      (return)
    )
    (call (. super activate-selection))
  )
  (fn-expr + can-choose Bool
    (param key String)
    (if-expr (and owner (!= index null)) (not (call (. owner has-children-of) ([] entries index))) true)
    (where
      (lazy owner tree)
      (lazy index (call (of column-tree-index-of-key Item) entries key))
    )
  )
  (fn-do + ensure-selection _
    (call refresh-rows)
    (call request-reveal)
  )
  (fn-expr + selection-order (list String)
    (spread entries)
    (pipe *> (. each key))
  )
  (fn-do + key-of-row (? String)
    (param row (? ListItem))
    (return-if (if (or (not row) (not (is row (of ColumnTreeItem Item))))))
    (return (?. (. (as row (of ColumnTreeItem Item)) entry) key))
  )
  (fn-do + reveal-key _
    (param key String)
    (call request-reveal)
  )
  (fn-do + show-selection _
    (call refresh-rows)
  )
  (fn-do + rows-changed _)
  (fn-expr + selected-index _ :get
    (call (of column-tree-level-selected-index Item) level)
  )
  (fn-do + select-index _
    (param index (? Index))
    (let owner (call selection-owner-for-update))
    (return-if (if (not owner)))
    (blank)
    (let row-index -1)
    (if (!= index null)
      (= row-index index)
    )
    (call (. owner select-row-at-index) row-index this)
  )
  (fn-do + mounted _
    (call (. super mounted))
    (= is-live true)
