      (call scroll-to (call Point 0 scroll-y))
    )
  )
  (fn-do _ entries-of (? (list (of ColumnTreeEntry Item)))
    (param owner Item)
    (param owner-key String)
    (let items (call load-children owner))
    (= ([] has-children-cache owner-key) (and (!= items null) (> (. items length) 0)))
    (return-if (if (== items null)))
    (return-if (if (== (. items length) 0)))
    (blank)
    (let entries (list (of ColumnTreeEntry Item)) (call (of List (of ColumnTreeEntry Item))))
    (let index Index 0)
    (for (in item items)
      (+= entries (call (of ColumnTreeEntry Item) item (call key-for-item item owner-key index)))
      (+= index 1)
    )
    (return entries)
  )
  (fn-expr + selected-item-at _
    (param index Index)
    (call (. path selected-item-at) index)
  )
  (fn-expr _ key-for-item String
    (param item Item)
    (param key-prefix String)
    (param index Index)
    (case? builder
      (call builder item)
    )
    (case? key-prefix
      (str key-prefix "/" index)
    )
    (default
      (str index)
    )
    (where
      (lazy builder key-builder)
    )
  )
  (fn-do _ publish-active-column-changed _
    (<- active-column-changed (call ActivateEvent))
  )
  (fn-do _ publish-selection _
    (<- selection-changed (call SelectEvent))
  )
)

(type + (of ColumnTreeColumn Item) (is ListBox)
  (prop + is-drop-column _ (= false))
  (prop + entry-source _ (:= (call (of VirtualListSource (of ColumnTreeEntry Item)))))
  (blank)
  (prop _ tree (? (of ColumnTree Item)))
  (prop _ level (? (of ColumnTreeLevel Item)))
  (prop _ selection-owner (? (of ColumnTree Item)))
  (prop _ shown-entries-id Size (= 0))
  (prop _ shown-selected-key (? String))
  (prop _ range-anchor (? String))
  (prop _ is-live _ (= false))
  (prop _ reveal-pending _ (= false))
  (blank)
  (rule This (• flex-col)
    (= overflow-y (. ScrollOverflow visible))
  )
  (fn-do + This _
    (= (. entry-source identity) (=> (entry) (as (call hash-for (. entry key)) U64)))
  )
  (content
    (<> This
      (<> (of VirtualRegion (of ColumnTreeEntry Item)) (id: rows) (• flex 1)
        (= source entry-source)
        (= virtual-layout (call VerticalRowLayout))
        (= overscan-rows column-tree-overscan-rows)
        (blank)
        (<> (of ColumnTreeItem Item) (id: column-row) (slot: row) (param: slot)
          (= column this)
          (= entry (. slot #item))
          (blank)
          (+<> Box (id: row) (param: column-row (of ColumnTreeItem Item)) (• flex-row) (• flex 1))
        )
      )
    )
  )
  (whenever-rule #level
    (call sync-level)
  )
  (subscribe-for (on event drag-start)
    (call (?. tree begin-row-drag) this event)
  )
  (subscribe-for (on event drag-over)
    (call (?. tree drag-over-column) this event)
  )
  (subscribe-for (on event drag-leave (when arrival))
    (call (?. tree clear-placement))
  )
  (subscribe-for (on event drop (when arrival))
    (call (?. tree finish-drop))
  )
  (subscribe-for (on event drag-end (when arrival))
    (let owner (?? tree selection-owner))
    (call (?. owner end-row-drag))
  )
  (fn-do + did-layout _
    (call (. super did-layout))
    (return-if (if (not reveal-pending)))
    (blank)
    (= reveal-pending false)
    (call reveal-index selected-index)
  )
  (fn-expr + page-row-step _ :get
    (case? (< rows-per-page 1)
      1
    )
    (default
      rows-per-page
    )
    (where
      (lazy rows-per-page (as (call floor (/ (. page content-bounds height) (. rows row-extent))) Int))
      (lazy page (?? (call (. rows nearest-scroll-container) (. Orientation vertical)) rows))
    )
  )
  (fn-do + select-key _
    (param key (? String))
    (param extends _ (= false))
    (param toggles _ (= false))
    (let owner tree)
    (if (or (not owner) (not key) (!= selection-mode (. SelectionMode multiple)) (and (not extends) (not toggles)))
      (= range-anchor key)
      (call select-index (call (of column-tree-index-of-key Item) entries key))
      (return)
    )
    (let held range-anchor)
    (let anchor (if-expr (and held (has selected-keys held)) held selected-key))
    (let keys
      (call selection-after-press
        (block
          (arg selection-mode)
          (arg selected-keys)
          (arg key)
          (arg (call selection-order))
          (arg anchor)
          (arg extends)
          (arg toggles)
        )
      )
    )
    (= range-anchor (if-expr (and extends anchor) anchor key))
    (call (. owner select-rows) keys key this)
  )
  (fn-do + select-all _
    (let owner tree)
    (return-if (if (or (not owner) (!= selection-mode (. SelectionMode multiple)))))
    (blank)
    (let order (call selection-order))
    (return-if (if (== (. order length) 0)))
    (blank)
    (call (. owner select-rows) order (?? selected-key ([] order 0)) this)
  )
  (fn-do + activate-selection _
    (let owner tree)
    (if owner
