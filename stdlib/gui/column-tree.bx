(import ./box)
(import ./drag)
(import ./events)
(import ./icons/lucide/chevron-right)
(import ./keys)
(import ./label)
(import ./list-box)
(import ./position)
(import ./primitives)
(import ./shorthands)
(import ./styles)
(import ./theme)
(import ./virtual)
(import ./window)
(import /core/intrinsics)
(import /core/markup)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/style)
(import /math)
(import /ui/input)
(import /ui/selection)
(import /ui/virtual)
(import /ui/virtual-layout)
(import /units)
(blank)
(prop _ column-tree-column-width Length (= 240))
(prop _ column-tree-overscan-rows VirtualCoord (= 3vcoord))

(style-extend GUIDefaultTheme
  (using GUIBoxPaint)
  (using GUIBoxSpacing)
  (using GUIBoxSize)
  (using GUIBoxPlacement)
  (using GUITextPaint)
  (using GUIBoxTransform)
  (using VectorPaintStyle)
  (rule ColumnTree (• bg gui-window-color)
    (rule ListItem
      (when-style #has-children
        (• pr 22)
        (blank)
        (<> LucideChevronRight (slot: after) (• icon) (• absolute) (• w 10) (• h 10)
          (= stroke-width 2)
          (= anchor (. Anchor style-target))
          (= right (call (. PositionOffset coord) 9))
          (= align-y (. Alignment center))
        )
      )
    )
  )
  (blank)
  (rule ColumnTreeColumn (• w column-tree-column-width)
    (= border-color gui-divider-color)
    (= border-right-width 1)
    (blank)
    (when-style #is-drop-column
      (• bg gui-hover-color)
    )
  )
  (blank)
  (rule ColumnTreeItem
    (when-style #is-drop-target
      (• bg gui-accent-color)
      (• text gui-accent-text-color)
    )
    (blank)
    (when-style #is-dragged
      (= opacity 0.4%%)
    )
  )
)

(type + (of ColumnTree Item) (is Box)
  (using GUIVirtualRowStyle)
  (rule This
    (= focus-mode (. FocusMode inside))
    (= window-draggable false)
    (= overflow-x (. ScrollOverflow auto))
  )
  (blank)
  (prop + root-node (? Item))
  (prop + load-children (of ColumnTreeChildProvider Item) (= column-tree-no-children))
  (prop + item-has-children (? (of ColumnTreeItemPredicate Item)))
  (prop + key-builder (? (of MarkupKeyBuilder Item)))
  (prop + active-column (? (of ColumnTreeColumn Item)))
  (prop + selection-mode _ (= (. SelectionMode single)))
  (prop + chooses-on-press _ (= true))
  (prop + selected-item (? Item)
    (=
      (call (of column-tree-selected-item-from Item)
        (block
          (arg (. #path #active-index))
          (arg (. #path #levels))
        )
      )
    )
  )
  (prop + selected-items (list Item) (= (call (of column-tree-selected-items-from Item) (. #path #levels))))
  (prop + detail-item (? Item)
    (=
      (call (of column-tree-detail-item-from Item)
        (block
          (arg (. #path #levels))
          (arg load-children)
          (arg #refresh-count)
          (arg has-children-cache)
          (arg item-has-children)
        )
      )
    )
  )
  (prop + owners (list Item) (= (call (of column-tree-owners-from Item) (. #path #levels))))
  (prop + can-go-back Bool (= (> (. #path #active-index) 0)))
  (prop + can-enter Bool
    (=
      (call (of column-tree-can-enter-from Item)
        (block
          (arg (. #path #active-index))
          (arg (. #path #levels))
          (arg load-children)
          (arg #refresh-count)
          (arg has-children-cache)
          (arg item-has-children)
        )
      )
    )
  )
  (prop + can-drag (? (of ColumnTreeItemPredicate Item)))
  (prop + can-drop (? (of ColumnTreeDropPredicate Item)))
  (prop + drop-key (? String))
  (prop + drop-level-id (? String))
  (blank)
  (event + active-column-changed ActivateEvent)
  (event + selection-changed SelectEvent)
  (event + item-activated ActivateEvent)
  (event + dropped (of ColumnTreeDrop Item))
  (event _ level-mounted Bool)
  (event _ laid-out Bool)
  (event _ path-shortened Bool)
  (event _ focus-requests ColumnFocusRequest)
  (event _ scroll-requests ColumnScrollRequest)
  (blank)
  (prop _ path (of ColumnTreePath Item))
  (prop _ viewport-retention ColumnTreeViewportRetention)
  (prop _ dragged-keys (of Map String Bool) (= (call (of Map String Bool))))
  (prop _ has-children-cache (of Map String Bool) (= (call (of Map String Bool))))
  (prop _ placement (? (of ColumnTreeDrop Item)))
  (prop _ detail-reveal-pending _ (= false))
  (prop _ refresh-count Size (= 0))
  (prop _ is-previewing _ (= false))
  (prop + column-focus _
    (machine
      (state settled)
      (state (call waiting-for-level i id) (trigger for (tuple i id) focus-requests)
        (blank)
        (then (call applying i id) (trigger if (!= (call requested-column i id) null)))
        (blank)
        (then (call applying i id) (trigger on level-mounted (!= (call requested-column i id) null)))
        (blank)
        (then settled (trigger on path-shortened (!= (call (. path level-id) i) id)))
      )
      (blank)
      (state (call applying i id)
        (let column (call requested-column i id))
        (if column
          (call (. column request-focus))
          (call ensure-active-column-visible)
          (call publish-active-column-changed)
        )
        (blank)
        (then settled (trigger if true))
      )
    )
  )
  (prop + scroll-into-view _
    (machine
      (state settled)
      (state (call waiting-for-layout i id) (trigger for (tuple i id) scroll-requests)
        (then settled (trigger if (call requested-column-is-laid-out i id))
          (call scroll-requested-column-into-view i id)
        )
        (blank)
        (then settled (trigger on laid-out (call requested-column-is-laid-out i id))
          (call scroll-requested-column-into-view i id)
        )
        (blank)
        (then settled (trigger on path-shortened (!= (call (. path level-id) i) id)))
      )
    )
  )
  (content
    (<> This (• flex-row)
      (if #can-go-back
        (<> KeyShortcut (text: "Back")
          (= key .arrow-left)
          (= action (=> () :do (call back)))
        )
      )
      (blank)
      (if #can-enter
        (<> KeyShortcut (text: "Open")
          (= key .arrow-right)
          (= action (=> () :do (call enter)))
        )
      )
      (blank)
      (for (in level (. #path #levels) (keyed-by (. level id)))
        (<> (of ColumnTreeColumn Item)
          (= tree this)
          (= level level)
          (= selection-mode #selection-mode)
          (= chooses-on-press #chooses-on-press)
          (= is-drop-column (and (== #drop-key null) (== #drop-level-id (. level id))))
          (blank)
          (<> Box (slot: row) (param: column-row) (• flex-row) (• flex 1)
            (+<> Box (id: row) (param: column-row (of ColumnTreeItem Item)) (• flex-row) (• flex 1))
          )
        )
      )
      (blank)
      (<> ColumnTreeDetail (id: detail-pane) (• flex-col) (• flex 1)
        (= display (if-expr (!= #detail-item null) (. Display visible) (. Display hidden)))
        (blank)
        (+<> Box (id: detail) (• flex-col) (• flex 1))
      )
      (blank)
      (if (> (. #viewport-retention #width) 0)
        (<> ColumnTreeColumnSpace
          (= span (. #viewport-retention #width))
        )
      )
    )
  )
  (whenever-rule #root-node
    (call reload-root)
  )
  (whenever-rule #detail-item
    (return-if (if (== detail-item null)))
    (= detail-reveal-pending true)
    (call invalidate-layout)
  )
  (subscribe-for (on event pointer-down)
    (if (== (. event button) (. PointerButton primary))
      (call clear-selection-at event)
    )
  )
  (fn-do + did-layout _
    (call (. super did-layout))
    (call (. viewport-retention release-if-unscrolled) scroll-x)
    (<- laid-out true)
    (call reveal-detail)
  )
  (fn-do + mounted _
    (call (. super mounted))
    (call reload-root)
    (call project-active-column)
  )
  (fn-expr + columns _ :get
    (call live-columns)
  )
  (fn-expr + active-index Index :get
    (. path active-index)
  )
  (fn-do + select-relative _
    (param direction Direction)
    (let column active-column)
    (if column
      (call (. (!! column) move-selection) (if-expr (== direction (. Direction up)) -1 1))
    )
  )
  (fn-do + enter _
    (param source (? (of ColumnTreeColumn Item)) (= null))
    (let index (. path active-index))
    (if source
      (let source-index (call column-index-of source))
      (return-if (if (== source-index null)))
      (blank)
      (= index source-index)
    )
    (blank)
    (return-if (if (and (< index (. path levels length)) (. ([] (. path levels) index) is-multiple))))
    (blank)
    (let next-index (+ index 1))
    (if (< next-index (. path levels length))
      (if (call (. path ensure-selection) next-index)
        (call publish-selection)
      )
      (call preview-selection next-index)
      (call focus-level next-index)
      (return)
    )
    (blank)
    (return-if (if (not (call append-children-of-selection index 0))))
    (blank)
    (call publish-selection)
    (call preview-selection next-index)
    (call focus-level next-index)
  )
  (fn-do + back _
    (return-if (if (== (. path active-index) 0)))
    (blank)
    (let index (- (. path active-index) 1))
    (call focus-level index)
    (call truncate-path-after-retaining-space index)
    (= is-previewing false)
  )
  (fn-do + activate _
    (param source (of ColumnTreeColumn Item))
    (let index (call column-index-of source))
    (return-if (if (== index null)))
    (blank)
    (let entry (call (. path selected-entry-at) index))
    (return-if (if (not entry)))
    (blank)
    (if (call has-children-of entry)
      (call enter source)
      (else
        (<- item-activated (call ActivateEvent))
      )
    )
  )
  (fn-do + focus-column _
    (param column (? (of ColumnTreeColumn Item)))
    (return-if (if (not column)))
    (blank)
    (let index (call column-index-of (!! column)))
    (if (!= index null)
      (call focus-level (!! index))
    )
  )
  (fn-do + focus-level _
    (param index Index)
    (return-if (if (not (call (. path focus) index))))
    (blank)
    (let id (call (. path level-id) index))
    (return-if (if (not id)))
    (blank)
    (call project-active-column)
    (<- focus-requests (call ColumnFocusRequest index id))
  )
  (fn-do + focus-active _
    (if (. path levels)
      (call focus-level (. path active-index))
    )
  )
  (fn-do + restore-path Bool
    (param keys (list String))
    (if (not keys)
      (call reload-root)
      (return false)
    )
    (blank)
    (let found (call project-key-path keys))
    (if (. path levels)
      (call focus-level (. path active-index))
    )
    (return found)
  )
  (fn-do + select-path Bool
    (param keys (list String))
    (return-if false (if (not keys)))
    (blank)
    (let found (call project-key-path keys))
    (call project-active-column)
    (return found)
  )
  (fn-do + clear-selection _
    (call (?. (call (of column-tree-level-column Item) columns (. path levels) 0 null) select-index) null)
  )
  (fn-do _ project-key-path Bool
    (param keys (list String))
    (let current-root root-node)
    (if (not current-root)
      (call clear-path)
      (return false)
    )
    (blank)
    (let owner Item current-root)
    (let owner-key "")
    (let depth Index 0)
    (while (< depth (. keys length))
      (if (or (>= depth (. path levels length)) (!= (. ([] (. path levels) depth) owner-key) owner-key))
        (if (== depth 0)
          (call clear-path)
          (else
            (let ignored (call truncate-path-after (- depth 1)))
          )
        )
        (let entries (call entries-of owner owner-key))
        (if (not entries)
          (call activate-deepest-level)
          (return false)
        )
        (call (. path append) owner owner-key entries)
      )
      (blank)
      (let level ([] (. path levels) depth))
      (let match-index (call (of column-tree-index-of-key Item) (. level entries) ([] keys depth)))
      (if (== match-index null)
        (let ignored (call truncate-path-after depth))
        (call activate-deepest-level)
        (return false)
      )
      (blank)
      (if (call (. path select) match-index depth)
        (let ignored (call truncate-path-after depth))
      )
      (let entry ([] (. level entries) match-index))
      (= owner (. entry item))
      (= owner-key (. entry key))
      (+= depth 1)
    )
    (blank)
    (let last (- (. keys length) 1))
    (let ignored (call truncate-path-after last))
    (let focused (call (. path focus) last))
    (call publish-selection)
    (call preview-selection last)
    (return true)
  )
  (fn-do + refresh _
    (+= refresh-count 1)
    (call (. has-children-cache clear))
    (let held-focus is-focus-within)
    (let held-active (. path active-index))
    (let current-root root-node)
    (if (or (not current-root) (not (. path levels)))
      (call clear-path)
      (let ignored (call load-root))
      (call project-active-column)
      (return)
    )
    (blank)
    (let owner Item current-root)
    (let owner-key "")
    (let index Index 0)
    (while (< index (. path levels length))
      (let level ([] (. path levels) index))
      (let entries (call entries-of owner owner-key))
      (if (not entries)
        (if (== index 0)
          (call clear-path)
          (else
            (let ignored (call truncate-path-after (- index 1)))
          )
        )
        (break)
      )
      (blank)
      (let found (call (of column-tree-index-of-key Item) entries (. level selected-key)))
      (let lost (and (>= (. level selected-index) 0) (== found null)))
      (let selected -1)
      (if (!= found null)
        (= selected found)
        (else-if (and lost (<= index (. path active-index)))
          (= selected (call min (. level selected-index) (- (as (. entries length) Int) 1)))
        )
      )
      (let kept
        (scope (if-expr lost (call (of List String)) kept-selection)
          (lazy kept-selection (call (of column-tree-kept-selection Item) (. level selection) entries))
        )
      )
      (if (or (!= selected (. level selected-index)) (!= kept (. level selection)) entries-differ)
        (call (. path replace) index owner owner-key entries selected kept)
      )
      (lazy entries-differ (not (call (of column-tree-entries-match Item) (. level entries) entries)))
      (if lost
        (let ignored (call truncate-path-after index))
        (call publish-selection)
        (if (>= selected 0)
          (call preview-selection index)
        )
        (break)
      )
      (if (< selected 0)
        (break)
      )
      (blank)
      (let entry ([] entries selected))
      (= owner (. entry item))
      (= owner-key (. entry key))
      (+= index 1)
    )
    (blank)
    (if is-previewing
      (call append-missing-preview)
    )
    (call project-active-column)
    (call refresh-rows)
    (if (and held-focus (. path levels) (!= (. path active-index) held-active))
      (call focus-level (. path active-index))
    )
  )
  (fn-do + row-for-key (? (of ColumnTreeItem Item))
    (param key (? String))
    (for (in column columns)
      (let row (call (. column row-for-key) key))
      (return-if row (if row))
    )
    (return null)
  )
  (fn-expr + column-at (? (of ColumnTreeColumn Item))
    (param event GUIEvent)
    (of (?. (. event hit-box) ancestor-or-self) (of ColumnTreeColumn Item))
  )
  (fn-do + item-at (? Item)
    (param event GUIEvent)
    (let column (call column-at event))
    (return-if (if (not column)))
    (blank)
    (let row (call (. column row-at) event))
    (return-if (if (or (not row) (not (is row (of ColumnTreeItem Item))))))
    (return (. (as row (of ColumnTreeItem Item)) item))
  )
  (fn-do + owner-at (? Item)
    (param event GUIEvent)
    (let column (call column-at event))
    (return-if (if (not column)))
    (return (?. (. column level) owner))
  )
  (fn-expr + has-children-of Bool
    (param entry (of ColumnTreeEntry Item))
    (call (of column-tree-entry-has-children Item) entry load-children has-children-cache item-has-children)
  )
  (fn-expr + is-dragged-key Bool
    (param key String)
    (has dragged-keys key)
  )
  (fn-do + begin-row-drag _
    (param column (of ColumnTreeColumn Item))
    (param event DragStartEvent)
    (let row (call (. column row-at) event))
    (let allows can-drag)
    (return-if (if (or (not row) (not allows) (not (is row (of ColumnTreeItem Item))))))
    (blank)
    (let entry (. (as row (of ColumnTreeItem Item)) entry))
    (return-if (if (or (not entry) (not (call allows (. entry item))))))
    (blank)
    (call (. event begin) (call (of ColumnTreeDrag Item) this (list (. entry item))) row)
    (= ([] dragged-keys (. entry key)) true)
    (call refresh-rows)
  )
  (fn-do + drag-over-column _
    (param column (of ColumnTreeColumn Item))
    (param event DragOverEvent)
    (return-if (if (not (is (. event payload) (of ColumnTreeDrag Item)))))
    (blank)
    (let next (call placement-at column (as (. event payload) (of ColumnTreeDrag Item)) (. event root-point)))
    (call show-placement next)
    (if next
      (call (. event accept) (?? (call (. column rows nearest-scroll-container) (. Orientation vertical)) (. column rows)))
    )
  )
  (fn-do + clear-placement _
    (call show-placement null)
  )
  (fn-do + finish-drop _
    (let landed placement)
    (call show-placement null)
    (if landed
      (<- dropped landed)
    )
  )
  (fn-do + end-row-drag _
    (call (. dragged-keys clear))
    (call show-placement null)
    (call refresh-rows)
  )
  (fn-expr _ placement-at (? (of ColumnTreePlacement Item))
    (param column (of ColumnTreeColumn Item))
    (param drag (of ColumnTreeDrag Item))
    (param point Point)
    (match (. column level)
      (case= null
        null
      )
      (case (: model (of ColumnTreeLevel Item))
        (case? (or (not can-drop) (== index null) (call is-carried-level index))
          null
        )
        (case? (and is-on-row (has dragged-keys (. entry key)))
          null
        )
        (case? (and is-on-row (call allows-drop inside))
          (call (of ColumnTreePlacement Item) (. entry key) (. model id) inside)
        )
        (case? (call allows-drop landing)
          (call (of ColumnTreePlacement Item) null (. model id) landing)
        )
        (default
          null
        )
        (blank)
        (lazy index (call (. path index-of) model))
        (lazy row (call (. column row-index-at) point))
        (lazy is-on-row (< row (. model entries length)))
        (lazy entry ([] (. model entries) row))
        (lazy inside (call (of ColumnTreeDrop Item) (. drag items) (. entry item) (. drag tree)))
        (lazy landing (call (of ColumnTreeDrop Item) (. drag items) (. model owner) (. drag tree)))
      )
    )
  )
  (fn-do _ is-carried-level Bool
    (param index Index)
    (let cursor Index 0)
    (while (and (< cursor index) (< cursor (. path levels length)))
      (let key (. ([] (. path levels) cursor) selected-key))
      (return-if true (if (and key (has dragged-keys key))))
      (blank)
      (+= cursor 1)
    )
    (return false)
  )
  (fn-expr _ allows-drop _
    (param drop (of ColumnTreeDrop Item))
    (case? checks
      (call checks drop)
    )
    (default
      false
    )
    (where
      (lazy checks can-drop)
    )
  )
  (fn-do _ show-placement _
    (param next (? (of ColumnTreePlacement Item)))
    (= placement (?. next drop))
    (let key (?. next key))
    (let level-id (?. next level-id))
    (return-if (if (and (== key drop-key) (== level-id drop-level-id))))
    (blank)
    (= drop-key key)
    (= drop-level-id level-id)
    (call refresh-rows)
  )
  (fn-do _ refresh-rows _
    (for (in column columns)
      (call (. column refresh-rows))
    )
  )
  (fn-do _ reveal-detail _
    (return-if (if (not detail-reveal-pending)))
    (blank)
    (= detail-reveal-pending false)
    (return-if (if (or (== detail-item null) (<= (. detail-pane bounds width) 0))))
    (blank)
    (call scroll-bounds-visible (. detail-pane bounds))
    (let column active-column)
    (if column
      (call scroll-bounds-visible (. column bounds))
    )
  )
  (fn-do _ activate-deepest-level _
    (if (. path levels)
      (let focused (call (. path focus) (- (. path levels length) 1)))
    )
  )
  (fn-do _ append-missing-preview _
    (let count (. path levels length))
    (return-if (if (== count 0)))
    (return-if (if (or (< (. ([] (. path levels) (- count 1)) selected-index) 0) (. ([] (. path levels) (- count 1)) is-multiple))))
    (blank)
    (let ignored (call append-children-of-selection (- count 1) -1))
  )
  (fn-do _ preview-selection _
    (param index Index)
    (return-if (if (and (< index (. path levels length)) (. ([] (. path levels) index) is-multiple))))
    (blank)
    (= is-previewing true)
    (let next-index (+ index 1))
    (if (< next-index (. path levels length))
      (call request-level-scroll next-index)
      (return)
    )
    (let selected-index (if-expr (== next-index (. path active-index)) 0 -1))
    (if (not (call append-children-of-selection index selected-index))
      (let ignored (call truncate-path-after index))
      (return)
    )
    (if (>= selected-index 0)
      (call publish-selection)
    )
    (call (. viewport-retention consume))
    (call request-level-scroll next-index)
  )
  (fn-do _ append-children-of-selection Bool
    (param index Index)
    (param selected-index Int)
    (let entry (call (. path selected-entry-at) index))
    (return-if false (if (not entry)))
    (blank)
    (let entries (call entries-of (. entry item) (. entry key)))
    (return-if false (if (not entries)))
    (blank)
    (let ignored (call truncate-path-after index))
    (call (. path append) (. entry item) (. entry key) entries selected-index)
    (return true)
  )
  (fn-do _ request-level-scroll _
    (param index Index)
    (let id (call (. path level-id) index))
    (if id
      (<- scroll-requests (call ColumnScrollRequest index id))
    )
  )
  (fn-do _ truncate-path-after-retaining-space _
    (param index Index)
    (let widths (call (of List Length)))
    (for (in position (..< (+ index 1) (. path levels length)))
      (let column (call (of column-tree-level-column Item) columns (. path levels) position null))
      (if column
        (+= widths (. column bounds width))
      )
    )
    (let removed-count (call truncate-path-after index))
    (if (and (> removed-count 0) (> scroll-x 0))
      (call (. viewport-retention retain) widths)
    )
  )
  (fn-do _ truncate-path-after _
    (param index Index)
    (let removed-count (call (. path truncate-after) index))
    (if (not (. path levels))
      (call (. viewport-retention release))
    )
    (<- path-shortened true)
    (return removed-count)
  )
  (fn-do + select-row-at-index _
    (param row-index Int)
    (param column (of ColumnTreeColumn Item))
    (let maybe-index (call column-index-of column))
    (return-if (if (== maybe-index null)))
    (blank)
    (let index maybe-index)
    (return-if (if (>= index (. path levels length))))
    (blank)
    (let changed (call (. path select) row-index index))
    (blank)
    (if (!= index (. path active-index))
      (call focus-level index)
    )
    (blank)
    (if changed
      (call truncate-path-after-retaining-space index)
      (call publish-selection)
    )
    (blank)
    (call preview-selection index)
  )
  (fn-do + select-rows _
    (param keys (list String))
    (param key String)
    (param column (of ColumnTreeColumn Item))
    (let maybe-index (call column-index-of column))
    (return-if (if (== maybe-index null)))
    (blank)
    (let index maybe-index)
    (return-if (if (>= index (. path levels length))))
    (blank)
    (let entries (. ([] (. path levels) index) entries))
    (if (< (. keys length) 2)
      (let only (call (of column-tree-index-of-key Item) entries (only-if ([] keys 0) (if (== (. keys length) 1)))))
      (call select-row-at-index (if-expr (!= only null) (as only Int) -1) column)
      (return)
    )
    (let focus
      (call (of column-tree-index-of-key Item)
        (block
          (arg entries)
          (arg (if-expr (has keys key) key ([] keys (- (. keys length) 1))))
        )
      )
    )
    (return-if (if (== focus null)))
    (blank)
    (let changed (call (. path select-many) focus keys index))
    (if (!= index (. path active-index))
      (call focus-level index)
    )
    (if changed
      (call truncate-path-after-retaining-space index)
      (= is-previewing false)
      (call publish-selection)
    )
  )
  (fn-do _ clear-selection-at _
    (param event PointerDownEvent)
    (let column (call column-at event))
    (if column
      (if (not (call (. column row-at) event))
        (call (. column select-index) null)
      )
      (return)
    )
    (let hit (. event hit-box))
    (return-if (if (not hit)))
    (return-if (if (and (!= (as hit Pointer) (as this Pointer)) (not (is hit ColumnTreeColumnSpace)))))
    (blank)
    (call clear-selection)
  )
  (fn-do _ column-index-of _
    (param column (of ColumnTreeColumn Item))
    (let target (. column level))
    (return-if (if (not target)))
    (blank)
    (return (call (. path index-of) target))
  )
  (fn-expr _ live-columns _
    (spread active-children)
    (pipe ?*>
      (match? each
        (case (: column (of ColumnTreeColumn Item))
          column
        )
      )
    )
    (pipe |> List)
  )
  (fn-do _ project-active-column _
    (let index (. path active-index))
    (let level-id (call (. path level-id) index))
    (let column (call (of column-tree-level-column Item) columns (. path levels) index level-id))
    (if (!= active-column column)
      (= active-column column)
    )
    (call release-unused-viewport-retention)
  )
  (fn-do + column-mounted _
    (param column (of ColumnTreeColumn Item))
    (call project-active-column)
    (<- level-mounted true)
  )
  (fn-do _ release-unused-viewport-retention _
    (call (. viewport-retention release-if-unscrolled) scroll-x)
  )
  (fn-expr _ requested-column _
    (param index Index)
    (param level-id String)
    (call (of column-tree-level-column Item) columns (. path levels) index level-id)
  )
  (fn-expr _ requested-column-is-laid-out _
    (param index Index)
    (param level-id String)
    (case? column
      (> (. column bounds width) 0)
    )
    (default
      false
    )
    (where
      (lazy column (call requested-column index level-id))
    )
  )
  (fn-do _ scroll-requested-column-into-view _
    (param index Index)
    (param level-id String)
    (let column (call requested-column index level-id))
    (if column
      (call scroll-bounds-visible (. column bounds))
    )
  )
  (fn-do _ ensure-active-column-visible _
    (let column active-column)
    (if (not column)
      (if (!= scroll-x 0)
        (call scroll-to (call Point 0 scroll-y))
      )
      (return)
    )
    (call scroll-bounds-visible (. column bounds))
  )
  (fn-do + reload-root _
    (let held-focus is-focus-within)
    (call clear-path)
    (if (call load-root)
      (if held-focus
        (call focus-level 0)
        (else
          (let ignored (call (. path focus) 0))
        )
      )
    )
    (blank)
    (call project-active-column)
  )
  (fn-do _ load-root Bool
    (let current-root root-node)
    (return-if false (if (not current-root)))
    (blank)
    (let entries (call entries-of current-root ""))
    (return-if false (if (not entries)))
    (blank)
    (call (. path append) current-root "" entries 0)
    (return true)
  )
  (fn-do _ clear-path _
    (= is-previewing false)
    (call (. path clear))
    (call (. has-children-cache clear))
    (<- path-shortened true)
    (call project-active-column)
    (call (. viewport-retention release))
