(import ./box)
(import ./button)
(import ./icon-button)
(import ./icons/lucide/x)
(import ./label)
(import ./placement)
(import ./popup)
(import ./primitives)
(import ./shorthands)
(import ./styles)
(import ./theme)
(import /core/markup)
(import /core/tracker)
(import /graphics/color)
(import /graphics/outline)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/text)
(import /stream/aggregate)
(import /time/duration)
(import /units)
(blank)
(prop _ toast-tick _ (= 100ms))

(style-extend GUIDefaultTheme
  (using GUIBoxMotion)
  (using GUIBoxPaint)
  (using GUIBoxTransform)
  (using GUITextPaint)
  (using GUIFontStyle)
  (using GUIBoxSpacing)
  (using GUIBoxSize)
  (using GUIPopupStyle)
  (rule Toaster (• pt 8) (• px 18) (• pb 22))
  (blank)
  (rule Toast (• bg gui-popup-color) (• text gui-text-color) (• pl 14) (• pr 8) (• py 6) (• mt 8) (• min-w 240) (• max-w 420)
    (= border-color gui-border-color)
    (= border-width 1)
    (= corner-radius gui-popup-radius)
    (= shadow gui-popup-shadow)
    (= motion gui-motion-smooth)
    (= (. motion size) gui-motion-smooth)
    (= leave-space (. LeaveSpace collapse))
    (blank)
    (when-style #is-entering
      (= opacity 0%%)
      (= translate (call Point 32 0))
    )
    (blank)
    (when-style #is-leaving
      (= opacity 0%%)
      (= scale 0.96)
    )
    (blank)
    (when-style #is-hover-within
      (= background-color (call (. gui-hover-color over) gui-popup-color))
    )
    (blank)
    (when-style #is-success
      (= border-color gui-success-color)
    )
    (blank)
    (when-style #is-warning
      (= border-color gui-warning-color)
    )
    (blank)
    (when-style #is-error
      (= border-color gui-danger-color)
    )
    (blank)
    (rule toast-label (• my 3)
      (= text-wrap (. TextWrap word))
    )
    (blank)
    (rule toast-action (• h 22) (• px 8) (• ml 8))
    (blank)
    (rule toast-close (• w 22) (• h 22) (• ml 4))
  )
)

(type + ToastSeverity (is Union)
  (variant info)
  (variant success)
  (variant warning)
  (variant error)
)

(type + ToastLifetime (is Union)
  (variant standard)
  (variant sticky)
  (variant timed Seconds)
)

(type + ToastMessage (is Tuple)
  (prop + id U64)
  (prop + text String)
  (prop + severity ToastSeverity)
  (prop + lifetime (? Seconds))
  (prop + action-title String)
  (prop + action (? Doer))
)

(type + Toaster (is Popup)
  (prop + messages (list ToastMessage))
  (prop + lifetime Seconds (= 3.5s))
  (prop + max-count Size (= 5))
  (blank)
  (prop _ next-id U64)
  (prop _ emptied (? MarkupBatchAction))
  (blank)
  (depends messages-changed messages)
  (blank)
  (rule This (• persistent) (• flex-col)
    (= placement (call CornerPlacement (. Corner bottom-right) 0))
  )
  (content
    (<> This
      (for (in message #messages (keyed-by (. message id)))
        (<> Toast
          (= message message)
        )
      )
    )
  )
  (fn-do + post ToastMessage
    (param text String)
    (param severity _ (= (. ToastSeverity info)))
    (param message-lifetime _ (= (. ToastLifetime standard)))
    (param action-title _ (= ""))
    (param action (? Doer) (= null))
    (+= next-id 1)
    (let life (call toast-lifetime-seconds message-lifetime lifetime))
    (let message (call ToastMessage next-id text severity life action-title action))
    (= messages (call messages-with message))
    (if (not is-open)
      (call show (. PopupAnchor window))
    )
    (if life
      (do-new
        (call expire (. message id) life)
      )
    )
    (return message)
  )
  (fn-do + remove _
    (param id U64)
    (= messages (call messages-without id))
  )
  (fn-do _ messages-changed _
    (return-if (if (!= (. messages length) 0)))
    (let root markup-batch-root)
    (if (not root)
      (call dismiss)
      (return)
    )
    (let action (call ensure-markup-batch-action root (. this dismiss-if-empty) emptied))
    (= emptied action)
    (call action)
  )
  (fn-do _ dismiss-if-empty (list Tracker)
    (if (== (. messages length) 0)
      (call dismiss)
    )
    (return (call (of List Tracker)))
  )
  (fn-do _ expire _
    (param id U64)
    (param life Seconds)
    (let remaining Nanoseconds life)
    (while (and (> remaining 0ns) (call holds id))
      (call (. toast-tick wait))
      (if (not is-hover-within)
        (-= remaining toast-tick)
      )
    )
    (call remove id)
  )
  (fn-expr _ holds Bool
    (param id U64)
    (call some messages (:where (== (. each id) id)))
  )
  (fn-do _ messages-with (list ToastMessage)
    (param message ToastMessage)
    (let next (call (of List ToastMessage) messages))
    (+= next message)
    (return (if-expr (<= (. next length) max-count) next ([] next (..< (- (. next length) max-count) (. next length)))))
  )
  (fn-expr _ messages-without _
    (param id U64)
    (spread messages)
    (pipe ?> (!= (. each id) id))
    (pipe |> List)
  )
)

(type + Toast (is Box)
  (prop + message ToastMessage)
  (prop + is-success _ (= (== (. #message severity) (. ToastSeverity success))))
  (prop + is-warning _ (= (== (. #message severity) (. ToastSeverity warning))))
  (prop + is-error _ (= (== (. #message severity) (. ToastSeverity error))))
  (blank)
  (prop _ toaster (of Ancestor Toaster))
  (content
    (<> This (• flex-row)
      (<> Label (• toast-label) (• flex 1)
        (= align-y (. Alignment center))
        (= text (. message text))
      )
      (if (. message action-title length)
        (<> Button (• toast-action)
          (= title (. message action-title))
          (= align-y (. Alignment start))
          (= action (=> () :do (call run-action)))
        )
      )
      (<> IconButton (• toast-close) (• icon-x)
        (= align-y (. Alignment start))
        (= action (=> () :do (call (?. toaster remove) (. message id))))
      )
    )
  )
  (subscribe-for (on event click)
    (call (?. toaster remove) (. message id))
    (call (. event cancel))
  )
  (fn-do _ run-action _
    (let callback (. message action))
    (call (?. toaster remove) (. message id))
    (if callback
      (call callback)
    )
  )
)

(fn-expr _ toast-lifetime-seconds (? Seconds)
  (param requested ToastLifetime)
  (param standard Seconds)
  (match requested
    (case (call (. ToastLifetime timed) seconds)
      seconds
    )
    (case (. ToastLifetime sticky)
      null
    )
    (default
      standard
    )
  )
)
