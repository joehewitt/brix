(import ./layout)
(import ./position)
(import ./primitives)
(import ./styles)
(import /graphics/color)
(import /graphics/primitives)

(style GUIShorthandsTheme
  (using GUIBoxPaint)
  (using GUITextPaint)
  (using GUIFontStyle)
  (using GUIParagraphStyle)
  (using GUITextComposition)
  (using GUIBoxDisplay)
  (using GUIBoxPlacement)
  (using GUIBoxSpacing)
  (using GUIBoxSize)
  (using GUIBoxLayout)
  (using GUIBoxScroll)
  (using GUIBoxMotion)
  (rule flex-col
    (= layout (call FlexLayout (. Orientation vertical)))
  )
  (blank)
  (rule flex-row
    (= layout (call FlexLayout (. Orientation horizontal)))
  )
  (blank)
  (rule flow-col
    (= layout (call FlowLayout (. Orientation vertical)))
  )
  (blank)
  (rule flow-row
    (= layout (call FlowLayout (. Orientation horizontal)))
  )
  (blank)
  (rule grid
    (param columns Size)
    (= layout (call GridLayout columns))
  )
  (blank)
  (rule grid-fill
    (param width Length)
    (= layout (call GridLayout (call GridFill width)))
  )
  (blank)
  (rule flex
    (param amount Float)
    (= flex amount)
  )
  (blank)
  (rule shrink
    (param amount Float)
    (= shrink amount)
  )
  (blank)
  (rule items-start
    (= align-children (. Alignment start))
  )
  (blank)
  (rule items-center
    (= align-children (. Alignment center))
  )
  (blank)
  (rule items-end
    (= align-children (. Alignment end))
  )
  (blank)
  (rule items-baseline
    (= align-children (. Alignment first-baseline))
  )
  (blank)
  (rule justify-center
    (= justify (. Justify center))
  )
  (blank)
  (rule justify-end
    (= justify (. Justify end))
  )
  (blank)
  (rule justify-between
    (= justify (. Justify space-between))
  )
  (blank)
  (rule gap
    (param size Length)
    (= gap size)
  )
  (blank)
  (rule absolute
    (= position (call AbsolutePosition))
  )
  (blank)
  (rule sticky
    (= position (call StickyPosition))
  )
  (blank)
  (rule overhang
    (= position (call OverhangPosition))
  )
  (blank)
  (rule bg
    (param value (? RGBA))
    (= background-color value)
  )
  (blank)
  (rule text
    (param value RGBA)
    (= color value)
  )
  (blank)
  (rule m
    (param value Length)
    (= margin-top value)
    (= margin-right value)
    (= margin-bottom value)
    (= margin-left value)
  )
  (blank)
  (rule mx
    (param value Length)
    (= margin-left value)
    (= margin-right value)
  )
  (blank)
  (rule my
    (param value Length)
    (= margin-top value)
    (= margin-bottom value)
  )
  (blank)
  (rule mt
    (param value Length)
    (= margin-top value)
  )
  (blank)
  (rule mr
    (param value Length)
    (= margin-right value)
  )
  (blank)
  (rule mb
    (param value Length)
    (= margin-bottom value)
  )
  (blank)
  (rule ml
    (param value Length)
    (= margin-left value)
  )
  (blank)
  (rule p
    (param value Length)
    (= padding-top value)
    (= padding-right value)
    (= padding-bottom value)
    (= padding-left value)
  )
  (blank)
  (rule px
    (param value Length)
    (= padding-left value)
    (= padding-right value)
  )
  (blank)
  (rule py
    (param value Length)
    (= padding-top value)
    (= padding-bottom value)
  )
  (blank)
  (rule pt
    (param value Length)
    (= padding-top value)
  )
  (blank)
  (rule pr
    (param value Length)
    (= padding-right value)
  )
  (blank)
  (rule pb
    (param value Length)
    (= padding-bottom value)
  )
  (blank)
  (rule pl
    (param value Length)
    (= padding-left value)
  )
  (blank)
  (rule w
    (param size Length)
    (= min-width (call (. SizeSpec coord) size))
    (= max-width (call (. SizeSpec coord) size))
  )
  (blank)
  (rule h
    (param size Length)
    (= min-height (call (. SizeSpec coord) size))
    (= max-height (call (. SizeSpec coord) size))
  )
  (blank)
  (rule min-w
    (param size Length)
    (= min-width (call (. SizeSpec coord) size))
  )
  (blank)
  (rule max-w
    (param size Length)
    (= max-width (call (. SizeSpec coord) size))
  )
  (blank)
  (rule min-h
    (param size Length)
    (= min-height (call (. SizeSpec coord) size))
  )
  (blank)
  (rule max-h
    (param size Length)
    (= max-height (call (. SizeSpec coord) size))
  )
  (blank)
  (rule center
    (param anchor Anchor (= (. Anchor screen)))
    (= anchor anchor)
    (= left (. PositionOffset anchor-center))
    (= top (. PositionOffset anchor-center))
  )
  (blank)
  (rule cover
    (param anchor Anchor (= (. Anchor screen)))
    (= anchor anchor)
    (= left (call (. PositionOffset coord) 0))
    (= top (call (. PositionOffset coord) 0))
    (= right (call (. PositionOffset coord) 0))
    (= bottom (call (. PositionOffset coord) 0))
  )
  (blank)
  (rule inset
    (param value PositionOffset)
    (= left value)
    (= top value)
    (= right value)
    (= bottom value)
  )
  (blank)
  (rule inset
    (param pos (tuple (: x PositionOffset) (: y PositionOffset)))
    (= left (. pos x))
    (= top (. pos y))
    (= right (. pos x))
    (= bottom (. pos y))
  )
)
