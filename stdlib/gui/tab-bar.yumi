────────────────────
+ do dismiss

dismissed <- this

────────────────────
+ do begin-rename

rename-requested <- true

────────────────────
+ do commit-rename
    - next String

rename-committed <- next

────────────────────
+ do cancel-rename

rename-canceled <- true

────────────────────
+ do focus-relative
    - offset Int

. tabs = strip?.items() ?? List'TabBox()
. index = tab-index(tabs, this)
. next = ListCursor(tabs.length, index).stepped(offset)
if next != null
    focus-tab(tabs[next])

────────────────────
+ do focus-edge
    - last Bool

. tabs = strip?.items() ?? List'TabBox()
=? if tabs.length == 0
focus-tab(if last then tabs[tabs.length - 1] else tabs[0])

────────────────────
_ do focus-tab
    - tab TabBox

tab.choose-tab()
tab.request-focus()

────────────────────
_ do settle-close

=? if is-press-within
is-pointed = is-hover-within

