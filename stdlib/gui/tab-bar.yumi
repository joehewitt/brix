+ gui-tab-side Length = (gui-tab-radius - gui-tab-stroke) * 2
+ gui-tab-gap Length = 2
+ gui-tab-tray-pad Length = 1.5
+ gui-tab-modified-size Length = 8
+ gui-tab-divider-width Length = 1
+ gui-tab-divider-height Length = 14
+ gui-tab-tray-height Length = gui-tab-height + gui-tab-tray-pad * 2
+ gui-tab-bar-height Length = 34
+ gui-tab-bar-stoplight-offset = Point
    - window-stoplight-offset.x
    - gui-tab-bar-height / 2 + 1 - window-stoplight-center

