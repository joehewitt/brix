━━━━━━━━━━━━━━━━━━━━
_ do tab-index Index?
    - tabs [TabBox]
    - tab TabBox

for index in 0 .. < tabs.length
    =? index if tabs[index] as Pointer == tab as Pointer

━━━━━━━━━━━━━━━━━━━━
_ do tab-leader'T Tab'T?
    - order [TabBox]?
    - value T

. tabs = order ?? List'TabBox()
for index in 0 .. < tabs.length
    . tab = tabs[index]
    if tab is Tab'T && (tab as Tab'T).value == value
        =? null if index == 0
        . leader = tabs[index - 1]
        =? leader as Tab'T if leader is Tab'T
        = null
= null

━━━━━━━━━━━━━━━━━━━━
_ do same-tabs Bool
    - one [TabBox]
    - two [TabBox]

=? false if one.length != two.length
for index in 0 .. < one.length
    =? false if one[index] as Pointer != two[index] as Pointer
= true
