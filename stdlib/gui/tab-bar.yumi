────────────────────
for event on drag-over

if event.payload is TabDrag
    . drag = event.payload as TabDrag
    if drag.strip == this && tray
        event.accept(tray)

────────────────────
for event on drop when arrival

if event.payload is TabDrag
    . tab = (event.payload as TabDrag).tab
    . index = tab.carry-slot
    if index != null
        tab.move-tab(index)

────────────────────
+ items

match tray
    | box TabTray
        List'TabBox
            ** box.active-children
            ?*> each as TabBox if each is TabBox
    ??
        List'TabBox()

────────────────────
+ do note-order

. found = items()
=? if same-tabs(found, order)
order = found

