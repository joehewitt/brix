+ Tab'T is TabBox

• This
    focus-mode = FocusMode.press
    window-draggable = false

+ value T
+ is-selected = #bar?.#selected == #value
+ is-framed = #is-selected
+ shows-hover = #is-hover-within && !#is-selected
+ is-plain = !#is-selected && !#is-hover-within && !#is-carried
+ is-divided = #is-plain && (tab-leader(#strip?.#order, #value)?.#is-plain ?? false)
+ is-closable = true
+ is-modified = false
+ is-untitled = #title == ""
+ is-renamable = false
+ rename-text = #title
+ rename-selection Size?
+ shows-close = #is-closable && !#is-untitled && !#is-renaming && #is-selected && (#is-pointed || #is-focus-visible)
+ event dismissed Tab'T
+ event renamed String
+ event rename-canceled Bool

_ bar Ancestor'(ChoiceControl'T)
_ tab-bar Ancestor'(TabBar'T)
_ strip Ancestor'TabStrip
_ is-pointed = false
_ event rename-requested Bool
_ event rename-committed String

────────────────────

<This • tab-pill flex-row flex:1
    <Box • tab-divider
    <Box • tab-side flex-row
        if #shows-close
            <IconButton • tab-close icon-x
                action = => do dismiss()
    <Box • tab-center flex-row
        + <Box leading • flex-row
            align-y = Alignment.center
        if #is-renaming
            <TabRenameInput'T rename-input
                text = rename-text
        else if !#is-untitled
            <Label • tab-title
                text = #title
    <Box • tab-side flex-row
        if #is-modified
            <Box • tab-modified
    <KeyShortcut "Next tab"
        key = .arrow-right
        discoverable = false
        action = => do focus-relative(1)
    <KeyShortcut "Previous tab"
        key = .arrow-left
        discoverable = false
        action = => do focus-relative(-1)
    <KeyShortcut "First tab"
        key = .home
        discoverable = false
        action = => do focus-edge(false)
    <KeyShortcut "Last tab"
        key = .end
        discoverable = false
        action = => do focus-edge(true)
    <KeyShortcut "Close tab"
        key = .delete
        discoverable = false
        when = => is-closable && !is-renaming
        action = => do dismiss()
    <KeyShortcut "Close tab"
        key = .backspace
        discoverable = false
        when = => is-closable && !is-renaming
        action = => do dismiss()
    <KeyShortcut "Rename tab"
        key = .enter
        discoverable = false
        when = => is-renamable && !is-renaming
        action = => do begin-rename()

