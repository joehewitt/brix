./app
./box
./menu
./primitives
./window
/YuAppleGUI/YuAppleGUI.h
/core/intrinsics
/core/markup
/graphics/point
/graphics/primitives

_ panel-gap Length = 4
_ panel-margin Length = 8

━━━━━━━━━━━━━━━━━━━━
+ StatusItem is Box
    is MarkupRootElement

+ app App?
+ title = ""
+ make-panel Getter'Window?
+ markup-batch-queue := MarkupBatchQueue(this as MarkupRootElement)

_ native Pointer?
_ panel Window?

. title-changed < title

────────────────────
+ do open

=? if native
native = C:yumiGuiStatusItemCreate()
C:yumiGuiStatusItemSetCallback
    - native!
    - gui-status-item-native-event as GuiStatusItemCallback
    - this as Pointer
markup-mount-root(this, this)
catch markup-batch-queue.checkpoint()
title-changed()
sync-menu()

────────────────────
+ do close

panel?.close()
panel = null
. item = native
=? if !item
native = null
C:yumiGuiStatusItemRelease(item)
markup-release(this)

────────────────────
+ do toggle-panel

. shown = panel
if shown && shown.is-open
    shown.close()
else
    open-panel()

────────────────────
+ do dismiss-panel

. shown = panel
if shown && shown.is-open
    shown.close()

────────────────────
+ do place-panel

. item = native
. shown = panel
=? if !item || !shown || !shown.is-open
shown.position = panel-position(item, shown)

────────────────────
+ do title-changed

if native
    C:yumiGuiStatusItemSetTitle(native, title)

────────────────────
_ do sync-menu

=? if !native
. menu = first-child-menu(this)
C:yumiGuiStatusItemSetMenu(native!, if menu then menu.native-menu() else Pointer())

────────────────────
_ do open-panel

. item = native
. make = make-panel
=? if !item || !make
. shown = make()
panel = shown
shown.app = app
shown.kind = WindowKind.panel
shown.position = panel-position(item, shown)
shown.open()
. window-native = shown.native
if window-native
    C:yumiGuiStatusItemSetPanel(item, window-native)


────────────────────
+ do markup-batch-did-flush
    - flush MarkupBatchFlush

sync-menu()

━━━━━━━━━━━━━━━━━━━━
_ panel-position Point
    - item Pointer
    - shown Window

Point(if x > right then right else if x < left then left else x, y)

.. left = C:yumiGuiStatusItemGetScreenBound(item, 0) + panel-margin
.. right = left + C:yumiGuiStatusItemGetScreenBound(item, 2) - shown.size.width - panel-margin * 2
.. x = C:yumiGuiStatusItemGetBound(item, 0)
.. y = C:yumiGuiStatusItemGetBound(item, 1) + C:yumiGuiStatusItemGetBound(item, 3) + panel-gap

━━━━━━━━━━━━━━━━━━━━
_ NativeStatusItemEventKind is U32

| pressed = 0
| dismissed = 1
| moved = 2

━━━━━━━━━━━━━━━━━━━━
_ GuiStatusItemCallback is (*C) Void
    - item-pointer Pointer
    - event-kind U32

━━━━━━━━━━━━━━━━━━━━
_ do gui-status-item-native-event
    - item-pointer Pointer
    - event-kind U32

. item = gc-object-from-pointer'StatusItem(item-pointer)
do match? event-kind as NativeStatusItemEventKind
    |= NativeStatusItemEventKind.pressed
        item.toggle-panel()
            catch error Error
                unhandled-error(error)
    |= NativeStatusItemEventKind.dismissed
        item.dismiss-panel()
            catch error Error
                unhandled-error(error)
    |= NativeStatusItemEventKind.moved
        item.place-panel()
