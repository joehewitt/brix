/graphics/graphic
/graphics/primitives
/graphics/vector-group

━━━━━━━━━━━━━━━━━━━━
+ VectorImageGenerator is () VectorGroup
    - bounds Rect

━━━━━━━━━━━━━━━━━━━━
+ GeneratedVectorImage is VectorGroup

+ generator VectorImageGenerator?
_ generated-output VectorGroup?
_ generated-stamp GraphicsCacheStamp?

. invalidate-generation < generator

────────────────────
+ This

────────────────────
+ This
    - generator

────────────────────
+ do invalidate-generation

if generated-output
    remove-group(generated-output)
generated-output = null
generated-stamp = null
graphic-invalidate(graphic-change-geometry)

────────────────────
+ do update
    - bounds Rect

ensure-generated(bounds)
super.update(bounds)

────────────────────
+ do prepare-paint
    - bounds Rect

ensure-generated(bounds)

────────────────────
_ do ensure-generated
    - bounds Rect

=? if generated-output && stamp.reuses(effective-cache-policy, generated-stamp)
.. stamp = GraphicsCacheStamp(revision, bounds, frame)
. output = VectorGroup()
if generator
    output = generator(bounds)
if generated-output
    remove-group(generated-output)
this += output
checkpoint()
generated-output = output
generated-stamp = GraphicsCacheStamp(revision, bounds, frame)
