/graphics/canvas
/graphics/color
/graphics/primitives
/math

_ terminal-box-lines [U8]
    ** List'U8(0x11, 0x22, 0x44, 0x88, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x14, 0x24, 0x18, 0x28)
    ** List'U8(0x05, 0x06, 0x09, 0x0A, 0x50, 0x60, 0x90, 0xA0, 0x41, 0x42, 0x81, 0x82, 0x54, 0x64, 0x94, 0x58)
    ** List'U8(0x98, 0xA4, 0x68, 0xA8, 0x45, 0x46, 0x85, 0x49, 0x89, 0x86, 0x4A, 0x8A, 0x15, 0x16, 0x25, 0x26)
    ** List'U8(0x19, 0x1A, 0x29, 0x2A, 0x51, 0x52, 0x61, 0x62, 0x91, 0x92, 0xA1, 0xA2, 0x55, 0x56, 0x65, 0x66)
    ** List'U8(0x95, 0x59, 0x99, 0x96, 0xA5, 0x5A, 0x69, 0xA6, 0x6A, 0x9A, 0xA9, 0xAA, 0x00, 0x00, 0x00, 0x00)
    ** List'U8(0x33, 0xCC, 0x34, 0x1C, 0x3C, 0x07, 0x0D, 0x0F, 0x70, 0xD0, 0xF0, 0x43, 0xC1, 0xC3, 0x74, 0xDC)
    ** List'U8(0xFC, 0x47, 0xCD, 0xCF, 0x37, 0x1D, 0x3F, 0x73, 0xD1, 0xF3, 0x77, 0xDD, 0xFF, 0x00, 0x00, 0x00)
    ** List'U8(0x00, 0x00, 0x00, 0x00, 0x01, 0x40, 0x10, 0x04, 0x02, 0x80, 0x20, 0x08, 0x21, 0x48, 0x12, 0x84)
_ terminal-block-quadrants = List'U8(4, 8, 1, 13, 9, 7, 11, 2, 6, 14)

━━━━━━━━━━━━━━━━━━━━
+ is-terminal-glyph Bool
    - code U32

code >= 0x2500 && code <= 0x259F

━━━━━━━━━━━━━━━━━━━━
+ do paint-terminal-glyph
    - canvas Canvas
    - code U32
    - cell Rect
    - stroke Length
    - scale F64

=? if !is-terminal-glyph(code) || scale <= 0
. left = round(cell.x * scale) as Int
. top = round(cell.y * scale) as Int
. width = (round(cell.right * scale) as Int) - left
. height = (round(cell.bottom * scale) as Int) - top
=? if width <= 0 || height <= 0
. grid = GlyphGrid(canvas, left, top, width, height, max(1, round(stroke * scale) as Int), scale)
if code >= 0x2580
    paint-block(grid, (code - 0x2580) as Int)
else
    paint-box(grid, (code - 0x2500) as Int)

━━━━━━━━━━━━━━━━━━━━
_ BoxWeight is U8

| none
| light
| heavy
| double

━━━━━━━━━━━━━━━━━━━━
_ GlyphGrid is Tuple

+ canvas Canvas
+ origin-x Int
+ origin-y Int
+ width Int
+ height Int
+ stroke Int
+ scale F64

────────────────────
+ x Coord
    - offset Float

(origin-x + offset) / scale

────────────────────
+ y Coord
    - offset Float

(origin-y + offset) / scale

────────────────────
+ do fill
    - left Int
    - top Int
    - right Int
    - bottom Int

=? if right <= left || bottom <= top
canvas.rect(Rect((origin-x + left) / scale, (origin-y + top) / scale, (right - left) / scale, (bottom - top) / scale))

────────────────────
+ do lines
    - code U8

. up = box-weight(code, 6)
. right = box-weight(code, 4)
. down = box-weight(code, 2)
. left = box-weight(code, 0)
. light = stroke
. heavy = stroke * 2
. h-light-top = (height - light) / 2
. h-light-bottom = h-light-top + light
. h-heavy-top = (height - heavy) / 2
. h-heavy-bottom = h-heavy-top + heavy
. h-double-top = h-light-top - light
. h-double-bottom = h-light-bottom + light
. v-light-left = (width - light) / 2
. v-light-right = v-light-left + light
. v-heavy-left = (width - heavy) / 2
. v-heavy-right = v-heavy-left + heavy
. v-double-left = v-light-left - light
. v-double-right = v-light-right + light
. horizontal-double = left == .double || right == .double
. vertical-double = up == .double || down == .double
. up-bottom =
    |? left == .heavy || right == .heavy
        h-heavy-bottom
    |? left != right || down == up
        if horizontal-double then h-double-bottom else h-light-bottom
    |? left == .none && right == .none
        h-light-bottom
    ??
        h-light-top
. down-top =
    |? left == .heavy || right == .heavy
        h-heavy-top
    |? left != right || up == down
        if horizontal-double then h-double-top else h-light-top
    |? left == .none && right == .none
        h-light-top
    ??
        h-light-bottom
. left-right =
    |? up == .heavy || down == .heavy
        v-heavy-right
    |? up != down || left == right
        if vertical-double then v-double-right else v-light-right
    |? up == .none && down == .none
        v-light-right
    ??
        v-light-left
. right-left =
    |? up == .heavy || down == .heavy
        v-heavy-left
    |? up != down || right == left
        if vertical-double then v-double-left else v-light-left
    |? up == .none && down == .none
        v-light-left
    ??
        v-light-right
match? up
    |= .light
        fill(v-light-left, 0, v-light-right, up-bottom)
    |= .heavy
        fill(v-heavy-left, 0, v-heavy-right, up-bottom)
    |= .double
        fill(v-double-left, 0, v-light-left, if left == .double then h-light-top else up-bottom)
        fill(v-light-right, 0, v-double-right, if right == .double then h-light-top else up-bottom)
match? right
    |= .light
        fill(right-left, h-light-top, width, h-light-bottom)
    |= .heavy
        fill(right-left, h-heavy-top, width, h-heavy-bottom)
    |= .double
        fill(if up == .double then v-light-right else right-left, h-double-top, width, h-light-top)
        fill(if down == .double then v-light-right else right-left, h-light-bottom, width, h-double-bottom)
match? down
    |= .light
        fill(v-light-left, down-top, v-light-right, height)
    |= .heavy
        fill(v-heavy-left, down-top, v-heavy-right, height)
    |= .double
        fill(v-double-left, if left == .double then h-light-bottom else down-top, v-light-left, height)
        fill(v-light-right, if right == .double then h-light-bottom else down-top, v-double-right, height)
match? left
    |= .light
        fill(0, h-light-top, left-right, h-light-bottom)
    |= .heavy
        fill(0, h-heavy-top, left-right, h-heavy-bottom)
    |= .double
        fill(0, h-double-top, if up == .double then v-light-left else left-right, h-light-top)
        fill(0, h-light-bottom, if down == .double then v-light-left else left-right, h-double-bottom)

────────────────────
+ do dashes
    - count Int
    - is-vertical Bool
    - is-heavy Bool

. thickness = if is-heavy then stroke * 2 else stroke
. span = if is-vertical then height else width
. gap = min(stroke * 2, span / (count * 2))
. dash = (span - gap * count) / count
. extra = (span - gap * count) % count
. across = ((if is-vertical then width else height) - thickness) / 2
. position = gap / 2
for index in 0 .. < count
    . end = position + dash + (if index < extra then 1 else 0)
    if is-vertical
        fill(across, position, across + thickness, end)
    else
        fill(position, across, end, across + thickness)
    position = end + gap

────────────────────
+ do arc
    - is-down Bool
    - is-right Bool

. thickness = stroke as Float
. center-x = (((width - stroke) / 2) as Float) + thickness / 2
. center-y = (((height - stroke) / 2) as Float) + thickness / 2
. radius = (min(width, height) as Float) / 2
. bend = radius / 4
. dx = if is-right then 1.0 else -1.0
. dy = if is-down then 1.0 else -1.0
. edge-x = if is-right then width as Float else 0.0
. edge-y = if is-down then height as Float else 0.0
do use canvas.saved-state
    begin-stroke()
    canvas.begin()
    canvas.move(x(center-x), y(edge-y))
    canvas.line(x(center-x), y(center-y + dy * radius))
    canvas.curve
        - x(center-x)
        - y(center-y + dy * bend)
        - x(center-x + dx * bend)
        - y(center-y)
        - x(center-x + dx * radius)
        - y(center-y)
    canvas.line(x(edge-x), y(center-y))
    canvas.end()

────────────────────
+ do diagonals
    - is-rising Bool
    - is-falling Bool

. right = width as Float
. bottom = height as Float
. reach-x = min(1.0, right / bottom) / 2
. reach-y = min(1.0, bottom / right) / 2
do use canvas.saved-state
    begin-stroke()
    if is-rising
        canvas.line(x(right + reach-x), y(-reach-y), x(-reach-x), y(bottom + reach-y))
    if is-falling
        canvas.line(x(-reach-x), y(-reach-y), x(right + reach-x), y(bottom + reach-y))

────────────────────
+ do begin-stroke

canvas.stroke-color = canvas.fill-color
canvas.fill-color = null
canvas.stroke-width = stroke / scale
canvas.stroke-cap = LineCap.butt

────────────────────
+ do shade
    - level Int

. color = canvas.fill-color
=? if !color
do use canvas.saved-state
    canvas.fill-color = color.with-alpha(color.alpha * level / 4)
    fill(0, 0, width, height)

────────────────────
+ do quadrants
    - mask U8

. middle-x = eighths(width, 4)
. middle-y = eighths(height, 4)
if (mask /and/ 1) != 0
    fill(0, 0, middle-x, middle-y)
if (mask /and/ 2) != 0
    fill(middle-x, 0, width, middle-y)
if (mask /and/ 4) != 0
    fill(0, middle-y, middle-x, height)
if (mask /and/ 8) != 0
    fill(middle-x, middle-y, width, height)

━━━━━━━━━━━━━━━━━━━━
_ do paint-box
    - grid GlyphGrid
    - index Int

if (index >= 0x04 && index <= 0x0B) || (index >= 0x4C && index <= 0x4F)
    . count = if index < 0x08 then 3 else if index < 0x0C then 4 else 2
    grid.dashes(count, (index / 2) % 2 == 1, index % 2 == 1)
else if index >= 0x6D && index <= 0x70
    grid.arc(index <= 0x6E, index == 0x6D || index == 0x70)
else if index >= 0x71 && index <= 0x73
    grid.diagonals(index != 0x72, index != 0x71)
else
    grid.lines(terminal-box-lines[index])

━━━━━━━━━━━━━━━━━━━━
_ do paint-block
    - grid GlyphGrid
    - index Int

. width = grid.width
. height = grid.height
if index == 0x00
    grid.fill(0, 0, width, eighths(height, 4))
else if index <= 0x08
    grid.fill(0, eighths(height, 8 - index), width, height)
else if index <= 0x0F
    grid.fill(0, 0, eighths(width, 0x10 - index), height)
else if index == 0x10
    grid.fill(eighths(width, 4), 0, width, height)
else if index <= 0x13
    grid.shade(index - 0x10)
else if index == 0x14
    grid.fill(0, 0, width, eighths(height, 1))
else if index == 0x15
    grid.fill(eighths(width, 7), 0, width, height)
else
    grid.quadrants(terminal-block-quadrants[index - 0x16])

━━━━━━━━━━━━━━━━━━━━
_ box-weight BoxWeight
    - code U8
    - shift U8

((code /rshift/ shift) /and/ 3) as BoxWeight

━━━━━━━━━━━━━━━━━━━━
_ eighths Int
    - total Int
    - count Int

(total * count + 4) / 8
