(import ./box)
(import ./events)
(import ./primitives)
(import ./window)
(import /BxAppleGUI/BxAppleGUI.h)
(import /BxWebKit/BxWebKit.h)
(import /core/intrinsics)
(import /data/json)
(import /graphics/matrix)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/text)
(blank)
(prop _ web-view-wake-margin Length (= 600))

(type + WebNavigationKind (is U32)
  (variant link (= 0))
  (variant form (= 1))
  (variant back-forward (= 2))
  (variant reload (= 3))
  (variant resubmit (= 4))
  (variant other (= 5))
)

(type + WebNavigationEvent (is GUIEvent)
  (prop + url String)
  (prop + kind WebNavigationKind)
  (prop + opens-window Bool)
  (fn-do + This _
    (param url _)
    (param kind _)
    (param opens-window _)
    (param data PointerEventData (= (call PointerEventData)))
  )
)

(type + WebLoadEvent (is GUIEvent)
  (prop + url String)
  (prop + error (? String))
  (fn-do + This _
    (param url _)
    (param error (? String) (= null))
    (param data PointerEventData (= (call PointerEventData)))
  )
)

(type + WebMessageEvent (is GUIEvent)
  (prop + name String)
  (prop + body JSON)
  (fn-do + This _
    (param name _)
    (param body _)
    (param data PointerEventData (= (call PointerEventData)))
  )
)

(type + WebScriptError (is Error))

(type _ WebScriptOutcome (is (tuple (: succeeded Bool) (: text String))))

(type + WebSession
  (implements Closable)
  (prop _ native (? Pointer))
  (prop _ viewer (? WebView))
  (fn-do + close _
    (return-if (if (not native)))
    (blank)
    (call (?. viewer forget-native))
    (= viewer null)
    (call C:brixWebViewRelease native)
    (= native null)
  )
  (fn-do _ take (? Pointer)
    (param view WebView)
    (return-if null (if (not native)))
    (blank)
    (let previous viewer)
    (if (and previous (!= (as previous Pointer) (as view Pointer)))
      (call (. previous forget-native))
    )
    (= viewer view)
    (return native)
  )
  (fn-do _ keep _
    (param made Pointer)
    (param view WebView)
    (= native made)
    (= viewer view)
  )
  (fn-do _ leave Bool
    (param view WebView)
    (return-if false (if (or (not viewer) (!= (as viewer Pointer) (as view Pointer)))))
    (blank)
    (= viewer null)
    (return true)
  )
)

(type + WebView (is Box)
  (rule This
    (= focus-mode (. FocusMode input))
    (= window-draggable false)
  )
  (blank)
  (prop + url (? String))
  (prop + html (? String))
  (prop + base-url _ (= ""))
  (prop + title _ (= ""))
  (prop + is-loading _ (= false))
  (prop + progress F64)
  (prop + can-go-back _ (= false))
  (prop + can-go-forward _ (= false))
  (prop + is-inspectable _ (= false))
  (prop + message-names (list String))
  (prop + fits-content _ (= false))
  (prop + content-height (? Length))
  (prop + is-transparent _ (= false))
  (prop + passes-scroll _ (= #fits-content))
  (prop + is-ephemeral _ (= false))
  (prop + session (? WebSession))
  (prop + inherits-style _ (= false))
  (prop + user-style _ (= ""))
  (prop + user-script _ (= ""))
  (prop + native (? Pointer))
  (prop + native-focus-handle _ (=> native))
  (event + navigating WebNavigationEvent)
  (event + loaded WebLoadEvent)
  (event + load-failed WebLoadEvent)
  (event + message WebMessageEvent)
  (blank)
  (prop _ is-accepting-native-state _ (= false))
  (prop _ held (? WebSession))
  (blank)
  (depends requested-url-changed url)
  (depends requested-html-changed html base-url)
  (depends native-inspectable-changed is-inspectable)
  (depends native-message-names-changed message-names)
  (depends native-fits-content-changed fits-content)
  (depends native-transparent-changed is-transparent)
  (depends native-passes-scroll-changed passes-scroll)
  (depends native-ephemeral-changed is-ephemeral)
  (depends native-session-changed session)
  (depends native-style-changed inherits-style user-style)
  (depends native-script-changed user-script)
  (depends invalidate-content-size content-height)
  (fn-do + mounted _
    (call (. super mounted))
    (call create-native)
  )
  (fn-do + unmounted _
    (call (. super unmounted))
    (call release-native)
  )
  (fn-do + markup-style-domains-changed _
    (param mask U32)
    (call (. super markup-style-domains-changed) mask)
    (if inherits-style
      (call native-style-changed)
    )
  )
  (fn-do + sync-native-geometry-self _
    (param native-origin Point)
    (param visible Bool)
    (param native-parent (? Pointer))
    (param transform (? Matrix))
    (return-if (if (not native)))
    (blank)
    (let host window)
    (return-if (if (not host)))
    (blank)
    (let content content-bounds)
    (let zoom native-zoom)
    (call C:brixGuiPeerSetContainer (?? (. (as host Window) native) (call Pointer)) (!! native) (?? native-parent (call Pointer)))
    (let corner (call native-placed-point (- (. content top-left) native-origin) native-origin transform))
    (let linear (?? transform (call Matrix)))
    (call C:brixGuiPeerSetFrame
      (block
        (arg (!! native))
        (arg (* (. corner x) zoom))
        (arg (* (. corner y) zoom))
        (arg (* (. content width) zoom))
        (arg (* (. content height) zoom))
        (arg (. linear a))
        (arg (. linear c))
        (arg (. linear b))
        (arg (. linear d))
      )
    )
    (call C:brixWebViewSetPageZoom (!! native) zoom)
    (let margin web-view-wake-margin)
    (let wake (call (. content outset) (call Insets margin margin margin margin)))
    (call C:brixGuiPeerSetVisible (!! native) (and visible (or is-focused (call is-presentation-visible wake))))
    (call C:brixGuiPeerSetOpacity (!! native) effective-opacity)
  )
  (fn-expr + measured-content-size _
    (param query MeasureQuery)
    (if-expr fits-content (call Dimensions width (?? content-height 150)) (call Dimensions 300 150))
    (where
      (lazy proposed (?? (. query inline available) (. query inline max) 300))
      (lazy width (call constrained-axis-size (call gui-safe-span proposed) (. query inline) $min-width $max-width))
    )
  )
  (fn-do + go-back _
    (if native
      (call C:brixWebViewGoBack native)
    )
  )
  (fn-do + go-forward _
    (if native
      (call C:brixWebViewGoForward native)
    )
  )
  (fn-do + reload _
    (if native
      (call C:brixWebViewReload native)
    )
  )
  (fn-do + stop _
    (if native
      (call C:brixWebViewStop native)
    )
  )
  (fn-do + evaluate JSON
    (param script String)
    (throw (call WebScriptError "The web view is not mounted") (if (not native)))
    (blank)
    (let completion (call (of Completion WebScriptOutcome)))
    (call C:brixWebViewEvaluate
      (block
        (arg (!! native))
        (arg script)
        (arg (as gui-web-view-script-result WebViewScriptCallback))
        (arg (as completion Pointer))
      )
    )
    (let outcome (!! (call (. completion await))))
    (throw (call WebScriptError (. outcome text)) (if (not (. outcome succeeded))))
    (return (call JSON (. outcome text)))
  )
  (fn-do + accept-native-state _
    (return-if (if (not native)))
    (blank)
    (let current (as (call C:brixWebViewGetURL native) String))
    (= is-accepting-native-state true)
    (if (and (. current length) (!= current url))
      (= url current)
    )
    (= title (as (call C:brixWebViewGetTitle (!! native)) String))
    (= is-loading (call C:brixWebViewIsLoading (!! native)))
    (= progress (call C:brixWebViewGetProgress (!! native)))
    (= can-go-back (call C:brixWebViewCanGoBack (!! native)))
    (= can-go-forward (call C:brixWebViewCanGoForward (!! native)))
    (if fits-content
      (let height (call C:brixWebViewGetContentHeight (!! native)))
      (if (>= height 0)
        (= content-height height)
      )
    )
    (= is-accepting-native-state false)
  )
  (fn-do + accept-native-focus _
    (let host window)
    (if host
      (call (. (as host Window) accept-native-focus) this)
    )
  )
  (fn-do + accept-navigation-request _
    (param request-id U64)
    (param detail U32)
    (param target String)
    (let kind (as (/and/ detail 255) WebNavigationKind))
    (let event (call WebNavigationEvent target kind (!= (/and/ detail 256) 0)))
    (<- navigating event)
    (if native
      (call C:brixWebViewDecideNavigation native request-id (not (. event is-canceled)))
    )
  )
  (fn-do + accept-native-load _
    (param target String)
    (param error (? String))
    (if error
      (<- load-failed (call WebLoadEvent target error))
      (else
        (<- loaded (call WebLoadEvent target))
      )
    )
  )
  (fn-do + accept-native-message _
    (param name String)
    (param body String)
    (<- message (call WebMessageEvent name (call JSON body)))
  )
  (fn-do _ create-native _
    (let host-box window)
    (return-if (if (not host-box)))
    (blank)
    (let host-window (as host-box Window))
    (call (. host-window ensure-native))
    (return-if (if (not (. host-window native))))
    (blank)
    (let kept (call (?. session take) this))
    (= native (?? kept (call C:brixWebViewCreate is-ephemeral)))
    (= held session)
    (if (and session (not kept))
      (call (. session keep) (!! native) this)
    )
    (call C:brixGuiWindowAddPeer (!! (. host-window native)) (!! native) true true)
    (call set-native-peer-artifact-required true)
    (call C:brixWebViewSetEventCallback
      (block
        (arg (!! native))
        (arg (as gui-web-view-event WebViewEventCallback))
        (arg (as this Pointer))
      )
    )
    (call native-inspectable-changed)
    (call native-message-names-changed)
    (call native-transparent-changed)
    (call native-style-changed)
    (call native-script-changed)
    (call native-fits-content-changed)
    (call native-passes-scroll-changed)
    (if (and kept (> (. (as (call C:brixWebViewGetURL (!! native)) String) length) 0))
      (call accept-native-state)
      (else
        (call load-requested-content)
      )
    )
  )
  (fn-do _ release-native _
    (return-if (if (not native)))
    (blank)
    (let owner held)
    (= held null)
    (if (not owner)
      (call C:brixWebViewRelease native)
      (else-if (call (. owner leave) this)
        (call C:brixWebViewClearEventCallback (!! native))
        (call C:brixGuiPeerDetach (!! native))
      )
    )
    (= native null)
  )
  (fn-do _ forget-native _
    (= native null)
    (= held null)
  )
  (fn-do _ requested-url-changed _
    (return-if (if (or is-accepting-native-state (not native))))
    (blank)
    (= html null)
    (call load-requested-url)
  )
  (fn-do _ requested-html-changed _
    (return-if (if (or (not native) (not html))))
    (blank)
    (call C:brixWebViewLoadHTML native html base-url)
  )
  (fn-do _ load-requested-content _
    (return-if (if (not native)))
    (blank)
    (if html
      (call C:brixWebViewLoadHTML native html base-url)
      (else
        (call load-requested-url)
      )
    )
  )
  (fn-do _ load-requested-url _
    (return-if (if (not native)))
    (blank)
    (let target url)
    (return-if (if (not target)))
    (blank)
    (if (not (call C:brixWebViewLoadURL native target))
      (<- load-failed (call WebLoadEvent target "Invalid URL"))
    )
  )
  (fn-do _ native-inspectable-changed _
    (if native
      (call C:brixWebViewSetInspectable native is-inspectable)
    )
  )
  (fn-do _ native-message-names-changed _
    (return-if (if (not native)))
    (blank)
    (call C:brixWebViewClearMessageHandlers native)
    (for (in name message-names)
      (call C:brixWebViewAddMessageHandler (!! native) name)
    )
  )
  (fn-do _ native-fits-content-changed _
    (if native
      (call C:brixWebViewSetFitsContent native fits-content)
    )
  )
  (fn-do _ native-transparent-changed _
    (if native
      (call C:brixWebViewSetTransparent native is-transparent)
    )
  )
  (fn-do _ native-passes-scroll-changed _
    (if native
      (call C:brixGuiPeerSetPassesScroll native passes-scroll)
    )
  )
  (fn-do _ native-ephemeral-changed _
    (return-if (if (not native)))
    (blank)
    (let owner held)
    (call release-native)
    (call (?. owner close))
    (call create-native)
    (call invalidate-paint)
  )
  (fn-do _ native-session-changed _
    (return-if (if (not native)))
    (blank)
    (call release-native)
    (call create-native)
    (call invalidate-paint)
  )
  (fn-do _ native-style-changed _
    (return-if (if (not native)))
    (blank)
    (let css (if-expr inherits-style (str (call inherited-style-css) user-style) user-style))
    (call C:brixWebViewSetUserStyle (!! native) css)
  )
  (fn-do _ native-script-changed _
    (if native
      (call C:brixWebViewSetUserScript native user-script)
    )
  )
  (fn-expr _ inherited-style-css _
    (paragraph
      ":root {"
      "    color-scheme: light dark;"
      (str "    --brix-text-color: " text-color ";")
      (str "    --brix-font-family: " families ";")
      (str "    --brix-font-size: " size "px;")
      (str "    color: " text-color ";")
      (str "    font: " slant " " weight " " size "px " families ";")
      "}"
    )
    (where
      (lazy text-color $color)
      (lazy family $font-family)
      (lazy families (if-expr (. family length) (str "\"" family "\", system-ui") "system-ui"))
      (lazy weight (str (. $font-weight css-weight)))
      (lazy slant (if-expr (== $font-slant (. FontSlant italic)) "italic" "normal"))
      (lazy size $font-size)
    )
  )
)

(type + WebViewEventCallback (is (c-fn-type Void (param view-pointer Pointer) (param event-kind U32) (param request-id U64) (param detail U32) (param first (of CPointer Char8)) (param second (of CPointer Char8)))))

(type _ NativeWebViewEventKind (is U32)
  (variant state (= 0))
  (variant focus (= 1))
  (variant navigation-request (= 2))
  (variant loaded (= 3))
  (variant load-failed (= 4))
  (variant message (= 5))
)

(type + WebViewScriptCallback (is (c-fn-type Void (param request-pointer Pointer) (param succeeded Bool) (param text (of CPointer Char8)))))

(fn-do _ gui-web-view-event _
  (param view-pointer Pointer)
  (param event-kind U32)
  (param request-id U64)
  (param detail U32)
  (param first (of CPointer Char8))
  (param second (of CPointer Char8))
  (let view (call (of gc-object-from-pointer WebView) view-pointer))
  (match? (as event-kind NativeWebViewEventKind)
    (case= (. NativeWebViewEventKind state)
      (call (. view accept-native-state))
    )
    (case= (. NativeWebViewEventKind focus)
      (call (. view accept-native-focus))
    )
    (case= (. NativeWebViewEventKind navigation-request)
      (call (. view accept-navigation-request) request-id detail first)
    )
    (case= (. NativeWebViewEventKind loaded)
      (call (. view accept-native-load) first null)
    )
    (case= (. NativeWebViewEventKind load-failed)
      (call (. view accept-native-load) first (as second String))
    )
    (case= (. NativeWebViewEventKind message)
      (call (. view accept-native-message) first second)
    )
  )
)

(fn-do _ gui-web-view-script-result _
  (param request-pointer Pointer)
  (param succeeded Bool)
  (param text (of CPointer Char8))
  (let completion (call (of gc-object-from-pointer (of Completion WebScriptOutcome)) request-pointer))
  (call (. completion finish) (call WebScriptOutcome succeeded text))
)
