** items
*> each.display-title
|> List

━━━━━━━━━━━━━━━━━━━━
_ do collect-menu-items
    - node GuiNode
    - result [MenuItem]

. child = node.%first-child
while child
    . current = child
    if current is MenuItem
        if (current as MenuItem).is-displayed
            result += current as MenuItem
    else if current.is-gui-transparent || (current is Box && !(current is Popup))
        collect-menu-items(current, result)
    child = current.%next-sibling

━━━━━━━━━━━━━━━━━━━━
+ menu-command-shortcut
    - item MenuItem
    - command Command

match item.window
    | host Window
        ", ".join • stream
            ** host.registered-key-bindings
            ?*> menu-binding-label(each, command)
    ??
        ""

━━━━━━━━━━━━━━━━━━━━
+ do menu-command-key
    - item MenuItem
    - command Command

. host = item.window
=? if !host || !(host is Window)
for binding in (host as Window).registered-key-bindings
    . target = binding.command-target
    if target && target.identity == command.identity && binding.key.trigger != KeyTrigger.none
        = binding.key

━━━━━━━━━━━━━━━━━━━━
_ menu-binding-label
    - binding KeyBinding
    - command Command

|? !target || target.identity != command.identity
    null
|? !label
    null
??
    label

.. target = binding.command-target
.. label = binding.symbol-label

━━━━━━━━━━━━━━━━━━━━
+ menu-role-title
    - role MenuRole

match role
    | MenuRole.undo
        "Undo"
    | MenuRole.redo
        "Redo"
    | MenuRole.cut
        "Cut"
    | MenuRole.copy
        "Copy"
    | MenuRole.paste
        "Paste"
    | MenuRole.paste-and-match-style
        "Paste and Match Style"
    | MenuRole.delete
        "Delete"
    | MenuRole.select-all
        "Select All"
    | MenuRole.find
        "Find…"
    | MenuRole.settings
        "Settings…"
    | MenuRole.minimize
        "Minimize"
    | MenuRole.zoom
        "Zoom"
    | MenuRole.close-window
        "Close Window"
    | MenuRole.bring-all-to-front
        "Bring All to Front"
    | MenuRole.toggle-full-screen
        "Enter Full Screen"
    | MenuRole.zoom-in
        "Zoom In"
    | MenuRole.zoom-out
        "Zoom Out"
    | MenuRole.actual-size
        "Actual Size"

━━━━━━━━━━━━━━━━━━━━
+ menu-role-key KeyCombo?
    - role MenuRole

match? role
    | MenuRole.undo
        undo-key
    | MenuRole.redo
        redo-key
    | MenuRole.cut
        cut-key
    | MenuRole.copy
        copy-key
    | MenuRole.paste
        paste-key
    | MenuRole.paste-and-match-style
        KeyCombo("Option+Shift+Cmd+V")
    | MenuRole.select-all
        KeyCombo("Cmd+A")
    | MenuRole.find
        KeyCombo("Cmd+F")
    | MenuRole.settings
        KeyCombo("Cmd+,")
    | MenuRole.minimize
        KeyCombo("Cmd+M")
    | MenuRole.close-window
        KeyCombo("Cmd+W")
    | MenuRole.toggle-full-screen
        KeyCombo("Ctrl+Cmd+F")
    | MenuRole.zoom-in
        KeyModifier.command + "="
    | MenuRole.zoom-out
        KeyModifier.command + "-"
    | MenuRole.actual-size
        KeyModifier.command + "0"

━━━━━━━━━━━━━━━━━━━━
_ menu-role-code U32
    - role MenuRole?

match role
    | MenuRole.undo
        1
    | MenuRole.redo
        2
    | MenuRole.cut
        3
    | MenuRole.copy
        4
    | MenuRole.paste
        5
    | MenuRole.select-all
        6
    | MenuRole.minimize
        7
    | MenuRole.zoom
        8
    | MenuRole.close-window
