+ get default-placement

match anchor
    | PopupAnchor.point
        PointPlacement()
    | PopupAnchor.pointer
        PointPlacement()
    ??
        if owner-item then submenu-placement else AnchoredPlacement()

.. submenu-placement = AnchoredPlacement(Side.right, AnchorPoint.start, 0, -6)

