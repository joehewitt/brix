+ do refresh-command-state

has-submenu = submenu != null
. source = command
if role
    implied-title = menu-role-title(role)
    implied-shortcut = menu-role-key(role!)?.symbol-label ?? ""
else if source
    implied-title = source.title
    implied-shortcut = menu-command-shortcut(this, source)
=? if !source
is-enabled = source.is-available
is-on = source.is-on

