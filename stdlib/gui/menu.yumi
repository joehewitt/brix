_ do type-select-key
    - event KeyPressEvent

. text = event.typed-text
=? if !text || (text == " " && !type-select.is-active)
. candidates = enabled-items
. found = type-select.find(text, menu-item-titles(candidates), highlighted-index(candidates))
if found != null
    highlight(candidates[found])
event.cancel()

────────────────────
_ do close-submenu
    - submenu Menu

if submenu.is-open
    submenu.dismiss()

────────────────────
_ do set-highlight
    - item MenuItem?

highlighted?.is-highlighted = false
highlighted = item
item?.is-highlighted = true

────────────────────
_ get enabled-items

** items
?> each.is-enabled
|> List

────────────────────
_ do highlighted-index Index?
    - candidates [MenuItem]

=? if !highlighted
for index in 0 .. < candidates.length
    =? index if candidates[index] as Pointer == highlighted as Pointer

────────────────────
+ do native-menu Pointer

if !native
    native = C:yumiGuiMenuCreate("", gui-menu-native-event as GuiMenuCallback, this as Pointer)
= native!

────────────────────
+ do sync-native

=? if !native
for item in items
    item.refresh-command-state()
. entries = List'Box()
collect-native-menu-entries(this, entries)
native-entries = entries
C:yumiGuiMenuRemoveAllItems(native!)
for entry in entries
    if entry is MenuItem
        add-native-item(entry as MenuItem)
    else
        C:yumiGuiMenuAddSeparator(native!)

────────────────────
+ do choose-native
    - index Index

=? if index >= native-entries.length
. entry = native-entries[index]
if entry is MenuItem
    (entry as MenuItem).activate()

────────────────────
+ do release-native

. menu = native
native = null
native-entries = List'Box()
if menu
    C:yumiGuiMenuRelease(menu)

────────────────────
_ do add-native-item
    - item MenuItem

. key = item.native-key
. characters = ""
. key-kind U32
. modifiers U64
if key
    do match? key.trigger
        | KeyTrigger.characters(text)
            characters = text
        | KeyTrigger.key(pressed)
            key-kind = key-to-native(pressed)
    modifiers = pointer-modifiers-to-native(key.modifiers)
. submenu = item.submenu
C:yumiGuiMenuAddItem
    - native!
    - item.display-title
    - characters
    - key-kind
    - modifiers
    - item.is-enabled
    - item.is-on
    - menu-role-code(item.role)
    - if submenu then submenu.native-menu() else Pointer()

────────────────────
+ do unmounted

release-native()
super.unmounted()

