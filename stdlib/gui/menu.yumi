────────────────────
+ do highlight
    - item MenuItem?
    - from-pointer = false

parent-menu?.keep-submenu-open(owner-item)
=? if item as Pointer? == highlighted as Pointer?
. previous = highlighted
set-highlight(item)
highlight-moved <- true
. entered = item?.submenu
if entered && entered.is-open
    submenu-kept <- entered
else if entered && from-pointer && item!.is-enabled
    submenu-hovered <- entered
. left = previous?.submenu
if left && left.is-open
    if from-pointer
        submenu-left <- left
    else
        left.dismiss()
if item
    ensure-visible(item)

────────────────────
+ do keep-submenu-open
    - item MenuItem?

=? if !item
. kept = item.submenu
if kept
    submenu-kept <- kept
if highlighted as Pointer? != item as Pointer?
    set-highlight(item)
parent-menu?.keep-submenu-open(owner-item)

