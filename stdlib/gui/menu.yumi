━━━━━━━━━━━━━━━━━━━━
+ do gui-menu-native-event
    - menu-pointer Pointer
    - event-kind U32
    - index U64

. menu = gc-object-from-pointer'Menu(menu-pointer)
if event-kind == 0
    menu.sync-native()
else
    menu.choose-native(index as Index)

