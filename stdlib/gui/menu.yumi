━━━━━━━━━━━━━━━━━━━━
+ do first-child-menu Menu?
    - node GuiNode

. child = node.%first-child
while child
    . current = child
    =? current as Menu if current is Menu
    if current.is-gui-transparent
        . nested = first-child-menu(current)
        =? nested if nested
    child = current.%next-sibling

━━━━━━━━━━━━━━━━━━━━
_ do collect-native-menu-entries
    - node GuiNode
    - result List'Box

. child = node.%first-child
while child
    . current = child
    if current is MenuItem || current is MenuSeparator
        if (current as Box).is-displayed
            result += current as Box
    else if current.is-gui-transparent || (current is Box && !(current is Popup))
        collect-native-menu-entries(current, result)
    child = current.%next-sibling

