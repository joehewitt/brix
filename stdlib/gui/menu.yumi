~> is-open
    _ submenu-closing ~>
        ~> idle
            then closing(submenu) for submenu on submenu-left

        ~> closing(submenu)
            then idle on Timer(submenu-close-delay)
                do close-submenu(submenu)
            then closing(next) for next on submenu-left
                do close-submenu(submenu)
            then idle on submenu-kept when each as Pointer == submenu as Pointer
            then idle on submenu-kept
                do close-submenu(submenu)

    _ submenu-opening ~>
        ~> idle

        ~> waiting(submenu) for submenu on submenu-hovered
            then idle on Timer(submenu-open-delay)
                do
                    if !submenu.is-open
                        submenu.show()
            then idle on highlight-moved
            then idle on submenu-kept

