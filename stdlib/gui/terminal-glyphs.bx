(import /graphics/canvas)
(import /graphics/color)
(import /graphics/primitives)
(import /math)
(blank)
(prop _ terminal-box-lines (list U8)
  (block
    (spread (call (of List U8) 0x11 0x22 0x44 0x88 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x14 0x24 0x18 0x28))
    (spread (call (of List U8) 0x05 0x06 0x09 0x0A 0x50 0x60 0x90 0xA0 0x41 0x42 0x81 0x82 0x54 0x64 0x94 0x58))
    (spread (call (of List U8) 0x98 0xA4 0x68 0xA8 0x45 0x46 0x85 0x49 0x89 0x86 0x4A 0x8A 0x15 0x16 0x25 0x26))
    (spread (call (of List U8) 0x19 0x1A 0x29 0x2A 0x51 0x52 0x61 0x62 0x91 0x92 0xA1 0xA2 0x55 0x56 0x65 0x66))
    (spread (call (of List U8) 0x95 0x59 0x99 0x96 0xA5 0x5A 0x69 0xA6 0x6A 0x9A 0xA9 0xAA 0x00 0x00 0x00 0x00))
    (spread (call (of List U8) 0x33 0xCC 0x34 0x1C 0x3C 0x07 0x0D 0x0F 0x70 0xD0 0xF0 0x43 0xC1 0xC3 0x74 0xDC))
    (spread (call (of List U8) 0xFC 0x47 0xCD 0xCF 0x37 0x1D 0x3F 0x73 0xD1 0xF3 0x77 0xDD 0xFF 0x00 0x00 0x00))
    (spread (call (of List U8) 0x00 0x00 0x00 0x00 0x01 0x40 0x10 0x04 0x02 0x80 0x20 0x08 0x21 0x48 0x12 0x84))
  )
)
(prop _ terminal-block-quadrants _ (= (call (of List U8) 4 8 1 13 9 7 11 2 6 14)))

(fn-expr + is-terminal-glyph Bool
  (param code U32)
  (and (>= code 0x2500) (<= code 0x259F))
)

(fn-do + paint-terminal-glyph _
  (param canvas Canvas)
  (param code U32)
  (param cell Rect)
  (param stroke Length)
  (param scale F64)
  (return-if (if (or (not (call is-terminal-glyph code)) (<= scale 0))))
  (blank)
  (let left (as (call round (* (. cell x) scale)) Int))
  (let top (as (call round (* (. cell y) scale)) Int))
  (let width (- (as (call round (* (. cell right) scale)) Int) left))
  (let height (- (as (call round (* (. cell bottom) scale)) Int) top))
  (return-if (if (or (<= width 0) (<= height 0))))
  (blank)
  (let grid (call GlyphGrid canvas left top width height (call max 1 (as (call round (* stroke scale)) Int)) scale))
  (if (>= code 0x2580)
    (call paint-block grid (as (- code 0x2580) Int))
    (else
      (call paint-box grid (as (- code 0x2500) Int))
    )
  )
)

(type _ BoxWeight (is U8)
  (variant none)
  (variant light)
  (variant heavy)
  (variant double)
)

(type _ GlyphGrid (is Tuple)
  (prop + canvas Canvas)
  (prop + origin-x Int)
  (prop + origin-y Int)
  (prop + width Int)
  (prop + height Int)
  (prop + stroke Int)
  (prop + scale F64)
  (fn-expr + x Coord
    (param offset Float)
    (/ (+ origin-x offset) scale)
  )
  (fn-expr + y Coord
    (param offset Float)
    (/ (+ origin-y offset) scale)
  )
  (fn-do + fill _
    (param left Int)
    (param top Int)
    (param right Int)
    (param bottom Int)
    (return-if (if (or (<= right left) (<= bottom top))))
    (blank)
    (call (. canvas rect)
      (block
        (arg
          (call Rect
            (block
              (arg (/ (+ origin-x left) scale))
              (arg (/ (+ origin-y top) scale))
              (arg (/ (- right left) scale))
              (arg (/ (- bottom top) scale))
            )
          )
        )
      )
    )
  )
  (fn-do + lines _
    (param code U8)
    (let up (call box-weight code 6))
    (let right (call box-weight code 4))
    (let down (call box-weight code 2))
    (let left (call box-weight code 0))
    (let light stroke)
    (let heavy (* stroke 2))
    (let h-light-top (/ (- height light) 2))
    (let h-light-bottom (+ h-light-top light))
    (let h-heavy-top (/ (- height heavy) 2))
    (let h-heavy-bottom (+ h-heavy-top heavy))
    (let h-double-top (- h-light-top light))
    (let h-double-bottom (+ h-light-bottom light))
    (let v-light-left (/ (- width light) 2))
    (let v-light-right (+ v-light-left light))
    (let v-heavy-left (/ (- width heavy) 2))
    (let v-heavy-right (+ v-heavy-left heavy))
    (let v-double-left (- v-light-left light))
    (let v-double-right (+ v-light-right light))
    (let horizontal-double (or (== left .double) (== right .double)))
    (let vertical-double (or (== up .double) (== down .double)))
    (let up-bottom
      (block
        (case? (or (== left .heavy) (== right .heavy))
          h-heavy-bottom
        )
        (case? (or (!= left right) (== down up))
          (if-expr horizontal-double h-double-bottom h-light-bottom)
        )
        (case? (and (== left .none) (== right .none))
          h-light-bottom
        )
        (default
          h-light-top
        )
      )
    )
    (let down-top
      (block
        (case? (or (== left .heavy) (== right .heavy))
          h-heavy-top
        )
        (case? (or (!= left right) (== up down))
          (if-expr horizontal-double h-double-top h-light-top)
        )
        (case? (and (== left .none) (== right .none))
          h-light-top
        )
        (default
          h-light-bottom
        )
      )
    )
    (let left-right
      (block
        (case? (or (== up .heavy) (== down .heavy))
          v-heavy-right
        )
        (case? (or (!= up down) (== left right))
          (if-expr vertical-double v-double-right v-light-right)
        )
        (case? (and (== up .none) (== down .none))
          v-light-right
        )
        (default
          v-light-left
        )
      )
    )
    (let right-left
      (block
        (case? (or (== up .heavy) (== down .heavy))
          v-heavy-left
        )
        (case? (or (!= up down) (== right left))
          (if-expr vertical-double v-double-left v-light-left)
        )
        (case? (and (== up .none) (== down .none))
          v-light-left
        )
        (default
          v-light-right
        )
      )
    )
    (match? up
      (case= .light
        (call fill v-light-left 0 v-light-right up-bottom)
      )
      (case= .heavy
        (call fill v-heavy-left 0 v-heavy-right up-bottom)
      )
      (case= .double
        (call fill v-double-left 0 v-light-left (if-expr (== left .double) h-light-top up-bottom))
        (call fill v-light-right 0 v-double-right (if-expr (== right .double) h-light-top up-bottom))
      )
    )
    (match? right
      (case= .light
        (call fill right-left h-light-top width h-light-bottom)
      )
      (case= .heavy
        (call fill right-left h-heavy-top width h-heavy-bottom)
      )
      (case= .double
        (call fill (if-expr (== up .double) v-light-right right-left) h-double-top width h-light-top)
        (call fill
          (block
            (arg (if-expr (== down .double) v-light-right right-left))
            (arg h-light-bottom)
            (arg width)
            (arg h-double-bottom)
          )
        )
      )
    )
    (match? down
      (case= .light
        (call fill v-light-left down-top v-light-right height)
      )
      (case= .heavy
        (call fill v-heavy-left down-top v-heavy-right height)
      )
      (case= .double
        (call fill
          (block
            (arg v-double-left)
            (arg (if-expr (== left .double) h-light-bottom down-top))
            (arg v-light-left)
            (arg height)
          )
        )
        (call fill
          (block
            (arg v-light-right)
            (arg (if-expr (== right .double) h-light-bottom down-top))
            (arg v-double-right)
            (arg height)
          )
        )
      )
    )
    (match? left
      (case= .light
        (call fill 0 h-light-top left-right h-light-bottom)
      )
      (case= .heavy
        (call fill 0 h-heavy-top left-right h-heavy-bottom)
      )
      (case= .double
        (call fill 0 h-double-top (if-expr (== up .double) v-light-left left-right) h-light-top)
        (call fill
          (block
            (arg 0)
            (arg h-light-bottom)
            (arg (if-expr (== down .double) v-light-left left-right))
            (arg h-double-bottom)
          )
        )
      )
    )
  )
  (fn-do + dashes _
    (param count Int)
    (param is-vertical Bool)
    (param is-heavy Bool)
    (let thickness (if-expr is-heavy (* stroke 2) stroke))
    (let span (if-expr is-vertical height width))
    (let gap (call min (* stroke 2) (/ span (* count 2))))
    (let dash (/ (- span (* gap count)) count))
    (let extra (% (- span (* gap count)) count))
    (let across (/ (- (if-expr is-vertical width height) thickness) 2))
    (let position (/ gap 2))
    (for (in index (..< 0 count))
      (let end (+ position dash (if-expr (< index extra) 1 0)))
      (if is-vertical
        (call fill across position (+ across thickness) end)
        (else
          (call fill position across end (+ across thickness))
        )
      )
      (= position (+ end gap))
    )
  )
  (fn-do + arc _
    (param is-down Bool)
    (param is-right Bool)
    (let thickness (as stroke Float))
    (let center-x (+ (as (/ (- width stroke) 2) Float) (/ thickness 2)))
    (let center-y (+ (as (/ (- height stroke) 2) Float) (/ thickness 2)))
    (let radius (/ (as (call min width height) Float) 2))
    (let bend (/ radius 4))
    (let dx (if-expr is-right 1.0 -1.0))
    (let dy (if-expr is-down 1.0 -1.0))
    (let edge-x (if-expr is-right (as width Float) 0.0))
    (let edge-y (if-expr is-down (as height Float) 0.0))
    (do-use (. canvas saved-state)
      (call begin-stroke)
      (call (. canvas begin))
      (call (. canvas move) (call x center-x) (call y edge-y))
      (call (. canvas line) (call x center-x) (call y (+ center-y (* dy radius))))
      (call (. canvas curve)
        (block
          (arg (call x center-x))
          (arg (call y (+ center-y (* dy bend))))
          (arg (call x (+ center-x (* dx bend))))
          (arg (call y center-y))
          (arg (call x (+ center-x (* dx radius))))
          (arg (call y center-y))
        )
      )
      (call (. canvas line) (call x edge-x) (call y center-y))
      (call (. canvas end))
    )
  )
  (fn-do + diagonals _
    (param is-rising Bool)
    (param is-falling Bool)
    (let right (as width Float))
    (let bottom (as height Float))
    (let reach-x (/ (call min 1.0 (/ right bottom)) 2))
    (let reach-y (/ (call min 1.0 (/ bottom right)) 2))
    (do-use (. canvas saved-state)
      (call begin-stroke)
      (if is-rising
        (call (. canvas line) (call x (+ right reach-x)) (call y (- reach-y)) (call x (- reach-x)) (call y (+ bottom reach-y)))
      )
      (if is-falling
        (call (. canvas line) (call x (- reach-x)) (call y (- reach-y)) (call x (+ right reach-x)) (call y (+ bottom reach-y)))
      )
    )
  )
  (fn-do + begin-stroke _
    (= (. canvas stroke-color) (. canvas fill-color))
    (= (. canvas fill-color) null)
    (= (. canvas stroke-width) (/ stroke scale))
    (= (. canvas stroke-cap) (. LineCap butt))
  )
  (fn-do + shade _
    (param level Int)
    (let color (. canvas fill-color))
    (return-if (if (not color)))
    (blank)
    (do-use (. canvas saved-state)
      (= (. canvas fill-color) (call (. color with-alpha) (/ (* (. color alpha) level) 4)))
      (call fill 0 0 width height)
    )
  )
  (fn-do + quadrants _
    (param mask U8)
    (let middle-x (call eighths width 4))
    (let middle-y (call eighths height 4))
    (if (!= (/and/ mask 1) 0)
      (call fill 0 0 middle-x middle-y)
    )
    (if (!= (/and/ mask 2) 0)
      (call fill middle-x 0 width middle-y)
    )
    (if (!= (/and/ mask 4) 0)
      (call fill 0 middle-y middle-x height)
    )
    (if (!= (/and/ mask 8) 0)
      (call fill middle-x middle-y width height)
    )
  )
)

(fn-do _ paint-box _
  (param grid GlyphGrid)
  (param index Int)
  (if (or (and (>= index 0x04) (<= index 0x0B)) (and (>= index 0x4C) (<= index 0x4F)))
    (let count (if-expr (< index 0x08) 3 (if-expr (< index 0x0C) 4 2)))
    (call (. grid dashes) count (== (% (/ index 2) 2) 1) (== (% index 2) 1))
    (else-if (and (>= index 0x6D) (<= index 0x70))
      (call (. grid arc) (<= index 0x6E) (or (== index 0x6D) (== index 0x70)))
    )
    (else-if (and (>= index 0x71) (<= index 0x73))
      (call (. grid diagonals) (!= index 0x72) (!= index 0x71))
    )
    (else
      (call (. grid lines) ([] terminal-box-lines index))
    )
  )
)

(fn-do _ paint-block _
  (param grid GlyphGrid)
  (param index Int)
  (let width (. grid width))
  (let height (. grid height))
  (if (== index 0x00)
    (call (. grid fill) 0 0 width (call eighths height 4))
    (else-if (<= index 0x08)
      (call (. grid fill) 0 (call eighths height (- 8 index)) width height)
    )
    (else-if (<= index 0x0F)
      (call (. grid fill) 0 0 (call eighths width (- 0x10 index)) height)
    )
    (else-if (== index 0x10)
      (call (. grid fill) (call eighths width 4) 0 width height)
    )
    (else-if (<= index 0x13)
      (call (. grid shade) (- index 0x10))
    )
    (else-if (== index 0x14)
      (call (. grid fill) 0 0 width (call eighths height 1))
    )
    (else-if (== index 0x15)
      (call (. grid fill) (call eighths width 7) 0 width height)
    )
    (else
      (call (. grid quadrants) ([] terminal-block-quadrants (- index 0x16)))
    )
  )
)

(fn-expr _ box-weight BoxWeight
  (param code U8)
  (param shift U8)
  (as (/and/ (/rshift/ code shift) 3) BoxWeight)
)

(fn-expr _ eighths Int
  (param total Int)
  (param count Int)
  (/ (+ (* total count) 4) 8)
)
