(import ./box)
(import ./events)
(import ./label)
(import ./primitives)
(import ./shorthands)
(import ./styles)
(import ./theme)
(import /graphics/point)
(import /graphics/primitives)
(import /math)
(import /ui/input)
(import /ui/value-change-phase)
(blank)
(prop + timeline-min-item-width Length (= 6))
(prop + timeline-item-inset Length (= 2))
(prop + timeline-drag-threshold Length (= 3))
(prop + timeline-snap-distance Length (= 8))

(style-extend GUIDefaultTheme
  (using GUIBoxComposite)
  (rule TimelineView (• bg gui-well-color))
  (blank)
  (rule timeline-headers (• bg gui-panel-color)
    (= border-color gui-divider-color)
    (= border-right-width 1)
  )
  (blank)
  (rule timeline-lane-title (• text gui-muted-text-color) (• px 8) (• pt 4)
    (= font-size gui-footnote-font-size)
  )
  (blank)
  (rule timeline-ruler (• bg gui-panel-color)
    (= border-color gui-divider-color)
    (= border-bottom-width 1)
  )
  (blank)
  (rule timeline-tick (• bg gui-border-color))
  (blank)
  (rule timeline-mark-label (• text gui-muted-text-color) (• pl 3) (• pt 2)
    (= font-size gui-caption-font-size)
  )
  (blank)
  (rule TimelineLaneBox
    (= border-color gui-divider-color)
    (= border-bottom-width 1)
  )
  (blank)
  (rule TimelineItemBody (• bg gui-field-color)
    (= corner-radius gui-inner-radius)
    (blank)
    (when-style #is-selected
      (• bg gui-accent-color)
    )
  )
  (blank)
  (rule timeline-item-label (• text gui-text-color) (• px 4)
    (= font-size gui-footnote-font-size)
  )
  (blank)
  (rule timeline-marker (• bg gui-accent-bright-color))
  (blank)
  (rule timeline-marker-label (• text gui-accent-bright-color) (• pl 3)
    (= font-size gui-caption-font-size)
  )
  (blank)
  (rule timeline-time (• bg gui-accent-bright-color))
  (blank)
  (rule timeline-snap (• bg gui-accent-color))
  (blank)
  (rule timeline-item-grip
    (= cursor (. CursorStyle resize-horizontal))
    (= drag-cursor (. CursorStyle resize-horizontal))
  )
)

(type + TimelineLane (is Tuple)
  (prop + title String)
  (prop + rows Index (= 1))
)

(type + TimelineItem (is Tuple)
  (prop + id U64)
  (prop + lane Index)
  (prop + row Index)
  (prop + start I64)
  (prop + end I64)
  (prop + label _ (= ""))
  (prop + is-selected _ (= false))
  (prop + movable _ (= false))
  (prop + resizable _ (= false))
)

(type + TimelineMarker (is Tuple)
  (prop + lane Index)
  (prop + time I64)
  (prop + label _ (= ""))
)

(type + TimelineData (is Tuple)
  (prop + lanes (list TimelineLane))
  (prop + items (list TimelineItem))
  (prop + markers (list TimelineMarker))
  (prop + duration I64)
  (prop + snaps (list I64))
)

(type + TimelineDrag (is Tuple)
  (prop + id U64)
  (prop + resizes Bool)
  (prop + shift I64)
  (prop + snapped (? I64))
  (prop + phase ValueChangePhase)
)

(type + TimelineMark (is Tuple)
  (prop + time I64)
  (prop + label String)
)

(type + TimelineScale (is Interface)
  (fn-do + marks (list TimelineMark)
    (param span I64)
    (param width Length)
  )
)

(type + TimelineSecondsScale
  (implements TimelineScale)
  (prop + units-per-second I64)
  (fn-do + This _
    (param units-per-second _)
  )
  (fn-do + marks (list TimelineMark)
    (param span I64)
    (param width Length)
    (let result (list TimelineMark))
    (return-if result (if (or (<= width 0) (<= span 0))))
    (let rate (as units-per-second F64))
    (let seconds (/ (as span F64) rate))
    (let step (call timeline-seconds-step (/ (* seconds 64) (as width F64))))
    (let tenths (as (call round (* step 10)) I64))
    (let count (as (/ seconds step) Index))
    (for (in index (.. 0 count))
      (let point (* tenths (as index I64)))
      (+= result (call TimelineMark (as (call round (/ (* (as point F64) rate) 10)) I64) (call timeline-tenths-label point)))
    )
    (return result)
  )
)

(fn-do _ timeline-seconds-step F64
  (param minimum F64)
  (for (in step (list 0.1 0.2 0.5 1.0 2.0 5.0 10.0 15.0 30.0 60.0 120.0 300.0 600.0))
    (return-if step (if (>= step minimum)))
  )
  (return 600.0)
)

(fn-expr _ timeline-tenths-label String
  (param tenths I64)
  (if-expr (== (% tenths 10) 0) (str (/ tenths 10) "s") (str (/ tenths 10) "." (% tenths 10) "s"))
)

(type + TimelineLaneView (is Tuple)
  (prop + lane TimelineLane)
  (prop + items (list TimelineItem))
  (prop + markers (list TimelineMarker))
)

(type + TimelineView (is Box)
  (prop + data _ (= (call TimelineData)))
  (prop + scale (? TimelineScale))
  (prop + time (? I64))
  (prop + zoom F64 (= 1))
  (prop + row-height Length (= 22))
  (prop + ruler-height Length (= 20))
  (prop + header-width Length (= 64))
  (prop + span I64 (= (call timeline-span (. #data duration))))
  (prop + track-width Length (= (* #viewport #zoom)))
  (prop + lanes (list TimelineLaneView) (= (call timeline-lane-views #data)))
  (prop + marks (list TimelineMark) (= (call timeline-marks #span #track-width #scale)))
  (prop + snap-time (? I64))
  (blank)
  (event + seek-requested I64)
  (event + item-chosen U64)
  (event + item-dragged TimelineDrag)
  (blank)
  (prop _ viewport Length (= 0))
  (prop _ seeking _ (= false))
  (prop _ seeking-pointer U64)
  (prop _ pressed (? TimelineItem))
  (prop _ press-pointer U64)
  (prop _ press-x Length (= 0))
  (prop _ press-resizes _ (= false))
  (prop _ press-snaps (list I64))
  (prop _ drag-x Length (= 0))
  (prop _ dragging _ (= false))
  (content
    (<> This (• flex-row)
      (= overflow-y (. ScrollOverflow auto))
      (<> Box (• timeline-headers) (• flex-col)
        (= min-width (call (. SizeSpec coord) #header-width))
        (= max-width (call (. SizeSpec coord) #header-width))
        (<> Box
          (= min-height (call (. SizeSpec coord) #ruler-height))
          (= max-height (call (. SizeSpec coord) #ruler-height))
        )
        (for (in lane #lanes)
          (<> Label (• timeline-lane-title)
            (= text (. lane lane title))
            (= min-height (call (. SizeSpec coord) (call timeline-lane-height (. lane lane) #row-height)))
            (= max-height (call (. SizeSpec coord) (call timeline-lane-height (. lane lane) #row-height)))
          )
        )
      )
      (<> Box (id: scroller) (• flex-col) (• flex 1)
        (= overflow-x (. ScrollOverflow auto))
        (<> Box (• flex-col)
          (= min-width (call (. SizeSpec coord) #track-width))
          (= max-width (call (. SizeSpec coord) #track-width))
          (for (on event pointer-down)
            (if (== (. event button) (. PointerButton primary))
              (call begin-seek (. event pointer-id) (. event point x))
              (call (. event cancel))
            )
          )
          (for (on event pointer-drag)
            (if (== (. event button) (. PointerButton primary))
              (call continue-seek (. event pointer-id) (. event point x))
              (call (. event cancel))
            )
          )
          (for (on event pointer-up)
            (call end-seek (. event pointer-id))
          )
          (<> Box (• timeline-ruler)
            (= min-height (call (. SizeSpec coord) #ruler-height))
            (= max-height (call (. SizeSpec coord) #ruler-height))
            (for (in mark #marks (keyed-by (. mark time)))
              (<> Box (• flex-row) (• absolute)
                (= anchor (. Anchor parent))
                (= left (call (. PositionOffset coord) (call timeline-x (. mark time) #span #track-width)))
                (= top (call (. PositionOffset coord) 0))
                (= bottom (call (. PositionOffset coord) 0))
                (<> Box (• timeline-tick) (• w 1))
                (<> Label (• timeline-mark-label)
                  (= text (. mark label))
                )
              )
            )
          )
          (for (in lane #lanes)
            (<> TimelineLaneBox
              (= min-height (call (. SizeSpec coord) (call timeline-lane-height (. lane lane) #row-height)))
              (= max-height (call (. SizeSpec coord) (call timeline-lane-height (. lane lane) #row-height)))
              (= view this)
              (= items (. lane items))
              (= markers (. lane markers))
              (blank)
              (<> Box (slot: content) (param: item-box) (• flex-row) (• flex 1)
                (+<> Box (id: content) (param: item-box TimelineItemBox) (• flex-row) (• flex 1)
                  (<> TimelineItemBody (• flex-row) (• flex 1)
                    (= is-selected (. item-box #item is-selected))
                    (<> Label (• timeline-item-label) (• flex 1)
                      (= text (. item-box #item label))
                    )
                  )
                )
              )
            )
          )
          (if (!= #time null)
            (<> Box (• timeline-time) (• absolute) (• w 2)
              (= anchor (. Anchor parent))
              (= layer "adornments")
              (= left (call (. PositionOffset coord) (- (call timeline-x (!! #time) #span #track-width) 1)))
              (= top (call (. PositionOffset coord) 0))
              (= bottom (call (. PositionOffset coord) 0))
            )
          )
          (if (!= #snap-time null)
            (<> Box (• timeline-snap) (• absolute) (• w 1)
              (= anchor (. Anchor parent))
              (= layer "adornments")
              (= left (call (. PositionOffset coord) (call timeline-x (!! #snap-time) #span #track-width)))
              (= top (call (. PositionOffset coord) 0))
              (= bottom (call (. PositionOffset coord) 0))
            )
          )
        )
      )
    )
  )
  (subscribe-for (on event magnify)
    (= zoom (call max 1.0 (call min 400.0 (* zoom (. event scale)))))
    (call (. event cancel))
  )
  (fn-do + did-layout _
    (call (. super did-layout))
    (= viewport (. scroller content-bounds width))
  )
  (fn-do _ begin-seek _
    (param pointer U64)
    (param x Length)
    (= seeking true)
    (= seeking-pointer pointer)
    (call seek-at x)
  )
  (fn-do _ continue-seek _
    (param pointer U64)
    (param x Length)
    (return-if (if (or (not seeking) (!= pointer seeking-pointer))))
    (call seek-at x)
  )
  (fn-do _ end-seek _
    (param pointer U64)
    (return-if (if (!= pointer seeking-pointer)))
    (= seeking false)
  )
  (fn-do _ seek-at _
    (param x Length)
    (return-if (if (<= track-width 0)))
    (let ratio (call max 0.0 (call min 1.0 (/ x track-width))))
    (let sought (as (call round (* ratio (as span F64))) I64))
    (<- seek-requested sought)
  )
  (fn-do _ press-item _
    (param item TimelineItem)
    (param event PointerDownEvent)
    (param resizes Bool)
    (return-if (if (!= (. event button) (. PointerButton primary))))
    (call (. event cancel))
    (<- item-chosen (. item id))
    (= pressed item)
    (= press-pointer (. event pointer-id))
    (= press-x (. event root-point x))
    (= press-resizes resizes)
    (= press-snaps (. data snaps))
    (= drag-x press-x)
    (= dragging false)
  )
  (fn-do _ drag-item _
    (param event PointerDragEvent)
    (call (. event cancel))
    (let item pressed)
    (return-if (if (or (not item) (!= (. event pointer-id) press-pointer))))
    (return-if (if (not (if-expr press-resizes (. item resizable) (. item movable)))))
    (let x (. event root-point x))
    (= drag-x x)
    (if dragging
      (call publish-drag item (. ValueChangePhase changed))
      (return)
    )
    (return-if (if (< (call abs (- x press-x)) timeline-drag-threshold)))
    (= dragging true)
    (call publish-drag item (. ValueChangePhase began))
  )
  (fn-do _ release-item _
    (param pointer U64)
    (return-if (if (!= pointer press-pointer)))
    (let item pressed)
    (= pressed null)
    (if (and item dragging)
      (= dragging false)
      (call publish-drag item (. ValueChangePhase ended))
    )
    (= snap-time null)
  )
  (fn-do _ publish-drag _
    (param item TimelineItem)
    (param phase ValueChangePhase)
    (return-if (if (<= track-width 0)))
    (let edge (if-expr press-resizes (. item end) (. item start)))
    (let moved (as (call round (* (as (/ (- drag-x press-x) track-width) F64) (as span F64))) I64))
    (let sought (+ edge moved))
    (let snapped (call timeline-nearest press-snaps sought span track-width))
    (let shift (if-expr (!= snapped null) (- snapped edge) moved))
    (= snap-time (only-if snapped (if (!= phase (. ValueChangePhase ended)))))
    (<- item-dragged (call TimelineDrag (. item id) press-resizes shift snapped phase))
  )
)

(type + TimelineLaneBox (is Box)
  (prop + view TimelineView)
  (prop + items (list TimelineItem) (= (call (of List TimelineItem))))
  (prop + markers (list TimelineMarker) (= (call (of List TimelineMarker))))
  (content
    (<> This
      (for (in item #items (keyed-by (. item id)))
        (<> TimelineItemBox (id: item-box) (• absolute)
          (= min-width (call (. SizeSpec coord) (call timeline-item-width item (. view #span) (. view #track-width))))
          (= max-width (call (. SizeSpec coord) (call timeline-item-width item (. view #span) (. view #track-width))))
          (= min-height (call (. SizeSpec coord) (- (. view #row-height) (* timeline-item-inset 2))))
          (= max-height (call (. SizeSpec coord) (- (. view #row-height) (* timeline-item-inset 2))))
          (= item item)
          (= anchor (. Anchor parent))
          (= left (call (. PositionOffset coord) (call timeline-x (. item start) (. view #span) (. view #track-width))))
          (= top
            (call (. PositionOffset coord)
              (block
                (arg (+ (* (. view #row-height) (as (. item row) Length)) timeline-item-inset))
              )
            )
          )
          (for (on event pointer-down)
            (call (. view press-item) item event false)
          )
          (for (on event pointer-drag)
            (call (. view drag-item) event)
          )
          (for (on event pointer-up)
            (call (. view release-item) (. event pointer-id))
          )
          (blank)
          (+<> Box (id: content) (param: item-box TimelineItemBox) (• flex-row) (• flex 1))
          (if (. item resizable)
            (<> Box (• timeline-item-grip) (• absolute) (• w 6)
              (= anchor (. Anchor parent))
              (= right (call (. PositionOffset coord) 0))
              (= top (call (. PositionOffset coord) 0))
              (= bottom (call (. PositionOffset coord) 0))
              (for (on event pointer-down)
                (call (. view press-item) item event true)
              )
              (for (on event pointer-drag)
                (call (. view drag-item) event)
              )
              (for (on event pointer-up)
                (call (. view release-item) (. event pointer-id))
              )
            )
          )
        )
      )
      (for (in marker #markers)
        (<> Box (• flex-row) (• absolute)
          (= anchor (. Anchor parent))
          (= left (call (. PositionOffset coord) (call timeline-x (. marker time) (. view #span) (. view #track-width))))
          (= top (call (. PositionOffset coord) 0))
          (= bottom (call (. PositionOffset coord) 0))
          (<> Box (• timeline-marker) (• w 2))
          (<> Label (• timeline-marker-label)
            (= text (. marker label))
          )
        )
      )
    )
  )
)

(type + TimelineItemBox (is Box)
  (prop + item TimelineItem)
)

(type + TimelineItemBody (is Box)
  (prop + is-selected _ (= false))
)

(fn-expr _ timeline-lane-views (list TimelineLaneView)
  (param data TimelineData)
  (call (of List TimelineLaneView) (in (call timeline-lane-view data each) (..< 0 (. data lanes length))))
)

(fn-expr _ timeline-lane-view TimelineLaneView
  (param data TimelineData)
  (param lane Index)
  (call TimelineLaneView ([] (. data lanes) lane) items markers)
  (where
    (lazy items
      (block
        (spread (. data items))
        (pipe ?> (== (. each lane) lane))
        (pipe |> List)
      )
    )
    (lazy markers
      (block
        (spread (. data markers))
        (pipe ?> (== (. each lane) lane))
        (pipe |> List)
      )
    )
  )
)

(fn-expr _ timeline-marks (list TimelineMark)
  (param span I64)
  (param width Length)
  (param scale (? TimelineScale))
  (if-expr scale (call (. scale marks) span width) (call (of List TimelineMark)))
)

(fn-do _ timeline-nearest (? I64)
  (param snaps (list I64))
  (param time I64)
  (param span I64)
  (param width Length)
  (let found (? I64))
  (let closest timeline-snap-distance)
  (for (in snap snaps)
    (let distance (call abs (- (call timeline-x snap span width) (call timeline-x time span width))))
    (if (<= distance closest)
      (= closest distance)
      (= found snap)
    )
  )
  (return found)
)

(fn-expr _ timeline-span I64
  (param duration I64)
  (call max (+ duration (/ duration 20)) 1)
)

(fn-expr _ timeline-x Length
  (param time I64)
  (param span I64)
  (param width Length)
  (* width (as (/ (as time F64) (as span F64)) Length))
)

(fn-expr _ timeline-item-width Length
  (param item TimelineItem)
  (param span I64)
  (param width Length)
  (call max
    (block
      (arg timeline-min-item-width)
      (arg (- (call timeline-x (. item end) span width) (call timeline-x (. item start) span width)))
    )
  )
)

(fn-expr _ timeline-lane-height Length
  (param lane TimelineLane)
  (param row-height Length)
  (* row-height (as (. lane rows) Length))
)
