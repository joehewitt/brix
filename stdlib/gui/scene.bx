  (fn-do _ record-indicator-items _
    (param chunk DisplayChunk)
    (let color (. chunk owner retained-scroll-indicator-color))
    (let horizontal (call (. chunk owner scroll-indicator-bounds) (. Orientation horizontal)))
    (if (and (> (. horizontal width) 0) (> (. horizontal height) 0))
      (let horizontal-shape (as (. chunk shapes length) U32))
      (+= (. chunk shapes) (call display-shape (call gui-scroll-indicator-outline horizontal) null))
      (let horizontal-item
        (call (. chunk add-item)
          (block
            (arg (call indicator-display-item horizontal color horizontal-shape))
            (arg horizontal)
          )
        )
      )
      (call (. chunk set-item-color) horizontal-item color)
    )
    (let vertical (call (. chunk owner scroll-indicator-bounds) (. Orientation vertical)))
    (if (and (> (. vertical width) 0) (> (. vertical height) 0))
      (let vertical-shape (as (. chunk shapes length) U32))
      (+= (. chunk shapes) (call display-shape (call gui-scroll-indicator-outline vertical) null))
      (let vertical-item
        (call (. chunk add-item)
          (block
            (arg (call indicator-display-item vertical color vertical-shape))
            (arg vertical)
          )
        )
      )
      (call (. chunk set-item-color) vertical-item color)
    )
  )
  (fn-expr _ indicator-display-item _
    (param bounds Rect)
    (param color RGBA)
    (param shape-index U32)
    (call DisplayItem
      (block
        (arg (. DisplayItemKind quad))
        (arg display-item-has-shape)
        (arg 0)
        (arg (as (. bounds x) F32))
        (arg (as (. bounds y) F32))
        (arg (as (. bounds width) F32))
        (arg (as (. bounds height) F32))
        (arg (as (. (call gui-scroll-indicator-outline bounds) effective-radius) F32))
        (arg (call pack-rgba8 color))
        (arg shape-index)
        (arg 0)
        (arg 0)
      )
    )
  )
  (fn-do _ update-indicator-items _
    (param chunk DisplayChunk)
    (let horizontal (call (. chunk owner scroll-indicator-bounds) (. Orientation horizontal)))
    (let has-horizontal (and (> (. horizontal width) 0) (> (. horizontal height) 0)))
    (let vertical (call (. chunk owner scroll-indicator-bounds) (. Orientation vertical)))
    (let has-vertical (and (> (. vertical width) 0) (> (. vertical height) 0)))
    (let next-count Size)
    (if has-horizontal
      (+= next-count 1)
    )
    (if has-vertical
      (+= next-count 1)
    )
    (if (!= next-count (. chunk indicator-count))
      (call rebuild-chunk chunk)
      (return)
    )
    (blank)
    (let old (. chunk bounds))
    (let had-old (. chunk has-bounds))
    (let exact (. chunk owner retained-scroll-indicator-color))
    (let index (. chunk indicator-start))
    (= (. chunk cull-index) null)
    (if has-horizontal
      (let horizontal-shape (. ([] (. chunk items) index) data1))
      (= ([] (. chunk shapes) horizontal-shape) (call display-shape (call gui-scroll-indicator-outline horizontal) null))
      (= ([] (. chunk items) index) (call indicator-display-item horizontal exact horizontal-shape))
      (call (. chunk set-item-color) (as index U32) exact)
      (+= index 1)
    )
    (if has-vertical
      (let vertical-shape (. ([] (. chunk items) index) data1))
      (= ([] (. chunk shapes) vertical-shape) (call display-shape (call gui-scroll-indicator-outline vertical) null))
      (= ([] (. chunk items) index) (call indicator-display-item vertical exact vertical-shape))
      (call (. chunk set-item-color) (as index U32) exact)
    )
    (= (. chunk bounds) display-no-rect)
    (= (. chunk has-bounds) false)
    (let item-index Size)
    (while (< item-index (. chunk items length))
      (call (. chunk add-ink) (call display-item-rect ([] (. chunk items) item-index)))
      (+= item-index 1)
    )
    (if had-old
      (call add-damage (call window-bounds old (. chunk parent)))
    )
    (if (. chunk has-bounds)
      (call add-damage (call window-bounds (. chunk bounds) (. chunk parent)))
    )
    (if (or (!= had-old (. chunk has-bounds)) (!= old (. chunk bounds)))
      (call schedule-group-refresh (. chunk parent))
    )
  )
  (fn-do _ build-box _
    (param box Box)
    (param members (list DisplayEntry))
    (param parent-visible Bool)
    (param parent (? DisplayGroup) (= null))
    (let visible (and parent-visible (. box is-display-visible)))
    (if (not visible)
      (call (. box clear-retained-paint-invalidation))
      (= (. box $is-paint-invalid) false)
      (= (. box $is-paint-invalid-below) false)
      (return)
    )
    (+= boxes-visited 1)
    (let old (call node-for box))
    (let node (call DisplayBoxNode box))
    (call link-node node parent)
    (call (. box set-retained-scene-node) (as node Pointer) generation)
    (if (. box is-markup-shadow)
      (call place-children box members visible true parent)
      (call (. box clear-retained-paint-invalidation))
      (= (. box $is-paint-invalid) false)
      (= (. box $is-paint-invalid-below) false)
      (return)
    )
    (blank)
    (let box-members members)
    (let box-parent parent)
    (let layer-group (? DisplayGroup))
    (if (call display-box-needs-layer box)
      (let group (call DisplayGroup box parent))
      (= (. group is-layer) true)
      (= (. group live-epoch) (?? (?. (?. old layer-group) live-epoch) ([] kept-group-epochs (call display-live-key box 0))))
      (call refresh-group-properties group)
