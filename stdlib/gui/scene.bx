    (blank)
    (let pre (call acquire-chunk box (. DisplayPhase pre)))
    (= (. pre live-epoch) (?? (?. (?. old pre) live-epoch) ([] kept-chunk-epochs (call display-live-key box (. DisplayPhase pre)))))
    (call record-chunk pre)
    (call append-chunk pre box-members node true box-parent)
    (blank)
    (if (call display-box-needs-group box)
      (let group (call DisplayGroup box box-parent))
      (= (. node group) group)
      (call refresh-group-properties group)
      (call place-children box (. group members) visible true group)
      (call finalize-group group)
      (if (> (. group members length) 0)
        (probe-count gui.scene.groups-built)
        (+= box-members (call DisplayEntry null group))
      )
      (else
        (call place-children box box-members visible true box-parent)
      )
    )
    (blank)
    (let post (call acquire-chunk box (. DisplayPhase post)))
    (= (. post live-epoch)
      (scope (?? (?. (?. old post) live-epoch) kept-epoch)
        (lazy kept-epoch ([] kept-chunk-epochs (call display-live-key box (. DisplayPhase post))))
      )
    )
    (call record-chunk post)
    (call append-chunk post box-members node false box-parent (. box has-retained-scroll-indicator))
    (if layer-group
      (let group layer-group)
      (call finalize-group group)
      (if (> (. group members length) 0)
        (probe-count gui.scene.groups-built)
        (+= members (call DisplayEntry null group))
      )
    )
    (call (. box clear-transparent-paint-state))
    (call (. box clear-retained-paint-invalidation))
    (call (. box clear-retained-presentation-invalidation))
    (= (. box $is-paint-invalid) false)
    (= (. box $is-paint-invalid-below) false)
  )
  (fn-do _ append-chunk _
    (param chunk DisplayChunk)
    (param members (list DisplayEntry))
    (param node DisplayBoxNode)
    (param is-pre Bool)
    (param parent (? DisplayGroup) (= null))
    (param force _ (= false))
    (if (and (not force) (call display-chunk-is-empty chunk))
      (call spare-empty-chunk chunk)
      (return)
    )
    (= (. chunk parent) parent)
    (if is-pre
      (= (. node pre) chunk)
      (else
        (= (. node post) chunk)
      )
    )
    (probe-count gui.scene.chunks-built)
    (+= items-built (. chunk items length))
    (+= members (call DisplayEntry chunk null))
  )
  (fn-do _ update-box Bool
    (param box Box)
    (param parent-visible Bool)
    (+= boxes-visited 1)
    (let visible (and parent-visible (. box is-display-visible)))
    (if (not visible)
      (let had-node (!= (call node-for box) null))
      (call (. box clear-retained-paint-invalidation))
      (= (. box $is-paint-invalid) false)
      (= (. box $is-paint-invalid-below) false)
      (return had-node)
    )
    (let node (call node-for box))
    (return-if true (if (not node)))
    (blank)
    (let layer-toggled (!= (call display-box-needs-layer box) (!= (. node layer-group) null)))
    (let group-needed (and (not (. box is-markup-shadow)) (== (. node group) null) (call display-box-needs-group box)))
    (call (. box clear-retained-presentation-invalidation))
    (blank)
    (if (and (. node layer-group) (not layer-toggled))
      (let layer-group (. node layer-group))
      (let old-opacity (. layer-group opacity))
      (let old-filters (. layer-group filters))
      (let old-region (. layer-group region))
      (let old-transform (. layer-group transform))
      (call refresh-group-properties layer-group)
      (let has-filters (> (. layer-group filters length) 0))
      (let region-changed (and has-filters (!= old-region (. layer-group region))))
      (let filter-changed (or (not (call display-filters-equal old-filters (. layer-group filters))) region-changed))
      (let transform-changed (not (call display-matrices-equal old-transform (. layer-group transform))))
      (if (or (!= old-opacity (. layer-group opacity)) filter-changed transform-changed)
        (if (. layer-group has-outer)
          (call add-damage (call window-bounds (. layer-group outer) (. layer-group parent)))
        )
        (if transform-changed
          (probe-count gui.scene.layer-retransforms)
          (call place-layer-outer layer-group)
          (call advance-group-generation layer-group)
          (if (. layer-group has-outer)
            (call add-damage (call window-bounds (. layer-group outer) (. layer-group parent)))
          )
        )
        (if has-filters
          (call add-damage (call window-bounds (. layer-group region) (. layer-group parent)))
        )
        (call schedule-group-refresh layer-group)
      )
    )
    (blank)
    (let translation-changed false)
    (if (. node group)
      (let group (. node group))
      (let old-rounded-clip (. group rounded-clip))
      (let old-clip (. group clip))
      (let old-has-clip (. group has-clip))
      (let old-shape-clip (. group shape-clip-revision))
      (let old-translation (. group translation))
      (let old-outer (. group outer))
      (let old-has-outer (. group has-outer))
      (call refresh-group-properties group)
      (let clip-changed (!= old-rounded-clip (. group rounded-clip)))
      (= clip-changed (or clip-changed (!= old-clip (. group clip))))
      (= clip-changed (or clip-changed (!= old-has-clip (. group has-clip))))
      (= clip-changed (or clip-changed (!= old-shape-clip (. group shape-clip-revision))))
      (= translation-changed (or clip-changed (!= old-translation (. group translation))))
      (if translation-changed
        (probe-count gui.scene.transform-updates)
        (if clip-changed
          (call finalize-group group)
          (else
            (call advance-group-generation group)
          )
        )
        (if old-has-outer
          (call add-damage (call window-bounds old-outer (. group parent)))
        )
        (if (. group has-outer)
          (call add-damage (call window-bounds (. group outer) (. group parent)))
        )
        (call schedule-group-refresh (. group parent))
      )
    )
    (blank)
    (let entries-changed false)
    (let legacy-self-paint (and (. box $is-paint-invalid) (not (. box is-retained-paint-invalid-below))))
    (if (or (. box is-retained-paint-invalid) legacy-self-paint)
      (if (. box is-retained-move-only-invalidation)
        (call retain-moved-node node)
        (else-if (and (. box is-retained-transform-only-invalidation) (call retain-transformed-node node))
          (probe-count gui.scene.chunks-retransformed)
        )
        (else-if (not (. box is-markup-shadow))
          (let scroll-only (and translation-changed (. box is-retained-scroll-only-invalidation)))
          (= scroll-only (and scroll-only (not (. box $is-paint-invalid))))
          (if (and (not scroll-only) (call update-node-chunk node true))
            (= entries-changed true)
          )
          (let post (. node post))
          (if (and post scroll-only)
            (call update-indicator-items post)
            (else-if (or (not scroll-only) (. box has-retained-scroll-indicator))
              (if (call update-node-chunk node false)
                (= entries-changed true)
              )
            )
          )
          (= (. node recorded-origin) (. box bounds top-left))
        )
      )
      (call (. box clear-retained-self-paint-invalidation))
      (= (. box $is-paint-invalid) false)
    )
    (blank)
    (let children-changed (!= (. node child-list-generation) (. box retained-child-list-generation)))
    (if (or children-changed (. box is-retained-paint-invalid-below) (. box $is-paint-invalid-below))
      (let relink children-changed)
      (let listed (and (not children-changed) (> (. box retained-paint-dirty-child-count) 0)))
      (if children-changed
        (call update-current-children box visible)
        (else-if listed
          (= relink (call update-listed-children box visible))
        )
        (else
          (= relink (call update-dirty-children box visible))
        )
      )
      (= relink (or relink (. node composite-relink)))
      (if (and relink (or (not (. node group)) (call relink-children box node visible)))
        (= entries-changed true)
      )
      (if listed
        (call (. box clear-listed-shadow-paint-state))
        (else
          (call (. box clear-transparent-paint-state))
        )
      )
      (call (. box clear-retained-paint-invalidation))
      (= (. box $is-paint-invalid-below) false)
    )
    (return (or entries-changed layer-toggled group-needed))
  )
  (fn-do _ update-listed-children _
    (param box Box)
    (param visible Bool)
    (let changed false)
    (let dirty-count (. box retained-paint-dirty-child-count))
    (let dirty-index Size)
    (while (< dirty-index dirty-count)
      (let dirty-child (call (. box retained-paint-dirty-child) dirty-index))
      (if (and dirty-child (call update-child dirty-child visible))
        (= changed true)
      )
      (+= dirty-index 1)
    )
    (return changed)
  )
  (fn-do _ update-dirty-children _
    (param box Box)
    (param visible Bool)
    (let changed false)
    (let child (. box retained-rendered-first-child))
    (while child
      (let next (call (. box retained-rendered-next-child) child))
      (if (and (call display-box-is-dirty child) (call update-child child visible))
        (= changed true)
      )
      (= child next)
    )
    (return changed)
  )
  (fn-do _ update-current-children _
    (param box Box)
    (param visible Bool)
    (let child (. box retained-rendered-first-child))
    (while child
      (let next (call (. box retained-rendered-next-child) child))
      (if (call display-box-is-dirty child)
        (let ignored (call update-child child visible))
      )
      (= child next)
    )
  )
  (fn-do _ update-child Bool
    (param child Box)
    (param visible Bool)
    (let host (. child composite-host))
    (return-if (call update-box child visible) (if (not host)))
    (return-if false (if (not (call update-box child visible))))
    (blank)
    (let host-node (call node-for host))
    (let root scene-root)
    (if (and (not host-node) root)
      (= host-node (call node-for root))
    )
    (if host-node
      (= (. host-node composite-relink) true)
    )
    (return false)
  )
  (fn-do _ update-node-chunk _
    (param node DisplayBoxNode)
    (param is-pre Bool)
    (let box (. node owner))
    (let forced (and (not is-pre) (. box has-retained-scroll-indicator)))
    (let existing (if-expr is-pre (. node pre) (. node post)))
    (if existing
      (call rebuild-chunk existing)
      (return-if false (if (or forced (not (call display-chunk-is-empty existing)))))
      (blank)
      (call release-chunk-glyph-handles existing)
      (call release-chunk-key existing)
      (if is-pre
        (= (. node pre) null)
        (else
          (= (. node post) null)
        )
      )
      (return (not (call unsplice-chunk existing)))
    )
    (probe-count gui.scene.missing-chunk-recordings)
    (let candidate (call acquire-chunk box (if-expr is-pre (. DisplayPhase pre) (. DisplayPhase post))))
    (call record-chunk candidate)
    (if (and (not forced) (call display-chunk-is-empty candidate))
      (call spare-empty-chunk candidate)
      (return false)
    )
    (if is-pre
      (= (. node pre) candidate)
      (else
        (= (. node post) candidate)
      )
    )
    (return (not (call splice-chunk node candidate is-pre)))
  )
  (fn-do _ acquire-chunk DisplayChunk
    (param box Box)
    (param phase U8)
    (let chunk (?? spare-chunk (call DisplayChunk box phase)))
    (= spare-chunk null)
    (= (. chunk owner) box)
    (= (. chunk phase) phase)
    (= (. chunk parent) null)
    (return chunk)
  )
  (fn-do _ spare-empty-chunk _
    (param chunk DisplayChunk)
    (return-if (if (. chunk is-live)))
    (blank)
    (call release-chunk-glyph-handles chunk)
    (= spare-chunk chunk)
  )
  (fn-do _ splice-chunk Bool
    (param node DisplayBoxNode)
    (param chunk DisplayChunk)
    (param is-pre Bool)
    (let group (?? (. node layer-group) (. node container)))
    (let members (if-expr group (. group members) roots))
    (return-if false (if (== (. members length) 0)))
    (blank)
    (let anchor (if-expr is-pre (call leading-anchor node) (call trailing-anchor node)))
    (return-if false (if (not (. anchor known))))
    (blank)
    (let entry (. anchor entry))
    (return-if false (if (not entry)))
    (blank)
    (let index (call display-entry-index members entry))
    (return-if false (if (not index)))
    (blank)
    (= (. chunk parent) group)
    (call (. members insert) (call DisplayEntry chunk null) (if-expr is-pre index (+ index 1)))
    (probe-count gui.scene.chunks-spliced)
    (if (. chunk has-bounds)
      (call add-damage (call window-bounds (. chunk bounds) group))
    )
    (call schedule-group-refresh group)
    (return true)
  )
  (fn-do _ unsplice-chunk Bool
    (param chunk DisplayChunk)
    (let group (. chunk parent))
    (let members (if-expr group (. group members) roots))
    (let index (call display-entry-index members (call DisplayEntry chunk null)))
    (return-if false (if (not index)))
    (blank)
    (call (. members remove) index)
    (return-if false (if (and group (== (. members length) 0))))
    (blank)
    (probe-count gui.scene.chunks-unspliced)
    (call schedule-group-refresh group)
    (return true)
  )
  (fn-expr _ leading-anchor DisplayAnchor
    (param node DisplayBoxNode)
    (if-expr (or (not (. inner known)) (. inner entry)) inner (call display-chunk-anchor (. node post)))
    (where
      (lazy inner (call inner-first-anchor (. node owner) node))
    )
  )
  (fn-expr _ trailing-anchor DisplayAnchor
    (param node DisplayBoxNode)
    (if-expr (or (not (. inner known)) (. inner entry)) inner (call display-chunk-anchor (. node pre)))
    (where
      (lazy inner (call inner-last-anchor (. node owner) node))
    )
  )
  (fn-expr _ subtree-first-anchor DisplayAnchor
    (param box Box)
    (case? (not (. box is-display-visible))
      display-no-anchor
    )
    (case? (not node)
      display-unknown-anchor
    )
    (case? layer
      (call display-group-anchor layer)
    )
    (case? (. node pre)
      (call display-chunk-anchor (. node pre))
    )
    (case? (or (not (. inner known)) (. inner entry))
      inner
    )
    (default
      (call display-chunk-anchor (. node post))
    )
    (where
      (lazy node (call node-for box))
      (lazy layer (. node layer-group))
      (lazy inner (call inner-first-anchor box node))
    )
  )
  (fn-expr _ subtree-last-anchor DisplayAnchor
    (param box Box)
    (case? (not (. box is-display-visible))
      display-no-anchor
    )
    (case? (not node)
      display-unknown-anchor
    )
    (case? layer
      (call display-group-anchor layer)
    )
    (case? (. node post)
      (call display-chunk-anchor (. node post))
    )
    (case? (or (not (. inner known)) (. inner entry))
      inner
    )
    (default
      (call display-chunk-anchor (. node pre))
    )
    (where
      (lazy node (call node-for box))
      (lazy layer (. node layer-group))
      (lazy inner (call inner-last-anchor box node))
    )
  )
  (fn-do _ inner-first-anchor DisplayAnchor
    (param box Box)
    (param node DisplayBoxNode)
    (let group (. node group))
    (return-if (call display-group-anchor group) (if group))
    (return-if display-unknown-anchor (if (. box composite-state)))
    (blank)
    (let child (. box retained-rendered-first-child))
    (while child
      (let current child)
      (if (not (. current is-composite-routed))
        (let anchor (call subtree-first-anchor current))
        (return-if anchor (if (or (not (. anchor known)) (. anchor entry))))
      )
      (= child (call (. box retained-rendered-next-child) current))
    )
    (return display-no-anchor)
  )
  (fn-do _ inner-last-anchor DisplayAnchor
    (param box Box)
    (param node DisplayBoxNode)
    (let group (. node group))
    (return-if (call display-group-anchor group) (if group))
    (return-if display-unknown-anchor (if (. box composite-state)))
    (blank)
    (let child (. box retained-rendered-last-child))
    (while child
      (let current child)
      (if (not (. current is-composite-routed))
        (let anchor (call subtree-last-anchor current))
        (return-if anchor (if (or (not (. anchor known)) (. anchor entry))))
      )
      (= child (call (. box retained-rendered-previous-child) current))
    )
    (return display-no-anchor)
  )
  (fn-do _ relink-children Bool
    (param box Box)
    (param node DisplayBoxNode)
    (param visible Bool)
    (let group (!! (. node group)))
    (let was-empty (== (. group members length) 0))
    (let refill (call begin-refill group))
    (= (. node composite-relink) false)
    (call place-children box (. group members) visible false group)
    (call finish-refill group refill)
    (= (. node child-list-generation) (. box retained-child-list-generation))
    (return (!= was-empty (== (. group members length) 0)))
  )
  (fn-do _ relink-roots _
    (param tree-root Box)
    (let previous roots)
    (= roots (call (of List DisplayEntry)))
    (let old-nodes root-nodes)
    (= root-nodes (call (of List DisplayBoxNode)))
    (= root-refill-stamp (call next-refill-stamp))
    (call link-box tree-root roots true null)
    (for (in node old-nodes)
      (if (and (not (. node container)) (!= (. node link-stamp) root-refill-stamp))
        (call drop-node node)
      )
    )
    (call damage-refill previous roots root-refill-stamp)
    (+= relinks 1)
    (= root-order-refresh-pending true)
  )
  (fn-do _ link-box _
    (param box Box)
    (param members (list DisplayEntry))
    (param parent-visible Bool)
    (param parent (? DisplayGroup))
    (let visible (and parent-visible (. box is-display-visible)))
    (if (not visible)
      (call (. box clear-retained-paint-invalidation))
      (= (. box $is-paint-invalid) false)
      (= (. box $is-paint-invalid-below) false)
      (return)
    )
    (let node (call node-for box))
    (if (not node)
      (call build-box box members visible parent)
      (return)
    )
    (call link-node node parent)
    (blank)
    (if (. box is-markup-shadow)
      (call link-children box members visible parent)
      (= (. node child-list-generation) (. box retained-child-list-generation))
      (return)
    )
    (blank)
    (let needs-layer (call display-box-needs-layer box))
    (if (and needs-layer (not (. node layer-group)))
      (let group (call DisplayGroup box parent))
      (= (. group is-layer) true)
      (call refresh-group-properties group)
      (= (. node layer-group) group)
      (probe-count gui.scene.layers-wrapped)
      (else-if (and (not needs-layer) (. node layer-group))
        (= (. node layer-group) null)
        (probe-count gui.scene.layers-unwrapped)
      )
    )
    (let layer-group (. node layer-group))
    (if layer-group
      (let refill (call begin-refill layer-group))
      (call adopt-group layer-group parent)
      (call link-box-entries box node (. layer-group members) visible layer-group)
      (call finish-refill layer-group refill)
      (if (> (. layer-group members length) 0)
        (+= members (call DisplayEntry null layer-group))
      )
      (else
        (call link-box-entries box node members visible parent)
      )
    )
  )
  (fn-do _ adopt-group _
    (param group DisplayGroup)
    (param parent (? DisplayGroup))
    (= (. group parent) parent)
    (if (. group refresh-pending)
      (call schedule-group-refresh parent)
    )
  )
  (fn-do _ link-box-entries _
    (param box Box)
    (param node DisplayBoxNode)
    (param members (list DisplayEntry))
    (param visible Bool)
    (param parent (? DisplayGroup))
    (let pre (. node pre))
    (if pre
      (= (. pre parent) parent)
      (+= members (call DisplayEntry pre null))
    )
    (let grouped (and (not (. node group)) (call display-box-needs-group box)))
    (if grouped
      (let created (call DisplayGroup box parent))
      (call refresh-group-properties created)
      (= (. node group) created)
      (probe-count gui.scene.groups-wrapped)
    )
    (let group (. node group))
    (if group
      (call adopt-group group parent)
      (let children-changed (!= (. node child-list-generation) (. box retained-child-list-generation)))
      (if children-changed
        (call update-current-children box visible)
      )
      (if (or children-changed grouped)
        (let ignored (call relink-children box node visible))
      )
      (if (> (. group members length) 0)
        (+= members (call DisplayEntry null group))
      )
      (else
        (call link-children box members visible parent)
        (= (. node child-list-generation) (. box retained-child-list-generation))
      )
    )
    (let post (. node post))
    (if post
      (= (. post parent) parent)
      (+= members (call DisplayEntry post null))
    )
  )
  (fn-do _ link-children _
    (param box Box)
    (param members (list DisplayEntry))
    (param visible Bool)
    (param parent (? DisplayGroup))
    (call place-children box members visible false parent)
  )
  (fn-do _ place-children _
    (param box Box)
    (param members (list DisplayEntry))
    (param visible Bool)
    (param building Bool)
    (param parent (? DisplayGroup))
    (let record (. box composite-state))
    (if record
      (call place-routed members visible building parent (. record below))
    )
    (let child (. box retained-rendered-first-child))
    (while child
      (let next (call (. box retained-rendered-next-child) child))
      (if (not (. child is-composite-routed))
        (if building
          (call build-box child members visible parent)
          (else
            (call link-box child members visible parent)
          )
        )
      )
      (= child next)
    )
    (if record
      (call place-routed members visible building parent (. record above))
    )
  )
  (fn-do _ place-routed _
    (param members (list DisplayEntry))
    (param visible Bool)
    (param building Bool)
    (param parent (? DisplayGroup))
    (param routed (? (list Box)))
    (return-if (if (not routed)))
    (blank)
    (for (in member routed)
      (if building
        (call build-box member members visible parent)
        (else
          (call link-box member members visible parent)
        )
      )
    )
  )
  (fn-do _ link-node _
    (param node DisplayBoxNode)
    (param parent (? DisplayGroup))
    (= (. node container) parent)
    (if parent
      (+= (. parent nodes) node)
      (= (. node link-stamp) (. parent refill-stamp))
      (else
        (+= root-nodes node)
        (= (. node link-stamp) root-refill-stamp)
      )
    )
  )
  (fn-do _ next-refill-stamp _
    (+= refill-stamp-counter 1)
    (if (not refill-stamp-counter)
      (= refill-stamp-counter 1)
    )
    (return refill-stamp-counter)
  )
  (fn-do _ begin-refill _
    (param group DisplayGroup)
    (let refill (call DisplayRefill (. group nodes) (. group members)))
    (= (. group members) (?? (. group spare-members) (call (of List DisplayEntry))))
    (= (. group nodes) (?? (. group spare-nodes) (call (of List DisplayBoxNode))))
    (= (. group spare-members) null)
    (= (. group spare-nodes) null)
    (= (. group refill-stamp) (call next-refill-stamp))
    (return refill)
  )
  (fn-do _ finish-refill _
    (param group DisplayGroup)
    (param refill DisplayRefill)
    (for (in node (. refill nodes))
      (if (and (!= (. node link-stamp) (. group refill-stamp)) (== (as (. node container) (? Pointer)) (as group (? Pointer))))
        (call drop-node node)
      )
    )
    (call finalize-group group)
    (call damage-refill (. refill members) (. group members) (. group refill-stamp) group)
    (call schedule-group-refresh (. group parent))
    (+= relinks 1)
    (call (. refill members clear))
    (call (. refill nodes clear))
    (= (. group spare-members) (. refill members))
    (= (. group spare-nodes) (. refill nodes))
  )
  (fn-do _ damage-refill _
    (param previous (list DisplayEntry))
    (param current (list DisplayEntry))
    (param stamp U32)
    (param parent (? DisplayGroup) (= null))
    (let index Size)
    (while (< index (. previous length))
      (call mark-previous-entry ([] previous index) stamp index)
      (+= index 1)
    )
    (let reordered false)
    (let has-last false)
    (let last-index Size)
    (for (in entry current)
      (let previous-index (call previous-entry-index entry stamp))
      (call mark-linked-entry entry stamp)
      (if (== previous-index null)
        (call damage-entry entry parent)
        (else
          (= reordered (or reordered (and has-last (< previous-index last-index))))
          (= last-index previous-index)
          (= has-last true)
        )
      )
    )
    (for (in entry previous)
      (if (not (call is-linked-entry entry stamp))
        (call damage-entry entry parent)
      )
    )
    (if reordered
      (for (in entry current)
        (call damage-entry entry parent)
      )
    )
  )
  (fn-do _ damage-entry _
    (param entry DisplayEntry)
    (param parent (? DisplayGroup))
    (call add-damage (call window-bounds (call display-entry-bounds entry) parent))
  )
  (fn-do _ mark-previous-entry _
    (param entry DisplayEntry)
    (param stamp U32)
    (param index Index)
    (let chunk (. entry chunk))
    (let group (. entry group))
    (if chunk
      (= (. chunk refill-mark) stamp)
      (= (. chunk refill-index) index)
      (else-if group
        (= (. group refill-mark) stamp)
        (= (. group refill-index) index)
      )
    )
  )
  (fn-expr _ previous-entry-index _
    (param entry DisplayEntry)
    (param stamp U32)
    (case? chunk
      (only-if (. chunk refill-index) (if (== (. chunk refill-mark) stamp)))
    )
    (case? group
      (only-if (. group refill-index) (if (== (. group refill-mark) stamp)))
    )
    (default
      null
    )
    (where
      (lazy chunk (. entry chunk))
      (lazy group (. entry group))
    )
  )
  (fn-do _ mark-linked-entry _
    (param entry DisplayEntry)
    (param stamp U32)
    (let chunk (. entry chunk))
    (let group (. entry group))
    (if chunk
      (= (. chunk linked-mark) stamp)
      (else-if group
        (= (. group linked-mark) stamp)
      )
    )
  )
  (fn-expr _ is-linked-entry _
    (param entry DisplayEntry)
    (param stamp U32)
    (case? chunk
      (== (. chunk linked-mark) stamp)
    )
    (case? group
      (== (. group linked-mark) stamp)
    )
    (default
      false
    )
    (where
      (lazy chunk (. entry chunk))
      (lazy group (. entry group))
    )
  )
  (fn-do _ detach-node _
    (param node DisplayBoxNode)
    (let current (call node-for (. node owner)))
    (if (and current (== (as current Pointer) (as node Pointer)))
      (call (. node owner set-retained-scene-node) (call Pointer) 0)
    )
  )
  (fn-do _ drop-node _
    (param node DisplayBoxNode)
    (call detach-node node)
    (let pre (. node pre))
    (if pre
      (call release-chunk-glyph-handles pre)
      (call release-chunk-key pre)
    )
    (let post (. node post))
    (if post
      (call release-chunk-glyph-handles post)
      (call release-chunk-key post)
    )
    (let group (. node group))
    (if group
      (call drop-group-shape-clip group)
      (call drop-group-nodes group)
    )
    (let layer-group (. node layer-group))
    (if layer-group
      (= (. layer-group is-live) false)
      (call drop-group-nodes layer-group)
    )
  )
  (fn-do _ drop-group-nodes _
    (param group DisplayGroup)
    (for (in node (. group nodes))
      (if (== (as (. node container) (? Pointer)) (as group (? Pointer)))
        (call drop-node node)
      )
    )
    (call (. group nodes clear))
  )
  (fn-do _ retain-transformed-node _
    (param node DisplayBoxNode)
    (let chunk (. node pre))
    (return-if false (if (or (not chunk) (. chunk is-opaque))))
    (blank)
    (let side (. chunk side))
    (return-if false (if (or (not side) (== (. side content-state) 0))))
    (blank)
    (let transform (. node owner content-transform))
    (return-if false (if (not transform)))
    (blank)
    (let content ([] (. side states) (. side content-state)))
    (= ([] (. side states) (. side content-state)) (= (. content matrix) transform))
    (call (. side refresh-states))
    (let old (. chunk bounds))
    (let had-old (. chunk has-bounds))
    (call (. chunk refresh-bounds))
    (call (. chunk bump-record-generation))
    (if had-old
      (call add-damage (call window-bounds old (. chunk parent)))
    )
    (if (. chunk has-bounds)
      (call add-damage (call window-bounds (. chunk bounds) (. chunk parent)))
    )
    (if (or (!= had-old (. chunk has-bounds)) (!= old (. chunk bounds)))
      (call schedule-group-refresh (. chunk parent))
    )
    (return true)
  )
  (fn-do _ retain-moved-node _
    (param node DisplayBoxNode)
    (let current-origin (. node owner bounds top-left))
    (let delta (- current-origin (. node recorded-origin)))
    (if (!= delta (call Point 0 0))
      (if (. node pre)
        (call retain-moved-chunk (. node pre) delta)
      )
      (if (. node post)
        (call retain-moved-chunk (. node post) delta)
      )
    )
    (= (. node recorded-origin) current-origin)
  )
  (fn-do _ retain-moved-chunk _
    (param chunk DisplayChunk)
    (param delta Point)
    (let side (. chunk side))
    (let side-unshiftable
      (scope (and (!= side null) (or has-styles (> (. side gradient-wires length) 0)))
        (lazy has-styles (or (> (. side states length) 1) (> (. side styled-wires length) 0)))
      )
    )
    (let unshiftable (or (. chunk needs-tile) side-unshiftable))
    (if (or (. chunk is-opaque) unshiftable)
      (probe-count gui.scene.opaque-move-fallbacks)
      (call rebuild-chunk chunk)
      (else
        (call rebase-chunk chunk delta)
      )
    )
  )
  (fn-do _ rebase-chunk _
    (param chunk DisplayChunk)
    (param delta Point)
    (let old (. chunk bounds))
    (let had-old (. chunk has-bounds))
    (let dx (as (. delta x) F32))
    (let dy (as (. delta y) F32))
    (let item-index Size)
    (while (< item-index (. chunk items length))
      (let item ([] (. chunk items) item-index))
      (= ([] (. chunk items) item-index)
        (call DisplayItem
          (block
            (arg (. item kind))
            (arg (. item flags))
            (arg (. item aux))
            (arg (+ (. item x) dx))
            (arg (+ (. item y) dy))
            (arg (. item width))
            (arg (. item height))
            (arg (. item value))
            (arg (. item data0))
            (arg (. item data1))
            (arg (. item data2))
            (arg (. item data3))
          )
        )
      )
      (+= item-index 1)
    )
    (let clip-index Size)
    (while (< clip-index (. chunk clips length))
      (= ([] (. chunk clips) clip-index) (+ ([] (. chunk clips) clip-index) delta))
      (+= clip-index 1)
    )
    (let known-exacts (. chunk exacts))
    (if known-exacts
      (let exact-index Size)
      (while (< exact-index (. known-exacts rects length))
        (= ([] (. known-exacts rects) exact-index) (+ ([] (. known-exacts rects) exact-index) delta))
        (+= exact-index 1)
      )
    )
    (= (. chunk cull-index) null)
    (let side (. chunk side))
    (if side
      (if (. side has-prefix-bounds)
        (= (. side prefix-bounds) (+ (. side prefix-bounds) delta))
      )
      (if (. side has-root-ink)
        (= (. side root-ink) (+ (. side root-ink) delta))
      )
      (let ink-index Size)
      (while (< ink-index (. side item-inks length))
        (let ink ([] (. side item-inks) ink-index))
        (if (and (>= (. ink width) 0) (>= (. ink height) 0))
          (= ([] (. side item-inks) ink-index) (+ ink delta))
        )
        (+= ink-index 1)
      )
      (let transform-index Size)
      (while (< transform-index (. side transforms length))
        (let matrix ([] (. side transforms) transform-index))
        (= ([] (. side transforms) transform-index)
          (call Matrix
            (block
              (arg (. matrix a))
              (arg (. matrix c))
              (arg (. matrix b))
              (arg (. matrix d))
              (arg (+ (. matrix tx) (. delta x)))
              (arg (+ (. matrix ty) (. delta y)))
            )
          )
        )
        (+= transform-index 1)
      )
    )
    (let kept (. chunk commands))
    (if kept
      (let command-index Size)
      (while (< command-index (. kept length))
        (= ([] kept command-index) (call rebase-command ([] kept command-index) delta))
        (+= command-index 1)
      )
    )
    (if (. chunk has-bounds)
      (= (. chunk bounds) (+ (. chunk bounds) delta))
    )
    (probe-count gui.scene.eligible-move-rebases)
    (if had-old
      (call add-damage (call window-bounds old (. chunk parent)))
    )
    (if (. chunk has-bounds)
      (call add-damage (call window-bounds (. chunk bounds) (. chunk parent)))
    )
    (call schedule-group-refresh (. chunk parent))
  )
  (fn-do _ rebase-command _
    (param command DisplayCommand)
    (param delta Point)
    (let rect (. command rect))
    (let tile-origin (. command point1))
    (let kind (. command kind))
    (if (or (== kind (. DisplayCommandKind rect)) (== kind (. DisplayCommandKind text)) is-image)
      (= rect (+ rect delta))
      (else-if (== kind (. DisplayCommandKind image-pattern))
        (= rect (+ rect delta))
        (= tile-origin (+ tile-origin delta))
      )
      (else-if (or (== kind (. DisplayCommandKind clip)) (== kind (. DisplayCommandKind clip-outline)))
        (= rect (+ rect delta))
      )
    )
    (lazy is-image (== kind (. DisplayCommandKind image)))
    (return
      (call DisplayCommand
        (block
          (arg (. command kind))
          (arg rect)
          (arg tile-origin)
          (arg (. command point2))
          (arg (. command point3))
          (arg (. command matrix))
          (arg (. command fill))
          (arg (. command stroke))
          (arg (. command stroke-width))
          (arg (. command stroke-cap))
          (arg (. command stroke-join))
          (arg (. command layout))
          (arg (. command image))
          (arg (. command alignment))
          (arg (. command flag))
          (arg (. command fill-rule))
          (arg (. command item-index))
          (arg (. command gradient))
          (arg (. command stroke-dash))
          (arg (. command blend))
          (arg (. command shader))
          (arg (. command shader-args))
          (arg (. command shader-images))
          (arg (. command sampling))
        )
      )
    )
  )
  (fn-do _ rebuild-chunk _
    (param chunk DisplayChunk)
    (let old (. chunk bounds))
    (let had-old (. chunk has-bounds))
    (call record-chunk chunk)
    (+= chunks-rebuilt 1)
    (probe-count gui.frame.display-chunks-rebuilt)
    (if had-old
      (call add-damage (call window-bounds old (. chunk parent)))
    )
    (if (. chunk has-bounds)
      (call add-damage (call window-bounds (. chunk bounds) (. chunk parent)))
    )
    (if (or (!= had-old (. chunk has-bounds)) (!= old (. chunk bounds)))
      (call schedule-group-refresh (. chunk parent))
    )
  )
  (fn-do _ schedule-group-refresh _
    (param start (? DisplayGroup))
    (let group (? DisplayGroup) start)
    (if (not group)
      (= root-order-refresh-pending true)
    )
    (while group
      (return-if (if (. group refresh-pending)))
      (blank)
      (= (. group refresh-pending) true)
      (if (not (. group parent))
        (= root-order-refresh-pending true)
      )
      (= group (. group parent))
    )
  )
  (fn-do _ flush-group-refreshes _
    (return-if (if (not root-order-refresh-pending)))
    (blank)
    (probe-group + gui.scene.group-refresh)
    (call refresh-pending-groups roots)
    (= root-order (call display-detect-order roots))
    (= root-order-refresh-pending false)
    (probe-group - gui.scene.group-refresh)
  )
  (fn-do _ refresh-pending-groups _
    (param members (list DisplayEntry))
    (for (in entry members)
      (if (. entry group)
        (let group (. entry group))
        (if (. group refresh-pending)
          (call refresh-pending-groups (. group members))
          (call finalize-group group)
          (= (. group refresh-pending) false)
          (probe-count gui.scene.group-refreshes)
        )
      )
    )
  )
  (fn-do _ refresh-group-properties _
    (param group DisplayGroup)
    (if (. group is-layer)
      (= (. group opacity) (. group owner computed-opacity))
      (= (. group filters) (. group owner layer-filters))
      (= (. group region) (. group owner bounds))
      (= (. group transform) (. group owner painted-transform))
      (if (> (. group filters length) 0)
        (= has-filter-content true)
      )
      (call refresh-group-liveness group)
      (= (. group has-clip) false)
      (= (. group clip) display-no-rect)
      (= (. group translation) (call Point 0 0))
      (return)
    )
    (= (. group has-clip) (. group owner clips-content))
    (call (. group owner set-retained-native-clip-required) (. group has-clip))
    (if (. group has-clip)
      (= (. group rounded-clip) (. group owner content-rounded-bounds))
      (= (. group clip) (. group rounded-clip bounds))
      (= (. group translation) (. group owner content-scroll-translation))
      (else
        (= (. group clip) display-no-rect)
        (= (. group translation) (call Point 0 0))
      )
    )
    (call refresh-group-shape-clip group)
  )
  (fn-do _ refresh-group-shape-clip _
    (param group DisplayGroup)
    (let owner (. group owner))
    (let shape (only-if (. owner $shape) (if (. group has-clip))))
    (if (or (not shape) (not (. shape clips-content)))
      (call drop-group-shape-clip group)
      (return)
    )
    (let chunk (?? (. group shape-clip) (call DisplayChunk owner (. DisplayPhase pre))))
    (let generation (. chunk path-generation))
    (call (. chunk reset))
    (call (. recorder begin-chunk) chunk)
    (call (. owner clip-content-shape) recorder)
    (call (. recorder end-chunk))
    (let state (call display-chunk-path-clip chunk))
    (= (. group shape-clip) chunk)
    (if (== state 0)
      (call drop-group-shape-clip group)
      (return)
    )
    (= (. group shape-clip-state) state)
    (let coords (. (!! (. chunk side)) path-coords))
    (if (and (> (. group shape-clip-coords length) 0) (call display-coords-equal coords (. group shape-clip-coords)))
      (= (. chunk path-generation) generation)
      (return)
    )
    (call (. group shape-clip-coords clear))
    (for (in coord coords)
      (+= (. group shape-clip-coords) coord)
    )
    (+= (. group shape-clip-revision) 1)
  )
  (fn-do _ drop-group-shape-clip _
    (param group DisplayGroup)
    (let chunk (. group shape-clip))
    (return-if (if (not chunk)))
    (blank)
    (call release-chunk-key chunk)
    (= (. group shape-clip) null)
    (= (. group shape-clip-state) 0)
    (call (. group shape-clip-coords clear))
    (+= (. group shape-clip-revision) 1)
  )
  (fn-do _ place-layer-outer _
    (param group DisplayGroup)
    (let transform (. group transform))
    (= (. group outer) (if-expr (and transform (. group has-inner)) (call (. transform transform) (. group inner)) (. group inner)))
    (= (. group has-outer) (. group has-inner))
    (call (. group owner set-retained-display-ink-bounds) (. group outer) (. group has-outer))
  )
  (fn-do _ advance-group-generation _
    (param group DisplayGroup)
    (= (. group record-generation) (call next-display-record-generation))
  )
  (fn-do _ finalize-group _
    (param group DisplayGroup)
    (call advance-group-generation group)
    (= (. group order) (call display-detect-order (. group members)))
    (let ink-bounds display-no-rect)
    (let has-ink-bounds false)
    (for (in entry (. group members))
      (let entry-rect (call display-entry-bounds entry))
      (if (. entry-rect is-empty)
        (continue)
      )
      (if has-ink-bounds
        (= ink-bounds (+ ink-bounds entry-rect))
        (else
          (= ink-bounds entry-rect)
          (= has-ink-bounds true)
        )
      )
    )
    (call (. group owner set-retained-display-ink-bounds) ink-bounds has-ink-bounds)
    (if (and (. group is-layer) (> (. group filters length) 0))
      (= (. group inner) (. group region))
      (= (. group has-inner) (not (. group region is-empty)))
      (call place-layer-outer group)
      (else-if (. group is-layer)
        (= (. group inner) ink-bounds)
        (= (. group has-inner) has-ink-bounds)
        (call place-layer-outer group)
      )
      (else-if (. group has-clip)
        (= (. group outer) (. group clip))
        (= (. group has-outer) (and (> (. group clip width) 0) (> (. group clip height) 0)))
      )
      (else
        (= (. group outer) ink-bounds)
        (= (. group has-outer) has-ink-bounds)
      )
    )
  )
  (fn-do _ expand-damage _
    (param whole-shaded-fills Bool)
    (if (and (not has-backdrop-content) (not has-filter-content))
      (call expand-antialiased-damage whole-shaded-fills)
      (return)
    )
    (for (in pass (..< 0 8))
      (let previous damage-revision)
      (call expand-antialiased-damage whole-shaded-fills)
      (if has-backdrop-content
        (call expand-backdrop-members roots)
      )
      (if has-filter-content
        (call expand-filter-members roots)
      )
      (return-if (if (== damage-revision previous)))
    )
  )
  (fn-do _ expand-filter-members _
    (param members (list DisplayEntry))
    (for (in entry members)
      (let group (. entry group))
      (if group
        (if (and (> (. group filters length) 0) (. group has-outer))
          (let visible (call window-bounds (. group outer) (. group parent)))
          (if (call damage-touches visible)
            (call add-damage visible)
          )
        )
        (call expand-filter-members (. group members))
      )
    )
  )
  (fn-do _ expand-antialiased-damage _
    (param whole-shaded-fills Bool)
    (return-if (if (and (not has-antialiased-content) (not (and whole-shaded-fills has-shaded-fill-content)))))
    (blank)
    (let root scene-root)
    (return-if (if (and root (call (. damage contains) (. root bounds) 0.01))))
    (blank)
    (let areas damage-snapshot)
    (for (in pass (..< 0 8))
      (let previous damage-revision)
      (call (. areas clear))
      (++= areas damage-areas)
      (for (in area areas)
        (call expand-antialiased-members roots root-order area whole-shaded-fills)
      )
      (return-if (if (== damage-revision previous)))
    )
  )
  (fn-do _ expand-backdrop-members _
    (param members (list DisplayEntry))
    (for (in entry members)
      (let chunk (. entry chunk))
      (if chunk
        (let side (. chunk side))
        (if (and side (. side has-backdrop))
          (call expand-chunk-backdrops chunk side)
        )
        (else-if (. entry group)
          (call expand-backdrop-members (. entry group members))
        )
      )
    )
  )
  (fn-do _ expand-chunk-backdrops _
    (param chunk DisplayChunk)
    (param side DisplayChunkSide)
    (let index Size)
    (while (< index (. chunk items length))
      (let kind (. ([] (. chunk items) index) kind))
      (if (or (== kind (. DisplayItemKind backdrop)) (== kind (. DisplayItemKind backdrop-shader)))
        (let state ([] (. side item-states) index))
        (let ink ([] (. side item-inks) index))
        (let placed (if-expr (== state 0) ink (call (. side state-ink-bounds) state ink)))
        (if placed
          (let sampled (call (. (call window-bounds placed (. chunk parent)) pad) (- display-backdrop-pixel-reach)))
          (if (call damage-touches sampled)
            (call add-damage sampled)
          )
        )
      )
      (+= index 1)
    )
  )
  (fn-do _ expand-antialiased-members _
    (param members (list DisplayEntry))
    (param order DisplayOrder)
    (param local-damage Rect)
    (param whole-shaded-fills Bool)
    (let index (call first-member-toward members order local-damage))
    (let axis (. order axis))
    (let stop (call display-order-stop order local-damage))
    (while (< index (. members length))
      (let entry ([] members index))
      (let bounds (call display-entry-bounds entry))
      (if (and (== axis (. DisplayAxis vertical)) (>= (. bounds top) stop) (not (. bounds is-empty)))
        (break)
      )
      (if (and (== axis (. DisplayAxis horizontal)) (>= (. bounds left) stop) (not (. bounds is-empty)))
        (break)
      )
      (if (call display-rects-overlap bounds local-damage)
        (let chunk (. entry chunk))
        (if chunk
          (let side (. chunk side))
          (let grows (and side (or (. side has-antialiased) (and whole-shaded-fills (. side has-shaded-fill)))))
          (if (and grows (not (call (. local-damage contains) bounds 0.01)))
            (call add-damage (call window-bounds bounds (. chunk parent)))
          )
          (else-if (. entry group)
            (let group (. entry group))
            (let local local-damage)
            (if (. group has-clip)
              (let visible (call (. group clip intersection) local-damage))
              (= local
                (call Rect
                  (block
                    (arg (- (. visible x) (. group translation x)))
                    (arg (- (. visible y) (. group translation y)))
                    (arg (. visible width))
                    (arg (. visible height))
                  )
                )
              )
            )
            (if (and (> (. local width) 0) (> (. local height) 0))
              (call expand-antialiased-members (. group members) (. group order) local whole-shaded-fills)
            )
          )
        )
      )
      (+= index 1)
    )
  )
  (fn-do _ draw-members _
    (param members (list DisplayEntry))
    (param order DisplayOrder)
    (param surface RasterCanvas)
    (param local-damage Rect)
    (let index (call first-member-toward members order local-damage))
    (let axis (. order axis))
    (let stop (call display-order-stop order local-damage))
    (while (< index (. members length))
      (let entry ([] members index))
      (+= cull-tests 1)
      (probe-count gui.scene.cull-tests)
      (let bounds (call display-entry-bounds entry))
      (if (and (== axis (. DisplayAxis vertical)) (>= (. bounds top) stop) (not (. bounds is-empty)))
        (break)
      )
      (if (and (== axis (. DisplayAxis horizontal)) (>= (. bounds left) stop) (not (. bounds is-empty)))
        (break)
      )
      (if (call display-rects-overlap bounds local-damage)
        (if (. entry chunk)
          (call draw-chunk (. entry chunk) surface local-damage)
          (else-if (. entry group)
            (call draw-group (. entry group) surface local-damage)
          )
        )
      )
      (+= index 1)
    )
  )
  (fn-do _ draw-group _
    (param group DisplayGroup)
    (param surface RasterCanvas)
    (param parent-damage Rect)
    (let local parent-damage)
    (if (. group is-layer)
      (return-if (if (<= (. group opacity) 0%%)))
      (blank)
      (let transform (. group transform))
      (if transform
        (let inverse (call (. transform create-inverse)))
        (return-if (if (not inverse)))
        (blank)
        (= local (call (. inverse transform) parent-damage))
      )
      (do-use (. surface saved-state)
        (if transform
          (call (. surface transform-content) transform)
        )
        (if (< (. group opacity) 1%%)
          (call (. surface begin-opacity) (. group opacity))
        )
        (let filters (call group-filters group))
        (for (in index (..< 0 (. filters length)))
          (call (. surface begin-filter) (. group region) ([] filters (- (. filters length) 1 index)))
        )
        (call draw-members (. group members) (. group order) surface local)
        (for (in filter filters)
          (call (. surface end-filter))
        )
        (if (< (. group opacity) 1%%)
          (call (. surface end-opacity))
        )
      )
      (return)
    )
    (if (. group has-clip)
      (let visible (call (. group clip intersection) parent-damage))
      (return-if (if (or (<= (. visible width) 0) (<= (. visible height) 0))))
      (blank)
      (call (. surface push))
      (call (. group rounded-clip clip) surface)
      (if (. group shape-clip)
        (call (. group owner clip-content-shape) surface)
      )
      (call (. surface translate) (. group translation x) (. group translation y))
      (= local
        (call Rect
          (block
            (arg (- (. visible x) (. group translation x)))
            (arg (- (. visible y) (. group translation y)))
            (arg (. visible width))
            (arg (. visible height))
          )
        )
      )
    )
    (call draw-members (. group members) (. group order) surface local)
    (if (. group has-clip)
      (call (. surface pop))
    )
  )
  (fn-do _ encode-metal-members _
    (param members (list DisplayEntry))
    (param order DisplayOrder)
    (param local-damage Rect)
    (param renderer MetalOffscreenRenderer)
    (let index (call first-member-toward members order local-damage))
    (let axis (. order axis))
    (let stop (call display-order-stop order local-damage))
    (while (< index (. members length))
      (let entry ([] members index))
      (+= cull-tests 1)
      (probe-count gui.scene.cull-tests)
      (let bounds (call display-entry-bounds entry))
      (if (and (== axis (. DisplayAxis vertical)) (>= (. bounds top) stop) (not (. bounds is-empty)))
        (break)
      )
      (if (and (== axis (. DisplayAxis horizontal)) (>= (. bounds left) stop) (not (. bounds is-empty)))
        (break)
      )
      (if (call display-rects-overlap bounds local-damage)
        (if (. entry chunk)
          (call encode-metal-chunk (. entry chunk) renderer local-damage)
          (else-if (. entry group)
            (call encode-metal-group (. entry group) local-damage renderer)
          )
        )
      )
      (+= index 1)
    )
  )
  (fn-do _ encode-metal-group _
    (param group DisplayGroup)
    (param parent-damage Rect)
    (param renderer MetalOffscreenRenderer)
    (let local parent-damage)
    (if (. group is-layer)
      (return-if (if (<= (. group opacity) 0%%)))
      (blank)
      (if (and (> (. group filters length) 0) (. group has-outer))
        (= local (. group outer))
      )
      (let transform (. group transform))
      (let turned (and (!= transform null) (not (. transform is-translation))))
      (if transform
        (let inverse (call (. transform create-inverse)))
        (return-if (if (not inverse)))
        (blank)
        (= local (call (. inverse transform) local))
        (if turned
          (call (. renderer push-transform-layer)
            (block
              (arg transform)
              (arg (if-expr (> (. group filters length) 0) 1%% (. group opacity)))
            )
          )
          (else
            (call (. renderer push-translate) (. transform translation))
          )
        )
      )
      (let filters (call group-filters group))
      (for (in index (..< 0 (. filters length)))
        (let outermost (== index 0))
        (call (. renderer push-filter-layer)
          (block
            (arg (. group region))
            (arg ([] filters (- (. filters length) 1 index)))
            (arg (if-expr outermost (. group opacity) 1%%))
          )
        )
      )
      (let layered (and (== (. filters length) 0) (< (. group opacity) 1%%) (not turned)))
      (if layered
        (call (. renderer push-layer) (. group opacity))
      )
      (call encode-metal-members (. group members) (. group order) local renderer)
      (if layered
        (call (. renderer pop-layer))
      )
      (for (in filter filters)
        (call (. renderer pop-layer))
      )
      (if turned
        (call (. renderer pop-layer))
        (else-if transform
          (call (. renderer pop-translate))
        )
      )
      (return)
    )
    (if (. group has-clip)
      (let visible (call (. group clip intersection) parent-damage))
      (return-if (if (or (<= (. visible width) 0) (<= (. visible height) 0))))
      (blank)
      (call (. renderer push-rounded-clip) (. group rounded-clip))
      (if (. group shape-clip)
        (call push-metal-shape-clip group renderer)
      )
      (call (. renderer push-translate) (. group translation))
      (= local
        (call Rect
          (block
            (arg (- (. visible x) (. group translation x)))
            (arg (- (. visible y) (. group translation y)))
            (arg (. visible width))
            (arg (. visible height))
          )
        )
      )
    )
    (call encode-metal-members (. group members) (. group order) local renderer)
    (if (. group has-clip)
      (call (. renderer pop-translate))
      (if (. group shape-clip)
        (call (. renderer pop-clip))
      )
      (call (. renderer pop-clip))
    )
  )
  (fn-do _ push-metal-shape-clip _
    (param group DisplayGroup)
    (param renderer MetalOffscreenRenderer)
    (let chunk (!! (. group shape-clip)))
    (let side (!! (. chunk side)))
    (call (. side refresh-wire-states))
    (let path-set
      (call (. renderer chunk-paths)
        (block
          (arg (. (as chunk Pointer) address))
          (arg (. chunk path-generation))
          (arg (. chunk items buffer-pointer))
          (arg 0)
          (arg (. side path-verbs buffer-pointer))
          (arg (. side path-verbs length))
          (arg (. side path-coords buffer-pointer))
          (arg (. side path-coords length))
          (arg (. side styled-wires buffer-pointer))
          (arg 0)
          (arg (. side gradient-wires buffer-pointer))
          (arg 0)
          (arg (. side gradient-stops buffer-pointer))
          (arg 0)
          (arg (. side shader-args buffer-pointer))
          (arg 0)
          (arg (. side wire-states buffer-pointer))
          (arg (. side wire-states length))
        )
      )
    )
    (let state ([] (. side states) (as (. group shape-clip-state) Size)))
    (call (. renderer push-path-clip) path-set (. group shape-clip-state) (== (. state fill-rule) (. FillRule even-odd)))
  )
  (fn-do _ encode-metal-chunk _
    (param chunk DisplayChunk)
    (param renderer MetalOffscreenRenderer)
    (param damage (? Rect) (= null))
    (+= chunks-encoded 1)
    (return-if (if (and damage (call encode-raster-chunk chunk damage renderer))))
    (blank)
    (if (and (not (. chunk is-opaque)) (not (. chunk needs-tile)) (call ensure-metal-chunk-resources chunk renderer))
      (let cull (? DisplayCullIndex) null)
      (if damage
        (let index (call metal-cull-index chunk damage))
        (if (and index (call (. index select) chunk damage (. renderer scale)))
          (= cull index)
        )
      )
      (let drawn (?? (?. cull order length) (. chunk items length)))
      (return-if (if (== drawn 0)))
      (blank)
      (if (call append-metal-items chunk renderer null cull)
        (+= items-encoded drawn)
        (probe-count gui.frame.visible-display-items (as drawn U64))
        (return)
      )
    )
    (+= metal-tile-fallbacks 1)
    (probe-count gui.scene.metal-tile-fallbacks)
    (let key (as (. (as chunk Pointer) address) U64))
    (let rect (call display-pixel-rect (. chunk bounds) (. renderer scale)))
    (let handle (call (. renderer tile-lookup) key (. chunk record-generation)))
    (if (not handle)
      (= handle (call register-metal-opaque-tile chunk rect renderer key))
    )
    (if handle
      (call (. renderer append-tile) (- handle 1) rect)
      (+= items-encoded 1)
      (probe-count gui.frame.visible-display-items)
    )
  )
  (fn-do _ metal-cull-index (? DisplayCullIndex)
    (param chunk DisplayChunk)
    (param damage Rect)
    (let table (. chunk side))
    (return-if null (if (or (not table) (< (. chunk items length) display-cull-minimum))))
    (blank)
    (return-if null (if (or (> (. table mask-layers) 0) (> (. table blur-layers) 0))))
    (blank)
    (return-if null (if (and (. chunk has-bounds) (call display-rect-covers damage (. chunk bounds)))))
    (blank)
    (if (!= (. chunk cull-seen) (. chunk path-generation))
      (= (. chunk cull-seen) (. chunk path-generation))
      (return null)
    )
    (if (not (. chunk cull-index))
      (let built (call DisplayCullIndex chunk))
      (= (. chunk cull-index) built)
    )
    (let index (!! (. chunk cull-index)))
    (return-if null (if (not (. index is-usable))))
    (blank)
    (return index)
  )
  (fn-do _ append-metal-items _
    (param chunk DisplayChunk)
    (param renderer MetalOffscreenRenderer)
    (param wires (? (list DisplayStateWire)) (= null))
    (param cull (? DisplayCullIndex) (= null))
    (let side (. chunk side))
    (if (not side)
      (return
        (call (. renderer append-items)
          (block
            (arg (. chunk items buffer-pointer))
            (arg (. chunk items length))
            (arg (. chunk clips buffer-pointer))
            (arg (. chunk clips length))
            (arg (. chunk vector-palette buffer-pointer))
            (arg (. chunk vector-palette length))
            (arg (. chunk shapes buffer-pointer))
            (arg (. chunk shapes length))
          )
        )
      )
    )
    (call (. side refresh-wire-states))
    (let states (?? wires (. side wire-states)))
    (let path-set I64 -1)
    (if (or (> (. side styled-wires length) 0) (> (. side shape-clips) 0) (> (. side gradient-wires length) 0))
      (= path-set
        (call (. renderer chunk-paths)
          (block
            (arg (. (as chunk Pointer) address))
            (arg (. chunk path-generation))
            (arg (. chunk items buffer-pointer))
            (arg (. chunk items length))
            (arg (. side path-verbs buffer-pointer))
            (arg (. side path-verbs length))
            (arg (. side path-coords buffer-pointer))
            (arg (. side path-coords length))
            (arg (. side styled-wires buffer-pointer))
            (arg (. side styled-wires length))
            (arg (. side gradient-wires buffer-pointer))
            (arg (. side gradient-wires length))
            (arg (. side gradient-stops buffer-pointer))
            (arg (. side gradient-stops length))
            (arg (. side shader-args buffer-pointer))
            (arg (. side shader-args length))
            (arg (. states buffer-pointer))
            (arg (. states length))
          )
        )
      )
    )
    (return
      (call (. renderer append-items)
        (block
          (arg (. chunk items buffer-pointer))
          (arg (. chunk items length))
          (arg (. chunk clips buffer-pointer))
          (arg (. chunk clips length))
          (arg (. chunk vector-palette buffer-pointer))
          (arg (. chunk vector-palette length))
          (arg (. chunk shapes buffer-pointer))
          (arg (. chunk shapes length))
          (arg (. side transforms buffer-pointer))
          (arg (. side transforms length))
          (arg (. side item-transforms buffer-pointer))
          (arg (. side vector-colors buffer-pointer))
          (arg (. side vector-colors length))
          (arg (. side item-strokes buffer-pointer))
          (arg (. side item-dashes buffer-pointer))
          (arg (. states buffer-pointer))
          (arg (. states length))
          (arg (. side item-states buffer-pointer))
          (arg (. side image-identities buffer-pointer))
          (arg (. side image-identities length))
          (arg path-set)
          (arg (. side quads buffer-pointer))
          (arg (. side quads length))
          (arg (?. cull order buffer-pointer))
          (arg (?? (?. cull order length) 0))
          (arg (?. cull requirements buffer-pointer))
          (arg (?? (?. cull requirement-bits) 0u32))
        )
      )
    )
  )
  (fn-do _ encode-raster-chunk Bool
    (param chunk DisplayChunk)
    (param damage Rect)
    (param renderer MetalOffscreenRenderer)
    (return-if false (if (or (not (. chunk owner $caches-raster)) (. chunk is-live))))
    (blank)
    (let found (call raster-view chunk))
    (return-if false (if (not found)))
    (blank)
    (let view found)
    (if (call raster-needs-index chunk view)
      (let waits (call raster-index-waits chunk))
      (if (not (call raster-cull-index chunk))
        (if waits
          (call note-raster-damage chunk view renderer)
        )
        (return false)
      )
    )
    (let seen (call raster-visible chunk view renderer))
    (return-if true (if (not seen)))
    (blank)
    (let scale (. renderer scale))
    (let zoom (. view matrix a))
    (let level (call raster-fit-level chunk zoom seen scale renderer))
    (let goal (call raster-goal-view chunk view))
    (if (not (call raster-tiles-chunk chunk view level seen))
      (if goal
        (call want-raster-goal chunk view goal scale renderer)
      )
      (return false)
    )
    (if (!= zoom (. chunk raster-scale-seen))
      (= (. chunk raster-scale-seen) zoom)
      (= (. chunk raster-scale-at) frame-time)
    )
    (let grid (call raster-drawing-grid chunk view level seen (!= goal null) scale renderer))
    (let size (call raster-grid-cell grid scale))
    (let span (call raster-cells seen size))
    (let generation (. chunk path-generation))
    (let passing (call raster-passes goal level))
    (if (not passing)
      (call want-raster-cells chunk grid span generation (. RasterWant visible) renderer)
    )
    (let covered true)
    (let complete true)
    (let waiting false)
    (for (in row (..< (. span top) (. span bottom)))
      (for (in column (..< (. span left) (. span right)))
        (let drawn (call draw-raster-cell chunk view grid column row generation scale renderer false))
        (if (== drawn (. RasterCellDraw none))
          (= covered false)
        )
        (if (!= drawn (. RasterCellDraw own))
          (= complete false)
        )
        (let missing (or (== drawn (. RasterCellDraw none)) (and (not passing) (!= drawn (. RasterCellDraw own)))))
        (if (and missing (not waiting) (call raster-cell-waits chunk grid column row generation renderer))
          (= waiting true)
        )
      )
    )
    (if (and passing (not covered))
      (call want-raster-cells chunk grid span generation (. RasterWant visible) renderer)
    )
    (if goal
      (call want-raster-goal chunk view goal scale renderer)
    )
    (call want-raster-motion chunk view grid seen span (and complete (not goal)) scale renderer)
    (if (not covered)
      (probe-count gui.scene.raster-direct)
      (if waiting
        (call note-raster-damage chunk view renderer)
      )
      (return false)
    )
    (let index (. chunk cull-index))
    (if (and index (> (. view first) 0))
      (call append-raster-outside chunk renderer index 0 (. view first))
    )
    (let clip (. view clip))
    (if clip
      (call (. renderer push-clip) clip)
    )
    (let drawn (call raster-cells (call raster-content-rect damage view) size))
    (for (in row (..< (call max (. span top) (. drawn top)) (call min (. span bottom) (. drawn bottom))))
      (for (in column (..< (call max (. span left) (. drawn left)) (call min (. span right) (. drawn right))))
        (let shown (call draw-raster-cell chunk view grid column row generation scale renderer true))
        (if (and (not passing) (== shown (. RasterCellDraw cover)) (call raster-cell-waits chunk grid column row generation renderer))
          (call note-tile-damage (call window-bounds (call raster-cell-bounds view grid column row scale) (. chunk parent)))
        )
      )
    )
    (if clip
      (call (. renderer pop-clip))
    )
    (if (and index (< (. view last) (- (. chunk items length) 1)))
      (call append-raster-outside chunk renderer index (+ (. view last) 1) (. chunk items length))
    )
    (return true)
  )
  (fn-do _ want-raster-cells _
    (param chunk DisplayChunk)
    (param grid RasterGrid)
    (param span RasterSpan)
    (param generation U32)
    (param want RasterWant)
    (param renderer MetalOffscreenRenderer)
    (let center-column (/ (+ (. span left) (. span right) -1) 2))
    (let center-row (/ (+ (. span top) (. span bottom) -1) 2))
    (let reach (call max (- (. span right) (. span left)) (- (. span bottom) (. span top))))
    (for (in ring (..< 0 (+ reach 1)))
      (for (in row (..< (. span top) (. span bottom)))
        (for (in column (..< (. span left) (. span right)))
          (if (== (call max (call abs (- column center-column)) (call abs (- row center-row))) ring)
            (call want-raster-tile chunk grid column row generation want renderer)
          )
        )
      )
    )
  )
  (fn-do _ want-raster-motion _
    (param chunk DisplayChunk)
    (param view RasterView)
    (param grid RasterGrid)
    (param seen Rect)
    (param span RasterSpan)
    (param ready Bool)
    (param scale F64)
    (param renderer MetalOffscreenRenderer)
    (let matrix (. view matrix))
    (let before (call Matrix (. chunk raster-motion-zoom) 0 0 (. chunk raster-motion-zoom) (. chunk raster-motion-x) (. chunk raster-motion-y)))
    (let then (. chunk raster-motion-time))
    (= (. chunk raster-motion-x) (. matrix tx))
    (= (. chunk raster-motion-y) (. matrix ty))
    (= (. chunk raster-motion-zoom) (. matrix a))
    (= (. chunk raster-motion-time) frame-time)
    (return-if (if (or (== then 0) (<= frame-time then) (> (- frame-time then) raster-motion-gap))))
    (blank)
    (let index (. chunk cull-index))
    (let extent (if-expr index (. index content area) (call raster-content-rect (. chunk bounds) view)))
    (if (== (. matrix a) (. before a))
      (call want-raster-strip chunk matrix before (- frame-time then) grid seen span extent scale renderer)
      (else-if (and ready (not (. grid settle)))
        (call want-raster-level-ahead chunk matrix before grid seen extent scale renderer)
      )
    )
  )
  (fn-do _ want-raster-strip _
    (param chunk DisplayChunk)
    (param matrix Matrix)
    (param before Matrix)
    (param elapsed U64)
    (param grid RasterGrid)
    (param seen Rect)
    (param span RasterSpan)
    (param extent Rect)
    (param scale F64)
    (param renderer MetalOffscreenRenderer)
    (let moved-x (- (. matrix tx) (. before tx)))
    (let moved-y (- (. matrix ty) (. before ty)))
    (return-if (if (and (== moved-x 0) (== moved-y 0))))
    (blank)
    (let ahead (/ raster-strip-nanos (as elapsed F64)))
    (let reach-x (/ (. seen width) 2))
    (let reach-y (/ (. seen height) 2))
    (let shift-x (call clamp (/ (* (- moved-x) ahead) (. matrix a)) (- reach-x) reach-x))
    (let shift-y (call clamp (/ (* (- moved-y) ahead) (. matrix a)) (- reach-y) reach-y))
    (let swept (call (. (+ seen (call Rect (+ (. seen x) shift-x) (+ (. seen y) shift-y) (. seen width) (. seen height))) intersection) extent))
    (return-if (if (. swept is-empty)))
    (blank)
    (let cells (call raster-cells swept (call raster-grid-cell grid scale)))
    (let generation (. chunk path-generation))
    (let reach (call max (call max (- (. span left) (. cells left)) (- (. cells right) (. span right))) (call max (- (. span top) (. cells top)) (- (. cells bottom) (. span bottom)))))
    (for (in ring (..< 1 (+ reach 1)))
      (for (in row (..< (. cells top) (. cells bottom)))
        (for (in column (..< (. cells left) (. cells right)))
          (let across (call max (- (. span left) column) (- column (- (. span right) 1))))
          (let down (call max (- (. span top) row) (- row (- (. span bottom) 1))))
          (if (== (call max across down) ring)
            (call want-raster-tile chunk grid column row generation (. RasterWant ahead) renderer)
          )
        )
      )
    )
  )
  (fn-do _ want-raster-level-ahead _
    (param chunk DisplayChunk)
    (param matrix Matrix)
    (param before Matrix)
    (param grid RasterGrid)
    (param seen Rect)
    (param extent Rect)
    (param scale F64)
    (param renderer MetalOffscreenRenderer)
    (let zoom (. matrix a))
    (let outward (< zoom (. before a)))
    (let level (+ (. grid level) (if-expr outward -1 1)))
    (return-if (if (or (< level raster-lowest-level) (> level raster-highest-level))))
    (blank)
    (let area seen)
    (if outward
      (let center-x (/ (- (. before tx) (. matrix tx)) (- zoom (. before a))))
      (let center-y (/ (- (. before ty) (. matrix ty)) (- zoom (. before a))))
      (let grow (/ (/ zoom (. grid scale)) raster-lowest-ratio))
      (= area (call Rect (+ center-x (* (- (. seen x) center-x) grow)) (+ center-y (* (- (. seen y) center-y) grow)) (* (. seen width) grow) (* (. seen height) grow)))
    )
    (let shown (call (. area intersection) extent))
    (return-if (if (. shown is-empty)))
    (blank)
    (let ahead (call raster-octave level))
    (let span (call raster-cells shown (call raster-grid-cell ahead scale)))
    (let count (* (as (- (. span right) (. span left)) I64) (as (- (. span bottom) (. span top)) I64)))
    (return-if (if (> count (call (. renderer pyramid-tile-limit) raster-tile-pixels))))
    (blank)
    (call want-raster-cells chunk ahead span (. chunk path-generation) (. RasterWant ahead) renderer)
  )
  (fn-do _ want-raster-tile _
    (param chunk DisplayChunk)
    (param grid RasterGrid)
    (param column I32)
    (param row I32)
    (param generation U32)
    (param want RasterWant)
    (param renderer MetalOffscreenRenderer)
    (let key (call raster-grid-key chunk grid column row))
    (return-if (if (!= (call (. renderer tile-lookup-rendered) key generation) 0)))
    (blank)
    (return-if (if (call (. renderer tile-failed) key generation)))
    (blank)
    (+= raster-wants (call RasterTile chunk grid column row generation want))
  )
  (fn-do _ raster-cell-waits Bool
    (param chunk DisplayChunk)
    (param grid RasterGrid)
    (param column I32)
    (param row I32)
    (param generation U32)
    (param renderer MetalOffscreenRenderer)
    (return-if false (if (or raster-full (== (. chunk raster-blocked-pass) raster-pass))))
    (blank)
    (return (not (call (. renderer tile-failed) (call raster-grid-key chunk grid column row) generation)))
  )
  (fn-do _ raster-drawing-grid RasterGrid
    (param chunk DisplayChunk)
    (param view RasterView)
    (param level I32)
    (param seen Rect)
    (param easing Bool)
    (param scale F64)
    (param renderer MetalOffscreenRenderer)
    (let octave (call raster-octave level))
    (let zoom (. view matrix a))
    (return-if octave (if (or easing (call raster-lands zoom level))))
    (blank)
    (let grid (call RasterGrid level zoom true))
    (let span (call raster-cells seen (call raster-grid-cell grid scale)))
    (let due (+ (. chunk raster-scale-at) raster-settle-delay))
    (if (and (< frame-time due) (not (call raster-grid-present chunk grid span renderer)))
      (call note-raster-settle chunk view due renderer)
      (return octave)
    )
    (= (. chunk raster-settle-due) 0)
    (let count (* (as (- (. span right) (. span left)) I64) (as (- (. span bottom) (. span top)) I64)))
    (return-if octave (if (> count (call (. renderer pyramid-tile-limit) raster-tile-pixels))))
    (blank)
    (= (. chunk raster-settle-scale) zoom)
    (return grid)
  )
  (fn-do _ raster-grid-present Bool
    (param chunk DisplayChunk)
    (param grid RasterGrid)
    (param span RasterSpan)
    (param renderer MetalOffscreenRenderer)
    (let generation (. chunk path-generation))
    (for (in row (..< (. span top) (. span bottom)))
      (for (in column (..< (. span left) (. span right)))
        (return-if false (if (== (call (. renderer tile-lookup-rendered) (call raster-grid-key chunk grid column row) generation) 0)))
      )
    )
    (return true)
  )
  (fn-do _ raster-passes Bool
    (param goal (? RasterView))
    (param level I32)
    (return-if false (if (not goal)))
    (blank)
    (return (!= (call raster-level (. goal matrix a)) level))
  )
  (fn-do _ raster-goal-view (? RasterView)
    (param chunk DisplayChunk)
    (param view RasterView)
    (let found (. chunk owner content-transform-goal))
    (return-if null (if (not found)))
    (blank)
    (let goal found)
    (return-if null (if (not (call raster-matrix-zooms goal))))
    (blank)
    (let side (. chunk side))
    (return-if null (if (not side)))
    (blank)
    (let current (. ([] (. side states) (. side content-state)) matrix))
    (let full (. view matrix))
    (let matrix (call Matrix (. goal a) 0 0 (. goal d) (+ (- (. full tx) (. current tx)) (. goal tx)) (+ (- (. full ty) (. current ty)) (. goal ty))))
    (return (call RasterView matrix (. view clip) (. view first) (. view last) (. view shift)))
  )
  (fn-do _ want-raster-goal _
    (param chunk DisplayChunk)
    (param view RasterView)
    (param goal RasterView)
    (param scale F64)
    (param renderer MetalOffscreenRenderer)
    (let port (call raster-viewport-local view renderer))
    (return-if (if (not port)))
    (blank)
    (let index (. chunk cull-index))
    (let extent (if-expr index (. index content area) (call raster-content-rect (. chunk bounds) view)))
    (let shown (call (. (call raster-content-rect port goal) intersection) extent))
    (return-if (if (. shown is-empty)))
    (blank)
    (let counted (as (+ (- (. view last) (. view first)) 1) F64))
    (let estimate (if-expr index (call (. index content estimate) shown) counted))
    (return-if (if (< estimate raster-tiled-items)))
    (blank)
    (let zoom (. goal matrix a))
    (let level (call raster-level zoom))
    (call want-raster-goal-grid chunk (call raster-octave level) shown scale renderer)
    (if (!= zoom (. chunk raster-goal-seen))
      (= (. chunk raster-goal-seen) zoom)
      (= (. chunk raster-goal-at) frame-time)
    )
    (return-if (if (or (call raster-lands zoom level) (< frame-time (+ (. chunk raster-goal-at) raster-settle-delay)))))
    (blank)
    (if (call want-raster-goal-grid chunk (call RasterGrid level zoom true) shown scale renderer)
      (= (. chunk raster-settle-scale) zoom)
    )
  )
  (fn-do _ want-raster-goal-grid Bool
    (param chunk DisplayChunk)
    (param grid RasterGrid)
