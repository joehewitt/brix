      (for (in area damage-areas)
        (let aligned (call align-damage-to-device area))
        (call (. renderer push-clip) aligned)
        (call encode-metal-members roots root-order (call display-rect-clamp aligned surface) renderer)
        (call (. renderer pop-clip))
      )
      (else
        (call encode-metal-members roots root-order (call display-rect-clamp clip surface) renderer)
      )
