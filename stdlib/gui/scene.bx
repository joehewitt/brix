  (fn-expr _ is-sprite-wanted Bool
    (param wants (list DisplaySpriteWant))
    (param key U64)
    (call some wants (:where (== (. each key) key)))
  )
  (fn-do _ render-sprite-batch Size
    (param wants (list DisplaySpriteWant))
    (param start Size)
    (param renderer MetalOffscreenRenderer)
    (let scale (. renderer scale))
    (let width (as (* (as (. renderer width) F64) scale) I32))
    (let height (as (* (as (. renderer height) F64) scale) I32))
    (call (. renderer begin-packet))
    (= current-metal-resource-renderer (. renderer native))
    (= current-metal-resource-epoch (+ (. renderer image-atlas-evictions) (. renderer image-texture-evictions)))
    (call flush-released-chunks renderer)
    (let x I32)
    (let y I32)
