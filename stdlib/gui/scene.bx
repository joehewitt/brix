    (for (in index (..< 0 (. sprite-chunks length)))
      (let chunk ([] sprite-chunks index))
      (if (and (> (. chunk sprite-count) 0) (!= (. chunk sprite-mark) pass))
        (= (. chunk sprite-mark) pass)
        (= ([] sprite-chunks kept) chunk)
        (+= kept 1)
      )
    )
    (call (. sprite-chunks remove) kept (- (. sprite-chunks length) kept))
    (for (in chunk (. recorder sprite-chunks))
      (if (and (> (. chunk sprite-count) 0) (!= (. chunk sprite-mark) pass))
        (= (. chunk sprite-mark) pass)
        (+= sprite-chunks chunk)
      )
    )
    (call (. recorder sprite-chunks clear))
    (let wants sprite-wants)
    (for (in chunk sprite-chunks)
      (for (in index (..< 0 (. chunk sprite-count)))
        (let item ([] (. chunk items) (as ([] (!! (. chunk sprite-items)) index) Size)))
        (let key (/or/ (as (. item data0) U64) (/lshift/ (as (. item data1) U64) 32)))
        (if (and (== (call (. renderer tile-lookup-rendered) key (. item data2)) 0) (not (call is-sprite-wanted wants key)))
          (+= wants (call DisplaySpriteWant ([] (!! (. chunk sprites)) index) key (. item data2) (. item value)))
        )
      )
    )
    (let next Size 0)
    (while (< next (. wants length))
      (= next (call render-sprite-batch wants next renderer))
    )
    (call (. wants clear))
