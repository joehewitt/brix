    (if (not has-damage)
      (+= frames-idle 1)
      (return)
    )
    (blank)
    (= is-replaying true)
    (finally
      (inline (= is-replaying false))
    )
    (call expand-damage true)
    (let clip (call align-damage-to-device damage))
    (let local (call Rect (- (. clip x) (. origin x)) (- (. clip y) (. origin y)) (. clip width) (. clip height)))
    (let is-full-surface (and (<= (. local x) 0) (<= (. local y) 0)))
    (= is-full-surface (and is-full-surface (>= (. local right) (. surface width))))
    (= is-full-surface (and is-full-surface (>= (. local bottom) (. surface height))))
    (if is-full-surface
      (call C:brixGraphicsClear
        (block
          (arg (. surface native))
          (arg (. background red))
          (arg (. background green))
          (arg (. background blue))
          (arg (. background alpha))
        )
      )
      (else
        (call (. surface push))
        (call (. surface clip) local)
        (if (< (. background alpha) 1%%)
          (call C:brixGraphicsClearRect (. surface native) (. local x) (. local y) (. local width) (. local height))
