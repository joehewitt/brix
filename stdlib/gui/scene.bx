        (call min
          (block
            (arg (. want pixel-scale))
            (arg (call min (/ (as width F64) (. bounds width)) (/ (as height F64) (. bounds height))))
          )
        )
      )
      (let pixel-width (call min (as (call ceil (* (. bounds width) resolution)) I32) width))
      (let pixel-height (call min (as (call ceil (* (. bounds height) resolution)) I32) height))
      (if (> (+ x pixel-width) width)
