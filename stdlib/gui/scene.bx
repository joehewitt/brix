  (fn-expr + layer-group-for (? DisplayGroup)
    (param box Box)
    (?. (call node-for box) layer-group)
  )
  (fn-do _ absorb-damage-area _
    (param rect Rect)
    (let merged rect)
    (let index Size 0)
    (while (< index (. damage-areas length))
      (let area ([] damage-areas index))
      (if (call display-damage-areas-join area merged)
        (= merged (+ merged area))
        (call (. damage-areas remove) index 1)
        (= index 0)
        (else
          (+= index 1)
        )
      )
    )
    (+= damage-areas merged)
  )
  (fn-do _ merge-closest-damage-areas _
    (let best-first Size 0)
    (let best-second Size 1)
    (let best-growth -1.0)
    (for (in first (..< 0 (. damage-areas length)))
      (for (in second (..< (+ first 1) (. damage-areas length)))
        (let growth (call display-damage-join-growth ([] damage-areas first) ([] damage-areas second)))
        (if (or (< best-growth 0) (< growth best-growth))
          (= best-first first)
          (= best-second second)
          (= best-growth growth)
        )
      )
    )
    (let merged (+ ([] damage-areas best-first) ([] damage-areas best-second)))
    (call (. damage-areas remove) best-second 1)
    (call (. damage-areas remove) best-first 1)
    (call absorb-damage-area merged)
  )
  (fn-do _ local-damage-areas (list F64)
    (let values (call (of List F64)))
    (for (in area damage-areas)
      (let aligned (call align-damage-to-device area))
      (++= values (list (- (. aligned x) (. origin x)) (- (. aligned y) (. origin y)) (. aligned width) (. aligned height)))
    )
    (return values)
  )
  (fn-do _ split-damaged-pixels Size
    (let total Size 0)
    (for (in area damage-areas)
      (+= total (call device-pixels (call align-damage-to-device area)))
    )
    (return total)
  )
  (fn-expr _ device-pixels Size
    (param rect Rect)
    (* (as (call ceil (* (. rect width) scale)) Size) (as (call ceil (* (. rect height) scale)) Size))
  )
  (fn-do _ clear-damage _
    (= has-damage false)
    (= damage display-no-rect)
    (call (. damage-areas clear))
  )
  (fn-expr _ damage-touches Bool
    (param visible Rect)
    (call some damage-areas (:where (and (call display-rects-overlap visible each) (not (call (. each contains) visible 0.01)))))
  )
  (fn-expr _ live-resting Bool
    (param cycle (? FrameCycle))
    (param epoch (? F64))
    (if-expr (or (not cycle) (== epoch null)) false (call (. cycle is-resting) (- (. recorder live-time) epoch)))
  )
  (fn-expr _ live-wake F64
    (param cycle FrameCycle)
    (param epoch F64)
    (+ epoch (call (. cycle next-start) (- (. recorder live-time) epoch)))
  )
  (fn-expr _ earliest-wake F64
    (param wake (? F64))
    (param at F64)
    (if-expr (!= wake null) (call min wake at) at)
  )
  (fn-do _ damage-live-chunk Bool
    (param chunk DisplayChunk)
    (param bounds Rect)
    (param rate (? F64))
    (let slot (call due-live-slot (. chunk live-slot) rate))
    (return-if false (if (not slot)))
    (blank)
    (= (. chunk live-slot) slot)
    (call add-damage bounds)
    (return true)
  )
  (fn-do _ damage-live-group Bool
    (param group DisplayGroup)
    (param bounds Rect)
    (param rate (? F64))
    (let slot (call due-live-slot (. group live-slot) rate))
    (return-if false (if (not slot)))
    (blank)
    (= (. group live-slot) slot)
    (call add-damage bounds)
    (return true)
  )
  (fn-expr _ due-live-slot (? F64)
    (param last F64)
    (param rate (? F64))
    (case? (or (not rate) (<= rate 0))
      last
    )
    (case? (<= slot last)
      null
    )
    (default
      slot
    )
    (where
      (lazy interval (/ 1 rate))
      (lazy slot (call floor (/ (+ (. recorder live-time) (/ interval 8)) interval)))
    )
  )
  (fn-do _ refresh-group-liveness _
    (param group DisplayGroup)
    (let live (and (. group owner $animates-fills) (call some (. group filters) (:where (. each is-live)))))
    (if (not live)
      (= (. group is-live) false)
      (= (. group live-epoch) null)
      (= (. group live-cycle) null)
      (return)
    )
    (let top 0.0)
    (let is-capped true)
    (let cycle (? FrameCycle) null)
    (let is-cycled true)
    (for (in filter (. group filters))
      (if (. filter is-live)
        (let wanted (. filter frame-rate))
        (if wanted
          (= top (call max top wanted))
          (else
            (= is-capped false)
          )
        )
        (let found (call display-layer-cycle filter))
        (if (or (not found) (and cycle (!= cycle found)))
          (= is-cycled false)
        )
        (= cycle found)
      )
    )
    (= (. group live-rate) (only-if top (if (and is-capped (> top 0)))))
    (let group-cycle (only-if cycle (if is-cycled)))
    (if (!= (. group live-cycle) group-cycle)
      (= (. group live-cycle) group-cycle)
      (= (. group is-live-settled) false)
    )
    (= (. group live-epoch) (?? (. group live-epoch) (. recorder live-time)))
    (return-if (if (. group is-live)))
    (blank)
    (= (. group is-live) true)
    (let known (call some live-groups (:where (== (as each Pointer) (as group Pointer)))))
    (if (not known)
      (+= live-groups group)
    )
  )
  (fn-do _ group-filters (list ShaderFilter)
    (param group DisplayGroup)
    (let epoch (. group live-epoch))
    (return-if (. group filters) (if (not epoch)))
    (blank)
    (let time (call max 0 (- (. recorder live-time) epoch)))
    (let timed (call (of List ShaderFilter)))
    (for (in filter (. group filters))
      (if (. filter is-live)
        (+= timed
          (call ShaderFilter
            (block
              (arg (. filter shader))
              (arg (. filter args))
              (arg (. filter images))
              (arg true)
              (arg (. filter frame-rate))
              (arg time)
              (arg (. filter arg-kinds))
            )
          )
        )
        (else
          (+= timed filter)
        )
      )
    )
    (return timed)
  )
  (fn-do _ keep-live-epochs _
    (call (. kept-group-epochs clear))
    (call (. kept-chunk-epochs clear))
    (for (in group live-groups)
      (if (and (. group is-live) (!= (. group live-epoch) null))
        (= ([] kept-group-epochs (call display-live-key (. group owner) 0)) (. group live-epoch))
      )
    )
    (for (in chunk live-chunks)
      (if (and (. chunk is-live) (!= (. chunk live-epoch) null))
        (= ([] kept-chunk-epochs (call display-live-key (. chunk owner) (. chunk phase))) (. chunk live-epoch))
      )
    )
  )
  (fn-do _ frame-metal-chunk Bool
    (param chunk DisplayChunk)
    (param renderer MetalOffscreenRenderer)
    (= is-replaying true)
    (finally
      (inline (= is-replaying false))
    )
    (call (. renderer begin-packet))
    (= current-metal-resource-renderer (. renderer native))
    (= current-metal-resource-epoch (+ (. renderer image-atlas-evictions) (. renderer image-texture-evictions)))
    (call flush-released-chunks renderer)
    (call encode-metal-chunk chunk renderer)
