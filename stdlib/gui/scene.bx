  (prop + kind U32)
  (prop + matrix Matrix)
  (prop + rect Rect)
  (prop + opacity F64)
  (prop + radius F64)
  (prop + side F64)
  (prop + offset F64)
  (prop + size F64)
  (prop + path-start U32)
  (prop + path-count U32)
  (prop + coord-start U32)
  (prop + fill-rule U32)
  (prop + serial U64)
  (prop + source U32)
  (prop + blend I32)
)

(type _ DisplayPathStyleWire (is Tuple)
  (prop + fill RGBA)
  (prop + stroke RGBA)
  (prop + stroke-width Length)
  (prop + dash Length)
  (prop + shadow-x Coord)
  (prop + shadow-y Coord)
