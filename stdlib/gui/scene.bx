    (+= fills fill)
    (return index)
  )
  (fn-do _ bump-record-generation _
    (= record-generation (call next-display-record-generation))
  )
  (fn-do _ refresh-bounds _
    (= bounds display-no-rect)
    (= has-bounds false)
    (let table (!! side))
    (if (. table has-prefix-bounds)
      (call add-ink (. table prefix-bounds))
    )
    (if (. table has-root-ink)
      (call add-ink (. table root-ink))
    )
    (let index Size 1)
    (while (< index (. table states length))
      (let state ([] (. table states) index))
      (if (. state has-local-ink)
        (let placed (call (. table state-ink-bounds) (as index U32) (. state local-ink)))
        (if placed
          (call add-ink placed)
        )
      )
      (+= index 1)
    )
  )
  (fn-do _ add-ink _
    (param rect Rect)
    (return-if (if (or (<= (. rect width) 0) (<= (. rect height) 0))))
    (blank)
    (if has-bounds
      (= bounds (+ bounds rect))
      (else
        (= bounds rect)
        (= has-bounds true)
      )
    )
  )
  (fn-do _ add-item _
    (param item DisplayItem)
    (param ink Rect)
    (param state U32 (= 0))
    (let index (as (. items length) U32))
    (+= items item)
    (+= item-glyph-layouts 4294967295)
    (let existing side)
    (if (or (!= state 0) (and (not existing) (>= (. items length) display-culling-item-count)))
      (call ensure-side)
    )
    (let current side)
    (if current
      (+= (. current item-colors) 4294967295)
      (+= (. current item-transforms) 4294967295)
      (+= (. current item-states) state)
      (+= (. current item-inks) ink)
      (+= (. current item-styles) 4294967295)
      (+= (. current item-strokes) 0)
      (+= (. current item-dashes) 0)
    )
    (let known-exacts exacts)
    (if known-exacts
      (+= (. known-exacts item-slots) 4294967295)
    )
    (if (== state 0)
      (call add-ink ink)
      (if current
        (call (. current include-root-ink) ink)
      )
      (else
        (let table (!! side))
        (call (. table include-state-ink) state ink)
        (let placed (call (. table state-ink-bounds) state ink))
        (if placed
          (call add-ink placed)
        )
      )
    )
    (return index)
  )
  (fn-do _ ensure-side _
    (let existing side)
    (return-if existing (if existing))
    (blank)
    (let created (call DisplayChunkSide))
    (+= (. created states) (call DisplayState 0 (. DisplayStateKind root)))
    (= (. created prefix-bounds) bounds)
    (= (. created has-prefix-bounds) has-bounds)
    (for (in index (..< 0 (. items length)))
      (+= (. created item-colors) 4294967295)
      (+= (. created item-transforms) 4294967295)
      (+= (. created item-states) 0)
      (+= (. created item-inks) display-unknown-ink)
      (+= (. created item-styles) 4294967295)
      (+= (. created item-strokes) 0)
      (+= (. created item-dashes) 0)
    )
    (for (in packed vector-palette)
      (+= (. created vector-colors) (call rgba8 packed))
    )
    (= side created)
    (return created)
  )
  (fn-do _ set-item-color _
    (param item-index U32)
    (param color RGBA)
    (if (== (call rgba8 (call pack-rgba8 color)) color)
      (let current side)
      (if current
        (= ([] (. current item-colors) item-index) 4294967295)
      )
      (return)
    )
    (let table (call ensure-side))
    (let slot ([] (. table item-colors) item-index))
    (if (!= slot 4294967295)
      (= ([] (. table colors) slot) color)
      (return)
    )
    (= ([] (. table item-colors) item-index) (as (. table colors length) U32))
    (+= (. table colors) color)
  )
  (fn-expr _ item-color _
    (param item-index Size)
    (param packed U32)
    (match current
      (case= null
        (call rgba8 packed)
      )
      (default
        (match ([] (. current item-colors) item-index)
          (case= 4294967295u32
            (call rgba8 packed)
          )
          (default
            ([] (. current colors) it)
          )
        )
      )
    )
    (where
      (lazy current side)
    )
  )
  (fn-do _ set-item-exact _
    (param item-index U32)
    (param rect Rect)
    (param value F64)
    (let item ([] items item-index))
    (let rect-exact (== (call display-item-rect item) rect))
    (let value-exact (== (as (. item value) F64) value))
    (return-if (if (and rect-exact value-exact)))
    (blank)
    (let table (call ensure-exacts))
    (= ([] (. table item-slots) item-index) (as (. table rects length) U32))
    (+= (. table rects) rect)
    (+= (. table values) value)
  )
  (fn-do _ ensure-exacts DisplayChunkExacts
    (let existing exacts)
    (return-if existing (if existing))
    (blank)
    (let created (call DisplayChunkExacts))
    (for (in index (..< 0 (. items length)))
      (+= (. created item-slots) 4294967295)
    )
    (= exacts created)
    (return created)
  )
  (fn-expr _ item-rect _
    (param item-index Size)
    (param item DisplayItem)
    (match current
      (case= null
        (call display-item-rect item)
      )
      (default
        (match ([] (. current item-slots) item-index)
          (case= 4294967295u32
            (call display-item-rect item)
          )
          (default
            ([] (. current rects) it)
          )
        )
      )
    )
    (where
      (lazy current exacts)
    )
  )
  (fn-expr _ item-value _
    (param item-index Size)
    (param item DisplayItem)
    (match current
      (case= null
        (. item value)
      )
      (default
        (match ([] (. current item-slots) item-index)
          (case= 4294967295u32
            (. item value)
          )
          (default
            ([] (. current values) it)
          )
        )
      )
    )
    (where
      (lazy current exacts)
    )
  )
  (fn-do _ set-item-transform _
    (param item-index U32)
    (param transform Matrix)
    (let table (call ensure-side))
    (= ([] (. table item-transforms) item-index) (as (. table transforms length) U32))
    (+= (. table transforms) transform)
  )
  (fn-expr _ item-transform _
    (param item-index Size)
    (match current
      (case= null
        null
      )
      (default
        (match ([] (. current item-transforms) item-index)
          (case= 4294967295u32
            null
          )
          (default
            ([] (. current transforms) it)
          )
        )
      )
    )
    (where
      (lazy current side)
    )
  )
  (fn-do _ add-vector-color _
    (param color RGBA)
    (let table (call ensure-side))
    (+= vector-palette (call pack-rgba8 color))
    (+= (. table vector-colors) color)
  )
  (fn-do _ demote-to-opaque _
    (= is-opaque true)
    (let owner-bounds (call (. owner bounds pad) (- (. owner focus-ring-reach))))
    (= bounds (if-expr has-bounds (+ owner-bounds bounds) owner-bounds))
    (= has-bounds (and (> (. bounds width) 0) (> (. bounds height) 0)))
  )
)

(type _ DisplayChunkExacts
  (prop + item-slots (list U32))
  (prop + rects (list Rect))
  (prop + values (list F64))
  (fn-do _ clear _
    (call (. item-slots clear))
    (call (. rects clear))
    (call (. values clear))
  )
)

(type _ DisplayChunkSide
  (prop + vector-colors (list RGBA))
  (prop + colors (list RGBA))
  (prop + item-colors (list U32))
  (prop + transforms (list Matrix))
  (prop + item-transforms (list U32))
  (prop + states (list DisplayState))
  (prop + wire-states (list DisplayStateWire))
  (prop + wire-dirty _ (= true))
  (prop + item-states (list U32))
  (prop + item-inks (list Rect))
  (prop + item-styles (list U32))
  (prop + item-strokes (list U32))
  (prop + item-dashes (list F32))
  (prop + path-verbs (list U8))
  (prop + path-coords (list F64))
  (prop + path-styles (list DisplayPathStyle))
  (prop + styled-wires (list DisplayPathStyleWire))
  (prop + gradient-wires (list DisplayGradientWire))
  (prop + gradient-stops (list GradientStop))
  (prop + shader-args (list F64))
  (prop + images (list RasterCanvas))
  (prop + image-identities (list U64))
  (prop + backdrop-shaders (list ShaderFilter))
  (prop + quads (list Quad))
  (prop + shape-clips Size)
  (prop + mask-layers Size)
  (prop + blur-layers Size)
  (prop + has-backdrop _ (= false))
  (prop + content-state U32)
  (prop + has-antialiased _ (= false))
  (prop + has-shaded-fill _ (= false))
  (prop + prefix-bounds Rect)
  (prop + has-prefix-bounds _ (= false))
  (prop + root-ink Rect)
  (prop + has-root-ink _ (= false))
  (fn-do _ clear _
    (call (. vector-colors clear))
    (call (. colors clear))
    (call (. item-colors clear))
    (call (. transforms clear))
    (call (. item-transforms clear))
    (call (. states clear))
    (+= states (call DisplayState 0 (. DisplayStateKind root)))
    (= wire-dirty true)
    (call (. item-states clear))
    (call (. item-inks clear))
    (call (. item-styles clear))
    (call (. item-strokes clear))
    (call (. item-dashes clear))
    (call (. path-verbs clear))
    (call (. path-coords clear))
    (call (. path-styles clear))
    (call (. styled-wires clear))
    (call (. gradient-wires clear))
    (call (. gradient-stops clear))
    (call (. shader-args clear))
    (call (. images clear))
    (call (. image-identities clear))
    (call (. backdrop-shaders clear))
    (call (. quads clear))
    (= shape-clips 0)
    (= mask-layers 0)
    (= blur-layers 0)
    (= has-backdrop false)
    (= content-state 0)
    (= has-antialiased false)
    (= has-shaded-fill false)
    (= prefix-bounds display-no-rect)
    (= has-prefix-bounds false)
    (= root-ink display-no-rect)
    (= has-root-ink false)
  )
  (fn-do _ include-root-ink _
    (param ink Rect)
    (return-if (if (or (<= (. ink width) 0) (<= (. ink height) 0))))
    (blank)
    (if has-root-ink
      (= root-ink (+ root-ink ink))
      (else
        (= root-ink ink)
        (= has-root-ink true)
      )
    )
  )
  (fn-do _ add-gradient _
    (param gradient Gradient)
    (let stops (. gradient stops))
    (let stop-start (as (. gradient-stops length) U32))
    (let stop-count (as (. stops length) U32))
    (for (in stop stops)
      (+= gradient-stops stop)
    )
    (match gradient
      (case (: linear LinearGradient)
        (+= gradient-wires
          (call DisplayGradientWire
            (block
              (arg (. linear start))
              (arg (. linear end))
              (arg 0)
              (arg 0)
              (arg display-gradient-linear)
              (arg stop-start)
              (arg stop-count)
            )
          )
        )
      )
      (case (: radial RadialGradient)
        (+= gradient-wires
          (call DisplayGradientWire
            (block
              (arg (. radial start-center))
              (arg (. radial end-center))
              (arg (. radial start-radius))
              (arg (. radial end-radius))
              (arg display-gradient-radial)
              (arg stop-start)
              (arg stop-count)
            )
          )
        )
      )
      (case (: conic ConicGradient)
        (+= gradient-wires
          (call DisplayGradientWire
            (block
              (arg (. conic center))
              (arg (. conic center))
              (arg (. conic angle))
              (arg 0)
              (arg display-gradient-conic)
              (arg stop-start)
              (arg stop-count)
            )
          )
        )
      )
    )
    (return (as (. gradient-wires length) U32))
  )
  (fn-do _ add-shader _
    (param rect Rect)
    (param shader Shader)
    (param args (list F64))
    (param epoch F64 (= -1))
    (let arg-start (as (. shader-args length) U32))
    (for (in arg args)
      (+= shader-args arg)
    )
    (+= gradient-wires
      (call DisplayGradientWire
        (block
          (arg (. rect top-left))
          (arg (call Point (. rect width) (. rect height)))
          (arg 0)
          (arg epoch)
          (arg display-gradient-shader)
          (arg arg-start)
          (arg (as (. args length) U32))
          (arg (. shader id))
        )
      )
    )
    (return (as (. gradient-wires length) U32))
  )
  (fn-do _ add-paint _
    (param paint Paint)
    (param color RGBA)
    (let arg-start (as (. shader-args length) U32))
    (for (in arg (. paint args))
      (+= shader-args arg)
    )
    (+= gradient-wires
      (call DisplayGradientWire
        (block
          (arg (call Point (. color red) (. color green)))
          (arg (call Point (. color blue) (. color alpha)))
          (arg 0)
          (arg 0)
          (arg display-gradient-paint)
          (arg arg-start)
          (arg (as (. paint args length) U32))
          (arg (. paint shader id))
        )
      )
    )
    (return (as (. gradient-wires length) U32))
  )
  (fn-do _ add-brush _
    (param brush Brush)
    (param color RGBA)
    (let arg-start (as (. shader-args length) U32))
    (call append-brush-arguments brush shader-args)
    (+= gradient-wires
      (call DisplayGradientWire
        (block
          (arg (call Point (. color red) (. color green)))
          (arg (call Point (. color blue) (. color alpha)))
          (arg 0)
          (arg 0)
          (arg display-gradient-brush)
          (arg arg-start)
          (arg (- (as (. shader-args length) U32) arg-start))
          (arg (. brush shader id))
        )
      )
    )
    (return (as (. gradient-wires length) U32))
  )
  (fn-do _ mask-owner _
    (param state U32)
    (let cursor state)
    (while (and (!= cursor 0) (!= (. ([] states cursor) kind) (. DisplayStateKind mask-layer)))
      (= cursor (. ([] states cursor) parent))
    )
    (return cursor)
  )
  (fn-do _ translates-at _
    (param state U32)
    (let cursor state)
    (while (!= cursor 0)
      (let entry ([] states cursor))
      (let kind (. entry kind))
      (return-if false (if (== kind (. DisplayStateKind content))))
      (return-if false (if (and (== kind (. DisplayStateKind transform)) (not (. entry matrix is-translation)))))
      (blank)
      (= cursor (. entry parent))
    )
    (return true)
  )
  (fn-do _ blend-at _
    (param state U32)
    (let cursor state)
    (while (!= cursor 0)
      (let kind (. ([] states cursor) kind))
      (return-if (. ([] states cursor) blend) (if (== kind (. DisplayStateKind blend))))
      (return-if (. BlendMode normal) (if (or (== kind (. DisplayStateKind layer)) (== kind (. DisplayStateKind mask-layer)))))
      (return-if (. BlendMode normal) (if (== kind (. DisplayStateKind blur))))
      (blank)
      (= cursor (. ([] states cursor) parent))
    )
    (return (. BlendMode normal))
  )
  (fn-do _ add-state _
    (param state DisplayState)
    (let parent ([] states (. state parent)))
    (let placed state)
    (= placed (= (. placed full) (. parent full)))
    (= placed (= (. placed clip-bounds) (. parent clip-bounds)))
    (= placed (= (. placed has-clip-bounds) (. parent has-clip-bounds)))
    (= placed (= (. placed local-ink) display-no-rect))
    (= placed (= (. placed has-local-ink) false))
    (= placed (call resolve-state placed parent))
    (let index (as (. states length) U32))
    (+= states placed)
    (if (or (== (. state kind) (. DisplayStateKind clip-outline)) (== (. state kind) (. DisplayStateKind clip-path)))
      (+= shape-clips 1)
    )
    (if (== (. state kind) (. DisplayStateKind mask-layer))
      (+= mask-layers 1)
    )
    (if (== (. state kind) (. DisplayStateKind blur))
      (+= blur-layers 1)
    )
    (= wire-dirty true)
    (return index)
  )
  (fn-do _ resolve-state _
    (param state DisplayState)
    (param parent DisplayState)
    (let placed state)
    (let kind (. state kind))
    (if (or (== kind (. DisplayStateKind transform)) (== kind (. DisplayStateKind content)))
      (= placed (= (. placed full) (call (. parent full concatenate) (. state matrix))))
      (= placed (= (. placed clip-bounds) (. parent clip-bounds)))
      (= placed (= (. placed has-clip-bounds) (. parent has-clip-bounds)))
      (return placed)
    )
    (= placed (= (. placed full) (. parent full)))
    (let clip (? Rect) null)
    (if (or (== kind (. DisplayStateKind clip)) (== kind (. DisplayStateKind clip-outline)))
      (= clip (call (. parent full transform) (. state rect)))
      (else-if (or (== kind (. DisplayStateKind clip-path)) (== kind (. DisplayStateKind clip-mask)))
        (= clip (call (. parent full transform) (. state rect)))
      )
    )
    (if clip
      (let bounded clip)
      (if (. parent has-clip-bounds)
        (= bounded (call (. parent clip-bounds intersection) bounded))
      )
      (= placed (= (. placed clip-bounds) bounded))
      (= placed (= (. placed has-clip-bounds) true))
      (else
        (= placed (= (. placed clip-bounds) (. parent clip-bounds)))
        (= placed (= (. placed has-clip-bounds) (. parent has-clip-bounds)))
      )
    )
    (return placed)
  )
  (fn-do _ refresh-states _
    (let index Size 1)
    (while (< index (. states length))
      (let state ([] states index))
      (= ([] states index) (call resolve-state state ([] states (. state parent))))
      (+= index 1)
    )
    (= wire-dirty true)
  )
  (fn-do _ refresh-wire-states _
    (return-if (if (not wire-dirty)))
    (blank)
    (call (. wire-states clear))
    (for (in state states)
      (+= wire-states
        (call DisplayStateWire
          (block
            (arg (. state parent))
            (arg (. state kind))
            (arg (. state matrix))
            (arg (. state rect))
            (arg (. state opacity))
            (arg (. state radius))
            (arg (. state side))
            (arg (. state offset))
            (arg (. state size))
            (arg (. state path-start))
            (arg (. state path-count))
            (arg (. state coord-start))
            (arg (if-expr (== (. state fill-rule) (. FillRule even-odd)) 1u32 0u32))
            (arg (. state serial))
            (arg (. state source))
            (arg (. state blend))
          )
        )
      )
    )
    (= wire-dirty false)
  )
  (fn-do _ include-state-ink _
    (param state U32)
    (param ink Rect)
    (return-if (if (or (< (. ink width) 0) (< (. ink height) 0))))
    (blank)
    (let current ([] states state))
    (if (. current has-local-ink)
      (= ([] states state) (= (. current local-ink) (+ (. current local-ink) ink)))
      (else
        (let updated (= (. current local-ink) ink))
        (= ([] states state) (= (. updated has-local-ink) true))
      )
    )
  )
  (fn-do _ state-ink-bounds _
    (param state U32)
    (param ink Rect)
    (return-if null (if (or (< (. ink width) 0) (< (. ink height) 0))))
    (blank)
    (let current ([] states state))
    (let placed (call (. current full transform) ink))
    (let bounds current)
    (if (> blur-layers 0)
      (let cursor state)
      (while (!= cursor 0)
        (let entry ([] states cursor))
        (if (== (. entry kind) (. DisplayStateKind blur))
          (let matrix (. entry full))
          (let scale (call sqrt (call abs (- (* (. matrix a) (. matrix d)) (* (. matrix b) (. matrix c))))))
          (= placed (call (. placed pad) (- (+ (* (. entry radius) scale) 1))))
          (= bounds entry)
        )
        (= cursor (. entry parent))
      )
    )
    (if (. bounds has-clip-bounds)
      (= placed (call (. placed intersection) (. bounds clip-bounds)))
    )
    (return-if null (if (or (<= (. placed width) 0) (<= (. placed height) 0))))
    (return placed)
  )
  (fn-do _ state-path-bounds _
    (param start U32)
    (param coord-start U32)
    (param count U32)
    (let coord (as coord-start Index))
    (let min-x F64)
    (let min-y F64)
    (let max-x F64)
    (let max-y F64)
    (let found false)
    (for (in verb-index (..< 0 (as count Size)))
      (let verb ([] path-verbs (+ (as start Index) verb-index)))
      (let pairs Size 0)
      (if (or (== verb (. DisplayPathVerb move)) (== verb (. DisplayPathVerb line)))
        (= pairs 1)
        (else-if (== verb (. DisplayPathVerb curve))
          (= pairs 3)
        )
      )
      (for (in pair (..< 0 pairs))
        (let x ([] path-coords coord))
        (let y ([] path-coords (+ coord 1)))
        (+= coord 2)
        (if found
          (= min-x (call min min-x x))
          (= min-y (call min min-y y))
          (= max-x (call max max-x x))
          (= max-y (call max max-y y))
          (else
            (= min-x x)
            (= min-y y)
            (= max-x x)
            (= max-y y)
            (= found true)
          )
        )
      )
    )
    (return (call Rect min-x min-y (- max-x min-x) (- max-y min-y)))
  )
)

(type _ DisplayGroup
  (prop + owner Box)
  (prop + parent (? DisplayGroup))
  (prop + members (list DisplayEntry))
  (prop + clip Rect)
  (prop + rounded-clip RoundedRect)
  (prop + has-clip _ (= false))
  (prop + shape-clip (? DisplayChunk))
  (prop + shape-clip-state U32)
  (prop + shape-clip-coords (list F64))
  (prop + shape-clip-revision U32)
  (prop + translation Point)
  (prop + order DisplayOrder)
  (prop + outer Rect)
  (prop + has-outer _ (= false))
  (prop + refresh-pending _ (= false))
  (prop + is-layer _ (= false))
  (prop + opacity Ratio (= 1%%))
  (prop + filters (list ShaderFilter))
  (prop + is-live _ (= false))
  (prop + live-rate (? F64))
  (prop + live-epoch (? F64))
  (prop + live-slot _ (= -1.0))
  (prop + live-cycle (? FrameCycle))
  (prop + is-live-settled _ (= false))
  (prop + region Rect)
  (prop + transform (? Matrix))
  (prop + inner Rect)
  (prop + has-inner _ (= false))
  (prop + record-generation U32)
  (prop + nodes (list DisplayBoxNode))
  (prop + spare-members (? (list DisplayEntry)))
  (prop + spare-nodes (? (list DisplayBoxNode)))
  (prop + refill-stamp U32)
  (prop + refill-mark U32)
  (prop + refill-index Size)
  (prop + linked-mark U32)
  (fn-do _ This _
    (param group-owner Box)
    (param group-parent (? DisplayGroup))
    (lazy owner group-owner)
    (= parent group-parent)
  )
)

(type _ DisplayBoxNode
  (prop + owner Box)
  (prop + pre (? DisplayChunk))
  (prop + post (? DisplayChunk))
  (prop + group (? DisplayGroup))
  (prop + layer-group (? DisplayGroup))
  (prop + child-list-generation U32)
  (prop + recorded-origin Point)
  (prop + container (? DisplayGroup))
  (prop + link-stamp U32)
  (prop + composite-relink _ (= false))
  (fn-do _ This _
    (param node-owner Box)
    (lazy owner node-owner)
    (= child-list-generation (. owner retained-child-list-generation))
    (= recorded-origin (. owner bounds top-left))
  )
)

(type _ DisplayFrameTable (is U8)
  (variant items)
  (variant clips)
  (variant shapes)
  (variant colors)
  (variant item-colors)
  (variant states)
  (variant item-states)
  (variant item-inks)
  (variant item-exacts)
  (variant exact-rects)
  (variant exact-values)
  (variant path-verbs)
  (variant path-coords)
  (variant styles)
  (variant gradients)
  (variant stops)
  (variant args)
  (variant quads)
  (fn-expr + width Size :get
    (case? (only-if (. DisplayItem size) (if (== this .items))))
    (case? (only-if (. Quad size) (if (== this .quads))))
    (case? (only-if (. DisplayShape size) (if (== this .shapes))))
    (case? (only-if (. RGBA size) (if (== this .colors))))
    (case? (only-if (. DisplayStateWire size) (if (== this .states))))
    (case? (only-if (. U8 size) (if (== this .path-verbs))))
    (case? (only-if (. DisplayPathStyleWire size) (if (== this .styles))))
    (case? (only-if (. DisplayGradientWire size) (if (== this .gradients))))
    (case? (only-if (. GradientStop size) (if (== this .stops))))
    (case? (only-if (. Rect size) (if (or (== this .clips) (== this .item-inks) (== this .exact-rects)))))
    (case? (only-if (. U32 size) (if (or (== this .item-colors) (== this .item-states) (== this .item-exacts)))))
    (default
      (inline (. F64 size))
    )
  )
)

(type _ DisplayFrameSpan (is Tuple)
  (prop + data Pointer)
  (prop + count Size)
)

(type _ DisplayFrameReplay
  (prop + scene _ (= (call DisplayScene)))
  (prop + chunk _ (= (call DisplayChunk (call Box) (. DisplayPhase pre))))
)

(fn-expr _ display-chunk-anchor _
  (param chunk (? DisplayChunk))
  (call DisplayAnchor (only-if (call DisplayEntry chunk null) (if chunk)) true)
)

(fn-expr _ display-group-anchor _
  (param group DisplayGroup)
  (call DisplayAnchor (only-if (call DisplayEntry null group) (if (> (. group members length) 0))) true)
)

(fn-do _ display-entry-index (? Index)
  (param members (list DisplayEntry))
  (param target DisplayEntry)
  (let index Size)
  (while (< index (. members length))
    (let entry ([] members index))
    (let same-chunk (== (as (. entry chunk) (? Pointer)) (as (. target chunk) (? Pointer))))
    (return-if index (if (and same-chunk (== (as (. entry group) (? Pointer)) (as (. target group) (? Pointer))))))
    (blank)
    (+= index 1)
  )
)

(fn-expr _ display-sprite-scale-step I64
  (param scale F64)
  (as (call ceil (/ (call log (call max scale 0.0625)) display-sprite-step)) I64)
)

(fn-expr _ display-frame-align Size
  (param offset Size)
  (* (/ (+ offset 15) 16) 16)
)

(fn-do _ frame-path-fits Bool
  (param verbs (of CPointer U8))
  (param verb-count Size)
  (param coord-count Size)
  (param start U32)
  (param count U32)
  (param coord-start U32)
  (let first (as start Size))
  (let length (as count Size))
  (return-if false (if (or (> first verb-count) (> length (- verb-count first)))))
  (blank)
  (let needed Size)
  (for (in index (..< first (+ first length)))
    (let verb ([] verbs index))
    (if (or (== verb (. DisplayPathVerb move)) (== verb (. DisplayPathVerb line)))
      (+= needed 2)
      (else-if (== verb (. DisplayPathVerb curve))
        (+= needed 6)
      )
      (else-if (!= verb (. DisplayPathVerb enclose))
        (return false)
      )
    )
  )
  (let coord (as coord-start Size))
  (return (and (<= coord coord-count) (<= needed (- coord-count coord))))
)

(fn-do _ frame-style-usable Bool
  (param wire DisplayPathStyleWire)
  (param usable (list Bool))
  (param gradients (of CPointer DisplayGradientWire))
  (if (!= (. wire gradient) 0)
    (let slot (as (- (. wire gradient) 1) Size))
    (return-if false (if (or (>= slot (. usable length)) (not ([] usable slot)))))
    (return-if false (if (== (. ([] gradients slot) kind) display-gradient-brush)))
  )
  (if (!= (. wire brush) 0)
    (let slot (as (- (. wire brush) 1) Size))
    (return-if false (if (or (>= slot (. usable length)) (not ([] usable slot)))))
    (return-if false (if (!= (. ([] gradients slot) kind) display-gradient-brush)))
  )
  (return true)
)

(fn-do _ frame-arguments (list F64)
  (param frame DisplayFrame)
  (param start U32)
  (param count U32)
  (let source (as (call (. frame table) .args) (of CPointer F64)))
  (let values (list F64))
  (for (in index (..< 0 (as count Size)))
    (+= values ([] source (+ (as start Size) index)))
  )
  (return values)
)

(fn-do _ frame-gradient Gradient
  (param frame DisplayFrame)
  (param wire DisplayGradientWire)
  (let source (as (call (. frame table) .stops) (of CPointer GradientStop)))
  (let stops (list GradientStop))
  (for (in index (..< 0 (as (. wire stop-count) Size)))
    (+= stops ([] source (+ (as (. wire stop-start) Size) index)))
  )
  (return
    (match (. wire kind)
      (case= display-gradient-radial
        (call RadialGradient (. wire start) (. wire start-radius) (. wire end) (. wire end-radius) stops)
      )
      (case= display-gradient-conic
        (call ConicGradient (. wire start) (. wire start-radius) stops)
      )
      (default
        (call LinearGradient (. wire start) (. wire end) stops)
      )
    )
  )
)

(fn-do _ display-frame-style DisplayPathStyle
  (param wire DisplayPathStyleWire)
  (param frame DisplayFrame)
  (param shaders (map U32 Shader))
  (let flags (. wire paint))
  (let fill (? RGBA) (only-if (. wire fill) (if (!= (/and/ flags 1) 0))))
  (let stroke (? RGBA) (only-if (. wire stroke) (if (!= (/and/ flags 2) 0))))
  (let gradient (? Gradient))
  (let shadow (? Shadow))
  (let shader (? Shader))
  (let shader-args (? (list F64)))
  (let paint (? Paint))
  (let brush (? Brush))
  (let gradients (as (call (. frame table) .gradients) (of CPointer DisplayGradientWire)))
  (if (!= (. wire gradient) 0)
    (let source ([] gradients (as (- (. wire gradient) 1) Size)))
    (if (== (. source kind) display-gradient-paint)
      (= paint
        (call Paint
          (block
            (arg (!! ([] shaders (. source shader))))
            (arg (call frame-arguments frame (. source stop-start) (. source stop-count)))
          )
        )
      )
      (= fill (call RGBA (. source start x) (. source start y) (. source end x) (. source end y)))
      (else-if (== (. source kind) display-gradient-shader)
        (= shader ([] shaders (. source shader)))
        (= shader-args (call frame-arguments frame (. source stop-start) (. source stop-count)))
        (= fill null)
        (= stroke null)
      )
      (else
        (= gradient (call frame-gradient frame source))
        (= fill null)
        (= stroke null)
      )
    )
  )
  (if (!= (. wire brush) 0)
    (let source ([] gradients (as (- (. wire brush) 1) Size)))
    (let values (call frame-arguments frame (. source stop-start) (. source stop-count)))
    (let extra (list F64))
    (for (in index (..< 12 (. values length)))
      (+= extra ([] values index))
    )
    (= stroke (call RGBA (. source start x) (. source start y) (. source end x) (. source end y)))
    (= brush
      (call Brush
        (block
          (arg (!! ([] shaders (. source shader))))
          (arg extra)
          (arg ([] values 0))
          (arg ([] values 1))
          (arg ([] values 2))
          (arg ([] values 3))
          (arg ([] values 4))
          (arg (only-if ([] values 5) (if (!= ([] values 6) 0))))
          (arg ([] values 7))
          (arg ([] values 8))
          (arg ([] values 9))
          (arg ([] values 10))
          (arg ([] values 11))
        )
      )
    )
  )
  (if (!= (/and/ flags 16) 0)
    (= shadow (call Shadow (. wire fill) (. wire shadow-blur) (. wire shadow-x) (. wire shadow-y)))
  )
  (return
    (call DisplayPathStyle
      (block
        (arg fill)
        (arg stroke)
        (arg (. wire stroke-width))
        (arg (call display-frame-cap (/and/ (. wire stroke-style) 15)))
        (arg (call display-frame-join (/and/ (/rshift/ (. wire stroke-style) 4) 15)))
        (arg (. wire dash))
        (arg (if-expr (!= (/and/ flags 8) 0) (. FillRule even-odd) (. FillRule nonzero)))
        (arg (!= (/and/ flags 4) 0))
        (arg gradient)
        (arg shadow)
        (arg shader)
        (arg shader-args)
        (arg paint)
        (arg brush)
      )
    )
  )
)

(fn-expr _ display-frame-cap LineCap
  (param code U32)
  (case? (only-if (. LineCap round) (if (== code 1))))
  (case? (only-if (. LineCap square) (if (== code 2))))
  (default
    (inline (. LineCap butt))
  )
)

(fn-expr _ display-frame-join LineJoin
  (param code U32)
  (case? (only-if (. LineJoin round) (if (== code 1))))
  (case? (only-if (. LineJoin bevel) (if (== code 2))))
  (default
    (inline (. LineJoin miter))
  )
)

(fn-expr _ display-item _
  (param kind U8)
  (param rect Rect)
  (param value F64)
  (param data0 U32)
  (param data1 U32 (= 0))
  (param data2 U32 (= 0))
  (param data3 U32 (= 0))
  (call DisplayItem
    (block
      (arg kind)
      (arg 0)
      (arg 0)
      (arg (as (. rect x) F32))
      (arg (as (. rect y) F32))
      (arg (as (. rect width) F32))
      (arg (as (. rect height) F32))
      (arg (as value F32))
      (arg data0)
      (arg data1)
      (arg data2)
      (arg data3)
    )
  )
)

(fn-expr _ display-shape _
  (param shape Outline)
  (param shadow (? Shadow))
  (call DisplayShape
    (block
      (arg (as (. shape effective-radius) F32))
      (arg (as (call outline-side-code (. shape arrow)) F32))
      (arg (as (?? (?. (. shape arrow) offset) 0) F32))
      (arg (as (?? (?. (. shape arrow) size) 0) F32))
      (arg (as (?? (?. shadow blur) 0) F32))
      (arg (as (?? (?. shadow x) 0) F32))
      (arg (as (?? (?. shadow y) 0) F32))
      (arg (as (?? (?. shadow spread) 0) F32))
    )
  )
)

(fn-expr _ display-shape-outline _
  (param rect Rect)
  (param shape DisplayShape)
  (call Outline rect (. shape radius) arrow)
  (where
    (lazy arrow (only-if (call OutlineArrow side (. shape offset) (. shape size)) (if side)))
    (lazy side (call display-shape-side (. shape side)))
  )
)

(fn-expr _ display-command-outline _
  (param command DisplayCommand)
  (call Outline (. command rect) (. command point1 x) arrow)
  (where
    (lazy arrow (only-if (call OutlineArrow side (. command point2 x) (. command point2 y)) (if side)))
    (lazy side (call display-shape-side (. command point1 y)))
  )
)

(fn-expr _ display-outline-within _
  (param inner Outline)
  (param outer Outline)
  (and (call (. outer bounds contains) (. inner bounds) 0.01) arrows corners)
  (where
    (lazy arrows (call display-points-near (call display-arrow-tip inner) (call display-arrow-tip outer)))
    (lazy corners (or rounded (call (. straight contains) (. inner bounds) 0.01)))
    (lazy straight (call (. outer bounds pad) (. outer effective-radius)))
    (lazy rounded (>= (. inner effective-radius) (- (. outer effective-radius) 0.01)))
  )
)

(fn-expr _ display-outline-inset _
  (param inner Outline)
  (param outer Outline)
  (param amount Length)
  (and bounds radius arrows)
  (where
    (lazy bounds (call display-rects-near (call (. inner bounds pad) (- amount)) (. outer bounds)))
    (lazy radius (< (call abs (- (. inner effective-radius) (call max 0 (- (. outer effective-radius) amount)))) 0.01))
    (lazy arrows (and (== (?. (. inner arrow) side) (?. (. outer arrow) side)) (< (call abs (- inner-offset outer-offset)) 0.01)))
    (lazy inner-offset (+ (?? (?. (. inner arrow) offset) 0) (if-expr (. inner arrow) amount 0)))
    (lazy outer-offset (?? (?. (. outer arrow) offset) 0))
  )
)

(fn-expr _ display-rects-near _
  (param a Rect)
  (param b Rect)
  (and (< (call abs (- (. a x) (. b x))) 0.01) (< (call abs (- (. a y) (. b y))) 0.01) sizes)
  (where
    (lazy sizes (and (< (call abs (- (. a width) (. b width))) 0.01) (< (call abs (- (. a height) (. b height))) 0.01)))
  )
)

(fn-expr _ display-points-near _
  (param a (? Point))
  (param b (? Point))
  (or (and (not a) (not b)) (and (!= a null) (!= b null) (< (call abs (- (. a x) (. b x))) 0.01) (< (call abs (- (. a y) (. b y))) 0.01)))
)

(fn-expr _ display-arrow-tip _
  (param shape Outline)
  (match? (?. (. shape arrow) side)
    (case= (. Side top)
      (call Point (+ (. shape bounds x) (. shape arrow-tip)) (- (. shape bounds y) size))
    )
    (case= (. Side bottom)
      (call Point (+ (. shape bounds x) (. shape arrow-tip)) (+ (. shape bounds bottom) size))
    )
    (case= (. Side left)
      (call Point (- (. shape bounds x) size) (+ (. shape bounds y) (. shape arrow-tip)))
    )
    (case= (. Side right)
      (call Point (+ (. shape bounds right) size) (+ (. shape bounds y) (. shape arrow-tip)))
    )
  )
  (where
    (lazy size (?? (?. (. shape arrow) size) 0))
  )
)

(fn-expr _ display-shape-side _
  (param code F64)
  (match? code
    (case= 0
      (. Side top)
    )
    (case= 1
      (. Side bottom)
    )
    (case= 2
      (. Side left)
    )
    (case= 3
      (. Side right)
    )
  )
)

(fn-expr _ display-item-rect _
  (param item DisplayItem)
  (call Rect (as (. item x) F64) (as (. item y) F64) (as (. item width) F64) (as (. item height) F64))
)

(fn-expr _ display-path-paint _
  (param has-fill Bool)
  (param has-stroke Bool)
  (param closed Bool)
  (param fill-rule FillRule)
  (param has-shadow Bool (= false))
  (/or/ fill stroke enclosed even-odd shadowed)
  (where
    (lazy fill (if-expr has-fill 1u32 0u32))
    (lazy stroke (if-expr has-stroke 2u32 0u32))
    (lazy enclosed (if-expr closed 4u32 0u32))
    (lazy even-odd (if-expr (== fill-rule (. FillRule even-odd)) 8u32 0u32))
    (lazy shadowed (if-expr has-shadow 16u32 0u32))
  )
)

(fn-expr _ display-stroke-style _
  (param cap LineCap)
  (param join LineJoin)
  (/or/ cap-code (/lshift/ join-code 4))
  (where
    (lazy cap-code (as (call line-cap-code cap) U32))
    (lazy join-code (as (call line-join-code join) U32))
  )
)

(fn-do _ display-shape-command DisplayCommand
  (param kind U8)
  (param rect Rect)
  (param canvas Canvas)
  (let command
    (call DisplayCommand
      (block
        (arg kind)
        (arg rect)
        (arg (call Point 0 0))
        (arg (call Point 0 0))
        (arg (call Point 0 0))
        (arg (call Matrix))
        (arg (. canvas fill-color))
        (arg (. canvas stroke-color))
        (arg (. canvas stroke-width))
        (arg (. canvas stroke-cap))
        (arg (. canvas stroke-join))
      )
    )
  )
  (= command (= (. command stroke-dash) (. canvas stroke-dash)))
  (return command)
)

(fn-expr _ display-stroke-ink _
  (param rect Rect)
  (param canvas Canvas)
  (case? (not (. canvas stroke-color))
    rect
  )
  (default
    (call (. rect inflate) (call max reach scattered))
  )
  (where
    (lazy reach (if-expr mitered (* (. canvas stroke-width) 5) (. canvas stroke-width)))
    (lazy mitered (== (. canvas stroke-join) (. LineJoin miter)))
    (lazy brush (. canvas stroke-brush))
    (lazy scattered
      (block
        (case? brush
          (+ (* (. canvas stroke-width) (+ (* 0.5 (+ 1 (call abs (. brush size-jitter)))) (* 1.2 (call abs (. brush scatter))))) 1)
        )
        (default
          0.0
        )
      )
    )
  )
)

(fn-expr _ display-outline-state _
  (param parent U32)
  (param kind U8)
  (param shape Outline)
  (call DisplayState
    (block
      (arg parent)
      (arg kind)
      (arg (call Matrix))
      (arg (. shape bounds))
      (arg (. shape radius))
      (arg (as (call outline-side-code (. shape arrow)) F64))
      (arg (?? (?. (. shape arrow) offset) 0))
      (arg (?? (?. (. shape arrow) size) 0))
    )
  )
)

(fn-expr _ display-outline-clip-command _
  (param shape Outline)
  (call DisplayCommand
    (block
      (arg (. DisplayCommandKind clip-outline))
      (arg (. shape bounds))
      (arg (call Point (. shape radius) (as (call outline-side-code (. shape arrow)) Coord)))
      (arg (call Point (?? (?. (. shape arrow) offset) 0) (?? (?. (. shape arrow) size) 0)))
    )
  )
)

(fn-expr _ display-clipped-ink _
  (param rect Rect)
  (param clip Rect)
  (param has-clip Bool)
  (if-expr has-clip (call (. rect intersection) clip) rect)
)

(fn-expr _ display-alignment-code U16
  (param alignment TextAlignment)
  (match alignment
    (case= (. TextAlignment center)
      1
    )
    (case= (. TextAlignment right)
      2
    )
    (default
      0
    )
  )
)

(fn-expr _ display-alignment _
  (param code U16)
  (match code
    (case= 1
      (. TextAlignment center)
    )
    (case= 2
      (. TextAlignment right)
    )
    (default
      (. TextAlignment left)
    )
  )
)

(fn-do _ next-display-record-generation _
  (+= display-record-generation 1)
  (if (not display-record-generation)
    (= display-record-generation 1)
  )
  (return display-record-generation)
)

(fn-do _ next-display-scene-generation _
  (+= display-scene-generation 1)
  (if (not display-scene-generation)
    (= display-scene-generation 1)
  )
  (return display-scene-generation)
)

(fn-expr _ display-damage-areas-join Bool
  (param first Rect)
  (param second Rect)
  (or (call display-rects-overlap (call (. first inflate) 2) second) (<= (call display-damage-join-growth first second) 0))
)

(fn-expr _ display-damage-join-growth F64
  (param first Rect)
  (param second Rect)
  (- (* (. joined width) (. joined height)) (* (+ (* (. first width) (. first height)) (* (. second width) (. second height))) 1.25))
  (where
    (lazy joined (+ first second))
  )
)

(fn-do _ display-chunk-path-clip U32
  (param chunk DisplayChunk)
  (let side (. chunk side))
  (return-if 0 (if (not side)))
  (blank)
  (for (in index (..< 1 (. side states length)))
    (return-if (as index U32) (if (== (. ([] (. side states) index) kind) (. DisplayStateKind clip-path))))
  )
  (return 0)
)

(fn-expr _ display-coords-equal Bool
  (param left (list F64))
  (param right (list F64))
  (== left right)
)

(fn-expr _ display-chunk-is-empty _
  (param chunk DisplayChunk)
  (if-expr (. chunk is-opaque) (== (?? (?. (. chunk commands) length) 0) 0) (== (. chunk items length) 0))
)

(fn-expr _ display-box-is-dirty _
  (param box Box)
  (or paint-invalid (. box is-retained-presentation-invalid) below)
  (where
    (lazy below (or (. box is-retained-paint-invalid-below) (. box $is-paint-invalid-below)))
    (lazy paint-invalid (or (. box is-retained-paint-invalid) (. box $is-paint-invalid)))
  )
)

(fn-expr _ display-box-needs-group _
  (param box Box)
  (or (. box clips-content) (. box is-composite-host) has-many-children)
  (where
    (lazy first (. box retained-rendered-first-child))
    (lazy has-many-children (and (!= first null) (!= (call (. box retained-rendered-next-child) first) null)))
  )
)

(fn-expr _ display-entry-bounds _
  (param entry DisplayEntry)
  (case? chunk
    (. chunk bounds)
  )
  (default
    (. group outer)
  )
  (where
    (lazy chunk (. entry chunk))
    (lazy group (!! (. entry group)))
  )
)

(fn-do _ display-detect-order _
  (param members (list DisplayEntry))
  (let count Size)
  (let first-top F64)
  (let first-left F64)
  (let highest-top F64)
  (let highest-bottom F64)
  (let highest-left F64)
  (let highest-right F64)
  (let top-lag F64)
  (let bottom-lag F64)
  (let left-lag F64)
  (let right-lag F64)
  (for (in entry members)
    (let current (call display-entry-bounds entry))
    (if (. current is-empty)
      (continue)
    )
    (if (> count 0)
      (= top-lag (call max top-lag (- highest-top (. current top))))
      (= bottom-lag (call max bottom-lag (- highest-bottom (. current bottom))))
      (= left-lag (call max left-lag (- highest-left (. current left))))
      (= right-lag (call max right-lag (- highest-right (. current right))))
      (= highest-top (call max highest-top (. current top)))
      (= highest-bottom (call max highest-bottom (. current bottom)))
      (= highest-left (call max highest-left (. current left)))
      (= highest-right (call max highest-right (. current right)))
      (else
        (= first-top (. current top))
        (= first-left (. current left))
        (= highest-top (. current top))
        (= highest-bottom (. current bottom))
        (= highest-left (. current left))
        (= highest-right (. current right))
      )
    )
    (+= count 1)
  )
  (return-if (call DisplayOrder (. DisplayAxis none) 0 0) (if (< count 2)))
  (blank)
  (let vertical-score (- highest-top first-top top-lag bottom-lag))
  (let horizontal-score (- highest-left first-left left-lag right-lag))
  (return
    (block
      (case? (and (<= vertical-score 0) (<= horizontal-score 0))
        (call DisplayOrder (. DisplayAxis none) 0 0)
      )
      (case? (>= vertical-score horizontal-score)
        (call DisplayOrder (. DisplayAxis vertical) top-lag bottom-lag)
      )
      (default
        (call DisplayOrder (. DisplayAxis horizontal) left-lag right-lag)
      )
    )
  )
)

(fn-expr _ display-order-before _
  (param order DisplayOrder)
  (param bounds Rect)
  (param damage Rect)
  (case? (== (. order axis) (. DisplayAxis vertical))
    (<= (+ (. bounds bottom) (. order end-lag)) (. damage top))
  )
  (default
    (<= (+ (. bounds right) (. order end-lag)) (. damage left))
  )
)

(fn-expr _ display-order-stop _
  (param order DisplayOrder)
  (param damage Rect)
  (case? (== (. order axis) (. DisplayAxis vertical))
    (+ (. damage bottom) (. order start-lag))
  )
  (default
    (+ (. damage right) (. order start-lag))
  )
)

(fn-expr _ display-state-outline _
  (param state DisplayState)
  (call Outline (. state rect) (. state radius) arrow)
  (where
    (lazy arrow (only-if (call OutlineArrow side (. state offset) (. state size)) (if side)))
    (lazy side (call display-shape-side (. state side)))
  )
)

(fn-expr _ display-item-culled _
  (param table DisplayChunkSide)
  (param state U32)
  (param ink Rect)
  (param damage Rect)
  (case? (or (< (. ink width) 0) (< (. ink height) 0))
    false
  )
  (case? (== state 0)
    (not (call display-rects-overlap ink damage))
  )
  (default
    (match (call (. table state-ink-bounds) state ink)
      (case= null
        true
      )
      (default
        (not (call display-rects-overlap it damage))
      )
    )
  )
)

(fn-expr _ display-pixel-rect _
  (param bounds Rect)
  (param scale F64)
  (call Rect left top (call ceil (- (. bounds right) left)) (call ceil (- (. bounds bottom) top)))
  (where
    (lazy left (/ (call floor (* (. bounds x) scale)) scale))
    (lazy top (/ (call floor (* (. bounds y) scale)) scale))
  )
)

(fn-expr _ display-image-uses-texture _
  (param image RasterCanvas)
  (param sampling F32)
  (case? (or (> sampling 0) (!= (. image color-space) (. ColorSpace srgb)) (!= (. image pixel-format) (. PixelFormat rgba8)))
    true
  )
  (default
    (> (call max (. image pixel-width) (. image pixel-height)) display-texture-image-threshold)
  )
)

(fn-expr _ display-image-scaled _
  (param image RasterCanvas)
  (param device-width F64)
  (param device-height F64)
  (or (> (call abs (- device-width (. image pixel-width))) 0.5) (> (call abs (- device-height (. image pixel-height))) 0.5))
)

(fn-expr _ display-pattern-fits-texture _
  (param image RasterCanvas)
  (and (<= (. image pixel-width) limit) (<= (. image pixel-height) limit))
  (where
    (lazy limit display-pattern-texture-limit)
  )
)

(fn-expr _ display-matrix-is-axis-aligned _
  (param matrix Matrix)
  (and (== (. matrix b) 0) (== (. matrix c) 0) (> (. matrix a) 0) (> (. matrix d) 0))
)

(fn-expr _ raster-matrix-zooms Bool
  (param matrix Matrix)
  (and (== (. matrix b) 0) (== (. matrix c) 0) (> (. matrix a) 0) (<= (call abs (- (. matrix a) (. matrix d))) (* (. matrix a) 0.000000001)))
)

(fn-expr _ raster-level I32
  (param zoom F64)
  (as (call clamp (call round (/ (call log zoom) (call log 2.0))) (as raster-lowest-level F64) (as raster-highest-level F64)) I32)
)

(fn-expr _ raster-level-scale F64
  (param level I32)
  (%% 2.0 (as level F64))
)

(fn-expr _ raster-cell-size F64
  (param level I32)
  (param scale F64)
  (/ raster-tile-interior (* scale (call raster-level-scale level)))
)

(fn-expr _ raster-ratio-fits Bool
  (param zoom F64)
  (param level I32)
  (and (<= ratio raster-cover-ratio) (>= (* ratio raster-cover-ratio) 1))
  (where
    (lazy ratio (/ zoom (call raster-level-scale level)))
  )
)

(fn-expr _ raster-lands Bool
  (param zoom F64)
  (param level I32)
  (< (call abs (- (/ zoom (call raster-level-scale level)) 1)) 0.000000001)
)

(fn-expr _ raster-grid-lands Bool
  (param zoom F64)
  (param grid RasterGrid)
  (< (call abs (- (/ zoom (. grid scale)) 1)) 0.000000001)
)

(fn-expr _ raster-octave RasterGrid
  (param level I32)
  (call RasterGrid level (call raster-level-scale level) false)
)

(fn-expr _ raster-grid-cell F64
  (param grid RasterGrid)
  (param scale F64)
  (/ raster-tile-interior (* scale (. grid scale)))
)

(fn-expr _ raster-scale-fits Bool
  (param zoom F64)
  (param scale F64)
  (and (<= ratio raster-cover-ratio) (>= (* ratio raster-cover-ratio) 1))
  (where
    (lazy ratio (/ zoom scale))
  )
)

(fn-expr _ raster-grid-key U64
  (param chunk DisplayChunk)
  (param grid RasterGrid)
  (param column I32)
  (param row I32)
  (if-expr (. grid settle) (call raster-settle-key chunk (. grid scale) column row) (call raster-key chunk (. grid level) column row))
)

(fn-expr _ raster-settle-key U64
  (param chunk DisplayChunk)
  (param scale F64)
  (param column I32)
  (param row I32)
  (/xor/ address (* cell 11400714819323198485))
  (where
    (lazy address (as (. (as chunk Pointer) address) U64))
    (lazy across (/and/ (as (+ column 32768) U64) 65535))
    (lazy down (/lshift/ (/and/ (as (+ row 32768) U64) 65535) 16))
    (lazy octaves (+ (call round (* (/ (call log scale) (call log 2.0)) raster-settle-steps)) (* 24 raster-settle-steps)))
    (lazy depth (/lshift/ (/and/ (as (call max octaves 0.0) U64) 1073741823) 32))
    (lazy cell (/or/ across down depth (/lshift/ 1u64 62) (/lshift/ 1u64 63)))
  )
)

(fn-expr _ raster-cover-draw RasterCellDraw
  (param found Bool)
  (if-expr found (. RasterCellDraw cover) (. RasterCellDraw none))
)

(fn-expr _ raster-cell-bounds Rect
  (param view RasterView)
  (param grid RasterGrid)
  (param column I32)
  (param row I32)
  (param scale F64)
  (call Rect (+ (. matrix tx) (* (as column F64) size)) (+ (. matrix ty) (* (as row F64) size)) size size)
  (where
    (lazy matrix (. view matrix))
    (lazy size (* (call raster-grid-cell grid scale) (. matrix a)))
  )
)

(fn-do _ raster-shift (? Point)
  (param chunk DisplayChunk)
  (let shift (call Point 0 0))
  (let group (. chunk parent))
  (while group
    (let transform (. group transform))
    (if transform
      (return-if null (if (not (. transform is-translation))))
      (blank)
      (= shift (+ shift (. transform translation)))
    )
    (if (. group has-clip)
      (= shift (+ shift (. group translation)))
    )
    (= group (. group parent))
  )
  (return shift)
)

(fn-expr _ raster-half I32
  (param value I32)
  (as (call floor (/ (as value F64) 2)) I32)
)

(fn-expr _ raster-content-rect Rect
  (param area Rect)
  (param view RasterView)
  (call Rect (/ (- (. area x) (. matrix tx)) zoom) (/ (- (. area y) (. matrix ty)) zoom) (/ (. area width) zoom) (/ (. area height) zoom))
  (where
    (lazy matrix (. view matrix))
    (lazy zoom (. matrix a))
  )
)

(fn-expr _ raster-cells RasterSpan
  (param area Rect)
  (param size F64)
  (call RasterSpan left top right bottom)
  (where
    (lazy left (as (call floor (/ (. area left) size)) I32))
    (lazy top (as (call floor (/ (. area top) size)) I32))
    (lazy right (as (call ceil (/ (. area right) size)) I32))
    (lazy bottom (as (call ceil (/ (. area bottom) size)) I32))
  )
)

(fn-expr _ raster-key U64
  (param chunk DisplayChunk)
  (param level I32)
  (param column I32)
  (param row I32)
  (/xor/ address (* cell 11400714819323198485))
  (where
    (lazy address (as (. (as chunk Pointer) address) U64))
    (lazy across (/and/ (as (+ column 32768) U64) 65535))
    (lazy down (/lshift/ (/and/ (as (+ row 32768) U64) 65535) 16))
    (lazy depth (/lshift/ (/and/ (as (+ level 128) U64) 255) 32))
    (lazy cell (/or/ across down depth (/lshift/ 1u64 63)))
  )
)

(fn-do _ raster-content-range (? RasterRange)
  (param chunk DisplayChunk)
  (param side DisplayChunkSide)
  (let under (list Bool))
  (+= under false)
  (for (in index (..< 1 (. side states length)))
    (let state ([] (. side states) index))
    (let inside (or (== index (as (. side content-state) Size)) ([] under (as (. state parent) Size))))
    (+= under inside)
    (if inside
      (return-if null (if (and (== (. state kind) (. DisplayStateKind blend)) (!= (. state blend) (. BlendMode normal)))))
      (blank)
      (return-if null (if (== (. state kind) (. DisplayStateKind blur))))
    )
  )
  (let first Size -1)
  (let last Size -1)
  (for (in index (..< 0 (. chunk items length)))
    (if ([] under (as ([] (. side item-states) index) Size))
      (let kind (. ([] (. chunk items) index) kind))
      (return-if null (if (or (== kind (. DisplayItemKind backdrop)) (== kind (. DisplayItemKind backdrop-shader)))))
      (blank)
      (if (< first 0)
        (= first index)
        (else-if (!= last (- index 1))
          (return null)
        )
      )
      (= last index)
    )
  )
  (return-if null (if (< first 0)))
  (blank)
  (let partial (or (> first 0) (< last (- (. chunk items length) 1))))
  (return-if null (if (and partial (or (> (. side mask-layers) 0) (> (. side blur-layers) 0)))))
  (blank)
  (return (call RasterRange first last))
)

(fn-do _ keep-raster-range _
  (param order (list U32))
  (param first Size)
  (param last Size)
  (let kept Size 0)
  (for (in position (..< 0 (. order length)))
    (let item (as ([] order position) Size))
    (if (and (>= item first) (<= item last))
      (= ([] order kept) ([] order position))
      (+= kept 1)
    )
  )
  (call (. order remove) kept (- (. order length) kept))
)

(fn-do _ fill-raster-range _
  (param order (list U32))
  (param first Size)
  (param last Size)
  (call (. order clear))
  (for (in item (..< first (+ last 1)))
    (+= order (as item U32))
  )
)

(fn-expr _ display-rect-covers Bool
  (param outer Rect)
  (param inner Rect)
  (and (<= (. outer left) (. inner left)) (<= (. outer top) (. inner top)) (>= (. outer right) (. inner right)) (>= (. outer bottom) (. inner bottom)))
)

(fn-expr _ display-rects-touch Bool
  (param left Rect)
  (param right Rect)
  (and (<= (. left left) (. right right)) (<= (. right left) (. left right)) (<= (. left top) (. right bottom)) (<= (. right top) (. left bottom)))
)

(fn-expr _ display-rect-clamp Rect
  (param area Rect)
  (param bounds Rect)
  (call Rect left top (call max 0.0 (- right left)) (call max 0.0 (- bottom top)))
  (where
    (lazy left (call max (. area left) (. bounds left)))
    (lazy top (call max (. area top) (. bounds top)))
    (lazy right (call min (. area right) (. bounds right)))
    (lazy bottom (call min (. area bottom) (. bounds bottom)))
  )
)

(fn-expr _ display-rects-overlap _
  (param left Rect)
  (param right Rect)
  (case? (or (<= (. left right) (. right left)) (<= (. right right) (. left left)))
    false
  )
  (case? (or (<= (. left bottom) (. right top)) (<= (. right bottom) (. left top)))
    false
  )
  (default
    true
  )
)

(fn-expr _ display-box-needs-layer _
  (param box Box)
  (or (< (. box computed-opacity) 1%%) (. box has-layer-filters) (!= (. box painted-transform) null))
)

(fn-expr _ display-layer-cycle (? FrameCycle)
  (param filter ShaderFilter)
  (if-expr (or (not cycle) (!= (. cycle active-per-width) 0)) null cycle)
  (where
    (lazy cycle (call shader-cycle (. filter args) (. filter arg-kinds)))
  )
)

(fn-expr _ display-live-key U64
  (param box Box)
  (param phase U8)
  (+ (* (. (as box Pointer) address) 4) phase)
)

(fn-expr _ display-matrices-equal _
  (param a (? Matrix))
  (param b (? Matrix))
  (case? (or (== a null) (== b null))
    (and (== a null) (== b null))
  )
  (default
    (== a b)
  )
)

(fn-do _ display-filters-equal Bool
  (param a (list ShaderFilter))
  (param b (list ShaderFilter))
  (return-if false (if (!= (. a length) (. b length))))
  (blank)
  (for (in index (..< 0 (. a length)))
    (let left ([] a index))
    (let right ([] b index))
    (return-if false (if (or (!= (. left shader id) (. right shader id)) (!= (. left args) (. right args)) images-differ passes-differ)))
    (blank)
    (lazy images-differ (!= (. left images) (. right images)))
    (lazy passes-differ (or (!= (. left resolution) (. right resolution)) (!= (. left keeps) (. right keeps))))
  )
  (return true)
)

(type _ DisplayCullGrid
  (prop + members (list U32))
  (prop + area Rect (= display-no-rect))
  (prop + columns Int)
  (prop + rows Int)
  (prop + cell-width F64 (= 1))
  (prop + cell-height F64 (= 1))
  (prop + starts (list U32))
  (prop + entries (list U32))
  (prop + wide (list U32))
  (fn-do + build _
    (param rects (list Rect))
    (return-if (if (== (. members length) 0)))
    (blank)
    (let first ([] rects (as ([] members 0) Size)))
    (let left (. first left))
    (let top (. first top))
    (let right (. first right))
    (let bottom (. first bottom))
    (for (in member members)
      (let rect ([] rects (as member Size)))
      (= left (call min left (. rect left)))
      (= top (call min top (. rect top)))
      (= right (call max right (. rect right)))
      (= bottom (call max bottom (. rect bottom)))
    )
    (= area (call Rect left top (- right left) (- bottom top)))
    (let target (as (call max 1 (/ (. members length) display-cull-cell-items)) F64))
    (let aspect (if-expr (> (. area height) 0) (/ (. area width) (. area height)) 1.0))
    (= columns (call clamp (as (call ceil (call sqrt (* target (call max aspect 1e-6)))) Int) 1 display-cull-max-axis))
    (= rows (call clamp (as (call ceil (/ target (as columns F64))) Int) 1 display-cull-max-axis))
    (= cell-width (call max (/ (. area width) (as columns F64)) 1e-9))
    (= cell-height (call max (/ (. area height) (as rows F64)) 1e-9))
    (let cells (as (* columns rows) Size))
    (for (in _ (..< 0 (+ cells 1)))
      (+= starts 0u32)
    )
    (for (in member members)
      (let rect ([] rects (as member Size)))
      (let first-column (call column-at (. rect left)))
      (let last-column (call column-at (. rect right)))
      (let first-row (call row-at (. rect top)))
      (let last-row (call row-at (. rect bottom)))
      (if (<= (* (+ (- last-column first-column) 1) (+ (- last-row first-row) 1)) display-cull-wide-cells)
        (for (in row (..< first-row (+ last-row 1)))
          (for (in column (..< first-column (+ last-column 1)))
            (let cell (as (+ (* row columns) column 1) Size))
            (= ([] starts cell) (+ ([] starts cell) 1))
          )
        )
      )
    )
    (for (in cell (..< 1 (+ cells 1)))
      (= ([] starts cell) (+ ([] starts cell) ([] starts (- cell 1))))
    )
    (let cursors (list U32))
    (for (in cell (..< 0 cells))
      (+= cursors ([] starts cell))
    )
    (for (in _ (..< 0 (as ([] starts cells) Size)))
      (+= entries 0u32)
    )
    (for (in member members)
      (let rect ([] rects (as member Size)))
      (let first-column (call column-at (. rect left)))
      (let last-column (call column-at (. rect right)))
      (let first-row (call row-at (. rect top)))
      (let last-row (call row-at (. rect bottom)))
      (if (<= (* (+ (- last-column first-column) 1) (+ (- last-row first-row) 1)) display-cull-wide-cells)
        (for (in row (..< first-row (+ last-row 1)))
          (for (in column (..< first-column (+ last-column 1)))
            (let cell (as (+ (* row columns) column) Size))
            (let slot ([] cursors cell))
            (= ([] entries (as slot Size)) member)
            (= ([] cursors cell) (+ slot 1))
          )
        )
        (else
          (+= wide member)
        )
      )
    )
  )
  (fn-expr _ column-at Int
    (param x F64)
    (call clamp (as (call floor (/ (- x (. area left)) cell-width)) Int) 0 (- columns 1))
  )
  (fn-expr _ row-at Int
    (param y F64)
    (call clamp (as (call floor (/ (- y (. area top)) cell-height)) Int) 0 (- rows 1))
  )
  (fn-do + estimate F64
    (param query Rect)
    (return-if 0.0 (if (or (== (. members length) 0) (not (call display-rects-touch query area)))))
    (return-if (as (. members length) F64) (if (call display-rect-covers query area)))
    (blank)
    (let first-column (call column-at (. query left)))
    (let last-column (call column-at (. query right)))
    (let reached 0u32)
    (for (in row (..< (call row-at (. query top)) (+ (call row-at (. query bottom)) 1)))
      (let start (* row columns))
      (+= reached (- ([] starts (as (+ start last-column 1) Size)) ([] starts (as (+ start first-column) Size))))
    )
    (let total (as ([] starts (- (. starts length) 1)) F64))
    (let narrow (as (- (. members length) (. wide length)) F64))
    (return (+ (as (. wide length) F64) (if-expr (> total 0) (* narrow (/ (as reached F64) total)) 0.0)))
  )
  (fn-do + gather _
    (param query Rect)
    (param rects (list Rect))
    (param index DisplayCullIndex)
    (return-if (if (or (== (. members length) 0) (not (call display-rects-touch query area)))))
    (blank)
    (if (call display-rect-covers query area)
      (for (in member members)
        (call (. index mark) member)
      )
      (return)
    )
    (let first-column (call column-at (. query left)))
    (let last-column (call column-at (. query right)))
    (let first-row (call row-at (. query top)))
    (let last-row (call row-at (. query bottom)))
    (for (in row (..< first-row (+ last-row 1)))
      (for (in column (..< first-column (+ last-column 1)))
        (let cell (as (+ (* row columns) column) Size))
        (for (in slot (..< (as ([] starts cell) Size) (as ([] starts (+ cell 1)) Size)))
          (let member ([] entries slot))
          (if (and (not (call (. index is-marked) member)) (call display-rects-touch ([] rects (as member Size)) query))
            (call (. index mark) member)
          )
        )
      )
    )
    (for (in member wide)
      (if (and (not (call (. index is-marked) member)) (call display-rects-touch ([] rects (as member Size)) query))
        (call (. index mark) member)
      )
    )
  )
)

(type _ DisplayCullIndex
  (prop + rects (list Rect))
  (prop + stamps (list U32))
  (prop + stamp U32)
  (prop + low Size)
  (prop + high Size)
  (prop + found Size)
  (prop + root DisplayCullGrid)
  (prop + content DisplayCullGrid)
  (prop + always (list U32))
  (prop + order (list U32))
  (prop + requirements (list U8))
  (prop + requirement-bits U32)
  (prop + content-state U32)
  (prop + is-usable _ (= false))
  (fn-do + This _
    (param chunk DisplayChunk)
    (let side (!! (. chunk side)))
    (= content-state (. side content-state))
    (let inverse (call Matrix))
    (if (!= content-state 0)
      (let found (call (. ([] (. side states) (as content-state Size)) full create-inverse)))
      (return-if (if (not found)))
      (blank)
      (= inverse found)
    )
    (let in-content (list Bool))
    (for (in state-index (..< 0 (. side states length)))
      (let state ([] (. side states) state-index))
      (+= in-content (and (!= state-index 0) (or (== (as state-index U32) content-state) ([] in-content (as (. state parent) Size)))))
    )
    (for (in item-index (..< 0 (. chunk items length)))
      (let ink ([] (. side item-inks) item-index))
      (let state ([] (. side item-states) item-index))
      (let member (as item-index U32))
      (+= stamps 0u32)
      (if (or (<= (. ink width) 0) (<= (. ink height) 0))
        (+= rects display-no-rect)
        (+= always member)
        (else
          (if (== state 0)
            (+= rects ink)
            (+= (. root members) member)
            (else
              (let placed (call (. ([] (. side states) (as state Size)) full transform) ink))
              (if ([] in-content (as state Size))
                (+= rects (call (. inverse transform) placed))
                (+= (. content members) member)
                (else
                  (+= rects placed)
                  (+= (. root members) member)
                )
              )
            )
          )
        )
      )
    )
    (call (. root build) rects)
    (call (. content build) rects)
    (for (in _ (..< 0 (call max (. side states length) 1)))
      (+= requirements 0u8)
    )
    (= requirement-bits
      (call metal-item-requirements
        (block
          (arg (. chunk items buffer-pointer))
          (arg (. chunk items length))
          (arg (. side item-states buffer-pointer))
          (arg (. side states length))
          (arg (. requirements buffer-pointer))
        )
      )
    )
    (= is-usable true)
  )
  (fn-expr + is-marked Bool
    (param member U32)
    (== ([] stamps (as member Size)) stamp)
  )
  (fn-do + mark _
    (param member U32)
    (let item (as member Size))
    (return-if (if (== ([] stamps item) stamp)))
    (blank)
    (= ([] stamps item) stamp)
    (+= found 1)
    (= low (call min low item))
    (= high (call max high item))
  )
  (fn-do + select Bool
    (param chunk DisplayChunk)
    (param damage Rect)
    (param scale F64)
    (let pad (/ 1 scale))
    (let query (call Rect (- (. damage x) pad) (- (. damage y) pad) (+ (. damage width) (* 2 pad)) (+ (. damage height) (* 2 pad))))
    (let content-query query)
    (if (!= content-state 0)
      (let inverse (call (. ([] (. (!! (. chunk side)) states) (as content-state Size)) full create-inverse)))
      (return-if false (if (not inverse)))
      (blank)
      (= content-query (call (. inverse transform) query))
    )
    (return (call collect query content-query))
  )
  (fn-do + select-content Bool
    (param area Rect)
    (return (call collect null area))
  )
  (fn-do _ collect Bool
    (param query (? Rect))
    (param content-query Rect)
    (let root-reach (if-expr query (call (. root estimate) query) 0.0))
    (let reach (+ root-reach (call (. content estimate) content-query) (as (. always length) F64)))
    (return-if false (if (>= (* 2 reach) (as (. rects length) F64))))
    (blank)
    (if (== stamp 4294967295u32)
      (for (in item (..< 0 (. stamps length)))
        (= ([] stamps item) 0u32)
      )
      (= stamp 0u32)
    )
    (+= stamp 1)
    (= found 0)
    (= low (. rects length))
    (= high 0)
    (if query
      (call (. root gather) query rects this)
    )
    (call (. content gather) content-query rects this)
    (for (in member always)
      (call mark member)
    )
    (return-if false (if (== found (. rects length))))
    (blank)
    (call (. order clear))
    (if (> found 0)
      (for (in item (..< low (+ high 1)))
        (if (== ([] stamps item) stamp)
          (+= order (as item U32))
        )
      )
    )
    (return true)
  )
)
