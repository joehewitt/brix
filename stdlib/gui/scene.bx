    (let scale (. renderer scale))
    (let points (/ (as raster-tile-pixels F64) scale))
    (let gutter (/ (as raster-tile-gutter F64) scale))
    (let columns (/ (as (* (as (. renderer width) F64) scale) I32) raster-tile-pixels))
    (let rows (/ (as (* (as (. renderer height) F64) scale) I32) raster-tile-pixels))
    (let capacity (* columns rows))
    (if (<= capacity 0)
      (call (. raster-wants clear))
      (return)
    )
    (call (. renderer begin-packet))
    (= current-metal-resource-renderer (. renderer native))
    (= current-metal-resource-epoch (+ (. renderer image-atlas-evictions) (. renderer image-texture-evictions)))
    (call flush-released-chunks renderer)
    (let limit (if-expr (call (. renderer take-tile-isolate)) 1 capacity))
    (call (. raster-reserved clear))
    (let slot I32)
    (let items Size 0)
    (for (in want raster-wants)
      (if (>= slot limit)
        (break)
      )
      (let chunk (. want chunk))
      (let grid (. want grid))
      (let column (. want column))
      (let row (. want row))
      (let key (call raster-grid-key chunk grid column row))
      (if (!= (. chunk path-generation) (. want generation))
        (continue)
      )
      (if (!= (call (. renderer tile-lookup-rendered) key (. want generation)) 0)
        (continue)
      )
      (if (not (. chunk owner $caches-raster))
        (continue)
      )
      (let found (call raster-view chunk))
      (if (not found)
        (continue)
      )
      (let view found)
      (let ready (call ensure-metal-chunk-resources chunk renderer))
      (if (call is-texture-pending chunk)
        (continue)
      )
      (if (not ready)
        (= (. chunk raster-blocked-pass) raster-pass)
        (continue)
      )
      (let size (call raster-grid-cell grid scale))
      (let pad (* size (/ (+ (as raster-tile-gutter F64) 1) raster-tile-interior)))
      (let area (call Rect (- (* (as column F64) size) pad) (- (* (as row F64) size) pad) (+ size (* 2 pad)) (+ size (* 2 pad))))
      (let cull (call raster-tile-cull chunk view area))
