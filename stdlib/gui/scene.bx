      (if (call ensure-metal-chunk-resources (. sprite chunk) renderer)
        (let points-width (/ (as pixel-width F64) resolution))
        (let points-height (/ (as pixel-height F64) resolution))
        (let reserved
          (call (. renderer tile-reserve)
            (block
              (arg (. want key))
              (arg (. want generation))
              (arg pixel-width)
              (arg pixel-height)
              (arg points-width)
              (arg points-height)
              (arg x)
              (arg y)
            )
          )
        )
        (if (!= reserved 0)
          (let left (/ (as x F64) scale))
          (let top (/ (as y F64) scale))
          (let zoom (/ resolution scale))
          (call (. renderer push-clip)
            (block
              (arg (call Rect left top (/ (as pixel-width F64) scale) (/ (as pixel-height F64) scale)))
            )
          )
          (call (. renderer push-transform)
            (block
              (arg (call Matrix zoom 0 0 zoom (- left (* (. bounds x) zoom)) (- top (* (. bounds y) zoom))))
            )
          )
          (call append-metal-items (. sprite chunk) renderer)
          (call (. renderer pop-transform))
          (call (. renderer pop-clip))
        )
        (+= x (+ pixel-width 2))
        (= shelf (call max shelf (+ pixel-height 2)))
      )
      (+= index 1)
    )
    (call (. renderer commit-tiles))
    (return index)
  )
  (fn-do _ append-raster-items Bool
    (param chunk DisplayChunk)
    (param renderer MetalOffscreenRenderer)
    (param cull (? DisplayCullIndex))
    (let side (!! (. chunk side)))
    (call (. side refresh-wire-states))
    (call (. raster-wires clear))
    (for (in wire (. side wire-states))
      (+= raster-wires wire)
    )
    (let rooted ([] raster-wires (. side content-state)))
    (= rooted (= (. rooted parent) 0))
    (= rooted (= (. rooted matrix) (call Matrix)))
    (= ([] raster-wires (. side content-state)) rooted)
    (return (call append-metal-items chunk renderer raster-wires cull))
  )
  (fn-expr _ is-texture-pending Bool
    (param chunk DisplayChunk)
    (call some pending-texture-chunks (:where (== (as each Pointer) (as chunk Pointer))))
  )
  (fn-do _ ensure-metal-chunk-resources _
    (param chunk DisplayChunk)
    (param renderer MetalOffscreenRenderer)
    (let cached-renderer (. chunk metal-resource-renderer))
    (if (and cached-renderer current-metal-resource-renderer)
      (let same-renderer (== cached-renderer current-metal-resource-renderer))
      (let same-epoch (== (. chunk metal-resource-epoch) current-metal-resource-epoch))
      (return-if true (if (and same-renderer same-epoch)))
    )
    (let all-registered true)
    (let movable false)
    (let pending false)
    (let item-index Size)
    (while (< item-index (. chunk items length))
      (let item ([] (. chunk items) item-index))
      (let transform (call (. chunk item-transform) item-index))
      (if (== (. item kind) (. DisplayItemKind vector))
        (let handle (call VectorGeometryHandle (. item data0) (. item data1)))
        (if (not (call (. renderer register-display-vector) resource-table handle))
          (= all-registered false)
        )
        (else-if (and transform (not (call display-matrix-is-axis-aligned transform)))
          (= all-registered false)
        )
        (else-if (== (. item kind) (. DisplayItemKind glyph))
          (if (and lacks-glyph-handle (not (call register-chunk-glyph chunk item-index)))
            (= all-registered false)
          )
          (lazy lacks-glyph-handle (== (/and/ (. item flags) display-item-has-glyph-handle) 0))
        )
        (else-if (== (. item kind) (. DisplayItemKind image))
          (let handle (call ImageHandle (. item data0) (. item data1)))
          (let full (call display-item-full item-index (. chunk side)))
          (let moves (call display-item-moves item-index (. chunk side)))
          (let exact (call display-matrix-is-axis-aligned full))
          (let has-source false)
          (if (or (not exact) moves)
            (= has-source (call (. renderer register-display-image-source) resource-table handle))
            (if (not has-source)
              (= all-registered false)
            )
          )
          (if exact
            (let rect (call display-item-rect item))
            (let device (call Rect (. rect x) (. rect y) (* (. rect width) (. full a)) (* (. rect height) (. full d))))
            (if (and (not (call (. renderer register-display-image) resource-table handle device)) (not has-source))
              (= all-registered false)
            )
          )
          (if moves
            (= movable true)
          )
        )
        (else-if (== (. item kind) (. DisplayItemKind canvas-image))
          (let image ([] (. (!! (. chunk side)) images) (. item aux)))
          (let serial (/or/ (as (. item data0) U64) (/lshift/ (as (. item data1) U64) 32)))
          (let template-alpha (!= (/and/ (. item flags) display-item-template-alpha) 0))
          (let full (call display-item-full item-index (. chunk side)))
          (let moves (call display-item-moves item-index (. chunk side)))
          (let exact (call display-matrix-is-axis-aligned full))
          (let rect (call display-item-rect item))
          (let scaling (. full scaling))
          (let scaled
            (call display-image-scaled
              (block
                (arg image)
                (arg (* (. rect width) (call abs (. scaling width)) scale))
                (arg (* (. rect height) (call abs (. scaling height)) scale))
              )
            )
          )
          (lazy uses-texture (call display-image-uses-texture image (. item value)))
          (if (or (. image is-gpu-resident) uses-texture (and scaled (not template-alpha)))
            (let state (call (. renderer register-canvas-texture) image))
            (if (== state (. TextureResidency missing))
              (= all-registered false)
              (else-if (== state (. TextureResidency pending))
                (= pending true)
              )
            )
            (else
              (let has-source false)
              (if (or (not exact) moves)
                (= has-source (call (. renderer register-canvas-image-source) image serial template-alpha))
                (if (not has-source)
                  (= all-registered false)
                )
              )
              (if exact
                (let device (call Rect (. rect x) (. rect y) (* (. rect width) (. full a)) (* (. rect height) (. full d))))
                (let registered (call (. renderer register-canvas-image) image serial device template-alpha))
                (if (and (not registered) (not has-source))
                  (= all-registered false)
                )
              )
            )
          )
          (if moves
            (= movable true)
          )
        )
        (else-if (== (. item kind) (. DisplayItemKind canvas-pattern))
          (let image ([] (. (!! (. chunk side)) images) (. item aux)))
          (if (and (not (. image is-gpu-resident)) (not (call display-pattern-fits-texture image)))
            (= all-registered false)
            (else
              (let state (call (. renderer register-canvas-texture) image))
              (if (== state (. TextureResidency missing))
                (= all-registered false)
                (else-if (== state (. TextureResidency pending))
                  (= pending true)
                )
              )
            )
          )
          (if (call display-item-moves item-index (. chunk side))
            (= movable true)
          )
        )
      )
      (+= item-index 1)
    )
    (let side (. chunk side))
    (if side
      (for (in state (. side states))
        (if (== (. state kind) (. DisplayStateKind clip-mask))
          (if (not (call (. renderer register-canvas-image-source) ([] (. side images) (. state image)) (. state serial) true))
            (= all-registered false)
          )
        )
      )
    )
    (if (and pending all-registered)
      (+= pending-texture-chunks chunk)
    )
    (if (and all-registered (not movable) (not pending))
      (= (. chunk metal-resource-renderer) (. renderer native))
      (= (. chunk metal-resource-epoch) current-metal-resource-epoch)
    )
    (return all-registered)
  )
  (fn-do _ register-chunk-glyph Bool
    (param chunk DisplayChunk)
    (param item-index Size)
    (let registrar glyph-registrar)
    (return-if false (if (not registrar)))
    (blank)
    (let layout ([] (!! (. chunk glyph-layouts)) (as ([] (. chunk item-glyph-layouts) item-index) Size)))
    (let registration (call (. registrar register-display-glyph) layout))
    (return-if false (if (not registration)))
    (blank)
    (let item ([] (. chunk items) item-index))
    (= (. chunk cull-index) null)
    (= ([] (. chunk items) item-index)
      (call DisplayItem
        (block
          (arg (. item kind))
          (arg (/or/ (. item flags) display-item-has-glyph-handle))
          (arg (. item aux))
          (arg (. item x))
          (arg (. item y))
          (arg (. item width))
          (arg (. item height))
          (arg (. item value))
          (arg (. registration index))
          (arg (. registration generation))
          (arg (. item data2))
          (arg (. item data3))
        )
      )
    )
    (let handles (?? (. chunk glyph-handles) (call (of List DisplayGlyphHandle))))
    (= (. chunk glyph-handles) handles)
    (+= handles registration)
    (return true)
  )
  (fn-expr _ display-item-full _
    (param item-index Size)
    (param side (? DisplayChunkSide))
    (case? (not side)
      (call Matrix)
    )
    (default
      (. ([] (. side states) ([] (. side item-states) item-index)) full)
    )
  )
  (fn-do _ display-item-moves _
    (param item-index Size)
    (param side (? DisplayChunkSide))
    (return-if false (if (not side)))
    (blank)
    (let cursor ([] (. side item-states) item-index))
    (while (!= cursor 0)
      (let kind (. ([] (. side states) cursor) kind))
      (return-if true (if (or (== kind (. DisplayStateKind transform)) (== kind (. DisplayStateKind content)))))
      (blank)
      (= cursor (. ([] (. side states) cursor) parent))
    )
    (return false)
  )
  (fn-do _ register-metal-opaque-tile _
    (param chunk DisplayChunk)
    (param rect Rect)
    (param renderer MetalOffscreenRenderer)
    (param key U64)
    (let width (as (. rect width) I32))
    (let height (as (. rect height) I32))
    (return-if 0u64 (if (or (<= width 0) (<= height 0))))
    (blank)
    (let surface (call metal-tile-canvas width height (. renderer scale)))
    (call (. surface push))
    (call (. surface translate) (- (. rect x)) (- (. rect y)))
    (if (or (. chunk is-opaque) (. chunk needs-tile))
      (call replay-commands chunk surface)
      (else
        (call draw-chunk-items chunk surface rect)
      )
    )
    (call (. surface pop))
    (return (call (. renderer tile-upsert) key (. chunk record-generation) surface (. rect width) (. rect height)))
  )
  (fn-do _ metal-tile-canvas _
    (param width I32)
    (param height I32)
    (param pixel-scale F64)
    (for (in index (..< 0 (. metal-tile-canvases length)))
      (let pooled ([] metal-tile-canvases index))
      (if (and (== (. pooled width) width) (== (. pooled height) height) (== (. pooled scale) pixel-scale))
        (= ([] metal-tile-canvas-frames index) metal-frames-encoded)
        (call (. pooled erase) transparent)
        (return pooled)
      )
    )
    (if (>= (. metal-tile-canvases length) metal-tile-canvas-limit)
      (call (. ([] metal-tile-canvases 0) close))
      (call (. metal-tile-canvases remove) 0)
      (call (. metal-tile-canvas-frames remove) 0)
    )
    (let created (call RasterCanvas width height pixel-scale))
    (+= metal-tile-canvases created)
    (+= metal-tile-canvas-frames metal-frames-encoded)
    (return created)
  )
  (fn-do _ trim-metal-tile-canvases _
    (let index Size)
    (while (< index (. metal-tile-canvases length))
      (if (< (+ ([] metal-tile-canvas-frames index) 1) metal-frames-encoded)
        (call (. ([] metal-tile-canvases index) close))
        (call (. metal-tile-canvases remove) index)
        (call (. metal-tile-canvas-frames remove) index)
        (else
          (+= index 1)
        )
      )
    )
  )
  (fn-do _ release-chunk-key _
    (param chunk DisplayChunk)
    (= (. chunk is-live) false)
    (= (. chunk live-epoch) null)
    (return-if (if (or (not current-metal-resource-renderer) releases-all-chunks)))
    (blank)
    (+= released-chunk-keys (. (as chunk Pointer) address))
  )
  (fn-do _ flush-released-chunks _
    (param renderer MetalOffscreenRenderer)
    (if releases-all-chunks
      (call (. renderer release-all-chunks))
      (= releases-all-chunks false)
    )
    (for (in key released-chunk-keys)
      (call (. renderer release-chunk) key)
    )
    (call (. released-chunk-keys clear))
  )
  (fn-do _ draw-chunk _
    (param chunk DisplayChunk)
    (param surface RasterCanvas)
    (param local-damage Rect)
    (+= chunks-drawn 1)
    (if (. chunk is-opaque)
      (call replay-commands chunk surface local-damage)
      (return)
    )
    (call draw-chunk-items chunk surface local-damage)
  )
  (fn-do _ draw-chunk-items _
    (param chunk DisplayChunk)
    (param surface RasterCanvas)
    (param local-damage Rect)
    (let side (. chunk side))
    (if (not side)
      (let index Size)
      (while (< index (. chunk items length))
        (call draw-item chunk ([] (. chunk items) index) index surface)
        (+= index 1)
      )
      (return)
    )
    (let table side)
    (call (. replay-states clear))
    (let index Size)
    (while (< index (. chunk items length))
      (let state ([] (. table item-states) index))
      (let hidden (and (> (. table mask-layers) 0) (!= (call (. table mask-owner) state) 0)))
      (if (and (not hidden) (not (call display-item-culled table state ([] (. table item-inks) index) local-damage)))
        (call sync-replay-state chunk table state surface)
        (call draw-item chunk ([] (. chunk items) index) index surface)
      )
      (+= index 1)
    )
    (call unwind-replay-states table 0 surface)
  )
  (fn-do _ sync-replay-state _
    (param chunk DisplayChunk)
    (param table DisplayChunkSide)
    (param state U32)
    (param surface RasterCanvas)
    (return-if (if (and (> (. replay-states length) 0) (== ([] replay-states (- (. replay-states length) 1)) state))))
    (return-if (if (and (== (. replay-states length) 0) (== state 0))))
    (blank)
    (call (. replay-path clear))
    (let cursor state)
    (while (!= cursor 0)
      (+= replay-path cursor)
      (= cursor (. ([] (. table states) cursor) parent))
    )
    (let depth Size)
    (while (and (< depth (. replay-states length)) (< depth (. replay-path length)))
      (if (!= ([] replay-states depth) ([] replay-path (- (. replay-path length) 1 depth)))
        (break)
      )
      (+= depth 1)
    )
    (call unwind-replay-states table depth surface)
    (while (< (. replay-states length) (. replay-path length))
      (let next ([] replay-path (- (. replay-path length) 1 (. replay-states length))))
      (call apply-replay-state chunk table ([] (. table states) next) surface)
      (+= replay-states next)
    )
  )
  (fn-do _ replay-mask _
    (param chunk DisplayChunk)
    (param table DisplayChunkSide)
    (param source U32)
    (param surface RasterCanvas)
    (let outer-path replay-path)
    (= replay-path (call (of List U32)))
    (let depth (. replay-states length))
    (call (. surface begin-mask))
    (let index Size)
    (while (< index (. chunk items length))
      (let state ([] (. table item-states) index))
      (if (== (call (. table mask-owner) state) source)
        (call sync-replay-state chunk table state surface)
        (call draw-item chunk ([] (. chunk items) index) index surface)
      )
      (+= index 1)
    )
    (call unwind-replay-states table depth surface)
    (call (. surface end-mask))
    (= replay-path outer-path)
  )
  (fn-do _ unwind-replay-states _
    (param table DisplayChunkSide)
    (param depth Size)
    (param surface RasterCanvas)
    (while (> (. replay-states length) depth)
      (let state (call (. replay-states pop)))
      (let kind (. ([] (. table states) state) kind))
      (if (== kind (. DisplayStateKind layer))
        (call (. surface end-opacity))
        (else-if (== kind (. DisplayStateKind blur))
          (call (. surface end-blur))
        )
      )
      (call (. surface pop))
    )
  )
  (fn-do _ apply-replay-state _
    (param chunk DisplayChunk)
    (param table DisplayChunkSide)
    (param state DisplayState)
    (param surface RasterCanvas)
    (call (. surface push))
    (let kind (. state kind))
    (if (or (== kind (. DisplayStateKind transform)) (== kind (. DisplayStateKind content)))
      (call (. surface transform) (. state matrix))
      (else-if (== kind (. DisplayStateKind clip))
        (call (. surface clip) (. state rect))
      )
      (else-if (== kind (. DisplayStateKind clip-outline))
        (call (. surface clip-outline) (call display-state-outline state))
      )
      (else-if (== kind (. DisplayStateKind clip-path))
        (call (. surface begin))
        (call trace-display-path table (. state path-start) (. state path-count) (. state coord-start) surface)
        (call (. surface clip-path) (. state fill-rule))
      )
      (else-if (== kind (. DisplayStateKind layer))
        (call (. surface begin-opacity) (. state opacity))
      )
      (else-if (== kind (. DisplayStateKind blur))
        (call (. surface begin-blur) (. state radius))
      )
      (else-if (== kind (. DisplayStateKind clip-mask))
        (call (. surface clip-mask) ([] (. table images) (. state image)) (. state rect))
      )
      (else-if (== kind (. DisplayStateKind clip-layer-mask))
        (call replay-mask chunk table (. state source) surface)
      )
      (else-if (== kind (. DisplayStateKind blend))
        (= (. surface blend-mode) (. state blend))
      )
    )
  )
  (fn-do _ trace-display-path _
    (param table DisplayChunkSide)
    (param start U32)
    (param count U32)
    (param coord-start U32)
    (param surface RasterCanvas)
    (call (. surface trace-path-buffer)
      (block
        (arg (+ (. table path-verbs buffer-pointer) (as start Index)))
        (arg count)
        (arg (+ (. table path-coords buffer-pointer) (as coord-start Index)))
      )
    )
  )
  (fn-do _ draw-item _
    (param chunk DisplayChunk)
    (param item DisplayItem)
    (param item-index Size)
    (param surface RasterCanvas)
    (+= items-drawn 1)
    (probe-count gui.frame.visible-display-items)
    (let rect (call (. chunk item-rect) item-index item))
    (if (== (. item kind) (. DisplayItemKind quad))
      (= (. surface fill-color) (call (. chunk item-color) item-index (. item data0)))
      (= (. surface stroke-color) null)
      (if (!= (/and/ (. item flags) display-item-has-shape) 0)
        (call (. surface outline) (call display-shape-outline rect ([] (. chunk shapes) (. item data1))))
        (else
          (call (. surface rect) rect)
        )
      )
      (else-if (== (. item kind) (. DisplayItemKind border))
        (= (. surface fill-color) null)
        (= (. surface stroke-color) (call (. chunk item-color) item-index (. item data0)))
        (let width (call (. chunk item-value) item-index item))
        (= (. surface stroke-width) width)
        (= (. surface stroke-join) (. LineJoin miter))
        (= (. surface stroke-dash) 0)
        (if (!= (/and/ (. item flags) display-item-has-shape) 0)
          (let outer (call display-shape-outline rect ([] (. chunk shapes) (. item data1))))
          (if (== (. item aux) 1)
            (do-use (. surface saved-state)
              (call (. surface clip-outline) outer)
              (call (. surface outline) (call (. outer grow) (/ (- width) 2)))
            )
            (else
              (call (. surface outline) (call (. outer grow) (/ (- width) 2)))
            )
          )
          (else
            (call (. surface rect) rect)
          )
        )
      )
      (else-if (== (. item kind) (. DisplayItemKind shadow))
        (let shape ([] (. chunk shapes) (. item data1)))
        (let color (call (. chunk item-color) item-index (. item data0)))
        (call (. surface shadow)
          (block
            (arg (call display-shape-outline rect shape))
            (arg (call Shadow color (. shape blur) (. shape x) (. shape y) (. shape spread)))
          )
        )
      )
      (else-if (== (. item kind) (. DisplayItemKind glyph))
        (do-use (. surface saved-state)
          (if (!= (/and/ (. item flags) display-item-has-clip) 0)
            (call (. surface clip) ([] (. chunk clips) (. item data3)))
          )
          (= (. surface text-color) (call (. chunk item-color) item-index (. item data2)))
          (let layout-index ([] (. chunk item-glyph-layouts) item-index))
          (= (. surface text-fill) (call still-fill chunk ([] (!! (. chunk glyph-fills)) layout-index)))
          (call (. surface draw-text) ([] (!! (. chunk glyph-layouts)) layout-index) rect (call display-alignment (. item aux)))
        )
      )
      (else-if (== (. item kind) (. DisplayItemKind vector))
        (call draw-vector-item chunk item item-index surface)
      )
      (else-if (== (. item kind) (. DisplayItemKind styled))
        (call draw-styled-item chunk item rect surface)
      )
      (else-if (== (. item kind) (. DisplayItemKind backdrop))
        (call (. surface backdrop-blur-in-clip) rect (. item value))
      )
      (else-if (== (. item kind) (. DisplayItemKind quads))
        (let stored (. (!! (. chunk side)) quads))
        (let start (as (. item data1) Size))
        (= (. surface stroke-color) null)
        (for (in index (..< start (+ start (as (. item data2) Size))))
          (let quad ([] stored index))
          (= (. surface fill-color) (. quad rgba))
          (call (. surface outline) (call Outline (. quad rect) (. quad radius)))
        )
      )
      (else-if (== (. item kind) (. DisplayItemKind backdrop-shader))
        (call (. surface backdrop-shader-in-clip)
          (block
            (arg rect)
            (arg (call still-backdrop chunk ([] (. (!! (. chunk side)) backdrop-shaders) (. item data0))))
            (arg (. item value))
          )
        )
      )
      (else-if (== (. item kind) (. DisplayItemKind canvas-image))
        (let table (!! (. chunk side)))
        (do-use (. surface saved-state)
          (if (!= (/and/ (. item flags) display-item-has-clip) 0)
            (call (. surface clip) ([] (. chunk clips) (. item data3)))
          )
          (let has-tint (!= (/and/ (. item flags) display-item-has-tint) 0))
          (= (. surface fill-color) (only-if (call (. chunk item-color) item-index (. item data2)) (if has-tint)))
          (let is-template (!= (/and/ (. item flags) display-item-template-alpha) 0))
          (let sampling (if-expr (> (. item value) 0) (. ImageSampling pixelated) (. ImageSampling smooth)))
          (call (. surface draw-image) ([] (. table images) (. item aux)) rect is-template sampling)
        )
      )
      (else-if (== (. item kind) (. DisplayItemKind canvas-pattern))
        (do-use (. surface saved-state)
          (if (!= (/and/ (. item flags) display-item-has-clip) 0)
            (call (. surface clip) ([] (. chunk clips) (. item data3)))
          )
          (let sampling (if-expr (> (. item value) 0) (. ImageSampling pixelated) (. ImageSampling smooth)))
          (call (. surface fill-image) ([] (. (!! (. chunk side)) images) (. item aux)) rect ([] (. chunk clips) (. item data2)) sampling)
        )
      )
      (else-if (== (. item kind) (. DisplayItemKind image))
        (let resource (call (. resource-table resolve-image) (call ImageHandle (. item data0) (. item data1))))
        (if resource
          (let tint (? RGBA))
          (if (!= (/and/ (. item flags) display-item-has-tint) 0)
            (= tint (call (. chunk item-color) item-index (. item data2)))
          )
          (call (. resource draw) (:destination surface)
            (block
              (arg rect)
              (arg tint)
            )
          )
        )
      )
    )
  )
  (fn-do _ draw-styled-item _
    (param chunk DisplayChunk)
    (param item DisplayItem)
    (param rect Rect)
    (param surface RasterCanvas)
    (let table (!! (. chunk side)))
    (let style ([] (. table path-styles) (. item data3)))
    (let has-clip (!= (/and/ (. item flags) display-item-has-clip) 0))
    (if has-clip
      (call (. surface push))
      (call (. surface clip) ([] (. chunk clips) (. item aux)))
    )
    (= (. surface fill-color) (. style fill))
    (= (. surface stroke-color) (. style stroke))
    (= (. surface stroke-width) (. style stroke-width))
    (= (. surface stroke-cap) (. style stroke-cap))
    (= (. surface stroke-join) (. style stroke-join))
    (= (. surface stroke-dash) (. style stroke-dash))
    (let op (as (. item value) U8))
    (if (. style shape-fill)
      (= (. surface shape-fill) (call still-fill chunk (. style shape-fill)))
      (call (. surface begin))
      (call trace-display-path table (. item data0) (. item data1) (. item data2) surface)
      (call (. surface end) (. style closed) (. style fill-rule))
      (= (. surface shape-fill) null)
      (else-if (. style gradient)
        (call (. surface fill-gradient) rect (. style gradient))
      )
      (else-if (. style shader)
        (call (. surface fill-shader) rect (. style shader) (!! (. style shader-args)))
      )
      (else-if (== op (. DisplayStyledShape rect))
        (call (. surface rect) rect)
      )
      (else-if (== op (. DisplayStyledShape oval))
        (call (. surface oval) rect)
      )
      (else-if (. style shadow)
        (call (. surface begin))
        (call trace-display-path table (. item data0) (. item data1) (. item data2) surface)
        (call (. surface shadow-path) (. style shadow))
      )
      (else
        (= (. surface fill-paint) (. style paint))
        (= (. surface stroke-brush) (. style brush))
        (call (. surface begin))
        (call trace-display-path table (. item data0) (. item data1) (. item data2) surface)
        (call (. surface end) (. style closed) (. style fill-rule))
        (= (. surface fill-paint) null)
        (= (. surface stroke-brush) null)
      )
    )
    (if has-clip
      (call (. surface pop))
    )
  )
  (fn-do _ draw-vector-item _
    (param chunk DisplayChunk)
    (param item DisplayItem)
    (param item-index Size)
    (param surface RasterCanvas)
    (let handle (call VectorGeometryHandle (. item data0) (. item data1)))
    (let geometry (call (. resource-table require) handle))
    (let view (. geometry view-box))
    (return-if (if (or (<= (. view width) 0) (<= (. view height) 0))))
    (blank)
    (let transform (!! (call (. chunk item-transform) item-index)))
    (let colors (. (!! (. chunk side)) vector-colors))
    (do-use (. surface saved-state)
      (if (!= (/and/ (. item flags) display-item-has-clip) 0)
        (call (. surface clip) ([] (. chunk clips) (. item aux)))
      )
      (let inherited-offset (+ (. item data2) (. item data3)))
      (if (!= (/and/ (. item flags) display-item-has-inherited-fill) 0)
        (= (. surface fill-color) ([] colors inherited-offset))
        (+= inherited-offset 1)
        (else
          (= (. surface fill-color) null)
        )
      )
      (if (!= (/and/ (. item flags) display-item-has-inherited-stroke) 0)
        (= (. surface stroke-color) ([] colors inherited-offset))
        (else
          (= (. surface stroke-color) null)
        )
      )
      (= (. surface stroke-width) (call (. chunk item-value) item-index item))
      (let style-index ([] (. (!! (. chunk side)) item-styles) item-index))
      (if (!= style-index 4294967295)
        (let style ([] (. (!! (. chunk side)) path-styles) style-index))
        (= (. surface stroke-cap) (. style stroke-cap))
        (= (. surface stroke-join) (. style stroke-join))
        (= (. surface stroke-dash) (. style stroke-dash))
      )
      (let cached
        (call (. resource-table paint-vector-cached)
          (block
            (arg handle)
            (arg surface)
            (arg colors)
            (arg (. item data2))
            (arg (. item data3))
            (arg transform)
          )
        )
      )
      (if (not cached)
        (call (. surface transform) transform)
        (call (. geometry paint-offset) surface colors (. item data2))
      )
    )
  )
  (fn-expr _ still-fill (? ShaderFill)
    (param chunk DisplayChunk)
    (param fill (? ShaderFill))
    (case? (not fill)
      null
    )
    (case? (not (. fill is-live))
      fill
    )
    (default
      (call ShaderFill (. fill shader) (. fill args) true (. fill frame-rate) (call max 0 (- (. recorder live-time) epoch)))
    )
    (where
      (lazy epoch (?? (. chunk live-epoch) (. recorder live-time)))
    )
  )
  (fn-expr _ still-backdrop ShaderFilter
    (param chunk DisplayChunk)
    (param backdrop ShaderFilter)
    (case? (or (not (. backdrop is-live)) (not (. chunk owner $animates-fills)))
      backdrop
    )
    (default
      (call ShaderFilter
        (block
          (arg (. backdrop shader))
          (arg (. backdrop args))
          (arg (. backdrop images))
          (arg true)
          (arg (. backdrop frame-rate))
          (arg (call max 0 (- (. recorder live-time) epoch)))
          (arg (. backdrop arg-kinds))
        )
      )
    )
    (where
      (lazy epoch (?? (. chunk live-epoch) (. recorder live-time)))
    )
  )
  (fn-do _ command-text-fill (? ShaderFill)
    (param chunk DisplayChunk)
    (param layout TextLayout)
    (let layouts (. chunk glyph-layouts))
    (return-if null (if (not layouts)))
    (blank)
    (for (in index (..< 0 (. layouts length)))
      (return-if (call still-fill chunk ([] (!! (. chunk glyph-fills)) index)) (if same-layout))
      (blank)
      (lazy same-layout (== (as ([] layouts index) Pointer) (as layout Pointer)))
    )
    (return null)
  )
  (fn-do _ replay-commands _
    (param chunk DisplayChunk)
    (param surface RasterCanvas)
    (param local-damage (? Rect) (= null))
    (let side (. chunk side))
    (let commands (. chunk commands))
    (return-if (if (not commands)))
    (blank)
    (let index Size)
    (while (< index (. commands length))
      (let command ([] commands index))
      (if (== (. command kind) (. DisplayCommandKind push))
        (call (. surface push))
        (else-if (== (. command kind) (. DisplayCommandKind pop))
          (call (. surface pop))
        )
        (else-if (== (. command kind) (. DisplayCommandKind clip))
          (call (. surface clip) (. command rect))
        )
        (else-if (== (. command kind) (. DisplayCommandKind clip-path))
          (let state ([] (. (!! side) states) (. command item-index)))
          (call (. surface begin))
          (call trace-display-path (!! side) (. state path-start) (. state path-count) (. state coord-start) surface)
          (call (. surface clip-path) (. state fill-rule))
        )
        (else-if (== (. command kind) (. DisplayCommandKind clip-mask))
          (call (. surface clip-mask) (!! (. command image)) (. command rect))
        )
        (else-if (== (. command kind) (. DisplayCommandKind begin-mask))
          (call (. surface begin-mask))
        )
        (else-if (== (. command kind) (. DisplayCommandKind end-mask))
          (call (. surface end-mask))
        )
        (else-if (== (. command kind) (. DisplayCommandKind blend))
          (= (. surface blend-mode) (. command blend))
        )
        (else-if (== (. command kind) (. DisplayCommandKind clip-outline))
          (call (. surface clip-outline) (call display-command-outline command))
        )
        (else-if (== (. command kind) (. DisplayCommandKind transform))
          (call (. surface transform) (. command matrix))
        )
        (else-if (== (. command kind) (. DisplayCommandKind rect))
          (call apply-command-state command surface)
          (call (. surface rect) (. command rect))
        )
        (else-if (== (. command kind) (. DisplayCommandKind oval))
          (call apply-command-state command surface)
          (call (. surface oval) (. command rect))
        )
        (else-if (== (. command kind) (. DisplayCommandKind gradient))
          (call (. surface fill-gradient) (. command rect) (!! (. command gradient)))
        )
        (else-if (== (. command kind) (. DisplayCommandKind shader))
          (call (. surface fill-shader) (. command rect) (!! (. command shader)) (!! (. command shader-args)))
        )
        (else-if (== (. command kind) (. DisplayCommandKind begin-filter))
          (call (. surface begin-filter)
            (block
              (arg (. command rect))
              (arg (call ShaderFilter (!! (. command shader)) (!! (. command shader-args)) (!! (. command shader-images))))
            )
          )
        )
        (else-if (== (. command kind) (. DisplayCommandKind end-filter))
          (call (. surface end-filter))
        )
        (else-if (== (. command kind) (. DisplayCommandKind text))
          (= (. surface text-color) (?? (. command fill) transparent))
          (= (. surface text-fill) (call command-text-fill chunk (!! (. command layout))))
          (call (. surface draw-text) (!! (. command layout)) (. command rect) (. command alignment))
        )
        (else-if (== (. command kind) (. DisplayCommandKind image))
          (= (. surface fill-color) (. command fill))
          (call (. surface draw-image) (!! (. command image)) (. command rect) (. command flag) (. command sampling))
        )
        (else-if (== (. command kind) (. DisplayCommandKind image-pattern))
          (let tile (call Rect (. command point1 x) (. command point1 y) (. command point2 x) (. command point2 y)))
          (call (. surface fill-image) (!! (. command image)) (. command rect) tile (. command sampling))
        )
        (else-if (== (. command kind) (. DisplayCommandKind item))
          (let item-index (as (. command item-index) Size))
          (let visible (or (not local-damage) (not side) (!= ([] (. side item-states) item-index) 0)))
          (if (or visible (not (call display-item-culled (!! side) 0 ([] (. (!! side) item-inks) item-index) (!! local-damage))))
            (call draw-item
              (block
                (arg chunk)
                (arg ([] (. chunk items) item-index))
                (arg item-index)
                (arg surface)
              )
            )
          )
        )
        (else-if (== (. command kind) (. DisplayCommandKind frame))
          (call replay-frame-items chunk command surface)
        )
        (else-if (== (. command kind) (. DisplayCommandKind erase))
          (call (. surface erase) (. command fill))
        )
        (else-if (== (. command kind) (. DisplayCommandKind begin-opacity))
          (call (. surface begin-opacity) (. command point1 x))
        )
        (else-if (== (. command kind) (. DisplayCommandKind end-opacity))
          (call (. surface end-opacity))
        )
        (else-if (== (. command kind) (. DisplayCommandKind begin-blur))
          (call (. surface begin-blur) (. command point1 x))
        )
        (else-if (== (. command kind) (. DisplayCommandKind end-blur))
          (call (. surface end-blur))
        )
      )
      (+= index 1)
    )
  )
  (fn-do _ replay-frame-items _
    (param chunk DisplayChunk)
    (param command DisplayCommand)
    (param surface RasterCanvas)
    (let table (!! (. chunk side)))
    (let outer (as (. command point1 y) U32))
    (let first (as (. command item-index) Size))
    (let count (as (. command point1 x) Size))
    (call (. replay-states clear))
    (call (. replay-path clear))
    (let cursor outer)
    (while (!= cursor 0)
      (+= replay-path cursor)
      (= cursor (. ([] (. table states) cursor) parent))
    )
    (while (> (. replay-path length) 0)
      (+= replay-states (call (. replay-path pop)))
    )
    (let depth (. replay-states length))
    (for (in index (..< first (+ first count)))
      (let state ([] (. table item-states) index))
      (let hidden (and (> (. table mask-layers) 0) (> (call (. table mask-owner) state) outer)))
      (if (not hidden)
        (call sync-replay-state chunk table state surface)
        (call draw-item chunk ([] (. chunk items) index) index surface)
      )
    )
    (call unwind-replay-states table depth surface)
    (call (. replay-states clear))
  )
  (fn-do _ apply-command-state _
    (param command DisplayCommand)
    (param surface RasterCanvas)
    (= (. surface fill-color) (. command fill))
    (= (. surface stroke-color) (. command stroke))
    (= (. surface stroke-width) (. command stroke-width))
    (= (. surface stroke-cap) (. command stroke-cap))
    (= (. surface stroke-join) (. command stroke-join))
    (= (. surface stroke-dash) (. command stroke-dash))
  )
  (fn-do _ first-member-toward _
    (param members (list DisplayEntry))
    (param order DisplayOrder)
    (param local-damage Rect)
    (return-if 0 (if (or (== (. order axis) (. DisplayAxis none)) (== (. members length) 0))))
    (blank)
    (let head (call display-entry-bounds ([] members 0)))
    (return-if 0 (if (and (not (. head is-empty)) (not (call display-order-before order head local-damage)))))
    (blank)
    (let low Size)
    (let high (. members length))
    (while (< low high)
      (+= cull-tests 1)
      (probe-count gui.scene.cull-tests)
      (let middle (/ (+ low high) 2))
      (let probe middle)
      (let bounds (call display-entry-bounds ([] members probe)))
      (while (and (. bounds is-empty) (< (+ probe 1) high))
        (+= probe 1)
        (= bounds (call display-entry-bounds ([] members probe)))
      )
      (if (and (not (. bounds is-empty)) (call display-order-before order bounds local-damage))
        (= low (+ probe 1))
        (else
          (= high middle)
        )
      )
    )
    (return low)
  )
  (fn-do _ window-bounds _
    (param local Rect)
    (param parent (? DisplayGroup))
    (let result local)
    (let group parent)
    (while group
      (let transform (. group transform))
      (if transform
        (= result (call (. transform transform) result))
      )
      (if (. group has-clip)
        (= result (call (. (+ result (. group translation)) intersection) (. group clip)))
      )
      (= group (. group parent))
    )
    (return result)
  )
  (fn-expr _ align-damage-to-device _
    (param rect Rect)
    (call Rect left top (- right left) (- bottom top))
    (where
      (lazy left (/ (call floor (* (. rect left) scale)) scale))
      (lazy top (/ (call floor (* (. rect top) scale)) scale))
      (lazy right (/ (call ceil (* (. rect right) scale)) scale))
      (lazy bottom (/ (call ceil (* (. rect bottom) scale)) scale))
    )
  )
)

(fn-do + draw-display-frame Bool
  (param canvas Canvas)
  (param frame DisplayFrame)
  (param shaders (map U32 Shader))
  (param placement Matrix)
  (param bounds Rect)
  (match? canvas
    (case (: recorder DisplayRecorder)
      (return (call (. recorder draw-frame) frame shaders placement bounds))
    )
    (case (: raster RasterCanvas)
      (let replay display-frame-replay)
      (let chunk (. replay chunk))
      (call (. chunk reset))
      (let recorder (. replay scene recorder))
      (call (. recorder begin-chunk) chunk)
      (let drawn (call (. recorder draw-frame) frame shaders placement bounds))
      (call (. recorder end-chunk))
      (if drawn
        (call (. replay scene draw-chunk)
          (block
            (arg chunk)
            (arg raster)
            (arg (call Rect -1000000000 -1000000000 2000000000 2000000000))
          )
        )
      )
      (return drawn)
    )
  )
  (return false)
)

(fn-do + draw-display-sprite Bool
  (param canvas Canvas)
  (param sprite DisplaySprite)
  (param pixel-scale (? F64) (= null))
  (param sampling _ (= (. ImageSampling smooth)))
  (match? canvas
    (case (: recorder DisplayRecorder)
      (return (call (. recorder draw-sprite) sprite pixel-scale sampling))
    )
  )
  (return false)
)

(fn-do + display-frame-format U64
  (let hash display-frame-magic)
  (for (in index (..< 0 display-frame-table-count))
    (= hash (* (/xor/ hash (as (. (as index DisplayFrameTable) width) U64)) 11400714819323198485))
    (= hash (/xor/ hash (/rshift/ hash 29)))
  )
  (return hash)
)

(fn-expr + merged-live-fills LiveFillState
  (param first LiveFillState)
  (param second LiveFillState)
  (case? (not (. second is-visible))
    (call LiveFillState (. first is-visible) (. first frame-rate) wake)
  )
  (case? (not (. first is-visible))
    (call LiveFillState true (. second frame-rate) wake)
  )
  (default
    (call LiveFillState true rate wake)
  )
  (where
    (lazy wake (if-expr (and (!= (. first wake-at) null) (!= (. second wake-at) null)) earlier-wake any-wake))
    (lazy earlier-wake (call min (. first wake-at) (. second wake-at)))
    (lazy any-wake (?? (. first wake-at) (. second wake-at)))
    (lazy rate (only-if higher-rate (if (and (!= (. first frame-rate) null) (!= (. second frame-rate) null)))))
    (lazy higher-rate (call max (. first frame-rate) (. second frame-rate)))
  )
)

(type _ DisplayItemKind (is U8)
  (variant quad)
  (variant border)
  (variant glyph)
  (variant vector)
  (variant image)
  (variant opaque)
  (variant shadow (= 7))
  (variant styled (= 8))
  (variant canvas-image (= 9))
  (variant backdrop (= 10))
  (variant canvas-pattern (= 11))
  (variant sprite (= 12))
  (variant backdrop-shader (= 13))
  (variant quads (= 14))
)

(type _ DisplayStyledShape (is U8)
  (variant rect)
  (variant oval)
  (variant path)
)

(type _ DisplayStateKind (is U8)
  (variant root)
  (variant transform)
  (variant content)
  (variant clip)
  (variant clip-outline)
  (variant clip-path)
  (variant layer)
  (variant clip-mask)
  (variant mask-layer)
  (variant clip-layer-mask)
  (variant blend)
  (variant blur)
)

