      (call (. current add-item)
        (block
          (arg item)
          (arg (if-expr (== current-state 0) (call root-ink rect) rect))
          (arg current-state)
        )
      )
    )
    (+= sprites sprite)
    (return true)
  )
  (fn-do + draw-frame Bool
    (param frame DisplayFrame)
    (param shaders (map U32 Shader))
    (param placement Matrix)
    (param bounds Rect)
    (return-if false (if (or (not chunk) (not (. frame is-valid)))))
    (blank)
    (let current chunk)
    (let table (call (. current ensure-side)))
    (let saved current-state)
    (let first (. current items length))
    (let marked (. recorded-commands length))
    (call enter-state (= (. (call DisplayState 0 (. DisplayStateKind transform)) matrix) placement))
    (call enter-state (= (. (call DisplayState 0 (. DisplayStateKind clip)) rect) bounds))
    (let base current-state)
    (= current-state saved)
    (let verb-offset (as (. table path-verbs length) U32))
    (let coord-offset (as (. table path-coords length) U32))
    (let gradient-offset (as (. table gradient-wires length) U32))
    (let verb-count (call (. frame count) .path-verbs))
    (let coord-count (call (. frame count) .path-coords))
    (let verbs (as (call (. frame table) .path-verbs) (of CPointer U8)))
    (let coords (as (call (. frame table) .path-coords) (of CPointer F64)))
    (for (in index (..< 0 verb-count))
      (+= (. table path-verbs) ([] verbs index))
    )
    (for (in index (..< 0 coord-count))
      (+= (. table path-coords) ([] coords index))
    )
    (let usable (call append-frame-gradients frame shaders table))
    (let mapped (call append-frame-states frame table base verb-offset coord-offset))
    (let state-count (. mapped length))
    (let items (as (call (. frame table) .items) (of CPointer DisplayItem)))
    (let item-count (call (. frame count) .items))
    (let item-states (as (call (. frame table) .item-states) (of CPointer U32)))
    (let item-inks (as (call (. frame table) .item-inks) (of CPointer Rect)))
    (let item-colors (as (call (. frame table) .item-colors) (of CPointer U32)))
    (let item-exacts (as (call (. frame table) .item-exacts) (of CPointer U32)))
    (let clips (as (call (. frame table) .clips) (of CPointer Rect)))
    (let shapes (as (call (. frame table) .shapes) (of CPointer DisplayShape)))
    (let colors (as (call (. frame table) .colors) (of CPointer RGBA)))
    (let records (as (call (. frame table) .quads) (of CPointer Quad)))
    (let quad-count (call (. frame count) .quads))
    (let exact-rects (as (call (. frame table) .exact-rects) (of CPointer Rect)))
    (let exact-values (as (call (. frame table) .exact-values) (of CPointer F64)))
    (let styles (as (call (. frame table) .styles) (of CPointer DisplayPathStyleWire)))
    (let gradients (as (call (. frame table) .gradients) (of CPointer DisplayGradientWire)))
    (let style-count (call (. frame count) .styles))
    (let exact-count (call min (call (. frame count) .exact-rects) (call (. frame count) .exact-values)))
    (let per-item (call min item-count (call (. frame count) .item-states)))
    (let inked (call (. frame count) .item-inks))
    (let colored (call (. frame count) .item-colors))
    (let exacted (call (. frame count) .item-exacts))
    (for (in index (..< 0 per-item))
      (let item ([] items index))
      (let kind (. item kind))
      (let rectangular (or (== kind (. DisplayItemKind quad)) (== kind (. DisplayItemKind border))))
      (let drawable (or rectangular (== kind (. DisplayItemKind shadow))))
      (let batched (== kind (. DisplayItemKind quads)))
      (if (and (not drawable) (not batched) (!= kind (. DisplayItemKind styled)))
        (continue)
      )
      (let local-state (as ([] item-states index) Size))
      (if (>= local-state state-count)
        (continue)
      )
      (if batched
        (let start (as (. item data1) Size))
        (let span (as (. item data2) Size))
        (if (<= (+ start span) quad-count)
          (call restyle-frame-quads ([] mapped local-state) records start span)
        )
        (continue)
      )
      (let placed item)
      (if (!= (/and/ (. item flags) display-item-has-clip) 0)
        (if (>= (as (. item aux) Size) (call (. frame count) .clips))
          (continue)
        )
      )
      (if (!= (/and/ (. item flags) display-item-has-shape) 0)
        (if (>= (as (. item data1) Size) (call (. frame count) .shapes))
          (continue)
        )
      )
      (let state ([] mapped local-state))
      (if (and is-quad-or-border (not (call (. table translates-at) state)))
        (let tone (call rgba8 (. item data0)))
        (if (and (< index colored) (< (as ([] item-colors index) Size) (call (. frame count) .colors)))
          (= tone ([] colors (as ([] item-colors index) Size)))
        )
        (let box (call display-item-rect item))
        (let value (as (. item value) F64))
        (if (and (< index exacted) (< (as ([] item-exacts index) Size) exact-count))
          (= box ([] exact-rects (as ([] item-exacts index) Size)))
          (= value ([] exact-values (as ([] item-exacts index) Size)))
        )
        (let shape (? Outline))
        (if (!= (/and/ (. item flags) display-item-has-shape) 0)
          (= shape (call display-shape-outline box ([] shapes (as (. item data1) Index))))
        )
        (call restyle-frame-item kind state box value tone (== (. item aux) 1) shape)
        (continue)
      )
      (lazy is-quad-or-border (or (== kind (. DisplayItemKind quad)) (== kind (. DisplayItemKind border))))
      (if (== kind (. DisplayItemKind styled))
        (let ordinal (as (. item data3) Size))
        (if (>= ordinal style-count)
          (continue)
        )
        (let wire ([] styles ordinal))
        (if (not (call frame-style-usable wire usable gradients))
          (continue)
        )
        (lazy path-fits
          (call frame-path-fits
            (block
              (arg verbs)
              (arg verb-count)
              (arg coord-count)
              (arg (. item data0))
              (arg (. item data1))
              (arg (. item data2))
            )
          )
        )
        (if (and (== (as (. item value) U8) (. DisplayStyledShape path)) (not path-fits))
          (continue)
        )
        (if (== (as (. item value) U8) (. DisplayStyledShape path))
          (= placed (= (. placed data0) (+ (. item data0) verb-offset)))
          (= placed (= (. placed data2) (+ (. item data2) coord-offset)))
        )
        (= placed (= (. placed data3) (as (. table path-styles length) U32)))
        (+= (. table path-styles) (call display-frame-style wire frame shaders))
        (let gradient-index (if-expr (!= (. wire gradient) 0) (+ (. wire gradient) gradient-offset) 0u32))
        (let brush-index (if-expr (!= (. wire brush) 0) (+ (. wire brush) gradient-offset) 0u32))
        (let remapped (= (. wire gradient) gradient-index))
        (+= (. table styled-wires) (= (. remapped brush) brush-index))
        (= (. table has-antialiased) true)
      )
      (if (!= (/and/ (. item flags) display-item-has-clip) 0)
        (= placed (= (. placed aux) (as (. current clips length) U16)))
        (+= (. current clips) ([] clips (as (. item aux) Index)))
      )
      (if (!= (/and/ (. item flags) display-item-has-shape) 0)
        (= placed (= (. placed data1) (as (. current shapes length) U32)))
        (+= (. current shapes) ([] shapes (as (. item data1) Index)))
      )
      (let ink (if-expr (< index inked) ([] item-inks index) display-unknown-ink))
      (let added (call (. current add-item) placed ink state))
      (if (< index colored)
        (let slot (as ([] item-colors index) Size))
        (if (< slot (call (. frame count) .colors))
          (call (. current set-item-color) added ([] colors slot))
        )
      )
      (if (< index exacted)
        (let slot (as ([] item-exacts index) Size))
        (if (< slot exact-count)
          (call (. current set-item-exact) added ([] exact-rects slot) ([] exact-values slot))
        )
      )
    )
    (while (> (. recorded-commands length) marked)
      (call (. recorded-commands pop))
    )
    (let count (- (. current items length) first))
    (if (> count 0)
      (let replayed
        (call DisplayCommand
          (block
            (arg (. DisplayCommandKind frame))
            (arg display-no-rect)
            (arg (call Point (as count F64) (as saved F64)))
          )
        )
      )
      (+= recorded-commands (= (. replayed item-index) (as first U32)))
    )
    (return true)
  )
  (fn-do _ begin-chunk _
    (param next DisplayChunk)
    (= chunk next)
    (call (. recorded-commands clear))
    (= has-clip-rect false)
    (= clip-shape null)
    (call (. clip-stack clear))
    (= current-state 0)
    (= path-open false)
  )
  (fn-do _ end-chunk _
    (let current chunk)
    (if (and current (. current needs-tile))
      (call keep-commands current)
    )
    (= chunk null)
  )
  (fn-do _ keep-commands _
    (param target DisplayChunk)
    (let kept (?? (. target commands) (call (of List DisplayCommand))))
    (= (. target commands) kept)
    (call (. kept clear))
    (++= kept recorded-commands)
  )
  (fn-do _ has-paint-since _
    (param start Size)
    (let index start)
    (while (< index (. recorded-commands length))
      (let command ([] recorded-commands index))
      (let kind (. command kind))
      (match? kind
        (case? (or (== it (. DisplayCommandKind rect)) (== it (. DisplayCommandKind oval)))
          (return-if true (if (or (. command fill) (. command stroke))))
        )
        (case? (or (== it (. DisplayCommandKind text)) (== it (. DisplayCommandKind image)) (== it (. DisplayCommandKind item)))
          (return true)
        )
        (case? (== it (. DisplayCommandKind frame))
          (return true)
        )
        (case? (== it (. DisplayCommandKind image-pattern))
          (return true)
        )
        (case? (== it (. DisplayCommandKind erase))
          (return true)
        )
        (case? (or (== it (. DisplayCommandKind gradient)) (== it (. DisplayCommandKind shader)))
          (return true)
        )
      )
      (+= index 1)
    )
    (return false)
  )
  (fn-expr _ root-ink _
    (param rect Rect)
    (call display-clipped-ink rect clip-rect root-clip-active)
  )
  (fn-do _ enter-state _
    (param state DisplayState)
    (call materialize-root-clip)
    (= current-state (call (. (call (. (!! chunk) ensure-side)) add-state) (= (. state parent) current-state)))
  )
  (fn-do _ materialize-root-clip _
    (return-if (if (!= current-state 0)))
    (blank)
    (let table (call (. (!! chunk) ensure-side)))
    (if has-clip-rect
      (let clip-state (call DisplayState 0 (. DisplayStateKind clip)))
      (= current-state (call (. table add-state) (= (. clip-state rect) clip-rect)))
    )
    (let shape clip-shape)
    (if shape
      (let outline (call display-outline-state current-state (. DisplayStateKind clip-outline) shape))
      (= current-state (call (. table add-state) outline))
    )
  )
  (fn-do _ promote-root-clip _
    (return-if (if (not root-clip-shape)))
    (blank)
    (call materialize-root-clip)
  )
  (fn-do _ contain-root-clip _
    (param extent Rect)
    (if (and root-clip-active (not (call (. clip-rect contains) extent 0.01)))
      (call materialize-root-clip)
    )
  )
  (fn-do _ fill-outline _
    (param shape Outline)
    (let clipping root-clip-shape)
    (if clipping
      (let covers (and (. shape is-rectangular) (call (. shape bounds contains) (. clipping extent) 0.01)))
      (if (or covers (== shape clipping))
        (call record-outline-fill clipping)
        (return)
      )
      (if (not (call display-outline-within shape clipping))
        (call promote-root-clip)
      )
    )
    (call contain-root-clip (. shape extent))
    (call record-outline-fill shape)
  )
  (fn-do _ stroke-outline _
    (param shape Outline)
    (let inset (/ stroke-width 2))
    (let outer (call (. shape grow) inset))
    (let clipping root-clip-shape)
    (if clipping
      (if (call display-outline-inset shape clipping inset)
        (call record-outline-border clipping true)
        (return)
      )
      (if (not (call display-outline-within outer clipping))
        (call promote-root-clip)
      )
    )
    (call contain-root-clip (. outer extent))
    (if (. outer arrow)
      (+= unsupported-calls 1)
    )
    (call record-outline-border outer false)
  )
  (fn-do _ record-outline-fill _
    (param shape Outline)
    (let current (!! chunk))
    (let shape-index (as (. current shapes length) U32))
    (+= (. current shapes) (call display-shape shape null))
    (let item
      (call DisplayItem
        (block
          (arg (. DisplayItemKind quad))
          (arg display-item-has-shape)
          (arg 0)
          (arg (as (. shape bounds x) F32))
          (arg (as (. shape bounds y) F32))
          (arg (as (. shape bounds width) F32))
          (arg (as (. shape bounds height) F32))
          (arg (as (. shape effective-radius) F32))
          (arg (call pack-rgba8 (!! fill-color)))
          (arg shape-index)
          (arg 0)
          (arg 0)
        )
      )
    )
    (let item-index (call (. current add-item) item (call root-ink (. shape extent)) current-state))
    (call (. current set-item-color) item-index (!! fill-color))
    (call (. current set-item-exact) item-index (. shape bounds) (. shape effective-radius))
    (call record-item-command item-index)
  )
  (fn-do _ record-outline-border _
    (param outer Outline)
    (param clipped Bool)
    (let current (!! chunk))
    (let shape-index (as (. current shapes length) U32))
    (+= (. current shapes) (call display-shape outer null))
    (let item
      (call DisplayItem
        (block
          (arg (. DisplayItemKind border))
          (arg display-item-has-shape)
          (arg (if-expr clipped 1 0))
          (arg (as (. outer bounds x) F32))
          (arg (as (. outer bounds y) F32))
          (arg (as (. outer bounds width) F32))
          (arg (as (. outer bounds height) F32))
          (arg (as stroke-width F32))
          (arg (call pack-rgba8 (!! stroke-color)))
          (arg shape-index)
          (arg 0)
          (arg 0)
        )
      )
    )
    (let item-index (call (. current add-item) item (call root-ink (. outer extent)) current-state))
    (call (. current set-item-color) item-index (!! stroke-color))
    (call (. current set-item-exact) item-index (. outer bounds) stroke-width)
    (call record-item-command item-index)
  )
  (fn-do _ record-item-command _
    (param item-index U32)
    (+= recorded-commands
      (call DisplayCommand
        (block
          (arg (. DisplayCommandKind item))
          (arg display-no-rect)
          (arg (call Point 0 0))
          (arg (call Point 0 0))
          (arg (call Point 0 0))
          (arg (call Matrix))
          (arg null)
          (arg null)
          (arg 0)
          (arg (. LineCap butt))
          (arg (. LineJoin miter))
          (arg null)
          (arg null)
          (arg (. TextAlignment left))
          (arg false)
          (arg (. FillRule nonzero))
          (arg item-index)
        )
      )
    )
  )
  (fn-do _ record-styled _
    (param op U8)
    (param rect Rect)
    (param ink Rect)
    (param path-count U32)
    (param verb-start U32)
    (param coord-start U32)
    (param closed _ (= false))
    (param fill-rule FillRule (= (. FillRule nonzero)))
    (param gradient (? Gradient) (= null))
    (param shadow (? Shadow) (= null))
    (param shader (? Shader) (= null))
    (param shader-args (? (list F64)) (= null))
    (param paint (? Paint) (= null))
    (param brush (? Brush) (= null))
    (param shading (? ShaderFill) (= null))
    (param fills _ (= true))
    (let current (!! chunk))
    (let table (call (. current ensure-side)))
    (let style-index (as (. table path-styles length) U32))
    (let fill (only-if fill-color (if fills)))
    (let stroke stroke-color)
    (let gradient-index U32)
    (let brush-index U32)
    (let painted (and (!= paint null) (!= fill null)))
    (let brushed (and (!= brush null) (!= stroke null)))
    (if painted
      (= gradient-index (call (. table add-paint) (!! paint) (!! fill)))
    )
    (if brushed
      (= brush-index (call (. table add-brush) (!! brush) (!! stroke)))
    )
    (if gradient
      (= fill null)
      (= stroke null)
      (= gradient-index (call (. table add-gradient) gradient))
    )
    (if shader
      (= fill null)
      (= stroke null)
      (= gradient-index (call (. table add-shader) rect shader (!! shader-args)))
    )
    (if shading
      (= fill null)
      (= stroke null)
      (= gradient-index
        (call (. table add-shader)
          (block
            (arg rect)
            (arg (. shading shader))
            (arg (. shading args))
            (arg
              (call live-fill-epoch
                (block
                  (arg current)
                  (arg (. shading is-live))
                  (arg (. shading frame-rate))
                  (arg (call (?. (call shader-cycle (. shading args) (. shading arg-kinds)) at-width) (. rect width)))
                )
              )
            )
          )
        )
      )
    )
    (if shadow
      (= fill (. shadow color))
      (= stroke null)
    )
    (+= (. table path-styles)
      (call DisplayPathStyle
        (block
          (arg fill)
          (arg stroke)
          (arg stroke-width)
          (arg stroke-cap)
          (arg stroke-join)
          (arg stroke-dash)
          (arg fill-rule)
          (arg closed)
          (arg gradient)
          (arg shadow)
          (arg (?? (?. shading shader) shader))
          (arg (?? (?. shading args) shader-args))
          (arg (only-if paint (if painted)))
          (arg (only-if brush (if brushed)))
          (arg shading)
        )
      )
    )
    (let flags U8)
    (let aux U16)
    (if root-clip-active
      (= flags (/or/ flags display-item-has-clip))
      (= aux (as (. current clips length) U16))
      (+= (. current clips) clip-rect)
    )
    (let item
      (call DisplayItem
        (block
          (arg (. DisplayItemKind styled))
          (arg flags)
          (arg aux)
          (arg (as (. rect x) F32))
          (arg (as (. rect y) F32))
          (arg (as (. rect width) F32))
          (arg (as (. rect height) F32))
          (arg op)
          (arg verb-start)
          (arg path-count)
          (arg coord-start)
          (arg style-index)
        )
      )
    )
    (let local-ink (if-expr (== current-state 0) (call root-ink ink) ink))
    (let item-index (call (. current add-item) item local-ink current-state))
    (call (. current set-item-exact) item-index rect op)
    (+= (. table styled-wires)
      (call DisplayPathStyleWire
        (block
          (arg (if-expr (or gradient shader shading painted) white (?? fill transparent)))
          (arg (if-expr brushed transparent (?? stroke transparent)))
          (arg stroke-width)
          (arg stroke-dash)
          (arg (?? (?. shadow x) 0))
          (arg (?? (?. shadow y) 0))
          (arg (?? (?. shadow blur) 0))
          (arg
            (call display-path-paint
              (block
                (arg (or (!= fill null) (!= gradient null) (!= shader null) (!= shading null)))
                (arg (and (!= stroke null) (not brushed)))
                (arg closed)
                (arg fill-rule)
                (arg (!= shadow null))
              )
            )
          )
          (arg (call display-stroke-style stroke-cap stroke-join))
          (arg gradient-index)
          (arg brush-index)
        )
      )
    )
    (if (or gradient shader shading)
      (= (. table has-shaded-fill) true)
      (else
        (= (. table has-antialiased) true)
      )
    )
  )
  (fn-do _ record-text-fill U32
    (param current DisplayChunk)
    (param fill ShaderFill)
    (param layout TextLayout)
    (param rect Rect)
    (param alignment TextAlignment)
    (let code (call display-alignment-code alignment))
    (let width (. layout width))
    (let height (. layout height))
    (let x
      (scope (if-expr (== code 1) centered-x (if-expr (== code 2) (- (. rect right) width) (. rect x)))
        (lazy centered-x (+ (. rect x) (/ (- (. rect width) width) 2)))
      )
    )
    (let frame (call Rect x (+ (. rect y) (/ (- (. rect height) height) 2)) width height))
    (return
      (call (. (call (. current ensure-side)) add-shader)
        (block
          (arg frame)
          (arg (. fill shader))
          (arg (. fill args))
          (arg
            (call live-fill-epoch
              (block
                (arg current)
                (arg (. fill is-live))
                (arg (. fill frame-rate))
                (arg (call (?. (call shader-cycle (. fill args) (. fill arg-kinds)) at-width) (. frame width)))
              )
            )
          )
        )
      )
    )
  )
  (fn-expr _ recorded-fill (? ShaderFill)
    (param current DisplayChunk)
    (param fill (? ShaderFill))
    (case? (not fill)
      null
    )
    (case? (or (not (. fill is-live)) (. current owner $animates-fills))
      fill
    )
    (default
      (call ShaderFill (. fill shader) (. fill args))
    )
  )
  (fn-do _ live-fill-epoch F64
    (param current DisplayChunk)
    (param is-live Bool)
    (param rate (? F64))
    (param cycle (? FrameCycle))
    (return-if -1.0 (if (not is-live)))
    (blank)
    (let kept (. current live-rate))
    (if (not (. current is-live))
      (= (. current live-rate) rate)
      (= (. current live-cycle) cycle)
      (= (. current is-live-settled) false)
      (else
        (= (. current live-rate) (only-if (call max kept rate) (if (and (!= kept null) (!= rate null)))))
        (if (!= (. current live-cycle) cycle)
          (= (. current live-cycle) null)
        )
      )
    )
    (= (. current is-live) true)
    (let epoch (?? (. current live-epoch) live-time))
    (= (. current live-epoch) epoch)
    (return epoch)
  )
  (fn-do _ append-path-verb _
    (param verb U8)
    (if (not path-open)
      (+= unsupported-calls 1)
      (return)
    )
    (+= (. (!! (. (!! chunk) side)) path-verbs) verb)
  )
  (fn-do _ append-path-point _
    (param x Coord)
    (param y Coord)
    (return-if (if (not path-open)))
    (blank)
    (let table (!! (. (!! chunk) side)))
    (+= (. table path-coords) x)
    (+= (. table path-coords) y)
  )
  (fn-do _ restyle-frame-item _
    (param kind U8)
    (param state U32)
    (param box Rect)
    (param value F64)
    (param color RGBA)
    (param clipped Bool)
    (param shape (? Outline))
    (let held-state current-state)
    (let held-fill fill-color)
    (let held-stroke stroke-color)
    (let held-width stroke-width)
    (let held-join stroke-join)
    (let held-dash stroke-dash)
    (let held-paint fill-paint)
    (let held-brush stroke-brush)
    (= current-state state)
    (= fill-paint null)
    (= stroke-brush null)
    (if (== kind (. DisplayItemKind quad))
      (= fill-color color)
      (= stroke-color null)
      (if shape
        (call outline shape)
        (else
          (call rect box)
        )
      )
      (else
        (= fill-color null)
        (= stroke-color color)
        (= stroke-width value)
        (= stroke-join (. LineJoin miter))
        (= stroke-dash 0)
        (if (and shape clipped)
          (call push)
          (call clip-outline shape)
          (call outline (call (. shape grow) (/ (- value) 2)))
          (call pop)
          (else-if shape
            (call outline (call (. shape grow) (/ (- value) 2)))
          )
          (else
            (call rect box)
          )
        )
      )
    )
    (= current-state held-state)
    (= fill-color held-fill)
    (= stroke-color held-stroke)
    (= stroke-width held-width)
    (= stroke-join held-join)
    (= stroke-dash held-dash)
    (= fill-paint held-paint)
    (= stroke-brush held-brush)
  )
  (fn-do _ restyle-frame-quads _
    (param state U32)
    (param records (of CPointer Quad))
    (param start Size)
    (param count Size)
    (let batch (list Quad))
    (for (in index (..< start (+ start count)))
      (+= batch ([] records index))
    )
    (let held-state current-state)
    (let held-paint fill-paint)
    (let held-fill shape-fill)
    (= current-state state)
    (= fill-paint null)
    (= shape-fill null)
    (call quads batch)
    (= current-state held-state)
    (= fill-paint held-paint)
    (= shape-fill held-fill)
  )
  (fn-do _ append-frame-gradients (list Bool)
    (param frame DisplayFrame)
    (param shaders (map U32 Shader))
    (param table DisplayChunkSide)
    (let stop-offset (as (. table gradient-stops length) U32))
    (let arg-offset (as (. table shader-args length) U32))
    (let stop-count (call (. frame count) .stops))
    (let arg-count (call (. frame count) .args))
    (let stops (as (call (. frame table) .stops) (of CPointer GradientStop)))
    (let args (as (call (. frame table) .args) (of CPointer F64)))
    (for (in index (..< 0 stop-count))
      (+= (. table gradient-stops) ([] stops index))
    )
    (for (in index (..< 0 arg-count))
      (+= (. table shader-args) ([] args index))
    )
    (let gradients (as (call (. frame table) .gradients) (of CPointer DisplayGradientWire)))
    (let usable (list Bool))
    (for (in index (..< 0 (call (. frame count) .gradients)))
      (let wire ([] gradients index))
      (let kind (. wire kind))
      (let shaded (>= kind display-gradient-shader))
      (let shader (only-if ([] shaders (. wire shader)) (if shaded)))
      (let limit (if-expr shaded arg-count stop-count))
      (let start (as (. wire stop-start) Size))
      (let fits (and (<= start limit) (<= (as (. wire stop-count) Size) (- limit start))))
      (let known (and (>= kind display-gradient-linear) (<= kind display-gradient-brush)))
      (let brushes (or (!= kind display-gradient-brush) (>= (. wire stop-count) 12)))
      (+= usable (and known fits brushes (or (not shaded) (!= shader null))))
      (let offset (if-expr shaded arg-offset stop-offset))
      (let shader-id (?? (?. shader id) 0u32))
      (let placed (= (. wire stop-start) (+ (. wire stop-start) offset)))
      (+= (. table gradient-wires) (= (. placed shader) shader-id))
    )
    (return usable)
  )
  (fn-do _ append-frame-states (list U32)
    (param frame DisplayFrame)
    (param table DisplayChunkSide)
    (param base U32)
    (param verb-offset U32)
    (param coord-offset U32)
    (let wires (as (call (. frame table) .states) (of CPointer DisplayStateWire)))
    (let count (call (. frame count) .states))
    (let verbs (as (call (. frame table) .path-verbs) (of CPointer U8)))
    (let verb-count (call (. frame count) .path-verbs))
    (let coord-count (call (. frame count) .path-coords))
    (let mapped (list U32))
    (+= mapped base)
    (for (in index (..< 1 count))
      (let wire ([] wires index))
      (let parent (if-expr (< (as (. wire parent) Size) index) ([] mapped (. wire parent)) base))
      (let kind (as (. wire kind) U8))
      (let known (and (>= kind (. DisplayStateKind transform)) (<= kind (. DisplayStateKind blur))))
      (let blended (and (>= (. wire blend) 0) (<= (. wire blend) 27)))
      (lazy path-fits
        (call frame-path-fits
          (block
            (arg verbs)
            (arg verb-count)
            (arg coord-count)
            (arg (. wire path-start))
            (arg (. wire path-count))
            (arg (. wire coord-start))
          )
        )
      )
      (let traced (or (!= kind (. DisplayStateKind clip-path)) path-fits))
      (let sourced (or (!= kind (. DisplayStateKind clip-layer-mask)) (< (as (. wire source) Size) index)))
      (if (or (not known) (not traced) (not sourced) (not blended))
        (+= mapped parent)
        (continue)
      )
      (let placed-kind kind)
      (if (== kind (. DisplayStateKind content))
        (= placed-kind (. DisplayStateKind transform))
        (else-if (== kind (. DisplayStateKind clip-mask))
          (= placed-kind (. DisplayStateKind clip))
        )
      )
      (let state
        (call DisplayState
          (block
            (arg parent)
            (arg placed-kind)
            (arg (. wire matrix))
            (arg (. wire rect))
            (arg (. wire radius))
            (arg (. wire side))
            (arg (. wire offset))
            (arg (. wire size))
            (arg (+ (. wire path-start) verb-offset))
            (arg (. wire path-count))
            (arg (+ (. wire coord-start) coord-offset))
            (arg (if-expr (== (. wire fill-rule) 1) (. FillRule even-odd) (. FillRule nonzero)))
            (arg (. wire opacity))
          )
        )
      )
      (= state (= (. state serial) (. wire serial)))
      (= state (= (. state blend) (as (. wire blend) BlendMode)))
      (if (== kind (. DisplayStateKind clip-layer-mask))
        (= state (= (. state source) ([] mapped (. wire source))))
      )
      (+= mapped (call (. table add-state) state))
    )
    (return mapped)
  )
)

(type + DisplayFrame (is Tuple)
  (prop + data Pointer)
  (prop + size Size)
  (fn-do + is-valid Bool :get
    (return-if false (if (or (not data) (< size display-frame-header-bytes))))
    (blank)
    (let words (as data (of CPointer U64)))
    (return-if false (if (or (!= ([] words 0) display-frame-magic) (!= ([] words 1) (call display-frame-format)))))
    (return-if false (if (or (> (as ([] words 2) Size) size) (!= (as ([] words 3) Size) display-frame-table-count))))
    (blank)
    (for (in index (..< 0 display-frame-table-count))
      (let offset (as ([] words (+ 4 (* index 2))) Size))
      (let count (as ([] words (+ 5 (* index 2))) Size))
      (return-if false (if (or (< offset display-frame-header-bytes) (> offset size) (!= (/and/ offset 7) 0))))
      (return-if false (if (> count (/ (- size offset) (. (as index DisplayFrameTable) width)))))
    )
    (return (> ([] words (+ 5 (* (as (. DisplayFrameTable states) Size) 2))) 0))
  )
  (fn-expr _ table Pointer
    (param kind DisplayFrameTable)
    (+ data (as ([] (as data (of CPointer U64)) (+ 4 (* (as kind Size) 2))) Size))
  )
  (fn-expr _ count Size
    (param kind DisplayFrameTable)
    (as ([] (as data (of CPointer U64)) (+ 5 (* (as kind Size) 2))) Size)
  )
)

(type + DisplayFrameRecorder
  (prop + unsupported Size)
  (prop + shaders (list Shader))
  (blank)
  (prop _ recorder _ (= (call DisplayRecorder)))
  (prop _ chunk _ (= (call DisplayChunk (call Box) (. DisplayPhase pre))))
  (prop _ spans (list DisplayFrameSpan))
  (fn-expr + item-count Size :get
    (. chunk items length)
  )
  (fn-expr + ink-bounds (? Rect) :get
    (only-if (. chunk bounds) (if (. chunk has-bounds)))
  )
  (fn-do + byte-size Size :get
    (let total display-frame-header-bytes)
    (for (in index (..< 0 (. spans length)))
      (= total (call display-frame-align (+ total (* (. ([] spans index) count) (. (as index DisplayFrameTable) width)))))
    )
    (return total)
  )
  (fn-do + begin Canvas
    (call (. chunk reset))
    (call (. chunk ensure-side))
    (call (. spans clear))
    (= (. recorder unsupported-calls) 0)
    (call (. recorder begin-chunk) chunk)
    (return recorder)
  )
  (fn-do + end _
    (call (. recorder end-chunk))
    (= unsupported (. recorder unsupported-calls))
    (let side (call (. chunk ensure-side)))
    (let exacts (call (. chunk ensure-exacts)))
    (call (. side refresh-wire-states))
    (call (. shaders clear))
    (for (in style (. side path-styles))
      (call collect-shader (. style shader))
      (call collect-shader (?. (. style paint) shader))
      (call collect-shader (?. (. style brush) shader))
    )
    (call (. spans clear))
    (+= spans (call DisplayFrameSpan (as (. chunk items buffer-pointer) Pointer) (. chunk items length)))
    (+= spans (call DisplayFrameSpan (as (. chunk clips buffer-pointer) Pointer) (. chunk clips length)))
    (+= spans (call DisplayFrameSpan (as (. chunk shapes buffer-pointer) Pointer) (. chunk shapes length)))
    (+= spans (call DisplayFrameSpan (as (. side colors buffer-pointer) Pointer) (. side colors length)))
    (+= spans (call DisplayFrameSpan (as (. side item-colors buffer-pointer) Pointer) (. side item-colors length)))
    (+= spans (call DisplayFrameSpan (as (. side wire-states buffer-pointer) Pointer) (. side wire-states length)))
    (+= spans (call DisplayFrameSpan (as (. side item-states buffer-pointer) Pointer) (. side item-states length)))
    (+= spans (call DisplayFrameSpan (as (. side item-inks buffer-pointer) Pointer) (. side item-inks length)))
    (+= spans (call DisplayFrameSpan (as (. exacts item-slots buffer-pointer) Pointer) (. exacts item-slots length)))
    (+= spans (call DisplayFrameSpan (as (. exacts rects buffer-pointer) Pointer) (. exacts rects length)))
    (+= spans (call DisplayFrameSpan (as (. exacts values buffer-pointer) Pointer) (. exacts values length)))
    (+= spans (call DisplayFrameSpan (. side path-verbs buffer-pointer) (. side path-verbs length)))
    (+= spans (call DisplayFrameSpan (as (. side path-coords buffer-pointer) Pointer) (. side path-coords length)))
    (+= spans (call DisplayFrameSpan (as (. side styled-wires buffer-pointer) Pointer) (. side styled-wires length)))
    (+= spans (call DisplayFrameSpan (as (. side gradient-wires buffer-pointer) Pointer) (. side gradient-wires length)))
    (+= spans (call DisplayFrameSpan (as (. side gradient-stops buffer-pointer) Pointer) (. side gradient-stops length)))
    (+= spans (call DisplayFrameSpan (as (. side shader-args buffer-pointer) Pointer) (. side shader-args length)))
    (+= spans (call DisplayFrameSpan (as (. side quads buffer-pointer) Pointer) (. side quads length)))
  )
  (fn-do + write _
    (param target Pointer)
    (let words (as target (of CPointer U64)))
    (= ([] words 0) display-frame-magic)
    (= ([] words 1) (call display-frame-format))
    (= ([] words 3) (as display-frame-table-count U64))
    (let offset display-frame-header-bytes)
    (for (in index (..< 0 (. spans length)))
      (let span ([] spans index))
      (let bytes (* (. span count) (. (as index DisplayFrameTable) width)))
      (= ([] words (+ 4 (* index 2))) (as offset U64))
      (= ([] words (+ 5 (* index 2))) (as (. span count) U64))
      (if (> bytes 0)
        (call C:memcpy (+ target offset) (. span data) bytes)
      )
      (= offset (call display-frame-align (+ offset bytes)))
    )
    (= ([] words 2) (as offset U64))
  )
  (fn-do _ collect-shader _
    (param shader (? Shader))
    (let found shader)
    (return-if (if (not found)))
    (blank)
    (for (in known shaders)
      (return-if (if (== (. known id) (. found id))))
    )
    (+= shaders found)
  )
)

(type + DisplayFrameRaster
  (implements Closable)
  (prop + canvas RasterCanvas)
  (blank)
  (prop _ background RGBA)
  (prop _ renderer (? MetalOffscreenRenderer))
  (prop _ scene (? DisplayScene))
  (prop _ chunk (? DisplayChunk))
  (fn-do + This _
    (param width I32)
    (param height I32)
    (param scale F64 (= 1))
    (param clear-background RGBA (= white))
    (= background clear-background)
    (= canvas (call RasterCanvas width height scale clear-background))
    (let candidate (call MetalOffscreenRenderer width height scale clear-background true))
    (if (. candidate is-available)
      (= renderer candidate)
      (= scene (call DisplayScene scale clear-background candidate))
      (= chunk (call DisplayChunk (call Box) (. DisplayPhase pre)))
      (else
        (call (. candidate close))
      )
    )
  )
  (fn-do + close _
    (let target scene)
    (if target
      (call (. target release-chunk-glyph-handles) (!! chunk))
      (call (. target close))
    )
    (let gpu renderer)
    (if gpu
      (call (. gpu close))
    )
    (= scene null)
    (= chunk null)
    (= renderer null)
    (call (. canvas close))
  )
  (fn-expr + uses-gpu Bool :get
    (!= renderer null)
  )
  (fn-do + begin Canvas
    (let target scene)
    (if (not target)
      (call (. canvas erase) background)
      (return canvas)
    )
    (let current (!! chunk))
    (call (. target release-chunk-glyph-handles) current)
    (call (. current reset))
    (call (. target recorder begin-chunk) current)
    (return (. target recorder))
  )
  (fn-do + end Bool
    (let target scene)
    (return-if true (if (not target)))
    (blank)
    (let current (!! chunk))
    (call (. target recorder end-chunk))
    (return-if false (if (not (call (. target frame-metal-chunk) current (!! renderer)))))
    (return (call (. (!! renderer) read-into) canvas))
  )
)

(type + DisplaySprite
  (prop + bounds _ (= display-no-rect))
  (prop + version U32)
  (blank)
  (prop _ serial U64)
  (prop _ chunk _ (= (call DisplayChunk display-sprite-owner (. DisplayPhase pre))))
  (fn-do + This _
    (+= display-sprite-serial 1)
    (= serial display-sprite-serial)
  )
  (fn-do + begin Canvas
    (call (. chunk reset))
    (call (. chunk ensure-side))
    (call (. display-sprite-recorder begin-chunk) chunk)
    (return display-sprite-recorder)
  )
  (fn-do + end _
    (param frame (? Rect) (= null))
    (call (. display-sprite-recorder end-chunk))
    (let ink (if-expr (. chunk has-bounds) (call (. chunk bounds inflate) 2) display-no-rect))
    (= bounds (?? frame ink))
    (+= version 1)
  )
)

(type + DisplayScene
  (implements Closable)
  (prop + background RGBA (= transparent))
  (prop + scale F64 (= 1))
  (prop + recorder DisplayRecorder)
  (prop + damage Rect)
  (prop + has-damage _ (= false))
  (prop + damage-areas (list Rect))
  (prop + chunks-rebuilt Size)
  (prop + chunks-drawn Size)
  (prop + items-drawn Size)
  (prop + cull-tests Size)
  (prop + builds Size)
  (prop + relinks Size)
  (prop + frames-replayed Size)
  (prop + frames-idle Size)
  (prop + chunks-encoded Size)
  (prop + items-encoded Size)
  (prop + last-damaged-pixels Size)
  (prop + last-frame-damage Rect)
  (prop + boxes-visited Size)
  (prop + items-built Size)
  (prop + opaque-demotions Size)
  (prop + metal-tile-fallbacks Size)
  (prop + origin Point)
  (prop + has-pending-textures _ (=> (or (> (. pending-texture-chunks length) 0) (!= pending-tile-damage null))))
  (prop + raster-tiled-items F64 (= 24000))
  (prop + raster-direct-items F64 (= 12000))
  (prop + raster-settle-delay U64 (= 150000000))
  (prop + frame-time U64)
  (blank)
  (prop _ roots (list DisplayEntry))
  (prop _ root-order DisplayOrder)
  (prop _ pending-texture-chunks (list DisplayChunk))
  (prop _ pending-tile-damage (? Rect))
  (prop _ damage-revision Size)
  (prop _ root-nodes (list DisplayBoxNode))
  (prop _ root-refill-stamp U32)
  (prop _ refill-stamp-counter U32)
  (prop _ spare-chunk (? DisplayChunk))
  (prop _ scene-root (? Box))
  (prop _ resource-table VectorGeometryTable (= (call default-vector-geometry-table)))
  (prop _ structure-generation U64)
  (prop _ generation U32 (= 1))
  (prop _ metal-frames-encoded Size)
  (prop _ is-built _ (= false))
  (prop _ is-maintaining _ (= false))
  (prop _ is-replaying _ (= false))
  (prop _ has-uncommitted _ (= false))
  (prop _ glyph-registrar (? DisplayGlyphRegistrar))
  (prop _ current-metal-resource-renderer (? Pointer))
  (prop _ current-metal-resource-epoch I64 (= -1))
  (prop _ root-order-refresh-pending _ (= false))
  (prop _ replay-states (list U32))
  (prop _ replay-path (list U32))
  (prop _ has-antialiased-content _ (= false))
  (prop _ has-shaded-fill-content _ (= false))
  (prop _ has-backdrop-content _ (= false))
  (prop _ has-filter-content _ (= false))
  (prop _ metal-tile-canvases (list RasterCanvas))
  (prop _ metal-tile-canvas-frames (list Size))
  (prop _ raster-wants (list RasterTile))
  (prop _ raster-reserved (list DisplayChunk))
  (prop _ raster-settling (list DisplayChunk))
  (prop _ raster-pass U32)
  (prop _ raster-full _ (= false))
  (prop _ raster-wires (list DisplayStateWire))
  (prop _ sprite-chunks (list DisplayChunk))
  (prop _ sprite-wants (list DisplaySpriteWant))
  (prop _ damage-snapshot (list Rect))
  (prop _ sprite-pass U32)
  (prop _ released-chunk-keys (list U64))
  (prop _ releases-all-chunks _ (= false))
  (prop _ live-chunks (list DisplayChunk))
  (prop _ live-groups (list DisplayGroup))
  (prop _ kept-group-epochs _ (= (call (of Map U64 F64))))
  (prop _ kept-chunk-epochs _ (= (call (of Map U64 F64))))
  (fn-do + This _
    (param scene-scale F64 (= 1))
    (param clear-background RGBA (= transparent))
    (param registrar (? DisplayGlyphRegistrar) (= null))
    (= scale scene-scale)
    (= background clear-background)
    (= glyph-registrar registrar)
    (lazy recorder (call DisplayRecorder))
    (call (. recorder configure) scale glyph-registrar resource-table)
  )
  (fn-do + close _
    (call release-all-glyph-handles)
    (call (. recorder close))
    (for (in canvas metal-tile-canvases)
      (call (. canvas close))
    )
    (call (. metal-tile-canvases clear))
    (call (. metal-tile-canvas-frames clear))
  )
  (fn-do + configure _
    (param scene-scale F64)
    (param clear-background RGBA)
    (let scale-changed (!= scale scene-scale))
    (let background-changed (!= background clear-background))
    (= scale scene-scale)
    (= background clear-background)
    (call (. recorder configure) scale glyph-registrar resource-table)
    (if (and scale-changed is-built scene-root)
      (call build scene-root)
      (else-if (and background-changed is-built scene-root)
        (call add-damage (. scene-root bounds))
      )
    )
  )
  (fn-do + reset-frame-counters _
    (= chunks-rebuilt 0)
    (= chunks-drawn 0)
    (= items-drawn 0)
    (= chunks-encoded 0)
    (= items-encoded 0)
    (= cull-tests 0)
  )
  (fn-do + damage-pending-textures _
    (for (in chunk pending-texture-chunks)
      (if (. chunk has-bounds)
        (call add-damage (call window-bounds (. chunk bounds) (. chunk parent)))
      )
    )
    (call (. pending-texture-chunks clear))
    (let tile-damage pending-tile-damage)
    (if tile-damage
      (call add-damage tile-damage)
      (= pending-tile-damage null)
    )
  )
  (fn-do _ note-tile-damage _
    (param rect Rect)
    (return-if (if (or (<= (. rect width) 0) (<= (. rect height) 0))))
    (blank)
    (let pending pending-tile-damage)
    (= pending-tile-damage (if-expr pending (+ pending rect) rect))
  )
  (fn-do + add-damage _
    (param rect Rect)
    (return-if (if (or (<= (. rect width) 0) (<= (. rect height) 0))))
    (blank)
    (let covered (call some damage-areas (:where (call (. each contains) rect 0.01))))
    (return-if (if covered))
    (blank)
    (if has-damage
      (= damage (+ damage rect))
      (else
        (= damage rect)
        (= has-damage true)
      )
    )
    (+= damage-revision 1)
    (call absorb-damage-area rect)
    (while (> (. damage-areas length) display-damage-area-limit)
      (call merge-closest-damage-areas)
    )
  )
  (fn-do + set-live-time _
    (param seconds F64)
    (= (. recorder live-time) seconds)
  )
  (fn-do + damage-live-chunks LiveFillState
    (param view Rect)
    (param adds-damage Bool)
    (let kept Size 0)
    (let visible false)
    (let rate 0.0)
    (let is-capped true)
    (let wake (? F64) null)
    (for (in index (..< 0 (. live-chunks length)))
      (let chunk ([] live-chunks index))
      (if (and (. chunk is-live) (. chunk owner frame-clock))
        (= ([] live-chunks kept) chunk)
        (+= kept 1)
        (if (and (. chunk has-bounds) (. chunk owner is-paint-visible))
          (let bounds (call (. (call window-bounds (. chunk bounds) (. chunk parent)) intersection) view))
          (if (and (> (. bounds width) 0) (> (. bounds height) 0))
            (let resting (call live-resting (. chunk live-cycle) (. chunk live-epoch)))
            (if (and resting (. chunk is-live-settled))
              (= wake (call earliest-wake wake (call live-wake (!! (. chunk live-cycle)) (!! (. chunk live-epoch)))))
              (else
                (if (not resting)
                  (= (. chunk is-live-settled) false)
                )
                (let wanted (. chunk live-rate))
                (if (and adds-damage (call damage-live-chunk chunk bounds wanted) resting)
                  (= (. chunk is-live-settled) true)
                )
                (if wanted
                  (= rate (call max rate wanted))
                  (else
                    (= is-capped false)
                  )
                )
                (= visible true)
              )
            )
          )
        )
      )
    )
    (call (. live-chunks remove) kept (- (. live-chunks length) kept))
    (let kept-groups Size 0)
    (for (in index (..< 0 (. live-groups length)))
      (let group ([] live-groups index))
      (if (and (. group is-live) (. group owner frame-clock))
        (= ([] live-groups kept-groups) group)
        (+= kept-groups 1)
        (if (and (. group has-outer) (. group owner is-paint-visible))
          (let bounds (call (. (call window-bounds (. group outer) (. group parent)) intersection) view))
          (if (and (> (. bounds width) 0) (> (. bounds height) 0))
            (let resting (call live-resting (. group live-cycle) (. group live-epoch)))
            (if (and resting (. group is-live-settled))
              (= wake (call earliest-wake wake (call live-wake (!! (. group live-cycle)) (!! (. group live-epoch)))))
              (else
                (if (not resting)
                  (= (. group is-live-settled) false)
                )
                (let wanted (. group live-rate))
                (if (and adds-damage (call damage-live-group group bounds wanted) resting)
                  (= (. group is-live-settled) true)
                )
                (if wanted
                  (= rate (call max rate wanted))
                  (else
                    (= is-capped false)
                  )
                )
                (= visible true)
              )
            )
          )
        )
      )
    )
    (call (. live-groups remove) kept-groups (- (. live-groups length) kept-groups))
    (return (call LiveFillState visible (only-if rate (if (and is-capped (> rate 0)))) wake))
  )
  (fn-do + build _
    (param tree-root Box)
    (throw (call Panic "DisplayScene maintenance cannot run during replay") (if is-replaying))
    (blank)
    (= is-maintaining true)
    (finally
      (inline (= is-maintaining false))
    )
    (blank)
    (+= builds 1)
    (probe-log gui.scene.build (text: "full build " builds))
    (call keep-live-epochs)
    (= scene-root tree-root)
    (call composite-refresh)
    (= resource-table (call vector-geometry-table-for (. tree-root markup-batch-root)))
    (call (. recorder configure) scale glyph-registrar resource-table)
    (call release-all-glyph-handles)
    (if current-metal-resource-renderer
      (= releases-all-chunks true)
      (call (. released-chunk-keys clear))
    )
    (call (. roots clear))
    (call (. root-nodes clear))
    (call (. live-chunks clear))
    (call (. live-groups clear))
    (= generation (call next-display-scene-generation))
    (= boxes-visited 0)
    (= items-built 0)
    (= root-order-refresh-pending false)
    (blank)
    (call build-box tree-root roots true)
    (call (. kept-group-epochs clear))
    (call (. kept-chunk-epochs clear))
    (= root-order (call display-detect-order roots))
    (= structure-generation (call gui-retained-tree-structure-generation))
    (= is-built true)
    (= has-uncommitted true)
    (call add-damage (. tree-root bounds))
  )
  (fn-do + update _
    (param tree-root Box)
    (throw (call Panic "DisplayScene maintenance cannot run during replay") (if is-replaying))
    (blank)
    (if (or (not is-built) (!= (as scene-root (? Pointer)) (as tree-root (? Pointer))))
      (call build tree-root)
      (return)
    )
    (call composite-refresh)
    (= is-maintaining true)
    (finally
      (inline (= is-maintaining false))
    )
    (= boxes-visited 0)
    (= root-order-refresh-pending false)
    (probe-group + gui.scene.update-box)
    (let roots-changed (call update-box tree-root true))
    (if roots-changed
      (call relink-roots tree-root)
    )
    (probe-group - gui.scene.update-box)
    (call flush-group-refreshes)
    (= structure-generation (call gui-retained-tree-structure-generation))
    (= has-uncommitted true)
