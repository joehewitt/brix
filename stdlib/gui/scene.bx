    (call trim-metal-tile-canvases)
    (+= metal-frames-encoded 1)
    (return (>= frame 0))
  )
  (fn-expr _ node-for _
    (param box Box)
    (case? (not pointer)
      null
    )
    (default
      (call (of gc-object-from-pointer DisplayBoxNode) pointer)
    )
    (where
      (lazy pointer (call (. box retained-scene-node-for) generation))
    )
  )
  (fn-do _ release-chunk-glyph-handles _
    (param chunk DisplayChunk)
    (return-if (if (not glyph-registrar)))
    (blank)
    (let handles (. chunk glyph-handles))
    (return-if (if (not handles)))
    (blank)
    (for (in handle handles)
      (call (. (!! glyph-registrar) release-display-glyph) handle)
    )
    (call (. handles clear))
  )
  (fn-do _ release-all-glyph-handles _
    (return-if (if (not glyph-registrar)))
    (blank)
    (call release-node-glyph-handles root-nodes)
  )
  (fn-do _ release-node-glyph-handles _
    (param list (list DisplayBoxNode))
    (for (in node list)
      (if (. node pre)
        (call release-chunk-glyph-handles (. node pre))
      )
      (if (. node post)
        (call release-chunk-glyph-handles (. node post))
      )
      (if (. node group)
        (call release-node-glyph-handles (. node group nodes))
      )
      (if (. node layer-group)
        (call release-node-glyph-handles (. node layer-group nodes))
      )
    )
  )
  (fn-do _ record-chunk _
    (param chunk DisplayChunk)
    (probe-group + gui.scene.record-chunk)
