  (variant move)
  (variant line)
  (variant curve)
  (variant enclose)
)

(type _ DisplayPhase (is U8)
  (variant pre)
  (variant post)
)

(type _ DisplayAxis (is U8)
  (variant none)
  (variant vertical)
  (variant horizontal)
)

(type _ DisplayCommandKind (is U8)
  (variant push)
  (variant pop)
  (variant clip)
  (variant transform)
  (variant rect)
  (variant oval)
  (variant text)
  (variant image)
  (variant vector)
  (variant erase)
  (variant item (= 16))
  (variant clip-path (= 17))
  (variant clip-outline (= 19))
  (variant gradient (= 20))
  (variant begin-opacity (= 21))
  (variant end-opacity (= 22))
  (variant clip-mask (= 23))
  (variant begin-mask (= 24))
  (variant end-mask (= 25))
  (variant blend (= 26))
  (variant begin-blur (= 27))
  (variant end-blur (= 28))
  (variant shader (= 29))
  (variant begin-filter (= 30))
  (variant end-filter (= 31))
  (variant image-pattern (= 32))
  (variant frame (= 33))
)

(type _ DisplayState (is Tuple)
  (prop + parent U32)
  (prop + kind U8)
  (prop + matrix Matrix (= (call Matrix)))
  (prop + rect Rect (= display-no-rect))
  (prop + radius F64)
  (prop + side F64)
  (prop + offset F64)
  (prop + size F64)
  (prop + path-start U32)
  (prop + path-count U32)
  (prop + coord-start U32)
  (prop + fill-rule FillRule (= (. FillRule nonzero)))
  (prop + opacity F64 (= 1))
  (prop + full Matrix (= (call Matrix)))
  (prop + clip-bounds Rect (= display-no-rect))
  (prop + has-clip-bounds _ (= false))
  (prop + local-ink Rect (= display-no-rect))
  (prop + has-local-ink _ (= false))
  (prop + image U32)
  (prop + serial U64)
  (prop + source U32)
  (prop + blend _ (= (. BlendMode normal)))
)

(type _ DisplayStateWire (is Tuple)
