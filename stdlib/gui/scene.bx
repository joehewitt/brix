    (throw (call Panic "DisplayScene commit cannot run during replay") (if is-replaying))
    (throw (call Panic "DisplayScene commit requires a built scene") (if (not is-built)))
    (blank)
    (= has-uncommitted false)
  )
  (fn-do + maintain _
    (param tree-root Box)
    (param scene-scale F64)
    (param clear-background RGBA)
    (call configure scene-scale clear-background)
    (call gui-record-paint-invalidations)
    (finally
      (inline (call gui-replay-paint-invalidations))
    )
    (if is-built
      (call update tree-root)
      (else
        (call build tree-root)
      )
    )
    (call commit)
