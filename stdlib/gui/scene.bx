    (if (not has-damage)
      (probe-count gui.scene.metal-frames-idle)
      (return)
    )
    (blank)
    (= is-replaying true)
    (finally
      (inline (= is-replaying false))
    )
    (call expand-damage false)
    (let clip (call align-damage-to-device damage))
    (let local (call Rect (- (. clip x) (. origin x)) (- (. clip y) (. origin y)) (. clip width) (. clip height)))
    (let is-full-surface (and (<= (. local x) 0) (<= (. local y) 0)))
    (= is-full-surface (and is-full-surface (>= (. local right) (. renderer width))))
    (= is-full-surface (and is-full-surface (>= (. local bottom) (. renderer height))))
    (let is-offset (!= origin (call Point 0 0)))
    (let is-split (and (not is-full-surface) (> (. damage-areas length) 1)))
    (call render-sprites renderer)
    (call render-raster-tiles renderer)
    (call (. renderer begin-packet))
    (= current-metal-resource-renderer (. renderer native))
    (= current-metal-resource-epoch (+ (. renderer image-atlas-evictions) (. renderer image-texture-evictions)))
    (call flush-released-chunks renderer)
