      (call (. surface translate) (- (. origin x)) (- (. origin y)))
      (probe-group + gui.scene.replay)
      (call draw-members roots root-order surface clip)
      (probe-group - gui.scene.replay)
    )
    (if (not is-full-surface)
      (call (. surface pop))
    )
    (blank)
    (let damage-width (as (call ceil (* (. clip width) scale)) Size))
    (let damage-height (as (call ceil (* (. clip height) scale)) Size))
    (let damaged-pixels (* damage-width damage-height))
    (= last-damaged-pixels damaged-pixels)
    (= last-frame-damage local)
    (probe-count gui.frame.damaged-pixels (as damaged-pixels U64))
