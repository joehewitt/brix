      (let y (* (/ slot columns) raster-tile-pixels))
      (let reserved
        (call (. renderer tile-reserve)
          (block
            (arg key)
            (arg (. want generation))
            (arg raster-tile-pixels)
            (arg raster-tile-pixels)
            (arg points)
            (arg points)
            (arg x)
            (arg y)
            (arg (if-expr (== (. want kind) (. RasterWant ahead)) (. MetalTilePool ahead) (. MetalTilePool visible)))
            (arg (. grid settle))
          )
        )
      )
      (if (== reserved 0)
        (if (!= (. want kind) (. RasterWant visible))
          (continue)
        )
        (if (. renderer is-pyramid-full)
          (= raster-full true)
          (break)
        )
        (= (. chunk raster-blocked-pass) raster-pass)
        (continue)
      )
      (+= raster-reserved chunk)
      (let left (/ (as x F64) scale))
      (let top (/ (as y F64) scale))
      (let zoom (. grid scale))
      (call (. renderer push-clip) (call Rect left top points points))
      (call (. renderer push-transform)
