(blank)
(prop _ display-damage-area-limit Size (= 4))
(prop _ display-backdrop-pixel-reach F64 (= 1))
(prop _ display-gradient-linear U32 (= 1))
(prop _ display-gradient-radial U32 (= 2))
(prop _ display-gradient-conic U32 (= 3))
(prop _ display-gradient-shader U32 (= 4))
(prop _ display-gradient-paint U32 (= 5))
(prop _ display-gradient-brush U32 (= 6))
(prop _ display-frame-magic U64 (= 3550328824200053849u64))
(prop _ display-frame-table-count Size (= (+ (as (. DisplayFrameTable quads) Size) 1)))
(prop _ display-frame-header-bytes Size (= (+ 32 (* display-frame-table-count 16))))
(prop _ display-culling-item-count Size (= 32))
(prop _ display-cull-minimum Size (= 64))
(prop _ display-cull-cell-items Size (= 8))
(prop _ display-cull-wide-cells Int (= 16))
(prop _ display-cull-max-axis Int (= 1024))
(prop _ display-texture-image-threshold I32 (= 512))
(prop _ display-pattern-texture-limit I32 (= 2048))
(prop _ display-unknown-ink _ (= (call Rect 0 0 -1 -1)))
(prop _ display-item-has-clip U8 (= 1))
(prop _ display-item-has-glyph-handle U8 (= 2))
(prop _ display-item-has-tint U8 (= 4))
(prop _ display-item-has-inherited-fill U8 (= 8))
(prop _ display-item-has-inherited-stroke U8 (= 16))
(prop _ display-item-template-alpha U8 (= 32))
(prop _ display-item-has-shape U8 (= 64))
(prop _ display-item-has-transform U8 (= 128))
(prop _ display-no-rect _ (= (call Rect 0 0 0 0)))
(prop _ display-no-anchor _ (= (call DisplayAnchor null true)))
(prop _ display-unknown-anchor _ (= (call DisplayAnchor null false)))
(prop _ display-scene-generation U32)
(prop _ display-record-generation U32)
(prop _ metal-tile-canvas-limit Size (= 4))
(prop _ raster-tile-pixels I32 (= 512))
(prop _ raster-lowest-level I32 (= -24))
(prop _ raster-settle-steps F64 (= 1048576))
(prop _ raster-highest-level I32 (= 8))
(prop _ raster-lowest-ratio F64 (= 0.71))
(prop _ raster-strip-nanos F64 (= 200000000))
(prop _ raster-motion-gap U64 (= 100000000))
(prop _ raster-tile-gutter I32 (= 2))
(prop _ raster-tile-interior F64 (= 508))
(prop _ raster-tile-source _ (= (call Rect 2 2 508 508)))
(prop _ raster-cover-ratio F64 (= 2.83))
(prop _ raster-tile-item-cap Size (= 40000))
(prop _ raster-ahead-item-cap Size (= 16000))
(prop _ display-sprite-serial U64)
(prop _ display-sprite-step F64 (= 0.17328679513998632))
(prop _ display-frame-replay _ (:= (call DisplayFrameReplay)))
(prop _ display-sprite-recorder _ (:= (call DisplayRecorder)))
(prop _ display-sprite-owner _ (:= (call Box)))
(blank)
(type-line + LiveFillState (is (tuple (: is-visible Bool) (: frame-rate (? F64)) (: wake-at (? F64)))))
(type-line _ RasterView (is (tuple (: matrix Matrix) (: clip (? Rect)) (: first Size) (: last Size) (: shift Point))))
(type-line _ RasterSpan (is (tuple (: left I32) (: top I32) (: right I32) (: bottom I32))))
(type-line _ RasterGrid (is (tuple (: level I32) (: scale F64) (: settle Bool))))
(type-line _ RasterTile (is (tuple (: chunk DisplayChunk) (: grid RasterGrid) (: column I32) (: row I32) (: generation U32) (: kind RasterWant))))
(type-line _ RasterRange (is (tuple (: first Size) (: last Size))))
(blank)
(type _ RasterWant (is U8)
  (variant visible)
  (variant goal)
  (variant ahead)
)
(blank)
(type _ RasterCellDraw (is U8)
  (variant none)
  (variant cover)
  (variant own)
)
(type-line _ DisplaySpriteWant (is (tuple (: sprite DisplaySprite) (: key U64) (: generation U32) (: pixel-scale F64))))
(type-line _ DisplayEntry (is (tuple (: chunk (? DisplayChunk)) (: group (? DisplayGroup)))))
(type-line _ DisplayAnchor (is (tuple (: entry (? DisplayEntry)) (: known Bool))))
(type-line _ DisplayOrder (is (tuple (: axis U8) (: start-lag F64) (: end-lag F64))))
(type-line _ DisplayRefill (is (tuple (: nodes (list DisplayBoxNode)) (: members (list DisplayEntry)))))
(type-line _ SavedDisplayClip (is (tuple (: rect Rect) (: has Bool) (: shape (? Outline)) (: state U32))))

(type + DisplayItem (is Tuple)
  (prop + kind U8)
  (prop + flags U8)
  (prop + aux U16)
  (prop + x F32)
  (prop + y F32)
  (prop + width F32)
  (prop + height F32)
  (prop + value F32)
  (prop + data0 U32)
  (prop + data1 U32)
  (prop + data2 U32)
  (prop + data3 U32)
)

(type + DisplayShape (is Tuple)
  (prop + radius F32)
  (prop + side F32)
  (prop + offset F32)
  (prop + size F32)
  (prop + blur F32)
  (prop + x F32)
  (prop + y F32)
  (prop + spread F32)
)

(type + DisplayRecorder (is Canvas)
  (prop + unsupported-calls Size)
  (prop + sprite-chunks (list DisplayChunk))
  (prop + live-time F64)
  (blank)
  (prop _ chunk (? DisplayChunk))
  (prop _ recorded-commands (list DisplayCommand))
  (prop _ clip-rect Rect)
  (prop _ has-clip-rect _ (= false))
  (prop _ clip-stack (list SavedDisplayClip))
  (prop _ clip-shape (? Outline))
  (prop _ current-state U32)
  (prop _ path-open _ (= false))
  (prop _ path-start U32)
  (prop _ path-coord-start U32)
  (prop _ recording-scale F64 (= 1))
  (prop _ glyph-registrar (? DisplayGlyphRegistrar))
  (prop _ resource-table (? VectorGeometryTable))
  (fn-do + This _
    (call super 0 0)
  )
  (fn-expr + blend-mode _ :get
    (?? (call (?. (?. chunk side) blend-at) current-state) (. BlendMode normal))
  )
  (fn-expr + scale _ :get
    recording-scale
  )
  (fn-do + blend-mode _ :set (param mode BlendMode)
    (return-if (if (or (not chunk) (== blend-mode mode))))
    (blank)
    (let command (call DisplayCommand (. DisplayCommandKind blend)))
    (+= recorded-commands (= (. command blend) mode))
    (let state (call DisplayState 0 (. DisplayStateKind blend)))
    (call enter-state (= (. state blend) mode))
  )
  (fn-do + push _
    (if chunk
      (+= recorded-commands (call DisplayCommand (. DisplayCommandKind push)))
    )
    (+= clip-stack (call SavedDisplayClip clip-rect has-clip-rect clip-shape current-state))
    (call (. super push))
  )
  (fn-do + pop _
    (if chunk
      (+= recorded-commands (call DisplayCommand (. DisplayCommandKind pop)))
    )
    (if (> (. clip-stack length) 0)
      (let saved (call (. clip-stack pop)))
      (= clip-rect (. saved rect))
      (= has-clip-rect (. saved has))
      (= clip-shape (. saved shape))
      (= current-state (. saved state))
    )
    (call (. super pop))
  )
  (fn-do + erase _
    (param color (? RGBA))
    (return-if (if (not chunk)))
    (blank)
    (+= unsupported-calls 1)
    (+= recorded-commands
      (call DisplayCommand
        (block
          (arg (. DisplayCommandKind erase))
          (arg display-no-rect)
          (arg (call Point 0 0))
          (arg (call Point 0 0))
          (arg (call Point 0 0))
          (arg (call Matrix))
          (arg color)
        )
      )
    )
  )
  (fn-do + fill-gradient _
    (param rect Rect)
    (param gradient Gradient)
    (return-if (if (not chunk)))
    (blank)
    (let current chunk)
    (call (. gradient validate))
    (+= recorded-commands
      (call DisplayCommand
        (block
          (arg (. DisplayCommandKind gradient))
          (arg rect)
          (arg (call Point 0 0))
          (arg (call Point 0 0))
          (arg (call Point 0 0))
          (arg (call Matrix))
          (arg null)
          (arg null)
          (arg 0)
          (arg (. LineCap butt))
          (arg (. LineJoin miter))
          (arg null)
          (arg null)
          (arg (. TextAlignment left))
          (arg false)
          (arg (. FillRule nonzero))
          (arg 0)
          (arg gradient)
        )
      )
    )
    (call promote-root-clip)
    (call record-styled (. DisplayStyledShape rect) rect rect 0 0 0 true (. FillRule nonzero) gradient)
  )
  (fn-do + fill-shader _
    (param rect Rect)
    (param shader Shader)
    (param args (list F64) (= (call (of List F64))))
    (return-if (if (not chunk)))
    (blank)
    (let copied (call (of List F64) args))
    (+= recorded-commands
      (call DisplayCommand
        (block
          (arg (. DisplayCommandKind shader))
          (arg rect)
          (arg (call Point 0 0))
          (arg (call Point 0 0))
          (arg (call Point 0 0))
          (arg (call Matrix))
          (arg null)
          (arg null)
          (arg 0)
          (arg (. LineCap butt))
          (arg (. LineJoin miter))
          (arg null)
          (arg null)
          (arg (. TextAlignment left))
          (arg false)
          (arg (. FillRule nonzero))
          (arg 0)
          (arg null)
          (arg 0)
          (arg (. BlendMode normal))
          (arg shader)
          (arg copied)
        )
      )
    )
    (call promote-root-clip)
    (call record-styled
      (block
        (arg (. DisplayStyledShape rect))
        (arg rect)
        (arg rect)
        (arg 0)
        (arg 0)
        (arg 0)
        (arg true)
        (arg (. FillRule nonzero))
        (arg null)
        (arg null)
        (arg shader)
        (arg copied)
      )
    )
  )
  (fn-do + begin-filter _
    (param rect Rect)
    (param filter ShaderFilter)
    (return-if (if (not chunk)))
    (blank)
    (+= unsupported-calls 1)
    (let copied (call (of List F64) (. filter args)))
    (+= recorded-commands
      (call DisplayCommand
        (block
          (arg (. DisplayCommandKind begin-filter))
          (arg rect)
          (arg (call Point 0 0))
          (arg (call Point 0 0))
          (arg (call Point 0 0))
          (arg (call Matrix))
          (arg null)
          (arg null)
          (arg 0)
          (arg (. LineCap butt))
          (arg (. LineJoin miter))
          (arg null)
          (arg null)
          (arg (. TextAlignment left))
          (arg false)
          (arg (. FillRule nonzero))
          (arg 0)
          (arg null)
          (arg 0)
          (arg (. BlendMode normal))
          (arg (. filter shader))
          (arg copied)
          (arg (call (of List Image) (. filter images)))
        )
      )
    )
  )
  (fn-do + end-filter _
    (return-if (if (not chunk)))
    (blank)
    (+= unsupported-calls 1)
    (+= recorded-commands (call DisplayCommand (. DisplayCommandKind end-filter)))
  )
  (fn-do + rect _
    (param rect Rect)
    (if shape-fill
      (call begin)
      (call rect-path rect)
      (call end true)
      (return)
    )
    (return-if (if (not chunk)))
    (blank)
    (let current chunk)
    (let shape root-clip-shape)
    (if shape
      (if (and fill-color (not fill-paint) (not stroke-color) (call (. rect contains) (. shape extent) 0.01))
        (call record-outline-fill shape)
        (return)
      )
      (call promote-root-clip)
    )
    (+= recorded-commands (call display-shape-command (. DisplayCommandKind rect) rect this))
    (let styled (and stroke-color (or (> stroke-dash 0) (!= stroke-join (. LineJoin miter)) stroke-brush)))
    (let painted (and fill-color fill-paint))
    (if (or styled painted (and (or fill-color stroke-color) (not translates)))
      (call record-styled
        (block
          (arg (. DisplayStyledShape rect))
          (arg rect)
          (arg (call display-stroke-ink rect this))
          (arg 0)
          (arg 0)
          (arg 0)
          (arg false)
          (arg (. FillRule nonzero))
          (arg null)
          (arg null)
          (arg null)
          (arg null)
          (arg fill-paint)
          (arg stroke-brush)
        )
      )
      (return)
    )
    (call contain-root-clip (if-expr stroke-color (call (. rect inflate) stroke-width) rect))
    (if fill-color
      (let quad
        (call (. current add-item)
          (block
            (arg (call display-item (. DisplayItemKind quad) rect 0 (call pack-rgba8 (!! fill-color))))
            (arg (if-expr (== current-state 0) (call root-ink rect) rect))
            (arg current-state)
          )
        )
      )
      (call (. current set-item-color) quad (!! fill-color))
      (call (. current set-item-exact) quad rect 0)
    )
    (if stroke-color
      (let ink (call (. rect inflate) stroke-width))
      (if root-clip-active
        (= ink (call (. ink intersection) clip-rect))
      )
      (let border
        (call (. current add-item)
          (block
            (arg (call display-item (. DisplayItemKind border) rect stroke-width (call pack-rgba8 (!! stroke-color))))
            (arg ink)
            (arg current-state)
          )
        )
      )
      (call (. current set-item-color) border (!! stroke-color))
      (call (. current set-item-exact) border rect stroke-width)
    )
  )
  (fn-do + square _
    (param x Coord)
    (param y Coord)
    (param width Length)
    (call rect (call Rect x y width width))
  )
  (fn-do + oval _
    (param rect Rect)
    (if shape-fill
      (call begin)
      (call oval-path rect)
      (call end true)
      (return)
    )
    (return-if (if (not chunk)))
    (blank)
    (+= recorded-commands (call display-shape-command (. DisplayCommandKind oval) rect this))
    (return-if (if (and (not fill-color) (not stroke-color))))
    (blank)
    (call promote-root-clip)
    (call record-styled
      (block
        (arg (. DisplayStyledShape oval))
        (arg rect)
        (arg (call display-stroke-ink rect this))
        (arg 0)
        (arg 0)
        (arg 0)
        (arg false)
        (arg (. FillRule nonzero))
        (arg null)
        (arg null)
        (arg null)
        (arg null)
        (arg fill-paint)
        (arg stroke-brush)
      )
    )
  )
  (fn-do + circle _
    (param cx Coord)
    (param cy Coord)
    (param radius Length)
    (let diameter (* radius 2))
    (call oval (call Rect (- cx radius) (- cy radius) diameter diameter))
  )
  (fn-do + move _
    (param x Coord)
    (param y Coord)
    (return-if (if (not chunk)))
    (blank)
    (call append-path-verb (. DisplayPathVerb move))
    (call append-path-point x y)
  )
  (fn-do + line _
    (param x Coord)
    (param y Coord)
    (return-if (if (not chunk)))
    (blank)
    (call append-path-verb (. DisplayPathVerb line))
    (call append-path-point x y)
  )
  (fn-do + curve _
    (param x1 Coord)
    (param y1 Coord)
    (param x2 Coord)
    (param y2 Coord)
    (param x3 Coord)
    (param y3 Coord)
    (return-if (if (not chunk)))
    (blank)
    (call append-path-verb (. DisplayPathVerb curve))
    (call append-path-point x1 y1)
    (call append-path-point x2 y2)
    (call append-path-point x3 y3)
  )
  (fn-do + translate _
    (param x Coord)
    (param y Coord)
    (call transform (call matrix-from-translation (call Point x y)))
  )
  (fn-do + transform _
    (param matrix Matrix)
    (return-if (if (not chunk)))
    (blank)
    (+= recorded-commands
      (call DisplayCommand
        (block
          (arg (. DisplayCommandKind transform))
          (arg display-no-rect)
          (arg (call Point 0 0))
          (arg (call Point 0 0))
          (arg (call Point 0 0))
          (arg matrix)
        )
      )
    )
    (return-if (if (. matrix is-identity)))
    (blank)
    (let state (call DisplayState 0 (. DisplayStateKind transform)))
    (call enter-state (= (. state matrix) matrix))
  )
  (fn-do + transform-content _
    (param matrix Matrix)
    (return-if (if (not chunk)))
    (blank)
    (+= recorded-commands
      (call DisplayCommand
        (block
          (arg (. DisplayCommandKind transform))
          (arg display-no-rect)
          (arg (call Point 0 0))
          (arg (call Point 0 0))
          (arg (call Point 0 0))
          (arg matrix)
        )
      )
    )
    (let table (call (. (!! chunk) ensure-side)))
    (let kind (if-expr (== (. table content-state) 0) (. DisplayStateKind content) (. DisplayStateKind transform)))
    (let state (call DisplayState 0 kind))
    (call enter-state (= (. state matrix) matrix))
    (if (== kind (. DisplayStateKind content))
      (= (. table content-state) current-state)
    )
  )
  (fn-do + outline _
    (param shape Outline)
    (if shape-fill
      (call begin)
      (call outline-path shape)
      (call end true)
      (return)
    )
    (return-if (if (not chunk)))
    (blank)
    (if (and (. shape is-rectangular) (not root-clip-shape))
      (call rect (. shape bounds))
      (return)
    )
    (if (or (and stroke-color (or (> stroke-dash 0) (!= stroke-join (. LineJoin miter)))) (not translates))
      (call begin)
      (call outline-path shape)
      (call end)
      (return)
    )
    (if fill-color
      (call fill-outline shape)
    )
    (if stroke-color
      (call stroke-outline shape)
    )
  )
  (fn-do + quads _
    (param quads (list Quad))
    (return-if (if (or (not chunk) (== (. quads length) 0))))
    (blank)
    (if (or shape-fill fill-paint (not translates))
      (call (. super quads) quads)
      (return)
    )
    (let current (!! chunk))
    (call promote-root-clip)
    (let table (call (. current ensure-side)))
    (let stored (. table quads))
    (let start (as (. stored length) U32))
    (let first ([] quads 0))
    (let left (. first x))
    (let top (. first y))
    (let right (+ left (. first width)))
    (let bottom (+ top (. first height)))
    (for (in quad quads)
      (+= stored quad)
      (= left (call min left (. quad x)))
      (= top (call min top (. quad y)))
      (= right (call max right (+ (. quad x) (. quad width))))
      (= bottom (call max bottom (+ (. quad y) (. quad height))))
    )
    (let bounds (call Rect (as left F64) (as top F64) (as (- right left) F64) (as (- bottom top) F64)))
    (call contain-root-clip bounds)
    (let item (call display-item (. DisplayItemKind quads) bounds 0 0 start (as (. quads length) U32)))
    (let ink (if-expr (== current-state 0) (call root-ink bounds) bounds))
    (call record-item-command (call (. current add-item) item ink current-state))
  )
  (fn-do + clip _
    (param rect Rect)
    (return-if (if (not chunk)))
    (blank)
    (+= recorded-commands (call DisplayCommand (. DisplayCommandKind clip) rect))
    (if (or (!= current-state 0) clip-shape)
      (call enter-state (= (. (call DisplayState 0 (. DisplayStateKind clip)) rect) rect))
      (return)
    )
    (if has-clip-rect
      (= clip-rect (call (. clip-rect intersection) rect))
      (else
        (= clip-rect rect)
        (= has-clip-rect true)
      )
    )
  )
  (fn-do + clip-outline _
    (param shape Outline)
    (return-if (if (not chunk)))
    (blank)
    (let current chunk)
    (if (!= current-state 0)
      (+= recorded-commands (call display-outline-clip-command shape))
      (call enter-state (call display-outline-state 0 (. DisplayStateKind clip-outline) shape))
      (return)
    )
    (if (. shape is-rectangular)
      (call clip (. shape bounds))
      (return)
    )
    (let extent (. shape extent))
    (+= recorded-commands (call display-outline-clip-command shape))
    (if (or clip-shape (and has-clip-rect (not (call (. clip-rect contains) extent 0.01))))
      (call enter-state (call display-outline-state 0 (. DisplayStateKind clip-outline) shape))
      (return)
    )
    (= clip-shape shape)
    (if has-clip-rect
      (= clip-rect (call (. clip-rect intersection) extent))
      (else
        (= clip-rect extent)
        (= has-clip-rect true)
      )
    )
  )
  (fn-do + clip-path _
    (param fill-rule FillRule (= (. FillRule nonzero)))
    (return-if (if (not chunk)))
    (blank)
    (if (not path-open)
      (+= unsupported-calls 1)
      (return)
    )
    (= path-open false)
    (let table (call (. chunk ensure-side)))
    (let count (- (as (. table path-verbs length) U32) path-start))
    (let bounds (call (. table state-path-bounds) path-start path-coord-start count))
    (call enter-state
      (block
        (arg
          (call DisplayState
            (block
              (arg 0)
              (arg (. DisplayStateKind clip-path))
              (arg (call Matrix))
              (arg bounds)
              (arg 0)
              (arg 0)
              (arg 0)
              (arg 0)
              (arg path-start)
              (arg count)
              (arg path-coord-start)
              (arg fill-rule)
            )
          )
        )
      )
    )
    (let command (call DisplayCommand (. DisplayCommandKind clip-path)))
    (+= recorded-commands (= (. command item-index) current-state))
  )
  (fn-do + clip-mask _
    (param image RasterCanvas)
    (param rect Rect)
    (return-if (if (not chunk)))
    (blank)
    (let command (call DisplayCommand (. DisplayCommandKind clip-mask) rect))
    (+= recorded-commands (= (. command image) image))
    (let table (call (. (!! chunk) ensure-side)))
    (let state (call DisplayState 0 (. DisplayStateKind clip-mask) (call Matrix) rect))
    (= state (= (. state image) (as (. table images length) U32)))
    (= state (= (. state serial) (. image content-serial)))
    (+= (. table images) image)
    (+= (. table image-identities) (. image identity))
    (call enter-state state)
  )
  (fn-do + begin-mask _
    (return-if (if (not chunk)))
    (blank)
    (+= recorded-commands (call DisplayCommand (. DisplayCommandKind begin-mask)))
    (+= clip-stack (call SavedDisplayClip clip-rect has-clip-rect clip-shape current-state))
    (call (. super push))
    (call enter-state (call DisplayState 0 (. DisplayStateKind mask-layer)))
  )
  (fn-do + end-mask _
    (return-if (if (not chunk)))
    (blank)
    (let table (call (. chunk ensure-side)))
    (let source current-state)
    (while (and (!= source 0) (!= (. ([] (. table states) source) kind) (. DisplayStateKind mask-layer)))
      (= source (. ([] (. table states) source) parent))
    )
    (if (or (== source 0) (== (. clip-stack length) 0))
      (+= unsupported-calls 1)
      (return)
    )
    (+= recorded-commands (call DisplayCommand (. DisplayCommandKind end-mask)))
    (let saved (call (. clip-stack pop)))
    (= clip-rect (. saved rect))
    (= has-clip-rect (. saved has))
    (= clip-shape (. saved shape))
    (= current-state (. saved state))
    (call (. super pop))
    (let state (call DisplayState 0 (. DisplayStateKind clip-layer-mask)))
    (call enter-state (= (. state source) source))
  )
  (fn-do + begin-blur _
    (param radius Length)
    (return-if (if (not chunk)))
    (blank)
    (+= recorded-commands
      (call DisplayCommand
        (block
          (arg (. DisplayCommandKind begin-blur))
          (arg display-no-rect)
          (arg (call Point radius 0))
        )
      )
    )
    (let state (call DisplayState 0 (. DisplayStateKind blur)))
    (call enter-state (= (. state radius) radius))
  )
  (fn-do + end-blur _
    (return-if (if (not chunk)))
    (blank)
    (+= recorded-commands (call DisplayCommand (. DisplayCommandKind end-blur)))
    (let table (call (. (!! chunk) ensure-side)))
    (let cursor current-state)
    (while (and (!= cursor 0) (!= (. ([] (. table states) cursor) kind) (. DisplayStateKind blur)))
      (= cursor (. ([] (. table states) cursor) parent))
