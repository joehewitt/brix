    (if (and side (. side has-antialiased))
      (= has-antialiased-content true)
    )
    (if (and side (. side has-shaded-fill))
      (= has-shaded-fill-content true)
    )
    (if (and side (. side has-backdrop))
      (= has-backdrop-content true)
    )
