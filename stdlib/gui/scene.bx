  (fn-do _ draw-raster-grid-cover Bool
    (param chunk DisplayChunk)
    (param view RasterView)
    (param target RasterGrid)
    (param column I32)
    (param row I32)
    (param source RasterGrid)
    (param generation U32)
    (param scale F64)
