    (call (. chunk reset))
    (let unsupported-before (. recorder unsupported-calls))
    (call (. recorder begin-chunk) chunk)
    (if (== (. chunk phase) (. DisplayPhase pre))
      (call (. chunk owner paint-box-background) recorder)
      (let self-start (. recorder recorded-commands length))
      (let self-unsupported (. recorder unsupported-calls))
      (call (. chunk owner paint-box-self) recorder)
      (if (not (call (. recorder has-paint-since) self-start))
        (while (> (. recorder recorded-commands length) self-start)
          (call (. recorder recorded-commands pop))
        )
        (= (. recorder unsupported-calls) self-unsupported)
      )
      (else
        (call (. chunk owner paint-box-border) recorder)
