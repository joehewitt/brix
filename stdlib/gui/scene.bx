    (probe-count gui.gpu.pipeline-switches (as (. renderer pipeline-switches) U64))
    (probe-count gui.gpu.encode-nanos (as (. renderer encode-nanos) U64))
    (probe-count gui.gpu.walk-nanos (as (. renderer walk-nanos) U64))
    (if (>= (. renderer gpu-nanos) 0)
      (probe-count gui.gpu.gpu-nanos (as (. renderer gpu-nanos) U64))
    )
    (probe-count gui.gpu.packet-bytes (as (. renderer packet-bytes) U64))
    (probe-count gui.gpu.unrenderable-ops (as (. renderer skipped-ops) U64))
