)

(type _ DisplayPathStyle (is Tuple)
  (prop + fill (? RGBA))
  (prop + stroke (? RGBA))
  (prop + stroke-width Length)
  (prop + stroke-cap LineCap)
  (prop + stroke-join LineJoin)
  (prop + stroke-dash Length)
  (prop + fill-rule FillRule)
  (prop + closed Bool)
  (prop + gradient (? Gradient) (= null))
  (prop + shadow (? Shadow) (= null))
  (prop + shader (? Shader) (= null))
  (prop + shader-args (? (list F64)) (= null))
  (prop + paint (? Paint) (= null))
  (prop + brush (? Brush) (= null))
  (prop + shape-fill (? ShaderFill) (= null))
)

(type _ DisplayCommand (is Tuple)
  (prop + kind U8)
  (prop + rect Rect (= display-no-rect))
  (prop + point1 Point (= (call Point 0 0)))
  (prop + point2 Point (= (call Point 0 0)))
  (prop + point3 Point (= (call Point 0 0)))
  (prop + matrix Matrix (= (call Matrix)))
  (prop + fill (? RGBA) (= null))
  (prop + stroke (? RGBA) (= null))
  (prop + stroke-width Length (= 0))
  (prop + stroke-cap LineCap (= (. LineCap butt)))
  (prop + stroke-join LineJoin (= (. LineJoin miter)))
  (prop + layout (? TextLayout) (= null))
  (prop + image (? RasterCanvas) (= null))
  (prop + alignment TextAlignment (= (. TextAlignment left)))
  (prop + flag _ (= false))
  (prop + fill-rule FillRule (= (. FillRule nonzero)))
  (prop + item-index U32)
  (prop + gradient (? Gradient) (= null))
  (prop + stroke-dash Length (= 0))
  (prop + blend _ (= (. BlendMode normal)))
  (prop + shader (? Shader) (= null))
  (prop + shader-args (? (list F64)) (= null))
  (prop + shader-images (? (list Image)) (= null))
  (prop + sampling _ (= (. ImageSampling smooth)))
)

(type _ DisplayChunk
  (prop + owner Box)
  (prop + phase U8)
  (prop + parent (? DisplayGroup))
  (prop + items (list DisplayItem))
  (prop + glyph-layouts (? (list TextLayout)))
  (prop + glyph-fills (? (list (? ShaderFill))))
  (prop + item-glyph-layouts (list U32))
  (prop + glyph-handles (? (list DisplayGlyphHandle)))
  (prop + clips (list Rect))
  (prop + shapes (list DisplayShape))
  (prop + vector-palette (list U32))
  (prop + side (? DisplayChunkSide))
  (prop + exacts (? DisplayChunkExacts))
  (prop + commands (? (list DisplayCommand)))
  (prop + bounds Rect)
  (prop + has-bounds _ (= false))
  (prop + is-opaque _ (= false))
  (prop + needs-tile _ (= false))
  (prop + indicator-start Size)
  (prop + indicator-count Size)
  (prop + record-generation U32 (= 1))
  (prop + path-generation U32 (= 1))
  (prop + refill-mark U32)
  (prop + refill-index Size)
  (prop + linked-mark U32)
  (prop + cull-index (? DisplayCullIndex))
  (prop + cull-seen U32)
  (prop + metal-resource-renderer (? Pointer))
  (prop + metal-resource-epoch I64 (= -1))
  (prop + raster-generation U32)
  (prop + is-raster-content _ (= false))
  (prop + raster-first Size)
  (prop + raster-last Size)
  (prop + raster-level-seen I32)
  (prop + raster-level-drop _ (= false))
  (prop + raster-surface-seen Rect)
  (prop + raster-blocked-pass U32)
  (prop + raster-tiling _ (= false))
  (prop + raster-scale-seen F64)
  (prop + raster-scale-at U64)
  (prop + raster-settle-scale F64)
  (prop + raster-settle-due U64)
  (prop + raster-settle-area Rect)
  (prop + raster-goal-seen F64)
  (prop + raster-goal-at U64)
  (prop + raster-motion-x F64)
  (prop + raster-motion-y F64)
  (prop + raster-motion-zoom F64)
  (prop + raster-motion-time U64)
  (prop + sprites (? (list DisplaySprite)))
  (prop + sprite-items (? (list U32)))
  (prop + sprite-mark U32)
  (prop + is-live _ (= false))
  (prop + live-rate (? F64))
  (prop + live-epoch (? F64))
  (prop + live-slot _ (= -1.0))
  (prop + live-cycle (? FrameCycle))
  (prop + is-live-settled _ (= false))
  (fn-do _ This _
    (param chunk-owner Box)
    (param chunk-phase U8)
    (lazy owner chunk-owner)
    (= phase chunk-phase)
  )
  (fn-expr + sprite-count Size :get
    (?? (?. sprites length) 0)
  )
  (fn-do _ reset _
    (= record-generation (call next-display-record-generation))
    (= path-generation record-generation)
    (= cull-index null)
    (call (. items clear))
    (call (?. glyph-layouts clear))
    (call (?. glyph-fills clear))
    (call (. item-glyph-layouts clear))
    (call (?. glyph-handles clear))
    (call (. clips clear))
    (call (. shapes clear))
    (call (. vector-palette clear))
    (let current side)
    (if current
      (call (. current clear))
    )
    (let known-exacts exacts)
    (if known-exacts
      (call (. known-exacts clear))
    )
    (call (?. commands clear))
    (call (?. sprites clear))
    (call (?. sprite-items clear))
    (= bounds display-no-rect)
    (= has-bounds false)
    (= is-opaque false)
    (= needs-tile false)
    (= is-live false)
    (= live-rate null)
    (= indicator-start 0)
    (= indicator-count 0)
    (= metal-resource-renderer null)
    (= metal-resource-epoch -1)
  )
  (fn-do _ add-glyph-layout U32
    (param layout TextLayout)
    (param fill (? ShaderFill))
    (let layouts (?? glyph-layouts (call (of List TextLayout))))
    (let fills (?? glyph-fills (call (of List (? ShaderFill)))))
    (= glyph-layouts layouts)
    (= glyph-fills fills)
    (let index (as (. layouts length) U32))
