    (if tile-damage
      (let device-scale (. renderer scale))
      (call note-tile-damage
        (call Rect
          (block
            (arg (+ (/ (. tile-damage x) device-scale) (. origin x)))
            (arg (+ (/ (. tile-damage y) device-scale) (. origin y)))
            (arg (/ (. tile-damage width) device-scale))
            (arg (/ (. tile-damage height) device-scale))
