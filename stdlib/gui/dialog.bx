(import ./box)
(import ./button)
(import ./events)
(import ./label)
(import ./placement)
(import ./popup)
(import ./primitives)
(import ./shorthands)
(import ./styles)
(import ./theme)
(import /graphics/color)
(import /graphics/outline)
(import /graphics/primitives)
(import /graphics/text)

(style-extend GUIDefaultTheme
  (using GUIBoxPaint)
  (using GUITextPaint)
  (using GUIFontStyle)
  (using GUIBoxSpacing)
  (using GUIBoxSize)
  (using GUIPopupStyle)
  (rule Dialog (• bg gui-scrim-color) (• text gui-text-color)
    (rule dialog-panel (• bg gui-popup-color) (• pt 18) (• px 20) (• pb 16) (• min-w 320)
      (= border-color gui-border-color)
      (= border-width 1)
      (= corner-radius gui-popup-radius)
      (= shadow gui-popup-shadow)
    )
    (blank)
    (rule dialog-title (• text gui-strong-text-color) (• h 22) (• mb 10)
      (= font-size gui-title3-font-size)
      (= font-weight (. FontWeight bold))
    )
    (blank)
    (rule dialog-message (• max-w 420)
      (= text-wrap (. TextWrap word))
    )
    (blank)
    (rule dialog-actions (• mt 16))
    (blank)
    (rule dialog-button (• min-w 66) (• ml 8))
  )
)

(type + Dialog (is Popup)
  (prop + title _ (= ""))
  (event + accepted DismissReason)
  (event + canceled DismissReason)
  (blank)
  (rule This (• flex-col) (• fill-window) (• modal)
    (= focus-mode (. FocusMode inside))
    (= deactivate-dismiss false)
    (= anchor-hidden-dismiss false)
  )
  (fn-do + This _
    (param title _ (= ""))
  )
  (content
    (<> This
      (<> Box (• flex-row) (• flex 1)
        (= align-x (. Alignment center))
        (<> Box (id: panel) (• dialog-panel) (• flex-col)
          (= align-y (. Alignment center))
          (if (!= #title "")
            (<> Label (id: title-label) (• dialog-title)
              (= text #title)
            )
          )
          (+<> Box (id: body) (• flex-col))
          (+<> Box (id: actions) (• dialog-actions) (• flex-row))
        )
      )
    )
  )
  (subscribe-for (on reason dismissed (when arrival))
    (if (== reason (. DismissReason chosen))
      (<- accepted reason)
      (else
        (<- canceled reason)
      )
    )
  )
  (fn-do + accept _
    (call dismiss (. DismissReason chosen))
  )
  (fn-do + cancel _
    (call dismiss (. DismissReason programmatic))
  )
)

(type + AlertDialog (is Dialog)
  (prop + message _ (= ""))
  (prop + accept-title _ (= "OK"))
  (content
    (<> This
      (<> Label (slot: body) (• dialog-message)
        (= text #message)
      )
      (<> Box (slot: actions) (• flex-row)
        (<> Box (• flex 1))
        (<> Button (• dialog-button)
          (= title #accept-title)
          (= role (. ButtonRole default))
          (= action (=> () :do (call accept)))
        )
      )
    )
  )
)

(type + ConfirmDialog (is Dialog)
  (prop + message _ (= ""))
  (prop + accept-title _ (= "OK"))
  (prop + cancel-title _ (= "Cancel"))
  (content
    (<> This
      (<> Label (slot: body) (• dialog-message)
        (= text #message)
      )
      (<> Box (slot: actions) (• flex-row)
        (<> Box (• flex 1))
        (<> Button (• dialog-button)
          (= title #cancel-title)
          (= role (. ButtonRole cancel))
          (= action (=> () :do (call cancel)))
        )
        (<> Button (• dialog-button)
          (= title #accept-title)
          (= role (. ButtonRole default))
          (= action (=> () :do (call accept)))
        )
      )
    )
  )
)
