╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌

────────────────────
+ do toggle

is-collapsed = !is-collapsed

────────────────────
_ do scrolling-body Box?

. after = false
for child in children
    =? child as Box if after && child is Box
    after = child as Pointer == heading as Pointer
= null

────────────────────
_ get storage-key String?

"sidebar:${state-key}" if state-key

────────────────────
_ do restore-collapse

. key = storage-key
. store = gui-app-state(this)
=? if !key || !store
. saved = store.read(key, 1)
=? if !saved
. collapsed = catch? JSONReader("sidebar", saved).bool()
if collapsed != null
    is-collapsed = collapsed

────────────────────
_ do collapse-changed

. key = storage-key
. store = gui-app-state(this)
=? if !key || !store
store.write(key, 1, is-collapsed)

