────────────────────
+ view-transform Matrix

match current
    |= null
        Matrix()
    ??
        |? view.width <= 0 || view.height <= 0
            matrix-from-translation(content.top-left)
        ??
            vector-view-transform(view, image-fit-rect(view.size, content, fit, align-x, align-y))

        .. view = current.view-box(current.root)

.. current = document
.. content = content-bounds

────────────────────
+ do sync-document Bool

. current = document
= if current then ensure-renderer(current).sync() else false

────────────────────
+ do unmounted

release-renderer()
super.unmounted()

────────────────────
+ do close

release-renderer()
super.close()

────────────────────
+ measured-content-size
    - query MeasureQuery

match current
    |= null
        Dimensions(0, 0)
    ??
        Dimensions(max(view.width, 0), max(view.height, 0))

        .. view = current.view-box(current.root)

.. current = document

────────────────────
+ do paint-self
    - canvas Canvas

. current = document
=? if !current
. content = content-bounds
=? if content.width <= 0 || content.height <= 0
. active = ensure-renderer(current)
active.sync()
. geometry-table = vector-geometry-table-for(markup-batch-root)
if table && table as Pointer != geometry-table as Pointer
    active.release()
    active.sync()
table = geometry-table
active.paint(canvas, view-transform(), geometry-table, embeds, null, images)

────────────────────
_ do ensure-renderer
    - current VectorDocument

. existing = renderer
=? existing if existing && existing.document as Pointer == current as Pointer
release-renderer()
. given = paths
. created = if given then VectorDocumentRenderer(current, given) else standalone
    .. standalone = VectorDocumentRenderer(current)
renderer = created
= created

────────────────────
_ do release-renderer

. existing = renderer
if existing
    existing.release()
renderer = null
