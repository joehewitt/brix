(import ./primitives)
(import ./shorthands)
(import ./styles)
(import ./theme)
(import /graphics/primitives)
(import /graphics/style)

(style-extend GUIDefaultTheme
  (using GUIBoxMotion)
  (using GUIBoxSize)
  (using VectorPaintStyle)
  (rule icon (• w 16) (• h 16)
    (= stroke (. Stroke inherit))
    (= stroke-width gui-icon-stroke-width)
  )
  (blank)
  (rule spinner
    (= animation spin)
  )
)
