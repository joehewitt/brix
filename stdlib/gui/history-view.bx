(import ./box)
(import ./events)
(import ./label)
(import ./number-field)
(import ./primitives)
(import ./select)
(import ./shorthands)
(import ./styles)
(import ./theme)
(import /graphics/point)
(import /graphics/primitives)
(import /ui/command-log)
(import /ui/command-parameters)
(import /ui/value-change-phase)

(style-extend GUIDefaultTheme
  (using GUIBoxSize)
  (using GUIBoxSpacing)
  (using GUITextPaint)
  (rule HistoryStepRow (• min-h 28) (• px 8) (• mb 2)
    (blank)
    (rule history-step-number (• text gui-muted-text-color) (• w 20))
    (blank)
    (rule history-step-failure (• text gui-danger-color) (• ml 8))
  )
  (blank)
  (rule HistoryPart (• mr 4)
    (blank)
    (rule history-number-field (• w 64))
  )
)

(type + HistoryStep (is Tuple)
  (prop + index Index)
  (prop + id U64)
  (prop + title String)
  (prop + sentence (list CommandSentencePart))
  (prop + failure (? String))
)

(type + HistoryView (is Box)
  (prop + log (? EditableLog))
  (prop + revision U64 (= 0))
  (prop + steps (list HistoryStep) (= (call history-steps #revision #log)))
  (blank)
  (rule This (• flex-col))
  (content
    (<> This
      (for (in shown #steps (keyed-by (. shown id)))
        (<> HistoryStepRow
          (= log log)
          (= step shown)
        )
      )
    )
  )
)

(type + HistoryStepRow (is Box)
  (prop + log (? EditableLog))
  (prop + step (? HistoryStep))
  (prop + parts (list HistoryPartSlot) (= (call history-part-slots #step)))
  (blank)
  (rule This (• flex-row))
  (content
    (<> This
      (<> Label (id: number) (• history-step-number)
        (= align-y (. Alignment center))
        (= text (str (+ (?? (?. #step index) 0) 1)))
      )
      (for (in slot #parts (keyed-by (. slot order)))
        (<> HistoryPart
          (= log log)
          (= id (?? (?. step id) 0))
          (= part (. slot part))
        )
      )
      (if (?. #step failure)
        (<> Label (id: failure) (• history-step-failure)
          (= align-y (. Alignment center))
          (= text (?? (?. #step failure) ""))
        )
      )
    )
  )
)

(type + HistoryPartSlot (is Tuple)
  (prop + order Index)
  (prop + part CommandSentencePart)
)

(type + HistoryPart (is Box)
  (prop + log (? EditableLog))
  (prop + id U64 (= 0))
  (prop + part (? CommandSentencePart))
  (prop + number _ (= (only-if (call command-sentence-number #part) (if #part))))
  (prop + point _ (= (only-if (call command-sentence-point #part) (if #part))))
  (prop + choices _ (= (call history-part-choices #part)))
  (prop + text _ (= (call history-part-text #part)))
  (blank)
  (rule This (• flex-row))
  (content
    (<> This
      (if #number
        (<> NumberField (id: number-field) (• history-number-field)
          (= align-y (. Alignment center))
          (= value (. (!! #number) display-value))
          (= step (. (!! #number) step))
          (= unit (. (!! #number) unit suffix))
          (for (on event value-changing)
            (call edit
              (block
                (arg (. (!! number) key))
                (arg (call (. CommandParameterValue number) (/ (. event value) (. (!! number) unit display-scale))))
                (arg (. event phase))
              )
            )
            (call (. event cancel))
          )
        )
        (else-if #point
          (<> NumberField (id: x-field) (• history-number-field)
            (= align-y (. Alignment center))
            (= label "X")
            (= value (as (. (!! #point) value x) F64))
            (for (on event value-changing)
              (call edit
                (block
                  (arg (. (!! point) key))
                  (arg (call (. CommandParameterValue point) (call Point (. event value) (. (!! point) value y))))
                  (arg (. event phase))
                )
              )
              (call (. event cancel))
            )
          )
          (<> NumberField (id: y-field) (• history-number-field)
            (= align-y (. Alignment center))
            (= label "Y")
            (= value (as (. (!! #point) value y) F64))
            (for (on event value-changing)
              (call edit
                (block
                  (arg (. (!! point) key))
                  (arg (call (. CommandParameterValue point) (call Point (. (!! point) value x) (. event value))))
                  (arg (. event phase))
                )
              )
              (call (. event cancel))
            )
          )
        )
        (else-if (. #choices length)
          (<> (of Select String) (id: choice-select)
            (= align-y (. Alignment center))
            (= options #choices)
            (= selected #text)
            (for (on event selection-changed)
              (call edit
                (block
                  (arg (?? (call command-part-key (!! part)) ""))
                  (arg (call (. CommandParameterValue text) (. event value)))
                  (arg (. ValueChangePhase discrete))
                )
              )
            )
          )
        )
        (else
          (<> Label (id: text-label)
            (= align-y (. Alignment center))
            (= text #text)
          )
        )
      )
    )
  )
  (fn-do + edit _
    (param key String)
    (param value CommandParameterValue)
    (param phase ValueChangePhase)
    (let active log)
    (return-if (if (or (not active) (not (. key length)))))
    (let ignored (call (. active edit-parameter) id key value phase))
  )
)

(fn-expr _ history-steps (list HistoryStep)
  (param revision U64)
  (param log (? EditableLog))
  (match log
    (case= null
      (call (of List HistoryStep))
    )
    (default
      (call (of List HistoryStep)
        (block
          (spread (..< 0 (. log length)))
          (pipe *>
            (call HistoryStep
              (block
                (arg each)
                (arg (call (. log step-id) each))
                (arg (call (. log step-title) each))
                (arg (call (. log step-sentence) each))
                (arg (call (. log step-failure) each))
              )
            )
          )
        )
      )
    )
  )
)

(fn-expr _ history-part-slots (list HistoryPartSlot)
  (param step (? HistoryStep))
  (if-expr step slots (call (of List HistoryPartSlot)))
  (where
    (lazy sentence (. step sentence))
    (lazy slots (call (of List HistoryPartSlot) (in (call HistoryPartSlot each ([] sentence each)) (..< 0 (. sentence length)))))
  )
)

(fn-expr _ history-part-choices (list String)
  (param part (? CommandSentencePart))
  (match part
    (case (call .input parameter)
      (. parameter options)
    )
    (default
      (call (of List String))
    )
  )
)

(fn-expr _ history-part-text String
  (param part (? CommandSentencePart))
  (case? (not part)
    ""
  )
  (default
    (match part
      (case (call .text value)
        value
      )
      (case (call .number parameter)
        (str (call (. parameter display-value places) 2) (. parameter unit suffix))
      )
      (case (call .point parameter)
        (str "(" (call (. (as (. parameter value x) F64) places) 2) ", " (call (. (as (. parameter value y) F64) places) 2) ")")
      )
      (case (call .input parameter)
        (. parameter value)
      )
      (case (call .color parameter)
        (. parameter value)
      )
      (case (call .reference parameter)
        (. parameter text)
      )
      (case (call .definition parameter)
        (. parameter value)
      )
      (case (call .value parameter)
        (. parameter text)
      )
    )
  )
)
