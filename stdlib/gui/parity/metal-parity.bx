(import ./support)
(import /core/markup)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/outline)
(import /graphics/primitives)
(import /graphics/vectorgeometry)
(import /gui/border)
(import /gui/box)
(import /gui/icons/lucide/activity)
(import /gui/layout)
(import /gui/metal)
(import /gui/painter)
(import /gui/primitives)
(import /gui/scene)
(import /gui/shape)
(import /math)
(import /test)
(import /units)
(blank)
(prop _ opacity-content-color _ (= (call RGBA "#38bdf8")))
(prop _ opacity-overlay-color _ (= (call RGBA "#fde047")))
(prop _ painter-active-color _ (= (call RGBA "#22c55e")))
(prop _ painter-inactive-color _ (= (call RGBA "#a855f7")))
(prop _ spiral-fill-color _ (= (call RGBA "#e6d980")))
(prop _ spiral-stroke-color _ (= (call RGBA "#333399")))
(blank)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "Rounded Metal Clip Parity"))
  (call (. cases run) rounded-metal-tests)
  (= cases (call (. cases then) "Retained Opacity Group Parity" retained-opacity-tests))
  (= cases (call (. cases then) "GUI Retained Painter Parity" retained-painter-tests))
  (= cases (call (. cases then) "Display Scene Metal Mixed Tiles" scene-metal-mixed-tests))
  (= cases (call (. cases then) "Display Scene Metal Stroke Vector Atlas" scene-metal-stroke-vector-tests))
  (= cases (call (. cases then) "Display Scene Metal Image Atlas" scene-metal-image-tests))
  (= cases (call (. cases then) "Offset Scene Metal Parity" offset-scene-tests))
  (return cases)
)

(fn-do + rounded-metal-tests _
  (param t TestCase)
  (let scales (list F64) (list 1 1.5 2))
  (for (in scale scales)
    (call check-rounded-metal t scale)
  )
  (return t)
)

(fn-do + check-rounded-metal _
  (param t TestCase)
  (param scale F64)
  (let root (call RoundedSceneRoot))
  (let outer (call RoundedSceneBox))
  (let inner (call RoundedSceneBox))
  (let fill (call RoundedSceneBox))
  (= (. outer radius) 22)
  (= (. outer inset) 3)
  (= (. inner radius) 18)
  (= (. inner inset) 1)
  (= (. inner fill) (call RGBA (/ 204 255.0) (/ 102 255.0) (/ 51 255.0) (/ 128 255.0)))
  (= (. fill fill) (call RGBA (/ 51 255.0) (/ 204 255.0) (/ 102 255.0) (/ 170 255.0)))
  (= (. fill radius) 0)
  (call markup-append root outer)
  (call markup-append outer inner)
  (call markup-append inner fill)
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (call (. root arrange-bounds) (call Rect 0 0 120 90))
  (call (. outer arrange-bounds) (call Rect 8 8 92 68))
  (call (. inner arrange-bounds) (call Rect 18 16 80 56))
  (call (. fill arrange-bounds) (call Rect 0 0 120 90))
  (let immediate (call RasterCanvas 120 90 scale))
  (let retained (call RasterCanvas 120 90 scale))
  (let renderer (call MetalOffscreenRenderer 120 90 scale))
  (let scene (call DisplayScene scale))
  (do-use scene
    (do-use immediate
      (do-use retained
        (do-use renderer
          (call (. scene build) root)
          (call (. scene commit))
          (call (. root paint) immediate)
          (call (. t check) "Metal produces a frame" (call (. scene frame-metal) renderer))
          (call (. scene add-damage) (. root bounds))
          (call (. scene frame) retained)
          (call (. t expect)
            (block
              (arg (str "nested rounded CoreGraphics clips match at " scale))
              (arg 0u64)
              (arg (call (. retained pixel-difference-count) immediate))
            )
          )
          (let diff (call (. renderer diff) immediate 2))
          (call (. t check)
            (block
              (arg (str "nested rounded Metal clips differ only along curves at " scale))
              (arg (<= (. diff differing-ratio) 0.02))
            )
          )
          (call (. t check)
            (block
              (arg (str "nested rounded Metal coverage stays close at " scale))
              (arg (<= (. diff total-delta) (. diff pixel-count)))
            )
          )
          (call (. t expect) "rounded Metal clips encode every operation" 0 (. renderer skipped-ops))
          (= (. outer fill) (call RGBA "#3366cc"))
          (= (. inner fill) (call RGBA "#cc6633"))
          (= (. fill fill) (call RGBA "#33cc66"))
          (= (. outer radius) 0)
          (= (. inner radius) 0)
          (call (. root markup-batch-queue checkpoint))
          (call (. scene update) root)
          (call (. scene commit))
          (call (. t check) "Metal produces a frame" (call (. scene frame-metal) renderer))
          (call (. immediate erase) null)
          (call (. root paint) immediate)
          (call (. t check)
            (block
              (arg (str "Metal radius reset stays within fractional-edge coverage at " scale))
              (arg (<= (. (call (. renderer diff) immediate) maximum-channel-delta) 128))
            )
          )
        )
      )
    )
  )
  (call (. root close))
  (call markup-release root)
)

(fn-do + retained-opacity-tests _
  (param t TestCase)
  (let scales (list F64) (list 1 1.5 2))
  (for (in scale scales)
    (call check-retained-opacity t scale)
  )
  (return t)
)

(fn-do + check-retained-opacity _
  (param t TestCase)
  (param scale F64)
  (let root (call OpacitySceneRoot))
  (let outer (call OpacitySceneOverlayBox))
  (let inner (call OpacitySceneBox))
  (let overflow (call OpacitySceneBox))
  (let overlap (call OpacitySceneBox))
  (= (. outer alpha) 0.65%%)
  (= (. outer fill) (call RGBA "#d946ef"))
  (= (. inner alpha) 0.5%%)
  (= (. inner fill) (call RGBA "#2563eb"))
  (= (. overflow fill) (call RGBA "#f97316"))
  (= (. overlap fill) (call RGBA "#22c55e"))
  (call markup-append root outer)
  (call markup-append outer inner)
  (call markup-append inner overflow)
  (call markup-append inner overlap)
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (call (. root arrange-bounds) (call Rect 0 0 120 90))
  (call (. outer arrange-bounds) (call Rect 10 10 70 55))
  (call (. inner arrange-bounds) (call Rect 20 18 50 38))
  (call (. overflow arrange-bounds) (call Rect 62 20 36 24))
  (call (. overlap arrange-bounds) (call Rect 50 28 34 24))
  (blank)
  (let immediate (call RasterCanvas 120 90 scale))
  (let retained (call RasterCanvas 120 90 scale))
  (let renderer (call MetalOffscreenRenderer 120 90 scale))
  (let scene (call DisplayScene scale))
  (do-use scene
    (do-use immediate
      (do-use retained
        (do-use renderer
          (call (. scene build) root)
          (call (. t check)
            (block
              (arg (str "partial opacity groups the outer box at " scale))
              (arg (!= (call (. scene layer-group-for) outer) null))
            )
          )
          (call (. t check)
            (block
              (arg (str "partial opacity groups the inner box at " scale))
              (arg (!= (call (. scene layer-group-for) inner) null))
            )
          )
          (call check-opacity-frame t root scene immediate retained renderer (str "nested " scale))
          (blank)
          (= (. inner alpha) 0.25%%)
          (call (. root markup-batch-queue checkpoint))
          (call (. scene update) root)
          (call check-opacity-frame
            (block
              (arg t)
              (arg root)
              (arg scene)
              (arg immediate)
              (arg retained)
              (arg renderer)
              (arg (str "nested update " scale))
            )
          )
          (blank)
          (= (. inner alpha) 1%%)
          (call (. root markup-batch-queue checkpoint))
          (call (. scene update) root)
          (call check-opacity-frame
            (block
              (arg t)
              (arg root)
              (arg scene)
              (arg immediate)
              (arg retained)
              (arg renderer)
              (arg (str "child direct path " scale))
            )
          )
          (blank)
          (= (. outer alpha) 1%%)
          (call (. root markup-batch-queue checkpoint))
          (call (. scene update) root)
          (call (. t check)
            (block
              (arg (str "100% removes the outer opacity group at " scale))
              (arg (== (call (. scene layer-group-for) outer) null))
            )
          )
          (call (. t check)
            (block
              (arg (str "100% removes the inner opacity group at " scale))
              (arg (== (call (. scene layer-group-for) inner) null))
            )
          )
          (call check-opacity-frame
            (block
              (arg t)
              (arg root)
              (arg scene)
              (arg immediate)
              (arg retained)
              (arg renderer)
              (arg (str "all direct " scale))
            )
          )
          (blank)
          (= (. outer alpha) 0%%)
          (call (. root markup-batch-queue checkpoint))
          (call (. scene update) root)
          (call check-opacity-frame t root scene immediate retained renderer (str "zero " scale))
          (call (. t expect)
            (block
              (arg (str "zero opacity clears all retained ink at " scale))
              (arg 0u64)
              (arg (call (. retained nontransparent-pixel-count) (call Rect 0 0 120 90)))
            )
          )
          (blank)
          (= (. outer alpha) 0.6%%)
          (call (. root markup-batch-queue checkpoint))
          (call (. scene update) root)
          (call check-opacity-frame
            (block
              (arg t)
              (arg root)
              (arg scene)
              (arg immediate)
              (arg retained)
              (arg renderer)
              (arg (str "restored " scale))
            )
          )
          (blank)
          (= (. inner is-clipped) true)
          (call (. root markup-batch-queue checkpoint))
          (call (. scene update) root)
          (call check-opacity-frame t root scene immediate retained renderer (str "clipped " scale))
          (blank)
          (= (. inner is-clipped) false)
          (call (. root markup-batch-queue checkpoint))
          (call (. scene update) root)
          (call check-opacity-frame
            (block
              (arg t)
              (arg root)
              (arg scene)
              (arg immediate)
              (arg retained)
              (arg renderer)
              (arg (str "unclipped " scale))
            )
          )
          (blank)
          (call (. overflow arrange-bounds) (call Rect 4 58 36 24))
          (call (. scene update) root)
          (call check-opacity-frame
            (block
              (arg t)
              (arg root)
              (arg scene)
              (arg immediate)
              (arg retained)
              (arg renderer)
              (arg (str "overflow move " scale))
            )
          )
          (call (. t expect)
            (block
              (arg (str "moving overflow damages and clears its old visible extent at " scale))
              (arg 0u64)
              (arg (call (. retained nontransparent-pixel-count) (call Rect 85 20 13 24)))
            )
          )
        )
      )
    )
  )
  (call (. root close))
  (call markup-release root)
)

(fn-do + check-opacity-frame _
  (param t TestCase)
  (param root OpacitySceneRoot)
  (param scene DisplayScene)
  (param immediate RasterCanvas)
  (param retained RasterCanvas)
  (param renderer MetalOffscreenRenderer)
  (param label String)
  (call (. scene commit))
  (call (. immediate erase) null)
  (call (. root paint) immediate)
  (let pending-damage (. scene damage))
  (call (. t check) (str "Metal produces the " label " frame") (call (. scene frame-metal) renderer))
  (call (. scene add-damage) pending-damage)
  (call (. scene frame) retained)
  (call (. t expect) (str "retained CoreGraphics matches " label) 0u64 (call (. retained pixel-difference-count) immediate))
  (let diff (call (. renderer diff) immediate 2))
  (call (. t check) (str "Metal coverage stays close for " label) (<= (. diff differing-ratio) 0.02))
  (call (. t expect) (str "Metal encodes every " label " operation") 0 (. renderer skipped-ops))
)

(fn-do + retained-painter-tests _
  (param t TestCase)
  (let scales (list F64) (list 1 1.5 2))
  (for (in scale scales)
    (call check-retained-painters t scale)
  )
  (return t)
)

(fn-do + check-retained-painters _
  (param t TestCase)
  (param scale F64)
  (let root (call PainterSceneRoot))
  (let background (call SceneBackgroundPainter))
  (let border (call SceneBorderPainter))
  (let next-background (call SceneBackgroundPainter))
  (let next-border (call SceneBorderPainter))
  (let box (call PainterSceneBox))
  (= (. box background-painter) background)
  (= (. box border-painter) border)
  (= (. next-background variant) true)
  (= (. next-border requested) (call Insets 2 7 5 1))
  (= (. box alternate-background-painter) next-background)
  (= (. box alternate-border-painter) next-border)
  (call markup-append root box)
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (call (. root arrange-bounds) (call Rect 0 0 100 72))
  (call (. box arrange-bounds) (call Rect 12 10 68 48))
  (blank)
  (let immediate (call RasterCanvas 100 72 scale))
  (let retained (call RasterCanvas 100 72 scale))
  (let renderer (call MetalOffscreenRenderer 100 72 scale))
  (let scene (call DisplayScene scale))
  (do-use scene
    (do-use immediate
      (do-use retained
        (do-use renderer
          (call (. scene build) root)
          (call (. t expect)
            (block
              (arg (str "retained recording calls background once at " scale))
              (arg 1)
              (arg (. background paint-count))
            )
          )
          (call (. t expect) (str "retained recording calls border once at " scale) 1 (. border paint-count))
          (call check-painter-frame t root scene immediate retained renderer (str "initial " scale))
          (blank)
          (= (. box alternate) true)
          (call (. root markup-batch-queue checkpoint))
          (call (. box arrange-bounds) (call Rect 12 10 68 48))
          (call (. scene update) root)
          (call check-painter-frame
            (block
              (arg t)
              (arg root)
              (arg scene)
              (arg immediate)
              (arg retained)
              (arg renderer)
              (arg (str "replacement " scale))
            )
          )
          (call (. t expect)
            (block
              (arg (str "replacement border updates layout before paint at " scale))
              (arg (call Insets 2 7 5 1))
              (arg (. box border-edges))
            )
          )
        )
      )
    )
  )
  (call (. root close))
  (call markup-release root)
)

(fn-do + check-painter-frame _
  (param t TestCase)
  (param root PainterSceneRoot)
  (param scene DisplayScene)
  (param immediate RasterCanvas)
  (param retained RasterCanvas)
  (param renderer MetalOffscreenRenderer)
  (param label String)
  (call (. scene commit))
  (call (. immediate erase) null)
  (call (. root paint) immediate)
  (let pending-damage (. scene damage))
  (call (. t check) (str "Metal produces the " label " painter frame") (call (. scene frame-metal) renderer))
  (call (. scene add-damage) pending-damage)
  (call (. scene frame) retained)
  (call (. t expect)
    (block
      (arg (str "retained CoreGraphics preserves " label " painter output"))
      (arg 0u64)
      (arg (call (. retained pixel-difference-count) immediate))
    )
  )
  (let diff (call (. renderer diff) immediate 2))
  (call (. t check) (str "Metal preserves " label " painter output") (<= (. diff differing-ratio) 0.02))
  (call (. t check) (str "Metal draws every " label " painter edge") (<= (. diff maximum-channel-delta) 16))
  (call (. t expect) (str "Metal retains every " label " painter operation") 0 (. renderer skipped-ops))
)

(fn-do + scene-metal-mixed-tests _
  (param t TestCase)
  (let root (call SceneParityRoot))
  (let panel (call SceneParityPanel))
  (let spiral (call SceneParitySpiral))
  (call markup-append root panel)
  (for (in index (..< 0 20))
    (call markup-append panel (call SceneParityCell))
  )
  (call markup-append root spiral)
  (call mount-scene-root root (call Rect 0 0 900 700))
  (let background (call RGBA "#fafaf5"))
  (let immediate (call RasterCanvas 900 700 2 background))
  (let renderer (call MetalOffscreenRenderer 900 700 2 background))
  (let scene (call DisplayScene 2 background))
  (do-use immediate
    (do-use renderer
      (call (. scene build) root)
      (call (. scene commit))
      (call (. root paint) immediate)
      (call (. scene frame-metal) renderer)
      (let diff (call (. renderer diff) immediate))
      (call (. t check)
        (block
          (arg "no-text mixed differing pixels stay within one percent")
          (arg (<= (. diff differing-ratio) 0.01))
        )
      )
      (call (. t expect) "mixed composition skips no supported ops" 0 (. renderer skipped-ops))
      (blank)
      (= (. spiral phase) 1)
      (call (. scene update) root)
      (call (. scene commit))
      (call (. immediate erase) background)
      (call (. root paint) immediate)
      (call (. scene frame-metal) renderer)
      (let mutation-diff (call (. renderer diff) immediate))
      (call (. t check)
        (block
          (arg "partial path tile pixels stay within one percent")
          (arg (<= (. mutation-diff differing-ratio) 0.01))
        )
      )
      (call (. t expect) "partial path tile skips no supported ops" 0 (. renderer skipped-ops))
    )
  )
  (call (. scene close))
  (call release-scene-root root)
  (return t)
)

(fn-do + scene-metal-stroke-vector-tests _
  (param t TestCase)
  (let root (call SceneMetalStrokeVectorRoot))
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (call (. root layout) (call Rect 0 0 120 80))
  (call (. root image layout) (call Rect 0 0 48 48))
  (let immediate (call RasterCanvas 120 80 2 white))
  (let renderer (call MetalOffscreenRenderer 120 80 2 white))
  (let scene (call DisplayScene 2 white renderer))
  (do-use immediate
    (do-use renderer
      (call (. scene build) root)
      (call (. scene commit))
      (call (. root paint) immediate)
      (call (. scene frame-metal) renderer)
      (let diff (call (. renderer diff) immediate))
      (call (. t check) "stroke vector pixels stay within one percent" (<= (. diff differing-ratio) 0.01))
      (call (. t check) "stroke vector total channel delta stays negligible" (<= (. diff total-delta) 512))
      (call (. t check) "stroke vector draws as GPU paths" (> (. renderer fill-draws) 0))
      (call (. t expect) "stroke vector frame skips no supported ops" 0 (. renderer skipped-ops))
      (call (. t expect) "stroke vector stays packed" 0 (. scene opaque-demotions))
      (call (. scene close))
    )
  )
  (call (. root close))
  (call markup-release root)
  (return t)
)

(fn-do + scene-metal-image-tests _
  (param t TestCase)
  (let root (call SceneParityRoot))
  (let image-box (call SceneMetalImageBox))
  (call markup-append root image-box)
  (call mount-scene-root root (call Rect 0 0 120 80))
  (call (. image-box layout) (call Rect 0 0 32 24))
  (let source (call RasterCanvas 16 12 2 transparent))
  (= (. source fill-color) (call RGBA "#dc2626"))
  (= (. source stroke-color) null)
  (call (. source rect) (call Rect 0 0 8 12))
  (= (. source fill-color) (call RGBA "#2563eb"))
  (call (. source rect) (call Rect 8 0 8 12))
  (let table (call vector-geometry-table-for root))
  (let handle (call (. table insert-image) (call ImageResource source 2)))
  (= (. image-box table) table)
  (= (. image-box handle) handle)
  (let immediate (call RasterCanvas 120 80 2 white))
  (let renderer (call MetalOffscreenRenderer 120 80 2 white))
  (let scene (call DisplayScene 2 white renderer))
  (do-use immediate
    (do-use renderer
      (call (. scene build) root)
      (call (. scene commit))
      (call (. root paint) immediate)
      (call (. scene frame-metal) renderer)
      (let diff (call (. renderer diff) immediate))
      (call (. t check) "RGBA image atlas pixels stay within one percent" (<= (. diff differing-ratio) 0.01))
      (call (. t expect) "image frame skips no supported ops" 0 (. renderer skipped-ops))
      (call (. t check) "image frame emits an instance" (> (. renderer instance-count) 0))
      (call (. t expect) "image resource stays packed" 0 (. scene opaque-demotions))
      (call (. t check)
        (block
          (arg "image atlas stays within 8 MiB")
          (arg (<= (. renderer image-atlas-bytes) (* 8 1024 1024)))
        )
      )
      (call (. scene close))
    )
  )
  (call (. table release-image) handle)
  (call release-scene-root root)
  (return t)
)

(fn-do + offset-scene-tests _
  (param t TestCase)
  (let root (call ShapeSceneRoot))
  (let box (call ShapeSceneBox))
  (= (. box shape-style) (call CalloutShape 9 (. Side top)))
  (= (. box drop-shadow) (call Shadow (call RGBA "#0f172a55") 12 0 5))
  (call markup-append root box)
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (call (. root arrange-bounds) (call Rect 0 0 400 300))
  (call (. box arrange-bounds) (call Rect 220 160 80 50))
  (let frame (call Rect 200 130 120 110))
  (let canvas (call RasterCanvas 120 110 2))
  (let renderer (call MetalOffscreenRenderer 120 110 2))
  (let canvas-scene (call DisplayScene 2))
  (let metal-scene (call DisplayScene 2 transparent renderer))
  (do-use metal-scene
    (= (. canvas-scene origin) (. frame top-left))
    (= (. metal-scene origin) (. frame top-left))
    (do-use canvas
      (do-use renderer
        (call (. canvas-scene build) box)
        (call (. canvas-scene commit))
        (call (. canvas-scene add-damage) frame)
        (call (. canvas-scene frame) canvas)
        (call (. metal-scene build) box)
        (call (. metal-scene commit))
        (call (. metal-scene add-damage) frame)
        (call (. t check) "an offset scene encodes a Metal frame" (call (. metal-scene frame-metal) renderer))
        (call (. t check)
          (block
            (arg "the offset box lands at its local position")
            (arg (== (call (. canvas nontransparent-pixel-count) (call Rect 30 40 60 30)) (* 60 30 4)))
          )
        )
        (call (. t check)
          (block
            (arg "the offset arrow lands above the box")
            (arg (> (call (. canvas nontransparent-pixel-count) (call Rect 58 24 4 4)) 0))
          )
        )
        (let diff (call (. renderer diff) canvas 2))
        (call (. t check) "offset Metal output tracks CoreGraphics" (<= (. diff total-delta) (. diff pixel-count)))
        (call (. t check) "offset Metal output covers the arrow" (<= (. diff differing-ratio) 0.08))
      )
    )
    (call (. canvas-scene close))
  )
  (call (. root close))
  (call markup-release root)
  (return t)
)

(type + RoundedSceneRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(type + RoundedSceneBox (is Box)
  (prop + radius Length (= 12))
  (prop + inset Length (= 0))
  (prop + fill RGBA (= (call RGBA (/ 51 255.0) (/ 102 255.0) (/ 204 255.0) (/ 128 255.0))))
  (blank)
  (rule This
    (= corner-radius #radius)
    (= padding-left #inset)
    (= padding-top (* #inset 2))
    (= padding-right (* #inset 3))
    (= padding-bottom #inset)
    (= background-color #fill)
    (= overflow-x (. ScrollOverflow clip))
    (= overflow-y (. ScrollOverflow clip))
  )
)

(type + OpacitySceneRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(type + OpacitySceneBox (is Box)
  (prop + alpha Ratio (= 1%%))
  (prop + fill RGBA (= transparent))
  (prop + is-clipped _ (= false))
  (blank)
  (rule This
    (= opacity #alpha)
    (= background-color #fill)
    (= border-color (call RGBA "#111827"))
    (= border-width 1)
    (when-style #is-clipped
      (= overflow-x (. ScrollOverflow clip))
      (= overflow-y (. ScrollOverflow clip))
    )
  )
)

(type + OpacitySceneOverlayBox (is OpacitySceneBox)
  (fn-do + paint-self _
    (param canvas Canvas)
    (= (. canvas fill-color) opacity-content-color)
    (= (. canvas stroke-color) null)
    (call (. canvas rect) (call Rect (+ (. bounds x) 7) (+ (. bounds y) 5) 28 22))
  )
  (fn-do + paint-overlay _
    (param canvas Canvas)
    (= (. canvas fill-color) opacity-overlay-color)
    (= (. canvas stroke-color) null)
    (call (. canvas rect) (call Rect (+ (. bounds x) 30) (+ (. bounds y) 20) 26 20))
  )
)

(type + PainterSceneRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(type + PainterSceneBox (is Box)
  (prop + background-painter (? SceneBackgroundPainter))
  (prop + border-painter BorderPainter (= (call DefaultBorderPainter)))
  (prop + alternate-background-painter (? SceneBackgroundPainter))
  (prop + alternate-border-painter BorderPainter (= (call DefaultBorderPainter)))
  (prop + alternate _ (= false))
  (blank)
  (rule This
    (= background #background-painter)
    (= border #border-painter)
    (= background-color (call RGBA "#3b82f6"))
    (= border-color (call RGBA "#f97316"))
    (= border-width 3)
    (= corner-radius 9)
    (when-style #alternate
      (= background #alternate-background-painter)
      (= border #alternate-border-painter)
    )
  )
)

(type + SceneBackgroundPainter (is Painter)
  (prop + paint-count Size)
  (prop + variant _ (= false))
  (fn-do + paint _
    (param node Box)
    (param rect Rect)
    (param canvas Canvas)
    (+= paint-count 1)
    (= (. canvas fill-color) (. node $background-color))
    (= (. canvas stroke-color) null)
    (call (. canvas oval) rect)
    (= (. canvas fill-color) (if-expr variant painter-active-color painter-inactive-color))
    (call (. canvas rect) (call Rect (+ (. rect x) 10) (+ (. rect y) 8) (- (. rect width) 20) (- (. rect height) 16)))
  )
)

(type + SceneBorderPainter (is BorderPainter)
  (prop + requested Insets (= (call Insets 4 2 6 5)))
  (prop + paint-count Size)
  (fn-expr + border-insets _
    (param node Box)
    requested
  )
  (fn-do + paint _
    (param node Box)
    (param rect Rect)
    (param canvas Canvas)
    (+= paint-count 1)
    (let edges (. node border-edges))
    (= (. canvas fill-color) (. node $border-color))
    (= (. canvas stroke-color) null)
    (call (. canvas rect) (call Rect (. rect x) (. rect y) (. rect width) (. edges top)))
    (call (. canvas rect) (call Rect (- (. rect right) (. edges right)) (. rect y) (. edges right) (. rect height)))
    (call (. canvas rect) (call Rect (. rect x) (- (. rect bottom) (. edges bottom)) (. rect width) (. edges bottom)))
    (call (. canvas rect) (call Rect (. rect x) (. rect y) (. edges left) (. rect height)))
  )
)

(type + SceneParityPanel (is Box)
  (rule This (• bg "#fff4e6")
    (= layout flow-col)
    (= overflow-y (. ScrollOverflow clip))
    (= min-height (call (. SizeSpec coord) 240))
    (= max-height (call (. SizeSpec coord) 240))
    (= border-width 2px)
    (= border-color "#886633")
  )
)

(type + SceneParitySpiral (is Box)
  (prop + phase Size)
  (blank)
  (depends invalidate-paint phase)
  (blank)
  (rule This
    (= min-width (call (. SizeSpec coord) 200))
    (= max-width (call (. SizeSpec coord) 200))
    (= min-height (call (. SizeSpec coord) 120))
    (= max-height (call (. SizeSpec coord) 120))
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (call (. canvas push))
    (= (. canvas fill-color) spiral-fill-color)
    (= (. canvas stroke-color) null)
    (call (. canvas circle) (. bounds center x) (. bounds center y) 50)
    (= (. canvas fill-color) null)
    (= (. canvas stroke-color) spiral-stroke-color)
    (= (. canvas stroke-width) 2)
    (call (. canvas begin))
    (call (. canvas move) (. bounds center x) (. bounds center y))
    (let angle (* (as phase F64) 0.1))
    (let radius F64 2)
    (while (< radius 48)
      (call (. canvas line)
        (block
          (arg (+ (. bounds center x) (* radius (call cos angle))))
          (arg (+ (. bounds center y) (* radius (call sin angle))))
        )
      )
      (+= angle 0.5)
      (+= radius 1.2)
    )
    (call (. canvas end))
    (call (. canvas pop))
  )
)

(type + SceneMetalStrokeVectorRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue (as this MarkupRootElement))))
  (content
    (<> This
      (<> LucideActivity (id: image) (• w 48) (• h 48)
        (= stroke "#2563eb")
      )
    )
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
    (let ignored (. flush applied))
  )
)

(type + SceneMetalImageBox (is Box)
  (prop + table (? VectorGeometryTable))
  (prop + handle _ (= (call ImageHandle 0 0)))
  (blank)
  (rule This
    (= min-width (call (. SizeSpec coord) 32))
    (= max-width (call (. SizeSpec coord) 32))
    (= min-height (call (. SizeSpec coord) 24))
    (= max-height (call (. SizeSpec coord) 24))
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (return-if (if (not table)))
    (let ignored (call (. table paint-image-resource) handle canvas bounds))
  )
)
