(import ./support)
(import /core/markup)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/matrix)
(import /graphics/outline)
(import /graphics/path)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/text)
(import /graphics/vectorgeometry)
(import /gui/box)
(import /gui/layout)
(import /gui/metal)
(import /gui/primitives)
(import /gui/scene)
(import /math)
(import /test)
(blank)
(prop _ raster-parity-width I32 (= 768))
(prop _ raster-parity-height I32 (= 512))
(prop _ raster-parity-bounds _ (= (call Rect (call Dimensions 768 512))))
(prop _ raster-parity-scale F64 (= 2))
(prop _ raster-parity-frames Size (= 8))
(prop _ raster-parity-second U64 (= 1000000000))
(prop _ raster-parity-words _ (= (list "Lorem" "ipsum" "dolor" "sit" "amet," "consectetur" "adipiscing" "elit," "sed" "do" "eiusmod" "tempor")))

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "GUI Raster Tile Parity"))
  (call (. cases run) whole-pixel-tests)
  (call (. cases run) fractional-pixel-tests)
  (call (. cases run) exact-landing-tests)
  (call (. cases run) between-levels-tests)
  (call (. cases run) settled-tests)
  (call (. cases run) tile-text-tests)
  (return cases)
)

(fn-do + whole-pixel-tests _
  (param t TestCase)
  (let offset (call Point -37 -23.5))
  (let found (call compare-raster-field offset offset))
  (call (. t check) "a whole-pixel offset draws the field from raster tiles" (. found is-tiled))
  (call (. t check) "tiles at a whole-pixel offset match direct drawing within one 8-bit step" (<= (. found diff maximum-channel-delta) 1))
)

(fn-do + fractional-pixel-tests _
  (param t TestCase)
  (let offset (call Point -37.3 -23.7))
  (let rounded (call Point (/ (call round (* (. offset x) raster-parity-scale)) raster-parity-scale) (/ (call round (* (. offset y) raster-parity-scale)) raster-parity-scale)))
  (let found (call compare-raster-field offset rounded))
  (call (. t check) "a fractional offset draws the field from raster tiles" (. found is-tiled))
  (call (. t check) "tiles at a fractional offset match direct drawing at the rounded offset within one 8-bit step" (<= (. found diff maximum-channel-delta) 1))
)

(fn-do + exact-landing-tests _
  (param t TestCase)
  (let offset (call Point -11.5 -7))
  (let found (call compare-raster-field offset offset 0.5))
  (call (. t check) "a power-of-two zoom draws the field from raster tiles" (. found is-tiled))
  (call (. t check) "tiles at a power-of-two zoom match direct drawing within one 8-bit step" (<= (. found diff maximum-channel-delta) 1))
)

(fn-do + between-levels-tests _
  (param t TestCase)
  (let offset (call Point -11.5 -7))
  (let found (call compare-raster-field offset offset 0.6))
  (call (. t check) "a zoom between levels draws the field from raster tiles" (. found is-tiled))
  (call (. t check) "tiles between levels stay close to direct drawing" (< (. found diff total-delta) (* (. found diff pixel-count) 8)))
)

(fn-do + settled-tests _
  (param t TestCase)
  (let offset (call Point -11.5 -7))
  (let found (call compare-raster-field offset offset 0.6 true))
  (call (. t check) "a settled zoom between levels draws the field from raster tiles" (. found is-tiled))
  (call (. t check) "settled tiles match direct drawing within one 8-bit step" (<= (. found diff maximum-channel-delta) 1))
)

(fn-do + tile-text-tests _
  (param t TestCase)
  (let bounds raster-parity-bounds)
  (let root (call SceneParityRoot))
  (let field (call RasterParityField))
  (= (. field zoom) 0.75)
  (call markup-append root field)
  (call mount-scene-root root bounds)
  (let renderer (call MetalOffscreenRenderer raster-parity-width raster-parity-height raster-parity-scale white))
  (let scene (call DisplayScene raster-parity-scale white renderer))
  (= (. scene raster-tiled-items) 0)
  (do-use renderer
    (call (. scene build) root)
    (call (. scene commit))
    (for (in _ (..< 0 2))
      (call (. scene add-damage) bounds)
      (call (. scene frame-metal) renderer)
      (call (. renderer finish))
    )
    (call (. renderer take-fill-redraw))
    (call (. scene reset-frame-counters))
    (call (. scene add-damage) bounds)
    (call (. scene frame-metal) renderer)
    (call (. renderer finish))
    (call (. t check) "the field draws directly while its tiles fill" (> (. scene items-encoded) 0))
    (call (. t check) "a tile frame between window frames leaves glyph redraw off" (not (. renderer has-pending-fill-redraw)))
  )
  (call (. scene close))
  (call release-scene-root root)
)

(type _ RasterFieldComparison (is Tuple)
  (prop + is-tiled Bool)
  (prop + frames Size)
  (prop + diff MetalPixelDiff)
)

(fn-do _ compare-raster-field RasterFieldComparison
  (param tiled-offset Point)
  (param direct-offset Point)
  (param zoom F64 (= 1))
  (param settles Bool (= false))
  (let bounds raster-parity-bounds)
  (let tiled-root (call SceneParityRoot))
  (let tiled-field (call RasterParityField))
  (= (. tiled-field offset) tiled-offset)
  (= (. tiled-field zoom) zoom)
  (call markup-append tiled-root tiled-field)
  (call mount-scene-root tiled-root bounds)
  (let direct-root (call SceneParityRoot))
  (let direct-field (call RasterParityField))
  (= (. direct-field offset) direct-offset)
  (= (. direct-field zoom) zoom)
  (= (. direct-field caches) false)
  (call markup-append direct-root direct-field)
  (call mount-scene-root direct-root bounds)
  (let renderer (call MetalOffscreenRenderer raster-parity-width raster-parity-height raster-parity-scale white))
  (let reference (call MetalOffscreenRenderer raster-parity-width raster-parity-height raster-parity-scale white))
  (let pixels (call RasterCanvas raster-parity-width raster-parity-height raster-parity-scale white))
  (let scene (call DisplayScene raster-parity-scale white renderer))
  (= (. scene raster-tiled-items) 0)
  (let direct-scene (call DisplayScene raster-parity-scale white reference))
  (let frames Size 0)
  (let is-tiled false)
  (let diff (call MetalPixelDiff 0 0 0 0))
  (do-use renderer
    (do-use reference
      (do-use pixels
        (call (. scene build) tiled-root)
        (call (. scene commit))
        (while (and (not is-tiled) (< frames raster-parity-frames))
          (if settles
            (= (. scene frame-time) (* (as frames U64) raster-parity-second))
          )
          (call (. scene reset-frame-counters))
          (call (. scene damage-pending-textures))
          (call (. scene add-damage) bounds)
          (call (. scene frame-metal) renderer)
          (call (. renderer finish))
          (= is-tiled (and (== (. scene items-encoded) 0) (not (. scene has-pending-textures))))
          (+= frames 1)
        )
        (call (. renderer read-into) pixels)
        (call (. direct-scene build) direct-root)
        (call (. direct-scene commit))
        (call (. direct-scene add-damage) bounds)
        (call (. direct-scene frame-metal) reference)
        (call (. reference finish))
        (= diff (call (. reference diff) pixels))
      )
    )
  )
  (call (. scene close))
  (call (. direct-scene close))
  (call release-scene-root tiled-root)
  (call release-scene-root direct-root)
  (return (call RasterFieldComparison is-tiled frames diff))
)

(type + RasterParityField (is Box)
  (prop + offset _ (= (call Point 0 0)))
  (prop + zoom F64 (= 1))
  (prop + caches _ (= true))
  (prop _ layouts (list TextLayout))
  (prop _ handles (list VectorGeometryHandle))
  (prop _ palettes (list (list RGBA)))
  (blank)
  (depends invalidate-content-transform offset zoom)
  (blank)
  (rule This
    (= caches-raster #caches)
    (= min-width (call (. SizeSpec coord) (. raster-parity-bounds width)))
    (= max-width (call (. SizeSpec coord) (. raster-parity-bounds width)))
    (= min-height (call (. SizeSpec coord) (. raster-parity-bounds height)))
    (= max-height (call (. SizeSpec coord) (. raster-parity-bounds height)))
  )
  (fn-expr + content-transform _ :get
    (call (. (call matrix-from-translation offset) scale) (call Dimensions zoom zoom))
  )
  (fn-do + paint-self _
    (param canvas Canvas)
    (let table (call vector-geometry-table-for markup-batch-root))
    (if (not layouts)
      (for (in line (..< 0 8))
        (let words (list String))
        (for (in word (..< 0 4))
          (+= words ([] raster-parity-words (% (+ (* line 3) (* word 5)) (. raster-parity-words length))))
        )
        (+= layouts (call TextLayout (call (. " " join) words) (call Font "Helvetica" 11) 200))
      )
      (+= handles (call (. table intern-geometry) (as 820001 U64) (=> () (call raster-parity-geometry 8))))
      (+= handles (call (. table intern-geometry) (as 820002 U64) (=> () (call raster-parity-geometry 24))))
      (for (in tone (..< 0 8))
        (let hue (/ (as tone F64) 8))
        (+= palettes (list (call RGBA (+ 0.2 (* hue 0.7)) 0.45 (- 0.9 (* hue 0.6)) 1)))
      )
    )
    (= (. canvas stroke-color) null)
    (= (. canvas fill-color) (call RGBA 0.93 0.94 0.96 1))
    (call (. canvas rect) (call Rect 0 0 1120 780))
    (= (. canvas text-color) (call RGBA 0.1 0.1 0.15 1))
    (for (in card (..< 0 30))
      (let x (+ 20 (* (as (% card 6) F64) 182.25)))
      (let y (+ 20 (* (as (/ card 6) F64) 151.5)))
      (= (. canvas fill-color) (call RGBA 1 1 1 1))
      (call (. canvas outline) (call Outline (call Rect x y 164 132) 9))
      (let icon (call (. table paint-vector) ([] handles 0) canvas ([] palettes (% card 8)) (call (. (call matrix-from-translation (call Point (+ x 10) (+ y 10))) scale) (call Dimensions 0.2 0.2))))
      (for (in row (..< 0 4))
        (call (. canvas draw-text) ([] layouts (% (+ row card) 8)) (call Rect (+ x 36) (+ y 12 (* (as row F64) 18)) 120 15))
      )
      (= (. canvas fill-color) (call RGBA 0.3 0.35 0.5 1))
      (call (. canvas rect) (call Rect (+ x 12) (+ y 96.25) 140 0.5))
      (let badge (call (. table paint-vector) ([] handles 1) canvas ([] palettes (% (+ card 3) 8)) (call (. (call matrix-from-translation (call Point (+ x 120.3) (+ y 102.7))) scale) (call Dimensions 0.16 0.16))))
    )
  )
)

(fn-do _ raster-parity-geometry VectorGeometry
  (param segments Int)
  (let outline (call Path))
  (let center (call Point 50 50))
  (let step (/ (* 2 π) (as segments F64)))
  (for (in index (..< 0 segments))
    (let start (* (as index F64) step))
    (let head (+ center (call Point (* (call cos start) 46) (* (call sin start) 46))))
    (let tail (+ center (call Point (* (call cos (+ start step)) 46) (* (call sin (+ start step)) 46))))
    (let bulge (* 46 (+ 1 (* 0.3 (/ 3 (as (+ segments 3) F64))))))
    (if (== index 0)
      (call (. outline move-to) head)
    )
    (call (. outline cubic-curve-to)
      (block
        (arg (+ center (call Point (* (call cos (+ start (/ step 3))) bulge) (* (call sin (+ start (/ step 3))) bulge))))
        (arg (+ center (call Point (* (call cos (+ start (/ (* step 2) 3))) bulge) (* (call sin (+ start (/ (* step 2) 3))) bulge))))
        (arg tail)
      )
    )
  )
  (call (. outline close))
  (let none (call VectorGeometryPaint (. VectorGeometryPaintRole none) 0))
  (let color (call VectorGeometryPaint (. VectorGeometryPaintRole color) 0))
  (return (call VectorGeometry (call Rect 0 0 100 100) (call Rect -10 -10 120 120) (list (call VectorGeometrySpan outline color none null null null (. FillRule nonzero))) false false))
)
