━━━━━━━━━━━━━━━━━━━━
+ do check-scene-paint
    - t TestCase
    - root Box
    - scene DisplayScene
    - retained RasterCanvas
    - immediate RasterCanvas
    - label String

scene.update(root)
scene.commit()
scene.frame(retained)
immediate.erase(white)
root.paint(immediate)
t.expect("$label matches immediate paint", 0u64, retained.pixel-difference-count(immediate))
t.check("$label leaves no box invalid", scene-paint-is-settled(root))

━━━━━━━━━━━━━━━━━━━━
_ do scene-paint-is-settled Bool
    - box Box

=? false if box.is-retained-paint-invalid || box.is-retained-paint-invalid-below
= all(box.rendered-children) • where scene-paint-is-settled(each)

━━━━━━━━━━━━━━━━━━━━
_ scene-relink-color
    - key I64

RGBA(0.1 + ((key % 4) as F64) * 0.2, 0.3, 0.9 - ((key % 3) as F64) * 0.25, 1)

