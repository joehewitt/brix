canvas.circle(bounds.center.x, bounds.center.y, 50)
canvas.fill-color = null
canvas.stroke-color = spiral-stroke-color
canvas.stroke-width = 2
canvas.begin()
canvas.move(bounds.center.x, bounds.center.y)
. angle = (phase as F64) * 0.1
. radius F64 = 2
while radius < 48
    canvas.line
        - bounds.center.x + radius * cos(angle)
        - bounds.center.y + radius * sin(angle)
    angle += 0.5
    radius += 1.2
canvas.end()
canvas.pop()

