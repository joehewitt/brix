immediate.erase(null)
root.paint(immediate)
. pending-damage = scene.damage
t.check("Metal produces the $label frame", scene.frame-metal(renderer))
scene.add-damage(pending-damage)
scene.frame(retained)
t.expect("retained CoreGraphics matches $label", 0u64, retained.pixel-difference-count(immediate))
. diff = renderer.diff(immediate, 2)
