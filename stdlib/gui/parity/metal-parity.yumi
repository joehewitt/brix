━━━━━━━━━━━━━━━━━━━━
+ do check-retained-opacity
    - t TestCase
    - scale F64

. root = OpacitySceneRoot()
. outer = OpacitySceneOverlayBox()
. inner = OpacitySceneBox()
. overflow = OpacitySceneBox()
. overlap = OpacitySceneBox()
outer.alpha = 0.65%%
outer.fill = RGBA("#d946ef")
inner.alpha = 0.5%%
inner.fill = RGBA("#2563eb")
overflow.fill = RGBA("#f97316")
overlap.fill = RGBA("#22c55e")
markup-append(root, outer)
markup-append(outer, inner)
markup-append(inner, overflow)
markup-append(inner, overlap)
markup-mount-root(root, root)
root.markup-batch-queue.checkpoint()
root.arrange-bounds(Rect(0, 0, 120, 90))
outer.arrange-bounds(Rect(10, 10, 70, 55))
inner.arrange-bounds(Rect(20, 18, 50, 38))
overflow.arrange-bounds(Rect(62, 20, 36, 24))
overlap.arrange-bounds(Rect(50, 28, 34, 24))

. immediate = RasterCanvas(120, 90, scale)
. retained = RasterCanvas(120, 90, scale)
. renderer = MetalOffscreenRenderer(120, 90, scale)
. scene = DisplayScene(scale)
do use scene
    do use immediate
        do use retained
            do use renderer
                scene.build(root)
                t.check
                    - "partial opacity groups the outer box at $scale"
                    - scene.layer-group-for(outer) != null
                t.check
                    - "partial opacity groups the inner box at $scale"
                    - scene.layer-group-for(inner) != null
                check-opacity-frame(t, root, scene, immediate, retained, renderer, "nested $scale")

                inner.alpha = 0.25%%
                root.markup-batch-queue.checkpoint()
                scene.update(root)
                check-opacity-frame
                    - t
                    - root
                    - scene
                    - immediate
                    - retained
                    - renderer
                    - "nested update $scale"

                inner.alpha = 1%%
                root.markup-batch-queue.checkpoint()
                scene.update(root)
                check-opacity-frame
                    - t
                    - root
                    - scene
                    - immediate
                    - retained
                    - renderer
                    - "child direct path $scale"

                outer.alpha = 1%%
                root.markup-batch-queue.checkpoint()
                scene.update(root)
                t.check
                    - "100% removes the outer opacity group at $scale"
                    - scene.layer-group-for(outer) == null
                t.check
                    - "100% removes the inner opacity group at $scale"
                    - scene.layer-group-for(inner) == null
                check-opacity-frame
                    - t
                    - root
                    - scene
                    - immediate
                    - retained
                    - renderer
                    - "all direct $scale"

                outer.alpha = 0%%
                root.markup-batch-queue.checkpoint()
                scene.update(root)
                check-opacity-frame(t, root, scene, immediate, retained, renderer, "zero $scale")
                t.expect
                    - "zero opacity clears all retained ink at $scale"
                    - 0u64
                    - retained.nontransparent-pixel-count(Rect(0, 0, 120, 90))

                outer.alpha = 0.6%%
                root.markup-batch-queue.checkpoint()
                scene.update(root)
                check-opacity-frame
                    - t
                    - root
                    - scene
                    - immediate
                    - retained
                    - renderer
                    - "restored $scale"

                inner.is-clipped = true
                root.markup-batch-queue.checkpoint()
                scene.update(root)
                check-opacity-frame(t, root, scene, immediate, retained, renderer, "clipped $scale")

                inner.is-clipped = false
                root.markup-batch-queue.checkpoint()
                scene.update(root)
                check-opacity-frame
                    - t
                    - root
                    - scene
                    - immediate
                    - retained
                    - renderer
                    - "unclipped $scale"

                overflow.arrange-bounds(Rect(4, 58, 36, 24))
                scene.update(root)
                check-opacity-frame
                    - t
                    - root
                    - scene
                    - immediate
                    - retained
                    - renderer
                    - "overflow move $scale"
                t.expect
                    - "moving overflow damages and clears its old visible extent at $scale"
                    - 0u64
                    - retained.nontransparent-pixel-count(Rect(85, 20, 13, 24))
root.close()
markup-release(root)

