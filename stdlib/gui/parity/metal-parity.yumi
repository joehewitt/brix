━━━━━━━━━━━━━━━━━━━━
+ do check-retained-painters
    - t TestCase
    - scale F64

. root = PainterSceneRoot()
. background = SceneBackgroundPainter()
. border = SceneBorderPainter()
. next-background = SceneBackgroundPainter()
. next-border = SceneBorderPainter()
. box = PainterSceneBox()
box.background-painter = background
box.border-painter = border
next-background.variant = true
next-border.requested = Insets(2, 7, 5, 1)
box.alternate-background-painter = next-background
box.alternate-border-painter = next-border
markup-append(root, box)
markup-mount-root(root, root)
root.markup-batch-queue.checkpoint()
root.arrange-bounds(Rect(0, 0, 100, 72))
box.arrange-bounds(Rect(12, 10, 68, 48))

. immediate = RasterCanvas(100, 72, scale)
. retained = RasterCanvas(100, 72, scale)
. renderer = MetalOffscreenRenderer(100, 72, scale)
. scene = DisplayScene(scale)
do use scene
    do use immediate
        do use retained
            do use renderer
                scene.build(root)
                t.expect
                    - "retained recording calls background once at $scale"
                    - 1
                    - background.paint-count
                t.expect("retained recording calls border once at $scale", 1, border.paint-count)
                check-painter-frame(t, root, scene, immediate, retained, renderer, "initial $scale")

                box.alternate = true
                root.markup-batch-queue.checkpoint()
                box.arrange-bounds(Rect(12, 10, 68, 48))
                scene.update(root)
                check-painter-frame
                    - t
                    - root
                    - scene
                    - immediate
                    - retained
                    - renderer
                    - "replacement $scale"
                t.expect
                    - "replacement border updates layout before paint at $scale"
                    - Insets(2, 7, 5, 1)
                    - box.border-edges
root.close()
markup-release(root)

