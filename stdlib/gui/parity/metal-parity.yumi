━━━━━━━━━━━━━━━━━━━━
+ do scene-metal-mixed-tests
    - t TestCase

. root = SceneParityRoot()
. panel = SceneParityPanel()
. spiral = SceneParitySpiral()
markup-append(root, panel)
for index in 0 .. < 20
    markup-append(panel, SceneParityCell())
markup-append(root, spiral)
mount-scene-root(root, Rect(0, 0, 900, 700))
. background = RGBA("#fafaf5")
. immediate = RasterCanvas(900, 700, 2, background)
. renderer = MetalOffscreenRenderer(900, 700, 2, background)
. scene = DisplayScene(2, background)
do use immediate
    do use renderer
        scene.build(root)
        scene.commit()
        root.paint(immediate)
        scene.frame-metal(renderer)
        . diff = renderer.diff(immediate)
        t.check
            - "no-text mixed differing pixels stay within one percent"
            - diff.differing-ratio <= 0.01
        t.expect("mixed composition skips no supported ops", 0, renderer.skipped-ops)

        spiral.phase = 1
        scene.update(root)
        scene.commit()
        immediate.erase(background)
        root.paint(immediate)
        scene.frame-metal(renderer)
        . mutation-diff = renderer.diff(immediate)
        t.check
            - "partial path tile pixels stay within one percent"
            - mutation-diff.differing-ratio <= 0.01
        t.expect("partial path tile skips no supported ops", 0, renderer.skipped-ops)
scene.close()
release-scene-root(root)
= t

━━━━━━━━━━━━━━━━━━━━
+ do scene-metal-stroke-vector-tests
    - t TestCase

. root = SceneMetalStrokeVectorRoot()
markup-mount-root(root, root)
root.markup-batch-queue.checkpoint()
root.layout(Rect(0, 0, 120, 80))
root.image.layout(Rect(0, 0, 48, 48))
. immediate = RasterCanvas(120, 80, 2, white)
. renderer = MetalOffscreenRenderer(120, 80, 2, white)
. scene = DisplayScene(2, white, renderer)
do use immediate
    do use renderer
        scene.build(root)
        scene.commit()
        root.paint(immediate)
        scene.frame-metal(renderer)
        . diff = renderer.diff(immediate)
        t.check("stroke vector pixels stay within one percent", diff.differing-ratio <= 0.01)
        t.check("stroke vector total channel delta stays negligible", diff.total-delta <= 512)
        t.check("stroke vector draws as GPU paths", renderer.fill-draws > 0)
        t.expect("stroke vector frame skips no supported ops", 0, renderer.skipped-ops)
        t.expect("stroke vector stays packed", 0, scene.opaque-demotions)
        scene.close()
root.close()
markup-release(root)
= t

━━━━━━━━━━━━━━━━━━━━
+ do scene-metal-image-tests
    - t TestCase

. root = SceneParityRoot()
. image-box = SceneMetalImageBox()
markup-append(root, image-box)
mount-scene-root(root, Rect(0, 0, 120, 80))
image-box.layout(Rect(0, 0, 32, 24))
. source = RasterCanvas(16, 12, 2, transparent)
source.fill-color = RGBA("#dc2626")
source.stroke-color = null
source.rect(Rect(0, 0, 8, 12))
source.fill-color = RGBA("#2563eb")
source.rect(Rect(8, 0, 8, 12))
. table = vector-geometry-table-for(root)
. handle = table.insert-image(ImageResource(source, 2))
image-box.table = table
image-box.handle = handle
. immediate = RasterCanvas(120, 80, 2, white)
. renderer = MetalOffscreenRenderer(120, 80, 2, white)
. scene = DisplayScene(2, white, renderer)
do use immediate
    do use renderer
        scene.build(root)
        scene.commit()
        root.paint(immediate)
        scene.frame-metal(renderer)
        . diff = renderer.diff(immediate)
        t.check("RGBA image atlas pixels stay within one percent", diff.differing-ratio <= 0.01)
        t.expect("image frame skips no supported ops", 0, renderer.skipped-ops)
        t.check("image frame emits an instance", renderer.instance-count > 0)
        t.expect("image resource stays packed", 0, scene.opaque-demotions)
        t.check
            - "image atlas stays within 8 MiB"
            - renderer.image-atlas-bytes <= 8 * 1024 * 1024
        scene.close()
table.release-image(handle)
release-scene-root(root)
= t

━━━━━━━━━━━━━━━━━━━━
+ do offset-scene-tests
    - t TestCase

. root = ShapeSceneRoot()
. box = ShapeSceneBox()
box.shape-style = CalloutShape(9, Side.top)
box.drop-shadow = Shadow(RGBA("#0f172a55"), 12, 0, 5)
markup-append(root, box)
markup-mount-root(root, root)
root.markup-batch-queue.checkpoint()
root.arrange-bounds(Rect(0, 0, 400, 300))
box.arrange-bounds(Rect(220, 160, 80, 50))
. frame = Rect(200, 130, 120, 110)
. canvas = RasterCanvas(120, 110, 2)
. renderer = MetalOffscreenRenderer(120, 110, 2)
. canvas-scene = DisplayScene(2)
. metal-scene = DisplayScene(2, transparent, renderer)
do use metal-scene
    canvas-scene.origin = frame.top-left
    metal-scene.origin = frame.top-left
    do use canvas
        do use renderer
            canvas-scene.build(box)
            canvas-scene.commit()
            canvas-scene.add-damage(frame)
            canvas-scene.frame(canvas)
            metal-scene.build(box)
            metal-scene.commit()
            metal-scene.add-damage(frame)
            t.check("an offset scene encodes a Metal frame", metal-scene.frame-metal(renderer))
            t.check
                - "the offset box lands at its local position"
                - canvas.nontransparent-pixel-count(Rect(30, 40, 60, 30)) == 60 * 30 * 4
            t.check
                - "the offset arrow lands above the box"
                - canvas.nontransparent-pixel-count(Rect(58, 24, 4, 4)) > 0
            . diff = renderer.diff(canvas, 2)
            t.check("offset Metal output tracks CoreGraphics", diff.total-delta <= diff.pixel-count)
            t.check("offset Metal output covers the arrow", diff.differing-ratio <= 0.08)
    canvas-scene.close()
root.close()
markup-release(root)
= t

