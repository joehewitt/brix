━━━━━━━━━━━━━━━━━━━━
+ do tests TestRender

. cases = TestCase("Rounded Metal Clip Parity")
cases.run(rounded-metal-tests)
cases = cases.then("Retained Opacity Group Parity", retained-opacity-tests)
cases = cases.then("GUI Retained Painter Parity", retained-painter-tests)
cases = cases.then("Display Scene Metal Mixed Tiles", scene-metal-mixed-tests)
cases = cases.then("Display Scene Metal Stroke Vector Atlas", scene-metal-stroke-vector-tests)
cases = cases.then("Display Scene Metal Image Atlas", scene-metal-image-tests)
cases = cases.then("Offset Scene Metal Parity", offset-scene-tests)
= cases

━━━━━━━━━━━━━━━━━━━━
+ do rounded-metal-tests
    - t TestCase

. scales [F64] = [1, 1.5, 2]
for scale in scales
    check-rounded-metal(t, scale)
= t

━━━━━━━━━━━━━━━━━━━━
+ do check-rounded-metal
    - t TestCase
    - scale F64

. root = RoundedSceneRoot()
. outer = RoundedSceneBox()
. inner = RoundedSceneBox()
. fill = RoundedSceneBox()
outer.radius = 22
outer.inset = 3
inner.radius = 18
inner.inset = 1
inner.fill = RGBA(204 / 255.0, 102 / 255.0, 51 / 255.0, 128 / 255.0)
fill.fill = RGBA(51 / 255.0, 204 / 255.0, 102 / 255.0, 170 / 255.0)
fill.radius = 0
markup-append(root, outer)
markup-append(outer, inner)
markup-append(inner, fill)
markup-mount-root(root, root)
root.markup-batch-queue.checkpoint()
root.arrange-bounds(Rect(0, 0, 120, 90))
outer.arrange-bounds(Rect(8, 8, 92, 68))
inner.arrange-bounds(Rect(18, 16, 80, 56))
fill.arrange-bounds(Rect(0, 0, 120, 90))
. immediate = RasterCanvas(120, 90, scale)
. retained = RasterCanvas(120, 90, scale)
. renderer = MetalOffscreenRenderer(120, 90, scale)
. scene = DisplayScene(scale)
do use scene
    do use immediate
        do use retained
            do use renderer
                scene.build(root)
                scene.commit()
                root.paint(immediate)
                t.check("Metal produces a frame", scene.frame-metal(renderer))
                scene.add-damage(root.bounds)
                scene.frame(retained)
                t.expect
                    - "nested rounded CoreGraphics clips match at $scale"
                    - 0u64
                    - retained.pixel-difference-count(immediate)
                . diff = renderer.diff(immediate, 2)
                t.check
                    - "nested rounded Metal clips differ only along curves at $scale"
                    - diff.differing-ratio <= 0.02
                t.check
                    - "nested rounded Metal coverage stays close at $scale"
                    - diff.total-delta <= diff.pixel-count
                t.expect("rounded Metal clips encode every operation", 0, renderer.skipped-ops)
                outer.fill = RGBA("#3366cc")
                inner.fill = RGBA("#cc6633")
                fill.fill = RGBA("#33cc66")
                outer.radius = 0
                inner.radius = 0
                root.markup-batch-queue.checkpoint()
                scene.update(root)
                scene.commit()
                t.check("Metal produces a frame", scene.frame-metal(renderer))
                immediate.erase(null)
                root.paint(immediate)
                t.check
                    - "Metal radius reset stays within fractional-edge coverage at $scale"
                    - renderer.diff(immediate).maximum-channel-delta <= 128
root.close()
markup-release(root)

