(import ./support)
(import /core/markup)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/outline)
(import /graphics/point)
(import /graphics/primitives)
(import /gui/box)
(import /gui/popup)
(import /gui/primitives)
(import /gui/scene)
(import /stream/aggregate)
(import /test)
(import /units)
(blank)
(prop _ conditional-paint-color _ (= (call RGBA "#e04060")))
(prop _ popup-border-color _ (= (call RGBA "#f0d080")))
(blank)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "Display Scene Popup Layer Parity"))
  (call (. cases run) scene-popup-layer-tests)
  (= cases (call (. cases then) "Display Scene Configuration Parity" scene-configuration-tests))
  (= cases (call (. cases then) "Display Scene Empty Chunk Reappearance" scene-empty-chunk-reappearance-tests))
  (= cases (call (. cases then) "Shadow Damage" shadow-damage-tests))
  (= cases (call (. cases then) "Display Scene Repeated Invalidation" scene-repeated-invalidation-tests))
  (= cases (call (. cases then) "Display Scene Invalidation Around Layout" scene-layout-invalidation-tests))
  (= cases (call (. cases then) "Display Scene Moved Invalidation" scene-moved-invalidation-tests))
  (= cases (call (. cases then) "Display Scene Nested Scroll Invalidation" scene-nested-scroll-tests))
  (= cases (call (. cases then) "Display Scene Styled Invalidation" scene-styled-invalidation-tests))
  (= cases (call (. cases then) "Display Scene Equal Style Values" scene-equal-style-tests))
  (return cases)
)

(fn-do + scene-popup-layer-tests _
  (param t TestCase)
  (let root (call SceneParityRoot))
  (let content (call SceneParityModalContent))
  (let popup (call SceneParityPopup))
  (call markup-append root content)
  (call markup-append root popup)
  (call mount-scene-root root (call Rect 0 0 900 700))
  (call (. content arrange-bounds) (call Rect 220 160 120 80))
  (blank)
  (let immediate (call RasterCanvas 900 700 2 white))
  (let retained (call RasterCanvas 900 700 2 white))
  (let layer-immediate (call RasterCanvas 540 380 2 transparent))
  (let layer-retained (call RasterCanvas 540 380 2 transparent))
  (let scene (call DisplayScene 2 white))
  (let layer-scene (call DisplayScene 2 transparent))
  (do-use layer-scene
    (do-use immediate
      (do-use retained
        (do-use layer-immediate
          (do-use layer-retained
            (call (. scene build) root)
            (call (. scene commit))
            (call (. scene frame) retained)
            (call (. immediate erase) white)
            (call (. root paint) immediate)
            (blank)
            (call (. popup show))
            (call (. root markup-batch-queue checkpoint))
            (call (. popup arrange-bounds) (call Rect 180 120 540 380))
            (call (. scene update) root)
            (call (. scene commit))
            (call (. scene add-damage) (. root bounds))
            (call (. scene frame) retained)
            (call (. t expect)
              (block
                (arg "open layer stays out of the base scene")
                (arg 0u64)
                (arg (call (. retained pixel-difference-count) immediate))
              )
            )
            (call (. immediate erase) white)
            (call (. root paint) immediate)
            (call (. t expect)
              (block
                (arg "open layer base pixels")
                (arg 0u64)
                (arg (call (. retained pixel-difference-count) immediate))
              )
            )
            (blank)
            (= (. layer-scene origin) (. popup bounds top-left))
            (call (. layer-scene maintain) popup 2 transparent)
            (call (. layer-scene frame) layer-retained)
            (call (. layer-immediate push))
            (call (. layer-immediate translate) -180 -120)
            (call (. popup paint) layer-immediate)
            (call (. layer-immediate pop))
            (call (. t expect)
              (block
                (arg "layer scene pixels")
                (arg 0u64)
                (arg (call (. layer-retained pixel-difference-count) layer-immediate))
              )
            )
            (blank)
            (= (. content color) (call RGBA "#99cc66"))
            (call (. content invalidate-paint))
            (call (. scene update) root)
            (call (. scene commit))
            (call (. scene frame) retained)
            (call (. t expect)
              (block
                (arg "base mutation under layer damage")
                (arg (* 120 80 4))
                (arg (. scene last-damaged-pixels))
              )
            )
            (call (. immediate erase) white)
            (call (. root paint) immediate)
            (call (. t expect)
              (block
                (arg "mutation under layer pixels")
                (arg 0u64)
                (arg (call (. retained pixel-difference-count) immediate))
              )
            )
            (blank)
            (let idle (. scene frames-idle))
            (= (. popup color) (call RGBA "#3050a0"))
            (call (. popup invalidate-paint))
            (call (. scene update) root)
            (call (. scene commit))
            (call (. scene frame) retained)
            (call (. t expect)
              (block
                (arg "layer mutation leaves the base scene idle")
                (arg (+ idle 1))
                (arg (. scene frames-idle))
              )
            )
            (call (. layer-scene maintain) popup 2 transparent)
            (call (. layer-scene frame) layer-retained)
            (call (. layer-immediate erase) transparent)
            (call (. layer-immediate push))
            (call (. layer-immediate translate) -180 -120)
            (call (. popup paint) layer-immediate)
            (call (. layer-immediate pop))
            (call (. t expect)
              (block
                (arg "layer mutation pixels")
                (arg 0u64)
                (arg (call (. layer-retained pixel-difference-count) layer-immediate))
              )
            )
            (blank)
            (call (. popup dismiss))
            (call (. root markup-batch-queue checkpoint))
            (call (. scene update) root)
            (call (. scene commit))
            (call (. scene frame) retained)
            (call (. immediate erase) white)
            (call (. root paint) immediate)
            (call (. t expect)
              (block
                (arg "closed layer pixels")
                (arg 0u64)
                (arg (call (. retained pixel-difference-count) immediate))
              )
            )
          )
        )
      )
    )
  )
  (call (. scene close))
  (call release-scene-root root)
  (return t)
)

(fn-do + scene-configuration-tests _
  (param t TestCase)
  (let root (call SceneParityRoot))
  (call markup-append root (call SceneParityCell))
  (call mount-scene-root root (call Rect 0 0 100 100))
  (let next-background (call RGBA "#f0e0d0"))
  (let immediate (call RasterCanvas 100 100 2 next-background))
  (let retained (call RasterCanvas 100 100 2 white))
  (let scene (call DisplayScene 2 white))
  (do-use immediate
    (do-use retained
      (call (. scene build) root)
      (call (. scene commit))
      (call (. scene frame) retained)
      (call (. scene configure) 2 next-background)
      (call (. scene frame) retained)
      (call (. root paint) immediate)
      (call (. t expect) "background change pixels" 0u64 (call (. retained pixel-difference-count) immediate))
    )
  )
  (call (. scene close))
  (blank)
  (let scale-immediate (call RasterCanvas 100 100 1 next-background))
  (let scale-retained (call RasterCanvas 100 100 1 next-background))
  (let scale-scene (call DisplayScene 2 next-background))
  (do-use scale-scene
    (do-use scale-immediate
      (do-use scale-retained
        (call (. scale-scene build) root)
        (call (. scale-scene commit))
        (call (. scale-scene configure) 1 next-background)
        (call (. scale-scene commit))
        (call (. scale-scene frame) scale-retained)
        (call (. root paint) scale-immediate)
        (let difference (call (. scale-retained pixel-difference-count) scale-immediate))
        (call (. t expect) "scale change pixels" 0u64 difference)
      )
    )
  )
  (call release-scene-root root)
  (return t)
)

(fn-do + scene-empty-chunk-reappearance-tests _
  (param t TestCase)
  (let root (call SceneParityRoot))
  (let conditional (call SceneConditionalPaint))
  (call markup-append root conditional)
  (call mount-scene-root root (call Rect 0 0 100 100))
  (call (. conditional arrange-bounds) (call Rect 10 10 10 10))
  (blank)
  (let immediate (call RasterCanvas 100 100 2 white))
  (let retained (call RasterCanvas 100 100 2 white))
  (let scene (call DisplayScene 2 white))
  (do-use immediate
    (do-use retained
      (call (. scene build) root)
      (call (. scene commit))
      (call (. scene frame) retained)
      (blank)
      (call (. conditional arrange-bounds) (call Rect 10 10 40 40))
      (call (. scene update) root)
      (call (. scene commit))
      (call (. scene frame) retained)
      (call (. root paint) immediate)
      (call (. t expect)
        (block
          (arg "empty paint chunk reappears after bounds grow")
          (arg 0u64)
          (arg (call (. retained pixel-difference-count) immediate))
        )
      )
    )
  )
  (call (. scene close))
  (call release-scene-root root)
  (return t)
)

(fn-do + shadow-damage-tests _
  (param t TestCase)
  (let root (call ShapeSceneRoot))
  (let box (call ShapeSceneBox))
  (= (. box drop-shadow) (call Shadow (call RGBA "#00000080") 8 0 6))
  (call markup-append root box)
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (call (. root arrange-bounds) (call Rect 0 0 160 120))
  (call (. box arrange-bounds) (call Rect 40 30 50 40))
  (let immediate (call RasterCanvas 160 120 2))
  (let retained (call RasterCanvas 160 120 2))
  (let scene (call DisplayScene 2))
  (do-use scene
    (do-use immediate
      (do-use retained
        (call (. scene build) root)
        (call (. scene commit))
        (call (. scene add-damage) (. root bounds))
        (call (. scene frame) retained)
        (= (. box drop-shadow) (call Shadow (call RGBA "#cc000080") 8 0 6))
        (call (. root markup-batch-queue checkpoint))
        (call (. scene update) root)
        (call (. scene commit))
        (call (. t check) "shadow change damages below the box" (>= (. scene damage bottom) (+ 70 6 8)))
        (call (. t check) "shadow change damages beside the box" (<= (. scene damage left) (- 40 8)))
        (call (. scene frame) retained)
        (call (. root paint) immediate)
        (call (. t expect)
          (block
            (arg "retained shadow repaint matches immediate paint")
            (arg 0u64)
            (arg (call (. retained pixel-difference-count) immediate))
          )
        )
        (call (. box arrange-bounds) (call Rect 70 50 50 40))
        (call (. scene update) root)
        (call (. scene commit))
        (call (. scene frame) retained)
        (call (. immediate erase) null)
        (call (. root paint) immediate)
        (call (. t expect)
          (block
            (arg "moved shadow leaves no stale pixels")
            (arg 0u64)
            (arg (call (. retained pixel-difference-count) immediate))
          )
        )
        (= (. box drop-shadow) null)
        (call (. root markup-batch-queue checkpoint))
        (call (. scene update) root)
        (call (. scene commit))
        (call (. scene frame) retained)
        (call (. immediate erase) null)
        (call (. root paint) immediate)
        (call (. t expect)
          (block
            (arg "removed shadow clears its ink")
            (arg 0u64)
            (arg (call (. retained pixel-difference-count) immediate))
          )
        )
      )
    )
  )
  (call (. root close))
  (call markup-release root)
  (return t)
)

(fn-do + scene-repeated-invalidation-tests _
  (param t TestCase)
  (let root (call mounted-paint-root))
  (let immediate (call RasterCanvas 120 120 2 white))
  (let retained (call RasterCanvas 120 120 2 white))
  (let scene (call DisplayScene 2 white))
  (do-use immediate
    (do-use retained
      (call (. scene build) root)
      (call (. scene commit))
      (call (. scene frame) retained)
      (let builds (. scene builds))
      (for (in frame (..< 0 4))
        (= (. root a color) (call scene-relink-color (+ frame 1)))
        (call (. root a invalidate-paint))
        (call (. root a invalidate-paint))
        (= (. root b color) (call scene-relink-color (+ frame 2)))
        (call (. root b invalidate-paint))
        (= (. root e color) (call scene-relink-color (+ frame 3)))
        (call (. root e invalidate-paint))
        (call check-scene-paint t root scene retained immediate (str "frame " frame))
      )
      (blank)
      (= (. root d color) (call scene-relink-color 9))
      (call (. root d invalidate-paint))
      (call check-scene-paint t root scene retained immediate "a lone leaf")
      (= (. root d color) (call scene-relink-color 10))
      (call (. root d invalidate-paint))
      (call check-scene-paint t root scene retained immediate "the same leaf again")
      (call (. t expect) "repeated invalidation avoids full scene builds" builds (. scene builds))
    )
  )
  (call (. scene close))
  (call (. root close))
  (call markup-release root)
  (return t)
)

(fn-do + scene-layout-invalidation-tests _
  (param t TestCase)
  (let root (call mounted-paint-root))
  (let immediate (call RasterCanvas 120 120 2 white))
  (let retained (call RasterCanvas 120 120 2 white))
  (let scene (call DisplayScene 2 white))
  (do-use immediate
    (do-use retained
      (call (. scene build) root)
      (call (. scene commit))
      (call (. scene frame) retained)
      (blank)
      (= (. root a color) (call scene-relink-color 5))
      (call (. root a invalidate-paint))
      (= (. root c tall) true)
      (call (. root markup-batch-queue checkpoint))
      (call (. root layout) (call Rect 0 0 120 120))
      (= (. root b color) (call scene-relink-color 6))
      (call (. root b invalidate-paint))
      (call check-scene-paint
        (block
          (arg t)
          (arg root)
          (arg scene)
          (arg retained)
          (arg immediate)
          (arg "invalidating before and after a layout")
        )
      )
      (blank)
      (= (. root a color) (call scene-relink-color 7))
      (call (. root a invalidate-paint))
      (= (. root c tall) false)
      (call (. root markup-batch-queue checkpoint))
      (call (. root layout) (call Rect 0 0 120 120))
      (= (. root a color) (call scene-relink-color 8))
      (call (. root a invalidate-paint))
      (= (. root b color) (call scene-relink-color 9))
      (call (. root b invalidate-paint))
      (call check-scene-paint
        (block
          (arg t)
          (arg root)
          (arg scene)
          (arg retained)
          (arg immediate)
          (arg "invalidating one leaf on both sides of a layout")
        )
      )
    )
  )
  (call (. scene close))
  (call (. root close))
  (call markup-release root)
  (return t)
)

(fn-do + scene-moved-invalidation-tests _
  (param t TestCase)
  (let root (call mounted-paint-root))
  (let immediate (call RasterCanvas 120 120 2 white))
  (let retained (call RasterCanvas 120 120 2 white))
  (let scene (call DisplayScene 2 white))
  (do-use immediate
    (do-use retained
      (call (. scene build) root)
      (call (. scene commit))
      (call (. scene frame) retained)
      (blank)
      (= (. root a color) (call scene-relink-color 5))
      (call (. root a invalidate-paint))
      (call markup-remove (. root first) (. root inner))
      (call markup-append (. root second) (. root inner))
      (= (. root a color) (call scene-relink-color 6))
      (call (. root a invalidate-paint))
      (call (. root markup-batch-queue checkpoint))
      (call (. root layout) (call Rect 0 0 120 120))
      (call check-scene-paint t root scene retained immediate "moving an invalid subtree")
      (blank)
      (= (. root b color) (call scene-relink-color 7))
      (call (. root b invalidate-paint))
      (call check-scene-paint
        (block
          (arg t)
          (arg root)
          (arg scene)
          (arg retained)
          (arg immediate)
          (arg "invalidating inside a moved subtree")
        )
      )
      (blank)
      (call markup-remove (. root second) (. root inner))
      (= (. root c color) (call scene-relink-color 8))
      (call (. root c invalidate-paint))
      (call markup-append (. root first) (. root inner))
      (call (. root markup-batch-queue checkpoint))
      (call (. root layout) (call Rect 0 0 120 120))
      (call check-scene-paint t root scene retained immediate "invalidating a detached subtree")
    )
  )
  (call (. scene close))
  (call (. root close))
  (call markup-release root)
  (return t)
)

(fn-do + scene-nested-scroll-tests _
  (param t TestCase)
  (let root (call SceneScrollRoot))
  (call markup-mount-root root root)
  (let outer (call ScenePaintGroup))
  (call markup-append root outer)
  (let inner (call ScenePaintGroup))
  (call markup-append outer inner)
  (let first (call nested-scroll-list inner 0))
  (let second (call nested-scroll-list inner 5))
  (call (. root markup-batch-queue checkpoint))
  (call (. root layout) (call Rect 0 0 120 120))
  (blank)
  (let immediate (call RasterCanvas 120 120 2 white))
  (let retained (call RasterCanvas 120 120 2 white))
  (let scene (call DisplayScene 2 white))
  (do-use immediate
    (do-use retained
      (call (. scene build) root)
      (call (. scene commit))
      (call (. scene frame) retained)
      (let builds (. scene builds))
      (for (in frame (..< 0 4))
        (let offset (+ 11.5 (* (as frame F64) 23)))
        (let ignored-first (call (. first scroll-to) (call Point 0 offset)))
        (let ignored-again (call (. first scroll-to) (call Point 0 (+ offset 3))))
        (let ignored-second (call (. second scroll-to) (call Point 0 (/ offset 2))))
        (call check-scene-paint
          (block
            (arg t)
            (arg root)
            (arg scene)
            (arg retained)
            (arg immediate)
            (arg (str "scrolling both lists in frame " frame))
          )
        )
        (let ignored-lone (call (. second scroll-to) (call Point 0 (+ offset 40))))
        (call check-scene-paint
          (block
            (arg t)
            (arg root)
            (arg scene)
            (arg retained)
            (arg immediate)
            (arg (str "scrolling one list after frame " frame))
          )
        )
      )
      (call (. t expect) "nested scrolling avoids full scene builds" builds (. scene builds))
    )
  )
  (call (. scene close))
  (call (. root close))
  (call markup-release root)
  (return t)
)

(fn-do + scene-styled-invalidation-tests _
  (param t TestCase)
  (let root (call SceneStyledRoot))
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (call (. root layout) (call Rect 0 0 120 120))
  (let immediate (call RasterCanvas 120 120 2 white))
  (let retained (call RasterCanvas 120 120 2 white))
  (let scene (call DisplayScene 2 white))
  (do-use immediate
    (do-use retained
      (call (. scene build) root)
      (call (. scene commit))
      (call (. scene frame) retained)
      (let builds (. scene builds))
      (blank)
      (= (. root first lit) true)
      (call check-scene-style t root scene retained immediate "a styled background")
      (= (. root first lit) false)
      (= (. root second lit) true)
      (call check-scene-style t root scene retained immediate "a moved styled background")
      (blank)
      (= (. root first lit) true)
      (= (. root second lit) false)
      (= (. root a color) (call scene-relink-color 3))
      (call (. root a invalidate-paint))
      (= (. root b color) (call scene-relink-color 4))
      (call (. root b invalidate-paint))
      (call check-scene-style
        (block
          (arg t)
          (arg root)
          (arg scene)
          (arg retained)
          (arg immediate)
          (arg "a styled background over repainted content")
        )
      )
      (call (. t check)
        (block
          (arg "a styled box settles its paint")
          (arg (and (not (. root first $is-paint-invalid)) (not (. root second $is-paint-invalid))))
        )
      )
      (blank)
      (= (. root first lit) false)
      (= (. root a color) (call scene-relink-color 5))
      (call (. root a invalidate-paint))
      (call check-scene-style
        (block
          (arg t)
          (arg root)
          (arg scene)
          (arg retained)
          (arg immediate)
          (arg "an unstyled background over repainted content")
        )
      )
      (call (. t expect) "styled invalidation avoids full scene builds" builds (. scene builds))
    )
  )
  (call (. scene close))
  (call (. root close))
  (call markup-release root)
  (return t)
)

(fn-do + scene-equal-style-tests _
  (param t TestCase)
  (let root (call SceneStripedRoot))
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (call (. root layout) (call Rect 0 0 120 120))
  (let immediate (call RasterCanvas 120 120 2 white))
  (let retained (call RasterCanvas 120 120 2 white))
  (let scene (call DisplayScene 2 white))
  (do-use immediate
    (do-use retained
      (call (. scene build) root)
      (call (. scene commit))
      (call (. scene frame) retained)
      (call (. t check) "a striped box settles its paint" (not (. root row $is-paint-invalid)))
      (blank)
      (call (. scene reset-frame-counters))
      (= (. root row address) 2)
      (call (. root markup-batch-queue checkpoint))
      (call (. t check) "an equal recomputed style value keeps paint valid" (not (. root row $is-paint-invalid)))
      (call (. root layout) (call Rect 0 0 120 120))
      (call check-scene-paint t root scene retained immediate "an equal recomputed style value")
      (call (. t expect) "an equal recomputed style value rebuilds no chunks" 0 (. scene chunks-rebuilt))
      (blank)
      (= (. root row address) 3)
      (call (. root markup-batch-queue checkpoint))
      (call (. t check) "a changed style value invalidates paint" (. root row $is-paint-invalid))
      (call (. root layout) (call Rect 0 0 120 120))
      (call check-scene-paint t root scene retained immediate "a changed style value")
      (call (. t check) "a changed style value rebuilds its chunk" (> (. scene chunks-rebuilt) 0))
      (blank)
      (call (. scene reset-frame-counters))
      (= (. root row address) 5)
      (call (. root markup-batch-queue checkpoint))
      (call (. t check) "an equal value after a change keeps paint valid" (not (. root row $is-paint-invalid)))
      (call (. root layout) (call Rect 0 0 120 120))
      (call check-scene-paint t root scene retained immediate "an equal value after a change")
      (call (. t expect) "an equal value after a change rebuilds no chunks" 0 (. scene chunks-rebuilt))
    )
  )
  (call (. scene close))
  (call (. root close))
  (call markup-release root)
  (return t)
)

(fn-do _ check-scene-style _
  (param t TestCase)
  (param root SceneStyledRoot)
  (param scene DisplayScene)
  (param retained RasterCanvas)
  (param immediate RasterCanvas)
  (param label String)
  (call (. root markup-batch-queue checkpoint))
  (call (. root layout) (call Rect 0 0 120 120))
  (call check-scene-paint t root scene retained immediate label)
)

(fn-do _ nested-scroll-list _
  (param parent Box)
  (param seed I64)
  (let list (call SceneNestedScrollList))
  (call markup-append parent list)
  (for (in index (..< 0 40))
    (let cell (call ScenePaintCell))
    (= (. cell color) (call scene-relink-color (+ index seed)))
    (call markup-append list cell)
  )
  (return list)
)

(fn-do _ mounted-paint-root _
  (let root (call ScenePaintRoot))
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (call (. root layout) (call Rect 0 0 120 120))
  (return root)
)

(fn-do + check-scene-paint _
  (param t TestCase)
  (param root Box)
  (param scene DisplayScene)
  (param retained RasterCanvas)
  (param immediate RasterCanvas)
  (param label String)
  (call (. scene update) root)
  (call (. scene commit))
  (call (. scene frame) retained)
  (call (. immediate erase) white)
  (call (. root paint) immediate)
  (call (. t expect) (str label " matches immediate paint") 0u64 (call (. retained pixel-difference-count) immediate))
  (call (. t check) (str label " leaves no box invalid") (call scene-paint-is-settled root))
)

(fn-do _ scene-paint-is-settled Bool
  (param box Box)
  (return-if false (if (or (. box is-retained-paint-invalid) (. box is-retained-paint-invalid-below))))
  (return (call all (. box rendered-children) (:where (call scene-paint-is-settled each))))
)

(fn-expr _ scene-relink-color _
  (param key I64)
  (call RGBA (+ 0.1 (* (as (% key 4) F64) 0.2)) 0.3 (- 0.9 (* (as (% key 3) F64) 0.25)) 1)
)

(type + SceneParityModalContent (is Box)
  (prop + color _ (= (call RGBA "#6699dd")))
  (fn-do + paint-background _
    (param canvas Canvas)
    (= (. canvas fill-color) color)
    (= (. canvas stroke-color) null)
    (call (. canvas rect) bounds)
  )
)

(type + SceneParityPopup (is Popup)
  (prop + color _ (= (call RGBA 0.12 0.08 0.2 1)))
  (fn-do + paint-background _
    (param canvas Canvas)
    (= (. canvas fill-color) color)
    (= (. canvas stroke-color) popup-border-color)
    (= (. canvas stroke-width) 4)
    (call (. canvas rect) bounds)
  )
)

(type + SceneConditionalPaint (is Box)
  (fn-do + paint-self _
    (param canvas Canvas)
    (return-if (if (or (< (. bounds width) 20) (< (. bounds height) 20))))
    (= (. canvas fill-color) conditional-paint-color)
    (= (. canvas stroke-color) null)
    (call (. canvas rect) bounds)
  )
)

(type + SceneRelinkCell (is Box)
  (prop + color _ (= (call RGBA 0.2 0.4 0.9 1)))
  (prop + shown _ (= true))
  (prop + faded _ (= false))
  (prop + blank _ (= false))
  (blank)
  (depends invalidate-paint blank)
  (blank)
  (rule This
    (= display (if-expr #shown (. Display visible) (. Display hidden)))
    (= opacity (if-expr #faded 0.5%% 1%%))
  )
  (fn-do + paint-background _
    (param canvas Canvas)
    (return-if (if blank))
    (call (. canvas push))
    (= (. canvas fill-color) color)
    (= (. canvas stroke-color) null)
    (call (. canvas rect) bounds)
    (call (. canvas pop))
  )
)

(type + SceneScrollRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (rule This (• flow-col))
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(type + ScenePaintRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (rule This (• flow-col))
  (content
    (<> This
      (<> ScenePaintGroup (id: first)
        (<> ScenePaintGroup (id: inner)
          (<> ScenePaintCell (id: a))
          (<> ScenePaintCell (id: b))
          (<> ScenePaintCell (id: c))
        )
      )
      (<> ScenePaintGroup (id: second)
        (<> ScenePaintCell (id: d))
        (<> ScenePaintCell (id: e))
      )
    )
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(type + SceneStyledRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (rule This (• flow-col))
  (content
    (<> This
      (<> SceneStyledGroup (id: first)
        (<> ScenePaintCell (id: a))
      )
      (<> SceneStyledGroup (id: second)
        (<> ScenePaintCell (id: b))
      )
    )
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(type + SceneStyledGroup (is Box)
  (prop + lit _ (= false))
  (blank)
  (rule This (• flow-col) (• p 4)
    (= background-color (only-if (call scene-relink-color 7) (if #lit)))
  )
)

(type + SceneStripedRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (rule This (• flow-col))
  (content
    (<> This
      (<> SceneStripedRow (id: row))
    )
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(type + SceneStripedRow (is Box)
  (prop + address I64)
  (blank)
  (rule This (• h 20)
    (= background-color (if-expr (== (% #address 2) 0) "#e8eef7" "#ffffff"))
  )
)

(type + ScenePaintGroup (is Box)
  (rule This (• flow-col) (• p 2))
)

(type + ScenePaintCell (is SceneRelinkCell)
  (prop + tall _ (= false))
  (blank)
  (rule This (• w 40)
    (= min-height (if-expr #tall (call (. SizeSpec coord) 18) (call (. SizeSpec coord) 8)))
    (= max-height (if-expr #tall (call (. SizeSpec coord) 18) (call (. SizeSpec coord) 8)))
  )
)

(type + SceneNestedScrollList (is Box)
  (rule This (• flow-col) (• w 100) (• h 40)
    (= overflow-y (. ScrollOverflow auto))
    (= scroll-indicator-y (. ScrollIndicatorVisibility hidden))
  )
