(import /core/markup)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/outline)
(import /graphics/primitives)
(import /gui/box)
(import /gui/layout)
(import /gui/primitives)
(import /gui/shape)

(fn-do + mount-scene-root _
  (param root SceneParityRoot)
  (param bounds Rect)
  (call markup-mount-root root root)
  (call (. root markup-batch-queue checkpoint))
  (call (. root layout) bounds)
)

(fn-do + release-scene-root _
  (param root SceneParityRoot)
  (call (. root close))
  (call markup-release root)
)

(type + SceneParityRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (rule This
    (= layout flow-col)
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(type + SceneParityCell (is Box)
  (prop + color _ (= (call RGBA 0.2 0.4 0.9 1)))
  (blank)
  (rule This
    (= min-width (call (. SizeSpec coord) 11))
    (= max-width (call (. SizeSpec coord) 11))
    (= min-height (call (. SizeSpec coord) 8))
    (= max-height (call (. SizeSpec coord) 8))
  )
  (fn-do + paint-background _
    (param canvas Canvas)
    (call (. canvas push))
    (= (. canvas fill-color) color)
    (= (. canvas stroke-color) null)
    (call (. canvas rect) bounds)
    (call (. canvas pop))
  )
)

(type + ShapeSceneRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(type + ShapeSceneBox (is Box)
  (prop + radius Length (= 10))
  (prop + fill RGBA (= (call RGBA "#3366cc")))
  (prop + edge RGBA (= (call RGBA "#112244")))
  (prop + shape-style (? BoxShape))
  (prop + drop-shadow (? Shadow))
  (blank)
  (rule This
    (= corner-radius #radius)
    (= background-color #fill)
    (= border-color #edge)
    (= border-width 2)
    (= shape #shape-style)
    (= shadow #drop-shadow)
  )
)
