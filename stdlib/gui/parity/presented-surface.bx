(import /BxAppleGUI/BxAppleGUI.h)
(import /core/markup)
(import /graphics/canvas)
(import /graphics/color)
(import /graphics/primitives)
(import /gui/box)
(import /gui/layout)
(import /gui/primitives)
(import /gui/scene)
(import /test)
(blank)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "GUI Presented Surface Parity"))
  (call (. cases run) presented-surface-tests)
  (return cases)
)

(fn-do + presented-surface-tests _
  (param t TestCase)
  (let root (call PresentationRoot))
  (call markup-mount-root root root)
  (let cells (list PresentationCell))
  (for (in row-index (..< 0 6))
    (let row (call PresentationRow))
    (call markup-append root row)
    (for (in cell-index (..< 0 10))
      (let cell (call PresentationCell))
      (= (. cell shade) (% (+ (* row-index 10) cell-index) 7))
      (+= cells cell)
      (call markup-append row cell)
    )
  )
  (call (. root markup-batch-queue checkpoint))
  (call (. root layout) (call Rect 0 0 240 160))
  (blank)
  (let native (call C:brixGuiWindowCreate "gui test presentation (offscreen)" 240 160))
  (let space (call C:brixGuiWindowGetDisplayColorSpace native))
  (let surface (call RasterCanvas 240 160 2 white space))
  (let immediate (call RasterCanvas 240 160 2 white space))
  (let presented (call RasterCanvas 240 160 2 white space))
  (let scene (call DisplayScene 2 white))
  (let changes (list 3 17 17 40 58 0 29 29 11 52 6 33))
  (do-use surface
    (do-use immediate
      (do-use presented
        (call present-frame
          (block
            (arg t)
            (arg root)
            (arg scene)
            (arg surface)
            (arg immediate)
            (arg presented)
            (arg native)
            (arg "the opening frame")
          )
        )
        (let step Size)
        (for (in index changes)
          (= (. ([] cells index) shade) (% (+ (. ([] cells index) shade) 3) 7))
          (if (== (% step 4) 1)
            (let partner ([] cells (% (+ index 23) (. cells length))))
            (= (. partner shade) (% (+ (. partner shade) 1) 7))
          )
          (if (== (% step 5) 4)
            (call (. scene add-damage) (. root bounds))
          )
          (call present-frame
            (block
              (arg t)
              (arg root)
              (arg scene)
              (arg surface)
              (arg immediate)
              (arg presented)
              (arg native)
              (arg (str "change step " step))
            )
          )
          (+= step 1)
        )
        (call present-frame t root scene surface immediate presented native "an idle frame")
        (let surfaces (call C:brixGuiWindowPresentedSurfaceCount native))
        (call (. t check) "presentation alternates buffers" (and (>= surfaces 2) (<= surfaces 3)))
        (let orientation (call C:brixGuiWindowPresentationOrientationCheck native))
        (call (. t expect) "the presented surface composites like image contents" 0 orientation)
      )
    )
  )
  (call (. scene close))
  (call C:brixGuiWindowClose native)
  (call C:brixGuiWindowRelease native)
  (call (. root close))
  (call markup-release root)
  (return t)
)

(fn-do + present-frame _
  (param t TestCase)
  (param root PresentationRoot)
  (param scene DisplayScene)
  (param surface RasterCanvas)
  (param immediate RasterCanvas)
  (param presented RasterCanvas)
  (param native Pointer)
  (param label String)
  (call (. root markup-batch-queue checkpoint))
  (call (. root update-layout))
  (call (. scene maintain) root 2 white)
  (let replay-count (. scene frames-replayed))
  (call (. scene frame) surface)
  (if (!= (. scene frames-replayed) replay-count)
    (let damage (. scene last-frame-damage))
    (call C:brixGuiWindowCommitFrame
      (block
        (arg native)
        (arg (. surface native))
        (arg (. damage x))
        (arg (. damage y))
        (arg (. damage width))
        (arg (. damage height))
      )
    )
  )
  (call (. t check) (str label " presents a surface") (call C:brixGuiWindowCopyPresentedPixels native (. presented native)))
  (call (. immediate erase) white)
  (call (. root paint) immediate)
  (call (. t expect) (str label " presents the immediate pixels") 0u64 (call (. presented pixel-difference-count) immediate))
)

(type + PresentationRoot (is Box)
  (implements MarkupRootElement)
  (prop + markup-batch-queue _ (:= (call MarkupBatchQueue this)))
  (blank)
  (rule This
    (= layout flow-col)
  )
  (fn-do + markup-batch-did-flush _
    (param flush MarkupBatchFlush)
  )
)

(type + PresentationRow (is Box)
  (rule This
    (= layout flow-row)
  )
)

(type + PresentationCell (is Box)
  (prop + shade Size)
  (blank)
  (rule This
    (= background-color (call RGBA (+ 0.15 (* (as #shade F64) 0.1)) 0.4 (- 0.85 (* (as #shade F64) 0.1)) 1))
    (= min-width (call (. SizeSpec coord) 22))
    (= max-width (call (. SizeSpec coord) 22))
    (= min-height (call (. SizeSpec coord) 24))
    (= max-height (call (. SizeSpec coord) 24))
    (= margin-right 2)
    (= margin-bottom 2)
  )
)
