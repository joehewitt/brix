━━━━━━━━━━━━━━━━━━━━
+ do tests TestRender

. cases = TestCase("GUI Presented Surface Parity")
cases.run(presented-surface-tests)
= cases

━━━━━━━━━━━━━━━━━━━━
+ do presented-surface-tests
    - t TestCase

. root = PresentationRoot()
markup-mount-root(root, root)
. cells [PresentationCell]
for row-index in 0 .. < 6
    . row = PresentationRow()
    markup-append(root, row)
    for cell-index in 0 .. < 10
        . cell = PresentationCell()
        cell.shade = (row-index * 10 + cell-index) % 7
        cells += cell
        markup-append(row, cell)
root.markup-batch-queue.checkpoint()
root.layout(Rect(0, 0, 240, 160))

. native = C:yumiGuiWindowCreate("gui test presentation (offscreen)", 240, 160)
. space = C:yumiGuiWindowGetDisplayColorSpace(native)
. surface = RasterCanvas(240, 160, 2, white, space)
. immediate = RasterCanvas(240, 160, 2, white, space)
. presented = RasterCanvas(240, 160, 2, white, space)
. scene = DisplayScene(2, white)
. changes = [3, 17, 17, 40, 58, 0, 29, 29, 11, 52, 6, 33]
do use surface
    do use immediate
        do use presented
            present-frame
                - t
                - root
                - scene
                - surface
                - immediate
                - presented
                - native
                - "the opening frame"
            . step Size
            for index in changes
                cells[index].shade = (cells[index].shade + 3) % 7
                if step % 4 == 1
                    . partner = cells[(index + 23) % cells.length]
                    partner.shade = (partner.shade + 1) % 7
                if step % 5 == 4
                    scene.add-damage(root.bounds)
                present-frame
                    - t
                    - root
                    - scene
                    - surface
                    - immediate
                    - presented
                    - native
                    - "change step $step"
                step += 1
            present-frame(t, root, scene, surface, immediate, presented, native, "an idle frame")
            . surfaces = C:yumiGuiWindowPresentedSurfaceCount(native)
            t.check("presentation alternates buffers", surfaces >= 2 && surfaces <= 3)
            . orientation = C:yumiGuiWindowPresentationOrientationCheck(native)
            t.expect("the presented surface composites like image contents", 0, orientation)
scene.close()
C:yumiGuiWindowClose(native)
C:yumiGuiWindowRelease(native)
root.close()
markup-release(root)
= t

━━━━━━━━━━━━━━━━━━━━
+ do present-frame
    - t TestCase
    - root PresentationRoot
    - scene DisplayScene
    - surface RasterCanvas
    - immediate RasterCanvas
    - presented RasterCanvas
    - native Pointer
    - label String

root.markup-batch-queue.checkpoint()
root.update-layout()
scene.maintain(root, 2, white)
. replay-count = scene.frames-replayed
scene.frame(surface)
if scene.frames-replayed != replay-count
    . damage = scene.last-frame-damage
    C:yumiGuiWindowCommitFrame
        - native
        - surface.native
        - damage.x
        - damage.y
        - damage.width
        - damage.height
t.check("$label presents a surface", C:yumiGuiWindowCopyPresentedPixels(native, presented.native))
immediate.erase(white)
root.paint(immediate)
t.expect("$label presents the immediate pixels", 0u64, presented.pixel-difference-count(immediate))

