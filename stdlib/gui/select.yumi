+ SelectMenu is Menu

+ focus-index Size = 0

• This • cover-anchor

────────────────────
+ get placement-focus

select-focus-rect(this, focus-index)

━━━━━━━━━━━━━━━━━━━━
+ do select-focus-rect
    - menu Menu
    - index Size

. padding = menu.padding-edges
. border = menu.border-edges
. y = border.top + padding.top
. candidates = menu.items
for position in 0 .. < candidates.length
    . height = candidates[position].measure().outer-size.height
    if position == index
        = Rect(border.left + padding.left + 12, y, 0, height)
    y += height
= Rect(border.left + padding.left + 12, border.top + padding.top, 0, 24)
