━━━━━━━━━━━━━━━━━━━━
+ SelectTitle'T is () String
    - option T

━━━━━━━━━━━━━━━━━━━━
+ Select'T is MenuButton

+ options [T] = List'T()
+ selected T?
+ option-title SelectTitle'T?
+ placeholder = ""
+ shows-placeholder = #selected == null
+ event selection-changing SelectionEvent'T
+ event selection-changed SelectionEvent'T

_ type-select = TypeSelect()

────────────────────

<This
    title = if #shows-placeholder then #placeholder else select-title'T(#selected, #option-title)
    <SelectMenu
        focus-index = option-index(#options, #selected)
        for option in #options
            <MenuItem
                title = select-title'T(option, #option-title)
                is-on = #selected == option
                action = => do choose(option)
    <KeyShortcut "Open options"
        key = .arrow-up
        discoverable = false
        action = => do open-menu()

────────────────────
for event on key-press

type-select-key(event)

────────────────────
+ do choose
    - value T

. old = selected
=? if old == value
. change = SelectionEvent'T(old, value)
selection-changing <- change
=? if change.is-canceled
selected = value
selection-changed <- SelectionEvent'T(old, value)

────────────────────
_ do type-select-key
    - event KeyPressEvent

=? if !is-effectively-enabled
. text = event.typed-text
=? if !text || (text == " " && !type-select.is-active)
. titles = List'String()
for option in options
    titles += select-title'T(option, option-title)
. current = option-index(options, selected) if selected != null
. found = type-select.find(text, titles, current)
if found != null
    choose(options[found])
event.cancel()

────────────────────
+ do option-index Size
    - choices [T]
    - option T?

for index in 0 .. < choices.length
    =? index if option == choices[index]
= 0

━━━━━━━━━━━━━━━━━━━━
+ select-title'T String
    - option T?
    - formatter SelectTitle'T?

|? option == null
    ""
|? formatter != null
    formatter(option)
??
    "${option}"

