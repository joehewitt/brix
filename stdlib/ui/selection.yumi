/math

━━━━━━━━━━━━━━━━━━━━
+ SelectionMode is U8

| none
| single
| multiple

━━━━━━━━━━━━━━━━━━━━
+ do selection-after-press [String]
    - mode SelectionMode
    - keys [String]
    - key String
    - order [String]
    - anchor String?
    - extends = false
    - toggles = false

=? List'String() if mode == SelectionMode.none
=? [key] if mode == SelectionMode.single
=? selection-range(anchor, key, order) if extends && anchor
=? [key] if !toggles
. kept = List'String
    ** keys
    ?> each != key
if kept.length == keys.length
    kept += key
= kept

━━━━━━━━━━━━━━━━━━━━
+ selection-range [String]
    - anchor String
    - key String
    - order [String]

if start == null || end == null then [key] else order[min(start, end) .. max(start, end)]

.. start = order.find(anchor)
.. end = order.find(key)
