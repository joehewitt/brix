        (let kept (?? ([] (. into pages) (. region id)) ""))
        (let own (call some (. region pages) (:where (and (== (. each id) kept) (not (call holds-role (. each root)))))))
        (if (and page (call holds-role (. page root)) (not own))
          (= ([] (. into pages) (. region id)) (. page id))
        )
      )
    )
    (= current context-id)
    (+= revision 1)
