      (lazy node (only-if (call node-in (. drag scope) (. drag stack)) (if (not (. drag view)))))
    )
  )
  (fn-expr + users-of (list PaneContext)
    (param owned PaneLayout)
    (call (of List PaneContext) (in each contexts (when (== (. each layout) (. owned id)))))
  )
  (fn-do + preview PaneModel
    (param drag PaneDrag)
    (param target PaneTarget)
    (let copy (call PaneModel))
    (+= (. copy roles) roles)
    (= (. copy buttoned) (call (of List String) buttoned))
