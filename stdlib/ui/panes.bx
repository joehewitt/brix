  (fn-do + switch-to _
    (param context-id String)
    (let target (call context-named context-id))
    (return-if (if (not target)))
    (blank)
    (let owned (call layout))
    (let into (call session-of target))
    (for (in region (++ (call (of List PaneRegion) (. owned workspace)) (call (. owned regions))))
      (for (in stack (call (. region stacks)))
        (let shown (call active-view stack))
        (let kept ([] (. into active) (. stack id)))
        (if (and shown (call is-role shown) (not (and kept (has (. into instances) kept) (has (. stack views) kept))))
          (= ([] (. into active) (. stack id)) shown)
        )
      )
      (if (== (. region kind) (. PaneRegionKind dock))
