(import /data/json)
(import /math)
(import /stream/aggregate)
(blank)
(prop + pane-workspace-home _ (= "workspace"))
(prop + pane-bottom-home _ (= "bottom"))
(prop + pane-side-dock-size Float (= 250))
(prop + pane-bottom-share Float (= 0.3))
(blank)
(prop _ pane-json-version _ (= 3))
(blank)
(type-line + PaneVisit (is (tuple (: context String) (: view String))))
(type-line _ PaneClosed (is (tuple (: view String) (: kind String) (: stack String) (: index (? Index)) (: origin (? PaneTarget)))))

(type + PaneAxis (is U8)
  (variant row)
  (variant column)
)

(type + PaneSide (is U8)
  (variant left)
  (variant right)
)

(type + PaneZone (is U8)
  (variant center)
  (variant left)
  (variant right)
  (variant top)
  (variant bottom)
)

(type + PaneStripMode (is U8)
  (variant beside)
  (variant top)
  (variant top-only)
)

(type + PaneViewScope (is U8)
  (variant app)
  (variant context)
)

(type + PaneScope (is U8)
  (variant layout)
  (variant workspace)
)

(type + PaneNodeKind (is U8)
  (variant stack)
  (variant split)
  (variant workspace)
)

(type + PaneRegionKind (is U8)
  (variant dock)
  (variant center)
  (variant float)
  (variant workspace)
)

(type + PaneNode
  (prop + kind PaneNodeKind)
  (prop + id String)
  (prop + views (list String))
  (prop + axis PaneAxis)
  (prop + kids (list PaneNode))
  (prop + sizes (list Float))
  (prop + is-collapsed Bool)
  (prop + is-dock Bool)
  (fn-do + This _
    (param kind _)
    (param id _)
    (param views (list String) (= (call (of List String))))
    (param axis _ (= (. PaneAxis row)))
    (param kids (list PaneNode) (= (call (of List PaneNode))))
    (param sizes (list Float) (= (call (of List Float))))
    (param is-collapsed _ (= false))
    (param is-dock _ (= false))
  )
  (fn-expr + is-split _ :get
    (== kind (. PaneNodeKind split))
  )
  (fn-expr + json JSON :get
    (call (of Map String JSON)
      (block
        (:kind (as kind Int))
        (:id id)
        (:views views)
        (:axis (as axis Int))
        (:kids (call (of List JSON) (in (. each json) kids)))
        (:sizes sizes)
        (:collapsed is-collapsed)
        (:dock is-dock)
      )
    )
  )
  (fn-expr _ is-stack _ :get
    (== kind (. PaneNodeKind stack))
  )
  (fn-do + stacks (stream PaneNode)
    (if is-stack
      (yield this)
    )
    (for (in kid kids)
      (yield-all (call (. kid stacks)))
    )
  )
  (fn-expr + size-at Float
    (param index Index)
    (if-expr (< index (. sizes length)) ([] sizes index) 1)
  )
  (fn-expr _ has-workspace Bool
    (or (== kind (. PaneNodeKind workspace)) (call some kids (:where (call (. each has-workspace)))))
  )
  (fn-do _ find (? PaneFound)
    (param target String)
    (param parent (? PaneNode) (= null))
    (param index Index (= 0))
    (return-if (call PaneFound this parent index null) (if (== id target)))
    (blank)
    (for (in position (..< 0 (. kids length)))
      (let found (call (. ([] kids position) find) target this position))
      (return-if found (if found))
    )
    (return null)
  )
  (fn-do _ find-dock (? PaneNode)
    (return-if this (if is-dock))
    (blank)
    (for (in kid kids)
      (let found (call (. kid find-dock)))
      (return-if found (if found))
    )
    (return null)
  )
  (fn-do _ is-folding Bool
    (param target String)
    (param stacked _ (= false))
    (return-if stacked (if (== id target)))
    (blank)
    (let below (or stacked (and is-split (== axis (. PaneAxis column)))))
    (for (in kid kids)
      (return-if (call (. kid is-folding) target below) (if (call (. kid find) target)))
    )
    (return false)
  )
  (fn-expr _ first-stack (? PaneNode)
    (call first (call stacks))
  )
)

(type + PanePage
  (prop + id String)
  (prop + root PaneNode)
  (fn-do + This _
    (param id _)
    (param root _)
  )
  (fn-expr + json JSON :get
    (call (of Map String JSON)
      (block
        (:id id)
        (:root (. root json))
      )
    )
  )
)

(type + PaneRegion
  (prop + kind PaneRegionKind)
  (prop + id String)
  (prop + side PaneSide)
  (prop + root (? PaneNode))
  (prop + pages (list PanePage))
  (prop + strip _ (= (. PaneStripMode beside)))
  (prop + size Float)
  (prop + is-collapsed _ (= false))
  (prop + x Float)
  (prop + y Float)
  (prop + width Float (= 380))
  (prop + height Float (= 280))
  (blank)
  (prop _ origin (? PaneTarget))
  (fn-do + This _
    (param kind _)
    (param id _)
    (param side _ (= (. PaneSide left)))
    (param size Float (= 240))
  )
  (fn-expr + json JSON :get
    (call (of Map String JSON)
      (block
        (:kind (as kind Int))
        (:id id)
        (:side (as side Int))
        (:root (as (?. root json) JSON))
        (:pages (call (of List JSON) (in (. each json) pages)))
        (:strip (as strip Int))
        (:size size)
        (:collapsed is-collapsed)
        (:x x)
        (:y y)
        (:width width)
        (:height height)
        (:origin (as (?. origin json) JSON))
      )
    )
  )
  (fn-do + stacks (stream PaneNode)
    (if root
      (yield-all (call (. root stacks)))
    )
    (for (in page pages)
      (yield-all (call (. page root stacks)))
    )
  )
  (fn-expr + page-named (? PanePage)
    (param page-id (? String))
    (call first (in each pages (when (== (. each id) (?? page-id "")))))
  )
  (fn-do + page-index (? Index)
    (param page-id (? String))
    (for (in index (..< 0 (. pages length)))
      (return-if index (if (== (. ([] pages index) id) (?? page-id ""))))
    )
    (return null)
  )
  (fn-do _ find (? PaneFound)
    (param target String)
    (let found (call (?. root find) target))
    (return-if found (if found))
    (blank)
    (for (in page pages)
      (let inner (call (. page root find) target))
      (return-if (call PaneFound (. inner node) (. inner parent) (. inner index) page) (if inner))
    )
    (return null)
  )
)

(type + PaneLayout
  (prop + id String)
  (prop + name String)
  (prop + is-shared _ (= true))
  (prop + left _ (= (call PaneRegion (. PaneRegionKind dock) "left" (. PaneSide left) pane-side-dock-size)))
  (prop + right _ (= (call PaneRegion (. PaneRegionKind dock) "right" (. PaneSide right) pane-side-dock-size)))
  (prop + center _ (= (call PaneRegion (. PaneRegionKind center) "center")))
  (prop + floats (list PaneRegion))
  (prop + workspace _ (= (call PaneRegion (. PaneRegionKind workspace) pane-workspace-home)))
  (prop + homes (map String String))
  (prop + closed (map String String))
  (prop + menus (list String))
  (prop + inlines (list String))
  (blank)
  (prop _ base (? String))
  (prop _ placed (map String String))
  (fn-do + This _
    (param id _)
    (param name _)
    (= (. center root) (call pane-workspace-node))
  )
  (fn-expr + json JSON :get
    (call (of Map String JSON)
      (block
        (:id id)
        (:name name)
        (:shared is-shared)
        (:base (as base JSON))
        (:left (. left json))
        (:right (. right json))
        (:center (. center json))
        (:workspace (. workspace json))
        (:floats (call (of List JSON) (in (. each json) floats)))
        (:homes (call pane-map-json homes))
        (:placed (call pane-map-json placed))
        (:closed (call pane-map-json closed))
        (:menus menus)
        (:inlines inlines)
      )
    )
  )
  (fn-expr + dock PaneRegion
    (param side PaneSide)
    (match side
      (case= (. PaneSide left)
        left
      )
      (case= (. PaneSide right)
        right
      )
    )
  )
  (fn-expr + regions (list PaneRegion)
    (++ (call (of List PaneRegion) left right center) floats)
  )
  (fn-do + add-bottom _
    (param node PaneNode)
    (= (. center root) (call pane-with-bottom (. center root) node (str (. node id) "-row")))
  )
  (fn-expr + find-float (? PaneRegion)
    (param float-id String)
    (call first (in each floats (when (== (. each id) float-id))))
  )
  (fn-expr _ region-of (? PaneRegion)
    (param node-id String)
    (call first (in each (call regions) (when (call (. each find) node-id))))
  )
)

(type + PaneSession
  (prop + active (map String String))
  (prop + pages (map String String))
  (prop + instances (map String String))
  (blank)
  (prop _ closed (list PaneClosed))
  (prop _ last-focus (map String String))
  (prop _ workspace-focus (? String))
  (prop _ focus (? String))
  (prop _ main-focus (? String))
  (fn-expr + json JSON :get
    (call (of Map String JSON)
      (block
        (:active (call pane-map-json active))
        (:pages (call pane-map-json pages))
        (:instances (call pane-map-json instances))
        (entry "lastFocus" (call pane-map-json last-focus))
        (entry "workspaceFocus" (as workspace-focus JSON))
      )
    )
  )
)

(type + PaneContext
  (prop + id String)
  (prop + name String)
  (prop + layout String)
  (fn-do + This _
    (param id _)
    (param name _)
    (param layout _)
  )
  (fn-expr + json JSON :get
    (call (of Map String JSON)
      (block
        (:id id)
        (:name name)
        (:layout layout)
      )
    )
  )
)

(type + PaneLocation (is Tuple)
  (prop + scope PaneScope)
  (prop + stack String)
  (prop + region PaneRegion)
  (prop + page (? PanePage))
)

(type + PaneDrag (is Tuple)
  (prop + view (? String))
  (prop + scope PaneScope)
  (prop + stack String)
)

(type + PaneTarget (is Union)
  (variant stack (tuple (: scope PaneScope) (: stack String) (: zone PaneZone) (: index (? Index))))
  (variant slot (tuple (: side PaneSide) (: before (? String))))
  (variant bottom)
  (variant float (tuple (: x Float) (: y Float) (: width Float) (: height Float)))
  (fn-expr _ json JSON :get
    (match this
      (case (call .stack scope stack zone index)
        (call (of Map String JSON) (:scope (as scope Int)) (:stack stack) (:zone (as zone Int)))
      )
      (case (call .slot side before)
        (call (of Map String JSON) (:slot (as side Int)) (:before (as before JSON)))
      )
      (case= .bottom
        (call (of Map String JSON) (:bottom true))
      )
      (case (call .float x y width height)
        (as null JSON)
      )
    )
  )
)

(type + PaneModel
  (prop + layouts (map String PaneLayout))
  (prop + contexts (list PaneContext))
  (prop + current _ (= ""))
  (prop + revision U64)
  (prop + focus-revision U64)
  (blank)
  (prop _ roles (map String PaneViewScope))
  (prop _ sessions (map String PaneSession))
  (event + focus-changed String)
  (event + menu-requested String)
  (blank)
  (prop _ buttoned (list String))
  (prop _ passive (list String))
  (prop _ visits (list PaneVisit))
  (prop _ next-id U64)
  (prop _ heir (? String))
  (prop _ blank _ (= (call PaneContext "" "" "")))
  (fn-expr + json JSON :get
    (call (of Map String JSON)
      (block
        (:version pane-json-version)
        (:current current)
        (entry "nextId" (as next-id Int))
        (:layouts (call (of List JSON) (in (. each json) (. layouts values))))
        (:contexts (call (of List JSON) (in (. each json) contexts)))
        (:sessions (call (of Map String JSON) (in (tuple (. each id) (. (call session-of each) json)) contexts)))
        (:visits (call (of List JSON) (in (call pane-visit-json each) visits)))
      )
    )
  )
  (fn-do + register _
    (param view String)
    (param scope PaneViewScope)
    (param focusable _ (= true))
    (= ([] roles view) scope)
    (if (and (not focusable) (not (has passive view)))
      (+= passive view)
    )
  )
  (fn-expr + is-focusable Bool
    (param view String)
    (not (has passive view))
  )
  (fn-do + register-buttons _
    (param view String)
    (if (not (has buttoned view))
      (+= buttoned view)
    )
  )
  (fn-do + add-layout _
    (param layout PaneLayout)
    (= ([] layouts (. layout id)) layout)
  )
  (fn-do + add-context PaneContext
    (param id String)
    (param name String)
    (param layout String)
    (let made (call PaneContext id name layout))
    (+= contexts made)
    (= ([] sessions id) (call PaneSession))
    (if (== current "")
      (= current id)
    )
    (call normalize-all)
    (return made)
  )
  (fn-do + remove-context _
    (param id String)
    (return-if (if (not (call context-named id))))
    (blank)
    (= contexts (call (of List PaneContext) (in each contexts (when (!= (. each id) id)))))
    (-= ([] sessions id))
    (if (== current id)
      (= current (if-expr (> (. contexts length) 0) (. ([] contexts 0) id) ""))
    )
    (call normalize-all)
    (+= revision 1)
  )
  (fn-expr + context PaneContext
    (?? (call context-named current) (call first contexts) blank)
  )
  (fn-expr + layout PaneLayout
    (call layout-of (call context))
  )
  (fn-expr + session PaneSession
    (call session-of (call context))
  )
  (fn-do + make-id String
    (param prefix String)
    (+= next-id 1)
    (return (str prefix "-" next-id))
  )
  (fn-expr + instance-kind (? String)
    (param view String)
    ([] (. (call session) instances) view)
  )
  (fn-expr + holds-instance Bool
    (param context String)
    (param view String)
    (and (!= owner null) (has (. owner instances) view))
    (where
      (lazy owner ([] sessions context))
    )
  )
  (fn-do + visible-views (list String)
    (param stack PaneNode)
    (let state (call session))
    (return (call (of List String) (in each (. stack views) (when (or (call is-role each) (has (. state instances) each))))))
  )
  (fn-expr + visible-in (list String)
    (param node (? PaneNode))
    (call (of List String) (call flat-map (in (call visible-views each) (?? (call (?. node stacks)) (call (of List PaneNode))))))
  )
  (fn-expr + tab-views (list String)
    (param stack PaneNode)
    (call (of List String) (in each (call visible-views stack) (when (not (has (. (call layout) inlines) each)))))
  )
  (fn-expr + active-view (? String)
    (param stack PaneNode)
    (if-expr (and chosen (has shown chosen)) chosen (call first shown))
    (where
      (lazy shown (call tab-views stack))
      (lazy chosen ([] (. (call session) active) (. stack id)))
    )
  )
  (fn-expr + stack-in (? PaneNode)
    (param scope PaneScope)
    (param stack-id String)
    (only-if node (if (and node (. node is-stack))))
    (where
      (lazy node (call node-in scope stack-id))
    )
  )
  (fn-do + top-stacks (list String)
    (let found (call (of List String)))
    (call collect-top (. (call layout) center root) found)
    (return found)
  )
  (fn-expr + pages-in (list PanePage)
    (param side PaneSide)
    (. (call (. (call layout) dock) side) pages)
  )
  (fn-expr + page-views (list String)
    (param page PanePage)
    (call visible-in (. page root))
  )
  (fn-expr + opens Bool
    (param page PanePage)
    (not (call is-menu-page page))
  )
  (fn-expr + is-menu-page Bool
    (param page PanePage)
    (and (!= lead null) (call is-menu lead))
    (where
      (lazy lead (call first (call page-views page)))
    )
  )
  (fn-expr + in-menu Bool
    (param view String)
    (and (!= page null) (call is-menu-page page))
    (where
      (lazy page (?. (call locate view) page))
    )
  )
  (fn-do + current-page (? PanePage)
    (param side PaneSide)
    (let region (call (. (call layout) dock) side))
    (let chosen ([] (. (call session) pages) (. region id)))
    (let pages (call (of List PanePage) (in each (call pages-in side) (when (call opens each)))))
    (return (?? (call first (in each pages (when (== (. each id) (?? chosen ""))))) (call first pages)))
  )
  (fn-expr + page-after (? String)
    (param side PaneSide)
    (param page-id String)
    (call pane-page-after (call pages-in side) page-id)
  )
  (fn-do + show-page _
    (param side PaneSide)
    (param page-id String)
    (let region (call (. (call layout) dock) side))
    (= ([] (. (call session) pages) (. region id)) page-id)
    (= (. region is-collapsed) false)
    (+= revision 1)
  )
  (fn-expr + is-menu Bool
    (param view String)
    (has (. (call layout) menus) view)
  )
  (fn-expr + shows-buttons Bool
    (param view String)
    (and (has (. (call layout) inlines) view) (!= (call locate view) null))
  )
  (fn-expr + can-inline Bool
    (param view String)
    (and (has buttoned view) (not (has (. (call layout) inlines) view)))
  )
  (fn-do + set-inline _
    (param view String)
    (param on Bool)
    (let owned (call layout))
    (return-if (if (== (has (. owned inlines) view) on)))
    (return-if (if (and on (not (call can-inline view)))))
    (blank)
    (call commit
      (:edit
        (=> () :do
          (block
            (if on
              (+= (. owned inlines) view)
              (else
                (-= (. owned inlines) view)
              )
            )
          )
        )
      )
    )
    (if (not on)
      (call reveal-in view)
    )
    (+= revision 1)
  )
  (fn-expr + is-visible Bool
    (param view String)
    (case? (not place)
      false
    )
    (case? (or (not stack) (. stack is-collapsed) (!= (call active-view stack) view))
      false
    )
    (case? (!= (. region kind) (. PaneRegionKind dock))
      true
    )
    (case? (or (. region is-collapsed) (not page))
      false
    )
    (default
      (== (?. (call current-page (. region side)) id) (. page id))
    )
    (where
      (lazy place (call locate view))
      (lazy stack (call stack-in (. place scope) (. place stack)))
      (lazy region (. place region))
      (lazy page (. place page))
    )
  )
  (fn-expr + is-shown Bool
    (param view String)
    (case? (not place)
      false
    )
    (case? (or (not stack) (. stack is-collapsed))
      false
    )
    (default
      (or (== (call active-view stack) view) (call shows-buttons view))
    )
    (where
      (lazy place (call locate view))
      (lazy stack (call stack-in (. place scope) (. place stack)))
    )
  )
  (fn-do + press-strip _
    (param view String)
    (let place (call locate view))
    (return-if (if (or (not place) (!= (. place region kind) (. PaneRegionKind dock)))))
    (blank)
    (let page (. place page))
    (return-if (if (not page)))
    (blank)
    (let region (. place region))
    (if (and (not (. region is-collapsed)) (== (?. (call current-page (. region side)) id) (. page id)) (call is-shown view))
      (= (. region is-collapsed) true)
      (+= revision 1)
      (return)
    )
    (call reveal view)
  )
  (fn-do + press-page _
    (param side PaneSide)
    (param page-id String)
    (let region (call (. (call layout) dock) side))
    (if (and (not (. region is-collapsed)) (== (?. (call current-page side) id) page-id))
      (= (. region is-collapsed) true)
      (+= revision 1)
      (return)
    )
    (call show-page side page-id)
  )
  (fn-expr + page-drag (? PaneDrag)
    (param view String)
    (case? (not place)
      null
    )
    (case? (and page (> (. (call page-views page) length) 1))
      (call pane-node-drag (. page root id) (. PaneScope layout))
    )
    (default
      (call pane-view-drag view (. place scope) (. place stack))
    )
    (where
      (lazy place (call locate view))
      (lazy page (. place page))
    )
  )
  (fn-do + set-menu _
    (param view String)
    (param on Bool)
    (let owned (call layout))
    (let page (?. (call locate view) page))
    (let views (if-expr page (++ (call page-views page) (call pane-views (call (. page root stacks)))) (call (of List String) view)))
    (for (in each views)
      (-= (. owned menus) each)
      (if on
        (+= (. owned menus) each)
      )
    )
    (+= revision 1)
  )
  (fn-do + move-to-dock _
    (param view String)
    (param side PaneSide)
    (let drag (call page-drag view))
    (return-if (if (not drag)))
    (blank)
    (call drop drag (call pane-slot-target side))
  )
  (fn-do + move-to-bottom _
    (param view String)
    (let drag (call page-drag view))
    (return-if (if (not drag)))
    (blank)
    (call drop drag (. PaneTarget bottom))
  )
  (fn-expr + bottom-node (? PaneNode)
    (call (?. (. (call layout) center root) find-dock))
  )
  (fn-expr + has-bottom Bool
    (!= (call bottom-node) null)
  )
  (fn-expr + in-bottom Bool
    (param view String)
    (and (!= place null) (== (. place scope) (. PaneScope layout)) (!= (call (?. (call bottom-node) find) (. place stack)) null))
    (where
      (lazy place (call locate view))
    )
  )
  (fn-expr + is-bottom-open Bool
    (and (!= node null) (not (call is-folded-node node)))
    (where
      (lazy node (call bottom-node))
    )
  )
  (fn-do + toggle-bottom _
    (let node (call bottom-node))
    (return-if (if (not node)))
    (blank)
    (let folds (not (call is-folded-node node)))
    (for (in stack (call (. node stacks)))
      (= (. stack is-collapsed) folds)
    )
    (+= revision 1)
  )
  (fn-expr + is-folded-node Bool
    (param node PaneNode)
    (case? (. node is-stack)
      (or (. node is-collapsed) (and (== (. (call tab-views node) length) 0) (> (. (call visible-views node) length) 0)))
    )
    (case? (not (. node is-split))
      false
    )
    (default
      (and (> (. node kids length) 0) (call all (. node kids) (:where (call is-folded-node each))))
    )
  )
  (fn-expr + strip-mode PaneStripMode
    (param side PaneSide)
    (. (call (. (call layout) dock) side) strip)
  )
  (fn-do + set-strip-mode _
    (param side PaneSide)
    (param mode PaneStripMode)
    (let region (call (. (call layout) dock) side))
    (return-if (if (== (. region strip) mode)))
    (blank)
    (= (. region strip) mode)
    (+= revision 1)
  )
  (fn-expr + role-views (list String)
    (call (of List String) (. roles keys))
  )
  (fn-do + show-pane _
    (param view String)
    (param side PaneSide)
    (return-if (if (or (not (call is-role view)) (call locate view))))
    (blank)
    (call commit
      (:edit
        (=> () :do
          (block
            (call restore-role view side)
          )
        )
