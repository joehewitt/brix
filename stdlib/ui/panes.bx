  (fn-do + validate Bool
    (param drag PaneDrag)
    (param target PaneTarget)
    (let views (call payload-views drag))
    (return-if false (if (== (. views length) 0)))
    (blank)
    (if (not (. drag view))
      (let node (call node-in (. drag scope) (. drag stack)))
      (return-if false (if (or (not node) (call (. node has-workspace)))))
      (return-if false (if (and (is target .stack) (== (. target scope) (. drag scope)) (call (. node find) (. target stack)))))
      (else-if (and (is target .stack) (== (. target stack) (. drag stack)))
        (let stack (call stack-in (. target scope) (. target stack)))
        (return-if false (if (and stack (<= (. (call visible-views stack) length) 1))))
        (return-if false (if (and (== (. target zone) (. PaneZone center)) (== (. target index) null))))
      )
    )
    (if (and (is target .slot) (== (. drag scope) (. PaneScope layout)))
      (let region (call region-in (. PaneScope layout) (. drag stack)))
      (let page (?. (call (?. region find) (. drag stack)) page))
      (if (and region page (== (. region side) (. target side)) (== (. (call page-views page) length) (. views length)))
        (let pages (call pages-in (. target side)))
        (return-if false (if (or (== (. target before) (. page id)) (== (. target before) (call pane-page-after pages (. page id))))))
      )
    )
    (return (or (not (is target .stack)) (== (. target zone) (. PaneZone center)) (call can-split (. target scope) (. target stack))))
  )
  (fn-do + vacates Bool
    (param drag PaneDrag)
    (let view (. drag view))
    (return-if true (if (not view)))
    (blank)
    (let source (call stack-in (. drag scope) (. drag stack)))
    (return-if true (if (not source)))
    (return-if false (if (> (. (call visible-views source) length) 1)))
    (return (and (not (has (call layout-keeps (call layout)) (. source id))) (call all (. source views) (:where (== each view)))))
  )
  (fn-expr + can-split Bool
    (param scope PaneScope)
    (param stack-id String)
