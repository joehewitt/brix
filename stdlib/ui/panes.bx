  (fn-do + make-shared _
    (call commit
      (:edit
        (=> () :do
          (block
            (let owner (call context))
            (let owned (call layout-of owner))
            (return-if (if (. owned is-shared)))
            (blank)
            (let base-id (call base-of owned))
            (return-if (if (not (call copy-layout owned base-id (?? (?. ([] layouts base-id) name) (. owned name)) null))))
