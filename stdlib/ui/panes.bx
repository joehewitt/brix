        )
      )
    )
  )
  (fn-do _ closed-target (? PaneTarget)
    (param record PaneClosed)
    (for (in scope (list (. PaneScope workspace) (. PaneScope layout)))
      (let stack (call stack-in scope (. record stack)))
      (if stack
        (let count (. (call tab-views stack) length))
        (return (call pane-stack-target scope (. record stack) (. PaneZone center) (call min (?? (. record index) count) count)))
      )
    )
    (let origin (. record origin))
    (case? (not origin)
      (return null)
    )
    (case? (and (is origin .stack) (not (call stack-in (. origin scope) (. origin stack))))
      (return null)
    )
    (default
      (return origin)
    )
  )
  (fn-expr _ focused (? PaneLocation)
    (?? (call locate-stack (. (call session) focus)) (call main-focused))
  )
  (fn-do _ main-focused (? PaneLocation)
    (let state (call session))
    (for (in id (list (. state main-focus) (. state workspace-focus) (?. (call (?. (. (call layout) workspace root) first-stack)) id)))
      (let place (call locate-stack id))
      (return-if place (if (and place (!= (. place region kind) (. PaneRegionKind dock)))))
    )
    (return null)
  )
  (fn-do _ locate-stack (? PaneLocation)
    (param id (? String))
    (return-if null (if (not id)))
    (blank)
    (for (in scope (list (. PaneScope workspace) (. PaneScope layout)))
      (let region (call region-in scope id))
      (return-if (call PaneLocation scope id region (?. (call (. region find) id) page)) (if (and region (call stack-in scope id))))
    )
    (return null)
  )
  (fn-do _ take-focus _
    (param stack-id String)
    (let state (call session))
    (let main
      (scope (if-expr docked (. state main-focus) stack-id)
        (lazy docked (== (?. (call (. (call layout) region-of) stack-id) kind) (. PaneRegionKind dock)))
      )
    )
    (return-if (if (and (== (. state focus) stack-id) (== (. state main-focus) main))))
    (blank)
    (= (. state focus) stack-id)
    (= (. state main-focus) main)
    (+= focus-revision 1)
  )
  (fn-expr _ is-folded Bool
    (param place PaneLocation)
    (case? (!= (. region kind) (. PaneRegionKind dock))
      false
    )
    (case? (. region is-collapsed)
      true
    )
    (default
      (and (!= page null) (!= (?. (call current-page (. region side)) id) (. page id)))
    )
    (where
      (lazy region (. place region))
      (lazy page (. place page))
    )
  )
  (fn-do _ pin-pages (map String String)
    (let showing (call (of Map String String)))
    (let state (call session))
    (for (in side (list (. PaneSide left) (. PaneSide right)))
      (let region (call (. (call layout) dock) side))
      (let page (call current-page side))
      (if page
        (= ([] (. state pages) (. region id)) (. page id))
        (if (not (. region is-collapsed))
          (= ([] showing (. region id)) (. page id))
        )
      )
    )
    (return showing)
  )
  (fn-do _ settle-pages _
    (param showing (map String String))
    (param moved (list String))
    (let state (call session))
    (let changed false)
    (for (in side (list (. PaneSide left) (. PaneSide right)))
      (let region (call (. (call layout) dock) side))
      (let was ([] showing (. region id)))
      (if (and was (!= (?. (call current-page side) id) was))
        (let place (call locate (?? (call first moved) "")))
        (let landed (?. place page))
        (if (and place landed (== (. place region) region) (call opens landed))
          (= ([] (. state pages) (. region id)) (. landed id))
          (else
            (= (. region is-collapsed) true)
          )
        )
        (= changed true)
      )
    )
    (if changed
      (+= revision 1)
    )
  )
  (fn-do _ holds-role Bool
    (param node PaneNode)
    (for (in stack (call (. node stacks)))
      (for (in view (. stack views))
        (return-if true (if (call is-role view)))
      )
    )
    (return false)
  )
  (fn-do _ commit _
    (param edit (fn-type Void))
    (call edit)
    (call normalize-all)
    (+= revision 1)
  )
  (fn-do _ restore-json _ (?! Error)
    (param value (? JSON))
    (let fields (call (. (call JSONReader "layout" value) object)))
    (throw (call Error (str "Saved panes are not version " pane-json-version)) (if (!= (call (. ([] fields "version") int)) pane-json-version)))
    (blank)
    (let found (call (of List PaneLayout) (in (call pane-layout-from each) (call (. ([] fields "layouts") items)))))
    (let loaded-layouts (call (of Map String PaneLayout) (in (tuple (. each id) each) found)))
    (return-if (if (== (. loaded-layouts length) 0)))
    (blank)
    (let saved (call (. ([] fields "sessions") object)))
    (let restored (call (of Map String PaneSession) (in (tuple each (call pane-session-from ([] saved each))) (. saved fields keys))))
    (for (in item (call (. ([] fields "contexts") items)))
      (let entry (call (. item object)))
      (let owner (call context-named (call (. ([] entry "id") string))))
      (if owner
        (= (. owner layout) (call (. ([] entry "layout") string)))
      )
    )
    (= layouts loaded-layouts)
    (for (in owner contexts)
      (if (not (has layouts (. owner layout)))
        (= (. owner layout) ([] (call (of List String) (. layouts keys)) 0))
      )
      (let state ([] restored (. owner id)))
      (if state
        (= ([] sessions (. owner id)) state)
      )
    )
    (let chosen (call (. ([] fields "current") string)))
    (if (call context-named chosen)
      (= current chosen)
    )
    (= next-id (call max next-id (as (call (. ([] fields "nextId") int)) U64)))
    (= visits (call (of List PaneVisit) (in (call pane-visit-from (call (. each object))) (call (. ([] fields "visits") items)))))
  )
  (fn-expr _ layout-keeps (list String)
    (param owned PaneLayout)
    (call (of List String) (. owned homes values))
  )
  (fn-do _ prune-views _
    (param owned PaneLayout)
    (let live (call (of Map String Bool)))
    (for (in owner (call users-of owned))
      (for (in view (. (call session-of owner) instances keys))
        (= ([] live view) true)
      )
    )
    (for (in stack (call layout-stacks owned))
      (let kept (call (of List String) (in each (. stack views) (when (or (call is-role each) (has live each))))))
      (= (. stack views) kept)
    )
  )
  (fn-do _ layout-stacks (list PaneNode)
    (param owned PaneLayout)
    (let found (call (of List PaneNode) (call (. owned workspace stacks))))
    (for (in region (call (. owned regions)))
      (++= found (call (. region stacks)))
    )
    (return found)
  )
  (fn-do _ normalized (? PaneNode)
    (param node (? PaneNode))
    (param keeps (list String))
    (return-if null (if (not node)))
    (blank)
    (match (. node kind)
      (case= (. PaneNodeKind workspace)
        (return node)
      )
      (case= (. PaneNodeKind stack)
        (return (only-if node (if (or (> (. node views length) 0) (has keeps (. node id))))))
      )
      (case= (. PaneNodeKind split)
        (let kept (call (of List (? PaneNode)) (in (call normalized each keeps) (. node kids))))
        (let shares (call (of List Float) (in (call (. node size-at) each) (..< 0 (. node kids length)))))
        (for (in position (..< 0 (. kept length)))
          (if (not ([] kept position))
            (let taker (call share-taker kept position))
            (if (!= taker null)
              (+= ([] shares taker) ([] shares position))
            )
          )
        )
        (let kids (call (of List PaneNode)))
        (let sizes (call (of List Float)))
        (for (in position (..< 0 (. kept length)))
          (let kid ([] kept position))
          (if kid
            (let share ([] shares position))
            (if (and (. kid is-split) (== (. kid axis) (. node axis)) (not (. kid is-dock)))
              (let total (call max (call sum (. kid sizes)) 0.0001))
              (for (in inner (..< 0 (. kid kids length)))
                (+= kids ([] (. kid kids) inner))
                (+= sizes (/ (* share (call (. kid size-at) inner)) total))
              )
              (else
                (+= kids kid)
                (+= sizes share)
              )
            )
          )
        )
        (return-if null (if (== (. kids length) 0)))
        (blank)
        (if (== (. kids length) 1)
          (let only ([] kids 0))
          (= (. only is-dock) (or (. only is-dock) (. node is-dock)))
          (return only)
        )
        (= (. node kids) kids)
        (= (. node sizes) sizes)
        (return node)
      )
    )
  )
  (fn-do _ share-taker (? Index)
    (param kept (list (? PaneNode)))
    (param position Index)
    (let before (call last (in each (..< 0 position) (when ([] kept each)))))
    (let after (call first (in each (..< (+ position 1) (. kept length)) (when ([] kept each)))))
    (let wanted heir)
    (if wanted
      (return-if before (if (and (!= before null) (!= (call (. (!! ([] kept before)) find) wanted) null))))
      (return-if after (if (and (!= after null) (!= (call (. (!! ([] kept after)) find) wanted) null))))
    )
    (return (?? before after))
  )
  (fn-do _ normalize-all _
    (for (in owned (. layouts values))
      (call prune-views owned)
      (let keeps (call layout-keeps owned))
      (for (in region (call (. owned regions)))
        (= (. region root) (call normalized (. region root) keeps))
        (call settle-collapsed (. region root) false)
        (call sink-inlines (. region root) (. owned inlines))
        (let pages (call (of List PanePage)))
        (for (in page (. region pages))
          (let root (call normalized (. page root) keeps))
          (if root
            (= (. page root) root)
            (call settle-collapsed root false)
            (call sink-inlines root (. owned inlines))
            (+= pages page)
          )
        )
        (= (. region pages) pages)
      )
      (= (. owned center root) (?? (. owned center root) (call pane-workspace-node)))
      (= (. owned floats) (call (of List PaneRegion) (in each (. owned floats) (when (. each root)))))
      (let root (. owned workspace root))
      (let first (call (?. root first-stack)))
      (= (. owned workspace root) (call normalized root (call (of List String))))
      (if (not (. owned workspace root))
        (= (. owned workspace root) (call pane-stack-node (?? (?. first id) (call make-id "stack")) (call (of List String))))
      )
      (call settle-collapsed (. owned workspace root) false)
      (call sink-inlines (. owned workspace root) (. owned inlines))
      (for (in owner (call users-of owned))
        (call rehome owner)
      )
    )
    (= heir null)
  )
  (fn-do _ sink-inlines _
    (param node (? PaneNode))
    (param inlines (list String))
    (return-if (if (not node)))
    (blank)
    (for (in stack (call (. node stacks)))
      (let kept (call (of List String) (in each (. stack views) (when (not (has inlines each))))))
      (if (< (. kept length) (. stack views length))
        (= (. stack views) (++ kept (call (of List String) (in each (. stack views) (when (has inlines each))))))
      )
    )
  )
  (fn-do _ settle-collapsed _
    (param node (? PaneNode))
    (param stacked Bool)
    (return-if (if (not node)))
    (blank)
    (if (and (. node is-stack) (not stacked))
      (= (. node is-collapsed) false)
    )
    (for (in kid (. node kids))
      (call settle-collapsed kid (or stacked (and (. node is-split) (== (. node axis) (. PaneAxis column)))))
    )
  )
  (fn-do _ remove-view _
    (param owned PaneLayout)
    (param view String)
    (for (in stack (call layout-stacks owned))
      (-= (. stack views) view)
    )
  )
  (fn-do _ forget-instance _
    (param state PaneSession)
    (param view String)
    (-= ([] (. state instances) view))
    (for (in kind (call (of List String) (call (. state last-focus find) view)))
      (-= ([] (. state last-focus) kind))
    )
  )
  (fn-do _ insert-beside _
    (param region PaneRegion)
    (param target-id String)
    (param added PaneNode)
    (param zone PaneZone)
    (param vacated (? String))
    (let axis (if-expr (or (== zone (. PaneZone left)) (== zone (. PaneZone right))) (. PaneAxis row) (. PaneAxis column)))
    (let before (or (== zone (. PaneZone left)) (== zone (. PaneZone top))))
    (let found (call (. region find) target-id))
    (return-if (if (not found)))
    (blank)
    (let parent (. found parent))
    (if (and parent (. parent is-split) (== (. parent axis) axis) (not (. found node is-dock)))
      (while (< (. parent sizes length) (. parent kids length))
        (+= (. parent sizes) 1)
      )
      (let hole (call (. (call (of List String) (in (. each id) (. parent kids))) find) (?? vacated "")))
      (let live (call (of List Index) (in each (..< 0 (. parent kids length)) (when (and (> (call (. parent size-at) each) 0) (not (. ([] (. parent kids) each) is-collapsed)))))))
      (let even
        (block
          (case? (> (. live length) 0)
            (as (/ (call sum (in (call (. parent size-at) each) live)) (. live length)) Float)
          )
          (default
            1
          )
        )
      )
      (let share (if-expr (!= hole null) (call (. parent size-at) hole) even))
      (if (!= hole null)
        (= ([] (. parent sizes) hole) 0)
      )
      (let at (if-expr before (. found index) (+ (. found index) 1)))
      (call (. parent kids insert) added at)
      (call (. parent sizes insert) share at)
      (else
        (let kids (if-expr before (call (of List PaneNode) added (. found node)) (call (of List PaneNode) (. found node) added)))
        (let split (call pane-split-node (call make-id "split") axis kids (call (of List Float) 1 1)))
        (= (. split is-dock) (. found node is-dock))
        (= (. found node is-dock) false)
        (let page (. found page))
        (if parent
          (= ([] (. parent kids) (. found index)) split)
          (else-if page
            (= (. page root) split)
          )
          (else
            (= (. region root) split)
          )
        )
      )
    )
  )
  (fn-do _ detach (? PaneNode)
    (param region PaneRegion)
    (param node-id String)
    (param hole PaneNode)
    (let found (call (. region find) node-id))
    (return-if null (if (not found)))
    (blank)
    (let parent (. found parent))
    (let page (. found page))
    (if parent
      (= ([] (. parent kids) (. found index)) hole)
      (else-if page
        (= (. page root) hole)
      )
      (else
        (= (. region root) null)
      )
    )
    (= (. found node is-dock) false)
    (return (. found node))
  )
  (fn-do _ add-to-stack _
    (param scope PaneScope)
    (param stack-id String)
    (param view String)
    (param after (? String) (= null))
    (let state (call session))
    (let stack (call node-in scope stack-id))
    (return-if (if (not stack)))
    (blank)
    (let anchor (?? after (only-if ([] (. state active) (. stack id)) (if (== scope (. PaneScope workspace))))))
    (let position (call (. stack views find) (?? anchor "")))
    (call (. stack views insert) view (if-expr (!= position null) (+ position 1) (call tail-of stack)))
    (if (== scope (. PaneScope workspace))
      (= (. state workspace-focus) (. stack id))
    )
    (= ([] (. state active) stack-id) view)
  )
  (fn-do _ place-instance _
    (param view String)
    (param skip-near Bool)
    (return-if (if (call locate view)))
    (blank)
    (let state (call session))
    (let kind (?? ([] (. state instances) view) ""))
    (let near ([] (. state last-focus) kind))
    (let place (only-if (call locate near) (if (and (not skip-near) near (!= near view) (has (. state instances) near)))))
    (let placed ([] (. (call layout) placed) kind))
    (let usable (and placed (or (== placed pane-workspace-home) (!= (call stack-in (. PaneScope layout) placed) null))))
    (let home (if-expr usable placed ([] (. (call layout) homes) kind)))
    (if place
      (call add-to-stack (. place scope) (. place stack) view near)
      (else-if (and home (!= home pane-workspace-home) (call stack-in (. PaneScope layout) home))
        (call add-to-stack (. PaneScope layout) home view)
      )
      (else-if (== home pane-bottom-home)
        (let stack (call pane-stack-node (call make-id "stack") (call (of List String) view)))
        (= (. stack is-collapsed) true)
        (call insert-tree stack (. PaneTarget bottom) null view)
      )
      (else
        (let focused (call stack-in (. PaneScope workspace) (?? (. state workspace-focus) "")))
        (let stack (?? focused (call (?. (. (call layout) workspace root) first-stack))))
        (if stack
          (call add-to-stack (. PaneScope workspace) (. stack id) view)
        )
      )
    )
  )
  (fn-do _ reveal-in _
    (param view String)
    (let place (call locate view))
    (return-if (if (not place)))
    (blank)
    (let state (call session))
    (let stack (call stack-in (. place scope) (. place stack)))
    (if (not (call shows-buttons view))
      (= ([] (. state active) (. place stack)) view)
      (if stack
        (call unfold stack)
      )
    )
    (let page (. place page))
    (if (== (. place region kind) (. PaneRegionKind dock))
      (if (call in-menu view)
        (<- menu-requested view)
        (else-if (and page (call opens page))
          (= (. place region is-collapsed) false)
          (= ([] (. state pages) (. place region id)) (. page id))
        )
      )
      (else-if (== (. place region kind) (. PaneRegionKind float))
        (call raise-float (. place region id))
      )
    )
    (if (== (. place scope) (. PaneScope workspace))
      (= (. state workspace-focus) (. place stack))
    )
  )
  (fn-do _ restore-role _
    (param view String)
    (param side (? PaneSide) (= null))
    (let owned (call layout))
    (let home ([] (. owned closed) view))
    (let remembered (only-if (?? (call stack-in (. PaneScope layout) home) (call stack-in (. PaneScope workspace) home)) (if home)))
    (-= ([] (. owned closed) view))
    (if remembered
      (+= (. remembered views) view)
      (else-if side
        (+= (. (call (. owned dock) side) pages)
          (call PanePage
            (block
              (arg (call make-id "page"))
              (arg (call pane-stack-node (call make-id "stack") (call (of List String) view)))
            )
          )
        )
      )
      (else
        (call insert-tree (call pane-stack-node (call make-id "stack") (call (of List String) view)) (. PaneTarget bottom) null view)
      )
    )
  )
  (fn-do _ origin-of (? PaneTarget)
    (param region PaneRegion)
    (param node-id String)
    (param scope PaneScope)
    (let found (call (. region find) node-id))
    (return-if null (if (not found)))
    (blank)
    (let parent (. found parent))
    (if (not parent)
      (let page (. found page))
      (return-if (call pane-slot-target (. region side) (call pane-page-after (. region pages) (. page id))) (if (and page docked)))
      (blank)
      (lazy docked (== (. region kind) (. PaneRegionKind dock)))
      (return null)
    )
    (let after (> (. found index) 0))
    (let sibling (call (. ([] (. parent kids) (if-expr after (- (. found index) 1) 1)) first-stack)))
    (return-if null (if (not sibling)))
    (blank)
    (let zone
      (scope (if-expr (== (. parent axis) (. PaneAxis row)) row-zone column-zone)
        (lazy row-zone (if-expr after (. PaneZone right) (. PaneZone left)))
        (lazy column-zone (if-expr after (. PaneZone bottom) (. PaneZone top)))
      )
    )
    (return (call pane-stack-target scope (. sibling id) zone))
  )
  (fn-do _ join-into _
    (param tree PaneNode)
    (param target PaneNode)
    (param scope PaneScope)
    (param index (? Index))
    (param chosen (? String))
    (let state (call session))
    (let views (call pane-views (call (. tree stacks))))
    (let picked (?? chosen (call first (call visible-in tree))))
    (let shown (call tab-views target))
    (let tail (call tail-of target))
    (let at
      (scope (if-expr (and (!= index null) (< index (. shown length))) placed-at tail)
        (lazy placed-at (?? (call (. target views find) ([] shown index)) tail))
      )
    )
    (call (. target views insert) views at)
    (if (== scope (. PaneScope workspace))
      (= (. state workspace-focus) (. target id))
    )
    (if picked
      (= ([] (. state active) (. target id)) picked)
    )
  )
  (fn-do _ tail-of Index
    (param stack PaneNode)
    (let inlines (. (call layout) inlines))
    (return (?? (call first (in each (..< 0 (. stack views length)) (when (has inlines ([] (. stack views) each))))) (. stack views length)))
  )
  (fn-do _ apply-drop _
    (param drag PaneDrag)
    (param incoming PaneTarget)
    (let owned (call layout))
    (let target incoming)
    (let tree (? PaneNode) null)
    (let origin (? PaneTarget) null)
    (let chosen (? String) null)
    (let hole (call pane-stack-node (call make-id "stack") (call (of List String))))
    (let vacated (? String) null)
    (if (. drag view)
      (let view (. drag view))
      (if (and (is target .stack) (== (. target zone) (. PaneZone center)) (== (. target stack) (. drag stack)))
        (let index (. target index))
        (let stack (call stack-in (. target scope) (. target stack)))
        (if (and stack (!= index null))
          (let from (call (. (call tab-views stack) find) view))
          (if (and (!= from null) (< from index))
            (= target (call pane-stack-target (. target scope) (. target stack) (. target zone) (- index 1)))
          )
        )
      )
      (= origin (call pane-stack-target (. drag scope) (. drag stack) (. PaneZone center)))
      (call remove-view owned view)
      (let source (call stack-in (. drag scope) (. drag stack)))
      (if (and source (== (. source views length) 0) (not (has (call layout-keeps owned) (. source id))))
        (= vacated (. drag stack))
      )
      (= tree (call pane-stack-node (call make-id "stack") (call (of List String) view)))
      (= chosen view)
      (else
        (let region (call region-in (. drag scope) (. drag stack)))
        (return-if (if (not region)))
        (blank)
        (= origin (call origin-of region (. drag stack) (. drag scope)))
        (= tree (call detach region (. drag stack) hole))
        (= vacated (. hole id))
      )
    )
    (return-if (if (not tree)))
    (blank)
    (call insert-tree tree target origin chosen vacated)
  )
  (fn-do _ insert-tree _
    (param tree PaneNode)
    (param target PaneTarget)
    (param origin (? PaneTarget))
    (param chosen (? String))
    (param vacated (? String) (= null))
    (let owned (call layout))
    (let state (call session))
    (let first (call (. tree first-stack)))
    (= heir (if-expr (and (is target .stack) (== (. target zone) (. PaneZone center))) (. target stack) (?. first id)))
    (match target
      (case (call .float x y width height)
        (let region (call PaneRegion (. PaneRegionKind float) (call make-id "float")))
        (= (. region x) x)
        (= (. region y) y)
        (= (. region width) width)
        (= (. region height) height)
        (= (. region root) tree)
        (= (. region origin) origin)
        (+= (. owned floats) region)
      )
      (case (call .slot side before)
        (let region (call (. owned dock) side))
        (call (. region pages insert)
          (block
            (arg (call PanePage (call make-id "page") tree))
            (arg (?? (call (. region page-index) before) (. region pages length)))
          )
        )
      )
      (case= .bottom
        (let joined (call (?. (call bottom-node) first-stack)))
        (if joined
          (= heir (. joined id))
          (call join-into tree joined (. PaneScope layout) null chosen)
          (return)
        )
        (= (. owned center root) (call pane-with-bottom (. owned center root) tree (call make-id "split")))
      )
      (case (call .stack scope stack-id zone index)
        (if (== zone (. PaneZone center))
          (let stack (call stack-in scope stack-id))
          (if stack
            (call join-into tree stack scope index chosen)
          )
          (return)
        )
        (let region (call region-in scope stack-id))
        (return-if (if (not region)))
        (blank)
        (call insert-beside region stack-id tree zone vacated)
        (if (and first (== scope (. PaneScope workspace)))
          (= (. state workspace-focus) (. first id))
        )
      )
    )
    (if (and first chosen)
      (= ([] (. state active) (. first id)) chosen)
    )
  )
  (fn-do _ copy-layout (? PaneLayout)
    (param source PaneLayout)
    (param id String)
    (param name String)
    (param base (? String))
    (let copied (catch? (call pane-layout-from (call JSONReader "layout" (. source json)))))
    (return-if null (if (not copied)))
    (blank)
    (= (. copied id) id)
    (= (. copied name) name)
    (= (. copied is-shared) (not base))
    (= (. copied base) base)
    (= ([] layouts id) copied)
    (return copied)
  )
  (fn-expr _ base-of String
    (param owned PaneLayout)
    (case? (. owned is-shared)
      (. owned id)
    )
    (case? (and base (has layouts base))
      base
    )
    (default
      ([] (call (of List String) (. layouts keys)) 0)
    )
    (where
      (lazy base (. owned base))
    )
  )
  (fn-do _ rehome _
    (param owner PaneContext)
    (let state (call session-of owner))
    (let located (call (of Map String Bool)))
    (for (in stack (call layout-stacks (call layout-of owner)))
      (for (in view (. stack views))
        (= ([] located view) true)
      )
    )
    (let lost (call (of List String) (in each (. state instances keys) (when (not (has located each))))))
    (return-if (if (== (. lost length) 0)))
    (blank)
    (let saved current)
    (= current (. owner id))
    (for (in view lost)
      (call place-instance view true)
    )
    (= current saved)
  )
)

(fn-expr + pane-stack-node PaneNode
  (param id String)
  (param views (list String))
  (call PaneNode (. PaneNodeKind stack) id (:views views))
)

(fn-expr + pane-split-node PaneNode
  (param id String)
  (param axis PaneAxis)
  (param kids (list PaneNode))
  (param sizes (list Float))
  (call PaneNode (. PaneNodeKind split) id (:axis axis) (:kids kids) (:sizes sizes))
)

(fn-expr + pane-workspace-node PaneNode
  (call PaneNode (. PaneNodeKind workspace) pane-workspace-home)
)

(fn-expr + pane-view-drag PaneDrag
  (param view String)
  (param scope PaneScope)
  (param stack String)
  (call PaneDrag view scope stack)
)

(fn-expr + pane-node-drag PaneDrag
  (param node String)
  (param scope PaneScope)
  (call PaneDrag null scope node)
)

(fn-expr + pane-arrival-drag PaneDrag
  (param view String)
  (call PaneDrag view (. PaneScope workspace) "")
)

(fn-expr + pane-stack-target PaneTarget
  (param scope PaneScope)
  (param stack String)
  (param zone PaneZone)
  (param index (? Index) (= null))
  (call (. PaneTarget stack) scope stack zone index)
)

(fn-expr + pane-slot-target PaneTarget
  (param side PaneSide)
  (param before (? String) (= null))
  (call (. PaneTarget slot) side before)
)

(fn-expr + pane-float-target PaneTarget
  (param x Float)
  (param y Float)
  (param width Float)
  (param height Float)
  (call (. PaneTarget float) x y width height)
)

(type _ PaneFound (is Tuple)
  (prop + node PaneNode)
  (prop + parent (? PaneNode))
  (prop + index Index)
  (prop + page (? PanePage))
)

(fn-do _ pane-with-bottom PaneNode
  (param root (? PaneNode))
  (param node PaneNode)
  (param id String)
  (= (. node is-dock) true)
  (return
    (call pane-split-node
      (block
        (arg id)
        (arg (. PaneAxis column))
        (arg (call (of List PaneNode) (?? root (call pane-workspace-node)) node))
        (arg (call (of List Float) (- 1 pane-bottom-share) pane-bottom-share))
      )
    )
  )
)

(fn-expr _ pane-node-from PaneNode (?! Error)
  (param reader JSONReader)
  (call PaneNode (as (call (. ([] fields "kind") int)) PaneNodeKind) (call (. ([] fields "id") string))
    (block
      (:views (call (of List String) (in (call (. each string)) (call (. ([] fields "views") items)))))
      (:axis (as (call (. ([] fields "axis") int)) PaneAxis))
      (:kids (call (of List PaneNode) (in (call pane-node-from each) (call (. ([] fields "kids") items)))))
      (:sizes (call (of List Float) (in (call (. each number)) (call (. ([] fields "sizes") items)))))
      (:is-collapsed (call (. ([] fields "collapsed") bool)))
      (:is-dock (call (. ([] fields "dock") bool)))
    )
  )
  (where
    (lazy fields (call (. reader object)))
  )
)

(fn-do _ pane-origin-from (? PaneTarget) (?! Error)
  (param reader JSONReader)
  (return-if null (if (not (. reader is-present))))
  (blank)
  (let fields (call (. reader object)))
  (return-if (. PaneTarget bottom) (if (. ([] fields "bottom") is-present)))
  (blank)
  (let slot ([] fields "slot"))
  (if (. slot is-present)
    (let before (? String) null)
    (= before (only-if (call (. ([] fields "before") string)) (if (. ([] fields "before") is-present))))
    (return (call pane-slot-target (as (call (. slot int)) PaneSide) before))
  )
  (let zone (as (call (. ([] fields "zone") int)) PaneZone))
  (return (call pane-stack-target (as (call (. ([] fields "scope") int)) PaneScope) (call (. ([] fields "stack") string)) zone))
)

(fn-expr _ pane-page-from PanePage (?! Error)
  (param reader JSONReader)
  (call PanePage (call (. ([] fields "id") string)) (call pane-node-from ([] fields "root")))
  (where
    (lazy fields (call (. reader object)))
  )
)

(fn-do _ pane-region-from PaneRegion (?! Error)
  (param reader JSONReader)
  (let fields (call (. reader object)))
  (let root ([] fields "root"))
  (let region (call PaneRegion (as (call (. ([] fields "kind") int)) PaneRegionKind) (call (. ([] fields "id") string))))
  (= (. region side) (as (call (. ([] fields "side") int)) PaneSide))
  (= (. region root) (only-if (call pane-node-from root) (if (. root is-present))))
  (= (. region pages) (call (of List PanePage) (in (call pane-page-from each) (call (. ([] fields "pages") items)))))
  (= (. region strip) (as (call (. ([] fields "strip") int)) PaneStripMode))
  (= (. region size) (call (. ([] fields "size") number)))
  (= (. region is-collapsed) (call (. ([] fields "collapsed") bool)))
  (= (. region x) (call (. ([] fields "x") number)))
  (= (. region y) (call (. ([] fields "y") number)))
  (= (. region width) (call (. ([] fields "width") number)))
  (= (. region height) (call (. ([] fields "height") number)))
  (= (. region origin) (call pane-origin-from ([] fields "origin")))
  (return region)
)

(fn-do _ pane-layout-from PaneLayout (?! Error)
  (param reader JSONReader)
  (let fields (call (. reader object)))
  (let layout (call PaneLayout (call (. ([] fields "id") string)) (call (. ([] fields "name") string))))
  (= (. layout is-shared) (call (. ([] fields "shared") bool)))
  (= (. layout base) (only-if (call (. ([] fields "base") string)) (if (. ([] fields "base") is-present))))
  (= (. layout left) (call pane-region-from ([] fields "left")))
  (= (. layout right) (call pane-region-from ([] fields "right")))
  (= (. layout center) (call pane-region-from ([] fields "center")))
  (= (. layout workspace) (call pane-region-from ([] fields "workspace")))
  (= (. layout floats) (call (of List PaneRegion) (in (call pane-region-from each) (call (. ([] fields "floats") items)))))
  (= (. layout homes) (call pane-string-map-from ([] fields "homes")))
  (= (. layout placed) (call pane-string-map-from ([] fields "placed")))
  (= (. layout closed) (call pane-string-map-from ([] fields "closed")))
  (= (. layout menus) (call (of List String) (in (call (. each string)) (call (. ([] fields "menus") items)))))
  (= (. layout inlines) (call (of List String) (in (call (. each string)) (call (. ([] fields "inlines") items)))))
  (return layout)
)

(fn-do _ pane-session-from PaneSession (?! Error)
  (param reader JSONReader)
  (let fields (call (. reader object)))
  (let session (call PaneSession))
  (= (. session active) (call pane-string-map-from ([] fields "active")))
  (= (. session pages) (call pane-string-map-from ([] fields "pages")))
  (= (. session instances) (call pane-string-map-from ([] fields "instances")))
  (= (. session last-focus) (call pane-string-map-from ([] fields "lastFocus")))
  (let focus ([] fields "workspaceFocus"))
  (= (. session workspace-focus) (only-if (call (. focus string)) (if (. focus is-present))))
  (return session)
)

(fn-expr _ pane-visit-json JSON
  (param visit PaneVisit)
  (call (of Map String JSON)
    (block
      (:context (. visit context))
      (:view (. visit view))
    )
  )
)

(fn-expr _ pane-visit-from PaneVisit
  (param fields JSONObjectReader)
  (call PaneVisit (call (. ([] fields "context") string)) (call (. ([] fields "view") string)))
)

(fn-expr _ same-visit Bool
  (param left PaneVisit)
  (param right PaneVisit)
  (and (== (. left context) (. right context)) (== (. left view) (. right view)))
)

(fn-expr _ pane-renamed-visit PaneVisit
  (param visit PaneVisit)
  (param context String)
  (param old String)
  (param view String)
  (if-expr (and (== (. visit context) context) (== (. visit view) old)) (call PaneVisit context view) visit)
)

(fn-do _ pane-string-map-from (map String String) (?! Error)
  (param reader JSONReader)
  (let found (call (of Map String String)))
  (return-if found (if (not (. reader is-present))))
  (blank)
  (for (in (tuple key value) (. (call (. reader object)) fields))
    (= ([] found key) (call (. (call JSONReader key value) string)))
  )
  (return found)
)

(fn-expr _ (of pane-map-json Value) (map String JSON)
  (param map (map String Value))
  (call (of Map String JSON) (in (tuple (. each key) (as (. each value) JSON)) (. map items)))
)

(fn-expr _ pane-page-after (? String)
  (param pages (list PanePage))
  (param page-id String)
  (if-expr (or (== index null) (>= (+ index 1) (. pages length))) null (. ([] pages (+ index 1)) id))
  (where
    (lazy index (call first (in each (..< 0 (. pages length)) (when (== (. ([] pages each) id) page-id)))))
  )
)

(fn-expr _ pane-views (list String)
  (param stacks (stream PaneNode))
  (call (of List String) (call flat-map (in (. each views) stacks)))
)
