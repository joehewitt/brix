./input
/stream/aggregate

━━━━━━━━━━━━━━━━━━━━
+ KeyTrigger is Union

| none
| key Key
| characters String

━━━━━━━━━━━━━━━━━━━━
+ KeyModifier is Union

| shift
| control
| option
| command

────────────────────
+ this + that KeyModifier

KeyCombo(this) + that

────────────────────
+ this + combo KeyCombo

KeyCombo(this) + combo

────────────────────
+ this + key Key

KeyCombo(this) + key

────────────────────
+ this + characters String

KeyCombo(this) + characters

━━━━━━━━━━━━━━━━━━━━
+ KeyCombo is Tuple

+ modifiers PointerModifiers = PointerModifiers()
+ trigger KeyTrigger = KeyTrigger.none
+ display-label => key-combo-label(this, key-combo-trigger-label(trigger))
+ symbol-label => key-combo-symbol-label(this)

────────────────────
+ This

────────────────────
+ This
    - key Key

= key-combo-key(key)

────────────────────
+ This
    - characters String

= match characters
    ~ This
        it
    ??
        key-combo-characters(characters)

────────────────────
+ This
    - modifier KeyModifier

= key-combo-from-modifier(modifier)

────────────────────
+ This ~ Char

~ mods \key-combo-modifier-plus* pressed \key-combo-trigger \key-combo-ws
    reduce(pressed, mods) • using :: combo, modifier => combo + modifier

.. key-combo-modifier-plus KeyCombo ~
    ~ \key-combo-ws modifier \key-combo-modifier \key-combo-ws "+" \key-combo-ws
        modifier

.. key-combo-modifier KeyCombo ~
    ~ "Shift" | "shift"
        key-combo-modifiers(true)
    ~ "Ctrl" | "ctrl" | "Control" | "control"
        key-combo-modifiers(false, true)
    ~ "Option" | "option" | "Alt" | "alt"
        key-combo-modifiers(false, false, true)
    ~ "Cmd" | "cmd" | "Command" | "command" | "Meta" | "meta"
        key-combo-modifiers(false, false, false, true)

.. key-combo-trigger KeyCombo ~
    ~ "Tab" | "tab"
        key-combo-key(Key.tab)
    ~ "Enter" | "enter" | "Return" | "return"
        key-combo-key(Key.enter)
    ~ "Esc" | "esc" | "Escape" | "escape"
        key-combo-key(Key.escape)
    ~ "Space" | "space"
        key-combo-key(Key.space)
    ~ "Home" | "home"
        key-combo-key(Key.home)
    ~ "End" | "end"
        key-combo-key(Key.end)
    ~ "PageUp" | "pageUp" | "Page-Up" | "page-up"
        key-combo-key(Key.page-up)
    ~ "PageDown" | "pageDown" | "Page-Down" | "page-down"
        key-combo-key(Key.page-down)
    ~ "Backspace" | "backspace"
        key-combo-key(Key.backspace)
    ~ "Delete" | "delete"
        key-combo-key(Key.delete)
    ~ "Up" | "up" | "ArrowUp" | "arrowUp" | "Arrow-Up" | "arrow-up"
        key-combo-key(Key.arrow-up)
    ~ "Down" | "down" | "ArrowDown" | "arrowDown" | "Arrow-Down" | "arrow-down"
        key-combo-key(Key.arrow-down)
    ~ "Left" | "left" | "ArrowLeft" | "arrowLeft" | "Arrow-Left" | "arrow-left"
        key-combo-key(Key.arrow-left)
    ~ "Right" | "right" | "ArrowRight" | "arrowRight" | "Arrow-Right" | "arrow-right"
        key-combo-key(Key.arrow-right)
    ~ ("F" | "f") number I32
        key-combo-function-key(number)
    ~ char .
        key-combo-characters(char)

.. key-combo-ws ~
    ~ (" " | "\t")*

────────────────────
+ to String

key-combo-label(this, key-combo-trigger-spec(trigger))

────────────────────
+ from characters String

This(characters)

────────────────────
+ from character Char

key-combo-characters("$character")

────────────────────
+ from key Key

This(key)

────────────────────
+ from modifier KeyModifier

This(modifier)

────────────────────
+ this + that KeyCombo

KeyCombo(key-combo-merged-modifiers(this, that), merged-trigger)

.. merged-trigger = if that.trigger != KeyTrigger.none then that.trigger else this.trigger

────────────────────
+ this + modifier KeyModifier

this + KeyCombo(modifier)

────────────────────
+ this + key Key

this + KeyCombo(key)

────────────────────
+ this + characters String

this + key-combo-characters(characters)

────────────────────
+ matches-key
    - key Key
    - characters String
    - modifiers PointerModifiers

match trigger
    | KeyTrigger.key(expected)
        expected == key && key-combo-modifiers-match(this, modifiers)
    | KeyTrigger.characters(expected)
        key-combo-characters-match(expected, characters) && modifiers-fit
    ??
        false

.. modifiers-fit = key-combo-character-modifiers-match(this, modifiers)

────────────────────
+ matches-text
    - text String

match trigger
    | KeyTrigger.characters(expected)
        !wants-command-modifier && key-combo-characters-match(expected, text)
    ??
        false

    .. wants-command-modifier = modifiers.control || modifiers.option || modifiers.command

────────────────────
+ is-modifier-only

trigger == KeyTrigger.none && has-modifier

.. has-modifier = modifiers.shift || modifiers.control || modifiers.option || modifiers.command

────────────────────
+ matches-modifiers
    - pressed PointerModifiers

is-modifier-only() && key-combo-modifiers-match(this, pressed)

────────────────────
+ is-printable-input

match trigger
    | KeyTrigger.characters(characters)
        !modifiers.control && !modifiers.option && !modifiers.command
    | KeyTrigger.key(pressed)
        pressed == Key.space && !modifiers.control && !modifiers.option && !modifiers.command
    ??
        false

────────────────────
+ is-text-editing

match trigger
    | KeyTrigger.key(pressed)
        text-editing-key(pressed) && !modifiers.control && !is-command-enter

        .. is-command-enter = pressed == Key.enter && modifiers.command
    ??
        false

────────────────────
+ is-text-input

is-printable-input() || is-text-editing()

────────────────────
+ is-focus-navigation

trigger == KeyTrigger.key(Key.tab)

━━━━━━━━━━━━━━━━━━━━
_ key-combo-function-key
    - number I32

|? number >= 1 && number <= 16
    key-combo-key(Key.function-key(number as U32))
??
    KeyCombo()

━━━━━━━━━━━━━━━━━━━━
_ key-combo-from-modifier
    - modifier KeyModifier

match modifier
    | KeyModifier.shift
        key-combo-modifiers(true)
    | KeyModifier.control
        key-combo-modifiers(false, true)
    | KeyModifier.option
        key-combo-modifiers(false, false, true)
    | KeyModifier.command
        key-combo-modifiers(false, false, false, true)

━━━━━━━━━━━━━━━━━━━━
_ key-combo-modifiers
    - shift Bool = false
    - control Bool = false
    - option Bool = false
    - command Bool = false

KeyCombo(PointerModifiers(shift, control, option, command), KeyTrigger.none)

━━━━━━━━━━━━━━━━━━━━
_ key-combo-key
    - key Key

KeyCombo(PointerModifiers(), KeyTrigger.key(key))

━━━━━━━━━━━━━━━━━━━━
_ key-combo-characters
    - characters String

KeyCombo(PointerModifiers(), KeyTrigger.characters(characters))

━━━━━━━━━━━━━━━━━━━━
_ key-combo-merged-modifiers
    - left KeyCombo
    - right KeyCombo

PointerModifiers
    - left.modifiers.shift || right.modifiers.shift
    - left.modifiers.control || right.modifiers.control
    - left.modifiers.option || right.modifiers.option
    - left.modifiers.command || right.modifiers.command

━━━━━━━━━━━━━━━━━━━━
_ key-combo-modifiers-match
    - combo KeyCombo
    - event PointerModifiers

|? shift-matches && control-matches && option-matches
    combo.modifiers.command == event.command
??
    false

.. shift-matches = combo.modifiers.shift == event.shift
.. control-matches = combo.modifiers.control == event.control
.. option-matches = combo.modifiers.option == event.option

━━━━━━━━━━━━━━━━━━━━
_ key-combo-characters-match
    - expected String
    - actual String

|? !expected || !actual
    false
??
    expected.lowercased == actual.lowercased

━━━━━━━━━━━━━━━━━━━━
_ key-combo-character-modifiers-match
    - combo KeyCombo
    - event PointerModifiers

|? shift-matches && control-matches && option-matches
    combo.modifiers.command == event.command
??
    false

.. shift-matches = !combo.modifiers.shift || event.shift
.. control-matches = combo.modifiers.control == event.control
.. option-matches = combo.modifiers.option == event.option

━━━━━━━━━━━━━━━━━━━━
_ key-combo-label
    - combo KeyCombo
    - trigger String

"+".join(key-combo-labels(combo, trigger))

━━━━━━━━━━━━━━━━━━━━
_ key-combo-labels [String]
    - combo KeyCombo
    - trigger String

*? "Cmd" if combo.modifiers.command
*? "Option" if combo.modifiers.option
*? "Ctrl" if combo.modifiers.control
*? "Shift" if combo.modifiers.shift
*? trigger if trigger

━━━━━━━━━━━━━━━━━━━━
_ key-combo-symbol-label
    - combo KeyCombo

"".join(key-combo-symbols(combo))

━━━━━━━━━━━━━━━━━━━━
_ key-combo-symbols [String]
    - combo KeyCombo

*? "⌃" if combo.modifiers.control
*? "⌥" if combo.modifiers.option
*? "⇧" if combo.modifiers.shift
*? "⌘" if combo.modifiers.command
*? key-combo-trigger-symbol(combo.trigger) if combo.trigger != KeyTrigger.none

━━━━━━━━━━━━━━━━━━━━
_ key-combo-trigger-symbol
    - trigger KeyTrigger

match trigger
    | KeyTrigger.characters(characters)
        characters.uppercased
    | KeyTrigger.key(key)
        key-combo-key-symbol(key)
    ??
        ""

━━━━━━━━━━━━━━━━━━━━
_ key-combo-key-symbol
    - key Key

match key
    | Key.tab
        "⇥"
    | Key.enter
        "↩"
    | Key.escape
        "⎋"
    | Key.space
        "Space"
    | Key.arrow-up
        "↑"
    | Key.arrow-down
        "↓"
    | Key.arrow-left
        "←"
    | Key.arrow-right
        "→"
    | Key.home
        "↖"
    | Key.end
        "↘"
    | Key.page-up
        "⇞"
    | Key.page-down
        "⇟"
    | Key.backspace
        "⌫"
    | Key.delete
        "⌦"
    | Key.function-key(index)
        "F$index"
    ??
        ""

━━━━━━━━━━━━━━━━━━━━
_ key-combo-trigger-label
    - trigger KeyTrigger

match trigger
    | KeyTrigger.characters(characters)
        characters.uppercased
    | KeyTrigger.key(key)
        key-combo-key-label(key)
    ??
        ""

━━━━━━━━━━━━━━━━━━━━
_ key-combo-trigger-spec
    - trigger KeyTrigger

match trigger
    | KeyTrigger.characters(characters)
        characters
    | KeyTrigger.key(key)
        key-combo-key-spec(key)
    ??
        ""

━━━━━━━━━━━━━━━━━━━━
_ key-combo-key-spec
    - key Key

match key
    | Key.page-up
        "PageUp"
    | Key.page-down
        "PageDown"
    ??
        key-combo-key-label(key)

━━━━━━━━━━━━━━━━━━━━
_ key-combo-key-label
    - key Key

match key
    | Key.tab
        "Tab"
    | Key.enter
        "Enter"
    | Key.escape
        "Esc"
    | Key.space
        "Space"
    | Key.arrow-up
        "Up"
    | Key.arrow-down
        "Down"
    | Key.arrow-left
        "Left"
    | Key.arrow-right
        "Right"
    | Key.home
        "Home"
    | Key.end
        "End"
    | Key.page-up
        "Page Up"
    | Key.page-down
        "Page Down"
    | Key.backspace
        "Backspace"
    | Key.delete
        "Delete"
    | Key.function-key(index)
        "F$index"
    ??
        ""

━━━━━━━━━━━━━━━━━━━━
+ text-editing-key
    - key Key

match key
    |= Key.backspace
        true
    |= Key.delete
        true
    |= Key.arrow-left
        true
    |= Key.arrow-right
        true
    |= Key.arrow-up
        true
    |= Key.arrow-down
        true
    |= Key.home
        true
    |= Key.end
        true
    |= Key.page-up
        true
    |= Key.page-down
        true
    |= Key.enter
        true
    ??
        false
