(import ./command-history)
(import ./command-parameters)
(import ./value-change-phase)
(import /data/json)
(import /math)
(import /stream/aggregate)
(import /time/duration)
(import /time/timer)

(type + (of ParameterizedCommand Args) (is Interface)
  (fn-expr + kind String :get)
  (fn-do + title String
    (param args Args)
  )
  (fn-do + sentence (list CommandSentencePart)
    (param args Args)
  )
  (fn-do + execute _ (?! Error)
    (param args Args)
  )
  (fn-do + encode JSON (?! Error)
    (param args Args)
  )
  (fn-do + decode Args (?! Error)
    (param json JSON)
    (throw (call Error (str kind " cannot be decoded")))
  )
  (fn-expr + replacing (? Args)
    (param args Args)
    (param key String)
    (param value CommandParameterValue)
    null
  )
  (fn-expr + reverts Bool
    (param args Args)
    false
  )
  (fn-do + revert _ (?! Error)
    (param args Args)
    (throw (call Error (str (call title args) " cannot be reverted")))
  )
  (fn-expr + defaults (? Args) :get
    null
  )
)

(type + Invocation (is Interface)
  (fn-expr + id U64 :get)
  (fn-expr + kind String :get)
  (fn-expr + title String :get)
  (fn-expr + sentence (list CommandSentencePart) :get)
  (fn-do + execute _ (?! Error))
  (fn-do + encode JSON (?! Error))
  (fn-expr + reverts Bool :get)
  (fn-do + revert _ (?! Error))
  (fn-expr + replacing (? Invocation)
    (param key String)
    (param value CommandParameterValue)
  )
)

(type + (of StoredInvocation Args) (is Tuple)
  (implements Invocation)
  (prop + id U64)
  (prop + command (of ParameterizedCommand Args))
  (prop + args Args)
  (fn-expr + kind _ :get
    (. command kind)
  )
  (fn-expr + title _ :get
    (call (. command title) args)
  )
  (fn-expr + sentence _ :get
    (call (. command sentence) args)
  )
  (fn-do + execute _ (?! Error)
    (call (. command execute) args)
  )
  (fn-expr + encode JSON (?! Error)
    (call (. command encode) args)
  )
  (fn-expr + reverts _ :get
    (call (. command reverts) args)
  )
  (fn-do + revert _ (?! Error)
    (call (. command revert) args)
  )
  (fn-expr + replacing (? Invocation)
    (param key String)
    (param value CommandParameterValue)
    (match? (call (. command replacing) args key value)
      (case Args
        (call (of StoredInvocation Args) id command it)
      )
    )
  )
)

(type + CommandReplayKind (is U8)
  (variant explicit)
  (variant parameter-edit)
  (variant history)
  (variant scrub)
  (variant rebuild)
  (variant structure)
  (variant recording)
)

(type + CommandLogTarget (is Interface)
  (fn-do + will-begin _)
  (fn-do + restore Index
    (param position Index)
    (param kind CommandReplayKind)
  )
  (fn-do + executed _
    (param position Index)
    (param cost Duration)
  )
  (fn-do + changed _
    (param position Index)
  )
  (fn-do + did-replay _
    (param kind CommandReplayKind)
  )
  (fn-do + pin _
    (param position Index)
    (param pinned Bool)
  )
  (fn-expr + fold-point (? Index)
    (param minimum Index)
    null
  )
  (fn-do + folded _
    (param count Index)
  )
)

(type + EditableLog (is Interface)
  (fn-expr + revision U64 :get)
  (fn-expr + length Index :get)
  (fn-do + step-id U64
    (param index Index)
  )
  (fn-do + step-title String
    (param index Index)
  )
  (fn-do + step-sentence (list CommandSentencePart)
    (param index Index)
  )
  (fn-do + step-failure (? String)
    (param index Index)
  )
  (fn-do + edit-parameter Bool
    (param id U64)
    (param key String)
    (param value CommandParameterValue)
    (param phase ValueChangePhase)
  )
  (fn-do + cancel-edit Bool
    (param id U64)
  )
)

(type + (of CommandLog Step)
  (implements EditableLog)
  (prop + revision U64 (= 0))
  (prop + failures-revision U64 (= 0))
  (prop + position Index)
  (prop + step-limit Size (= 0))
  (prop + target (? CommandLogTarget))
  (prop + history (? CommandHistory))
  (prop + steps (list Step) (= (call (of List Step))))
  (prop + next-id U64 (= 0))
  (blank)
  (prop _ begun _ (= false))
  (prop _ ran (list Step) (= (call (of List Step))))
  (prop _ failures (of Map U64 String))
  (prop _ live-before (? Step))
  (prop _ live-changed _ (= false))
  (prop _ live-pin (? Index))
  (fn-do + This _
    (param target (? CommandLogTarget) (= null))
    (param history (? CommandHistory) (= null))
  )
  (fn-expr + length Index :get
    (. steps length)
  )
  (fn-expr + (index-get this (param index Index)) _
    ([] steps index)
  )
  (fn-expr + end Index :get
    (. steps length)
  )
  (fn-expr + is-editing _ :get
    (!= live-before null)
  )
  (fn-do + index-of (? Index)
    (param id U64)
    (for (in index (..< 0 (. steps length)))
      (return-if index (if (== (. ([] steps index) id) id)))
    )
    (return null)
  )
  (fn-expr + position-of Index
    (param index Index)
    index
  )
  (fn-do + claim-id U64
    (+= next-id 1)
    (return next-id)
  )
  (fn-do + prepare-recording _
    (return-if (if begun))
    (= begun true)
    (call (?. target will-begin))
  )
  (fn-do + place _
    (param index Index)
    (param step Step)
    (let tick (call position-of index))
    (call (. steps insert) step index)
    (+= revision 1)
    (call invalidate tick)
  )
  (fn-do + place-after Index
    (param step Step)
    (param previous (? U64))
    (let found (only-if (call index-of previous) (if previous)))
    (let index (if-expr (!= found null) (+ found 1) 0))
    (call place index step)
    (return index)
  )
  (fn-do + remove Step
    (param index Index)
    (let tick (call position-of index))
    (let step ([] steps index))
    (call (. steps remove) index)
    (+= revision 1)
    (call invalidate tick)
    (return step)
  )
  (fn-do + replace _
    (param index Index)
    (param step Step)
    (let tick (call position-of index))
    (= ([] steps index) step)
    (+= revision 1)
    (call invalidate tick)
  )
  (fn-do + invalidate _
    (param tick Index)
    (call (?. target changed) tick)
  )
  (fn-do + record _
    (param step Step)
    (param cost Duration (= 0ns))
    (call prepare-recording)
    (let index end)
    (let previous (? U64) (only-if (. ([] steps (- index 1)) id) (if index)))
    (call place index step)
    (+= ran step)
    (+= position 1)
    (call (?. target executed) position cost)
    (call (?. history record) (. step title) (call (of CommandLogInsertEntry Step) this step previous))
    (call fold)
  )
  (fn-do + perform Step (?! Error)
    (param step Step)
    (call prepare-recording)
    (let started (call monotonic-time-nanoseconds))
    (call (. step execute))
    (call record step (as (- (call monotonic-time-nanoseconds) started) Nanoseconds))
    (return step)
  )
  (fn-do + insert Step
    (param index Index)
    (param step Step)
    (call prepare-recording)
    (let position (call min index (. steps length)))
    (let previous (? U64) (only-if (. ([] steps (- position 1)) id) (if position)))
    (call place position step)
    (call (?. history record) (str "Insert " (. step title)) (call (of CommandLogInsertEntry Step) this step previous))
    (call replay (. CommandReplayKind structure) position)
    (call fold)
    (return step)
  )
  (fn-do + delete Bool
    (param id U64)
    (let index (call index-of id))
    (return-if false (if (== index null)))
    (let previous (? U64) (only-if (. ([] steps (- index 1)) id) (if index)))
    (let step (call remove index))
    (call (?. history record) (str "Delete " (. step title)) (call (of CommandLogRemoveEntry Step) this step previous))
    (call replay (. CommandReplayKind structure) index)
    (return true)
  )
  (fn-do + move Bool
    (param id U64)
    (param slot Index)
    (let first (call index-of id))
    (return-if false (if (== first null)))
    (let wanted (call min slot (- (. steps length) 1)))
    (return-if false (if (== wanted first)))
    (let origin (? U64) (only-if (. ([] steps (- first 1)) id) (if first)))
    (let step (call remove first))
    (let landing (? U64) (only-if (. ([] steps (- wanted 1)) id) (if wanted)))
    (call place wanted step)
    (call (?. history record) (str "Move " (. step title)) (call (of CommandLogMoveEntry Step) this id 1 origin landing))
    (call replay (. CommandReplayKind structure) (call min first wanted))
    (return true)
  )
  (fn-do + edit Bool
    (param id U64)
    (param key String)
    (param value CommandParameterValue)
    (param title String)
    (param phase _ (= (. ValueChangePhase discrete)))
    (let index (call index-of id))
    (return-if false (if (== index null)))
    (return (call apply-edit index title phase (call (. ([] steps index) replacing) key value)))
  )
  (fn-do + apply-edit Bool
    (param index Index)
    (param title String)
    (param phase ValueChangePhase)
    (param replacement (? Step))
    (let original (?? live-before ([] steps index)))
    (let live (or (== phase (. ValueChangePhase began)) (== phase (. ValueChangePhase changed))))
    (if (and live (not live-pin))
      (let pinned (call position-of index))
      (= live-pin pinned)
      (call (?. target pin) pinned true)
    )
    (if replacement
      (call replace index (call adjusted index replacement))
      (call replay (. CommandReplayKind parameter-edit) index)
    )
    (if live
      (= live-before original)
      (= live-changed (or live-changed (!= replacement null)))
      (return (!= replacement null))
    )
    (let pinned live-pin)
    (if pinned
      (call (?. target pin) pinned false)
    )
    (= live-pin null)
    (let changed (or live-changed (!= replacement null)))
    (= live-before null)
    (= live-changed false)
    (return-if false (if (not changed)))
    (let others (call followed index (!= replacement null)))
    (let active history)
    (return-if true (if (not active)))
    (do-use (call (. active group) title)
      (call (. active record) title (call (of CommandLogReplaceEntry Step) this original ([] steps index)))
      (for (in other others)
        (let spot (call index-of (. other id)))
        (if (!= spot null)
          (call (. active record) title (call (of CommandLogReplaceEntry Step) this other ([] steps spot)))
        )
      )
    )
    (return true)
  )
  (fn-expr + adjusted Step
    (param index Index)
    (param replacement Step)
    replacement
  )
  (fn-expr + followed (list Step)
    (param index Index)
    (param replaced Bool)
    (call (of List Step))
  )
  (fn-do + cancel-edit Bool
    (param id U64)
    (let index (call index-of id))
    (let original live-before)
    (let pinned live-pin)
    (= live-before null)
    (= live-changed false)
    (= live-pin null)
    (if pinned
      (call (?. target pin) pinned false)
    )
    (return-if false (if (or (== index null) (not original))))
    (call replace index original)
    (call replay (. CommandReplayKind parameter-edit) index)
    (return true)
  )
  (fn-do + replay _
    (param kind _ (= (. CommandReplayKind explicit)))
    (param from Index (= 0))
    (let start (call rewind (call position-of (call min from end)) kind))
    (for (in index (..< start end))
      (call execute-step index)
    )
    (call (?. target did-replay) kind)
  )
  (fn-do + rewind Index
    (param requested Index)
    (param kind CommandReplayKind)
    (return-if position (if (>= requested position)))
    (return-if requested (if (and (call reverts-to requested) (call reverted-to requested))))
    (let restored (?? (call (?. target restore) requested kind) 0))
    (= position restored)
    (if (> (. ran length) restored)
      (-= ([] ran (..< restored (. ran length))))
    )
    (return restored)
  )
  (fn-expr + reverts-to Bool
    (param requested Index)
    (and (== (. ran length) position) (call all ([] ran (..< requested position)) (:where (. each reverts))))
  )
  (fn-do _ reverted-to Bool
    (param requested Index)
    (while (> position requested)
      (let step (call (. ran pop)))
      (-= position 1)
      (call (. step revert)
        (block
          (on-error (: error Error)
            (call unhandled-error error)
            (return false)
          )
        )
      )
    )
    (return true)
  )
  (fn-do + execute-step _
    (param index Index)
    (let step ([] steps index))
    (let started (call monotonic-time-nanoseconds))
    (call (. step execute)
      (block
        (on-error (: error Error)
          (call fail (. step id) (. error message))
        )
      )
    )
    (if (and (. failures length) (has failures (. step id)))
      (-= ([] failures (. step id)))
      (+= failures-revision 1)
    )
    (+= ran step)
    (+= position 1)
    (call (?. target executed) position (as (- (call monotonic-time-nanoseconds) started) Nanoseconds))
  )
  (fn-do _ fail _
    (param id U64)
    (param message String)
    (= ([] failures id) message)
    (+= failures-revision 1)
  )
  (fn-do + fold _
    (return-if (if (or (not step-limit) (<= (. steps length) step-limit))))
    (let active-target target)
    (return-if (if (not active-target)))
    (let point (call (. active-target fold-point) (- (. steps length) step-limit)))
    (return-if (if (or (not point) (== point 0))))
    (-= ([] steps (..< 0 point)))
    (if (>= (. ran length) point)
      (-= ([] ran (..< 0 point)))
    )
    (+= revision 1)
    (call (. active-target folded) point)
    (-= position point)
  )
  (fn-expr + step-id U64
    (param index Index)
    (. ([] steps index) id)
  )
  (fn-expr + step-title String
    (param index Index)
    (. ([] steps index) title)
  )
  (fn-expr + step-sentence (list CommandSentencePart)
    (param index Index)
    (. ([] steps index) sentence)
  )
  (fn-expr + step-failure (? String)
    (param index Index)
    (only-if ([] failures (. ([] steps index) id)) (if (. failures length)))
  )
  (fn-do + edit-parameter Bool
    (param id U64)
    (param key String)
    (param value CommandParameterValue)
    (param phase ValueChangePhase)
    (let index (call index-of id))
    (return-if false (if (== index null)))
    (let part (call command-sentence-part (. ([] steps index) sentence) key))
    (return (call edit id key value (str "Edit " (if-expr part (call command-part-label (!! part)) key)) phase))
  )
)

(type + InvocationLog (is (of CommandLog Invocation))
  (fn-do + This _
    (param target (? CommandLogTarget) (= null))
    (param history (? CommandHistory) (= null))
    (call super target history)
  )
  (fn-do + (of perform Args) Invocation (?! Error)
    (param command (of ParameterizedCommand Args))
    (param args Args)
    (return (call perform (call (of StoredInvocation Args) (call claim-id) command args)))
  )
  (fn-do + (of load Args) Invocation (?! Error)
    (param command (of ParameterizedCommand Args))
    (param json JSON)
    (let step (call (of StoredInvocation Args) (call claim-id) command (call (. command decode) json)))
    (+= steps step)
    (+= revision 1)
    (return step)
  )
)

(type + (of CommandLogInsertEntry Step) (is Tuple)
  (implements CommandHistoryEntry)
  (prop + log (of CommandLog Step))
  (prop + step Step)
  (prop + previous (? U64))
  (fn-do + undo _
    (let index (call (. log index-of) (. step id)))
    (return-if (if (== index null)))
    (call (. log remove) index)
    (call (. log replay) (. CommandReplayKind history) index)
  )
  (fn-do + redo _
    (return-if (if (!= (call (. log index-of) (. step id)) null)))
    (let index (call (. log place-after) step previous))
    (call (. log replay) (. CommandReplayKind history) index)
  )
)

(type + (of CommandLogRemoveEntry Step) (is Tuple)
  (implements CommandHistoryEntry)
  (prop + log (of CommandLog Step))
  (prop + step Step)
  (prop + previous (? U64))
  (fn-do + undo _
    (call (. (call (of CommandLogInsertEntry Step) log step previous) redo))
  )
  (fn-do + redo _
    (call (. (call (of CommandLogInsertEntry Step) log step previous) undo))
  )
)

(type + (of CommandLogRangeEntry Step) (is Tuple)
  (implements CommandHistoryEntry)
  (prop + log (of CommandLog Step))
  (prop + steps (list Step))
  (prop + previous (? U64))
  (prop + inserted Bool)
  (fn-do _ take-out _
    (let index (call (. log index-of) (. ([] steps 0) id)))
    (return-if (if (== index null)))
    (for (in step steps)
      (call (. log remove) index)
    )
    (call (. log replay) (. CommandReplayKind history) index)
  )
  (fn-do _ put-back _
    (return-if (if (!= (call (. log index-of) (. ([] steps 0) id)) null)))
    (let index (call (. log place-after) ([] steps 0) previous))
    (for (in offset (..< 1 (. steps length)))
      (call (. log place) (+ index offset) ([] steps offset))
    )
    (call (. log replay) (. CommandReplayKind history) index)
  )
  (fn-do + undo _
    (if inserted
      (call take-out)
      (else
        (call put-back)
      )
    )
  )
  (fn-do + redo _
    (if inserted
      (call put-back)
      (else
        (call take-out)
      )
    )
  )
)

(type + (of CommandLogReplaceEntry Step)
  (implements CommandHistoryEntry)
  (prop + log (of CommandLog Step))
  (prop + before Step)
  (prop + after Step)
  (fn-do + This _
    (param log _)
    (param before _)
    (param after _)
  )
  (fn-do + coalesce Bool
    (param next CommandHistoryEntry)
    (match? next
      (case (of CommandLogReplaceEntry Step)
        (return-if false (if (or (!= (as (. it log) Pointer) (as log Pointer)) (!= (. it before id) (. after id)))))
        (= after (. it after))
        (return true)
      )
    )
    (return false)
  )
  (fn-do + undo _
    (let index (call (. log index-of) (. after id)))
    (return-if (if (== index null)))
    (call (. log replace) index before)
    (call (. log replay) (. CommandReplayKind history) index)
  )
  (fn-do + redo _
    (let index (call (. log index-of) (. before id)))
    (return-if (if (== index null)))
    (call (. log replace) index after)
    (call (. log replay) (. CommandReplayKind history) index)
  )
)

(type + (of CommandLogMoveEntry Step) (is Tuple)
  (implements CommandHistoryEntry)
  (prop + log (of CommandLog Step))
  (prop + id U64)
  (prop + count Index)
  (prop + before (? U64))
  (prop + after (? U64))
  (fn-do _ settle _
    (param previous (? U64))
    (let first (call (. log index-of) id))
    (return-if (if (== first null)))
    (let moved (list Step))
    (for (in offset (..< 0 count))
      (+= moved (call (. log remove) first))
    )
    (let landed (call (. log place-after) ([] moved 0) previous))
    (for (in offset (..< 1 (. moved length)))
      (call (. log place) (+ landed offset) ([] moved offset))
    )
    (call (. log replay) (. CommandReplayKind history) (call min first landed))
  )
  (fn-do + undo _
    (call settle before)
  )
  (fn-do + redo _
    (call settle after)
  )
)
