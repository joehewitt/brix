(import ./undo-target)
(import /time/duration)
(import /time/timer)

(type + CommandHistoryEntry (is Interface)
  (fn-do + undo _)
  (fn-do + redo _)
  (fn-expr + coalesce Bool
    (param next CommandHistoryEntry)
    false
  )
)

(type _ CommandHistoryGroupEntry (is Tuple)
  (implements CommandHistoryEntry)
  (prop + entries (list CommandHistoryEntry))
  (fn-do + undo _
    (let index (. entries length))
    (while (> index 0)
      (-= index 1)
      (call (. ([] entries index) undo))
    )
  )
  (fn-do + redo _
    (for (in entry entries)
      (call (. entry redo))
    )
  )
)

(type _ CommandHistoryStep (is Tuple)
  (prop + title String)
  (prop + entry CommandHistoryEntry)
)

(type + CommandHistory
  (implements UndoTarget)
  (prop + limit (? Size) (= 100))
  (prop + coalescing (? Duration) (= 1seconds))
  (prop + revision U64)
  (prop + undo-title _ (= "Undo"))
  (prop + redo-title _ (= "Redo"))
  (prop + can-undo _ (= false))
  (prop + can-redo _ (= false))
  (prop + is-modified _ (= false))
  (event + dropped (list CommandHistoryEntry))
  (blank)
  (prop _ steps (list CommandHistoryStep))
  (prop _ cursor Index (= 0))
  (prop _ saved (? Index) (= 0))
  (prop _ recorded-at U64)
  (prop _ is-open _ (= false))
  (prop _ is-replaying _ (= false))
  (prop _ group-depth Size)
  (prop _ group-title _ (= ""))
  (prop _ grouped (list CommandHistoryEntry))
  (blank)
  (prop + undo-count _ (=> cursor))
  (prop + redo-count _ (=> (- (. steps length) cursor)))
  (fn-expr + group _
    (param title String)
    (call CommandHistoryGroupScope this title)
  )
  (fn-do + entries (stream CommandHistoryEntry)
    (for (in step steps)
      (yield-all (call command-history-leaves (. step entry)))
    )
  )
  (fn-do + record _
    (param title String)
    (param entry CommandHistoryEntry)
    (return-if (if is-replaying))
    (blank)
    (if group-depth
      (if (not (. group-title length))
        (= group-title title)
      )
      (+= grouped entry)
      (return)
    )
    (let now (call monotonic-time-nanoseconds))
    (let window coalescing)
    (let recent (or (== window null) (< (as (- now recorded-at) Nanoseconds) window)))
    (let mergeable (and is-open recent (== cursor (. steps length)) (> cursor 0) (!= saved cursor)))
    (= recorded-at now)
    (= is-open true)
    (if (and mergeable (== (. ([] steps (- cursor 1)) title) title) (call (. ([] steps (- cursor 1)) entry coalesce) entry))
      (+= revision 1)
      (return)
    )
    (if (and (!= saved null) (> saved cursor))
      (= saved null)
    )
    (let discarded (list CommandHistoryEntry))
    (while (> (. steps length) cursor)
      (+= discarded (. (call (. steps pop)) entry))
    )
    (+= steps (call CommandHistoryStep title entry))
    (+= cursor 1)
    (let bound limit)
    (while (and (!= bound null) (> (. steps length) bound))
      (+= discarded (. ([] steps 0) entry))
      (call (. steps remove) 0)
      (-= cursor 1)
      (if (== saved 0)
        (= saved null)
        (else-if (!= saved null)
          (= saved (- saved 1))
        )
      )
    )
    (call changed)
    (call drop discarded)
  )
  (fn-do + undo _
    (return-if (if (not can-undo)))
    (blank)
    (= is-open false)
    (= is-replaying true)
    (finally
      (= is-replaying false)
    )
    (call (. ([] steps (- cursor 1)) entry undo))
    (-= cursor 1)
    (call changed)
  )
  (fn-do + redo _
    (return-if (if (not can-redo)))
    (blank)
    (= is-open false)
    (= is-replaying true)
    (finally
      (= is-replaying false)
    )
    (call (. ([] steps cursor) entry redo))
    (+= cursor 1)
    (call changed)
  )
  (fn-do + mark-saved _
    (= saved cursor)
    (= is-open false)
    (call changed)
  )
  (fn-do + seal _
    (= is-open false)
  )
  (fn-do + clear _
    (= is-open false)
    (return-if (if (not (. steps length))))
    (blank)
    (= saved (only-if 0 (if (== saved cursor))))
    (let discarded (call (of List CommandHistoryEntry) (in (. each entry) steps)))
    (call (. steps clear))
    (= cursor 0)
    (call changed)
    (call drop discarded)
  )
  (fn-do _ begin-group _
    (param title String)
    (if (not group-depth)
      (= group-title title)
      (= grouped (call (of List CommandHistoryEntry)))
    )
    (+= group-depth 1)
  )
  (fn-do _ end-group _
    (return-if (if (not group-depth)))
    (blank)
    (-= group-depth 1)
    (return-if (if group-depth))
    (blank)
    (let entries grouped)
    (= grouped (call (of List CommandHistoryEntry)))
    (return-if (if (not (. entries length))))
    (blank)
    (if (== (. entries length) 1)
      (call record group-title ([] entries 0))
      (else
        (call record group-title (call CommandHistoryGroupEntry entries))
      )
    )
  )
  (fn-do _ drop _
    (param discarded (list CommandHistoryEntry))
    (return-if (if (not (. discarded length))))
    (blank)
    (let leaves (list CommandHistoryEntry))
    (for (in entry discarded)
      (for (in leaf (call command-history-leaves entry))
        (+= leaves leaf)
      )
    )
    (<- dropped leaves)
  )
  (fn-do _ changed _
    (= undo-title (if-expr cursor (str "Undo " (. ([] steps (- cursor 1)) title)) "Undo"))
    (= redo-title (if-expr (< cursor (. steps length)) (str "Redo " (. ([] steps cursor) title)) "Redo"))
    (= can-undo (> cursor 0))
    (= can-redo (< cursor (. steps length)))
    (= is-modified (!= saved cursor))
    (+= revision 1)
  )
)

(type + CommandHistoryGroupScope (is Tuple)
  (implements (of Usable Void))
  (prop _ history CommandHistory)
  (prop _ title String)
  (fn-do + This _
    (param history _)
    (param title _)
  )
  (fn-do + begin-using _
    (call (. history begin-group) title)
  )
  (fn-do + end-using _
    (call (. history end-group))
  )
)

(fn-do _ command-history-leaves (list CommandHistoryEntry)
  (param entry CommandHistoryEntry)
  (if (= (| (: group CommandHistoryGroupEntry)) entry)
    (return (. group entries))
  )
  (return (list entry))
)
