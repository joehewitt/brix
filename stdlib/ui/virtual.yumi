────────────────────
+ get domain VirtualSequenceDomain

this

────────────────────
+ do bind
    - address I64
    - generation U64
    - target VirtualBindingTarget'Item

if address < 0 || address >= (values.length as I64)
    target.fail(generation)
else
    target.commit(VirtualKey(revision.value, address), values[address], generation)

────────────────────
+ do identity-at U64?
    - address I64

. identify = identity
=? if !identify || address < 0 || address >= (values.length as I64)
= identify(values[address])
