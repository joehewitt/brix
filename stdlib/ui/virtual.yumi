is-bound = true

━━━━━━━━━━━━━━━━━━━━
+ VirtualRangeSource
    is VirtualSequenceDomain
    is VirtualSource'I64

+ count VirtualCoord
+ revision := VirtualRevision()

. count-changed < count

────────────────────
+ This
    - count

?! Panic("Virtual range count must not be negative")
    if count < 0vcoord

────────────────────
+ do bump-revision

revision.bump()

────────────────────
_ do count-changed

revision.touch()

────────────────────
+ get known-count VirtualCoord

count

────────────────────
+ get estimated-count VirtualCoord?

count

────────────────────
+ get is-final Bool

true

────────────────────
+ address-at I64
    - index VirtualCoord

index

────────────────────
+ index-of VirtualCoord?
    - address I64

|? address < 0 || address >= (count as I64)
    null
??
    address as VirtualCoord

────────────────────
+ get domain VirtualSequenceDomain

this

────────────────────
+ do bind
    - address I64
    - generation U64
    - target VirtualBindingTarget'I64

if address < 0 || address >= (count as I64)
    target.fail(generation)
else
    . item = address + ((revision.value as I64) * (count as I64))
    target.commit(VirtualKey(revision.value, address), item, generation)

