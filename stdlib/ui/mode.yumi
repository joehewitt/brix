━━━━━━━━━━━━━━━━━━━━
+ ModeActivation is Interface

────────────────────
+ close

━━━━━━━━━━━━━━━━━━━━
+ Mode'T

+ value T
+ effective-value T
+ revision U64 = 0
+ event changed T
+ event effective-changed T

_ next-token U64 = 0
_ overrides [ModeOverride'T] = List'(ModeOverride'T)()

────────────────────
+ This
    - initial T

value = initial
effective-value = initial

────────────────────
+ do set
    - next T

value = next
revision += 1
update-effective-value()
changed <- next

────────────────────
+ do acquire ModeActivation
    - temporary T

next-token += 1
. token = next-token
overrides += ModeOverride'T(token, temporary)
revision += 1
update-effective-value()
= ModeLease'T(this, token)

────────────────────
+ do release
    - token U64

for index in overrides.length - 1 .. 0
    if overrides[index].token == token
        overrides.remove(index)
        revision += 1
        update-effective-value()
        =

────────────────────
_ do update-effective-value

effective-value = if overrides.length == 0 then value else overrides[overrides.length - 1].value
effective-changed <- effective-value

━━━━━━━━━━━━━━━━━━━━
_ ModeOverride'T is Tuple

+ token U64
+ value T

━━━━━━━━━━━━━━━━━━━━
_ ModeLease'T
    is ModeActivation

_ mode Mode'T?
_ token U64

────────────────────
_ This
    - mode
    - token

────────────────────
+ do close

. active = mode
=? if !active
mode = null
active.release(token)
