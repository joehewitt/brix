(type + Command (is Interface)
  (fn-expr + title String :get)
  (fn-expr + is-available Bool :get)
  (fn-expr + description String :get)
  (fn-expr + is-on Bool :get)
  (fn-expr + running Bool :get)
  (fn-expr + unavailable-reason String :get)
  (fn-expr + stable-key String :get)
  (fn-expr + identity Pointer :get)
  (fn-expr + is-discoverable Bool :get
    true
  )
  (fn-expr + run _)
)
