(type + ModeActivation (is Interface)
  (fn-expr + close _)
)

(type + (of Mode T)
  (prop + value T)
  (prop + effective-value T)
  (prop + revision U64 (= 0))
  (event + changed T)
  (event + effective-changed T)
  (blank)
  (prop _ next-token U64 (= 0))
  (prop _ overrides (list (of ModeOverride T)) (= (call (of List (of ModeOverride T)))))
  (fn-do + This _
    (param initial T)
    (= value initial)
    (= effective-value initial)
  )
  (fn-do + set _
    (param next T)
    (= value next)
    (+= revision 1)
    (call update-effective-value)
    (<- changed next)
  )
  (fn-do + acquire ModeActivation
    (param temporary T)
    (+= next-token 1)
    (let token next-token)
    (+= overrides (call (of ModeOverride T) token temporary))
    (+= revision 1)
    (call update-effective-value)
    (return (call (of ModeLease T) this token))
  )
  (fn-do + release _
    (param token U64)
    (for (in index (.. (- (. overrides length) 1) 0))
      (if (== (. ([] overrides index) token) token)
        (call (. overrides remove) index)
        (+= revision 1)
        (call update-effective-value)
        (return)
      )
    )
  )
  (fn-do _ update-effective-value _
    (= effective-value (if-expr (== (. overrides length) 0) value (. ([] overrides (- (. overrides length) 1)) value)))
    (<- effective-changed effective-value)
  )
)

(type _ (of ModeOverride T) (is Tuple)
  (prop + token U64)
  (prop + value T)
)

(type _ (of ModeLease T)
  (implements ModeActivation)
  (prop _ mode (? (of Mode T)))
  (prop _ token U64)
  (fn-do _ This _
    (param mode _)
    (param token _)
  )
  (fn-do + close _
    (let active mode)
    (return-if (if (not active)))
    (= mode null)
    (call (. active release) token)
  )
)
