(import /time/deadline)
(import /time/duration)
(blank)
(prop + type-select-timeout Duration (= 1s))

(type + TypeSelect
  (prop + timeout _ (= type-select-timeout))
  (blank)
  (prop _ typed _ (= ""))
  (prop _ deadline (? Deadline))
  (fn-do + find (? Index)
    (param text String)
    (param titles (list String))
    (param current (? Index))
    (return-if (if (not text)))
    (if (or (not deadline) (. deadline has-passed))
      (= typed "")
    )
    (= deadline (call Deadline timeout))
    (let unit (. text lowercased))
    (+= typed unit)
    (let is-cycling (== typed (* unit (/ (. typed length) (. unit length)))))
    (let needle (if-expr is-cycling unit typed))
    (let count (. titles length))
    (return-if (if (== count 0)))
    (let first 0)
    (if (!= current null)
      (= first (if-expr is-cycling (% (+ current 1) count) current))
    )
    (for (in step (..< 0 count))
      (let index (% (+ first step) count))
      (return-if index (if (call (. ([] titles index) lowercased starts-with) needle)))
    )
  )
  (fn-expr + is-active Bool :get
    (and (> (. typed length) 0) (!= deadline null) (not (. deadline has-passed)))
  )
  (fn-do + reset _
    (= typed "")
    (= deadline null)
  )
)
