(type + Recents
  (prop + keys (list String))
  (prop + limit Size (= 20))
  (blank)
  (event + changed (list String))
  (fn-do + remember _
    (param key String)
    (return-if (if (not (. key length))))
    (blank)
    (let next (call (of List String) key))
    (for (in each keys)
      (if (and (!= each key) (< (. next length) limit))
        (+= next each)
      )
    )
    (= keys next)
    (<- changed next)
  )
)
