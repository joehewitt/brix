(type + PointerButton (is Union)
  (variant primary)
  (variant secondary)
  (variant middle)
  (variant other U32)
)

(type + PointerModifiers (is Tuple)
  (prop + shift _ (= false))
  (prop + control _ (= false))
  (prop + option _ (= false))
  (prop + command _ (= false))
  (prop + caps-lock _ (= false))
  (prop + function _ (= false))
)

(type + Key (is Union)
  (variant tab)
  (variant enter)
  (variant escape)
  (variant space)
  (variant arrow-up)
  (variant arrow-down)
  (variant arrow-left)
  (variant arrow-right)
  (variant home)
  (variant end)
  (variant page-up)
  (variant page-down)
  (variant backspace)
  (variant delete)
  (variant function-key U32)
  (variant unknown U32)
)
