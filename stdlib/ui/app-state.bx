(import /data/json)
(import /os/app-support)
(import /os/file)
(import /os/path)
(import /time/debounced)
(import /time/duration)
(blank)
(prop + app-state-delay _ (= 500ms))
(prop + app-state-format _ (= 1))
(prop + app-state-file-name _ (= "state.json"))

(type + AppState
  (prop + path Path)
  (prop + delay _ (= app-state-delay))
  (prop + problem (? String))
  (blank)
  (prop _ sections (of Map String JSON))
  (prop _ changed (list String))
  (prop _ revision U64)
  (prop _ saved-revision U64)
  (prop _ schedule-flush _ (:= (call debounced delay (. this flush))))
  (fn-do + This _
    (param app-id String (= main-app-id))
    (param location (? Path) (= null))
    (= path (?? location (/ (call app-support-path app-id) app-state-file-name)))
    (call load)
  )
  (fn-expr + read _
    (param key String)
    (param version Int)
    ([] sections (call app-state-key key version))
  )
  (fn-do + write _
    (param key String)
    (param version Int)
    (param value JSON)
    (let entry (call app-state-key key version))
    (= ([] sections entry) value)
    (call note entry)
  )
  (fn-do + remove _
    (param key String)
    (param version Int)
    (let entry (call app-state-key key version))
    (return-if (if (not (has sections entry))))
    (blank)
    (-= ([] sections entry))
    (call note entry)
  )
  (fn-do + flush _
    (return-if (if (== saved-revision revision)))
    (blank)
    (let current revision)
    (let merged (call latest-sections))
    (for (in entry changed)
      (let value ([] sections entry))
      (if value
        (= ([] merged entry) value)
        (else-if (has merged entry)
          (-= ([] merged entry))
        )
      )
    )
    (let root
      (call (of Map String JSON)
        (block
          (entry "format" app-state-format)
          (entry "sections" merged)
        )
      )
    )
    (let failure (catch (call store (call to-json root))))
    (if (is failure Error)
      (= problem (. (as failure Error) message))
      (else
        (= sections merged)
        (= changed (call (of List String)))
        (= saved-revision current)
        (= problem null)
      )
    )
  )
  (fn-do _ note _
    (param entry String)
    (if (not (has changed entry))
      (+= changed entry)
    )
    (call schedule)
  )
  (fn-do _ schedule _
    (+= revision 1)
    (call schedule-flush)
  )
  (fn-do _ load _
    (return-if (if (not (. path exists))))
    (blank)
    (let loaded (catch (call app-state-sections (call read-file-text path))))
    (if (is loaded Error)
      (= problem (. (as loaded Error) message))
      (catch (call (. path move) (call Path (str path ".bad") 0)))
      (return)
    )
    (= sections (as loaded (of Map String JSON)))
  )
  (fn-do _ latest-sections (of Map String JSON)
    (return-if sections (if (not (. path exists))))
    (blank)
    (let text (catch? (call read-file-text path)))
    (return-if sections (if (not text)))
    (return (?? (catch? (call app-state-sections text)) sections))
  )
  (fn-do _ store _ (?! Error)
    (param text String)
    (let directory (. path parent))
    (if directory
      (call (. directory make-directories))
    )
    (call write-file-atomically path text)
  )
)

(fn-expr _ app-state-key String
  (param key String)
  (param version Int)
  (str key "@" version)
)

(fn-expr _ app-state-sections _ (?! Error)
  (param text String)
  (before
    (throw (call Error (str "Unsupported app state format " format)) (if (!= format app-state-format)))
  )
  (. (call (. ([] root "sections") object)) fields)
  (where
    (lazy root (call (. (call JSONReader "App state" (call parse-json text)) object)))
    (lazy format (call (. ([] root "format") int)))
  )
)
