/graphics/point
/math
/stream/aggregate
/units

━━━━━━━━━━━━━━━━━━━━
+ ParameterUnit is U8

| none
| degrees
| percent

────────────────────
+ get suffix String

match this
    |= .degrees
        "°"
    |= .percent
        "%"
    ??
        ""

────────────────────
+ get display-scale F64

match this
    |= .percent
        1.0 as Ratio as Percent as F64
    ??
        1.0

━━━━━━━━━━━━━━━━━━━━
+ CommandNumberParameter

+ key String
+ label String
+ value F64
+ unit ParameterUnit
+ step F64
+ point String
+ axis Index
+ optional = false
+ empty = false

────────────────────
+ This
    - label
    - value
    - unit = ParameterUnit.none
    - step = 1.0
    - name = ""
    - point = ""
    - axis Index = 0

.. key = if name.length then name else label

────────────────────
+ get display-value

value * unit.display-scale

━━━━━━━━━━━━━━━━━━━━
+ CommandPointParameter

+ key String
+ label String
+ value Point
+ unit ParameterUnit
+ step F64

────────────────────
+ This
    - label
    - value
    - unit = ParameterUnit.none
    - step = 1.0
    - name = ""

.. key = if name.length then name else label

────────────────────
+ get x-part

CommandNumberParameter(label, value.x, unit, step, "${key}.x", key, 0)

────────────────────
+ get y-part

CommandNumberParameter(label, value.y, unit, step, "${key}.y", key, 1)

━━━━━━━━━━━━━━━━━━━━
+ CommandTextParameter

+ key String
+ label String
+ value String
+ options [String]

────────────────────
+ This
    - label
    - value
    - options [String] = List'String()
    - name = ""

.. key = if name.length then name else label

────────────────────
+ accepts
    - candidate String

if options.length then options has candidate else candidate.length > 0

────────────────────
+ get next-value

|? !options.length
    value
??
    options[((options.find(value) ?? options.length - 1) + 1) % options.length]

━━━━━━━━━━━━━━━━━━━━
+ CommandReferenceParameter

+ key String
+ label String
+ ids [U64]
+ text String
+ kind String
+ multiple Bool

────────────────────
+ This
    - label
    - ids
    - text
    - kind = ""
    - multiple = false
    - name = ""

.. key = if name.length then name else label

────────────────────
+ get is-empty

ids.length == 0

────────────────────
+ get is-editable

kind.length > 0

━━━━━━━━━━━━━━━━━━━━
+ CommandValueParameter is Interface

────────────────────
+ get key String

────────────────────
+ get label String

────────────────────
+ get text String

━━━━━━━━━━━━━━━━━━━━
+ CommandSentencePart is Union

| text String
| number CommandNumberParameter
| point CommandPointParameter
| input CommandTextParameter
| color CommandTextParameter
| reference CommandReferenceParameter
| definition CommandTextParameter
| value CommandValueParameter

━━━━━━━━━━━━━━━━━━━━
+ CommandParameterValue is Union

| number F64
| point Point
| text String
| ids [U64]

━━━━━━━━━━━━━━━━━━━━
+ command-sentence-text
    - part CommandSentencePart

match? part
    | .text(value)
        value

━━━━━━━━━━━━━━━━━━━━
+ command-sentence-number
    - part CommandSentencePart

match? part
    | .number(parameter)
        parameter

━━━━━━━━━━━━━━━━━━━━
+ command-sentence-point
    - part CommandSentencePart

match? part
    | .point(parameter)
        parameter

━━━━━━━━━━━━━━━━━━━━
+ command-sentence-input
    - part CommandSentencePart

match? part
    | .input(value)
        value

━━━━━━━━━━━━━━━━━━━━
+ command-sentence-color
    - part CommandSentencePart

match? part
    | .color(value)
        value

━━━━━━━━━━━━━━━━━━━━
+ command-sentence-reference
    - part CommandSentencePart

match? part
    | .reference(value)
        value

━━━━━━━━━━━━━━━━━━━━
+ command-sentence-definition
    - part CommandSentencePart

match? part
    | .definition(value)
        value

━━━━━━━━━━━━━━━━━━━━
+ command-sentence-value
    - part CommandSentencePart

match? part
    | .value(value)
        value

━━━━━━━━━━━━━━━━━━━━
+ command-part-key String?
    - part CommandSentencePart

match part
    | .text
        null
    | .number(parameter)
        parameter.key
    | .point(parameter)
        parameter.key
    | .input(parameter)
        parameter.key
    | .color(parameter)
        parameter.key
    | .reference(parameter)
        parameter.key
    | .definition(parameter)
        parameter.key
    | .value(parameter)
        parameter.key

━━━━━━━━━━━━━━━━━━━━
+ command-part-label String
    - part CommandSentencePart

match part
    | .text(text)
        text
    | .number(parameter)
        parameter.label
    | .point(parameter)
        parameter.label
    | .input(parameter)
        parameter.label
    | .color(parameter)
        parameter.label
    | .reference(parameter)
        parameter.label
    | .definition(parameter)
        parameter.label
    | .value(parameter)
        parameter.label

━━━━━━━━━━━━━━━━━━━━
+ command-sentence-part
    - sentence [CommandSentencePart]
    - key String

first(each in sentence when command-part-key(each) == key)
