/time/deadline
/time/duration

+ type-select-timeout Duration = 1s

━━━━━━━━━━━━━━━━━━━━
+ TypeSelect

+ timeout = type-select-timeout

_ typed = ""
_ deadline Deadline?

────────────────────
+ do find Index?
    - text String
    - titles [String]
    - current Index?

=? if !text
if !deadline || deadline.has-passed
    typed = ""
deadline = Deadline(timeout)
. unit = text.lowercased
typed += unit
. is-cycling = typed == unit * (typed.length / unit.length)
. needle = if is-cycling then unit else typed
. count = titles.length
=? if count == 0
. first = 0
if current != null
    first = if is-cycling then (current + 1) % count else current
for step in 0 .. < count
    . index = (first + step) % count
    =? index if titles[index].lowercased.starts-with(needle)

────────────────────
+ get is-active Bool

typed.length > 0 && deadline != null && !deadline.has-passed

────────────────────
+ do reset

typed = ""
deadline = null
