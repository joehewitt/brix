(import /test)
(import /ui/tests/support/virtual-fixtures)
(import /ui/virtual)
(import /ui/virtual-layout)
(import /ui/virtual-recycler)
(blank)

(main
  (call tests)
)

(fn-do + tests TestRender
  (let cases (call TestCase "Virtual Vertical Fixed Rows"))
  (call (. cases run) vertical-fixed-tests)
  (= cases (call (. cases then) "Virtual Vertical Fixed Horizontal Scroll" vertical-fixed-scroll-x-tests))
  (= cases (call (. cases then) "Virtual Horizontal Fixed Columns" horizontal-fixed-tests))
  (= cases (call (. cases then) "Virtual Open Domain Extent" open-domain-tests))
  (= cases (call (. cases then) "Virtual Rect For Address" rect-for-address-tests))
  (= cases (call (. cases then) "Virtual Recycler Fill And Release" recycler-release-tests))
  (= cases (call (. cases then) "Virtual Recycler Scroll Reuse" recycler-reuse-tests))
  (= cases (call (. cases then) "Virtual Recycler Shrink And Regrow" recycler-regrow-tests))
  (= cases (call (. cases then) "Virtual Recycler Revision And Replacement" recycler-revision-tests))
  (= cases (call (. cases then) "Virtual Recycler Growing Source" growing-source-tests))
  (= cases (call (. cases then) "Virtual Recycler List Identity" list-identity-tests))
  (= cases (call (. cases then) "Virtual Measured Rows" measured-row-tests))
  (= cases (call (. cases then) "Virtual Measured Estimate And Padding" measured-estimate-tests))
  (= cases (call (. cases then) "Virtual Recycler Retention" retention-tests))
  (= cases (call (. cases then) "Virtual Recycler Holds" holds-tests))
  (= cases (call (. cases then) "Virtual Growing Source Binds" growing-bind-tests))
  (= cases (call (. cases then) "Virtual Grid Layout" grid-layout-tests))
  (return cases)
)

(fn-do _ vertical-fixed-tests _
  (param t TestCase)
  (let source (call VirtualRangeSource 1000000000vcoord))
  (let layout (call VerticalFixedLayout 4vcoord))
  (let window (call VirtualWindow))
  (= (. window scroll-y) 4001vcoord)
  (= (. window viewport-width) 80vcoord)
  (= (. window frame-width) 80vcoord)
  (= (. window viewport-height) 24vcoord)
  (= (. window frame-height) 24vcoord)
  (call (. window set-overscan) (call VirtualInsets 12vcoord 0vcoord 12vcoord 0vcoord))
  (call (. layout fill-window) window source)
  (call (. t expect) "placements" 13 (. window placement-count))
  (call (. t expect)
    (block
      (arg "first")
      (arg "997 (0, 3988, 80, 4)")
      (arg (str (. ([] (. window placements) 0) placement-id) " " (. ([] (. window placements) 0) rect)))
    )
  )
  (call (. t expect)
    (block
      (arg "last")
      (arg "1009 1009")
      (arg (str (. ([] (. window placements) 12) placement-id) " " (. ([] (. window placements) 12) address)))
    )
  )
  (call (. t expect) "scroll" "(0, 4001)" (str (. window resolved-scroll)))
  (call (. t expect) "extent-y" "(4000000000, 4000000000, true)" (str (. window extent-y)))
  (call (. t expect) "extent-x" "(80, 80, true)" (str (. window extent-x)))
  (blank)
  (= (. window scroll-y) 4000vcoord)
  (call (. layout fill-window) window source)
  (call (. t expect) "aligned placements" 12 (. window placement-count))
  (blank)
  (= (. window scroll-y) 9000000000000vcoord)
  (call (. layout fill-window) window source)
  (call (. t expect) "end scroll" 3999999976vcoord (. window resolved-scroll-y))
  (call (. t expect)
    (block
      (arg "end last")
      (arg 999999999vcoord)
      (arg (. ([] (. window placements) (- (. window placement-count) 1)) placement-id))
    )
  )
  (blank)
  (= (. window scroll-y) -50vcoord)
  (call (. layout fill-window) window source)
  (call (. t expect) "start scroll" 0vcoord (. window resolved-scroll-y))
  (call (. t expect) "start first" 0vcoord (. ([] (. window placements) 0) placement-id))
  (call (. t expect) "start placements" 9 (. window placement-count))
  (return t)
)

(fn-do _ vertical-fixed-scroll-x-tests _
  (param t TestCase)
  (let source (call VirtualRangeSource 100vcoord))
  (let window (call VirtualWindow))
  (= (. window scroll-x) 500vcoord)
  (= (. window viewport-width) 80vcoord)
  (= (. window frame-width) 80vcoord)
  (= (. window viewport-height) 24vcoord)
  (= (. window frame-height) 24vcoord)
  (blank)
  (let filling (call VerticalFixedLayout 4vcoord))
  (call (. filling fill-window) window source)
  (call (. t expect) "filling scroll-x" 0vcoord (. window resolved-scroll-x))
  (blank)
  (let wide (call VerticalFixedLayout 4vcoord 200vcoord))
  (call (. wide fill-window) window source)
  (call (. t expect) "wide extent-x" "(200, 200, true)" (str (. window extent-x)))
  (call (. t expect) "wide scroll-x" 120vcoord (. window resolved-scroll-x))
  (call (. t expect) "wide row" "0 200" (str (. ([] (. window placements) 0) x) " " (. ([] (. window placements) 0) width)))
  (blank)
  (= (. window scroll-x) 40vcoord)
  (call (. wide fill-window) window source)
  (call (. t expect) "inside scroll-x" 40vcoord (. window resolved-scroll-x))
  (return t)
)

(fn-do _ horizontal-fixed-tests _
  (param t TestCase)
  (let source (call VirtualRangeSource 1000vcoord))
  (let window (call VirtualWindow))
  (= (. window scroll-x) 1005vcoord)
  (= (. window scroll-y) 7vcoord)
  (= (. window viewport-width) 100vcoord)
  (= (. window frame-width) 100vcoord)
  (= (. window viewport-height) 30vcoord)
  (= (. window frame-height) 30vcoord)
  (call (. window set-overscan) (call VirtualInsets 0vcoord 20vcoord 0vcoord 20vcoord))
  (blank)
  (let layout (call HorizontalFixedLayout 10vcoord))
  (call (. layout fill-window) window source)
  (call (. t expect) "placements" 15 (. window placement-count))
  (call (. t expect)
    (block
      (arg "first")
      (arg "98 (980, 0, 10, 30)")
      (arg (str (. ([] (. window placements) 0) placement-id) " " (. ([] (. window placements) 0) rect)))
    )
  )
  (call (. t expect) "scroll" "(1005, 0)" (str (. window resolved-scroll)))
  (call (. t expect) "extent-x" "(10000, 10000, true)" (str (. window extent-x)))
  (call (. t expect) "extent-y" "(30, 30, true)" (str (. window extent-y)))
  (blank)
  (let tall (call HorizontalFixedLayout 10vcoord 50vcoord))
  (call (. tall fill-window) window source)
  (call (. t expect) "tall scroll-y" 7vcoord (. window resolved-scroll-y))
  (call (. t expect) "tall extent-y" "(50, 50, true)" (str (. window extent-y)))
  (blank)
  (= (. window scroll-y) 99vcoord)
  (call (. tall fill-window) window source)
  (call (. t expect) "clamped scroll-y" 20vcoord (. window resolved-scroll-y))
  (return t)
)

(fn-do _ open-domain-tests _
  (param t TestCase)
  (let domain (call VirtualTestDomain 5vcoord))
  (let window (call VirtualWindow))
  (= (. window viewport-width) 10vcoord)
  (= (. window frame-width) 10vcoord)
  (= (. window viewport-height) 10vcoord)
  (= (. window frame-height) 10vcoord)
  (let layout (call VerticalFixedLayout 1vcoord))
  (call (. layout fill-window) window domain)
  (call (. t expect) "open" "6 (5, unknown, false)" (str (. window placement-count) " " (. window extent-y)))
  (blank)
  (= (. domain estimate) 40vcoord)
  (call (. layout fill-window) window domain)
  (call (. t expect) "estimated" "6 (5, 40, false)" (str (. window placement-count) " " (. window extent-y)))
  (blank)
  (= (. domain finished) true)
  (call (. layout fill-window) window domain)
  (call (. t expect) "final" "5 (5, 40, true)" (str (. window placement-count) " " (. window extent-y)))
  (return t)
)

(fn-do _ rect-for-address-tests _
  (param t TestCase)
  (let source (call VirtualRangeSource 1000vcoord))
  (let window (call VirtualWindow))
  (= (. window frame-width) 80vcoord)
  (= (. window frame-height) 24vcoord)
  (let rows (call VerticalFixedLayout 4vcoord))
  (let columns (call HorizontalFixedLayout 10vcoord 50vcoord))
  (call (. t expect) "row 123" "(0, 492, 80, 4)" (str (call (. rows rect-for-address) 123 source window)))
  (call (. t expect) "column 7" "(70, 0, 10, 50)" (str (call (. columns rect-for-address) 7 source window)))
  (call (. t expect) "row -1" "unknown" (str (call (. rows rect-for-address) -1 source window)))
  (call (. t expect) "row 1000" "unknown" (str (call (. rows rect-for-address) 1000 source window)))
  (blank)
  (let hosted (call VerticalRowLayout))
  (= (. window row-height) 6vcoord)
  (call (. t expect) "hosted row 123" "(0, 738, 80, 6)" (str (call (. hosted rect-for-address) 123 source window)))
  (= (. window viewport-width) 40vcoord)
  (= (. window viewport-height) 24vcoord)
  (call (. hosted fill-window) window source)
  (call (. t expect)
    (block
      (arg "hosted")
      (arg "4 (0, 6, 80, 6) 6000")
      (arg (str (. window placement-count) " " (. ([] (. window placements) 1) rect) " " (. window known-height)))
    )
  )
  (let opened (call VerticalRowLayout 2vcoord))
  (call (. opened fill-window) window source)
  (call (. t expect) "gap" "(0, 18, 80, 6)" (str (. ([] (. window placements) 2) rect)))
  (= (. window row-height) 0vcoord)
  (call (. hosted fill-window) window source)
  (call (. t expect) "fallback" 1000vcoord (. window known-height))
  (return t)
)

(fn-do _ recycler-release-tests _
  (param t TestCase)
  (let recycler (call fixed-recycler))
  (call request recycler 4001vcoord 24vcoord)
  (call (. t expect) "pool" 13 (. recycler pool-size))
  (call (. t expect) "binds" 13 (. recycler stats source-binds))
  (call (. t expect) "matched" true (call slots-match-placements recycler))
  (call (. t expect) "first address" 997 (. (!! (call (. recycler slot-at) 0)) address))
  (call (. t expect) "changes" true (. recycler has-pending-changes))
  (blank)
  (= (. recycler has-pending-changes) false)
  (call request recycler 4001vcoord 24vcoord)
  (call (. t expect) "unchanged changes" false (. recycler has-pending-changes))
  (call (. t expect) "unchanged binds" 13 (. recycler stats source-binds))
  (blank)
  (let log (as (!! (. recycler owner)) VirtualDepartureLog))
  (call (. recycler release))
  (call (. t expect) "release departures" "13 bound 13" (str (. log count) " bound " (. log bound-count)))
  (call (. t expect) "release pool" 0 (. recycler pool-size))
  (call (. t expect) "release changes" true (. recycler has-pending-changes))
  (return t)
)

(fn-do _ recycler-reuse-tests _
  (param t TestCase)
  (let recycler (call fixed-recycler))
  (let log (as (!! (. recycler owner)) VirtualDepartureLog))
  (call request recycler 4001vcoord 24vcoord)
  (blank)
  (let prior (. recycler stats))
  (for (in step (..< 0 64))
    (call request recycler (if-expr (== (% step 2) 0) 4001vcoord 4002vcoord) 24vcoord)
  )
  (let current (. recycler stats))
  (call (. t expect) "stable binds" 0 (- (. current source-binds) (. prior source-binds)))
  (call (. t expect) "stable departures" 0 (- (. current departures) (. prior departures)))
  (blank)
  (= prior (. recycler stats))
  (let y 4001vcoord)
  (for (in _ (..< 0 100))
    (+= y 4vcoord)
    (call request recycler y 24vcoord)
  )
  (= current (. recycler stats))
  (call (. t expect) "adjacent binds" 100 (- (. current source-binds) (. prior source-binds)))
  (call (. t expect) "adjacent departures" 100 (- (. current departures) (. prior departures)))
  (call (. t expect) "adjacent pool" 13 (. recycler pool-size))
  (call (. t expect) "adjacent matched" true (call slots-match-placements recycler))
  (call (. t expect) "departed" "100 bound 100" (str (. log count) " bound " (. log bound-count)))
  (blank)
  (= prior (. recycler stats))
  (call request recycler 2000000001vcoord 24vcoord)
  (= current (. recycler stats))
  (call (. t expect) "jump binds" 13 (- (. current source-binds) (. prior source-binds)))
  (call (. t expect) "jump pool" 13 (. recycler pool-size))
  (call (. t expect) "jump matched" true (call slots-match-placements recycler))
  (call (. t expect) "jump first address" 499999997 (. ([] (. recycler window placements) 0) address))
  (return t)
)

(fn-do _ recycler-regrow-tests _
  (param t TestCase)
  (let recycler (call fixed-recycler))
  (let log (as (!! (. recycler owner)) VirtualDepartureLog))
  (call request recycler 4001vcoord 48vcoord)
  (call (. t expect) "tall pool" 19 (. recycler pool-size))
  (blank)
  (let departures (. log count))
  (call request recycler 4001vcoord 24vcoord)
  (call (. t expect) "shrink pool" 19 (. recycler pool-size))
  (call (. t expect) "shrink departures" 6 (- (. log count) departures))
  (call (. t expect) "shrink bound" 13 (call bound-slot-count recycler))
  (call (. t expect) "shrink matched" true (call slots-match-placements recycler))
  (blank)
  (let prior (. recycler stats))
  (call request recycler 4001vcoord 48vcoord)
  (let current (. recycler stats))
  (call (. t expect) "regrow created" 0 (- (. current pool-created) (. prior pool-created)))
  (call (. t expect) "regrow binds" 6 (- (. current source-binds) (. prior source-binds)))
  (call (. t expect) "regrow bound" 19 (call bound-slot-count recycler))
  (return t)
)

(fn-do _ recycler-revision-tests _
  (param t TestCase)
  (let recycler (call fixed-recycler))
  (let source (as (!! (. recycler source)) VirtualRangeSource))
  (call request recycler 4001vcoord 24vcoord)
  (let first-slot (!! (call (. recycler slot-at) 0)))
  (let first-generation (. first-slot generation))
  (blank)
  (let prior (. recycler stats))
  (call (. source bump-revision))
  (call request recycler 4001vcoord 24vcoord)
  (let current (. recycler stats))
  (call (. t expect) "revision binds" 13 (- (. current source-binds) (. prior source-binds)))
  (call (. t expect) "revision pool" 13 (. recycler pool-size))
  (call (. t expect) "revision key" 1u (. (!! (call (. recycler slot-at) 0)) key revision))
  (call (. t expect) "revision generation advanced" true (> (. first-slot generation) first-generation))
  (blank)
  (= prior (. recycler stats))
  (= (. recycler source) (call VirtualRangeSource 1000000000vcoord))
  (call request recycler 4001vcoord 24vcoord)
  (= current (. recycler stats))
  (call (. t expect) "replaced binds" 13 (- (. current source-binds) (. prior source-binds)))
  (call (. t expect) "replaced created" 0 (- (. current pool-created) (. prior pool-created)))
  (call (. t expect) "replaced key" 0u (. (!! (call (. recycler slot-at) 0)) key revision))
  (blank)
  (let replay (call VirtualReplaySource 100vcoord))
  (= (. recycler source) replay)
  (call request recycler 0vcoord 24vcoord)
  (let address (. (!! (call (. recycler slot-at) 0)) address))
  (let stale (. recycler stats stale-commits))
  (call (. replay replay))
  (call (. t expect) "stale commits" 1 (- (. recycler stats stale-commits) stale))
  (call (. t expect) "stale address kept" true (== (. (!! (call (. recycler slot-at) 0)) address) address))
  (return t)
)

(fn-do _ growing-source-tests _
  (param t TestCase)
  (let unbounded (call open-recycler (call VirtualGrowingSource 1000vcoord)))
  (call (. t expect) "unbounded pool" 10 (. unbounded pool-size))
  (call (. t expect) "unbounded extent" "(10, unknown, false)" (str (. unbounded window extent-y)))
  (call (. t expect) "unbounded matched" true (call slots-match-placements unbounded))
  (blank)
  (let short (call open-recycler (call VirtualGrowingSource 4vcoord)))
  (call (. t expect) "short pool" 4 (. short pool-size))
  (call (. t expect) "short extent" "(4, unknown, true)" (str (. short window extent-y)))
  (blank)
  (let stalled (call open-recycler (call VirtualGrowingSource 0vcoord)))
  (call (. t expect) "stalled pool" 0 (. stalled pool-size))
  (call (. t expect) "stalled placements" 1 (. stalled window placement-count))
  (return t)
)

(fn-do _ list-identity-tests _
  (param t TestCase)
  (let source (call (of VirtualListSource String)))
  (= (. source identity) (=> (name) (as (call hash-for name) U64)))
  (call (. source replace) (call list-names 100 ""))
  (let recycler (call (of VirtualRecycler String)))
  (= (. recycler source) source)
  (= (. recycler layout) (call VerticalFixedLayout 4vcoord))
  (call request-list recycler)
  (call (. t expect) "pool" 9 (. recycler pool-size))
  (call (. t expect) "first" "row-0" (. (!! (call (. recycler slot-at) 0)) item))
  (call (. t expect) "extent" 400vcoord (. recycler window extent-y known))
  (blank)
  (let inserted (call list-names 100 ""))
  (call (. inserted insert) "new-b" 0)
  (call (. inserted insert) "new-a" 0)
  (let prior (. recycler stats))
  (call (. source replace) inserted)
  (call request-list recycler)
  (let current (. recycler stats))
  (call (. t expect) "insert departures" 2 (- (. current departures) (. prior departures)))
  (call (. t expect) "insert binds" 9 (- (. current source-binds) (. prior source-binds)))
  (call (. t expect) "insert pool" 9 (. recycler pool-size))
  (call (. t expect)
    (block
      (arg "insert slot")
      (arg "row-0 2")
      (arg (str (. (!! (call (. recycler slot-at) 0)) item) " " (. (!! (call (. recycler slot-at) 0)) address)))
    )
  )
  (call (. t expect) "insert matched" true (call list-slots-match recycler))
  (blank)
  (let removed (call list-names 100 ""))
  (call (. removed insert) "new-b" 0)
  (call (. removed insert) "new-a" 0)
  (call (. removed remove) 5)
  (= prior (. recycler stats))
  (call (. source replace) removed)
  (call request-list recycler)
  (= current (. recycler stats))
  (call (. t expect) "remove departures" 1 (- (. current departures) (. prior departures)))
  (call (. t expect) "remove matched" true (call list-slots-match recycler))
  (blank)
  (= (. source identity) null)
  (= prior (. recycler stats))
  (call (. source replace) (call list-names 100 "x"))
  (call request-list recycler)
  (= current (. recycler stats))
  (call (. t expect) "plain departures" 9 (- (. current departures) (. prior departures)))
  (call (. t expect) "plain matched" true (call list-slots-match recycler))
  (return t)
)

(fn-expr _ list-names (list String)
  (param count Size)
  (param prefix String)
  (spread (in (str prefix "row-" each) (..< 0 count)))
)

(fn-do _ request-list _
  (param recycler (of VirtualRecycler String))
  (let window (. recycler window))
  (= (. window scroll-y) 0vcoord)
  (= (. window viewport-width) 80vcoord)
  (= (. window frame-width) 80vcoord)
  (= (. window viewport-height) 24vcoord)
  (= (. window frame-height) 24vcoord)
  (= (. window overscan-top) 12vcoord)
  (= (. window overscan-bottom) 12vcoord)
  (call (. recycler refresh))
)

(fn-do _ list-slots-match _
  (param recycler (of VirtualRecycler String))
  (let list (as (!! (. recycler source)) (of VirtualListSource String)))
  (let placed Size)
  (for (in index (..< 0 (. recycler pool-size)))
    (let slot (!! (call (. recycler slot-at) index)))
    (let placement (call (. recycler placement-for-slot) index))
    (if placement
      (return-if false (if (or (not (. slot is-bound)) (!= (. slot address) (. placement address)))))
      (return-if false (if (!= (. slot item) ([] (. list items) (. placement address)))))
      (+= placed 1)
      (else
        (return-if false (if (. slot is-bound)))
      )
    )
  )
  (return (== placed (. recycler window placement-count)))
)

(fn-do _ measured-row-tests _
  (param t TestCase)
  (let source (call VirtualRangeSource 100vcoord))
  (let layout (call VerticalMeasuredLayout 10vcoord))
  (let window (call VirtualWindow))
  (= (. window viewport-width) 80vcoord)
  (= (. window frame-width) 80vcoord)
  (= (. window viewport-height) 35vcoord)
  (= (. window frame-height) 35vcoord)
  (call (. t expect)
    (block
      (arg "measures rows")
      (arg "true false")
      (arg (str (. layout measures-rows) " " (. (call VerticalFixedLayout 4vcoord) measures-rows)))
    )
  )
  (call (. layout fill-window) window source)
  (call (. t expect)
    (block
      (arg "estimated")
      (arg "4 (1000, 1000, true) false")
      (arg (str (. window placement-count) " " (. window extent-y) " " (call (. layout is-row-measured) 1)))
    )
  )
  (blank)
  (call (. t expect)
    (block
      (arg "record")
      (arg "true true")
      (arg (str (call (. layout record-row-height) ([] (. window placements) 1) 25vcoord) " " (call (. layout is-row-measured) 1)))
    )
  )
  (call (. layout fill-window) window source)
  (call (. t expect) "repeat" false (call (. layout record-row-height) ([] (. window placements) 1) 25vcoord))
  (call (. t expect)
    (block
      (arg "measured")
      (arg "2 (0, 10, 80, 25) 1015")
      (arg (str (. window placement-count) " " (. ([] (. window placements) 1) rect) " " (. window known-height)))
    )
  )
  (call (. t expect) "address 50" "(0, 515, 80, 10)" (str (call (. layout rect-for-address) 50 source window)))
  (call (. t expect) "address 100" "unknown" (str (call (. layout rect-for-address) 100 source window)))
  (blank)
  (= (. window scroll-y) 5000vcoord)
  (call (. layout fill-window) window source)
  (call (. t expect)
    (block
      (arg "clamped")
      (arg "980 99")
      (arg (str (. window resolved-scroll-y) " " (. ([] (. window placements) (- (. window placement-count) 1)) placement-id)))
    )
  )
  (blank)
  (= (. window scroll-y) 0vcoord)
  (call (. window set-overscan) (call VirtualInsets 0vcoord 0vcoord 20vcoord 0vcoord))
  (call (. layout fill-window) window source)
  (call (. t expect) "overscan" 4 (. window placement-count))
  (blank)
  (call (. window set-overscan) (call VirtualInsets 0vcoord 0vcoord 0vcoord 0vcoord))
  (= (. window viewport-width) 60vcoord)
  (= (. window frame-width) 60vcoord)
  (call (. layout fill-window) window source)
  (call (. t expect)
    (block
      (arg "narrower")
      (arg "false 1015 60")
      (arg (str (call (. layout is-row-measured) 1) " " (. window known-height) " " (. ([] (. window placements) 0) width)))
    )
  )
  (blank)
  (= (. source count) 1vcoord)
  (call (. layout fill-window) window source)
  (call (. t expect) "shrunk" "1 10" (str (. layout row-count) " " (. window known-height)))
  (= (. source count) 3vcoord)
  (call (. layout fill-window) window source)
  (call (. t expect) "regrown" 30vcoord (. window known-height))
  (blank)
  (call (. layout reset))
  (call (. t expect) "reset" 0 (. layout row-count))
  (return t)
)

(fn-do _ measured-estimate-tests _
  (param t TestCase)
  (let source (call VirtualRangeSource 4vcoord))
  (let layout (call VerticalMeasuredLayout 10vcoord null 7vcoord 3vcoord))
  (= (. layout estimate) (=> (address width) (* (as address VirtualCoord) width)))
  (let window (call VirtualWindow))
  (= (. window viewport-width) 5vcoord)
  (= (. window frame-width) 5vcoord)
  (= (. window viewport-height) 100vcoord)
  (= (. window frame-height) 100vcoord)
  (call (. layout fill-window) window source)
  (call (. t expect) "placements" 4 (. window placement-count))
  (call (. t expect) "row 0" "(0, 7, 5, 1)" (str (. ([] (. window placements) 0) rect)))
  (call (. t expect) "row 2" "(0, 13, 5, 10)" (str (. ([] (. window placements) 2) rect)))
  (call (. t expect) "height" 41vcoord (. window known-height))
  (call (. t expect) "address 3" "(0, 23, 5, 15)" (str (call (. layout rect-for-address) 3 source window)))
  (blank)
  (= (. window viewport-height) 20vcoord)
  (= (. window frame-height) 20vcoord)
  (= (. window scroll-y) 500vcoord)
  (call (. layout fill-window) window source)
  (call (. t expect)
    (block
      (arg "clamped")
      (arg "21 2 3")
      (arg (str (. window resolved-scroll-y) " " (. window placement-count) " " (. ([] (. window placements) 1) placement-id)))
    )
  )
  (blank)
  (call (. t expect) "record" true (call (. layout record-row-height) ([] (. window placements) 0) 4vcoord))
  (= (. window viewport-width) 2vcoord)
  (= (. window frame-width) 2vcoord)
  (call (. layout fill-window) window source)
  (call (. t expect)
    (block
      (arg "narrower")
      (arg "6 4 false")
      (arg (str (. ([] (. window placements) 3) height) " " (. ([] (. window placements) 2) height) " " (call (. layout is-row-measured) 2)))
    )
  )
  (return t)
)

(fn-do _ retention-tests _
  (param t TestCase)
  (let recycler (call retaining-recycler))
  (let log (as (!! (. recycler owner)) VirtualDepartureLog))
  (call request-retained recycler 0vcoord)
  (call (. t expect)
    (block
      (arg "start pool")
      (arg "4 placements 14")
      (arg (str (. recycler pool-size) " placements " (. recycler window placement-count)))
    )
  )
  (call (. t expect) "start row 5 bound" false (!= (call slot-for-address recycler 5) null))
  (blank)
  (call request-retained recycler 60vcoord)
  (call (. t expect) "scrolled pool" "8 departures 0" (str (. recycler pool-size) " departures " (. log count)))
  (call (. t expect) "scrolled row 0 slot" true (!= (call slot-for-address recycler 0) null))
  (call (. t expect) "scrolled row 0 placement" true (!= (call placement-for-address recycler 0) null))
  (call (. t expect) "scrolled row 5 bound" false (!= (call slot-for-address recycler 5) null))
  (blank)
  (let binds (. recycler stats source-binds))
  (call request-retained recycler 0vcoord)
  (call (. t expect)
    (block
      (arg "returned binds")
      (arg "0 departures 0")
      (arg (str (- (. recycler stats source-binds) binds) " departures " (. log count)))
    )
  )
  (blank)
  (call request-retained recycler 400vcoord)
  (call (. t expect) "far pool" "8 departures 8" (str (. recycler pool-size) " departures " (. log count)))
  (call (. t expect) "far row 0 bound" false (!= (call slot-for-address recycler 0) null))
  (blank)
  (= (. recycler retention) (call VirtualInsets 0vcoord 0vcoord 0vcoord 0vcoord))
  (call request-retained recycler 440vcoord)
  (call (. t expect)
    (block
      (arg "unretained placements")
      (arg "4 departures 12")
      (arg (str (. recycler window placement-count) " departures " (. log count)))
    )
  )
  (return t)
)

(fn-do _ holds-tests _
  (param t TestCase)
  (let recycler (call retaining-recycler))
  (call request-retained recycler 0vcoord)
  (call (. t expect) "built" true (call (. recycler holds) 0vcoord 0vcoord 80vcoord 35vcoord))
  (call (. t expect) "unbuilt" false (call (. recycler holds) 0vcoord 10vcoord 80vcoord 35vcoord))
  (blank)
  (call request-retained recycler 60vcoord)
  (call (. t expect) "gap" false (call (. recycler holds) 0vcoord 0vcoord 80vcoord 35vcoord))
  (call request-retained recycler 40vcoord)
  (call request-retained recycler 20vcoord)
  (call (. t expect) "behind" true (call (. recycler holds) 0vcoord 0vcoord 80vcoord 35vcoord))
  (call (. t expect) "ahead" true (call (. recycler holds) 0vcoord 60vcoord 80vcoord 35vcoord))
  (call (. t expect) "past built" false (call (. recycler holds) 0vcoord 70vcoord 80vcoord 35vcoord))
  (call (. t expect) "outside band" false (call (. recycler holds) 0vcoord 120vcoord 80vcoord 35vcoord))
  (blank)
  (let short (call (of VirtualRecycler I64)))
  (= (. short source) (call VirtualRangeSource 3vcoord))
  (= (. short layout) (call VerticalMeasuredLayout 10vcoord null 7vcoord 3vcoord))
  (= (. short window viewport-width) 80vcoord)
  (= (. short window frame-width) 80vcoord)
  (= (. short window viewport-height) 35vcoord)
  (= (. short window frame-height) 35vcoord)
  (call (. short refresh))
  (call (. t expect) "leading space" true (call (. short holds) 0vcoord 0vcoord 80vcoord 35vcoord))
  (call (. t expect) "trailing space" true (call (. short holds) 0vcoord 5vcoord 80vcoord 35vcoord))
  (return t)
)

(fn-do _ growing-bind-tests _
  (param t TestCase)
  (let source (call VirtualGrowingSource 1000000vcoord))
  (let recycler (call (of VirtualRecycler I64)))
  (= (. recycler source) source)
  (= (. recycler layout) (call VerticalFixedLayout 1vcoord))
  (= (. recycler window viewport-width) 80vcoord)
  (= (. recycler window frame-width) 80vcoord)
  (= (. recycler window viewport-height) 4vcoord)
  (= (. recycler window frame-height) 4vcoord)
  (= (. recycler window overscan-bottom) 3vcoord)
  (call (. recycler refresh))
  (call (. t expect) "known" 7vcoord (. source known-count))
  (call (. t expect) "binds" 7 (. source bind-count))
  (call (. t expect) "pool" 7 (. recycler pool-size))
  (return t)
)

(fn-do _ grid-layout-tests _
  (param t TestCase)
  (let recycler (call (of VirtualRecycler I64)))
  (= (. recycler source) (call VirtualRangeSource 100vcoord))
  (= (. recycler layout) (call VerticalGridLayout 20vcoord 4vcoord))
  (= (. recycler window viewport-width) 90vcoord)
  (= (. recycler window frame-width) 90vcoord)
  (= (. recycler window viewport-height) 40vcoord)
  (= (. recycler window frame-height) 40vcoord)
  (call (. recycler refresh))
  (call (. t expect) "extent-x" "(90, 90, true)" (str (. recycler window extent-x)))
  (call (. t expect) "first" "(11, 0, 20, 20)" (str (. ([] (. recycler window placements) 0) rect)))
  (call (. t expect) "second row" "(11, 24, 20, 20)" (str (. ([] (. recycler window placements) 3) rect)))
  (call (. t expect) "holds" true (call (. recycler holds) 0vcoord 0vcoord 90vcoord 40vcoord))
  (return t)
)
