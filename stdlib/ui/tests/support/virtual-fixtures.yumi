/ui/virtual
/ui/virtual-layout
/ui/virtual-recycler

━━━━━━━━━━━━━━━━━━━━
+ do fixed-recycler

. recycler = VirtualRecycler'I64()
recycler.source = VirtualRangeSource(1000000000vcoord)
recycler.layout = VerticalFixedLayout(4vcoord)
recycler.owner = VirtualDepartureLog(recycler)
= recycler

━━━━━━━━━━━━━━━━━━━━
+ do retaining-recycler

. recycler = VirtualRecycler'I64()
recycler.source = VirtualRangeSource(100vcoord)
recycler.layout = VerticalMeasuredLayout(10vcoord)
recycler.retention = VirtualInsets(100vcoord, 0vcoord, 100vcoord, 0vcoord)
recycler.owner = VirtualDepartureLog(recycler)
= recycler

━━━━━━━━━━━━━━━━━━━━
+ do open-recycler
    - source VirtualGrowingSource

. recycler = VirtualRecycler'I64()
recycler.source = source
recycler.layout = VerticalFixedLayout(1vcoord)
. window = recycler.window
window.viewport-width = 10vcoord
window.frame-width = 10vcoord
window.viewport-height = 10vcoord
window.frame-height = 10vcoord
recycler.refresh()
= recycler

━━━━━━━━━━━━━━━━━━━━
+ do request
    - recycler VirtualRecycler'I64
    - scroll-y VirtualCoord
    - viewport-height VirtualCoord

. window = recycler.window
window.scroll-y = scroll-y
window.viewport-width = 80vcoord
window.frame-width = 80vcoord
window.viewport-height = viewport-height
window.frame-height = viewport-height
window.overscan-top = 12vcoord
window.overscan-bottom = 12vcoord
recycler.refresh()

━━━━━━━━━━━━━━━━━━━━
+ do request-retained
    - recycler VirtualRecycler'I64
    - scroll-y VirtualCoord

. window = recycler.window
window.scroll-y = scroll-y
window.viewport-width = 80vcoord
window.frame-width = 80vcoord
window.viewport-height = 35vcoord
window.frame-height = 35vcoord
recycler.refresh()

━━━━━━━━━━━━━━━━━━━━
+ do slots-match-placements Bool
    - recycler VirtualRecycler'I64

. placed Size
for index in 0 .. < recycler.pool-size
    . slot = recycler.slot-at(index)!
    . placement = recycler.placement-for-slot(index)
    if placement
        =? false if !slot.is-bound || slot.address != placement.address
        placed += 1
    else
        =? false if slot.is-bound
= placed == recycler.window.placement-count

━━━━━━━━━━━━━━━━━━━━
+ do bound-slot-count
    - recycler VirtualRecycler'I64

. count Size
for index in 0 .. < recycler.pool-size
    if recycler.slot-at(index)!.is-bound
        count += 1
= count

━━━━━━━━━━━━━━━━━━━━
+ do slot-for-address VirtualSlot'I64?
    - recycler VirtualRecycler'I64
    - address I64

for index in 0 .. < recycler.pool-size
    . slot = recycler.slot-at(index)!
    =? slot if slot.is-bound && slot.address == address
= null

━━━━━━━━━━━━━━━━━━━━
+ do placement-for-address VirtualPlacement?
    - recycler VirtualRecycler'I64
    - address I64

for index in 0 .. < recycler.pool-size
    . slot = recycler.slot-at(index)!
    =? recycler.placement-for-slot(index) if slot.is-bound && slot.address == address
= null

━━━━━━━━━━━━━━━━━━━━
+ VirtualDepartureLog
    is VirtualRecyclerOwner

+ recycler VirtualRecycler'I64
+ count Size
+ bound-count Size

────────────────────
+ This
    - recycler

────────────────────
+ do virtual-slot-departing
    - slot-index Index

count += 1
if recycler.slot-at(slot-index)?.is-bound ?? false
    bound-count += 1

────────────────────
+ do virtual-slot-arriving
    - slot-index Index

