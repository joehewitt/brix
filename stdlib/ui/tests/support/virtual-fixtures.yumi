━━━━━━━━━━━━━━━━━━━━
+ VirtualGrowingSource
    is VirtualSequenceDomain
    is VirtualSource'I64

+ limit VirtualCoord
+ known VirtualCoord
+ finished Bool
+ revision := VirtualRevision()
+ bind-count Size

────────────────────
+ This
    - limit

────────────────────
+ get known-count VirtualCoord

known

────────────────────
+ get estimated-count VirtualCoord?

null

────────────────────
+ get is-final Bool

finished

────────────────────
+ address-at I64
    - index VirtualCoord

index

────────────────────
+ index-of VirtualCoord?
    - address I64

|? address < 0 || address >= (known as I64)
    null
??
    address as VirtualCoord

────────────────────
+ get domain VirtualSequenceDomain

this

────────────────────
+ do bind
    - address I64
    - generation U64
    - target VirtualBindingTarget'I64

bind-count += 1
if address == (known as I64) && known < limit
    known += 1vcoord
    finished = known == limit
if address >= 0 && address < (known as I64)
    target.commit(VirtualKey(revision.value, address), address, generation)
else
    target.fail(generation)

━━━━━━━━━━━━━━━━━━━━
+ VirtualReplaySource
    is VirtualSequenceDomain
    is VirtualSource'I64

+ count VirtualCoord
+ revision := VirtualRevision()

_ last-target VirtualBindingTarget'I64?
_ last-generation U64
_ last-address I64

────────────────────
+ This
    - count

────────────────────
+ do replay

. target = last-target
=? if !target
target.commit(VirtualKey(revision.value, last-address), last-address + 1, last-generation)

────────────────────
+ get known-count VirtualCoord

count

────────────────────
+ get estimated-count VirtualCoord?

count

────────────────────
+ get is-final Bool

true

────────────────────
+ address-at I64
    - index VirtualCoord

index

────────────────────
+ index-of VirtualCoord?
    - address I64

|? address < 0 || address >= (count as I64)
    null
??
    address as VirtualCoord

────────────────────
+ get domain VirtualSequenceDomain

this

────────────────────
+ do bind
    - address I64
    - generation U64
    - target VirtualBindingTarget'I64

last-target = target
last-generation = generation
last-address = address
if address >= 0 && address < (count as I64)
    target.commit(VirtualKey(revision.value, address), address, generation)
else
    target.fail(generation)
