/test
/ui/tests/support/virtual-fixtures
/ui/virtual
/ui/virtual-layout
/ui/virtual-recycler

tests()

━━━━━━━━━━━━━━━━━━━━
+ do tests TestRender

. cases = TestCase("Virtual Vertical Fixed Rows")
cases.run(vertical-fixed-tests)
cases = cases.then("Virtual Vertical Fixed Horizontal Scroll", vertical-fixed-scroll-x-tests)
cases = cases.then("Virtual Horizontal Fixed Columns", horizontal-fixed-tests)
cases = cases.then("Virtual Open Domain Extent", open-domain-tests)
cases = cases.then("Virtual Rect For Address", rect-for-address-tests)
cases = cases.then("Virtual Recycler Fill And Release", recycler-release-tests)
cases = cases.then("Virtual Recycler Scroll Reuse", recycler-reuse-tests)
cases = cases.then("Virtual Recycler Shrink And Regrow", recycler-regrow-tests)
cases = cases.then("Virtual Recycler Revision And Replacement", recycler-revision-tests)
cases = cases.then("Virtual Recycler Growing Source", growing-source-tests)
cases = cases.then("Virtual Recycler List Identity", list-identity-tests)
cases = cases.then("Virtual Measured Rows", measured-row-tests)
cases = cases.then("Virtual Measured Estimate And Padding", measured-estimate-tests)
cases = cases.then("Virtual Recycler Retention", retention-tests)
cases = cases.then("Virtual Recycler Holds", holds-tests)
cases = cases.then("Virtual Growing Source Binds", growing-bind-tests)
cases = cases.then("Virtual Grid Layout", grid-layout-tests)
= cases

━━━━━━━━━━━━━━━━━━━━
_ do vertical-fixed-tests
    - t TestCase

. source = VirtualRangeSource(1000000000vcoord)
. layout = VerticalFixedLayout(4vcoord)
. window = VirtualWindow()
window.scroll-y = 4001vcoord
window.viewport-width = 80vcoord
window.frame-width = 80vcoord
window.viewport-height = 24vcoord
window.frame-height = 24vcoord
window.set-overscan(VirtualInsets(12vcoord, 0vcoord, 12vcoord, 0vcoord))
layout.fill-window(window, source)
t.expect("placements", 13, window.placement-count)
t.expect
    - "first"
    - "997 (0, 3988, 80, 4)"
    - "${window.placements[0].placement-id} ${window.placements[0].rect}"
t.expect
    - "last"
    - "1009 1009"
    - "${window.placements[12].placement-id} ${window.placements[12].address}"
t.expect("scroll", "(0, 4001)", "${window.resolved-scroll}")
t.expect("extent-y", "(4000000000, 4000000000, true)", "${window.extent-y}")
t.expect("extent-x", "(80, 80, true)", "${window.extent-x}")

window.scroll-y = 4000vcoord
layout.fill-window(window, source)
t.expect("aligned placements", 12, window.placement-count)

window.scroll-y = 9000000000000vcoord
layout.fill-window(window, source)
t.expect("end scroll", 3999999976vcoord, window.resolved-scroll-y)
t.expect
    - "end last"
    - 999999999vcoord
    - window.placements[window.placement-count - 1].placement-id

window.scroll-y = -50vcoord
layout.fill-window(window, source)
t.expect("start scroll", 0vcoord, window.resolved-scroll-y)
t.expect("start first", 0vcoord, window.placements[0].placement-id)
t.expect("start placements", 9, window.placement-count)
= t

━━━━━━━━━━━━━━━━━━━━
_ do vertical-fixed-scroll-x-tests
    - t TestCase

. source = VirtualRangeSource(100vcoord)
. window = VirtualWindow()
window.scroll-x = 500vcoord
window.viewport-width = 80vcoord
window.frame-width = 80vcoord
window.viewport-height = 24vcoord
window.frame-height = 24vcoord

. filling = VerticalFixedLayout(4vcoord)
filling.fill-window(window, source)
t.expect("filling scroll-x", 0vcoord, window.resolved-scroll-x)

. wide = VerticalFixedLayout(4vcoord, 200vcoord)
wide.fill-window(window, source)
t.expect("wide extent-x", "(200, 200, true)", "${window.extent-x}")
t.expect("wide scroll-x", 120vcoord, window.resolved-scroll-x)
t.expect("wide row", "0 200", "${window.placements[0].x} ${window.placements[0].width}")

window.scroll-x = 40vcoord
wide.fill-window(window, source)
t.expect("inside scroll-x", 40vcoord, window.resolved-scroll-x)
= t

━━━━━━━━━━━━━━━━━━━━
_ do horizontal-fixed-tests
    - t TestCase

. source = VirtualRangeSource(1000vcoord)
. window = VirtualWindow()
window.scroll-x = 1005vcoord
window.scroll-y = 7vcoord
window.viewport-width = 100vcoord
window.frame-width = 100vcoord
window.viewport-height = 30vcoord
window.frame-height = 30vcoord
window.set-overscan(VirtualInsets(0vcoord, 20vcoord, 0vcoord, 20vcoord))

. layout = HorizontalFixedLayout(10vcoord)
layout.fill-window(window, source)
t.expect("placements", 15, window.placement-count)
t.expect
    - "first"
    - "98 (980, 0, 10, 30)"
    - "${window.placements[0].placement-id} ${window.placements[0].rect}"
t.expect("scroll", "(1005, 0)", "${window.resolved-scroll}")
t.expect("extent-x", "(10000, 10000, true)", "${window.extent-x}")
t.expect("extent-y", "(30, 30, true)", "${window.extent-y}")

. tall = HorizontalFixedLayout(10vcoord, 50vcoord)
tall.fill-window(window, source)
t.expect("tall scroll-y", 7vcoord, window.resolved-scroll-y)
t.expect("tall extent-y", "(50, 50, true)", "${window.extent-y}")

window.scroll-y = 99vcoord
tall.fill-window(window, source)
t.expect("clamped scroll-y", 20vcoord, window.resolved-scroll-y)
= t

━━━━━━━━━━━━━━━━━━━━
_ do open-domain-tests
    - t TestCase

. domain = VirtualTestDomain(5vcoord)
. window = VirtualWindow()
window.viewport-width = 10vcoord
window.frame-width = 10vcoord
window.viewport-height = 10vcoord
window.frame-height = 10vcoord
. layout = VerticalFixedLayout(1vcoord)
layout.fill-window(window, domain)
t.expect("open", "6 (5, unknown, false)", "${window.placement-count} ${window.extent-y}")

domain.estimate = 40vcoord
layout.fill-window(window, domain)
t.expect("estimated", "6 (5, 40, false)", "${window.placement-count} ${window.extent-y}")

domain.finished = true
layout.fill-window(window, domain)
t.expect("final", "5 (5, 40, true)", "${window.placement-count} ${window.extent-y}")
= t

━━━━━━━━━━━━━━━━━━━━
_ do rect-for-address-tests
    - t TestCase

. source = VirtualRangeSource(1000vcoord)
. window = VirtualWindow()
window.frame-width = 80vcoord
window.frame-height = 24vcoord
. rows = VerticalFixedLayout(4vcoord)
. columns = HorizontalFixedLayout(10vcoord, 50vcoord)
t.expect("row 123", "(0, 492, 80, 4)", "${rows.rect-for-address(123, source, window)}")
t.expect("column 7", "(70, 0, 10, 50)", "${columns.rect-for-address(7, source, window)}")
t.expect("row -1", "unknown", "${rows.rect-for-address(-1, source, window)}")
t.expect("row 1000", "unknown", "${rows.rect-for-address(1000, source, window)}")

. hosted = VerticalRowLayout()
window.row-height = 6vcoord
t.expect("hosted row 123", "(0, 738, 80, 6)", "${hosted.rect-for-address(123, source, window)}")
window.viewport-width = 40vcoord
window.viewport-height = 24vcoord
hosted.fill-window(window, source)
t.expect
    - "hosted"
    - "4 (0, 6, 80, 6) 6000"
    - "${window.placement-count} ${window.placements[1].rect} ${window.known-height}"
. opened = VerticalRowLayout(2vcoord)
opened.fill-window(window, source)
t.expect("gap", "(0, 18, 80, 6)", "${window.placements[2].rect}")
window.row-height = 0vcoord
hosted.fill-window(window, source)
t.expect("fallback", 1000vcoord, window.known-height)
= t

━━━━━━━━━━━━━━━━━━━━
_ do recycler-release-tests
    - t TestCase

. recycler = fixed-recycler()
request(recycler, 4001vcoord, 24vcoord)
t.expect("pool", 13, recycler.pool-size)
t.expect("binds", 13, recycler.stats.source-binds)
t.expect("matched", true, slots-match-placements(recycler))
t.expect("first address", 997, recycler.slot-at(0)!.address)
t.expect("changes", true, recycler.has-pending-changes)

recycler.has-pending-changes = false
request(recycler, 4001vcoord, 24vcoord)
t.expect("unchanged changes", false, recycler.has-pending-changes)
t.expect("unchanged binds", 13, recycler.stats.source-binds)

. log = recycler.owner! as VirtualDepartureLog
recycler.release()
t.expect("release departures", "13 bound 13", "${log.count} bound ${log.bound-count}")
t.expect("release pool", 0, recycler.pool-size)
t.expect("release changes", true, recycler.has-pending-changes)
= t

━━━━━━━━━━━━━━━━━━━━
_ do recycler-reuse-tests
    - t TestCase

. recycler = fixed-recycler()
. log = recycler.owner! as VirtualDepartureLog
request(recycler, 4001vcoord, 24vcoord)

. prior = recycler.stats
for step in 0 .. < 64
    request(recycler, if step % 2 == 0 then 4001vcoord else 4002vcoord, 24vcoord)
. current = recycler.stats
t.expect("stable binds", 0, current.source-binds - prior.source-binds)
t.expect("stable departures", 0, current.departures - prior.departures)

prior = recycler.stats
. y = 4001vcoord
for _ in 0 .. < 100
    y += 4vcoord
    request(recycler, y, 24vcoord)
current = recycler.stats
t.expect("adjacent binds", 100, current.source-binds - prior.source-binds)
t.expect("adjacent departures", 100, current.departures - prior.departures)
t.expect("adjacent pool", 13, recycler.pool-size)
t.expect("adjacent matched", true, slots-match-placements(recycler))
t.expect("departed", "100 bound 100", "${log.count} bound ${log.bound-count}")

prior = recycler.stats
request(recycler, 2000000001vcoord, 24vcoord)
current = recycler.stats
t.expect("jump binds", 13, current.source-binds - prior.source-binds)
t.expect("jump pool", 13, recycler.pool-size)
t.expect("jump matched", true, slots-match-placements(recycler))
t.expect("jump first address", 499999997, recycler.window.placements[0].address)
= t

━━━━━━━━━━━━━━━━━━━━
_ do recycler-regrow-tests
    - t TestCase

. recycler = fixed-recycler()
. log = recycler.owner! as VirtualDepartureLog
request(recycler, 4001vcoord, 48vcoord)
t.expect("tall pool", 19, recycler.pool-size)

. departures = log.count
request(recycler, 4001vcoord, 24vcoord)
t.expect("shrink pool", 19, recycler.pool-size)
t.expect("shrink departures", 6, log.count - departures)
t.expect("shrink bound", 13, bound-slot-count(recycler))
t.expect("shrink matched", true, slots-match-placements(recycler))

. prior = recycler.stats
request(recycler, 4001vcoord, 48vcoord)
. current = recycler.stats
t.expect("regrow created", 0, current.pool-created - prior.pool-created)
t.expect("regrow binds", 6, current.source-binds - prior.source-binds)
t.expect("regrow bound", 19, bound-slot-count(recycler))
= t

━━━━━━━━━━━━━━━━━━━━
_ do recycler-revision-tests
    - t TestCase

. recycler = fixed-recycler()
. source = recycler.source! as VirtualRangeSource
request(recycler, 4001vcoord, 24vcoord)
. first-slot = recycler.slot-at(0)!
. first-generation = first-slot.generation

. prior = recycler.stats
source.bump-revision()
request(recycler, 4001vcoord, 24vcoord)
. current = recycler.stats
t.expect("revision binds", 13, current.source-binds - prior.source-binds)
t.expect("revision pool", 13, recycler.pool-size)
t.expect("revision key", 1u, recycler.slot-at(0)!.key.revision)
t.expect("revision generation advanced", true, first-slot.generation > first-generation)

prior = recycler.stats
recycler.source = VirtualRangeSource(1000000000vcoord)
request(recycler, 4001vcoord, 24vcoord)
current = recycler.stats
t.expect("replaced binds", 13, current.source-binds - prior.source-binds)
t.expect("replaced created", 0, current.pool-created - prior.pool-created)
t.expect("replaced key", 0u, recycler.slot-at(0)!.key.revision)

. replay = VirtualReplaySource(100vcoord)
recycler.source = replay
request(recycler, 0vcoord, 24vcoord)
. address = recycler.slot-at(0)!.address
. stale = recycler.stats.stale-commits
replay.replay()
t.expect("stale commits", 1, recycler.stats.stale-commits - stale)
t.expect("stale address kept", true, recycler.slot-at(0)!.address == address)
= t

━━━━━━━━━━━━━━━━━━━━
_ do growing-source-tests
    - t TestCase

. unbounded = open-recycler(VirtualGrowingSource(1000vcoord))
t.expect("unbounded pool", 10, unbounded.pool-size)
t.expect("unbounded extent", "(10, unknown, false)", "${unbounded.window.extent-y}")
t.expect("unbounded matched", true, slots-match-placements(unbounded))

. short = open-recycler(VirtualGrowingSource(4vcoord))
t.expect("short pool", 4, short.pool-size)
t.expect("short extent", "(4, unknown, true)", "${short.window.extent-y}")

. stalled = open-recycler(VirtualGrowingSource(0vcoord))
t.expect("stalled pool", 0, stalled.pool-size)
t.expect("stalled placements", 1, stalled.window.placement-count)
= t

━━━━━━━━━━━━━━━━━━━━
_ do list-identity-tests
    - t TestCase

. source = VirtualListSource'String()
source.identity = :: name => hash-for(name) as U64
source.replace(list-names(100, ""))
. recycler = VirtualRecycler'String()
recycler.source = source
recycler.layout = VerticalFixedLayout(4vcoord)
request-list(recycler)
t.expect("pool", 9, recycler.pool-size)
t.expect("first", "row-0", recycler.slot-at(0)!.item)
t.expect("extent", 400vcoord, recycler.window.extent-y.known)

. inserted = list-names(100, "")
inserted.insert("new-b", 0)
inserted.insert("new-a", 0)
. prior = recycler.stats
source.replace(inserted)
request-list(recycler)
. current = recycler.stats
t.expect("insert departures", 2, current.departures - prior.departures)
t.expect("insert binds", 9, current.source-binds - prior.source-binds)
t.expect("insert pool", 9, recycler.pool-size)
t.expect
    - "insert slot"
    - "row-0 2"
    - "${recycler.slot-at(0)!.item} ${recycler.slot-at(0)!.address}"
t.expect("insert matched", true, list-slots-match(recycler))

. removed = list-names(100, "")
removed.insert("new-b", 0)
removed.insert("new-a", 0)
removed.remove(5)
prior = recycler.stats
source.replace(removed)
request-list(recycler)
current = recycler.stats
t.expect("remove departures", 1, current.departures - prior.departures)
t.expect("remove matched", true, list-slots-match(recycler))

source.identity = null
prior = recycler.stats
source.replace(list-names(100, "x"))
request-list(recycler)
current = recycler.stats
t.expect("plain departures", 9, current.departures - prior.departures)
t.expect("plain matched", true, list-slots-match(recycler))
= t

━━━━━━━━━━━━━━━━━━━━
_ list-names [String]
    - count Size
    - prefix String

** "${prefix}row-$each" in 0 .. < count

━━━━━━━━━━━━━━━━━━━━
_ do request-list
    - recycler VirtualRecycler'String

. window = recycler.window
window.scroll-y = 0vcoord
window.viewport-width = 80vcoord
window.frame-width = 80vcoord
window.viewport-height = 24vcoord
window.frame-height = 24vcoord
window.overscan-top = 12vcoord
window.overscan-bottom = 12vcoord
recycler.refresh()

━━━━━━━━━━━━━━━━━━━━
_ do list-slots-match
    - recycler VirtualRecycler'String

. list = recycler.source! as VirtualListSource'String
. placed Size
for index in 0 .. < recycler.pool-size
    . slot = recycler.slot-at(index)!
    . placement = recycler.placement-for-slot(index)
    if placement
        =? false if !slot.is-bound || slot.address != placement.address
        =? false if slot.item != list.items[placement.address]
        placed += 1
    else
        =? false if slot.is-bound
= placed == recycler.window.placement-count

━━━━━━━━━━━━━━━━━━━━
_ do measured-row-tests
    - t TestCase

. source = VirtualRangeSource(100vcoord)
. layout = VerticalMeasuredLayout(10vcoord)
. window = VirtualWindow()
window.viewport-width = 80vcoord
window.frame-width = 80vcoord
window.viewport-height = 35vcoord
window.frame-height = 35vcoord
t.expect
    - "measures rows"
    - "true false"
    - "${layout.measures-rows} ${VerticalFixedLayout(4vcoord).measures-rows}"
layout.fill-window(window, source)
t.expect
    - "estimated"
    - "4 (1000, 1000, true) false"
    - "${window.placement-count} ${window.extent-y} ${layout.is-row-measured(1)}"

t.expect
    - "record"
    - "true true"
    - "${layout.record-row-height(window.placements[1], 25vcoord)} ${layout.is-row-measured(1)}"
layout.fill-window(window, source)
t.expect("repeat", false, layout.record-row-height(window.placements[1], 25vcoord))
t.expect
    - "measured"
    - "2 (0, 10, 80, 25) 1015"
    - "${window.placement-count} ${window.placements[1].rect} ${window.known-height}"
t.expect("address 50", "(0, 515, 80, 10)", "${layout.rect-for-address(50, source, window)}")
t.expect("address 100", "unknown", "${layout.rect-for-address(100, source, window)}")

window.scroll-y = 5000vcoord
layout.fill-window(window, source)
t.expect
    - "clamped"
    - "980 99"
    - "${window.resolved-scroll-y} ${window.placements[window.placement-count - 1].placement-id}"

window.scroll-y = 0vcoord
window.set-overscan(VirtualInsets(0vcoord, 0vcoord, 20vcoord, 0vcoord))
layout.fill-window(window, source)
t.expect("overscan", 4, window.placement-count)

window.set-overscan(VirtualInsets(0vcoord, 0vcoord, 0vcoord, 0vcoord))
window.viewport-width = 60vcoord
window.frame-width = 60vcoord
layout.fill-window(window, source)
t.expect
    - "narrower"
    - "false 1015 60"
    - "${layout.is-row-measured(1)} ${window.known-height} ${window.placements[0].width}"

source.count = 1vcoord
layout.fill-window(window, source)
t.expect("shrunk", "1 10", "${layout.row-count} ${window.known-height}")
source.count = 3vcoord
layout.fill-window(window, source)
t.expect("regrown", 30vcoord, window.known-height)

layout.reset()
t.expect("reset", 0, layout.row-count)
= t

━━━━━━━━━━━━━━━━━━━━
_ do measured-estimate-tests
    - t TestCase

. source = VirtualRangeSource(4vcoord)
. layout = VerticalMeasuredLayout(10vcoord, null, 7vcoord, 3vcoord)
layout.estimate = :: address, width => (address as VirtualCoord) * width
. window = VirtualWindow()
window.viewport-width = 5vcoord
window.frame-width = 5vcoord
window.viewport-height = 100vcoord
window.frame-height = 100vcoord
layout.fill-window(window, source)
t.expect("placements", 4, window.placement-count)
t.expect("row 0", "(0, 7, 5, 1)", "${window.placements[0].rect}")
t.expect("row 2", "(0, 13, 5, 10)", "${window.placements[2].rect}")
t.expect("height", 41vcoord, window.known-height)
t.expect("address 3", "(0, 23, 5, 15)", "${layout.rect-for-address(3, source, window)}")

window.viewport-height = 20vcoord
window.frame-height = 20vcoord
window.scroll-y = 500vcoord
layout.fill-window(window, source)
t.expect
    - "clamped"
    - "21 2 3"
    - "${window.resolved-scroll-y} ${window.placement-count} ${window.placements[1].placement-id}"

t.expect("record", true, layout.record-row-height(window.placements[0], 4vcoord))
window.viewport-width = 2vcoord
window.frame-width = 2vcoord
layout.fill-window(window, source)
t.expect
    - "narrower"
    - "6 4 false"
    - "${window.placements[3].height} ${window.placements[2].height} ${layout.is-row-measured(2)}"
= t

━━━━━━━━━━━━━━━━━━━━
_ do retention-tests
    - t TestCase

. recycler = retaining-recycler()
. log = recycler.owner! as VirtualDepartureLog
request-retained(recycler, 0vcoord)
t.expect
    - "start pool"
    - "4 placements 14"
    - "${recycler.pool-size} placements ${recycler.window.placement-count}"
t.expect("start row 5 bound", false, slot-for-address(recycler, 5) != null)

request-retained(recycler, 60vcoord)
t.expect("scrolled pool", "8 departures 0", "${recycler.pool-size} departures ${log.count}")
t.expect("scrolled row 0 slot", true, slot-for-address(recycler, 0) != null)
t.expect("scrolled row 0 placement", true, placement-for-address(recycler, 0) != null)
t.expect("scrolled row 5 bound", false, slot-for-address(recycler, 5) != null)

. binds = recycler.stats.source-binds
request-retained(recycler, 0vcoord)
t.expect
    - "returned binds"
    - "0 departures 0"
    - "${recycler.stats.source-binds - binds} departures ${log.count}"

request-retained(recycler, 400vcoord)
t.expect("far pool", "8 departures 8", "${recycler.pool-size} departures ${log.count}")
t.expect("far row 0 bound", false, slot-for-address(recycler, 0) != null)

recycler.retention = VirtualInsets(0vcoord, 0vcoord, 0vcoord, 0vcoord)
request-retained(recycler, 440vcoord)
t.expect
    - "unretained placements"
    - "4 departures 12"
    - "${recycler.window.placement-count} departures ${log.count}"
= t

━━━━━━━━━━━━━━━━━━━━
_ do holds-tests
    - t TestCase

. recycler = retaining-recycler()
request-retained(recycler, 0vcoord)
t.expect("built", true, recycler.holds(0vcoord, 0vcoord, 80vcoord, 35vcoord))
t.expect("unbuilt", false, recycler.holds(0vcoord, 10vcoord, 80vcoord, 35vcoord))

request-retained(recycler, 60vcoord)
t.expect("gap", false, recycler.holds(0vcoord, 0vcoord, 80vcoord, 35vcoord))
request-retained(recycler, 40vcoord)
request-retained(recycler, 20vcoord)
t.expect("behind", true, recycler.holds(0vcoord, 0vcoord, 80vcoord, 35vcoord))
t.expect("ahead", true, recycler.holds(0vcoord, 60vcoord, 80vcoord, 35vcoord))
t.expect("past built", false, recycler.holds(0vcoord, 70vcoord, 80vcoord, 35vcoord))
t.expect("outside band", false, recycler.holds(0vcoord, 120vcoord, 80vcoord, 35vcoord))

. short = VirtualRecycler'I64()
short.source = VirtualRangeSource(3vcoord)
short.layout = VerticalMeasuredLayout(10vcoord, null, 7vcoord, 3vcoord)
short.window.viewport-width = 80vcoord
short.window.frame-width = 80vcoord
short.window.viewport-height = 35vcoord
short.window.frame-height = 35vcoord
short.refresh()
t.expect("leading space", true, short.holds(0vcoord, 0vcoord, 80vcoord, 35vcoord))
t.expect("trailing space", true, short.holds(0vcoord, 5vcoord, 80vcoord, 35vcoord))
= t

━━━━━━━━━━━━━━━━━━━━
_ do growing-bind-tests
    - t TestCase

. source = VirtualGrowingSource(1000000vcoord)
. recycler = VirtualRecycler'I64()
recycler.source = source
recycler.layout = VerticalFixedLayout(1vcoord)
recycler.window.viewport-width = 80vcoord
recycler.window.frame-width = 80vcoord
recycler.window.viewport-height = 4vcoord
recycler.window.frame-height = 4vcoord
recycler.window.overscan-bottom = 3vcoord
recycler.refresh()
t.expect("known", 7vcoord, source.known-count)
t.expect("binds", 7, source.bind-count)
t.expect("pool", 7, recycler.pool-size)
= t

━━━━━━━━━━━━━━━━━━━━
_ do grid-layout-tests
    - t TestCase

. recycler = VirtualRecycler'I64()
recycler.source = VirtualRangeSource(100vcoord)
recycler.layout = VerticalGridLayout(20vcoord, 4vcoord)
recycler.window.viewport-width = 90vcoord
recycler.window.frame-width = 90vcoord
recycler.window.viewport-height = 40vcoord
recycler.window.frame-height = 40vcoord
recycler.refresh()
t.expect("extent-x", "(90, 90, true)", "${recycler.window.extent-x}")
t.expect("first", "(11, 0, 20, 20)", "${recycler.window.placements[0].rect}")
t.expect("second row", "(11, 24, 20, 20)", "${recycler.window.placements[3].rect}")
t.expect("holds", true, recycler.holds(0vcoord, 0vcoord, 90vcoord, 40vcoord))
= t
