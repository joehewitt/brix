━━━━━━━━━━━━━━━━━━━━
+ PointerButton is Union

| primary
| secondary
| middle
| other U32

━━━━━━━━━━━━━━━━━━━━
+ PointerModifiers is Tuple

+ shift = false
+ control = false
+ option = false
+ command = false
+ caps-lock = false
+ function = false

━━━━━━━━━━━━━━━━━━━━
+ Key is Union

| tab
| enter
| escape
| space
| arrow-up
| arrow-down
| arrow-left
| arrow-right
| home
| end
| page-up
| page-down
| backspace
| delete
| function-key U32
| unknown U32
