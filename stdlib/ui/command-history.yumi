./undo-target
/time/duration
/time/timer

━━━━━━━━━━━━━━━━━━━━
+ CommandHistoryEntry is Interface

────────────────────
+ do undo

────────────────────
+ do redo

────────────────────
+ coalesce Bool
    - next CommandHistoryEntry

false

━━━━━━━━━━━━━━━━━━━━
_ CommandHistoryGroupEntry is Tuple
    is CommandHistoryEntry

+ entries [CommandHistoryEntry]

────────────────────
+ do undo

. index = entries.length
while index > 0
    index -= 1
    entries[index].undo()

────────────────────
+ do redo

for entry in entries
    entry.redo()

━━━━━━━━━━━━━━━━━━━━
_ CommandHistoryStep is Tuple

+ title String
+ entry CommandHistoryEntry

━━━━━━━━━━━━━━━━━━━━
+ CommandHistory
    is UndoTarget

+ limit Size? = 100
+ coalescing Duration? = 1seconds
+ revision U64
+ undo-title = "Undo"
+ redo-title = "Redo"
+ can-undo = false
+ can-redo = false
+ is-modified = false
+ event dropped [CommandHistoryEntry]

_ steps [CommandHistoryStep]
_ cursor Index = 0
_ saved Index? = 0
_ recorded-at U64
_ is-open = false
_ is-replaying = false
_ group-depth Size
_ group-title = ""
_ grouped [CommandHistoryEntry]

+ undo-count => cursor
+ redo-count => steps.length - cursor

────────────────────
+ group
    - title String

CommandHistoryGroupScope(this, title)

────────────────────
+ do entries <CommandHistoryEntry>

for step in steps
    <<= command-history-leaves(step.entry)

────────────────────
+ do record
    - title String
    - entry CommandHistoryEntry

=? if is-replaying
if group-depth
    if !group-title.length
        group-title = title
    grouped += entry
    =
. now = monotonic-time-nanoseconds()
. window = coalescing
. recent = window == null || (now - recorded-at) as Nanoseconds < window
. mergeable = is-open && recent && cursor == steps.length && cursor > 0 && saved != cursor
recorded-at = now
is-open = true
if mergeable && steps[cursor - 1].title == title && steps[cursor - 1].entry.coalesce(entry)
    revision += 1
    =
if saved != null && saved > cursor
    saved = null
. discarded [CommandHistoryEntry]
while steps.length > cursor
    discarded += steps.pop().entry
steps += CommandHistoryStep(title, entry)
cursor += 1
. bound = limit
while bound != null && steps.length > bound
    discarded += steps[0].entry
    steps.remove(0)
    cursor -= 1
    if saved == 0
        saved = null
    else if saved != null
        saved = saved - 1
changed()
drop(discarded)

────────────────────
+ do undo

=? if !can-undo
is-open = false
is-replaying = true
do finally
    is-replaying = false
steps[cursor - 1].entry.undo()
cursor -= 1
changed()

────────────────────
+ do redo

=? if !can-redo
is-open = false
is-replaying = true
do finally
    is-replaying = false
steps[cursor].entry.redo()
cursor += 1
changed()

────────────────────
+ do mark-saved

saved = cursor
is-open = false
changed()

────────────────────
+ do seal

is-open = false

────────────────────
+ do clear

is-open = false
=? if !steps.length
saved = 0 if saved == cursor
. discarded = List'CommandHistoryEntry(each.entry in steps)
steps.clear()
cursor = 0
changed()
drop(discarded)

────────────────────
_ do begin-group
    - title String

if !group-depth
    group-title = title
    grouped = List'CommandHistoryEntry()
group-depth += 1

────────────────────
_ do end-group

=? if !group-depth
group-depth -= 1
=? if group-depth
. entries = grouped
grouped = List'CommandHistoryEntry()
=? if !entries.length
if entries.length == 1
    record(group-title, entries[0])
else
    record(group-title, CommandHistoryGroupEntry(entries))

────────────────────
_ do drop
    - discarded [CommandHistoryEntry]

=? if !discarded.length
. leaves [CommandHistoryEntry]
for entry in discarded
    for leaf in command-history-leaves(entry)
        leaves += leaf
dropped <- leaves

────────────────────
_ do changed

undo-title = if cursor then "Undo ${steps[cursor - 1].title}" else "Undo"
redo-title = if cursor < steps.length then "Redo ${steps[cursor].title}" else "Redo"
can-undo = cursor > 0
can-redo = cursor < steps.length
is-modified = saved != cursor
revision += 1

━━━━━━━━━━━━━━━━━━━━
+ CommandHistoryGroupScope is Tuple
    is Usable'Void

_ history CommandHistory
_ title String

────────────────────
+ This
    - history
    - title

────────────────────
+ do begin-using

history.begin-group(title)

────────────────────
+ do end-using

history.end-group()

━━━━━━━━━━━━━━━━━━━━
_ do command-history-leaves [CommandHistoryEntry]
    - entry CommandHistoryEntry

if | group CommandHistoryGroupEntry = entry
    = group.entries
= [entry]
