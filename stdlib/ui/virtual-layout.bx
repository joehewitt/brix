(import ./virtual)

(type + VirtualPlacement
  (prop + placement-id VirtualCoord)
  (prop + address I64)
  (prop + x VirtualCoord)
  (prop + y VirtualCoord)
  (prop + width VirtualCoord)
  (prop + height VirtualCoord)
  (prop + is-sticky Bool)
  (prop + is-pinned Bool)
  (prop + sticky-depth Index)
  (prop + rect _ (=> (call VirtualRect x y width height)))
)

(type + VirtualWindow
  (prop + scroll-x VirtualCoord)
  (prop + scroll-y VirtualCoord)
  (prop + viewport-width VirtualCoord)
  (prop + viewport-height VirtualCoord)
  (prop + frame-width VirtualCoord)
  (prop + frame-height VirtualCoord)
  (prop + row-height VirtualCoord)
  (prop + overscan-top VirtualCoord)
  (prop + overscan-right VirtualCoord)
  (prop + overscan-bottom VirtualCoord)
  (prop + overscan-left VirtualCoord)
  (prop + placements (list VirtualPlacement))
  (prop + placement-count Size)
  (prop + resolved-scroll-x VirtualCoord)
  (prop + resolved-scroll-y VirtualCoord)
  (prop + known-width VirtualCoord)
  (prop + estimated-width (? VirtualCoord))
  (prop + is-width-final Bool)
  (prop + known-height VirtualCoord)
  (prop + estimated-height (? VirtualCoord))
  (prop + is-height-final Bool)
  (prop + sticky-line (? VirtualCoord))
  (prop + viewport _ (=> (call VirtualSize viewport-width viewport-height)))
  (prop + frame _ (=> (call VirtualSize frame-width frame-height)))
  (prop + resolved-scroll _ (=> (call VirtualPoint resolved-scroll-x resolved-scroll-y)))
  (prop + extent-x _ (=> (call VirtualExtent known-width estimated-width is-width-final)))
  (prop + extent-y _ (=> (call VirtualExtent known-height estimated-height is-height-final)))
  (fn-do + set-overscan _
    (param overscan VirtualInsets)
    (= overscan-top (. overscan top))
    (= overscan-right (. overscan right))
    (= overscan-bottom (. overscan bottom))
    (= overscan-left (. overscan left))
  )
  (fn-do + clear-placements _
    (= placement-count 0)
  )
  (fn-do + place _
    (param placement-id VirtualCoord)
    (param address I64)
    (param x VirtualCoord)
    (param y VirtualCoord)
    (param width VirtualCoord)
    (param height VirtualCoord)
    (throw (call Panic "Virtual placements must have increasing placement ids") (if (and (> placement-count 0) (>= (. ([] placements (- placement-count 1)) placement-id) placement-id))))
    (if (== placement-count (. placements length))
      (+= placements (call VirtualPlacement))
    )
    (let placement ([] placements placement-count))
    (= (. placement placement-id) placement-id)
    (= (. placement address) address)
    (= (. placement x) x)
    (= (. placement y) y)
    (= (. placement width) width)
    (= (. placement height) height)
    (= (. placement is-sticky) false)
    (= (. placement is-pinned) false)
    (= (. placement sticky-depth) 0)
    (+= placement-count 1)
  )
  (fn-do + insert-placement _
    (param position Index)
    (param placement-id VirtualCoord)
    (param address I64)
    (param x VirtualCoord)
    (param y VirtualCoord)
    (param width VirtualCoord)
    (param height VirtualCoord)
    (throw (call Panic "Virtual placements must have increasing placement ids") (if (> position placement-count)))
    (throw (call Panic "Virtual placements must have increasing placement ids") (if (and (> position 0) (>= (. ([] placements (- position 1)) placement-id) placement-id))))
    (throw (call Panic "Virtual placements must have increasing placement ids") (if (and (< position placement-count) (<= (. ([] placements position) placement-id) placement-id))))
    (if (== placement-count (. placements length))
      (+= placements (call VirtualPlacement))
    )
    (let spare ([] placements placement-count))
    (let index placement-count)
    (while (> index position)
      (= ([] placements index) ([] placements (- index 1)))
      (-= index 1)
    )
    (= ([] placements position) spare)
    (= (. spare placement-id) placement-id)
    (= (. spare address) address)
    (= (. spare x) x)
    (= (. spare y) y)
    (= (. spare width) width)
    (= (. spare height) height)
    (= (. spare is-sticky) false)
    (= (. spare is-pinned) false)
    (= (. spare sticky-depth) 0)
    (+= placement-count 1)
  )
  (fn-expr + placement-at _
    (param index Index)
    (only-if ([] placements index) (if (< index placement-count)))
  )
)

(type + VirtualLayout (is Interface)
  (fn-expr + revision (? VirtualRevision) :get
    null
  )
  (fn-expr + fill-window _
    (param window VirtualWindow)
    (param domain VirtualSequenceDomain)
  )
  (fn-expr + rect-for-address (? VirtualRect)
    (param address I64)
    (param domain VirtualSequenceDomain)
    (param window VirtualWindow)
  )
  (fn-expr + measures-rows Bool :get
    false
  )
  (fn-do + record-row-height Bool
    (param placement VirtualPlacement)
    (param height VirtualCoord)
    (return false)
  )
  (fn-expr + has-sticky-rows _ :get
    false
  )
  (fn-expr + sticky-margin _
    (param address I64)
    (param domain VirtualSequenceDomain)
    (param window VirtualWindow)
    0vcoord
  )
)

(type + VirtualStickyRows (is Interface)
  (fn-do + sticky-headers _
    (param address I64)
    (param headers (of List I64))
  )
  (fn-do + sticky-section-last I64
    (param header I64)
  )
)

(type + VerticalStickyLayout
  (implements VirtualLayout)
  (prop + inner VirtualLayout)
  (prop + rows VirtualStickyRows)
  (blank)
  (prop _ headers _ (= (call (of List I64))))
  (prop _ stuck _ (= (call (of List I64))))
  (prop _ stuck-rects _ (= (call (of List VirtualRect))))
  (prop _ stuck-pins _ (= (call (of List Bool))))
  (fn-do + This _
    (param inner _)
    (param rows _)
  )
  (fn-expr + revision (? VirtualRevision) :get
    (. inner revision)
  )
  (fn-do + fill-window _
    (param window VirtualWindow)
    (param domain VirtualSequenceDomain)
    (call (. inner fill-window) window domain)
    (let line (. window sticky-line))
    (return-if (if (== line null)))
    (call collect-stuck window domain line)
    (for (in index (..< 0 (. stuck length)))
      (call stick window domain index ([] stuck index) ([] stuck-rects index) ([] stuck-pins index))
    )
  )
  (fn-expr + rect-for-address _
    (param address I64)
    (param domain VirtualSequenceDomain)
    (param window VirtualWindow)
    (call (. inner rect-for-address) address domain window)
  )
  (fn-expr + measures-rows _ :get
    (. inner measures-rows)
  )
  (fn-do + record-row-height _
    (param placement VirtualPlacement)
    (param height VirtualCoord)
    (return (call (. inner record-row-height) placement height))
  )
  (fn-expr + has-sticky-rows _ :get
    true
  )
  (fn-do + sticky-margin _
    (param address I64)
    (param domain VirtualSequenceDomain)
    (param window VirtualWindow)
    (call (. headers clear))
    (call (. rows sticky-headers) address headers)
    (let margin 0vcoord)
    (for (in header headers)
      (if (!= header address)
        (let rect (call (. inner rect-for-address) header domain window))
        (if rect
          (+= margin (. rect height))
        )
      )
    )
    (return margin)
  )
  (fn-do _ collect-stuck _
    (param window VirtualWindow)
    (param domain VirtualSequenceDomain)
    (param line VirtualCoord)
    (call (. stuck clear))
    (call (. stuck-rects clear))
    (call (. stuck-pins clear))
    (let bottom line)
    (let reach line)
    (let carries true)
    (while true
      (let probe (call virtual-window-address-at window reach))
      (return-if (if (== probe null)))
      (call (. headers clear))
      (call (. rows sticky-headers) probe headers)
      (return-if (if (or (<= (. headers length) (. stuck length)) (not (call extends-stuck)))))
      (let header ([] headers (. stuck length)))
      (let rect (call (. inner rect-for-address) header domain window))
      (return-if (if (not rect)))
      (let limit (. window known-height))
      (let last (call (. inner rect-for-address) (call (. rows sticky-section-last) header) domain window))
      (if last
        (= limit (+ (. last y) (. last height)))
      )
      (let pushed (- limit (. rect height)))
      (let y (call larger-virtual (. rect y) (call smaller-virtual bottom pushed)))
      (= carries (and carries (< bottom pushed) (<= (. rect y) bottom)))
      (+= stuck header)
      (+= stuck-rects (call VirtualRect (. rect x) y (. rect width) (. rect height)))
      (+= stuck-pins carries)
      (= bottom (+ y (. rect height)))
      (+= reach (. rect height))
    )
  )
  (fn-do _ extends-stuck _
    (for (in index (..< 0 (. stuck length)))
      (return-if false (if (!= ([] headers index) ([] stuck index))))
    )
    (return true)
  )
  (fn-do _ stick _
    (param window VirtualWindow)
    (param domain VirtualSequenceDomain)
    (param depth Index)
    (param header I64)
    (param rect VirtualRect)
    (param is-pinned Bool)
    (let index (call (. domain index-of) header))
    (return-if (if (== index null)))
    (let position Index 0)
    (while (and (< position (. window placement-count)) (< (. ([] (. window placements) position) placement-id) index))
      (+= position 1)
    )
    (if (or (== position (. window placement-count)) (!= (. ([] (. window placements) position) placement-id) index))
      (call (. window insert-placement) position index header (. rect x) (. rect y) (. rect width) (. rect height))
    )
    (let placement ([] (. window placements) position))
    (= (. placement y) (. rect y))
    (= (. placement is-sticky) true)
    (= (. placement is-pinned) is-pinned)
    (= (. placement sticky-depth) depth)
  )
)

(fn-do _ virtual-window-address-at _
  (param window VirtualWindow)
  (param y VirtualCoord)
  (for (in index (..< 0 (. window placement-count)))
    (let placement ([] (. window placements) index))
    (return-if (. placement address) (if (and (<= (. placement y) y) (< y (+ (. placement y) (. placement height))))))
  )
  (return null)
)

(type + VerticalFixedLayout
  (implements VirtualLayout)
  (prop + row-height VirtualCoord)
  (prop + row-width (? VirtualCoord))
  (prop + gap (? VirtualCoord))
  (prop + tail VirtualCoord)
  (fn-do + This _
    (param row-height _)
    (param row-width (? VirtualCoord) (= null))
    (param gap (? VirtualCoord) (= null))
    (param tail VirtualCoord (= 0vcoord))
    (throw (call Panic "Virtual padding must not be negative") (if (< tail 0vcoord)))
    (call check-fixed-lengths row-height row-width)
  )
  (fn-do + fill-window _
    (param window VirtualWindow)
    (param domain VirtualSequenceDomain)
    (call fill-fixed-window window domain true row-height row-width gap tail)
  )
  (fn-expr + rect-for-address (? VirtualRect)
    (param address I64)
    (param domain VirtualSequenceDomain)
    (param window VirtualWindow)
    (call fixed-rect-for-address address domain (. window frame) true row-height row-width gap)
  )
)

(type + VirtualRowOffsets (is Interface)
  (fn-expr + total-height VirtualCoord :get)
  (fn-expr + offset-at VirtualCoord
    (param index VirtualCoord)
  )
  (fn-expr + index-at VirtualCoord
    (param offset VirtualCoord)
  )
)

(type + VerticalOffsetLayout
  (implements VirtualLayout)
  (prop + offsets VirtualRowOffsets)
  (prop + row-width (? VirtualCoord))
  (fn-do + This _
    (param offsets _)
    (param row-width (? VirtualCoord) (= null))
  )
  (fn-do + fill-window _
    (param window VirtualWindow)
    (param domain VirtualSequenceDomain)
    (call (. window clear-placements))
    (let count (call larger-virtual 0vcoord (. domain known-count)))
    (let total (call larger-virtual 0vcoord (. offsets total-height)))
    (let viewport-height (call larger-virtual 0vcoord (. window viewport-height)))
    (let viewport-width (call larger-virtual 0vcoord (. window viewport-width)))
    (let max-y (call larger-virtual 0vcoord (- total viewport-height)))
    (let resolved-y (call smaller-virtual max-y (call larger-virtual 0vcoord (. window scroll-y))))
    (let width (call offset-row-width window))
    (let max-x (call larger-virtual 0vcoord (- width viewport-width)))
    (let resolved-x (call smaller-virtual max-x (call larger-virtual 0vcoord (. window scroll-x))))
    (let window-start (call larger-virtual 0vcoord (- resolved-y (call larger-virtual 0vcoord (. window overscan-top)))))
    (let window-end (+ resolved-y viewport-height (call larger-virtual 0vcoord (. window overscan-bottom))))
    (let index (call (. offsets index-at) window-start))
    (while (< index count)
      (let top (call (. offsets offset-at) index))
      (if (>= top window-end)
        (break)
      )
      (call (. window place)
        (block
          (arg index)
          (arg (call (. domain address-at) index))
          (arg 0vcoord)
          (arg top)
          (arg width)
          (arg (- (call (. offsets offset-at) (+ index 1vcoord)) top))
        )
      )
      (+= index 1vcoord)
    )
    (= (. window resolved-scroll-x) resolved-x)
    (= (. window resolved-scroll-y) resolved-y)
    (= (. window known-width) width)
    (= (. window estimated-width) width)
    (= (. window is-width-final) true)
    (= (. window known-height) total)
    (= (. window estimated-height) total)
    (= (. window is-height-final) (. domain is-final))
  )
  (fn-do + rect-for-address _
    (param address I64)
    (param domain VirtualSequenceDomain)
    (param window VirtualWindow)
    (let index (call (. domain index-of) address))
    (return-if (if (== index null)))
    (let top (call (. offsets offset-at) index))
    (return (call VirtualRect 0vcoord top (call offset-row-width window) (- (call (. offsets offset-at) (+ index 1vcoord)) top)))
  )
  (fn-expr _ offset-row-width _
    (param window VirtualWindow)
    (if-expr (!= row-width null) (call larger-virtual row-width frame) frame)
    (where
      (lazy frame (call larger-virtual 0vcoord (. window frame-width)))
    )
  )
)

(type + VerticalRowLayout
  (implements VirtualLayout)
  (prop + gap (? VirtualCoord))
  (fn-do + This _
    (param gap (? VirtualCoord) (= null))
  )
  (fn-do + fill-window _
    (param window VirtualWindow)
    (param domain VirtualSequenceDomain)
    (call fill-fixed-window window domain true (call hosted-row-height window) null gap)
  )
  (fn-expr + rect-for-address (? VirtualRect)
    (param address I64)
    (param domain VirtualSequenceDomain)
    (param window VirtualWindow)
    (call fixed-rect-for-address address domain (. window frame) true (call hosted-row-height window) null gap)
  )
)

(type + HorizontalFixedLayout
  (implements VirtualLayout)
  (prop + column-width VirtualCoord)
  (prop + column-height (? VirtualCoord))
  (fn-do + This _
    (param column-width _)
    (param column-height (? VirtualCoord) (= null))
    (call check-fixed-lengths column-width column-height)
  )
  (fn-do + fill-window _
    (param window VirtualWindow)
    (param domain VirtualSequenceDomain)
    (call fill-fixed-window window domain false column-width column-height)
  )
  (fn-expr + rect-for-address (? VirtualRect)
    (param address I64)
    (param domain VirtualSequenceDomain)
    (param window VirtualWindow)
    (call fixed-rect-for-address address domain (. window frame) false column-width column-height)
  )
)

(type + VerticalGridLayout
  (implements VirtualLayout)
  (prop + cell-length VirtualCoord)
  (prop + spacing VirtualCoord)
  (fn-do + This _
    (param cell-length _)
    (param spacing _ (= 0vcoord))
    (call check-fixed-lengths cell-length spacing)
  )
  (fn-do + fill-window _
    (param window VirtualWindow)
    (param domain VirtualSequenceDomain)
    (call (. window clear-placements))
    (blank)
    (let known-count (call larger-virtual 0vcoord (. domain known-count)))
    (let available-count known-count)
    (if (not (. domain is-final))
      (throw (call Panic "Virtual sequence size overflow") (if (== known-count (. VirtualCoord max))))
      (+= available-count 1vcoord)
    )
    (blank)
    (let width (call larger-virtual 0vcoord (. window frame-width)))
    (let columns (call column-count width))
    (let cell (call cell-extent width))
    (let pitch (+ cell spacing))
    (let inset (call leading-inset width))
    (let viewport-height (call larger-virtual 0vcoord (. window viewport-height)))
    (let leading (call larger-virtual 0vcoord (. window overscan-top)))
    (let trailing (call larger-virtual 0vcoord (. window overscan-bottom)))
    (blank)
    (let available-length (call grid-length available-count columns pitch spacing))
    (let max-main (call larger-virtual 0vcoord (- available-length viewport-height)))
    (let resolved-main (call smaller-virtual max-main (call larger-virtual 0vcoord (. window scroll-y))))
    (let window-start (call larger-virtual 0vcoord (- resolved-main leading)))
    (let window-end (call checked-virtual-sum (call checked-virtual-sum resolved-main viewport-height) trailing))
    (let rows (call grid-rows available-count columns))
    (let row (/ window-start pitch))
    (let last-row (/ window-end pitch))
    (if (!= (% window-end pitch) 0vcoord)
      (+= last-row 1vcoord)
    )
    (= last-row (call smaller-virtual last-row rows))
    (blank)
    (while (< row last-row)
      (let index (call checked-virtual-product row columns))
      (let end (call smaller-virtual available-count (+ index columns)))
      (let y (call checked-virtual-product row pitch))
      (while (< index end)
        (let x (+ inset (* (- index (* row columns)) pitch)))
        (call (. window place) index (call (. domain address-at) index) x y cell cell)
        (+= index 1vcoord)
      )
      (+= row 1vcoord)
    )
    (blank)
    (let estimated-length (? VirtualCoord))
    (if (. domain estimated-count)
      (let estimated-count (call larger-virtual 0vcoord (!! (. domain estimated-count))))
      (= estimated-length (call grid-length estimated-count columns pitch spacing))
    )
    (blank)
    (= (. window resolved-scroll-x) 0vcoord)
    (= (. window resolved-scroll-y) resolved-main)
    (= (. window known-width) width)
    (= (. window estimated-width) width)
    (= (. window is-width-final) true)
    (= (. window known-height) (call grid-length known-count columns pitch spacing))
    (= (. window estimated-height) estimated-length)
    (= (. window is-height-final) (. domain is-final))
  )
  (fn-do + rect-for-address (? VirtualRect)
    (param address I64)
    (param domain VirtualSequenceDomain)
    (param window VirtualWindow)
    (let index (call (. domain index-of) address))
    (return-if (if (not index)))
    (let width (call larger-virtual 0vcoord (. window frame-width)))
    (let columns (call column-count width))
    (let cell (call cell-extent width))
    (let pitch (+ cell spacing))
    (return
      (call VirtualRect
        (block
          (arg (+ (call leading-inset width) (* (% index columns) pitch)))
          (arg (* (/ index columns) pitch))
          (arg cell)
          (arg cell)
        )
      )
    )
  )
  (fn-expr + column-count VirtualCoord
    (param width VirtualCoord)
    (call larger-virtual 1vcoord (/ (+ width spacing) (+ cell-length spacing)))
  )
  (fn-expr + cell-extent VirtualCoord
    (param width VirtualCoord)
    (call larger-virtual 1vcoord (call smaller-virtual cell-length width))
  )
  (fn-expr + leading-inset VirtualCoord
    (param width VirtualCoord)
    (call larger-virtual
      (block
        (arg 0vcoord)
        (arg (/ (+ (- width (* (call column-count width) (+ (call cell-extent width) spacing))) spacing) 2vcoord))
      )
    )
  )
)

(fn-expr _ grid-rows VirtualCoord
  (param count VirtualCoord)
  (param columns VirtualCoord)
  (/ (- (+ count columns) 1vcoord) columns)
)

(fn-expr _ grid-length VirtualCoord
  (param count VirtualCoord)
  (param columns VirtualCoord)
  (param pitch VirtualCoord)
  (param spacing VirtualCoord)
  (call larger-virtual 0vcoord (- (call checked-virtual-product (call grid-rows count columns) pitch) spacing))
)

(type + VirtualHeightEstimate (is (fn-type VirtualCoord (param address I64) (param width VirtualCoord))))

(type + VerticalMeasuredLayout
  (implements VirtualLayout)
  (prop + estimated-height VirtualCoord)
  (prop + estimate (? VirtualHeightEstimate))
  (prop + leading VirtualCoord)
  (prop + trailing VirtualCoord)
  (prop + revision _ (:= (call VirtualRevision)))
  (blank)
  (depends parameters-changed estimated-height estimate leading trailing)
  (blank)
  (prop _ heights (list VirtualCoord))
  (prop _ measured-at (list VirtualCoord))
  (prop _ sums (list VirtualCoord))
  (prop _ leaf-count Index)
  (prop _ row-width VirtualCoord)
  (fn-do + This _
    (param estimated-height _)
    (param estimate (? VirtualHeightEstimate) (= null))
    (param leading VirtualCoord (= 0vcoord))
    (param trailing VirtualCoord (= 0vcoord))
    (throw (call Panic "Virtual estimated height must be positive") (if (<= estimated-height 0vcoord)))
    (throw (call Panic "Virtual padding must not be negative") (if (or (< leading 0vcoord) (< trailing 0vcoord))))
    (call rebuild-sums)
  )
  (fn-expr + row-count _ :get
    (. heights length)
  )
  (fn-expr + is-row-measured _
    (param index Index)
    (and (< index (. measured-at length)) (== ([] measured-at index) row-width))
  )
  (fn-do + reset _
    (call (. heights clear))
    (call (. measured-at clear))
    (call rebuild-sums)
    (call (. revision touch))
  )
  (fn-do + splice _
    (param domain VirtualSequenceDomain)
    (param index Index)
    (param removed Size)
    (param added Size)
    (return-if (if (> index (. heights length))))
    (let available (- (. heights length) index))
    (let count (if-expr (< removed available) removed available))
    (if (> count 0)
      (call (. heights remove) index count)
      (call (. measured-at remove) index count)
    )
    (let estimates (list VirtualCoord))
    (let unmeasured (list VirtualCoord))
    (let offset Index)
    (while (< offset added)
      (+= estimates (call estimated-row-height (call (. domain address-at) (+ index offset)) row-width))
      (+= unmeasured -1vcoord)
      (+= offset 1)
    )
    (if (> added 0)
      (call (. heights insert) estimates index)
      (call (. measured-at insert) unmeasured index)
    )
    (call rebuild-sums)
    (call (. revision touch))
  )
  (fn-do _ parameters-changed _
    (call (. revision touch))
  )
  (fn-do _ rebuild-sums _
    (let capacity Index 1)
    (while (< capacity (. heights length))
      (*= capacity 2)
    )
    (= leaf-count capacity)
    (call (. sums clear))
    (call (. sums reserve) (* capacity 2))
    (let index Index)
    (while (< index (* capacity 2))
      (+= sums 0vcoord)
      (+= index 1)
    )
    (= index 0)
    (while (< index (. heights length))
      (= ([] sums (+ capacity index)) ([] heights index))
      (+= index 1)
    )
    (let node (- capacity 1))
    (while (> node 0)
      (= ([] sums node) (call checked-virtual-sum ([] sums (* node 2)) ([] sums (+ (* node 2) 1))))
      (-= node 1)
    )
  )
  (fn-do _ set-sum _
    (param index Index)
    (param height VirtualCoord)
    (if (>= index leaf-count)
      (call rebuild-sums)
      (return)
    )
    (let node (+ leaf-count index))
    (= ([] sums node) height)
    (/= node 2)
    (while (> node 0)
      (= ([] sums node) (call checked-virtual-sum ([] sums (* node 2)) ([] sums (+ (* node 2) 1))))
      (/= node 2)
    )
  )
  (fn-expr _ total-height VirtualCoord :get
    ([] sums 1)
  )
  (fn-do _ offset-at VirtualCoord
    (param index Index)
    (let total 0vcoord)
    (let low leaf-count)
    (let high (+ leaf-count index))
    (while (< low high)
      (if (== (% low 2) 1)
        (+= total ([] sums low))
        (+= low 1)
      )
      (if (== (% high 2) 1)
        (-= high 1)
        (+= total ([] sums high))
      )
      (/= low 2)
      (/= high 2)
    )
    (return total)
  )
  (fn-do _ index-at Index
    (param position VirtualCoord)
    (return-if 0 (if (< position 0vcoord)))
    (return-if (. heights length) (if (>= position total-height)))
    (let node Index 1)
    (let remaining position)
    (while (< node leaf-count)
      (let left (* node 2))
      (if (> ([] sums left) remaining)
        (= node left)
        (else
          (-= remaining ([] sums left))
          (= node (+ left 1))
        )
      )
    )
    (let found (- node leaf-count))
    (return (if-expr (< found (. heights length)) found (. heights length)))
  )
  (fn-expr _ estimated-row-height VirtualCoord
    (param address I64)
    (param width VirtualCoord)
    (if-expr custom (call larger-virtual 1vcoord (call custom address width)) estimated-height)
    (where
      (lazy custom estimate)
    )
  )
  (fn-do _ sync _
    (param domain VirtualSequenceDomain)
    (param width VirtualCoord)
    (let count Size (call larger-virtual 0vcoord (. domain known-count)))
    (while (> (. heights length) count)
      (call (. heights pop))
      (call (. measured-at pop))
      (call set-sum (. heights length) 0vcoord)
    )
    (if (!= width row-width)
      (= row-width width)
      (let index Index)
      (while (< index (. heights length))
        (if (< ([] measured-at index) 0vcoord)
          (let next (call estimated-row-height (call (. domain address-at) index) width))
          (if (!= next ([] heights index))
            (= ([] heights index) next)
            (call set-sum index next)
          )
        )
        (+= index 1)
      )
    )
    (while (< (. heights length) count)
      (let next (call estimated-row-height (call (. domain address-at) (. heights length)) width))
      (+= heights next)
      (+= measured-at -1vcoord)
      (call set-sum (- (. heights length) 1) next)
    )
  )
  (fn-expr + measures-rows Bool :get
    true
  )
  (fn-do + record-row-height Bool
    (param placement VirtualPlacement)
    (param height VirtualCoord)
    (return-if false (if (< (. placement placement-id) 0vcoord)))
    (let index Index (. placement placement-id))
    (return-if false (if (>= index (. heights length))))
    (let next (call larger-virtual 0vcoord height))
    (let changed (!= ([] heights index) next))
    (= ([] measured-at index) row-width)
    (if changed
      (= ([] heights index) next)
      (call set-sum index next)
    )
    (return changed)
  )
  (fn-do + fill-window _
    (param window VirtualWindow)
    (param domain VirtualSequenceDomain)
    (call (. window clear-placements))
    (let width (call larger-virtual 0vcoord (. window frame-width)))
    (let viewport (call larger-virtual 0vcoord (. window viewport-height)))
    (call sync domain width)
    (blank)
    (let count (. heights length))
    (let padded (call checked-virtual-sum leading total-height))
    (let total (call checked-virtual-sum padded trailing))
    (let max-scroll (call larger-virtual 0vcoord (- total viewport)))
    (let resolved (call smaller-virtual max-scroll (call larger-virtual 0vcoord (. window scroll-y))))
    (let lead (call larger-virtual 0vcoord (. window overscan-top)))
    (let trail (call larger-virtual 0vcoord (. window overscan-bottom)))
    (let window-start (call larger-virtual 0vcoord (- resolved lead)))
    (let window-end (call checked-virtual-sum (call checked-virtual-sum resolved viewport) trail))
    (blank)
    (let index (call index-at (- window-start leading)))
    (let top (+ leading (call offset-at index)))
    (while (and (< index count) (< top window-end))
      (call (. window place) index (call (. domain address-at) index) 0vcoord top width ([] heights index))
      (+= top ([] heights index))
      (+= index 1)
    )
    (blank)
    (= (. window resolved-scroll-x) 0vcoord)
    (= (. window resolved-scroll-y) resolved)
    (= (. window known-width) width)
    (= (. window estimated-width) width)
    (= (. window is-width-final) true)
    (= (. window known-height) total)
    (= (. window estimated-height) total)
    (= (. window is-height-final) (. domain is-final))
  )
  (fn-do + rect-for-address (? VirtualRect)
    (param address I64)
    (param domain VirtualSequenceDomain)
    (param window VirtualWindow)
    (let width (call larger-virtual 0vcoord (. window frame-width)))
    (call sync domain width)
    (let found (call (. domain index-of) address))
    (return-if (if (== found null)))
    (let index Index found)
    (return-if (if (>= index (. heights length))))
    (return (call VirtualRect 0vcoord (+ leading (call offset-at index)) width ([] heights index)))
  )
)

(fn-expr _ hosted-row-height _
  (param window VirtualWindow)
  (call larger-virtual 1vcoord (. window row-height))
)

(fn-do _ check-fixed-lengths _
  (param item-length VirtualCoord)
  (param cross-length (? VirtualCoord))
  (throw (call Panic "Virtual item length must be positive") (if (<= item-length 0vcoord)))
  (throw (call Panic "Virtual cross length must not be negative") (if (and cross-length (< cross-length 0vcoord))))
)

(fn-do _ fill-fixed-window _
  (param window VirtualWindow)
  (param domain VirtualSequenceDomain)
  (param is-vertical Bool)
  (param item-length VirtualCoord)
  (param fixed-cross-length (? VirtualCoord))
  (param gap (? VirtualCoord) (= null))
  (param tail VirtualCoord (= 0vcoord))
  (call (. window clear-placements))
  (blank)
  (let known-count (call larger-virtual 0vcoord (. domain known-count)))
  (let available-count known-count)
  (if (not (. domain is-final))
    (throw (call Panic "Virtual sequence size overflow") (if (== known-count (. VirtualCoord max))))
    (+= available-count 1vcoord)
  )
  (blank)
  (let scroll-main (if-expr is-vertical (. window scroll-y) (. window scroll-x)))
  (let scroll-cross (if-expr is-vertical (. window scroll-x) (. window scroll-y)))
  (let raw-viewport-main (if-expr is-vertical (. window viewport-height) (. window viewport-width)))
  (let raw-viewport-cross (if-expr is-vertical (. window viewport-width) (. window viewport-height)))
  (let raw-frame-cross (if-expr is-vertical (. window frame-width) (. window frame-height)))
  (let raw-leading (if-expr is-vertical (. window overscan-top) (. window overscan-left)))
  (let raw-trailing (if-expr is-vertical (. window overscan-bottom) (. window overscan-right)))
  (let viewport-main (call larger-virtual 0vcoord raw-viewport-main))
  (let viewport-cross (call larger-virtual 0vcoord raw-viewport-cross))
  (let leading (call larger-virtual 0vcoord raw-leading))
  (let trailing (call larger-virtual 0vcoord raw-trailing))
  (blank)
  (let spare (if-expr (!= gap null) 1vcoord 0vcoord))
  (let known-length
    (call checked-virtual-sum
      (block
        (arg (call checked-virtual-product (call checked-virtual-sum known-count spare) item-length))
        (arg tail)
      )
    )
  )
  (let available-slots (call checked-virtual-sum available-count spare))
  (let available-length
    (call checked-virtual-sum
      (block
        (arg (call checked-virtual-product available-slots item-length))
        (arg tail)
      )
    )
  )
  (let max-main (call larger-virtual 0vcoord (- available-length viewport-main)))
  (let resolved-main (call smaller-virtual max-main (call larger-virtual 0vcoord scroll-main)))
  (blank)
  (let frame-cross (call larger-virtual 0vcoord raw-frame-cross))
  (let cross-length (call larger-virtual (?? fixed-cross-length frame-cross) frame-cross))
  (let max-cross (call larger-virtual 0vcoord (- cross-length viewport-cross)))
  (let resolved-cross (call smaller-virtual max-cross (call larger-virtual 0vcoord scroll-cross)))
  (blank)
  (let window-start (call larger-virtual 0vcoord (- resolved-main leading)))
  (let window-end (call checked-virtual-sum (call checked-virtual-sum resolved-main viewport-main) trailing))
  (let first-index (/ window-start item-length))
  (let last-index (/ window-end item-length))
  (if (!= (% window-end item-length) 0vcoord)
    (+= last-index 1vcoord)
  )
  (= last-index (call smaller-virtual last-index available-slots))
  (blank)
  (let slot first-index)
  (while (< slot last-index)
    (if (or (== gap null) (!= slot gap))
      (let index (if-expr (and (!= gap null) (> slot gap)) (- slot 1vcoord) slot))
      (let main (call checked-virtual-product slot item-length))
      (let address (call (. domain address-at) index))
      (if is-vertical
        (call (. window place) index address 0vcoord main cross-length item-length)
        (else
          (call (. window place) index address main 0vcoord item-length cross-length)
        )
      )
    )
    (+= slot 1vcoord)
  )
  (blank)
  (let estimated-length (? VirtualCoord))
  (if (. domain estimated-count)
    (let estimated-count (call larger-virtual 0vcoord (!! (. domain estimated-count))))
    (let estimated-slots (call checked-virtual-sum estimated-count spare))
    (= estimated-length
      (call checked-virtual-sum
        (block
          (arg (call checked-virtual-product estimated-slots item-length))
          (arg tail)
        )
      )
    )
  )
  (blank)
  (if is-vertical
    (= (. window resolved-scroll-x) resolved-cross)
    (= (. window resolved-scroll-y) resolved-main)
    (= (. window known-width) cross-length)
    (= (. window estimated-width) cross-length)
    (= (. window is-width-final) true)
    (= (. window known-height) known-length)
    (= (. window estimated-height) estimated-length)
    (= (. window is-height-final) (. domain is-final))
    (else
      (= (. window resolved-scroll-x) resolved-main)
      (= (. window resolved-scroll-y) resolved-cross)
      (= (. window known-width) known-length)
      (= (. window estimated-width) estimated-length)
      (= (. window is-width-final) (. domain is-final))
      (= (. window known-height) cross-length)
      (= (. window estimated-height) cross-length)
      (= (. window is-height-final) true)
    )
  )
)

(fn-do _ fixed-rect-for-address (? VirtualRect)
  (param address I64)
  (param domain VirtualSequenceDomain)
  (param frame VirtualSize)
  (param is-vertical Bool)
  (param item-length VirtualCoord)
  (param fixed-cross-length (? VirtualCoord))
  (param gap (? VirtualCoord) (= null))
  (let index (call (. domain index-of) address))
  (return-if (if (not index)))
  (let slot (if-expr (and (!= gap null) (>= index gap)) (+ index 1vcoord) index))
  (let main (call checked-virtual-product slot item-length))
  (let raw-frame-cross (if-expr is-vertical (. frame width) (. frame height)))
  (let frame-cross (call larger-virtual 0vcoord raw-frame-cross))
  (let cross-length (call larger-virtual (?? fixed-cross-length frame-cross) frame-cross))
  (return-if (call VirtualRect 0vcoord main cross-length item-length) (if is-vertical))
  (return (call VirtualRect main 0vcoord item-length cross-length))
)

(fn-expr _ checked-virtual-product VirtualCoord
  (param left VirtualCoord)
  (param right VirtualCoord)
  (before
    (throw (call Panic "Virtual extent overflow") (if (or (< left 0vcoord) (< right 0vcoord) (and (!= right 0vcoord) (> left (/ (. VirtualCoord max) right))))))
  )
  (* left right)
)

(fn-expr _ checked-virtual-sum VirtualCoord
  (param left VirtualCoord)
  (param right VirtualCoord)
  (before
    (throw (call Panic "Virtual extent overflow") (if (or (< left 0vcoord) (< right 0vcoord) (> left (- (. VirtualCoord max) right)))))
  )
  (+ left right)
)

(fn-expr _ larger-virtual _
  (param left VirtualCoord)
  (param right VirtualCoord)
  (if-expr (> left right) left right)
)

(fn-expr _ smaller-virtual _
  (param left VirtualCoord)
  (param right VirtualCoord)
  (if-expr (< left right) left right)
)
