(import /math)

(type + SelectionMode (is U8)
  (variant none)
  (variant single)
  (variant multiple)
)

(fn-do + selection-after-press (list String)
  (param mode SelectionMode)
  (param keys (list String))
  (param key String)
  (param order (list String))
  (param anchor (? String))
  (param extends _ (= false))
  (param toggles _ (= false))
  (return-if (call (of List String)) (if (== mode (. SelectionMode none))))
  (return-if (list key) (if (== mode (. SelectionMode single))))
  (return-if (call selection-range anchor key order) (if (and extends anchor)))
  (return-if (list key) (if (not toggles)))
  (let kept
    (call (of List String)
      (block
        (spread keys)
        (pipe ?> (!= each key))
      )
    )
  )
  (if (== (. kept length) (. keys length))
    (+= kept key)
  )
  (return kept)
)

(fn-expr + selection-range (list String)
  (param anchor String)
  (param key String)
  (param order (list String))
  (if-expr (or (== start null) (== end null)) (list key) ([] order (.. (call min start end) (call max start end))))
  (where
    (lazy start (call (. order find) anchor))
    (lazy end (call (. order find) key))
  )
)
