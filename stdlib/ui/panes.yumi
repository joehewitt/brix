━━━━━━━━━━━━━━━━━━━━
+ PaneNode

+ kind PaneNodeKind
+ id String
+ views [String]
+ axis PaneAxis
+ kids [PaneNode]
+ sizes [Float]
+ is-collapsed Bool
+ is-dock Bool

────────────────────
+ This
    - kind
    - id
    - views [String] = List'String()
    - axis = PaneAxis.row
    - kids [PaneNode] = List'PaneNode()
    - sizes [Float] = List'Float()
    - is-collapsed = false
    - is-dock = false

────────────────────
+ get is-split

kind == PaneNodeKind.split

────────────────────
+ get json JSON

Map'String'JSON
    • kind kind as Int
    • id id
    • views views
    • axis axis as Int
    • kids List'JSON(each.json in kids)
    • sizes sizes
    • collapsed is-collapsed
    • dock is-dock

────────────────────
_ get is-stack

kind == PaneNodeKind.stack

────────────────────
+ do stacks <PaneNode>

if is-stack
    <= this
for kid in kids
    <<= kid.stacks()

────────────────────
+ size-at Float
    - index Index

if index < sizes.length then sizes[index] else 1

────────────────────
_ has-workspace Bool

kind == PaneNodeKind.workspace || (some(kids) • where each.has-workspace())

────────────────────
_ do find PaneFound?
    - target String
    - parent PaneNode? = null
    - index Index = 0

=? PaneFound(this, parent, index, null) if id == target
for position in 0 .. < kids.length
    . found = kids[position].find(target, this, position)
    =? found if found
= null

────────────────────
_ do find-dock PaneNode?

=? this if is-dock
for kid in kids
    . found = kid.find-dock()
    =? found if found
= null

────────────────────
_ do is-folding Bool
    - target String
    - stacked = false

=? stacked if id == target
. below = stacked || (is-split && axis == PaneAxis.column)
for kid in kids
    =? kid.is-folding(target, below) if kid.find(target)
= false

────────────────────
_ first-stack PaneNode?

first(stacks())

