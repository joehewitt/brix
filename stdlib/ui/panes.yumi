/data/json
/math
/stream/aggregate

+ pane-workspace-home = "workspace"
+ pane-bottom-home = "bottom"
+ pane-side-dock-size Float = 250
+ pane-bottom-share Float = 0.3

_ pane-json-version = 3

+ PaneVisit is (context String, view String)
_ PaneClosed is (view String, kind String, stack String, index Index?, origin PaneTarget?)

━━━━━━━━━━━━━━━━━━━━
