━━━━━━━━━━━━━━━━━━━━
+ PaneTarget is Union

| stack(scope PaneScope, stack String, zone PaneZone, index Index?)
| slot(side PaneSide, before String?)
| bottom
| float(x Float, y Float, width Float, height Float)

────────────────────
_ get json JSON

match this
    | .stack(scope, stack, zone, index)
        Map'String'JSON • scope scope as Int • stack stack • zone zone as Int
    | .slot(side, before)
        Map'String'JSON • slot side as Int • before before as JSON
    |= .bottom
        Map'String'JSON • bottom true
    | .float(x, y, width, height)
        null as JSON

━━━━━━━━━━━━━━━━━━━━
+ PaneModel

+ layouts [String = PaneLayout]
+ contexts [PaneContext]
+ current = ""
+ revision U64
+ focus-revision U64

_ roles [String = PaneViewScope]
_ sessions [String = PaneSession]
+ event focus-changed String
+ event menu-requested String

_ buttoned [String]
_ passive [String]
_ visits [PaneVisit]
_ next-id U64
_ heir String?
_ blank = PaneContext("", "", "")

────────────────────
+ get json JSON

Map'String'JSON
    • version pane-json-version
    • current current
    • "nextId" next-id as Int
    • layouts List'JSON(each.json in layouts.values)
    • contexts List'JSON(each.json in contexts)
    • sessions Map'String'JSON((each.id, session-of(each).json) in contexts)
    • visits List'JSON(pane-visit-json(each) in visits)

────────────────────
+ do register
    - view String
    - scope PaneViewScope
    - focusable = true

roles[view] = scope
if !focusable && !(passive has view)
    passive += view

────────────────────
+ is-focusable Bool
    - view String

!(passive has view)

────────────────────
+ do register-buttons
    - view String

if !(buttoned has view)
    buttoned += view

────────────────────
+ do add-layout
    - layout PaneLayout

layouts[layout.id] = layout

────────────────────
+ do add-context PaneContext
    - id String
    - name String
    - layout String

. made = PaneContext(id, name, layout)
contexts += made
sessions[id] = PaneSession()
if current == ""
    current = id
normalize-all()
= made

────────────────────
+ do remove-context
    - id String

=? if !context-named(id)
contexts = List'PaneContext(each in contexts when each.id != id)
-= sessions[id]
if current == id
    current = if contexts.length > 0 then contexts[0].id else ""
normalize-all()
revision += 1

────────────────────
+ context PaneContext

context-named(current) ?? first(contexts) ?? blank

────────────────────
+ layout PaneLayout

layout-of(context())

────────────────────
+ session PaneSession

session-of(context())

────────────────────
+ do make-id String
    - prefix String

next-id += 1
= "${prefix}-${next-id}"

────────────────────
+ instance-kind String?
    - view String

session().instances[view]

────────────────────
+ holds-instance Bool
    - context String
    - view String

owner != null && owner.instances has view

.. owner = sessions[context]

────────────────────
+ do visible-views [String]
    - stack PaneNode

. state = session()
= List'String(each in stack.views when is-role(each) || state.instances has each)

────────────────────
+ visible-in [String]
    - node PaneNode?

List'String(flat-map(visible-views(each) in (node?.stacks() ?? List'PaneNode())))

────────────────────
+ tab-views [String]
    - stack PaneNode

List'String(each in visible-views(stack) when !(layout().inlines has each))

────────────────────
+ active-view String?
    - stack PaneNode

if chosen && shown has chosen then chosen else first(shown)

.. shown = tab-views(stack)
.. chosen = session().active[stack.id]

────────────────────
+ stack-in PaneNode?
    - scope PaneScope
    - stack-id String

node if node && node.is-stack

.. node = node-in(scope, stack-id)

────────────────────
+ do top-stacks [String]

. found = List'String()
collect-top(layout().center.root, found)
= found

────────────────────
+ pages-in [PanePage]
    - side PaneSide

layout().dock(side).pages

────────────────────
+ page-views [String]
    - page PanePage

visible-in(page.root)

────────────────────
+ opens Bool
    - page PanePage

!is-menu-page(page)

────────────────────
+ is-menu-page Bool
    - page PanePage

lead != null && is-menu(lead)

.. lead = first(page-views(page))

────────────────────
+ in-menu Bool
    - view String

page != null && is-menu-page(page)

.. page = locate(view)?.page

────────────────────
+ do current-page PanePage?
    - side PaneSide

. region = layout().dock(side)
. chosen = session().pages[region.id]
. pages = List'PanePage(each in pages-in(side) when opens(each))
= first(each in pages when each.id == (chosen ?? "")) ?? first(pages)

────────────────────
+ page-after String?
    - side PaneSide
    - page-id String

pane-page-after(pages-in(side), page-id)

────────────────────
+ do show-page
    - side PaneSide
    - page-id String

. region = layout().dock(side)
session().pages[region.id] = page-id
region.is-collapsed = false
revision += 1

────────────────────
+ is-menu Bool
    - view String

layout().menus has view

────────────────────
+ shows-buttons Bool
    - view String

layout().inlines has view && locate(view) != null

────────────────────
+ can-inline Bool
    - view String

buttoned has view && !(layout().inlines has view)

────────────────────
+ do set-inline
    - view String
    - on Bool

. owned = layout()
=? if (owned.inlines has view) == on
=? if on && !can-inline(view)
commit • edit => do
    if on
        owned.inlines += view
    else
        owned.inlines -= view
if !on
    reveal-in(view)
revision += 1

────────────────────
+ is-visible Bool
    - view String

|? !place
    false
|? !stack || stack.is-collapsed || active-view(stack) != view
    false
|? region.kind != PaneRegionKind.dock
    true
|? region.is-collapsed || !page
    false
??
    current-page(region.side)?.id == page.id

.. place = locate(view)
.. stack = stack-in(place.scope, place.stack)
.. region = place.region
.. page = place.page

────────────────────
+ is-shown Bool
    - view String

|? !place
    false
|? !stack || stack.is-collapsed
    false
??
    active-view(stack) == view || shows-buttons(view)

.. place = locate(view)
.. stack = stack-in(place.scope, place.stack)

────────────────────
+ do press-strip
    - view String

. place = locate(view)
=? if !place || place.region.kind != PaneRegionKind.dock
. page = place.page
=? if !page
. region = place.region
if !region.is-collapsed && current-page(region.side)?.id == page.id && is-shown(view)
    region.is-collapsed = true
    revision += 1
    =
reveal(view)

────────────────────
+ do press-page
    - side PaneSide
    - page-id String

. region = layout().dock(side)
if !region.is-collapsed && current-page(side)?.id == page-id
    region.is-collapsed = true
    revision += 1
    =
show-page(side, page-id)

────────────────────
+ page-drag PaneDrag?
    - view String

|? !place
    null
|? page && page-views(page).length > 1
    pane-node-drag(page.root.id, PaneScope.layout)
??
    pane-view-drag(view, place.scope, place.stack)

.. place = locate(view)
.. page = place.page

────────────────────
+ do set-menu
    - view String
    - on Bool

. owned = layout()
. page = locate(view)?.page
. views = if page then page-views(page) ++ pane-views(page.root.stacks()) else List'String(view)
for each in views
    owned.menus -= each
    if on
        owned.menus += each
revision += 1

────────────────────
+ do move-to-dock
    - view String
    - side PaneSide

. drag = page-drag(view)
=? if !drag
drop(drag, pane-slot-target(side))

────────────────────
+ do move-to-bottom
    - view String

. drag = page-drag(view)
=? if !drag
drop(drag, PaneTarget.bottom)

────────────────────
+ bottom-node PaneNode?

layout().center.root?.find-dock()

────────────────────
+ has-bottom Bool

bottom-node() != null

────────────────────
+ in-bottom Bool
    - view String

place != null && place.scope == PaneScope.layout && bottom-node()?.find(place.stack) != null

.. place = locate(view)

────────────────────
+ is-bottom-open Bool

node != null && !is-folded-node(node)

.. node = bottom-node()

────────────────────
+ do toggle-bottom

. node = bottom-node()
=? if !node
. folds = !is-folded-node(node)
for stack in node.stacks()
    stack.is-collapsed = folds
revision += 1

────────────────────
+ is-folded-node Bool
    - node PaneNode

|? node.is-stack
    node.is-collapsed || (tab-views(node).length == 0 && visible-views(node).length > 0)
|? !node.is-split
    false
??
    node.kids.length > 0 && (all(node.kids) • where is-folded-node(each))

────────────────────
+ strip-mode PaneStripMode
    - side PaneSide

layout().dock(side).strip

────────────────────
+ do set-strip-mode
    - side PaneSide
    - mode PaneStripMode

. region = layout().dock(side)
=? if region.strip == mode
region.strip = mode
revision += 1

────────────────────
+ role-views [String]

List'String(roles.keys)

────────────────────
+ do show-pane
    - view String
    - side PaneSide

=? if !is-role(view) || locate(view)
commit • edit => do
    restore-role(view, side)

────────────────────
+ do locate PaneLocation?
    - view String

. owned = layout()
for stack in owned.workspace.stacks()
    =? PaneLocation(PaneScope.workspace, stack.id, owned.workspace, null) if stack.views has view
for region in owned.regions()
    for stack in region.stacks()
        =? PaneLocation(PaneScope.layout, stack.id, region, page) if stack.views has view
        .. page = region.find(stack.id)?.page
= null

────────────────────
+ do select
    - scope PaneScope
    - stack-id String
    - view String

session().active[stack-id] = view
. stack = stack-in(scope, stack-id)
if stack
    unfold(stack)
revision += 1

────────────────────
+ do note-focus
    - view String

=? if !is-focusable(view)
. place = locate(view)
=? if !place
. state = session()
take-focus(place.stack)
if place.scope == PaneScope.workspace
    state.workspace-focus = place.stack
. kind = instance-kind(view)
if kind
    state.last-focus[kind] = view
. visit = PaneVisit(if roles[view] == PaneViewScope.app then "" else current, view)
visits = List'PaneVisit(each in visits when holds-visit(each) && !same-visit(each, visit))
visits += visit
focus-changed <- view

────────────────────
+ do recent-visits [PaneVisit]

. ordered = List'PaneVisit(each in visits.reversed() when holds-visit(each))
. owners = List'PaneContext(each in contexts when each.id == current) ++ other-owners
    .. other-owners = List'PaneContext(each in contexts when each.id != current)
for owner in owners
    for view in session-of(owner).instances.keys
        . visit = PaneVisit(owner.id, view)
        if !(some(ordered) • where same-visit(each, visit))
            ordered += visit
= ordered

────────────────────
+ holds-visit Bool
    - visit PaneVisit

|? visit.context == ""
    is-role(visit.view)
??
    owner != null && (is-role(visit.view) || owner.instances has visit.view)

.. owner = sessions[visit.context]

────────────────────
+ focused-view String?

view-at(focused())

────────────────────
+ focused-stack String?

focused()?.stack

────────────────────
+ main-view String?

view-at(main-focused())

────────────────────
+ can-collapse Bool
    - scope PaneScope
    - stack-id String

|? !region || !found || !found.node.is-stack
    false
??
    (found.page?.root ?? region.root)?.is-folding(stack-id) ?? false

.. region = region-in(scope, stack-id)
.. found = region.find(stack-id)

────────────────────
+ do set-collapsed
    - scope PaneScope
    - stack-id String
    - collapsed Bool

. stack = stack-in(scope, stack-id)
=? if !stack || stack.is-collapsed == collapsed
=? if collapsed && !can-collapse(scope, stack-id)
if collapsed
    stack.is-collapsed = true
else
    unfold(stack)
revision += 1

────────────────────
+ do step-tab
    - delta Int

. place = focused()
=? if !place
. stack = stack-in(place.scope, place.stack)
=? if !stack
. shown = tab-views(stack)
=? if shown.length < 2
. count = shown.length as Int
. index = (shown.find(active-view(stack) ?? "") ?? 0) as Int
select(place.scope, stack.id, shown[((index + delta) % count + count) % count])

────────────────────
+ do reopen String?

. state = session()
=? null if state.closed.length == 0
. last = state.closed.pop()
if !(state.instances has last.view)
    commit • edit => do
        state.instances[last.view] = last.kind
        place-instance(last.view, false)
    place-closed(last)
reveal(last.view)
= last.view

────────────────────
+ do restore Bool
    - view String

. state = session()
. position = last(each in 0 .. < state.closed.length when state.closed[each].view == view)
=? false if position == null
. record = state.closed[position]
state.closed.remove(position)
place-closed(record)
reveal(view)
= true

────────────────────
+ do toggle-dock
    - side PaneSide

. region = layout().dock(side)
region.is-collapsed = !region.is-collapsed
revision += 1

────────────────────
+ do set-dock-size
    - side PaneSide
    - size Float

layout().dock(side).size = size
revision += 1

────────────────────
+ do set-split-sizes
    - split-id String
    - sizes [Float]

. split = node-in(PaneScope.workspace, split-id) ?? node-in(PaneScope.layout, split-id)
=? if !split
split.sizes = sizes
revision += 1

────────────────────
+ do move-float
    - float-id String
    - x Float
    - y Float
    - width Float
    - height Float

. region = layout().find-float(float-id)
=? if !region
region.x = x
region.y = y
region.width = width
region.height = height
raise-float(float-id)
revision += 1

────────────────────
+ do raise-float
    - float-id String

. owned = layout()
. region = owned.find-float(float-id)
=? if !region
owned.floats -= region
owned.floats += region

────────────────────
+ do open
    - view String
    - kind String
    - beside String? = null
    - reveals = true

. state = session()
if state.instances has view
    if reveals
        reveal(view)
    =
. anchor = locate(beside ?? "")
commit • edit => do
    state.instances[view] = kind
    if anchor && !locate(view)
        add-to-stack(anchor.scope, anchor.stack, view, beside)
    place-instance(view, false)
    if reveals
        reveal-in(view)

────────────────────
+ do open-at
    - view String
    - kind String
    - target PaneTarget

open(view, kind)
. place = locate(view)
if place
    drop(pane-view-drag(view, place.scope, place.stack), target)

────────────────────
+ do reveal
    - view String
    - expands = true

. place = locate(view)
if place && place.region.kind == PaneRegionKind.dock && in-menu(view)
    session().active[place.stack] = view
    revision += 1
    if expands
        menu-requested <- view
    =
. folded = place && (is-folded(place) || stack-collapsed)
    .. stack-collapsed = stack-in(place.scope, place.stack)?.is-collapsed ?? false
if place && !expands && folded
    session().active[place.stack] = view
    revision += 1
else if place
    reveal-in(view)
    revision += 1
else if is-role(view)
    commit • edit => do
        restore-role(view)
        reveal-in(view)

────────────────────
+ do reveal-panel
    - view String

if layout().inlines has view
    set-inline(view, false)
reveal(view)

────────────────────
+ do rename
    - old String
    - view String

. state = session()
. kind = state.instances[old]
=? if !kind || state.instances has view
. place = locate(old)
commit • edit => do
    -= state.instances[old]
    state.instances[view] = kind
    . stack = stack-in(place.scope, place.stack) if place && !locate(view)
    if stack
        . at = stack.views.find(old)
        stack.views.insert(view, if at != null then at + 1 else tail-of(stack))
    visits = List'PaneVisit(pane-renamed-visit(each, current, old, view) in visits)
    for key in List'String(each.key in state.active.items when each.value == old)
        state.active[key] = view
    for key in List'String(each.key in state.last-focus.items when each.value == old)
        state.last-focus[key] = view

────────────────────
+ do close
    - view String

. place = locate(view)
. stack = stack-in(place.scope, place.stack) if place
. index = tab-views(stack).find(view) if place && stack
. origin = origin-of(place.region, place.stack, place.scope) if place
commit • edit => do
    . state = session()
    visits = List'PaneVisit(each in visits when !same-visit(each, PaneVisit(current, view)))
    if !is-role(view)
        state.closed += PaneClosed
            - view
            - state.instances[view] ?? ""
            - place?.stack ?? ""
            - index
            - origin
        if state.closed.length > 50
            . ignored = state.closed.pop-first()
        forget-instance(state, view)
    else
        . owned = layout()
        if place
            owned.closed[view] = place.stack
        remove-view(owned, view)

────────────────────
+ do close-node
    - node-id String

. owned = layout()
. region = owned.region-of(node-id) ?? (owned.workspace if owned.workspace.find(node-id))
=? if !region || owned.workspace.root?.id == node-id
commit • edit => do
    . ignored = detach(region, node-id, pane-stack-node(make-id("stack"), List'String()))

────────────────────
+ do drop
    - drag PaneDrag
    - target PaneTarget

=? if !validate(drag, target)
. moved = payload-views(drag)
. showing = pin-pages()
. filled = target.side if target is .slot && pages-in(target.side).length == 0
commit • edit => do
    apply-drop(drag, target)
    for view in moved
        . kind = instance-kind(view)
        . place = locate(view)
        if kind && place
            . home = if place.scope == PaneScope.workspace then pane-workspace-home else place.stack
            layout().placed[kind] = home
        if target is .stack
            layout().menus -= view
settle-pages(showing, moved)
. page = locate(first(moved) ?? "")?.page
if filled && page && opens(page)
    show-page(filled, page.id)

────────────────────
+ do float-node
    - scope PaneScope
    - node-id String
    - x Float
    - y Float
    - width Float
    - height Float

drop(pane-node-drag(node-id, scope), pane-float-target(x, y, width, height))

────────────────────
+ do unfloat
    - float-id String

=? if !layout().find-float(float-id)
. returned String? = null
commit • edit => do
    . region = layout().find-float(float-id)
    =? if !region || !region.root
    . views = visible-in(region.root)
    . target = region.origin
    if target && target is .stack
        if !stack-in(target.scope, target.stack) || region.find(target.stack)
            target = null
    if !target
        . first = layout().workspace.root?.first-stack()
        . fallback = pane-stack-target(PaneScope.workspace, first?.id ?? "", PaneZone.center)
        target = if bottom-node() then PaneTarget.bottom else fallback
    apply-drop(pane-node-drag(region.root!.id, PaneScope.layout), target)
    if target is .slot
        returned = first(views)
. place = locate(returned ?? "")
. page = place?.page
if place && page && place.region.kind == PaneRegionKind.dock && opens(page)
    show-page(place.region.side, page.id)

────────────────────
+ do switch-to
    - context-id String

. target = context-named(context-id)
=? if !target
. owned = layout()
. into = session-of(target)
for region in List'PaneRegion(owned.workspace) ++ owned.regions()
    for stack in region.stacks()
        . shown = active-view(stack)
        . kept = into.active[stack.id]
        if shown && is-role(shown) && !(kept && into.instances has kept && stack.views has kept)
            into.active[stack.id] = shown
    if region.kind == PaneRegionKind.dock
        . page = current-page(region.side)
        . kept = into.pages[region.id] ?? ""
        . own = some(region.pages) • where each.id == kept && !holds-role(each.root)
        if page && holds-role(page.root) && !own
            into.pages[region.id] = page.id
current = context-id
revision += 1

────────────────────
+ do fork

commit • edit => do
    . owner = context()
    . base = layout-of(owner)
    =? if !base.is-shared
    . copied = copy-layout(base, make-id("layout"), "${owner.name} layout", base.id)
    if copied
        owner.layout = copied.id

────────────────────
+ do revert

commit • edit => do
    . owner = context()
    . owned = layout-of(owner)
    =? if owned.is-shared
    owner.layout = base-of(owned)
    -= layouts[owned.id]

────────────────────
+ do make-shared

commit • edit => do
    . owner = context()
    . owned = layout-of(owner)
    =? if owned.is-shared
    . base-id = base-of(owned)
    =? if !copy-layout(owned, base-id, layouts[base-id]?.name ?? owned.name, null)
    owner.layout = base-id
    -= layouts[owned.id]

────────────────────
+ do validate Bool
    - drag PaneDrag
    - target PaneTarget

. views = payload-views(drag)
=? false if views.length == 0
if !drag.view
    . node = node-in(drag.scope, drag.stack)
    =? false if !node || node.has-workspace()
    =? false if target is .stack && target.scope == drag.scope && node.find(target.stack)
else if target is .stack && target.stack == drag.stack
    . stack = stack-in(target.scope, target.stack)
    =? false if stack && visible-views(stack).length <= 1
    =? false if target.zone == PaneZone.center && target.index == null
if target is .slot && drag.scope == PaneScope.layout
    . region = region-in(PaneScope.layout, drag.stack)
    . page = region?.find(drag.stack)?.page
    if region && page && region.side == target.side && page-views(page).length == views.length
        . pages = pages-in(target.side)
        =? false if target.before == page.id || target.before == pane-page-after(pages, page.id)
= !(target is .stack) || target.zone == PaneZone.center || can-split(target.scope, target.stack)

────────────────────
+ do vacates Bool
    - drag PaneDrag

. view = drag.view
=? true if !view
. source = stack-in(drag.scope, drag.stack)
=? true if !source
=? false if visible-views(source).length > 1
= !(layout-keeps(layout()) has source.id) && (all(source.views) • where each == view)

────────────────────
+ can-split Bool
    - scope PaneScope
    - stack-id String

stack-in(scope, stack-id) != null

────────────────────
+ payload-views [String]
    - drag PaneDrag

|? drag.view
    List'String(drag.view)
??
    visible-in(node-in(drag.scope, drag.stack))

────────────────────
+ drag-stacks [String]
    - drag PaneDrag

*? drag.stack if drag.view
**? (each.id in node.stacks()) if node

.. node = node-in(drag.scope, drag.stack) if !drag.view

────────────────────
+ users-of [PaneContext]
    - owned PaneLayout

List'PaneContext(each in contexts when each.layout == owned.id)

────────────────────
+ do preview PaneModel
    - drag PaneDrag
    - target PaneTarget

. copy = PaneModel()
copy.roles += roles
copy.buttoned = List'String(buttoned)
for owner in contexts
    do copy.add-context(owner.id, owner.name, owner.layout)
. ignored = copy.load(json)
. view = drag.view
if view && !copy.locate(view)
    copy.session().instances[view] = ""
copy.drop(drag, target)
= copy

────────────────────
+ do load Bool
    - value JSON

. failure = catch restore-json(value)
=? false if failure is Error
normalize-all()
revision += 1
= true

────────────────────
_ context-named PaneContext?
    - id String

first(each in contexts when each.id == id)

────────────────────
_ layout-of PaneLayout
    - owner PaneContext

layout-for(owner)!

────────────────────
_ layout-for PaneLayout?
    - owner PaneContext

layouts[owner.layout] ?? first(layouts.values)

────────────────────
_ session-of PaneSession
    - owner PaneContext

sessions.get-or-init(owner.id)

────────────────────
_ is-role Bool
    - view String

roles has view

────────────────────
_ node-in PaneNode?
    - scope PaneScope
    - node-id String

region-in(scope, node-id)?.find(node-id)?.node

────────────────────
_ region-in PaneRegion?
    - scope PaneScope
    - node-id String

match scope
    |= PaneScope.workspace
        layout().workspace
    |= PaneScope.layout
        layout().region-of(node-id)

────────────────────
_ do collect-top
    - node PaneNode?
    - into [String]

=? if !node
match node.kind
    |= PaneNodeKind.workspace
        collect-top(layout().workspace.root, into)
    |= PaneNodeKind.stack
        into += node.id
    |= PaneNodeKind.split
        for kid in node.kids
            collect-top(kid, into)
            =? if node.axis == PaneAxis.column

────────────────────
_ do unfold
    - stack PaneNode

. bottom = bottom-node()
if bottom && bottom.find(stack.id) && is-folded-node(bottom)
    for member in bottom.stacks()
        member.is-collapsed = false
else
    stack.is-collapsed = false

────────────────────
_ view-at String?
    - place PaneLocation?

|? !place
    null
|? !stack
    null
??
    active-view(stack)

.. stack = stack-in(place.scope, place.stack)

────────────────────
_ do place-closed
    - record PaneClosed

. target = closed-target(record)
. place = locate(record.view)
=? if !target || !place
. drag = pane-view-drag(record.view, place.scope, place.stack)
=? if !validate(drag, target)
commit • edit => do
    apply-drop(drag, target)

────────────────────
_ do closed-target PaneTarget?
    - record PaneClosed

for scope in [PaneScope.workspace, PaneScope.layout]
    . stack = stack-in(scope, record.stack)
    if stack
        . count = tab-views(stack).length
        = pane-stack-target(scope, record.stack, PaneZone.center, min(record.index ?? count, count))
. origin = record.origin
|? !origin
    = null
|? origin is .stack && !stack-in(origin.scope, origin.stack)
    = null
??
    = origin

────────────────────
_ focused PaneLocation?

locate-stack(session().focus) ?? main-focused()

────────────────────
_ do main-focused PaneLocation?

. state = session()
for id in [state.main-focus, state.workspace-focus, layout().workspace.root?.first-stack()?.id]
    . place = locate-stack(id)
    =? place if place && place.region.kind != PaneRegionKind.dock
= null

────────────────────
_ do locate-stack PaneLocation?
    - id String?

=? null if !id
for scope in [PaneScope.workspace, PaneScope.layout]
    . region = region-in(scope, id)
    =? PaneLocation(scope, id, region, region.find(id)?.page) if region && stack-in(scope, id)
= null

────────────────────
_ do take-focus
    - stack-id String

. state = session()
. main = if docked then state.main-focus else stack-id
    .. docked = layout().region-of(stack-id)?.kind == PaneRegionKind.dock
=? if state.focus == stack-id && state.main-focus == main
state.focus = stack-id
state.main-focus = main
focus-revision += 1

────────────────────
_ is-folded Bool
    - place PaneLocation

|? region.kind != PaneRegionKind.dock
    false
|? region.is-collapsed
    true
??
    page != null && current-page(region.side)?.id != page.id

.. region = place.region
.. page = place.page

────────────────────
_ do pin-pages [String = String]

. showing = Map'String'String()
. state = session()
for side in [PaneSide.left, PaneSide.right]
    . region = layout().dock(side)
    . page = current-page(side)
    if page
        state.pages[region.id] = page.id
        if !region.is-collapsed
            showing[region.id] = page.id
= showing

────────────────────
_ do settle-pages
    - showing [String = String]
    - moved [String]

. state = session()
. changed = false
for side in [PaneSide.left, PaneSide.right]
    . region = layout().dock(side)
    . was = showing[region.id]
    if was && current-page(side)?.id != was
        . place = locate(first(moved) ?? "")
        . landed = place?.page
        if place && landed && place.region == region && opens(landed)
            state.pages[region.id] = landed.id
        else
            region.is-collapsed = true
        changed = true
if changed
    revision += 1

────────────────────
_ do holds-role Bool
    - node PaneNode

for stack in node.stacks()
    for view in stack.views
        =? true if is-role(view)
= false

────────────────────
_ do commit
    - edit () Void

edit()
normalize-all()
revision += 1

────────────────────
_ do restore-json ?! Error
    - value JSON?

. fields = JSONReader("layout", value).object()
?! Error("Saved panes are not version $pane-json-version")
    if fields["version"].int() != pane-json-version
. found = List'PaneLayout(pane-layout-from(each) in fields["layouts"].items())
. loaded-layouts = Map'String'PaneLayout((each.id, each) in found)
=? if loaded-layouts.length == 0
. saved = fields["sessions"].object()
. restored = Map'String'PaneSession((each, pane-session-from(saved[each])) in saved.fields.keys)
for item in fields["contexts"].items()
    . entry = item.object()
    . owner = context-named(entry["id"].string())
    if owner
        owner.layout = entry["layout"].string()
layouts = loaded-layouts
for owner in contexts
    if !(layouts has owner.layout)
        owner.layout = List'String(layouts.keys)[0]
    . state = restored[owner.id]
    if state
        sessions[owner.id] = state
. chosen = fields["current"].string()
if context-named(chosen)
    current = chosen
next-id = max(next-id, fields["nextId"].int() as U64)
visits = List'PaneVisit(pane-visit-from(each.object()) in fields["visits"].items())

────────────────────
_ layout-keeps [String]
    - owned PaneLayout

List'String(owned.homes.values)

────────────────────
_ do prune-views
    - owned PaneLayout

. live = Map'String'Bool()
for owner in users-of(owned)
    for view in session-of(owner).instances.keys
        live[view] = true
for stack in layout-stacks(owned)
    . kept = List'String(each in stack.views when is-role(each) || live has each)
    stack.views = kept

────────────────────
_ do layout-stacks [PaneNode]
    - owned PaneLayout

. found = List'PaneNode(owned.workspace.stacks())
for region in owned.regions()
    found ++= region.stacks()
= found

────────────────────
_ do normalized PaneNode?
    - node PaneNode?
    - keeps [String]

=? null if !node
match node.kind
    |= PaneNodeKind.workspace
        = node
    |= PaneNodeKind.stack
        = node if node.views.length > 0 || keeps has node.id
    |= PaneNodeKind.split
        . kept = List'(PaneNode?)(normalized(each, keeps) in node.kids)
        . shares = List'Float(node.size-at(each) in 0 .. < node.kids.length)
        for position in 0 .. < kept.length
            if !kept[position]
                . taker = share-taker(kept, position)
                if taker != null
                    shares[taker] += shares[position]
        . kids = List'PaneNode()
        . sizes = List'Float()
        for position in 0 .. < kept.length
            . kid = kept[position]
            if kid
                . share = shares[position]
                if kid.is-split && kid.axis == node.axis && !kid.is-dock
                    . total = max(sum(kid.sizes), 0.0001)
                    for inner in 0 .. < kid.kids.length
                        kids += kid.kids[inner]
                        sizes += share * kid.size-at(inner) / total
                else
                    kids += kid
                    sizes += share
        =? null if kids.length == 0
        if kids.length == 1
            . only = kids[0]
            only.is-dock = only.is-dock || node.is-dock
            = only
        node.kids = kids
        node.sizes = sizes
        = node

────────────────────
_ do share-taker Index?
    - kept [PaneNode?]
    - position Index

. before = last(each in 0 .. < position when kept[each])
. after = first(each in position + 1 .. < kept.length when kept[each])
. wanted = heir
if wanted
    =? before if before != null && kept[before]!.find(wanted) != null
    =? after if after != null && kept[after]!.find(wanted) != null
= before ?? after

────────────────────
_ do normalize-all

for owned in layouts.values
    prune-views(owned)
    . keeps = layout-keeps(owned)
    for region in owned.regions()
        region.root = normalized(region.root, keeps)
        settle-collapsed(region.root, false)
        sink-inlines(region.root, owned.inlines)
        . pages = List'PanePage()
        for page in region.pages
            . root = normalized(page.root, keeps)
            if root
                page.root = root
                settle-collapsed(root, false)
                sink-inlines(root, owned.inlines)
                pages += page
        region.pages = pages
    owned.center.root = owned.center.root ?? pane-workspace-node()
    owned.floats = List'PaneRegion(each in owned.floats when each.root)
    . root = owned.workspace.root
    . first = root?.first-stack()
    owned.workspace.root = normalized(root, List'String())
    if !owned.workspace.root
        owned.workspace.root = pane-stack-node(first?.id ?? make-id("stack"), List'String())
    settle-collapsed(owned.workspace.root, false)
    sink-inlines(owned.workspace.root, owned.inlines)
    for owner in users-of(owned)
        rehome(owner)
heir = null

────────────────────
_ do sink-inlines
    - node PaneNode?
    - inlines [String]

=? if !node
for stack in node.stacks()
    . kept = List'String(each in stack.views when !(inlines has each))
    if kept.length < stack.views.length
        stack.views = kept ++ List'String(each in stack.views when inlines has each)

────────────────────
_ do settle-collapsed
    - node PaneNode?
    - stacked Bool

=? if !node
if node.is-stack && !stacked
    node.is-collapsed = false
for kid in node.kids
    settle-collapsed(kid, stacked || (node.is-split && node.axis == PaneAxis.column))

────────────────────
_ do remove-view
    - owned PaneLayout
    - view String

for stack in layout-stacks(owned)
    stack.views -= view

────────────────────
_ do forget-instance
    - state PaneSession
    - view String

-= state.instances[view]
for kind in List'String(state.last-focus.find(view))
    -= state.last-focus[kind]

────────────────────
_ do insert-beside
    - region PaneRegion
    - target-id String
    - added PaneNode
    - zone PaneZone
    - vacated String?

. axis = if zone == PaneZone.left || zone == PaneZone.right then PaneAxis.row else PaneAxis.column
. before = zone == PaneZone.left || zone == PaneZone.top
. found = region.find(target-id)
=? if !found
. parent = found.parent
if parent && parent.is-split && parent.axis == axis && !found.node.is-dock
    while parent.sizes.length < parent.kids.length
        parent.sizes += 1
    . hole = List'String(each.id in parent.kids).find(vacated ?? "")
    . live = List'Index(each in 0 .. < parent.kids.length when parent.size-at(each) > 0 && !parent.kids[each].is-collapsed)
    . even = if live.length > 0 then sum(parent.size-at(each) in live) / live.length as Float else 1
    . share = if hole != null then parent.size-at(hole) else even
    if hole != null
        parent.sizes[hole] = 0
    . at = if before then found.index else found.index + 1
    parent.kids.insert(added, at)
    parent.sizes.insert(share, at)
else
    . kids = if before then List'PaneNode(added, found.node) else List'PaneNode(found.node, added)
    . split = pane-split-node(make-id("split"), axis, kids, List'Float(1, 1))
    split.is-dock = found.node.is-dock
    found.node.is-dock = false
    . page = found.page
    if parent
        parent.kids[found.index] = split
    else if page
        page.root = split
    else
        region.root = split

────────────────────
_ do detach PaneNode?
    - region PaneRegion
    - node-id String
    - hole PaneNode

. found = region.find(node-id)
=? null if !found
. parent = found.parent
. page = found.page
if parent
    parent.kids[found.index] = hole
else if page
    page.root = hole
else
    region.root = null
found.node.is-dock = false
= found.node

────────────────────
_ do add-to-stack
    - scope PaneScope
    - stack-id String
    - view String
    - after String? = null

. state = session()
. stack = node-in(scope, stack-id)
=? if !stack
. anchor = after ?? (state.active[stack.id] if scope == PaneScope.workspace)
. position = stack.views.find(anchor ?? "")
stack.views.insert(view, if position != null then position + 1 else tail-of(stack))
if scope == PaneScope.workspace
    state.workspace-focus = stack.id
state.active[stack-id] = view

────────────────────
_ do place-instance
    - view String
    - skip-near Bool

=? if locate(view)
. state = session()
. kind = state.instances[view] ?? ""
. near = state.last-focus[kind]
. place = locate(near) if !skip-near && near && near != view && state.instances has near
. placed = layout().placed[kind]
. usable = placed && (placed == pane-workspace-home || stack-in(PaneScope.layout, placed) != null)
. home = if usable then placed else layout().homes[kind]
if place
    add-to-stack(place.scope, place.stack, view, near)
else if home && home != pane-workspace-home && stack-in(PaneScope.layout, home)
    add-to-stack(PaneScope.layout, home, view)
else if home == pane-bottom-home
    . stack = pane-stack-node(make-id("stack"), List'String(view))
    stack.is-collapsed = true
    insert-tree(stack, PaneTarget.bottom, null, view)
else
    . focused = stack-in(PaneScope.workspace, state.workspace-focus ?? "")
    . stack = focused ?? layout().workspace.root?.first-stack()
    if stack
        add-to-stack(PaneScope.workspace, stack.id, view)

────────────────────
_ do reveal-in
    - view String

. place = locate(view)
=? if !place
. state = session()
. stack = stack-in(place.scope, place.stack)
if !shows-buttons(view)
    state.active[place.stack] = view
    if stack
        unfold(stack)
. page = place.page
if place.region.kind == PaneRegionKind.dock
    if in-menu(view)
        menu-requested <- view
    else if page && opens(page)
        place.region.is-collapsed = false
        state.pages[place.region.id] = page.id
else if place.region.kind == PaneRegionKind.float
    raise-float(place.region.id)
if place.scope == PaneScope.workspace
    state.workspace-focus = place.stack

────────────────────
_ do restore-role
    - view String
    - side PaneSide? = null

. owned = layout()
. home = owned.closed[view]
. remembered = (stack-in(PaneScope.layout, home) ?? stack-in(PaneScope.workspace, home)) if home
-= owned.closed[view]
if remembered
    remembered.views += view
else if side
    owned.dock(side).pages += PanePage(make-id("page"), pane-stack-node(make-id("stack"), List'String(view)))
else
    insert-tree(pane-stack-node(make-id("stack"), List'String(view)), PaneTarget.bottom, null, view)

────────────────────
_ do origin-of PaneTarget?
    - region PaneRegion
    - node-id String
    - scope PaneScope

. found = region.find(node-id)
=? null if !found
. parent = found.parent
if !parent
    . page = found.page
    =? pane-slot-target(region.side, pane-page-after(region.pages, page.id)) if page && docked
    .. docked = region.kind == PaneRegionKind.dock
    = null
. after = found.index > 0
. sibling = parent.kids[if after then found.index - 1 else 1].first-stack()
=? null if !sibling
. zone = if parent.axis == PaneAxis.row then row-zone else column-zone
    .. row-zone = if after then PaneZone.right else PaneZone.left
    .. column-zone = if after then PaneZone.bottom else PaneZone.top
= pane-stack-target(scope, sibling.id, zone)

────────────────────
_ do join-into
    - tree PaneNode
    - target PaneNode
    - scope PaneScope
    - index Index?
    - chosen String?

. state = session()
. views = pane-views(tree.stacks())
. picked = chosen ?? first(visible-in(tree))
. shown = tab-views(target)
. tail = tail-of(target)
. at = if index != null && index < shown.length then placed-at else tail
    .. placed-at = target.views.find(shown[index]) ?? tail
target.views.insert(views, at)
if scope == PaneScope.workspace
    state.workspace-focus = target.id
if picked
    state.active[target.id] = picked

────────────────────
_ do tail-of Index
    - stack PaneNode

. inlines = layout().inlines
= first(each in 0 .. < stack.views.length when inlines has stack.views[each]) ?? stack.views.length

────────────────────
_ do apply-drop
    - drag PaneDrag
    - incoming PaneTarget

. owned = layout()
. target = incoming
. tree PaneNode? = null
. origin PaneTarget? = null
. chosen String? = null
. hole = pane-stack-node(make-id("stack"), List'String())
. vacated String? = null
if drag.view
    . view = drag.view
    if target is .stack && target.zone == PaneZone.center && target.stack == drag.stack
        . index = target.index
        . stack = stack-in(target.scope, target.stack)
        if stack && index != null
            . from = tab-views(stack).find(view)
            if from != null && from < index
                target = pane-stack-target(target.scope, target.stack, target.zone, index - 1)
    origin = pane-stack-target(drag.scope, drag.stack, PaneZone.center)
    remove-view(owned, view)
    . source = stack-in(drag.scope, drag.stack)
    if source && source.views.length == 0 && !(layout-keeps(owned) has source.id)
        vacated = drag.stack
    tree = pane-stack-node(make-id("stack"), List'String(view))
    chosen = view
else
    . region = region-in(drag.scope, drag.stack)
    =? if !region
    origin = origin-of(region, drag.stack, drag.scope)
    tree = detach(region, drag.stack, hole)
    vacated = hole.id
=? if !tree
insert-tree(tree, target, origin, chosen, vacated)

────────────────────
_ do insert-tree
    - tree PaneNode
    - target PaneTarget
    - origin PaneTarget?
    - chosen String?
    - vacated String? = null

. owned = layout()
. state = session()
. first = tree.first-stack()
heir = if target is .stack && target.zone == PaneZone.center then target.stack else first?.id
match target
    | .float(x, y, width, height)
        . region = PaneRegion(PaneRegionKind.float, make-id("float"))
        region.x = x
        region.y = y
        region.width = width
        region.height = height
        region.root = tree
        region.origin = origin
        owned.floats += region
    | .slot(side, before)
        . region = owned.dock(side)
        region.pages.insert
            - PanePage(make-id("page"), tree)
            - region.page-index(before) ?? region.pages.length
    |= .bottom
        . joined = bottom-node()?.first-stack()
        if joined
            heir = joined.id
            join-into(tree, joined, PaneScope.layout, null, chosen)
            =
        owned.center.root = pane-with-bottom(owned.center.root, tree, make-id("split"))
    | .stack(scope, stack-id, zone, index)
        if zone == PaneZone.center
            . stack = stack-in(scope, stack-id)
            if stack
                join-into(tree, stack, scope, index, chosen)
            =
        . region = region-in(scope, stack-id)
        =? if !region
        insert-beside(region, stack-id, tree, zone, vacated)
        if first && scope == PaneScope.workspace
            state.workspace-focus = first.id
if first && chosen
    state.active[first.id] = chosen

────────────────────
_ do copy-layout PaneLayout?
    - source PaneLayout
    - id String
    - name String
    - base String?

. copied = catch? pane-layout-from(JSONReader("layout", source.json))
=? null if !copied
copied.id = id
copied.name = name
copied.is-shared = !base
copied.base = base
layouts[id] = copied
= copied

────────────────────
_ base-of String
    - owned PaneLayout

|? owned.is-shared
    owned.id
|? base && layouts has base
    base
??
    List'String(layouts.keys)[0]

.. base = owned.base

────────────────────
_ do rehome
    - owner PaneContext

. state = session-of(owner)
. located = Map'String'Bool()
for stack in layout-stacks(layout-of(owner))
    for view in stack.views
        located[view] = true
. lost = List'String(each in state.instances.keys when !(located has each))
=? if lost.length == 0
. saved = current
current = owner.id
for view in lost
    place-instance(view, true)
current = saved

━━━━━━━━━━━━━━━━━━━━
+ pane-stack-node PaneNode
    - id String
    - views [String]

PaneNode(PaneNodeKind.stack, id) • views views

━━━━━━━━━━━━━━━━━━━━
+ pane-split-node PaneNode
    - id String
    - axis PaneAxis
    - kids [PaneNode]
    - sizes [Float]

PaneNode(PaneNodeKind.split, id) • axis axis • kids kids • sizes sizes

━━━━━━━━━━━━━━━━━━━━
+ pane-workspace-node PaneNode

PaneNode(PaneNodeKind.workspace, pane-workspace-home)

━━━━━━━━━━━━━━━━━━━━
+ pane-view-drag PaneDrag
    - view String
    - scope PaneScope
    - stack String

PaneDrag(view, scope, stack)

━━━━━━━━━━━━━━━━━━━━
+ pane-node-drag PaneDrag
    - node String
    - scope PaneScope

PaneDrag(null, scope, node)

━━━━━━━━━━━━━━━━━━━━
+ pane-arrival-drag PaneDrag
    - view String

PaneDrag(view, PaneScope.workspace, "")

━━━━━━━━━━━━━━━━━━━━
+ pane-stack-target PaneTarget
    - scope PaneScope
    - stack String
    - zone PaneZone
    - index Index? = null

PaneTarget.stack(scope, stack, zone, index)

━━━━━━━━━━━━━━━━━━━━
+ pane-slot-target PaneTarget
    - side PaneSide
    - before String? = null

PaneTarget.slot(side, before)

━━━━━━━━━━━━━━━━━━━━
+ pane-float-target PaneTarget
    - x Float
    - y Float
    - width Float
    - height Float

PaneTarget.float(x, y, width, height)

━━━━━━━━━━━━━━━━━━━━
_ PaneFound is Tuple

+ node PaneNode
+ parent PaneNode?
+ index Index
+ page PanePage?

━━━━━━━━━━━━━━━━━━━━
_ do pane-with-bottom PaneNode
    - root PaneNode?
    - node PaneNode
    - id String

node.is-dock = true
= pane-split-node
    - id
    - PaneAxis.column
    - List'PaneNode(root ?? pane-workspace-node(), node)
    - List'Float(1 - pane-bottom-share, pane-bottom-share)

━━━━━━━━━━━━━━━━━━━━
_ pane-node-from PaneNode ?! Error
    - reader JSONReader

PaneNode(fields["kind"].int() as PaneNodeKind, fields["id"].string())
    • views List'String(each.string() in fields["views"].items())
    • axis fields["axis"].int() as PaneAxis
    • kids List'PaneNode(pane-node-from(each) in fields["kids"].items())
    • sizes List'Float(each.number() in fields["sizes"].items())
    • is-collapsed fields["collapsed"].bool()
    • is-dock fields["dock"].bool()

.. fields = reader.object()

━━━━━━━━━━━━━━━━━━━━
_ do pane-origin-from PaneTarget? ?! Error
    - reader JSONReader

=? null if !reader.is-present
. fields = reader.object()
=? PaneTarget.bottom if fields["bottom"].is-present
. slot = fields["slot"]
if slot.is-present
    . before String? = null
    before = fields["before"].string() if fields["before"].is-present
    = pane-slot-target(slot.int() as PaneSide, before)
. zone = fields["zone"].int() as PaneZone
= pane-stack-target(fields["scope"].int() as PaneScope, fields["stack"].string(), zone)

━━━━━━━━━━━━━━━━━━━━
_ pane-page-from PanePage ?! Error
    - reader JSONReader

PanePage(fields["id"].string(), pane-node-from(fields["root"]))

.. fields = reader.object()

━━━━━━━━━━━━━━━━━━━━
_ do pane-region-from PaneRegion ?! Error
    - reader JSONReader

. fields = reader.object()
. root = fields["root"]
. region = PaneRegion((fields["kind"].int()) as PaneRegionKind, fields["id"].string())
region.side = (fields["side"].int()) as PaneSide
region.root = pane-node-from(root) if root.is-present
region.pages = List'PanePage(pane-page-from(each) in fields["pages"].items())
region.strip = fields["strip"].int() as PaneStripMode
region.size = fields["size"].number()
region.is-collapsed = fields["collapsed"].bool()
region.x = fields["x"].number()
region.y = fields["y"].number()
region.width = fields["width"].number()
region.height = fields["height"].number()
region.origin = pane-origin-from(fields["origin"])
= region

━━━━━━━━━━━━━━━━━━━━
_ do pane-layout-from PaneLayout ?! Error
    - reader JSONReader

. fields = reader.object()
. layout = PaneLayout(fields["id"].string(), fields["name"].string())
layout.is-shared = fields["shared"].bool()
layout.base = fields["base"].string() if fields["base"].is-present
layout.left = pane-region-from(fields["left"])
layout.right = pane-region-from(fields["right"])
layout.center = pane-region-from(fields["center"])
layout.workspace = pane-region-from(fields["workspace"])
layout.floats = List'PaneRegion(pane-region-from(each) in fields["floats"].items())
layout.homes = pane-string-map-from(fields["homes"])
layout.placed = pane-string-map-from(fields["placed"])
layout.closed = pane-string-map-from(fields["closed"])
layout.menus = List'String(each.string() in fields["menus"].items())
layout.inlines = List'String(each.string() in fields["inlines"].items())
= layout

━━━━━━━━━━━━━━━━━━━━
_ do pane-session-from PaneSession ?! Error
    - reader JSONReader

. fields = reader.object()
. session = PaneSession()
session.active = pane-string-map-from(fields["active"])
session.pages = pane-string-map-from(fields["pages"])
session.instances = pane-string-map-from(fields["instances"])
session.last-focus = pane-string-map-from(fields["lastFocus"])
. focus = fields["workspaceFocus"]
session.workspace-focus = focus.string() if focus.is-present
= session

━━━━━━━━━━━━━━━━━━━━
_ pane-visit-json JSON
    - visit PaneVisit

Map'String'JSON
    • context visit.context
    • view visit.view

━━━━━━━━━━━━━━━━━━━━
_ pane-visit-from PaneVisit
    - fields JSONObjectReader

PaneVisit(fields["context"].string(), fields["view"].string())

━━━━━━━━━━━━━━━━━━━━
_ same-visit Bool
    - left PaneVisit
    - right PaneVisit

left.context == right.context && left.view == right.view

━━━━━━━━━━━━━━━━━━━━
_ pane-renamed-visit PaneVisit
    - visit PaneVisit
    - context String
    - old String
    - view String

if visit.context == context && visit.view == old then PaneVisit(context, view) else visit

━━━━━━━━━━━━━━━━━━━━
_ do pane-string-map-from [String = String] ?! Error
    - reader JSONReader

. found = Map'String'String()
=? found if !reader.is-present
for key, value in reader.object().fields
    found[key] = JSONReader(key, value).string()
= found

━━━━━━━━━━━━━━━━━━━━
_ pane-map-json'Value [String = JSON]
    - map [String = Value]

Map'String'JSON((each.key, each.value as JSON) in map.items)

━━━━━━━━━━━━━━━━━━━━
_ pane-page-after String?
    - pages [PanePage]
    - page-id String

if index == null || index + 1 >= pages.length then null else pages[index + 1].id

.. index = first(each in 0 .. < pages.length when pages[each].id == page-id)

━━━━━━━━━━━━━━━━━━━━
_ pane-views [String]
    - stacks <PaneNode>

List'String(flat-map(each.views in stacks))
