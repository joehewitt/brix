+ PaneLayout

+ id String
+ name String
+ is-shared = true
+ left = PaneRegion(PaneRegionKind.dock, "left", PaneSide.left, pane-side-dock-size)
+ right = PaneRegion(PaneRegionKind.dock, "right", PaneSide.right, pane-side-dock-size)
+ center = PaneRegion(PaneRegionKind.center, "center")
+ floats [PaneRegion]
+ workspace = PaneRegion(PaneRegionKind.workspace, pane-workspace-home)
+ homes [String = String]
+ closed [String = String]
+ menus [String]
+ inlines [String]

_ base String?
_ placed [String = String]

────────────────────
+ This
    - id
    - name

center.root = pane-workspace-node()

────────────────────
+ get json JSON

Map'String'JSON
    • id id
    • name name
    • shared is-shared
    • base base as JSON
    • left left.json
    • right right.json
    • center center.json
    • workspace workspace.json
    • floats List'JSON(each.json in floats)
    • homes pane-map-json(homes)
    • placed pane-map-json(placed)
    • closed pane-map-json(closed)
    • menus menus
    • inlines inlines

────────────────────
+ dock PaneRegion
    - side PaneSide

match side
    |= PaneSide.left
        left
    |= PaneSide.right
        right

────────────────────
+ regions [PaneRegion]

List'PaneRegion(left, right, center) ++ floats

────────────────────
+ do add-bottom
    - node PaneNode

center.root = pane-with-bottom(center.root, node, "${node.id}-row")

────────────────────
+ find-float PaneRegion?
    - float-id String

first(each in floats when each.id == float-id)

────────────────────
_ region-of PaneRegion?
    - node-id String

first(each in regions() when each.find(node-id))

