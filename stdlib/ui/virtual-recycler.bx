(import ./virtual)
(import ./virtual-layout)

(type + VirtualRecyclerStats (is Tuple)
  (prop + pool-created Size)
  (prop + pool-high-water Size)
  (prop + window-refreshes Size)
  (prop + placements-emitted Size)
  (prop + layout-addresses-inspected Size)
  (prop + rebinds Size)
  (prop + source-binds Size)
  (prop + departures Size)
  (prop + placement-buffer-grows Size)
  (prop + stale-commits Size)
)

(type + VirtualRecyclerOwner (is Interface)
  (fn-do + virtual-slot-departing _
    (param slot-index Index)
  )
  (fn-do + virtual-slot-arriving _
    (param slot-index Index)
  )
)

(type _ (of VirtualBindingOwner Item) (is Interface)
  (fn-do + accept-binding _
    (param slot-index Index)
    (param address I64)
    (param key VirtualKey)
    (param item Item)
    (param generation U64)
  )
  (fn-do + note-stale-commit _)
)

(type + (of VirtualRecycler Item)
  (implements (of VirtualBindingOwner Item))
  (prop + source (? (of VirtualSource Item)))
  (prop + layout (? VirtualLayout))
  (prop + owner (? VirtualRecyclerOwner))
  (prop + window _ (:= (call VirtualWindow)))
  (prop + retention _ (= (call VirtualInsets 0vcoord 0vcoord 0vcoord 0vcoord)))
  (prop + slots (list (of VirtualSlot Item)) (= (call (of List (of VirtualSlot Item)))))
  (prop + has-pending-changes Bool)
  (prop + is-revision-change Bool)
  (blank)
  (prop _ targets (list (of VirtualBindingRequestTarget Item)) (= (call (of List (of VirtualBindingRequestTarget Item)))))
  (prop _ slot-is-placed (list Bool) (= (call (of List Bool))))
  (prop _ slot-placement-ids (list VirtualCoord) (= (call (of List VirtualCoord))))
  (prop _ slot-placement-indexes (list Index) (= (call (of List Index))))
  (prop _ placement-slot-indexes (list Index) (= (call (of List Index))))
  (prop _ placed-slots (list Index) (= (call (of List Index))))
  (prop _ next-placed-slots (list Index) (= (call (of List Index))))
  (prop _ free-slots (list Index) (= (call (of List Index))))
  (prop _ slot-identities (list U64) (= (call (of List U64))))
  (prop _ slot-has-identity (list Bool) (= (call (of List Bool))))
  (prop _ slot-retained (list Bool) (= (call (of List Bool))))
  (prop _ placement-retained (list Bool) (= (call (of List Bool))))
  (prop _ placement-required (list Bool) (= (call (of List Bool))))
  (prop _ has-cover Bool)
  (prop _ cover-first Index)
  (prop _ cover-last Index)
  (prop _ cover-reaches-start Bool)
  (prop _ cover-reaches-end Bool)
  (prop _ identity-slots (of Map U64 Index) (= (call (of Map U64 Index))))
  (prop _ bound-source (? (of VirtualSource Item)))
  (prop _ bound-source-pointer Pointer)
  (prop _ has-source-revision Bool)
  (prop _ source-revision U64)
  (blank)
  (prop _ stat-pool-created Size)
  (prop _ stat-pool-high-water Size)
  (prop _ stat-window-refreshes Size)
  (prop _ stat-placements-emitted Size)
  (prop _ stat-layout-addresses-inspected Size)
  (prop _ stat-rebinds Size)
  (prop _ stat-source-binds Size)
  (prop _ stat-departures Size)
  (prop _ stat-placement-buffer-grows Size)
  (prop _ stat-stale-commits Size)
  (fn-expr + stats VirtualRecyclerStats :get
    (call VirtualRecyclerStats
      (block
        (arg stat-pool-created)
        (arg stat-pool-high-water)
        (arg stat-window-refreshes)
        (arg stat-placements-emitted)
        (arg stat-layout-addresses-inspected)
        (arg stat-rebinds)
        (arg stat-source-binds)
        (arg stat-departures)
        (arg stat-placement-buffer-grows)
        (arg stat-stale-commits)
      )
    )
  )
  (fn-expr + pool-size _ :get
    (. slots length)
  )
  (fn-expr + has-pending-revision Bool :get
    (case? (or (not live) (not has-source-revision) (!= (as live Pointer) bound-source-pointer))
      false
    )
    (default
      (!= (. live revision value) source-revision)
    )
    (where
      (lazy live source)
    )
  )
  (fn-expr + slot-at (? (of VirtualSlot Item))
    (param index Index)
    (only-if ([] slots index) (if (< index (. slots length))))
  )
  (fn-do + placement-for-slot (? VirtualPlacement)
    (param slot-index Index)
    (return-if (if (or (>= slot-index (. slots length)) (not ([] slot-is-placed slot-index)))))
    (return (call (. window placement-at) ([] slot-placement-indexes slot-index)))
  )
  (fn-do + rect-for-address (? VirtualRect)
    (param address I64)
    (return-if (if (or (not source) (not layout))))
    (return (call (. layout rect-for-address) address (. source domain) window))
  )
  (fn-do + refresh _
    (return-if (if (or (not source) (not layout))))
    (blank)
    (let domain (. source domain))
    (let known-before (. domain known-count))
    (let made-progress true)
    (while made-progress
      (call refresh-window)
      (let known-after (. domain known-count))
      (= made-progress (> known-after known-before))
      (= known-before known-after)
    )
  )
  (fn-do + refresh-window _
    (return-if (if (or (not source) (not layout))))
    (blank)
    (let live-source source)
    (let live-layout layout)
    (let previous-capacity (. window placements capacity))
    (let required
      (call VirtualInsets
        (block
          (arg (. window overscan-top))
          (arg (. window overscan-right))
          (arg (. window overscan-bottom))
          (arg (. window overscan-left))
        )
      )
    )
    (let retains (call retains-beyond required))
    (if retains
      (call (. window set-overscan) (call retained-insets required))
    )
    (call (. live-layout fill-window) window (. live-source domain))
    (call (. window set-overscan) required)
    (throw (call Panic "Virtual layout returned more placements than it supplied") (if (> (. window placement-count) (. window placements length))))
    (blank)
    (if (> (. window placements capacity) previous-capacity)
      (+= stat-placement-buffer-grows 1)
    )
    (+= stat-window-refreshes 1)
    (+= stat-placements-emitted (. window placement-count))
    (+= stat-layout-addresses-inspected (. window placement-count))
    (blank)
    (let live-source-pointer (as live-source Pointer))
    (let source-changed (!= live-source-pointer bound-source-pointer))
    (let revision-changed (or (not has-source-revision) (!= (. live-source revision value) source-revision)))
    (let source-state-changed (or source-changed revision-changed))
    (= bound-source live-source)
    (= bound-source-pointer live-source-pointer)
    (= source-revision (. live-source revision value))
    (= has-source-revision true)
    (blank)
    (let retains-identity (and revision-changed (not source-changed)))
    (= is-revision-change retains-identity)
    (let departed-count (call match-previous-placements source-state-changed retains-identity))
    (call collect-free-slots)
    (call mark-required-placements retains)
    (let rebound-count (call bind-entering-placements live-source))
    (call record-placed-slots)
    (call record-cover (. live-source domain))
    (if (or source-state-changed (> departed-count 0) (> rebound-count 0))
      (= has-pending-changes true)
    )
  )
  (fn-expr + holds Bool
    (param scroll-x VirtualCoord)
    (param scroll-y VirtualCoord)
    (param viewport-width VirtualCoord)
    (param viewport-height VirtualCoord)
    (and (!= (. window placement-count) 0) has-cover (or spans-x holds-x) holds-y)
    (where
      (lazy spans-x (and (. window extent-x is-final) (<= (. window extent-x known) (. window frame-width))))
      (lazy holds-x
        (call axis-holds
          (block
            (arg true)
            (arg scroll-x)
            (arg viewport-width)
            (arg (call VirtualSize (. window overscan-left) (. window overscan-right)))
            (arg (call VirtualSize (. retention left) (. retention right)))
            (arg (. window extent-x))
          )
        )
      )
      (lazy holds-y
        (call axis-holds
          (block
            (arg false)
            (arg scroll-y)
            (arg viewport-height)
            (arg (call VirtualSize (. window overscan-top) (. window overscan-bottom)))
            (arg (call VirtualSize (. retention top) (. retention bottom)))
            (arg (. window extent-y))
          )
        )
      )
    )
  )
  (fn-do + release _
    (for (in slot-index placed-slots)
      (call depart slot-index)
    )
    (for (in target targets)
      (call (. target deactivate))
    )
    (= slots (call (of List (of VirtualSlot Item))))
    (= targets (call (of List (of VirtualBindingRequestTarget Item))))
    (= slot-is-placed (call (of List Bool)))
    (= slot-placement-ids (call (of List VirtualCoord)))
    (= slot-placement-indexes (call (of List Index)))
    (= placement-slot-indexes (call (of List Index)))
    (= placed-slots (call (of List Index)))
    (= next-placed-slots (call (of List Index)))
    (= free-slots (call (of List Index)))
    (= slot-identities (call (of List U64)))
    (= slot-has-identity (call (of List Bool)))
    (= slot-retained (call (of List Bool)))
    (= placement-retained (call (of List Bool)))
    (= placement-required (call (of List Bool)))
    (= has-cover false)
    (call (. identity-slots clear))
    (call (. window clear-placements))
    (= source null)
    (= bound-source null)
    (= bound-source-pointer (call Pointer))
    (= has-source-revision false)
    (= source-revision 0)
    (= has-pending-changes true)
  )
  (fn-do _ match-previous-placements Size
    (param source-state-changed Bool)
    (param retains-identity Bool)
    (call (. placement-slot-indexes clear))
    (call (. placement-retained clear))
    (let fill-index Index)
    (while (< fill-index (. window placement-count))
      (+= placement-slot-indexes (. Index max))
      (+= placement-retained false)
      (+= fill-index 1)
    )
    (blank)
    (return-if (call retain-identified-placements (!! bound-source)) (if retains-identity))
    (blank)
    (let departed-count Size)
    (let previous-index Index)
    (let placement-index Index)
    (while (< previous-index (. placed-slots length))
      (let slot-index ([] placed-slots previous-index))
      (let previous-id ([] slot-placement-ids slot-index))
      (if (or source-state-changed (>= placement-index (. window placement-count)))
        (call depart slot-index)
        (+= departed-count 1)
        (+= previous-index 1)
        (else
          (let next-id (. ([] (. window placements) placement-index) placement-id))
          (if (== previous-id next-id)
            (= ([] placement-slot-indexes placement-index) slot-index)
            (+= previous-index 1)
            (+= placement-index 1)
            (else-if (< previous-id next-id)
              (call depart slot-index)
              (+= departed-count 1)
              (+= previous-index 1)
            )
            (else
              (+= placement-index 1)
            )
          )
        )
      )
    )
    (return departed-count)
  )
  (fn-do _ retain-identified-placements _
    (param live-source (of VirtualSource Item))
    (let identified Size)
    (let placed-index Index)
    (while (< placed-index (. placed-slots length))
      (let slot-index ([] placed-slots placed-index))
      (= ([] slot-retained slot-index) false)
      (if ([] slot-has-identity slot-index)
        (if (== identified 0)
          (call (. identity-slots clear))
        )
        (= ([] identity-slots ([] slot-identities slot-index)) slot-index)
        (+= identified 1)
      )
      (+= placed-index 1)
    )
    (blank)
    (let placement-index Index)
    (while (and (> identified 0) (< placement-index (. window placement-count)))
      (let identity (call (. live-source identity-at) (. ([] (. window placements) placement-index) address)))
      (if (!= identity null)
        (let retained ([] identity-slots identity))
        (if (!= retained null)
          (= ([] placement-slot-indexes placement-index) retained)
          (= ([] placement-retained placement-index) true)
          (= ([] slot-retained retained) true)
          (-= ([] identity-slots identity))
        )
      )
      (+= placement-index 1)
    )
    (blank)
    (let departed-count Size)
    (= placed-index 0)
    (while (< placed-index (. placed-slots length))
      (let slot-index ([] placed-slots placed-index))
      (if (not ([] slot-retained slot-index))
        (call depart slot-index)
        (+= departed-count 1)
      )
      (= ([] slot-retained slot-index) false)
      (+= placed-index 1)
    )
    (return departed-count)
  )
  (fn-do _ record-slot-identity _
    (param live-source (of VirtualSource Item))
    (param slot-index Index)
    (param address I64)
    (let identity (call (. live-source identity-at) address))
    (= ([] slot-has-identity slot-index) (!= identity null))
    (= ([] slot-identities slot-index) (?? identity 0u64))
  )
  (fn-do _ rebind-retained-slot _
    (param live-source (of VirtualSource Item))
    (param slot-index Index)
    (param placement-index Index)
    (let placement ([] (. window placements) placement-index))
    (let slot ([] slots slot-index))
    (let generation (+ (. slot generation) 1))
    (let target ([] targets slot-index))
    (= (. target address) (. placement address))
    (call (. target prepare) generation)
    (call (. live-source bind) (. placement address) generation target)
    (call (. target finish))
    (return-if false (if (or (not (. slot is-bound)) (!= (. slot generation) generation))))
    (blank)
    (call place-slot slot-index placement-index)
    (call record-slot-identity live-source slot-index (. placement address))
    (return true)
  )
  (fn-do _ depart _
    (param slot-index Index)
    (call (?. owner virtual-slot-departing) slot-index)
    (call (. ([] targets slot-index) deactivate))
    (let slot ([] slots slot-index))
    (+= (. slot generation) 1)
    (= (. slot is-bound) false)
    (= ([] slot-is-placed slot-index) false)
    (+= stat-departures 1)
  )
  (fn-do _ collect-free-slots _
    (call (. free-slots clear))
    (let slot-index Index)
    (while (< slot-index (. slots length))
      (if (not ([] slot-is-placed slot-index))
        (+= free-slots slot-index)
      )
      (+= slot-index 1)
    )
  )
  (fn-do _ bind-entering-placements _
    (param live-source (of VirtualSource Item))
    (let rebound-count Size)
    (let free-cursor Index)
    (let placement-index Index)
    (while (< placement-index (. window placement-count))
      (if ([] placement-retained placement-index)
        (+= rebound-count 1)
        (+= stat-source-binds 1)
        (+= stat-rebinds 1)
        (let retained ([] placement-slot-indexes placement-index))
        (if (not (call rebind-retained-slot live-source retained placement-index))
          (call depart retained)
          (= ([] placement-slot-indexes placement-index) (. Index max))
        )
        (else-if (call is-entering placement-index)
          (+= rebound-count 1)
          (+= stat-source-binds 1)
          (+= stat-rebinds 1)
          (let placement ([] (. window placements) placement-index))
          (if (< free-cursor (. free-slots length))
            (let slot-index ([] free-slots free-cursor))
            (let slot ([] slots slot-index))
            (let generation (+ (. slot generation) 1))
            (let target ([] targets slot-index))
            (= (. target address) (. placement address))
            (call (. target prepare) generation)
            (call (. live-source bind) (. placement address) generation target)
            (call (. target finish))
            (if (and (. slot is-bound) (== (. slot generation) generation))
              (call place-slot slot-index placement-index)
              (call record-slot-identity live-source slot-index (. placement address))
              (call (?. owner virtual-slot-arriving) slot-index)
              (+= free-cursor 1)
              (else
                (= (. slot generation) generation)
              )
            )
            (else
              (let initial-generation U64 1)
              (let initial-target (call (of VirtualInitialBindingTarget Item) this initial-generation))
              (call (. live-source bind) (. placement address) initial-generation initial-target)
              (call (. initial-target finish))
              (if (. initial-target did-commit)
                (let key (. initial-target key))
                (let item (. initial-target item))
                (let slot-index (call grow-pool (. placement address) key item initial-generation))
                (call place-slot slot-index placement-index)
                (call record-slot-identity live-source slot-index (. placement address))
              )
            )
          )
        )
      )
      (+= placement-index 1)
    )
    (return rebound-count)
  )
  (fn-expr _ is-entering _
    (param placement-index Index)
    (and (== ([] placement-slot-indexes placement-index) (. Index max)) ([] placement-required placement-index))
  )
  (fn-do _ place-slot _
    (param slot-index Index)
    (param placement-index Index)
    (= ([] slot-is-placed slot-index) true)
    (= ([] slot-placement-ids slot-index) (. ([] (. window placements) placement-index) placement-id))
    (= ([] placement-slot-indexes placement-index) slot-index)
  )
  (fn-do _ record-placed-slots _
    (call (. next-placed-slots clear))
    (let slot-index Index)
    (while (< slot-index (. slot-placement-indexes length))
      (= ([] slot-placement-indexes slot-index) (. Index max))
      (+= slot-index 1)
    )
    (let placement-index Index)
    (while (< placement-index (. window placement-count))
      (let placed ([] placement-slot-indexes placement-index))
      (if (!= placed (. Index max))
        (+= next-placed-slots placed)
        (= ([] slot-placement-indexes placed) placement-index)
      )
      (+= placement-index 1)
    )
    (let previous placed-slots)
    (= placed-slots next-placed-slots)
    (= next-placed-slots previous)
  )
  (fn-expr _ retains-beyond _
    (param required VirtualInsets)
    (or beyond-top beyond-right beyond-bottom beyond-left)
    (where
      (lazy beyond-top (> (. retention top) (call non-negative-virtual (. required top))))
      (lazy beyond-right (> (. retention right) (call non-negative-virtual (. required right))))
      (lazy beyond-bottom (> (. retention bottom) (call non-negative-virtual (. required bottom))))
      (lazy beyond-left (> (. retention left) (call non-negative-virtual (. required left))))
    )
  )
  (fn-expr _ retained-insets _
    (param required VirtualInsets)
    (call VirtualInsets
      (block
        (arg (call larger-virtual (. required top) (. retention top)))
        (arg (call larger-virtual (. required right) (. retention right)))
        (arg (call larger-virtual (. required bottom) (. retention bottom)))
        (arg (call larger-virtual (. required left) (. retention left)))
      )
    )
  )
  (fn-do _ mark-required-placements _
    (param retains Bool)
    (call (. placement-required clear))
    (let lead-x (call non-negative-virtual (. window overscan-left)))
    (let trail-x (call non-negative-virtual (. window overscan-right)))
    (let lead-y (call non-negative-virtual (. window overscan-top)))
    (let trail-y (call non-negative-virtual (. window overscan-bottom)))
    (let left (call non-negative-virtual (- (. window resolved-scroll-x) lead-x)))
    (let right (+ (. window resolved-scroll-x) (call non-negative-virtual (. window viewport-width)) trail-x))
    (let top (call non-negative-virtual (- (. window resolved-scroll-y) lead-y)))
    (let bottom (+ (. window resolved-scroll-y) (call non-negative-virtual (. window viewport-height)) trail-y))
    (let checks-x (and retains (or (> (. retention left) lead-x) (> (. retention right) trail-x))))
    (let checks-y (and retains (or (> (. retention top) lead-y) (> (. retention bottom) trail-y))))
    (let index Index)
    (while (< index (. window placement-count))
      (let placement ([] (. window placements) index))
      (let inside-x (or (not checks-x) (and (< (. placement x) right) (> (+ (. placement x) (. placement width)) left))))
      (let inside-y (or (not checks-y) (and (< (. placement y) bottom) (> (+ (. placement y) (. placement height)) top))))
      (+= placement-required (and inside-x inside-y))
      (+= index 1)
    )
  )
  (fn-do _ record-cover _
    (param domain VirtualSequenceDomain)
    (= has-cover false)
    (= cover-reaches-start false)
    (= cover-reaches-end false)
    (let count (. window placement-count))
    (let index Index)
    (while (< index count)
      (if ([] placement-required index)
        (if (not has-cover)
          (= cover-first index)
        )
        (= cover-last index)
        (= has-cover true)
      )
      (+= index 1)
    )
    (return-if (if (not has-cover)))
    (blank)
    (while (and (> cover-first 0) (!= ([] placement-slot-indexes (- cover-first 1)) (. Index max)))
      (-= cover-first 1)
    )
    (while (and (< (+ cover-last 1) count) (!= ([] placement-slot-indexes (+ cover-last 1)) (. Index max)))
      (+= cover-last 1)
    )
    (let first (call (. domain index-of) (. ([] (. window placements) cover-first) address)))
    (= cover-reaches-start (and (!= first null) (<= first 0vcoord)))
    (let last (call (. domain index-of) (. ([] (. window placements) cover-last) address)))
    (= cover-reaches-end (and (. domain is-final) (!= last null) (>= (+ last 1vcoord) (. domain known-count))))
  )
  (fn-do _ axis-holds Bool
    (param is-horizontal Bool)
    (param scroll VirtualCoord)
    (param viewport VirtualCoord)
    (param overscan VirtualSize)
    (param retained VirtualSize)
    (param extent VirtualExtent)
    (let lead (call non-negative-virtual (. overscan width)))
    (let trail (call non-negative-virtual (. overscan height)))
    (let window-start (call non-negative-virtual (- scroll lead)))
    (let window-end (+ scroll viewport trail))
    (let band-start (call non-negative-virtual (- scroll (call larger-virtual lead (. retained width)))))
    (let band-end (+ scroll viewport (call larger-virtual trail (. retained height))))
    (let cover-start (. VirtualCoord max))
    (let cover-end 0vcoord)
    (let min-end (. VirtualCoord max))
    (let max-start 0vcoord)
    (let index Index)
    (while (< index (. window placement-count))
      (let is-covered (and (>= index cover-first) (<= index cover-last)))
      (if (or is-covered (!= ([] placement-slot-indexes index) (. Index max)))
        (let placement ([] (. window placements) index))
        (let start (if-expr is-horizontal (. placement x) (. placement y)))
        (let end (+ start (if-expr is-horizontal (. placement width) (. placement height))))
        (= min-end (call smaller-virtual min-end end))
        (= max-start (call larger-virtual max-start start))
        (if is-covered
          (= cover-start (call smaller-virtual cover-start start))
          (= cover-end (call larger-virtual cover-end end))
        )
      )
      (+= index 1)
    )
    (let leading (or (<= cover-start window-start) (<= cover-start 0vcoord) cover-reaches-start))
    (let reaches-extent (and (. extent is-final) (>= cover-end (. extent known))))
    (let trailing (or (>= cover-end window-end) reaches-extent cover-reaches-end))
    (return (and (> min-end band-start) (< max-start band-end) leading trailing))
  )
  (fn-do _ grow-pool Index
    (param address I64)
    (param key VirtualKey)
    (param item Item)
    (param generation U64)
    (let index (. slots length))
    (+= slots (call (of VirtualSlot Item) address key item generation))
    (+= targets (call (of VirtualBindingRequestTarget Item) this index))
    (+= slot-is-placed false)
    (+= slot-placement-ids 0vcoord)
    (+= slot-placement-indexes (. Index max))
    (+= slot-identities 0u64)
    (+= slot-has-identity false)
    (+= slot-retained false)
    (+= stat-pool-created 1)
    (if (> (. slots length) stat-pool-high-water)
      (= stat-pool-high-water (. slots length))
    )
    (return index)
  )
  (fn-do + accept-binding _
    (param slot-index Index)
    (param address I64)
    (param key VirtualKey)
    (param item Item)
    (param generation U64)
    (let slot ([] slots slot-index))
    (= (. slot address) address)
    (= (. slot key) key)
    (= (. slot item) item)
    (= (. slot is-bound) true)
    (= (. slot generation) generation)
  )
  (fn-do + note-stale-commit _
    (+= stat-stale-commits 1)
  )
)

(type _ (of VirtualInitialBindingTarget Item)
  (implements (of VirtualBindingTarget Item))
  (prop _ owner (of VirtualBindingOwner Item))
  (prop _ request-generation U64)
  (prop _ is-accepting Bool (= true))
  (prop _ bound-key (? VirtualKey))
  (prop _ bound-item (? Item))
  (prop + did-commit Bool)
  (fn-do _ This _
    (param owner _)
    (param request-generation _)
  )
  (fn-expr + key _ :get
    (!! bound-key)
  )
  (fn-expr + item Item :get
    (!! bound-item)
  )
  (fn-do + finish _
    (= is-accepting false)
  )
  (fn-do + commit _
    (param key VirtualKey)
    (param item Item)
    (param generation U64)
    (if (and is-accepting (== generation request-generation))
      (= bound-key key)
      (= bound-item item)
      (= did-commit true)
      (else
        (call (. owner note-stale-commit))
      )
    )
  )
  (fn-do + fail _
    (param generation U64)
    (if (or (not is-accepting) (!= generation request-generation))
      (call (. owner note-stale-commit))
    )
  )
)

(type _ (of VirtualBindingRequestTarget Item)
  (implements (of VirtualBindingTarget Item))
  (prop _ owner (of VirtualBindingOwner Item))
  (prop _ slot-index Index)
  (prop + address I64)
  (prop _ request-generation U64)
  (prop _ is-accepting Bool)
  (fn-do _ This _
    (param owner _)
    (param slot-index _)
  )
  (fn-do + prepare _
    (param generation U64)
    (= request-generation generation)
    (= is-accepting true)
  )
  (fn-do + finish _
    (= is-accepting false)
  )
  (fn-do + deactivate _
    (= is-accepting false)
  )
  (fn-expr + accepts _
    (param generation U64)
    (and is-accepting (== generation request-generation))
  )
  (fn-do + commit _
    (param key VirtualKey)
    (param item Item)
    (param generation U64)
    (if (call accepts generation)
      (call (. owner accept-binding) slot-index address key item generation)
      (else
        (call (. owner note-stale-commit))
      )
    )
  )
  (fn-do + fail _
    (param generation U64)
    (if (not (call accepts generation))
      (call (. owner note-stale-commit))
    )
  )
)

(fn-expr _ non-negative-virtual _
  (param value VirtualCoord)
  (if-expr (> value 0vcoord) value 0vcoord)
)

(fn-expr _ larger-virtual _
  (param left VirtualCoord)
  (param right VirtualCoord)
  (if-expr (> left right) left right)
)

(fn-expr _ smaller-virtual _
  (param left VirtualCoord)
  (param right VirtualCoord)
  (if-expr (< left right) left right)
)
