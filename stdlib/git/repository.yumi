./command
/os/file
/os/path
/stream/sort

━━━━━━━━━━━━━━━━━━━━
+ GitWorktree is Tuple

+ path String
+ head String
+ branch String?
+ is-bare Bool
+ is-detached Bool
+ is-locked Bool
+ is-prunable Bool

━━━━━━━━━━━━━━━━━━━━
+ GitRepository is Tuple

+ path String
+ common-dir String
+ worktrees [GitWorktree]

+ main => worktrees[0]

━━━━━━━━━━━━━━━━━━━━
+ GitDirectories is Tuple

+ top String
+ git-dir String
+ common-dir String

━━━━━━━━━━━━━━━━━━━━
+ do git-open-repository ?! Error
    - folder String

. found = git-find-directories(folder)
. listed = git-read-worktrees(found.common-dir) if found
=? GitRepository(found!.top, found!.common-dir, listed) if listed != null
. output = git-text
    - folder
    - ["rev-parse", "--path-format=absolute", "--show-toplevel", "--git-common-dir"]
. lines = List'String(output.trim().split("\n"))
?! Error("Unexpected git rev-parse output")
    if lines.length != 2
= GitRepository(lines[0], lines[1], git-worktrees(lines[0]))

━━━━━━━━━━━━━━━━━━━━
+ do git-find-directories
    - folder String

. cursor = catch? Path(folder, 0).resolved
while cursor
    . marker = cursor / ".git"
    if marker.is-dir
        = git-directories-at(cursor, marker)
    if marker.is-file
        . linked = git-linked-directory(cursor, marker)
        = git-directories-at(cursor, linked) if linked
    cursor = cursor.parent
= null

━━━━━━━━━━━━━━━━━━━━
+ do git-read-worktrees
    - common-dir String

. common = Path(common-dir, 0)
=? if common.name != ".git" || (common / "reftable").exists
. top = common.parent
=? if !top
. admins = common / "worktrees"
. entries = catch? List'PathEntry(admins.entries)
. linked = List'GitWorktree()
for entry in entries ?? List'PathEntry()
    . found = git-linked-worktree(common, admins / entry.name)
    if found
        linked += found
. sorted = sort(linked) • using git-worktree-order
. main = git-worktree-at("${top}", common, common)
= List'GitWorktree
    * main
    ** sorted

━━━━━━━━━━━━━━━━━━━━
+ do git-worktrees ?! Error
    - directory String

= git-parse-worktrees(git-output(directory, ["worktree", "list", "--porcelain", "-z"]))

━━━━━━━━━━━━━━━━━━━━
+ do git-parse-worktrees ?! Error
    - bytes Byte[]

. worktrees = List'GitWorktree()
. record = List'String()
for field in git-fields(bytes)
    if field.length > 0
        record += field
    else if record.length > 0
        worktrees += git-worktree-from(record)
        record = List'String()
if record.length > 0
    worktrees += git-worktree-from(record)
= worktrees

━━━━━━━━━━━━━━━━━━━━
_ do git-worktree-from ?! Error
    - record [String]

. path = ""
. head = ""
. branch String?
. is-bare = false
. is-detached = false
. is-locked = false
. is-prunable = false
for field in record
    if field.starts-with("worktree ")
        path = field[9 ...]
    else if field.starts-with("HEAD ")
        head = field[5 ...]
    else if field.starts-with("branch ")
        branch = git-short-branch(field[7 ...])
    else if field == "bare"
        is-bare = true
    else if field == "detached"
        is-detached = true
    else if field == "locked" || field.starts-with("locked ")
        is-locked = true
    else if field == "prunable" || field.starts-with("prunable ")
        is-prunable = true
?! Error("Invalid Git worktree list")
    if path.length == 0
= GitWorktree(path, head, branch, is-bare, is-detached, is-locked, is-prunable)

━━━━━━━━━━━━━━━━━━━━
+ git-short-branch
    - ref String

if ref.starts-with("refs/heads/") then ref[11 ...] else ref

━━━━━━━━━━━━━━━━━━━━
_ git-worktree-order
    - left GitWorktree
    - right GitWorktree

|? left.path.lowercased < right.path.lowercased
    Comparison.lesser
|? left.path.lowercased > right.path.lowercased
    Comparison.greater
|? left.path < right.path
    Comparison.lesser
|? left.path > right.path
    Comparison.greater
??
    Comparison.equal

━━━━━━━━━━━━━━━━━━━━
_ do git-directories-at
    - top Path
    - git-dir Path

=? if !(git-dir / "HEAD").exists
. shared = git-read-file(git-dir / "commondir")
. common = if shared then git-relative-path(git-dir, shared.trim()) ?? git-dir else git-dir
=? if !common
= GitDirectories("$top", "$git-dir", "${common}")

━━━━━━━━━━━━━━━━━━━━
_ do git-linked-directory
    - top Path
    - marker Path

. text = git-read-file(marker)
=? if !text || !text.starts-with("gitdir: ")
= git-relative-path(top, text[8 ...].trim())

━━━━━━━━━━━━━━━━━━━━
_ do git-linked-worktree
    - common Path
    - admin Path

. target = git-read-file(admin / "gitdir")
=? if !target
. text = target.trim()
. marker = Path(text, 0)
if !text.starts-with("/")
    marker = git-relative-path(admin, text) ?? admin / text
. path = "$marker"
. is-locked = (admin / "locked").exists
. location = if path.ends-with("/.git") then path[0 .. < path.length - 5] else path
= git-worktree-at(location, common, admin, is-locked, !is-locked && !marker.exists)

━━━━━━━━━━━━━━━━━━━━
_ do git-worktree-at
    - path String
    - common Path
    - admin Path
    - is-locked = false
    - is-prunable = false

. head = (git-read-file(admin / "HEAD") ?? "").trim()
=? GitWorktree(path, head, null, false, true, is-locked, is-prunable) if !head.starts-with("ref: ")
. ref = head[5 ...]
= GitWorktree
    - path
    - git-resolve-ref(common, ref)
    - git-short-branch(ref)
    - false
    - false
    - is-locked
    - is-prunable

━━━━━━━━━━━━━━━━━━━━
_ do git-resolve-ref
    - common Path
    - ref String

. loose = git-read-file(common / ref)
=? loose.trim() if loose
. packed = git-read-file(common / "packed-refs")
=? "" if !packed
. suffix = " $ref"
for line in packed.split("\n")
    =? line[0 .. < line.length - suffix.length] if line.ends-with(suffix)
= ""

━━━━━━━━━━━━━━━━━━━━
_ do git-relative-path
    - base Path
    - text String

= catch? Path(if text.starts-with("/") then text else "$base/$text", 0).resolved

━━━━━━━━━━━━━━━━━━━━
_ do git-read-file
    - location Path

. input = catch? File'Byte(location)
=? if !input
use input
. bytes = input as Byte[]
= bytes.slice-string(0 .. < bytes.size)
