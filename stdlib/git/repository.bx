(import ./command)
(import /os/file)
(import /os/path)
(import /stream/sort)

(type + GitWorktree (is Tuple)
  (prop + path String)
  (prop + head String)
  (prop + branch (? String))
  (prop + is-bare Bool)
  (prop + is-detached Bool)
  (prop + is-locked Bool)
  (prop + is-prunable Bool)
)

(type + GitRepository (is Tuple)
  (prop + path String)
  (prop + common-dir String)
  (prop + worktrees (list GitWorktree))
  (blank)
  (prop + main _ (=> ([] worktrees 0)))
)

(type + GitDirectories (is Tuple)
  (prop + top String)
  (prop + git-dir String)
  (prop + common-dir String)
)

(fn-do + git-open-repository _ (?! Error)
  (param folder String)
  (let found (call git-find-directories folder))
  (let listed (only-if (call git-read-worktrees (. found common-dir)) (if found)))
  (return-if (call GitRepository (. (!! found) top) (. (!! found) common-dir) listed) (if (!= listed null)))
  (let output
    (call git-text
      (block
        (arg folder)
        (arg (list "rev-parse" "--path-format=absolute" "--show-toplevel" "--git-common-dir"))
      )
    )
  )
  (let lines (call (of List String) (call (. (call (. output trim)) split) "\n")))
  (throw (call Error "Unexpected git rev-parse output") (if (!= (. lines length) 2)))
  (return (call GitRepository ([] lines 0) ([] lines 1) (call git-worktrees ([] lines 0))))
)

(fn-do + git-find-directories _
  (param folder String)
  (let cursor (catch? (. (call Path folder 0) resolved)))
  (while cursor
    (let marker (/ cursor ".git"))
    (if (. marker is-dir)
      (return (call git-directories-at cursor marker))
    )
    (if (. marker is-file)
      (let linked (call git-linked-directory cursor marker))
      (return (only-if (call git-directories-at cursor linked) (if linked)))
    )
    (= cursor (. cursor parent))
  )
  (return null)
)

(fn-do + git-read-worktrees _
  (param common-dir String)
  (let common (call Path common-dir 0))
  (return-if (if (or (!= (. common name) ".git") (. (/ common "reftable") exists))))
  (let top (. common parent))
  (return-if (if (not top)))
  (let admins (/ common "worktrees"))
  (let entries (catch? (call (of List PathEntry) (. admins entries))))
  (let linked (call (of List GitWorktree)))
  (for (in entry (?? entries (call (of List PathEntry))))
    (let found (call git-linked-worktree common (/ admins (. entry name))))
    (if found
      (+= linked found)
    )
  )
  (let sorted (call sort linked (:using git-worktree-order)))
  (let main (call git-worktree-at (str top) common common))
  (return
    (call (of List GitWorktree)
      (block
        (item main)
        (spread sorted)
      )
    )
  )
)

(fn-do + git-worktrees _ (?! Error)
  (param directory String)
  (return (call git-parse-worktrees (call git-output directory (list "worktree" "list" "--porcelain" "-z"))))
)

(fn-do + git-parse-worktrees _ (?! Error)
  (param bytes ([] Byte))
  (let worktrees (call (of List GitWorktree)))
  (let record (call (of List String)))
  (for (in field (call git-fields bytes))
    (if (> (. field length) 0)
      (+= record field)
      (else-if (> (. record length) 0)
        (+= worktrees (call git-worktree-from record))
        (= record (call (of List String)))
      )
    )
  )
  (if (> (. record length) 0)
    (+= worktrees (call git-worktree-from record))
  )
  (return worktrees)
)

(fn-do _ git-worktree-from _ (?! Error)
  (param record (list String))
  (let path "")
  (let head "")
  (let branch (? String))
  (let is-bare false)
  (let is-detached false)
  (let is-locked false)
  (let is-prunable false)
  (for (in field record)
    (if (call (. field starts-with) "worktree ")
      (= path ([] field (... 9)))
      (else-if (call (. field starts-with) "HEAD ")
        (= head ([] field (... 5)))
      )
      (else-if (call (. field starts-with) "branch ")
        (= branch (call git-short-branch ([] field (... 7))))
      )
      (else-if (== field "bare")
        (= is-bare true)
      )
      (else-if (== field "detached")
        (= is-detached true)
      )
      (else-if (or (== field "locked") (call (. field starts-with) "locked "))
        (= is-locked true)
      )
      (else-if (or (== field "prunable") (call (. field starts-with) "prunable "))
        (= is-prunable true)
      )
    )
  )
  (throw (call Error "Invalid Git worktree list") (if (== (. path length) 0)))
  (return (call GitWorktree path head branch is-bare is-detached is-locked is-prunable))
)

(fn-expr + git-short-branch _
  (param ref String)
  (if-expr (call (. ref starts-with) "refs/heads/") ([] ref (... 11)) ref)
)

(fn-expr _ git-worktree-order _
  (param left GitWorktree)
  (param right GitWorktree)
  (case? (< (. left path lowercased) (. right path lowercased))
    (. Comparison lesser)
  )
  (case? (> (. left path lowercased) (. right path lowercased))
    (. Comparison greater)
  )
  (case? (< (. left path) (. right path))
    (. Comparison lesser)
  )
  (case? (> (. left path) (. right path))
    (. Comparison greater)
  )
  (default
    (. Comparison equal)
  )
)

(fn-do _ git-directories-at _
  (param top Path)
  (param git-dir Path)
  (return-if (if (not (. (/ git-dir "HEAD") exists))))
  (let shared (call git-read-file (/ git-dir "commondir")))
  (let common (if-expr shared (?? (call git-relative-path git-dir (call (. shared trim))) git-dir) git-dir))
  (return-if (if (not common)))
  (return (call GitDirectories (str top) (str git-dir) (str common)))
)

(fn-do _ git-linked-directory _
  (param top Path)
  (param marker Path)
  (let text (call git-read-file marker))
  (return-if (if (or (not text) (not (call (. text starts-with) "gitdir: ")))))
  (return (call git-relative-path top (call (. ([] text (... 8)) trim))))
)

(fn-do _ git-linked-worktree _
  (param common Path)
  (param admin Path)
  (let target (call git-read-file (/ admin "gitdir")))
  (return-if (if (not target)))
  (let text (call (. target trim)))
  (let marker (call Path text 0))
  (if (not (call (. text starts-with) "/"))
    (= marker (?? (call git-relative-path admin text) (/ admin text)))
  )
  (let path (str marker))
  (let is-locked (. (/ admin "locked") exists))
  (let location (if-expr (call (. path ends-with) "/.git") ([] path (..< 0 (- (. path length) 5))) path))
  (return (call git-worktree-at location common admin is-locked (and (not is-locked) (not (. marker exists)))))
)

(fn-do _ git-worktree-at _
  (param path String)
  (param common Path)
  (param admin Path)
  (param is-locked _ (= false))
  (param is-prunable _ (= false))
  (let head (call (. (?? (call git-read-file (/ admin "HEAD")) "") trim)))
  (return-if (call GitWorktree path head null false true is-locked is-prunable) (if (not (call (. head starts-with) "ref: "))))
  (let ref ([] head (... 5)))
  (return
    (call GitWorktree
      (block
        (arg path)
        (arg (call git-resolve-ref common ref))
        (arg (call git-short-branch ref))
        (arg false)
        (arg false)
        (arg is-locked)
        (arg is-prunable)
      )
    )
  )
)

(fn-do _ git-resolve-ref _
  (param common Path)
  (param ref String)
  (let loose (call git-read-file (/ common ref)))
  (return-if (call (. loose trim)) (if loose))
  (let packed (call git-read-file (/ common "packed-refs")))
  (return-if "" (if (not packed)))
  (let suffix (str " " ref))
  (for (in line (call (. packed split) "\n"))
    (return-if ([] line (..< 0 (- (. line length) (. suffix length)))) (if (call (. line ends-with) suffix)))
  )
  (return "")
)

(fn-do _ git-relative-path _
  (param base Path)
  (param text String)
  (return (catch? (. (call Path (if-expr (call (. text starts-with) "/") text (str base "/" text)) 0) resolved)))
)

(fn-do _ git-read-file _
  (param location Path)
  (let input (catch? (call (of File Byte) location)))
  (return-if (if (not input)))
  (use input)
  (let bytes (as input ([] Byte)))
  (return (call (. bytes slice-string) (..< 0 (. bytes size))))
)
