./command
./reader
/os/process

_ git-log-format = "--format=%H%x00%P%x00%an%x00%at%x00%s"

━━━━━━━━━━━━━━━━━━━━
+ GitCommit is Tuple

+ id String
+ parents [String]
+ author String
+ time I64
+ subject String

+ first-parent => if parents.length > 0 then parents[0] else ""
+ short-id => id[0 .. < 8]

━━━━━━━━━━━━━━━━━━━━
+ GitCommitDetails is Tuple

+ id String
+ parents [String]
+ author-name String
+ author-email String
+ author-time I64
+ author-date String
+ committer-name String
+ committer-email String
+ committer-time I64
+ committer-date String
+ message String

+ short-id => id[0 .. < 8]

────────────────────
+ get subject

git-message-subject(message)

────────────────────
+ do get body

. lines = List'String()
. is-subject = false
. is-body = false
for line in message.split("\n")
    if is-body
        lines += line
    else if line.trim().length > 0
        is-subject = true
    else if is-subject
        is-body = true
= ("\n".join(lines)).trim()

━━━━━━━━━━━━━━━━━━━━
+ do git-message-subject String
    - message String

. parts = List'String()
for line in message.split("\n")
    . text = line.trim()
    if text.length == 0 && parts.length > 0
        break
    if text.length > 0
        parts += text
= " ".join(parts)

━━━━━━━━━━━━━━━━━━━━
+ GitLogReader
    is Closable

+ process Process

_ reader GitReader

────────────────────
+ This ?! Error
    - directory String
    - revision String

.. process = git-process
    - directory
    - ["log", "--first-parent", "-z", git-log-format, "--end-of-options", revision, "--"]
.. reader = GitReader(process)

────────────────────
+ do next ?! Error
    - count Size

. commits = List'GitCommit()
while commits.length < count
    . id = reader.read-text(0)
    =? commits if id == null
    . parents = reader.require-text(0)
    . author = reader.require-text(0)
    . time = reader.require-text(0) as I64
    . subject = reader.require-text(0)
    commits += GitCommit(id, git-parents(parents), author, time, subject)
= commits

────────────────────
+ do close

process.terminate()
process.close()
process.wait(null)

━━━━━━━━━━━━━━━━━━━━
+ do git-log-commits ?! Error
    - directory String
    - revision String
    - limit Size

. reader = use GitLogReader(directory, revision)
= reader.next(limit)

━━━━━━━━━━━━━━━━━━━━
+ do git-ahead-ids ?! Error
    - directory String
    - base String
    - head String = "HEAD"

. output = git-text
    - directory
    - ["rev-list", "--first-parent", "--end-of-options", "$base..$head", "--"]
. ids = Map'String'Bool()
for line in output.split("\n")
    if line.length > 0
        ids[line] = true
= ids

━━━━━━━━━━━━━━━━━━━━
+ do git-commit-details ?! Error
    - directory String
    - id String
    - date-format = "%b %-d, %Y at %-I:%M %p"

. arguments = List'String
    * "log"
    * "-1"
    * "--date=format-local:${date-format}"
    * "--format=%H%x00%P%x00%an%x00%ae%x00%at%x00%ad%x00%cn%x00%ce%x00%ct%x00%cd%x00%B"
    * "--end-of-options"
    * id
    * "--"
. fields = git-fields(git-output(directory, arguments))
?! Error("Unable to read commit $id")
    if fields.length < 11
= GitCommitDetails
    - fields[0]
    - git-parents(fields[1])
    - fields[2]
    - fields[3]
    - fields[4] as I64
    - fields[5]
    - fields[6]
    - fields[7]
    - fields[8] as I64
    - fields[9]
    - fields[10].trim()

━━━━━━━━━━━━━━━━━━━━
+ do git-count-commits Size ?! Error
    - directory String
    - revision String

= git-text(directory, ["rev-list", "--count", "--end-of-options", revision, "--"]).trim() as Size

━━━━━━━━━━━━━━━━━━━━
+ do git-merge-base ?! Error
    - directory String
    - base String
    - head String = "HEAD"

= git-text(directory, ["merge-base", "--end-of-options", base, head]).trim()

━━━━━━━━━━━━━━━━━━━━
_ git-parents
    - field String

List'String
    ** field.split(" ")
    ?> each.length > 0
