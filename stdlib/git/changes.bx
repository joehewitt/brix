(import ./command)

(type + GitFileChange (is Tuple)
  (prop + old-mode String)
  (prop + new-mode String)
  (prop + old-id String)
  (prop + new-id String)
  (prop + status String)
  (prop + path String)
  (prop + old-path (? String) (= null))
)

(fn-do + git-changed-files _ (?! Error)
  (param directory String)
  (param base String)
  (param target String)
  (param index (? String) (= null))
  (let is-root (== (. base length) 0))
  (let arguments
    (call (of List String)
      (block
        (spread? (only-if (list "diff-tree" "--root" "--no-commit-id" "-r") (if is-root)))
        (item? (only-if "diff" (if (not is-root))))
        (spread (list "--raw" "-z" "--no-abbrev" "-M" "--no-ext-diff" "--no-textconv"))
        (item "--diff-filter=ADMR")
        (item "--end-of-options")
        (item? (only-if base (if (not is-root))))
        (item? (only-if target (if (> (. target length) 0))))
        (item "--")
      )
    )
  )
  (return (call git-parse-changes (call git-output directory arguments null index)))
)

(fn-do + git-parse-changes _ (?! Error)
  (param bytes ([] Byte))
  (let fields (call git-fields bytes))
  (let changes (call (of List GitFileChange)))
  (let index Index 0)
  (while (< index (. fields length))
    (let header (call (of List String) (call (. ([] fields index) split) " ")))
    (throw (call Error "Invalid Git raw output") (if (or (!= (. header length) 5) (not (call (. ([] header 0) starts-with) ":")) (== (. ([] header 4) length) 0))))
    (let status ([] ([] header 4) (..< 0 1)))
    (let paths Index (if-expr (or (== status "R") (== status "C")) 2 1))
    (throw (call Error "Incomplete Git raw output") (if (>= (+ index paths) (. fields length))))
    (let old-mode ([] ([] header 0) (... 1)))
    (let new-mode ([] header 1))
    (if (or (call git-is-regular-mode old-mode) (call git-is-regular-mode new-mode))
      (let old-path (only-if ([] fields (+ index 1)) (if (== paths 2))))
      (+= changes
        (call GitFileChange
          (block
            (arg old-mode)
            (arg new-mode)
            (arg ([] header 2))
            (arg ([] header 3))
            (arg status)
            (arg ([] fields (+ index paths)))
            (arg old-path)
          )
        )
      )
    )
    (+= index (+ paths 1))
  )
  (return changes)
)

(fn-expr + git-is-regular-mode _
  (param mode String)
  (or (== mode "100644") (== mode "100755"))
)
