./command
./reader
/os/process

━━━━━━━━━━━━━━━━━━━━
+ GitBlobReader
    is Closable

+ process Process

_ reader GitReader

────────────────────
+ This ?! Error
    - directory String

.. process = git-process(directory, ["cat-file", "--batch"])
.. reader = GitReader(process)

────────────────────
+ do read ?! Error
    - name String

process.write("$name\n")
. header = reader.require-text(10)
=? null if header.ends-with(" missing")
. fields = List'String(header.split(" "))
?! Error("Invalid Git object header: $header")
    if fields.length != 3 || fields[1] != "blob"
. output = reader.read-exact(fields[2] as Size)
?! Error("Invalid Git object terminator")
    if reader.read-byte() != 10
= output

────────────────────
+ do close

process.close()
process.wait(null)
