(import ./command)

(type + GitStatusKind (is Union)
  (variant changed)
  (variant renamed)
  (variant unmerged)
  (variant untracked)
)

(type + GitStatusEntry (is Tuple)
  (prop + kind GitStatusKind)
  (prop + path String)
  (prop + original-path (? String))
  (prop + staged String)
  (prop + unstaged String)
)

(type + GitStatus (is Tuple)
  (prop + head String)
  (prop + branch (? String))
  (prop + upstream (? String))
  (prop + ahead I64)
  (prop + behind I64)
  (prop + entries (list GitStatusEntry))
)

(fn-do + git-status _ (?! Error)
  (param directory String)
  (let output
    (call git-output
      (block
        (arg directory)
        (arg (list "status" "--porcelain=v2" "-z" "--branch" "--untracked-files=all"))
      )
    )
  )
  (return (call git-parse-status output))
)

(fn-do + git-ignored-paths _ (?! Error)
  (param directory String)
  (param paths (list String))
  (return-if (call (of List String)) (if (== (. paths length) 0)))
  (let input (call (. "\x00" join) (in each paths)))
  (let output (catch (call git-output directory (list "check-ignore" "-z" "--stdin") (str input "\x00"))))
  (if (is output Error)
    (let failure (as output Error))
    (return-if (call (of List String)) (if (and (is failure GitError) (== (. (as failure GitError) status) 1))))
    (throw failure)
  )
  (return (call git-fields output))
)

(fn-do + git-parse-status _ (?! Error)
  (param bytes ([] Byte))
  (let head "")
  (let branch (? String))
  (let upstream (? String))
  (let ahead I64)
  (let behind I64)
  (let entries (call (of List GitStatusEntry)))
  (let fields (call git-fields bytes))
  (let index Index 0)
  (while (< index (. fields length))
    (let field ([] fields index))
    (+= index 1)
    (if (call (. field starts-with) "# branch.oid ")
      (let oid ([] field (... 13)))
      (= head (if-expr (== oid "(initial)") "" oid))
      (else-if (call (. field starts-with) "# branch.head ")
        (let name ([] field (... 14)))
        (= branch (if-expr (== name "(detached)") null name))
      )
      (else-if (call (. field starts-with) "# branch.upstream ")
        (= upstream ([] field (... 18)))
      )
      (else-if (call (. field starts-with) "# branch.ab ")
        (let counts (call (of List String) (call (. ([] field (... 12)) split) " ")))
        (throw (call Error "Invalid Git status branch counts") (if (!= (. counts length) 2)))
        (= ahead (as ([] ([] counts 0) (... 1)) I64))
        (= behind (as ([] ([] counts 1) (... 1)) I64))
      )
      (else-if (call (. field starts-with) "1 ")
        (+= entries (call git-status-entry .changed field 8 null))
      )
      (else-if (call (. field starts-with) "2 ")
        (throw (call Error "Incomplete Git status rename") (if (>= index (. fields length))))
        (+= entries (call git-status-entry .renamed field 9 ([] fields index)))
        (+= index 1)
      )
      (else-if (call (. field starts-with) "u ")
        (+= entries (call git-status-entry .unmerged field 10 null))
      )
      (else-if (call (. field starts-with) "? ")
        (+= entries (call GitStatusEntry .untracked ([] field (... 2)) null "?" "?"))
      )
    )
  )
  (return (call GitStatus head branch upstream ahead behind entries))
)

(fn-do _ git-status-entry _ (?! Error)
  (param kind GitStatusKind)
  (param field String)
  (param spaces Size)
  (param original-path (? String))
  (let start Index 0)
  (for (in count (..< 0 spaces))
    (let found (call (. field find) " " start))
    (throw (call Error "Invalid Git status entry") (if (== found null)))
    (= start (+ found 1))
  )
  (return (call GitStatusEntry kind ([] field (... start)) original-path ([] field (..< 2 3)) ([] field (..< 3 4))))
)
