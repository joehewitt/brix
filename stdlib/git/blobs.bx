(import ./command)
(import ./reader)
(import /os/process)

(type + GitBlobReader
  (implements Closable)
  (prop + process Process)
  (blank)
  (prop _ reader GitReader)
  (fn-do + This _ (?! Error)
    (param directory String)
    (lazy process (call git-process directory (list "cat-file" "--batch")))
    (lazy reader (call GitReader process))
  )
  (fn-do + read _ (?! Error)
    (param name String)
    (call (. process write) (str name "\n"))
    (let header (call (. reader require-text) 10))
    (return-if null (if (call (. header ends-with) " missing")))
    (let fields (call (of List String) (call (. header split) " ")))
    (throw (call Error (str "Invalid Git object header: " header)) (if (or (!= (. fields length) 3) (!= ([] fields 1) "blob"))))
    (let output (call (. reader read-exact) (as ([] fields 2) Size)))
    (throw (call Error "Invalid Git object terminator") (if (!= (call (. reader read-byte)) 10)))
    (return output)
  )
  (fn-do + close _
    (call (. process close))
    (call (. process wait) null)
  )
)
