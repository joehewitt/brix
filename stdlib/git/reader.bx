(import /os/process)

(type + GitReader
  (prop + process Process)
  (blank)
  (prop _ buffer _ (= ([] Byte 65536)))
  (prop _ cursor Index)
  (prop _ length Size)
  (fn-do + This _
    (param process _)
  )
  (fn-do + read-bytes _
    (param terminator Byte)
    (let head (? ([] Byte)))
    (while true
      (if (and (== cursor length) (not (call refill)))
        (return head)
      )
      (let start cursor)
      (while (and (< cursor length) (!= ([] buffer cursor) terminator))
        (+= cursor 1)
      )
      (let piece (call joined start cursor head))
      (if (< cursor length)
        (+= cursor 1)
        (return piece)
      )
      (= head piece)
    )
  )
  (fn-do + read-text _
    (param terminator Byte)
    (let bytes (call read-bytes terminator))
    (return-if null (if (== bytes null)))
    (return (call (. bytes slice-string)))
  )
  (fn-do + require-text _ (?! Error)
    (param terminator Byte)
    (let text (call read-text terminator))
    (throw (call Error "Incomplete Git output") (if (== text null)))
    (return text)
  )
  (fn-do + read-byte _
    (return-if null (if (and (== cursor length) (not (call refill)))))
    (let byte ([] buffer cursor))
    (+= cursor 1)
    (return byte)
  )
  (fn-do + read-exact _ (?! Error)
    (param size Size)
    (let output ([] Byte size))
    (let offset Index 0)
    (while (< offset size)
      (if (< cursor length)
        (let count (- length cursor))
        (if (> count (- size offset))
          (= count (- size offset))
        )
        (= ([] output (..< offset (+ offset count))) ([] buffer (..< cursor (+ cursor count))))
        (+= cursor count)
        (+= offset count)
        (else
          (let count (call (. process read) (- size offset) ([] output (... offset))))
          (throw (call Error "Incomplete Git output") (if (== count 0)))
          (+= offset count)
        )
      )
    )
    (return output)
  )
  (fn-do + consume _ (?! Error)
    (param expected (of ImmutableArray Byte))
    (while (< (- length cursor) (. expected length))
      (throw (call Error "Incomplete Git output") (if (not (call append))))
    )
    (for (in index (..< 0 (. expected length)))
      (return-if false (if (!= ([] buffer (+ cursor index)) ([] expected index))))
    )
    (+= cursor (. expected length))
    (return true)
  )
  (fn-do _ refill _
    (= length (call (. process read) (. buffer length) buffer))
    (= cursor 0)
    (return (> length 0))
  )
  (fn-do _ append _
    (if (> cursor 0)
      (let remaining (- length cursor))
      (for (in index (..< 0 remaining))
        (= ([] buffer index) ([] buffer (+ cursor index)))
      )
      (= length remaining)
      (= cursor 0)
    )
    (let count (call (. process read) (- (. buffer length) length) ([] buffer (... length))))
    (+= length count)
    (return (> count 0))
  )
  (fn-do _ joined _
    (param start Index)
    (param end Index)
    (param head (? ([] Byte)))
    (let prefix (?? (?. head length) 0))
    (let output ([] Byte (- (+ prefix end) start)))
    (if (!= head null)
      (= ([] output (..< 0 prefix)) head)
    )
    (= ([] output (... prefix)) ([] buffer (..< start end)))
    (return output)
  )
)
