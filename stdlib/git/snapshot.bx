(import ./command)
(import ./stats)
(import ./untracked)
(import /os/file)
(import /os/path)

(fn-do + git-snapshot String (?! Error)
  (param directory String)
  (let made (call temporary-directory "git-snapshot"))
  (let target (str (as made String) "/index"))
  (let tree (catch (call git-snapshot-tree directory target)))
  (catch (call (. (call Path target 0) delete)))
  (catch (call (. made delete)))
  (throw (as tree Error) (if (is tree Error)))
  (return (as tree String))
)

(fn-do _ git-snapshot-tree String (?! Error)
  (param directory String)
  (param target String)
  (call git-copy-index directory target)
  (let added (call git-output directory (list "add" "-A" "--" ".") null target))
  (return (call (. (call (. (call git-output directory (list "write-tree") null target) slice-string)) trim)))
)

(fn-do + git-tree-line-counts GitLineCounts (?! Error)
  (param directory String)
  (param before String)
  (param after String)
  (let output
    (call git-output
      (block
        (arg directory)
        (arg (list "diff" "--raw" "--numstat" "-z" "-M" "--end-of-options" before after "--"))
      )
    )
  )
  (return (call git-parse-line-counts output))
)
