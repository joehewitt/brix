./command

━━━━━━━━━━━━━━━━━━━━
+ do git-remotes [String] ?! Error
    - directory String

= List'String
    ** git-text(directory, ["remote"]).split("\n")
    ?> each.length > 0

━━━━━━━━━━━━━━━━━━━━
+ do git-fetch ?! Error
    - directory String
    - remote String
    - ref String

. fetched = git-output(directory, ["fetch", "--quiet", "--end-of-options", remote, ref])

━━━━━━━━━━━━━━━━━━━━
+ do git-push ?! Error
    - directory String
    - remote String
    - refspec String

. pushed = git-output(directory, ["push", "--quiet", "--end-of-options", remote, refspec])
