(import ./command)
(import ./repository)
(import ./status)
(import /os/file)
(import /os/path)

(type + GitMergeResult (is Union)
  (variant merged)
  (variant conflicted (tuple (: paths (list String))))
)

(fn-do + git-merge GitMergeResult (?! Error)
  (param directory String)
  (param revision String)
  (let merged
    (block
      (catch (call git-output directory (list "merge" "--no-edit" "--quiet" "--end-of-options" revision)))
    )
  )
  (return-if (. GitMergeResult merged) (if (not (is merged Error))))
  (let paths (call git-unmerged-paths directory))
  (throw (as merged Error) (if (== (. paths length) 0)))
  (return (call (. GitMergeResult conflicted) paths))
)

(fn-do + git-fast-forward _ (?! Error)
  (param directory String)
  (param revision String)
  (let moved (call git-output directory (list "merge" "--ff-only" "--quiet" "--end-of-options" revision)))
)

(fn-do + git-unmerged-paths (list String) (?! Error)
  (param directory String)
  (return (call git-fields (call git-output directory (list "diff" "--name-only" "--diff-filter=U" "-z"))))
)

(fn-do + git-pending-operation (? String) (?! Error)
  (param directory String)
  (let found (call git-find-directories directory))
  (throw (call Error (str directory " is not in a Git worktree")) (if (not found)))
  (let folder (call Path (. found git-dir) 0))
  (return-if "merge" (if (. (/ folder "MERGE_HEAD") exists)))
  (return-if "rebase" (if (or (. (/ folder "rebase-merge") exists) (. (/ folder "rebase-apply") exists))))
  (return-if "cherry-pick" (if (. (/ folder "CHERRY_PICK_HEAD") exists)))
  (return-if "revert" (if (. (/ folder "REVERT_HEAD") exists)))
  (return null)
)

(fn-do + git-unresolved-paths (list String)
  (param directory String)
  (param status GitStatus)
  (let found (call (of List String)))
  (for (in entry (. status entries))
    (if (and is-unmerged (call git-has-conflict-markers (call Path (str directory "/" (. entry path)) 0)))
      (+= found (. entry path))
    )
    (lazy is-unmerged (== (. entry kind) (. GitStatusKind unmerged)))
  )
  (return found)
)

(fn-do _ git-has-conflict-markers Bool
  (param path Path)
  (let text (catch? (call read-file-text path)))
  (return-if false (if (not text)))
  (return (or (call (. text starts-with) "<<<<<<< ") (!= (call (. text find) "\n<<<<<<< ") null)))
)
