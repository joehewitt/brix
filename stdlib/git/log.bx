(import ./command)
(import ./reader)
(import /os/process)
(blank)
(prop _ git-log-format _ (= "--format=%H%x00%P%x00%an%x00%at%x00%s"))

(type + GitCommit (is Tuple)
  (prop + id String)
  (prop + parents (list String))
  (prop + author String)
  (prop + time I64)
  (prop + subject String)
  (blank)
  (prop + first-parent _ (=> (if-expr (> (. parents length) 0) ([] parents 0) "")))
  (prop + short-id _ (=> ([] id (..< 0 8))))
)

(type + GitCommitDetails (is Tuple)
  (prop + id String)
  (prop + parents (list String))
  (prop + author-name String)
  (prop + author-email String)
  (prop + author-time I64)
  (prop + author-date String)
  (prop + committer-name String)
  (prop + committer-email String)
  (prop + committer-time I64)
  (prop + committer-date String)
  (prop + message String)
  (blank)
  (prop + short-id _ (=> ([] id (..< 0 8))))
  (fn-expr + subject _ :get
    (call git-message-subject message)
  )
  (fn-do + body _ :get
    (let lines (call (of List String)))
    (let is-subject false)
    (let is-body false)
    (for (in line (call (. message split) "\n"))
      (if is-body
        (+= lines line)
        (else-if (> (. (call (. line trim)) length) 0)
          (= is-subject true)
        )
        (else-if is-subject
          (= is-body true)
        )
      )
    )
    (return (call (. (call (. "\n" join) lines) trim)))
  )
)

(fn-do + git-message-subject String
  (param message String)
  (let parts (call (of List String)))
  (for (in line (call (. message split) "\n"))
    (let text (call (. line trim)))
    (if (and (== (. text length) 0) (> (. parts length) 0))
      (break)
    )
    (if (> (. text length) 0)
      (+= parts text)
    )
  )
  (return (call (. " " join) parts))
)

(type + GitLogReader
  (implements Closable)
  (prop + process Process)
  (blank)
  (prop _ reader GitReader)
  (fn-do + This _ (?! Error)
    (param directory String)
    (param revision String)
    (param follows-merges _ (= false))
    (lazy process
      (call git-process
        (block
          (arg directory)
          (arg (list "log" order "-z" git-log-format "--end-of-options" revision "--"))
        )
      )
    )
    (lazy order (if-expr follows-merges "--topo-order" "--first-parent"))
    (lazy reader (call GitReader process))
  )
  (fn-do + next _ (?! Error)
    (param count Size)
    (let commits (call (of List GitCommit)))
    (while (< (. commits length) count)
      (let id (call (. reader read-text) 0))
      (return-if commits (if (== id null)))
      (let parents (call (. reader require-text) 0))
      (let author (call (. reader require-text) 0))
      (let time (as (call (. reader require-text) 0) I64))
      (let subject (call (. reader require-text) 0))
      (+= commits (call GitCommit id (call git-parents parents) author time subject))
    )
    (return commits)
  )
  (fn-do + close _
    (call (. process terminate))
    (call (. process close))
    (call (. process wait) null)
  )
)

(fn-do + git-log-commits _ (?! Error)
  (param directory String)
  (param revision String)
  (param limit Size)
  (let reader (use (call GitLogReader directory revision)))
  (return (call (. reader next) limit))
)

(fn-do + git-ahead-ids _ (?! Error)
  (param directory String)
  (param base String)
  (param head String (= "HEAD"))
  (let output
    (call git-text
      (block
        (arg directory)
        (arg (list "rev-list" "--first-parent" "--end-of-options" (str base ".." head) "--"))
      )
    )
  )
  (let ids (call (of Map String Bool)))
  (for (in line (call (. output split) "\n"))
    (if (> (. line length) 0)
      (= ([] ids line) true)
    )
  )
  (return ids)
)

(fn-do + git-commit-details _ (?! Error)
  (param directory String)
  (param id String)
  (param date-format _ (= "%b %-d, %Y at %-I:%M %p"))
  (let arguments
    (call (of List String)
      (block
        (item "log")
        (item "-1")
        (item (str "--date=format-local:" date-format))
        (item "--format=%H%x00%P%x00%an%x00%ae%x00%at%x00%ad%x00%cn%x00%ce%x00%ct%x00%cd%x00%B")
        (item "--end-of-options")
        (item id)
        (item "--")
      )
    )
  )
  (let fields (call git-fields (call git-output directory arguments)))
  (throw (call Error (str "Unable to read commit " id)) (if (< (. fields length) 11)))
  (return
    (call GitCommitDetails
      (block
        (arg ([] fields 0))
        (arg (call git-parents ([] fields 1)))
        (arg ([] fields 2))
        (arg ([] fields 3))
        (arg (as ([] fields 4) I64))
        (arg ([] fields 5))
        (arg ([] fields 6))
        (arg ([] fields 7))
        (arg (as ([] fields 8) I64))
        (arg ([] fields 9))
        (arg (call (. ([] fields 10) trim)))
      )
    )
  )
)

(fn-do + git-count-commits Size (?! Error)
  (param directory String)
  (param revision String)
  (return (as (call (. (call git-text directory (list "rev-list" "--count" "--end-of-options" revision "--")) trim)) Size))
)

(fn-do + git-merge-base _ (?! Error)
  (param directory String)
  (param base String)
  (param head String (= "HEAD"))
  (return (call (. (call git-text directory (list "merge-base" "--end-of-options" base head)) trim)))
)

(fn-expr _ git-parents _
  (param field String)
  (call (of List String)
    (block
      (spread (call (. field split) " "))
      (pipe ?> (> (. each length) 0))
    )
  )
)
