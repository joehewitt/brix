./command
./status
/os/file
/os/path

_ git-empty-blob = "e69de29bb2d1d6434b8b29ae775ad8c2e48c5391"

━━━━━━━━━━━━━━━━━━━━
+ GitUntrackedIndex
    is Closable

+ path String?

_ folder Path?

────────────────────
+ This ?! Error
    - directory String
    - status GitStatus

. lines = List'String
    ** status.entries
    ?> each.kind == GitStatusKind.untracked
    *> "100644 $git-empty-blob\t${each.path}\0"
=? if lines.length == 0
. made = temporary-directory("git-index")
folder = made
. target = "${made as String}/index"
. prepared = catch git-prepare-index(directory, target, "".join(lines))
if prepared is Error
    close()
    ?! prepared as Error
path = target

────────────────────
+ do close

. made = folder
folder = null
path = null
=? if made == null
catch Path("${made as String}/index", 0).delete()
catch made.delete()

━━━━━━━━━━━━━━━━━━━━
_ do git-prepare-index ?! Error
    - directory String
    - target String
    - lines String

git-copy-index(directory, target)
. updated = git-output
    - directory
    - ["update-index", "-z", "--add", "--info-only", "--index-info"]
    - lines
    - target
= true

━━━━━━━━━━━━━━━━━━━━
+ do git-copy-index ?! Error
    - directory String
    - target String

. source = git-text(directory, ["rev-parse", "--git-path", "index"]).trim()
. current = Path(if source.starts-with("/") then source else "$directory/$source", 0)
=? if !current.exists
. input = use File'Byte(current)
. bytes = input as Byte[]
. mode = FileFlags.write-mode + FileFlags.create-mode + FileFlags.truncate-mode
. output = use File(target, mode)
. ignored = output.write(bytes, bytes.length)
