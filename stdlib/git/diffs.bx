(import ./blobs)
(import ./changes)
(import ./command)
(import ./log)
(import ./status)
(import ./untracked)
(import /os/file)
(blank)
(prop + git-null-id _ (= "0000000000000000000000000000000000000000"))

(type + GitChangeSet (is Tuple)
  (prop + directory String)
  (prop + changes (list GitFileChange))
  (prop + reads-worktree Bool)
)

(fn-do + git-commit-changes _ (?! Error)
  (param directory String)
  (param commit GitCommit)
  (return (call GitChangeSet directory (call git-changed-files directory (. commit first-parent) (. commit id)) false))
)

(fn-do + git-worktree-changes _ (?! Error)
  (param directory String)
  (param since (? String) (= null))
  (let status (call git-status directory))
  (let base (?? since (if-expr (> (. status head length) 0) (. status head) git-empty-tree)))
  (return (call GitChangeSet directory (call git-worktree-file-changes directory status base) true))
)

(fn-do + git-worktree-file-changes _ (?! Error)
  (param directory String)
  (param status GitStatus)
  (param base String)
  (let untracked (call (of Map String Bool)))
  (for (in entry (. status entries))
    (if (== (. entry kind) (. GitStatusKind untracked))
      (= ([] untracked (. entry path)) true)
    )
  )
  (let index (use (call GitUntrackedIndex directory status)))
  (let changes (call git-changed-files directory base "" (. index path)))
  (return
    (call (of List GitFileChange)
      (block
        (spread changes)
        (pipe *>
          (block
            (case? (and (== (. each status) "A") (has untracked (. each path)))
              (call GitFileChange (. each old-mode) (. each new-mode) (. each old-id) (. each new-id) "?" (. each path))
            )
            (default
              each
            )
          )
        )
      )
    )
  )
)

(type + GitChangeBytes (is Tuple)
  (prop + old ([] Byte))
  (prop + new ([] Byte))
)

(fn-do + git-change-bytes GitChangeBytes (?! Error)
  (param set GitChangeSet)
  (param change GitFileChange)
  (param blobs GitBlobReader)
  (let old (call git-object-bytes blobs (. change old-id) (. change old-mode)))
  (let new
    (block
      (case? (. set reads-worktree)
        (call git-worktree-bytes (. set directory) (. change path) (. change new-mode))
      )
      (default
        (call git-object-bytes blobs (. change new-id) (. change new-mode))
      )
    )
  )
  (return (call GitChangeBytes old new))
)

(fn-do + git-worktree-bytes ([] Byte) (?! Error)
  (param directory String)
  (param path String)
  (param mode String (= "100644"))
  (return-if (call (of Array Byte)) (if (not (call git-is-regular-mode mode))))
  (let input (use (call (of File Byte) (str directory "/" path))))
  (let bytes ([] Byte) input)
  (return bytes)
)

(fn-do _ git-object-bytes _ (?! Error)
  (param blobs GitBlobReader)
  (param id String)
  (param mode String)
  (return-if (call (of Array Byte)) (if (or (not (call git-is-regular-mode mode)) (== id git-null-id))))
  (return (?? (call (. blobs read) id) (call (of Array Byte))))
)
