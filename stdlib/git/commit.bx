(import ./command)

(fn-do + git-resolve (? String) (?! Error)
  (param directory String)
  (param revision String)
  (let output (catch (call git-text directory (list "rev-parse" "--verify" "--quiet" "--end-of-options" revision))))
  (if (is output Error)
    (let failure (as output Error))
    (return-if null (if (and (is failure GitError) (== (. (as failure GitError) status) 1))))
    (throw failure)
  )
  (return (call (. (as output String) trim)))
)

(fn-do + git-commit-all String (?! Error)
  (param directory String)
  (param message String)
  (let staged (call git-output directory (list "add" "-A")))
  (let committed (call git-output directory (list "commit" "--quiet" "-F" "-") message))
  (return (call (. (call git-text directory (list "rev-parse" "HEAD")) trim)))
)

(fn-do + git-commit-tree String (?! Error)
  (param directory String)
  (param tree String)
  (param parents (list String))
  (param message String)
  (let arguments
    (call (of List String)
      (block
        (item "commit-tree")
        (item tree)
      )
    )
  )
  (for (in parent parents)
    (+= arguments "-p")
    (+= arguments parent)
  )
  (+= arguments "-F")
  (+= arguments "-")
  (return (call (. (call git-text directory arguments message) trim)))
)

(fn-do + git-is-ancestor Bool (?! Error)
  (param directory String)
  (param ancestor String)
  (param descendant String)
  (let checked (catch (call git-output directory (list "merge-base" "--is-ancestor" "--end-of-options" ancestor descendant))))
  (if (is checked Error)
    (let failure (as checked Error))
    (return-if false (if (and (is failure GitError) (== (. (as failure GitError) status) 1))))
    (throw failure)
  )
  (return true)
)

(fn-do + git-reset-keep _ (?! Error)
  (param directory String)
  (param commit String)
  (let reset (call git-output directory (list "reset" "--keep" "--quiet" commit)))
)

(fn-do + git-restore _ (?! Error)
  (param directory String)
  (param source String)
  (param paths (list String))
  (let arguments
    (call (of List String)
      (block
        (item "restore")
        (item (str "--source=" source))
        (item "--staged")
        (item "--worktree")
        (item "--")
        (spread paths)
      )
    )
  )
  (let restored (call git-output directory arguments))
)
