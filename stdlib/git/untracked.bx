(import ./command)
(import ./status)
(import /os/file)
(import /os/path)
(blank)
(prop _ git-empty-blob _ (= "e69de29bb2d1d6434b8b29ae775ad8c2e48c5391"))

(type + GitUntrackedIndex
  (implements Closable)
  (prop + path (? String))
  (blank)
  (prop _ folder (? Path))
  (fn-do + This _ (?! Error)
    (param directory String)
    (param status GitStatus)
    (let lines
      (call (of List String)
        (block
          (spread (. status entries))
          (pipe ?> (== (. each kind) (. GitStatusKind untracked)))
          (pipe *> (str "100644 " git-empty-blob "\t" (. each path) "\x00"))
        )
      )
    )
    (return-if (if (== (. lines length) 0)))
    (blank)
    (let made (call temporary-directory "git-index"))
    (= folder made)
    (let target (str (as made String) "/index"))
    (let prepared (catch (call git-prepare-index directory target (call (. "" join) lines))))
    (if (is prepared Error)
      (call close)
      (throw (as prepared Error))
    )
    (= path target)
  )
  (fn-do + close _
    (let made folder)
    (= folder null)
    (= path null)
    (return-if (if (== made null)))
    (blank)
    (catch (call (. (call Path (str (as made String) "/index") 0) delete)))
    (catch (call (. made delete)))
  )
)

(fn-do _ git-prepare-index _ (?! Error)
  (param directory String)
  (param target String)
  (param lines String)
  (call git-copy-index directory target)
  (let updated
    (call git-output
      (block
        (arg directory)
        (arg (list "update-index" "-z" "--add" "--info-only" "--index-info"))
        (arg lines)
        (arg target)
      )
    )
  )
  (return true)
)

(fn-do + git-copy-index _ (?! Error)
  (param directory String)
  (param target String)
  (let source (call (. (call git-text directory (list "rev-parse" "--git-path" "index")) trim)))
  (let current (call Path (if-expr (call (. source starts-with) "/") source (str directory "/" source)) 0))
  (return-if (if (not (. current exists))))
  (blank)
  (let input (use (call (of File Byte) current)))
  (let bytes (as input ([] Byte)))
  (let mode (+ (. FileFlags write-mode) (. FileFlags create-mode) (. FileFlags truncate-mode)))
  (let output (use (call File target mode)))
  (let ignored (call (. output write) bytes (. bytes length)))
)
