(import /core/tokenstream)
(import /os/env)
(import /os/process)
(blank)
(prop + git-empty-tree _ (= "4b825dc642cb6eb9a060e54bf8d69288fbee4904"))
(blank)
(prop _ git-blocked-variables _ (= (list "GIT_DIR" "GIT_WORK_TREE" "GIT_INDEX_FILE" "GIT_COMMON_DIR")))

(type + GitError (is Error)
  (prop + arguments (list String))
  (prop + status Int)
  (prop + errors String)
  (fn-do + This _
    (param arguments _)
    (param status _)
    (param errors _)
    (= message (call git-error-message arguments status errors))
  )
)

(fn-expr _ git-error-message _
  (param arguments (list String))
  (param status Int)
  (param errors String)
  (if-expr (> (. detail length) 0) detail (str "git " (call (. " " join) arguments) " exited with status " status))
  (where
    (lazy detail (call (. errors trim)))
  )
)

(fn-do + git-process _ (?! Error)
  (param directory String)
  (param arguments (list String))
  (param stderr-mode _ (= (. ProcessStderr discard)))
  (param index (? String) (= null))
  (let full
    (call (of List String)
      (block
        (item "-c")
        (item "core.quotepath=off")
        (spread arguments)
      )
    )
  )
  (return (call Process "git" stderr-mode full directory (call git-variables index)))
)

(fn-do + git-output _ (?! Error)
  (param directory String)
  (param arguments (list String))
  (param input (? String) (= null))
  (param index (? String) (= null))
  (let process (use (call git-process directory arguments (. ProcessStderr capture) index)))
  (let errors (!! (. process stderr)))
  (let drained (call (of Semaphore String)))
  (let drainer
    (do-new
      (let text (as errors String))
      (call (. drained post) text)
    )
  )
  (finally
    (inline (call (. drainer cancel)))
  )
  (let fed (call (of Semaphore Void)))
  (let feeder
    (do-new
      (if (!= input null)
        (catch (call (. process write) input))
      )
      (call (. process close-input))
      (call (. fed post))
    )
  )
  (finally
    (inline (call (. feeder cancel)))
  )
  (let output (call (. (call (of ChunkedTokenStream Byte) process) read)))
  (let status (?? (call (. process wait) null) -1))
  (call (. fed wait))
  (let message (?? (call (. drained await)) ""))
  (throw (call GitError arguments status message) (if (!= status 0)))
  (return output)
)

(fn-do + git-text _ (?! Error)
  (param directory String)
  (param arguments (list String))
  (param input (? String) (= null))
  (return (call (. (call git-output directory arguments input) slice-string)))
)

(fn-do + git-fields _
  (param bytes ([] Byte))
  (let fields (call (of List String)))
  (let start Index 0)
  (for (in index (..< 0 (. bytes length)))
    (if (== ([] bytes index) 0)
      (+= fields (call (. bytes slice-string) (..< start index)))
      (= start (+ index 1))
    )
  )
  (if (< start (. bytes length))
    (+= fields (call (. bytes slice-string) (... start)))
  )
  (return fields)
)

(fn-do _ git-variables _
  (param index (? String))
  (let variables (call environment))
  (for (in name git-blocked-variables)
    (-= ([] variables name))
  )
  (if index
    (= ([] variables "GIT_INDEX_FILE") index)
  )
  (= ([] variables "GIT_TERMINAL_PROMPT") "0")
  (= ([] variables "GIT_OPTIONAL_LOCKS") "0")
  (return variables)
)
