(import ./command)

(fn-do + git-remotes (list String) (?! Error)
  (param directory String)
  (return
    (call (of List String)
      (block
        (spread (call (. (call git-text directory (list "remote")) split) "\n"))
        (pipe ?> (> (. each length) 0))
      )
    )
  )
)

(fn-do + git-fetch _ (?! Error)
  (param directory String)
  (param remote String)
  (param ref String)
  (let fetched (call git-output directory (list "fetch" "--quiet" "--end-of-options" remote ref)))
)

(fn-do + git-push _ (?! Error)
  (param directory String)
  (param remote String)
  (param refspec String)
  (let pushed (call git-output directory (list "push" "--quiet" "--end-of-options" remote refspec)))
)
