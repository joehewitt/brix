(import ./command)
(import ./repository)
(import ./status)
(import /os/path)
(import /time/debounced)
(import /time/duration)
(blank)
(prop + git-watch-delay _ (= 200ms))

(type + GitWorktreeChanges (is Tuple)
  (prop + paths (list String))
  (prop + ignored-paths (list String))
  (prop + is-git-changed Bool)
  (prop + are-worktrees-changed Bool)
  (prop + must-rescan Bool)
  (blank)
  (prop + is-relevant _ (=> (or must-rescan is-git-changed are-worktrees-changed (> (. paths length) 0))))
  (fn-expr + touches _
    (param path String)
    (or must-rescan (is-in path paths) (is-in path ignored-paths))
  )
)

(type + GitWorktreeWatch
  (implements Closable)
  (prop + directory String)
  (prop + git-dir String)
  (prop + common-dir String)
  (prop + ignored (list String))
  (event + changed GitWorktreeChanges)
  (blank)
  (prop _ streams (of List Closable))
  (prop _ paths (of Map String Bool))
  (prop _ is-git-changed _ (= false))
  (prop _ are-worktrees-changed _ (= false))
  (prop _ must-rescan _ (= false))
  (prop _ schedule-flush _ (:= (call throttled git-watch-delay (. this flush))))
  (prop _ is-closed _ (= false))
  (fn-do + This _
    (param directory _)
    (param git-dir _)
    (param common-dir _)
    (call watch directory)
    (if (== (call git-watch-inner common-dir directory) null)
      (call watch common-dir)
    )
  )
  (fn-do + refresh-ignored _
    (let listed (catch (call git-worktrees directory)))
    (return-if (if (is listed Error)))
    (blank)
    (let nested (call (of List String)))
    (for (in worktree (as listed (list GitWorktree)))
      (let real (call git-watch-real (. worktree path)))
      (if (and (!= real directory) (!= (call git-watch-inner real directory) null))
        (+= nested real)
      )
    )
    (= ignored nested)
  )
  (fn-do + close _
    (= is-closed true)
    (for (in stream streams)
      (call (. stream close))
    )
    (= streams (call (of List Closable)))
  )
  (fn-do _ watch _
    (param root String)
    (let stream (call (. (call Path root 0) watch) true))
    (for (on event stream)
      (call note event)
    )
    (+= streams stream)
  )
  (fn-do _ note _
    (param event PathWatchEvent)
    (return-if (if is-closed))
    (blank)
    (if (. event must-rescan)
      (= must-rescan true)
      (call schedule-flush)
      (return)
    )
    (let text (str (. event path)))
    (let inner (call git-watch-inner text common-dir))
    (if (!= inner null)
      (call note-git inner)
      (return)
    )
    (let relative (call git-watch-inner text directory))
    (return-if (if (or (== relative null) (== relative "") (== relative ".git"))))
    (blank)
    (for (in nested ignored)
      (return-if (if (!= (call git-watch-inner text nested) null)))
    )
    (= ([] paths relative) true)
    (call schedule-flush)
  )
  (fn-do _ note-git _
    (param inner String)
    (return-if (if (call git-watch-is-noise inner)))
    (blank)
    (let own (?? (call git-watch-inner git-dir common-dir) ""))
    (if (== inner "worktrees")
      (call note-worktrees)
      (return)
    )
    (if (call (. inner starts-with) "worktrees/")
      (let rest ([] inner (... 10)))
      (let slash (call (. rest find) "/"))
      (if (== slash null)
        (call note-worktrees)
        (return)
      )
      (return-if (if (!= (str "worktrees/" ([] rest (..< 0 slash))) own)))
      (return-if (if (call git-watch-is-under ([] rest (... (+ slash 1))) "logs")))
      (else-if (and (!= own "") (== inner "index"))
        (return)
      )
    )
    (= is-git-changed true)
    (call schedule-flush)
  )
  (fn-do _ note-worktrees _
    (= are-worktrees-changed true)
    (do-new
      (inline (call refresh-ignored))
    )
    (call schedule-flush)
  )
  (fn-do _ flush _
    (return-if (if is-closed))
    (blank)
    (let touched (call (of List String) (. paths keys)))
    (let git is-git-changed)
    (let worktrees are-worktrees-changed)
    (let rescan must-rescan)
    (= paths (call (of Map String Bool)))
    (= is-git-changed false)
    (= are-worktrees-changed false)
    (= must-rescan false)
    (let listed (catch (call git-ignored-paths directory touched)))
    (return-if (if is-closed))
    (blank)
    (let skipped (call (of Map String Bool)))
    (if (not (is listed Error))
      (for (in path (as listed (list String)))
        (= ([] skipped path) true)
      )
    )
    (let kept
      (call (of List String)
        (block
          (spread touched)
          (pipe ?> (not (has skipped each)))
        )
      )
    )
    (let dropped
      (call (of List String)
        (block
          (spread touched)
          (pipe ?> (has skipped each))
        )
      )
    )
    (<- changed (call GitWorktreeChanges kept dropped git worktrees rescan))
  )
)

(fn-do + git-watch-worktree _ (?! Error)
  (param directory String)
  (let found (call git-find-directories directory))
  (let watch
    (block
      (case? found
        (call GitWorktreeWatch
          (block
            (arg (call git-watch-real directory))
            (arg (call git-watch-real (. found git-dir)))
            (arg (call git-watch-real (. found common-dir)))
          )
        )
      )
      (default
        (call git-watch-asked directory)
      )
    )
  )
  (call (. watch refresh-ignored))
  (return watch)
)

(fn-do _ git-watch-asked _ (?! Error)
  (param directory String)
  (let output
    (call git-text
      (block
        (arg directory)
        (arg (list "rev-parse" "--path-format=absolute" "--git-dir" "--git-common-dir"))
      )
    )
  )
  (let lines (call (of List String) (call (. (call (. output trim)) split) "\n")))
  (throw (call Error "Unexpected git rev-parse output") (if (!= (. lines length) 2)))
  (return (call GitWorktreeWatch (call git-watch-real directory) (call git-watch-real ([] lines 0)) (call git-watch-real ([] lines 1))))
)

(fn-do _ git-watch-real _
  (param text String)
  (let path (call Path text 0))
  (let resolved (?? (catch? (. path resolved)) path))
  (return (str resolved))
)

(fn-expr _ git-watch-inner _
  (param text String)
  (param root String)
  (case? (== text root)
    ""
  )
  (case? (call (. text starts-with) (str root "/"))
    ([] text (... (+ (. root length) 1)))
  )
  (default
    null
  )
)

(fn-expr _ git-watch-is-under _
  (param text String)
  (param name String)
  (or (== text name) (call (. text starts-with) (str name "/")))
)

(fn-expr _ git-watch-is-noise _
  (param inner String)
  (or (call (. inner ends-with) ".lock") is-objects is-logs)
  (where
    (lazy is-objects (call git-watch-is-under inner "objects"))
    (lazy is-logs (call git-watch-is-under inner "logs"))
  )
)
