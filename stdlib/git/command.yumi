+ git-empty-tree = "4b825dc642cb6eb9a060e54bf8d69288fbee4904"

_ git-blocked-variables = ["GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE", "GIT_COMMON_DIR"]

━━━━━━━━━━━━━━━━━━━━
+ GitError is Error

+ arguments [String]
+ status Int
