(import ./commands)
(import ./options)
(import ./query)
(import /os/cli)
(import /probes/supervise)
(import /time/duration)
(blank)

(main
  (call request-process-termination (call (. (call ProbesTool) run)))
)

(type _ ProbesTool (is CommandLine)
  (content
    (<> This
      (= name "brix probes")
      (= about "Query the probe trace of a run. A run is recorded each time a program runs with `brix x.bx -o out --probes` or `brix probes run`. A trace is the last run's by default, or a .trace file or .run.json record from .tmp/build/probes/.")
      (blank)
      (<> Subcommand (text: "summary")
        (= about "records, groups by time, counters and the busiest sites")
        (= action (=> () (call summary (call query (list (!! (. summary-trace value)))))))
        (blank)
        (<> Argument (id: summary-trace) (text: "trace")
          (= default "last")
        )
      )
      (blank)
      (<> Subcommand (text: "sites")
        (= about "each probe site with its fields, location and record count")
        (= action (=> () (call sites (call query (list (!! (. sites-trace value)))) (. sites-all value))))
        (blank)
        (<> Argument (id: sites-trace) (text: "trace")
          (= default "last")
        )
        (<> Flag (id: sites-all) (text: "--all")
          (= about "also list the sites that wrote no records")
        )
      )
      (blank)
      (<> Subcommand (text: "log")
        (= about "records in order, filtered")
        (= action (=> () (call log (call query (list (!! (. log-trace value)))))))
        (blank)
        (<> Argument (id: log-trace) (text: "trace")
          (= default "last")
        )
      )
      (blank)
      (<> Subcommand (text: "around")
        (= about "records around a record index (120) or a time (1.5s)")
        (= action (=> () (call around (call query (list (!! (. around-target value)) (!! (. around-trace value)))) (. around-context value))))
        (blank)
        (<> Argument (id: around-target) (text: "index|time")
          (= required true)
        )
        (<> Argument (id: around-trace) (text: "trace")
          (= default "last")
        )
        (<> (of Option Size) (id: around-context) (text: "--context")
          (= value-name "N")
          (= about "records shown on each side (10 by default)")
        )
      )
      (blank)
      (<> Subcommand (text: "agg")
        (= about "statistics of a field, such as agg --field ms p50,p95,max --by frame")
        (= action (=> () (call agg (call query (. agg-operands values)) (call split-list (. agg-stats value)) (. agg-field value) (. agg-by value))))
        (blank)
        (<> Arguments (id: agg-operands) (text: "stats|trace")
          (= about "statistics joined by commas, or the trace")
        )
        (<> Option (id: agg-field) (text: "--field")
          (= value-name "NAME")
          (= about "the field to aggregate")
        )
        (<> Option (id: agg-by) (text: "--by")
          (= value-name "NAME")
          (= about "group the statistics by a field")
        )
        (<> Option (id: agg-stats) (text: "--stats")
          (= value-name "STATS")
          (= about "count, sum, min, max, mean, median or pNN, joined by commas")
          (= parser (=> (text) (only-if text (if (call is-stat-list text)))))
        )
      )
      (blank)
      (<> Subcommand (text: "durations")
        (= about "group times by group: count, total, mean, p50, p95, max")
        (= action (=> () (call durations (call query (list (!! (. durations-trace value)))))))
        (blank)
        (<> Argument (id: durations-trace) (text: "trace")
          (= default "last")
        )
      )
      (blank)
      (<> Subcommand (text: "tree")
        (= about "nested group time as a tree with total and self time")
        (= action (=> () (call tree (call query (list (!! (. tree-trace value)))) (. tree-depth value))))
        (blank)
        (<> Argument (id: tree-trace) (text: "trace")
          (= default "last")
        )
        (<> (of Option Size) (id: tree-depth) (text: "--depth")
          (= value-name "N")
          (= about "the deepest groups shown")
        )
      )
      (blank)
      (<> Subcommand (text: "counters")
        (= about "counter values and profile metrics")
        (= action (=> () (call counters (call query (list (!! (. counters-trace value)))))))
        (blank)
        (<> Argument (id: counters-trace) (text: "trace")
          (= default "last")
        )
      )
      (blank)
      (<> Subcommand (text: "timeline")
        (= about "records per bucket as sparklines; with --field, a statistic of it")
        (= action (=> () (call timeline (call query (list (!! (. timeline-trace value)))) (call split-list (. timeline-stats value)) (. timeline-bucket value) (. timeline-field value))))
        (blank)
        (<> Argument (id: timeline-trace) (text: "trace")
          (= default "last")
        )
        (<> (of Option U64) (id: timeline-bucket) (text: "--bucket")
          (= value-name "D")
          (= about "the time each column covers, such as 10ms")
          (= parser (=> (text) (call duration-of text)))
        )
        (<> Option (id: timeline-field) (text: "--field")
          (= value-name "NAME")
          (= about "chart a statistic of this field in place of the record count")
        )
        (<> Option (id: timeline-stats) (text: "--stats")
          (= value-name "STAT")
          (= about "the statistic charted: count, sum, min, max, mean, median or pNN")
          (= parser (=> (text) (only-if text (if (call is-stat-list text)))))
        )
      )
      (blank)
      (<> Subcommand (text: "outliers")
        (= about "slowest groups, or largest values of a field, against the median")
        (= action (=> () (call outliers (call query (list (!! (. outliers-trace value)))) (. outliers-field value) (. outliers-context value))))
        (blank)
        (<> Argument (id: outliers-trace) (text: "trace")
          (= default "last")
        )
        (<> Option (id: outliers-field) (text: "--field")
          (= value-name "NAME")
          (= about "rank records by this field in place of group time")
        )
        (<> (of Option Size) (id: outliers-context) (text: "--context")
          (= value-name "N")
          (= about "records shown around each outlier")
        )
      )
      (blank)
      (<> Subcommand (text: "diff")
        (= about "changes in records per site, group times and counters")
        (= action (=> () (call diff (call query (list (!! (. diff-old value)) (!! (. diff-new value)))) (. diff-all value))))
        (blank)
        (<> Argument (id: diff-old) (text: "a")
          (= required true)
        )
        (<> Argument (id: diff-new) (text: "b")
          (= required true)
        )
        (<> Flag (id: diff-all) (text: "--all")
          (= about "also list what did not change")
        )
      )
      (blank)
      (<> Subcommand (text: "run")
        (= about "run a program built with --probes and record its trace: run -- program [args]")
        (= action (=> () (call run-program (. run-command values) (. run-quiet value) (. run-timeout value) (. run-trace value))))
        (blank)
        (<> Arguments (id: run-command) (text: "command")
          (= required true)
        )
        (<> (of Option Seconds) (id: run-timeout) (text: "--timeout")
          (= value-name "D")
          (= about "stop the program after D (500ms, 30s, 2m), then kill it after a grace period")
          (= parser (=> (text) (call parse-timeout text)))
        )
        (<> Option (id: run-trace) (text: "--trace")
          (= value-name "PATH")
          (= about "where to write the trace; .tmp/build/probes/ by default")
        )
        (<> Flag (id: run-quiet) (text: "--quiet")
          (= about "show only the footer, not each probe line")
        )
      )
      (blank)
      (<> OptionGroup (text: "filters")
        (<> Options (id: keys) (text: "--key")
          (= value-name "K[,K]")
          (= about "key globs (gui.*, *.frame); a plain key also matches keys inside it")
        )
        (<> Options (id: wheres) (text: "--where")
          (= value-name "EXPR")
          (= about "comparisons of fields joined by &&: 'ms > 4 && frame < 10'; also duration, time, depth, index, key, label, text, location")
        )
        (<> Options (id: texts) (text: "--text")
          (= value-name "S")
          (= about "the record's text contains S")
        )
        (<> Options (id: sources) (text: "--source")
          (= value-name "F[:L]")
          (= about "records written at a file, or a file and line")
        )
        (<> (of Option U64) (id: since) (text: "--since")
          (= value-name "D")
          (= about "time from the first record: 250us, 100ms, 1.5s")
          (= parser (=> (text) (call duration-of text)))
        )
        (<> (of Option U64) (id: until) (text: "--until")
          (= value-name "D")
          (= about "time from the first record")
          (= parser (=> (text) (call duration-of text)))
        )
        (<> Options (id: kinds) (text: "--kind")
          (= value-name "K[,K]")
          (= about "log, event, group, begin, end, system, or open for groups that never ended")
        )
      )
      (blank)
      (<> OptionGroup (text: "output")
        (<> (of Option Size) (id: limit) (text: "--limit")
          (= value-name "N")
          (= about "page through results; text output is capped and says how to see more")
        )
        (<> (of Option Size) (id: offset) (text: "--offset")
          (= value-name "N")
        )
        (<> Option (id: format) (text: "--format")
          (= choices (list "text" "json" "jsonl"))
          (= default "text")
          (= about "machine-readable output")
        )
        (<> Option (id: catalog) (text: "--catalog")
          (= value-name "PATH")
          (= about "the catalog that names fields; found next to the trace by default")
        )
      )
    )
  )
  (fn-do _ query ProbeQuery (?! UsageError)
    (param positionals (list String))
    (let made (call ProbeQuery))
    (= (. made positionals) positionals)
    (= (. made catalog) (. catalog value))
    (= (. made output format) (!! (. format value)))
    (= (. made output limit) (. limit value))
    (= (. made output offset) (?? (. offset value) 0))
    (= (. made filter earliest) (. since value))
    (= (. made filter latest) (. until value))
    (for (in text (. texts values))
      (+= (. made filter texts) text)
    )
    (for (in list (. keys values))
      (for (in key (call split-list list))
        (+= (. made filter keys) key)
      )
    )
    (for (in list (. sources values))
      (for (in source (call split-list list))
        (+= (. made filter sources) source)
      )
    )
    (for (in list (. kinds values))
      (call (. made filter add-kinds) list
        (block
          (on-error (: error Error)
            (throw (call UsageError (. error message) this))
          )
        )
      )
    )
    (for (in clause (. wheres values))
      (call (. made filter add-where) clause
        (block
          (on-error (: error Error)
            (throw (call UsageError (. error message) this))
          )
        )
      )
    )
    (return made)
  )
)
