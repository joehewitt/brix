(import ./model)
(import /probes/console)
(import /probes/model)
(import /probes/trace)
(import /stream/aggregate)
(blank)
(type-line _ Clause (is (tuple (: field String) (: operator String) (: value String))))

(type + Datum (is Union)
  (variant number F64)
  (variant text String)
)

(type + RowFilter
  (prop + keys (list String))
  (prop + texts (list String))
  (prop + sources (list String))
  (prop + kinds (list TraceRowKind))
  (prop + earliest (? U64))
  (prop + latest (? U64))
  (prop + is-open-only _ (= false))
  (blank)
  (prop _ clauses (list Clause))
  (fn-do + add-where _ (?! Error)
    (param text String)
    (for (in clause (call parse-clauses text))
      (+= clauses clause)
    )
  )
  (fn-do + add-kinds _ (?! Error)
    (param text String)
    (for (in name (call (. text split) ","))
      (match (call (. name trim))
        (case= "log"
          (+= kinds (. TraceRowKind log))
        )
        (case= "event"
          (+= kinds (. TraceRowKind event))
        )
        (case= "group"
          (+= kinds (. TraceRowKind begin))
          (+= kinds (. TraceRowKind end))
        )
        (case= "begin"
          (+= kinds (. TraceRowKind begin))
        )
        (case= "end"
          (+= kinds (. TraceRowKind end))
        )
        (case= "open"
          (+= kinds (. TraceRowKind begin))
          (= is-open-only true)
        )
        (case= "system"
          (+= kinds (. TraceRowKind system))
        )
        (throw (call Error (str "Unknown --kind " (call (. name trim)) " (use log, event, group, begin, end, open or system)")))
      )
    )
  )
  (fn-do + accepts Bool
    (param row TraceRow)
    (return-if false (if (and (!= (. kinds length) 0) (not (has kinds (. row kind))))))
    (return-if false (if (and is-open-only (or (!= (. row kind) (. TraceRowKind begin)) (!= (. row duration) null)))))
    (return-if false (if (and earliest (< (. row time) earliest))))
    (return-if false (if (and latest (> (. row time) latest))))
    (return-if false (if (and (!= (. keys length) 0) (not (call matches-key row)))))
    (return-if false (if (and (!= (. sources length) 0) (not (call matches-source row)))))
    (for (in text texts)
      (return-if false (if (== (call (. row text find) text) null)))
    )
    (return (call all clauses (:where (call clause-holds each row))))
  )
  (fn-do _ matches-key Bool
    (param row TraceRow)
    (let name (if-expr (!= (. row key) "") (. row key) (. row label)))
    (for (in pattern keys)
      (return-if true (if (call glob-matches pattern name)))
      (return-if true (if (and (not (call (. pattern find) "*")) (not (call (. pattern find) "?")) (call (. name starts-with) (str pattern ".")))))
    )
    (return false)
  )
  (fn-do _ matches-source Bool
    (param row TraceRow)
    (for (in wanted sources)
      (let colon (call (. wanted find-reverse) ":"))
      (let file wanted)
      (let line (? U32) null)
      (if colon
        (let number (call parse-number ([] wanted (... (+ colon 1)))))
        (if number
          (= file ([] wanted (..< 0 colon)))
          (= line (as number U32))
        )
      )
      (let place (if-expr (!= (. row path) "") (. row path) (. row location)))
      (let named (or (== place file) (call (. place ends-with) (str "/" file)) (call (. row location starts-with) (str file ":"))))
      (if (and named (or (not line) (== line (. row line))))
        (return true)
      )
    )
    (return false)
  )
)

(fn-expr + parse-duration (? U64) (?! Error)
  (param text String)
  (before
    (throw (call Error (str "Invalid duration: " text " (use a number with ns, us, ms, s or m)")) (if (not nanoseconds)))
  )
  nanoseconds
  (where
    (lazy nanoseconds (call duration-of text))
  )
)

(fn-do + duration-of (? U64)
  (param text String)
  (let scale 1000000000.0)
  (let cut Size 0)
  (if (call (. text ends-with) "ns")
    (= scale 1.0)
    (= cut 2)
    (else-if (or (call (. text ends-with) "us") (call (. text ends-with) "µs"))
      (= scale 1000.0)
      (= cut 2)
    )
    (else-if (call (. text ends-with) "ms")
      (= scale 1000000.0)
      (= cut 2)
    )
    (else-if (call (. text ends-with) "s")
      (= cut 1)
    )
    (else-if (call (. text ends-with) "m")
      (= scale 60000000000.0)
      (= cut 1)
    )
  )
  (let value (call parse-number ([] text (..< 0 (- (. text length) cut)))))
  (return-if null (if (or (not value) (< value 0.0))))
  (return (as (* value scale) U64))
)

(fn-do + parse-number (? F64)
  (param text String)
  (return-if null (if (== (. text length) 0)))
  (let dots 0)
  (let digits 0)
  (let first true)
  (for (in char text)
    (let leading first)
    (= first false)
    (if (== char '.')
      (+= dots 1)
      (else-if (and (== char '-') leading)
        (continue)
      )
      (else-if (or (< char '0') (> char '9'))
        (return null)
      )
      (else
        (+= digits 1)
      )
    )
  )
  (return-if null (if (or (> dots 1) (== digits 0))))
  (return (as text F64))
)

(fn-expr + parse-quantity (? F64)
  (param text String)
  (case? number
    number
  )
  (case? (and (not (call (. text ends-with) "s")) (not (call (. text ends-with) "m")))
    null
  )
  (case? (not nanoseconds)
    null
  )
  (default
    (as nanoseconds F64)
  )
  (where
    (lazy number (call parse-number text))
    (lazy nanoseconds (catch? (call parse-duration text)))
  )
)

(fn-do + glob-matches Bool
  (param pattern String)
  (param text String)
  (return-if true (if (== pattern "*")))
  (let wanted (call chars pattern))
  (let given (call chars text))
  (let cursor 0)
  (let matched 0)
  (let star (? Size) null)
  (let resume 0)
  (while (< matched (. given length))
    (if (and (< cursor (. wanted length)) (or (== ([] wanted cursor) '?') (== ([] wanted cursor) ([] given matched))))
      (+= cursor 1)
      (+= matched 1)
      (else-if (and (< cursor (. wanted length)) (== ([] wanted cursor) '*'))
        (= star cursor)
        (= resume matched)
        (+= cursor 1)
      )
      (else-if star
        (= cursor (+ star 1))
        (+= resume 1)
        (= matched resume)
      )
      (else
        (return false)
      )
    )
  )
  (while (and (< cursor (. wanted length)) (== ([] wanted cursor) '*'))
    (+= cursor 1)
  )
  (return (== cursor (. wanted length)))
)

(fn-do + field-datum (? Datum)
  (param row TraceRow)
  (param name String)
  (match? name
    (case= "duration"
      (return-if (call (. Datum number) (as (. row duration) F64)) (if (. row duration)))
      (return null)
    )
    (case= "time"
      (return (call (. Datum number) (as (. row time) F64)))
    )
    (case= "depth"
      (return (call (. Datum number) (as (. row depth) F64)))
    )
    (case= "index"
      (return (call (. Datum number) (as (. row index) F64)))
    )
    (case= "key"
      (return (call (. Datum text) (. row key)))
    )
    (case= "label"
      (return (call (. Datum text) (. row label)))
    )
    (case= "text"
      (return (call (. Datum text) (. row text)))
    )
    (case= "location"
      (return (call (. Datum text) (. row location)))
    )
    (case= "owner"
      (return (call (. Datum text) (. row owner)))
    )
  )
  (let found (call (. row value) name))
  (return-if null (if (not found)))
  (return (call value-datum found))
)

(fn-do + value-datum Datum
  (param value TraceValue)
  (match? value
    (case (call .truth truth)
      (return (call (. Datum number) (if-expr truth 1.0 0.0)))
    )
    (case (call .integer integer)
      (return (call (. Datum number) (as integer F64)))
    )
    (case (call .unsigned unsigned)
      (return (call (. Datum number) (as unsigned F64)))
    )
    (case (call .real real)
      (return (call (. Datum number) real))
    )
    (case (call .text text)
      (let number (call parse-number text))
      (return-if (call (. Datum number) number) (if number))
      (return (call (. Datum text) text))
    )
  )
  (return (call (. Datum text) (call value-text value (call (of Map U16 String)))))
)

(fn-do + datum-number (? F64)
  (param datum (? Datum))
  (return-if null (if (not datum)))
  (match? datum
    (case (call .number number)
      (return number)
    )
  )
  (return null)
)

(fn-do + datum-text String
  (param datum (? Datum))
  (return-if "" (if (not datum)))
  (match? datum
    (case (call .number number)
      (return (call number-text number))
    )
    (case (call .text text)
      (return text)
    )
  )
  (return "")
)

(fn-do + number-text String
  (param value F64)
  (let negative (< value 0.0))
  (let magnitude (if-expr negative (- value) value))
  (let scaled (as (+ (* magnitude 1000.0) 0.5) U64))
  (let whole (/ scaled 1000))
  (let fraction (% scaled 1000))
  (let sign (if-expr (and negative (!= scaled 0)) "-" ""))
  (return-if (str sign whole) (if (== fraction 0)))
  (let padded (str (+ fraction 1000)))
  (let digits ([] padded (... 1)))
  (while (call (. digits ends-with) "0")
    (= digits ([] digits (..< 0 (- (. digits length) 1))))
  )
  (return (str sign whole "." digits))
)

(fn-do + split-list (list String)
  (param text (? String))
  (let items (list String))
  (return-if items (if (not text)))
  (for (in part (call (. text split) ","))
    (let trimmed (call (. part trim)))
    (if (!= trimmed "")
      (+= items trimmed)
    )
  )
  (return items)
)

(fn-expr _ chars (list Char)
  (param text String)
  (in each text)
)

(fn-do _ parse-clauses (list Clause) (?! Error)
  (param text String)
  (let clauses (list Clause))
  (for (in part (call (. text split) "&&"))
    (for (in piece (call (. part split) " and "))
      (let trimmed (call (. piece trim)))
      (if (!= trimmed "")
        (+= clauses (call parse-clause trimmed))
      )
    )
  )
  (return clauses)
)

(fn-do _ parse-clause Clause (?! Error)
  (param text String)
  (for (in operator (list "==" "!=" "<=" ">=" "~" "<" ">" "="))
    (let cursor (call (. text find) operator))
    (if cursor
      (let field (call (. ([] text (..< 0 cursor)) trim)))
      (let value (call unquoted (call (. ([] text (... (+ cursor (. operator length)))) trim))))
      (throw (call Error (str "Invalid --where clause: " text " (use field op value, such as ms > 4)")) (if (or (== field "") (== value ""))))
      (return (call Clause field (if-expr (== operator "=") "==" operator) value))
    )
  )
  (throw (call Error (str "Invalid --where clause: " text " (use field op value, where op is ==, !=, <, <=, >, >= or ~)")))
)

(fn-expr _ unquoted String
  (param text String)
  (case? (and (>= (. text length) 2) (or (and (call (. text starts-with) "\"") (call (. text ends-with) "\"")) is-single-quoted))
    ([] text (..< 1 (- (. text length) 1)))
  )
  (default
    text
  )
  (where
    (lazy is-single-quoted (and (call (. text starts-with) "'") (call (. text ends-with) "'")))
  )
)

(fn-do _ clause-holds Bool
  (param clause Clause)
  (param row TraceRow)
  (let datum (call field-datum row (. clause field)))
  (return-if false (if (not datum)))
  (let left (call datum-number datum))
  (let right (call parse-quantity (. clause value)))
  (if (and left right)
    (let a left)
    (let b right)
    (match? (. clause operator)
      (case= "=="
        (return (== a b))
      )
      (case= "!="
        (return (!= a b))
      )
      (case= "<"
        (return (< a b))
      )
      (case= "<="
        (return (<= a b))
      )
      (case= ">"
        (return (> a b))
      )
      (case= ">="
        (return (>= a b))
      )
    )
  )
  (let text (call datum-text datum))
  (match? (. clause operator)
    (case= "=="
      (return (== text (. clause value)))
    )
    (case= "!="
      (return (!= text (. clause value)))
    )
    (case= "~"
      (return (!= (call (. text find) (. clause value)) null))
    )
    (case= "<"
      (return (< text (. clause value)))
    )
    (case= "<="
      (return (<= text (. clause value)))
    )
    (case= ">"
      (return (> text (. clause value)))
    )
    (case= ">="
      (return (>= text (. clause value)))
    )
  )
  (return false)
)
