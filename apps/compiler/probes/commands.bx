(import ./analysis)
(import ./model)
(import ./options)
(import ./output)
(import ./query)
(import ./stats)
(import /data/json)
(import /os/file)
(import /os/path)
(import /probes/console)
(import /probes/model)
(import /probes/supervise)
(import /probes/trace)
(import /stream/aggregate)
(import /stream/sort)
(import /time/duration)
(blank)
(prop _ default-stats (list String) (= (list "count" "min" "mean" "p50" "p95" "max")))

(fn-do _ open-trace ProbeTrace (?! Error)
  (param options ProbeQuery)
  (param position Size (= 0))
  (return (call load-trace (call (. options trace-name) position) (. options catalog)))
)

(fn-do + summary Int (?! Error)
  (param options ProbeQuery)
  (let trace (call open-trace options))
  (let out (. options output))
  (let logs 0)
  (let events 0)
  (let groups 0)
  (let systems 0)
  (let snapshots (. trace snapshots))
  (let busy (map U16 Size))
  (for (in row (. trace rows))
    (match (. row kind)
      (case= .log
        (+= logs 1)
        (= ([] busy (. row site-id)) (+ (?? ([] busy (. row site-id)) 0) 1))
      )
      (case= .event
        (+= events 1)
        (= ([] busy (. row site-id)) (+ (?? ([] busy (. row site-id)) 0) 1))
      )
      (case= .begin
        (+= groups 1)
      )
      (case= .system
        (+= systems 1)
      )
      (default
        (continue)
      )
    )
  )
  (let summaries (call group-summaries trace (. options filter)))
  (let ranked (call sort (. busy keys) (:using (=> (a b) (if-expr (> (!! ([] busy a)) (!! ([] busy b))) .lesser .greater)))))
  (let warnings (call trace-warnings trace))
  (if (not (. out is-text))
    (let record
      (call (of Map String JSON)
        (block
          (entry "trace" (as (. trace source trace) JSON))
          (entry "program" (as (. trace source program) JSON))
        )
      )
    )
    (if (. trace source status)
      (= ([] record "status") (as (. trace source status) Int))
    )
    (= ([] record "timed_out") (. trace source timed-out))
    (= ([] record "closed") (. trace is-closed))
    (= ([] record "span_ns") (as (. trace span) Int))
    (= ([] record "records") (as (. trace rows length) Int))
    (= ([] record "logs") (as logs Int))
    (= ([] record "events") (as events Int))
    (= ([] record "groups") (as groups Int))
    (let grouped (list JSON))
    (for (in item summaries)
      (+= grouped (call group-json item))
    )
    (= ([] record "group_totals") grouped)
    (let sited (list JSON))
    (for (in id ranked)
      (+= sited (call site-json trace (!! ([] (. trace sites) id)) (!! ([] busy id))))
    )
    (= ([] record "sites") sited)
    (= ([] record "counters") (call counters-json trace))
    (let warned (list JSON))
    (for (in warning warnings)
      (+= warned warning)
    )
    (= ([] record "warnings") warned)
    (call (. out value) record)
    (return 0)
  )
  (let outcome "")
  (if (. trace source timed-out)
    (= outcome " · timed out")
    (else-if (. trace source status)
      (= outcome (str " · exit " (. trace source status)))
    )
  )
  (call (. out line) (str "trace    " (. trace source trace) outcome))
  (if (!= (. trace source program) "")
    (call (. out line) (str "program  " (. trace source program)))
  )
  (let kinds (list String))
  (+= kinds (str (call count-text (as logs U64)) " logs"))
  (if (!= events 0)
    (+= kinds (str (call count-text (as events U64)) " events"))
  )
  (if (!= groups 0)
    (+= kinds (str (call count-text (as groups U64)) " groups"))
  )
  (if (!= systems 0)
    (+= kinds (str (call count-text (as systems U64)) " system logs"))
  )
  (if (!= snapshots 0)
    (+= kinds (str (call count-text (as snapshots U64)) " snapshots"))
  )
  (call (. out line) (str "records  " record-count " over " (call duration-text (. trace span)) ": " (call (. ", " join) kinds))
    (block
      (lazy record-count (call count-text (as (. trace rows length) U64)))
    )
  )
  (if (!= (. summaries length) 0)
    (call (. out line) "")
    (call (. out line) "groups by total time")
    (for (in text (call (. (call group-table summaries 8) lines)))
      (call (. out line) (str "  " text))
    )
    (if (> (. summaries length) 8)
      (call (. out line) (str "  … +" (- (. summaries length) 8) " more (brix probes durations)"))
    )
  )
  (let counted (call counter-table trace (. options filter)))
  (if (!= (. counted length) 0)
    (call (. out line) "")
    (call (. out line) "counters")
    (for (in text (call (. counted lines)))
      (call (. out line) (str "  " text))
    )
  )
  (if (!= (. ranked length) 0)
    (call (. out line) "")
    (call (. out line) "busiest sites")
    (let table (call Table (list "records" "site" "fields" "location") (list true)))
    (for (in position (..< 0 (if-expr (< (. ranked length) 8) (. ranked length) 8)))
      (let site (!! ([] (. trace sites) ([] ranked position))))
      (call (. table add)
        (block
          (arg
            (call List
              (block
                (item (str (call count-text (as (!! ([] busy ([] ranked position))) U64))))
                (item (call site-text trace site))
                (item (call (. ", " join) (call (. trace field-names) site)))
                (item (call (. trace location-of) site))
              )
            )
          )
        )
      )
    )
    (for (in text (call (. table lines)))
      (call (. out line) (str "  " text))
    )
    (if (> (. ranked length) 8)
      (call (. out line) (str "  … +" (- (. ranked length) 8) " more (brix probes sites)"))
    )
  )
  (for (in warning warnings)
    (call (. out line) (str "warning: " warning))
  )
  (return 0)
)

(fn-do _ trace-warnings (list String)
  (param trace ProbeTrace)
  (let warnings (list String))
  (if (not (. trace is-closed))
    (+= warnings "the program did not close its trace, so records it had not flushed are missing")
  )
  (for (in selector (. trace unmatched))
    (+= warnings (str "--probes selector " selector " matched no probe sites"))
  )
  (if (!= (. trace unended) 0)
    (+= warnings (str (. trace unended) " groups never ended"))
  )
  (if (. trace problem)
    (+= warnings (. trace problem))
  )
  (if (== (. trace source catalog) "")
    (+= warnings "no catalog for this trace; values are named value1, value2, …")
    (else-if (!= (. trace unnamed-sites) 0)
      (+= warnings
        (paragraph
          (str (. trace unnamed-sites) " sites do not match the catalog " (. trace source catalog) "; their values are named value1, value2, …")
        )
      )
    )
  )
  (return warnings)
)

(fn-do _ site-text String
  (param trace ProbeTrace)
  (param site TraceSite)
  (let names (call (. trace field-names) site))
  (return-if (. site key) (if (and (== (. site template) "") (!= (. site key) ""))))
  (return-if "(begin)" (if (and (== (. site template) "") (== (. site name) "groupBegin"))))
  (return-if "(end)" (if (and (== (. site template) "") (== (. site name) "groupEnd"))))
  (return-if (?? (. site name) "probe") (if (== (. site template) "")))
  (let parts (list String) (call (. site template split) "%%"))
  (let text ([] parts 0))
  (for (in index (..< 1 (. parts length)))
    (let name (if-expr (< (- index 1) (. names length)) ([] names (- index 1)) (str "value" index)))
    (+= text (str "{" name "}" ([] parts index)))
  )
  (return (if-expr (!= (. site key) "") (str "[" (. site key) "] " text) text))
)

(fn-expr _ site-kind String
  (param site TraceSite)
  (case? (== (. site name) "groupBegin")
    "begin"
  )
  (case? (== (. site name) "groupEnd")
    "end"
  )
  (case? (== (. site kind) (. TraceSiteKind log))
    "log"
  )
  (case? (== (. site kind) (. TraceSiteKind event))
    "event"
  )
  (default
    "counter"
  )
)

(fn-do _ site-json JSON
  (param trace ProbeTrace)
  (param site TraceSite)
  (param records Size)
  (let record
    (call (of Map String JSON)
      (block
        (entry "id" (as (as (. site id) Int) JSON))
        (entry "kind" (as (call site-kind site) JSON))
        (entry "key" (as (. site key) JSON))
        (entry "template" (as (. site template) JSON))
        (entry "text" (as (call site-text trace site) JSON))
      )
    )
  )
  (let fields (list JSON))
  (for (in name (call (. trace field-names) site))
    (+= fields name)
  )
  (= ([] record "fields") fields)
  (= ([] record "location") (call (. trace location-of) site))
  (= ([] record "path") (. site source-path))
  (= ([] record "line") (as (. site line) Int))
  (= ([] record "records") (as records Int))
  (return record)
)

(fn-do + sites Int (?! Error)
  (param options ProbeQuery)
  (param shows-all Bool)
  (let trace (call open-trace options))
  (let out (. options output))
  (let ids (call sort (. trace sites keys) (:using (=> (a b) (if-expr (< a b) .lesser .greater)))))
  (let table (call Table (list "id" "kind" "records" "site" "fields" "location") (list true false true)))
  (for (in id ids)
    (let site (!! ([] (. trace sites) id)))
    (let records (?? ([] (. trace site-rows) id) 0))
    (if (and (== records 0) (not shows-all))
      (continue)
    )
    (if (not (. out is-text))
      (call (. out record) (call site-json trace site records))
      (continue)
    )
    (call (. table add)
      (block
        (arg
          (call List
            (block
              (item (str id))
              (item (call site-kind site))
              (item (call count-text (as records U64)))
              (item (call site-text trace site))
              (item (call (. ", " join) (call (. trace field-names) site)))
              (item (call (. trace location-of) site))
            )
          )
        )
      )
    )
  )
  (if (. out is-text)
    (for (in text (call (. table lines)))
      (call (. out line) text)
    )
    (let hidden (- (. ids length) (. table length)))
    (if (!= hidden 0)
      (call (. out line) (str "… " hidden " sites wrote no records (--all lists them)"))
    )
  )
  (call (. out finish))
  (return 0)
)

(fn-do + log Int (?! Error)
  (param options ProbeQuery)
  (let trace (call open-trace options))
  (let out (. options output))
  (let rows (list TraceRow))
  (for (in row (. trace rows))
    (if (call (. options filter accepts) row)
      (+= rows row)
    )
  )
  (for (in position (call (. out page) (. rows length) 100))
    (if (. out is-text)
      (call (. out line) (call row-line ([] rows position)))
      (else
        (call (. out record) (call row-json ([] rows position) (. trace types)))
      )
    )
  )
  (if (and (. out is-text) (== (. rows length) 0))
    (call (. out line) "no records match")
  )
  (call (. out more) (. rows length) 100 "records")
  (call (. out finish))
  (return 0)
)

(fn-do + around Int (?! Error)
  (param options ProbeQuery)
  (param context (? Size))
  (let target ([] (. options positionals) 0))
  (let trace (call open-trace options 1))
  (let out (. options output))
  (let rows (list TraceRow))
  (for (in row (. trace rows))
    (if (call (. options filter accepts) row)
      (+= rows row)
    )
  )
  (let index (call parse-number target))
  (let time (? U64) null)
  (if (not index)
    (= time (call parse-duration target))
  )
  (let center (. rows length))
  (for (in position (..< 0 (. rows length)))
    (let row ([] rows position))
    (if (or (and index (>= (as (. row index) F64) index)) (and time (>= (. row time) time)))
      (= center position)
      (break)
    )
  )
  (throw (call Error (str "No record at or after " target)) (if (== center (. rows length))))
  (let shown (?? context 10))
  (let first (if-expr (> center shown) (- center shown) 0))
  (let last (if-expr (< (+ center shown 1) (. rows length)) (+ center shown 1) (. rows length)))
  (for (in position (..< first last))
    (if (. out is-text)
      (let mark (if-expr (== position center) "→ " "  "))
      (call (. out line) (str mark (call row-line ([] rows position))))
      (else
        (call (. out record) (call row-json ([] rows position) (. trace types)))
      )
    )
  )
  (call (. out finish))
  (return 0)
)

(fn-do _ counter-table Table
  (param trace ProbeTrace)
  (param filter RowFilter)
  (let totals (map String U64))
  (let owners (map String Size))
  (for (in count (. trace counts))
    (if (and (!= (. filter keys length) 0) (not (call key-selected filter (. count key))))
      (continue)
    )
    (= ([] totals (. count key)) (+ (?? ([] totals (. count key)) 0u64) (. count value)))
    (if (and (!= (. count owner) "") (not (call (. count owner ends-with) "#0")))
      (= ([] owners (. count key)) (+ (?? ([] owners (. count key)) 0) 1))
    )
  )
  (let owned (!= (. owners length) 0))
  (let table
    (call Table
      (block
        (arg (if-expr owned (list "counter" "value" "objects") (list "counter" "value")))
        (arg (list false true true))
      )
    )
  )
  (let keys (call sort (. totals keys) (:using (=> (a b) (if-expr (< a b) .lesser .greater)))))
  (for (in key keys)
    (if owned
      (call (. table add) (list key (call count-text (!! ([] totals key))) (if-expr ([] owners key) (str (!! ([] owners key))) "")))
      (else
        (call (. table add) (list key (call count-text (!! ([] totals key)))))
      )
    )
  )
  (let metrics
    (block
      (call sort (. trace metrics) (:using (=> (a b) (if-expr (< (. a site key) (. b site key)) .lesser .greater))))
    )
  )
  (for (in metric metrics)
    (if (and (!= (. filter keys length) 0) (not (call key-selected filter (. metric site key))))
      (continue)
    )
    (let shown
      (scope (if-expr is-timer timer-text (call count-text (. metric value)))
        (lazy is-timer (== (. metric site kind) (. TraceMetricKind timer)))
        (lazy timer-text (str (call count-text (. metric value)) "× " (call duration-text (. metric total-ns))))
      )
    )
    (let cells (list String))
    (+= cells (str (. metric site key) " (metric)"))
    (+= cells shown)
    (if owned
      (+= cells "")
    )
    (call (. table add) cells)
  )
  (return table)
)

(fn-expr _ key-selected Bool
  (param filter RowFilter)
  (param key String)
  (call some (. filter keys) (:where (or (call glob-matches each key) (call (. key starts-with) (str each ".")))))
)

(fn-do _ counters-json (list JSON)
  (param trace ProbeTrace)
  (let records (list JSON))
  (for (in count (. trace counts))
    (let record
      (call (of Map String JSON)
        (block
          (entry "key" (as (. count key) JSON))
          (entry "owner" (as (. count owner) JSON))
          (entry "value" (as (as (. count value) Int) JSON))
        )
      )
    )
    (+= records record)
  )
  (for (in metric (. trace metrics))
    (let record
      (call (of Map String JSON)
        (block
          (entry "key" (as (. metric site key) JSON))
          (entry "metric" (as (if-expr (== (. metric site kind) (. TraceMetricKind timer)) "timer" "counter") JSON))
          (entry "value" (as (as (. metric value) Int) JSON))
          (entry "total_ns" (as (as (. metric total-ns) Int) JSON))
        )
      )
    )
    (+= records record)
  )
  (return records)
)

(fn-do + counters Int (?! Error)
  (param options ProbeQuery)
  (let trace (call open-trace options))
  (let out (. options output))
  (if (not (. out is-text))
    (for (in record (call counters-json trace))
      (call (. out record) record)
    )
    (call (. out finish))
    (return 0)
  )
  (let table (call counter-table trace (. options filter)))
  (if (== (. table length) 0)
    (call (. out line) "no counters (the program wrote none, or none match --key)")
    (return 0)
  )
  (for (in text (call (. table lines)))
    (call (. out line) text)
  )
  (return 0)
)

(fn-do _ group-table Table
  (param summaries (list GroupSummary))
  (param limit Size)
  (let table
    (call Table
      (block
        (arg (list "group" "count" "total" "mean" "p50" "p95" "max" "location"))
        (arg (list false true true true true true true))
      )
    )
  )
  (for (in position (..< 0 (if-expr (< (. summaries length) limit) (. summaries length) limit)))
    (let item ([] summaries position))
    (let stats (. item stats))
    (let unended (if-expr (!= (. item unended) 0) (str " (+" (. item unended) " open)") ""))
    (call (. table add)
      (block
        (arg
          (call List
            (block
              (item (. item label))
              (item (str (call count-text (as (. stats count) U64)) unended))
              (item (call nanoseconds-text (. stats sum)))
              (item (call nanoseconds-text (. stats mean)))
              (item (call nanoseconds-text (call (. stats percentile) 50.0)))
              (item (call nanoseconds-text (call (. stats percentile) 95.0)))
              (item (call nanoseconds-text (. stats max)))
              (item (. item location))
            )
          )
        )
      )
    )
  )
  (return table)
)

(fn-expr _ nanoseconds-text String
  (param value F64)
  (call duration-text (as value U64))
)

(fn-do _ group-json JSON
  (param item GroupSummary)
  (let record
    (call (of Map String JSON)
      (block
        (entry "group" (as (. item label) JSON))
        (entry "location" (as (. item location) JSON))
        (entry "count" (as (as (. item stats count) Int) JSON))
        (entry "open" (as (as (. item unended) Int) JSON))
        (entry "total_ns" (call number-json (. item stats sum)))
        (entry "mean_ns" (call number-json (. item stats mean)))
        (entry "p50_ns" (call number-json (call (. item stats percentile) 50.0)))
        (entry "p95_ns" (call number-json (call (. item stats percentile) 95.0)))
        (entry "max_ns" (call number-json (. item stats max)))
      )
    )
  )
  (return record)
)

(fn-do + durations Int (?! Error)
  (param options ProbeQuery)
  (let trace (call open-trace options))
  (let out (. options output))
  (let summaries (call group-summaries trace (. options filter)))
  (if (not (. out is-text))
    (for (in position (call (. out page) (. summaries length) 20))
      (call (. out record) (call group-json ([] summaries position)))
    )
    (call (. out finish))
    (return 0)
  )
  (if (== (. summaries length) 0)
    (call (. out line) "no groups (write //+key// … and //-key// … around the work to time it)")
    (return 0)
  )
  (let shown (call (. out page) (. summaries length) 20))
  (let page (list GroupSummary))
  (for (in position shown)
    (+= page ([] summaries position))
  )
  (for (in text (call (. (call group-table page (. page length)) lines)))
    (call (. out line) text)
  )
  (call (. out more) (. summaries length) 20 "groups")
  (return 0)
)

(fn-do + tree Int (?! Error)
  (param options ProbeQuery)
  (param depth (? Size))
  (let trace (call open-trace options))
  (let out (. options output))
  (let nodes (call group-tree trace (. options filter)))
  (let kept (list TreeNode))
  (for (in node nodes)
    (if (or (not depth) (<= (. node depth) depth))
      (+= kept node)
    )
  )
  (if (not (. out is-text))
    (for (in node kept)
      (let record
        (call (of Map String JSON)
          (block
            (entry "path" (as (. node path) JSON))
            (entry "group" (as (. node label) JSON))
            (entry "depth" (as (as (. node depth) Int) JSON))
            (entry "count" (as (as (. node count) Int) JSON))
            (entry "total_ns" (as (as (. node total) Int) JSON))
            (entry "self_ns" (as (as (. node own) Int) JSON))
          )
        )
      )
      (call (. out record) record)
    )
    (call (. out finish))
    (return 0)
  )
  (if (== (. kept length) 0)
    (call (. out line) "no groups (write //+key// … and //-key// … around the work to time it)")
    (return 0)
  )
  (let table (call Table (list "total" "self" "count" "group") (list true true true)))
  (for (in position (call (. out page) (. kept length) 60))
    (let node ([] kept position))
    (call (. table add)
      (block
        (arg
          (call List
            (block
              (item (call duration-text (. node total)))
              (item (call duration-text (. node own)))
              (item (call count-text (as (. node count) U64)))
              (item (str (* "  " (. node depth)) (. node label)))
            )
          )
        )
      )
    )
  )
  (for (in text (call (. table lines)))
    (call (. out line) text)
  )
  (call (. out more) (. kept length) 60 "groups")
  (return 0)
)

(fn-do _ split-positionals (list String)
  (param options ProbeQuery)
  (param stats (list String))
  (let traces (list String))
  (for (in positional (. options positionals))
    (if (call is-stat-list positional)
      (for (in name (call stat-names positional))
        (+= stats name)
      )
      (else
        (+= traces positional)
      )
    )
  )
  (return traces)
)

(fn-do + agg Int (?! Error)
  (param options ProbeQuery)
  (param stats (list String))
  (param field (? String))
  (param group-by (? String))
  (let traces (call split-positionals options stats))
  (let trace (call load-trace (if-expr (!= (. traces length) 0) ([] traces 0) "last") (. options catalog)))
  (let out (. options output))
  (throw (call Error (str "agg needs --field NAME; fields with numbers here: " (call (. ", " join) (call numeric-fields trace)))) (if (not field)))
  (let named field)
  (let names (if-expr (!= (. stats length) 0) stats default-stats))
  (let groups (call field-groups trace (. options filter) named group-by))
  (let timed (or (== named "duration") (== named "time")))
  (if (not (. out is-text))
    (for (in position (call (. out page) (. groups length) 50))
      (let group ([] groups position))
      (let record (call (of Map String JSON)))
      (if group-by
        (= ([] record group-by) (. group name))
      )
      (= ([] record "field") named)
      (for (in name names)
        (= ([] record name) (call number-json (?? (call (. group stats stat) name) 0.0)))
      )
      (call (. out record) record)
    )
    (call (. out finish))
    (return 0)
  )
  (if (== (. groups length) 0)
    (call (. out line) (str "no records with a number in " named " match; fields with numbers here: " numeric-names)
      (block
        (lazy numeric-names (call (. ", " join) (call numeric-fields trace)))
      )
    )
    (return 0)
  )
  (let headers (list String))
  (let rights (list Bool))
  (+= headers (?? group-by "field"))
  (+= rights false)
  (for (in name names)
    (+= headers name)
    (+= rights true)
  )
  (let table (call Table headers rights))
  (for (in position (call (. out page) (. groups length) 50))
    (let group ([] groups position))
    (let cells (list String))
    (+= cells (if-expr group-by (. group name) named))
    (for (in name names)
      (let value (?? (call (. group stats stat) name) 0.0))
      (+= cells (call stat-text name value timed))
    )
    (call (. table add) cells)
  )
  (for (in text (call (. table lines)))
    (call (. out line) text)
  )
  (call (. out more) (. groups length) 50 "groups")
  (return 0)
)

(fn-expr _ stat-text String
  (param name String)
  (param value F64)
  (param timed Bool)
  (case? (== name "count")
    (call count-text (as value U64))
  )
  (case? (and timed (>= value 0.0))
    (call duration-text (as value U64))
  )
  (default
    (call number-text value)
  )
)

(fn-do _ numeric-fields (list String)
  (param trace ProbeTrace)
  (let found (map String Bool))
  (let names (list String))
  (for (in row (. trace rows))
    (for (in index (..< 0 (. row fields length)))
      (let name ([] (. row fields) index))
      (if (or ([] found name) (>= index (. row values length)))
        (continue)
      )
      (if (call datum-number (call value-datum ([] (. row values) index)))
        (= ([] found name) true)
        (+= names name)
      )
    )
  )
  (+= names "duration")
  (return names)
)

(fn-do + timeline Int (?! Error)
  (param options ProbeQuery)
  (param stats (list String))
  (param bucket (? U64))
  (param field (? String))
  (let trace (call open-trace options))
  (let out (. options output))
  (let width (?? bucket (call nice-bucket (. trace span) 60)))
  (throw (call Error (str "--bucket " bucket-text " gives more than 400 columns over " span-text "; use a larger bucket")) (if (> (/ (. trace span) width) 400)))
  (lazy bucket-text (call duration-text width))
  (lazy span-text (call duration-text (. trace span)))
  (let stat (if-expr (!= (. stats length) 0) ([] stats 0) (if-expr field "max" "count")))
  (let series (call timeline-series trace (. options filter) width stat field))
  (if (not (. out is-text))
    (for (in position (call (. out page) (. series length) 12))
      (let line ([] series position))
      (let record
        (call (of Map String JSON)
          (block
            (entry "label" (as (. line label) JSON))
            (entry "records" (as (as (. line count) Int) JSON))
            (entry "bucket_ns" (as (as width Int) JSON))
            (entry "stat" (as stat JSON))
          )
        )
      )
      (let values (list JSON))
      (for (in value (. line buckets))
        (+= values (call number-json value))
      )
      (= ([] record "buckets") values)
      (call (. out record) record)
    )
    (call (. out finish))
    (return 0)
  )
  (if (== (. series length) 0)
    (call (. out line) "no records match")
    (return 0)
  )
  (let measure (if-expr field (str stat " of " field) "records"))
  (call (. out line) (str "each column is " (call duration-text width) " over " trace-span "; bars show " measure " per column")
    (block
      (lazy trace-span (call duration-text (. trace span)))
    )
  )
  (let table (call Table (list "" "records" "peak") (list false true true)))
  (let lines (list String))
  (for (in position (call (. out page) (. series length) 12))
    (let line ([] series position))
    (let peak F64)
    (for (in value (. line buckets))
      (if (> value peak)
        (= peak value)
      )
    )
    (call (. table add)
      (block
        (arg (list (. line label) (call count-text (as (. line count) U64)) (call stat-text stat peak (== field "duration"))))
      )
    )
    (+= lines (call sparkline (. line buckets)))
  )
  (let texts (call (. table lines)))
  (call (. out line) ([] texts 0))
  (for (in index (..< 1 (. texts length)))
    (call (. out line) (str ([] texts index) "  │" ([] lines (- index 1)) "│"))
  )
  (call (. out more) (. series length) 12 "series")
  (return 0)
)

(fn-do + outliers Int (?! Error)
  (param options ProbeQuery)
  (param field (? String))
  (param context (? Size))
  (let trace (call open-trace options))
  (let out (. options output))
  (let found (call find-outliers trace (. options filter) field))
  (let timed (or (not field) (== field "duration") (== field "time")))
  (if (not (. out is-text))
    (for (in position (call (. out page) (. found length) 10))
      (let outlier ([] found position))
      (let record
        (call (of Map String JSON)
          (block
            (entry "row" (call row-json (. outlier row) (. trace types)))
            (entry "value" (call number-json (. outlier value)))
            (entry "median" (call number-json (. outlier median)))
            (entry "ratio" (call number-json (call ratio outlier)))
          )
        )
      )
      (call (. out record) record)
    )
    (call (. out finish))
    (return 0)
  )
  (if (== (. found length) 0)
    (let wanted
      (block
        (case? field
          (str "records with a number in " field)
        )
        (default
          "ended groups (or pass --field NAME)"
        )
      )
    )
    (call (. out line) (str "no " wanted " match"))
    (return 0)
  )
  (for (in position (call (. out page) (. found length) 10))
    (let outlier ([] found position))
    (let value (call stat-text "value" (. outlier value) timed))
    (let median (call stat-text "value" (. outlier median) timed))
    (call (. out line)
      (block
        (arg
          (paragraph
            (str (call ratio-text (call ratio outlier)) "× median (" value " vs " median ")  " (. outlier row label) "  #" (. outlier row index) " at " (call duration-text (. outlier row time)) "  " (. outlier row location))
          )
        )
      )
    )
    (for (in text (call context-lines trace (. outlier row) context))
      (call (. out line) (str "    " text))
    )
  )
  (call (. out more) (. found length) 10 "outliers")
  (return 0)
)

(fn-expr _ ratio-text String
  (param value F64)
  (call number-text (/ (as (as (+ (* value 10.0) 0.5) U64) F64) 10.0))
)

(fn-do _ context-lines (list String)
  (param trace ProbeTrace)
  (param row TraceRow)
  (param context (? Size))
  (let lines (list String))
  (if (== (. row kind) (. TraceRowKind begin))
    (let limit (?? context 8))
    (let shown 0)
    (let inside 0)
    (for (in index (..< (+ (. row index) 1) (. trace rows length)))
      (let other ([] (. trace rows) index))
      (if (and (== (. other kind) (. TraceRowKind end)) (== (. other span) (. row span)))
        (break)
      )
      (+= inside 1)
      (if (< shown limit)
        (+= lines (call row-line other))
        (+= shown 1)
      )
    )
    (if (> inside shown)
      (+= lines (str "… +" (- inside shown) " more inside (brix probes around " (. row index) ")"))
    )
    (return lines)
  )
  (let reach (?? context 2))
  (let first (if-expr (> (. row index) reach) (- (. row index) reach) 0))
  (let last
    (scope (if-expr (< (+ (. row index) reach 1) (. trace rows length)) reach-end (. trace rows length))
      (lazy reach-end (+ (. row index) reach 1))
    )
  )
  (for (in index (..< first last))
    (let mark (if-expr (== index (. row index)) "→ " "  "))
    (+= lines (str mark (call row-line ([] (. trace rows) index))))
  )
  (return lines)
)

(fn-do + diff Int (?! Error)
  (param options ProbeQuery)
  (param shows-all Bool)
  (let left (call load-trace ([] (. options positionals) 0) null))
  (let right (call load-trace ([] (. options positionals) 1) null))
  (let out (. options output))
  (let changes (call trace-changes left right shows-all))
  (if (not (. out is-text))
    (for (in position (call (. out page) (. changes length) 30))
      (let change ([] changes position))
      (let record
        (call (of Map String JSON)
          (block
            (entry "section" (as (. change section) JSON))
            (entry "name" (as (. change name) JSON))
            (entry "a" (call number-json (. change left)))
            (entry "b" (call number-json (. change right)))
            (entry "delta" (call number-json (. change delta)))
          )
        )
      )
      (call (. out record) record)
    )
    (call (. out finish))
    (return 0)
  )
  (call (. out line) (str "a  " (. left source trace) "  " (call duration-text (. left span)) " · " left-count " records")
    (block
      (lazy left-count (call count-text (as (. left rows length) U64)))
    )
  )
  (call (. out line) (str "b  " (. right source trace) "  " (call duration-text (. right span)) " · " right-count " records")
    (block
      (lazy right-count (call count-text (as (. right rows length) U64)))
    )
  )
  (if (== (. changes length) 0)
    (call (. out line) "no differences in records per site, group times or counters")
    (return 0)
  )
  (let table (call Table (list "" "name" "a" "b" "change") (list false false true true true)))
  (for (in position (call (. out page) (. changes length) 30))
    (let change ([] changes position))
    (call (. table add)
      (block
        (arg
          (call List
            (block
              (item (. change section))
              (item (. change name))
              (item (call change-value change (. change left)))
              (item (call change-value change (. change right)))
              (item (call change-text change))
            )
          )
        )
      )
    )
  )
  (for (in text (call (. table lines)))
    (call (. out line) text)
  )
  (call (. out more) (. changes length) 30 "changes")
  (return 0)
)

(fn-expr _ change-value String
  (param change Change)
  (param value F64)
  (if-expr (. change is-duration) (call duration-text (as value U64)) (call number-text value))
)

(fn-expr _ change-text String
  (param change Change)
  (case? (and (== (. change left) 0.0) (!= (. change right) 0.0))
    "new"
  )
  (case? (and (== (. change right) 0.0) (!= (. change left) 0.0))
    "gone"
  )
  (case? (== (. change left) (. change right))
    "same"
  )
  (case? (>= percent 0.0)
    (str "+" (call ratio-text percent) "%")
  )
  (default
    (str "-" (call ratio-text (- percent)) "%")
  )
  (where
    (lazy percent (* (/ (. change delta) (. change left)) 100.0))
  )
)

(fn-do + run-program Int (?! Error)
  (param command (list String))
  (param is-quiet Bool)
  (param timeout (? Seconds))
  (param trace-path (? String))
  (let program ([] command 0))
  (throw (call Error (str "No program at " program "; build it first with `brix x.bx -o " program " --probes --compile`")) (if (not (. (call Path program) is-file))))
  (let run (call ProbeRun program ([] command (... 1))))
  (let catalog (str program ".probes.json"))
  (if (. (call Path catalog) is-file)
    (= (. run catalog-path) catalog)
    (else
      (<- stderr (str "warning: no catalog at " catalog "; was " program " compiled with --probes?\n"))
    )
  )
  (= (. run timeout) timeout)
  (let traces (call probes-directory))
  (= (. run trace-path) (?? trace-path (as (call new-trace-path traces (. (call Path program) name)) String)))
  (= (. run shows-lines) (not is-quiet))
  (let code (call (. run run)))
  (catch (call write-last-run traces run code))
  (return code)
)
