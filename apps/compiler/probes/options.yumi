./output
./query
./stats
/stream/aggregate

━━━━━━━━━━━━━━━━━━━━
+ ProbeQuery

+ positionals [String]
+ catalog String?
+ filter = RowFilter()
+ output = Output()

────────────────────
+ trace-name String
    - position Size = 0

if position < positionals.length then positionals[position] else "last"

━━━━━━━━━━━━━━━━━━━━
+ do stat-names [String] ?! Error
    - text String

. names = split-list(text)
for name in names
    ?! Error("Unknown statistic $name (use count, sum, min, max, mean, median or pNN such as p95)")
        if !is-stat-name(name)
= names

━━━━━━━━━━━━━━━━━━━━
+ do is-stat-list Bool
    - text String

. names = split-list(text)
=? false if names.length == 0
= all(names) • where is-stat-name(each)
