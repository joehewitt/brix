(import /stream/sort)
(blank)
(prop _ bars (list String) (= (list "▁" "▂" "▃" "▄" "▅" "▆" "▇" "█")))

(type + Stats
  (prop + count Size (= 0))
  (prop + sum F64)
  (prop + min F64)
  (prop + max F64)
  (blank)
  (prop _ values (list F64))
  (prop _ ordered (list F64))
  (prop _ is-ordered _ (= false))
  (fn-do + add _
    (param value F64)
    (if (or (== count 0) (< value min))
      (= min value)
    )
    (if (or (== count 0) (> value max))
      (= max value)
    )
    (+= count 1)
    (+= sum value)
    (+= values value)
    (= is-ordered false)
  )
  (fn-expr + mean F64 :get
    (if-expr (!= count 0) (/ sum (as count F64)) 0.0)
  )
  (fn-do + percentile F64
    (param rank F64)
    (return-if 0.0 (if (== count 0)))
    (blank)
    (if (not is-ordered)
      (= ordered (call sort values (:using (=> (a b) (if-expr (< a b) .lesser .greater)))))
      (= is-ordered true)
    )
    (let position (as (+ (* (/ rank 100.0) (as count F64)) 0.999999) Size))
    (let index (if-expr (> position 0) (- position 1) 0))
    (return ([] ordered (if-expr (< index count) index (- count 1))))
  )
  (fn-do + stat (? F64)
    (param name String)
    (match? name
      (case= "count"
        (return (as count F64))
      )
      (case= "sum"
        (return sum)
      )
      (case= "total"
        (return sum)
      )
      (case= "min"
        (return min)
      )
      (case= "max"
        (return max)
      )
      (case= "mean"
        (return mean)
      )
      (case= "avg"
        (return mean)
      )
      (case= "median"
        (return (call percentile 50.0))
      )
    )
    (return-if null (if (not (call (. name starts-with) "p"))))
    (blank)
    (let rank (call parse-rank ([] name (... 1))))
    (return-if null (if (not rank)))
    (return (call percentile rank))
  )
)

(fn-do _ parse-rank (? F64)
  (param text String)
  (return-if null (if (== (. text length) 0)))
  (blank)
  (for (in char text)
    (return-if null (if (and (or (< char '0') (> char '9')) (!= char '.'))))
  )
  (let rank (as text F64))
  (return-if null (if (> rank 100.0)))
  (return rank)
)

(fn-expr + is-stat-name Bool
  (param name String)
  (or (has (list "count" "sum" "total" "min" "max" "mean" "avg" "median") name) is-rank)
  (where
    (lazy is-rank (and (call (. name starts-with) "p") (!= (call parse-rank ([] name (... 1))) null)))
  )
)

(fn-do + sparkline String
  (param values (list F64))
  (let top F64)
  (for (in value values)
    (if (> value top)
      (= top value)
    )
  )
  (let line "")
  (for (in value values)
    (if (or (<= value 0.0) (<= top 0.0))
      (+= line " ")
      (else
        (let level (as (+ (* (/ value top) 7.0) 0.5) Size))
        (+= line ([] bars (if-expr (< level 8) level 7)))
      )
    )
  )
  (return line)
)
