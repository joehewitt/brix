/data/json
/lang/constants
/os/file
/os/path
/probes/model
/probes/supervise

━━━━━━━━━━━━━━━━━━━━
+ probes-directory Path

brix-probes-path

━━━━━━━━━━━━━━━━━━━━
+ do resolve-source TraceSource ?! Error
    - name String
    - catalog String?

. source = TraceSource()
if name == "" || name == "last"
    . last = probes-directory() / "last.json"
    ?! Error("No probe run recorded yet; run a program with `brix x.yumi -o out --probes` first")
        if !last.is-file
    source = read-run-record(last as String)
else if name.ends-with(".run.json")
    source = read-run-record(name)
else if name.ends-with(".trace")
    . record = trace-sidecar(name, "run.json")
    if Path(record).is-file
        source = catch? read-run-record(record) ?? TraceSource()
    source.trace = name
    . kept = trace-sidecar(name, "probes.json")
    if source.catalog == "" && Path(kept).is-file
        source.catalog = kept
else
    ?! Error("Not a trace: $name (expected last, a .trace file or a .run.json record)")
if catalog
    source.catalog = catalog
?! Error("The trace ${source.trace} does not exist")
    if !Path(source.trace).is-file
= source

━━━━━━━━━━━━━━━━━━━━
_ do read-run-record TraceSource ?! Error
    - path String

. root = JSONReader(path, parse-json(read-file-text(Path(path)))).object()
. source = TraceSource()
source.trace = root["trace"].string()
if root.has("catalog")
    source.catalog = root["catalog"].string()
if root.has("program")
    source.program = root["program"].string()
if root.has("arguments")
    for item in root["arguments"].items()
        source.arguments += item.string()
if root.has("status")
    source.status = root["status"].int()
if root.has("timed-out")
    source.timed-out = root["timed-out"].bool()
= source

━━━━━━━━━━━━━━━━━━━━
+ do load-trace ProbeTrace ?! Error
    - name String
    - catalog String?

. trace = ProbeTrace(resolve-source(name, catalog))
trace.load()
= trace
