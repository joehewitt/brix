(import ./model)
(import ./query)
(import ./stats)
(import /probes/model)
(import /stream/sort)

(type + GroupSummary
  (prop + label _ (= ""))
  (prop + location _ (= ""))
  (prop + stats _ (= (call Stats)))
  (prop + unended Size (= 0))
)

(fn-do + group-summaries (list GroupSummary)
  (param trace ProbeTrace)
  (param filter RowFilter)
  (let found (map String GroupSummary))
  (for (in row (. trace rows))
    (if (or (!= (. row kind) (. TraceRowKind begin)) (not (call (. filter accepts) row)))
      (continue)
    )
    (let summary (?? ([] found (. row label)) (call new-summary row)))
    (= ([] found (. row label)) summary)
    (if (. row duration)
      (call (. summary stats add) (as (. row duration) F64))
      (else
        (+= (. summary unended) 1)
      )
    )
  )
  (return (call sort (. found values) (:using (=> (a b) (if-expr (> (. a stats sum) (. b stats sum)) .lesser .greater)))))
)

(fn-do _ new-summary GroupSummary
  (param row TraceRow)
  (let summary (call GroupSummary))
  (= (. summary label) (. row label))
  (= (. summary location) (. row location))
  (return summary)
)

(type + TreeNode
  (prop + path _ (= ""))
  (prop + label _ (= ""))
  (prop + parent _ (= ""))
  (prop + depth Size (= 0))
  (prop + count Size (= 0))
  (prop + total U64)
  (prop + own U64)
  (prop + children (list TreeNode))
)

(fn-do + group-tree (list TreeNode)
  (param trace ProbeTrace)
  (param filter RowFilter)
  (let nested (map Size U64))
  (for (in row (. trace rows))
    (if (and (== (. row kind) (. TraceRowKind begin)) (. row parent) (. row duration))
      (= ([] nested (!! (. row parent))) (+ (?? ([] nested (. row parent)) 0u64) (!! (. row duration))))
    )
  )
  (let paths (map Size String))
  (let nodes (map String TreeNode))
  (let order (list String))
  (for (in row (. trace rows))
    (if (!= (. row kind) (. TraceRowKind begin))
      (continue)
    )
    (let above "")
    (if (. row parent)
      (= above (?? ([] paths (. row parent)) ""))
    )
    (let path (if-expr (!= above "") (str above " › " (. row label)) (. row label)))
    (= ([] paths (. row index)) path)
    (if (or (not (. row duration)) (not (call (. filter accepts) row)))
      (continue)
    )
    (let node (?? ([] nodes path) (call TreeNode)))
    (if (== (. node path) "")
      (= (. node path) path)
      (= (. node label) (. row label))
      (= (. node parent) above)
      (= (. node depth) (. row depth))
      (= ([] nodes path) node)
      (+= order path)
    )
    (+= (. node count) 1)
    (+= (. node total) (!! (. row duration)))
    (let inside (?? ([] nested (. row index)) 0u64))
    (+= (. node own) (if-expr (> (!! (. row duration)) inside) (- (!! (. row duration)) inside) 0u64))
  )
  (let roots (list TreeNode))
  (for (in path order)
    (let node (!! ([] nodes path)))
    (let owner ([] nodes (. node parent)))
    (if owner
      (+= (. owner children) node)
      (else
        (+= roots node)
      )
    )
  )
  (let flat (list TreeNode))
  (call flatten roots flat)
  (return flat)
)

(fn-do _ flatten _
  (param nodes (list TreeNode))
  (param flat (list TreeNode))
  (let ordered (call sort nodes (:using (=> (a b) (if-expr (> (. a total) (. b total)) .lesser .greater)))))
  (for (in node ordered)
    (+= flat node)
    (call flatten (. node children) flat)
  )
)

(type + FieldGroup
  (prop + name _ (= ""))
  (prop + number (? F64))
  (prop + stats _ (= (call Stats)))
)

(fn-do + field-groups (list FieldGroup)
  (param trace ProbeTrace)
  (param filter RowFilter)
  (param field String)
  (param group-by (? String))
  (let found (map String FieldGroup))
  (for (in row (. trace rows))
    (if (not (call (. filter accepts) row))
      (continue)
    )
    (let value (call datum-number (call field-datum row field)))
    (if (not value)
      (continue)
    )
    (let datum (only-if (call field-datum row group-by) (if group-by)))
    (if (and group-by (not datum))
      (continue)
    )
    (let name (if-expr group-by (call datum-text datum) "all"))
    (let group (?? ([] found name) (call FieldGroup)))
    (if (== (. group name) "")
      (= (. group name) name)
      (= (. group number) (only-if (call datum-number datum) (if group-by)))
      (= ([] found name) group)
    )
    (call (. group stats add) value)
  )
  (let groups (list FieldGroup))
  (let numeric true)
  (for (in (tuple _ group) found)
    (+= groups group)
    (if (not (. group number))
      (= numeric false)
    )
  )
  (if (and numeric group-by)
    (return (call sort groups (:using (=> (a b) (if-expr (< (!! (. a number)) (!! (. b number))) .lesser .greater)))))
  )
  (return (call sort groups (:using (=> (a b) (if-expr (or (> (. a stats count) (. b stats count)) (and (== (. a stats count) (. b stats count)) (< (. a name) (. b name)))) .lesser .greater)))))
)

(type + Series
  (prop + label _ (= ""))
  (prop + count Size (= 0))
  (prop + buckets (list F64))
  (prop + stats (list Stats))
)

(fn-do + timeline-series (list Series)
  (param trace ProbeTrace)
  (param filter RowFilter)
  (param bucket U64)
  (param stat String)
  (param field (? String))
  (let width (as (+ (/ (. trace span) bucket) 1) Size))
  (let found (map String Series))
  (for (in row (. trace rows))
    (if (or (== (. row kind) (. TraceRowKind end)) (not (call (. filter accepts) row)))
      (continue)
    )
    (let value (? F64) 1.0)
    (if field
      (= value (call datum-number (call field-datum row field)))
    )
    (if (not value)
      (continue)
    )
    (let series (?? ([] found (. row label)) (call new-series (. row label) width)))
    (= ([] found (. row label)) series)
    (+= (. series count) 1)
    (let slot (as (/ (. row time) bucket) Size))
    (call (. ([] (. series stats) (if-expr (< slot width) slot (- width 1))) add) value)
  )
  (let ordered (call sort (. found values) (:using (=> (a b) (if-expr (> (. a count) (. b count)) .lesser .greater)))))
  (for (in series ordered)
    (for (in index (..< 0 width))
      (let stats ([] (. series stats) index))
      (+= (. series buckets) (?? (call (. stats stat) stat) 0.0))
    )
  )
  (return ordered)
)

(fn-do _ new-series Series
  (param label String)
  (param width Size)
  (let series (call Series))
  (= (. series label) label)
  (for (in _ (..< 0 width))
    (+= (. series stats) (call Stats))
  )
  (return series)
)

(fn-do + nice-bucket U64
  (param span U64)
  (param columns U64)
  (let wanted (+ (/ span columns) 1))
  (for (in step (list 1u64 2u64 5u64))
    (let scale 1u64)
    (while (< scale 100000000000)
      (let size (* step scale))
      (if (and (>= size wanted) (call is-smallest size wanted))
        (return size)
      )
      (*= scale 10)
    )
  )
  (return wanted)
)

(fn-do _ is-smallest Bool
  (param size U64)
  (param wanted U64)
  (for (in step (list 1u64 2u64 5u64))
    (let scale 1u64)
    (while (< scale 100000000000)
      (let other (* step scale))
      (if (and (>= other wanted) (< other size))
        (return false)
      )
      (*= scale 10)
    )
  )
  (return true)
)

(type + Outlier
  (prop + row TraceRow)
  (prop + value F64)
  (prop + median F64)
  (fn-do + This _
    (param row TraceRow)
    (param value F64)
    (param median F64)
  )
)

(fn-do + find-outliers (list Outlier)
  (param trace ProbeTrace)
  (param filter RowFilter)
  (param field (? String))
  (let populations (map String Stats))
  (let candidates (list Outlier))
  (for (in row (. trace rows))
    (if (not (call (. filter accepts) row))
      (continue)
    )
    (let value (? F64) null)
    (if field
      (= value (call datum-number (call field-datum row field)))
      (else-if (and (== (. row kind) (. TraceRowKind begin)) (. row duration))
        (= value (as (. row duration) F64))
      )
    )
    (if (not value)
      (continue)
    )
    (let population (?? ([] populations (. row label)) (call Stats)))
    (= ([] populations (. row label)) population)
    (call (. population add) value)
    (+= candidates (call Outlier row value 0.0))
  )
  (for (in candidate candidates)
    (= (. candidate median) (call (. (!! ([] populations (. candidate row label))) percentile) 50.0))
  )
  (return (call sort candidates (:using (=> (a b) (if-expr (or (> (call ratio a) (call ratio b)) (and (== (call ratio a) (call ratio b)) (> (. a value) (. b value)))) .lesser .greater)))))
)

(fn-expr + ratio F64
  (param outlier Outlier)
  (if-expr (> (. outlier median) 0.0) (/ (. outlier value) (. outlier median)) (. outlier value))
)

(type + Change
  (prop + section _ (= ""))
  (prop + name _ (= ""))
  (prop + left F64)
  (prop + right F64)
  (prop + is-duration _ (= false))
  (fn-expr + delta F64 :get
    (- right left)
  )
  (fn-expr + weight F64 :get
    (case? (== left 0.0)
      (if-expr (!= right 0.0) 1000000.0 0.0)
    )
    (default
      (if-expr (>= delta 0.0) (/ delta left) (/ (- delta) left))
    )
  )
)

(fn-do + trace-changes (list Change)
  (param left ProbeTrace)
  (param right ProbeTrace)
  (param shows-all Bool)
  (let changes (list Change))
  (let empty (call RowFilter))
  (call compare changes "records" (call site-counts left) (call site-counts right) false)
  (call compare
    (block
      (arg changes)
      (arg "group total")
      (arg (call group-totals left empty "sum"))
      (arg (call group-totals right empty "sum"))
      (arg true)
    )
  )
  (call compare
    (block
      (arg changes)
      (arg "group p50")
      (arg (call group-totals left empty "p50"))
      (arg (call group-totals right empty "p50"))
      (arg true)
    )
  )
  (call compare changes "counter" (call counter-totals left) (call counter-totals right) false)
  (let kept (list Change))
  (for (in change changes)
    (if (or shows-all (!= (. change left) (. change right)))
      (+= kept change)
    )
  )
  (return (call sort kept (:using (=> (a b) (if-expr (> (. a weight) (. b weight)) .lesser .greater)))))
)

(fn-do _ compare _
  (param changes (list Change))
  (param section String)
  (param left (map String F64))
  (param right (map String F64))
  (param is-duration Bool)
  (let names (map String Bool))
  (for (in (tuple name _) left)
    (= ([] names name) true)
  )
  (for (in (tuple name _) right)
    (= ([] names name) true)
  )
  (for (in (tuple name _) names)
    (let change (call Change))
    (= (. change section) section)
    (= (. change name) name)
    (= (. change left) (?? ([] left name) 0.0))
    (= (. change right) (?? ([] right name) 0.0))
    (= (. change is-duration) is-duration)
    (+= changes change)
  )
)

(fn-do _ site-counts (map String F64)
  (param trace ProbeTrace)
  (let counts (map String F64))
  (for (in row (. trace rows))
    (if (== (. row kind) (. TraceRowKind end))
      (continue)
    )
    (let name (if-expr (!= (. row location) "") (str (. row label) " " (. row location)) (. row label)))
    (= ([] counts name) (+ (?? ([] counts name) 0.0) 1.0))
  )
  (return counts)
)

(fn-do _ group-totals (map String F64)
  (param trace ProbeTrace)
  (param filter RowFilter)
  (param stat String)
  (let totals (map String F64))
  (for (in summary (call group-summaries trace filter))
    (if (!= (. summary stats count) 0)
      (= ([] totals (. summary label)) (?? (call (. summary stats stat) stat) 0.0))
    )
  )
  (return totals)
)

(fn-do _ counter-totals (map String F64)
  (param trace ProbeTrace)
  (let totals (map String F64))
  (for (in count (. trace counts))
    (= ([] totals (. count key)) (+ (?? ([] totals (. count key)) 0.0) (as (. count value) F64)))
  )
  (for (in metric (. trace metrics))
    (= ([] totals (. metric site key)) (+ (?? ([] totals (. metric site key)) 0.0) (as (. metric value) F64)))
  )
  (return totals)
)
