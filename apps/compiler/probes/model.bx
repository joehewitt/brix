(import /data/json)
(import /lang/constants)
(import /os/file)
(import /os/path)
(import /probes/model)
(import /probes/supervise)

(fn-expr + probes-directory Path
  brix-probes-path
)

(fn-do + resolve-source TraceSource (?! Error)
  (param name String)
  (param catalog (? String))
  (let source (call TraceSource))
  (if (or (== name "") (== name "last"))
    (let last (/ (call probes-directory) "last.json"))
    (throw (call Error "No probe run recorded yet; run a program with `brix x.bx -o out --probes` first") (if (not (. last is-file))))
    (blank)
    (= source (call read-run-record (as last String)))
    (else-if (call (. name ends-with) ".run.json")
      (= source (call read-run-record name))
    )
    (else-if (call (. name ends-with) ".trace")
      (let record (call trace-sidecar name "run.json"))
      (if (. (call Path record) is-file)
        (= source (?? (catch? (call read-run-record record)) (call TraceSource)))
      )
      (= (. source trace) name)
      (let kept (call trace-sidecar name "probes.json"))
      (if (and (== (. source catalog) "") (. (call Path kept) is-file))
        (= (. source catalog) kept)
      )
    )
    (else
      (throw (call Error (str "Not a trace: " name " (expected last, a .trace file or a .run.json record)")))
    )
  )
  (if catalog
    (= (. source catalog) catalog)
  )
  (throw (call Error (str "The trace " (. source trace) " does not exist")) (if (not (. (call Path (. source trace)) is-file))))
  (return source)
)

(fn-do _ read-run-record TraceSource (?! Error)
  (param path String)
  (let root (call (. (call JSONReader path (call parse-json (call read-file-text (call Path path)))) object)))
  (let source (call TraceSource))
  (= (. source trace) (call (. ([] root "trace") string)))
  (if (call (. root has) "catalog")
    (= (. source catalog) (call (. ([] root "catalog") string)))
  )
  (if (call (. root has) "program")
    (= (. source program) (call (. ([] root "program") string)))
  )
  (if (call (. root has) "arguments")
    (for (in item (call (. ([] root "arguments") items)))
      (+= (. source arguments) (call (. item string)))
    )
  )
  (if (call (. root has) "status")
    (= (. source status) (call (. ([] root "status") int)))
  )
  (if (call (. root has) "timed-out")
    (= (. source timed-out) (call (. ([] root "timed-out") bool)))
  )
  (return source)
)

(fn-do + load-trace ProbeTrace (?! Error)
  (param name String)
  (param catalog (? String))
  (let trace (call ProbeTrace (call resolve-source name catalog)))
  (call (. trace load))
  (return trace)
)
