(import ./bench-config)
(import /os/file)
(import /os/path)
(import /stream/sort)
(blank)
(prop + bench-metadata-marker _ (= "benchmark.meta"))
(blank)
(type-line _ BenchMetadataLine (is (tuple (: key String) (: value String))))

(type + BenchCase (is Tuple)
  (prop + suite BenchSuite)
  (prop + case-name String)
  (prop + id String)
  (prop + description String)
  (prop + tags (list String))
  (prop + timing (? String))
  (prop + profiles (? (list String)))
  (prop + source-path String)
  (prop + relative-path String)
)

(fn-do + discover-bench-cases (list BenchCase) (?! Error)
  (param config BenchConfig)
  (let cases (list BenchCase))
  (let sources (map String (map String String)))
  (for (in suite (. config suites))
    (for (in source-path (call bench-files suite))
      (let within-suite ([] source-path (... (+ (. suite path length) 1))))
      (let case-name (call bench-without-extension within-suite (. suite extensions)))
      (let id (str (. suite name) "/" case-name))
      (let known ([] sources source-path))
      (let metadata (if-expr known known (call bench-metadata (call read-file-text (call Path source-path 0)))))
      (= ([] sources source-path) metadata)
      (let description (?? ([] metadata "description") ""))
      (throw (call Error (str "Benchmark " id " is missing `" bench-metadata-marker " description")) (if (== description "")))
      (let timing ([] metadata "timing"))
      (throw (call Error (str "Invalid timing '" timing "' for benchmark " id)) (if (and timing (!= timing "recommended") (!= timing "not-recommended"))))
      (let listed ([] metadata "profiles"))
      (+= cases
        (call BenchCase
          (block
            (arg suite)
            (arg case-name)
            (arg id)
            (arg description)
            (arg (call bench-commas (?? ([] metadata "tags") "")))
            (arg timing)
            (arg (only-if (call bench-unique (call bench-commas listed)) (if listed)))
            (arg source-path)
            (arg (if-expr (call (. source-path starts-with) (str (. config root) "/")) relative-source source-path))
          )
        )
      )
      (lazy relative-source ([] source-path (... (+ (. config root length) 1))))
    )
  )
  (return (call sort cases (:using (=> (a b) (if-expr (< (. a id) (. b id)) .lesser .greater)))))
)

(fn-do + select-bench-cases (list BenchCase)
  (param cases (list BenchCase))
  (param selectors (list String))
  (return-if cases (if (== (. selectors length) 0)))
  (let normalized (list String))
  (for (in selector selectors)
    (+= normalized (call bench-selector selector))
  )
  (let selected (list BenchCase))
  (for (in bench cases)
    (for (in selector normalized)
      (if (call bench-case-matches bench selector)
        (+= selected bench)
        (break)
      )
    )
  )
  (return selected)
)

(fn-do + unmatched-bench-selectors (list String)
  (param cases (list BenchCase))
  (param selectors (list String))
  (let unmatched (list String))
  (for (in selector selectors)
    (let normalized (call bench-selector selector))
    (let found false)
    (for (in bench cases)
      (if (call bench-case-matches bench normalized)
        (= found true)
        (break)
      )
    )
    (if (not found)
      (+= unmatched selector)
    )
  )
  (return unmatched)
)

(fn-expr + bench-case-matches Bool
  (param bench BenchCase)
  (param selector String)
  (or (== selector (. bench suite name)) (== selector (. bench id)) (== selector (str (. bench id) extension)) (== selector (. bench case-name)) (== selector file-name) (== selector (call bench-selector (. bench relative-path))) (== selector (call bench-selector (. bench source-path))) (call (. selector ends-with) (str "/" (. bench id))) (call (. selector ends-with) (str "/" (. bench id) extension)))
  (where
    (lazy extension (call bench-extension (. bench relative-path)))
    (lazy file-name (call bench-file-name (. bench relative-path)))
  )
)

(fn-do + bench-selector String
  (param text String)
  (let rest text)
  (while (call (. rest starts-with) "./")
    (= rest ([] rest (... 2)))
    (while (call (. rest starts-with) "/")
      (= rest ([] rest (... 1)))
    )
  )
  (return-if "." (if (== rest "")))
  (let normalized (call bench-normalized-path rest))
  (return (if-expr (!= normalized "") normalized "."))
)

(fn-expr + bench-file-name String
  (param path String)
  (if-expr slash ([] path (... (+ slash 1))) path)
  (where
    (lazy slash (call (. path find) "/" 0 true))
  )
)

(fn-expr + bench-extension String
  (param path String)
  (if-expr (and dot (> dot 0)) ([] name (... dot)) "")
  (where
    (lazy name (call bench-file-name path))
    (lazy dot (call (. name find) "." 0 true))
  )
)

(fn-do _ bench-files (list String) (?! Error)
  (param suite BenchSuite)
  (let files (list String))
  (let root (call Path (. suite path) 0))
  (return-if files (if (not (. root exists))))
  (call visit-bench-files (. suite path) (. suite extensions) files)
  (return (call sort files (:using (=> (a b) (if-expr (< a b) .lesser .greater)))))
)

(fn-do _ visit-bench-files _ (?! Error)
  (param directory String)
  (param extensions (list String))
  (param files (list String))
  (for (in entry (. (call Path directory 0) entries))
    (if (or (== (. entry name) ".") (== (. entry name) ".."))
      (continue)
    )
    (let path (str directory "/" (. entry name)))
    (if (== (. entry kind) (. PathKind directory))
      (call visit-bench-files path extensions files)
      (else-if (== (. entry kind) (. PathKind file))
        (for (in extension extensions)
          (if (call (. entry name ends-with) extension)
            (+= files path)
            (break)
          )
        )
      )
    )
  )
)

(fn-do _ bench-metadata (map String String) (?! Error)
  (param source String)
  (let fields (map String String))
  (for (in line (call (. source split) "\n"))
    (let parsed (call bench-metadata-line line))
    (if parsed
      (= ([] fields (. parsed key)) (. parsed value))
    )
  )
  (return fields)
)

(fn-do _ bench-metadata-line (? BenchMetadataLine) (?! Error)
  (param line String)
  (return-if null (if (and (not (call (. line starts-with) "`")) (not (call (. line starts-with) ";")))))
  (let comment ([] line (... 1)))
  (let start 0)
  (while (and (< start (. comment length)) (or (== ([] comment start) (char " ")) (== ([] comment start) (char "\t"))))
    (+= start 1)
  )
  (let text ([] comment (... start)))
  (return-if null (if (not (call (. text starts-with) bench-metadata-marker))))
  (let body (call (. ([] text (... (. bench-metadata-marker length))) trim)))
  (let colon (call (. body find) ":"))
  (throw (call Error (str "Invalid benchmark metadata line: " line)) (if (not colon)))
  (return (call BenchMetadataLine (call (. ([] body (..< 0 colon)) trim)) (call (. ([] body (... (+ colon 1))) trim))))
)

(fn-do _ bench-without-extension String
  (param path String)
  (param extensions (list String))
  (for (in extension extensions)
    (return-if ([] path (..< 0 (- (. path length) (. extension length)))) (if (call (. path ends-with) extension)))
  )
  (return path)
)

(fn-do _ bench-unique (list String)
  (param values (list String))
  (let unique (list String))
  (for (in value values)
    (if (not (has unique value))
      (+= unique value)
    )
  )
  (return unique)
)
