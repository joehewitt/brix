(import ./bench-catalog)
(import ./bench-config)
(import ./bench-launch)
(import ./bench-metrics)
(import ./bench-report)
(import ./bench-runner)
(import ./bench-session)
(import /data/json)
(import /lang/constants)
(import /os/cli)
(import /os/env)
(import /os/file)
(import /os/path)
(import /os/signal)
(import /probes/supervise)
(import /time/duration)
(import /time/timer)
(import /unistd.h)
(blank)
(prop _ bench-refresh _ (= 100ms))
(prop _ bench-clear-line _ (= "\r\x1b[K"))
(blank)

(main
  (call request-process-termination (call (. (call BenchTool) run)))
)

(type _ BenchTool (is CommandLine)
  (content
    (<> This
      (= name "brix bench")
      (= about
        (paragraph
          (str "Build and measure a project's benchmarks. Each folder inside a bench folder under the project root is a suite named after it, and the timing profile measures run time, CPU time, instructions and cycles. " bench-config-path " can add suites, metrics and profiles, and folders under the root can hold a " bench-config-path " of their own.")
        )
      )
      (blank)
      (<> Subcommand (text: "list")
        (= about "profiles and suites, or the benchmarks a selection holds")
        (= action (=> () (call list (?? (. root value) (as project-root String)) (. listed values) (. benchmarks value) (. profile value))))
        (blank)
        (<> Arguments (id: listed) (text: "selector"))
        (<> Flag (id: benchmarks) (text: "--benchmarks")
          (= about "list each selected benchmark")
        )
      )
      (blank)
      (<> Subcommand (text: "runs")
        (= about "saved runs to compare against")
        (= action (=> () (call list-runs (?? (. root value) (as project-root String)) (. profile value))))
      )
      (blank)
      (<> Subcommand (text: "run")
        (= about "run the selected benchmarks, or the profile's default selection")
        (= action (=> () (call run-chosen)))
        (blank)
        (<> Arguments (id: chosen) (text: "selector"))
        (<> (of Option Size) (id: iterations) (text: "--iterations")
          (= value-name "N")
          (= about "measured samples of each benchmark, for profiles with a timing metric")
        )
        (<> (of Option Size) (id: warmup) (text: "--warmup")
          (= value-name "N")
          (= about "discarded samples before measuring")
        )
        (<> Option (id: compare) (text: "--compare")
          (= value-name "NAME")
          (= about "compare against a saved run")
        )
        (<> Option (id: save) (text: "--save")
          (= value-name "NAME")
          (= about "also save this run under NAME")
        )
        (<> Option (id: reason) (text: "--reason")
          (= value-name "TEXT")
          (= about "a note saved with the report")
        )
        (<> (of Option U64) (id: timeout) (text: "--timeout")
          (= value-name "MS")
          (= about "the limit for each compile or run")
          (= default bench-default-timeout)
        )
        (<> Option (id: metrics) (text: "--metrics")
          (= value-name "KEYS")
          (= about "the metrics shown for each benchmark, comma separated, or all")
        )
        (<> Flag (id: keep) (text: "--keep")
          (= about "keep the built executables and metric files")
        )
      )
      (blank)
      (<> Subcommand (text: "launch")
        (= about
          (paragraph
            "launch a built benchmark once to warm it, then until its timing settles, and print its process metrics"
          )
        )
        (= action (=> () (call (. (call BenchLauncher (as (. (call Path (!! (. executable value))) resolved) String) (!! (. deadline value))) run))))
        (blank)
        (<> Argument (id: executable) (text: "executable"))
        (<> (of Option Seconds) (id: deadline) (text: "--deadline")
          (= value-name "D")
          (= parser (=> (text) (call parse-timeout text)))
          (= default bench-launch-deadline)
          (= about "stop launching after D (500ms, 30s, 2m) and exit with 124")
        )
      )
      (blank)
      (<> HelpTopic (text: "selectors")
        (<> HelpEntry (text: "array")
          (= about "a whole suite")
        )
        (<> HelpEntry (text: "array/scalar-index")
          (= about "one benchmark, in one suite")
        )
        (<> HelpEntry (text: "scalar-index")
          (= about "a benchmark in every suite that has it")
        )
        (<> HelpEntry (text: "stdlib/core/bench/array/scalar-index-access.bx")
          (= about "a benchmark source file")
        )
      )
      (blank)
      (<> Option (id: profile) (text: "--profile")
        (= value-name "NAME")
        (= about "the profile to run, list or compare; the config's default otherwise")
      )
      (<> Option (id: root) (text: "--root")
        (= value-name "PATH")
        (= about
          (paragraph
            (str "the project folder holding " bench-config-path "; by default the nearest folder holding .git, or else a " project-folder-name " folder, or else the current folder")
          )
        )
      )
    )
  )
  (fn-expr _ run-chosen Int (?! Error)
    (call run-benchmarks
      (block
        (arg (?? (. root value) (as project-root String)))
        (arg (. chosen values))
        (arg (!! (. timeout value)))
        (arg (. keep value))
        (arg (. profile value))
        (arg (. iterations value))
        (arg (. warmup value))
        (arg (. compare value))
        (arg (. save value))
        (arg (. reason value))
        (arg (. metrics value))
      )
    )
  )
)

(fn-do _ list Int (?! Error)
  (param root String)
  (param selectors (list String))
  (param shows-benchmarks Bool)
  (param profile-name (? String))
  (let config (call load-bench-config root))
  (let cases (call discover-bench-cases config))
  (if (and (== (. selectors length) 0) (not shows-benchmarks))
    (for (in line (call bench-profile-lines config cases))
      (print line)
    )
    (return 0)
  )
  (let chosen
    (scope (if-expr (> (. selectors length) 0) selectors (. (call (. config profile) wanted-name) default-selectors))
      (lazy wanted-name (?? profile-name (. config default-profile)))
    )
  )
  (for (in selector (call unmatched-bench-selectors cases chosen))
    (<- stderr (str "warning: " selector " matched no benchmarks\n"))
  )
  (let selected (call select-bench-cases cases chosen))
  (for (in line (call bench-selection-lines selected shows-benchmarks))
    (print line)
  )
  (return (if-expr (> (. selected length) 0) 0 1))
)

(fn-do _ list-runs Int (?! Error)
  (param root String)
  (param profile-name (? String))
  (let config (call load-bench-config root))
  (let profile (only-if (. (call (. config profile) profile-name) name) (if profile-name)))
  (for (in line (call bench-saved-run-lines (call bench-saved-runs root profile) profile))
    (print line)
  )
  (return 0)
)

(fn-do _ run-benchmarks Int (?! Error)
  (param root String)
  (param selectors (list String))
  (param timeout U64)
  (param keeps Bool)
  (param profile-name (? String))
  (param iterations (? Size))
  (param warmup (? Size))
  (param compare (? String))
  (param save (? String))
  (param reason (? String))
  (param metrics (? String))
  (let config (call load-bench-config root))
  (let profile (call (. config profile) (?? profile-name (. config default-profile))))
  (let cases (call discover-bench-cases config))
  (let chosen (if-expr (> (. selectors length) 0) selectors (. profile default-selectors)))
  (for (in selector (call unmatched-bench-selectors cases chosen))
    (<- stderr (str "warning: " selector " matched no benchmarks\n"))
  )
  (let selected (call select-bench-cases cases chosen))
  (throw (call Error (str "No benchmarks matched " chosen-text " for profile " (. profile name))) (if (== (. selected length) 0)))
  (blank)
  (lazy chosen-text (if-expr (> (. chosen length) 0) (call (. ", " join) chosen) "all"))
  (for (in note (call bench-run-notes profile iterations warmup))
    (<- stderr (str "note: " note "\n"))
  )
  (let info
    (call bench-run-info
      (block
        (arg config)
        (arg profile)
        (arg chosen)
        (arg timeout)
        (arg keeps)
        (arg "human")
        (arg iterations)
        (arg warmup)
        (arg compare)
        (arg save)
        (arg reason)
      )
    )
  )
  (let shown (call bench-shown-metrics profile metrics))
  (let baseline (call bench-baseline root (. info compare-name)))
  (let runner (use (call BenchRunner)))
  (let session (call BenchSession (. selected length)))
  (do-new
    (for (in frame (. runner frames))
      (call (. session apply) (. frame event))
      (if (. session is-complete)
        (break)
      )
    )
  )
  (call (. runner start) (call BenchOrder 1 info selected))
  (do-new
    (for (on sig sig-int)
      (if (. session is-stopping)
        (call request-process-termination 130)
      )
      (= (. session is-stopping) true)
      (call (. runner stop) 1)
    )
  )
  (let is-live (== (call C:isatty 1) 1))
  (print (call bench-heading info (. selected length)))
  (let printed 0)
  (while (not (. session is-complete))
    (= printed (call print-finished session info shown baseline printed is-live))
    (if is-live
      (<- stdout (str bench-clear-line (call bench-status-line session selected info)))
    )
    (call (. bench-refresh wait))
  )
  (call print-finished session info shown baseline printed is-live)
  (if is-live
    (<- stdout bench-clear-line)
  )
  (for (in line (call bench-summary-lines session info))
    (print line)
  )
  (let problem (. session problem))
  (if problem
    (<- stderr (str "error: " problem "\n"))
  )
  (return-if 130 (if (. session is-stopped)))
  (return-if 1 (if problem))
  (blank)
  (for (in result (. session results))
    (return-if 1 (if (or (not result) (not (. result is-passed)))))
  )
  (return 0)
)

(fn-do _ print-finished Size
  (param session BenchSession)
  (param info BenchRunInfo)
  (param shown (list Index))
  (param baseline (map String JSON))
  (param printed Size)
  (param is-live Bool)
  (let next printed)
  (while (and (< next (. session results length)) ([] (. session results) next))
    (+= next 1)
  )
  (return-if printed (if (== next printed)))
  (blank)
  (if is-live
    (<- stdout bench-clear-line)
  )
  (for (in index (..< printed next))
    (for (in line (call bench-result-lines (!! ([] (. session results) index)) info shown baseline))
      (print line)
    )
  )
  (return next)
)
