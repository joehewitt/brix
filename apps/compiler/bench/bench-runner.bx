(import ./../command-template)
(import ./bench-catalog)
(import ./bench-config)
(import ./bench-metrics)
(import ./bench-probes)
(import ./bench-report)
(import /BxCore/BxString.h)
(import /data/json)
(import /os/env)
(import /os/file)
(import /os/path)
(import /os/process)
(import /time/clock)
(import /time/duration)
(import /time/timer)
(blank)
(prop _ bench-stop-grace _ (= 1500ms))
(prop _ bench-drain-grace _ (= 2s))
(prop _ bench-settle-poll _ (= 20ms))
(prop _ bench-settle-polls _ (= 25))
(prop _ bench-prune-age _ (= 172800))
(prop _ bench-output-lines Size (= 12))
(prop _ bench-setup-lines Size (= 20))
(prop _ bench-lifeline _ (= "(read line <&3; kill -KILL 0) </dev/null >/dev/null 2>&1 & exec \"\$@\" 3<&-"))
(blank)
(type-line + BenchFrame (is (tuple (: run Int) (: event BenchEvent))))
(type-line _ BenchStopped (is Error))

(type + BenchRunner
  (implements Closable)
  (prop + frames _ (:= (call (of SyncBufferedChannel BenchFrame))))
  (blank)
  (prop _ requests _ (:= (call (of SyncBufferedChannel BenchRequest))))
  (prop _ served _ (:= (call (of SyncBufferedChannel Bool))))
  (prop _ worker _ (:= (call Worker)))
  (fn-do + This _
    (do-new (worker: worker)
      (call serve)
    )
  )
  (fn-do + close _
    (return-if (if (. requests is-closed)))
    (call (. requests close))
    (<- served)
    (call (. worker stop))
    (call (. frames close))
  )
  (fn-do + start _
    (param order BenchOrder)
    (<- requests (call (. BenchRequest start) order))
  )
  (fn-do + stop _
    (param run Int)
    (<- requests (call (. BenchRequest stop) run))
  )
  (fn-do + discover _
    (param request Int)
    (param root String)
    (<- requests (call (. BenchRequest discover) request root))
  )
  (fn-do + load _
    (param request Int)
    (param root String)
    (param profile String)
    (param compare String)
    (<- requests (call (. BenchRequest load) request root profile compare))
  )
  (fn-do + save _
    (param request Int)
    (param root String)
    (param profiles (list String))
    (param reason String)
    (<- requests (call (. BenchRequest save) request root profiles reason))
  )
  (fn-do + archive _
    (param request Int)
    (param root String)
    (param name String)
    (<- requests (call (. BenchRequest archive) request root name))
  )
  (fn-do _ serve _
    (let executions (list BenchExecution))
    (let last (? BenchExecution))
    (for (in request requests)
      (match request
        (case (call .start order)
          (let previous last)
          (let execution (call BenchExecution order frames))
          (let live (list BenchExecution))
          (for (in each executions)
            (if (not (. each is-finished))
              (+= live each)
            )
          )
          (+= live execution)
          (= executions live)
          (= last execution)
          (do-new
            (call (?. previous await))
            (call (. execution execute))
          )
        )
        (case (call .stop run)
          (for (in execution executions)
            (if (== (. execution order run) run)
              (call (. execution stop))
            )
          )
        )
        (case (call .discover request root)
          (do-new
            (<- frames (call BenchFrame request (call bench-discovery root)))
          )
        )
        (case (call .load request root profile compare)
          (do-new
            (<- frames (call BenchFrame request (call bench-loading root profile compare)))
          )
        )
        (case (call .save request root profiles reason)
          (do-new
            (<- frames (call BenchFrame request (call bench-saving root profiles reason)))
          )
        )
        (case (call .archive request root name)
          (do-new
            (<- frames (call BenchFrame request (call bench-archiving root name)))
          )
        )
      )
    )
    (for (in execution executions)
      (call (. execution stop))
    )
    (call (?. last await))
    (call (. served close))
  )
)

(type + BenchPhase (is Union)
  (variant warmup-compile)
  (variant warmup-compile-done)
  (variant warmup-run)
  (variant warmup-run-done)
  (variant compile)
  (variant compile-done)
  (variant run)
  (variant run-done)
)

(type + BenchEvent (is Union)
  (variant setup (tuple (: state String)))
  (variant progress (tuple (: bench Index) (: phase BenchPhase) (: iteration Size) (: at U64) (: values (list (? F64)))))
  (variant finished (tuple (: bench Index) (: result BenchResult)))
  (variant saved (tuple (: path String)))
  (variant failed (tuple (: message String)))
  (variant completed (tuple (: is-stopped Bool)))
  (variant discovered (tuple (: config BenchConfig) (: cases (list BenchCase))))
  (variant loaded (tuple (: state BenchLoad)))
  (variant unavailable (tuple (: message String)))
  (variant unconfigured)
  (variant changed)
)

(type + BenchLoad (is Tuple)
  (prop + profile String)
  (prop + compare String)
  (prop + latest (map String BenchRecord))
  (prop + baseline (map String BenchRecord))
  (prop + runs (list BenchSavedRun))
  (prop + unsaved (list String))
  (prop + problem String)
)

(type + BenchOrder (is Tuple)
  (prop + run Int)
  (prop + info BenchRunInfo)
  (prop + cases (list BenchCase))
)

(fn-expr + bench-exit-label String
  (param sample BenchSample)
  (if-expr (. sample signal) (str " signal=" (. sample signal)) exit-text)
  (where
    (lazy exit-text (if-expr (and (. sample exit-code) (!= (. sample exit-code) 0)) (str " exit=" (. sample exit-code)) ""))
  )
)

(type _ BenchRequest (is Union)
  (variant start (tuple (: order BenchOrder)))
  (variant stop (tuple (: run Int)))
  (variant discover (tuple (: request Int) (: root String)))
  (variant load (tuple (: request Int) (: root String) (: profile String) (: compare String)))
  (variant save (tuple (: request Int) (: root String) (: profiles (list String)) (: reason String)))
  (variant archive (tuple (: request Int) (: root String) (: name String)))
)

(type _ BenchAttempt (is Tuple)
  (prop + compile (? BenchSample))
  (prop + run (? BenchSample))
  (prop + checksum (? F64))
  (prop + result-line (? String))
  (prop + diagnostics (list String))
)

(type _ BenchValidation (is Tuple)
  (prop + checksum (? F64))
  (prop + result-line (? String))
  (prop + problem String)
)

(type _ BenchExecution
  (prop + order BenchOrder)
  (prop + is-finished _ (= false))
  (blank)
  (prop _ frames (of SyncBufferedChannel BenchFrame))
  (prop _ process (? BenchProcess))
  (prop _ is-stopping _ (= false))
  (prop _ done _ (:= (call (of SyncBufferedChannel Bool))))
  (fn-do + This _
    (param order _)
    (param frames _)
  )
  (fn-do + stop _
    (return-if (if is-stopping))
    (= is-stopping true)
    (call (?. process stop))
  )
  (fn-do + await _
    (<- done)
  )
  (fn-do + execute _
    (call run-order
      (block
        (on-error (: failure Error)
          (if (not is-stopping)
            (call send (call (. BenchEvent failed) (. failure message)))
          )
        )
      )
    )
    (call send (call (. BenchEvent completed) is-stopping))
    (= is-finished true)
    (call (. done close))
  )
  (fn-do _ run-order _ (?! Error)
    (let info (. order info))
    (let root (. info config root))
    (let baseline (? JSON))
    (if (!= (. info compare-name) "")
      (= baseline (call load-bench-baseline root (. info compare-name)))
    )
    (if (. info profile setup)
      (call send (call (. BenchEvent setup) "provider-setup"))
      (call run-setup)
      (call send (call (. BenchEvent setup) "setup-ready"))
      (else
        (call send (call (. BenchEvent setup) "setup-not-needed"))
      )
    )
    (let directory (call make-bench-directory (. info run-id)))
    (finally
      (if (not (. info keeps))
        (catch (call remove-bench-tree directory))
      )
    )
    (let results (list BenchResult))
    (for (in index (..< 0 (. order cases length)))
      (call check-stopped)
      (let result (call run-case index directory))
      (call check-stopped)
      (+= results result)
      (call send (call (. BenchEvent finished) index result))
    )
    (let comparison (? BenchComparison))
    (if baseline
      (= comparison
        (call bench-comparison root (. info compare-name) baseline results (. info profile metrics)
          (block
            (on-error (: failure Error)
              (throw (call Error (str "Measurement finished, but the comparison failed: " (. failure message))))
            )
          )
        )
      )
    )
    (let path
      (call save-bench-reports info results comparison
        (block
          (on-error (: failure Error)
            (throw (call Error (str "Measurement finished, but saving the report failed: " (. failure message))))
          )
        )
      )
    )
    (call send (call (. BenchEvent saved) path))
  )
  (fn-do _ run-setup _ (?! Error)
    (let info (. order info))
    (let step (call (. info config step) (!! (. info profile setup)) (. info profile) (call variables "" "" "" "" "")))
    (let limit (if-expr (> (. info timeout) bench-setup-timeout) (. info timeout) bench-setup-timeout))
    (let sample (call execute step limit 0))
    (throw (call Error (str "benchmark setup " (. sample status) (call bench-exit-label sample) "\n" output-tail)) (if (!= (. sample status) "passed")))
    (lazy output-tail (call bench-tail (call trim-joined (. sample stdout) (. sample stderr)) bench-setup-lines))
  )
  (fn-do _ run-case BenchResult (?! Error)
    (param index Index)
    (param directory String)
    (let info (. order info))
    (let bench ([] (. order cases) index))
    (let case-directory (str directory "/" (call bench-sanitized (. bench id))))
    (call (. (call Path case-directory 0) make-directories))
    (let source (. bench source-path))
    (let diagnostics (list String))
    (for (in iteration (..< 0 (. info warmup)))
      (let warmup (call attempt index source case-directory iteration true))
      (if (> (. warmup diagnostics length) 0)
        (for (in diagnostic (. warmup diagnostics))
          (+= diagnostics (str "warmup " iteration ": " diagnostic))
        )
        (break)
      )
    )
    (let compile-samples (list BenchSample))
    (let run-samples (list BenchSample))
    (let checksum (? F64))
    (let result-line (? String))
    (if (== (. diagnostics length) 0)
      (for (in iteration (..< 0 (. info iterations)))
        (let sample (call attempt index source case-directory iteration false))
        (if (. sample compile)
          (+= compile-samples (. sample compile))
        )
        (if (. sample run)
          (+= run-samples (. sample run))
        )
        (if (. sample checksum)
          (= checksum (. sample checksum))
        )
        (if (. sample result-line)
          (= result-line (. sample result-line))
        )
        (++= diagnostics (. sample diagnostics))
      )
    )
    (let values (list (list (? F64))))
    (let summaries (list BenchSummary))
    (for (in metric (. info profile metrics))
      (let samples (if-expr (== (. metric source) (. BenchSource compile)) compile-samples run-samples))
      (let extracted (list (? F64)))
      (for (in sample samples)
        (+= extracted (call bench-extract metric (call bench-sample-json sample (. metric source) false)))
      )
      (+= values extracted)
      (+= summaries (call bench-summary extracted))
    )
    (return
      (call BenchResult
        (block
          (arg bench)
          (arg (call bench-status compile-samples run-samples diagnostics))
          (arg checksum)
          (arg result-line)
          (arg compile-samples)
          (arg run-samples)
          (arg values)
          (arg summaries)
          (arg diagnostics)
        )
      )
    )
  )
  (fn-do _ attempt BenchAttempt (?! Error)
    (param index Index)
    (param source String)
    (param directory String)
    (param iteration Size)
    (param is-warmup Bool)
    (let info (. order info))
    (let bench ([] (. order cases) index))
    (let tag (if-expr is-warmup (str "warmup-" iteration) (str "iter-" iteration)))
    (let executable (str directory "/" (call bench-sanitized (. bench id)) "-" tag))
    (let metrics-path (str executable ".metrics.json"))
    (let compiler-trace
      (scope (if-expr (> (. info profile compiler-probes length) 0) traced-path "")
        (lazy traced-path (str executable ".compiler.probes"))
      )
    )
    (let probes-path (str executable ".probes"))
    (call progress
      (block
        (arg index)
        (arg (if-expr is-warmup (. BenchPhase warmup-compile) (. BenchPhase compile)))
        (arg iteration)
        (arg null)
      )
    )
    (let step
      (call (. info config step)
        (block
          (arg (. bench suite compile))
          (arg (. info profile))
          (arg (call variables source executable "" compiler-trace probes-path))
        )
      )
    )
    (let outcome (call execute step (. info timeout) iteration))
    (let data (call compiler-metrics compiler-trace))
    (let compile
      (call BenchSample
        (block
          (arg iteration)
          (arg (. outcome duration))
          (arg (. outcome status))
          (arg (. outcome exit-code))
          (arg (. outcome signal))
          (arg (. outcome stdout))
          (arg (. outcome stderr))
          (arg executable)
          (arg "")
          (arg compiler-trace)
          (arg data)
        )
      )
    )
    (call progress
      (block
        (arg index)
        (arg (if-expr is-warmup (. BenchPhase warmup-compile-done) (. BenchPhase compile-done)))
        (arg iteration)
        (arg compile)
      )
    )
    (let diagnostics (list String))
    (if (!= (. compile status) "passed")
      (+= diagnostics (str "compile " (. compile status) (call bench-exit-label compile)))
      (++= diagnostics (call bench-output-diagnostics "compile" compile))
      (return (call BenchAttempt compile null null null diagnostics))
    )
    (return-if (call BenchAttempt compile null null null diagnostics) (if (not (. info profile runs-executable))))
    (let ran (call run-executable index source executable metrics-path probes-path iteration is-warmup))
    (return (call BenchAttempt compile (. ran run) (. ran checksum) (. ran result-line) (. ran diagnostics)))
  )
  (fn-do _ run-executable BenchAttempt (?! Error)
    (param index Index)
    (param source String)
    (param executable String)
    (param metrics-path String)
    (param probes-path String)
    (param iteration Size)
    (param is-warmup Bool)
    (let info (. order info))
    (let bench ([] (. order cases) index))
    (call progress index (if-expr is-warmup (. BenchPhase warmup-run) (. BenchPhase run)) iteration null)
    (let step
      (call (. info config step)
        (block
          (arg (. bench suite run))
          (arg (. info profile))
          (arg (call variables source executable metrics-path "" probes-path))
        )
      )
    )
    (let outcome (call execute step (. info timeout) iteration))
    (let diagnostics (list String))
    (let probes (if-expr (> (. info profile probes length) 0) probes-path ""))
    (let data (call runtime-metrics metrics-path probes (. outcome stdout) diagnostics))
    (let run
      (call BenchSample
        (block
          (arg iteration)
          (arg (. outcome duration))
          (arg (. outcome status))
          (arg (. outcome exit-code))
          (arg (. outcome signal))
          (arg (. outcome stdout))
          (arg (. outcome stderr))
          (arg executable)
          (arg metrics-path)
          (arg probes)
          (arg data)
        )
      )
    )
    (call progress
      (block
        (arg index)
        (arg (if-expr is-warmup (. BenchPhase warmup-run-done) (. BenchPhase run-done)))
        (arg iteration)
        (arg run)
      )
    )
    (let validation (call bench-validation (. bench id) (. run stdout)))
    (if (!= (. run status) "passed")
      (+= diagnostics (str "run " (. run status) (call bench-exit-label run)))
      (++= diagnostics (call bench-output-diagnostics "run" run))
      (else-if (!= (. validation problem) "")
        (+= diagnostics (. validation problem))
      )
    )
    (return (call BenchAttempt null run (. validation checksum) (. validation result-line) diagnostics))
  )
  (fn-do _ execute BenchSample (?! Error)
    (param step TargetStep)
    (param timeout U64)
    (param iteration Size)
    (call check-stopped)
    (let current (call BenchProcess step (. order info config root) timeout))
    (= process current)
    (if is-stopping
      (call (. current stop))
    )
    (let sample (call (. current run)))
    (= process null)
    (call check-stopped)
    (return sample)
  )
  (fn-do _ variables (map String String)
    (param source String)
    (param artifact String)
    (param metrics String)
    (param compiler-trace String)
    (param trace String)
    (let info (. order info))
    (let root (. info config root))
    (let values
      (call (of Map String String)
        (block
          (entry "root" root)
          (entry "source" source)
          (entry "artifact" artifact)
          (entry "metrics" metrics)
          (entry "compilerProbes" (. info profile compiler-probe-selectors))
          (entry "compilerTrace" compiler-trace)
          (entry "probes" (. info profile probe-selectors))
          (entry "trace" trace)
          (entry "build" (call bench-build root (. info profile)))
          (entry "benchmarkMetrics" (if-expr (. info profile has-benchmark-metrics) "1" ""))
        )
      )
    )
    (return values)
  )
  (fn-do _ compiler-metrics (? JSON)
    (param trace String)
    (let fields (map String JSON))
    (let probed (only-if (call bench-probe-metrics trace) (if (!= trace ""))))
    (for (in (tuple key value) (?? probed (call (of Map String JSON))))
      (= ([] fields key) value)
    )
    (return-if null (if (== (. fields length) 0)))
    (return (as fields JSON))
  )
  (fn-do _ runtime-metrics (? JSON)
    (param metrics-path String)
    (param trace String)
    (param stdout String)
    (param diagnostics (list String))
    (let fields (map String JSON))
    (let sidecar (only-if (call bench-read-json metrics-path) (if (!= metrics-path ""))))
    (if sidecar
      (match? sidecar
        (case (: found (map String JSON))
          (for (in (tuple key value) found)
            (= ([] fields key) value)
          )
        )
      )
    )
    (for (in line (call (. stdout split) "\n"))
      (let text (if-expr (call (. line ends-with) "\r") ([] line (..< 0 (- (. line length) 1))) line))
      (if (not (call (. text starts-with) "bench-metrics "))
        (continue)
      )
      (let parsed (catch (call parse-json (call (. ([] text (... (. "bench-metrics " length))) trim)))))
      (if (is parsed Error)
        (+= diagnostics (str "invalid bench-metrics JSON: " (. (as parsed Error) message)))
        (continue)
      )
      (match (as parsed JSON)
        (case (: found (map String JSON))
          (for (in (tuple key value) found)
            (= ([] fields key) value)
          )
        )
        (default
          (+= diagnostics "invalid bench-metrics line: expected JSON object")
        )
      )
    )
    (let probed (only-if (call bench-probe-metrics trace) (if (!= trace ""))))
    (for (in (tuple key value) (?? probed (call (of Map String JSON))))
      (= ([] fields key) value)
    )
    (return-if null (if (== (. fields length) 0)))
    (return (as fields JSON))
  )
  (fn-do _ progress _
    (param index Index)
    (param phase BenchPhase)
    (param iteration Size)
    (param sample (? BenchSample))
    (let values (list (? F64)))
    (if sample
      (let source
        (scope (if-expr is-compile (. BenchSource compile) (. BenchSource run))
          (lazy is-compile (or (== phase (. BenchPhase compile-done)) (== phase (. BenchPhase warmup-compile-done))))
        )
      )
      (let sampled (call bench-sample-json sample source false))
      (for (in metric (. order info profile metrics))
        (+= values (only-if (call bench-extract metric sampled) (if (== (. metric source) source))))
      )
    )
    (call send (call (. BenchEvent progress) index phase iteration (call monotonic-time-nanoseconds) values))
  )
  (fn-do _ check-stopped _ (?! Error)
    (throw (call BenchStopped "Benchmark run stopped") (if is-stopping))
  )
  (fn-do _ send _
    (param event BenchEvent)
    (<- frames (call BenchFrame (. order run) event))
  )
)

(type _ BenchProcess
  (prop _ step TargetStep)
  (prop _ root String)
  (prop _ timeout U64)
  (prop _ child (? Process))
  (prop _ lifeline (? File))
  (prop _ status Int (= -1))
  (prop _ errors _ (= ""))
  (prop _ is-stopping _ (= false))
  (prop _ is-exited _ (= false))
  (prop _ is-timed-out _ (= false))
  (prop _ is-settled _ (= false))
  (prop _ timers (list Task))
  (prop _ exited _ (:= (call (of SyncBufferedChannel Bool))))
  (prop _ drained _ (:= (call (of SyncBufferedChannel Bool))))
  (fn-do + This _
    (param step _)
    (param root _)
    (param timeout _)
  )
  (fn-do + run BenchSample (?! Error)
    (let started (call monotonic-time-nanoseconds))
    (call spawn)
    (let current (!! child))
    (do-new
      (call drain-errors current)
    )
    (+= timers
      (do-new
        (call await-exit current)
      )
    )
    (+= timers
      (do-new
        (call watch current)
      )
    )
    (if is-stopping
      (call (. current kill-tree))
    )
    (let output (call read-output current))
    (<- exited)
    (<- drained)
    (call settle current)
    (let duration (call bench-rounded (/ (as (- (call monotonic-time-nanoseconds) started) F64) 1000000.0)))
    (let signal-number (if-expr (> status 128) (- status 128) 0))
    (let sample-status
      (scope (if-expr is-timed-out "timeout" (if-expr is-signaled "signal" exit-status))
        (lazy is-signaled (> signal-number 0))
        (lazy exit-status (if-expr (!= status 0) "failed" "passed"))
      )
    )
    (let exit-code (? Int) (if-expr (> signal-number 0) null status))
    (let signal (? String) (only-if (call bench-signal-name signal-number) (if (> signal-number 0))))
    (return
      (call BenchSample
        (block
          (arg 0)
          (arg duration)
          (arg sample-status)
          (arg exit-code)
          (arg signal)
          (arg (call (. output trim)))
          (arg (call (. errors trim)))
          (arg "")
          (arg "")
          (arg "")
          (arg null)
        )
      )
    )
  )
  (fn-do + stop _
    (return-if (if is-stopping))
    (= is-stopping true)
    (let current child)
    (return-if (if (not current)))
    (if is-exited
      (call (. current kill-tree))
      (return)
    )
    (call (. current terminate-group))
    (+= timers
      (do-new
        (call (. bench-stop-grace wait))
        (if (not is-exited)
          (call (. current kill-tree))
        )
      )
    )
  )
  (fn-do _ spawn _ (?! Error)
    (let arguments
      (block
        (item "-c")
        (item bench-lifeline)
        (item "sh")
        (spread (. step arguments))
        (pipe |> List)
      )
    )
    (let pipe (call process-pipe))
    (call (. pipe reader set-flag) (. FileFlags non-block-mode) false)
    (let created
      (call Process "/bin/sh" (. ProcessStderr capture) arguments root (. step variables) (list (. pipe reader fd)) (:group (. ProcessGroup own))
        (block
          (on-error (: failure Error)
            (catch (call (. pipe reader close)))
            (catch (call (. pipe writer close)))
            (throw failure)
          )
        )
      )
    )
    (catch (call (. pipe reader close)))
    (= lifeline (. pipe writer))
    (= child created)
    (catch (call (. created close-input)))
  )
  (fn-do _ read-output String
    (param current Process)
    (let chunk ([] Byte 0x10000))
    (let buffer ([] Byte 0x10000))
    (let length Size 0)
    (while true
      (let count (call bench-read-chunk current chunk))
      (if (== count 0)
        (break)
      )
      (while (> (+ length count) (. buffer size))
        (= buffer (call (. buffer resize) (* (. buffer size) 2)))
      )
      (for (in index (..< 0 count))
        (= ([] buffer (+ length index)) ([] chunk index))
      )
      (+= length count)
    )
    (return (call bench-byte-text buffer length))
  )
  (fn-do _ drain-errors _
    (param current Process)
    (let chunk ([] Byte 0x10000))
    (let buffer ([] Byte 0x10000))
    (let length Size 0)
    (let source (!! (. current stderr)))
    (while true
      (let count (call bench-read-chunk source chunk))
      (if (== count 0)
        (break)
      )
      (while (> (+ length count) (. buffer size))
        (= buffer (call (. buffer resize) (* (. buffer size) 2)))
      )
      (for (in index (..< 0 count))
        (= ([] buffer (+ length index)) ([] chunk index))
      )
      (+= length count)
    )
    (= errors (call bench-byte-text buffer length))
    (call (. drained close))
  )
  (fn-do _ await-exit _
    (param current Process)
    (= status (?? (call (. current wait) null) -1))
    (= is-exited true)
    (call (. exited close))
    (call (. bench-drain-grace wait))
    (return-if (if is-settled))
    (call (. current kill-tree))
  )
  (fn-do _ watch _
    (param current Process)
    (let limit (* timeout 1000000))
    (let started (call monotonic-time-nanoseconds))
    (while (and (not is-settled) (not is-exited))
      (let elapsed (- (call monotonic-time-nanoseconds) started))
      (if (>= elapsed limit)
        (= is-timed-out true)
        (call (. current kill-tree))
        (return)
      )
      (call (. (as (as (- limit elapsed) F64) Nanoseconds) wait))
    )
  )
  (fn-do _ settle _
    (param current Process)
    (= is-settled true)
    (for (in timer timers)
      (call (. timer cancel))
    )
    (call (. current kill-tree))
    (catch (call (. (!! lifeline) close)))
    (catch (call (. current close)))
    (let polls 0)
    (while (and (> (. current group-members length) 0) (< polls bench-settle-polls))
      (call (. bench-settle-poll wait))
      (+= polls 1)
    )
  )
)

(fn-do _ bench-discovery BenchEvent
  (param root String)
  (let config
    (call load-bench-config root
      (block
        (on-error (: failure Error)
          (return-if (. BenchEvent unconfigured) (if (is failure BenchUnconfiguredError)))
          (return (call (. BenchEvent unavailable) (. failure message)))
        )
      )
    )
  )
  (let cases
    (call discover-bench-cases config
      (block
        (on-error (: failure Error)
          (return (call (. BenchEvent unavailable) (. failure message)))
        )
      )
    )
  )
  (return (call (. BenchEvent discovered) config cases))
)

(fn-do _ bench-loading BenchEvent
  (param root String)
  (param profile String)
  (param compare String)
  (let problem "")
  (let latest (call (of Map String BenchRecord)))
  (let loaded (catch (call load-bench-latest root profile)))
  (if (is loaded Error)
    (= problem (. loaded message))
    (else
      (= latest loaded)
    )
  )
  (let baseline (call (of Map String BenchRecord)))
  (if (!= compare "")
    (let compared (catch (call load-bench-compared root compare profile)))
    (if (is compared Error)
      (= problem (. compared message))
      (else
        (= baseline compared)
      )
    )
  )
  (let listed (call bench-saved-runs root null))
  (let runs (list BenchSavedRun))
  (for (in run listed)
    (if (== (. run profile) profile)
      (+= runs run)
    )
  )
  (return
    (call (. BenchEvent loaded)
      (block
        (arg
          (call BenchLoad
            (block
              (arg profile)
              (arg compare)
              (arg latest)
              (arg baseline)
              (arg runs)
              (arg (call bench-unsaved-profiles root listed))
              (arg problem)
            )
          )
        )
      )
    )
  )
)

(fn-do _ bench-saving BenchEvent
  (param root String)
  (param profiles (list String))
  (param reason String)
  (for (in profile profiles)
    (let failure (catch (call save-bench-comparison root profile reason)))
    (return-if (call (. BenchEvent failed) (. (as failure Error) message)) (if (is failure Error)))
  )
  (return (. BenchEvent changed))
)

(fn-do _ bench-archiving BenchEvent
  (param root String)
  (param name String)
  (let failure (catch (call archive-bench-run root name)))
  (return-if (call (. BenchEvent failed) (. (as failure Error) message)) (if (is failure Error)))
  (return (. BenchEvent changed))
)

(fn-do _ bench-status String
  (param compile-samples (list BenchSample))
  (param run-samples (list BenchSample))
  (param diagnostics (list String))
  (for (in sample compile-samples)
    (return-if "compile-failed" (if (!= (. sample status) "passed")))
  )
  (for (in sample run-samples)
    (return-if "run-failed" (if (!= (. sample status) "passed")))
  )
  (return-if "passed" (if (== (. diagnostics length) 0)))
  (for (in diagnostic diagnostics)
    (return-if "validation-failed" (if (or is-bad-result (!= (call (. diagnostic find) "bench-result") null))))
    (lazy is-bad-result (or (call (. diagnostic starts-with) "missing") (call (. diagnostic starts-with) "invalid")))
  )
  (return "run-failed")
)

(fn-do _ bench-validation BenchValidation
  (param id String)
  (param stdout String)
  (let line (? String))
  (for (in each (call (. stdout split) "\n"))
    (if (call (. each starts-with) "bench-result ")
      (= line (if-expr (call (. each ends-with) "\r") ([] each (..< 0 (- (. each length) 1))) each))
      (break)
    )
  )
  (return-if (call BenchValidation null null "missing bench-result line") (if (not line)))
  (let words (list String))
  (for (in word (call (. ([] line (... (. "bench-result " length))) split) " "))
    (if (!= word "")
      (+= words word)
    )
  )
  (let digits
    (scope (if-expr (and (== (. words length) 2) (call (. ([] words 1) starts-with) "checksum=")) checksum-text "")
      (lazy checksum-text ([] ([] words 1) (... (. "checksum=" length))))
    )
  )
  (let is-valid (!= digits ""))
  (for (in char digits)
    (= is-valid (and is-valid (>= char '0') (<= char '9')))
  )
  (return-if (call BenchValidation null line (str "invalid bench-result line: " line)) (if (not is-valid)))
  (let checksum (as digits F64))
  (return-if (call BenchValidation checksum line mismatch-message) (if (!= ([] words 0) id)))
  (lazy mismatch-message (str "bench-result identity '" ([] words 0) "' did not match '" id "'"))
  (return (call BenchValidation checksum line ""))
)

(fn-do _ bench-output-diagnostics (list String)
  (param label String)
  (param sample BenchSample)
  (let diagnostics (list String))
  (if (!= (. sample stdout) "")
    (+= diagnostics (str label " stdout:\n" (call bench-tail (. sample stdout) bench-output-lines)))
  )
  (if (!= (. sample stderr) "")
    (+= diagnostics (str label " stderr:\n" (call bench-tail (. sample stderr) bench-output-lines)))
  )
  (return diagnostics)
)

(fn-do _ bench-tail String
  (param text String)
  (param count Size)
  (let lines (list String))
  (for (in line (call (. text split) "\n"))
    (+= lines line)
  )
  (return-if text (if (<= (. lines length) count)))
  (return (call (. "\n" join) ([] lines (... (- (. lines length) count)))))
)

(fn-do _ trim-joined String
  (param first String)
  (param second String)
  (let parts (list String))
  (if (!= first "")
    (+= parts first)
  )
  (if (!= second "")
    (+= parts second)
  )
  (return (call (. (call (. "\n" join) parts) trim)))
)

(fn-do _ bench-byte-text String
  (param bytes ([] Byte))
  (param count Size)
  (return-if "" (if (== count 0)))
  (return-if (call (. bytes slice-string) (..< 0 count)) (if (== (call C:brixStringValidateUtf8 (. bytes data) count) 0)))
  (let cleaned ([] Byte count))
  (for (in index (..< 0 count))
    (= ([] cleaned index) (if-expr (< ([] bytes index) 128) ([] bytes index) 63))
  )
  (return (call (. cleaned slice-string) (..< 0 count)))
)

(fn-expr _ bench-signal-name String
  (param number Int)
  (match number
    (case= 1
      "SIGHUP"
    )
    (case= 2
      "SIGINT"
    )
    (case= 3
      "SIGQUIT"
    )
    (case= 4
      "SIGILL"
    )
    (case= 5
      "SIGTRAP"
    )
    (case= 6
      "SIGABRT"
    )
    (case= 8
      "SIGFPE"
    )
    (case= 9
      "SIGKILL"
    )
    (case= 10
      "SIGBUS"
    )
    (case= 11
      "SIGSEGV"
    )
    (case= 13
      "SIGPIPE"
    )
    (case= 14
      "SIGALRM"
    )
    (case= 15
      "SIGTERM"
    )
    (default
      (str "SIG" number)
    )
  )
)

(fn-do _ make-bench-directory String (?! Error)
  (param run-id String)
  (let root (call bench-temp-root))
  (call (. (call Path root 0) make-directories))
  (call prune-bench-directories root)
  (let directory (str root "/" (call bench-sanitized run-id)))
  (call (. (call Path directory 0) make-directories))
  (return directory)
)

(fn-expr _ bench-temp-root String
  (str trimmed "/brix-bench")
  (where
    (lazy base (?? ([] (call environment) "TMPDIR") "/tmp"))
    (lazy trimmed (if-expr (call (. base ends-with) "/") ([] base (..< 0 (- (. base length) 1))) base))
  )
)

(fn-do _ prune-bench-directories _
  (param root String)
  (let now (as (. (call clock) s) I64))
  (let found (catch? (. (call Path root 0) entries)))
  (return-if (if (not found)))
  (for (in entry found)
    (if (or (!= (. entry kind) (. PathKind directory)) (== (. entry name) ".") (== (. entry name) ".."))
      (continue)
    )
    (let path (str root "/" (. entry name)))
    (let stat (catch? (. (call Path path 0) stat)))
    (if (and stat (> (- now (as (. stat mtime s) I64)) bench-prune-age))
      (catch (call remove-bench-tree path))
    )
  )
)

(fn-do _ remove-bench-tree _ (?! Error)
  (param path String)
  (return-if (if (not (call (. path starts-with) (str (call bench-temp-root) "/")))))
  (let found (catch? (. (call Path path 0) entries)))
  (if found
    (for (in entry found)
      (if (or (== (. entry name) ".") (== (. entry name) ".."))
        (continue)
      )
      (let child (str path "/" (. entry name)))
      (if (== (. entry kind) (. PathKind directory))
        (call remove-bench-tree child)
        (else
          (catch (call (. (call Path child 0) delete)))
        )
      )
    )
  )
  (catch (call (. (call Path path 0) delete)))
)
