(import ./bench-catalog)
(import ./bench-config)
(import ./bench-metrics)
(import /data/json)
(import /math)
(import /os/file)
(import /os/path)
(import /os/process)
(import /stream/sort)
(import /string.h)
(import /time/clock)
(import /time/datetime)
(import /time/duration)
(import /time/timer)
(import /time/zone)
(import /unistd.h)
(blank)
(prop + bench-results-path _ (= ".tmp/results/bench"))
(prop _ bench-report-perms _ (= (/or/ user-read-perm user-write-perm group-read-perm other-read-perm)))
(prop + bench-last-run-name _ (= "last-run"))
(prop + bench-last-run-format _ (= 2))
(prop + bench-schema-version _ (= 1))
(blank)
(prop _ bench-lock-poll _ (= 10ms))
(prop _ bench-lock-limit U64 (= 30000000000))
(prop _ bench-read-size Size (= 0x10000))

(type + BenchSample (is Tuple)
  (prop + iteration Size)
  (prop + duration F64)
  (prop + status String)
  (prop + exit-code (? Int))
  (prop + signal (? String))
  (prop + stdout String)
  (prop + stderr String)
  (prop + artifact-path String)
  (prop + metrics-path String)
  (prop + probes-path String)
  (prop + data (? JSON))
)

(type + BenchResult (is Tuple)
  (prop + bench BenchCase)
  (prop + status String)
  (prop + checksum (? F64))
  (prop + result-line (? String))
  (prop + compile-samples (list BenchSample))
  (prop + run-samples (list BenchSample))
  (prop + values (list (list (? F64))))
  (prop + summaries (list BenchSummary))
  (prop + diagnostics (list String))
  (fn-expr + is-passed Bool :get
    (== status "passed")
  )
)

(type + BenchRunInfo (is Tuple)
  (prop + run-id String)
  (prop + started String)
  (prop + config BenchConfig)
  (prop + profile BenchProfile)
  (prop + selectors (list String))
  (prop + iterations Size)
  (prop + warmup Size)
  (prop + timeout U64)
  (prop + keeps Bool)
  (prop + save-name String)
  (prop + compare-name String)
  (prop + reason String)
  (prop + saved-by String)
)

(type + BenchDelta (is Tuple)
  (prop + baseline (? F64))
  (prop + current (? F64))
  (prop + delta (? F64))
  (prop + percent (? F64))
  (prop + direction String)
)

(type + BenchMatch (is Tuple)
  (prop + id String)
  (prop + baseline-status String)
  (prop + current-status String)
  (prop + deltas (list BenchDelta))
)

(type + BenchComparison (is Tuple)
  (prop + name String)
  (prop + path String)
  (prop + generated (? String))
  (prop + matches (list BenchMatch))
  (prop + current-only (list String))
  (prop + baseline-only (list String))
  (fn-do + match-of (? BenchMatch)
    (param id String)
    (for (in found matches)
      (return-if found (if (== (. found id) id)))
    )
    (return null)
  )
)

(type + BenchSavedRun (is Tuple)
  (prop + name String)
  (prop + path String)
  (prop + profile String)
  (prop + reason String)
  (prop + saved-by String)
  (prop + generated String)
)

(type + BenchRecord (is Tuple)
  (prop + id String)
  (prop + status String)
  (prop + summaries (map String BenchSummary))
  (prop + completed String)
  (prop + diagnostics (list String))
)

(fn-expr + bench-normalized-name String (?! Error)
  (param name String)
  (before
    (throw (call Error "A saved benchmark run name must not be empty") (if (== (call (. bare trim)) "")))
  )
  (call bench-sanitized bare)
  (where
    (lazy trimmed (call (. name trim)))
    (lazy bare (if-expr (call (. trimmed lowercased ends-with) ".json") ([] trimmed (..< 0 (- (. trimmed length) 5))) trimmed))
  )
)

(fn-expr + bench-saved-name String (?! Error)
  (param name String)
  (param profile String)
  (if-expr (call (. normalized ends-with) suffix) normalized (str normalized suffix))
  (where
    (lazy normalized (call bench-normalized-name name))
    (lazy suffix (str "-" (call bench-normalized-name profile)))
  )
)

(fn-expr + bench-saved-path String (?! Error)
  (param root String)
  (param name String)
  (str root "/" bench-results-path "/" (call bench-normalized-name name) ".json")
)

(fn-do + bench-sanitized String
  (param text String)
  (let result "")
  (let is-gap false)
  (for (in char text)
    (if (or is-letter (and (>= char '0') (<= char '9')) (== char '.') (== char '_') (== char '-'))
      (= result (str result char))
      (= is-gap false)
      (else-if (not is-gap)
        (= result (str result "-"))
        (= is-gap true)
      )
    )
    (lazy is-letter (or (and (>= char 'a') (<= char 'z')) (and (>= char 'A') (<= char 'Z'))))
  )
  (return result)
)

(fn-do + load-bench-baseline JSON (?! Error)
  (param root String)
  (param name String)
  (let path (call bench-saved-path root name))
  (let text
    (call read-file-text (call Path path 0)
      (block
        (on-error (: failure Error)
          (throw (call Error (str "Could not load saved benchmark result '" name "' at " path ": " (. failure message))))
        )
      )
    )
  )
  (let report
    (call parse-json text
      (block
        (on-error (: failure Error)
          (throw (call Error (str "Could not load saved benchmark result '" name "' at " path ": " (. failure message))))
        )
      )
    )
  )
  (throw (call Error (str "Could not load saved benchmark result '" name "' at " path ": saved result does not contain a results array")) (if (== (call bench-items (call bench-field "results" report)) null)))
  (return report)
)

(fn-do + bench-comparison BenchComparison (?! Error)
  (param root String)
  (param name String)
  (param baseline JSON)
  (param results (list BenchResult))
  (param metrics (list BenchMetric))
  (let by-id (map String JSON))
  (let baseline-ids (list String))
  (for (in item (?? (call bench-items (call bench-field "results" baseline)) (call (of List JSON))))
    (let id (call bench-string (call bench-field "id" item)))
    (if (!= id "")
      (= ([] by-id id) item)
      (+= baseline-ids id)
    )
  )
  (let matches (list BenchMatch))
  (let current-only (list String))
  (let current-ids (map String Bool))
  (for (in result results)
    (let id (. result bench id))
    (= ([] current-ids id) true)
    (let base ([] by-id id))
    (if (not base)
      (+= current-only id)
      (continue)
    )
    (let deltas (list BenchDelta))
    (for (in index (..< 0 (. metrics length)))
      (let prior (call bench-result-median base (. ([] metrics index) key)))
      (let later (. ([] (. result summaries) index) median))
      (+= deltas (call bench-delta prior later))
    )
    (+= matches (call BenchMatch id (call bench-string (call bench-field "status" base)) (. result status) deltas))
  )
  (let baseline-only (list String))
  (for (in id baseline-ids)
    (if (not ([] current-ids id))
      (+= baseline-only id)
    )
  )
  (let generated (call bench-string (call bench-field "generatedAt" baseline)))
  (return
    (call BenchComparison
      (block
        (arg (call bench-normalized-name name))
        (arg (call bench-saved-path root name))
        (arg (only-if generated (if (!= generated ""))))
        (arg matches)
        (arg current-only)
        (arg baseline-only)
      )
    )
  )
)

(fn-expr + bench-delta BenchDelta
  (param prior (? F64))
  (param later (? F64))
  (case? (or (not prior) (not later))
    (call BenchDelta prior later null null "unknown")
  )
  (default
    (call BenchDelta prior later delta percent direction)
  )
  (where
    (lazy delta (call bench-rounded (- later prior)))
    (lazy percent (? F64) (if-expr (== prior 0.0) null (call bench-rounded (* (/ delta prior) 100.0))))
    (lazy direction (if-expr (< delta 0.0) "better" (if-expr (> delta 0.0) "worse" "same")))
  )
)

(fn-do + save-bench-reports String (?! Error)
  (param info BenchRunInfo)
  (param results (list BenchResult))
  (param comparison (? BenchComparison))
  (let root (. info config root))
  (let generated (call bench-iso-time))
  (let repo (call bench-repo root))
  (let last-name (call bench-saved-name bench-last-run-name (. info profile name)))
  (let last-path (call bench-saved-path root last-name))
  (call (. (call Path (str root "/" bench-results-path) 0) make-directories))
  (call save-bench-last-run
    (block
      (arg last-path)
      (arg (call bench-report info results last-name last-path generated repo true null))
      (arg (. info profile name))
    )
  )
  (return-if last-path (if (== (. info save-name) last-name)))
  (let named-path (call bench-saved-path root (. info save-name)))
  (let named
    (call bench-report
      (block
        (arg info)
        (arg results)
        (arg (. info save-name))
        (arg named-path)
        (arg generated)
        (arg repo)
        (arg false)
        (arg comparison)
      )
    )
  )
  (throw (call Error (str "Benchmark report already exists: " (. info save-name) ".json")) (if (. (call Path named-path 0) exists)))
  (let file
    (call File
      (block
        (arg named-path)
        (arg (+ (. FileFlags write-mode) (. FileFlags create-mode) (. FileFlags exclusive-mode)))
        (arg bench-report-perms)
      )
    )
  )
  (do-use file
    (call (. file write) (str (call to-json named) "\n"))
  )
  (return named-path)
)

(fn-do _ save-bench-last-run _ (?! Error)
  (param path String)
  (param compact JSON)
  (param profile String)
  (let lock-path (str path ".lock"))
  (let started (call monotonic-time-nanoseconds))
  (let lock (? File))
  (while (not lock)
    (= lock
      (scope (catch? (call File lock-path lock-flags))
        (lazy lock-flags (+ (. FileFlags write-mode) (. FileFlags create-mode) (. FileFlags exclusive-mode)))
      )
    )
    (if (not lock)
      (throw (call Error (str "Timed out waiting for the benchmark report lock " lock-path)) (if (>= (- (call monotonic-time-nanoseconds) started) bench-lock-limit)))
      (call (. bench-lock-poll wait))
    )
  )
  (finally
    (catch (call (. (!! lock) close)))
    (catch (call (. (call Path lock-path 0) delete)))
  )
  (let existing (call bench-read-json path))
  (call write-file-atomically
    (block
      (arg (call Path path 0))
      (arg (str (call to-json (call bench-last-run compact profile existing)) "\n"))
      (arg bench-report-perms)
    )
  )
)

(fn-do + bench-saved-runs (list BenchSavedRun)
  (param root String)
  (param profile (? String))
  (let runs (list BenchSavedRun))
  (let directory (call Path (str root "/" bench-results-path) 0))
  (return-if runs (if (not (. directory exists))))
  (let names (list String))
  (for (in entry (. directory entries))
    (if (and (== (. entry kind) (. PathKind file)) (call (. entry name ends-with) ".json"))
      (+= names (. entry name))
    )
  )
  (for (in file-name names)
    (let path (str root "/" bench-results-path "/" file-name))
    (let report (call bench-read-json path))
    (if (not report)
      (continue)
    )
    (let options (call bench-field "options" report))
    (let owner (call bench-string (call bench-field "profile" options)))
    (let name ([] file-name (..< 0 (- (. file-name length) 5))))
    (if (or (== owner "") (not (call (. name ends-with) (str "-" owner))) (and profile (!= owner profile)) is-last-run)
      (continue)
    )
    (lazy is-last-run (== name (str bench-last-run-name "-" owner)))
    (+= runs
      (call BenchSavedRun
        (block
          (arg name)
          (arg path)
          (arg owner)
          (arg (call bench-string (call bench-field "reason" report)))
          (arg (call bench-string (call bench-field "savedBy" report)))
          (arg (call bench-string (call bench-field "generatedAt" report)))
        )
      )
    )
  )
  (return (call sort runs (:using (=> (a b) (if-expr (> (. a generated) (. b generated)) .lesser .greater)))))
)

(fn-do + load-bench-latest (map String BenchRecord) (?! Error)
  (param root String)
  (param profile String)
  (return
    (call bench-records
      (block
        (arg (call bench-read-json (call bench-saved-path root (call bench-saved-name bench-last-run-name profile))))
      )
    )
  )
)

(fn-do + load-bench-compared (map String BenchRecord) (?! Error)
  (param root String)
  (param name String)
  (param profile String)
  (return (call bench-records (call load-bench-baseline root (call bench-saved-name name profile))))
)

(fn-do + save-bench-comparison String (?! Error)
  (param root String)
  (param profile String)
  (param reason String)
  (let last-path (call bench-saved-path root (call bench-saved-name bench-last-run-name profile)))
  (let report (call bench-read-json last-path))
  (throw (call Error (str "No last run of " profile " to save")) (if (not report)))
  (let fields (call bench-fields-of report))
  (let results (list JSON))
  (for (in entry (?? (call bench-items ([] fields "retainedResults")) (call (of List JSON))))
    (let result (call bench-field "result" entry))
    (if result
      (+= results result)
    )
  )
  (for (in result (?? (call bench-items ([] fields "results")) (call (of List JSON))))
    (+= results result)
  )
  (let trimmed (call (. reason trim)))
  (let base
    (scope (if-expr (!= trimmed "") (call bench-sanitized trimmed) generated-base)
      (lazy generated-base (str "saved-" (call bench-digits (call bench-string ([] fields "generatedAt")))))
    )
  )
  (let name (call bench-saved-name base profile))
  (let suffix 2)
  (while (. (call Path (call bench-saved-path root name) 0) exists)
    (= name (call bench-saved-name (str base "-" suffix) profile))
    (+= suffix 1)
  )
  (let path (call bench-saved-path root name))
  (let passed 0)
  (for (in result results)
    (if (== (call bench-string (call bench-field "status" result)) "passed")
      (+= passed 1)
    )
  )
  (let summary (map String JSON))
  (= ([] summary "total") (. results length))
  (= ([] summary "passed") passed)
  (= ([] summary "failed") (- (. results length) passed))
  (let options (call bench-fields-of (?? ([] fields "options") (as null JSON))))
  (= ([] options "saveName") name)
  (= ([] options "reason") trimmed)
  (= ([] options "savedBy") "human")
  (-= ([] fields "lastRunReportFormat"))
  (-= ([] fields "retainedResults"))
  (= ([] fields "reason") trimmed)
  (= ([] fields "savedBy") "human")
  (= ([] fields "options") options)
  (= ([] fields "summary") summary)
  (= ([] fields "results") results)
  (= ([] fields "savedReportPath") path)
  (let file
    (call File
      (block
        (arg path)
        (arg (+ (. FileFlags write-mode) (. FileFlags create-mode) (. FileFlags exclusive-mode)))
        (arg bench-report-perms)
      )
    )
  )
  (do-use file
    (call (. file write) (str (call to-json (as fields JSON)) "\n"))
  )
  (return path)
)

(fn-do + archive-bench-run _ (?! Error)
  (param root String)
  (param name String)
  (let folder (str root "/" bench-results-path "/archive"))
  (call (. (call Path folder 0) make-directories))
  (call (. (call Path (call bench-saved-path root name) 0) move) (call Path (str folder "/" (call bench-normalized-name name) ".json") 0))
)

(fn-do + bench-unsaved-profiles (list String)
  (param root String)
  (param runs (list BenchSavedRun))
  (let unsaved (list String))
  (let directory (call Path (str root "/" bench-results-path) 0))
  (return-if unsaved (if (not (. directory exists))))
  (let prefix (str bench-last-run-name "-"))
  (for (in entry (. directory entries))
    (if (or (!= (. entry kind) (. PathKind file)) (not (call (. entry name starts-with) prefix)) (not is-json))
      (continue)
    )
    (lazy is-json (call (. entry name ends-with) ".json"))
    (let report (call bench-read-json (str root "/" bench-results-path "/" (. entry name))))
    (let profile (call bench-string (call bench-field "profile" (call bench-field "options" report))))
    (let generated (call bench-string (call bench-field "generatedAt" report)))
    (if (or (== profile "") (== generated ""))
      (continue)
    )
    (let copied false)
    (for (in run runs)
      (= copied (or copied (and (== (. run profile) profile) (== (. run generated) generated))))
    )
    (if (not copied)
      (+= unsaved profile)
    )
  )
  (return unsaved)
)

(fn-do _ bench-digits String
  (param text String)
  (let digits "")
  (for (in char text)
    (if (and (>= char '0') (<= char '9'))
      (= digits (str digits char))
    )
  )
  (return (if-expr (> (. digits length) 14) ([] digits (..< 0 14)) digits))
)

(fn-do + bench-records (map String BenchRecord)
  (param report (? JSON))
  (let records (map String BenchRecord))
  (return-if records (if (not report)))
  (for (in key (call (of List String) "retainedResults" "results"))
    (for (in item (?? (call bench-items (call bench-field key report)) (call (of List JSON))))
      (let id (call bench-string (call bench-field "id" item)))
      (if (!= id "")
        (= ([] records id) (call bench-record id item))
      )
    )
  )
  (return records)
)

(fn-do + bench-result-record BenchRecord
  (param result BenchResult)
  (param metrics (list BenchMetric))
  (param completed String)
  (let summaries (map String BenchSummary))
  (for (in index (..< 0 (. metrics length)))
    (if (< index (. result summaries length))
      (= ([] summaries (. ([] metrics index) key)) ([] (. result summaries) index))
    )
  )
  (return (call BenchRecord (. result bench id) (. result status) summaries completed (. result diagnostics)))
)

(fn-do + bench-iso-time String
  (let now (call clock))
  (let time (call DateTime (. now s) utc))
  (let milliseconds (/ (as (. now ns) U64) 1000000))
  (let fraction (str milliseconds))
  (while (< (. fraction length) 3)
    (= fraction (str "0" fraction))
  )
  (return (str (call (. time year pad) 4) "-" (call (. (+ (. time month number) 1) pad) 2) "-" (call (. (+ (. time day number) 1) pad) 2) "T" (call (. time hour pad) 2) ":" (call (. time minute pad) 2) ":" (call (. time second pad) 2) "." fraction "Z"))
)

(fn-do + bench-run-id String
  (let now (call clock))
  (return
    (scope (str "benchmarks-" milliseconds "-" (call C:getpid) (% (call monotonic-time-nanoseconds) 1000000))
      (lazy milliseconds (+ (* (as (. now s) U64) 1000) (/ (as (. now ns) U64) 1000000)))
    )
  )
)

(fn-do + bench-sample-json JSON
  (param sample BenchSample)
  (param source BenchSource)
  (param is-compact Bool)
  (let fields (map String JSON))
  (= ([] fields "iteration") (. sample iteration))
  (= ([] fields "durationMs") (. sample duration))
  (= ([] fields "status") (. sample status))
  (= ([] fields "exitCode") (if-expr (. sample exit-code) (as (. sample exit-code) JSON) (as null JSON)))
  (= ([] fields "signal") (if-expr (. sample signal) (as (. sample signal) JSON) (as null JSON)))
  (if is-compact
    (if (and (!= (. sample status) "passed") (!= (. sample stdout) ""))
      (= ([] fields "stdout") (. sample stdout))
    )
    (if (and (!= (. sample status) "passed") (!= (. sample stderr) ""))
      (= ([] fields "stderr") (. sample stderr))
    )
    (return fields)
  )
  (= ([] fields "stdout") (. sample stdout))
  (= ([] fields "stderr") (. sample stderr))
  (= ([] fields "artifactPath") (. sample artifact-path))
  (if (== source (. BenchSource compile))
    (if (!= (. sample probes-path) "")
      (= ([] fields "probesPath") (. sample probes-path))
      (= ([] fields "compilerMetrics") (?? (. sample data) (as null JSON)))
    )
    (return fields)
  )
  (= ([] fields "metricsPath") (. sample metrics-path))
  (if (!= (. sample probes-path) "")
    (= ([] fields "probesPath") (. sample probes-path))
  )
  (= ([] fields "metrics") (?? (. sample data) (as null JSON)))
  (return fields)
)

(fn-do + bench-field (? JSON)
  (param key String)
  (param value (? JSON))
  (return-if null (if (not value)))
  (match value
    (case (: fields (map String JSON))
      (return ([] fields key))
    )
    (default
      (return null)
    )
  )
)

(fn-do + bench-items (? (list JSON))
  (param value (? JSON))
  (return-if null (if (not value)))
  (match value
    (case (: items (list JSON))
      (return items)
    )
    (default
      (return null)
    )
  )
)

(fn-do + bench-string String
  (param value (? JSON))
  (return-if "" (if (not value)))
  (match value
    (case (: text String)
      (return text)
    )
    (default
      (return "")
    )
  )
)

(fn-expr + bench-result-median (? F64)
  (param result JSON)
  (param key String)
  (call bench-json-number (call bench-field "median" summary))
  (where
    (lazy summary (?? (call bench-field key (call bench-field "summaries" result)) (call bench-field key (call bench-field "profileMetricSummaries" result))))
  )
)

(fn-do _ bench-report JSON
  (param info BenchRunInfo)
  (param results (list BenchResult))
  (param save-name String)
  (param saved-path String)
  (param generated String)
  (param repo JSON)
  (param is-compact Bool)
  (param comparison (? BenchComparison))
  (let config (. info config))
  (let profile (. info profile))
  (let options (map String JSON))
  (= ([] options "allocator") "gc")
  (= ([] options "iterations") (. info iterations))
  (= ([] options "warmup") (. info warmup))
  (= ([] options "timeoutMs") (as (. info timeout) JSON))
  (= ([] options "keep") (. info keeps))
  (= ([] options "configPath") (. config path))
  (= ([] options "profile") (. profile name))
  (= ([] options "defaultProfileName") (. config default-profile))
  (= ([] options "benchmarkMetrics") (. profile has-benchmark-metrics))
  (= ([] options "setupCommand") (?? (. profile setup) ""))
  (= ([] options "metricColumns") (call bench-metric-columns (. profile metrics)))
  (= ([] options "compilerProbes") (. profile compiler-probe-selectors))
  (= ([] options "runExecutable") (. profile runs-executable))
  (= ([] options "runtimeProbes") (. profile probe-selectors))
  (= ([] options "saveName") save-name)
  (= ([] options "compareName") (. info compare-name))
  (= ([] options "reason") (. info reason))
  (= ([] options "savedBy") (. info saved-by))
  (let passed 0)
  (let listed (list JSON))
  (for (in result results)
    (if (. result is-passed)
      (+= passed 1)
    )
    (+= listed (call bench-result-json result (. profile metrics) generated is-compact))
  )
  (let summary (map String JSON))
  (= ([] summary "total") (. results length))
  (= ([] summary "passed") passed)
  (= ([] summary "failed") (- (. results length) passed))
  (let environment (map String JSON))
  (= ([] environment "runner") "brix")
  (= ([] environment "hostname") (call bench-hostname))
  (let report (map String JSON))
  (= ([] report "schemaVersion") bench-schema-version)
  (= ([] report "runId") (. info run-id))
  (= ([] report "startedAt") (. info started))
  (= ([] report "generatedAt") generated)
  (= ([] report "projectRoot") (. config root))
  (= ([] report "selectors") (call bench-string-list (. info selectors)))
  (= ([] report "reason") (. info reason))
  (= ([] report "savedBy") (. info saved-by))
  (= ([] report "repo") repo)
  (= ([] report "environment") environment)
  (= ([] report "options") options)
  (= ([] report "summary") summary)
  (= ([] report "results") listed)
  (if comparison
    (= ([] report "comparison") (call bench-comparison-json comparison (. profile metrics)))
  )
  (= ([] report "savedReportPath") saved-path)
  (return report)
)

(fn-do _ bench-result-json JSON
  (param result BenchResult)
  (param metrics (list BenchMetric))
  (param generated String)
  (param is-compact Bool)
  (let bench (. result bench))
  (let fields (map String JSON))
  (= ([] fields "suite") (. bench suite name))
  (= ([] fields "caseName") (. bench case-name))
  (= ([] fields "id") (. bench id))
  (= ([] fields "description") (. bench description))
  (= ([] fields "tags") (call bench-string-list (. bench tags)))
  (= ([] fields "sourcePath") (. bench source-path))
  (= ([] fields "relativePath") (. bench relative-path))
  (= ([] fields "allocator") "gc")
  (= ([] fields "status") (. result status))
  (= ([] fields "checksum") (call bench-checksum-json (. result checksum)))
  (= ([] fields "resultLine") (if-expr (. result result-line) (as (. result result-line) JSON) (as null JSON)))
  (let compile-samples (list JSON))
  (for (in sample (. result compile-samples))
    (+= compile-samples (call bench-sample-json sample (. BenchSource compile) is-compact))
  )
  (let run-samples (list JSON))
  (for (in sample (. result run-samples))
    (+= run-samples (call bench-sample-json sample (. BenchSource run) is-compact))
  )
  (= ([] fields "compileSamples") compile-samples)
  (= ([] fields "runSamples") run-samples)
  (let summaries (map String JSON))
  (let samples (map String JSON))
  (for (in index (..< 0 (. metrics length)))
    (= ([] summaries (. ([] metrics index) key)) (call bench-summary-json ([] (. result summaries) index)))
    (let values (list JSON))
    (for (in value ([] (. result values) index))
      (+= values (call bench-number-json value))
    )
    (= ([] samples (. ([] metrics index) key)) values)
  )
  (if (not is-compact)
    (= ([] fields "metricSamples") samples)
  )
  (= ([] fields "summaries") summaries)
  (= ([] fields "profileMetricSummaries") (call (of Map String JSON)))
  (= ([] fields "diagnostics") (call bench-string-list (. result diagnostics)))
  (= ([] fields "completedAt") generated)
  (return fields)
)

(fn-expr _ bench-checksum-json JSON
  (param checksum (? F64))
  (case? (not checksum)
    (as null JSON)
  )
  (default
    (as checksum JSON)
  )
)

(fn-do _ bench-metric-columns JSON
  (param metrics (list BenchMetric))
  (let columns (list JSON))
  (for (in metric metrics)
    (let column (map String JSON))
    (= ([] column "key") (. metric key))
    (= ([] column "title") (. metric title))
    (= ([] column "description") (. metric description))
    (= ([] column "format") (call bench-format-name (. metric format)))
    (= ([] column "source") (call bench-source-name (. metric source)))
    (= ([] column "sampleDuration") (. metric is-timing))
    (if (. metric min-width)
      (= ([] column "minWidth") (. metric min-width))
    )
    (+= columns column)
  )
  (return columns)
)

(fn-do _ bench-comparison-json JSON
  (param comparison BenchComparison)
  (param metrics (list BenchMetric))
  (let results (list JSON))
  (for (in found (. comparison matches))
    (let deltas (map String JSON))
    (for (in index (..< 0 (. metrics length)))
      (let delta ([] (. found deltas) index))
      (let fields (map String JSON))
      (= ([] fields "baseline") (call bench-number-json (. delta baseline)))
      (= ([] fields "current") (call bench-number-json (. delta current)))
      (= ([] fields "delta") (call bench-number-json (. delta delta)))
      (= ([] fields "deltaPct") (call bench-number-json (. delta percent)))
      (= ([] fields "direction") (. delta direction))
      (= ([] deltas (. ([] metrics index) key)) fields)
    )
    (let entry (map String JSON))
    (= ([] entry "id") (. found id))
    (= ([] entry "baselineStatus") (. found baseline-status))
    (= ([] entry "currentStatus") (. found current-status))
    (= ([] entry "metrics") deltas)
    (+= results entry)
  )
  (let fields (map String JSON))
  (= ([] fields "baselineName") (. comparison name))
  (= ([] fields "baselinePath") (. comparison path))
  (= ([] fields "baselineGeneratedAt") (if-expr (. comparison generated) (as (. comparison generated) JSON) (as null JSON)))
  (= ([] fields "matched") (. comparison matches length))
  (= ([] fields "currentOnly") (call bench-string-list (. comparison current-only)))
  (= ([] fields "baselineOnly") (call bench-string-list (. comparison baseline-only)))
  (= ([] fields "results") results)
  (return fields)
)

(fn-do _ bench-last-run JSON
  (param current JSON)
  (param profile String)
  (param existing (? JSON))
  (let retained (map String JSON))
  (let order (list String))
  (if (and existing (== (call bench-number-of (call bench-field "lastRunReportFormat" existing)) bench-last-run-format) (== (call bench-string (call bench-field "profile" (call bench-field "options" existing))) profile))
    (for (in entry (?? (call bench-items (call bench-field "retainedResults" existing)) (call (of List JSON))))
      (let id (call bench-string (call bench-field "id" (call bench-field "result" entry))))
      (if (and (!= id "") (call bench-is-object (call bench-field "result" entry)) has-origin)
        (if (not ([] retained id))
          (+= order id)
        )
        (= ([] retained id) entry)
      )
      (lazy has-origin (call bench-is-object (call bench-field "origin" entry)))
    )
    (for (in result (?? (call bench-items (call bench-field "results" existing)) (call (of List JSON))))
      (let id (call bench-string (call bench-field "id" result)))
      (if (!= id "")
        (if (not ([] retained id))
          (+= order id)
        )
        (= ([] retained id) (call bench-retained existing result))
      )
    )
  )
  (let fresh (map String Bool))
  (for (in result (?? (call bench-items (call bench-field "results" current)) (call (of List JSON))))
    (= ([] fresh (call bench-string (call bench-field "id" result))) true)
  )
  (let kept (list JSON))
  (for (in id order)
    (if (not ([] fresh id))
      (+= kept (!! ([] retained id)))
    )
  )
  (let fields (call bench-fields-of current))
  (= ([] fields "lastRunReportFormat") bench-last-run-format)
  (= ([] fields "retainedResults") kept)
  (return fields)
)

(fn-do _ bench-retained JSON
  (param report JSON)
  (param result JSON)
  (let generated (?? (call bench-field "generatedAt" report) (as (call bench-iso-time) JSON)))
  (let origin (map String JSON))
  (= ([] origin "runId") (call bench-string (call bench-field "runId" report)))
  (= ([] origin "selectors") (?? (call bench-field "selectors" report) (as (call (of List JSON)) JSON)))
  (= ([] origin "startedAt") (?? (call bench-field "startedAt" report) generated))
  (= ([] origin "generatedAt") generated)
  (= ([] origin "completedAt") (?? (call bench-field "completedAt" result) generated))
  (= ([] origin "options") (?? (call bench-field "options" report) (as (call (of Map String JSON)) JSON)))
  (= ([] origin "repo") (?? (call bench-field "repo" report) (as null JSON)))
  (let entry (map String JSON))
  (= ([] entry "result") result)
  (= ([] entry "origin") origin)
  (return entry)
)

(fn-do _ bench-fields-of (map String JSON)
  (param value JSON)
  (let fields (map String JSON))
  (match value
    (case (: found (map String JSON))
      (for (in (tuple key item) found)
        (= ([] fields key) item)
      )
    )
    (default
      (return fields)
    )
  )
  (return fields)
)

(fn-do _ bench-is-object Bool
  (param value (? JSON))
  (return-if false (if (not value)))
  (match value
    (case (: fields (map String JSON))
      (return true)
    )
    (default
      (return false)
    )
  )
)

(fn-expr _ bench-number-of (? Int)
  (param value (? JSON))
  (only-if (as number Int) (if number))
  (where
    (lazy number (call bench-json-number value))
  )
)

(fn-do _ bench-record BenchRecord
  (param id String)
  (param item JSON)
  (let summaries (map String BenchSummary))
  (let listed (call bench-field "summaries" item))
  (if listed
    (match? listed
      (case (: fields (map String JSON))
        (for (in (tuple key value) fields)
          (let summary (call bench-summary-of value))
          (if summary
            (= ([] summaries key) summary)
          )
        )
      )
    )
  )
  (let diagnostics (list String))
  (for (in entry (?? (call bench-items (call bench-field "diagnostics" item)) (call (of List JSON))))
    (+= diagnostics (call bench-string entry))
  )
  (return
    (call BenchRecord
      (block
        (arg id)
        (arg (call bench-string (call bench-field "status" item)))
        (arg summaries)
        (arg (call bench-string (call bench-field "completedAt" item)))
        (arg diagnostics)
      )
    )
  )
)

(fn-do _ bench-string-list JSON
  (param values (list String))
  (let items (list JSON))
  (for (in value values)
    (+= items value)
  )
  (return items)
)

(fn-do _ bench-repo JSON
  (param root String)
  (let fields (map String JSON))
  (let branch (call bench-git root (call (of List String) "rev-parse" "--abbrev-ref" "HEAD")))
  (let commit (call bench-git root (call (of List String) "rev-parse" "HEAD")))
  (let status (call bench-git root (call (of List String) "status" "--short")))
  (= ([] fields "branch") (if-expr branch (as branch JSON) (as null JSON)))
  (= ([] fields "commit") (if-expr commit (as commit JSON) (as null JSON)))
  (= ([] fields "dirty") (and (!= status null) (!= status "")))
  (return fields)
)

(fn-do _ bench-git (? String)
  (param root String)
  (param arguments (list String))
  (let child (catch? (call Process "git" (. ProcessStderr discard) arguments root)))
  (return-if null (if (not child)))
  (let chunk ([] Byte bench-read-size))
  (let output "")
  (while true
    (let count (call bench-read-chunk child chunk))
    (if (== count 0)
      (break)
    )
    (= output (str output (call (. chunk slice-string) (..< 0 count))))
  )
  (let status (?? (call (. child wait) null) -1))
  (catch (call (. child close)))
  (return (only-if (call (. output trim)) (if (== status 0))))
)

(fn-do _ bench-hostname String
  (let buffer ([] Byte 256))
  (return-if "" (if (!= (call C:gethostname (. buffer data) 255) 0)))
  (return (call (. buffer slice-string) (..< 0 (call C:strlen (. buffer data)))))
)

(fn-do + bench-read-json (? JSON)
  (param path String)
  (let found (call Path path 0))
  (return-if null (if (not (. found exists))))
  (let text (catch? (call read-file-text found)))
  (return-if null (if (not text)))
  (return (catch? (call parse-json text)))
)

(fn-do + bench-read-chunk Size
  (param source ByteReadable)
  (param chunk ([] Byte))
  (return
    (call (. source read) (. chunk size) chunk
      (block
        (on-error (: failure Error)
          (return 0)
        )
      )
    )
  )
)
