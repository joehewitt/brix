(import ./../command-template)
(import /data/json)
(import /os/env)
(import /os/file)
(import /os/path)
(import /os/shell)
(import /stream/aggregate)
(import /stream/sort)
(blank)
(prop + bench-config-path _ (= ".brix/benchmarks.json"))
(prop + bench-default-timeout U64 (= 180000))
(prop + bench-setup-timeout U64 (= 300000))
(prop + bench-build-path _ (= ".tmp/bench"))
(blank)
(prop _ bench-default-brix (list String) (= (list "brix")))
(prop _ bench-folder-name _ (= "bench"))
(prop _ bench-fixtures-name _ (= "fixtures"))
(prop _ bench-default-extensions (list String) (= (list ".bx")))
(prop _ bench-compile-command _ (= "compile"))
(prop _ bench-launch-command _ (= "launch"))
(blank)
(type-line + BenchUnconfiguredError (is Error))

(type + BenchConfig (is Tuple)
  (prop + root String)
  (prop + path String)
  (prop + variables (list TargetVariable))
  (prop + suites (list BenchSuite))
  (prop + metrics (list BenchMetric))
  (prop + profiles (list BenchProfile))
  (prop + commands (map String BenchCommand))
  (prop + default-profile String)
  (fn-do + profile BenchProfile (?! Error)
    (param name String)
    (let wanted (. (call (. name trim)) lowercased))
    (for (in profile profiles)
      (return-if profile (if (== (. profile name lowercased) wanted)))
    )
    (let names (list String))
    (for (in profile profiles)
      (+= names (. profile name))
    )
    (throw (call Error (str "Unknown benchmark profile " name "; the profiles are " (call (. ", " join) names))))
  )
  (fn-do + suite (? BenchSuite)
    (param name String)
    (for (in suite suites)
      (return-if suite (if (== (. suite name) name)))
    )
    (return null)
  )
  (fn-do + step TargetStep (?! Error)
    (param name String)
    (param profile BenchProfile)
    (param values (map String String))
    (let command ([] commands name))
    (throw (call Error (str "No command " name " in " bench-config-path)) (if (not command)))
    (call await-login-shell-environment)
    (let settings (call (of Map String String)))
    (for (in (tuple key value) (call environment))
      (= ([] settings key) value)
    )
    (call apply-variables settings variables values)
    (let local (call (of Map String String)))
    (for (in (tuple key value) values)
      (= ([] local key) value)
    )
    (= ([] local "root") (. command folder))
    (= ([] local "build") (call bench-build (. command folder) profile))
    (call apply-variables settings (. command variables) local)
    (let arguments (call expand-arguments (. command run) local))
    (if (> (. profile probes length) 0)
      (++= arguments (call expand-arguments (. command probes) local))
    )
    (return (call TargetStep arguments settings))
  )
)

(type + BenchFormat (is Union)
  (variant duration)
  (variant count)
  (variant bytes)
  (variant percent)
  (variant rate)
)

(type + BenchSource (is Union)
  (variant compile)
  (variant run)
)

(type + BenchExtractor (is Union)
  (variant value (tuple (: pointer String)))
  (variant sum (tuple (: pointers (list String))))
  (variant child-sum (tuple (: pointer String) (: field String)))
  (variant ratio (tuple (: numerator String) (: denominator String) (: denominators (list String)) (: scale F64)))
)

(type + BenchMetric (is Tuple)
  (prop + key String)
  (prop + title String)
  (prop + description String)
  (prop + format BenchFormat)
  (prop + source BenchSource)
  (prop + extractor BenchExtractor)
  (prop + is-timing Bool)
  (prop + min-width (? Size))
)

(type + BenchProfile (is Tuple)
  (prop + name String)
  (prop + description String)
  (prop + is-default Bool)
  (prop + metrics (list BenchMetric))
  (prop + compiler-probes (list String))
  (prop + has-benchmark-metrics Bool)
  (prop + setup (? String))
  (prop + probes (list String))
  (prop + default-selectors (list String))
  (prop + runs-executable Bool)
  (fn-expr + uses-timing-samples Bool :get
    (call some metrics (:where (. each is-timing)))
  )
  (fn-expr + probe-selectors String :get
    (call (. "," join) probes)
  )
  (fn-expr + compiler-probe-selectors String :get
    (call (. "," join) compiler-probes)
  )
)

(type + BenchSuite (is Tuple)
  (prop + name String)
  (prop + path String)
  (prop + compile String)
  (prop + run String)
  (prop + extensions (list String))
  (prop + description String)
)

(type + BenchCommand (is Tuple)
  (prop + name String)
  (prop + run (list String))
  (prop + variables (list TargetVariable))
  (prop + probes (list String))
  (prop + folder String)
)

(fn-expr + bench-build String
  (param folder String)
  (param profile BenchProfile)
  (if-expr (. profile has-benchmark-metrics) (str folder "/" bench-build-path) (str folder "/.tmp/build"))
)

(fn-do + load-bench-config BenchConfig (?! Error)
  (param root String)
  (let path (call Path (str root "/" bench-config-path) 0))
  (let file (call bench-file path bench-config-path))
  (let files (list BenchFile))
  (+= files (call BenchFile file bench-config-path root false))
  (for (in config (call nested-configs root bench-config-path))
    (let nested (call bench-file (call Path (str (. config folder) "/" bench-config-path) 0) (. config label)))
    (+= files (call BenchFile nested (. config label) (. config folder) true))
  )
  (let brix (if-expr (call (. file has) "brix") (call target-arguments ([] file "brix")) bench-default-brix))
  (let commands (call built-in-bench-commands brix root))
  (let owners (map String String))
  (for (in each files)
    (call add-bench-commands commands owners each)
  )
  (let suites (list BenchSuite))
  (if (call some files (:where (call (. each file has) "suites")))
    (let places (map String String))
    (for (in each files)
      (call add-bench-suites suites places each commands)
    )
    (else
      (= suites (call found-bench-suites root))
      (if (and (== (. suites length) 0) (not (. path exists)) (== (. files length) 1))
        (throw
          (call BenchUnconfiguredError
            (block
              (arg
                (paragraph
                  (str root " has no benchmarks: no folder inside a " bench-folder-name " folder, and no " bench-config-path)
                )
              )
            )
          )
        )
      )
    )
  )
  (let metrics (call built-in-bench-metrics))
  (let by-key (map String BenchMetric))
  (for (in metric metrics)
    (= ([] by-key (. metric key)) metric)
  )
  (for (in each files)
    (if (call (. each file has) "metrics")
      (for (in item (call (. ([] (. each file) "metrics") items)))
        (let metric (call bench-metric (call (. item object))))
        (throw (call Error (str "Metric " (. metric key) " in " (. each label) " appears twice or is built in")) (if ([] by-key (. metric key))))
        (= ([] by-key (. metric key)) metric)
        (+= metrics metric)
      )
    )
  )
  (let listed (list BenchProfile))
  (let extensions (list BenchExtension))
  (let defined (map String String))
  (for (in each files)
    (call add-bench-profiles listed extensions defined each by-key commands)
  )
  (let profiles (call built-in-bench-profiles by-key (not (call some listed (:where (. each is-default))))))
  (++= profiles listed)
  (call extend-bench-profiles profiles extensions)
  (call check-bench-config root suites metrics profiles)
  (let default-profile (. ([] profiles 0) name))
  (for (in profile profiles)
    (if (. profile is-default)
      (= default-profile (. profile name))
      (break)
    )
  )
  (let variables (if-expr (call (. file has) "env") (call target-variables ([] file "env")) (call (of List TargetVariable))))
  (return
    (call BenchConfig
      (block
        (arg root)
        (arg (str root "/" bench-config-path))
        (arg variables)
        (arg suites)
        (arg metrics)
        (arg profiles)
        (arg commands)
        (arg default-profile)
      )
    )
  )
)

(fn-do + ordered-bench-profiles (list BenchProfile)
  (param config BenchConfig)
  (let ordered (list BenchProfile))
  (for (in profile (. config profiles))
    (if (. profile is-default)
      (+= ordered profile)
    )
  )
  (for (in profile (. config profiles))
    (if (not (. profile is-default))
      (+= ordered profile)
    )
  )
  (return ordered)
)

(fn-do + bench-normalized-path String
  (param text String)
  (let parts (list String))
  (for (in part (call (. text split) "/"))
    (if (or (== part "") (== part "."))
      (continue)
    )
    (if (and (== part "..") (> (. parts length) 0) (!= ([] parts (- (. parts length) 1)) ".."))
      (call (. parts pop))
      (else
        (+= parts part)
      )
    )
  )
  (let joined (call (. "/" join) parts))
  (return (if-expr (call (. text starts-with) "/") (str "/" joined) joined))
)

(fn-expr + bench-format-name String
  (param format BenchFormat)
  (match format
    (case .duration
      "duration"
    )
    (case .count
      "count"
    )
    (case .bytes
      "bytes"
    )
    (case .percent
      "percent"
    )
    (case .rate
      "rate"
    )
  )
)

(fn-expr + bench-source-name String
  (param source BenchSource)
  (if-expr (== source (. BenchSource compile)) "compile" "run")
)

(fn-do + bench-commas (list String)
  (param text String)
  (let values (list String))
  (return-if values (if (== (call (. text trim)) "")))
  (for (in part (call (. text split) ","))
    (let trimmed (call (. part trim)))
    (if (!= trimmed "")
      (+= values trimmed)
    )
  )
  (return values)
)

(type _ BenchFile (is Tuple)
  (prop + file JSONObjectReader)
  (prop + label String)
  (prop + folder String)
  (prop + is-nested Bool)
)

(type _ BenchExtension (is Tuple)
  (prop + name String)
  (prop + label String)
  (prop + metrics (list BenchMetric))
)

(fn-do _ bench-file JSONObjectReader (?! Error)
  (param path Path)
  (param label String)
  (let text (if-expr (. path exists) (call read-file-text path) "{}"))
  (return (call (. (call JSONReader label (call parse-json text)) object)))
)

(fn-do _ add-bench-suites _ (?! Error)
  (param suites (list BenchSuite))
  (param places (map String String))
  (param source BenchFile)
  (param commands (map String BenchCommand))
  (return-if (if (not (call (. source file has) "suites"))))
  (for (in item (call (. ([] (. source file) "suites") items)))
    (let suite (call bench-suite (. source folder) (call (. item object)) commands))
    (let other ([] places (. suite name)))
    (throw (call Error (str "Suite " (. suite name) " appears twice in " (call config-places other (. source label)))) (if other))
    (= ([] places (. suite name)) (. source label))
    (+= suites suite)
  )
)

(fn-do _ add-bench-profiles _ (?! Error)
  (param listed (list BenchProfile))
  (param extensions (list BenchExtension))
  (param defined (map String String))
  (param source BenchFile)
  (param by-key (map String BenchMetric))
  (param commands (map String BenchCommand))
  (return-if (if (not (call (. source file has) "profiles"))))
  (for (in item (call (. ([] (. source file) "profiles") items)))
    (let entry (call (. item object)))
    (if (not (call (. entry has) "description"))
      (+= extensions (call bench-extension entry by-key (. source label)))
      (continue)
    )
    (let profile (call bench-profile entry by-key commands))
    (let other ([] defined (. profile name)))
    (throw (call Error (str "Profile " (. profile name) " appears twice in " (call config-places other (. source label)))) (if other))
    (= ([] defined (. profile name)) (. source label))
    (+= listed profile)
  )
)

(fn-do _ add-bench-commands _ (?! Error)
  (param commands (map String BenchCommand))
  (param owners (map String String))
  (param source BenchFile)
  (return-if (if (not (call (. source file has) "commands"))))
  (let shared
    (scope (if-expr has-env (call target-variables ([] (. source file) "env")) (call (of List TargetVariable)))
      (lazy has-env (and (. source is-nested) (call (. source file has) "env")))
    )
  )
  (for (in (tuple name value) (. (call (. ([] (. source file) "commands") object)) fields))
    (throw (call Error (str "Command " name " in " (. source label) " is built in; give it another name")) (if (or (== name bench-compile-command) (== name bench-launch-command))))
    (let other ([] owners name))
    (throw (call Error (str "Command " name " appears twice in " (call config-places other (. source label)))) (if other))
    (= ([] owners name) (. source label))
    (= ([] commands name)
      (call bench-command
        (block
          (arg name)
          (arg (call (. (call JSONReader (str (. source label) " commands." name) value) object)))
          (arg (. source folder))
          (arg shared)
        )
      )
    )
  )
)

(fn-do _ bench-extension BenchExtension (?! Error)
  (param entry JSONObjectReader)
  (param by-key (map String BenchMetric))
  (param label String)
  (let name (call (. ([] entry "id") string)))
  (for (in (tuple key _) (. entry fields))
    (throw (call Error (str "Profile " name " in " label " has no description, so it can only add metrics")) (if (and (!= key "id") (!= key "metrics"))))
  )
  (let metrics (list BenchMetric))
  (for (in key (call bench-strings entry "metrics"))
    (let metric ([] by-key key))
    (throw (call Error (str "Benchmark profile " name " in " label " references unknown metric " key)) (if (not metric)))
    (+= metrics metric)
  )
  (return (call BenchExtension name label metrics))
)

(fn-do _ extend-bench-profiles _ (?! Error)
  (param profiles (list BenchProfile))
  (param extensions (list BenchExtension))
  (for (in extension extensions)
    (let name (. extension name))
    (let label (. extension label))
    (let index (call bench-profile-index profiles name))
    (throw (call Error (str "Profile " name " in " label " has no description, and no other config defines it")) (if (== index null)))
    (let profile ([] profiles index))
    (let metrics (. profile metrics))
    (for (in metric (. extension metrics))
      (throw (call Error (str "Profile " name " in " label " adds metric " (. metric key) ", which it already shows")) (if (call some metrics (:where (== (. each key) (. metric key))))))
      (+= metrics metric)
    )
    (let runs (call some (. extension metrics) (:where (== (. each source) (. BenchSource run)))))
    (= ([] profiles index)
      (call BenchProfile
        (block
          (arg (. profile name))
          (arg (. profile description))
          (arg (. profile is-default))
          (arg metrics)
          (arg (. profile compiler-probes))
          (arg (. profile has-benchmark-metrics))
          (arg (. profile setup))
          (arg (. profile probes))
          (arg (. profile default-selectors))
          (arg (or (. profile runs-executable) runs))
        )
      )
    )
  )
)

(fn-do _ bench-profile-index (? Index)
  (param profiles (list BenchProfile))
  (param name String)
  (for (in index (..< 0 (. profiles length)))
    (return-if index (if (== (. ([] profiles index) name) name)))
  )
  (return null)
)

(fn-do _ built-in-bench-commands (map String BenchCommand)
  (param brix (list String))
  (param root String)
  (let commands (map String BenchCommand))
  (= ([] commands bench-compile-command)
    (call BenchCommand
      (block
        (arg bench-compile-command)
        (arg compile)
        (arg (call (of List TargetVariable)))
        (arg (list "--probes" "\${probes}"))
        (arg root)
      )
    )
  )
  (= ([] commands bench-launch-command)
    (call BenchCommand
      (block
        (arg bench-launch-command)
        (arg launch)
        (arg launch-variables)
        (arg (call (of List String)))
        (arg root)
      )
    )
  )
  (return commands)
  (blank)
  (lazy compile (list String)
    (block
      (spread brix)
      (item "\${source}")
      (item "--compile")
      (item "-o")
      (item "\${artifact}")
    )
  )
  (lazy launch (list String)
    (block
      (spread brix)
      (item "bench")
      (item "launch")
      (item "\${artifact}")
    )
  )
  (lazy launch-variables (list TargetVariable)
    (block
      (item (call TargetVariable "PROBES_ENABLED" "\${probes}"))
      (item (call TargetVariable "PROBES_PATH" "\${trace}"))
      (item (call TargetVariable "BRIX_BENCH_METRICS_PATH" "\${metrics}"))
    )
  )
)

(fn-expr _ built-in-bench-metrics (list BenchMetric)
  metrics
  (where
    (lazy metrics (list BenchMetric)
      (block
        (item
          (call run-metric
            (block
              (arg "runMs")
              (arg "Run")
              (arg
                (paragraph
                  "Median wall time of the benchmark process from creation to exit across warm launches, after one discarded launch."
                )
              )
              (arg (. BenchFormat duration))
              (arg "/metrics/process/wallMs")
              (arg true)
            )
          )
        )
        (item
          (call run-metric
            (block
              (arg "runCpuMs")
              (arg "Run CPU")
              (arg "Median user plus system CPU time of the benchmark process across warm launches.")
              (arg (. BenchFormat duration))
              (arg "/metrics/process/cpuMs")
              (arg false)
            )
          )
        )
        (item
          (call run-metric
            (block
              (arg "runInstructions")
              (arg "Run instr")
              (arg "Median instructions retired by the benchmark process across warm launches.")
              (arg (. BenchFormat count))
              (arg "/metrics/process/instructions")
              (arg false)
            )
          )
        )
        (item
          (call run-metric
            (block
              (arg "runCycles")
              (arg "Run cycles")
              (arg "Median CPU cycles consumed by the benchmark process across warm launches.")
              (arg (. BenchFormat count))
              (arg "/metrics/process/cycles")
              (arg false)
            )
          )
        )
        (item
          (call run-metric
            (block
              (arg "collectorCycles")
              (arg "GC cycles")
              (arg "Collections the collector finished, from its gc.cycles probe counter.")
              (arg (. BenchFormat count))
              (arg "/metrics/probeCounters/gc.cycles")
              (arg false)
            )
          )
        )
        (item
          (call run-metric
            (block
              (arg "collectorPauses")
              (arg "GC pauses")
              (arg "Pauses the collector made, from its gc.pauses probe counter.")
              (arg (. BenchFormat count))
              (arg "/metrics/probeCounters/gc.pauses")
              (arg false)
            )
          )
        )
        (item
          (call run-metric
            (block
              (arg "collectorAssistNanos")
              (arg "Assist ns")
              (arg
                (paragraph
                  "Nanoseconds the program spent assisting the collector, from its gc.assist.nanos probe counter."
                )
              )
              (arg (. BenchFormat count))
              (arg "/metrics/probeCounters/gc.assist.nanos")
              (arg false)
            )
          )
        )
      )
    )
  )
)

(fn-expr _ run-metric BenchMetric
  (param key String)
  (param title String)
  (param description String)
  (param format BenchFormat)
  (param pointer String)
  (param is-timing Bool)
  (call BenchMetric
    (block
      (arg key)
      (arg title)
      (arg description)
      (arg format)
      (arg (. BenchSource run))
      (arg (call (. BenchExtractor value) pointer))
      (arg is-timing)
      (arg null)
    )
  )
)

(fn-expr _ built-in-bench-profiles (list BenchProfile)
  (param by-key (map String BenchMetric))
  (param is-default Bool)
  (item
    (call BenchProfile
      (block
        (arg "timing")
        (arg "Run time, CPU time, instructions and cycles across warm launches.")
        (arg is-default)
        (arg timing)
        (arg (call (of List String)))
        (arg false)
        (arg null)
        (arg (call (of List String)))
        (arg (call (of List String)))
        (arg true)
      )
    )
  )
  (item
    (call BenchProfile
      (block
        (arg "gc")
        (arg "Run time, and the collections, pauses and assists the collector's probe counters record.")
        (arg false)
        (arg collector)
        (arg (call (of List String)))
        (arg false)
        (arg null)
        (arg (list "gc"))
        (arg (call (of List String)))
        (arg true)
      )
    )
  )
  (where
    (lazy timing (list BenchMetric)
      (case-each (in key (list "runMs" "runCpuMs" "runInstructions" "runCycles"))
        (!! ([] by-key key))
      )
    )
    (lazy collector (list BenchMetric)
      (block
        (case-each (in key (list "runMs" "collectorCycles" "collectorPauses" "collectorAssistNanos"))
          (!! ([] by-key key))
        )
      )
    )
  )
)

(fn-do _ found-bench-suites (list BenchSuite) (?! Error)
  (param root String)
  (let folders (list String))
  (call collect-bench-folders (call Path root) folders)
  (let suites (list BenchSuite))
  (let places (map String String))
  (for (in folder (call sort folders))
    (let children (list String)
      (case-each (in child (. (call Path folder) contents) (when (and (. child is-dir) (!= (. child name) bench-fixtures-name) (not (call (. child name starts-with) ".")))))
        (as child String)
      )
    )
    (for (in path (call sort children))
      (let name (. (call Path path) name))
      (let relative (if-expr (call (. path starts-with) (str root "/")) ([] path (... (+ (. root length) 1))) path))
      (let other ([] places name))
      (if other
        (throw
          (call Error
            (block
              (arg
                (paragraph
                  (str "The bench folders " other " and " relative " both hold a suite named " name "; name the suites in " bench-config-path)
                )
              )
            )
          )
        )
      )
      (= ([] places name) relative)
      (+= suites
        (call BenchSuite
          (block
            (arg name)
            (arg path)
            (arg bench-compile-command)
            (arg bench-launch-command)
            (arg bench-default-extensions)
            (arg (str "The benchmarks in " relative))
          )
        )
      )
    )
  )
  (return suites)
)

(fn-do _ collect-bench-folders _ (?! Error)
  (param directory Path)
  (param folders (list String))
  (for (in child (. directory contents))
    (if (or (not (. child is-dir)) (call (. child name starts-with) "."))
      (continue)
    )
    (if (== (. child name) bench-folder-name)
      (+= folders (as child String))
      (else
        (call collect-bench-folders child folders)
      )
    )
  )
)

(fn-expr _ bench-command BenchCommand (?! Error)
  (param name String)
  (param entry JSONObjectReader)
  (param folder String)
  (param shared (list TargetVariable))
  (call BenchCommand
    (block
      (arg name)
      (arg (call target-arguments ([] entry "run")))
      (arg (++ shared (if-expr (call (. entry has) "env") (call target-variables ([] entry "env")) (call (of List TargetVariable)))))
      (arg (call bench-strings entry "probes"))
      (arg folder)
    )
  )
)

(fn-do _ bench-suite BenchSuite (?! Error)
  (param root String)
  (param entry JSONObjectReader)
  (param commands (map String BenchCommand))
  (let name (call (. ([] entry "id") string)))
  (let compile (if-expr (call (. entry has) "compile") (call (. ([] entry "compile") string)) bench-compile-command))
  (let run (if-expr (call (. entry has) "run") (call (. ([] entry "run") string)) bench-launch-command))
  (for (in command (call (of List String) compile run))
    (throw (call Error (str "Benchmark suite " name " names unknown command " command)) (if (not ([] commands command))))
  )
  (let description (if-expr (call (. entry has) "description") (call (. ([] entry "description") string)) ""))
  (let path (call (. ([] entry "path") string)))
  (let extensions (list String))
  (for (in extension (call bench-strings entry "extensions"))
    (+= extensions (if-expr (call (. extension starts-with) ".") extension (str "." extension)))
  )
  (if (not extensions)
    (= extensions bench-default-extensions)
  )
  (return
    (call BenchSuite
      (block
        (arg name)
        (arg (call bench-normalized-path (if-expr (call (. path starts-with) "/") path (str root "/" path))))
        (arg compile)
        (arg run)
        (arg extensions)
        (arg description)
      )
    )
  )
)

(fn-do _ bench-metric BenchMetric (?! Error)
  (param entry JSONObjectReader)
  (let key (call (. ([] entry "id") string)))
  (let extractors (list BenchExtractor))
  (if (call (. entry has) "value")
    (+= extractors (call (. BenchExtractor value) (call (. ([] entry "value") string))))
  )
  (if (call (. entry has) "sum")
    (+= extractors (call (. BenchExtractor sum) (call bench-strings entry "sum")))
  )
  (if (call (. entry has) "childSum")
    (let child (call (. ([] entry "childSum") object)))
    (+= extractors (call (. BenchExtractor child-sum) (call (. ([] child "object") string)) (call (. ([] child "value") string))))
  )
  (if (call (. entry has) "ratio")
    (let ratio (call (. ([] entry "ratio") object)))
    (let denominator (if-expr (call (. ratio has) "denominator") (call (. ([] ratio "denominator") string)) ""))
    (let scale (if-expr (call (. ratio has) "scale") (call (. ([] ratio "scale") number)) 1.0))
    (+= extractors
      (call (. BenchExtractor ratio)
        (block
          (arg (call (. ([] ratio "numerator") string)))
          (arg denominator)
          (arg (call bench-strings ratio "denominatorSum"))
          (arg scale)
        )
      )
    )
  )
  (throw (call Error (str "Benchmark metric " key " must define exactly one of value, sum, childSum or ratio")) (if (!= (. extractors length) 1)))
  (let source (call (. ([] entry "source") string)))
  (throw (call Error (str "Invalid source '" source "' for benchmark metric " key)) (if (and (!= source "compile") (!= source "run"))))
  (return
    (call BenchMetric
      (block
        (arg key)
        (arg (call (. ([] entry "title") string)))
        (arg (call (. ([] entry "description") string)))
        (arg (call bench-format (call (. ([] entry "format") string)) key))
        (arg (if-expr (== source "compile") (. BenchSource compile) (. BenchSource run)))
        (arg ([] extractors 0))
        (arg (if-expr (call (. entry has) "timing") (call (. ([] entry "timing") bool)) false))
        (arg (only-if (as (call (. ([] entry "minWidth") number)) Size) (if (call (. entry has) "minWidth"))))
      )
    )
  )
)

(fn-do _ bench-profile BenchProfile (?! Error)
  (param entry JSONObjectReader)
  (param by-key (map String BenchMetric))
  (param commands (map String BenchCommand))
  (let name (call (. ([] entry "id") string)))
  (let metrics (list BenchMetric))
  (for (in key (call bench-strings entry "metrics"))
    (let metric ([] by-key key))
    (throw (call Error (str "Benchmark profile " name " references unknown metric " key)) (if (not metric)))
    (+= metrics metric)
  )
  (let setup (only-if (call (. ([] entry "setup") string)) (if (call (. entry has) "setup"))))
  (throw (call Error (str "Benchmark profile " name " names unknown setup command " setup)) (if (and setup (not ([] commands setup)))))
  (let has-benchmark-metrics
    (block
      (case? (call (. entry has) "benchmarkMetrics")
        (call (. ([] entry "benchmarkMetrics") bool))
      )
      (default
        false
      )
    )
  )
  (throw (call Error (str "Benchmark profile " name " enables benchmarkMetrics but does not define setup")) (if (and has-benchmark-metrics (not setup))))
  (let probes (call bench-strings entry "probes"))
  (let runs (or has-benchmark-metrics (> (. probes length) 0)))
  (for (in metric metrics)
    (= runs (or runs (== (. metric source) (. BenchSource run))))
  )
  (return
    (call BenchProfile
      (block
        (arg name)
        (arg (call (. ([] entry "description") string)))
        (arg (if-expr (call (. entry has) "default") (call (. ([] entry "default") bool)) false))
        (arg metrics)
        (arg (call bench-strings entry "compilerProbes"))
        (arg has-benchmark-metrics)
        (arg setup)
        (arg probes)
        (arg (call bench-strings entry "selectors"))
        (arg runs)
      )
    )
  )
)

(fn-do _ check-bench-config _ (?! Error)
  (param root String)
  (param suites (list BenchSuite))
  (param metrics (list BenchMetric))
  (param profiles (list BenchProfile))
  (if (== (. suites length) 0)
    (throw
      (call Error
        (block
          (arg
            (paragraph
              (str root " has no benchmarks: no folder inside a " bench-folder-name " folder, and no suites in " bench-config-path)
            )
          )
        )
      )
    )
  )
  (let names (map String Bool))
  (for (in suite suites)
    (call check-bench-identifier "suite" (. suite name))
    (throw (call Error (str "Suite " (. suite name) " appears twice in " bench-config-path)) (if ([] names (. suite name))))
    (= ([] names (. suite name)) true)
  )
  (for (in metric metrics)
    (call check-bench-identifier "metric" (. metric key))
  )
  (let profile-names (map String Bool))
  (for (in profile profiles)
    (call check-bench-identifier "profile" (. profile name))
    (throw (call Error (str "Benchmark profile " (. profile name) " must list at least one metric")) (if (== (. profile metrics length) 0)))
    (throw (call Error (str "Profile " (. profile name) " appears twice in " bench-config-path)) (if ([] profile-names (. profile name))))
    (= ([] profile-names (. profile name)) true)
  )
)

(fn-do _ check-bench-identifier _ (?! Error)
  (param kind String)
  (param text String)
  (let is-valid (> (. text length) 0))
  (let starts true)
  (for (in char text)
    (if starts
      (= is-valid (and is-valid (>= char 'a') (<= char 'z')))
      (= starts false)
      (else-if (== char '/')
        (= starts true)
      )
      (else
        (= is-valid
          (scope (and is-valid (or is-letter (and (>= char '0') (<= char '9')) (== char '-')))
            (lazy is-letter (or (and (>= char 'a') (<= char 'z')) (and (>= char 'A') (<= char 'Z'))))
          )
        )
      )
    )
  )
  (throw (call Error (str "Invalid benchmark " kind " '" text "'")) (if (or (not is-valid) starts)))
)

(fn-do _ bench-format BenchFormat (?! Error)
  (param text String)
  (param key String)
  (match? text
    (case= "count"
      (return (. BenchFormat count))
    )
    (case= "duration"
      (return (. BenchFormat duration))
    )
    (case= "bytes"
      (return (. BenchFormat bytes))
    )
    (case= "percent"
      (return (. BenchFormat percent))
    )
    (case= "rate"
      (return (. BenchFormat rate))
    )
  )
  (throw (call Error (str "Invalid format '" text "' for benchmark metric " key)))
)

(fn-do _ bench-strings (list String) (?! Error)
  (param entry JSONObjectReader)
  (param key String)
  (let values (list String))
  (return-if values (if (not (call (. entry has) key))))
  (for (in item (call (. ([] entry key) items)))
    (+= values (call (. item string)))
  )
  (return values)
)
