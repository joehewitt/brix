./bench-metrics
/BxCore/BxSystem.h
/data/json
/math
/os/env
/os/file
/os/path
/os/process
/os/signal
/probes/console
/signal.h
/stream/aggregate
/time/duration
/time/timer
/unistd.h

+ bench-launch-deadline = 57s
_ bench-launch-limit Size = 100
_ bench-launch-budget = 250ms
_ bench-launch-timed-out-status = 124
_ bench-launch-signaled-status-base = 128
_ bench-launch-gc-runtime = "bench-gc-runtime"
_ bench-launch-outputs [String] = ["PROBES_PATH", "BRIX_BENCH_METRICS_PATH"]

━━━━━━━━━━━━━━━━━━━━
+ BenchLaunch is Tuple

+ usage ProcessUsage
+ wall U64

────────────────────
+ get is-success Bool

usage.exit-code == 0 && usage.signal == 0

━━━━━━━━━━━━━━━━━━━━
+ BenchLauncher

+ executable String
+ deadline Seconds
+ launches [BenchLaunch]
+ is-timed-out = false
+ forwarded Signal = 0

_ child Process?
_ timer Task?
_ is-running = false

────────────────────
+ This
    - executable
    - deadline

────────────────────
for sig on sig-term whenever #is-running

forward(sig)

────────────────────
for sig on sig-int whenever #is-running

forward(sig)

────────────────────
+ get is-interrupted Bool

is-timed-out || forwarded != 0

────────────────────
+ do run Int ?! Error

=? pass-through() if bench-launch-passes-through()
. failure = launch-all()
if is-timed-out
    stderr <- "The benchmark launches passed their $limit deadline\n"
        .. limit = duration-text((deadline as Nanoseconds) as U64)
    = bench-launch-timed-out-status
=? exit-by-signal(forwarded) if forwarded != 0
if failure
    . usage = failure.usage
    =? exit-by-signal(usage.signal) if usage.signal != 0
    = usage.exit-code
-- "bench-metrics ${to-json(bench-launch-metrics(launches))}"
= 0

────────────────────
_ do launch-all BenchLaunch? ?! Error

. scratch = temporary-directory("brix-bench-launch")
do finally remove-scratch(scratch)
is-running = true
do finally stop()
timer = do new watch-deadline()
. discarded = launch(launch-variables(scratch, "discarded"), null)
=? discarded if is-interrupted || !discarded.is-success
. output = scratch / "output"
. budget = (bench-launch-budget as Nanoseconds) as U64
. measured U64
while launches.length < bench-launch-limit && measured < budget
    . variables = if launches then repeat-variables else environment()
        .. repeat-variables = launch-variables(scratch, "repeat-${launches.length}")
    . log = File
        - output as String
        - FileFlags.write-mode + FileFlags.create-mode + FileFlags.truncate-mode
    . launched = launch(variables, log)
    log.close()
    =? launched if is-interrupted
    if !launched.is-success
        stderr <- "Measured launch $ordinal failed with $status after the discarded launch passed\n"
            .. ordinal = launches.length + 1
            .. status = bench-launch-status-text(launched.usage)
        stderr <- read-file-text(output)
        = launched
    launches += launched
    measured += launched.wall
= null

────────────────────
_ do launch BenchLaunch ?! Error
    - variables [String = String]
    - output File?

. started = monotonic-time-nanoseconds()
. spawned = Process(executable, ProcessStderr.inherit, List'String()) • variables variables • stdio-mode ProcessStdio.inherit • output-file output
child = spawned
. usage = spawned.wait-usage()
child = null
?! Error("The wait for $executable was cancelled")
    if !usage
= BenchLaunch(usage, monotonic-time-nanoseconds() - started)

────────────────────
_ do launch-variables [String = String]
    - scratch Path
    - label String

. variables = environment()
for name in bench-launch-outputs
    if variables[name]
        variables[name] = "${scratch as String}/${label}.${name}"
= variables

────────────────────
_ do forward
    - sig Signal

forwarded = sig
. running = child
if running
    C:kill(running.pid, sig)

────────────────────
_ do watch-deadline

deadline.wait()
=? if !is-running
is-timed-out = true
child?.kill()

────────────────────
_ do stop

is-running = false
timer?.cancel()

────────────────────
_ do pass-through Int ?! Error

C:brixSetSignalIgnored(C:SIGPIPE, 0)
. argv = String[2]
argv[0] = executable
C:execv(executable, argv)
?! Error("Unable to run $executable")

━━━━━━━━━━━━━━━━━━━━
_ do remove-scratch
    - scratch Path

for entry in scratch.contents
    catch entry.delete()
catch scratch.delete()

━━━━━━━━━━━━━━━━━━━━
_ do exit-by-signal Int
    - sig Signal

C:brixSetSignalIgnored(sig, 0)
C:kill(C:getpid(), sig)
= bench-launch-signaled-status-base + sig

━━━━━━━━━━━━━━━━━━━━
_ bench-launch-passes-through Bool

some(selectors.split(",")) • where (some(each.split(" ")) • where each == bench-launch-gc-runtime)

.. selectors = env("PROBES_ENABLED") ?? ""

━━━━━━━━━━━━━━━━━━━━
_ bench-launch-status-text String
    - usage ProcessUsage

if usage.signal != 0 then "signal ${usage.signal}" else "exit code ${usage.exit-code}"

━━━━━━━━━━━━━━━━━━━━
_ do bench-launch-metrics JSON
    - launches [BenchLaunch]

. walls [F64?] = <* launch in launches
    (launch.wall as F64) / 1000000.0
. users [F64?] = <* launch in launches
    (launch.usage.user-nanoseconds as F64) / 1000000.0
. systems [F64?] = <* launch in launches
    (launch.usage.system-nanoseconds as F64) / 1000000.0
. cpus [F64?] = <* launch in launches
    ((launch.usage.user-nanoseconds + launch.usage.system-nanoseconds) as F64) / 1000000.0
. instructions [F64?] = <* launch in launches
    launch.usage.instructions as F64
. cycles [F64?] = <* launch in launches
    launch.usage.cycles as F64
. switches [F64?] = <* launch in launches
    launch.usage.involuntary-switches as F64
. process [String = JSON]
process["wallMs"] = bench-summary(walls).median!
process["cpuMs"] = bench-summary(cpus).median!
process["userMs"] = bench-summary(users).median!
process["systemMs"] = bench-summary(systems).median!
process["instructions"] = round(bench-summary(instructions).median!)
process["cycles"] = round(bench-summary(cycles).median!)
process["involuntaryContextSwitches"] = round(bench-summary(switches).median!) as Int
process["launches"] = launches.length
. metrics [String = JSON]
metrics["process"] = process
= metrics
