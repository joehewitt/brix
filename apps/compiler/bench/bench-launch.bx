(import ./bench-metrics)
(import /BxCore/BxSystem.h)
(import /data/json)
(import /math)
(import /os/env)
(import /os/file)
(import /os/path)
(import /os/process)
(import /os/signal)
(import /probes/console)
(import /signal.h)
(import /stream/aggregate)
(import /time/duration)
(import /time/timer)
(import /unistd.h)
(blank)
(prop + bench-launch-deadline _ (= 57s))
(prop _ bench-launch-limit Size (= 100))
(prop _ bench-launch-budget _ (= 250ms))
(prop _ bench-launch-timed-out-status _ (= 124))
(prop _ bench-launch-signaled-status-base _ (= 128))
(prop _ bench-launch-gc-runtime _ (= "bench-gc-runtime"))
(prop _ bench-launch-outputs (list String) (= (list "PROBES_PATH" "BRIX_BENCH_METRICS_PATH")))

(type + BenchLaunch (is Tuple)
  (prop + usage ProcessUsage)
  (prop + wall U64)
  (fn-expr + is-success Bool :get
    (and (== (. usage exit-code) 0) (== (. usage signal) 0))
  )
)

(type + BenchLauncher
  (prop + executable String)
  (prop + deadline Seconds)
  (prop + launches (list BenchLaunch))
  (prop + is-timed-out _ (= false))
  (prop + forwarded Signal (= 0))
  (blank)
  (prop _ child (? Process))
  (prop _ timer (? Task))
  (prop _ is-running _ (= false))
  (fn-do + This _
    (param executable _)
    (param deadline _)
  )
  (subscribe-for (on sig sig-term (whenever #is-running))
    (call forward sig)
  )
  (subscribe-for (on sig sig-int (whenever #is-running))
    (call forward sig)
  )
  (fn-expr + is-interrupted Bool :get
    (or is-timed-out (!= forwarded 0))
  )
  (fn-do + run Int (?! Error)
    (return-if (call pass-through) (if (call bench-launch-passes-through)))
    (let failure (call launch-all))
    (if is-timed-out
      (scope (<- stderr (str "The benchmark launches passed their " limit " deadline\n"))
        (lazy limit (call duration-text (as (as deadline Nanoseconds) U64)))
      )
      (return bench-launch-timed-out-status)
    )
    (return-if (call exit-by-signal forwarded) (if (!= forwarded 0)))
    (if failure
      (let usage (. failure usage))
      (return-if (call exit-by-signal (. usage signal)) (if (!= (. usage signal) 0)))
      (return (. usage exit-code))
    )
    (print (str "bench-metrics " (call to-json (call bench-launch-metrics launches))))
    (return 0)
  )
  (fn-do _ launch-all (? BenchLaunch) (?! Error)
    (let scratch (call temporary-directory "brix-bench-launch"))
    (finally
      (inline (call remove-scratch scratch))
    )
    (= is-running true)
    (finally
      (inline (call stop))
    )
    (= timer
      (do-new
        (inline (call watch-deadline))
      )
    )
    (let discarded (call launch (call launch-variables scratch "discarded") null))
    (return-if discarded (if (or is-interrupted (not (. discarded is-success)))))
    (let output (/ scratch "output"))
    (let budget (as (as bench-launch-budget Nanoseconds) U64))
    (let measured U64)
    (while (and (< (. launches length) bench-launch-limit) (< measured budget))
      (let variables
        (scope (if-expr launches repeat-variables (call environment))
          (lazy repeat-variables (call launch-variables scratch (str "repeat-" (. launches length))))
        )
      )
      (let log
        (call File
          (block
            (arg (as output String))
            (arg (+ (. FileFlags write-mode) (. FileFlags create-mode) (. FileFlags truncate-mode)))
          )
        )
      )
      (let launched (call launch variables log))
      (call (. log close))
      (return-if launched (if is-interrupted))
      (if (not (. launched is-success))
        (scope (<- stderr (str "Measured launch " ordinal " failed with " status " after the discarded launch passed\n"))
          (lazy ordinal (+ (. launches length) 1))
          (lazy status (call bench-launch-status-text (. launched usage)))
        )
        (<- stderr (call read-file-text output))
        (return launched)
      )
      (+= launches launched)
      (+= measured (. launched wall))
    )
    (return null)
  )
  (fn-do _ launch BenchLaunch (?! Error)
    (param variables (map String String))
    (param output (? File))
    (let started (call monotonic-time-nanoseconds))
    (let spawned
      (call Process
        (block
          (arg executable)
          (arg (. ProcessStderr inherit))
          (arg (call (of List String)))
          (:variables variables)
          (:stdio-mode (. ProcessStdio inherit))
          (:output-file output)
        )
      )
    )
    (= child spawned)
    (let usage (call (. spawned wait-usage)))
    (= child null)
    (throw (call Error (str "The wait for " executable " was cancelled")) (if (not usage)))
    (return (call BenchLaunch usage (- (call monotonic-time-nanoseconds) started)))
  )
  (fn-do _ launch-variables (map String String)
    (param scratch Path)
    (param label String)
    (let variables (call environment))
    (for (in name bench-launch-outputs)
      (if ([] variables name)
        (= ([] variables name) (str (as scratch String) "/" label "." name))
      )
    )
    (return variables)
  )
  (fn-do _ forward _
    (param sig Signal)
    (= forwarded sig)
    (let running child)
    (if running
      (call C:kill (. running pid) sig)
    )
  )
  (fn-do _ watch-deadline _
    (call (. deadline wait))
    (return-if (if (not is-running)))
    (= is-timed-out true)
    (call (?. child kill))
  )
  (fn-do _ stop _
    (= is-running false)
    (call (?. timer cancel))
  )
  (fn-do _ pass-through Int (?! Error)
    (call C:brixSetSignalIgnored C:SIGPIPE 0)
    (let argv ([] String 2))
    (= ([] argv 0) executable)
    (call C:execv executable argv)
    (throw (call Error (str "Unable to run " executable)))
  )
)

(fn-do _ remove-scratch _
  (param scratch Path)
  (for (in entry (. scratch contents))
    (catch (call (. entry delete)))
  )
  (catch (call (. scratch delete)))
)

(fn-do _ exit-by-signal Int
  (param sig Signal)
  (call C:brixSetSignalIgnored sig 0)
  (call C:kill (call C:getpid) sig)
  (return (+ bench-launch-signaled-status-base sig))
)

(fn-expr _ bench-launch-passes-through Bool
  (call some (call (. selectors split) ",") (:where (call some (call (. each split) " ") (:where (== each bench-launch-gc-runtime)))))
  (where
    (lazy selectors (?? (call env "PROBES_ENABLED") ""))
  )
)

(fn-expr _ bench-launch-status-text String
  (param usage ProcessUsage)
  (if-expr (!= (. usage signal) 0) (str "signal " (. usage signal)) (str "exit code " (. usage exit-code)))
)

(fn-do _ bench-launch-metrics JSON
  (param launches (list BenchLaunch))
  (let walls (list (? F64))
    (case-each (in launch launches)
      (/ (as (. launch wall) F64) 1000000.0)
    )
  )
  (let users (list (? F64))
    (case-each (in launch launches)
      (/ (as (. launch usage user-nanoseconds) F64) 1000000.0)
    )
  )
  (let systems (list (? F64))
    (case-each (in launch launches)
      (/ (as (. launch usage system-nanoseconds) F64) 1000000.0)
    )
  )
  (let cpus (list (? F64))
    (case-each (in launch launches)
      (/ (as (+ (. launch usage user-nanoseconds) (. launch usage system-nanoseconds)) F64) 1000000.0)
    )
  )
  (let instructions (list (? F64))
    (case-each (in launch launches)
      (as (. launch usage instructions) F64)
    )
  )
  (let cycles (list (? F64))
    (case-each (in launch launches)
      (as (. launch usage cycles) F64)
    )
  )
  (let switches (list (? F64))
    (case-each (in launch launches)
      (as (. launch usage involuntary-switches) F64)
    )
  )
  (let process (map String JSON))
  (= ([] process "wallMs") (!! (. (call bench-summary walls) median)))
  (= ([] process "cpuMs") (!! (. (call bench-summary cpus) median)))
  (= ([] process "userMs") (!! (. (call bench-summary users) median)))
  (= ([] process "systemMs") (!! (. (call bench-summary systems) median)))
  (= ([] process "instructions") (call round (!! (. (call bench-summary instructions) median))))
  (= ([] process "cycles") (call round (!! (. (call bench-summary cycles) median))))
  (= ([] process "involuntaryContextSwitches") (as (call round (!! (. (call bench-summary switches) median))) Int))
  (= ([] process "launches") (. launches length))
  (let metrics (map String JSON))
  (= ([] metrics "process") process)
  (return metrics)
)
