(import /data/json)
(import /math)
(import /probes/trace)
(import /stream/sort)
(blank)
(prop _ bench-group-type U16 (= 16))
(prop _ bench-nanoseconds U64 (= 1000000000))

(fn-do + bench-probe-metrics (? (map String JSON))
  (param path String)
  (let reading (call BenchProbeReading))
  (let reader (use (call TraceReader path false)))
  (let read (catch (call (. reading read) reader)))
  (return-if null (if (is read Error)))
  (return (call (. reading metrics)))
)

(type _ BenchProbeKey
  (prop + is-group-expected _ (= false))
  (prop + group-count U64)
  (prop + group-ms _ (= 0.0))
  (prop + samples (list F64))
  (prop + least (? F64))
  (prop + most (? F64))
  (prop + active-count U64)
  (prop + active-ms _ (= 0.0))
  (prop + is-counter-seen _ (= false))
  (prop + is-counter-expected _ (= false))
  (prop + counter-value U64)
  (prop + owners (map U32 Bool))
)

(type _ BenchOpenGroup (is (tuple (: key String) (: time U64))))

(type _ BenchProbeReading
  (prop + keys (map String BenchProbeKey))
  (prop + counts (map String TraceCounter))
  (prop + measures (map U16 TraceMetric))
  (prop + open (map U32 BenchOpenGroup))
  (fn-do + read Bool (?! Error)
    (param reader TraceReader)
    (for (in item (call (. reader read-all)))
      (call observe item)
    )
    (return (. reader is-done))
  )
  (fn-do + metrics (map String JSON)
    (let counters (map String U64))
    (for (in (tuple _ counter) counts)
      (let key (. counter site key))
      (if (== key "")
        (continue)
      )
      (let named (if-expr (!= (. counter object-id) 0) (str (. counter object-id) ":" key) key))
      (= ([] counters named) (+ (?? ([] counters named) 0) (. counter value)))
      (let found (call entry key))
      (= (. found is-counter-seen) true)
      (+= (. found counter-value) (. counter value))
      (if (!= (. counter object-id) 0)
        (= ([] (. found owners) (. counter object-id)) true)
      )
    )
    (for (in (tuple _ metric) measures)
      (let key (. metric site key))
      (if (== key "")
        (continue)
      )
      (let found (call entry key))
      (if (== (. metric site kind) (. TraceMetricKind counter))
        (= ([] counters key) (+ (?? ([] counters key) 0) (. metric value)))
        (= (. found is-counter-seen) true)
        (+= (. found counter-value) (. metric value))
        (else
          (= (. found is-group-expected) true)
          (+= (. found group-count) (. metric value))
          (+= (. found group-ms) (/ (as (. metric total-ns) F64) 1000000.0))
          (+= (. found active-count) (. metric active-count))
          (+= (. found active-ms) (/ (as (. metric active-elapsed-ns) F64) 1000000.0))
        )
      )
    )
    (let values (map String JSON))
    (for (in (tuple key value) counters)
      (= ([] values key) (as value JSON))
    )
    (let profiles (map String JSON))
    (let names (list String))
    (for (in (tuple key _) keys)
      (+= names key)
    )
    (for (in key (call sort names))
      (let fields (call profile-fields (!! ([] keys key))))
      (if (> (. fields length) 0)
        (= ([] profiles key) fields)
      )
    )
    (let found (map String JSON))
    (= ([] found "probeCounters") values)
    (= ([] found "probeProfiles") profiles)
    (return found)
  )
  (fn-do _ observe _
    (param item TraceItem)
    (match? item
      (case (call .site site)
        (if (and (== (. site kind) (. TraceSiteKind counter)) (!= (. site key) ""))
          (= (. (call entry (. site key)) is-counter-expected) true)
        )
      )
      (case (call .metric-site site)
        (if (!= (. site key) "")
          (let found (call entry (. site key)))
          (if (== (. site kind) (. TraceMetricKind counter))
            (= (. found is-counter-expected) true)
            (else
              (= (. found is-group-expected) true)
            )
          )
        )
      )
      (case (call .log record)
        (call group record)
      )
      (case (call .event record)
        (call group record)
      )
      (case (call .counter counter)
        (= ([] counts (str (. counter site id) ":" (. counter object-id))) counter)
      )
      (case (call .metric metric)
        (= ([] measures (. metric site id)) metric)
      )
    )
  )
  (fn-do _ group _
    (param record TraceRecord)
    (let name (?? (. record site name) ""))
    (return-if (if (or (== (. record site key) "") (and (!= name "groupBegin") (!= name "groupEnd")))))
    (let id (call group-id record))
    (return-if (if (not id)))
    (let time (+ (* (. record time seconds) bench-nanoseconds) (. record time nanoseconds)))
    (if (== name "groupBegin")
      (= ([] open id) (call BenchOpenGroup (. record site key) time))
      (return)
    )
    (let started ([] open id))
    (return-if (if (not started)))
    (-= ([] open id))
    (let elapsed (if-expr (> time (. started time)) (/ (as (- time (. started time)) F64) 1000000.0) 0.0))
    (let found (call entry (. started key)))
    (+= (. found group-count) 1)
    (+= (. found group-ms) elapsed)
    (+= (. found samples) elapsed)
    (= (. found least) (if-expr (or (not (. found least)) (< elapsed (. found least))) elapsed (. found least)))
    (= (. found most) (if-expr (or (not (. found most)) (> elapsed (. found most))) elapsed (. found most)))
  )
  (fn-do _ group-id (? U32)
    (param record TraceRecord)
    (for (in value (. record values))
      (match? value
        (case (call .object object)
          (return-if (. object object-id) (if (== (. object type-id) bench-group-type)))
        )
      )
    )
    (return null)
  )
  (fn-do _ entry BenchProbeKey
    (param key String)
    (let found ([] keys key))
    (return-if found (if found))
    (let made (call BenchProbeKey))
    (= ([] keys key) made)
    (return made)
  )
)

(fn-do _ profile-fields (map String JSON)
  (param found BenchProbeKey)
  (let fields (map String JSON))
  (if (or (> (. found group-count) 0) (> (. found active-count) 0))
    (let sorted (call sort (. found samples)))
    (= ([] fields "count") (as (. found group-count) JSON))
    (= ([] fields "totalMs") (. found group-ms))
    (= ([] fields "averageMs")
      (scope (if-expr (> (. found group-count) 0) average-ms (as null JSON))
        (lazy average-ms (as (/ (. found group-ms) (as (. found group-count) F64)) JSON))
      )
    )
    (= ([] fields "minMs") (call optional-json (. found least)))
    (= ([] fields "p50Ms") (call percentile sorted 0.5))
    (= ([] fields "p95Ms") (call percentile sorted 0.95))
    (= ([] fields "p99Ms") (call percentile sorted 0.99))
    (= ([] fields "maxMs") (call optional-json (. found most)))
    (= ([] fields "activeCount") (as (. found active-count) JSON))
    (= ([] fields "activeMs") (. found active-ms))
    (else-if (. found is-group-expected)
      (= ([] fields "count") 0)
      (= ([] fields "totalMs") 0.0)
      (= ([] fields "averageMs") null)
      (= ([] fields "minMs") null)
      (= ([] fields "p50Ms") null)
      (= ([] fields "p95Ms") null)
      (= ([] fields "p99Ms") null)
      (= ([] fields "maxMs") null)
      (= ([] fields "activeCount") 0)
      (= ([] fields "activeMs") 0.0)
    )
  )
  (if (or (. found is-counter-seen) (. found is-counter-expected))
    (= ([] fields "value")
      (scope (if-expr (. found is-counter-seen) counter-json (as null JSON))
        (lazy counter-json (as (. found counter-value) JSON))
      )
    )
    (= ([] fields "objectCount") (. found owners length))
  )
  (return fields)
)

(fn-expr _ percentile JSON
  (param sorted (list F64))
  (param fraction F64)
  (case? (== (. sorted length) 0)
    (as null JSON)
  )
  (default
    (as ([] sorted (as index Size)) JSON)
  )
  (where
    (lazy rank (- (as (call ceil (* (as (. sorted length) F64) fraction)) Int) 1))
    (lazy index (call max 0 (call min (- (as (. sorted length) Int) 1) rank)))
  )
)

(fn-expr _ optional-json JSON
  (param value (? F64))
  (if-expr value (as value JSON) (as null JSON))
)
