(import ./bench-catalog)
(import ./bench-config)
(import ./bench-metrics)
(import ./bench-report)
(import ./bench-runner)
(import /data/json)
(import /time/timer)
(blank)
(prop _ bench-shown-metrics Size (= 6))
(prop _ bench-shown-lines Size (= 40))
(prop _ bench-reason-limit Size (= 120))

(type + BenchSession
  (prop + results (list (? BenchResult)))
  (prop + phase (? BenchPhase))
  (prop + current (? Index))
  (prop + iteration Size (= 0))
  (prop + phase-started U64)
  (prop + setup _ (= ""))
  (prop + saved (? String))
  (prop + problem (? String))
  (prop + started U64)
  (prop + ended U64)
  (prop + is-stopping _ (= false))
  (prop + is-stopped _ (= false))
  (prop + is-complete _ (= false))
  (fn-do + This _
    (param count Size)
    (= started (call monotonic-time-nanoseconds))
    (for (in _ (..< 0 count))
      (+= results null)
    )
  )
  (fn-do + apply _
    (param event BenchEvent)
    (match? event
      (case (call .setup state)
        (= setup state)
      )
      (case (call .progress bench phase iteration at _)
        (= current bench)
        (= (. this phase) phase)
        (= (. this iteration) iteration)
        (if (or (== phase (. BenchPhase compile)) (== phase (. BenchPhase run)) is-warmup)
          (= phase-started at)
        )
        (lazy is-warmup (or (== phase (. BenchPhase warmup-compile)) (== phase (. BenchPhase warmup-run))))
      )
      (case (call .finished bench result)
        (= ([] results bench) result)
        (= current null)
      )
      (case (call .saved path)
        (= saved path)
      )
      (case (call .failed message)
        (= problem message)
      )
      (case (call .completed stopped)
        (= is-stopped stopped)
        (= ended (call monotonic-time-nanoseconds))
        (= is-complete true)
      )
    )
  )
  (fn-expr + elapsed U64 :get
    (- (if-expr (!= ended 0) ended (call monotonic-time-nanoseconds)) started)
  )
)

(fn-do + bench-run-info BenchRunInfo (?! Error)
  (param config BenchConfig)
  (param profile BenchProfile)
  (param selectors (list String))
  (param timeout U64)
  (param keeps Bool)
  (param saved-by String)
  (param iterations (? Size))
  (param warmup (? Size))
  (param compare (? String))
  (param save (? String))
  (param reason (? String))
  (let uses-timing (. profile uses-timing-samples))
  (let note (call (. (?? reason "") trim)))
  (throw (call Error (str "A benchmark reason must be at most " bench-reason-limit " characters")) (if (> (. note length) bench-reason-limit)))
  (return
    (call BenchRunInfo
      (block
        (arg (call bench-run-id))
        (arg (call bench-iso-time))
        (arg config)
        (arg profile)
        (arg selectors)
        (arg (if-expr uses-timing (?? iterations 1) 1))
        (arg (if-expr uses-timing (?? warmup 0) 0))
        (arg timeout)
        (arg keeps)
        (arg (call bench-saved-name (?? save bench-last-run-name) (. profile name)))
        (arg (if-expr compare (call bench-saved-name compare (. profile name)) ""))
        (arg note)
        (arg saved-by)
      )
    )
  )
)

(fn-do + bench-run-notes (list String)
  (param profile BenchProfile)
  (param iterations (? Size))
  (param warmup (? Size))
  (let notes (list String))
  (if (and (not (. profile uses-timing-samples)) (or (!= iterations null) (!= warmup null)))
    (+= notes (str (. profile name) " has no timing metric, so each benchmark runs once without warmup"))
  )
  (return notes)
)

(fn-do + bench-baseline (map String JSON) (?! Error)
  (param root String)
  (param compare-name String)
  (let baseline (map String JSON))
  (if (!= compare-name "")
    (for (in item (?? (call bench-items (call bench-field "results" (call load-bench-baseline root compare-name))) (call (of List JSON))))
      (= ([] baseline (call bench-string (call bench-field "id" item))) item)
    )
  )
  (return baseline)
)

(fn-do + bench-shown-metrics (list Index) (?! Error)
  (param profile BenchProfile)
  (param option (? String))
  (let shown (list Index))
  (if (not option)
    (for (in index (..< 0 (. profile metrics length)))
      (if (< index bench-shown-metrics)
        (+= shown index)
      )
    )
    (return shown)
  )
  (if (== option "all")
    (for (in index (..< 0 (. profile metrics length)))
      (+= shown index)
    )
    (return shown)
  )
  (for (in key (call bench-commas option))
    (let found false)
    (for (in index (..< 0 (. profile metrics length)))
      (if (== (. ([] (. profile metrics) index) key) key)
        (+= shown index)
        (= found true)
      )
    )
    (throw (call Error (str (. profile name) " has no metric " key)) (if (not found)))
  )
  (return shown)
)

(fn-do + bench-profile-lines (list String)
  (param config BenchConfig)
  (param cases (list BenchCase))
  (let lines (list String))
  (+= lines "profiles")
  (for (in profile (call ordered-bench-profiles config))
    (let note (if-expr (. profile is-default) "  (default)" ""))
    (+= lines
      (scope (str "  " (. profile name) note "  " metric-count "  " (. profile description))
        (lazy metric-count (call bench-count-text (. profile metrics length) "metric"))
      )
    )
  )
  (+= lines "")
  (+= lines "suites")
  (for (in suite (. config suites))
    (let count 0)
    (for (in bench cases)
      (if (== (. bench suite name) (. suite name))
        (+= count 1)
      )
    )
    (+= lines (str "  " (. suite name) "  " (call bench-count-text count "benchmark") "  " (. suite description)))
  )
  (+= lines (str (call bench-count-text (. cases length) "benchmark")))
  (return lines)
)

(fn-do + bench-selection-lines (list String)
  (param selected (list BenchCase))
  (param shows-benchmarks Bool)
  (let suites (list String))
  (let counts (map String Size))
  (for (in bench selected)
    (if (not ([] counts (. bench suite name)))
      (+= suites (. bench suite name))
    )
    (= ([] counts (. bench suite name)) (+ (?? ([] counts (. bench suite name)) 0) 1))
  )
  (let lines (list String))
  (for (in suite suites)
    (+= lines (str suite "  " (call bench-count-text (!! ([] counts suite)) "benchmark")))
    (if shows-benchmarks
      (for (in bench selected)
        (if (== (. bench suite name) suite)
          (+= lines (str "    " (. bench id) "  " (. bench description)))
        )
      )
    )
  )
  (+= lines (str (call bench-count-text (. selected length) "benchmark") " selected"))
  (return lines)
)

(fn-do + bench-saved-run-lines (list String)
  (param runs (list BenchSavedRun))
  (param profile (? String))
  (let lines (list String))
  (if (== (. runs length) 0)
    (+= lines (str "No saved runs" (if-expr profile (str " for " profile) "")))
    (return lines)
  )
  (for (in saved runs)
    (let reason (if-expr (!= (. saved reason) "") (str "  " (. saved reason)) ""))
    (let owner
      (scope (if-expr (and (!= (. saved saved-by) "") (!= (. saved saved-by) "human")) saver-note "")
        (lazy saver-note (str "  saved by " (. saved saved-by)))
      )
    )
    (+= lines (str (. saved name) "  " (. saved generated) reason owner))
  )
  (return lines)
)

(fn-do + bench-heading String
  (param info BenchRunInfo)
  (param count Size)
  (let parts (list String))
  (if (> (. info iterations) 1)
    (+= parts (str (. info iterations) " iterations"))
  )
  (if (> (. info warmup) 0)
    (+= parts (str (. info warmup) " warmup"))
  )
  (if (!= (. info compare-name) "")
    (+= parts (str "compared with " (. info compare-name)))
  )
  (let note (if-expr (> (. parts length) 0) (str "  " (call (. "  " join) parts)) ""))
  (return (str (. info profile name) "  " (call bench-count-text count "benchmark") note))
)

(fn-do + bench-result-lines (list String)
  (param result BenchResult)
  (param info BenchRunInfo)
  (param shown (list Index))
  (param baseline (map String JSON))
  (let parts (list String))
  (for (in index shown)
    (+= parts
      (call bench-metric-text
        (block
          (arg result)
          (arg ([] (. info profile metrics) index))
          (arg index)
          (arg ([] baseline (. result bench id)))
        )
      )
    )
  )
  (let label (if-expr (. result is-passed) "PASS" (. result status uppercased)))
  (let values (if-expr (> (. parts length) 0) (str "  " (call (. "  " join) parts)) ""))
  (let lines (list String))
  (+= lines (str label "  " (. result bench id) values))
  (if (not (. result is-passed))
    (for (in diagnostic (. result diagnostics))
      (++= lines (call bench-indented-lines diagnostic))
    )
    (+= lines "")
  )
  (return lines)
)

(fn-do + bench-status-line String
  (param session BenchSession)
  (param selected (list BenchCase))
  (param info BenchRunInfo)
  (let done 0)
  (let passed 0)
  (for (in result (. session results))
    (if result
      (+= done 1)
      (if (. result is-passed)
        (+= passed 1)
      )
    )
  )
  (let line (str done "/" (. selected length) "  " passed " passed"))
  (if (> done passed)
    (= line (str line "  " (- done passed) " failed"))
  )
  (= line (str line "  " (call bench-elapsed-text (. session elapsed))))
  (return-if (str line "  stopping…") (if (. session is-stopping)))
  (return-if (str line "  " (call bench-setup-text (. session setup))) (if (and is-idle (== (. session setup) "provider-setup"))))
  (blank)
  (lazy is-idle (== (. session current) null))
  (let current (. session current))
  (return-if line (if (== current null)))
  (blank)
  (let phase (call bench-phase-text (!! (. session phase)) (. session iteration) info))
  (let timer
    (scope (if-expr (!= (. session phase-started) 0) phase-elapsed "")
      (lazy phase-elapsed (call bench-elapsed-text (- (call monotonic-time-nanoseconds) (. session phase-started))))
    )
  )
  (return (str line "  " (. ([] selected current) id) "  " phase "  " timer))
)

(fn-do + bench-summary-lines (list String)
  (param session BenchSession)
  (param info BenchRunInfo)
  (let total 0)
  (let passed 0)
  (for (in result (. session results))
    (if result
      (+= total 1)
      (if (. result is-passed)
        (+= passed 1)
      )
    )
  )
  (let outcome (if-expr (. session is-stopped) "stopped  " ""))
  (let failed (if-expr (> total passed) (str "  " (- total passed) " failed") ""))
  (let lines (list String))
  (+= lines
    (scope (str outcome (call bench-count-text total "benchmark") "  " passed " passed" failed "  " elapsed-text)
      (lazy elapsed-text (call bench-elapsed-text (. session elapsed)))
    )
  )
  (let saved (. session saved))
  (if saved
    (+= lines
      (scope (str "saved " (if-expr (call (. saved starts-with) (str (. info config root) "/")) relative-saved saved))
        (lazy relative-saved ([] saved (... (+ (. info config root length) 1))))
      )
    )
  )
  (return lines)
)

(fn-expr + bench-count-text String
  (param count Size)
  (param noun String)
  (if-expr (== count 1) (str "1 " noun) (str count " " noun "s"))
)

(fn-expr _ bench-metric-text String
  (param result BenchResult)
  (param metric BenchMetric)
  (param index Index)
  (param base (? JSON))
  (case? (not base)
    (str (. metric title) " " value)
  )
  (default
    (str (. metric title) " " value " (" (call bench-delta-text (. delta percent)) ")")
  )
  (where
    (lazy summary ([] (. result summaries) index))
    (lazy value (if-expr (and (. summary is-dispersed) (. summary min) (. summary max)) (str (call bench-value-text (. metric format) (. summary min)) "–" (call bench-value-text (. metric format) (. summary max))) (call bench-value-text (. metric format) (. summary median))))
    (lazy delta (call bench-delta (call bench-result-median base (. metric key)) (. summary median)))
  )
)

(fn-do _ bench-indented-lines (list String)
  (param text String)
  (let lines (list String))
  (for (in line (call (. text split) "\n"))
    (+= lines line)
  )
  (let shown (list String))
  (let count 0)
  (for (in line lines)
    (if (== count bench-shown-lines)
      (+= shown (str "    … " (- (. lines length) count) " more lines"))
      (break)
    )
    (+= shown (str "    " line))
    (+= count 1)
  )
  (return shown)
)

(fn-expr _ bench-phase-text String
  (param phase BenchPhase)
  (param iteration Size)
  (param info BenchRunInfo)
  (match phase
    (case .warmup-compile
      (str "warmup compile " (+ iteration 1) "/" (. info warmup))
    )
    (case .warmup-compile-done
      (str "warmup compile " (+ iteration 1) "/" (. info warmup))
    )
    (case .warmup-run
      (str "warmup run " (+ iteration 1) "/" (. info warmup))
    )
    (case .warmup-run-done
      (str "warmup run " (+ iteration 1) "/" (. info warmup))
    )
    (case .compile
      (str "compile " (+ iteration 1) "/" (. info iterations))
    )
    (case .compile-done
      (str "compile " (+ iteration 1) "/" (. info iterations))
    )
    (case .run
      (str "run " (+ iteration 1) "/" (. info iterations))
    )
    (case .run-done
      (str "run " (+ iteration 1) "/" (. info iterations))
    )
  )
)

(fn-expr _ bench-setup-text String
  (param state String)
  (if-expr (== state "provider-setup") "setting up the benchmark runtime" state)
)
