(import ./bench-config)
(import /data/json)
(import /math)
(import /stream/sort)
(blank)
(prop + bench-dispersion-limit F64 (= 20.0))

(type + BenchSummary (is Tuple)
  (prop + count Size)
  (prop + min (? F64))
  (prop + mean (? F64))
  (prop + median (? F64))
  (prop + max (? F64))
  (prop + deviation (? F64))
  (prop + relative-deviation (? F64))
  (prop + relative-range (? F64))
  (prop + is-dispersed Bool)
)

(fn-do + bench-summary BenchSummary
  (param values (list (? F64)))
  (let found (list F64))
  (for (in value values)
    (if (and value (call bench-is-finite value))
      (+= found value)
    )
  )
  (return-if (call BenchSummary 0 null null null null null null null false) (if (== (. found length) 0)))
  (blank)
  (let numbers (call sort found (:using (=> (a b) (if-expr (< a b) .lesser .greater)))))
  (let count (. numbers length))
  (let middle (/ count 2))
  (let median (if-expr (== (% count 2) 1) ([] numbers middle) (/ (+ ([] numbers (- middle 1)) ([] numbers middle)) 2.0)))
  (let total 0.0)
  (for (in number numbers)
    (+= total number)
  )
  (let mean (/ total (as count F64)))
  (let variance 0.0)
  (for (in number numbers)
    (+= variance (* (- number mean) (- number mean)))
  )
  (let deviation (call sqrt (/ variance (as count F64))))
  (let low ([] numbers 0))
  (let high ([] numbers (- count 1)))
  (let range (- high low))
  (let relative-deviation (? F64)
    (scope (if-expr (== mean 0.0) (only-if 0.0 (if (== deviation 0.0))) deviation-percent)
      (lazy deviation-percent (* (call abs (/ deviation mean)) 100.0))
    )
  )
  (let relative-range (? F64) (if-expr (== median 0.0) (only-if 0.0 (if (== range 0.0))) (* (call abs (/ range median)) 100.0)))
  (let is-dispersed
    (scope (and (> count 1) (> range 0.0) is-wide-range)
      (lazy is-wide-range (or (== relative-range null) (>= relative-range bench-dispersion-limit)))
    )
  )
  (return
    (call BenchSummary
      (block
        (arg count)
        (arg (call bench-rounded low))
        (arg (call bench-rounded mean))
        (arg (call bench-rounded median))
        (arg (call bench-rounded high))
        (arg (call bench-rounded deviation))
        (arg (only-if (call bench-rounded relative-deviation) (if relative-deviation)))
        (arg (only-if (call bench-rounded relative-range) (if relative-range)))
        (arg is-dispersed)
      )
    )
  )
)

(fn-do + bench-summary-json JSON
  (param summary BenchSummary)
  (let fields (map String JSON))
  (= ([] fields "sampleCount") (. summary count))
  (= ([] fields "min") (call bench-number-json (. summary min)))
  (= ([] fields "mean") (call bench-number-json (. summary mean)))
  (= ([] fields "median") (call bench-number-json (. summary median)))
  (= ([] fields "max") (call bench-number-json (. summary max)))
  (= ([] fields "standardDeviation") (call bench-number-json (. summary deviation)))
  (= ([] fields "relativeStdDevPct") (call bench-number-json (. summary relative-deviation)))
  (= ([] fields "relativeRangePct") (call bench-number-json (. summary relative-range)))
  (= ([] fields "highDispersion") (. summary is-dispersed))
  (return fields)
)

(fn-do + bench-summary-of (? BenchSummary)
  (param value (? JSON))
  (return-if null (if (not value)))
  (blank)
  (match value
    (case (: fields (map String JSON))
      (return
        (call BenchSummary
          (block
            (arg (as (?? (call bench-json-number ([] fields "sampleCount")) 0.0) Size))
            (arg (call bench-json-number ([] fields "min")))
            (arg (call bench-json-number ([] fields "mean")))
            (arg (call bench-json-number ([] fields "median")))
            (arg (call bench-json-number ([] fields "max")))
            (arg (call bench-json-number ([] fields "standardDeviation")))
            (arg (call bench-json-number ([] fields "relativeStdDevPct")))
            (arg (call bench-json-number ([] fields "relativeRangePct")))
            (arg (== ([] fields "highDispersion") (as true JSON)))
          )
        )
      )
    )
    (default
      (return null)
    )
  )
)

(fn-do + bench-extract (? F64)
  (param metric BenchMetric)
  (param sample JSON)
  (match (. metric extractor)
    (case (call .value pointer)
      (return (call bench-json-number (call bench-pointer sample pointer)))
    )
    (case (call .sum pointers)
      (return (call bench-sum sample pointers))
    )
    (case (call .child-sum pointer field)
      (return (call bench-child-sum sample pointer field))
    )
    (case (call .ratio numerator denominator denominators scale)
      (let top (call bench-json-number (call bench-pointer sample numerator)))
      (let bottom (if-expr (!= denominator "") (?? (call bench-json-number (call bench-pointer sample denominator)) (call bench-sum sample denominators)) (call bench-sum sample denominators)))
      (return-if null (if (or (not top) (not bottom) (== bottom 0.0))))
      (return (* (/ top bottom) scale))
    )
  )
)

(fn-do + bench-pointer (? JSON)
  (param root JSON)
  (param pointer String)
  (return-if null (if (not (call (. pointer starts-with) "/"))))
  (blank)
  (let value (? JSON) root)
  (for (in segment (call (. ([] pointer (... 1)) split) "/"))
    (let key (call bench-pointer-segment segment))
    (match (!! value)
      (case (: fields (map String JSON))
        (return-if null (if (== ([] fields key) null)))
        (blank)
        (= value ([] fields key))
      )
      (case (: items (list JSON))
        (let index (call bench-index key))
        (return-if null (if (or (not index) (>= index (. items length)))))
        (blank)
        (= value ([] items index))
      )
      (default
        (return null)
      )
    )
  )
  (return value)
)

(fn-do + bench-json-number (? F64)
  (param value (? JSON))
  (return-if null (if (not value)))
  (blank)
  (match value
    (case (: number Float)
      (return number)
    )
    (case (: number Int)
      (return (as number F64))
    )
    (default
      (return null)
    )
  )
)

(fn-expr + bench-number-json JSON
  (param value (? F64))
  (if-expr value (as value JSON) (as null JSON))
)

(fn-expr + bench-rounded F64
  (param value F64)
  (/ (call floor (+ (* value 1000.0) 0.5)) 1000.0)
)

(fn-expr + bench-is-finite Bool
  (param value F64)
  (and (== value value) (== (- value value) 0.0))
)

(fn-do + bench-value-text String
  (param format BenchFormat)
  (param value (? F64))
  (return-if "n/a" (if (not value)))
  (blank)
  (let number value)
  (match format
    (case .duration
      (return-if (str (call bench-fixed (/ number 1000.0) 2) " s") (if (>= number 1000.0)))
      (return (str (call bench-fixed number 0) " ms"))
    )
    (case .count
      (case? (>= number 1000000.0)
        (return (str (call bench-decimal (/ number 1000000.0) 1) "M"))
      )
      (case? (>= number 1000.0)
        (return (str (call bench-decimal (/ number 1000.0) 1) "k"))
      )
      (default
        (return (call bench-fixed number 0))
      )
    )
    (case .rate
      (case? (>= number 1000000.0)
        (return (str (call bench-decimal (/ number 1000000.0) 1) "M/s"))
      )
      (case? (>= number 1000.0)
        (return (str (call bench-decimal (/ number 1000.0) 1) "k/s"))
      )
      (default
        (return (str (call bench-decimal number 1) "/s"))
      )
    )
    (case .percent
      (return (str (call bench-decimal number 1) "%"))
    )
    (case .bytes
      (let units (call (of List String) "B" "KiB" "MiB" "GiB"))
      (let unit 0)
      (let scaled number)
      (while (and (>= scaled 1024.0) (< unit (- (. units length) 1)))
        (= scaled (/ scaled 1024.0))
        (+= unit 1)
      )
      (return (str (call bench-decimal scaled (if-expr (or (>= scaled 100.0) (== unit 0)) 0 1)) " " ([] units unit)))
    )
  )
)

(fn-expr + bench-elapsed-text String
  (param nanoseconds U64)
  (case? (< milliseconds 1000)
    (str milliseconds "ms")
  )
  (case? (< milliseconds 60000)
    (str (/ tenths 10) "." (% tenths 10) "s")
  )
  (default
    (str (/ seconds 60) "m " (% seconds 60) "s")
  )
  (where
    (lazy milliseconds (/ nanoseconds 1000000))
    (lazy tenths (/ milliseconds 100))
    (lazy seconds (/ milliseconds 1000))
  )
)

(fn-expr + bench-delta-text String
  (param percent (? F64))
  (case? (or (not percent) (not (call bench-is-finite percent)))
    "-"
  )
  (case? (< (call abs percent) 0.05)
    "0%"
  )
  (default
    (str sign (call bench-fixed magnitude (if-expr (>= magnitude 10.0) 0 1)) "%")
  )
  (where
    (lazy sign (if-expr (> percent 0.0) "+" "-"))
    (lazy magnitude (call abs percent))
  )
)

(fn-do + bench-fixed String
  (param value F64)
  (param digits Size)
  (let scale 1.0)
  (for (in _ (..< 0 digits))
    (= scale (* scale 10.0))
  )
  (let negative (< value 0.0))
  (let units (as (call floor (+ (* (call abs value) scale) 0.5)) U64))
  (let whole (call bench-grouped (/ units (as scale U64))))
  (let sign (if-expr (and negative (> units 0)) "-" ""))
  (return-if (str sign whole) (if (== digits 0)))
  (blank)
  (let fraction (str (% units (as scale U64))))
  (while (< (. fraction length) digits)
    (= fraction (str "0" fraction))
  )
  (return (str sign whole "." fraction))
)

(fn-do + bench-decimal String
  (param value F64)
  (param digits Size)
  (let text (call bench-fixed value digits))
  (return-if text (if (or (== digits 0) (not (call (. text find) ".")))))
  (blank)
  (let end (. text length))
  (while (== ([] text (- end 1)) '0')
    (-= end 1)
  )
  (if (== ([] text (- end 1)) '.')
    (-= end 1)
  )
  (return ([] text (..< 0 end)))
)

(fn-do _ bench-grouped String
  (param value U64)
  (let digits (str value))
  (let result "")
  (let count 0)
  (let index (. digits length))
  (while (> index 0)
    (if (== count 3)
      (= result (str "," result))
      (= count 0)
    )
    (-= index 1)
    (= result (str ([] digits index) result))
    (+= count 1)
  )
  (return result)
)

(fn-do _ bench-sum (? F64)
  (param sample JSON)
  (param pointers (list String))
  (let total 0.0)
  (let found false)
  (for (in pointer pointers)
    (let value (call bench-json-number (call bench-pointer sample pointer)))
    (if value
      (+= total value)
      (= found true)
    )
  )
  (return (only-if total (if found)))
)

(fn-do _ bench-child-sum (? F64)
  (param sample JSON)
  (param pointer String)
  (param field String)
  (let container (call bench-pointer sample pointer))
  (return-if null (if (not container)))
  (blank)
  (let children (list JSON))
  (match container
    (case (: fields (map String JSON))
      (for (in (tuple _ child) fields)
        (+= children child)
      )
    )
    (case (: items (list JSON))
      (= children items)
    )
    (default
      (return null)
    )
  )
  (let total 0.0)
  (let found false)
  (for (in child children)
    (let value (call bench-json-number (call bench-child-value child field)))
    (if value
      (+= total value)
      (= found true)
    )
  )
  (return (only-if total (if found)))
)

(fn-do _ bench-child-value (? JSON)
  (param child JSON)
  (param field String)
  (return-if child (if (== field "")))
  (return-if (call bench-pointer child field) (if (call (. field starts-with) "/")))
  (blank)
  (match child
    (case (: fields (map String JSON))
      (return ([] fields field))
    )
    (default
      (return null)
    )
  )
)

(fn-do _ bench-pointer-segment String
  (param segment String)
  (let result "")
  (let index 0)
  (while (< index (. segment length))
    (if (and (== ([] segment index) '~') (< (+ index 1) (. segment length)))
      (if (== ([] segment (+ index 1)) '1')
        (= result (str result "/"))
        (+= index 2)
        (continue)
      )
      (if (== ([] segment (+ index 1)) '0')
        (= result (str result "~"))
        (+= index 2)
        (continue)
      )
    )
    (= result (str result ([] segment index)))
    (+= index 1)
  )
  (return result)
)

(fn-do _ bench-index (? Size)
  (param text String)
  (return-if null (if (== text "")))
  (blank)
  (let value Size 0)
  (for (in char text)
    (return-if null (if (or (< char '0') (> char '9'))))
    (blank)
    (= value (+ (* value 10) (- (as char U32) (as '0' U32))))
  )
  (return value)
)
