./../command-template
/data/json
/os/env
/os/file
/os/path
/os/shell
/stream/aggregate
/stream/sort

+ bench-config-path = ".brix/benchmarks.json"
+ bench-default-timeout U64 = 180000
+ bench-setup-timeout U64 = 300000
+ bench-build-path = ".tmp/bench"

_ bench-default-brix [String] = ["brix"]
_ bench-folder-name = "bench"
_ bench-fixtures-name = "fixtures"
_ bench-default-extensions [String] = [".yumi", ".bx"]
_ bench-compile-command = "compile"
_ bench-launch-command = "launch"

+ BenchUnconfiguredError is Error

━━━━━━━━━━━━━━━━━━━━
+ BenchConfig is Tuple

+ root String
+ path String
+ variables [TargetVariable]
+ suites [BenchSuite]
+ metrics [BenchMetric]
+ profiles [BenchProfile]
+ commands [String = BenchCommand]
+ default-profile String

────────────────────
+ do profile BenchProfile ?! Error
    - name String

. wanted = name.trim().lowercased
for profile in profiles
    =? profile if profile.name.lowercased == wanted
. names [String]
for profile in profiles
    names += profile.name
?! Error("Unknown benchmark profile $name; the profiles are ${", ".join(names)}")

────────────────────
+ do suite BenchSuite?
    - name String

for suite in suites
    =? suite if suite.name == name
= null

────────────────────
+ do step TargetStep ?! Error
    - name String
    - profile BenchProfile
    - values [String = String]

. command = commands[name]
?! Error("No command $name in $bench-config-path")
    if !command
await-login-shell-environment()
. settings = Map'String'String()
for key, value in environment()
    settings[key] = value
apply-variables(settings, variables, values)
. local = Map'String'String()
for key, value in values
    local[key] = value
local["root"] = command.folder
local["build"] = bench-build(command.folder, profile)
apply-variables(settings, command.variables, local)
. arguments = expand-arguments(command.run, local)
if profile.probes.length > 0
    arguments ++= expand-arguments(command.probes, local)
= TargetStep(arguments, settings)

━━━━━━━━━━━━━━━━━━━━
+ BenchFormat is Union

| duration
| count
| bytes
| percent
| rate

━━━━━━━━━━━━━━━━━━━━
+ BenchSource is Union

| compile
| run

━━━━━━━━━━━━━━━━━━━━
+ BenchExtractor is Union

| value(pointer String)
| sum(pointers [String])
| child-sum(pointer String, field String)
| ratio(numerator String, denominator String, denominators [String], scale F64)

━━━━━━━━━━━━━━━━━━━━
+ BenchMetric is Tuple

+ key String
+ title String
+ description String
+ format BenchFormat
+ source BenchSource
+ extractor BenchExtractor
+ is-timing Bool
+ min-width Size?

━━━━━━━━━━━━━━━━━━━━
+ BenchProfile is Tuple

+ name String
+ description String
+ is-default Bool
+ metrics [BenchMetric]
+ compiler-probes [String]
+ has-benchmark-metrics Bool
+ setup String?
+ probes [String]
+ default-selectors [String]
+ runs-executable Bool

────────────────────
+ get uses-timing-samples Bool

some(metrics) • where each.is-timing

────────────────────
+ get probe-selectors String

",".join(probes)

────────────────────
+ get compiler-probe-selectors String

",".join(compiler-probes)

━━━━━━━━━━━━━━━━━━━━
+ BenchSuite is Tuple

+ name String
+ path String
+ compile String
+ run String
+ extensions [String]
+ description String

━━━━━━━━━━━━━━━━━━━━
+ BenchCommand is Tuple

+ name String
+ run [String]
+ variables [TargetVariable]
+ probes [String]
+ folder String

━━━━━━━━━━━━━━━━━━━━
+ bench-build String
    - folder String
    - profile BenchProfile

if profile.has-benchmark-metrics then "$folder/$bench-build-path" else "$folder/.tmp/build"

━━━━━━━━━━━━━━━━━━━━
+ do load-bench-config BenchConfig ?! Error
    - root String

. path = Path("$root/$bench-config-path", 0)
. file = bench-file(path, bench-config-path)
. files [BenchFile]
files += BenchFile(file, bench-config-path, root, false)
for config in nested-configs(root, bench-config-path)
    . nested = bench-file(Path("${config.folder}/$bench-config-path", 0), config.label)
    files += BenchFile(nested, config.label, config.folder, true)
. brix = if file.has("brix") then target-arguments(file["brix"]) else bench-default-brix
. commands = built-in-bench-commands(brix, root)
. owners [String = String]
for each in files
    add-bench-commands(commands, owners, each)
. suites [BenchSuite]
if some(files) • where each.file.has("suites")
    . places [String = String]
    for each in files
        add-bench-suites(suites, places, each, commands)
else
    suites = found-bench-suites(root)
    ?! BenchUnconfiguredError("$root has no benchmarks: no folder inside a $bench-folder-name folder, and no $bench-config-path")
        if suites.length == 0 && !path.exists && files.length == 1
. metrics = built-in-bench-metrics()
. by-key [String = BenchMetric]
for metric in metrics
    by-key[metric.key] = metric
for each in files
    if each.file.has("metrics")
        for item in each.file["metrics"].items()
            . metric = bench-metric(item.object())
            ?! Error("Metric ${metric.key} in ${each.label} appears twice or is built in")
                if by-key[metric.key]
            by-key[metric.key] = metric
            metrics += metric
. listed [BenchProfile]
. extensions [BenchExtension]
. defined [String = String]
for each in files
    add-bench-profiles(listed, extensions, defined, each, by-key, commands)
. profiles = built-in-bench-profiles(by-key, !(some(listed) • where each.is-default))
profiles ++= listed
extend-bench-profiles(profiles, extensions)
check-bench-config(root, suites, metrics, profiles)
. default-profile = profiles[0].name
for profile in profiles
    if profile.is-default
        default-profile = profile.name
        break
. variables = if file.has("env") then target-variables(file["env"]) else List'TargetVariable()
= BenchConfig
    - root
    - "$root/$bench-config-path"
    - variables
    - suites
    - metrics
    - profiles
    - commands
    - default-profile

━━━━━━━━━━━━━━━━━━━━
+ do ordered-bench-profiles [BenchProfile]
    - config BenchConfig

. ordered [BenchProfile]
for profile in config.profiles
    if profile.is-default
        ordered += profile
for profile in config.profiles
    if !profile.is-default
        ordered += profile
= ordered

━━━━━━━━━━━━━━━━━━━━
+ do bench-normalized-path String
    - text String

. parts [String]
for part in text.split("/")
    if part == "" || part == "."
        continue
    if part == ".." && parts.length > 0 && parts[parts.length - 1] != ".."
        parts.pop()
    else
        parts += part
. joined = "/".join(parts)
= if text.starts-with("/") then "/$joined" else joined

━━━━━━━━━━━━━━━━━━━━
+ bench-format-name String
    - format BenchFormat

match format
    | .duration
        "duration"
    | .count
        "count"
    | .bytes
        "bytes"
    | .percent
        "percent"
    | .rate
        "rate"

━━━━━━━━━━━━━━━━━━━━
+ bench-source-name String
    - source BenchSource

if source == BenchSource.compile then "compile" else "run"

━━━━━━━━━━━━━━━━━━━━
+ do bench-commas [String]
    - text String

. values [String]
=? values if text.trim() == ""
for part in text.split(",")
    . trimmed = part.trim()
    if trimmed != ""
        values += trimmed
= values

━━━━━━━━━━━━━━━━━━━━
_ BenchFile is Tuple

+ file JSONObjectReader
+ label String
+ folder String
+ is-nested Bool

━━━━━━━━━━━━━━━━━━━━
_ BenchExtension is Tuple

+ name String
+ label String
+ metrics [BenchMetric]

━━━━━━━━━━━━━━━━━━━━
_ do bench-file JSONObjectReader ?! Error
    - path Path
    - label String

. text = if path.exists then read-file-text(path) else "{}"
= JSONReader(label, parse-json(text)).object()

━━━━━━━━━━━━━━━━━━━━
_ do add-bench-suites ?! Error
    - suites [BenchSuite]
    - places [String = String]
    - source BenchFile
    - commands [String = BenchCommand]

=? if !source.file.has("suites")
for item in source.file["suites"].items()
    . suite = bench-suite(source.folder, item.object(), commands)
    . other = places[suite.name]
    ?! Error("Suite ${suite.name} appears twice in ${config-places(other, source.label)}")
        if other
    places[suite.name] = source.label
    suites += suite

━━━━━━━━━━━━━━━━━━━━
_ do add-bench-profiles ?! Error
    - listed [BenchProfile]
    - extensions [BenchExtension]
    - defined [String = String]
    - source BenchFile
    - by-key [String = BenchMetric]
    - commands [String = BenchCommand]

=? if !source.file.has("profiles")
for item in source.file["profiles"].items()
    . entry = item.object()
    if !entry.has("description")
        extensions += bench-extension(entry, by-key, source.label)
        continue
    . profile = bench-profile(entry, by-key, commands)
    . other = defined[profile.name]
    ?! Error("Profile ${profile.name} appears twice in ${config-places(other, source.label)}")
        if other
    defined[profile.name] = source.label
    listed += profile

━━━━━━━━━━━━━━━━━━━━
_ do add-bench-commands ?! Error
    - commands [String = BenchCommand]
    - owners [String = String]
    - source BenchFile

=? if !source.file.has("commands")
. shared = if has-env then target-variables(source.file["env"]) else List'TargetVariable()
    .. has-env = source.is-nested && source.file.has("env")
for name, value in source.file["commands"].object().fields
    ?! Error("Command $name in ${source.label} is built in; give it another name")
        if name == bench-compile-command || name == bench-launch-command
    . other = owners[name]
    ?! Error("Command $name appears twice in ${config-places(other, source.label)}")
        if other
    owners[name] = source.label
    commands[name] = bench-command
        - name
        - JSONReader("${source.label} commands.$name", value).object()
        - source.folder
        - shared

━━━━━━━━━━━━━━━━━━━━
_ do bench-extension BenchExtension ?! Error
    - entry JSONObjectReader
    - by-key [String = BenchMetric]
    - label String

. name = entry["id"].string()
for key, _ in entry.fields
    ?! Error("Profile $name in $label has no description, so it can only add metrics")
        if key != "id" && key != "metrics"
. metrics [BenchMetric]
for key in bench-strings(entry, "metrics")
    . metric = by-key[key]
    ?! Error("Benchmark profile $name in $label references unknown metric $key")
        if !metric
    metrics += metric
= BenchExtension(name, label, metrics)

━━━━━━━━━━━━━━━━━━━━
_ do extend-bench-profiles ?! Error
    - profiles [BenchProfile]
    - extensions [BenchExtension]

for extension in extensions
    . name = extension.name
    . label = extension.label
    . index = bench-profile-index(profiles, name)
    ?! Error("Profile $name in $label has no description, and no other config defines it")
        if index == null
    . profile = profiles[index]
    . metrics = profile.metrics
    for metric in extension.metrics
        ?! Error("Profile $name in $label adds metric ${metric.key}, which it already shows")
            if some(metrics) • where each.key == metric.key
        metrics += metric
    . runs = some(extension.metrics) • where each.source == BenchSource.run
    profiles[index] = BenchProfile
        - profile.name
        - profile.description
        - profile.is-default
        - metrics
        - profile.compiler-probes
        - profile.has-benchmark-metrics
        - profile.setup
        - profile.probes
        - profile.default-selectors
        - profile.runs-executable || runs

━━━━━━━━━━━━━━━━━━━━
_ do bench-profile-index Index?
    - profiles [BenchProfile]
    - name String

for index in 0 .. < profiles.length
    =? index if profiles[index].name == name
= null

━━━━━━━━━━━━━━━━━━━━
_ do built-in-bench-commands [String = BenchCommand]
    - brix [String]
    - root String

. commands [String = BenchCommand]
commands[bench-compile-command] = BenchCommand
    - bench-compile-command
    - compile
    - List'TargetVariable()
    - ["--probes", "\${probes}"]
    - root
commands[bench-launch-command] = BenchCommand
    - bench-launch-command
    - launch
    - launch-variables
    - List'String()
    - root
= commands

.. compile [String]
    ** brix
    * "\${source}"
    * "--compile"
    * "-o"
    * "\${artifact}"
.. launch [String]
    ** brix
    * "bench"
    * "launch"
    * "\${artifact}"
.. launch-variables [TargetVariable]
    * TargetVariable("PROBES_ENABLED", "\${probes}")
    * TargetVariable("PROBES_PATH", "\${trace}")
    * TargetVariable("BRIX_BENCH_METRICS_PATH", "\${metrics}")

━━━━━━━━━━━━━━━━━━━━
_ built-in-bench-metrics [BenchMetric]

metrics

.. metrics [BenchMetric]
    * run-metric("runMs", "Run", "Median wall time of the benchmark process from creation to exit across warm launches, after one discarded launch.", BenchFormat.duration, "/metrics/process/wallMs", true)
    * run-metric
        - "runCpuMs"
        - "Run CPU"
        - "Median user plus system CPU time of the benchmark process across warm launches."
        - BenchFormat.duration
        - "/metrics/process/cpuMs"
        - false
    * run-metric
        - "runInstructions"
        - "Run instr"
        - "Median instructions retired by the benchmark process across warm launches."
        - BenchFormat.count
        - "/metrics/process/instructions"
        - false
    * run-metric
        - "runCycles"
        - "Run cycles"
        - "Median CPU cycles consumed by the benchmark process across warm launches."
        - BenchFormat.count
        - "/metrics/process/cycles"
        - false
    * run-metric
        - "collectorCycles"
        - "GC cycles"
        - "Collections the collector finished, from its gc.cycles probe counter."
        - BenchFormat.count
        - "/metrics/probeCounters/gc.cycles"
        - false
    * run-metric
        - "collectorPauses"
        - "GC pauses"
        - "Pauses the collector made, from its gc.pauses probe counter."
        - BenchFormat.count
        - "/metrics/probeCounters/gc.pauses"
        - false
    * run-metric("collectorAssistNanos", "Assist ns", "Nanoseconds the program spent assisting the collector, from its gc.assist.nanos probe counter.", BenchFormat.count, "/metrics/probeCounters/gc.assist.nanos", false)

━━━━━━━━━━━━━━━━━━━━
_ run-metric BenchMetric
    - key String
    - title String
    - description String
    - format BenchFormat
    - pointer String
    - is-timing Bool

BenchMetric
    - key
    - title
    - description
    - format
    - BenchSource.run
    - BenchExtractor.value(pointer)
    - is-timing
    - null

━━━━━━━━━━━━━━━━━━━━
_ built-in-bench-profiles [BenchProfile]
    - by-key [String = BenchMetric]
    - is-default Bool

List'BenchProfile
    * BenchProfile
        - "timing"
        - "Run time, CPU time, instructions and cycles across warm launches."
        - is-default
        - timing
        - List'String()
        - false
        - null
        - List'String()
        - List'String()
        - true
    * BenchProfile
        - "gc"
        - "Run time, and the collections, pauses and assists the collector's probe counters record."
        - false
        - collector
        - List'String()
        - false
        - null
        - ["gc"]
        - List'String()
        - true

.. timing [BenchMetric] = <* key in ["runMs", "runCpuMs", "runInstructions", "runCycles"]
    by-key[key]!
.. collector [BenchMetric] = <* key in ["runMs", "collectorCycles", "collectorPauses", "collectorAssistNanos"]
    by-key[key]!

━━━━━━━━━━━━━━━━━━━━
_ do found-bench-suites [BenchSuite] ?! Error
    - root String

. folders [String]
collect-bench-folders(Path(root), folders)
. suites [BenchSuite]
. places [String = String]
for folder in sort(folders)
    . children [String] = <* child in Path(folder).contents when child.is-dir && child.name != bench-fixtures-name && !child.name.starts-with(".")
        child as String
    for path in sort(children)
        . name = Path(path).name
        . relative = if path.starts-with("$root/") then path[root.length + 1 ...] else path
        . other = places[name]
        ?! Error("The bench folders $other and $relative both hold a suite named $name; name the suites in $bench-config-path")
            if other
        places[name] = relative
        suites += BenchSuite
            - name
            - path
            - bench-compile-command
            - bench-launch-command
            - bench-default-extensions
            - "The benchmarks in $relative"
= suites

━━━━━━━━━━━━━━━━━━━━
_ do collect-bench-folders ?! Error
    - directory Path
    - folders [String]

for child in directory.contents
    if !child.is-dir || child.name.starts-with(".")
        continue
    if child.name == bench-folder-name
        folders += child as String
    else
        collect-bench-folders(child, folders)

━━━━━━━━━━━━━━━━━━━━
_ bench-command BenchCommand ?! Error
    - name String
    - entry JSONObjectReader
    - folder String
    - shared [TargetVariable]

BenchCommand
    - name
    - target-arguments(entry["run"])
    - shared ++ (if entry.has("env") then target-variables(entry["env"]) else List'TargetVariable())
    - bench-strings(entry, "probes")
    - folder

━━━━━━━━━━━━━━━━━━━━
_ do bench-suite BenchSuite ?! Error
    - root String
    - entry JSONObjectReader
    - commands [String = BenchCommand]

. name = entry["id"].string()
. compile = if entry.has("compile") then entry["compile"].string() else bench-compile-command
. run = if entry.has("run") then entry["run"].string() else bench-launch-command
for command in List'String(compile, run)
    ?! Error("Benchmark suite $name names unknown command $command")
        if !commands[command]
. description = if entry.has("description") then entry["description"].string() else ""
. path = entry["path"].string()
. extensions [String]
for extension in bench-strings(entry, "extensions")
    extensions += if extension.starts-with(".") then extension else ".$extension"
if !extensions
    extensions = bench-default-extensions
= BenchSuite
    - name
    - bench-normalized-path(if path.starts-with("/") then path else "$root/$path")
    - compile
    - run
    - extensions
    - description

━━━━━━━━━━━━━━━━━━━━
_ do bench-metric BenchMetric ?! Error
    - entry JSONObjectReader

. key = entry["id"].string()
. extractors [BenchExtractor]
if entry.has("value")
    extractors += BenchExtractor.value(entry["value"].string())
if entry.has("sum")
    extractors += BenchExtractor.sum(bench-strings(entry, "sum"))
if entry.has("childSum")
    . child = entry["childSum"].object()
    extractors += BenchExtractor.child-sum(child["object"].string(), child["value"].string())
if entry.has("ratio")
    . ratio = entry["ratio"].object()
    . denominator = if ratio.has("denominator") then ratio["denominator"].string() else ""
    . scale = if ratio.has("scale") then ratio["scale"].number() else 1.0
    extractors += BenchExtractor.ratio
        - ratio["numerator"].string()
        - denominator
        - bench-strings(ratio, "denominatorSum")
        - scale
?! Error("Benchmark metric $key must define exactly one of value, sum, childSum or ratio")
    if extractors.length != 1
. source = entry["source"].string()
?! Error("Invalid source '$source' for benchmark metric $key")
    if source != "compile" && source != "run"
= BenchMetric
    - key
    - entry["title"].string()
    - entry["description"].string()
    - bench-format(entry["format"].string(), key)
    - if source == "compile" then BenchSource.compile else BenchSource.run
    - extractors[0]
    - if entry.has("timing") then entry["timing"].bool() else false
    - (entry["minWidth"].number() as Size) if entry.has("minWidth")

━━━━━━━━━━━━━━━━━━━━
_ do bench-profile BenchProfile ?! Error
    - entry JSONObjectReader
    - by-key [String = BenchMetric]
    - commands [String = BenchCommand]

. name = entry["id"].string()
. metrics [BenchMetric]
for key in bench-strings(entry, "metrics")
    . metric = by-key[key]
    ?! Error("Benchmark profile $name references unknown metric $key")
        if !metric
    metrics += metric
. setup = entry["setup"].string() if entry.has("setup")
?! Error("Benchmark profile $name names unknown setup command ${setup}")
    if setup && !commands[setup]
. has-benchmark-metrics = if entry.has("benchmarkMetrics") then entry["benchmarkMetrics"].bool() else false
?! Error("Benchmark profile $name enables benchmarkMetrics but does not define setup")
    if has-benchmark-metrics && !setup
. probes = bench-strings(entry, "probes")
. runs = has-benchmark-metrics || probes.length > 0
for metric in metrics
    runs = runs || metric.source == BenchSource.run
= BenchProfile
    - name
    - entry["description"].string()
    - if entry.has("default") then entry["default"].bool() else false
    - metrics
    - bench-strings(entry, "compilerProbes")
    - has-benchmark-metrics
    - setup
    - probes
    - bench-strings(entry, "selectors")
    - runs

━━━━━━━━━━━━━━━━━━━━
_ do check-bench-config ?! Error
    - root String
    - suites [BenchSuite]
    - metrics [BenchMetric]
    - profiles [BenchProfile]

?! Error("$root has no benchmarks: no folder inside a $bench-folder-name folder, and no suites in $bench-config-path")
    if suites.length == 0
. names [String = Bool]
for suite in suites
    check-bench-identifier("suite", suite.name)
    ?! Error("Suite ${suite.name} appears twice in $bench-config-path")
        if names[suite.name]
    names[suite.name] = true
for metric in metrics
    check-bench-identifier("metric", metric.key)
. profile-names [String = Bool]
for profile in profiles
    check-bench-identifier("profile", profile.name)
    ?! Error("Benchmark profile ${profile.name} must list at least one metric")
        if profile.metrics.length == 0
    ?! Error("Profile ${profile.name} appears twice in $bench-config-path")
        if profile-names[profile.name]
    profile-names[profile.name] = true

━━━━━━━━━━━━━━━━━━━━
_ do check-bench-identifier ?! Error
    - kind String
    - text String

. is-valid = text.length > 0
. starts = true
for char in text
    if starts
        is-valid = is-valid && char >= 'a' && char <= 'z'
        starts = false
    else if char == '/'
        starts = true
    else
        is-valid = is-valid && (is-letter || (char >= '0' && char <= '9') || char == '-')
            .. is-letter = (char >= 'a' && char <= 'z') || (char >= 'A' && char <= 'Z')
?! Error("Invalid benchmark $kind '$text'")
    if !is-valid || starts

━━━━━━━━━━━━━━━━━━━━
_ do bench-format BenchFormat ?! Error
    - text String
    - key String

do match? text
    |= "count"
        = BenchFormat.count
    |= "duration"
        = BenchFormat.duration
    |= "bytes"
        = BenchFormat.bytes
    |= "percent"
        = BenchFormat.percent
    |= "rate"
        = BenchFormat.rate
?! Error("Invalid format '$text' for benchmark metric $key")

━━━━━━━━━━━━━━━━━━━━
_ do bench-strings [String] ?! Error
    - entry JSONObjectReader
    - key String

. values [String]
=? values if !entry.has(key)
for item in entry[key].items()
    values += item.string()
= values
