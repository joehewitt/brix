(import /data/json)
(import /data/jsonrpc)
(import /lang/analysis/analysis-service)
(import /lang/ast/syntax-program)
(import /lang/target)
(import /os/file)
(import /os/memory-pressure)
(import /os/path)
(import /os/power)
(import /stream/aggregate)
(import /time/duration)
(import /unistd.h)

(type + BuildResult (is Tuple)
  (prop + status Int)
  (prop + output String)
  (prop + product (? String))
)

(type + BuildRunner (is (fn-type BuildResult (param arguments (list String)))))

(type _ BuildStep (is Union)
  (variant build (tuple (: job BuildJob)))
  (variant rest)
  (variant idle)
)

(type + BuildDaemon
  (prop + analysis AnalysisService)
  (prop + modules ModuleView)
  (prop + search-paths (list Path))
  (prop + runner BuildRunner)
  (prop + settling _ (= 100ms))
  (prop + rest (? Doer))
  (prop _ lock _ (= (call Mutex)))
  (prop _ builder _ (= (call Worker)))
  (prop _ analyzer _ (= (call Worker)))
  (prop _ messages _ (= (call (of SyncBufferedChannel JSONRPCMessage))))
  (prop _ sightings _ (= (call (of SyncBufferedChannel (of List String)))))
  (prop _ replies File)
  (prop _ reply-lock _ (= (call Mutex)))
  (prop _ queued (list BuildJob))
  (prop _ running (? BuildJob))
  (prop _ finished (map String BuildJob))
  (prop _ resting (list String))
  (prop _ resting-limit _ (= 8))
  (prop _ digests (map String KeptDigest))
  (prop _ watching (map String (list String)))
  (prop _ live (map String Bool))
  (prop _ completed _ (= 0))
  (prop _ generation _ (= 0))
  (prop _ is-working Bool)
  (prop _ is-closing Bool)
  (prop _ idle _ (= (call (of Semaphore Void))))
  (prop _ analyzed _ (= (call (of Semaphore Void))))
  (prop _ quiet _ (= (call (of Semaphore Void))))
  (prop _ outstanding _ (= 0))
  (prop _ is-ending Bool)
  (prop _ has-departed Bool)
  (prop _ streams (list Closable))
  (prop _ watched (list String))
  (prop _ changes (map String Bool))
  (prop _ must-rescan Bool)
  (prop _ is-pending Bool)
  (prop _ is-serving Bool)
  (prop _ is-pressed Bool)
  (prop _ rested _ (= 0))
  (fn-do + This _
    (param analysis AnalysisService)
    (param modules ModuleView)
    (param search-paths (list Path))
    (param runner BuildRunner)
    (lazy replies (call File (call C:dup 1) true false))
  )
  (subscribe-for (on pressure memory-pressure (whenever #is-serving))
    (call relieve)
  )
  (fn-do + serve Int
    (= is-serving true)
    (probe-group + compiler.daemon.serve (text: "serving"))
    (do-new (worker: analyzer)
      (inline (call analyze))
    )
    (do-new
      (inline (call watch-sightings))
    )
    (let lines (of Iterable String) stdin)
    (for (in line lines)
      (if has-departed
        (break)
      )
      (if (!= (. line length) 0)
        (call receive line)
      )
    )
    (= is-ending true)
    (= is-serving false)
    (call (. messages close))
    (call (. analyzed wait))
    (while (!= outstanding 0)
      (call (. quiet wait))
    )
    (if (call close-builds)
      (call (. idle wait))
    )
    (call (. sightings close))
    (for (in stream streams)
      (call (. stream close))
    )
    (probe-group - compiler.daemon.serve (text: "served"))
    (return 0)
  )
  (fn-do _ build BuildRecord
    (param arguments (list String))
    (let key (call (. "\n" join) arguments))
    (probe-group + compiler.daemon.request (text: "request " (call (. " " join) arguments)))
    (finally
      (probe-group - compiler.daemon.request (text: "answered " (call (. " " join) arguments)))
    )
    (let joined (? BuildJob) null)
    (while true
      (let waiter (call (of Semaphore Void)))
      (let ticket (call enlist key arguments waiter joined))
      (return-if (!! (. ticket job record)) (if (. ticket is-answered)))
      (blank)
      (call (. waiter wait))
      (= joined (. ticket job))
    )
  )
  (fn-do _ receive _
    (param line String)
    (let parsed (catch (call parse-json-rpc line)))
    (if (is parsed Error)
      (call reply (call JSONRPCResponse null (call .error (call JSONRPCError .parse-error (. (as parsed Error) message)))))
      (return)
    )
    (let message (as parsed JSONRPCMessage))
    (if (is message JSONRPCRequest)
      (let request (as message JSONRPCRequest))
      (if (== (. request method) "build")
        (+= outstanding 1)
        (do-new
          (inline (call answer-build request))
        )
        (return)
      )
      (if (== (. request method) "watch")
        (call reply (call answer-watch request))
        (return)
      )
      (if (== (. request method) "unwatch")
        (call reply (call answer-unwatch request))
        (return)
      )
    )
    (<- messages message)
  )
  (fn-do _ answer-build _
    (param request JSONRPCRequest)
    (let arguments (catch (call build-arguments (. request params))))
    (if (is arguments JSONRPCError)
      (call reply (call (. request error-response) arguments))
      (else-if (is arguments Error)
        (call reply (call (. request error-response) (call JSONRPCError .invalid-params (. arguments message))))
      )
      (else
        (let watches (catch? (call build-watches (. request params))))
        (if (?? watches false)
          (call watch arguments true)
        )
        (call reply (call (. request response) (call record-fields (call build arguments))))
      )
    )
    (-= outstanding 1)
    (call (. quiet post))
  )
  (fn-do _ answer-watch JSONRPCResponse
    (param request JSONRPCRequest)
    (let arguments (catch (call build-arguments (. request params))))
    (return-if (call (. request error-response) arguments) (if (is arguments JSONRPCError)))
    (return-if (call (. request error-response) (call JSONRPCError .invalid-params (. arguments message))) (if (is arguments Error)))
    (blank)
    (call watch arguments false)
    (call schedule)
    (return (call (. request response) true))
  )
  (fn-do _ answer-unwatch JSONRPCResponse
    (param request JSONRPCRequest)
    (let arguments (catch (call build-arguments (. request params))))
    (return-if (call (. request error-response) arguments) (if (is arguments JSONRPCError)))
    (return-if (call (. request error-response) (call JSONRPCError .invalid-params (. arguments message))) (if (is arguments Error)))
    (blank)
    (call unwatch arguments)
    (return (call (. request response) true))
  )
  (fn-do _ watch _
    (param arguments (list String))
    (param is-live Bool)
    (use lock)
    (let key (call (. "\n" join) arguments))
    (= ([] watching key) arguments)
    (if is-live
      (= ([] live key) true)
    )
    (call wake key)
  )
  (fn-do _ unwatch _
    (param arguments (list String))
    (use lock)
    (let key (call (. "\n" join) arguments))
    (-= ([] watching key))
    (-= ([] live key))
    (if ([] finished key)
      (call settle key)
    )
  )
  (fn-do _ wake _
    (param key String)
    (= resting (case-each (in other resting (when (!= other key))) other))
  )
  (fn-do _ settle _
    (param key String)
    (call wake key)
    (return-if (if ([] watching key)))
    (blank)
    (+= resting key)
    (while (> (. resting length) resting-limit)
      (-= ([] finished ([] resting 0)))
      (call (. resting remove) 0)
    )
  )
  (fn-do _ announce _
    (param arguments (list String))
    (param record BuildRecord)
    (let params (call record-fields record))
    (= ([] params "arguments") (call (of List JSON) (in each arguments)))
    (call send (str (call JSONRPCNotification "built" params) "\n"))
  )
  (fn-do _ analyze _
    (for (in message messages)
      (match? message
        (case (: request JSONRPCRequest)
          (call reply (call respond request))
        )
        (case (: notification JSONRPCNotification)
          (if (call (. analysis answers) (. notification method))
            (catch (call (. analysis perform) (. notification method) (. notification params)))
          )
        )
      )
      (let inputs (call (. analysis store take-inputs)))
      (if (!= (. inputs length) 0)
        (<- sightings (call present-paths inputs))
      )
    )
    (call (. analyzed post))
  )
  (fn-do _ respond JSONRPCResponse
    (param request JSONRPCRequest)
    (let result (catch (call perform request)))
    (if (is result JSONRPCError)
      (return (call (. request error-response) result))
    )
    (if (is result Error)
      (return (call (. request error-response) (call JSONRPCError .internal-error (. (as result Error) message))))
    )
    (return (call (. request response) result))
  )
  (fn-do _ perform JSON (?! Error)
    (param request JSONRPCRequest)
    (throw (call JSONRPCError .method-not-found (str "Unknown method " (. request method))) (if (not (call (. analysis answers) (. request method)))))
    (return (call (. analysis perform) (. request method) (. request params)))
  )
  (fn-do _ reply _
    (param response JSONRPCResponse)
    (call send (str response "\n"))
  )
  (fn-do _ send _
    (param line String)
    (use reply-lock)
    (return-if (if has-departed))
    (blank)
    (scope (<- replies line)
      (on-error IOError
        (= has-departed true)
      )
    )
  )
  (fn-do _ enlist BuildTicket
    (param key String)
    (param arguments (list String))
    (param waiter (of Semaphore Void))
    (param joined (? BuildJob))
    (use lock)
    (if joined
      (return-if (call BuildTicket joined true) (if (call matches (!! (. joined record)))))
    )
    (let finished-job ([] finished key))
    (if (and finished-job (call is-current (!! (. finished-job record))))
      (probe-log compiler.daemon.hit (text: "hit " (call (. " " join) arguments) " number " (?. (. finished-job record) number)))
      (call settle key)
      (return (call BuildTicket finished-job true))
    )
    (let job (call job-for key arguments true))
    (probe-log compiler.daemon.miss (text: "miss " (call (. " " join) arguments)))
    (+= (. job waiters) waiter)
    (return (call BuildTicket job false))
  )
  (fn-do _ speculate _
    (use lock)
    (return-if (if is-closing))
    (blank)
    (let defers (call is-on-battery))
    (for (in (tuple key arguments) watching (when (or (not ([] finished key)) (not (call is-current (!! (. (!! ([] finished key)) record)))))))
      (if (or (not defers) ([] live key))
        (probe-log compiler.daemon.speculate (text: "speculating " (call (. " " join) arguments)))
        (call job-for key arguments false)
        (else
          (probe-log compiler.daemon.defer (text: "deferred " (call (. " " join) arguments) " on battery"))
        )
      )
    )
  )
  (fn-do _ job-for BuildJob
    (param key String)
    (param arguments (list String))
    (param is-asked Bool)
    (for (in index (..< 0 (. queued length)))
      (let job ([] queued index))
      (if (== (. job key) key)
        (if (and is-asked (not (. job is-asked)))
          (probe-log compiler.daemon.promote (text: "promoted " (call (. " " join) arguments) " from " index))
          (call (. queued remove) index)
          (= (. job is-asked) true)
          (call enqueue job)
        )
        (return job)
      )
    )
    (let active running)
    (return-if active (if (and active (== (. active key) key) (== (. active generation) generation))))
    (blank)
    (let job (call BuildJob key arguments))
    (= (. job is-asked) is-asked)
    (probe-log compiler.daemon.queue (text: "queued " (call (. " " join) arguments) " after " (. queued length) " queued, building " (!= active null) ", asked " is-asked))
    (call enqueue job)
    (if (not is-working)
      (= is-working true)
      (do-new (worker: builder)
        (inline (call work))
      )
    )
    (return job)
  )
  (fn-do _ enqueue _
    (param job BuildJob)
    (let place (if-expr (. job is-asked) 0 (. queued length)))
    (while (and (< place (. queued length)) (. ([] queued place) is-asked))
      (+= place 1)
    )
    (call (. queued insert) job place)
  )
  (fn-do _ work _
    (while true
      (match (call take)
        (case (call .build job)
          (call run job)
        )
        (case .rest
          (let action rest)
          (if action
            (probe-group + compiler.daemon.rest)
            (catch (call action))
            (probe-group - compiler.daemon.rest)
          )
        )
        (case .idle
          (return)
        )
      )
    )
  )
  (fn-do _ run _
    (param job BuildJob)
    (probe-group + compiler.daemon.build (text: "building " (call (. " " join) (. job arguments))))
    (let result (call runner (. job arguments)))
    (probe-group - compiler.daemon.build (text: "built " (call (. " " join) (. job arguments)) " status " (. result status)))
    (let inputs (call (. modules take-inputs)))
    (let product (. result product))
    (+= completed 1)
    (let record
      (call BuildRecord
        (block
          (arg result)
          (arg inputs)
          (arg (only-if (call file-stamp product) (if product)))
          (arg (. job generation))
          (arg completed)
        )
      )
    )
    (call finish job record)
    (call announce (. job arguments) record)
    (call keep-digests record)
    (<- sightings (call present-paths inputs))
    (if (not (call still-matches record))
      (probe-log compiler.daemon.stale (text: "stale " (call (. " " join) (. job arguments)) " number " (. record number)))
      (call speculate)
    )
  )
  (fn-do _ take BuildStep
    (use lock)
    (if (== (. queued length) 0)
      (if (and is-pressed (not is-closing))
        (= is-pressed false)
        (= rested completed)
        (return (. BuildStep rest))
      )
      (= is-working false)
      (if is-closing
        (call (. idle post))
      )
      (return (. BuildStep idle))
    )
    (let job ([] queued 0))
    (call (. queued remove) 0)
    (= (. job generation) generation)
    (= running job)
    (return (call (. BuildStep build) job))
  )
  (fn-do _ relieve _
    (use lock)
    (return-if (if (or is-closing (not rest))))
    (return-if (if (and (not is-working) (== rested completed))))
    (blank)
    (= is-pressed true)
    (if (not is-working)
      (= is-working true)
      (do-new (worker: builder)
        (inline (call work))
      )
    )
  )
  (fn-do _ finish _
    (param job BuildJob)
    (param record BuildRecord)
    (use lock)
    (probe-log compiler.daemon.finish (text: "finished " (call (. " " join) (. job arguments)) " number " (. record number) " for " (. job waiters length) " waiting"))
    (= (. job record) record)
    (= ([] finished (. job key)) job)
    (= running null)
    (for (in waiter (. job waiters))
      (call (. waiter post))
    )
    (call (. (. job waiters) clear))
    (call settle (. job key))
  )
  (fn-do _ close-builds Bool
    (use lock)
    (= is-closing true)
    (return is-working)
  )
  (fn-do _ is-current Bool
    (param record BuildRecord)
    (return-if false (if (!= (. record generation) generation)))
    (blank)
    (let product (. record result product))
    (if product
      (return-if false (if (!= (call file-stamp product) (. record product-stamp))))
    )
    (return (call matches record))
  )
  (fn-do _ still-matches Bool
    (param record BuildRecord)
    (use lock)
    (return (call matches record))
  )
  (fn-do _ matches Bool
    (param record BuildRecord)
    (for (in (tuple path stamp) (. record inputs))
      (return-if false (if (not (call is-unchanged path stamp))))
    )
    (return true)
  )
  (fn-do _ is-unchanged Bool
    (param path String)
    (param stamp ParseStamp)
    (let now (call file-stamp path))
    (return-if (not now) (if (not (. stamp is-file))))
    (return-if true (if (== now stamp)))
    (blank)
    (let kept ([] digests path))
    (return-if false (if (or (not now) (not kept) (!= (. kept stamp) stamp) (!= (. now size) (. stamp size)))))
    (return-if true (if (== (. kept alike) now)))
    (blank)
    (let bytes (catch? (call read-file-bytes (call Path path))))
    (return-if false (if (or (not bytes) (!= (call fnv-hash bytes (. bytes size)) (. kept digest)) (!= (call file-stamp path) now))))
    (blank)
    (= (. kept alike) now)
    (return true)
  )
  (fn-do _ keep-digests _
    (param record BuildRecord)
    (for (in (tuple path stamp) (. record inputs))
      (if (and (. stamp is-file) (call source-stem path) (not (call has-digest path stamp)))
        (let before (call file-stamp path))
        (let bytes (catch? (call read-file-bytes (call Path path))))
        (if (and bytes (== before stamp) (== (call file-stamp path) stamp))
          (call keep-digest path stamp (call fnv-hash bytes (. bytes size)))
        )
      )
    )
  )
  (fn-do _ has-digest Bool
    (param path String)
    (param stamp ParseStamp)
    (use lock)
    (return (== (?. ([] digests path) stamp) stamp))
  )
  (fn-do _ keep-digest _
    (param path String)
    (param stamp ParseStamp)
    (param digest U64)
    (use lock)
    (= ([] digests path) (call KeptDigest stamp digest))
  )
  (fn-do _ watch-sightings _
    (for (in paths sightings)
      (let roots (map String Bool))
      (for (in path paths (when (call source-stem path)))
        (= ([] roots (call root-of path)) true)
      )
      (for (in (tuple root _) roots)
        (if (and (not (call is-nested root roots)) (not (call is-within root watched)))
          (call watch root)
        )
      )
    )
  )
  (fn-do _ root-of String
    (param path String)
    (for (in search search-paths)
      (let root (as search String))
      (return-if root (if (call (. path starts-with) (str root "/"))))
    )
    (let parent (. (call Path path) parent))
    (return (if-expr parent (as parent String) path))
  )
  (fn-do _ watch _
    (param root String)
    (let stream (call (. (call Path root) watch) true))
    (for (on event stream)
      (call note event)
    )
    (+= streams stream)
    (+= watched root)
  )
  (fn-do _ note _
    (param event PathWatchEvent)
    (return-if (if is-ending))
    (blank)
    (let path (as (. event path) String))
    (return-if (if (and (not (. event must-rescan)) (not (call source-stem path)))))
    (blank)
    (probe-count compiler.daemon.events)
    (if (. event must-rescan)
      (call advance)
      (= must-rescan true)
      (else
        (= ([] changes path) true)
      )
    )
    (call schedule)
  )
  (fn-do _ advance _
    (use lock)
    (+= generation 1)
  )
  (fn-do _ schedule _
    (return-if (if is-pending))
    (blank)
    (= is-pending true)
    (do-new
      (call (. settling wait))
      (= is-pending false)
      (call flush)
    )
  )
  (fn-do _ flush _
    (return-if (if is-ending))
    (blank)
    (probe-log compiler.daemon.changes (text: "changed " (. changes length) " sources, rescan " must-rescan))
    (for (in (tuple path _) changes)
      (let params
        (call (of Map String JSON)
          (block
            (:path path)
          )
        )
      )
      (<- messages (call JSONRPCNotification "changed" params))
    )
    (call (. changes clear))
    (if must-rescan
      (<- messages (call JSONRPCNotification "changed" (call (of Map String JSON))))
      (= must-rescan false)
    )
    (call speculate)
  )
)

(type _ BuildJob
  (prop + key String)
  (prop + arguments (list String))
  (prop + generation _ (= 0))
  (prop + is-asked Bool)
  (prop + waiters (list (of Semaphore Void)))
  (prop + record (? BuildRecord))
  (fn-do + This _
    (param key String)
    (param arguments (list String))
  )
)

(type _ BuildRecord (is Tuple)
  (prop + result BuildResult)
  (prop + inputs (map String ParseStamp))
  (prop + product-stamp (? ParseStamp))
  (prop + generation Int)
  (prop + number Int)
)

(type _ KeptDigest
  (prop + stamp ParseStamp)
  (prop + digest U64)
  (prop + alike (? ParseStamp))
  (fn-do + This _
    (param stamp ParseStamp)
    (param digest U64)
  )
)

(type _ BuildTicket (is Tuple)
  (prop + job BuildJob)
  (prop + is-answered Bool)
)

(fn-expr _ present-paths (list String)
  (param inputs (map String ParseStamp))
  (case-each (in (tuple path stamp) inputs (when (. stamp is-file)))
    path
  )
)

(fn-expr _ is-within Bool
  (param path String)
  (param roots (list String))
  (call some roots (:where (or (== path each) (call (. path starts-with) (str each "/")))))
)

(fn-expr _ is-nested Bool
  (param path String)
  (param roots (map String Bool))
  (call some (. roots keys) (:where (call (. path starts-with) (str each "/"))))
)

(fn-expr _ record-fields (of Map String JSON)
  (param record BuildRecord)
  (call (of Map String JSON)
    (block
      (:status (. record result status))
      (:output (. record result output))
      (:product? (. record result product))
      (:number (. record number))
    )
  )
)

(fn-expr _ build-watches Bool (?! Error)
  (param params JSON)
  (if-expr (call (. fields has) "watch") (call (. ([] fields "watch") bool)) false)
  (where
    (lazy fields (call (. (call JSONReader "params" params) object)))
  )
)

(fn-expr _ build-arguments (list String) (?! Error)
  (param params JSON)
  (in (call (. each string)) (call (. ([] (call (. (call JSONReader "params" params) object)) "arguments") items)))
)
