(import ./../command-template)
(import /data/json)
(import /os/env)
(import /os/file)
(import /os/path)
(import /os/shell)
(import /time/duration)
(blank)
(prop + test-config-path _ (= ".brix/tests.json"))
(blank)
(prop _ test-idle-timeout _ (= 300s))
(prop _ test-protocol-prefix _ (= "OMETER_TESTOMETER_"))
(prop _ default-brix (list String) (= (list "brix")))
(prop _ default-suite-name _ (= "tests"))

(type + TestConfig (is Tuple)
  (prop + root String)
  (prop + variables (list TargetVariable))
  (prop + suites (list TestSuiteConfig))
  (fn-do + step TargetStep (?! Error)
    (param suite TestSuiteConfig)
    (param arguments (list String))
    (param extra (map String String))
    (let environment (call test-environment root (. suite id)))
    (for (in (tuple name value) extra)
      (= ([] environment name) value)
    )
    (let values
      (call (of Map String String)
        (block
          (entry "root" root)
        )
      )
    )
    (call apply-variables environment variables values)
    (call apply-variables environment (. suite variables) values)
    (return (call TargetStep (call expand-arguments arguments values) environment))
  )
)

(type + TestSuiteConfig (is Tuple)
  (prop + id String)
  (prop + catalog (list String))
  (prop + run (list String))
  (prop + variables (list TargetVariable))
  (prop + idle-timeout Seconds)
  (prop + modes (map String (list String)))
)

(fn-do + load-test-config TestConfig (?! Error)
  (param root String)
  (let path (call Path (str root "/" test-config-path) 0))
  (let nested (call nested-configs root test-config-path))
  (return-if (call default-test-config root) (if (and (not (. path exists)) (not nested))))
  (blank)
  (let file (call test-file path test-config-path))
  (let brix (if-expr (call (. file has) "brix") (call target-arguments ([] file "brix")) default-brix))
  (let suites (list TestSuiteConfig))
  (let claimed (map String String))
  (let layers (map String TestLayer))
  (= ([] layers root) (call TestLayer brix (call (of List TargetVariable))))
  (call add-test-suites suites claimed file test-config-path null (!! ([] layers root)))
  (for (in config nested)
    (let entry (call test-file (call Path (str (. config folder) "/" test-config-path) 0) (. config label)))
    (let inherited (!! ([] layers (. config parent))))
    (let folder (. config folder))
    (let given-brix (only-if (call rebased-paths (call target-arguments ([] entry "brix")) folder) (if (call (. entry has) "brix"))))
    (let given-env (if-expr (call (. entry has) "env") (call target-variables ([] entry "env")) (call (of List TargetVariable))))
    (let layer
      (call TestLayer
        (block
          (arg (?? given-brix (. inherited brix)))
          (arg (++ (. inherited variables) (call rebased-variables given-env folder)))
        )
      )
    )
    (= ([] layers folder) layer)
    (call add-test-suites suites claimed entry (. config label) folder layer)
  )
  (let variables (if-expr (call (. file has) "env") (call target-variables ([] file "env")) (call (of List TargetVariable))))
  (return (call TestConfig root variables suites))
)

(type _ TestLayer (is Tuple)
  (prop + brix (list String))
  (prop + variables (list TargetVariable))
)

(fn-expr _ default-test-config TestConfig
  (param root String)
  (call TestConfig root none (list suite))
  (where
    (lazy none (call (of List TargetVariable)))
    (lazy suite (call module-suite default-brix default-suite-name (list ".") none test-idle-timeout))
  )
)

(fn-do _ test-file JSONObjectReader (?! Error)
  (param path Path)
  (param label String)
  (let text (if-expr (. path exists) (call read-file-text path) "{}"))
  (return (call (. (call JSONReader label (call parse-json text)) object)))
)

(fn-do _ add-test-suites _ (?! Error)
  (param suites (list TestSuiteConfig))
  (param claimed (map String String))
  (param file JSONObjectReader)
  (param label String)
  (param folder (? String))
  (param layer TestLayer)
  (return-if (if (not (call (. file has) "suites"))))
  (blank)
  (for (in item (call (. ([] file "suites") items)))
    (let entry (call (. item object)))
    (let id (call (. ([] entry "id") string)))
    (let other ([] claimed id))
    (throw (call Error (str "Suite " id " appears twice in " (call config-places other label))) (if other))
    (blank)
    (= ([] claimed id) label)
    (let own (if-expr (call (. entry has) "env") (call target-variables ([] entry "env")) (call (of List TargetVariable))))
    (let variables (++ (. layer variables) (call rebased-variables own folder)))
    (let timeout
      (block
        (case? (call (. entry has) "timeout")
          (as (call (. ([] entry "timeout") number)) Seconds)
        )
        (default
          test-idle-timeout
        )
      )
    )
    (if (call (. entry has) "modules")
      (let sources (call rebased-paths (call module-sources ([] entry "modules")) folder))
      (+= suites (call module-suite (. layer brix) id sources variables timeout))
      (continue)
    )
    (+= suites
      (call TestSuiteConfig
        (block
          (arg id)
          (arg (call rebased-paths (call target-arguments ([] entry "catalog")) folder))
          (arg (call rebased-paths (call target-arguments ([] entry "run")) folder))
          (arg variables)
          (arg timeout)
          (arg (call test-modes entry folder))
        )
      )
    )
  )
)

(fn-expr _ module-sources (list String) (?! Error)
  (param reader JSONReader)
  ; What a suite with modules names: one folder, or a list of folders and of modules named by their
  ; path without `.bx`.
  (case? (is (. reader value) String)
    (list (as (. reader value) String))
  )
  (default
    (case-each (in item (call (. reader items)))
      (call (. item string))
    )
  )
)

(fn-expr _ module-suite TestSuiteConfig
  (param brix (list String))
  (param id String)
  (param sources (list String))
  (param variables (list TargetVariable))
  (param timeout Seconds)
  (call TestSuiteConfig
    (block
      (arg id)
      (arg (call modules-command brix "catalog-modules" sources))
      (arg (call modules-command brix "run-modules" sources))
      (arg variables)
      (arg timeout)
      (arg (call (of Map String (list String))))
    )
  )
)

(fn-expr _ modules-command (list String)
  (param brix (list String))
  (param action String)
  (param sources (list String))
  parts
  (where
    (lazy parts (list String)
      (block
        (spread brix)
        (item "test")
        (item action)
        (spread sources)
      )
    )
  )
)

(fn-do _ test-modes (map String (list String)) (?! Error)
  (param entry JSONObjectReader)
  (param folder (? String))
  (let modes (map String (list String)))
  (return-if modes (if (not (call (. entry has) "modes"))))
  (blank)
  (let reader ([] entry "modes"))
  (for (in (tuple name value) (. (call (. reader object)) fields))
    (let arguments (list String))
    (for (in item (call (. (call JSONReader (str (. reader label) "." name) value) items)))
      (+= arguments (call rebased-path (call (. item string)) folder))
    )
    (= ([] modes name) arguments)
  )
  (return modes)
)

(fn-do _ test-environment (map String String)
  (param root String)
  (param suite String)
  (call await-login-shell-environment)
  (let variables (call (of Map String String)))
  (for (in (tuple name value) (call environment))
    (if (not (call (. name starts-with) test-protocol-prefix))
      (= ([] variables name) value)
    )
  )
  (= ([] variables (str test-protocol-prefix "PROJECT_ROOT")) root)
  (= ([] variables (str test-protocol-prefix "SUITE_NAME")) suite)
  (return variables)
)
