(import ./suite-runner)
(import ./test-protocol)
(import /data/json)
(import /lang/constants)
(import /os/cli)
(import /os/env)
(import /os/file)
(import /os/path)
(import /os/process)
(import /unistd.h)
(blank)
(prop _ suite-protocol _ (= "ometer.testometer.v1"))
(prop _ suite-statuses (list String) (= (list "passed" "failed" "skipped" "crashed" "killed")))
(prop _ suite-reserved-cores _ (= 2))
(prop _ suite-core-batch-floor _ (= 100))
(prop _ suite-batch-ceiling _ (= 32))
(blank)

(main
  (call request-process-termination (call (. (call SuiteTool) run)))
)

(type _ SuiteTool (is CommandLine)
  (content
    (<> This
      (= name "brix test-suite")
      (blank)
      (<> Subcommand (text: "catalog")
        (= about "list the tests of the suite BRIX_TEST_SUITE names, under BRIX_TEST_ROOT")
        (= action (=> () (call emit-suite-catalog)))
      )
      (blank)
      (<> Subcommand (text: "run")
        (= about
          (paragraph
            "run the tests OMETER_TESTOMETER_SELECTED_TEST_IDS names, in batches across processes"
          )
        )
        (= action (=> () (call run-suite)))
      )
      (blank)
      (<> Subcommand (text: "batch")
        (= about
          (paragraph
            "run the tests BRIX_TEST_PAYLOAD names in this process, as run does in each process it starts"
          )
        )
        (= action (=> () (call run-batch)))
      )
    )
  )
)

(type _ SuitePlace (is Tuple)
  (prop + suite String)
  (prop + project-path String)
  (prop + tests-path String)
)

(fn-do _ suite-place SuitePlace (?! Error)
  (let suite (call env-required "BRIX_TEST_SUITE"))
  (let project-path (as (. (call Path (?? (call env "OMETER_TESTOMETER_PROJECT_ROOT") (call cwd))) normalized) String))
  (let given (call env-required "BRIX_TEST_ROOT"))
  (let relative (if-expr (call (. given starts-with) "./") ([] given (... 2)) given))
  (let tests-path
    (scope (as (. (if-expr (call (. given starts-with) "/") (call Path given) under-project) normalized) String)
      (lazy under-project (/ (call Path project-path) relative))
    )
  )
  (call check-suite suite project-path tests-path)
  (return (call SuitePlace suite project-path tests-path))
)

(fn-do _ emit-suite-catalog Int (?! Error)
  (let place (call suite-place))
  (let start (as (?? (call env "OMETER_TESTOMETER_CATALOG_START_INDEX") "0") Int))
  (call emit-catalog (. place suite) (. place project-path) (. place tests-path) start)
  (return 0)
)

(fn-do _ run-suite Int (?! Error)
  (let place (call suite-place))
  (let ids
    (call selected-test-ids
      (block
        (arg (?? (call env "OMETER_TESTOMETER_SELECTED_TEST_IDS") (call env "OMETER_TESTOMETER_SELECTED_IDS") "[]"))
      )
    )
  )
  (throw (call Error "No Testometer-selected tests were provided") (if (not ids)))
  (blank)
  (call emit-json (call run-start-json ids))
  (for (in id ids)
    (call emit-json (call test-start-json id))
  )
  (let variables (call suite-variables place))
  (let scratch (? String))
  (if (not (call reads-in-process (. place suite)))
    (= ([] variables "BRIX_TEST_COMPILER") (call suite-compiler (. place project-path) variables))
    (let parent (/ (call Path (. place project-path)) (str ".tmp/selfhost/" (. place suite))))
    (call (. parent make-directories))
    (= scratch (as (call temporary-directory "run" (as parent String)) String))
  )
  (let batches (call SuiteBatches place (as (call executable-path) String) variables scratch ids))
  (finally
    (inline (call remove-scratch scratch))
  )
  (call (. batches run))
  (call emit-json (call (. batches end-json)))
  (return 0)
)

(fn-do _ suite-variables (map String String)
  (param place SuitePlace)
  (let variables (call environment))
  (-= ([] variables "OMETER_TESTOMETER_SELECTED_TEST_IDS"))
  (-= ([] variables "OMETER_TESTOMETER_SELECTED_IDS"))
  (let build (?? (call env "BRIX_BUILD_PATH") ".tmp/build"))
  (= ([] variables "BRIXPATH") (as (/ toolchain-root "stdlib") String))
  (= ([] variables "BRIX_BUILD_PATH")
    (scope (. (if-expr is-absolute (call Path build) under-project) normalized)
      (lazy is-absolute (call (. build starts-with) "/"))
      (lazy under-project (/ (call Path (. place project-path)) build))
    )
  )
  (= ([] variables "BRIX_DEBUG_LOG") "")
  (= ([] variables "PROBES_ENABLED") "")
  (= ([] variables "PROBES_PATH") "")
  (= ([] variables "PROBES_CONTROL_PATH") "")
  (= ([] variables "BRIX_TEST_SUITE") (. place suite))
  (= ([] variables "BRIX_TEST_PROJECT_ROOT") (. place project-path))
  (= ([] variables "BRIX_TEST_ROOT") (. place tests-path))
  (return variables)
)

(fn-do _ suite-compiler String (?! Error)
  (param project-path String)
  (param variables (map String String))
  (let given (call env "BRIX_TEST_COMPILER"))
  (return-if (. (call Path given) normalized) (if given))
  (blank)
  (let builder
    (call Process
      (block
        (arg (as (/ toolchain-root "bin/brix") String))
        (arg (. ProcessStderr inherit))
        (arg (list "--build-only"))
        (arg project-path)
        (arg variables)
      )
    )
  )
  (let built (call (. (call (. (call (of ChunkedTokenStream Byte) builder) read)) slice-string)))
  (let status (?? (call (. builder wait) null) -1))
  (call (. builder close))
  (throw (call Error "Building the compiler failed") (if (!= status 0)))
  (return (call (. built trim)))
)

(fn-do _ remove-scratch _
  (param scratch (? String))
  (return-if (if (not scratch)))
  (blank)
  (let remover (call Process "/bin/rm" (list "-rf" scratch)))
  (call (. remover wait) null)
  (call (. remover close))
)

(type _ SuiteBatches
  (prop + counts (map String Int))
  (blank)
  (prop _ place SuitePlace)
  (prop _ executable String)
  (prop _ variables (map String String))
  (prop _ scratch (? String))
  (prop _ ids (list String))
  (prop _ batches (list (list String)))
  (prop _ selected (map String Bool))
  (prop _ completed (map String Bool))
  (prop _ workers Size)
  (prop _ next Index (= 0))
  (prop _ failure (? Error))
  (prop _ output _ (:= (call Mutex)))
  (fn-do + This _
    (param place _)
    (param executable _)
    (param variables _)
    (param scratch _)
    (param ids _)
    (for (in id ids)
      (= ([] selected id) true)
    )
    (for (in status suite-statuses)
      (= ([] counts status) 0)
    )
    (= workers (call worker-count))
    (let size (call batch-size (. ids length) workers))
    (let start Index 0)
    (while (< start (. ids length))
      (let end (if-expr (< (+ start size) (. ids length)) (+ start size) (. ids length)))
      (let batch (list String))
      (for (in index (..< start end))
        (+= batch ([] ids index))
      )
      (+= batches batch)
      (= start end)
    )
  )
  (fn-do + run _ (?! Error)
    (let running (if-expr (< workers (. batches length)) workers (. batches length)))
    (let finished (call (of SyncBufferedChannel Bool)))
    (for (in _ (..< 0 running))
      (do-new
        (call work
          (block
            (on-error (: caught Error)
              (= failure (?? failure caught))
            )
          )
        )
        (<- finished true)
      )
    )
    (for (in _ (..< 0 running))
      (<- finished)
    )
    (throw failure (if failure))
  )
  (fn-expr + end-json (map String JSON)
    (call run-end-json
      (block
        (arg (. ids length))
        (arg (!! ([] counts "passed")))
        (arg (!! ([] counts "failed")))
        (arg (!! ([] counts "skipped")))
        (arg (!! ([] counts "crashed")))
        (arg (!! ([] counts "killed")))
      )
    )
  )
  (fn-expr _ batch-size Index
    (param count Size)
    (param workers Size)
    (case? (== (. place suite) core-suite)
      (if-expr (> spread suite-core-batch-floor) spread suite-core-batch-floor)
    )
    (default
      (if-expr (< narrow 1) 1 (if-expr (> narrow suite-batch-ceiling) suite-batch-ceiling narrow))
    )
    (where
      (lazy spread (/ (- (+ count (* workers 2)) 1) (* workers 2)))
      (lazy narrow (/ (- (+ count (* workers 4)) 1) (* workers 4)))
    )
  )
  (fn-do _ work _ (?! Error)
    (while (< next (. batches length))
      (let index next)
      (+= next 1)
      (call run-group ([] batches index) index)
    )
  )
  (fn-do _ run-group _ (?! Error)
    (param batch (list String))
    (param index Index)
    (let attempts 0)
    (while true
      (let pending (list String) (case-each (in id batch (when (not ([] completed id))))))
      (return-if (if (not pending)))
      (blank)
      (+= attempts 1)
      (let started (map String Bool))
      (let ended (call attempt pending (str "batch-" index "-" attempts) started))
      (let unfinished (list String) (case-each (in id pending (when (not ([] completed id))))))
      (return-if (if (not unfinished)))
      (blank)
      (let begun (list String) (case-each (in id unfinished (when ([] started id)))))
      (let stranded (if-expr begun ([] begun 0) ([] unfinished 0)))
      (= ([] completed stranded) true)
      (= ([] counts "crashed") (+ (!! ([] counts "crashed")) 1))
      (call write-line (call to-json (call crashed-json stranded ended)))
    )
  )
  (fn-do _ attempt String (?! Error)
    (param pending (list String))
    (param name String)
    (param started (map String Bool))
    (let attempt-variables (call (of Map String String) (in each variables)))
    (= ([] attempt-variables "BRIX_TEST_PAYLOAD") (call to-json (call json-strings pending)))
    (if scratch
      (let directory (call Path (str scratch "/" name)))
      (call (. directory make-directories))
      (= ([] attempt-variables "BRIX_TEST_SCRATCH") (as directory String))
    )
    (let child
      (call Process
        (block
          (arg executable)
          (arg (. ProcessStderr inherit))
          (arg (list "batch"))
          (arg (. place project-path))
          (arg attempt-variables)
        )
      )
    )
    (call (. child close-input))
    (for (in line (~> child \event-line))
      (call accept line started)
    )
    (let usage (call (. child wait-usage)))
    (call (. child close))
    (case? (and usage (!= (. usage signal) 0))
      (return (str "The test runner terminated with signal " (. usage signal)))
    )
    (case? (and usage (!= (. usage exit-code) 0))
      (return (str "The test runner terminated with exit code " (. usage exit-code)))
    )
    (default
      (return "The test runner ended without reporting a result")
    )
  )
  (fn-do _ accept _
    (param line String)
    (param started (map String Bool))
    (return-if (if (not (call (. line trim)))))
    (blank)
    (let decoded (catch (call JSON line)))
    (if (is-not decoded (map String JSON))
      (<- stderr (str "Ignoring invalid runner output: " line "\n"))
      (return)
    )
    (let fields (as decoded (map String JSON)))
    (let kind (call event-field fields "type"))
    (let id (call event-field fields "id"))
    (if (and (== kind "testStart") id)
      (= ([] started id) true)
    )
    (return-if (if (!= kind "testResult")))
    (blank)
    (let status (call event-field fields "status"))
    (return-if (if (or (not ([] selected id)) ([] completed id) (not (has suite-statuses status)))))
    (blank)
    (= ([] completed id) true)
    (= ([] counts status) (+ (!! ([] counts status)) 1))
    (call write-line line)
  )
  (fn-do _ write-line _
    (param line String)
    (use output)
    (call (. stdout write) (str line "\n"))
  )
)

(fn-expr _ event-line String (over: Char)
  (~ (seq (: text (* (seq (! "\n") .))) "\n")
    text
  )
  (~ (seq (: text (+ (seq (! "\n") .))) (! .))
    text
  )
)

(fn-expr _ event-field String
  (param fields (map String JSON))
  (param key String)
  (if-expr (is value String) (as value String) "")
  (where
    (lazy value ([] fields key))
  )
)

(fn-expr _ crashed-json (map String JSON)
  (param id String)
  (param errors String)
  (call (of Map String JSON)
    (block
      (entry "protocol" (as suite-protocol JSON))
      (entry "version" (as 1 JSON))
      (entry "type" (as "testResult" JSON))
      (entry "id" (as id JSON))
      (entry "status" (as "crashed" JSON))
      (entry "duration" (as 0 JSON))
      (entry "errors" (as errors JSON))
    )
  )
)

(fn-expr _ worker-count Size
  (if-expr (> requested 0) (as requested Size) (if-expr (> online suite-reserved-cores) (as (- online suite-reserved-cores) Size) 1))
  (where
    (lazy requested (as (?? (call env "BRIX_TEST_JOBS") "0") Int))
    (lazy online (as (call C:sysconf C:_SC_NPROCESSORS_ONLN) Int))
  )
)
