(import ./test-catalog)
(import ./test-config)
(import ./test-model)
(import ./test-runner)
(blank)
(prop + test-shown-lines Size (= 60))
(prop _ test-shown-notes Size (= 20))
(prop _ test-summary-statuses (list TestStatus)
  (=
    (call List
      (block
        (item (. TestStatus passed))
        (item (. TestStatus failed))
        (item (. TestStatus crashed))
        (item (. TestStatus timed-out))
        (item (. TestStatus not-run))
        (item (. TestStatus stopped))
        (item (. TestStatus skipped))
      )
    )
  )
)

(fn-do + test-suite-lines (list String)
  (param config TestConfig)
  (param catalog TestCatalog)
  (let lines (list String))
  (for (in suite (. catalog suites))
    (let node ([] (. catalog nodes) suite))
    (let names (list String))
    (for (in (tuple name _) (. ([] (. config suites) (. node suite)) modes))
      (+= names name)
    )
    (let modes (if-expr (> (. names length) 0) (str "  modes: " (call (. ", " join) names)) ""))
    (+= lines (str (. node id) "  " (call test-count-text (. (call (. catalog leaves) suite) length)) modes))
  )
  (return lines)
)

(fn-do + test-selection-lines (list String)
  (param catalog TestCatalog)
  (param selection TestSelection)
  (param shows-tests Bool)
  (let owners (list Index))
  (let members (map Index (list Index)))
  (for (in leaf (. selection leaves))
    (let owner (!! (. ([] (. catalog nodes) leaf) parent)))
    (if (not ([] members owner))
      (+= owners owner)
      (= ([] members owner) (call (of List Index)))
    )
    (+= (!! ([] members owner)) leaf)
  )
  (let lines (list String))
  (for (in owner owners)
    (let node ([] (. catalog nodes) owner))
    (let suite (. ([] (. catalog nodes) (call (. catalog suite-of) owner)) id))
    (let tests (!! ([] members owner)))
    (+= lines (str suite "  " (call test-node-name node) "  " (call test-count-text (. tests length))))
    (if shows-tests
      (for (in leaf tests)
        (let test ([] (. catalog nodes) leaf))
        (+= lines (str "    " (. test id) "  " (. test label)))
      )
    )
  )
  (+= lines (str (call test-count-text (. selection leaves length)) " selected"))
  (return lines)
)

(fn-do + test-mode-warnings (list String) (?! Error)
  (param config TestConfig)
  (param catalog TestCatalog)
  (param leaves (list Index))
  (param mode String)
  (let known (list String))
  (for (in suite (. config suites))
    (for (in (tuple name _) (. suite modes))
      (if (not (has known name))
        (+= known name)
      )
    )
  )
  (let available
    (scope (if-expr (> (. known length) 0) mode-list "; no suite defines a mode")
      (lazy mode-list (str "; the modes are " (call (. ", " join) known)))
    )
  )
  (throw (call Error (str "No suite has a mode named " mode available)) (if (not (has known mode))))
  (blank)
  (let warnings (list String))
  (let warned ([] Bool (. config suites length)))
  (for (in leaf leaves)
    (let suite (. ([] (. catalog nodes) leaf) suite))
    (if (and (not ([] warned suite)) (== ([] (. ([] (. config suites) suite) modes) mode) null))
      (= ([] warned suite) true)
      (+= warnings (str (. ([] (. config suites) suite) id) " has no " mode " mode and runs in its default mode"))
    )
  )
  (return warnings)
)

(fn-do + test-failure-lines (list String)
  (param outcome TestOutcome)
  (param limit (? Size) (= test-shown-lines))
  (let result (. outcome result))
  (let lines (list String))
  (+= lines
    (scope (str status-name "  " (. outcome suite) "  " (. outcome id) "  " (. outcome label))
      (lazy status-name (. (call test-status-name (. result status)) uppercased))
    )
  )
  (++= lines (call test-section-lines "expected" (. result expected) limit))
  (++= lines (call test-section-lines "actual" (. result actual) limit))
  (++= lines (call test-section-lines "errors" (. result errors) limit))
  (return lines)
)

(fn-do + test-status-line String
  (param model TestModel)
  (param current TestRun)
  (let catalog (!! (. model catalog)))
  (let total (. current leaves length))
  (let waiting 0)
  (let passed 0)
  (let problems 0)
  (for (in leaf (. current leaves))
    (let status (call (. model status-of) leaf))
    (if (or (== status (. TestStatus queued)) (== status (. TestStatus running)))
      (+= waiting 1)
      (else-if (== status (. TestStatus passed))
        (+= passed 1)
      )
      (else-if (or (call test-is-problem status) (== status (. TestStatus not-run)))
        (+= problems 1)
      )
    )
  )
  (let line (str (- total waiting) "/" total "  " passed " passed"))
  (if (> problems 0)
    (= line (str line "  " problems " failed"))
  )
  (= line (str line "  " (call test-elapsed-text (. current elapsed))))
  (if (. current is-settled)
    (return (str line "  stopping…"))
  )
  (if (!= (. current phase) "")
    (= line (str line "  " (. current phase)))
  )
  (if (== (. current running) 1)
    (for (in leaf (. current leaves))
      (if (== (call (. model status-of) leaf) (. TestStatus running))
        (let elapsed (call (. model elapsed) leaf))
        (let timer (if-expr elapsed (str "  " (call test-elapsed-text elapsed)) ""))
        (return (str line "  " (. ([] (. catalog nodes) leaf) id) timer))
      )
    )
  )
  (return line)
)

(fn-do + test-unrun-lines (list String)
  (param current TestRun)
  (let reasons (list String))
  (let counts (call (of Map String Size)))
  (for (in outcome (. current outcomes))
    (if (== (. outcome result status) (. TestStatus not-run))
      (let reason (. outcome result errors))
      (if (not ([] counts reason))
        (+= reasons reason)
      )
      (= ([] counts reason) (+ (?? ([] counts reason) 0) 1))
    )
  )
  (let lines (list String))
  (for (in reason reasons)
    (+= lines (str "NOT RUN  " (call test-count-text (!! ([] counts reason)))))
    (++= lines (call test-section-lines "reason" reason test-shown-lines))
    (+= lines "")
  )
  (return lines)
)

(fn-do + test-note-lines (list String)
  (param current TestRun)
  (let lines (list String))
  (for (in note (if-expr (> (. current notes length) test-shown-notes) ([] (. current notes) (..< 0 test-shown-notes)) (. current notes)))
    (+= lines (str "note: " note))
  )
  (if (> (. current notes length) test-shown-notes)
    (+= lines (str "note: " (- (. current notes length) test-shown-notes) " more notes"))
  )
  (return lines)
)

(fn-do + test-summary-lines (list String)
  (param current TestRun)
  (let positions (call (of Map String Index)))
  (let suites (list String))
  (let counts (list Size))
  (for (in outcome (. current outcomes))
    (let known ([] positions (. outcome suite)))
    (let position (?? known (. suites length)))
    (if (== known null)
      (= ([] positions (. outcome suite)) position)
      (+= suites (. outcome suite))
      (for (in _ (..< 0 test-status-count))
        (+= counts 0)
      )
    )
    (+= ([] counts (+ (* position test-status-count) (call test-status-slot (. outcome result status)))) 1)
  )
  (let lines (list String))
  (let overall ([] Size test-status-count))
  (for (in position (..< 0 (. suites length)))
    (let parts (list String))
    (for (in status test-summary-statuses)
      (let count ([] counts (+ (* position test-status-count) (call test-status-slot status))))
      (if (> count 0)
        (+= parts (str count " " (call test-status-name status)))
        (+= ([] overall (call test-status-slot status)) count)
      )
    )
    (if (> (. parts length) 0)
      (let elapsed ([] (. current suite-times) ([] suites position)))
      (let timer (if-expr elapsed (str "  " (call test-elapsed-text elapsed)) ""))
      (+= lines (str ([] suites position) "  " (call (. "  " join) parts) timer))
    )
  )
  (let totals (list String))
  (for (in status test-summary-statuses)
    (let count ([] overall (call test-status-slot status)))
    (if (> count 0)
      (+= totals (str count " " (call test-status-name status)))
    )
  )
  (let outcome (if-expr (. current is-stopped) "stopped  " ""))
  (+= lines
    (scope (str outcome (call test-count-text (. current leaves length)) "  " (call (. "  " join) totals) "  " elapsed-text)
      (lazy elapsed-text (call test-elapsed-text (. current elapsed)))
    )
  )
  (return lines)
)

(fn-expr + test-stuck-line (? String)
  (param current TestRun)
  (only-if (str "warning: " (. current stuck length) " processes would not exit: " stuck-list) (if (> (. current stuck length) 0)))
  (where
    (lazy stuck-list (call (. " " join) (call (of List String) (in (str each) (. current stuck)))))
  )
)

(fn-expr + test-is-problem Bool
  (param status TestStatus)
  (or (== status (. TestStatus failed)) (== status (. TestStatus crashed)) (== status (. TestStatus timed-out)))
)

(fn-expr + test-count-text String
  (param count Size)
  (if-expr (== count 1) "1 test" (str count " tests"))
)

(fn-do _ test-section-lines (list String)
  (param title String)
  (param text String)
  (param limit (? Size))
  (let trimmed (call test-trailing-trimmed text))
  (let lines (list String))
  (return-if lines (if (== trimmed "")))
  (blank)
  (+= lines (str "  " title))
  (let most (?? limit (. trimmed length)))
  (let count Size 0)
  (let rest trimmed)
  (while (and (!= rest "") (< count most))
    (let newline (call (. rest find) "\n"))
    (+= lines (str "    " (if-expr newline ([] rest (..< 0 newline)) rest)))
    (= rest (if-expr newline ([] rest (... (+ newline 1))) ""))
    (+= count 1)
  )
  (if (!= rest "")
    (+= lines (str "    … " (call test-count-of-lines rest) " more lines"))
  )
  (return lines)
)

(fn-expr _ test-node-name String
  (param node TestNode)
  (if-expr (!= (. node relative-path) "") (. node relative-path) (. node selector))
)

(fn-do _ test-trailing-trimmed String
  (param text String)
  (let end (. text length))
  (while (and (> end 0) (or (== ([] text (- end 1)) (char "\n")) (== ([] text (- end 1)) (char " ")) (== ([] text (- end 1)) (char "\t")) (== ([] text (- end 1)) (char "\r"))))
    (-= end 1)
  )
  (return ([] text (..< 0 end)))
)

(fn-do _ test-count-of-lines Size
  (param text String)
  (let count 1)
  (for (in char text)
    (if (== char (char "\n"))
      (+= count 1)
    )
  )
  (return count)
)
