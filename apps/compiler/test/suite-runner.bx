(import ./test-protocol)
(import /data/json)
(import /lang/ast/ast-builder)
(import /lang/ast/ast-nodes)
(import /lang/ast/ast-xml)
(import /lang/ast/brix)
(import /lang/ast/error)
(import /lang/ast/grammar)
(import /lang/brix/convert)
(import /lang/constants)
(import /lang/target)
(import /math)
(import /os/env)
(import /os/file)
(import /os/path)
(import /os/process)
(import /stream/aggregate)
(import /stream/combine)
(import /stream/filter)
(import /stream/sort)
(import /time/clock)
(import /time/duration)
(blank)
(prop + parse-suite _ (= "parse"))
(prop + core-suite _ (= "core"))
(prop + diagnostics-suite _ (= "diagnostics"))
(prop + scratch-suite _ (= "scratch"))
(prop + docs-suite _ (= "docs"))
(prop + ubrix-suite _ (= "ubrix"))
(prop _ suite-names (list String) (= (list parse-suite core-suite diagnostics-suite scratch-suite docs-suite ubrix-suite)))
(prop _ batch-name-rounds Index (= 8))
(prop _ spec-extension _ (= ".test.md"))
(prop _ fence-flags (list String) (= (list "crash" "compile-error" "warn" "probes")))
(prop _ stage-none _ (= 0))
(prop _ stage-program _ (= 1))
(prop _ stage-file _ (= 3))
(prop _ stage-errors _ (= 4))
(prop _ stage-output _ (= 5))

(type + TestCase
  (prop + suite String)
  (prop + source-path String)
  (prop + relative-path String)
  (prop + file-label String)
  (prop + case-index Int)
  (prop + source String)
  (prop + is-brix Bool)
  (prop + output (? String))
  (prop + errors (? String))
  (prop + line-no-start Int)
  (prop + line-no-end Int)
  (prop + options (map String String))
  (prop + files (map String String))
  (prop + title (? String))
  (fn-do + This _
    (param suite _)
    (param source-path _)
    (param relative-path _)
    (param file-label _)
    (param case-index _)
    (param parsed ParsedCase)
    (lazy source (. parsed source))
    (lazy is-brix (. parsed is-brix))
    (lazy output (. parsed output))
    (lazy errors (. parsed errors))
    (lazy line-no-start (. parsed line-no-start))
    (lazy line-no-end (. parsed line-no-end))
    (lazy options (. parsed options))
    (lazy files (. parsed files))
    (lazy title (. parsed title))
  )
  (fn-expr + id String :get
    (str "test:" suite ":" relative-path ":" case-index)
  )
  (fn-expr + file-id String :get
    (str "file:" suite ":" relative-path)
  )
  (fn-expr + catalog-relative-path String :get
    (str suite ":" relative-path)
  )
  (fn-expr + label String :get
    (?? title (if-expr (> (. source length) 50) ([] source (..< 0 50)) source))
  )
  (fn-expr + source-name String :get
    (if-expr is-brix (str "__source__" brix-extension) "__source__.yumi")
  )
  (fn-expr + source-extension String :get
    (if-expr is-brix brix-extension ".yumi")
  )
  (fn-expr + has-option _
    (param name String)
    (!= ([] options name) null)
  )
)

(type + ParsedCase
  (prop + source String)
  (prop + is-brix Bool)
  (prop + line-no-start Int)
  (prop + line-no-end Int)
  (prop + options (map String String))
  (prop + files (map String String))
  (prop + output (? String) (= null))
  (prop + errors (? String) (= null))
  (prop + title (? String) (= null))
  (fn-do + This _
    (param source _)
    (param is-brix _)
    (param line-no-start _)
    (param options _)
    (param title _)
    (lazy line-no-end line-no-start)
  )
)

(type _ DocumentFence (is (tuple (: line Int) (: info String) (: content String) (: end Int))))

(type _ DocumentBlock (is Union)
  (variant fence DocumentFence)
  (variant heading (? String))
  (variant unclosed Int)
  (variant prose)
)

(type _ ParsedDocument
  (prop + blocks (list DocumentBlock))
  (fn-do + This _
    (param blocks (list DocumentBlock))
  )
  (fn-expr + This _ (over: Char)
    (~ (seq (: blocks (* \document-block)) /)
      (call This blocks)
    )
    (where
      (lazy document-block DocumentBlock
        (pattern
          (~ (: fence \fence)
            (call .fence fence)
          )
          (~ (: line \unclosed-opening)
            (call .unclosed line)
          )
          (~ (: title \heading)
            (call .heading title)
          )
          (~ (seq (* \line-char) \nl)
            .prose
          )
          (~ (+ \line-char)
            .prose
          )
        )
      )
      (blank)
      (lazy fence DocumentFence
        (pattern
          (~ (seq (: start \long-opening) (: info \fence-info) (: content \long-fenced) (: end \long-closing))
            (call DocumentFence start (call (. info trim)) (call opened content) end)
          )
          (~ (seq (: start \opening) (: info \fence-info) (: content \fenced) (: end \closing))
            (call DocumentFence start (call (. info trim)) (call opened content) end)
          )
        )
      )
      (blank)
      (lazy unclosed-opening Int
        (pattern
          (~ (seq (: start \long-opening) (* .))
            start
          )
          (~ (seq (: start \opening) (* .))
            start
          )
        )
      )
      (blank)
      (lazy long-opening Int
        (pattern
          (~ "````"
            (+ (as (. location begin line) Int) 1)
          )
        )
      )
      (blank)
      (lazy opening Int
        (pattern
          (~ (seq "```" (! "`"))
            (+ (as (. location begin line) Int) 1)
          )
        )
      )
      (blank)
      (lazy fence-info String
        (pattern
          (~ (: chars (* \line-char))
            (call (. (call (of Array Char) chars) slice-string))
          )
        )
      )
      (blank)
      (lazy fenced String
        (pattern
          (~ (: chars (* \fenced-char))
            (call (. (call (of Array Char) chars) slice-string))
          )
        )
      )
      (blank)
      (lazy fenced-char Char
        (pattern
          (~ (seq (! \closing) .))
        )
      )
      (blank)
      (lazy long-fenced String
        (pattern
          (~ (: chars (* \long-fenced-char))
            (call (. (call (of Array Char) chars) slice-string))
          )
        )
      )
      (blank)
      (lazy long-fenced-char Char
        (pattern
          (~ (seq (! \long-closing) .))
        )
      )
      (blank)
      (lazy closing Int
        (pattern
          (~ (seq \nl "```" (* "`") (* \horizontal-space) (| \nl (! .)))
            (+ (as (. location begin line) Int) 2)
          )
        )
      )
      (blank)
      (lazy long-closing Int
        (pattern
          (~ (seq \nl "````" (* "`") (* \horizontal-space) (| \nl (! .)))
            (+ (as (. location begin line) Int) 2)
          )
        )
      )
      (blank)
      (lazy heading (? String)
        (pattern
          (~ (seq "#" (+ "#") " " (: chars (* \line-char)) (| \nl (! .)))
            (call (. (call (. (call (of Array Char) chars) slice-string)) trim))
          )
          (~ (seq "# " (* \line-char) (| \nl (! .)))
            null
          )
        )
      )
      (blank)
      (lazy horizontal-space
        (pattern
          (~ (| " " "\t" "\r" "\x0b" "\x0c"))
        )
      )
      (blank)
      (lazy line-char
        (pattern
          (~ (seq (! \nl) .))
        )
      )
    )
  )
)

(fn-expr _ opened String
  (param content String)
  (if-expr (call (. content starts-with) "\n") ([] content (... 1)) content)
)

(type _ DocumentCases
  (prop + cases (list ParsedCase))
  (blank)
  (prop _ path String)
  (prop _ title (? String))
  (prop _ heading Index (= -1))
  (prop _ headings (list Index))
  (prop _ current (? ParsedCase))
  (prop _ stage _ (= stage-none))
  (fn-do + This _
    (param path _)
  )
  (fn-do + read _ (?! Error)
    (param blocks (list DocumentBlock))
    (for (in block blocks)
      (match? block
        (case (call .fence fence)
          (call add fence)
        )
        (case (call .heading text)
          (= title text)
          (+= heading 1)
          (= current null)
          (= stage stage-none)
        )
        (case (call .unclosed line)
          (throw (call Error (str path ":" line ": The fence is never closed")))
        )
      )
    )
    (call number-shared-titles)
  )
  (fn-do _ add _ (?! Error)
    (param fence DocumentFence)
    (let words (call (of List String) (in each (call (. fence info split) " ") (when (!= (. each length) 0)))))
    (let kind (if-expr words ([] words 0) ""))
    (let file (call file-name words))
    (if file
      (call take-file fence words file)
      (else-if (or (== kind "yumi") (== kind "brix"))
        (call take-program fence words (== kind "brix"))
      )
      (else-if (or (== kind "stderr") (== kind "output"))
        (call take-expected fence words kind)
      )
    )
  )
  (fn-do _ take-program _ (?! Error)
    (param fence DocumentFence)
    (param words (list String))
    (param is-brix Bool)
    (let made (call ParsedCase (call (. fence content trim)) is-brix (. fence line) (call flag-options words (. fence line)) title))
    (= (. made line-no-end) (. fence end))
    (+= cases made)
    (+= headings heading)
    (= current made)
    (= stage stage-program)
  )
  (fn-do _ take-file _ (?! Error)
    (param fence DocumentFence)
    (param words (list String))
    (param name String)
    (let found current)
    (throw (call Error (str path ":" (. fence line) ": A file fence must follow its case's program, before its expected output")) (if (or (not found) (> stage stage-file))))
    (throw (call Error (str path ":" (. fence line) ": A file fence takes only its language and its file=")) (if (or (!= (. words length) 2) (not name))))
    (= ([] (. found files) name) (. fence content))
    (= (. found line-no-end) (. fence end))
    (= stage stage-file)
  )
  (fn-do _ take-expected _ (?! Error)
    (param fence DocumentFence)
    (param words (list String))
    (param kind String)
    (let found current)
    (let latest (if-expr (== kind "stderr") stage-file stage-errors))
    (throw (call Error (str path ":" (. fence line) ": The " kind " fence is out of order; a case is its program, files, stderr and output")) (if (or (not found) (> stage latest))))
    (throw (call Error (str path ":" (. fence line) ": The " kind " fence takes no other words")) (if (!= (. words length) 1)))
    (if (== kind "stderr")
      (= (. found errors) (call (. fence content trim)))
      (= stage stage-errors)
      (else
        (= (. found output) (call (. fence content trim)))
        (= stage stage-output)
      )
    )
    (= (. found line-no-end) (. fence end))
  )
  (fn-do _ flag-options (map String String) (?! Error)
    (param words (list String))
    (param line Int)
    (let options (map String String))
    (for (in word ([] words (... 1)))
      (if (call (. word starts-with) "probes=")
        (= ([] options "probes") ([] word (... (. "probes=" length))))
        (else-if (has fence-flags word)
          (= ([] options word) "true")
        )
        (else
          (throw (call Error (str path ":" line ": Unknown word \"" word "\" on a program fence")))
        )
      )
    )
    (return options)
  )
  (fn-do _ number-shared-titles _
    (let counts (map Index Int))
    (for (in index headings)
      (= ([] counts index) (+ (?? ([] counts index) 0) 1))
    )
    (let numbers (map Index Int))
    (for (in position (..< 0 (. cases length)))
      (let index ([] headings position))
      (let named (. ([] cases position) title))
      (if (and named (> (?? ([] counts index) 0) 1))
        (let number (+ (?? ([] numbers index) 0) 1))
        (= ([] numbers index) number)
        (= (. ([] cases position) title) (str named " (" number ")"))
      )
    )
  )
)

(fn-do _ file-name (? String)
  (param words (list String))
  (for (in word words)
    (return-if ([] word (... (. "file=" length))) (if (call (. word starts-with) "file=")))
  )
  (return null)
)

(type + TestFile
  (prop _ suite String)
  (prop _ source-path String)
  (prop _ relative-path String)
  (prop _ file-label String)
  (fn-do + This _
    (param suite String)
    (param source-path String)
    (param project-path String)
    (= (. this suite) suite)
    (= (. this source-path) source-path)
    (= relative-path (call relative-test-path source-path project-path))
    (= file-label (call test-file-label source-path))
  )
  (fn-do + parse (list TestCase)
    (let source-file (use (call File source-path)))
    (let text (as source-file String))
    (let cases (++ (call document-cases text) (call inline-form-cases text)))
    (return
      (case-each (in (tuple index parsed) (call indexed cases))
        (call TestCase suite source-path relative-path file-label (+ index 1) parsed)
      )
    )
  )
  (fn-do _ document-cases (list ParsedCase) (?! Error)
    (param text String)
    (let reader (call DocumentCases relative-path))
    (call (. reader read) (call document-blocks text))
    (return (. reader cases))
  )
  (fn-expr _ document-blocks (list DocumentBlock) (?! Error)
    (param text String)
    (match text
      (~ ParsedDocument
        (. it blocks)
      )
      (throw (call Error (str "Malformed document " relative-path)))
    )
  )
)

(fn-do _ inline-form-cases (list ParsedCase)
  (param text String)
  (let forms (call inline-forms text))
  (return-if (call (of List ParsedCase)) (if (== (. forms length) 0)))
  (let checked (call (. " " join) (in (str "(tuple " ([] each 0) " " (call brix-quoted ([] each 1)) ")") forms)))
  (let source (str "(import /lang/brix/inline)\n\n(main\n  (for (in (tuple line form) (list " checked "))\n    (if (not (call brix-inline-view form))\n      (print (str line \": \" form))\n    )\n  )\n)"))
  (return (list (call ParsedCase source true 1 (call (of Map String String)) "Inline forms")))
)

(fn-do _ inline-forms (list (tuple Int String))
  (param text String)
  (let forms (list (tuple Int String)))
  (let prose (call (. "\n" join) (call unfenced-lines text)))
  (let pieces (call (of List String) (call (. prose split) "`{.brix}")))
  (let line-no 1)
  (let index 0)
  (for (in piece pieces)
    (+= index 1)
    (if (< index (. pieces length))
      (let parts (call (of List String) (call (. piece split) "`")))
      (let form ([] parts (- (. parts length) 1)))
      (let start (- (+ line-no (call line-count piece)) (call line-count form)))
      (+= forms (tuple start (call (. "|" join) (call (. (call (. " " join) (in (call (. each trim)) (call (. form split) "\n"))) split) "\\|"))))
    )
    (+= line-no (call line-count piece))
  )
  (return forms)
)

(fn-do _ unfenced-lines (list String)
  (param text String)
  (let lines (list String))
  (let ticks Size 0)
  (for (in line (call (. text split) "\n"))
    (let run (call backtick-run line))
    (if (and (== ticks 0) (>= run 3))
      (= ticks run)
      (+= lines "")
      (else-if (and (!= ticks 0) (>= run ticks) (== (. (call (. line trim)) length) run))
        (= ticks 0)
        (+= lines "")
      )
      (else
        (+= lines (if-expr (!= ticks 0) "" line))
      )
    )
  )
  (return lines)
)

(fn-do _ backtick-run Size
  (param line String)
  (let count Size 0)
  (for (in char line)
    (if (!= char '`')
      (break)
    )
    (+= count 1)
  )
  (return count)
)

(fn-do _ line-count Int
  (param text String)
  (let count 0)
  (for (in c text)
    (+=? count (only-if 1 (if (== c (char "\n")))))
  )
  (return count)
)

(fn-do _ brix-quoted String
  (param text String)
  (let quoted "\"")
  (for (in c text)
    (++=? quoted (only-if "\\" (if (or (== c (char "\\")) (== c (char "\"")) (== c '$')))))
    (++= quoted c)
  )
  (return (++ quoted "\""))
)

(fn-expr _ relative-test-path String
  (param source-path String)
  (param project-path String)
  (before
    (throw (call Error (str "Test file is outside the project: " source-path)) (if (not (call (. source-path starts-with) (str project-path "/")))))
  )
  ([] source-path (... (+ (. project-path length) 1)))
)

(fn-do _ test-file-label String
  (param source-path String)
  (let words (list String))
  (let word "")
  (let previous (? Char))
  (let name (. (call Path source-path) name))
  (let is-spec (call (. name ends-with) spec-extension))
  (let base (if-expr is-spec ([] name (..< 0 (- (. name length) (. spec-extension length)))) (. (call Path name) base-name)))
  (for (in char base)
    (let is-separator (or (== char '-') (== char '_')))
    (let starts-after-lowercase (and previous (>= previous 'a') (<= previous 'z')))
    (let starts-camel-word (and starts-after-lowercase (>= char 'A') (<= char 'Z')))
    (if (or is-separator starts-camel-word)
      (if word
        (+= words word)
      )
      (= word "")
    )
    (if (not is-separator)
      (+= word char)
    )
    (= previous char)
  )
  (if word
    (+= words word)
  )
  (blank)
  (let first (if-expr is-spec 1 0))
  (return
    (call (. " " join)
      (block
        (spread (..< first (. words length)))
        (pipe *> (. ([] words each) lowercased))
      )
    )
  )
)

(type + CaseResult
  (prop + status _ (= "crashed"))
  (prop + actual _ (= ""))
  (prop + expected _ (= ""))
  (prop + errors _ (= ""))
  (prop + duration _ (= 0ms))
  (prop + compiled _ (= false))
  (prop + exit _ (= 0))
  (fn-do + compare _
    (param actual String)
    (param expected String)
    (= (. this actual) actual)
    (= (. this expected) expected)
    (= status (if-expr (== (call (. actual trim)) (call (. expected trim))) "passed" "failed"))
  )
)

(type + RunContext
  (prop + suite String)
  (prop + compiler String)
  (prop + scratch String)
  (prop + project String)
  (prop + library String)
  (prop + case-count _ (= 0))
  (fn-do + This _
    (param suite String)
    (param compiler String)
    (param scratch String)
    (param project String)
    (param library String)
  )
)

(fn-do + run-batch Int (?! Error)
  (let suite (call env-required "BRIX_TEST_SUITE"))
  (let project-path (call env-required "BRIX_TEST_PROJECT_ROOT"))
  (let tests-path (call env-required "BRIX_TEST_ROOT"))
  (let payload (call env-required "BRIX_TEST_PAYLOAD"))
  (call check-suite suite project-path tests-path)
  (let compiler (?? (call env "BRIX_TEST_COMPILER") ""))
  (let scratch (?? (call env "BRIX_TEST_SCRATCH") ""))
  (if (and (not (call reads-in-process suite)) (or (not compiler) (not scratch)))
    (throw (call Error (str "The " suite " suite needs BRIX_TEST_COMPILER and BRIX_TEST_SCRATCH")))
  )
  (let stdlib (as (/ toolchain-root "stdlib") String))
  (let context (call RunContext suite compiler scratch project-path stdlib))
  (call emit-run context project-path tests-path (call selected-test-ids payload))
  (return 0)
)

(fn-expr + reads-in-process Bool
  (param suite String)
  (or (== suite parse-suite) (== suite ubrix-suite))
)

(fn-do + check-suite _ (?! Error)
  (param suite String)
  (param project-path String)
  (param tests-path String)
  (if (not is-known)
    (throw (call Error (str "Unknown test suite: " suite)))
  )
  (lazy is-known (call some suite-names (:where (== each suite))))
  (if (and (!= tests-path project-path) (not (call (. tests-path starts-with) (str project-path "/"))))
    (throw (call Error (str "The test root is outside the project: " tests-path)))
  )
  (return-if (if (and (== suite scratch-suite) (not (. (call Path tests-path) exists)))))
  (if (not (. (call Path tests-path) is-dir))
    (throw (call Error (str "The test root is not a directory: " tests-path)))
  )
)

(fn-expr + selected-test-paths _ (?! Error)
  (param suite String)
  (param root String)
  (param selected-ids (list String))
  (call distinct (in (call selected-test-path suite root each) selected-ids))
)

(fn-expr + selected-test-path String (?! Error)
  (param suite String)
  (param root String)
  (param id String)
  (match id
    (~ (seq "test:" $suite ":" $root "/" (: name (+ (seq (! \case-index) .))) \case-index)
      (str root "/" name)
    )
    (throw (call Error (str "The selected test is outside the " suite " catalog: " id)))
    (blank)
    (lazy case-index
      (pattern
        (~ (seq ":" (+ (chars "0-9")) (! .)))
      )
    )
  )
)

(fn-do + emit-catalog _
  (param suite String)
  (param project-path String)
  (param tests-path String)
  (param start-index Int)
  (let test-paths (list String) (call sort (call find-test-paths (call Path tests-path) (call test-file-extension suite))))
  (let parsed-files (list (list TestCase))
    (case-each (in test-path test-paths)
      (call (. (call TestFile suite test-path project-path) parse))
    )
  )
  (let file-case-lists (list (list TestCase)) (case-each (in file-cases parsed-files (when (!= (. file-cases length) 0)))))
  (let all-cases (list TestCase) (case-each (in test-case (call all-test-cases file-case-lists))))
  (let catalog-tests (list JSON)
    (case-each (in (tuple index test-case) (call indexed all-cases))
      (as (call test-catalog-json test-case (+ start-index index 1)) JSON)
    )
  )
  (let file-nodes (list JSON)
    (case-each (in file-cases file-case-lists)
      (let test-nodes (list JSON)
        (case-each (in test-case file-cases)
          (as (call test-node-json test-case) JSON)
        )
      )
      (as (call file-node-json file-cases test-nodes) JSON)
    )
  )
  (blank)
  (let root
    (call (of Map String JSON)
      (block
        (entry "protocol" (as "ometer.testometer.catalog.v1" JSON))
        (entry "protocolVersion" (as 1 JSON))
        (entry "version" (as 2 JSON))
        (entry "projectPath" (as project-path JSON))
        (entry "suites" (as (list (as (call suite-node-json suite file-nodes (. catalog-tests length)) JSON)) JSON))
        (entry "tests" (as catalog-tests JSON))
        (entry "scopes" (as (call (of List JSON)) JSON))
        (entry "isExclusive" (as false JSON))
      )
    )
  )
  (call emit-json root)
)

(fn-do + emit-run _
  (param context RunContext)
  (param project-path String)
  (param tests-path String)
  (param selected-ids (list String))
  (if (not selected-ids)
    (throw (call Error "No Testometer-selected tests were provided"))
  )
  (blank)
  (let selected-cases (call file-cases (. context suite) project-path tests-path selected-ids))
  (blank)
  (call emit-json (call run-start-json selected-ids))
  (blank)
  (let results (list CaseResult) (call run-cases selected-cases context))
  (let passed-results (list CaseResult) (case-each (in result results (when (== (. result status) "passed")))))
  (let failed-results (list CaseResult) (case-each (in result results (when (== (. result status) "failed")))))
  (let crashed-results (list CaseResult) (case-each (in result results (when (== (. result status) "crashed")))))
  (let passed (. passed-results length))
  (let failed (. failed-results length))
  (let crashed (. crashed-results length))
  (let skipped-results (list CaseResult) (case-each (in result results (when (== (. result status) "skipped")))))
  (let skipped (. skipped-results length))
  (let killed (- (. results length) passed failed skipped crashed))
  (blank)
  (call emit-json (call run-end-json (. selected-ids length) passed failed skipped crashed killed))
)

(fn-do + file-cases (list TestCase) (?! Error)
  (param suite String)
  (param project-path String)
  (param tests-path String)
  (param selected-ids (list String))
  ; The cases of test files the ids select, in the order of the ids.
  (let root (call relative-test-path tests-path project-path))
  (let test-paths (call selected-test-paths suite root selected-ids))
  (let file-case-lists (list (list TestCase))
    (case-each (in test-path test-paths)
      (call (. (call TestFile suite (str project-path "/" test-path) project-path) parse))
    )
  )
  (let all-cases (list TestCase) (case-each (in test-case (call all-test-cases file-case-lists))))
  (return
    (case-each (in id selected-ids)
      (call selected-test-case id all-cases)
    )
  )
)

(fn-do + all-test-cases (stream TestCase)
  (param file-case-lists (list (list TestCase)))
  (for (in file-cases file-case-lists)
    (yield-all file-cases)
  )
)

(fn-do + selected-test-case TestCase
  (param id String)
  (param all-cases (list TestCase))
  (for (in test-case all-cases)
    (if (== (. test-case id) id)
      (return test-case)
    )
  )
  (throw (call Error (str "The selected test is outside the catalog: " id)))
)

(fn-do + run-cases (list CaseResult)
  (param cases (list TestCase))
  (param context RunContext)
  ; Runs the cases of a suite and reports each. A case of the core suite runs in a batch, as the
  ; batches of `brixtest` run theirs, unless it must run alone; one that expects the compiler to
  ; fail is compiled alone first, and goes to the batch only where the compiler reports nothing.
  (if (and (!= (. context suite) core-suite) (!= (. context suite) docs-suite))
    (return
      (case-each (in test-case cases)
        (call run-and-emit-result test-case context)
      )
    )
  )
  (let results (list CaseResult))
  (let batched (list Index))
  (for (in test-case cases)
    (let result (call CaseResult))
    (+= results result)
    (call emit-json (call test-start-json (. test-case id)))
    (if (call runs-alone test-case)
      (call run-into test-case result context)
      (call emit-json (call test-result-json test-case result))
      (else-if (or (not (call expects-compile-failure test-case)) (call compiles-alone test-case result context))
        (+= batched (- (. results length) 1))
      )
      (else
        (call emit-json (call test-result-json test-case result))
      )
    )
  )
  (call run-batch cases batched results context)
  (for (in position batched)
    (call emit-json (call test-result-json ([] cases position) ([] results position)))
  )
  (return results)
)

(fn-expr _ runs-alone Bool
  (param test-case TestCase)
  ; Whether a case runs by itself: one that expects what the compiler warns, which the compiler
  ; warns of for a whole batch at once, or one that compiles probes in.
  (call some (list "warn" "probes") (:where (call (. test-case has-option) each)))
)

(fn-expr _ expects-compile-failure Bool
  (param test-case TestCase)
  (and (== (. test-case errors) null) fails)
  (where
    (lazy fails (call some (list "crash" "compile-error") (:where (call (. test-case has-option) each))))
  )
)

(fn-do _ run-into _
  (param test-case TestCase)
  (param result CaseResult)
  (param context RunContext)
  ; Runs a case by itself into its result.
  (let ran (call run-case test-case context))
  (= (. result status) (. ran status))
  (= (. result actual) (. ran actual))
  (= (. result expected) (. ran expected))
  (= (. result errors) (. ran errors))
  (= (. result duration) (. ran duration))
  (= (. result compiled) (. ran compiled))
  (= (. result exit) (. ran exit))
)

(fn-do _ compiles-alone Bool
  (param test-case TestCase)
  (param result CaseResult)
  (param context RunContext)
  ; Type checks a case that expects the compiler to fail without building it, and gives whether
  ; the compiler reported nothing, so the case runs in a batch. Where it reported what it found,
  ; that is the case's result, as it is where the case runs alone; where it failed for any other
  ; reason, the case runs alone.
  (let started (call clock))
  (+= (. context case-count) 1)
  (let directory (str (. context scratch) "/case-" (. context case-count)))
  (call (. (call Path directory) make-directory))
  (for (in (tuple name content) (. test-case files))
    (call write-case-file directory name content)
  )
  (let errors-path (str directory "/stderr"))
  (let command
    (paragraph
      (str "cd " (call shell-quoted directory) " && " (call shell-quoted (. context compiler)) " --reached-only " (call source-switch directory test-case) " 2>" (call shell-quoted errors-path))
    )
  )
  (let process (call Process "/bin/sh" "-c" command))
  (let output (call unsourced (as process String) directory test-case))
  (let status (?? (call (. process wait) null) 1))
  (call (. process close))
  (if (== status 0)
    (return true)
  )
  (if (!= status diagnostic-status)
    (call run-into test-case result context)
    (return false)
  )
  (let errors (call unsourced (call read-text errors-path) directory test-case))
  (let run (call CompilerRun output errors status (str directory "/case") "" errors))
  (call finish-case test-case run result context directory)
  (= (. result duration) (- (call clock) started))
  (return false)
)

(fn-do + run-and-emit-result CaseResult
  (param test-case TestCase)
  (param context RunContext)
  (call emit-json (call test-start-json (. test-case id)))
  (let result (call run-case test-case context))
  (call emit-json (call test-result-json test-case result))
  (return result)
)

(fn-do + run-case CaseResult
  (param test-case TestCase)
  (param context RunContext)
  (let result (call CaseResult))
  (let started (call clock))
  (call execute-case test-case result context)
  (= (. result duration) (- (call clock) started))
  (return result)
)

(fn-do + execute-case _
  (param test-case TestCase)
  (param result CaseResult)
  (param context RunContext)
  ; Runs the case in a task of its own, with the main task's stack, and waits for it. A panic that
  ; ends that task marks the case crashed.
  (let running
    (do-new @large-stack
      (let execution (catch (call execute-case-body test-case result context)))
      (if (is execution Error)
        (= (. result status) "crashed")
        (= (. result errors) (str execution))
      )
      (on-failure failure
        (= (. result status) "crashed")
        (= (. result errors) (str failure))
      )
    )
  )
  (call (. running wait))
)

(fn-do + execute-case-body _
  (param test-case TestCase)
  (param result CaseResult)
  (param context RunContext)
  (if (== (. context suite) parse-suite)
    (call parse-case-body test-case result)
    (else-if (== (. context suite) ubrix-suite)
      (call ubrix-case-body test-case result)
    )
    (else
      (call core-case-body test-case result context)
    )
  )
)

(fn-do + parse-case-body _
  (param test-case TestCase)
  (param result CaseResult)
  (let expected (?? (. test-case output) ""))
  (call parse-compare (str "\n" (. test-case source)) (. test-case is-brix) expected result)
)

(fn-do + ubrix-case-body _
  (param test-case TestCase)
  (param result CaseResult)
  (let source (. test-case source))
  (let read (catch (call parse-brix (str "\n" source))))
  (if (is read Error)
    (= (. result status) "skipped")
    (return)
  )
  (let tree (as read ASTBuilder))
  (use tree)
  (let back (catch (call ubrix-round-trip source)))
  (if (is back Error)
    (= (. result status) "failed")
    (= (. result expected) source)
    (= (. result errors) (str "Its UBrix view does not read back: " back))
    (else
      (call (. result compare) (as back String) source)
    )
  )
)

(fn-do _ ubrix-round-trip String (?! Error)
  (param source String)
  (return (call brix-convert (call brix-yumi-text (str source "\n"))))
)

(fn-do _ parse-compare _
  (param source String)
  (param is-brix Bool)
  (param expected String)
  (param result CaseResult)
  (let parsed (catch (call parsed-source source is-brix)))
  (if (is parsed ASTBuilder)
    (let tree (as parsed ASTBuilder))
    (use tree)
    (let actual
      (call (. "\n" join)
        (block
          (spread (..< 0 (call root-statement-count tree)))
          (pipe *> (as (call (. tree view) (call root-statement tree each)) String))
        )
      )
    )
    (call (. result compare) actual expected)
    (else-if (is parsed YumiSyntaxError)
      (call (. result compare) (. (as parsed YumiSyntaxError) exception-text) expected)
    )
    (else
      (= (. result status) "crashed")
      (= (. result errors) (str parsed))
    )
  )
)

(fn-expr _ parsed-source ASTBuilder (?! YumiSyntaxError)
  (param source String)
  (param is-brix Bool)
  (if-expr is-brix (call parse-brix source) (call parse-yumi source))
)

(fn-expr _ root-statement-count Size
  (param tree ASTBuilder)
  (match ([] (. tree nodes) (. tree root))
    (case (call .node-top-level-syntax top)
      (as (. top statements count) Size)
    )
    (throw (call Panic "ASTBuilder root has the wrong syntax case"))
  )
)

(fn-expr _ root-statement SyntaxId
  (param tree ASTBuilder)
  (param index Index)
  (match ([] (. tree nodes) (. tree root))
    (case (call .node-top-level-syntax top)
      (throw (call Panic "ASTBuilder statement index is out of bounds") (if (>= index (. top statements count))))
      ([] (. tree children) (+ (. top statements start) index))
    )
    (throw (call Panic "ASTBuilder root has the wrong syntax case"))
  )
)

(fn-do + core-case-body _
  (param test-case TestCase)
  (param result CaseResult)
  (param context RunContext)
  (+= (. context case-count) 1)
  (let directory (str (. context scratch) "/case-" (. context case-count)))
  (call (. (call Path directory) make-directory))
  (for (in (tuple name content) (. test-case files))
    (call write-case-file directory name content)
  )
  (blank)
  (let probes (?? ([] (. test-case options) "probes") ""))
  (let run
    (call run-compiler
      (block
        (arg context)
        (arg directory)
        (arg test-case)
        (arg (call source-switch directory test-case))
        (arg (call (. test-case has-option) "warn"))
        (arg probes)
      )
    )
  )
  (call finish-case test-case run result context directory)
)

(fn-do _ finish-case _
  (param test-case TestCase)
  (param run CompilerRun)
  (param result CaseResult)
  (param context RunContext)
  (param directory String)
  ; Gives a case its result from what compiling and running it printed, and how it ended.
  (let crash (call crash-reason run test-case))
  (= (. result compiled) (. (call Path (. run executable)) is-file))
  (= (. result exit) (. run status))
  (if crash
    (= (. result status) "crashed")
    (= (. result errors) crash)
    (= (. result actual) (. run output))
    (else
      (call compare-case test-case run result (. context library) directory)
    )
  )
)

(fn-do _ compare-case _
  (param test-case TestCase)
  (param run CompilerRun)
  (param result CaseResult)
  (param library String)
  (param directory String)
  (let actual (list String))
  (let expected (list String))
  (let matches true)
  (let errors (. test-case errors))
  (if (!= errors null)
    (let reported (call case-errors test-case run library directory))
    (+= actual reported)
    (+= expected errors)
    (= matches (== (call (. reported trim)) (call (. errors trim))))
  )
  (if (or (!= (. test-case output) null) (== errors null))
    (let printed (call without-case-directory (. run output) directory))
    (let wanted (?? (. test-case output) ""))
    (+= actual printed)
    (+= expected wanted)
    (= matches (and matches (== (call (. printed trim)) (call (. wanted trim)))))
  )
  (= (. result actual) (call (. "\n" join) actual))
  (= (. result expected) (call (. "\n" join) expected))
  (= (. result status) (if-expr matches "passed" "failed"))
)

(fn-do _ run-batch _ (?! Error) (?! IOError)
  (param cases (list TestCase))
  (param batched (list Index))
  (param results (list CaseResult))
  (param context RunContext)
  (param rounds Index (= 0))
  ; Builds the cases of a batch into one program and runs it. Each case is written to a directory
  ; of its own as the module the compiler names by its place in the batch, and the program runs
  ; from where each case of a run starts: one that ends the program ends its case, and the program
  ; runs again from the next. The sources are removed once built, as a case run alone has no file
  ; for a place its program reports to show. Where the batch cannot be built, it is split.
  (if (not batched)
    (return)
  )
  (let started (call clock))
  (+= (. context case-count) 1)
  (let directory (str (. context scratch) "/batch-" (. context case-count)))
  (call (. (call Path directory) make-directory))
  (let control (str directory "/control"))
  (let output (str directory "/stdout"))
  (let errors (str directory "/stderr"))
  (let lines (list String) (list (str control "\t" output "\t" errors)))
  (let directories (list String))
  (for (in position batched)
    (let case-directory (str directory "/t" (call (. (as (. directories length) Int) pad) 6)))
    (call (. (call Path case-directory) make-directory))
    (for (in (tuple name content) (. ([] cases position) files))
      (call write-case-file case-directory name content)
    )
    (let source-name (. ([] cases position) source-name))
    (call write-case-file case-directory source-name (str "\n" (. ([] cases position) source)))
    (+= lines (str (. ([] cases position) id) "\t" case-directory "\t" case-directory "/" source-name))
    (+= directories case-directory)
  )
  (call write-case-file directory "manifest" (call (. "\n" join) lines))
  (call write-case-file directory "stdout" "")
  (call write-case-file directory "stderr" "")
  (let executable (str directory "/batch"))
  (let command
    (paragraph
      (str "cd " (call shell-quoted directory) " && " (call shell-quoted (. context compiler)) " --batch manifest -o " (call shell-quoted executable) " >" (call shell-quoted (str directory "/build")) " 2>&1")
    )
  )
  (let process (call Process "/bin/sh" "-c" command))
  (let status (?? (call (. process wait) null) 1))
  (call (. process close))
  (if (or (!= status 0) (not (. (call Path executable) is-file)))
    (call split-batch cases batched results context (call read-text (str directory "/build")) rounds)
    (return)
  )
  (for (in position (..< 0 (. directories length)))
    (call (. (call Path (str ([] directories position) "/" (. ([] cases ([] batched position)) source-name))) delete))
  )
  (let next 0)
  (while (< next (. batched length))
    (= next (call run-batch-from next cases batched results context directory directories))
  )
  (let each (/ (- (call clock) started) (as (. batched length) F64)))
  (for (in position batched)
    (= (. ([] results position) duration) each)
  )
)

(fn-do _ split-batch _ (?! Error) (?! IOError)
  (param cases (list TestCase))
  (param batched (list Index))
  (param results (list CaseResult))
  (param context RunContext)
  (param report String)
  (param rounds Index)
  ; Runs the cases of a batch that could not be built: each whose source the compiler's report
  ; names runs alone and the others in a batch again, for a few such rounds. Where it names none, or
  ; the rounds are spent, each half runs as a batch of its own, and a case by itself runs alone.
  (let named (call named-cases report (. batched length)))
  (let alone (list Index))
  (let rest (list Index))
  (for (in position (..< 0 (. batched length)))
    (if (and ([] named position) (< rounds batch-name-rounds))
      (+= alone ([] batched position))
      (else
        (+= rest ([] batched position))
      )
    )
  )
  (if alone
    (for (in position alone)
      (call run-into ([] cases position) ([] results position) context)
    )
    (call run-batch cases rest results context (+ rounds 1))
    (return)
  )
  (if (== (. batched length) 1)
    (call run-into ([] cases ([] batched 0)) ([] results ([] batched 0)) context)
    (return)
  )
  (let half (/ (. batched length) 2))
  (let first (list Index))
  (let second (list Index))
  (for (in position (..< 0 (. batched length)))
    (if (< position half)
      (+= first ([] batched position))
      (else
        (+= second ([] batched position))
      )
    )
  )
  (call run-batch cases first results context rounds)
  (call run-batch cases second results context rounds)
)

(fn-do _ named-cases (list Bool)
  (param report String)
  (param count Index)
  ; Which of the cases of a batch a report names a place in the source of, by the directory the
  ; batch gives each: a path in it to a Brix source, followed by a line.
  (let named (list Bool))
  (for (in position (..< 0 count))
    (+= named false)
  )
  (let pieces (list String) (call (. report split) "t"))
  (for (in position (..< 1 (. pieces length)))
    (let piece ([] pieces position))
    (let prior ([] pieces (- position 1)))
    (if (or (!= (call digit-count piece) 6) (< (. piece length) 7) (!= ([] piece 6) '/'))
      (continue)
    )
    (if (and (!= (. prior length) 0) (not (call (. prior ends-with) "/")) (not (call (. prior ends-with) " ")) (not (call (. prior ends-with) "\n")))
      (continue)
    )
    (let place (list String) (call (. piece split) ":"))
    (let number (call leading-number piece))
    (let is-source
      (scope (and (> (. place length) 1) has-extension)
        (lazy has-extension (or (call (. ([] place 0) ends-with) ".yumi") (call (. ([] place 0) ends-with) brix-extension)))
      )
    )
    (if (and is-source (>= (call leading-number ([] place 1)) 0) (< number (as count Int)))
      (= ([] named number) true)
    )
  )
  (return named)
)

(fn-do _ run-batch-from Index
  (param first Index)
  (param cases (list TestCase))
  (param batched (list Index))
  (param results (list CaseResult))
  (param context RunContext)
  (param directory String)
  (param directories (list String))
  ; Runs a batch from one of its cases on, gives each case that finished its result and the case
  ; that ended the program its own, and gives where the batch runs from next.
  (let control (str directory "/control"))
  (call write-case-file directory "control" "")
  (let command
    (paragraph
      (str "cd " (call shell-quoted directory) " && BRIXTEST_BATCH_START_INDEX=" first " BRIXTEST_BATCH_END_INDEX=" (. batched length) " BRIXTEST_BATCH_CONTINUE_AFTER_PANIC=1 exec ./batch >>" (call shell-quoted (str directory "/process")) " 2>&1")
    )
  )
  (let process (call Process "/bin/sh" "-c" command))
  (let status (?? (call (. process wait) null) 1))
  (call (. process close))
  (let marks (map String BatchMark))
  (for (in line (call (. (call read-text control) split) "\n"))
    (let fields (list String) (call (. line split) "\t"))
    (if (!= (. fields length) 4)
      (continue)
    )
    (let mark (?? ([] marks ([] fields 1)) (call BatchMark)))
    (if (== ([] fields 0) "started")
      (= (. mark started) true)
      (= (. mark output-start) (as (as ([] fields 2) Int) Size))
      (= (. mark errors-start) (as (as ([] fields 3) Int) Size))
      (else-if (== ([] fields 0) "finished")
        (= (. mark finished) true)
        (= (. mark output-end) (as (as ([] fields 2) Int) Size))
        (= (. mark errors-end) (as (as ([] fields 3) Int) Size))
      )
    )
    (= ([] marks ([] fields 1)) mark)
  )
  (let output (call read-bytes (str directory "/stdout")))
  (let errors (call read-bytes (str directory "/stderr")))
  (for (in position (..< first (. batched length)))
    (let test-case ([] cases ([] batched position)))
    (let mark (?? ([] marks (. test-case id)) (call BatchMark)))
    (if (not (. mark started))
      (if (== position first)
        (call run-into test-case ([] results ([] batched position)) context)
        (return (+ position 1))
      )
      (return position)
    )
    (let ended (. mark finished))
    (let printed
      (call (. output slice-string)
        (block
          (arg (..< (. mark output-start) (if-expr ended (. mark output-end) (. output size))))
        )
      )
    )
    (let reported
      (call (. errors slice-string)
        (block
          (arg (..< (. mark errors-start) (if-expr ended (. mark errors-end) (. errors size))))
        )
      )
    )
    (let case-directory ([] directories position))
    (let held (call task-numbers (call in-case reported case-directory test-case)))
    (let run
      (call CompilerRun
        (block
          (arg (call in-case printed case-directory test-case))
          (arg held)
          (arg (if-expr ended 0 status))
          (arg (str directory "/batch"))
          (arg "")
          (arg held)
        )
      )
    )
    (call finish-case test-case run ([] results ([] batched position)) context case-directory)
    (if (not ended)
      (return (+ position 1))
    )
  )
  (return (. batched length))
)

(type + BatchMark
  ; Where a case of a batch starts and finishes printing in the files the batch prints to.
  (blank)
  (prop + started _ (= false))
  (prop + finished _ (= false))
  (prop + output-start Size (= 0))
  (prop + output-end Size (= 0))
  (prop + errors-start Size (= 0))
  (prop + errors-end Size (= 0))
)

(fn-do _ in-case String
  (param text String)
  (param directory String)
  (param test-case TestCase)
  ; What a case of a batch printed as the case would print it alone: its module and the modules
  ; beside it are named without the place the batch gives them, its source has no file, and what the
  ; program numbers across its cases is named as the batches of `brixtest` name it.
  (let pieces (list String) (call (. text split) "__test__/t"))
  (let kept (list String) (list ([] pieces 0)))
  (for (in position (..< 1 (. pieces length)))
    (let piece ([] pieces position))
    (if (and (> (. piece length) 7) (== ([] piece 6) '/'))
      (+= kept ([] piece (... 7)))
      (else
        (+= kept (str "__test__/t" piece))
      )
    )
  )
  (let placed (call unsourced (call (. "" join) kept) directory test-case))
  (let dispatched (call without-number placed "__source__:union-dispatch-" "__source__:union-dispatch-1"))
  (let transitioned
    (call without-number
      (block
        (arg dispatched)
        (arg "__source__:state-transition")
        (arg "__source__:state-transition")
      )
    )
  )
  (return (call without-number transitioned "__source__:Fork" "__source__:Fork"))
)

(fn-do _ without-number String
  (param text String)
  (param name String)
  (param kept String)
  ; Text where each name that is `name` followed by a number is `kept`.
  (let pieces (list String) (call (. text split) name))
  (let joined (list String) (list ([] pieces 0)))
  (for (in position (..< 1 (. pieces length)))
    (let piece ([] pieces position))
    (let digits (call digit-count piece))
    (if (== digits 0)
      (+= joined (str name piece))
      (else
        (let rest ([] piece (... digits)))
        (+= joined (str kept rest))
      )
    )
  )
  (return (call (. "" join) joined))
)

(fn-do _ digit-count Size
  (param text String)
  ; How many digits a text begins with.
  (let count Size 0)
  (for (in char text)
    (if (or (< char '0') (> char '9'))
      (break)
    )
    (+= count 1)
  )
  (return count)
)

(fn-do _ read-text String
  (param path String)
  (let file (use (call File path)))
  (return (as file String))
)

(fn-do _ read-bytes ([] Byte)
  (param path String)
  (let file (use (call File path)))
  (return file)
)

(fn-do _ task-numbers String
  (param text String)
  ; What a case of a batch reported, with the tasks the runtime names numbered from the first it
  ; names, as a case run alone numbers them.
  (let words (list String) (call (. text split) "ask "))
  (if (< (. words length) 2)
    (return text)
  )
  (let first (. Int max))
  (for (in position (..< 1 (. words length)))
    (let number (call leading-number ([] words position)))
    (if (and (>= number 0) (< number first) follows-task)
      (= first number)
    )
    (lazy follows-task (or (call (. ([] words (- position 1)) ends-with) "T") (call (. ([] words (- position 1)) ends-with) "t")))
  )
  (if (== first (. Int max))
    (return text)
  )
  (let kept (list String) (list ([] words 0)))
  (for (in position (..< 1 (. words length)))
    (let number (call leading-number ([] words position)))
    (let word ([] words position))
    (if (and (>= number 0) (or (call (. ([] words (- position 1)) ends-with) "T") (call (. ([] words (- position 1)) ends-with) "t")))
      (let digits (as (. (str number) length) Size))
      (let rest ([] word (... digits)))
      (= word (str (+ (- number first) 1) rest))
    )
    (+= kept word)
  )
  (return (call (. "ask " join) kept))
)

(fn-do _ leading-number Int
  (param text String)
  ; The number a text begins with, or -1.
  (let number -1)
  (for (in char text)
    (if (or (< char '0') (> char '9'))
      (break)
    )
    (= number (+ (if-expr (< number 0) 0 (* number 10)) (- (as char Int) (as '0' Int))))
  )
  (return number)
)

(type + CompilerRun (is Tuple)
  (prop + output String)
  (prop + errors String)
  (prop + status Int)
  (prop + executable String)
  (prop + warnings String)
  (prop + ran String)
)

(fn-do _ run-compiler CompilerRun
  (param context RunContext)
  (param directory String)
  (param test-case TestCase)
  (param source-switch String)
  (param warns Bool)
  (param probes String)
  ; Compiles a case and runs its program as the batches of `brixtest` run theirs: a program
  ; that reports an unhandled panic or error goes on (`BRIXTEST_BATCH_CONTINUE_AFTER_PANIC`).
  (let process (call Process "/bin/sh" "-c" command))
  (let output (as process String))
  (let status (?? (call (. process wait) null) 1))
  (call (. process close))
  (let warned (call unsourced (call read-text warnings-path) directory test-case))
  (let ran (call unsourced (call read-text errors-path) directory test-case))
  (return
    (call CompilerRun
      (block
        (arg (call unsourced output directory test-case))
        (arg (str warned ran))
        (arg status)
        (arg executable)
        (arg (call (. warned trim)))
        (arg ran)
      )
    )
  )
  (blank)
  (lazy executable (str directory "/case"))
  (lazy errors-path (str directory "/stderr"))
  (lazy warnings-path (str directory "/compile-stderr"))
  (lazy switches (if-expr warns "--compile --warnings" "--compile"))
  (lazy probing (if-expr (== probes "true") "--probes" (if-expr probes (str "--probes " (call shell-quoted probes)) "")))
  (lazy tracing (if-expr probes (str "PROBES_ENABLED=" (call shell-quoted probes) " PROBES_PATH=" (call shell-quoted trace-path)) ""))
  (lazy trace-path (str directory "/probes.trace"))
  (lazy command
    (paragraph
      (str "cd " (call shell-quoted directory) " && : >" (call shell-quoted errors-path) " && " (call shell-quoted (. context compiler)) " " source-switch " -o " (call shell-quoted executable) " " switches " " probing " 2>" (call shell-quoted warnings-path) " && " removing "BRIXTEST_BATCH_CONTINUE_AFTER_PANIC=1 " tracing " exec " (call shell-quoted executable) " 2>>" (call shell-quoted errors-path))
    )
  )
  (lazy removing (if-expr (. test-case is-brix) (str "rm -f " (. test-case source-name) " && ") ""))
)

(fn-expr _ crash-reason (? String)
  (param run CompilerRun)
  (param test-case TestCase)
  ; Why a run counts as crashed whatever the case expects. A compiler that reported diagnostics
  ; exits with their status and no executable; one that produced no executable for any other
  ; reason failed, which no expected crash of the program stands for.
  (case? (and (not produced) (!= (. run status) 0) (!= (. run status) diagnostic-status))
    (if-expr (. run errors) (. run errors) (str "The compiler exited with status " (. run status)))
  )
  (case? (and (!= (. run status) 0) (not expects-failure))
    (if-expr (. run errors) (. run errors) (str "The compiler exited with status " (. run status)))
  )
  (default
    null
  )
  (where
    (lazy produced (. (call Path (. run executable)) is-file))
    (lazy expects-failure (call some (:stream (list "crash" "compile-error")) (:where (call (. test-case has-option) each))))
  )
)

(fn-expr _ case-errors String
  (param test-case TestCase)
  (param run CompilerRun)
  (param library String)
  (param directory String)
  (case? (call (. test-case has-option) "warn")
    (call without-case-directory warned directory)
  )
  (default
    (call without-library-locations (. run errors) library (. test-case source-extension))
  )
  (where
    (lazy warned (call (. "\n" join) (in each (list (. run warnings) (. run ran)) (when (!= (. each length) 0)))))
  )
)

(fn-do _ source-switch String
  (param directory String)
  (param test-case TestCase)
  (return-if (str "-c " (call shell-quoted (str "\n" (. test-case source)))) (if (not (. test-case is-brix))))
  (call write-case-file directory (. test-case source-name) (str "\n" (. test-case source)))
  (return (. test-case source-name))
)

(fn-expr _ unsourced String
  (param text String)
  (param directory String)
  (param test-case TestCase)
  (call (. "no file" join) (call (. unplaced split) (. test-case source-name)))
  (where
    (lazy unplaced (call (. "no file" join) (call (. text split) (str directory "/" (. test-case source-name)))))
  )
)

(fn-expr _ without-case-directory String
  (param text String)
  (param directory String)
  ; Output whose places in the case's own files are named from the case's directory, as the batches
  ; of `brixtest` name them: the directory the case was written to is no part of what it expects.
  (call (. "" join) (call (. text split) (str directory "/")))
)

(fn-do _ without-library-locations String
  (param text String)
  (param library String)
  (param extension String)
  ; A stack trace whose places in the library are named by their files alone, so that a case holds
  ; neither where the project is kept nor a line of the library.
  (let root (str library "/"))
  (let lines (list String) (call (. text split) "\n"))
  (let kept (list String))
  (let index 0)
  (while (< index (. lines length))
    (let line ([] lines index))
    (let start (call library-place line library extension))
    (if start
      (let offset (as start Size))
      (let place ([] line (..< offset (. line length))))
      (let file (call library-file (if-expr (call (. place starts-with) root) ([] place (... (. root length))) place)))
      (if (and (call (. line starts-with) "<") (call (. line ends-with) ">"))
        (+= kept (str "<" file ">"))
        (if (and (< (+ index 2) (. lines length)) (call marks-column ([] lines (+ index 2))))
          (+= index 2)
        )
        (else
          (+= kept (str ([] line (..< 0 offset)) file))
        )
      )
      (else
        (+= kept line)
      )
    )
    (+= index 1)
  )
  (return (call (. "\n" join) kept))
)

(fn-do _ library-place (? Index)
  (param line String)
  (param library String)
  (param extension String)
  (return? (call (. line find) (str library "/")))
  (let found (call (. line find) (str extension ":")))
  (if (not found)
    (return null)
  )
  (let end (as found Size))
  (let start end)
  (while (and (> start 0) (!= ([] line (- start 1)) (char " ")) (!= ([] line (- start 1)) '<'))
    (-= start 1)
  )
  (return-if (as start Index) (if (. (call Path (str library "/" ([] line (..< start (+ end (. extension length)))))) is-file)))
  (return null)
)

(fn-expr _ library-file String
  (param place String)
  ; The file a place in the library names, without its line and column.
  (case? end
    ([] place (..< 0 (as end Size)))
  )
  (case? (call (. place ends-with) ">")
    ([] place (..< 0 (- (. place length) 1)))
  )
  (default
    place
  )
  (where
    (lazy end (call (. place find) ":"))
  )
)

(fn-expr _ marks-column Bool
  (param line String)
  ; Whether a line is the mark a panic draws under the line it echoes.
  (and (!= (. mark length) 0) (== mark (* "^" (. mark length))))
  (where
    (lazy mark (call (. line trim)))
  )
)

(fn-do _ write-case-file _
  (param directory String)
  (param name String)
  (param content String)
  (let target (call Path (str directory "/" name)))
  (call make-directories (as (. target dir) String) directory)
  (let flags (+ (. FileFlags write-mode) (. FileFlags create-mode) (. FileFlags truncate-mode)))
  (let file (call File (as target String) flags))
  (call (. file write) content)
  (call (. file close))
)

(fn-do _ make-directories _ (?! Error)
  (param path String)
  (param root String)
  (if (or (== path root) (. (call Path path) is-dir))
    (return)
  )
  (call make-directories (as (. (call Path path) dir) String) root)
  (call (. (call Path path) make-directory))
)

(fn-expr _ shell-quoted String
  (param text String)
  (str "'" (call (. "'\\''" join) (call (. text split) "'")) "'")
)

(fn-do + find-test-paths (list String)
  (param root Path)
  (param extension String)
  (let paths (list String))
  (return-if paths (if (not (. root exists))))
  (let directories (list Path) (list root))
  (while directories
    (let directory (call (. directories pop)))
    (for (in child (. directory contents))
      (if (. child is-dir)
        (+= directories child)
        (else-if (and (. child is-file) (call (. child name ends-with) extension))
          (+= paths (as child String))
        )
      )
    )
  )
  (return paths)
)

(fn-expr _ test-file-extension String
  (param suite String)
  (if-expr (== suite docs-suite) ".md" spec-extension)
)

(fn-expr + test-catalog-json (map String JSON)
  (param test-case TestCase)
  (param catalog-index Int)
  (call (of Map String JSON)
    (block
      (entry "id" (as (. test-case id) JSON))
      (entry "groupName" (as (. test-case suite) JSON))
      (entry "fileLabel" (as (. test-case file-label) JSON))
      (entry "sourcePath" (as (. test-case source-path) JSON))
      (entry "relativePath" (as (. test-case catalog-relative-path) JSON))
      (entry "label" (as (. test-case label) JSON))
      (entry "lineNoStart" (as (. test-case line-no-start) JSON))
      (entry "lineNoEnd" (as (. test-case line-no-end) JSON))
      (entry "selector" (as (. test-case id) JSON))
      (entry "fileId" (as (. test-case file-id) JSON))
      (entry "groupId" (as (str "group:" (. test-case suite)) JSON))
      (entry "suiteIds" (as (call json-strings (list suite-id (. test-case file-id))) JSON))
      (entry "selectors" (as selectors JSON))
      (entry "index" (as catalog-index JSON))
      (entry "caseIndex" (as (. test-case case-index) JSON))
      (entry "configName" (as (. test-case suite) JSON))
      (entry "suiteName" (as (. test-case suite) JSON))
      (entry "configuredSuiteSelector" (as suite-id JSON))
      (entry "isDefault" (as false JSON))
    )
  )
  (where
    (lazy suite-id (str "suite:" (. test-case suite)))
    (lazy selectors (call json-strings (list (. test-case id) (. test-case file-id) suite-id)))
  )
)

(fn-expr + suite-node-json (map String JSON)
  (param suite String)
  (param children (list JSON))
  (param count Int)
  (call (of Map String JSON)
    (block
      (entry "id" (as (str "suite:" suite) JSON))
      (entry "label" (as suite JSON))
      (entry "kind" (as "suite" JSON))
      (entry "selector" (as (str "suite:" suite) JSON))
      (entry "count" (as count JSON))
      (entry "children" (as children JSON))
    )
  )
)

(fn-do + file-node-json (map String JSON)
  (param file-cases (list TestCase))
  (param children (list JSON))
  (if (not file-cases)
    (throw (call Error "Cannot create a catalog node for an empty test file"))
  )
  (let first ([] file-cases 0))
  (return
    (call (of Map String JSON)
      (block
        (entry "id" (as (. first file-id) JSON))
        (entry "label" (as (. first file-label) JSON))
        (entry "kind" (as "suite" JSON))
        (entry "selector" (as (. first file-id) JSON))
        (entry "count" (as (. children length) JSON))
        (entry "path" (as (. first source-path) JSON))
        (entry "sourcePath" (as (. first source-path) JSON))
        (entry "relativePath" (as (. first catalog-relative-path) JSON))
        (entry "children" (as children JSON))
      )
    )
  )
)

(fn-expr + test-node-json (map String JSON)
  (param test-case TestCase)
  (call (of Map String JSON)
    (block
      (entry "id" (as (. test-case id) JSON))
      (entry "label" (as (. test-case label) JSON))
      (entry "kind" (as "test" JSON))
      (entry "selector" (as (. test-case id) JSON))
      (entry "count" (as 1 JSON))
      (entry "path" (as (. test-case source-path) JSON))
      (entry "sourcePath" (as (. test-case source-path) JSON))
      (entry "relativePath" (as (. test-case catalog-relative-path) JSON))
      (entry "lineNoStart" (as (. test-case line-no-start) JSON))
      (entry "lineNoEnd" (as (. test-case line-no-end) JSON))
    )
  )
)

(fn-expr + test-result-json (map String JSON)
  (param test-case TestCase)
  (param result CaseResult)
  (case? (== (. result status) "failed")
    (call (of Map String JSON)
      (block
        (entry "protocol" (as "ometer.testometer.v1" JSON))
        (entry "version" (as 1 JSON))
        (entry "type" (as "testResult" JSON))
        (entry "id" (as (. test-case id) JSON))
        (entry "groupName" (as (. test-case suite) JSON))
        (entry "fileLabel" (as (. test-case file-label) JSON))
        (entry "sourcePath" (as (. test-case source-path) JSON))
        (entry "relativePath" (as (. test-case catalog-relative-path) JSON))
        (entry "label" (as (. test-case label) JSON))
        (entry "lineNoStart" (as (. test-case line-no-start) JSON))
        (entry "lineNoEnd" (as (. test-case line-no-end) JSON))
        (entry "index" (as (. test-case case-index) JSON))
        (entry "status" (as (. result status) JSON))
        (entry "duration" (as (. result duration) JSON))
        (entry "expected" (as (. result expected) JSON))
        (entry "actual" (as (. result actual) JSON))
        (entry "compiled" (as (. result compiled) JSON))
        (entry "exit" (as (. result exit) JSON))
      )
    )
  )
  (case? (== (. result status) "crashed")
    (call (of Map String JSON)
      (block
        (entry "protocol" (as "ometer.testometer.v1" JSON))
        (entry "version" (as 1 JSON))
        (entry "type" (as "testResult" JSON))
        (entry "id" (as (. test-case id) JSON))
        (entry "groupName" (as (. test-case suite) JSON))
        (entry "fileLabel" (as (. test-case file-label) JSON))
        (entry "sourcePath" (as (. test-case source-path) JSON))
        (entry "relativePath" (as (. test-case catalog-relative-path) JSON))
        (entry "label" (as (. test-case label) JSON))
        (entry "lineNoStart" (as (. test-case line-no-start) JSON))
        (entry "lineNoEnd" (as (. test-case line-no-end) JSON))
        (entry "index" (as (. test-case case-index) JSON))
        (entry "status" (as (. result status) JSON))
        (entry "duration" (as (. result duration) JSON))
        (entry "errors" (as (. result errors) JSON))
        (entry "output" (as (. result actual) JSON))
        (entry "compiled" (as (. result compiled) JSON))
        (entry "exit" (as (. result exit) JSON))
      )
    )
  )
  (default
    (call (of Map String JSON)
      (block
        (entry "protocol" (as "ometer.testometer.v1" JSON))
        (entry "version" (as 1 JSON))
        (entry "type" (as "testResult" JSON))
        (entry "id" (as (. test-case id) JSON))
        (entry "groupName" (as (. test-case suite) JSON))
        (entry "fileLabel" (as (. test-case file-label) JSON))
        (entry "sourcePath" (as (. test-case source-path) JSON))
        (entry "relativePath" (as (. test-case catalog-relative-path) JSON))
        (entry "label" (as (. test-case label) JSON))
        (entry "lineNoStart" (as (. test-case line-no-start) JSON))
        (entry "lineNoEnd" (as (. test-case line-no-end) JSON))
        (entry "index" (as (. test-case case-index) JSON))
        (entry "status" (as (. result status) JSON))
        (entry "duration" (as (. result duration) JSON))
      )
    )
  )
)
