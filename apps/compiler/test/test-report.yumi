./test-catalog
./test-config
./test-model
./test-runner

+ test-shown-lines Size = 60
_ test-shown-notes Size = 20
_ test-summary-statuses [TestStatus] = [TestStatus.passed, TestStatus.failed, TestStatus.crashed, TestStatus.timed-out, TestStatus.not-run, TestStatus.stopped, TestStatus.skipped]

━━━━━━━━━━━━━━━━━━━━
+ do test-suite-lines [String]
    - config TestConfig
    - catalog TestCatalog

. lines [String]
for suite in catalog.suites
    . node = catalog.nodes[suite]
    . names [String]
    for name, _ in config.suites[node.suite].modes
        names += name
    . modes = if names.length > 0 then "  modes: ${", ".join(names)}" else ""
    lines += "${node.id}  ${test-count-text(catalog.leaves(suite).length)}$modes"
= lines

━━━━━━━━━━━━━━━━━━━━
+ do test-selection-lines [String]
    - catalog TestCatalog
    - selection TestSelection
    - shows-tests Bool

. owners [Index]
. members [Index = [Index]]
for leaf in selection.leaves
    . owner = catalog.nodes[leaf].parent!
    if !members[owner]
        owners += owner
        members[owner] = List'Index()
    members[owner]! += leaf
. lines [String]
for owner in owners
    . node = catalog.nodes[owner]
    . suite = catalog.nodes[catalog.suite-of(owner)].id
    . tests = members[owner]!
    lines += "$suite  ${test-node-name(node)}  ${test-count-text(tests.length)}"
    if shows-tests
        for leaf in tests
            . test = catalog.nodes[leaf]
            lines += "    ${test.id}  ${test.label}"
lines += "${test-count-text(selection.leaves.length)} selected"
= lines

━━━━━━━━━━━━━━━━━━━━
+ do test-mode-warnings [String] ?! Error
    - config TestConfig
    - catalog TestCatalog
    - leaves [Index]
    - mode String

. known [String]
for suite in config.suites
    for name, _ in suite.modes
        if !(known has name)
            known += name
. available = if known.length > 0 then mode-list else "; no suite defines a mode"
    .. mode-list = "; the modes are ${", ".join(known)}"
?! Error("No suite has a mode named $mode$available")
    if !(known has mode)
. warnings [String]
. warned = Bool[config.suites.length]
for leaf in leaves
    . suite = catalog.nodes[leaf].suite
    if !warned[suite] && config.suites[suite].modes[mode] == null
        warned[suite] = true
        warnings += "${config.suites[suite].id} has no $mode mode and runs in its default mode"
= warnings

━━━━━━━━━━━━━━━━━━━━
+ do test-failure-lines [String]
    - outcome TestOutcome
    - limit Size? = test-shown-lines

. result = outcome.result
. lines [String]
lines += "$status-name  ${outcome.suite}  ${outcome.id}  ${outcome.label}"
    .. status-name = test-status-name(result.status).uppercased
lines ++= test-section-lines("expected", result.expected, limit)
lines ++= test-section-lines("actual", result.actual, limit)
lines ++= test-section-lines("errors", result.errors, limit)
= lines

━━━━━━━━━━━━━━━━━━━━
+ do test-status-line String
    - model TestModel
    - current TestRun

. catalog = model.catalog!
. total = current.leaves.length
. waiting = 0
. passed = 0
. problems = 0
for leaf in current.leaves
    . status = model.status-of(leaf)
    if status == TestStatus.queued || status == TestStatus.running
        waiting += 1
    else if status == TestStatus.passed
        passed += 1
    else if test-is-problem(status) || status == TestStatus.not-run
        problems += 1
. line = "${total - waiting}/$total  $passed passed"
if problems > 0
    line = "$line  $problems failed"
line = "$line  ${test-elapsed-text(current.elapsed)}"
if current.is-settled
    = "$line  stopping…"
if current.phase != ""
    line = "$line  ${current.phase}"
if current.running == 1
    for leaf in current.leaves
        if model.status-of(leaf) == TestStatus.running
            . elapsed = model.elapsed(leaf)
            . timer = if elapsed then "  ${test-elapsed-text(elapsed)}" else ""
            = "$line  ${catalog.nodes[leaf].id}$timer"
= line

━━━━━━━━━━━━━━━━━━━━
+ do test-unrun-lines [String]
    - current TestRun

. reasons [String]
. counts = Map'String'Size()
for outcome in current.outcomes
    if outcome.result.status == TestStatus.not-run
        . reason = outcome.result.errors
        if !counts[reason]
            reasons += reason
        counts[reason] = (counts[reason] ?? 0) + 1
. lines [String]
for reason in reasons
    lines += "NOT RUN  ${test-count-text(counts[reason]!)}"
    lines ++= test-section-lines("reason", reason, test-shown-lines)
    lines += ""
= lines

━━━━━━━━━━━━━━━━━━━━
+ do test-note-lines [String]
    - current TestRun

. lines [String]
for note in if current.notes.length > test-shown-notes then current.notes[0 .. < test-shown-notes] else current.notes
    lines += "note: $note"
if current.notes.length > test-shown-notes
    lines += "note: ${current.notes.length - test-shown-notes} more notes"
= lines

━━━━━━━━━━━━━━━━━━━━
+ do test-summary-lines [String]
    - current TestRun

. positions = Map'String'Index()
. suites [String]
. counts [Size]
for outcome in current.outcomes
    . known = positions[outcome.suite]
    . position = known ?? suites.length
    if known == null
        positions[outcome.suite] = position
        suites += outcome.suite
        for _ in 0 .. < test-status-count
            counts += 0
    counts[position * test-status-count + test-status-slot(outcome.result.status)] += 1
. lines [String]
. overall = Size[test-status-count]
for position in 0 .. < suites.length
    . parts [String]
    for status in test-summary-statuses
        . count = counts[position * test-status-count + test-status-slot(status)]
        if count > 0
            parts += "$count ${test-status-name(status)}"
            overall[test-status-slot(status)] += count
    if parts.length > 0
        . elapsed = current.suite-times[suites[position]]
        . timer = if elapsed then "  ${test-elapsed-text(elapsed)}" else ""
        lines += "${suites[position]}  ${"  ".join(parts)}$timer"
. totals [String]
for status in test-summary-statuses
    . count = overall[test-status-slot(status)]
    if count > 0
        totals += "$count ${test-status-name(status)}"
. outcome = if current.is-stopped then "stopped  " else ""
lines += "$outcome${test-count-text(current.leaves.length)}  ${"  ".join(totals)}  $elapsed-text"
    .. elapsed-text = test-elapsed-text(current.elapsed)
= lines

━━━━━━━━━━━━━━━━━━━━
+ test-stuck-line String?
    - current TestRun

"warning: ${current.stuck.length} processes would not exit: $stuck-list" if current.stuck.length > 0

.. stuck-list = " ".join(List'String("$each" in current.stuck))

━━━━━━━━━━━━━━━━━━━━
+ test-is-problem Bool
    - status TestStatus

status == TestStatus.failed || status == TestStatus.crashed || status == TestStatus.timed-out

━━━━━━━━━━━━━━━━━━━━
+ test-count-text String
    - count Size

if count == 1 then "1 test" else "$count tests"

━━━━━━━━━━━━━━━━━━━━
_ do test-section-lines [String]
    - title String
    - text String
    - limit Size?

. trimmed = test-trailing-trimmed(text)
. lines [String]
=? lines if trimmed == ""
lines += "  $title"
. most = limit ?? trimmed.length
. count Size = 0
. rest = trimmed
while rest != "" && count < most
    . newline = rest.find("\n")
    lines += "    ${if newline then rest[0 .. < newline] else rest}"
    rest = if newline then rest[newline + 1 ...] else ""
    count += 1
if rest != ""
    lines += "    … ${test-count-of-lines(rest)} more lines"
= lines

━━━━━━━━━━━━━━━━━━━━
_ test-node-name String
    - node TestNode

if node.relative-path != "" then node.relative-path else node.selector

━━━━━━━━━━━━━━━━━━━━
_ do test-trailing-trimmed String
    - text String

. end = text.length
while end > 0 && (text[end - 1] == '\n' || text[end - 1] == ' ' || text[end - 1] == '\t' || text[end - 1] == '\r')
    end -= 1
= text[0 .. < end]

━━━━━━━━━━━━━━━━━━━━
_ do test-count-of-lines Size
    - text String

. count = 1
for char in text
    if char == '\n'
        count += 1
= count
