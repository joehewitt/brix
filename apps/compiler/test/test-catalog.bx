(import ./../command-template)
(import ./test-config)
(import /core/tokenstream)
(import /data/json)
(import /os/path)
(import /os/process)
(import /time/duration)
(blank)
(prop _ test-listing-timeout _ (= 60s))
(blank)
(type-line _ TestLineSelector (is (tuple (: path String) (: number Size))))
(type-line _ TestListing (is (tuple (: index Index) (: text String) (: problem (? String)))))

(type + TestCatalog
  (prop + root String)
  (prop + nodes (list TestNode))
  (prop + suites (list Index))
  (prop + problems (list String))
  (fn-do + This _
    (param root _)
  )
  (fn-do + add Index
    (param node TestNode)
    (let index (. nodes length))
    (+= nodes node)
    (if (. node parent)
      (+= (. ([] nodes (. node parent)) children) index)
    )
    (return index)
  )
  (fn-do + leaves (list Index)
    (param node Index)
    (let found (list Index))
    (call collect-leaves node found)
    (return found)
  )
  (fn-do + suite-of Index
    (param node Index)
    (let current node)
    (while (. ([] nodes current) parent)
      (= current (!! (. ([] nodes current) parent)))
    )
    (return current)
  )
  (fn-do + select TestSelection
    (param selectors (list String))
    (let chosen ([] Bool (. nodes length)))
    (let unmatched (list String))
    (if (== (. selectors length) 0)
      (for (in suite suites)
        (call mark suite chosen)
      )
    )
    (for (in selector selectors)
      (if (not (call choose selector chosen))
        (+= unmatched selector)
      )
    )
    (let leaves (list Index))
    (for (in index (..< 0 (. nodes length)))
      (if (and ([] chosen index) (. ([] nodes index) is-test))
        (+= leaves index)
      )
    )
    (return (call TestSelection leaves unmatched))
  )
  (fn-do _ collect-leaves _
    (param node Index)
    (param found (list Index))
    (let entry ([] nodes node))
    (if (. entry is-test)
      (+= found node)
      (return)
    )
    (for (in child (. entry children))
      (call collect-leaves child found)
    )
  )
  (fn-do _ mark Bool
    (param node Index)
    (param chosen ([] Bool))
    (let matched false)
    (for (in leaf (call leaves node))
      (= ([] chosen leaf) true)
      (= matched true)
    )
    (return matched)
  )
  (fn-do _ choose Bool
    (param selector String)
    (param chosen ([] Bool))
    (if (call (. selector starts-with) "suite:")
      (let name ([] selector (... (. "suite:" length))))
      (let matched false)
      (for (in suite suites)
        (if (== (. ([] nodes suite) id) name)
          (= matched (or (call mark suite chosen) matched))
        )
      )
      (return-if true (if matched))
      (return (or (call choose-groups selector chosen) (call choose-groups name chosen)))
    )
    (if (call (. selector starts-with) "file:")
      (let path (call test-relative-path ([] selector (... (. "file:" length))) root))
      (return (call choose-tests chosen (=> (node) (== (. node relative-path) path))))
    )
    (if (call (. selector starts-with) "test:")
      (return (call choose-tests chosen (=> (node) (or (== (. node id) selector) (== (. node selector) selector)))))
    )
    (let line (call test-line-selector selector))
    (if line
      (let path (call test-relative-path (. line path) root))
      (let number (. line number))
      (return (call choose-tests chosen (=> (node) (and (== (. node relative-path) path) (<= (. node line-start) number) (<= number (. node line-end))))))
    )
    (return-if true (if (call choose-groups selector chosen)))
    (let path (call test-relative-path selector root))
    (return-if true (if (call choose-tests chosen (=> (node) (or (has (. node selectors) selector) (== (. node relative-path) path) (== (. (call Path (. node relative-path) 0) name) selector))))))
    (let prefix (str path "/"))
    (return (call choose-tests chosen (=> (node) (call (. node relative-path starts-with) prefix))))
  )
  (fn-do _ choose-groups Bool
    (param selector String)
    (param chosen ([] Bool))
    (let matched false)
    (for (in index (..< 0 (. nodes length)))
      (let node ([] nodes index))
      (if (and (not (. node is-test)) (or is-named (has (. node selectors) selector) is-at-path))
        (= matched (or (call mark index chosen) matched))
      )
      (lazy is-named (or (== (. node selector) selector) (== (. node id) selector)))
      (lazy is-at-path (and (!= (. node relative-path) "") (== (. node relative-path) selector)))
    )
    (return matched)
  )
  (fn-do _ choose-tests Bool
    (param chosen ([] Bool))
    (param accepts TestNodePredicate)
    (let matched false)
    (for (in index (..< 0 (. nodes length)))
      (let node ([] nodes index))
      (if (and (. node is-test) (call accepts node))
        (= ([] chosen index) true)
        (= matched true)
      )
    )
    (return matched)
  )
)

(type + TestNodeKind (is Union)
  (variant suite)
  (variant group)
  (variant test)
)

(type + TestNode
  (prop + kind TestNodeKind)
  (prop + suite Index)
  (prop + id String)
  (prop + label String)
  (prop + selector String)
  (prop + parent (? Index))
  (prop + children (list Index))
  (prop + relative-path _ (= ""))
  (prop + line-start Size (= 0))
  (prop + line-end Size (= 0))
  (prop + selectors (list String))
  (fn-do + This _
    (param kind _)
    (param suite _)
    (param id _)
    (param label _)
    (param selector _)
    (param parent _)
  )
  (fn-expr + is-test Bool :get
    (== kind (. TestNodeKind test))
  )
)

(type + TestSelection (is Tuple)
  (prop + leaves (list Index))
  (prop + unmatched (list String))
)

(type + TestDiscovery
  (prop + is-stopped _ (= false))
  (prop + is-finished _ (= false))
  (blank)
  (prop _ processes (list Process))
  (prop _ done _ (:= (call (of SyncBufferedChannel Bool))))
  (fn-do + stop _
    (return-if (if is-stopped))
    (= is-stopped true)
    (for (in process processes)
      (call (. process kill-tree))
    )
  )
  (fn-do + finish _
    (= is-finished true)
    (call (. done close))
  )
  (fn-do + await _
    (<- done)
  )
  (fn-do _ watch _
    (param process Process)
    (if is-stopped
      (call (. process kill-tree))
    )
    (+= processes process)
  )
  (fn-do _ forget _
    (param process Process)
    (= processes (call (of List Process) (in each processes (when (!= (as each Pointer) (as process Pointer))))))
  )
)

(fn-expr + test-relative-path String
  (param path String)
  (param root String)
  (case? (call (. path starts-with) "./")
    ([] path (... 2))
  )
  (case? (call (. path starts-with) (str root "/"))
    ([] path (... (+ (. root length) 1)))
  )
  (default
    path
  )
)

(fn-do + discover-tests TestCatalog
  (param config TestConfig)
  (param discovery TestDiscovery)
  (let catalog (call TestCatalog (. config root)))
  (let listed (call (of SyncBufferedChannel TestListing)))
  (for (in index (..< 0 (. config suites length)))
    (do-new
      (<- listed (call list-suite config index discovery))
    )
  )
  (let listings (call (of Map Index TestListing)))
  (for (in _ (..< 0 (. config suites length)))
    (let listing (<- listed))
    (if listing
      (= ([] listings (. listing index)) listing)
    )
  )
  (for (in index (..< 0 (. config suites length)))
    (let suite ([] (. config suites) index))
    (let listing ([] listings index))
    (let problem (?. listing problem))
    (if (and listing (not problem))
      (let added (catch (call add-listing catalog index suite (. listing text))))
      (if (is added Error)
        (+= (. catalog problems) (str (. suite id) ": " (. (as added Error) message)))
      )
      (else
        (+= (. catalog problems) (str (. suite id) ": " (?? problem "no catalog")))
      )
    )
  )
  (return catalog)
)

(fn-expr + test-failure-text String
  (param errors String)
  (param fallback String)
  (if-expr (!= last "") last fallback)
  (where
    (lazy last (call test-last-line errors))
  )
)

(fn-expr + test-last-line String
  (param text String)
  (if-expr newline (call (. ([] trimmed (... (+ newline 1))) trim)) trimmed)
  (where
    (lazy trimmed (call (. text trim)))
    (lazy newline (call (. trimmed find-reverse) "\n"))
  )
)

(fn-expr + test-field String (?! Error)
  (param fields JSONObjectReader)
  (param key String)
  (if-expr (. ([] fields key) is-present) (call (. ([] fields key) string)) "")
)

(fn-expr + test-number Size (?! Error)
  (param fields JSONObjectReader)
  (param key String)
  (if-expr (. ([] fields key) is-present) (call (. ([] fields key) int)) 0)
)

(fn-expr + test-items (list JSONReader) (?! Error)
  (param fields JSONObjectReader)
  (param key String)
  (if-expr (. ([] fields key) is-present) (call (. ([] fields key) items)) (call (of List JSONReader)))
)

(type _ TestNodePredicate (is (fn-type Bool (param node TestNode))))

(type _ TestCapture
  (prop + is-timed-out _ (= false))
  (blank)
  (prop _ process Process)
  (prop _ is-settled _ (= false))
  (prop _ timer (? Task))
  (prop _ drained _ (:= (call (of Semaphore String))))
  (fn-do + This _
    (param process _)
    (let errors (!! (. process stderr)))
    (do-new
      (let text (as errors String))
      (call (. drained post) text)
    )
    (= timer
      (do-new
        (call watch)
      )
    )
  )
  (fn-do + settle _
    (= is-settled true)
    (call (?. timer cancel))
  )
  (fn-do + errors String
    (return (?? (call (. drained await)) ""))
  )
  (fn-do _ watch _
    (return-if (if is-settled))
    (call (. test-listing-timeout wait))
    (return-if (if is-settled))
    (= is-timed-out true)
    (call (. process kill-tree))
  )
)

(fn-do _ test-line-selector (? TestLineSelector)
  (param selector String)
  (let colon (call (. selector find-reverse) ":"))
  (return-if null (if (or (== colon null) (== colon 0))))
  (let digits ([] selector (... (+ colon 1))))
  (return-if null (if (== (. digits length) 0)))
  (for (in char digits)
    (return-if null (if (or (< char '0') (> char '9'))))
  )
  (let path ([] selector (..< 0 colon)))
  (return-if null (if (and (== (call (. path find) "/") null) (== (call (. path find) ".") null))))
  (return (call TestLineSelector path (as digits Size)))
)

(fn-do _ list-suite TestListing
  (param config TestConfig)
  (param index Index)
  (param discovery TestDiscovery)
  (let suite ([] (. config suites) index))
  (let listed (catch (call read-listing config suite discovery)))
  (match listed
    (case (: failure Error)
      (return (call TestListing index "" (. failure message)))
    )
    (case (: text String)
      (return (call TestListing index text null))
    )
  )
)

(fn-do _ read-listing String (?! Error)
  (param config TestConfig)
  (param suite TestSuiteConfig)
  (param discovery TestDiscovery)
  (throw (call Error "discovery stopped") (if (. discovery is-stopped)))
  (let step (call (. config step) suite (. suite catalog) (call (of Map String String))))
  (let command (. step arguments))
  (let process (use (call Process ([] command 0) (. ProcessStderr capture) ([] command (... 1)) (. config root) (. step variables) (:group (. ProcessGroup own)))))
  (call (. discovery watch) process)
  (finally
    (call (. discovery forget) process)
  )
  (let capture (call TestCapture process))
  (let output (call (. (call (. (call (of ChunkedTokenStream Byte) process) read)) slice-string)))
  (let status (?? (call (. process wait) null) -1))
  (call (. capture settle))
  (let errors (call (. capture errors)))
  (throw (call Error (str "listing timed out after " test-listing-timeout)) (if (. capture is-timed-out)))
  (throw (call Error (call test-failure-text errors (str "listing exited with status " status))) (if (!= status 0)))
  (return output)
)

(fn-do _ add-listing _ (?! Error)
  (param catalog TestCatalog)
  (param index Index)
  (param suite TestSuiteConfig)
  (param text String)
  (let listing (call (. (call JSONReader (str (. suite id) " catalog") (call parse-json text)) object)))
  (let details (call (of Map String JSONObjectReader)))
  (for (in item (call (. ([] listing "tests") items)))
    (let fields (call (. item object)))
    (= ([] details (call (. ([] fields "id") string))) fields)
  )
  (let root (call TestNode (. TestNodeKind suite) index (. suite id) (. suite id) (str "suite:" (. suite id)) null))
  (let node (call (. catalog add) root))
  (+= (. catalog suites) node)
  (let tops (call (. ([] listing "suites") items)))
  (if (and (== (. tops length) 1) (== (call test-field (call (. ([] tops 0) object)) "kind") "suite"))
    (let top (call (. ([] tops 0) object)))
    (+= (. root selectors) (call test-field top "selector"))
    (+= (. root selectors) (call test-field top "id"))
    (call add-children catalog node (call test-items top "children") details)
    (else
      (call add-children catalog node tops details)
    )
  )
)

(fn-do _ add-children _ (?! Error)
  (param catalog TestCatalog)
  (param parent Index)
  (param items (list JSONReader))
  (param details (map String JSONObjectReader))
  (let suite (. ([] (. catalog nodes) parent) suite))
  (for (in item items)
    (let fields (call (. item object)))
    (let id (call test-field fields "id"))
    (if (== (call test-field fields "kind") "test")
      (let detail (?? ([] details id) fields))
      (let node
        (call TestNode
          (block
            (arg (. TestNodeKind test))
            (arg suite)
            (arg id)
            (arg (call test-first-line (call test-field detail "label")))
            (arg (call test-field detail "selector"))
            (arg parent)
          )
        )
      )
      (= (. node relative-path)
        (scope (?? (call test-location detail root) (call test-field detail "relativePath"))
          (lazy root (. catalog root))
        )
      )
      (= (. node line-start) (call test-number detail "lineNoStart"))
      (= (. node line-end) (call test-number detail "lineNoEnd"))
      (for (in selector (call test-items detail "selectors"))
        (+= (. node selectors) (call (. selector string)))
      )
      (call (. catalog add) node)
      (else
        (let node
          (call TestNode
            (block
              (arg (. TestNodeKind group))
              (arg suite)
              (arg id)
              (arg (call test-field fields "label"))
              (arg (call test-field fields "selector"))
              (arg parent)
            )
          )
        )
        (= (. node relative-path) (?? (call test-location fields (. catalog root)) (if-expr (call (. id starts-with) "file:") ([] id (... (. "file:" length))) (call test-field fields "relativePath"))))
        (call add-children catalog (call (. catalog add) node) (call test-items fields "children") details)
      )
    )
  )
)

(fn-expr _ test-location (? String) (?! Error)
  (param fields JSONObjectReader)
  (param root String)
  (only-if ([] source (... (+ (. root length) 1))) (if (call (. source starts-with) (str root "/"))))
  (where
    (lazy source (call test-field fields "sourcePath"))
  )
)

(fn-expr _ test-first-line String
  (param text String)
  (if-expr newline (call (. ([] trimmed (..< 0 newline)) trim)) trimmed)
  (where
    (lazy trimmed (call (. text trim)))
    (lazy newline (call (. trimmed find) "\n"))
  )
)
