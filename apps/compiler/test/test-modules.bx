(import ./test-protocol)
(import /data/json)
(import /lang/target)
(import /os/env)
(import /os/file)
(import /os/path)
(import /os/process)
(import /stream/combine)
(import /stream/sort)
(import /time/clock)
(import /time/duration)
(import /unistd.h)
(blank)
(prop _ module-statuses (list String) (= (list "passed" "failed" "crashed")))
(prop _ module-reserved-cores _ (= 2))
(prop _ default-suite-name _ (= "tests"))

(fn-do + emit-module-catalog Int (?! Error)
  (param sources (list String))
  (let suite (call module-suite sources))
  (let start (as (?? (call env "OMETER_TESTOMETER_CATALOG_START_INDEX") "0") Int))
  (call emit-json (call catalog-json suite (call test-modules suite) start))
  (return 0)
)

(fn-do + run-modules Int (?! Error)
  (param sources (list String))
  (let suite (call module-suite sources))
  (let ids (call selected-test-ids (?? (call env "OMETER_TESTOMETER_SELECTED_TEST_IDS") "[]")))
  (throw (call Error "No tests were selected") (if (not ids)))
  (let found (map String TestModule))
  (for (in each (call test-modules suite))
    (= ([] found (. each id)) each)
  )
  (let modules (list TestModule))
  (for (in id ids)
    (let module ([] found id))
    (throw (call Error (str id " is not a test module of the " (. suite name) " suite")) (if (not module)))
    (+= modules module)
  )
  (let parent (/ (call Path (. suite project)) ".tmp/build/tests"))
  (call (. parent make-directories))
  (let scratch (as (call temporary-directory "run" (as parent String)) String))
  (finally
    (inline (call remove-folder scratch))
  )
  (call emit-json (call run-start-json ids))
  (let run (call ModuleRun suite (as (/ (. (call executable-path) dir) "brix") String) scratch modules))
  (call (. run run))
  (call emit-json (call (. run end-json)))
  (return 0)
)

(type _ ModuleSuite (is Tuple)
  (prop + name String)
  (prop + project String)
  (prop + sources (list String))
)

(fn-do _ module-suite ModuleSuite (?! Error)
  (param written (list String))
  ; A suite of the test modules its sources hold: a folder holds those in its `tests` folders, and a
  ; module named by its path without `.bx` is one.
  (let name (?? (call env "OMETER_TESTOMETER_SUITE_NAME") default-suite-name))
  (let project (. (call Path (?? (call env "OMETER_TESTOMETER_PROJECT_ROOT") (call cwd))) normalized))
  (let sources (list String))
  (for (in source written)
    (let found (. (if-expr (call (. source starts-with) "/") (call Path source) (/ (call Path project) source)) normalized))
    (throw (call Error (str "The " name " suite's " source " is neither a folder nor a module in " project)) (if (and (not (. (call Path found) is-dir)) (not is-brix-file))))
    (lazy is-brix-file (. (call Path (str found brix-extension)) is-file))
    (+= sources found)
  )
  (return (call ModuleSuite name project sources))
)

(type _ TestModule (is Tuple)
  (prop + id String)
  (prop + source-path String)
  (prop + relative-path String)
  (prop + display (list String))
  (prop + label String)
  (prop + fixtures (? String))
)

(fn-do _ test-modules (list TestModule) (?! Error)
  (param suite ModuleSuite)
  (let modules (list TestModule))
  (for (in source (. suite sources))
    (if (. (call Path source) is-dir)
      (let names (list String))
      (call collect-module-names (call Path source) "" names)
      (for (in name (call sort names))
        (+= modules (call test-module suite source name))
      )
      (else
        (+= modules (call test-module suite (as (. (call Path source) dir) String) (str "/" (. (call Path source) name))))
      )
    )
  )
  (return modules)
)

(fn-expr _ test-module TestModule
  (param suite ModuleSuite)
  (param root String)
  (param name String)
  (call TestModule
    (block
      (arg (str "test:" (. suite name) ":" relative-path ":1"))
      (arg source-path)
      (arg relative-path)
      (arg display)
      (arg label)
      (arg (call fixtures-folder root name))
    )
  )
  (where
    (lazy source-path (str root name brix-extension))
    (lazy relative-path (call project-relative (. suite project) source-path))
    (lazy display (call module-display name))
    (lazy label (if-expr display ([] display (- (. display length) 1)) name))
  )
)

(fn-do _ collect-module-names _ (?! Error)
  (param directory Path)
  (param prefix String)
  (param names (list String))
  (for (in child (. directory contents))
    (let base (. child name))
    (if (or (not (. child is-dir)) (call (. base starts-with) "."))
      (continue)
    )
    (if (!= base "tests")
      (call collect-module-names child (str prefix "/" base) names)
      (continue)
    )
    (for (in entry (. child contents))
      (if (and (. entry is-file) (== (str "." (. entry ext)) brix-extension))
        (+= names (str prefix "/" base "/" (. entry base-name)))
      )
    )
  )
)

(fn-do _ module-display (list String)
  (param name String)
  (let segments (list String) (case-each (in part (call (. name split) "/") (when (and part (!= part "tests"))))))
  (while (and (> (. segments length) 1) (== ([] segments (- (. segments length) 1)) ([] segments (- (. segments length) 2))))
    (call (. segments pop))
  )
  (return segments)
)

(fn-expr _ fixtures-folder (? String)
  (param root String)
  (param name String)
  (only-if (as folder String) (if (. folder is-dir)))
  (where
    (lazy folder (call Path (str root (. (call Path name) dir) "/fixtures/" (. (call Path name) name))))
  )
)

(fn-expr _ project-relative String
  (param project String)
  (param path String)
  (if-expr (call (. path starts-with) (str project "/")) ([] path (... (+ (. project length) 1))) path)
)

(fn-do _ catalog-json (map String JSON)
  (param suite ModuleSuite)
  (param modules (list TestModule))
  (param start Int)
  (let suite-id (str "suite:" (. suite name)))
  (let root (call CatalogNode suite-id (. suite name)))
  (let nodes (map String CatalogNode))
  (= ([] nodes suite-id) root)
  (let tests (list JSON))
  (for (in (tuple index found) (call indexed modules))
    (let relative-path (str (. suite name) ":" (. found relative-path)))
    (let file-id (str "file:" relative-path))
    (let display (. found display))
    (let suite-ids (list String) (list suite-id))
    (let parent root)
    (+= (. root count) 1)
    (for (in depth (..< 1 (. display length)))
      (let child-id (str "suite:" (. suite name) "/" (call (. "/" join) ([] display (..< 0 depth)))))
      (let child (?? ([] nodes child-id) (call CatalogNode child-id ([] display (- depth 1)))))
      (if (not ([] nodes child-id))
        (= ([] nodes child-id) child)
        (+= (. parent entries) (call CatalogEntry child null))
      )
      (+= (. child count) 1)
      (+= suite-ids child-id)
      (= parent child)
    )
    (let selectors (list String) (list (. found id) (str (. suite name) "/" (call (. "/" join) display)) file-id))
    (++= selectors suite-ids)
    (let test
      (call (of Map String JSON)
        (block
          (entry "id" (as (. found id) JSON))
          (entry "groupName" (as (. suite name) JSON))
          (entry "fileLabel" (as (call (. "/" join) display) JSON))
          (entry "sourcePath" (as (. found source-path) JSON))
          (entry "relativePath" (as relative-path JSON))
          (entry "label" (as (. found label) JSON))
          (entry "lineNoStart" (as 1 JSON))
          (entry "lineNoEnd" (as 1 JSON))
          (entry "selector" (as (. found id) JSON))
          (entry "fileId" (as file-id JSON))
          (entry "groupId" (as (str "group:" (. suite name)) JSON))
          (entry "suiteIds" (as (call json-strings suite-ids) JSON))
          (entry "selectors" (as (call json-strings selectors) JSON))
          (entry "index" (as (+ start index 1) JSON))
          (entry "caseIndex" (as 1 JSON))
          (entry "configName" (as (. suite name) JSON))
          (entry "suiteName" (as (. suite name) JSON))
          (entry "configuredSuiteSelector" (as suite-id JSON))
          (entry "isDefault" (as false JSON))
        )
      )
    )
    (+= tests test)
    (let node
      (call (of Map String JSON)
        (block
          (entry "id" (as (. found id) JSON))
          (entry "label" (as (. found label) JSON))
          (entry "kind" (as "test" JSON))
          (entry "selector" (as (. found id) JSON))
          (entry "count" (as 1 JSON))
          (entry "path" (as (. found source-path) JSON))
          (entry "sourcePath" (as (. found source-path) JSON))
          (entry "relativePath" (as relative-path JSON))
          (entry "lineNoStart" (as 1 JSON))
          (entry "lineNoEnd" (as 1 JSON))
        )
      )
    )
    (+= (. parent entries) (call CatalogEntry null (as node JSON)))
  )
  (return
    (call (of Map String JSON)
      (block
        (entry "protocol" (as "ometer.testometer.catalog.v1" JSON))
        (entry "protocolVersion" (as 1 JSON))
        (entry "version" (as 2 JSON))
        (entry "projectPath" (as (. suite project) JSON))
        (entry "suites" (as (list (call (. root json))) JSON))
        (entry "tests" (as tests JSON))
        (entry "scopes" (as (call (of List JSON)) JSON))
        (entry "isExclusive" (as false JSON))
      )
    )
  )
)

(type _ CatalogEntry (is Tuple)
  (prop + node (? CatalogNode))
  (prop + test (? JSON))
)

(type _ CatalogNode
  (prop + id String)
  (prop + label String)
  (prop + count _ (= 0))
  (prop + entries (list CatalogEntry))
  (fn-do + This _
    (param id _)
    (param label _)
  )
  (fn-do + json JSON
    (let children (list JSON))
    (for (in entry entries)
      (let node (. entry node))
      (+= children (if-expr node (call (. node json)) (!! (. entry test))))
    )
    (let fields
      (call (of Map String JSON)
        (block
          (entry "id" (as id JSON))
          (entry "label" (as label JSON))
          (entry "kind" (as "suite" JSON))
          (entry "selector" (as id JSON))
          (entry "count" (as count JSON))
          (entry "children" (as children JSON))
        )
      )
    )
    (return fields)
  )
)

(type _ ModuleResult
  (prop + status _ (= "crashed"))
  (prop + actual _ (= ""))
  (prop + expected _ (= ""))
  (prop + errors _ (= ""))
  (prop + duration _ (= 0ms))
  (prop + compiled _ (= false))
  (prop + exit _ (= 0))
)

(type _ ModuleRun
  (prop _ suite ModuleSuite)
  (prop _ compiler String)
  (prop _ scratch String)
  (prop _ modules (list TestModule))
  (prop _ counts (map String Int))
  (prop _ next Index (= 0))
  (prop _ output _ (:= (call Mutex)))
  (fn-do + This _
    (param suite _)
    (param compiler _)
    (param scratch _)
    (param modules _)
    (for (in status module-statuses)
      (= ([] counts status) 0)
    )
  )
  (fn-do + run _
    (let workers (call worker-count (. modules length)))
    (let finished (call (of SyncBufferedChannel Bool)))
    (for (in _ (..< 0 workers))
      (do-new
        (call work)
        (<- finished true)
      )
    )
    (for (in _ (..< 0 workers))
      (<- finished)
    )
  )
  (fn-expr + end-json (map String JSON)
    (call run-end-json (. modules length) (!! ([] counts "passed")) (!! ([] counts "failed")) 0 (!! ([] counts "crashed")) 0)
  )
  (fn-do _ work _
    (while true
      (let index (call claim))
      (return-if (if (>= index (. modules length))))
      (let module ([] modules index))
      (call write (call test-start-json (. module id)))
      (let result (call run-module module index))
      (call report module result)
    )
  )
  (fn-do _ claim Index
    (use output)
    (let index next)
    (+= next 1)
    (return index)
  )
  (fn-do _ write _
    (param value (map String JSON))
    (use output)
    (call (. stdout write) (str (call to-json value) "\n"))
  )
  (fn-do _ report _
    (param module TestModule)
    (param result ModuleResult)
    (use output)
    (= ([] counts (. result status)) (+ (!! ([] counts (. result status))) 1))
    (call (. stdout write) (str (call to-json (call result-json (. suite name) module result)) "\n"))
  )
  (fn-do _ run-module ModuleResult
    (param module TestModule)
    (param index Index)
    (let result (call ModuleResult))
    (let started (call clock))
    (let ran (catch (call build-and-run module index result)))
    (if (is ran Error)
      (= (. result status) "crashed")
      (= (. result errors) (str ran))
    )
    (= (. result duration) (- (call clock) started))
    (return result)
  )
  (fn-do _ build-and-run _ (?! Error)
    (param module TestModule)
    (param index Index)
    (param result ModuleResult)
    (let directory (str scratch "/module-" index))
    (let work (str directory "/work"))
    (call (. (call Path work) make-directories))
    (let fixtures (. module fixtures))
    (if fixtures
      (let copy (call Process "/bin/sh" "-c" (str "cp -R " (call shell-quoted (str fixtures "/.")) " " (call shell-quoted work))))
      (let copied (?? (call (. copy wait) null) 1))
      (call (. copy close))
      (throw (call Error (str "Unable to copy the fixtures of " (. module relative-path))) (if (!= copied 0)))
    )
    (let executable (str directory "/module"))
    (let build (str directory "/build"))
    (let errors-path (str directory "/stderr"))
    (let compile
      (paragraph
        (str "cd " (call shell-quoted (. suite project)) " && " (call shell-quoted compiler) " --compile -o " (call shell-quoted executable) " " (call shell-quoted (. module source-path)) " >" (call shell-quoted build) " 2>&1")
      )
    )
    (let compiling (call Process "/bin/sh" "-c" compile))
    (let compiled (?? (call (. compiling wait) null) 1))
    (call (. compiling close))
    (= (. result compiled) (. (call Path executable) is-file))
    (= (. result exit) compiled)
    (if (or (!= compiled 0) (not (. result compiled)))
      (let report (call (. (call read-text build) trim)))
      (= (. result status) "crashed")
      (= (. result errors) (if-expr report report (str "The compiler exited with status " compiled)))
      (return)
    )
    (let command
      (paragraph
        (str "cd " (call shell-quoted work) " && exec " (call shell-quoted executable) " 2>" (call shell-quoted errors-path))
      )
    )
    (let process (call Process "/bin/sh" "-c" command))
    (let output (as process String))
    (let status (?? (call (. process wait) null) 1))
    (call (. process close))
    (= (. result exit) status)
    (= (. result actual) (call (. output trim)))
    (if (!= (call (. output find) "RED (") null)
      (= (. result status) "failed")
      (= (. result expected) "every case GREEN")
      (else-if (!= status 0)
        (= (. result status) "crashed")
        (= (. result errors) (str (call (. output trim)) (call (. (call read-text errors-path) trim))))
      )
      (else
        (= (. result status) "passed")
      )
    )
  )
)

(fn-do _ result-json (map String JSON)
  (param suite String)
  (param module TestModule)
  (param result ModuleResult)
  (let fields
    (call (of Map String JSON)
      (block
        (entry "protocol" (as "ometer.testometer.v1" JSON))
        (entry "version" (as 1 JSON))
        (entry "type" (as "testResult" JSON))
        (entry "id" (as (. module id) JSON))
        (entry "groupName" (as suite JSON))
        (entry "fileLabel" (as (call (. "/" join) (. module display)) JSON))
        (entry "sourcePath" (as (. module source-path) JSON))
        (entry "relativePath" (as (str suite ":" (. module relative-path)) JSON))
        (entry "label" (as (. module label) JSON))
        (entry "lineNoStart" (as 1 JSON))
        (entry "lineNoEnd" (as 1 JSON))
        (entry "index" (as 1 JSON))
        (entry "status" (as (. result status) JSON))
        (entry "duration" (as (. result duration) JSON))
        (entry "compiled" (as (. result compiled) JSON))
        (entry "exit" (as (. result exit) JSON))
      )
    )
  )
  (if (== (. result status) "failed")
    (= ([] fields "expected") (. result expected))
    (= ([] fields "actual") (. result actual))
    (else-if (== (. result status) "crashed")
      (= ([] fields "errors") (. result errors))
      (= ([] fields "output") (. result actual))
    )
  )
  (return fields)
)

(fn-expr _ worker-count Size
  (param count Size)
  (if-expr (< count cores) count cores)
  (where
    (lazy online (as (call C:sysconf C:_SC_NPROCESSORS_ONLN) Int))
    (lazy cores (if-expr (> online module-reserved-cores) (as (- online module-reserved-cores) Size) 1))
  )
)

(fn-do _ read-text String
  (param path String)
  (let file (use (call File path)))
  (return (as file String))
)

(fn-expr _ shell-quoted String
  (param text String)
  (str "'" (call (. "'\\''" join) (call (. text split) "'")) "'")
)

(fn-do _ remove-folder _
  (param path String)
  (let remover (call Process "/bin/rm" (list "-rf" path)))
  (call (. remover wait) null)
  (call (. remover close))
)
