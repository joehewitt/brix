(import ./test-catalog)
(import ./test-config)
(import ./test-model)
(import ./test-modules)
(import ./test-report)
(import ./test-runner)
(import /lang/constants)
(import /os/cli)
(import /os/env)
(import /os/file)
(import /os/signal)
(import /time/duration)
(import /unistd.h)
(blank)
(prop _ test-refresh _ (= 100ms))
(prop _ test-discovery-poll _ (= 10ms))
(prop _ test-clear-line _ (= "\r\x1b[K"))
(blank)

(main
  (call request-process-termination (call (. (call TestTool) run)))
)

(type _ TestTool (is CommandLine)
  (content
    (<> This
      (= name "brix test")
      (= about (str "Run a project's tests. A project with no " test-config-path " has one suite, tests, which builds and runs each test module in a tests folder under the project root; a test module fails when it prints RED and crashes when it does not build or exits nonzero. " test-config-path " can name other folders of modules, or suites run by commands of their own, and folders under the root can hold a " test-config-path " of their own."))
      (blank)
      (<> Subcommand (text: "list")
        (= about "suites, or the files holding the selected tests")
        (= action (=> () (call list (?? (. root value) (as project-root String)) (. listed values) (. tests value))))
        (blank)
        (<> Arguments (id: listed) (text: "selector"))
        (<> Flag (id: tests) (text: "--tests")
          (= about "list each selected test")
        )
      )
      (blank)
      (<> Subcommand (text: "run")
        (= about "run the selected tests, or every suite")
        (= action (=> () (call run-tests (?? (. root value) (as project-root String)) (. chosen values) (. mode value))))
        (blank)
        (<> Arguments (id: chosen) (text: "selector"))
        (<> Option (id: mode) (text: "--mode")
          (= value-name "NAME")
          (= about "run each suite in a mode its config defines, such as no-batch")
        )
      )
      (blank)
      (<> Subcommand (text: "catalog-modules")
        (= hidden true)
        (= about "list the test modules of folders and modules, as a suite with modules does")
        (= action (=> () (call emit-module-catalog (. catalog-sources values))))
        (blank)
        (<> Arguments (id: catalog-sources) (text: "source"))
      )
      (blank)
      (<> Subcommand (text: "run-modules")
        (= hidden true)
        (= about "run the selected test modules of folders and modules, as a suite with modules does")
        (= action (=> () (call run-modules (. run-sources values))))
        (blank)
        (<> Arguments (id: run-sources) (text: "source"))
      )
      (blank)
      (<> HelpTopic (text: "selectors")
        (<> HelpEntry (text: "suite:tests")
          (= about "a whole suite")
        )
        (<> HelpEntry (text: "parser/tests/tokens.bx")
          (= about "one test module, or every case in a file of cases")
        )
        (<> HelpEntry (text: "stdlib/core/tests/a.test.md:40")
          (= about "the case of a file of cases that holds line 40")
        )
      )
      (blank)
      (<> Option (id: root) (text: "--root")
        (= value-name "PATH")
        (= about (str "the project folder holding " test-config-path "; by default the nearest folder holding .git, or else a " project-folder-name " folder, or else the current folder"))
      )
    )
  )
)

(fn-do _ open-catalog TestCatalog (?! Error)
  (param model TestModel)
  (call (. model discover))
  (while (. model is-discovering)
    (call (. test-discovery-poll wait))
  )
  (let problem (. model problem))
  (if problem
    (throw (call Error problem))
  )
  (let catalog (!! (. model catalog)))
  (for (in problem (. catalog problems))
    (<- stderr (str "warning: " problem "\n"))
  )
  (return catalog)
)

(fn-do _ list Int (?! Error)
  (param root String)
  (param selectors (list String))
  (param shows-tests Bool)
  (let model (use (call TestModel root)))
  (let catalog (call open-catalog model))
  (if (== (. selectors length) 0)
    (for (in line (call test-suite-lines (!! (. model config)) catalog))
      (print line)
    )
    (return 0)
  )
  (let selection (call (. catalog select) selectors))
  (for (in selector (. selection unmatched))
    (<- stderr (str "warning: " selector " matched no tests\n"))
  )
  (for (in line (call test-selection-lines catalog selection shows-tests))
    (print line)
  )
  (return (if-expr (> (. selection leaves length) 0) 0 1))
)

(fn-do _ run-tests Int (?! Error)
  (param root String)
  (param selectors (list String))
  (param mode (? String))
  (let model (use (call TestModel root)))
  (let catalog (call open-catalog model))
  (let selection (call (. catalog select) selectors))
  (for (in selector (. selection unmatched))
    (<- stderr (str "warning: " selector " matched no tests\n"))
  )
  (if (== (. selection leaves length) 0)
    (<- stderr "No tests selected\n")
    (return 1)
  )
  (if mode
    (for (in warning (call test-mode-warnings (!! (. model config)) catalog (. selection leaves) mode))
      (<- stderr (str "warning: " warning "\n"))
    )
  )
  (call (. model start) (. selection leaves) mode)
  (let current (!! (. model run)))
  (do-new
    (for (on sig sig-int)
      (if (. current is-settled)
        (call request-process-termination 130)
      )
      (call (. model stop))
    )
  )
  (let is-live (== (call C:isatty 1) 1))
  (let shown 0)
  (while (not (. current is-complete))
    (= shown (call print-reported model current shown is-live))
    (if is-live
      (<- stdout (str test-clear-line (call test-status-line model current)))
    )
    (call (. test-refresh wait))
  )
  (call print-reported model current shown is-live)
  (if is-live
    (<- stdout test-clear-line)
  )
  (for (in line (call test-unrun-lines current))
    (print line)
  )
  (for (in line (call test-note-lines current))
    (<- stderr (str line "\n"))
  )
  (for (in line (call test-summary-lines current))
    (print line)
  )
  (let stuck (call test-stuck-line current))
  (if stuck
    (<- stderr (str stuck "\n"))
  )
  (return-if 130 (if (. current is-stopped)))
  (for (in outcome (. current outcomes))
    (let status (. outcome result status))
    (return-if 1 (if (and (!= status (. TestStatus passed)) (!= status (. TestStatus skipped)))))
  )
  (return 0)
)

(fn-do _ print-reported Size
  (param model TestModel)
  (param current TestRun)
  (param shown Size)
  (param is-live Bool)
  (let reported (. current reported))
  (return-if shown (if (== shown (. reported length))))
  (if is-live
    (<- stdout test-clear-line)
  )
  (for (in index (..< shown (. reported length)))
    (let result (!! (call (. model result-of) ([] reported index))))
    (if (and (== (. result run) (. current number)) (call test-is-problem (. result status)))
      (for (in line (call test-failure-lines (call test-outcome (!! (. model catalog)) result)))
        (print line)
      )
      (print "")
    )
  )
  (return (. reported length))
)
