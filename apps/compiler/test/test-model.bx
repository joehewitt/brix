(import ./test-catalog)
(import ./test-config)
(import ./test-runner)
(import /os/path)
(import /stream/aggregate)
(import /time/debounced)
(import /time/duration)
(import /time/timer)
(blank)
(prop + test-status-count Size (= 10))
(prop _ test-refresh-delay _ (= 300ms))
(prop _ test-statuses (list TestStatus)
  (=
    (call List
      (block
        (item (. TestStatus running))
        (item (. TestStatus queued))
        (item (. TestStatus crashed))
        (item (. TestStatus timed-out))
        (item (. TestStatus failed))
        (item (. TestStatus stopped))
        (item (. TestStatus not-run))
        (item (. TestStatus passed))
        (item (. TestStatus skipped))
        (item (. TestStatus idle))
      )
    )
  )
)

(type + TestOutcome (is Tuple)
  (prop + suite String)
  (prop + id String)
  (prop + label String)
  (prop + result TestResult)
)

(type + TestRun
  (prop + number Int)
  (prop + leaves (list Index))
  (prop + started U64)
  (prop + ended U64)
  (prop + phase _ (= ""))
  (prop + notes (list String))
  (prop + reported (list Index))
  (prop + stuck (list Int))
  (prop + outcomes (list TestOutcome))
  (prop + suite-times (map String U64))
  (prop + running Size (= 0))
  (prop + is-settled _ (= false))
  (prop + is-stopped _ (= false))
  (prop + is-complete _ (= false))
  (fn-do + This _
    (param number _)
    (param leaves _)
    (param started _)
  )
  (fn-expr + elapsed U64 :get
    (- (if-expr (!= ended 0) ended (call monotonic-time-nanoseconds)) started)
  )
)

(type + TestModel
  (implements Closable)
  (prop + root String)
  (prop + changes (? (of Broadcastable PathWatchEvent)))
  (prop + config (? TestConfig))
  (prop + catalog (? TestCatalog))
  (prop + run (? TestRun))
  (prop + revision _ (= 0))
  (prop + is-discovering _ (= false))
  (prop + is-configured _ (= true))
  (prop + problem (? String))
  (prop + selection (list String))
  (blank)
  (prop _ runner _ (:= (call TestRunner)))
  (prop _ listener (? Closable))
  (prop _ base _ (= ""))
  (prop _ inputs (map String Bool))
  (prop _ folders (map String (list String)))
  (prop _ is-stale _ (= false))
  (prop _ schedule-refresh DebouncedAction)
  (prop _ live (list TestStatus))
  (prop _ results (list (? TestResult)))
  (prop _ tallies _ (= ([] Size 0)))
  (prop _ busy _ (= ([] U64 0)))
  (prop _ busy-since _ (= ([] U64 0)))
  (prop _ starts _ (= ([] U64 0)))
  (prop _ next-run _ (= 1))
  (fn-do + This _
    (param root _)
    (param changes _ (= null))
    (= base (str (?? (catch? (. (call Path root 0) resolved)) (call Path root 0))))
    (= schedule-refresh (call throttled test-refresh-delay (. this refresh)))
    (do-new
      (call consume)
    )
  )
  (fn-do + discover _
    (= is-stale false)
    (= problem null)
    (call listen)
    (let loaded (catch (call load-test-config root)))
    (if (is loaded Error)
      (= problem (. (as loaded Error) message))
      (+= revision 1)
      (return)
    )
    (= config (as loaded TestConfig))
    (= is-discovering true)
    (+= revision 1)
    (call (. runner discover) (!! config))
  )
  (fn-do + select _
    (param keys (list String))
    (= selection keys)
  )
  (fn-do + start _
    (param leaves (list Index))
    (param mode (? String) (= null))
    (return-if (if (or (not catalog) (not config) (== (. leaves length) 0))))
    (blank)
    (call stop)
    (let found (!! catalog))
    (let suites (. (!! config) suites))
    (let batches (list TestBatch))
    (for (in suite (..< 0 (. suites length)))
      (let ids (list String))
      (let nodes (call (of Map String Index)))
      (for (in leaf leaves)
        (let node ([] (. found nodes) leaf))
        (if (== (. node suite) suite)
          (+= ids (. node id))
          (= ([] nodes (. node id)) leaf)
        )
      )
      (if (> (. ids length) 0)
        (let arguments (list String))
        (++= arguments (. ([] suites suite) run))
        (if mode
          (++= arguments (?? ([] (. ([] suites suite) modes) mode) (call (of List String))))
        )
        (+= batches (call TestBatch ([] suites suite) arguments ids nodes))
      )
    )
    (let number next-run)
    (+= next-run 1)
    (= run (call TestRun number leaves (call monotonic-time-nanoseconds)))
    (for (in leaf leaves)
      (let parent (. ([] (. found nodes) leaf) parent))
      (while parent
        (= ([] busy parent) 0)
        (= ([] busy-since parent) 0)
        (= parent (. ([] (. found nodes) parent) parent))
      )
    )
    (for (in leaf leaves)
      (call set-live leaf (. TestStatus queued))
    )
    (+= revision 1)
    (call (. runner start) (call TestOrder number (!! config) batches))
  )
  (fn-do + stop _
    (let current run)
    (return-if (if (or (not current) (. current is-settled))))
    (blank)
    (let now (call monotonic-time-nanoseconds))
    (for (in leaf (. current leaves))
      (if (== ([] live leaf) (. TestStatus running))
        (call record (call TestResult (. current number) leaf (. TestStatus stopped) (- now ([] starts leaf)) "" "" ""))
        (else-if (== ([] live leaf) (. TestStatus queued))
          (call set-live leaf (. TestStatus idle))
        )
      )
    )
    (call seal current)
    (= (. current is-settled) true)
    (= (. current is-stopped) true)
    (= (. current ended) now)
    (+= revision 1)
    (call (. runner stop) (. current number))
  )
  (fn-do + status-of TestStatus
    (param node Index)
    (return-if (call leaf-status node) (if (. ([] (. (!! catalog) nodes) node) is-test)))
    (blank)
    (let base (* node test-status-count))
    (for (in status test-statuses)
      (return-if status (if (> ([] tallies (+ base (call test-status-slot status))) 0)))
    )
    (return (. TestStatus idle))
  )
  (fn-expr + count Size
    (param node Index)
    (param status TestStatus)
    (case? (. ([] (. (!! catalog) nodes) node) is-test)
      (if-expr (== (call leaf-status node) status) 1 0)
    )
    (default
      ([] tallies (+ (* node test-status-count) (call test-status-slot status)))
    )
  )
  (fn-do + elapsed (? U64)
    (param node Index)
    (let now (call monotonic-time-nanoseconds))
    (if (. ([] (. (!! catalog) nodes) node) is-test)
      (return-if null (if (== ([] live node) (. TestStatus queued))))
      (blank)
      (if (== ([] live node) (. TestStatus running))
        (return-if (- now ([] starts node)) (if (and run (== (. run running) 1))))
        (return null)
      )
      (return (?. ([] results node) duration))
    )
    (return-if (- (+ ([] busy node) now) ([] busy-since node)) (if (!= ([] busy-since node) 0)))
    (return (only-if ([] busy node) (if (> ([] busy node) 0))))
  )
  (fn-expr + problem-count Size
    (param node Index)
    (+ failed-or-crashed (call count node (. TestStatus timed-out)) (call count node (. TestStatus not-run)))
    (where
      (lazy failed-or-crashed (+ (call count node (. TestStatus failed)) (call count node (. TestStatus crashed))))
    )
  )
  (fn-do + run-counts (? (list Size))
    (let current run)
    (return-if null (if (not current)))
    (blank)
    (let counts (list Size))
    (for (in slot (..< 0 test-status-count))
      (+= counts 0)
    )
    (for (in leaf (. current leaves))
      (+= ([] counts (call test-status-slot (call leaf-status leaf))) 1)
    )
    (return counts)
  )
  (fn-expr + result-of (? TestResult)
    (param node Index)
    ([] results node)
  )
  (fn-expr + is-running Bool :get
    (and (!= run null) (not (. run is-settled)))
  )
  (fn-do + close _
    (call stop)
    (call (?. listener close))
    (= listener null)
    (call (. runner close))
  )
  (fn-expr _ leaf-status TestStatus
    (param node Index)
    (if-expr (!= ([] live node) (. TestStatus idle)) ([] live node) (?? (?. ([] results node) status) (. TestStatus idle)))
  )
  (fn-expr _ active Bool
    (param number Int)
    (and (== (?. run number) number) (not (. (!! run) is-settled)))
  )
  (fn-do _ consume _
    (for (in frame (. runner frames))
      (call apply frame)
      (while (not (. runner frames is-empty))
        (let next (<- (. runner frames)))
        (if next
          (call apply next)
        )
      )
      (+= revision 1)
      (call refresh)
    )
  )
  (fn-do _ listen _
    (return-if (if (or listener (not changes))))
    (blank)
    (= listener (catch? (call listen-for-changes changes (. this note))))
  )
  (fn-do _ note _
    (param event PathWatchEvent)
    (return-if (if (not (call affects event))))
    (blank)
    (= is-stale true)
    (call schedule-refresh)
  )
  (fn-do _ affects Bool
    (param event PathWatchEvent)
    (return-if true (if (. event must-rescan)))
    (blank)
    (let text (str (. event path)))
    (return-if true (if (?? (or (call (. text ends-with) (str "/" test-config-path)) ([] inputs text)) false)))
    (blank)
    (let slash (call (. text find-reverse) "/"))
    (return-if false (if (not slash)))
    (blank)
    (let extensions ([] folders ([] text (..< 0 slash))))
    (return-if false (if (or (not extensions) (not (call test-changes-names (. event flags))))))
    (return (call some extensions (:where (call (. text ends-with) each))))
  )
  (fn-do _ refresh _
    (return-if (if (or (not is-stale) is-discovering is-running)))
    (blank)
    (call discover)
  )
  (fn-do _ note-inputs _
    (param found TestCatalog)
    (let files (map String Bool))
    (let places (map String (list String)))
    (for (in node (. found nodes))
      (if (== (. node relative-path) "")
        (continue)
      )
      (let path (str base "/" (. node relative-path)))
      (= ([] files path) true)
      (let slash (call (. path find-reverse) "/"))
      (let dot (call (. path find-reverse) "."))
      (if (and slash dot (> dot slash))
        (let folder ([] path (..< 0 slash)))
        (let extension ([] path (... dot)))
        (let known (?? ([] places folder) (call (of List String))))
        (if (not (has known extension))
          (+= known extension)
          (= ([] places folder) known)
        )
      )
    )
    (= inputs files)
    (= folders places)
  )
  (fn-do _ apply _
    (param frame TestFrame)
    (let current run)
    (match (. frame event)
      (case (call .discovered found)
        (call adopt found)
      )
      (case (call .completed stuck)
        (if (== (?. current number) (. frame run))
          (= (. (!! current) stuck) stuck)
          (= (. (!! current) is-complete) true)
          (if (not (. (!! current) is-settled))
            (call finish (!! current))
          )
        )
      )
      (case (call .started node at)
        (if (call active (. frame run))
          (= ([] starts node) at)
          (call set-live node (. TestStatus running))
        )
      )
      (case (call .reported result)
        (if (call active (. frame run))
          (call record result)
        )
      )
      (case (call .phase name)
        (if (call active (. frame run))
          (= (. (!! current) phase) name)
        )
      )
      (case (call .noted text)
        (if (call active (. frame run))
          (+= (. (!! current) notes) text)
        )
      )
    )
  )
  (fn-do _ adopt _
    (param found TestCatalog)
    (call stop)
    (let previous catalog)
    (let earlier results)
    (let spent busy)
    (let last run)
    (= run null)
    (= catalog found)
    (= is-configured
      (scope (or has-config (> (. (call (. found select) (call (of List String))) leaves length) 0))
        (lazy has-config (. (call Path (str root "/" test-config-path) 0) exists))
      )
    )
    (let count (. found nodes length))
    (let statuses (list TestStatus))
    (let outcomes (list (? TestResult)))
    (for (in _ (..< 0 count))
      (+= statuses (. TestStatus idle))
      (+= outcomes null)
    )
    (= live statuses)
    (= results outcomes)
    (= tallies ([] Size (* count test-status-count)))
    (= busy ([] U64 count))
    (= busy-since ([] U64 count))
    (= starts ([] U64 count))
    (if previous
      (let moved (call test-moved-nodes previous found))
      (for (in old (..< 0 (. moved length)))
        (let index ([] moved old))
        (if (!= index null)
          (= ([] busy index) ([] spent old))
          (let result ([] earlier old))
          (if (and result (. ([] (. found nodes) index) is-test))
            (= ([] results index)
              (call TestResult
                (block
                  (arg (. result run))
                  (arg index)
                  (arg (. result status))
                  (arg (. result duration))
                  (arg (. result expected))
                  (arg (. result actual))
                  (arg (. result errors))
                )
              )
            )
          )
        )
      )
      (if (and last (. last is-settled))
        (= run (call test-moved-run last moved))
      )
    )
    (for (in index (..< 0 count))
      (if (. ([] (. found nodes) index) is-test)
        (let slot (call test-status-slot (call leaf-status index)))
        (let parent (. ([] (. found nodes) index) parent))
        (while parent
          (+= ([] tallies (+ (* parent test-status-count) slot)) 1)
          (= parent (. ([] (. found nodes) parent) parent))
        )
      )
    )
    (= is-discovering false)
    (call note-inputs found)
  )
  (fn-do _ finish _
    (param current TestRun)
    (for (in leaf (. current leaves))
      (if (!= ([] live leaf) (. TestStatus idle))
        (call record
          (block
            (arg
              (call TestResult
                (block
                  (arg (. current number))
                  (arg leaf)
                  (arg (. TestStatus not-run))
                  (arg 0)
                  (arg "")
                  (arg "")
                  (arg "no result was reported")
                )
              )
            )
          )
        )
      )
    )
    (call seal current)
    (= (. current is-settled) true)
    (= (. current ended) (call monotonic-time-nanoseconds))
  )
  (fn-do _ seal _
    (param current TestRun)
    (let found (!! catalog))
    (let sealed (list TestOutcome))
    (for (in leaf (. current leaves))
      (let result ([] results leaf))
      (let kept
        (scope (if-expr (and result (== (. result run) (. current number))) result stopped-result)
          (lazy stopped-result (call TestResult (. current number) leaf (. TestStatus stopped) 0 "" "" ""))
        )
      )
      (+= sealed (call test-outcome found kept))
      (let suite (call (. found suite-of) leaf))
      (let name (. ([] (. found nodes) suite) id))
      (let spent (call elapsed suite))
      (if (and spent (== ([] (. current suite-times) name) null))
        (= ([] (. current suite-times) name) spent)
      )
    )
    (= (. current outcomes) sealed)
  )
  (fn-do _ record _
    (param result TestResult)
    (let node (. result node))
    (let previous (call leaf-status node))
    (= ([] results node) result)
    (= ([] live node) (. TestStatus idle))
    (call shift node previous (call leaf-status node))
    (+= (?. run reported) node)
  )
  (fn-do _ set-live _
    (param node Index)
    (param status TestStatus)
    (let previous (call leaf-status node))
    (= ([] live node) status)
    (call shift node previous (call leaf-status node))
  )
  (fn-do _ shift _
    (param node Index)
    (param previous TestStatus)
    (param updated TestStatus)
    (return-if (if (== previous updated)))
    (blank)
    (let current run)
    (if current
      (if (== previous (. TestStatus running))
        (-= (. current running) 1)
      )
      (if (== updated (. TestStatus running))
        (+= (. current running) 1)
      )
    )
    (let now (call monotonic-time-nanoseconds))
    (let vacated (call test-status-slot previous))
    (let entered (call test-status-slot updated))
    (let running (call test-status-slot (. TestStatus running)))
    (let parent (. ([] (. (!! catalog) nodes) node) parent))
    (while parent
      (let base (* parent test-status-count))
      (let was-busy (> ([] tallies (+ base running)) 0))
      (-= ([] tallies (+ base vacated)) 1)
      (+= ([] tallies (+ base entered)) 1)
      (let is-busy (> ([] tallies (+ base running)) 0))
      (if (and (not was-busy) is-busy)
        (= ([] busy-since parent) now)
        (else-if (and was-busy (not is-busy))
          (+= ([] busy parent) (- now ([] busy-since parent)))
          (= ([] busy-since parent) 0)
        )
      )
      (= parent (. ([] (. (!! catalog) nodes) parent) parent))
    )
  )
)

(fn-do _ test-moved-nodes (list (? Index))
  (param previous TestCatalog)
  (param found TestCatalog)
  (let positions (map String Index))
  (for (in index (..< 0 (. found nodes length)))
    (= ([] positions (. ([] (. found nodes) index) selector)) index)
  )
  (let moved (list (? Index)))
  (for (in node (. previous nodes))
    (+= moved ([] positions (. node selector)))
  )
  (return moved)
)

(fn-do _ test-moved-run TestRun
  (param last TestRun)
  (param moved (list (? Index)))
  (let made (call TestRun (. last number) (call test-moved-indices (. last leaves) moved) (. last started)))
  (= (. made ended) (. last ended))
  (= (. made phase) (. last phase))
  (= (. made notes) (. last notes))
  (= (. made reported) (call test-moved-indices (. last reported) moved))
  (= (. made stuck) (. last stuck))
  (= (. made outcomes) (. last outcomes))
  (= (. made suite-times) (. last suite-times))
  (= (. made is-settled) (. last is-settled))
  (= (. made is-stopped) (. last is-stopped))
  (= (. made is-complete) (. last is-complete))
  (return made)
)

(fn-do _ test-moved-indices (list Index)
  (param indices (list Index))
  (param moved (list (? Index)))
  (let kept (list Index))
  (for (in index indices)
    (let found (only-if ([] moved index) (if (< index (. moved length)))))
    (if (!= found null)
      (+= kept found)
    )
  )
  (return kept)
)

(fn-expr + test-outcome TestOutcome
  (param catalog TestCatalog)
  (param result TestResult)
  (call TestOutcome (. ([] (. catalog nodes) (call (. catalog suite-of) (. result node))) id) (. test id) (. test label) result)
  (where
    (lazy test ([] (. catalog nodes) (. result node)))
  )
)

(fn-expr _ test-changes-names Bool
  (param flags PathWatchFlags)
  (or (call (. flags contains) (. PathWatchFlags created)) (call (. flags contains) (. PathWatchFlags removed)) is-renamed)
  (where
    (lazy is-renamed (call (. flags contains) (. PathWatchFlags renamed)))
  )
)

(fn-expr + test-status-slot Index
  (param status TestStatus)
  (match status
    (case .running
      0
    )
    (case .queued
      1
    )
    (case .crashed
      2
    )
    (case .timed-out
      3
    )
    (case .failed
      4
    )
    (case .stopped
      5
    )
    (case .not-run
      6
    )
    (case .passed
      7
    )
    (case .skipped
      8
    )
    (case .idle
      9
    )
  )
)

(fn-expr + test-status-name String
  (param status TestStatus)
  (match status
    (case .running
      "running"
    )
    (case .queued
      "queued"
    )
    (case .crashed
      "crashed"
    )
    (case .timed-out
      "timed out"
    )
    (case .failed
      "failed"
    )
    (case .stopped
      "stopped"
    )
    (case .not-run
      "not run"
    )
    (case .passed
      "passed"
    )
    (case .skipped
      "skipped"
    )
    (case .idle
      "idle"
    )
  )
)

(fn-expr + test-elapsed-text String
  (param nanoseconds U64)
  (case? (< milliseconds 1000)
    (str milliseconds "ms")
  )
  (case? (< milliseconds 60000)
    (str (/ tenths 10) "." (% tenths 10) "s")
  )
  (default
    (str (/ seconds 60) "m " (% seconds 60) "s")
  )
  (where
    (lazy milliseconds (/ nanoseconds 1000000))
    (lazy tenths (/ milliseconds 100))
    (lazy seconds (/ milliseconds 1000))
  )
)
