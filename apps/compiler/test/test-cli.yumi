./test-catalog
./test-config
./test-model
./test-modules
./test-report
./test-runner
/lang/constants
/os/cli
/os/env
/os/file
/os/signal
/time/duration
/unistd.h

_ test-refresh = 100ms
_ test-discovery-poll = 10ms
_ test-clear-line = "\r\x1b[K"

request-process-termination(TestTool().run())

━━━━━━━━━━━━━━━━━━━━
_ TestTool is CommandLine

────────────────────

<This
    name = "brix test"
    about = "Run a project's tests. A project with no $test-config-path has one suite, tests, which builds and runs each test module in a tests folder under the project root; a test module fails when it prints RED and crashes when it does not build or exits nonzero. $test-config-path can name other folders of modules, or suites run by commands of their own, and folders under the root can hold a $test-config-path of their own."

    <Subcommand "list"
        about = "suites, or the files holding the selected tests"
        action = => list(root.value ?? (project-root as String), listed.values, tests.value)

        <Arguments listed "selector"
        <Flag tests "--tests"
            about = "list each selected test"

    <Subcommand "run"
        about = "run the selected tests, or every suite"
        action = => run-tests(root.value ?? (project-root as String), chosen.values, mode.value)

        <Arguments chosen "selector"
        <Option mode "--mode"
            value-name = "NAME"
            about = "run each suite in a mode its config defines, such as no-batch"

    <Subcommand "catalog-modules"
        hidden = true
        about = "list the test modules of folders and modules, as a suite with modules does"
        action = => emit-module-catalog(catalog-sources.values)

        <Arguments catalog-sources "source"

    <Subcommand "run-modules"
        hidden = true
        about = "run the selected test modules of folders and modules, as a suite with modules does"
        action = => run-modules(run-sources.values)

        <Arguments run-sources "source"

    <HelpTopic "selectors"
        <HelpEntry "suite:tests"
            about = "a whole suite"
        <HelpEntry "parser/tests/tokens.yumi"
            about = "one test module, or every case in a file of cases"
        <HelpEntry "stdlib/core/tests/a.test.md:40"
            about = "the case of a file of cases that holds line 40"

    <Option root "--root"
        value-name = "PATH"
        about = "the project folder holding $test-config-path; by default the nearest folder holding .git, or else a $project-folder-name folder, or else the current folder"

━━━━━━━━━━━━━━━━━━━━
_ do open-catalog TestCatalog ?! Error
    - model TestModel

model.discover()
while model.is-discovering
    test-discovery-poll.wait()
. problem = model.problem
if problem
    ?! Error(problem)
. catalog = model.catalog!
for problem in catalog.problems
    stderr <- "warning: $problem\n"
= catalog

━━━━━━━━━━━━━━━━━━━━
_ do list Int ?! Error
    - root String
    - selectors [String]
    - shows-tests Bool

. model = use TestModel(root)
. catalog = open-catalog(model)
if selectors.length == 0
    for line in test-suite-lines(model.config!, catalog)
        -- line
    = 0
. selection = catalog.select(selectors)
for selector in selection.unmatched
    stderr <- "warning: $selector matched no tests\n"
for line in test-selection-lines(catalog, selection, shows-tests)
    -- line
= if selection.leaves.length > 0 then 0 else 1

━━━━━━━━━━━━━━━━━━━━
_ do run-tests Int ?! Error
    - root String
    - selectors [String]
    - mode String?

. model = use TestModel(root)
. catalog = open-catalog(model)
. selection = catalog.select(selectors)
for selector in selection.unmatched
    stderr <- "warning: $selector matched no tests\n"
if selection.leaves.length == 0
    stderr <- "No tests selected\n"
    = 1
if mode
    for warning in test-mode-warnings(model.config!, catalog, selection.leaves, mode)
        stderr <- "warning: $warning\n"
model.start(selection.leaves, mode)
. current = model.run!
do new
    for sig on sig-int
        if current.is-settled
            request-process-termination(130)
        model.stop()
. is-live = C:isatty(1) == 1
. shown = 0
while !current.is-complete
    shown = print-reported(model, current, shown, is-live)
    if is-live
        stdout <- "$test-clear-line${test-status-line(model, current)}"
    test-refresh.wait()
print-reported(model, current, shown, is-live)
if is-live
    stdout <- test-clear-line
for line in test-unrun-lines(current)
    -- line
for line in test-note-lines(current)
    stderr <- "$line\n"
for line in test-summary-lines(current)
    -- line
. stuck = test-stuck-line(current)
if stuck
    stderr <- "$stuck\n"
=? 130 if current.is-stopped
for outcome in current.outcomes
    . status = outcome.result.status
    =? 1 if status != TestStatus.passed && status != TestStatus.skipped
= 0

━━━━━━━━━━━━━━━━━━━━
_ do print-reported Size
    - model TestModel
    - current TestRun
    - shown Size
    - is-live Bool

. reported = current.reported
=? shown if shown == reported.length
if is-live
    stdout <- test-clear-line
for index in shown .. < reported.length
    . result = model.result-of(reported[index])!
    if result.run == current.number && test-is-problem(result.status)
        for line in test-failure-lines(test-outcome(model.catalog!, result))
            -- line
        -- ""
= reported.length
