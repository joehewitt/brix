(import /data/json)
(import /os/file)

(fn-do + selected-test-ids (list String)
  (param text String)
  (let decoded (call JSON text))
  (if (is-not decoded (list JSON))
    (throw (call Error "The selected tests must be a JSON array"))
  )
  (blank)
  (let ids (list String))
  (for (in value (as decoded (list JSON)))
    (if (is-not value String)
      (throw (call Error "The ids of the selected tests must be strings"))
    )
    (+= ids value)
  )
  (return ids)
)

(fn-expr + run-start-json (map String JSON)
  (param selected-ids (list String))
  (call (of Map String JSON)
    (block
      (entry "protocol" (as "ometer.testometer.v1" JSON))
      (entry "version" (as 1 JSON))
      (entry "type" (as "runStart" JSON))
      (entry "count" (as (. selected-ids length) JSON))
      (entry "testIds" (as (call json-strings selected-ids) JSON))
    )
  )
)

(fn-expr + test-start-json (map String JSON)
  (param id String)
  (call (of Map String JSON)
    (block
      (entry "protocol" (as "ometer.testometer.v1" JSON))
      (entry "version" (as 1 JSON))
      (entry "type" (as "testStart" JSON))
      (entry "id" (as id JSON))
    )
  )
)

(fn-expr + run-end-json (map String JSON)
  (param count Int)
  (param passed Int)
  (param failed Int)
  (param skipped Int)
  (param crashed Int)
  (param killed Int)
  (call (of Map String JSON)
    (block
      (entry "protocol" (as "ometer.testometer.v1" JSON))
      (entry "version" (as 1 JSON))
      (entry "type" (as "runEnd" JSON))
      (entry "count" (as count JSON))
      (entry "passed" (as passed JSON))
      (entry "failed" (as failed JSON))
      (entry "skipped" (as skipped JSON))
      (entry "crashed" (as crashed JSON))
      (entry "killed" (as killed JSON))
    )
  )
)

(fn-expr + json-strings (list JSON)
  (param values (list String))
  (case-each (in value values)
    (as value JSON)
  )
)

(fn-do + emit-json _
  (param value (map String JSON))
  (call (. stdout write) (str (call to-json value) "\n"))
)
