(import ./test-catalog)
(import ./test-config)
(import /BxCore/BxString.h)
(import /data/json)
(import /os/file)
(import /os/process)
(import /time/duration)
(import /time/timer)
(blank)
(prop _ test-stop-grace _ (= 1s))
(prop _ test-drain-grace _ (= 2s))
(prop _ test-settle-poll _ (= 20ms))
(prop _ test-settle-polls _ (= 25))
(prop _ test-attempt-limit _ (= 3))
(prop _ test-read-size Size (= 0x10000))
(prop _ test-line-limit Size (= 0x1000000))
(prop _ test-tail-limit Size (= 0x4000))
(prop _ test-note-limit Size (= 2000))
(prop _ test-newline Byte (= 10))
(prop _ test-lifeline _ (= "(read line <&3; kill -KILL 0) </dev/null >/dev/null 2>&1 & exec \"\$@\" 3<&-"))
(blank)
(type-line + TestFrame (is (tuple (: run Int) (: event TestEvent))))

(type + TestRunner
  (implements Closable)
  (prop + frames _ (:= (call (of SyncBufferedChannel TestFrame))))
  (blank)
  (prop _ commands _ (:= (call (of SyncBufferedChannel TestCommand))))
  (prop _ served _ (:= (call (of SyncBufferedChannel Bool))))
  (prop _ worker _ (:= (call Worker)))
  (fn-do + This _
    (do-new (worker: worker)
      (call serve)
    )
  )
  (fn-do + close _
    (return-if (if (. commands is-closed)))
    (blank)
    (call (. commands close))
    (<- served)
    (call (. worker stop))
    (call (. frames close))
  )
  (fn-do + discover _
    (param config TestConfig)
    (<- commands (call (. TestCommand discover) config))
  )
  (fn-do + start _
    (param order TestOrder)
    (<- commands (call (. TestCommand start) order))
  )
  (fn-do + stop _
    (param run Int)
    (<- commands (call (. TestCommand stop) run))
  )
  (fn-do _ serve _
    (let current (? TestExecution))
    (let discoveries (list TestDiscovery))
    (for (in command commands)
      (match command
        (case (call .discover config)
          (let discovery (call TestDiscovery))
          (= discoveries (call (of List TestDiscovery) (in each discoveries (when (not (. each is-finished))))))
          (+= discoveries discovery)
          (do-new
            (let found (call discover-tests config discovery))
            (if (not (. discovery is-stopped))
              (<- frames (call TestFrame 0 (call (. TestEvent discovered) found)))
            )
            (call (. discovery finish))
          )
        )
        (case (call .start order)
          (let previous current)
          (call (?. previous stop))
          (let execution (call TestExecution order frames))
          (= current execution)
          (do-new
            (call (?. previous await))
            (call (. execution execute))
          )
        )
        (case (call .stop run)
          (if (and current (== (. current order run) run))
            (call (. current stop))
          )
        )
      )
    )
    (for (in discovery discoveries)
      (call (. discovery stop))
    )
    (call (?. current stop))
    (for (in discovery discoveries)
      (call (. discovery await))
    )
    (call (?. current await))
    (call (. served close))
  )
)

(type + TestStatus (is Union)
  (variant idle)
  (variant queued)
  (variant running)
  (variant passed)
  (variant failed)
  (variant crashed)
  (variant timed-out)
  (variant stopped)
  (variant not-run)
  (variant skipped)
)

(type + TestResult (is Tuple)
  (prop + run Int)
  (prop + node Index)
  (prop + status TestStatus)
  (prop + duration U64)
  (prop + expected String)
  (prop + actual String)
  (prop + errors String)
)

(type + TestEvent (is Union)
  (variant discovered (tuple (: catalog TestCatalog)))
  (variant started (tuple (: node Index) (: at U64)))
  (variant reported (tuple (: result TestResult)))
  (variant phase (tuple (: name String)))
  (variant noted (tuple (: text String)))
  (variant completed (tuple (: stuck (list Int))))
)

(type + TestBatch (is Tuple)
  (prop + suite TestSuiteConfig)
  (prop + arguments (list String))
  (prop + ids (list String))
  (prop + nodes (map String Index))
)

(type + TestOrder (is Tuple)
  (prop + run Int)
  (prop + config TestConfig)
  (prop + batches (list TestBatch))
)

(fn-do + test-byte-text String
  (param bytes ([] Byte))
  (param count Size)
  (return-if (call (. bytes slice-string) (..< 0 count)) (if (== (call C:brixStringValidateUtf8 (. bytes data) count) 0)))
  (blank)
  (let cleaned ([] Byte count))
  (for (in index (..< 0 count))
    (= ([] cleaned index) (if-expr (< ([] bytes index) 128) ([] bytes index) 63))
  )
  (return (call (. cleaned slice-string) (..< 0 count)))
)

(type _ TestCommand (is Union)
  (variant discover (tuple (: config TestConfig)))
  (variant start (tuple (: order TestOrder)))
  (variant stop (tuple (: run Int)))
)

(type _ TestExecution
  (prop + order TestOrder)
  (blank)
  (prop _ frames (of SyncBufferedChannel TestFrame))
  (prop _ attempt (? TestAttempt))
  (prop _ is-stopping _ (= false))
  (prop _ stuck (list Int))
  (prop _ done _ (:= (call (of SyncBufferedChannel Bool))))
  (fn-do + This _
    (param order _)
    (param frames _)
  )
  (fn-do + stop _
    (return-if (if is-stopping))
    (blank)
    (= is-stopping true)
    (call (?. attempt stop))
  )
  (fn-do + await _
    (<- done)
  )
  (fn-do + execute _
    (for (in batch (. order batches))
      (if is-stopping
        (break)
      )
      (call run-batch batch)
    )
    (<- frames (call TestFrame (. order run) (call (. TestEvent completed) stuck)))
    (call (. done close))
  )
  (fn-do _ run-batch _
    (param batch TestBatch)
    (let pending (. batch ids))
    (let attempts 0)
    (let problem "")
    (while (and (> (. pending length) 0) (not is-stopping))
      (+= attempts 1)
      (let current (call TestAttempt order batch pending frames))
      (= attempt current)
      (call (. current run))
      (= attempt null)
      (++= stuck (. current stuck))
      (if (!= (. current problem) "")
        (= problem (. current problem))
      )
      (= pending (. current unstarted))
      (if (or (not (. current has-progressed)) (>= attempts test-attempt-limit))
        (break)
      )
    )
    (return-if (if is-stopping))
    (blank)
    (let reason (if-expr (!= problem "") problem (str (. batch suite id) " reported no result")))
    (for (in id pending)
      (scope (<- frames (call TestFrame (. order run) (call (. TestEvent reported) missing)))
        (lazy missing (call TestResult (. order run) (!! ([] (. batch nodes) id)) (. TestStatus not-run) 0 "" "" reason))
      )
    )
  )
)

(type _ TestAttempt
  (prop + unstarted (list String))
  (prop + stuck (list Int))
  (prop + problem _ (= ""))
  (prop + has-progressed _ (= false))
  (blank)
  (prop _ order TestOrder)
  (prop _ batch TestBatch)
  (prop _ ids (list String))
  (prop _ frames (of SyncBufferedChannel TestFrame))
  (prop _ wanted (map String Bool))
  (prop _ started (map String U64))
  (prop _ finished (map String Bool))
  (prop _ process (? Process))
  (prop _ lifeline (? File))
  (prop _ status Int (= -1))
  (prop _ errors _ (= ""))
  (prop _ last-activity U64)
  (prop _ is-stopping _ (= false))
  (prop _ is-exited _ (= false))
  (prop _ is-timed-out _ (= false))
  (prop _ is-settled _ (= false))
  (prop _ timers (list Task))
  (prop _ exited _ (:= (call (of SyncBufferedChannel Bool))))
  (prop _ drained _ (:= (call (of SyncBufferedChannel Bool))))
  (fn-do + This _
    (param order _)
    (param batch _)
    (param ids _)
    (param frames _)
    (for (in id ids)
      (= ([] wanted id) true)
    )
  )
  (fn-do + run _
    (call spawn
      (block
        (on-error (: failure Error)
          (= problem (str (. batch suite id) " did not start: " (. failure message)))
          (= unstarted ids)
          (return)
        )
      )
    )
    (let child (!! process))
    (= last-activity (call monotonic-time-nanoseconds))
    (do-new
      (call drain-errors child)
    )
    (+= timers
      (do-new
        (call await-exit child)
      )
    )
    (+= timers
      (do-new
        (call watch child)
      )
    )
    (if is-stopping
      (call (. child kill-tree))
    )
    (call read-output child)
    (<- exited)
    (<- drained)
    (call settle child)
    (call classify)
  )
  (fn-do + stop _
    (return-if (if is-stopping))
    (blank)
    (= is-stopping true)
    (let child process)
    (return-if (if (not child)))
    (blank)
    (if is-exited
      (call (. child kill-tree))
      (catch (call (. child close)))
      (return)
    )
    (call (. child terminate-group))
    (+= timers
      (do-new
        (call (. test-stop-grace wait))
        (if (not is-exited)
          (call (. child kill-tree))
        )
      )
    )
  )
  (fn-do _ spawn _ (?! Error)
    (let extra
      (call (of Map String String)
        (block
          (entry "OMETER_TESTOMETER_SELECTED_TEST_IDS" (call to-json (as (call (of List JSON) (in (as each JSON) ids)) JSON)))
        )
      )
    )
    (let step (call (. order config step) (. batch suite) (. batch arguments) extra))
    (let arguments
      (block
        (item "-c")
        (item test-lifeline)
        (item "sh")
        (spread (. step arguments))
        (pipe |> List)
      )
    )
    (let pipe (call process-pipe))
    (call (. pipe reader set-flag) (. FileFlags non-block-mode) false)
    (let child
      (call Process "/bin/sh" (. ProcessStderr capture) arguments (. order config root) (. step variables) (list (. pipe reader fd)) (:group (. ProcessGroup own))
        (block
          (on-error (: failure Error)
            (catch (call (. pipe reader close)))
            (catch (call (. pipe writer close)))
            (throw failure)
          )
        )
      )
    )
    (catch (call (. pipe reader close)))
    (= lifeline (. pipe writer))
    (= process child)
    (catch (call (. child close-input)))
  )
  (fn-do _ read-output _
    (param child Process)
    (let chunk ([] Byte test-read-size))
    (let line ([] Byte test-read-size))
    (let length Size 0)
    (let is-dropping false)
    (while true
      (let count (call read-chunk child chunk))
      (if (== count 0)
        (break)
      )
      (= last-activity (call monotonic-time-nanoseconds))
      (for (in index (..< 0 count))
        (let byte ([] chunk index))
        (if (== byte test-newline)
          (call finish-line line length is-dropping)
          (= length 0)
          (= is-dropping false)
          (else-if (< length test-line-limit)
            (if (== length (. line size))
              (= line (call (. line resize) (* length 2)))
            )
            (= ([] line length) byte)
            (+= length 1)
          )
          (else
            (= is-dropping true)
          )
        )
      )
    )
    (call finish-line line length is-dropping)
  )
  (fn-do _ finish-line _
    (param line ([] Byte))
    (param length Size)
    (param is-dropping Bool)
    (if is-dropping
      (call note (str (. batch suite id) " wrote a line longer than " test-line-limit " bytes"))
      (else-if (> length 0)
        (call accept (call test-byte-text line length))
      )
    )
  )
  (fn-do _ accept _
    (param text String)
    (let trimmed (call (. text trim)))
    (return-if (if (== (. trimmed length) 0)))
    (blank)
    (let parsed (catch? (call parse-json trimmed)))
    (let event (only-if (catch? (call (. (call JSONReader (str (. batch suite id) " event") parsed) object))) (if parsed)))
    (if (not event)
      (call note trimmed)
      (return)
    )
    (call handle event
      (block
        (on-error (: failure Error)
          (call note (str (. failure message) ": " trimmed))
        )
      )
    )
  )
  (fn-do _ handle _ (?! Error)
    (param event JSONObjectReader)
    (match? (call test-field event "type")
      (case= "testStart"
        (call begin (call test-field event "id"))
      )
      (case= "testResult"
        (call report event)
      )
      (case= "phase"
        (call send (call (. TestEvent phase) (call test-field event "name")))
      )
      (case= "error"
        (= problem (call test-field event "message"))
        (call note problem)
      )
    )
  )
  (fn-do _ begin _
    (param id String)
    (return-if (if (or (== ([] wanted id) null) (!= ([] started id) null))))
    (blank)
    (let now (call monotonic-time-nanoseconds))
    (= ([] started id) now)
    (= has-progressed true)
    (call send (call (. TestEvent started) (!! ([] (. batch nodes) id)) now))
  )
  (fn-do _ report _ (?! Error)
    (param event JSONObjectReader)
    (let id (call test-field event "id"))
    (return-if (if (== ([] wanted id) null)))
    (blank)
    (call begin id)
    (= ([] finished id) true)
    (= has-progressed true)
    (let milliseconds (call event-number event "duration"))
    (let measured (- (call monotonic-time-nanoseconds) (!! ([] started id))))
    (let duration (if-expr milliseconds (as (* milliseconds 1000000.0) U64) measured))
    (let status (call provider-status (call event-text event "status")))
    (call send
      (block
        (arg
          (call (. TestEvent reported)
            (block
              (arg
                (call TestResult
                  (block
                    (arg (. order run))
                    (arg (!! ([] (. batch nodes) id)))
                    (arg status)
                    (arg duration)
                    (arg (call event-text event "expected"))
                    (arg (call event-text event "actual"))
                    (arg (call event-text event "errors"))
                  )
                )
              )
            )
          )
        )
      )
    )
  )
  (fn-do _ drain-errors _
    (param child Process)
    (let chunk ([] Byte test-read-size))
    (let source (!! (. child stderr)))
    (while true
      (let count (call read-chunk source chunk))
      (if (== count 0)
        (break)
      )
      (= last-activity (call monotonic-time-nanoseconds))
      (let text (str errors (call test-byte-text chunk count)))
      (= errors (if-expr (> (. text length) test-tail-limit) ([] text (... (- (. text length) test-tail-limit))) text))
    )
    (call (. drained close))
  )
  (fn-do _ await-exit _
    (param child Process)
    (= status (?? (call (. child wait) null) -1))
    (= is-exited true)
    (call (. exited close))
    (call (. test-drain-grace wait))
    (return-if (if is-settled))
    (blank)
    (call (. child kill-tree))
    (catch (call (. child close)))
  )
  (fn-do _ watch _
    (param child Process)
    (let limit (as (as (. batch suite idle-timeout) Nanoseconds) U64))
    (while (not is-settled)
      (let idle (- (call monotonic-time-nanoseconds) last-activity))
      (if (>= idle limit)
        (= is-timed-out true)
        (call (. child kill-tree))
        (return)
      )
      (call (. (as (as (- limit idle) F64) Nanoseconds) wait))
    )
  )
  (fn-do _ settle _
    (param child Process)
    (= is-settled true)
    (for (in timer timers)
      (call (. timer cancel))
    )
    (call (. child kill-tree))
    (catch (call (. (!! lifeline) close)))
    (catch (call (. child close)))
    (let remaining (. child group-members))
    (let polls 0)
    (while (and (> (. remaining length) 0) (< polls test-settle-polls))
      (call (. test-settle-poll wait))
      (= remaining (. child group-members))
      (+= polls 1)
    )
    (= stuck remaining)
  )
  (fn-do _ classify _
    (let in-flight (list String))
    (for (in id ids)
      (if (== ([] finished id) null)
        (if (!= ([] started id) null)
          (+= in-flight id)
          (else
            (+= unstarted id)
          )
        )
      )
    )
    (return-if (if is-stopping))
    (blank)
    (let failure (call exit-text))
    (if (or is-timed-out (!= status 0))
      (= problem failure)
    )
    (let now (call monotonic-time-nanoseconds))
    (for (in id in-flight)
      (let elapsed (- now (!! ([] started id))))
      (if is-timed-out
        (call conclude id (. TestStatus timed-out) elapsed failure)
        (else-if (== (. in-flight length) 1)
          (call conclude id (. TestStatus crashed) elapsed failure)
        )
        (else
          (call conclude id (. TestStatus not-run) 0 failure)
        )
      )
    )
  )
  (fn-do _ exit-text String
    (let summary (str (. batch suite id) " exited with status " status))
    (if is-timed-out
      (= summary (str (. batch suite id) " wrote nothing for " (. batch suite idle-timeout) "s and was killed"))
      (else-if (== status 0)
        (= summary (str (. batch suite id) " exited without reporting every result"))
      )
    )
    (let tail (call (. errors trim)))
    (return (if-expr (!= tail "") (str summary "\n" tail) summary))
  )
  (fn-do _ conclude _
    (param id String)
    (param status TestStatus)
    (param duration U64)
    (param errors String)
    (call send (call (. TestEvent reported) (call TestResult (. order run) (!! ([] (. batch nodes) id)) status duration "" "" errors)))
  )
  (fn-do _ note _
    (param text String)
    (call send (call (. TestEvent noted) (if-expr (> (. text length) test-note-limit) ([] text (..< 0 test-note-limit)) text)))
  )
  (fn-do _ send _
    (param event TestEvent)
    (<- frames (call TestFrame (. order run) event))
  )
)

(fn-do _ read-chunk Size
  (param source ByteReadable)
  (param chunk ([] Byte))
  (return
    (call (. source read) (. chunk size) chunk
      (block
        (on-error (: failure Error)
          (return 0)
        )
      )
    )
  )
)

(fn-expr _ event-number (? F64)
  (param event JSONObjectReader)
  (param key String)
  (catch? (call (. ([] event key) number)))
)

(fn-expr _ event-text String
  (param event JSONObjectReader)
  (param key String)
  (?? text "")
  (where
    (lazy text (catch? (call (. ([] event key) string))))
  )
)

(fn-expr _ provider-status TestStatus
  (param status String)
  (case? (== status "passed")
    (. TestStatus passed)
  )
  (case? (== status "failed")
    (. TestStatus failed)
  )
  (case? (== status "skipped")
    (. TestStatus skipped)
  )
  (case? (== status "killed")
    (. TestStatus timed-out)
  )
  (default
    (. TestStatus crashed)
  )
)
