(import /BxCore/BxCore.h)
(import /data/json)
(import /lang/ast/error)
(import /lang/constants)
(import /lang/lint/config)
(import /lang/lint/diagnostics)
(import /lang/lint/fix)
(import /lang/lint/linter)
(import /lang/lint/protocol)
(import /lang/lint/semantic)
(import /os/cli)
(import /os/env)
(import /os/path)
(blank)

(main
  (call request-process-termination (call (. (call Brixlint) run)))
)

(type + LintTally
  ; Counts the diagnostics of a run as they are reported, and writes each in the run's format.
  (prop + json-lines Bool)
  (prop + total Int)
  (prop + actionable Int)
  (prop + review Int)
  (prop + fixes (? Int))
  (prop + fixed-files _ (= 0))
  (prop + is-dry-run _ (= false))
  (fn-do + This _
    (param json-lines Bool)
  )
  (fn-do + report _
    (param diagnostics (list LintDiagnostic))
    (for (in diagnostic diagnostics)
      (+= total 1)
      (if (== (. diagnostic status) "review")
        (+= review 1)
        (else
          (+= actionable 1)
        )
      )
      (if json-lines
        (call emit-diagnostic diagnostic)
        (else
          (print (call text-diagnostic diagnostic))
        )
      )
    )
  )
  (fn-do + summary (map String JSON)
    (param files Int)
    (param analysis (? SemanticAnalysis))
    ; The counts the run ends with, and with semantic rules, the roots typed, the targets they cover
    ; and those they do not, as the reference counts them.
    (let counts
      (call (of Map String JSON)
        (block
          (:files files)
          (:diagnostics total)
          (:actionable actionable)
          (:review review)
        )
      )
    )
    (if analysis
      (let plan (. analysis plan))
      (let failing (call (. analysis failed)))
      (let covered 0)
      (for (in target (. plan targets))
        (if (and (!= (. target covered-by length) 0) (not failing))
          (+= covered 1)
        )
      )
      (= ([] counts "semanticRoots") (. plan roots length))
      (= ([] counts "semanticCoveredFiles") covered)
      (= ([] counts "semanticUncoveredFiles")
        (scope (if-expr failing (. plan targets length) uncovered-count)
          (lazy uncovered-count (. plan uncovered length))
        )
      )
    )
    (if fixes
      (= ([] counts "fixes") fixes)
      (= ([] counts "fixedFiles") fixed-files)
      (= ([] counts "fixDryRun") is-dry-run)
    )
    (return counts)
  )
  (fn-do + finish _
    (param files Int)
    (param analysis (? SemanticAnalysis))
    (if json-lines
      (call emit-end "passed" (call summary files analysis) (only-if (call (. analysis report)) (if analysis)))
      (return)
    )
    (if fixes
      (let action (if-expr is-dry-run "Would apply" "Applied"))
      (print (str action " " (!! fixes) " fixes in " fixed-files " files"))
    )
    (if analysis
      (let plan (. analysis plan))
      (let names (list String) (in (. each path) (. plan roots)))
      (if (!= (. names length) 0)
        (print (str "Semantic roots: " root-list))
        (lazy root-list (call (. ", " join) (in (call relative-report-path (. analysis project-root) each) names)))
        (else
          (print "Semantic roots: none")
        )
      )
      (if (!= (. plan uncovered length) 0)
        (print (str "No semantic coverage: " (call (. ", " join) (in (call relative-report-path (. analysis project-root) each) (. plan uncovered)))))
      )
    )
    (if (!= total 0)
      (print (str total " diagnostics (" actionable " actionable, " review " reviewable) in " files " files"))
      (else
        (print (str "No lint diagnostics in " files " files"))
      )
    )
  )
)

(fn-expr + error-text _
  (param error Error)
  (match error
    (case (: syntax-error BrixSyntaxError)
      (str syntax-error)
    )
    (default
      (. error message)
    )
  )
)

(fn-do + fix _
  (param linter Linter)
  (param files (list String))
  (param fix-rules (list String))
  (param is-dry-run Bool)
  (param roots (list String))
  (param json-lines Bool)
  ; Lints the files in passes that apply their safe fixes, and reports the diagnostics of the last
  ; pass with the fixes applied, writing the files they changed unless it `is-dry-run`.
  (let run (call LintFixRun linter files fix-rules is-dry-run roots))
  (let tally (call LintTally json-lines))
  (let outcome (catch (call (. run run))))
  (if (is outcome Error)
    (let failed (and (. run analysis) (call (. run analysis failed))))
    (if (and json-lines failed)
      (call emit-error (. (as outcome Error) message))
      (call emit-end "error" (call (. tally summary) (. files length) (. run analysis)) (call (. (!! (. run analysis)) report)))
      (call C:exit 1)
    )
    (throw (as outcome Error))
  )
  (let report (only-if (call (. run analysis report)) (if (. run analysis))))
  (if json-lines
    (call emit-start (. files length) (. linter config path) report)
    (if report
      (call emit-semantic report)
    )
  )
  (= (. tally fixes) (. run fixes))
  (= (. tally fixed-files) (as (. run changed length) Int))
  (= (. tally is-dry-run) is-dry-run)
  (call (. tally report) (. run diagnostics))
  (call (. tally finish) (. files length) (. run analysis))
)

(fn-expr + normalized-root _
  (param root String)
  (case? (call (. root starts-with) "/")
    (call strip-trailing-slash root)
  )
  (case? (== root ".")
    (call cwd)
  )
  (default
    (call strip-trailing-slash (str (call cwd) "/" root))
  )
)

(fn-expr + default-search-path String
  (call (. ":" join) (in (as each String) (call module-search-paths)))
)

(type _ Brixlint (is CommandLine)
  (content
    (<> This
      (= name "brix lint")
      (= about "Lint Brix files, or apply the fixes their rules make safely.")
      (blank)
      (<> Arguments (id: target-paths) (text: "target")
        (= about "a file or folder to lint; the project root by default")
      )
      (<> Option (id: project) (text: "--project")
        (= value-name "ROOT")
        (= about "the project root; the current folder by default")
      )
      (<> Option (id: config-file) (text: "--config")
        (= value-name "PATH")
        (= about "the lint config; the project's .brix/lint.json by default")
      )
      (<> Option (id: module-paths) (text: "--search-path")
        (= value-name "PATHS")
        (= about
          (paragraph
            "folders to find modules in, joined by colons; the config's, or the compiler's by default"
          )
        )
      )
      (<> Options (id: rules) (text: "--rule")
        (= value-name "ID")
        (= about "run only this rule, configured or not")
      )
      (<> Option (id: format) (text: "--format")
        (= choices (list "text" "json-lines"))
        (= default "text")
        (= about "how to write diagnostics")
      )
      (<> Flag (id: lists-rules) (text: "--list-rules")
        (= about "list the rules as JSON lines, and lint nothing")
      )
      (blank)
      (<> OptionGroup (text: "semantic rules")
        (<> Flag (id: semantic-rules) (text: "--semantic-rules")
          (= about "also run the rules that type the program")
        )
        (<> Flag (id: coverage-plan) (text: "--coverage-plan")
          (= about "run the semantic rules and report which targets their roots cover")
        )
        (<> Options (id: semantic-roots) (text: "--semantic-root")
          (= value-name "PATH")
          (= about "a program to type, in place of the config's semantic roots")
        )
      )
      (blank)
      (<> OptionGroup (text: "fixes")
        (<> Flag (id: fixes) (text: "--fix")
          (= about "apply the safe fixes and write the files they change")
        )
        (<> Flag (id: dry-run) (text: "--fix-dry-run")
          (= about "report the safe fixes without writing them")
        )
        (<> Options (id: fix-rules) (text: "--fix-rule")
          (= value-name "ID")
          (= about "apply the fixes of only this rule")
        )
      )
    )
  )
  (fn-do + main Int (?! Error)
    (let outcome (catch (call lint)))
    (if (is outcome Error)
      (call emit-error (call error-text outcome))
      (return 1)
    )
    (return 0)
  )
  (fn-do _ lint _ (?! Error)
    (if (. lists-rules value)
      (let listed-root (call normalized-root (?? (. project value) (call cwd))))
      (call emit-rule-catalog (call load-lint-config listed-root (call rule-catalog) (. config-file value)))
      (return)
    )
    (blank)
    (let catalog (call rule-catalog))
    (let is-fixing (or (. fixes value) (. dry-run value)))
    (let is-semantic (or (. semantic-rules value) (. coverage-plan value)))
    (throw (call Error "--coverage-plan cannot be combined with --fix or --fix-dry-run") (if (and (. coverage-plan value) is-fixing)))
    (throw (call Error "--fix-rule needs --fix or --fix-dry-run") (if (and (!= (. fix-rules values length) 0) (not is-fixing))))
    (let selected (++ (. rules values) (. fix-rules values)))
    (let project-root (call normalized-root (?? (. project value) (call cwd))))
    (let config (call load-lint-config project-root catalog (. config-file value)))
    (let search-path (?? (. module-paths value) (. config search-path) (call default-search-path)))
    (for (in id selected)
      (let rule (call find-rule catalog id))
      (throw (call Error (str "Unknown lint rule: " id)) (if (not rule)))
      (if (not ([] (. config rules) id))
        (= ([] (. config rules) id) (call copy-options (. rule default-options)))
      )
    )
    (blank)
    (let targets (. target-paths values))
    (if (== (. targets length) 0)
      (+= targets ".")
    )
    (let files (call discover-lint-files project-root targets))
    (let linter (call Linter project-root search-path config catalog selected is-semantic))
    (blank)
    (let json-lines (== (. format value) "json-lines"))
    (if is-fixing
      (let roots (list String) (in (call resolve-target project-root each) (. semantic-roots values)))
      (call fix linter files (. fix-rules values) (. dry-run value) roots json-lines)
      (return)
    )
    (if json-lines
      (call emit-start (. files length) (. config path))
    )
    (blank)
    (let tally (call LintTally json-lines))
    (if (call (. linter has-file-rules))
      (let index 0)
      (for (in file files)
        (+= index 1)
        (if json-lines
          (call emit-progress (call relative-report-path project-root file) index (. files length))
        )
        (call (. tally report) (call (. linter lint-file) file))
      )
    )
    (blank)
    (if (not (call (. linter needs-phase) "semantic"))
      (call (. tally finish) (. files length) null)
      (return)
    )
    (blank)
    (let semantic-ids (list String) (in (. each id) (. linter active-rules) (when (== (. each phase) "semantic"))))
    (let label (if-expr (== (. semantic-ids length) 1) ([] semantic-ids 0) (str (. semantic-ids length) " rules")))
    (if json-lines
      (call emit-semantic-progress (. files length) null null label "analyze")
    )
    (let search-paths (list Path) (in (call Path each) (call (. search-path split) ":")))
    (let analysis (call SemanticAnalysis project-root search-paths json-lines label))
    (let roots (list String) (in (call resolve-target project-root each) (. semantic-roots values)))
    (call (. analysis analyze) files roots (. config semantic-roots))
    (let report (call (. analysis report)))
    (if json-lines
      (call emit-semantic report)
    )
    (if (call (. analysis failed))
      (if json-lines
        (call emit-error (call (. analysis failure-message)))
        (call emit-end "error" (call (. tally summary) (. files length) analysis) report)
        (else
          (call write-stderr (str "brix lint: " (call (. analysis failure-message))))
        )
      )
      (call C:exit 1)
    )
    (blank)
    (let index 0)
    (for (in file files)
      (+= index 1)
      (if json-lines
        (call emit-semantic-progress (. files length) (call relative-report-path project-root file) index label)
      )
      (if ([] (. analysis compiled) file)
        (call (. tally report) (call (. linter lint-file) file ([] (. analysis facts) file)))
      )
    )
    (call (. tally finish) (. files length) analysis)
  )
)
