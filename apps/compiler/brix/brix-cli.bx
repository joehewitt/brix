(import /core/arena)
(import /core/array-builder)
(import /data/sexp)
(import /lang/ast/ast-builder)
(import /lang/ast/ast-nodes)
(import /lang/ast/ast-xml)
(import /lang/ast/brix)
(import /lang/ast/grammar)
(import /lang/brix/convert)
(import /lang/constants)
(import /lang/lint/config)
(import /lang/lint/diagnostics)
(import /lang/lint/linter)
(import /lang/lint/source)
(import /lang/target)
(import /os/cli)
(import /os/env)
(import /os/file)
(import /os/path)
(blank)

(main
  (call request-process-termination (call run))
)

(fn-do _ run Int
  (let command (call cmdline))
  (let out (call env "BRIX_OUT"))
  (return-if (call sweep (. command args) out) (if (call (. command has-flag) "sweep")))
  (return-if (call check-parity (. command args)) (if (call (. command has-flag) "parity")))
  (return-if (call brix-round-trips (. command args)) (if (call (. command has-flag) "brix-round-trip")))
  (let is-check (call (. command has-flag) "check"))
  (let is-round-trip (call (. command has-flag) "round-trip"))
  (let converted 0)
  (let failed 0)
  (let differing 0)
  (for (in path (. command args))
    (if is-round-trip
      (let same (catch (call round-trips path)))
      (if (is same Error)
        (+= failed 1)
        (print (str path ": " same))
        (else-if (as same Bool)
          (+= converted 1)
        )
        (else
          (+= differing 1)
          (print (str path ": reads back differently"))
        )
      )
      (continue)
    )
    (let outcome (catch (call convert-file path is-check out)))
    (if (is outcome String)
      (+= converted 1)
      (if (not is-check)
        (print (as outcome String))
      )
      (else
        (+= failed 1)
        (print (str path ": " outcome))
      )
    )
  )
  (if is-round-trip
    (print (str "same " converted ", different " differing ", failed " failed))
    (else
      (print (str "converted " converted ", failed " failed))
    )
  )
  (return (if-expr (== (+ failed differing) 0) 0 1))
)

(fn-do _ sweep Int
  (param paths (list String))
  (param out (? String))
  (let tally (call ParityTally))
  (let problems Size 0)
  (for (in path paths)
    (let found (catch (call sweep-file path out tally)))
    (if (is found Error)
      (+= problems 1)
      (print (str path ": " found))
      (else
        (+= problems (as found Size))
      )
    )
  )
  (+= problems (+ (. tally failed-files) (. tally different-forms) (. tally failed-forms)))
  (print (str "sweep files " (. paths length) " problems " problems))
  (return (if-expr (== problems 0) 0 1))
)

(fn-do _ sweep-file Size (?! Error)
  (param path String)
  (param out (? String))
  (param tally ParityTally)
  (let source-file (use (call File path)))
  (let source (as source-file String))
  (let brix (call brix-convert source))
  (if out
    (call write-brix path brix out)
  )
  (let compared (catch (call compare-text path source brix tally)))
  (if (is compared Error)
    (+= (. tally failed-files) 1)
    (print (str path ": " compared))
  )
  (let view (call brix-yumi-text brix))
  (let problems Size 0)
  (if (not (call views-match source view))
    (+= problems 1)
    (print (str path ": its UBrix view reads back differently"))
  )
  (let mismatch (call save-mismatch brix view))
  (if mismatch
    (+= problems 1)
    (print (str path ":" mismatch ": saving its UBrix view changes its Brix"))
  )
  (return problems)
)

(fn-do _ convert-file String (?! Error)
  (param path String)
  (param is-check Bool)
  (param out (? String))
  (let source-file (use (call File path)))
  (let source (as source-file String))
  (let text (call brix-convert source))
  (return-if path (if is-check))
  (return (call write-brix path text out))
)

(fn-do _ write-brix String (?! Error)
  (param path String)
  (param text String)
  (param out (? String))
  (let name (str (?? (call source-stem path) path) brix-extension))
  (let target (if-expr out (/ (call Path out) name) (call Path name)))
  (let folder (. target parent))
  (if folder
    (call (. folder make-directories))
  )
  (let mode (+ (. FileFlags write-mode) (. FileFlags create-mode) (. FileFlags truncate-mode)))
  (let file (use (call File (as target String) mode)))
  (call (. file write) text)
  (return (as target String))
)

(fn-do _ round-trips Bool (?! Error)
  (param path String)
  (let source-file (use (call File path)))
  (let source (as source-file String))
  (return (call views-match source (call brix-yumi-text (call brix-convert source))))
)

(fn-expr _ views-match Bool (?! Error)
  (param source String)
  (param view String)
  (and (!= read null) (== read (call syntax-text source)))
  (where
    (lazy read (catch? (call syntax-text view)))
  )
)

(fn-do _ brix-round-trips Int
  (param paths (list String))
  (let linter (catch (call format-linter)))
  (if (is linter Error)
    (print (str linter))
    (return 1)
  )
  (let same Size 0)
  (let differing Size 0)
  (let failed Size 0)
  (for (in path paths)
    (let mismatch (catch (call brix-mismatch path linter)))
    (if (is mismatch Error)
      (+= failed 1)
      (print (str path ": " mismatch))
      (else-if (is mismatch Size)
        (+= differing 1)
        (print (str path ":" mismatch ": reads back differently"))
      )
      (else
        (+= same 1)
      )
    )
  )
  (print (str "same " same ", different " differing ", failed " failed))
  (return (if-expr (== (+ failed differing) 0) 0 1))
)

(fn-do _ format-linter Linter (?! Error)
  (let root (call cwd))
  (let catalog (call rule-catalog))
  (let config (call load-lint-config root catalog))
  (if (not ([] (. config rules) "layout/format"))
    (= ([] (. config rules) "layout/format")
      (call copy-options
        (block
          (arg (. (!! (call find-rule catalog "layout/format")) default-options))
        )
      )
    )
  )
  (let search-path (?? (. config search-path) (call (. ":" join) (in (as each String) (call module-search-paths)))))
  (return (call Linter root search-path config catalog (list "layout/format")))
)

(fn-do _ brix-mismatch (? Size) (?! Error)
  (param path String)
  (param linter Linter)
  (let source-file (use (call File path)))
  (let source (call formatted linter path (as source-file String)))
  (return (call save-mismatch source (call brix-yumi-text source)))
)

(fn-expr _ formatted String
  (param linter Linter)
  (param path String)
  (param text String)
  (if-expr (!= (. candidates length) 0) (. ([] candidates 0) replacement) text)
  (where
    (lazy absolute (if-expr (call (. path starts-with) "/") path (str (call cwd) "/" path)))
    (lazy candidates (call (. linter format-candidates) (call LintSource absolute text)))
  )
)

(fn-do _ save-mismatch (? Size) (?! Error)
  (param brix String)
  (param view String)
  (let reread (catch (call brix-convert view)))
  (throw (call Error (str "its UBrix view does not convert: " reread)) (if (is reread Error)))
  (let printed (as reread String))
  (return-if null (if (== printed brix)))
  (let wanted (call (of List String) (call (. brix split) "\n")))
  (let made (call (of List String) (call (. printed split) "\n")))
  (let line Size 0)
  (while (and (< line (. wanted length)) (< line (. made length)) (== ([] wanted line) ([] made line)))
    (+= line 1)
  )
  (return (+ line 1))
)

(fn-do _ syntax-text String (?! Error)
  (param source String)
  (let builder (call parse-yumi source))
  (use builder)
  (return (as (call (. builder view) (. builder root)) String))
)

(type _ ParityTally
  (prop + same-files Size (= 0))
  (prop + split-files Size (= 0))
  (prop + failed-files Size (= 0))
  (prop + same-forms Size (= 0))
  (prop + different-forms Size (= 0))
  (prop + failed-forms Size (= 0))
  (prop + reasons (map String Size))
)

(fn-do _ check-parity Int
  (param paths (list String))
  (let tally (call ParityTally))
  (for (in path paths)
    (let compared (catch (call compare-file path tally)))
    (if (is compared Error)
      (+= (. tally failed-files) 1)
      (print (str path ": " compared))
    )
  )
  (print (str "files: same " (. tally same-files) ", split " (. tally split-files) ", failed " (. tally failed-files)))
  (print (str "forms: same " (. tally same-forms) ", different " (. tally different-forms) ", failed " form-failures))
  (lazy form-failures (. tally failed-forms))
  (for (in (tuple reason count) (. tally reasons))
    (print (str count " " reason))
  )
  (return (if-expr (== (+ (. tally failed-files) (. tally different-forms) (. tally failed-forms)) 0) 0 1))
)

(fn-do _ compare-file _ (?! Error)
  (param path String)
  (param tally ParityTally)
  (let source-file (use (call File path)))
  (let source (as source-file String))
  (call compare-text path source (call brix-convert source) tally)
)

(fn-do _ compare-text _ (?! Error)
  (param path String)
  (param source String)
  (param brix String)
  (param tally ParityTally)
  (let yumi (use (call parse-yumi source path)))
  (let whole (catch? (call parse-brix brix path)))
  (if whole
    (let same (== (as (call (. whole view) (. whole root)) String) (as (call (. yumi view) (. yumi root)) String)))
    (call (. whole release))
    (if same
      (+= (. tally same-files) 1)
      (return)
    )
  )
  (+= (. tally split-files) 1)
  (call compare-forms path brix yumi tally)
)

(fn-do _ compare-forms _ (?! Error)
  (param path String)
  (param brix String)
  (param yumi ASTBuilder)
  (param tally ParityTally)
  (let statements (call top-statements yumi))
  (let arena (use (call Arena)))
  (let tape (call sexp-tape brix arena false))
  (let bytes (call byte-view brix))
  (let cursor Size 0)
  (let index Index 0)
  (while (< index (. tape length))
    (let head
      (scope (if-expr (and (call (. tape is-open) index) (call (. tape is-atom) (+ index 1))) head-atom "?")
        (lazy head-atom (call (. tape atom-text) (+ index 1)))
      )
    )
    (let span (call form-span tape index head))
    (if (== span 0)
      (= index (call (. tape after) index))
      (continue)
    )
    (let part (catch (call parse-brix (call (. bytes slice-string) (..< (call (. tape start) index) (call (. tape end) index))) path)))
    (if (is part ASTBuilder)
      (let made (call top-statements part))
      (throw (call Error (str path ": (" head " …) makes more statements than the source")) (if overruns))
      (lazy overruns (> (+ cursor (. made length)) (. statements length)))
      (for (in offset (..< 0 (. made length)))
        (let expected (call closure-free (as (call (. yumi view) ([] statements (+ cursor offset))) String)))
        (if (== (call closure-free (as (call (. part view) ([] made offset)) String)) expected)
          (+= (. tally same-forms) 1)
          (else
            (+= (. tally different-forms) 1)
            (print (str path ": (" head " …) differs"))
          )
        )
      )
      (+= cursor (. made length))
      (call (. part release))
      (else
        (+= cursor span)
        (+= (. tally failed-forms) span)
        (let message (. (as part Error) message))
        (= ([] (. tally reasons) message) (+ (?? ([] (. tally reasons) message) 0) 1))
        (print (str path ":" (+ (. (call (. tape token-location) index) line) 1) ": (" head " …) fails: " message))
      )
    )
    (= index (call (. tape after) index))
  )
)

(fn-do _ form-span Size
  (param tape SexpTape)
  (param index Index)
  (param head String)
  (return-if 0 (if (== head "blank")))
  (return-if 1 (if (!= head "main")))
  (let span Size 0)
  (let row (+ index 2))
  (while (< row (call (. tape close-of) index))
    (if (not (and (call (. tape is-open) row) (call (. tape atom-is) (+ row 1) "blank")))
      (+= span 1)
    )
    (= row (call (. tape after) row))
  )
  (return span)
)

(fn-do _ top-statements (list SyntaxId)
  (param tree ASTBuilder)
  (let ids (list SyntaxId))
  (match? ([] (. tree nodes) (. tree root))
    (case (call .node-top-level-syntax row)
      (for (in offset (..< 0 (. row statements count)))
        (+= ids ([] (. tree children) (+ (. row statements start) offset)))
      )
    )
  )
  (return ids)
)

(fn-do _ closure-free String
  (param text String)
  (let bytes (call byte-view text))
  (let marker (call byte-view "(closure"))
  (let kept (call (of ArrayBuilder Byte)))
  (let index Index 0)
  (while (< index (. bytes length))
    (let matched (and (<= (+ index (. marker length)) (. bytes length)) (call marker-at bytes index marker)))
    (let step (if-expr matched (. marker length) 1))
    (for (in offset (..< 0 step))
      (call (. kept append) ([] bytes (+ index offset)))
    )
    (+= index step)
    (while (and matched (< index (. bytes length)) (>= ([] bytes index) 48) (<= ([] bytes index) 57))
      (+= index 1)
    )
  )
  (return (call (. (call (. kept finish-mutable)) slice-string)))
)

(fn-do _ marker-at Bool
  (param bytes (of ImmutableArray Byte))
  (param index Index)
  (param marker (of ImmutableArray Byte))
  (for (in offset (..< 0 (. marker length)))
    (return-if false (if (!= ([] bytes (+ index offset)) ([] marker offset))))
  )
  (return true)
)
