/data/json
/data/jsonrpc
/lang/analysis/analysis-service
/lang/ast/syntax-program
/lang/target
/os/file
/os/memory-pressure
/os/path
/stream/aggregate
/time/duration
/unistd.h

━━━━━━━━━━━━━━━━━━━━
+ BuildResult is Tuple

+ status Int
+ output String
+ product String?

━━━━━━━━━━━━━━━━━━━━
+ BuildRunner is () BuildResult
    - arguments [String]

━━━━━━━━━━━━━━━━━━━━
_ BuildStep is Union

| build(job BuildJob)
| rest
| idle

━━━━━━━━━━━━━━━━━━━━
+ BuildDaemon

+ analysis AnalysisService
+ modules ModuleView
+ search-paths [Path]
+ runner BuildRunner
+ settling = 100ms
+ rest Doer?
_ lock = Mutex()
_ builder = Worker()
_ analyzer = Worker()
_ messages = SyncBufferedChannel'JSONRPCMessage()
_ sightings = SyncBufferedChannel'(List'String)()
_ replies File
_ reply-lock = Mutex()
_ queued [BuildJob]
_ running BuildJob?
_ finished [String = BuildJob]
_ digests [String = KeptDigest]
_ latest [String]?
_ watching [String = [String]]
_ completed = 0
_ generation = 0
_ is-working Bool
_ is-closing Bool
_ idle = Semaphore'Void()
_ analyzed = Semaphore'Void()
_ quiet = Semaphore'Void()
_ outstanding = 0
_ is-ending Bool
_ has-departed Bool
_ streams [Closable]
_ watched [String]
_ changes [String = Bool]
_ must-rescan Bool
_ is-pending Bool
_ is-serving Bool
_ is-pressed Bool
_ rested = 0

────────────────────
+ This
    - analysis AnalysisService
    - modules ModuleView
    - search-paths [Path]
    - runner BuildRunner

.. replies = File(C:dup(1), true, false)

────────────────────
for pressure on memory-pressure whenever #is-serving

relieve()

────────────────────
+ do serve Int

is-serving = true
do (analyzer) new analyze()
do new watch-sightings()
. lines Iterable'String = stdin
for line in lines
    if has-departed
        break
    if line.length != 0
        receive(line)
is-ending = true
is-serving = false
messages.close()
analyzed.wait()
while outstanding != 0
    quiet.wait()
if close-builds()
    idle.wait()
sightings.close()
for stream in streams
    stream.close()
= 0

────────────────────
_ do build BuildRecord
    - arguments [String]

. key = "\n".join(arguments)
. joined BuildJob? = null
while true
    . waiter = Semaphore'Void()
    . ticket = enlist(key, arguments, waiter, joined)
    =? ticket.job.record! if ticket.is-answered
    waiter.wait()
    joined = ticket.job

────────────────────
_ do receive
    - line String

. parsed = catch parse-json-rpc(line)
if parsed is Error
    reply(JSONRPCResponse(null, .error(JSONRPCError(.parse-error, (parsed as Error).message))))
    =
. message = parsed as JSONRPCMessage
if message is JSONRPCRequest
    . request = message as JSONRPCRequest
    if request.method == "build"
        outstanding += 1
        do new answer-build(request)
        =
    if request.method == "unwatch"
        reply(answer-unwatch(request))
        =
messages <- message

────────────────────
_ do answer-build
    - request JSONRPCRequest

. arguments = catch build-arguments(request.params)
if arguments is JSONRPCError
    reply(request.error-response(arguments))
else if arguments is Error
    reply(request.error-response(JSONRPCError(.invalid-params, arguments.message)))
else
    . watches = catch? build-watches(request.params)
    if watches ?? false
        watch(arguments)
    reply(request.response(record-fields(build(arguments))))
outstanding -= 1
quiet.post()

────────────────────
_ do answer-unwatch JSONRPCResponse
    - request JSONRPCRequest

. arguments = catch build-arguments(request.params)
=? request.error-response(arguments) if arguments is JSONRPCError
=? request.error-response(JSONRPCError(.invalid-params, arguments.message)) if arguments is Error
unwatch(arguments)
= request.response(true)

────────────────────
_ do watch
    - arguments [String]

use lock
watching["\n".join(arguments)] = arguments

────────────────────
_ do unwatch
    - arguments [String]

use lock
-= watching["\n".join(arguments)]

────────────────────
_ do announce
    - arguments [String]
    - record BuildRecord

. params = record-fields(record)
params["arguments"] = List'JSON(each in arguments)
send("${JSONRPCNotification("built", params)}\n")

────────────────────
_ do analyze

for message in messages
    match? message
        | request JSONRPCRequest
            reply(respond(request))
        | notification JSONRPCNotification
            if analysis.answers(notification.method)
                catch analysis.perform(notification.method, notification.params)
    . inputs = analysis.store.take-inputs()
    if inputs.length != 0
        sightings <- present-paths(inputs)
analyzed.post()

────────────────────
_ do respond JSONRPCResponse
    - request JSONRPCRequest

. result = catch perform(request)
if result is JSONRPCError
    = request.error-response(result)
if result is Error
    = request.error-response(JSONRPCError(.internal-error, (result as Error).message))
= request.response(result)

────────────────────
_ do perform JSON ?! Error
    - request JSONRPCRequest

?! JSONRPCError(.method-not-found, "Unknown method ${request.method}")
    if !analysis.answers(request.method)
= analysis.perform(request.method, request.params)

────────────────────
_ do reply
    - response JSONRPCResponse

send("$response\n")

────────────────────
_ do send
    - line String

use reply-lock
=? if has-departed
replies <- line
    catch IOError
        has-departed = true

────────────────────
_ do enlist BuildTicket
    - key String
    - arguments [String]
    - waiter Semaphore'Void
    - joined BuildJob?

use lock
latest = arguments
if joined
    =? BuildTicket(joined, true) if matches(joined.record!)
. finished-job = finished[key]
if finished-job
    =? BuildTicket(finished-job, true) if is-current(finished-job.record!)
. job = job-for(key, arguments)
job.waiters += waiter
= BuildTicket(job, false)

────────────────────
_ do speculate

use lock
=? if is-closing
. last = latest
. wanted = if last then watching + Map'String'(List'String)(("\n".join(last), last)) else watching
for key, arguments in wanted when !finished[key] || !is-current(finished[key]!.record!)
    job-for(key, arguments)

────────────────────
_ do job-for BuildJob
    - key String
    - arguments [String]

for job in queued
    =? job if job.key == key
. active = running
=? active if active && active.key == key && active.generation == generation
. job = BuildJob(key, arguments)
queued += job
if !is-working
    is-working = true
    do (builder) new work()
= job

────────────────────
_ do work

while true
    match take()
        | .build(job)
            run(job)
        | .rest
            . action = rest
            if action
                catch action()
        | .idle
            =

────────────────────
_ do run
    - job BuildJob

. result = runner(job.arguments)
. inputs = modules.take-inputs()
. product = result.product
completed += 1
. record = BuildRecord
    - result
    - inputs
    - file-stamp(product) if product
    - job.generation
    - completed
finish(job, record)
announce(job.arguments, record)
keep-digests(record)
sightings <- present-paths(inputs)
if !still-matches(record)
    speculate()

────────────────────
_ do take BuildStep

use lock
if queued.length == 0
    if is-pressed && !is-closing
        is-pressed = false
        rested = completed
        = BuildStep.rest
    is-working = false
    if is-closing
        idle.post()
    = BuildStep.idle
. job = queued[0]
queued.remove(0)
job.generation = generation
running = job
= BuildStep.build(job)

────────────────────
_ do relieve

use lock
=? if is-closing || !rest
=? if !is-working && rested == completed
is-pressed = true
if !is-working
    is-working = true
    do (builder) new work()

────────────────────
_ do finish
    - job BuildJob
    - record BuildRecord

use lock
job.record = record
finished[job.key] = job
running = null
for waiter in job.waiters
    waiter.post()

────────────────────
_ do close-builds Bool

use lock
is-closing = true
= is-working

────────────────────
_ do is-current Bool
    - record BuildRecord

=? false if record.generation != generation
. product = record.result.product
if product
    =? false if file-stamp(product) != record.product-stamp
= matches(record)

────────────────────
_ do still-matches Bool
    - record BuildRecord

use lock
= matches(record)

────────────────────
_ do matches Bool
    - record BuildRecord

for path, stamp in record.inputs
    =? false if !is-unchanged(path, stamp)
= true

────────────────────
_ do is-unchanged Bool
    - path String
    - stamp ParseStamp

. now = file-stamp(path)
=? !now if !stamp.is-file
=? true if now == stamp
. kept = digests[path]
=? false if !now || !kept || kept.stamp != stamp || now.size != stamp.size
=? true if kept.alike == now
. bytes = catch? read-file-bytes(Path(path))
=? false if !bytes || fnv-hash(bytes, bytes.size) != kept.digest || file-stamp(path) != now
kept.alike = now
= true

────────────────────
_ do keep-digests
    - record BuildRecord

for path, stamp in record.inputs
    if stamp.is-file && source-stem(path) && !has-digest(path, stamp)
        . before = file-stamp(path)
        . bytes = catch? read-file-bytes(Path(path))
        if bytes && before == stamp && file-stamp(path) == stamp
            keep-digest(path, stamp, fnv-hash(bytes, bytes.size))

────────────────────
_ do has-digest Bool
    - path String
    - stamp ParseStamp

use lock
= digests[path]?.stamp == stamp

────────────────────
_ do keep-digest
    - path String
    - stamp ParseStamp
    - digest U64

use lock
digests[path] = KeptDigest(stamp, digest)

────────────────────
_ do watch-sightings

for paths in sightings
    . roots [String = Bool]
    for path in paths when source-stem(path)
        roots[root-of(path)] = true
    for root, _ in roots
        if !is-nested(root, roots) && !is-within(root, watched)
            watch(root)

────────────────────
_ do root-of String
    - path String

for search in search-paths
    . root = search as String
    =? root if path.starts-with("$root/")
. parent = Path(path).parent
= if parent then parent as String else path

────────────────────
_ do watch
    - root String

. stream = Path(root).watch(true)
for event on stream
    note(event)
streams += stream
watched += root

────────────────────
_ do note
    - event PathWatchEvent

=? if is-ending
. path = event.path as String
=? if !event.must-rescan && !source-stem(path)
if event.must-rescan
    advance()
    must-rescan = true
else
    changes[path] = true
schedule()

────────────────────
_ do advance

use lock
generation += 1

────────────────────
_ do schedule

=? if is-pending
is-pending = true
do new
    settling.wait()
    is-pending = false
    flush()

────────────────────
_ do flush

=? if is-ending
for path, _ in changes
    . params = Map'String'JSON
        • path path
    messages <- JSONRPCNotification("changed", params)
changes.clear()
if must-rescan
    messages <- JSONRPCNotification("changed", Map'String'JSON())
    must-rescan = false
speculate()

━━━━━━━━━━━━━━━━━━━━
_ BuildJob

+ key String
+ arguments [String]
+ generation = 0
+ waiters [Semaphore'Void]
+ record BuildRecord?

────────────────────
+ This
    - key String
    - arguments [String]

━━━━━━━━━━━━━━━━━━━━
_ BuildRecord is Tuple

+ result BuildResult
+ inputs [String = ParseStamp]
+ product-stamp ParseStamp?
+ generation Int
+ number Int

━━━━━━━━━━━━━━━━━━━━
_ KeptDigest

+ stamp ParseStamp
+ digest U64
+ alike ParseStamp?

────────────────────
+ This
    - stamp ParseStamp
    - digest U64

━━━━━━━━━━━━━━━━━━━━
_ BuildTicket is Tuple

+ job BuildJob
+ is-answered Bool

━━━━━━━━━━━━━━━━━━━━
_ present-paths [String]
    - inputs [String = ParseStamp]

<* path, stamp in inputs when stamp.is-file
    path

━━━━━━━━━━━━━━━━━━━━
_ is-within Bool
    - path String
    - roots [String]

some(roots) • where path == each || path.starts-with("$each/")

━━━━━━━━━━━━━━━━━━━━
_ is-nested Bool
    - path String
    - roots [String = Bool]

some(roots.keys) • where path.starts-with("$each/")

━━━━━━━━━━━━━━━━━━━━
_ record-fields Map'String'JSON
    - record BuildRecord

Map'String'JSON
    • status record.result.status
    • output record.result.output
    •? product record.result.product
    • number record.number

━━━━━━━━━━━━━━━━━━━━
_ build-watches Bool ?! Error
    - params JSON

if fields.has("watch") then fields["watch"].bool() else false

.. fields = JSONReader("params", params).object()

━━━━━━━━━━━━━━━━━━━━
_ build-arguments [String] ?! Error
    - params JSON

each.string() in JSONReader("params", params).object()["arguments"].items()
