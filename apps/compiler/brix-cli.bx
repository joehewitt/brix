(import ./build-daemon)
(import ./project-init)
(import ./version)
(import /data/json)
(import /gc/gc)
(import /lang/analysis/analysis-service)
(import /lang/analysis/program-store)
(import /lang/ast/ast)
(import /lang/ast/ast-nodes)
(import /lang/ast/c-header)
(import /lang/ast/c-header-snapshot)
(import /lang/ast/error)
(import /lang/ast/module)
(import /lang/ast/probe-selection)
(import /lang/ast/program)
(import /lang/ast/syntax-program)
(import /lang/backend/backend-cache)
(import /lang/check/edit-typing)
(import /lang/check/parallel-typing)
(import /lang/check/session)
(import /lang/compiler)
(import /lang/constants)
(import /lang/emit/emission)
(import /lang/emit/emission-memory)
(import /lang/emit/link)
(import /lang/emit/products)
(import /lang/product/run-report)
(import /lang/report/explain)
(import /lang/report/facts-text)
(import /lang/target)
(import /os/cli)
(import /os/env)
(import /os/file)
(import /os/path)
(import /os/process)
(import /probes/supervise)
(import /stream/aggregate)
(import /time/clock)
(import /time/duration)
(import /unistd.h)
(blank)
(prop _ tool-names (list String) (= (list "probes" "test" "bench" "lint")))
(prop _ guide-index Path (:= (/ toolchain-root "docs/index.md")))
(blank)

(main
  (call set-minimum-heap-goal (* 256 1048576))
  (call request-process-termination
    (block
      (arg (?? (call run-tool (call cmdline-args)) (call run-init (call cmdline-args)) (call (. (call CompilerCommand) run))))
    )
  )
)

(type + BatchManifest
  ; The cases of a batch as a test runner lists them: the file the runtime marks each case in as it
  ; starts and finishes, the files the cases print to, and for each case its id, the directory it
  ; runs in, and its source with the name of its module.
  (blank)
  (prop + control _ (= ""))
  (prop + output _ (= ""))
  (prop + errors _ (= ""))
  (prop + ids (list String))
  (prop + directories (list String))
  (prop + roots (list (tuple String String)))
)

(fn-do + read-batch-manifest BatchManifest (?! Error)
  (param path (? String))
  ; Reads a manifest of a batch: a first line of its control, output and error files, then a line
  ; for each case of its id, its directory and the path of its source, each split by tabs. The
  ; module of a case is named by its place in the batch. Without a manifest there is no batch.
  (if (not path)
    (return (call BatchManifest))
  )
  (let file (use (call File path)))
  (let lines (list String) (call (. (as file String) split) "\n"))
  (let files (list String) (call (. ([] lines 0) split) "\t"))
  (throw (call Error "A batch manifest begins with its control, output and error files") (if (!= (. files length) 3)))
  (blank)
  (let manifest (call BatchManifest))
  (= (. manifest control) ([] files 0))
  (= (. manifest output) ([] files 1))
  (= (. manifest errors) ([] files 2))
  (for (in position (..< 1 (. lines length)))
    (if (== (. ([] lines position) length) 0)
      (continue)
    )
    (let fields (list String) (call (. ([] lines position) split) "\t"))
    (throw (call Error "A case of a batch manifest names its id, its directory and its source") (if (!= (. fields length) 3)))
    (blank)
    (+= (. manifest ids) ([] fields 0))
    (+= (. manifest directories) ([] fields 1))
    (+= (. manifest roots) (tuple ([] fields 2) (str "__test__/t" (call (. (as (. manifest roots length) Int) pad) 6) "/__source__")))
  )
  (throw (call Error "A batch manifest names no case") (if (not (. manifest roots))))
  (return manifest)
)

(fn-do + load-program Program
  (param brix BrixCompiler)
  (param manifest BatchManifest)
  (param source-path (? String))
  (param code (? String))
  ; The program a command names: the cases of a batch, or one source, read from its path or given
  ; as `code`.
  (return-if (call (. brix batch-to-ast) (. manifest roots)) (if (. manifest roots)))
  (return (call (. brix source-to-ast) (?? source-path "") "__source__" code))
)

(type _ CompilerCommand (is CommandLine)
  (prop + modules (? ModuleView))
  (prop + lowerings (? BackendCache))
  (prop + emissions (? EmissionMemory))
  (prop + typings (? KeptTyping))
  (prop + is-served _ (= false))
  (content
    (<> This
      (= name "brix")
      (= about
        (paragraph
          "Check a Brix program, or build it with -o and run it with the arguments after its source."
          (blank)
          (str "Before writing Brix, read " guide-index ", an index of the guides, the standard library and the examples.")
        )
      )
      (blank)
      (<> Argument (id: source) (text: "path.bx")
        (= about "the program to check, build or run")
      )
      (<> Arguments (id: passed) (text: "args")
        (= about "the program's arguments; after --, they may start with -")
      )
      (<> Flag (id: shows-version) (text: "--version")
        (= aliases (list "-v"))
        (= about "print the release this compiler came in, or the commit a local build is of")
      )
      (blank)
      (<> OptionGroup (text: "build")
        (<> Option (id: executable) (text: "-o")
          (= aliases (list "--o"))
          (= value-name "PATH")
          (= about
            (paragraph
              "build the executable at PATH and run it; without -o or --probes the program is only checked"
            )
          )
        )
        (<> Flag (id: compiles) (text: "--compile")
          (= about "build with -o but do not run")
        )
        (<> Flag (id: claims-documents) (text: "--claims-documents")
          (= about
            (paragraph
              "make the app bundle claim its DocumentType files, so the OS opens them with it; give it only to the build that gets installed, since a launched bundle stays registered"
            )
          )
        )
        (<> Flag (id: stops-at-object) (text: "--object-only")
          (= about "write the object file at -o PATH and stop, without linking or running")
        )
        (<> Flag (id: reached-only) (text: "--reached-only")
          (= about
            (paragraph
              "without -o, check only what the program reaches, as a build does; a check otherwise also types what the source declares that nothing reaches"
            )
          )
        )
        (<> Option (id: built) (text: "--run")
          (= value-name "PATH")
          (= about
            (paragraph
              "run a program built with --compile -o PATH, installing it on its simulator or device first"
            )
          )
        )
        (<> Option (id: device) (text: "--device")
          (= value-name "NAME")
          (= about
            (paragraph
              "the simulator or device an iOS program runs on, by name or id; the first --list-devices lists by default"
            )
          )
        )
        (<> Flag (id: lists-devices) (text: "--list-devices")
          (= about
            (paragraph
              "list the simulators or devices of --target, one JSON line each, in the order a run picks from"
            )
          )
        )
        (<> Option (id: code) (text: "-c")
          (= aliases (list "--c"))
          (= value-name "SOURCE")
          (= about "the program's source text in place of a file")
        )
        (<> Option (id: target-name) (text: "--target")
          (= value-name "NAME")
          (= choices (in (. each name) (call targets)))
          (= default (. (call host-target) name))
          (= about (str "the platform to build for: " (call (. ", " join) (in (. each name) (call targets)))))
        )
        (<> Option (id: c-header-snapshot) (text: "--c-headers")
          (= value-name "PATH")
          (= about
            (paragraph
              "read the C headers from the snapshot at PATH, which --record-c-headers wrote, in place of the target's SDK or sysroot"
            )
          )
        )
        (<> Option (id: c-header-recording) (text: "--record-c-headers")
          (= value-name "PATH")
          (= about
            (paragraph
              "write a snapshot at PATH of the C headers the build reads, for a host without the target's SDK to build as this one does"
            )
          )
        )
        (<> (of Option Int) (id: workers) (text: "--workers")
          (= value-name "N")
          (= about "threads for typing and emission")
        )
        (<> Flag (id: unoptimized) (text: "--unoptimized")
          (= about "build without optimizing")
        )
        (<> Flag (id: warns) (text: "--warnings")
          (= about "report warnings")
        )
        (<> Flag (id: shows-ubrix) (text: "--ubrix-errors")
          (= about
            (paragraph
              "under an error in a .bx file, quote the UBrix row the editor shows, with the caret under the expression the error is about, in place of the S-expression line"
            )
          )
        )
        (<> Flag (id: verifies-reuse) (text: "--verify-reuse")
          (= about
            (paragraph
              "in the build daemon, emit, inline and lower each function a build would reuse, and fail where they differ"
            )
          )
        )
        (<> Option (id: batch-path) (text: "--batch")
          (= hidden true)
        )
        (<> Flag (id: debugs) (text: "--debug")
          (= hidden true)
        )
        (<> Flag (id: serves) (text: "--serve")
          (= hidden true)
          (= about
            (paragraph
              "answer build and analysis requests on stdin, one JSON-RPC line each, keeping what each parse and each lowered function makes"
            )
          )
        )
        (<> Flag (id: debug-intrinsics) (text: "--compiler-debug-intrinsics")
          (= aliases (list "--compilerDebugIntrinsics"))
          (= hidden true)
        )
      )
      (blank)
      (<> OptionGroup (text: "probes")
        (<> Options (id: probes) (text: "--probes")
          (= needs-value false)
          (= value-name "SELECTORS")
          (= parser (=> (text) (only-if text (if (call is-selector-list text)))))
          (= about
            (paragraph
              "compile probes in, run, and record the trace in .tmp/build/probes/; without -o, the executable is built at .tmp/build/probes/bin/NAME; with no selectors, every probe in the source and every probe with no key"
            )
          )
        )
        (<> (of Option Seconds) (id: time-limit) (text: "--timeout")
          (= value-name "D")
          (= parser (=> (text) (call parse-timeout text)))
          (= about "stop the program after D (500ms, 30s, 2m) and exit with 124")
        )
        (<> Option (id: trace-path) (text: "--trace")
          (= value-name "PATH")
          (= about "where to write the trace")
        )
        (<> Flag (id: quiet-probes) (text: "--quiet-probes")
          (= about "print only the footer, not each probe line")
        )
      )
      (blank)
      (<> OptionGroup (text: "inspection")
        (<> Flag (id: dumps-ir) (text: "--dump-ir")
          (= about "print the IR of each function to stderr as it builds")
        )
        (<> Option (id: inspection) (text: "--inspect")
          (= choices (list "ir" "emitted"))
          (= about
            (paragraph
              "print the IR to stderr without building; ir adds each backend stage, emitted does not"
            )
          )
        )
        (<> Flag (id: lists-sources) (text: "--list-sources")
          (= about "list the modules the program loads")
        )
        (<> Option (id: explained) (text: "--explain")
          (= value-name "FUNCTION")
          (= about
            (paragraph
              "print what the compiler inferred about a function: a name, Type.method, path:name, or file:line"
            )
          )
        )
        (<> Flag (id: lists-probes) (text: "--list-probes")
          (= about
            (paragraph
              "list each probe the program writes, as a JSON line of its key, kind, path and line"
            )
          )
        )
        (<> Flag (id: timings) (text: "--timings")
          (= about "print the time each phase takes")
        )
        (<> Option (id: link-record) (text: "--link-record")
          (= value-name "PATH")
          (= about "write the link command as JSON to PATH")
        )
      )
      (blank)
      (<> HelpTopic (text: "probe selectors, joined by commas or spaces in one argument")
        (<> HelpEntry (text: "key, key.*")
          (= about "a key and the keys inside it")
        )
        (<> HelpEntry (text: "log:, log:key")
          (= about "logs with no key, or logs under a key")
        )
        (<> HelpEntry (text: "counter:*")
          (= about "every counter")
        )
        (<> HelpEntry (text: "profile:key")
          (= about "counters and groups without text as metrics, no records")
        )
        (<> HelpEntry (text: "gc")
          (= about "the collector's cycles, pauses and assist time")
        )
        (<> HelpEntry (text: "*")
          (= about "every probe")
        )
      )
      (blank)
      (<> HelpTopic (text: "tools")
        (<> HelpEntry (text: "brix init [folder]")
          (= about
            (paragraph
              "write the AGENTS.md section and CLAUDE.md import that send agents to these guides"
            )
          )
        )
        (<> HelpEntry (text: "brix probes --help")
          (= about
            (paragraph
              "query the trace of a run: summary, log, agg, durations, tree, timeline, outliers"
            )
          )
        )
        (<> HelpEntry (text: "brix test --help")
          (= about
            (paragraph
              "run the test modules in the tests folders of a project, or the suites .brix/tests.json defines"
            )
          )
        )
        (<> HelpEntry (text: "brix bench --help")
          (= about "build, measure and compare the benchmarks in the bench folders of a project")
        )
        (<> HelpEntry (text: "brix lint --help")
          (= about "lint Brix files, or apply the fixes their rules make safely")
        )
      )
      (blank)
      (<> HelpTopic (text: "bin/brix")
        (<> HelpEntry (text: "--compiler-probes [SELECTORS]")
          (= about "build the compiler with these probes and record its run")
        )
      )
    )
  )
  (fn-do + main Int (?! Error)
    (return-if (call serve) (if (. serves value)))
    (return-if (call show-version) (if (. shows-version value)))
    (return-if (call introduce) (if (< (. (call cmdline-args) length) 2)))
    (throw (call UsageError "missing <path.bx>" this) (if (and (not source-path) (not (. code value)) (not (. batch-path value)) (not (. built value)) (not (. lists-devices value)))))
    (throw (call UsageError "--trace and --quiet-probes need --probes" this) (if (and (not (. probes is-given)) (or (. trace-path value) (. quiet-probes value)))))
    (throw (call UsageError "--compile needs -o PATH for the executable" this) (if (and (. compiles value) (not (. executable value)) (not (. batch-path value)))))
    (throw (call UsageError "--object-only needs -o PATH for the object" this) (if (and (. stops-at-object value) (not (. executable value)))))
    (blank)
    (if (and is-served runs-program)
      (throw
        (call UsageError
          (block
            (arg "The build service builds with --compile or checks without -o, and runs no program")
            (arg this)
          )
        )
      )
    )
    (return-if (call list-devices) (if (. lists-devices value)))
    (return-if (call run-built-program (. built value) program-arguments chosen-device) (if (. built value)))
    (return (call check))
  )
  (fn-expr _ source-path (? String) :get
    (only-if (. source value) (if (and (not (. code value)) (not (. built value)))))
  )
  (fn-expr _ program-arguments (list String) :get
    (spread leading)
    (spread (. passed values))
    (where
      (lazy leading (list String) (if-expr (and (. source value) (not source-path)) (list (. source value)) (call (of List String))))
    )
  )
  (fn-expr _ runs-program Bool :get
    (or (. built value) (and (not stops-early) (or (. executable value) (. probes is-given))))
    (where
      (lazy stops-early (or (. compiles value) (. stops-at-object value) (. batch-path value) (. inspection value) is-listing (. explained value)))
      (lazy is-listing (or (. lists-sources value) (. lists-probes value) (. lists-devices value)))
    )
  )
  (fn-expr _ chosen-device (? String) :get
    (only-if (. device value) (if (!= (. device value) "")))
  )
  (fn-expr _ types-unreached Bool :get
    (and is-check-only (== (. inspection value) null) (not (. batch-path value)) (not (. reached-only value)))
    (where
      (lazy is-check-only (and (not (. executable value)) (not (. probes is-given))))
    )
  )
  (fn-do _ introduce Int
    (<- stdout (str usage "\n\n" about "\n\nrun `brix --help` for its options\n"))
    (return 0)
  )
  (fn-do _ show-version Int
    (print (call version-text))
    (return 0)
  )
  (fn-do _ explain Int
    (param program Program)
    (param session Session)
    (param asked String)
    (let root (call source-module program))
    (let ref
      (call explained-function program root asked
        (block
          (on-error (: error ExplainError)
            (<- stderr (str (. error message) "\n"))
            (return 1)
          )
        )
      )
    )
    (let holder ([] (. program modules) (. ref module)))
    (let read (catch? (call source-text (. holder path))))
    (print (call explain-function session root ref (?? read "")))
    (return 0)
  )
  (fn-do _ list-devices Int (?! Error)
    (let target (!! (call target-named (!! (. target-name value)))))
    (for (in record (call device-records target (/ brix-build-path "devices")))
      (print record)
    )
    (return 0)
  )
  (fn-do _ check Int (?! Error)
    (let brix BrixCompiler)
    (= (. brix modules) modules)
    (= (. brix probes) (call ProbeSelection (. probes is-given) (call (. " " join) (. probes values)) (list "__source__")))
    (= (. brix search-paths) (call module-search-paths))
    (blank)
    (let target (!! (call target-named (!! (. target-name value)))))
    (throw (call UsageError "--probes and --timeout need a target that runs on this machine" this) (if (and (or (. probes is-given) (. time-limit value)) (not (. target runs-on-host)))))
    (blank)
    (= (. brix target) target)
    (let recording
      (call chosen-c-headers brix target
        (block
          (on-error (: error Error)
            (<- stderr (str (. error message) "\n"))
            (return 1)
          )
        )
      )
    )
    (let started (call clock))
    (probe-group + compiler.phase.parse)
    (let manifest
      (call read-batch-manifest (. batch-path value)
        (block
          (on-error (: error Error)
            (<- stderr (str (. error message) "\n"))
            (return 1)
          )
        )
      )
    )
    (let program
      (call load-program brix manifest source-path (. code value)
        (block
          (on-error (: error BrixSyntaxError)
            (print (. error exception-text))
            (return diagnostic-status)
          )
          (on-error (: error Error)
            (<- stderr (str (. error message) "\n"))
            (return 1)
          )
        )
      )
    )
    (= (. program shows-ubrix) (. shows-ubrix value))
    (if recording
      (call (. recording write) (call Path (!! (. c-header-recording value)))
        (block
          (on-error (: error Error)
            (<- stderr (str (. error message) "\n"))
            (return 1)
          )
        )
      )
    )
    (if (or (. lists-sources value) (. lists-probes value))
      (for (in module (. program modules))
        (if (. lists-sources value)
          (print (. module path))
          (else
            (for (in line (call probe-lines (. module tree) (. module path)))
              (print line)
            )
          )
        )
      )
      (call (. program release))
      (return 0)
    )
    (blank)
    (probe-group - compiler.phase.parse)
    (let parse-time (call (of (. started elapsed) Microseconds)))
    (let typing-started (call clock))
    (probe-group + compiler.phase.typing)
    (let kept (?? typings (call KeptTyping)))
    (finally
      (if (not typings)
        (call (. kept release))
      )
    )
    (let session
      (call (. kept typed)
        (block
          (arg (call typing-key))
          (arg program)
          (arg (?? (. workers value) default-worker-count))
          (arg types-unreached)
        )
      )
    )
    (probe-group - compiler.phase.typing)
    (let typing-time (call (of (. typing-started elapsed) Microseconds)))
    (blank)
    (let text (call FactsText session (. brix search-paths)))
    (let reported (call (. text reported-entries) diagnostic-limit))
    (if (!= (. reported length) 0)
      (print (call (. "\n\n" join) reported))
      (return diagnostic-status)
    )
    (let asked (. explained value))
    (if asked
      (return (call explain program session asked))
    )
    (let product
      (call read-product program (. session types) target
        (block
          (on-error (: error ProductError)
            (print (. error message))
            (return diagnostic-status)
          )
        )
      )
    )
    (let inspects (!= (. inspection value) null))
    (let output
      (call output-path inspects
        (block
          (on-error (: error Error)
            (<- stderr (str (. error message) "\n"))
            (return 1)
          )
        )
      )
    )
    (if (and (not output) (not inspects))
      (return 0)
    )
    (blank)
    (let emission (call EmissionOptions))
    (= (. emission object-path) (if-expr (not output) "" (if-expr (. stops-at-object value) output (str output ".o"))))
    (= (. emission catalog-path) (if-expr (and output (not inspects)) (str output ".probes.json") ""))
    (= (. emission writes-object) (not inspects))
    (= (. emission batch-control) (. manifest control))
    (= (. emission batch-output) (. manifest output))
    (= (. emission batch-errors) (. manifest errors))
    (= (. emission batch-ids) (. manifest ids))
    (= (. emission batch-directories) (. manifest directories))
    (= (. emission dumps-ir) (or (. dumps-ir value) inspects))
    (= (. emission dumps-stages) (or (. dumps-ir value) (== (. inspection value) "ir")))
    (= (. emission warns) (. warns value))
    (= (. emission optimizes) (not (. unoptimized value)))
    (if (. workers value)
      (= (. emission worker-count) (. workers value))
    )
    (= (. emission backend-cache) lowerings)
    (= (. emission memory) emissions)
    (= (. emission verifies-reuse) (. verifies-reuse value))
    (call emit-program program (. session instances) (. session facts) (. session types) (. session bindings) emission
      (block
        (on-error (: error Error)
          (<- stderr (str (. error message) "\n"))
          (return 1)
        )
      )
    )
    (if (or inspects (. batch-path value) (. compiles value) (. stops-at-object value))
      (for (in selector (. emission unmatched-probes))
        (<- stderr (str "warning: --probes selector " selector " matched no probe sites\n"))
      )
    )
    (if (not typings)
      (call (. program release-trees))
      (call (. session release-typing))
    )
    (if (or inspects (. stops-at-object value))
      (return 0)
    )
    (let link-started (call clock))
    (probe-group + compiler.phase.link)
    (let plan
      (call link-plan program (. emission object-path) (!! output) target
        (block
          (on-error (: error Error)
            (<- stderr (str (. error message) "\n"))
            (return 1)
          )
        )
      )
    )
    (call (?. modules note-files) (. plan inputs))
    (call link-executable plan (. link-record value)
      (block
        (on-error (: error Error)
          (<- stderr (str (. error message) "\n"))
          (return 1)
        )
      )
    )
    (probe-group - compiler.phase.link)
    (if (. timings value)
      (let link-time (call (of (. link-started elapsed) Microseconds)))
      (<- stderr (str "parse " parse-time "\ntyping " typing-time "\nprogram-tables " (. emission tables-time) "\n"))
      (scope (<- stderr (str "round " (. emission round-time) "\nmerge " (. emission merge-time) "\nobject " object-time "\n"))
        (lazy object-time (. emission object-time))
      )
      (<- stderr (str "link " link-time "\ntotal " (call (of (. started elapsed) Microseconds)) "\n"))
      (if typings
        (<- stderr (str "kept " (?? (. kept refusal) "retyped") "\n"))
      )
      (if lowerings
        (<- stderr (str "reused " (. (!! lowerings) hits) " of " (+ (. (!! lowerings) hits) (. (!! lowerings) misses)) "\n"))
      )
      (if emissions
        (<- stderr (str "uninlined " (. (!! emissions) reused) "\nverified " (. (!! emissions) verified) "\n"))
      )
    )
    (if (. batch-path value)
      (return 0)
    )
    (let packaged
      (call package-program (!! output) target product (. claims-documents value)
        (block
          (on-error (: error Error)
            (<- stderr (str (. error message) "\n"))
            (return 1)
          )
        )
      )
    )
    (if (. compiles value)
      (return 0)
    )
    (let arguments program-arguments)
    (if (and (not (. probes is-given)) (not (. time-limit value)))
      (let status
        (call run-program packaged target arguments chosen-device
          (block
            (on-error (: error Error)
              (<- stderr (str (. error message) "\n"))
              (return 1)
            )
          )
        )
      )
      (return status)
    )
    (let command-arguments ([] (. packaged command) (... 1)))
    (++= command-arguments arguments)
    (let supervised (call ProbeRun ([] (. packaged command) 0) command-arguments))
    (= (. supervised timeout) (. time-limit value))
    (let traces brix-probes-path)
    (if (. probes is-given)
      (if (. trace-path value)
        (= (. supervised trace-path) (. trace-path value))
        (else
          (let chosen
            (call new-trace-path traces (. (call Path (!! output)) name)
              (block
                (on-error (: error Error)
                  (<- stderr (str (. error message) "\n"))
                  (return 1)
                )
              )
            )
          )
          (= (. supervised trace-path) (as chosen String))
        )
      )
      (= (. supervised catalog-path) (. emission catalog-path))
      (= (. supervised shows-lines) (not (. quiet-probes value)))
      (= (. supervised unmatched) (. emission unmatched-probes))
    )
    (let exit-code
      (call (. supervised run)
        (block
          (on-error (: error Error)
            (<- stderr (str (. error message) "\n"))
            (return 1)
          )
        )
      )
    )
    (if (. probes is-given)
      (catch (call write-last-run traces supervised exit-code))
    )
    (return exit-code)
  )
  (fn-do _ chosen-c-headers (? CHeaderSnapshot) (?! Error)
    (param brix BrixCompiler)
    (param target Target)
    ; Points `brix` at the snapshot --c-headers names, or at the target's headers with a recording for
    ; --record-c-headers, which it gives back to be written once the program is read.
    (throw (call UsageError "--c-headers and --record-c-headers cannot be given together" this) (if (and (. c-header-snapshot value) (. c-header-recording value))))
    (blank)
    (if (. c-header-snapshot value)
      (let snapshot (call read-c-header-snapshot (call Path (. c-header-snapshot value))))
      (throw (call Error (str snapshot-path " is a snapshot of " snapshot-target " headers, not " (. target name))) (if (!= (. snapshot target-name) (. target name))))
      (blank)
      (lazy snapshot-path (. c-header-snapshot value))
      (lazy snapshot-target (. snapshot target-name))
      (= (. brix c-headers) (call CHeaders (. target name) (. snapshot c-root) (call (of List String)) snapshot))
      (return null)
    )
    (if (not (. c-header-recording value))
      (return null)
    )
    (let headers (call target-c-headers target))
    (let recording (call CHeaderSnapshot (. target name) (. headers c-root)))
    (= (. brix c-headers) (call CHeaders (. headers target-name) (. headers c-root) (. headers arguments) null recording))
    (return recording)
  )
  (fn-do _ serve Int (?! Error)
    (let search-paths (call module-search-paths))
    (let cache (use (call ModuleCache)))
    (let view (use (call (. cache view))))
    (let store (use (call ProgramStore search-paths cache)))
    (let lowerings (use (call BackendCache)))
    (let emissions (use (call EmissionMemory)))
    (let typings (use (call KeptTyping view)))
    (let builds (call ServedBuilds name view lowerings emissions typings))
    (let daemon (call BuildDaemon (call AnalysisService store) view search-paths (. builds run)))
    (= (. daemon rest) (. builds rest))
    (return (call (. daemon serve)))
  )
  (fn-expr _ typing-key String
    (str (?? source-path "") "|" (?? (. target-name value) "") "|" (?? (. code value) "") "|" (?? (. batch-path value) "") "|" (. probes is-given) " " (call (. " " join) (. probes values)) "|" (?? (call env "BRIXPATH") "") "|" types-unreached)
  )
  (fn-do _ output-path (? String) (?! Error)
    (param inspects Bool)
    (let given (. executable value))
    (if (and given (not inspects))
      (call (?. (. (call Path given) parent) make-directories))
    )
    (return-if given (if (or given (not (. probes is-given)) inspects (. batch-path value))))
    (blank)
    (let directory brix-probes-path)
    (call (. (/ directory "bin") make-directories))
    (let base (if-expr source-path (. (call Path (!! source-path)) base-name) "program"))
    (return (as (/ directory "bin" base) String))
  )
)

(type _ ServedBuilds
  (prop + name String)
  (prop + modules ModuleView)
  (prop + lowerings BackendCache)
  (prop + emissions EmissionMemory)
  (prop + typings KeptTyping)
  (fn-do + This _
    (param name String)
    (param modules ModuleView)
    (param lowerings BackendCache)
    (param emissions EmissionMemory)
    (param typings KeptTyping)
  )
  (fn-do + run BuildResult
    (param arguments (list String))
    (let result (catch (call captured arguments)))
    (return-if (call BuildResult 1 (str (. (as result Error) message) "\n") null) (if (is result Error)))
    (return result)
  )
  (fn-do + rest _
    (call (. typings release))
    (call collect-garbage)
    (call return-free-memory)
  )
  (fn-do _ captured BuildResult (?! Error)
    (param arguments (list String))
    (let command (call CompilerCommand))
    (= (. command modules) modules)
    (= (. command lowerings) lowerings)
    (= (. command emissions) emissions)
    (= (. command typings) typings)
    (= (. command is-served) true)
    (let given (list String))
    (+= given name)
    (++= given arguments)
    (let capture (call Path (str (call temporary-root) "/brix-serve-" (call C:getpid) ".out")))
    (let file
      (call File
        (block
          (arg (as capture String))
          (arg (+ (. FileFlags write-mode) (. FileFlags create-mode) (. FileFlags truncate-mode)))
          (arg (+ user-read-perm user-write-perm))
        )
      )
    )
    (let saved-output (call C:dup 1))
    (let saved-errors (call C:dup 2))
    (call C:dup2 (. file fd) 1)
    (call C:dup2 (. file fd) 2)
    (let ran (catch (call (. command respond) given)))
    (if (and (not (is ran Error)) (== (as ran Int) 0))
      (call (. modules finish-round))
    )
    (call (. modules settle))
    (call C:dup2 saved-output 1)
    (call C:dup2 saved-errors 2)
    (call C:close saved-output)
    (call C:close saved-errors)
    (call (. file close))
    (let output (call read-file-text capture))
    (call (. capture delete))
    (probe-group + compiler.daemon.collect)
    (call collect-garbage)
    (call return-free-memory)
    (probe-group - compiler.daemon.collect)
    (probe-log compiler.daemon.memory (items: (. (call gc-memory) live) (. (call gc-memory) committed) (. (call gc-memory) footprint)))
    (return-if (call BuildResult 1 (str output (. (as ran Error) message) "\n") (. command executable value)) (if (is ran Error)))
    (return (call BuildResult ran output (. command executable value)))
  )
)

(fn-do _ run-tool (? Int)
  (param argv (list String))
  (let name (if-expr (> (. argv length) 1) ([] argv 1) ""))
  (return-if null (if (not (call some tool-names (:where (== each name))))))
  (blank)
  (let tool (as (/ toolchain-root "bin" (str "brix-" name)) String))
  (let arguments ([] String (. argv length)))
  (= ([] arguments 0) tool)
  (for (in index (..< 2 (. argv length)))
    (= ([] arguments (- index 1)) ([] argv index))
  )
  (call replace-process tool arguments)
  (<- stderr (str "brix " name " is not in this toolchain: " tool " does not run\n"))
  (return 1)
)

(fn-do _ run-init (? Int)
  (param argv (list String))
  (return-if null (if (or (< (. argv length) 2) (!= ([] argv 1) "init"))))
  (return (call (. (call InitCommand) respond) ([] argv (... 1))))
)

(fn-do _ is-selector-list Bool
  (param text String)
  (return-if false (if (or (== (. text length) 0) (call (. text starts-with) "-") (!= (call source-stem text) null))))
  (blank)
  (for (in char text)
    (let allowed
      (block
        (or (and (>= char 'a') (<= char 'z')) (and (>= char 'A') (<= char 'Z')) (and (>= char '0') (<= char '9')))
      )
    )
    (return-if false (if (and (not allowed) (!= char '.') (!= char '*') (!= char ':') (!= char ',') (!= char '-') (!= char '_') (!= char (char " ")))))
  )
  (return true)
)

(fn-do _ probe-lines (list String)
  (param tree AST)
  (param path String)
  (let lines (list String))
  (for (in id (..< 1u32 (. tree nodes length)))
    (let kind (call probe-kind tree (as id SyntaxId)))
    (if kind
      (let entry
        (call (of Map String JSON)
          (block
            (entry "key" (as (call probe-key tree (as id SyntaxId)) JSON))
            (entry "kind" (as kind JSON))
            (entry "path" (as path JSON))
            (entry "line" (as (as (+ (. ([] (. tree nodes loc) id) begin line) 1) Int) JSON))
          )
        )
      )
      (+= lines (call to-json (as entry JSON)))
    )
  )
  (return lines)
)

(fn-do _ probe-kind (? String)
  (param tree AST)
  (param id SyntaxId)
  (match? ([] (. tree nodes) id)
    (case (call .node-probe row)
      (return (if-expr (. row name) "event" "log"))
    )
    (case (call .node-probe-group row)
      (return-if null (if (. row is-end)))
      (return (if-expr (. row is-data) "data" "group"))
    )
    (case (call .node-probe-counter row)
      (return "counter")
    )
    (case (call .node-probe-assign row)
      (return "property")
    )
    (case (call .node-probe-statement row)
      (return "statement")
    )
  )
  (return null)
)

(fn-do _ probe-key String
  (param tree AST)
  (param id SyntaxId)
  (match? ([] (. tree nodes) id)
    (case (call .node-probe row)
      (return (if-expr (. row key) (. row key text) ""))
    )
    (case (call .node-probe-group row)
      (return (if-expr (. row key) (. row key text) ""))
    )
    (case (call .node-probe-counter row)
      (return (. row key text))
    )
    (case (call .node-probe-assign row)
      (return (. row key text))
    )
    (case (call .node-probe-statement row)
      (return (if-expr (. row key) (. row key text) ""))
    )
  )
  (return "")
)

(fn-do _ source-module ModuleId
  (param program Program)
  (for (in position (..< 0 (. program modules length)))
    (return-if (as position ModuleId) (if (== (. ([] (. program modules) position) name) "__source__")))
  )
  (return 0)
)

(fn-do _ source-text String (?! Error)
  (param path String)
  (let file (use (call File path)))
  (return (as file String))
)
