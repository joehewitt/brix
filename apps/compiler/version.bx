(import /data/json)
(import /lang/constants)
(import /os/file)
(import /os/path)
(import /os/process)

(fn-do + version-text String
  (let release (call release-text (/ toolchain-root "release.json")))
  (return-if release (if release))
  (return (call local-text toolchain-root))
)

(fn-do _ release-text (? String)
  (param path Path)
  (let text (catch? (call read-file-text path)))
  (return-if null (if (not text)))
  (blank)
  (let release (call JSON text))
  (let version (call json-text release "version"))
  (return-if null (if (not version)))
  (blank)
  (let commit (call json-text (call json-field release "source") "commit"))
  (return-if (str "brix " version) (if (not commit)))
  (return (str "brix " version " (" ([] commit (..< 0 12)) ")"))
)

(fn-do _ local-text String
  (param root Path)
  (let place (as root String))
  (let described (only-if (call git-output root (list "describe" "--tags" "--match" "v*" "--long" "--dirty" "--abbrev=12")) (if (. (/ root ".git") exists))))
  (return-if (str "brix unreleased build in " place) (if (not described)))
  (blank)
  (let parts (list String) (call (. described split) "-"))
  (let changed (== ([] parts (- (. parts length) 1)) "dirty"))
  (if changed
    (call (. parts pop))
  )
  (let commit ([] (call (. parts pop)) (... 1)))
  (let distance (call (. parts pop)))
  (let tag (call (. "-" join) parts))
  (let release (if-expr (call (. tag starts-with) "v") ([] tag (... 1)) tag))
  (let ahead (if-expr (== distance "0") "" (str "+" distance)))
  (let branch (call git-output root (list "rev-parse" "--abbrev-ref" "HEAD")))
  (let source (if-expr (and branch (!= branch "HEAD")) (str branch " at " commit) commit))
  (let state (if-expr changed ", uncommitted changes" ""))
  (return (str "brix " release ahead " local build (" source state ") in " place))
)

(fn-do _ git-output (? String)
  (param root Path)
  (param arguments (list String))
  (let process (catch? (call Process "git" (. ProcessStderr discard) arguments (as root String))))
  (return-if null (if (not process)))
  (blank)
  (let output (as process String))
  (let status (?? (call (. process wait) null) 1))
  (call (. process close))
  (let text (call (. output trim)))
  (return (only-if text (if (and (== status 0) (!= text "")))))
)

(fn-expr _ json-field (? JSON)
  (param value (? JSON))
  (param name String)
  (case? (or (not value) (is-not value (map String JSON)))
    null
  )
  (default
    ([] (as value (map String JSON)) name)
  )
)

(fn-expr _ json-text (? String)
  (param value (? JSON))
  (param name String)
  (case? (or (not field) (is-not field String))
    null
  )
  (default
    (as field String)
  )
  (where
    (lazy field (call json-field value name))
  )
)
