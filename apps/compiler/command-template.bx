(import /data/json)
(import /os/env)
(import /os/path)
(import /stream/sort)

(type + TargetVariable (is Tuple)
  (prop + name String)
  (prop + value (? String))
)

(type + TargetStep (is Tuple)
  (prop + arguments (list String))
  (prop + variables (map String String))
)

(fn-do + target-arguments (list String) (?! Error)
  (param reader JSONReader)
  (let arguments (list String))
  (for (in item (call (. reader items)))
    (+= arguments (call (. item string)))
  )
  (throw (call Error (str (. reader label) " must name a program")) (if (== (. arguments length) 0)))
  (return arguments)
)

(fn-do + target-variables (list TargetVariable) (?! Error)
  (param reader JSONReader)
  (let variables (list TargetVariable))
  (for (in (tuple name value) (. (call (. reader object)) fields))
    (if (is value Null)
      (+= variables (call TargetVariable name null))
      (else
        (+= variables (call TargetVariable name (call (. (call JSONReader (str (. reader label) "." name) value) string))))
      )
    )
  )
  (return variables)
)

(fn-do + apply-variables _ (?! Error)
  (param environment (map String String))
  (param variables (list TargetVariable))
  (param values (map String String))
  (for (in variable variables)
    (let value (. variable value))
    (if value
      (= ([] environment (. variable name)) (call resolve-path (call expand value values) (!! ([] values "root"))))
      (else
        (-= ([] environment (. variable name)))
      )
    )
  )
)

(fn-expr + expand-arguments (list String) (?! Error)
  (param arguments (list String))
  (param values (map String String))
  (in (call resolve-path (call expand each values) (!! ([] values "root"))) arguments)
)

(fn-expr + expand-path String (?! Error)
  (param text String)
  (param values (map String String))
  (call resolve-path (call expand text values) (!! ([] values "root")))
)

(fn-do _ expand String (?! Error)
  (param text String)
  (param values (map String String))
  (let result "")
  (let index I32)
  (while true
    (let start (call (. text find) "\${" (as index Int)))
    (if (== start null)
      (break)
    )
    (let finish (call (. text find) "}" (as (+ start 2) Int)))
    (throw (call Error (str "Unclosed variable in " text)) (if (== finish null)))
    (blank)
    (let name ([] text (..< (+ start 2) finish)))
    (let value ([] values name))
    (throw (call Error (str "Unknown variable " name " in " text)) (if (== value null)))
    (blank)
    (= result (str result ([] text (..< index start)) value))
    (= index (+ finish 1))
  )
  (return (str result ([] text (... index))))
)

(fn-expr _ resolve-path String
  (param text String)
  (param root String)
  (case? (call (. text starts-with) "./")
    (str root "/" ([] text (... 2)))
  )
  (case? (call (. text starts-with) "~/")
    (str (?? (call env "HOME") "") "/" ([] text (... 2)))
  )
  (default
    text
  )
)

(type + NestedConfig (is Tuple)
  (prop + folder String)
  (prop + parent String)
  (prop + label String)
)

(fn-do + nested-configs (list NestedConfig) (?! Error)
  (param root String)
  (param name String)
  (let found (list NestedConfig))
  (call collect-nested-configs root root "" name found)
  (return found)
)

(fn-do _ collect-nested-configs _ (?! Error)
  (param directory String)
  (param parent String)
  (param prefix String)
  (param name String)
  (param found (list NestedConfig))
  (let names (list String)
    (case-each (in child (. (call Path directory) contents) (when (call is-config-folder child)))
      (. child name)
    )
  )
  (for (in base (call sort names))
    (let folder (str directory "/" base))
    (let relative (str prefix base))
    (let holds (. (call Path (str folder "/" name)) is-file))
    (if holds
      (+= found (call NestedConfig folder parent (str relative "/" name)))
    )
    (call collect-nested-configs folder (if-expr holds folder parent) (str relative "/") name found)
  )
)

(fn-expr _ is-config-folder Bool
  (param path Path)
  (and (. path is-dir) (not (. path is-link)) (not (call (. path name starts-with) ".")))
)

(fn-expr + config-places String
  (param first (? String))
  (param second String)
  (if-expr (or (== first null) (== first second)) second (str first " and " second))
)

(fn-expr + rebased-path String
  (param text String)
  (param folder (? String))
  (case? (== folder null)
    text
  )
  (case? (== text ".")
    folder
  )
  (case? (call (. text starts-with) "./")
    (str folder "/" ([] text (... 2)))
  )
  (case? (call (. text starts-with) "../")
    (str folder "/" text)
  )
  (default
    text
  )
)

(fn-expr + rebased-paths (list String)
  (param texts (list String))
  (param folder (? String))
  (in (call rebased-path each folder) texts)
)

(fn-expr + rebased-variables (list TargetVariable)
  (param variables (list TargetVariable))
  (param folder (? String))
  (in (call TargetVariable (. each name) (only-if (call rebased-path (. each value) folder) (if (!= (. each value) null)))) variables)
)
