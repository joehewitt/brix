(import /lang/build-service)
(import /os/env)
(import /os/file)
(import /os/path)
(import /os/pty)
(import /os/shell)
(import /os/terminal)
(import /probes/feed)
(import /probes/model)
(blank)
(prop _ runner-note-style _ (= "\x1b[2m"))
(prop _ runner-error-style _ (= "\x1b[31m"))
(prop _ runner-style-reset _ (= "\x1b[0m"))
(prop _ runner-installer-url _ (= "https://brix-lang.com/install.py"))

(type + RunState (is Union)
  (variant idle)
  (variant compiling)
  (variant running)
  (variant installing)
  (variant stopping)
  (variant stopped)
  (variant exited)
  (variant installed)
  (variant failed)
)

(type + RunToolchain (is Tuple)
  (prop + root String)
  (prop + compiler String)
  (prop + command BuildServiceCommand)
)

(type + Runner
  (implements Closable)
  (prop + session TerminalSession)
  (prop + state _ (= (. RunState idle)))
  (prop + exit-code (? Int))
  (prop + source (? Path))
  (prop + feed (? ProbeFeed))
  (prop + has-toolchain _ (= false))
  (event + toolchain-installed Bool)
  (blank)
  (prop _ service (? BuildService))
  (prop _ is-stop-requested _ (= false))
  (prop _ is-serving _ (= false))
  (prop _ is-closed _ (= false))
  (fn-do + This _
    (lazy session (call TerminalSession (?? (call env "HOME") "/")))
    (= has-toolchain (call runner-finds-toolchain))
  )
  (fn-expr + is-busy Bool :get
    (call runner-is-busy state)
  )
  (fn-do + start _
    (param path Path)
    (param directory Path)
    (return-if (if (or is-busy is-closed)))
    (= source path)
    (= feed null)
    (= exit-code null)
    (= is-stop-requested false)
    (= (. session directory) (str directory))
    (call (. session clear))
    (= state (. RunState compiling))
    (do-new
      (call perform path)
    )
  )
  (fn-do + install-toolchain _
    (return-if (if (or is-busy is-closed)))
    (= source null)
    (= feed null)
    (= exit-code null)
    (= is-stop-requested false)
    (call (. session clear))
    (= state (. RunState installing))
    (do-new
      (call perform-install)
    )
  )
  (fn-do + stop _
    (return-if (if (or (not is-busy) (== state (. RunState stopping)))))
    (= is-stop-requested true)
    (= state (. RunState stopping))
    (if is-serving
      (call (?. service cancel))
    )
    (call (. session interrupt))
  )
  (fn-do + close _
    (= is-closed true)
    (= is-stop-requested true)
    (call (?. service close))
    (call (. session close))
  )
  (fn-do _ perform _
    (param path Path)
    (call execute path
      (block
        (on-error (: error Error)
          (call fail (. error message))
        )
      )
    )
  )
  (fn-do _ perform-install _
    (call install
      (block
        (on-error (: error Error)
          (call fail (. error message))
        )
      )
    )
  )
  (fn-do _ install _ (?! Error)
    (call await-login-shell-environment)
    (let variables (call terminal-environment))
    (let tools (call (. session execute) "/usr/bin/xcode-select" (list "--print-path") variables))
    (if (or (== tools null) is-stop-requested)
      (call halt)
      (return)
    )
    (if (!= tools 0)
      (let ignored (call (. session execute) "/usr/bin/xcode-select" (list "--install") variables))
      (call note
        (block
          (arg
            (paragraph
              "Brix needs Apple’s Command Line Tools to build programs. Install them in the window macOS opened, then choose Install Brix Toolchain again."
            )
          )
        )
      )
      (= state (. RunState idle))
      (return)
    )
    (let caches (call runner-caches))
    (call (. caches make-directories))
    (let script (/ caches "install.py"))
    (call note (str "Downloading " runner-installer-url))
    (let fetched
      (call (. session execute)
        (block
          (arg "/usr/bin/curl")
          (arg
            (call List
              (block
                (item "--fail")
                (item "--silent")
                (item "--show-error")
                (item "--location")
                (item "--output")
                (item (str script))
                (item runner-installer-url)
              )
            )
          )
          (arg variables)
        )
      )
    )
    (if (or (== fetched null) is-stop-requested)
      (call halt)
      (return)
    )
    (if (!= fetched 0)
      (= exit-code fetched)
      (call fail "Downloading the installer failed")
      (return)
    )
    (let code (call (. session execute) "/usr/bin/python3" (list (str script) "--yes" "--no-modify-path") variables))
    (if (or (== code null) is-stop-requested)
      (call halt)
      (return)
    )
    (= exit-code code)
    (if (!= code 0)
      (call fail "Installing the Brix toolchain failed")
      (return)
    )
    (= has-toolchain (call runner-finds-toolchain))
    (= state (. RunState installed))
    (<- toolchain-installed true)
  )
  (fn-do _ execute _ (?! Error)
    (param path Path)
    (call await-login-shell-environment)
    (if (call runner-runs-brix path)
      (call execute-brix path)
      (return)
    )
    (let command (call script-command path))
    (throw (call Error (str "Brix Editor does not know how to run " (. path name))) (if (not command)))
    (= state (. RunState running))
    (call note (str "Running " (. path name)))
    (call finish (call (. session execute) ([] command 0) ([] command (... 1)) (call terminal-environment)))
  )
  (fn-do _ execute-brix _ (?! Error)
    (param path Path)
    (let toolchain (call find-toolchain path))
    (let artifact (call runner-artifact path))
    (let folder (. artifact parent))
    (if folder
      (call (. folder make-directories))
    )
    (let trace (call Path (str artifact ".trace") 0))
    (if (. trace exists)
      (call (. trace delete))
    )
    (if is-stop-requested
      (call halt)
      (return)
    )
    (call note (str "Compiling " (. path name)))
    (let compiled (call compile toolchain path artifact))
    (if (or (== compiled null) is-stop-requested)
      (call halt)
      (return)
    )
    (if (!= compiled 0)
      (= exit-code compiled)
      (call fail (str "Compiling " (. path name) " failed"))
      (return)
    )
    (let origin (call TraceSource))
    (= (. origin trace) (str trace))
    (= (. origin catalog) (str artifact ".probes.json"))
    (= (. origin program) (str path))
    (let recorder (call ProbeFeed origin))
    (= feed recorder)
    (= state (. RunState running))
    (call note (str "Running " (. path name)))
    (do-new
      (inline (call (. recorder follow)))
    )
    (let variables (call terminal-environment))
    (= ([] variables "PROBES_ENABLED") "1")
    (= ([] variables "PROBES_PATH") (str trace))
    (let code (call (. session execute) (. toolchain compiler) (list "--run" (str artifact) "--") variables))
    (call (. recorder finish) code)
    (call finish code)
  )
  (fn-do _ compile (? Int) (?! Error)
    (param toolchain RunToolchain)
    (param path Path)
    (param artifact Path)
    (let arguments (list (str path) "--compile" "-o" (str artifact) "--probes"))
    (let built (call service-for toolchain))
    (= is-serving true)
    (let outcome (call (. built build) (. toolchain command) arguments))
    (= is-serving false)
    (if outcome
      (if (> (. outcome output length) 0)
        (call (. session echo) (call (. "\r\n" join) (call (. outcome output split) "\n")))
      )
      (return (. outcome status))
    )
    (return-if null (if is-stop-requested))
    (return (call (. session execute) (. toolchain compiler) arguments (. toolchain command variables)))
  )
  (fn-do _ service-for BuildService
    (param toolchain RunToolchain)
    (let current service)
    (return-if current (if (and current (== (. current root) (. toolchain root)))))
    (call (?. current close))
    (let made (call BuildService (. toolchain root)))
    (= service made)
    (return made)
  )
  (fn-do _ find-toolchain RunToolchain (?! Error)
    (param path Path)
    (let checkout (call find-brix-checkout (?? (. path parent) path)))
    (if checkout
      (call note (str "Updating the compiler in " checkout))
      (let command (call checkout-service-command checkout (list (/ checkout "stdlib"))))
      (return (call RunToolchain (str checkout) ([] (. command arguments) 0) command))
    )
    (let variables (call terminal-environment))
    (let compiler (call installed-compiler variables))
    (= has-toolchain (!= compiler null))
    (if (not compiler)
      (throw
        (call Error
          (block
            (arg
              (paragraph
                "Running a Brix program needs the Brix toolchain. Choose Install Brix Toolchain from the Run menu, then run again."
              )
            )
          )
        )
      )
    )
    (return
      (call RunToolchain
        (block
          (arg (?? ([] variables "HOME") "/"))
          (arg compiler)
          (arg (call BuildServiceCommand (list compiler "--serve") variables))
        )
      )
    )
  )
  (fn-do _ halt _
    (= state (. RunState stopped))
    (call note "Stopped")
  )
  (fn-do _ finish _
    (param code (? Int))
    (if (or (== code null) is-stop-requested)
      (call halt)
      (return)
    )
    (= exit-code code)
    (= state (. RunState exited))
    (call note (str "Exited with code " code))
  )
  (fn-do _ fail _
    (param text String)
    (= state (. RunState failed))
    (return-if (if is-closed))
    (call (. session echo-line) (str runner-error-style text runner-style-reset))
  )
  (fn-do _ note _
    (param text String)
    (return-if (if is-closed))
    (call (. session echo-line) (str runner-note-style text runner-style-reset))
  )
)

(fn-expr + runner-runs-brix Bool
  (param path Path)
  (== (. path extension) "bx")
)

(fn-expr + runner-can-run Bool
  (param path Path)
  (param text String)
  (or (call runner-runs-brix path) (call (. text starts-with) "#!") (!= (call runner-interpreter (. path extension) "") null))
)

(fn-expr + runner-is-busy Bool
  (param state RunState)
  (or (== state (. RunState compiling)) (== state (. RunState running)) (== state (. RunState installing)) (== state (. RunState stopping)))
)

(fn-expr + runner-status String
  (param state RunState)
  (param exit-code (? Int))
  (match state
    (case .idle
      ""
    )
    (case .compiling
      "Compiling…"
    )
    (case .running
      "Running"
    )
    (case .installing
      "Installing the Brix toolchain…"
    )
    (case .stopping
      "Stopping…"
    )
    (case .stopped
      "Stopped"
    )
    (case .exited
      (str "Exited (" (?? exit-code 0) ")")
    )
    (case .installed
      "Installed the Brix toolchain"
    )
    (case .failed
      "Failed"
    )
  )
)

(fn-expr _ runner-interpreter (? (list String))
  (param extension String)
  (param source String)
  (case? (== extension "py")
    (list "python3" source)
  )
  (case? (or (== extension "js") (== extension "mjs") (== extension "cjs"))
    (list "node" source)
  )
  (case? (== extension "sh")
    (list "/bin/sh" source)
  )
  (case? (or (== extension "bash") (== extension "zsh"))
    (list extension source)
  )
  (case? (== extension "go")
    (list "go" "run" source)
  )
  (case? (== extension "rb")
    (list "ruby" source)
  )
  (default
    null
  )
)

(fn-do _ script-command (? (list String)) (?! Error)
  (param path Path)
  (let text (call read-file-text path))
  (let ending (call (. text find) "\n"))
  (let first (if-expr ending ([] text (... _ ending)) text))
  (if (call (. first starts-with) "#!")
    (let parts (call (of List String) (in each (call (. ([] first (... 2)) split) " ") (when (> (. each length) 0)))))
    (if (> (. parts length) 0)
      (+= parts (str path))
      (return parts)
    )
  )
  (return (call runner-interpreter (. path extension) (str path)))
)

(fn-do _ runner-artifact Path
  (param source Path)
  (let caches (/ (call runner-caches) "builds"))
  (let folder (. source parent))
  (return (/ (call Path (str caches (?? folder (call Path "/" 0))) 0) (. source base-name)))
)

(fn-expr _ runner-caches Path
  (/ (call Path (?? (call env "HOME") "/tmp") 0) "Library" "Caches" "com.brix-lang.editor")
)

(fn-do _ runner-finds-toolchain Bool
  (return (!= (call installed-compiler (call terminal-environment)) null))
)

(fn-do _ installed-compiler (? String)
  (param variables (map String String))
  (let home (?? ([] variables "BRIX_HOME") (str (?? ([] variables "HOME") "") "/.brix")))
  (let installed (str home "/bin/brix"))
  (return-if installed (if (. (call Path installed 0) is-file)))
  (return (call find-executable "brix" variables))
)
