./editor-document
./editor-theme
/graphics/primitives
/gui
/gui/code-editor
/gui/source-editor

━━━━━━━━━━━━━━━━━━━━
+ CodePane is Box
    using EditorTheme

+ document EditorDocument
+ find-options FindOptions
+ blurs-scrolling = false
+ chrome-height Length = 0

_ is-presented = false
_ bars-height Length

────────────────────

<This • flex-col
    <CodeEditor editor • flex:1
        focus-default = true
        blurs-scrolling = #blurs-scrolling
        top-inset = #chrome-height + #bars-height
    <Box • editor-pill
        if editor.#is-parsing
            <Label • status-item
                text = "Parsing…"
        else if editor.#has-parse-error
            <Label • status-warning
                text = "Syntax errors"
        if document.#status
            <Label • status-warning
                text = document.#status
        <Label • status-item
            text = "Ln ${editor.#caret-line + 1}, Col ${editor.#caret-column + 1}"
        <Label • status-item
            text = editor.#language-title
    <PaneBars bars • pane-bars
        top = PositionOffset.coord(#chrome-height)
        if document.#code?.#is-missing ?? false
            <Box • editor-banner
                <Label • flex:1
                    text = "This file was deleted. Saving recreates it."
        else if document.#code?.#is-changed-on-disk ?? false
            <Box • editor-banner
                <Label • flex:1
                    text = "This file changed on disk. Your unsaved edits are kept."
                <Button "Reload"
                    action = => do document.revert()
        <FindBar find-bar
            options = find-options

────────────────────
for covered on bars.resized

bars-height = covered

────────────────────
whenever document.#code?.#session

present()

────────────────────
whenever document.#jump

take-jump()

────────────────────
whenever editor.#text-revision

find-bar.follow()

────────────────────
whenever document.#code?.#is-modified

document.note-modified(document.code?.is-modified ?? false)

────────────────────
for action on document.find-requested

pane-find(find-bar, action)

────────────────────
for action on document.fold-requested

do match action
    | .fold
        editor.fold()
    | .unfold
        editor.unfold()
    | .fold-all
        editor.fold-all()
    | .unfold-all
        editor.unfold-all()

────────────────────
for active on editor.save-requested

document.save-requested <- document

────────────────────
+ do mounted

super.mounted()
find-bar.target = editor
present()
editor.request-focus()

────────────────────
+ do unmounted

if is-presented
    document.scroll = editor.text-scroll
super.unmounted()

────────────────────
_ do present

. active = document.code?.session
=? if !active
. scroll = if is-presented then editor.text-scroll else document.scroll
is-presented = true
editor.show(active, scroll)
find-bar.reset()
take-jump()

────────────────────
_ do take-jump

. found = document.jump
. active = document.code?.session
=? if !found || !active || !is-presented
document.jump = null
editor.jump-to(found.line, (found.column ?? 0) as Float)
editor.request-focus()

━━━━━━━━━━━━━━━━━━━━
+ BrixPane is Box
    using EditorTheme

+ document EditorDocument
+ find-options FindOptions
+ shows-forms = false
+ blurs-scrolling = false
+ chrome-height Length = 0

_ is-presented = false
_ bars-height Length

────────────────────

<This • flex-row
    <Box • flex-col flex:1
        <SourceEditor editor • flex:1
            focus-default = true
            blurs-scrolling = #blurs-scrolling
            top-inset = #chrome-height + #bars-height
        <Box • editor-pill
            if document.#status
                <Label • status-warning
                    text = document.#status
            <Label • status-item
                text = "Ln ${editor.#caret-row + 1}, Col ${editor.#caret-column + 1}"
            <Label • status-item
                text = "Brix"
    <SourceListingPane listing • flex:1
        display = if #shows-forms then Display.visible else Display.hidden
        is-active = #shows-forms
        session = editor.#session
        stamp = editor.#stamp
        top-inset = #chrome-height + #bars-height
    <PaneBars bars • pane-bars
        top = PositionOffset.coord(#chrome-height)
        if document.#brix?.#is-missing ?? false
            <Box • editor-banner
                <Label • flex:1
                    text = "This file was deleted. Saving recreates it."
        else if document.#brix?.#is-changed-on-disk ?? false
            <Box • editor-banner
                <Label • flex:1
                    text = "This file changed on disk. Your unsaved edits are kept."
                <Button "Reload"
                    action = => do document.revert()
        <FindBar find-bar
            options = find-options

────────────────────
for covered on bars.resized

bars-height = covered

────────────────────
whenever document.#brix?.#session

present()

────────────────────
whenever document.#jump

take-jump()

────────────────────
whenever editor.#stamp

find-bar.follow()

────────────────────
whenever document.#is-modified

editor.is-modified = document.is-modified

────────────────────
for action on document.find-requested

pane-find(find-bar, action)

────────────────────
for action on document.fold-requested

do match action
    | .fold
        editor.fold()
    | .unfold
        editor.unfold()
    | .fold-all
        editor.fold-all()
    | .unfold-all
        editor.unfold-all()

────────────────────
for row on listing.row-picked

editor.jump-to(row, 0)
editor.request-focus()

────────────────────
for modified on editor.modified-changed

document.note-modified(modified)

────────────────────
for active on editor.save-requested

document.save-requested <- document

────────────────────
+ do mounted

super.mounted()
find-bar.target = editor
present()
editor.request-focus()

────────────────────
+ do unmounted

if is-presented
    document.scroll = editor.text-scroll
document.brix?.session.document.shed()
super.unmounted()

────────────────────
_ do present

. active = document.brix?.session
=? if !active
. scroll = if is-presented then editor.text-scroll else document.scroll
is-presented = true
editor.resume(active, scroll)
find-bar.reset()
take-jump()

────────────────────
_ do take-jump

. found = document.jump
. active = document.brix?.session
=? if !found || !active || !is-presented
document.jump = null
. row = active.document.row-of-line(found.line) ?? found.line
editor.jump-to(row, found.column ?? 0)
editor.request-focus()

━━━━━━━━━━━━━━━━━━━━
+ DocumentPane is Box
    using EditorTheme

+ document EditorDocument
+ find-options FindOptions
+ shows-forms = false
+ blurs-scrolling = false
+ chrome-height Length = 0

────────────────────

<This • flex-col
    if document.is-brix
        <BrixPane • flex:1
            document = document
            find-options = find-options
            shows-forms = #shows-forms
            blurs-scrolling = #blurs-scrolling
            chrome-height = #chrome-height
    else
        <CodePane • flex:1
            document = document
            find-options = find-options
            blurs-scrolling = #blurs-scrolling
            chrome-height = #chrome-height

━━━━━━━━━━━━━━━━━━━━
+ PaneBars is Box

+ event resized Length

_ reported Length

────────────────────
+ do did-layout

super.did-layout()
if height != reported
    reported = height
    resized <- height

━━━━━━━━━━━━━━━━━━━━
_ do pane-find
    - bar FindBar
    - action FindAction

do match action
    | .find
        bar.open(false)
    | .replace
        bar.open(true)
    | .next
        bar.step(true)
    | .previous
        bar.step(false)
    | .selection
        bar.use-selection()
