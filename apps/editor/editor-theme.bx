(import /graphics/color)
(import /graphics/outline)
(import /graphics/point)
(import /graphics/primitives)
(import /graphics/text)
(import /gui)
(import /units)

(style EditorTheme
  (using GUIDefaultTheme)
  (using GUIMotionTheme)
  (using GUIMetrics)
  (prop + editor-banner-color RGBA (= (call RGBA "#3b2e14")))
  (prop + editor-warning-color RGBA (= (call RGBA "#d29922")))
  (prop + editor-document-color RGBA (= (call RGBA "#1e1e20")))
  (blank)
  (style-domains editor-banner-color (domain paint))
  (style-domains editor-warning-color (domain paint))
  (style-domains editor-document-color (domain paint))
  (blank)
  (rule placeholder (• text gui-muted-text-color) (• p 24))
  (blank)
  (rule editor-banner (• flex-row) (• items-center) (• h 34) (• px 12) (• py 4) (• bg editor-banner-color))
  (blank)
  (rule editor-pill (• flex-row) (• items-center) (• absolute) (• px 10) (• py 3) (• text gui-muted-text-color)
    (= anchor (. Anchor parent))
    (= right (call (. PositionOffset coord) 12))
    (= bottom (call (. PositionOffset coord) 10))
    (= gap 12)
    (= background-color gui-window-color)
    (= border-color gui-border-color)
    (= border-width 1)
    (= corner-radius 12)
    (= shadow (call Shadow gui-shadow-color 6 0 2))
    (= font-size 11)
  )
  (blank)
  (rule pane-bars (• flex-col) (• absolute)
    (= anchor (. Anchor parent))
    (= left (call (. PositionOffset coord) 0))
    (= right (call (. PositionOffset coord) 0))
  )
  (blank)
  (rule status-item (• text gui-muted-text-color))
  (blank)
  (rule status-warning (• text editor-warning-color))
  (blank)
  (rule document-column (• flex-col) (• flex 1) (• bg editor-document-color))
)

(style EditorLightTheme (is EditorTheme) (for light)
  (prop + editor-banner-color _ (= (call RGBA "#fff8c5")))
  (prop + editor-warning-color _ (= (call RGBA "#9a6700")))
  (prop + editor-document-color _ (= (call RGBA "#ffffff")))
)
