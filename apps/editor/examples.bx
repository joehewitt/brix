(import /data/json)
(import /os/env)
(import /os/file)
(import /os/file-tree)
(import /os/path)
(import /ui/app-state)
(blank)
(prop _ examples-key _ (= "examples"))
(prop _ examples-version _ (= 1))
(prop _ examples-folder-name _ (= "Brix Examples"))

(type + BundledExamples
  (prop + state AppState)
  (prop + toolchain (? Path))
  (prop + folder Path)
  (fn-do + This _
    (param state _)
    (param toolchain _)
    (= folder (/ (. state path dir) examples-folder-name))
  )
  (fn-do + install (? Path) (?! Error)
    (return-if folder (if (. folder exists)))
    (blank)
    (let source (call examples-source))
    (return-if null (if (not source)))
    (blank)
    (let staged (call stage source))
    (call (. staged move) folder)
    (call record (call release-version))
    (return folder)
  )
  (fn-do + update (? Path) (?! Error)
    (return-if null (if (not (. folder exists))))
    (blank)
    (let source (call examples-source))
    (return-if null (if (not source)))
    (blank)
    (let version (call release-version))
    (return-if null (if (== (call recorded "version") version)))
    (blank)
    (let staged (call stage source))
    (let kept (? Path) null)
    (if (== (call recorded "fingerprint") (call fingerprint))
      (call delete-tree folder (. PathKind directory))
      (else
        (= kept (call set-aside))
      )
    )
    (call (. staged move) folder)
    (call record version)
    (return kept)
  )
  (fn-do _ examples-source (? Path)
    (return-if null (if (not toolchain)))
    (blank)
    (let source (/ toolchain "examples"))
    (return (only-if source (if (. source is-dir))))
  )
  (fn-do _ release-version (? String)
    (return-if null (if (not toolchain)))
    (blank)
    (let text (catch? (call read-file-text (/ toolchain "release.json"))))
    (return-if null (if (not text)))
    (blank)
    (let parsed (catch? (call parse-json text)))
    (return-if null (if (not parsed)))
    (blank)
    (let fields (catch? (call (. (call JSONReader "release.json" parsed) object))))
    (return-if null (if (not fields)))
    (return (catch? (call (. ([] fields "version") string))))
  )
  (fn-do _ recorded (? String)
    (param field String)
    (let saved (call (. state read) examples-key examples-version))
    (return-if null (if (not saved)))
    (blank)
    (let fields (catch? (call (. (call JSONReader examples-key saved) object))))
    (return-if null (if (not fields)))
    (return (catch? (call (. ([] fields field) string))))
  )
  (fn-do _ record _ (?! Error)
    (param version (? String))
    (let fields
      (call (of Map String JSON)
        (block
          (entry? "version" version)
          (entry "fingerprint" (call fingerprint))
        )
      )
    )
    (call (. state write) examples-key examples-version fields)
    (call (. state flush))
  )
  (fn-do _ fingerprint String (?! Error)
    (let text String (as (call folder-fingerprint folder "") Hex))
    (return text)
  )
  (fn-do _ stage Path (?! Error)
    (param source Path)
    (let staged (/ (. folder dir) (str examples-folder-name ".partial")))
    (if (. staged exists)
      (call make-writable staged (. PathKind directory))
      (call delete-tree staged (. PathKind directory))
    )
    (call (. folder dir make-directories))
    (call file-tree-copy source staged)
    (call make-writable staged (. PathKind directory))
    (return staged)
  )
  (fn-do _ set-aside Path (?! Error)
    (let base (str examples-folder-name " (" (?? (call recorded "version") "old") ")"))
    (let target (/ (. folder dir) base))
    (let count 2)
    (while (. target exists)
      (= target (/ (. folder dir) (str base " " count)))
      (+= count 1)
    )
    (call (. folder move) target)
    (return target)
  )
)

(fn-do + examples-toolchain (? Path)
  (let home (?? (call env "BRIX_HOME") (str (?? (call env "HOME") "") "/.brix")))
  (let current (call Path (str home "/current") 0))
  (return (only-if current (if (. current is-dir))))
)

(fn-do _ folder-fingerprint U64 (?! Error)
  (param folder Path)
  (param relative String)
  (let total U64)
  (for (in entry (. folder entries))
    (if (not (call (. entry name starts-with) "."))
      (let path (/ folder (. entry name)))
      (let name (if-expr (== relative "") (. entry name) (str relative "/" (. entry name))))
      (if (== (. entry kind) (. PathKind directory))
        (+= total (call folder-fingerprint path name))
        (else-if (== (. entry kind) (. PathKind file))
          (+= total (call file-fingerprint path name))
        )
      )
    )
  )
  (return total)
)

(fn-do _ file-fingerprint U64 (?! Error)
  (param path Path)
  (param name String)
  (let label (as name ([] Byte)))
  (let contents (call read-file-bytes path))
  (return (call fnv-hash (. contents data) (. contents length) (call fnv-hash (. label data) (. label length))))
)

(fn-do _ make-writable _ (?! Error)
  (param path Path)
  (param kind PathKind)
  (return-if (if (and (!= kind (. PathKind directory)) (!= kind (. PathKind file)))))
  (blank)
  (call (. path change-mode) (/or/ (/and/ (as (. path mode) FilePermissions) all-rwx-perm) user-write-perm))
  (if (== kind (. PathKind directory))
    (for (in entry (. path entries))
      (call make-writable (/ path (. entry name)) (. entry kind))
    )
  )
)

(fn-do _ delete-tree _ (?! Error)
  (param path Path)
  (param kind PathKind)
  (if (== kind (. PathKind directory))
    (for (in entry (. path entries))
      (call delete-tree (/ path (. entry name)) (. entry kind))
    )
  )
  (call (. path delete))
)
