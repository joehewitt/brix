(import /code/code-document)
(import /code/structure/document)
(import /code/structure/session)
(import /lang/ubrix/ubrix)
(import /os/file)
(import /os/path)
(import /time/debounced)
(import /time/duration)
(blank)
(prop + brix-file-watch-delay _ (= 100ms))

(type + BrixFile
  (implements Closable)
  (prop + path Path)
  (prop + session SourceSession)
  (prop + is-changed-on-disk _ (= false))
  (prop + is-missing _ (= false))
  (blank)
  (prop _ disk-text String)
  (prop _ watcher (? Closable))
  (prop _ watched-path _ (= ""))
  (prop _ schedule-reload _ (:= (call throttled brix-file-watch-delay (. this reload))))
  (fn-do + This _
    (param path _)
    (param text String)
    (param document SourceDocument)
    (lazy session (call SourceSession document))
    (= disk-text text)
  )
  (fn-do + save Bool
    (if is-missing
      (catch (call (?. (. path parent) make-directories)))
    )
    (return-if false (if (not (call source-write-text session (str path)))))
    (blank)
    (= disk-text (call (. session document text)))
    (= is-changed-on-disk false)
    (= is-missing false)
    (return true)
  )
  (fn-do + reload _
    (param discards _ (= false))
    (if (not (. path exists))
      (= is-missing true)
      (return)
    )
    (= is-missing false)
    (let text (call code-read-text path))
    (if (== text null)
      (= is-changed-on-disk true)
      (return)
    )
    (if (and (not discards) (. session is-modified))
      (= is-changed-on-disk (!= text disk-text))
      (return)
    )
    (return-if (if (and (not discards) (== text disk-text))))
    (blank)
    (let read (catch (call brix-document-read text)))
    (if (is read Error)
      (= is-changed-on-disk true)
      (return)
    )
    (let next (call SourceSession (as read SourceDocument)))
    (call (. next place) (. session row) (. session column))
    (let previous session)
    (= session next)
    (= disk-text text)
    (= is-changed-on-disk false)
    (call (. previous document release))
  )
  (fn-do + watch _ (?! Error)
    (return-if (if watcher))
    (blank)
    (let resolved (?? (catch? (. path resolved)) path))
    (= watched-path (str resolved))
    (let folder (?? (. resolved parent) resolved))
    (= watcher (call listen-for-changes (as (call (. folder watch)) (of Broadcastable PathWatchEvent)) (. this note)))
  )
  (fn-do + close _
    (let stream watcher)
    (= watcher null)
    (if stream
      (call (. stream close))
    )
    (call (. session document release))
  )
  (fn-do _ note _
    (param event PathWatchEvent)
    (if (or (. event must-rescan) (== (str (. event path)) watched-path))
      (call schedule-reload)
    )
  )
)
