./editor-document
./editor-theme
./workspace
/graphics/primitives
/gui
/gui/icons/lucide/panel-bottom
/gui/icons/lucide/play
/gui/icons/lucide/square

━━━━━━━━━━━━━━━━━━━━
+ EditorToolbar is Toolbar
    using EditorTheme

+ workspace Workspace
+ can-run = false
+ is-running = false
+ shows-output = false
+ event run-requested Bool
+ event stop-requested Bool
+ event output-toggled Bool
+ event closing EditorDocument

────────────────────

<This
    <Box • w:gui-toolbar-group-height
        display = if #is-title-bar then Display.visible else Display.hidden
    <ToolbarTitle
        text = workspace.#active?.title ?? workspace.#folder?.name ?? "Brix Editor"
    <ToolbarSpace
    <ToolbarGroup
        <ToolbarButton "Run" • icon-play
            is-enabled = #can-run && !#is-running
            action = => do run-requested <- true
            <Tooltip "Run (⌘R)"
        <ToolbarButton • icon-square
            is-enabled = #is-running
            action = => do stop-requested <- true
            <Tooltip "Stop (⌘.)"
    <ToolbarGroup
        <ToolbarButton • icon-panel-bottom
            is-on = #shows-output
            action = => do output-toggled <- true
            <Tooltip "Show Output (⇧⌘Y)"
    <EditorTabBar tabs(accessory)
        workspace = workspace
        display = if workspace.tabs(workspace.#revision).length > 0 then Display.visible else Display.hidden

────────────────────
for document on tabs.closing

closing <- document

━━━━━━━━━━━━━━━━━━━━
+ EditorTabBar is TabBar'EditorDocument
    using EditorTheme

+ workspace Workspace
+ event closing EditorDocument

────────────────────

<This
    window-draggable = true
    selected = workspace.#active

    <TabStrip
        for document in workspace.tabs(workspace.#revision) keyed by document.id
            <Tab'EditorDocument
                value = document
                title = document.title
                is-modified = document.#is-modified
                for tab on dismissed
                    closing <- document

────────────────────
for event on selection-changed

workspace.activate(event.value)
