(import ./editor-document)
(import /data/json)
(import /gui/code-editor)
(import /math)
(import /os/file)
(import /os/file-session)
(import /os/file-tree)
(import /os/path)
(import /ui/app-state)
(import /ui/recents)
(blank)
(prop _ workspace-key _ (= "workspace"))
(prop _ workspace-version _ (= 1))
(prop _ recents-key _ (= "recents"))
(prop _ recents-version _ (= 1))

(type + Workspace
  (implements Closable)
  (prop + state AppState)
  (prop + find-options _ (= (call FindOptions)))
  (prop + recents _ (= (call Recents)))
  (prop + folder (? Path))
  (prop + files (? FileTree))
  (prop + file-session _ (= (call FileSession)))
  (prop + documents (list EditorDocument))
  (prop + active (? EditorDocument))
  (prop + revision U64)
  (event + failed String)
  (blank)
  (prop _ next-id U64 (= 1))
  (prop _ is-restoring _ (= false))
  (prop _ last-path (? Path))
  (fn-do + This _
    (param state _)
    (call (. find-options restore) state)
    (call restore-recents)
  )
  (fn-expr + folder-name String :get
    (?? (?. folder name) "")
  )
  (fn-expr + title String :get
    (?? (?. active title) (?. folder name) "Brix Editor")
  )
  (fn-expr + tabs (list EditorDocument)
    (param revision U64)
    (call (of List EditorDocument) documents)
    (where
      (lazy ignored revision)
    )
  )
  (fn-expr + folder-list (list Path)
    (param revision U64)
    (if-expr folder (call (of List Path) folder) (call (of List Path)))
    (where
      (lazy ignored revision)
    )
  )
  (fn-expr + active-list (list EditorDocument)
    (param revision U64)
    (if-expr active (call (of List EditorDocument) active) (call (of List EditorDocument)))
    (where
      (lazy ignored revision)
    )
  )
  (fn-expr + recent-folders (list Path)
    (param revision U64)
    (call (of List Path) (in (call Path each 0) (. recents keys)))
    (where
      (lazy ignored revision)
    )
  )
  (fn-expr + unsaved-count Size
    (param revision U64)
    (. (call (of List EditorDocument) (in each documents (when (. each is-modified)))) length)
    (where
      (lazy ignored revision)
    )
  )
  (fn-do + document-at (? EditorDocument)
    (param path Path)
    (for (in document documents)
      (return-if document (if (== (str (. document path)) (str path))))
    )
    (return null)
  )
  (fn-do + browse-folder (? Path)
    (let parent (?. last-path parent))
    (return-if parent (if (and parent (. parent exists))))
    (return folder)
  )
  (fn-do + open-folder _
    (param path Path)
    (let resolved (?? (catch? (. path resolved)) path))
    (call close-documents)
    (call (?. files close))
    (= files (call FileTree resolved))
    (= (. file-session current) null)
    (= (. file-session expanded) (call (of List String)))
    (= folder resolved)
    (= last-path null)
    (call (. recents remember) (str resolved))
    (call save-recents)
    (+= revision 1)
    (call persist)
  )
  (fn-do + remember-folder _
    (param path Path)
    (call (. recents remember) (str path))
    (call save-recents)
    (+= revision 1)
  )
  (fn-do + open-path _
    (param path Path)
    (param jump (? EditorJump) (= null))
    (let existing (call document-at path))
    (if existing
      (if jump
        (= (. existing jump) jump)
      )
      (call activate existing)
      (return)
    )
    (let opened (catch (call open-editor-document next-id path)))
    (if (is opened Error)
      (<- failed (. (as opened Error) message))
      (return)
    )
    (+= next-id 1)
    (let document (as opened EditorDocument))
    (if jump
      (= (. document jump) jump)
    )
    (+= documents document)
    (= active document)
    (call follow-active true)
    (+= revision 1)
    (call persist)
  )
  (fn-do + create-file _
    (param path Path)
    (if (not (. path exists))
      (call write-file-atomically path ""
        (block
          (on-error (: error Error)
            (<- failed (str "Unable to create " (. path name) ": " (. error message)))
            (return)
          )
        )
      )
    )
    (call open-path path)
  )
  (fn-do + activate _
    (param document EditorDocument)
    (return-if (if (== (?. active id) (. document id))))
    (= active document)
    (call follow-active false)
    (+= revision 1)
    (call persist)
  )
  (fn-do + step _
    (param offset Int)
    (return-if (if (== (. documents length) 0)))
    (let current (call index-of active))
    (let next (% (+ current offset (. documents length)) (. documents length)))
    (call activate ([] documents next))
  )
  (fn-do + close _
    (param document EditorDocument)
    (let index (call index-of document))
    (= documents (call (of List EditorDocument) (in each documents (when (!= (. each id) (. document id))))))
    (if (== (?. active id) (. document id))
      (= active (if-expr (> (. documents length) 0) ([] documents (call min index (- (. documents length) 1))) null))
      (call follow-active false)
    )
    (call (. document close))
    (+= revision 1)
    (call persist)
  )
  (fn-do + save _
    (param document EditorDocument)
    (call (. document save)
      (block
        (on-error (: error Error)
          (<- failed (. error message))
        )
      )
    )
    (+= revision 1)
  )
  (fn-do + save-all _
    (for (in document documents)
      (if (. document is-modified)
        (call save document)
      )
    )
  )
  (fn-do + revert _
    (param document EditorDocument)
    (call (. document revert))
    (+= revision 1)
  )
  (fn-do + restore _
    (let saved (call (. state read) workspace-key workspace-version))
    (return-if (if (not saved)))
    (let fields (catch? (call (. (call JSONReader workspace-key saved) object))))
    (return-if (if (not fields)))
    (= is-restoring true)
    (let folder-text (catch? (call (. ([] fields "folder") string))))
    (if folder-text
      (let path (call Path folder-text 0))
      (if (. path exists)
        (call open-folder path)
      )
    )
    (let items (catch? (call (. ([] fields "open") items))))
    (if items
      (for (in item items)
        (let text (catch? (call (. item string))))
        (if (and text (. (call Path text 0) exists))
          (call open-path (call Path text 0))
        )
      )
    )
    (let chosen (catch? (call (. ([] fields "active") string))))
    (if chosen
      (let found (call document-at (call Path chosen 0)))
      (if found
        (= active found)
      )
    )
    (call follow-active false)
    (if (not active)
      (let last-text (catch? (call (. ([] fields "last") string))))
      (if last-text
        (= last-path (call Path last-text 0))
      )
    )
    (= is-restoring false)
    (+= revision 1)
  )
  (fn-do + persist _
    (return-if (if is-restoring))
    (let open (call (of List JSON) (in (as (str (. each path)) JSON) documents)))
    (let folder-text (? String) (if-expr folder (str folder) null))
    (let active-text (? String) (if-expr active (str (. active path)) null))
    (let last-text (? String) (if-expr last-path (str last-path) null))
    (let fields
      (call (of Map String JSON)
        (block
          (entry? "folder" folder-text)
          (entry "open" (as open JSON))
          (entry? "active" active-text)
          (entry? "last" last-text)
        )
      )
    )
    (call (. state write) workspace-key workspace-version fields)
  )
  (fn-do + close _
    (call close-documents)
    (call (?. files close))
    (= files null)
  )
  (fn-do _ close-documents _
    (for (in document documents)
      (call (. document close))
    )
    (= documents (call (of List EditorDocument)))
    (= active null)
  )
  (fn-do _ follow-active _
    (param reveals Bool)
    (if active
      (= last-path (. active path))
    )
    (let node (if-expr active (call (?. files find) (. active path)) null))
    (= (. file-session current) node)
    (if (and node reveals)
      (<- (. file-session revealed) node)
    )
  )
  (fn-do _ index-of Index
    (param document (? EditorDocument))
    (return-if 0 (if (not document)))
    (for (in index (..< 0 (. documents length)))
      (return-if index (if (== (. ([] documents index) id) (. document id))))
    )
    (return 0)
  )
  (fn-do _ restore-recents _
    (let saved (call (. state read) recents-key recents-version))
    (return-if (if (not saved)))
    (let items (catch? (call (. (call JSONReader recents-key saved) items))))
    (return-if (if (not items)))
    (let keys (list String))
    (for (in item items)
      (let text (catch? (call (. item string))))
      (if text
        (+= keys text)
      )
    )
    (= (. recents keys) keys)
  )
  (fn-do _ save-recents _
    (call (. state write) recents-key recents-version (as (call (of List JSON) (in (as each JSON) (. recents keys))) JSON))
  )
)
