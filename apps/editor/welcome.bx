(import ./editor-theme)
(import ./runner)
(import ./workspace)
(import /graphics/color)
(import /graphics/primitives)
(import /graphics/text)
(import /gui)
(import /os/path)

(style-extend EditorTheme
  (rule welcome-title (• text gui-strong-text-color) (• mb 6)
    (= font-size 22)
    (= font-weight (. FontWeight semibold))
  )
  (blank)
  (rule welcome-note (• text gui-muted-text-color) (• mb 20))
  (blank)
  (rule welcome-button (• w 200) (• mb 8))
  (blank)
  (rule welcome-recent (• bg transparent) (• text gui-text-color) (• w 280) (• h 26) (• px 10)
    (= shadow null)
    (= corner-radius gui-control-radius)
    (blank)
    (when-style #is-hover-within
      (• bg gui-hover-color)
    )
  )
)

(type + WelcomeView (is Box)
  (using EditorTheme)
  (prop + workspace Workspace)
  (prop + runner Runner)
  (event + open-requested Bool)
  (event + folder-requested Path)
  (event + new-requested Bool)
  (event + install-requested Bool)
  (content
    (<> This (• flex-col) (• items-center)
      (= justify (. Justify center))
      (if (!= (. workspace #folder) null)
        (<> Label (• welcome-note)
          (= text "Open a file from the sidebar, or press ⌘P to go to one.")
        )
        (<> Button (text: "New File…") (• welcome-button)
          (= action (=> () :do (<- new-requested true)))
        )
        (else
          (<> Label (• welcome-title)
            (= text "Brix Editor")
          )
          (<> Label (• welcome-note)
            (= text "Open a folder to read, write and run its programs.")
          )
          (<> Button (text: "Open a Folder…") (• welcome-button)
            (= role (. ButtonRole default))
            (= action (=> () :do (<- open-requested true)))
          )
          (<> Button (text: "New File…") (• welcome-button)
            (= action (=> () :do (<- new-requested true)))
          )
          (if (> (. (call (. workspace recent-folders) (. workspace #revision)) length) 0)
            (<> Label (• group-heading) (• mt 24) (• mb 6)
              (= text "Recent")
            )
            (for (in path (call (. workspace recent-folders) (. workspace #revision)) (keyed-by (str path)))
              (<> Button (• welcome-recent)
                (= title (. path name))
                (= action (=> () :do (<- folder-requested path)))
                (<> Tooltip
                  (= text (str path))
                )
              )
            )
          )
        )
      )
      (if (not (. runner #has-toolchain))
        (<> Label (• welcome-note) (• mt 24) (• mb 10)
          (= text "Running programs needs the Brix toolchain.")
        )
        (<> Button (text: "Install Brix Toolchain") (• welcome-button)
          (= is-enabled (not (call runner-is-busy (. runner #state))))
          (= action (=> () :do (<- install-requested true)))
        )
      )
    )
  )
)
