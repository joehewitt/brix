(import ./editor-document)
(import ./editor-theme)
(import ./workspace)
(import /graphics/primitives)
(import /gui)
(import /gui/icons/lucide/panel-bottom)
(import /gui/icons/lucide/play)
(import /gui/icons/lucide/square)

(type + EditorToolbar (is Toolbar)
  (using EditorTheme)
  (prop + workspace Workspace)
  (prop + can-run _ (= false))
  (prop + is-running _ (= false))
  (prop + shows-output _ (= false))
  (event + run-requested Bool)
  (event + stop-requested Bool)
  (event + output-toggled Bool)
  (event + closing EditorDocument)
  (content
    (<> This
      (<> Box (• w gui-toolbar-group-height)
        (= display (if-expr #is-title-bar (. Display visible) (. Display hidden)))
      )
      (<> ToolbarTitle
        (= text (?? (?. (. workspace #active) title) (?. (. workspace #folder) name) "Brix Editor"))
      )
      (<> ToolbarSpace)
      (<> ToolbarGroup
        (<> ToolbarButton (text: "Run") (• icon-play)
          (= is-enabled (and #can-run (not #is-running)))
          (= action (=> () :do (<- run-requested true)))
          (<> Tooltip (text: "Run (⌘R)"))
        )
        (<> ToolbarButton (• icon-square)
          (= is-enabled #is-running)
          (= action (=> () :do (<- stop-requested true)))
          (<> Tooltip (text: "Stop (⌘.)"))
        )
      )
      (<> ToolbarGroup
        (<> ToolbarButton (• icon-panel-bottom)
          (= is-on #shows-output)
          (= action (=> () :do (<- output-toggled true)))
          (<> Tooltip (text: "Show Output (⇧⌘Y)"))
        )
      )
      (<> EditorTabBar (id: tabs) (slot: accessory)
        (= workspace workspace)
        (= display (if-expr (> (. (call (. workspace tabs) (. workspace #revision)) length) 0) (. Display visible) (. Display hidden)))
      )
    )
  )
  (subscribe-for (on document (. tabs closing))
    (<- closing document)
  )
)

(type + EditorTabBar (is (of TabBar EditorDocument))
  (using EditorTheme)
  (prop + workspace Workspace)
  (event + closing EditorDocument)
  (content
    (<> This
      (= window-draggable true)
      (= selected (. workspace #active))
      (blank)
      (<> TabStrip
        (for (in document (call (. workspace tabs) (. workspace #revision)) (keyed-by (. document id)))
          (<> (of Tab EditorDocument)
            (= value document)
            (= title (. document title))
            (= is-modified (. document #is-modified))
            (for (on tab dismissed)
              (<- closing document)
            )
          )
        )
      )
    )
  )
  (subscribe-for (on event selection-changed)
    (call (. workspace activate) (. event value))
  )
)
