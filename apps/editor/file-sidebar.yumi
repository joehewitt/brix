./editor-theme
./workspace
/graphics/primitives
/gui
/gui/file-browsing

━━━━━━━━━━━━━━━━━━━━
+ FileSidebar is Sidebar
    using EditorTheme

+ workspace Workspace

────────────────────

<This
    resize-edge = Side.right
    state-key = "editor.files"
    <Box (header) • h:gui-toolbar-height
        window-draggable = true
    for folder in workspace.folder-list(workspace.#revision) keyed by "$folder"
        <SidebarSection • flex:1 pb:0
            title = folder.name
            <FileTreeBox • flex:1
                files = workspace.files!
                session = workspace.file-session
