(import ./editor-theme)
(import /data/json)
(import /graphics/primitives)
(import /gui)
(import /gui/desktop)
(import /math)
(import /net/http)
(import /net/url)
(import /os/file)
(import /os/path)
(import /regex)
(import /time/duration)
(import /ui/app-state)
(blank)
(prop _ updates-key _ (= "updates"))
(prop _ updates-version _ (= 1))
(prop _ updates-url _ (= "https://brix-lang.com/releases/editor/latest.json"))
(prop _ updates-interval _ (= 86400))

(style-extend EditorTheme
  (rule update-bar (• flex-row) (• items-center) (• h 38) (• px 12) (• bg editor-document-color)
    (= border-color gui-divider-color)
    (= border-width 0)
    (= border-top-width 1)
  )
  (blank)
  (rule update-text (• flex 1) (• text gui-text-color))
)

(type + EditorRelease (is Tuple)
  (prop + version String)
  (prop + page String)
  (prop + minimum-system (? String))
)

(type + EditorUpdates
  (implements Closable)
  (prop + state AppState)
  (prop + version (? String))
  (prop + available (? EditorRelease))
  (event + reported String)
  (blank)
  (prop _ is-closed _ (= false))
  (fn-do + This _
    (param state _)
    (= version (call editor-version))
  )
  (fn-do + start _
    (return-if (if (not version)))
    (do-new
      (call watch)
    )
  )
  (fn-do + check-now _
    (do-new
      (call check true)
    )
  )
  (fn-do + download _
    (let shown available)
    (return-if (if (not shown)))
    (let ignored (call open-url (. shown page)))
  )
  (fn-do + dismiss _
    (let shown available)
    (return-if (if (not shown)))
    (= available null)
    (let fields
      (call (of Map String JSON)
        (block
          (entry "dismissed" (. shown version))
        )
      )
    )
    (call (. state write) updates-key updates-version fields)
    (call (. state flush))
  )
  (fn-do + close _
    (= is-closed true)
  )
  (fn-do _ watch _
    (while (not is-closed)
      (call check false)
      (call (. (as updates-interval Seconds) wait))
    )
  )
  (fn-do _ check _
    (param is-asked Bool)
    (let current version)
    (if (not current)
      (if is-asked
        (<- reported "This build of Brix Editor has no version, so it cannot check for updates.")
      )
      (return)
    )
    (let fetched (catch (call fetch-editor-release)))
    (if (is fetched Error)
      (if is-asked
        (<- reported (str "Unable to check for updates: " (. (as fetched Error) message)))
      )
      (return)
    )
    (let release (as fetched (? EditorRelease)))
    (if (not release)
      (if is-asked
        (<- reported (str "Brix Editor " current " is the latest version."))
      )
      (return)
    )
    (if (or (not (call editor-version-is-newer (. release version) current)) (not (call editor-runs-on (. release minimum-system))))
      (if is-asked
        (<- reported (str "Brix Editor " current " is the latest version."))
      )
      (return)
    )
    (if (and (not is-asked) (== (call dismissed) (. release version)))
      (return)
    )
    (= available release)
  )
  (fn-do _ dismissed (? String)
    (let saved (call (. state read) updates-key updates-version))
    (return-if null (if (not saved)))
    (let fields (catch? (call (. (call JSONReader updates-key saved) object))))
    (return-if null (if (not fields)))
    (return (catch? (call (. ([] fields "dismissed") string))))
  )
)

(type + UpdateBar (is Box)
  (using EditorTheme)
  (prop + updates EditorUpdates)
  (prop + release EditorRelease)
  (content
    (<> This (• update-bar)
      (<> Label (• update-text)
        (= text (str "Brix Editor " (. release version) " is available."))
      )
      (<> Button (text: "Not Now") (• w 90)
        (= action (=> () :do (call (. updates dismiss))))
      )
      (<> Button (text: "Download") (• w 100) (• ml 8)
        (= role (. ButtonRole default))
        (= action (=> () :do (call (. updates download))))
      )
    )
  )
)

(fn-do _ fetch-editor-release (? EditorRelease) (?! Error)
  (let response (call http-get (call URL updates-url)))
  (return-if null (if (== (. response status) (. HTTPStatus not-found))))
  (throw (call Error (str "brix-lang.com answered " (. response status))) (if (!= (. response status) (. HTTPStatus ok))))
  (let fields (call (. (call JSONReader "latest.json" (call parse-json (. response text))) object)))
  (let minimum (catch? (call (. ([] fields "minimumSystem") string))))
  (return (call EditorRelease (call (. ([] fields "version") string)) (call (. ([] fields "page") string)) minimum))
)

(fn-do _ editor-version (? String)
  (let executable (catch? (call executable-path)))
  (return-if null (if (not executable)))
  (let contents (?. (. executable parent) parent))
  (return-if null (if (not contents)))
  (return (call plist-string (/ contents "Info.plist") "CFBundleShortVersionString"))
)

(fn-do + editor-version-is-newer Bool
  (param candidate String)
  (param current String)
  (let later (call release-numbers candidate))
  (let earlier (call release-numbers current))
  (return-if false (if (or (!= (. later length) 4) (!= (. earlier length) 4))))
  (return (call numbers-are-later later earlier))
)

(fn-do _ editor-runs-on Bool
  (param minimum (? String))
  (return-if true (if (not minimum)))
  (let system
    (call plist-string
      (block
        (arg (call Path "/System/Library/CoreServices/SystemVersion.plist" 0))
        (arg "ProductVersion")
      )
    )
  )
  (return-if true (if (not system)))
  (return (not (call numbers-are-later (call dotted-numbers minimum) (call dotted-numbers system))))
)

(fn-do _ numbers-are-later Bool
  (param later (list Int))
  (param earlier (list Int))
  (for (in index (..< 0 (call min (. later length) (. earlier length))))
    (return-if (> ([] later index) ([] earlier index)) (if (!= ([] later index) ([] earlier index))))
  )
  (return (> (. later length) (. earlier length)))
)

(fn-do _ release-numbers (list Int)
  (param version String)
  (let pattern (catch? (call Regex "^(\\d{4})\\.(\\d{2})\\.(\\d{2})-(\\d+)")))
  (return-if (call (of List Int)) (if (not pattern)))
  (let found (catch? (call (. pattern find) version)))
  (return-if (call (of List Int)) (if (or (not found) (!= (. found value) version))))
  (return (call (of List Int) (in (call Int (?? (call (. found group) each) "0")) (list 1 2 3 4))))
)

(fn-do _ dotted-numbers (list Int)
  (param text String)
  (let pattern (catch? (call Regex "^(\\d+)(?:\\.(\\d+))?(?:\\.(\\d+))?")))
  (return-if (call (of List Int)) (if (not pattern)))
  (let found (catch? (call (. pattern find) text)))
  (return-if (call (of List Int)) (if (not found)))
  (return (call (of List Int) (in (call Int (?? (call (. found group) each) "0")) (list 1 2 3))))
)

(fn-do _ plist-string (? String)
  (param path Path)
  (param key String)
  (let text (catch? (call read-file-text path)))
  (return-if null (if (not text)))
  (let pattern (catch? (call Regex (str "<key>" (call regex-escape key) "</key>\\s*<string>([^<]*)</string>"))))
  (return-if null (if (not pattern)))
  (let found (catch? (call (. pattern find) text)))
  (return-if null (if (not found)))
  (return (call (. found group) 1))
)
