(import ./editor-document)
(import ./editor-theme)
(import ./editor-toolbar)
(import ./file-sidebar)
(import ./output-panel)
(import ./panes)
(import ./runner)
(import ./updates)
(import ./welcome)
(import ./workspace)
(import /code/file-text)
(import /graphics/primitives)
(import /graphics/text)
(import /gui)
(import /gui/code-editor)
(import /gui/file-browsing)
(import /gui/icons/lucide/panel-left)
(import /os/path)

(type + EditorClosing (is Union)
  (variant document (tuple (: document EditorDocument)))
  (variant folder (tuple (: path Path)))
  (variant window)
)

(type + EditorWindow (is Window)
  (using EditorTheme)
  (prop + workspace Workspace)
  (prop + pending-close (? EditorClosing))
  (prop + shows-forms _ (= false))
  (prop + blurs-scrolling _ (= true))
  (prop + has-tabs _ (= (> (. (call (. workspace tabs) (. workspace #revision)) length) 0)))
  (prop + chrome-height _ (= (+ gui-toolbar-height (if-expr #has-tabs gui-toolbar-tab-bar-height 0))))
  (prop + is-brix-active _ (= (?? (?. (. workspace #active) is-brix) false)))
  (prop + runner _ (= (call Runner)))
  (prop + updates _ (= (call EditorUpdates (. workspace state))))
  (prop + shows-output _ (= false))
  (prop + is-running _ (= (call runner-is-busy (. runner #state))))
  (prop + can-run _ (= (?? (?. (. workspace #active) #can-run) false)))
  (blank)
  (prop _ is-close-confirmed _ (= false))
  (fn-do + This _
    (param workspace _)
    (call (. updates start))
  )
  (content
    (<> This (• flex-row)
      (= title (?? (?. (. workspace #active) title) (?. (. workspace #folder) name) "Brix Editor"))
      (= titlebar-visible false)
      (= stoplight-offset gui-toolbar-stoplight-offset)
      (= allows-zoom true)
      (= size (tuple 1180 780))
      (= state-key "editor")
      (blank)
      (<> KeyShortcut (id: new-file-shortcut) (text: "New File…")
        (= key (call KeyCombo "Cmd+N"))
        (= stable-key "editor.file.new")
        (= repeat false)
        (= action (=> () :do (call new-file)))
      )
      (<> KeyShortcut (id: open-shortcut) (text: "Open…")
        (= key (call KeyCombo "Cmd+O"))
        (= stable-key "editor.file.open")
        (= repeat false)
        (= action (=> () :do (call open-any)))
      )
      (<> KeyShortcut (id: go-to-file-shortcut) (text: "Go to File…")
        (= key (call KeyCombo "Cmd+P"))
        (= stable-key "editor.file.go")
        (= repeat false)
        (= when (=> () (!= (. workspace folder) null)))
        (= action (=> () :do (call (. palettes show-files))))
      )
      (<> KeyShortcut (id: close-tab-shortcut) (text: "Close Tab")
        (= key (call KeyCombo "Cmd+W"))
        (= stable-key "editor.document.close")
        (= repeat false)
        (= when (=> () (!= (. workspace active) null)))
        (= action (=> () :do (call close-active)))
      )
      (<> KeyShortcut (id: close-window-shortcut) (text: "Close Window")
        (= key (call KeyCombo "Cmd+Shift+W"))
        (= stable-key "editor.window.close")
        (= repeat false)
        (= action (=> () :do (call close)))
      )
      (<> KeyShortcut (id: save-shortcut) (text: "Save")
        (= key (call KeyCombo "Cmd+S"))
        (= stable-key "editor.file.save")
        (= repeat false)
        (= when (=> () (!= (. workspace active) null)))
        (= action (=> () :do (call save-active)))
      )
      (<> KeyShortcut (id: save-all-shortcut) (text: "Save All")
        (= key (call KeyCombo "Option+Cmd+S"))
        (= stable-key "editor.file.save-all")
        (= repeat false)
        (= when (=> () (> (call (. workspace unsaved-count) (. workspace revision)) 0)))
        (= action (=> () :do (call (. workspace save-all))))
      )
      (<> KeyShortcut (id: revert-shortcut) (text: "Revert to Saved")
        (= stable-key "editor.file.revert")
        (= repeat false)
        (= when (=> () (?? (?. (. workspace active) is-modified) false)))
        (= action (=> () :do (call revert-active)))
      )
      (<> KeyShortcut (id: find-shortcut) (text: "Find…")
        (= key (call KeyCombo "Cmd+F"))
        (= stable-key "brix.find.find")
        (= repeat false)
        (= when (=> () (!= (. workspace active) null)))
        (= action (=> () :do (call find (. FindAction find))))
      )
      (<> KeyShortcut (id: replace-shortcut) (text: "Find and Replace…")
        (= key (call KeyCombo "Option+Cmd+F"))
        (= stable-key "brix.find.replace")
        (= repeat false)
        (= when (=> () (!= (. workspace active) null)))
        (= action (=> () :do (call find (. FindAction replace))))
      )
      (<> KeyShortcut (id: find-next-shortcut) (text: "Find Next")
        (= key (call KeyCombo "Cmd+G"))
        (= stable-key "brix.find.next")
        (= when (=> () (!= (. workspace active) null)))
        (= action (=> () :do (call find (. FindAction next))))
      )
      (<> KeyShortcut (id: find-previous-shortcut) (text: "Find Previous")
        (= key (call KeyCombo "Cmd+Shift+G"))
        (= stable-key "brix.find.previous")
        (= when (=> () (!= (. workspace active) null)))
        (= action (=> () :do (call find (. FindAction previous))))
      )
      (<> KeyShortcut (id: find-selection-shortcut) (text: "Use Selection for Find")
        (= key (call KeyCombo "Cmd+E"))
        (= stable-key "brix.find.selection")
        (= repeat false)
        (= when (=> () (!= (. workspace active) null)))
        (= action (=> () :do (call find (. FindAction selection))))
      )
      (<> KeyShortcut (id: find-files-shortcut) (text: "Find in Files…")
        (= key (call KeyCombo "Cmd+Shift+F"))
        (= stable-key "brix.find.files")
        (= repeat false)
        (= when (=> () (!= (. workspace folder) null)))
        (= action (=> () :do (call (. palettes show-text))))
      )
      (<> KeyShortcut (id: fold-shortcut) (text: "Fold")
        (= key (call KeyCombo "Option+Cmd+["))
        (= stable-key "brix.fold.fold")
        (= when (=> () (!= (. workspace active) null)))
        (= action (=> () :do (call fold (. FoldAction fold))))
      )
      (<> KeyShortcut (id: unfold-shortcut) (text: "Unfold")
        (= key (call KeyCombo "Option+Cmd+]"))
        (= stable-key "brix.fold.unfold")
        (= when (=> () (!= (. workspace active) null)))
        (= action (=> () :do (call fold (. FoldAction unfold))))
      )
      (<> KeyShortcut (id: fold-all-shortcut) (text: "Fold All")
        (= key (call KeyCombo "Option+Cmd+{"))
        (= stable-key "brix.fold.all")
        (= repeat false)
        (= when (=> () (!= (. workspace active) null)))
        (= action (=> () :do (call fold (. FoldAction fold-all))))
      )
      (<> KeyShortcut (id: unfold-all-shortcut) (text: "Unfold All")
        (= key (call KeyCombo "Option+Cmd+}"))
        (= stable-key "brix.fold.unfold-all")
        (= repeat false)
        (= when (=> () (!= (. workspace active) null)))
        (= action (=> () :do (call fold (. FoldAction unfold-all))))
      )
      (<> KeyShortcut (id: forms-shortcut) (text: "Show Forms")
        (= key (call KeyCombo "Cmd+L"))
        (= stable-key "brix.view.source")
        (= repeat false)
        (= is-on #shows-forms)
        (= when (=> () (?? (?. (. workspace active) is-brix) false)))
        (= action (=> () :do (= shows-forms (not shows-forms))))
      )
      (<> KeyShortcut (id: scroll-blur-shortcut) (text: "Blur While Scrolling")
        (= stable-key "editor.view.scroll-blur")
        (= repeat false)
        (= is-on #blurs-scrolling)
        (= action (=> () :do (= blurs-scrolling (not blurs-scrolling))))
      )
      (<> KeyShortcut (id: sidebar-shortcut) (text: "Show Sidebar")
        (= key (call KeyCombo "Cmd+\\"))
        (= stable-key "editor.view.sidebar")
        (= repeat false)
        (= is-on (not (. files #is-collapsed)))
        (= action (=> () :do (call (. files toggle))))
      )
      (<> KeyShortcut (id: previous-tab-shortcut) (text: "Previous Tab")
        (= key (call KeyCombo "Cmd+{"))
        (= stable-key "editor.document.previous")
        (= action (=> () :do (call (. workspace step) -1)))
      )
      (<> KeyShortcut (id: next-tab-shortcut) (text: "Next Tab")
        (= key (call KeyCombo "Cmd+}"))
        (= stable-key "editor.document.next")
        (= action (=> () :do (call (. workspace step) 1)))
      )
      (<> KeyShortcut (id: run-shortcut) (text: "Run")
        (= key (call KeyCombo "Cmd+R"))
        (= stable-key "editor.run.run")
        (= repeat false)
        (= when (=> () (and (?? (?. (. workspace active) can-run) false) (not (. runner is-busy)))))
        (= action (=> () :do (call run)))
      )
      (<> KeyShortcut (id: stop-shortcut) (text: "Stop")
        (= key (call KeyCombo "Cmd+."))
        (= stable-key "editor.run.stop")
        (= repeat false)
        (= when (=> () (. runner is-busy)))
        (= action (=> () :do (call (. runner stop))))
      )
      (<> KeyShortcut (id: install-shortcut) (text: "Install Brix Toolchain")
        (= stable-key "editor.run.install")
        (= repeat false)
        (= when (=> () (not (. runner is-busy))))
        (= action (=> () :do (call install-toolchain)))
      )
      (<> KeyShortcut (id: output-shortcut) (text: "Show Output")
        (= key (call KeyCombo "Cmd+Shift+Y"))
        (= stable-key "editor.view.output")
        (= repeat false)
        (= is-on #shows-output)
        (= action (=> () :do (= shows-output (not shows-output))))
      )
      (<> KeyShortcut (id: updates-shortcut) (text: "Check for Updates…")
        (= stable-key "editor.help.updates")
        (= repeat false)
        (= action (=> () :do (call (. updates check-now))))
      )
      (<> MenuBar
        (<> MenuBarItem (text: "File")
          (<> Menu
            (<> MenuItem
              (= command new-file-shortcut)
            )
            (<> MenuItem
              (= command open-shortcut)
            )
            (<> MenuItem (text: "Open Recent")
              (<> Menu
                (for (in path (call (. workspace recent-folders) (. workspace #revision)) (keyed-by (str path)))
                  (<> MenuItem
                    (= title (. path name))
                    (= action (=> () :do (call request-folder path)))
                  )
                )
              )
            )
            (<> MenuSeparator)
            (<> MenuItem
              (= command go-to-file-shortcut)
            )
            (<> MenuSeparator)
            (<> MenuItem
              (= command close-tab-shortcut)
            )
            (<> MenuItem
              (= command close-window-shortcut)
            )
            (<> MenuSeparator)
            (<> MenuItem
              (= command save-shortcut)
            )
            (<> MenuItem
              (= command save-all-shortcut)
            )
            (<> MenuItem
              (= command revert-shortcut)
            )
          )
        )
        (<> MenuBarItem (text: "Edit")
          (<> Menu
            (<> MenuItem
              (= role (. MenuRole undo))
            )
            (<> MenuItem
              (= role (. MenuRole redo))
            )
            (<> MenuSeparator)
            (<> MenuItem
              (= role (. MenuRole cut))
            )
            (<> MenuItem
              (= role (. MenuRole copy))
            )
            (<> MenuItem
              (= role (. MenuRole paste))
            )
            (<> MenuItem
              (= role (. MenuRole select-all))
            )
            (<> MenuSeparator)
            (<> MenuItem
              (= command find-shortcut)
            )
            (<> MenuItem
              (= command replace-shortcut)
            )
            (<> MenuItem
              (= command find-next-shortcut)
            )
            (<> MenuItem
              (= command find-previous-shortcut)
            )
            (<> MenuItem
              (= command find-selection-shortcut)
            )
            (<> MenuSeparator)
            (<> MenuItem
              (= command find-files-shortcut)
            )
          )
        )
        (<> MenuBarItem (text: "View")
          (<> Menu
            (<> MenuItem
              (= command sidebar-shortcut)
            )
            (<> MenuItem
              (= command output-shortcut)
            )
            (<> MenuItem
              (= command forms-shortcut)
            )
            (<> MenuItem
              (= command scroll-blur-shortcut)
            )
            (<> MenuSeparator)
            (<> MenuItem
              (= command previous-tab-shortcut)
            )
            (<> MenuItem
              (= command next-tab-shortcut)
            )
            (<> MenuSeparator)
            (<> MenuItem
              (= command fold-shortcut)
            )
            (<> MenuItem
              (= command unfold-shortcut)
            )
            (<> MenuItem
              (= command fold-all-shortcut)
            )
            (<> MenuItem
              (= command unfold-all-shortcut)
            )
            (<> MenuSeparator)
            (<> MenuItem
              (= role (. MenuRole zoom-in))
            )
            (<> MenuItem
              (= role (. MenuRole zoom-out))
            )
            (<> MenuItem
              (= role (. MenuRole actual-size))
            )
          )
        )
        (<> MenuBarItem (text: "Run")
          (<> Menu
            (<> MenuItem
              (= command run-shortcut)
            )
            (<> MenuItem
              (= command stop-shortcut)
            )
            (<> MenuSeparator)
            (<> MenuItem
              (= command install-shortcut)
            )
          )
        )
        (<> MenuBarItem (text: "Window")
          (<> Menu
            (<> MenuItem
              (= role (. MenuRole minimize))
            )
            (<> MenuItem
              (= role (. MenuRole zoom))
            )
            (<> MenuSeparator)
            (<> MenuItem
              (= role (. MenuRole bring-all-to-front))
            )
          )
        )
        (<> MenuBarItem (text: "Help")
          (<> Menu
            (<> MenuItem
              (= command updates-shortcut)
            )
          )
        )
      )
      (blank)
      (<> FileSidebar (id: files) (• glass) (• w 260)
        (= workspace workspace)
      )
      (<> Box (• document-column)
        (<> Box (• flex-col) (• flex 1)
          (for (in document (call (. workspace active-list) (. workspace #revision)) (keyed-by (. document id)))
            (<> DocumentPane (• flex 1)
              (= document document)
              (= find-options (. workspace find-options))
              (= shows-forms #shows-forms)
              (= blurs-scrolling #blurs-scrolling)
              (= chrome-height #chrome-height)
            )
          )
          (if (== (. workspace #active) null)
            (<> WelcomeView (id: welcome) (• flex 1)
              (= padding-top #chrome-height)
              (= workspace workspace)
              (= runner runner)
            )
          )
          (if (!= (. updates #available) null)
            (<> UpdateBar
              (= updates updates)
              (= release (!! (. updates #available)))
            )
          )
          (if #shows-output
            (<> OutputPanel (• h 240)
              (= workspace workspace)
              (= runner runner)
              (for (on event closed)
                (= shows-output false)
              )
            )
          )
        )
        (<> EditorToolbar (id: toolbar) (• absolute)
          (= left (call (. PositionOffset coord) 0))
          (= right (call (. PositionOffset coord) 0))
          (= top (call (. PositionOffset coord) 0))
          (= workspace workspace)
          (= is-title-bar (. files #is-collapsed))
          (= can-run #can-run)
          (= is-running #is-running)
          (= shows-output #shows-output)
        )
      )
      (<> ToolbarGroup (• absolute)
        (= left (call (. PositionOffset coord) (if-expr #is-full-screen gui-toolbar-pad #stoplight-inset)))
        (= top (call (. PositionOffset coord) (/ (- gui-toolbar-height gui-toolbar-group-height) 2)))
        (<> ToolbarButton (• icon-panel-left)
          (= action (=> () :do (call (. files toggle))))
          (<> Tooltip
            (= text (if-expr (. files #is-collapsed) "Show Sidebar" "Hide Sidebar"))
          )
        )
      )
      (<> EditorPalettes (id: palettes)
        (= workspace workspace)
      )
      (<> Dialog (id: close-dialog)
        (= title (call editor-closing-title #pending-close))
        (<> Label (slot: body) (• w 340)
          (= text "Your changes will be lost if you don’t save them.")
          (= text-wrap (. TextWrap word))
        )
        (<> Box (slot: actions) (• flex-row)
          (<> Button (text: "Don’t Save") (• w 100)
            (= action (=> () :do (call settle-close false)))
          )
          (<> Box (• flex 1))
          (<> Button (text: "Cancel") (• w 90)
            (= action (=> () :do (call (. close-dialog dismiss))))
          )
          (<> Button (text: "Save") (• w 90) (• ml 8)
            (= role (. ButtonRole default))
            (= action (=> () :do (call settle-close true)))
          )
        )
      )
      (<> Toaster (id: toaster))
    )
  )
  (whenever-rule (. workspace file-session #current)
    (let node (. workspace file-session current))
    (return-if (if (or (not node) (. node is-directory))))
    (call (. workspace open-path) (. node path))
  )
  (subscribe-for (on node (. workspace file-session opened))
    (if (not (. node is-directory))
      (call (. workspace open-path) (. node path))
    )
  )
  (subscribe-for (on message (. workspace file-session failed))
    (let ignored (call (. toaster post) message (. ToastSeverity error)))
  )
  (subscribe-for (on message (. workspace failed))
    (let ignored (call (. toaster post) message (. ToastSeverity error)))
  )
  (subscribe-for (on event (. toolbar run-requested))
    (call run)
  )
  (subscribe-for (on event (. toolbar stop-requested))
    (call (. runner stop))
  )
  (subscribe-for (on event (. toolbar output-toggled))
    (= shows-output (not shows-output))
  )
  (subscribe-for (on event closed)
    (call (. runner close))
    (call (. updates close))
  )
  (subscribe-for (on message (. updates reported))
    (let ignored (call (. toaster post) message (. ToastSeverity info)))
  )
  (subscribe-for (on document (. toolbar closing))
    (call confirm-close document)
  )
  (subscribe-for (on requested (. welcome open-requested))
    (call open-any)
  )
  (subscribe-for (on requested (. welcome new-requested))
    (call new-file)
  )
  (subscribe-for (on path (. welcome folder-requested))
    (call request-folder path)
  )
  (subscribe-for (on requested (. welcome install-requested))
    (call install-toolchain)
  )
  (subscribe-for (on event closing)
    (if (and (not is-close-confirmed) (> (call (. workspace unsaved-count) (. workspace revision)) 0))
      (call (. event cancel))
      (call ask (. EditorClosing window))
    )
  )
  (subscribe-for (on reason (. close-dialog dismissed) (when arrival))
    (= pending-close null)
  )
  (fn-do + run _
    (let document (. workspace active))
    (return-if (if (or (not document) (not (. document can-run)) (. runner is-busy))))
    (blank)
    (call (. workspace save-all))
    (= shows-output true)
    (call (. runner start) (. document path) (?? (. workspace folder) (. document path parent) (call Path "/" 0)))
  )
  (fn-do + install-toolchain _
    (return-if (if (. runner is-busy)))
    (blank)
    (= shows-output true)
    (call (. runner install-toolchain))
  )
  (fn-do + request-folder _
    (param path Path)
    (if (> (call (. workspace unsaved-count) (. workspace revision)) 0)
      (call ask (call (. EditorClosing folder) path))
      (else
        (call (. workspace open-folder) path)
      )
    )
  )
  (fn-do + open-paths _
    (param paths (list Path))
    (for (in path paths)
      (if (. path is-dir)
        (call request-folder path)
        (else
          (if (== (. workspace folder) null)
            (let parent (. path parent))
            (if parent
              (call (. workspace open-folder) parent)
            )
          )
          (call (. workspace open-path) path)
        )
      )
    )
  )
  (fn-do _ new-file _
    (let chosen
      (call choose-save-path this
        (block
          (:name "untitled.bx")
          (:directory (call (. workspace browse-folder)))
          (:message "Name the new file")
          (:prompt "Create")
        )
      )
    )
    (return-if (if (not chosen)))
    (blank)
    (if (== (. workspace folder) null)
      (let parent (. chosen parent))
      (if parent
        (call (. workspace open-folder) parent)
      )
    )
    (call (. workspace create-file) chosen)
  )
  (fn-do _ open-any _
    (let chosen
      (call choose-open-paths this
        (block
          (:directory (call (. workspace browse-folder)))
          (:allows-multiple true)
          (:chooses-files true)
          (:chooses-directories true)
          (:message "Choose a folder or files to open")
          (:prompt "Open")
        )
      )
    )
    (call open-paths chosen)
  )
  (fn-do _ close-active _
    (let document (. workspace active))
    (if document
      (call confirm-close document)
    )
  )
  (fn-do _ confirm-close _
    (param document EditorDocument)
    (if (. document is-modified)
      (call ask (call (. EditorClosing document) document))
      (else
        (call (. workspace close) document)
      )
    )
  )
  (fn-do _ save-active _
    (let document (. workspace active))
    (if document
      (call (. workspace save) document)
    )
  )
  (fn-do _ revert-active _
    (let document (. workspace active))
    (if document
      (call (. workspace revert) document)
    )
  )
  (fn-do _ find _
    (param action FindAction)
    (let document (. workspace active))
    (if document
      (<- (. document find-requested) action)
    )
  )
  (fn-do _ fold _
    (param action FoldAction)
    (let document (. workspace active))
    (if document
      (<- (. document fold-requested) action)
    )
  )
  (fn-do _ ask _
    (param target EditorClosing)
    (= pending-close target)
    (call (. close-dialog show))
  )
  (fn-do _ settle-close _
    (param saves Bool)
    (let target pending-close)
    (= pending-close null)
    (call (. close-dialog dismiss))
    (return-if (if (not target)))
    (blank)
    (match target
      (case (call .document document)
        (if saves
          (call (. workspace save) document)
        )
        (if (or (not saves) (not (. document is-modified)))
          (call (. workspace close) document)
        )
      )
      (case (call .folder path)
        (if saves
          (call (. workspace save-all))
        )
        (call (. workspace open-folder) path)
      )
      (case .window
        (if saves
          (call (. workspace save-all))
        )
        (= is-close-confirmed true)
        (call close)
      )
    )
  )
)

(type + EditorPalettes (is Box)
  (prop + workspace Workspace)
  (blank)
  (prop _ file-palettes (of Descendants FilePalette))
  (prop _ text-palettes (of Descendants FileTextPalette))
  (content
    (<> This (• absolute) (• w 0) (• h 0)
      (for (in folder (call (. workspace folder-list) (. workspace #revision)) (keyed-by (str folder)))
        (<> Box (• absolute) (• w 0) (• h 0)
          (<> FilePalette
            (= files (!! (. workspace files)))
            (= is-confined true)
            (for (on item chosen)
              (call take-file item)
            )
            (for (on spot line-chosen)
              (call take-line spot)
            )
          )
          (<> FileTextPalette
            (= folder folder)
            (for (on match chosen)
              (call take-match folder match)
            )
          )
        )
      )
    )
  )
  (fn-do + show-files _
    (for (in palette file-palettes)
      (call (. palette show))
    )
  )
  (fn-do + show-text _
    (for (in palette text-palettes)
      (call (. palette show-seeded) "")
    )
  )
  (fn-do _ take-file _
    (param item FilePaletteItem)
    (if (. item is-directory)
      (let node (call (?. (. workspace files) find) (. item path)))
      (if node
        (<- (. workspace file-session revealed) node)
      )
      (return)
    )
    (let line (. item line))
    (if (!= line null)
      (call (. workspace open-path) (. item path) (call EditorJump line (. item column)))
      (else
        (call (. workspace open-path) (. item path))
      )
    )
  )
  (fn-do _ take-line _
    (param spot FilePaletteSpot)
    (let line (. spot line))
    (if (!= line null)
      (call (?. (. workspace active) jump-to) line (. spot column))
    )
  )
  (fn-do _ take-match _
    (param folder Path)
    (param match FileTextMatch)
    (call (. workspace open-path) (call Path (str folder "/" (. match path)) 0) (call EditorJump (. match line) (. match column)))
  )
)

(fn-expr _ editor-closing-title String
  (param closing (? EditorClosing))
  (match closing
    (case (call .document document)
      (str "Save changes to " (. document title) "?")
    )
    (case (call .folder path)
      (str "Save changes before opening " (. path name) "?")
    )
    (case .window
      "Save changes before closing?"
    )
    (default
      ""
    )
  )
)
