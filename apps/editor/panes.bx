(import ./editor-document)
(import ./editor-theme)
(import /graphics/primitives)
(import /gui)
(import /gui/code-editor)
(import /gui/source-editor)

(type + CodePane (is Box)
  (using EditorTheme)
  (prop + document EditorDocument)
  (prop + find-options FindOptions)
  (prop + blurs-scrolling _ (= false))
  (prop + chrome-height Length (= 0))
  (blank)
  (prop _ is-presented _ (= false))
  (prop _ bars-height Length)
  (content
    (<> This (• flex-col)
      (<> CodeEditor (id: editor) (• flex 1)
        (= focus-default true)
        (= scroll-blur (only-if $gui-scroll-blur (if #blurs-scrolling)))
        (= top-inset (+ #chrome-height #bars-height))
      )
      (<> Box (• editor-pill)
        (if (. editor #is-parsing)
          (<> Label (• status-item)
            (= text "Parsing…")
          )
          (else-if (. editor #has-parse-error)
            (<> Label (• status-warning)
              (= text "Syntax errors")
            )
          )
        )
        (if (. document #status)
          (<> Label (• status-warning)
            (= text (. document #status))
          )
        )
        (<> Label (• status-item)
          (= text (str "Ln " (+ (. editor #caret-line) 1) ", Col " (+ (. editor #caret-column) 1)))
        )
        (<> Label (• status-item)
          (= text (. editor #language-title))
        )
      )
      (<> PaneBars (id: bars) (• pane-bars)
        (= top (call (. PositionOffset coord) #chrome-height))
        (if (?? (?. (. document #code) #is-missing) false)
          (<> Box (• editor-banner)
            (<> Label (• flex 1)
              (= text "This file was deleted. Saving recreates it.")
            )
          )
          (else-if (?? (?. (. document #code) #is-changed-on-disk) false)
            (<> Box (• editor-banner)
              (<> Label (• flex 1)
                (= text "This file changed on disk. Your unsaved edits are kept.")
              )
              (<> Button (text: "Reload")
                (= action (=> () :do (call (. document revert))))
              )
            )
          )
        )
        (<> FindBar (id: find-bar)
          (= options find-options)
        )
      )
    )
  )
  (subscribe-for (on covered (. bars resized))
    (= bars-height covered)
  )
  (whenever-rule (?. (. document #code) #session)
    (call present)
  )
  (whenever-rule (. document #jump)
    (call take-jump)
  )
  (whenever-rule (. editor #text-revision)
    (call (. find-bar follow))
  )
  (whenever-rule (?. (. document #code) #is-modified)
    (call (. document note-modified) (?? (?. (. document code) is-modified) false))
  )
  (subscribe-for (on action (. document find-requested))
    (call pane-find find-bar action)
  )
  (subscribe-for (on action (. document fold-requested))
    (match action
      (case .fold
        (call (. editor fold))
      )
      (case .unfold
        (call (. editor unfold))
      )
      (case .fold-all
        (call (. editor fold-all))
      )
      (case .unfold-all
        (call (. editor unfold-all))
      )
    )
  )
  (subscribe-for (on active (. editor save-requested))
    (<- (. document save-requested) document)
  )
  (fn-do + mounted _
    (call (. super mounted))
    (= (. find-bar target) editor)
    (call present)
    (call (. editor request-focus))
  )
  (fn-do + unmounted _
    (if is-presented
      (= (. document scroll) (. editor text-scroll))
    )
    (call (. super unmounted))
  )
  (fn-do _ present _
    (let active (?. (. document code) session))
    (return-if (if (not active)))
    (blank)
    (let scroll (if-expr is-presented (. editor text-scroll) (. document scroll)))
    (= is-presented true)
    (call (. editor show) active scroll)
    (call (. find-bar reset))
    (call take-jump)
  )
  (fn-do _ take-jump _
    (let found (. document jump))
    (let active (?. (. document code) session))
    (return-if (if (or (not found) (not active) (not is-presented))))
    (blank)
    (= (. document jump) null)
    (call (. editor jump-to) (. found line) (as (?? (. found column) 0) Float))
    (call (. editor request-focus))
  )
)

(type + BrixPane (is Box)
  (using EditorTheme)
  (prop + document EditorDocument)
  (prop + find-options FindOptions)
  (prop + shows-forms _ (= false))
  (prop + blurs-scrolling _ (= false))
  (prop + chrome-height Length (= 0))
  (blank)
  (prop _ is-presented _ (= false))
  (prop _ bars-height Length)
  (content
    (<> This (• flex-row)
      (<> Box (• flex-col) (• flex 1)
        (<> SourceEditor (id: editor) (• flex 1)
          (= focus-default true)
          (= scroll-blur (only-if $gui-scroll-blur (if #blurs-scrolling)))
          (= top-inset (+ #chrome-height #bars-height))
        )
        (<> Box (• editor-pill)
          (if (. document #status)
            (<> Label (• status-warning)
              (= text (. document #status))
            )
          )
          (<> Label (• status-item)
            (= text (str "Ln " (+ (. editor #caret-row) 1) ", Col " (+ (. editor #caret-column) 1)))
          )
          (<> Label (• status-item)
            (= text "Brix")
          )
        )
      )
      (<> SourceListingPane (id: listing) (• flex 1)
        (= display (if-expr #shows-forms (. Display visible) (. Display hidden)))
        (= is-active #shows-forms)
        (= session (. editor #session))
        (= stamp (. editor #stamp))
        (= top-inset (+ #chrome-height #bars-height))
      )
      (<> PaneBars (id: bars) (• pane-bars)
        (= top (call (. PositionOffset coord) #chrome-height))
        (if (?? (?. (. document #brix) #is-missing) false)
          (<> Box (• editor-banner)
            (<> Label (• flex 1)
              (= text "This file was deleted. Saving recreates it.")
            )
          )
          (else-if (?? (?. (. document #brix) #is-changed-on-disk) false)
            (<> Box (• editor-banner)
              (<> Label (• flex 1)
                (= text "This file changed on disk. Your unsaved edits are kept.")
              )
              (<> Button (text: "Reload")
                (= action (=> () :do (call (. document revert))))
              )
            )
          )
        )
        (<> FindBar (id: find-bar)
          (= options find-options)
        )
      )
    )
  )
  (subscribe-for (on covered (. bars resized))
    (= bars-height covered)
  )
  (whenever-rule (?. (. document #brix) #session)
    (call present)
  )
  (whenever-rule (. document #jump)
    (call take-jump)
  )
  (whenever-rule (. editor #stamp)
    (call (. find-bar follow))
  )
  (whenever-rule (. document #is-modified)
    (= (. editor is-modified) (. document is-modified))
  )
  (subscribe-for (on action (. document find-requested))
    (call pane-find find-bar action)
  )
  (subscribe-for (on action (. document fold-requested))
    (match action
      (case .fold
        (call (. editor fold))
      )
      (case .unfold
        (call (. editor unfold))
      )
      (case .fold-all
        (call (. editor fold-all))
      )
      (case .unfold-all
        (call (. editor unfold-all))
      )
    )
  )
  (subscribe-for (on row (. listing row-picked))
    (call (. editor jump-to) row 0)
    (call (. editor request-focus))
  )
  (subscribe-for (on modified (. editor modified-changed))
    (call (. document note-modified) modified)
  )
  (subscribe-for (on active (. editor save-requested))
    (<- (. document save-requested) document)
  )
  (fn-do + mounted _
    (call (. super mounted))
    (= (. find-bar target) editor)
    (call present)
    (call (. editor request-focus))
  )
  (fn-do + unmounted _
    (if is-presented
      (= (. document scroll) (. editor text-scroll))
    )
    (call (. (?. (. document brix) session) document shed))
    (call (. super unmounted))
  )
  (fn-do _ present _
    (let active (?. (. document brix) session))
    (return-if (if (not active)))
    (blank)
    (let scroll (if-expr is-presented (. editor text-scroll) (. document scroll)))
    (= is-presented true)
    (call (. editor resume) active scroll)
    (call (. find-bar reset))
    (call take-jump)
  )
  (fn-do _ take-jump _
    (let found (. document jump))
    (let active (?. (. document brix) session))
    (return-if (if (or (not found) (not active) (not is-presented))))
    (blank)
    (= (. document jump) null)
    (let row (?? (call (. active document row-of-line) (. found line)) (. found line)))
    (call (. editor jump-to) row (?? (. found column) 0))
    (call (. editor request-focus))
  )
)

(type + DocumentPane (is Box)
  (using EditorTheme)
  (prop + document EditorDocument)
  (prop + find-options FindOptions)
  (prop + shows-forms _ (= false))
  (prop + blurs-scrolling _ (= false))
  (prop + chrome-height Length (= 0))
  (content
    (<> This (• flex-col)
      (if (. document is-brix)
        (<> BrixPane (• flex 1)
          (= document document)
          (= find-options find-options)
          (= shows-forms #shows-forms)
          (= blurs-scrolling #blurs-scrolling)
          (= chrome-height #chrome-height)
        )
        (else
          (<> CodePane (• flex 1)
            (= document document)
            (= find-options find-options)
            (= blurs-scrolling #blurs-scrolling)
            (= chrome-height #chrome-height)
          )
        )
      )
    )
  )
)

(type + PaneBars (is Box)
  (event + resized Length)
  (blank)
  (prop _ reported Length)
  (fn-do + did-layout _
    (call (. super did-layout))
    (if (!= height reported)
      (= reported height)
      (<- resized height)
    )
  )
)

(fn-do _ pane-find _
  (param bar FindBar)
  (param action FindAction)
  (match action
    (case .find
      (call (. bar open) false)
    )
    (case .replace
      (call (. bar open) true)
    )
    (case .next
      (call (. bar step) true)
    )
    (case .previous
      (call (. bar step) false)
    )
    (case .selection
      (call (. bar use-selection))
    )
  )
)
