(import ./brix-file)
(import ./runner)
(import /code/code-document)
(import /code/structure/document)
(import /graphics/point)
(import /lang/ubrix/ubrix)
(import /os/path)

(type + FindAction (is Union)
  (variant find)
  (variant replace)
  (variant next)
  (variant previous)
  (variant selection)
)

(type + FoldAction (is Union)
  (variant fold)
  (variant unfold)
  (variant fold-all)
  (variant unfold-all)
)

(type + EditorJump (is Tuple)
  (prop + line Size)
  (prop + column (? Size))
)

(type + EditorDocument
  (implements Closable)
  (prop + id U64)
  (prop + path Path)
  (prop + code (? CodeDocument))
  (prop + brix (? BrixFile))
  (prop + is-modified _ (= false))
  (prop + status _ (= ""))
  (prop + scroll _ (= (call Point 0 0)))
  (prop + jump (? EditorJump))
  (prop + can-run _ (= false))
  (event + find-requested FindAction)
  (event + fold-requested FoldAction)
  (event + save-requested EditorDocument)
  (fn-do + This _
    (param id _)
    (param path _)
    (param text String)
    (= can-run (call runner-can-run path text))
    (if (== (. path extension) "bx")
      (let read (catch (call brix-document-read text)))
      (if (is read Error)
        (= status (str "Not readable as Brix: " (. (as read Error) message)))
        (= code (call CodeDocument path text))
        (else
          (= brix (call BrixFile path text (as read SourceDocument)))
        )
      )
      (else
        (= code (call CodeDocument path text))
      )
    )
    (catch (call (?. code watch)))
    (catch (call (?. brix watch)))
  )
  (fn-expr + title String :get
    (. path name)
  )
  (fn-expr + is-brix Bool :get
    (!= brix null)
  )
  (fn-expr + is-changed-on-disk Bool :get
    (?? (?. code is-changed-on-disk) (?. brix is-changed-on-disk) false)
  )
  (fn-expr + is-missing Bool :get
    (?? (?. code is-missing) (?. brix is-missing) false)
  )
  (fn-expr + language String :get
    (if-expr (!= brix null) "Brix" "")
  )
  (fn-do + save _ (?! Error)
    (let active code)
    (if active
      (call (. active save))
      (= is-modified (. active is-modified))
      (= status "")
      (return)
    )
    (let file brix)
    (throw (call Error (str "Unable to write " path)) (if (and (!= file null) (not (call (. file save))))))
    (blank)
    (= is-modified false)
    (= status "")
  )
  (fn-do + revert _
    (call (?. code reload) true)
    (call (?. brix reload) true)
    (= is-modified false)
  )
  (fn-do + note-modified _
    (param modified Bool)
    (= is-modified modified)
  )
  (fn-do + jump-to _
    (param line Size)
    (param column (? Size) (= null))
    (= jump (call EditorJump line column))
  )
  (fn-do + close _
    (call (?. code close))
    (call (?. brix close))
  )
)

(fn-do + open-editor-document EditorDocument (?! Error)
  (param id U64)
  (param path Path)
  (let text (call code-read-text path))
  (throw (call Error (str (. path name) " is not a text file")) (if (== text null)))
  (return (call EditorDocument id path text))
)
