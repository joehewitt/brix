(import ./editor-window)
(import ./examples)
(import ./workspace)
(import /gui)
(import /lang/product/mac-app)
(import /os/cli)
(import /os/path)
(import /os/shell)
(import /ui/app-state)
(import /unistd.h)
(blank)

(main
  (if (!= (call C:isatty 1) 1)
    (call adopt-login-shell-environment)
  )
  (blank)
  (<> MacApp (id: product)
    (= id "com.brix-lang.editor")
    (= name "Brix Editor")
    (<> DocumentType
      (= name "Brix Source")
      (= extensions (list "bx"))
      (= rank "owner")
    )
    (<> DocumentType
      (= name "Yumi Source")
      (= extensions (list "yumi"))
      (= rank "alternate")
    )
    (<> DocumentType
      (= name "Text")
      (= content-types (list "public.text"))
      (= rank "alternate")
    )
    (<> DocumentType
      (= name "Folder")
      (= content-types (list "public.folder"))
      (= rank "alternate")
    )
  )
  (blank)
  (let state (call AppState "Brix Editor"))
  (<> App (id: app)
    (= state state)
  )
  (blank)
  (let shell (use (call EditorShell app state)))
  (call (. shell start) (call (of List Path) (in (call Path each 0) (. (call cmdline) args))))
  (for (on paths (. app open-requested))
    (call (. shell open-paths) paths)
  )
)

(type + EditorShell
  (implements Closable)
  (prop + app App)
  (prop + state AppState)
  (prop + workspace Workspace)
  (prop + window EditorWindow)
  (fn-do + This _
    (param app _)
    (param state _)
    (= workspace (call Workspace state))
    (= window (call EditorWindow workspace))
    (+= app window)
    (for (on event (. window closed))
      (if (not (. app is-quitting))
        (call (. app stop))
      )
    )
    (for (on event (. window runner toolchain-installed))
      (call set-up-examples)
    )
  )
  (fn-do + start _
    (param paths (list Path))
    (if (> (. paths length) 0)
      (call (. window open-paths) paths)
      (return)
    )
    (let examples (call BundledExamples state (call examples-toolchain)))
    (call update-examples examples)
    (call (. workspace restore))
    (if (and (not (. workspace folder)) (== (. workspace documents length) 0))
      (call open-examples examples)
    )
  )
  (fn-do + open-paths _
    (param paths (list Path))
    (call (. window open-paths) paths)
    (call (. window bring-to-front))
  )
  (fn-do + close _
    (call (. workspace close))
  )
  (fn-do _ update-examples _
    (param examples BundledExamples)
    (let kept
      (call (. examples update)
        (block
          (on-error (: error Error)
            (<- (. workspace failed) (str "Unable to update the examples: " (. error message)))
            (return)
          )
        )
      )
    )
    (if kept
      (call (. workspace remember-folder) kept)
    )
  )
  (fn-do _ set-up-examples _
    (let examples (call BundledExamples state (call examples-toolchain)))
    (let installed
      (call (. examples install)
        (block
          (on-error (: error Error)
            (<- (. workspace failed) (str "Unable to set up the examples: " (. error message)))
            (return)
          )
        )
      )
    )
    (return-if (if (not installed)))
    (if (and (not (. workspace folder)) (== (. workspace documents length) 0))
      (call (. workspace open-folder) installed)
      (else
        (call (. workspace remember-folder) installed)
      )
    )
  )
  (fn-do _ open-examples _
    (param examples BundledExamples)
    (let installed
      (call (. examples install)
        (block
          (on-error (: error Error)
            (<- (. workspace failed) (str "Unable to set up the examples: " (. error message)))
            (return)
          )
        )
      )
    )
    (if installed
      (call (. workspace open-folder) installed)
    )
  )
)
