(import ./editor-theme)
(import ./workspace)
(import /graphics/primitives)
(import /gui)
(import /gui/file-browsing)

(type + FileSidebar (is Sidebar)
  (using EditorTheme)
  (prop + workspace Workspace)
  (content
    (<> This
      (= resize-edge (. Side right))
      (= state-key "editor.files")
      (<> Box (slot: header) (• h gui-toolbar-height)
        (= window-draggable true)
      )
      (for (in folder (call (. workspace folder-list) (. workspace #revision)) (keyed-by (str folder)))
        (<> SidebarSection (• flex 1) (• pb 0)
          (= title (. folder name))
          (<> FileTreeBox (• flex 1)
            (= files (!! (. workspace files)))
            (= session (. workspace file-session))
          )
        )
      )
    )
  )
)
