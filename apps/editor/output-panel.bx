(import ./editor-document)
(import ./editor-theme)
(import ./runner)
(import ./workspace)
(import /graphics/color)
(import /graphics/primitives)
(import /gui)
(import /gui/icons/lucide/x)
(import /gui/probe-lines)
(import /gui/terminal-view)
(import /os/path)
(import /os/terminal-path)
(import /probes/feed)

(style-extend EditorTheme
  (rule output-panel (• flex-col) (• bg editor-document-color)
    (= border-color gui-divider-color)
    (= border-width 0)
    (= border-top-width 1)
  )
  (blank)
  (rule output-bar (• flex-row) (• items-center) (• h 34) (• px 8))
  (blank)
  (rule output-status (• text gui-muted-text-color) (• ml 10))
  (blank)
  (rule output-filter (• w 200) (• mr 6))
  (blank)
  (rule output-note (• text gui-muted-text-color)
    (= font-size gui-footnote-font-size)
  )
)

(type + OutputMode (is Union)
  (variant output)
  (variant probes)
)

(type + OutputPanel (is Box)
  (using EditorTheme)
  (prop + workspace Workspace)
  (prop + runner Runner)
  (prop + mode _ (= (. OutputMode output)))
  (prop + status _ (= (call runner-status (. runner #state) (. runner #exit-code))))
  (prop + feed _ (= (. runner #feed)))
  (prop + revision _ (= (?? (?. #feed #revision) 0u64)))
  (prop + is-recording _ (= (?? (?. #feed #is-recording) false)))
  (prop + probe-status _ (= (if-expr #feed (call probe-feed-status #revision #is-recording #feed) "")))
  (prop + counters _ (= (call probe-feed-counters #revision #feed)))
  (prop + filter-text _ (= ""))
  (event + closed Bool)
  (content
    (<> This (• output-panel)
      (<> Box (• output-bar)
        (<> (of SegmentedControl OutputMode)
          (= selected #mode)
          (for (on event selection-changed)
            (= mode (. event value))
          )
          (<> (of Segment OutputMode)
            (= title "Output")
            (= value (. OutputMode output))
          )
          (<> (of Segment OutputMode)
            (= title "Probes")
            (= value (. OutputMode probes))
          )
        )
        (<> Label (• output-status) (• flex 1)
          (= text (if-expr (and (== #mode (. OutputMode probes)) (> (. #probe-status length) 0)) #probe-status #status))
        )
        (if (== #mode (. OutputMode probes))
          (<> TextInput (• output-filter)
            (= placeholder "Filter text or key")
            (= live-edit-delay probe-filter-delay)
            (for (on event text-edited)
              (= filter-text (. event text))
            )
            (for (on event change)
              (= filter-text (. event text))
            )
          )
        )
        (<> IconButton (• icon-x) (• w 24) (• h 22)
          (= action (=> () :do (<- closed true)))
          (<> Tooltip (text: "Hide Output (⇧⌘Y)"))
        )
      )
      (<> TerminalView (id: terminal) (• flex 1) (• p 6)
        (= session (. runner session))
        (= display (if-expr (== #mode (. OutputMode output)) (. Display visible) (. Display hidden)))
        (for (on link path-opened)
          (call open-link link)
        )
      )
      (<> Box (• flex-col) (• flex 1)
        (= display (if-expr (== #mode (. OutputMode probes)) (. Display visible) (. Display hidden)))
        (if (!= #feed null)
          (<> ProbeLines (• flex 1)
            (= feed (!! #feed))
            (= filter #filter-text)
            (for (on line opened)
              (call open-probe line)
            )
          )
          (else
            (<> Box (• flex 1) (• items-center)
              (= justify (. Justify center))
              (<> Label (• output-note)
                (= text "Run a Brix program to see the probes it records.")
              )
            )
          )
        )
        (if (> (. #counters length) 0)
          (<> Label (• output-note) (• px 10) (• py 4)
            (= text #counters)
          )
        )
      )
      (<> Resizer
        (= edge (. Side top))
        (= min-size 90)
        (= max-size 700)
        (= state-key "editor.output")
      )
    )
  )
  (fn-do _ open-link _
    (param link TerminalPathLink)
    (let line (. link line))
    (if (and (!= line null) (> line 0))
      (call (. workspace open-path)
        (block
          (arg (call Path (. link path) 0))
          (arg (call EditorJump (- line 1) (only-if (- (!! (. link column)) 1) (if (> (?? (. link column) 0) 0)))))
        )
      )
      (else
        (call (. workspace open-path) (call Path (. link path) 0))
      )
    )
  )
  (fn-do _ open-probe _
    (param line ProbeLine)
    (return-if (if (== (. line path length) 0)))
    (blank)
    (let path
      (block
        (case? (call (. line path starts-with) "/")
          (call Path (. line path) 0)
        )
        (default
          (/ (?? (?. (. runner source) parent) (call Path "/" 0)) (. line path))
        )
      )
    )
    (call (. workspace open-path) path (call EditorJump (if-expr (> (. line line) 0) (as (- (. line line) 1) Size) 0) null))
  )
)
