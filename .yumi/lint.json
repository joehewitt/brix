{
    "extends": "recommended",
    "searchPath": ["stdlib"],
    "rules": {
        "layout/line-length": { "max": 100 },
        "layout/format": {
            "lengths": {
                "━": 20,
                "─": 20,
                "═": 20
            }
        },
        "imports/sort": true,
        "names/import-conflicts": true,
        "names/local-shadows-import": true,
        "names/type-param-shadows-type": true,
        "style/no-unused-catch-optional": true,
        "style/prefer-expression-function": true,
        "style/no-redundant-context-cast": true,
        "style/prefer-shorthand": true,
        "tui/prefer-shortcut-node": true
    }
}
